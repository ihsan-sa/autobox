#!/usr/bin/env bash
# gh — a shim ahead of the real gh on PATH (~/bin comes first): a call that names a GitHub org this box may not touch —
# in its arguments, in GH_REPO, or as one of the cwd's remotes — is refused with the org and the list named, and the
# real gh never runs. Every other call IS the real gh, exec'd with the same arguments: nothing here reads its output or
# changes its behaviour. The list, and what counts as naming an org, are cc-github-deny's (beside this file); with no
# list, or no cc-github-deny to ask, every call passes. A caller that spells /usr/bin/gh walks past this shim — cc-guard
# reads that line, and the git layers still stand behind it.
me=$(readlink -f -- "$0"); d=${me%/*}
real=""; IFS=:; for p in $PATH; do
  [ -x "$p/gh" ] && [ ! -d "$p/gh" ] || continue
  [ "$(readlink -f -- "$p/gh")" = "$me" ] && continue
  real=$p/gh; break
done; unset IFS
[ -n "$real" ] || { echo "gh: this is the deny-list shim and no real gh is behind it on PATH" >&2; exit 127; }
if [ -x "$d/cc-github-deny" ]; then
  "$d/cc-github-deny" check "$@" "${GH_REPO:-}" "$(git config --get-regexp '^remote\..*\.url$' 2>/dev/null)"
  [ $? = 77 ] && exit 77   # any other answer — allowed, or the check itself failed — is the real gh, untouched
fi
exec "$real" "$@"
