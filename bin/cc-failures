        ok("…the live ledger was neither read nor written: no box scope appeared under CC_FAILURES", not os.path.exists(os.path.join(T, "failures", "box.jsonl")))
        rc, out, err = C("replay", "--json")
        j = json.loads(out) if rc == 0 else {}
        ok("replay --json prints the run: clusters with fired/control, no errors", rc == 0 and j.get("clusters", {}).get(AE, {}).get("fired", {}).get("at") == "2026-09-07T20:50:00Z" and j["errors"] == [])
        rc, out, err = C("replay", os.path.join(T, "none.jsonl"))
        ok("an events file that is not there is refused, not replayed empty", rc == 2 and "events" in err)
        bad = os.path.join(T, "bad.jsonl"); open(bad, "w").write('{"ts": "2026-09-01T10:00Z", "scope": "s", "text": "no kind and no row"}\n')
        rc, out, err = C("replay", bad)
        ok("…and a line with neither kind nor row is refused", rc == 2 and "kind or row" in err)
        # CANDIDATES: the same events, another detector. A copy of this file with the episode gap cut to 5 minutes turns the
        # "one episode written three times" control into three episodes: it fires, and the run is red, not scored.
        src = open(os.path.join(B, "cc-failures")).read()
        cand = os.path.join(T, "cand-gap5"); open(cand, "w").write(src.replace("EPISODE_GAP_MIN = 30 ", "EPISODE_GAP_MIN = 5 ")); os.chmod(cand, 0o755)
        rc, out, err = C("replay", "--candidate", cand)
        ok("a candidate that fires on a negative control: the control line says FIRED, the run is RED, rc 1",
           rc == 1 and any(l.strip().startswith("FIRED  control 'one episode written three times'") for l in out.splitlines()) and "RED: a control fired" in out
           and out.count("controls quiet") == 0)
        ok("…the baseline in the same run still shows the control quiet", "baseline:" in out and out.split("candidate:")[0].count("quiet  control") == 5)
        cand2 = os.path.join(T, "cand-two"); open(cand2, "w").write(src.replace("EPISODES_NEEDED = 3 ", "EPISODES_NEEDED = 2 ")); os.chmod(cand2, 0o755)
        rc, out, err = C("replay", "--candidate", cand2)
        ok("a candidate needing two episodes: the crossing moves earlier and the difference says by how much — and the two-episode control fires, so it is red",
           rc == 1 and f"~ {AE}  answer-evidence/wrong-object-or-proxy  crossing moved 2026-09-07T20:50 → 2026-09-07T19:30 (earlier by 1h 20m)" in out
           and any(l.strip().startswith("FIRED  control 'two episodes in fourteen days'") for l in out.splitlines()))
        cat2 = json.load(open(CATALOGUE)); cat2["kinds"]["notification/false-action-needed"]["match"] = []
        ccat = os.path.join(T, "cat-no-steward.json"); json.dump(cat2, open(ccat, "w"))
        rc, out, err = C("replay", "--candidate-catalogue", ccat)
        NF = fpid(fingerprint("box", "notification/false-action-needed"))
        ok("a candidate catalogue that drops a match: the rows file under their own families and that cluster no longer fires",
           rc == 0 and f"- no longer fires {NF}  box  notification/false-action-needed" in out and "only in the candidate: 4" in out)
        ok("…the baseline's catalogue is untouched by --candidate-catalogue", f"‼ {NF}" in out.split("candidate:")[0])
        rc, out, err = C("replay", "--candidate", cand2, "--candidate-catalogue", ccat)
        ok("…both together: the candidate executable runs with the candidate catalogue", rc == 1 and f"- no longer fires {NF}" in out and "crossing moved" in out)
        rc, out, err = C("replay", "--candidate-catalogue", CATALOGUE)
        ok("the same detector twice: no difference", rc == 0 and "no difference: the same clusters fire at the same moments" in out)
        mixed = os.path.join(T, "mixed.jsonl")
        with open(mixed, "w") as fh:
            fh.write('{"label": "real", "ts": "2026-09-01T10:00Z", "scope": "s", "kind": "a/b", "text": "a real event", "detector": "box"}\n')
            fh.write('{"label": "ctl", "control": "must not fire", "ts": "2026-09-02T10:00Z", "scope": "s", "kind": "a/b", "text": "a control in the same cluster", "detector": "box"}\n')
        rc, out, err = C("replay", mixed)
        ok("a control that shares a cluster with a real event is a fixture error: said, and rc 1", rc == 1 and "ERROR control 'must not fire' shares cluster" in out)
        rc, out, err = C("kinds")
        ok("kinds prints the catalogue's kinds and the critical reasons", rc == 0 and out.count("/") >= 6 and "person-first" in out and K in out)
        rc, out, err = C("sideways")
        ok("an unknown command is usage, rc 2", rc == 2)
    finally:
        shutil.rmtree(T, ignore_errors=True)
    print(f"cc-failures selfcheck: {n - f} passed, {f} failed")
    return 1 if f else 0

def load_in(env, scope):
    """The ledger as the tool under test reads it — `show ID` prints JSON; the selfcheck asks for the whole scope."""
    p = subprocess.run([os.path.join(B, "cc-failures"), "show", "--scope", scope, "--json"], capture_output=True, text=True, env=env)
    return json.loads(p.stdout) if p.returncode == 0 and p.stdout.strip() else []

# ---------------------------------------------------------------- argv
def opts(a, flags, lists=()):
    """--k v pairs → dict (lists collect); bare words → positional. Unknown --flag is usage."""
    out, pos, i = {k: [] for k in lists}, [], 0
    while i < len(a):
        x = a[i]
        if x.startswith("--"):
            k = x[2:]
            if k in ("all", "dry", "json"): out[k] = True; i += 1; continue
            if k not in flags and k not in lists: die(f"unknown option {x}\n{USAGE}")
            if i + 1 >= len(a): die(f"{x} needs a value")
            if k in lists: out[k].append(a[i + 1])
            else: out[k] = a[i + 1]
            i += 2
        else: pos.append(x); i += 1
    return out, pos

USAGE = "usage: cc-failures record|show|eligible|claim|packet|metrics|replay|import|kinds|selfcheck ...  (the docstring has the flags)"
def as_of(o):
    if not o.get("as-of"): return None
    t = parse_ts(o["as-of"])
    if not t: die(f"--as-of is a UTC stamp like 2026-09-11T17:20Z, got '{o['as-of']}'")
    return t

def main(a):
    if not a: die(USAGE)
    cmd = a[0]; a = a[1:]
    if cmd == "record":
        o, pos = opts(a, ("scope", "kind", "observed", "expected", "detector", "detector-evidence", "writer", "critical", "status", "ts", "corrects"), ("evidence", "cost", "link"))
        for k in ("scope", "kind", "observed"):
            if k not in o: die(f"record needs --{k}\n{USAGE}")
        ts = parse_ts(o["ts"]) if o.get("ts") else None
        if o.get("ts") and not ts: die(f"--ts is a UTC stamp like 2026-09-11T17:20Z, got '{o['ts']}'")
        links = {}
        for kv in o["link"]:
            if "=" not in kv: die(f"--link is k=v, got '{kv}'")
            k, v = kv.split("=", 1); links[k] = v
        status = o.get("status", "confirmed")
        if o.get("corrects"):
            # "Records are immutable; corrections append": the correction names the record, carries the status it
            # now has, and is folded in on every read. It must name a record the ledger holds.
            if "status" not in o: die("--corrects needs --status confirmed|asserted|refuted: the status the record now has")
            if not any(r["id"] == o["corrects"] for r in load(o["scope"])): die(f"no record {o['corrects']} in scope {o['scope']}")
        ids = add_record(o["scope"], o["kind"], o["observed"], expected=o.get("expected", ""), evidence=o["evidence"],
                         detector=o.get("detector", "unknown"), detector_evidence=o.get("detector-evidence", ""),
                         writer=o.get("writer", "session"), cost=o["cost"], links=links, critical=o.get("critical", ""),
                         status=status, ts=ts, corrects=o.get("corrects"))
        print(" ".join(ids))
    elif cmd in ("show", "eligible"):
        o, pos = opts(a, ("scope", "as-of"))
        recs = load(o.get("scope"))
        if cmd == "show" and o.get("json"):
            print(json.dumps(recs, indent=1)); return
        if cmd == "show" and pos:
            for r in recs:
                if r["id"] == pos[0] or r["cluster"] == pos[0]: print(json.dumps(r, indent=1))
            return
        cl = clusters(recs, as_of(o))
        if cmd == "eligible":
            for c in cl:
                if c["eligible"]: print(f"{c['id']}\t{c['scope']}\t{c['kind']}\t{c['eligible']}\t{c['episodes_14d']} episode(s)\t{c['first'][:16]}..{c['last'][:16]}\t{claim_word(c, as_of(o))}")
        else: render(cl, o.get("all"), as_of=as_of(o))
    elif cmd == "claim":
        o, pos = opts(a, ("scope", "as-of"))
        k = claim_one(o.get("scope"), as_of(o), dry=bool(o.get("dry")))
        if not k: sys.exit(1)
        print(f"{k['id']}\t{k['cluster']}\t{k['scope']}\t{k['kind']}\t{k['why']}\t{k['slot']}")
    elif cmd == "packet":
        o, pos = opts(a, ("as-of",))
        if len(pos) != 1: die("packet needs a claim or cluster id")
        packet(pos[0], as_of(o))
    elif cmd == "board":   # what `cc board failures <repo>` execs: the board's own heading, then the scope's clusters
        o, pos = opts(a, ("as-of",))
        if not pos: die("board needs a repo")
        print(f"\n\033[1m{pos[0]}\033[0m  failures  (cc-failures; the rule: critical, or {EPISODES_NEEDED} episodes in {WINDOW_DAYS} days)")
        render(clusters(load(pos[0]), as_of(o)), board=True, as_of=as_of(o)); print()
    elif cmd == "metrics":
        o, pos = opts(a, ("scope",))
        if pos: metrics_fixture(pos[0])
        else: metrics_ledger(o.get("scope"))
    elif cmd == "replay":
        o, pos = opts(a, ("catalogue", "candidate", "candidate-catalogue"))
        if len(pos) > 1: die("replay takes one events file")
        for k in ("catalogue", "candidate", "candidate-catalogue"):
            if o.get(k) and not os.path.isfile(o[k]): die(f"--{k}: no such file {o[k]}")
        sys.exit(replay(pos[0] if pos else EVENTS, o.get("catalogue"), o.get("candidate"), o.get("candidate-catalogue"), as_json=bool(o.get("json"))))
    elif cmd == "import":
        o, pos = opts(a, ())
        if len(pos) != 1: die("import needs a repo")
        import_board(pos[0], dry=bool(o.get("dry")))
    elif cmd == "kinds":
        cat = catalogue()
        print(f"catalogue v{cat.get('version')}: {os.path.normpath(CATALOGUE)}")
        for k, v in cat["kinds"].items(): print(f"  {k}\n      contract: {v.get('contract','')}\n      symptom:  {v.get('symptom','')}")
        print("critical reasons: " + ", ".join(f"{k} ({v})" for k, v in cat["critical"].items()))
    elif cmd == "selfcheck":
        sys.exit(selfcheck())
    else: die(USAGE)

if __name__ == "__main__":
    main(sys.argv[1:])
