#!/usr/bin/env bash
# cc-evals — the suite that verifies the SYSTEM, not the code. The three PR gates say the scripts still parse and
# still behave; this says the box can still do work it has already done. The REGRESSION set is deterministic and
# drives this box's own scripts, so what it gates is the control plane and the worker guard — never a model. The
# CAPABILITY set is where a model is graded: those cases put a question to one through `ask` and cost real money,
# which is why no nightly gate runs them. Design: <overlay>/docs/*-agent-evals-design.md
#   cc-evals run [--set regression|capability|all] [--case <name>] [--json] [--show] [--no-record] | list
#           | bless <case>
#           | last | selfcheck | ask [--budget N] [--schema <json>] < prompt
# A case is one file with its metadata in its own header (no second list to drift from it) and one function:
#   # @set: regression   # @kind: replay|property|capability   # @base: <sha>   # @title: …
#   probe(){ … }   rc 0 = the invariant holds · 1 = violated · 2 = INCONCLUSIVE (the probe could not run at all)
# rc 2 is INCONCLUSIVE in EVERY set, graded ones included: a usage limit or an API error means the question never
# reached the model, and reporting that as a wrong answer is the one false signal an A/B between models must not
# produce. It is soft outside the regression set, where a probe may need a live thing; there it is still red.
# A `replay` is judged on BOTH halves: it must FAIL on its pinned base snapshot and PASS on this tree. Head-passes
# alone is what selftest.sh already gives; base-fails is the proof the probe bites. A replay that passes at base is
# VACUOUS and counts as red — an eval that cannot fail proves nothing, and silently counting it green is worse than
# not having it. rc 2 on either side is INCONCLUSIVE and never PASS: a snapshot that will not run is not evidence.
set -uo pipefail
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"                 # the tree this copy ships with (core/)
TOP="$(git -C "$R" rev-parse --show-toplevel 2>/dev/null || echo "$R")"  # the repo: overlay root, or autobox itself
S="${CC_EVALS_HOME:-$HOME/.cc/evals}"        # snapshots, refs, salt, run records. NEVER in git — see `## refs` below
SNAP="$S/snap"; REFS="${CC_EVALS_REFS:-$S/refs}"; SALT_F="$S/salt"; RUNS="$S/runs"
CASES="${CC_EVALS_CASES:-}"
[ -n "$CASES" ] || for d in "$TOP/evals/cases" "$R/evals/cases"; do [ -d "$d" ] && { CASES="$d"; break; }; done
now_ms(){ local e=${EPOCHREALTIME:-}; e=${e//[!0-9]/}   # `date +%s%3N` is not portable: this box's date ignores the
  if [ ${#e} -ge 13 ]; then echo $(( e / 1000 )); else echo $(( $(date +%s) * 1000 )); fi; }   # width and prints ns
say(){ printf '%s\n' "$*"; }
die(){ printf 'cc-evals: %s\n' "$*" >&2; exit 2; }

# ---- case metadata: read out of the case file's own header, so adding a case adds nothing else ----
meta(){ sed -n "s|^#[[:space:]]*@$2:[[:space:]]*||p" "$1" | head -1; }
case_name(){ basename "$1" .sh; }
cases_all(){ [ -n "$CASES" ] && [ -d "$CASES" ] || return 0; find "$CASES" -maxdepth 1 -name '*.sh' | sort; }

# ---- the tree under test: a case reaches its scripts through $CC_EVALS_BIN and the tree they ship with through
# $CC_EVALS_ROOT, because that pair differs between a private overlay (core/bin, core/) and a bare autobox (bin, .)
# — a case must not have to know which of the two it is running on ----
tree_bin(){ if [ -d "$1/core/bin" ]; then echo "$1/core/bin"; else echo "$1/bin"; fi; }

# ---- snapshots: one `git archive` per pinned sha, kept. A replay's base must be FROZEN, so it is addressed by sha
# and extracted once; nothing here ever checks out, fetches, or touches the working tree. ----
snapshot(){   # snapshot <rev> -> prints the dir, or nothing and rc 1 when that commit is not in this clone
  local rev=$1 sha d
  sha=$(git -C "$TOP" rev-parse --verify --quiet "$rev^{commit}") || return 1
  d="$SNAP/$sha"
  if [ ! -d "$d" ]; then mkdir -p "$d.tmp.$$" || return 1
    git -C "$TOP" archive "$sha" | tar -x -C "$d.tmp.$$" || { rm -rf "$d.tmp.$$"; return 1; }
    mv "$d.tmp.$$" "$d" 2>/dev/null || rm -rf "$d.tmp.$$"; fi
  [ -d "$d" ] && printf '%s' "$d"
}

# ---- running one probe: its own scratch HOME, its own metrics file, and nothing of the caller's environment that
# could decide the answer. $CC_HANDOFF especially: a suite that inherits it asserts against whoever is running it,
# which cost four red gates in one night on 2026-08-31 (see selftest.sh's header) ----
PROBE_OUT=""; PROBE_COST=0; PROBE_LOOPS=0
run_probe(){   # run_probe <case-file> <tree> -> rc from the probe; sets PROBE_OUT/COST/LOOPS
  local f=$1 tree=$2 h m rc
  h=$(mktemp -d "${TMPDIR:-/tmp}/cc-evals-h.XXXXXX") || return 2
  m="$h/.metrics"; : > "$m"
  local tb; tb=$(tree_bin "$tree")
  # $CC_EVALS_ASK — the only door from a probe to a model, and a shim rather than a path because the probe's HOME is
  # a scratch dir with no credentials in it: the shim puts the REAL home back for the `claude` process alone, so a
  # probe can spend money without being able to read the home it spent it from. Every probe gets it, not just the
  # capability ones — a regression case that uses it goes red on the "must be free" rule below, which is the wall
  # that already exists and does not need a second one here.
  printf '#!/bin/sh\nHOME=%q exec %q ask "$@"\n' "$HOME" "$(readlink -f "$0")" > "$h/.ask" && chmod +x "$h/.ask"
  PROBE_OUT=$(
    export HOME="$h" CC_EVALS_METRICS="$m" CC_EVALS_TREE="$tree" CC_EVALS_BIN="$tb" CC_EVALS_ROOT="${tb%/bin}"
    export CC_EVALS_ASK="$h/.ask"
    export CC_NOTIFY_LOG_ONLY=1 CC_NOTIFY_LOG="$h/notify.log"   # a probe never pushes to the owner
    export TMUX_TMPDIR="$h"; unset TMUX     # …and never reaches the box's own tmux server: a probe that lists or
    unset CC_HANDOFF CC_ROLE                # kills windows must find an empty server of its own, not the live one
    cd "$h" || exit 2
    set +o pipefail +u   # a probe is judged on ITS OWN answer, never on the runner's shell options: with pipefail
                         # inherited, `cc ls | grep -q x` returns the SIGPIPE from the left side of a pipe grep had
                         # every right to close early, and a perfectly good probe reads as a failure
    exec </dev/null   # a probe NEVER inherits stdin: one `git` inside one probe ate the case list off the runner's
                      # loop and the run stopped half way through, reporting green on the half it had reached.
                      # The redirect belongs INSIDE here — `VAR=$(…) </dev/null` sets $? from the redirect, not the
                      # probe, which read as "base passed" and turned all six cases VACUOUS in one go.
    # shellcheck source=/dev/null
    . "$f" || exit 2
    probe "$tree" 2>&1
  ); rc=$?
  PROBE_COST=$(sed -n 's/^cost=//p' "$m" 2>/dev/null | awk '{s+=$1} END{printf "%.4f", s+0}')
  PROBE_LOOPS=$(sed -n 's/^loops=//p' "$m" 2>/dev/null | awk '{s+=$1} END{print s+0}')
  rm -rf "$h"; return $rc
}

# ---- ask: a capability probe's model call, and the only one it gets. What has to be true of every graded question
# lives here instead of in each case: one hardened arg set (no tools, no settings, no MCP, a turn cap, a budget cap),
# the spend appended to the probe's own metrics so no case can forget to report what it burned, and a usage limit
# answered with rc 2 — INCONCLUSIVE, because a question that never reached a model is not a model that answered
# wrong. The model is $CC_EVALS_MODEL, defaulting to the one the lander reviews with, and it is env-only rather
# than a flag because which model answered is a property of the RUN, not of one question — a case that could pick
# its own would grade a model nobody asked for. That one variable is also the whole of an A/B:
# `CC_EVALS_MODEL=claude-sonnet-5 cc-evals run --set capability` puts the same questions to the other model.
# Env: CC_EVALS_MODEL · CC_EVALS_BUDGET (dollars per question, default 0.50) · CC_EVALS_THINK (MAX_THINKING_TOKENS;
# unset = the CLI's own default) · CC_EVALS_CLAUDE (which binary — the selfcheck points it at a fake and spends 0).
#
# THE WALL. `--tools ""` is what actually leaves this call with nothing, and until 2026-09-06 it was the whole of
# it — one flag, and what a flag's default does after a harness release is not ours to promise. The two layers
# below are the same ones cc-brief carries: the escape hatches named (a probe once reached the shell
# through `Monitor`, not `Bash`), then the secret stores denied by path. This call is the least exposed of the seven
# — its prompt is a case file's own fixtures and a template read out of an already-landed commit, and a hostile
# case file has a shell before it ever reaches here — so this is depth, not a hole being closed. SECRET_PATHS is a
# COPY of cc-audit's; the selfcheck reads that file and goes red when an entry there is missing here.
SECRET_PATHS=".cc/config .cc/secrets/** .cc/members/** ccbox/env .ssh/** .claude/.credentials.json .claude.json .config/gh/**"
DENY="Bash,BashOutput,KillShell,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch,Agent,Task,Monitor,Workflow,Skill,ToolSearch,CronCreate,CronDelete,CronList,ScheduleWakeup,SendMessage,RemoteTrigger,PushNotification,DesignSync,ListAgents,EnterWorktree,ExitWorktree,Read,Grep,Glob,LS"
# `set -f` is load-bearing, not tidiness: $SECRET_PATHS is word-split on purpose, and four of its entries are
# globs. cc-evals is normally started from $HOME, where `.cc/members/**` EXPANDS (no globstar, so `**` is `*`)
# to the member directories that exist at that instant — and the rule then names the directory, leaving the
# credentials.json inside it undenied. Glob off, the words reach --disallowedTools as written.
set -f; for _s in $SECRET_PATHS; do DENY="$DENY,Read(/$HOME/$_s),Grep(/$HOME/$_s)"; done; set +f; unset _s
cmd_ask(){   # ask [--budget N] [--schema <json>] < prompt -> the answer on stdout; rc 2 = no answer
  local model=${CC_EVALS_MODEL:-claude-opus-5-5} budget=${CC_EVALS_BUDGET:-0.50} schema="" prompt j rc out cl wd
  while [ $# -gt 0 ]; do case $1 in
    --budget) budget=${2:?}; shift 2 ;; --schema) schema=${2:?}; shift 2 ;;
    *) die "ask: unknown option $1" ;; esac; done
  prompt=$(cat); [ -n "$prompt" ] || { printf 'cc-evals ask: no prompt on stdin\n' >&2; return 2; }
  cl=${CC_EVALS_CLAUDE:-claude}; command -v "$cl" >/dev/null 2>&1 || { printf 'cc-evals ask: no %s on PATH\n' "$cl" >&2; return 2; }
  # --max-turns 3, not 1: the structured-output round trip is not always one turn — Opus with thinking on came back
  # error_max_turns at 1 on questions Sonnet answered first time. There are no tools here, so a further turn can only
  # finish the answer, and what actually bounds a question is the budget cap.
  # $DENY as well as `--tools ""`: the .ask shim puts the REAL home back for this process (run_probe:68), so
  # the credentials and the keys are on the other side of one flag otherwise.
  local args=(-p --model "$model" --max-budget-usd "$budget" --max-turns 3 --output-format json
              --tools "" --setting-sources "" --strict-mcp-config --disable-slash-commands --no-session-persistence
              --disallowedTools "$DENY")
  [ -z "$schema" ] || args+=(--json-schema "$schema")
  j=$(mktemp) || return 2; local e; e=$(mktemp) || return 2
  # cwd is a scratch dir OUTSIDE the real home on purpose: a session reads CLAUDE.md from its cwd and upwards, and
  # HOME is this box's own tree, so asking from there would feed the box's instructions to the model being graded.
  wd=$(mktemp -d) || return 2
  # Two tries, and the second only for a blip: a case asks its questions one after another, so one API error late in
  # a nine-question run throws away the eight already paid for. A usage limit is NOT retried — it is answered by
  # waiting, not by asking again — and the budget cap is per question, so a retry cannot spend more than one more.
  local lim err=""
  for _ in 1 2; do
    ( cd "$wd" && printf '%s' "$prompt" | CC_ROLE=worker ${CC_EVALS_THINK:+MAX_THINKING_TOKENS=$CC_EVALS_THINK} \
        timeout 600 "$cl" "${args[@]}" > "$j" 2>"$e" ); rc=$?
    [ -z "${CC_EVALS_METRICS:-}" ] || printf 'cost=%s\n' "$(jq -r '.total_cost_usd // 0' "$j" 2>/dev/null)" >> "$CC_EVALS_METRICS"
    if lim=$("$(dirname "$(readlink -f "$0")")/cc-limit" check "$j" "$e" 2>/dev/null); then
      printf 'cc-evals ask: a Claude usage limit (%s) — no answer, not a wrong one\n' "$lim" >&2
      rm -f "$j" "$e"; rmdir "$wd" 2>/dev/null; return 2; fi
    out=$(jq -r 'if (.structured_output|type) == "object" then (.structured_output|tojson) else (.result // "") end' "$j" 2>/dev/null)
    if [ -n "$out" ] && [ "$(jq -r '.is_error // false' "$j" 2>/dev/null)" != true ]; then
      rm -f "$j" "$e"; rmdir "$wd" 2>/dev/null; printf '%s\n' "$out"; return 0; fi
    err=$(printf 'rc=%s %s %s %s' "$rc" "$(jq -r '.subtype // "no json"' "$j" 2>/dev/null)" \
          "$(jq -r '(.result // "")[0:120]' "$j" 2>/dev/null)" "$(tail -1 "$e" 2>/dev/null)")
  done
  printf 'cc-evals ask: no answer from %s after two tries (%s)\n' "$model" "$err" >&2
  rm -f "$j" "$e"; rmdir "$wd" 2>/dev/null; return 2
}

# ---- refs: the hidden half. A capability case's expected answer is never in the repo and never in plaintext — the
# stored ref is sha256(salt ‖ normalised output), so a worker that finds this directory can still only VERIFY. ----
norm(){   # everything that differs run to run, gone: colour, the scratch HOME, the tree path, trailing space
  sed -e 's/\x1b\[[0-9;]*m//g' -e "s|${2:-/nonexistent-tree}|<tree>|g" -e 's|/tmp/cc-evals-h\.[A-Za-z0-9]*|<home>|g' \
      -e 's/[[:space:]]*$//' <<<"$1" | sed -e '/./,$!d' | tac | sed -e '/./,$!d' | tac
}
salt(){ [ -s "$SALT_F" ] || { mkdir -p "$S"; chmod 700 "$S" 2>/dev/null; (umask 077; head -c 32 /dev/urandom | base64 > "$SALT_F"); }
        cat "$SALT_F"; }
digest(){ printf '%s\n%s' "$(salt)" "$1" | sha256sum | cut -d' ' -f1; }

# ---- one case, judged ----
VERDICT=""; DETAIL=""; DUR=0; COST=0; LOOPS=0
judge(){   # judge <case-file>
  local f=$1 kind base t0 rc bd brc name cs
  name=$(case_name "$f"); kind=$(meta "$f" kind); base=$(meta "$f" base); cs=$(meta "$f" set); cs=${cs:-regression}
  VERDICT=FAIL; DETAIL=""; COST=0; LOOPS=0; t0=$(now_ms)
  if [ "$kind" = replay ]; then
    if [ -z "$base" ]; then VERDICT=INCONCLUSIVE; DETAIL="a replay with no @base: nothing to prove it bites"
    elif ! bd=$(snapshot "$base"); then VERDICT=INCONCLUSIVE; DETAIL="base $base is not in this clone"
    else
      run_probe "$f" "$bd"; brc=$?
      case $brc in
        0) VERDICT=VACUOUS; DETAIL="the probe passes on base $base too — it does not test the fix" ;;
        2) VERDICT=INCONCLUSIVE; DETAIL="base $base could not run the probe: $(printf '%s' "$PROBE_OUT" | tail -1)" ;;
      esac
    fi
    [ "$VERDICT" = FAIL ] || { DUR=$(( $(now_ms) - t0 )); return; }   # base already decided it
  fi
  run_probe "$f" "$TOP"; rc=$?
  COST=$PROBE_COST; LOOPS=$PROBE_LOOPS
  if [ "$kind" = capability ]; then
    # A MISSING REF IS NOT A FREE PASS. `rm` on one ref used to turn its case SKIP, i.e. green — the cheapest way
    # to switch off the only graded case there is. It is SKIP on a box that has never blessed anything (a fresh
    # install genuinely has no answers yet) and red everywhere else: in the regression set always, and in the
    # capability set once this box holds any other ref, because then the ref went missing rather than never existed.
    # The ref check comes first because it is about this BOX, not about the answer: with no reference there is
    # nothing to compare against however the probe went. The rc arms below then split a wrong answer from no answer.
    if [ ! -s "$REFS/$name.ref" ]; then
      if [ "$cs" = regression ] || [ -n "$(find "$REFS" -maxdepth 1 -name '*.ref' -size +0c 2>/dev/null | head -1)" ]; then
        VERDICT=FAIL; DETAIL="no blessed reference on a box that has them — deleted, not never blessed (cc-evals bless $name)"
      else VERDICT=SKIP; DETAIL="no blessed reference (cc-evals bless $name)"; fi
    elif [ $rc -eq 2 ]; then VERDICT=INCONCLUSIVE; DETAIL=$(printf '%s' "$PROBE_OUT" | tail -1)
    elif [ $rc -ne 0 ]; then VERDICT=FAIL; DETAIL=$(printf '%s' "$PROBE_OUT" | tail -1)
    elif [ "$(digest "$(norm "$PROBE_OUT" "$TOP")")" = "$(cat "$REFS/$name.ref")" ]; then VERDICT=PASS
    else VERDICT=FAIL; DETAIL="output does not match the blessed reference"; fi
  else
    case $rc in 0) VERDICT=PASS ;; 2) VERDICT=INCONCLUSIVE; DETAIL=$(printf '%s' "$PROBE_OUT" | tail -1) ;;
      *) VERDICT=FAIL; DETAIL=$(printf '%s' "$PROBE_OUT" | tail -1) ;; esac
  fi
  # "the regression set is free" was a promise in the docs and nowhere in the code: the set is author-written and the
  # cost self-reported afterwards, so one case that starts calling a model would quietly put spend on every nightly
  # audit. A regression case that reports any spend is red, whatever else it did — move it to the capability set.
  if [ "$cs" = regression ] && awk -v c="$COST" 'BEGIN{exit !(c+0>0)}'; then
    VERDICT=FAIL; DETAIL="a regression case must be free — this one reported \$$COST (the capability set is where spend belongs)"
  fi
  DUR=$(( $(now_ms) - t0 ))
}

# ---- run ----
cmd_run(){
  local want=regression one="" json=0 record=1 show=0
  while [ $# -gt 0 ]; do case $1 in
    --set) want=${2:?}; shift 2 ;; --case) one=${2:?}; shift 2 ;;
    --json) json=1; shift ;; --no-record) record=0; shift ;; --show) show=1; shift ;;
    *) die "run: unknown option $1" ;; esac; done
  case $want in regression|capability|all) ;; *) die "run: --set must be regression, capability or all" ;; esac
  local f n=0 p=0 fl=0 vac=0 sk=0 inc=0 incr=0 tc=0 tl=0 rows="" t0; t0=$(now_ms)
  local list; list=$(cases_all)
  if [ -z "$list" ]; then
    say "cc-evals: no cases in ${CASES:-<none found>} — nothing to verify (a bare install has none)"; return 0; fi
  say "cc-evals: $want set"
  while IFS= read -r f <&3; do
    [ -n "$f" ] || continue
    local cs; cs=$(meta "$f" set); cs=${cs:-regression}
    [ "$want" = all ] || [ "$cs" = "$want" ] || continue
    [ -z "$one" ] || [ "$(case_name "$f")" = "$one" ] || continue
    n=$((n+1)); judge "$f"
    case $VERDICT in PASS) p=$((p+1));; FAIL) fl=$((fl+1));; VACUOUS) vac=$((vac+1));;
      SKIP) sk=$((sk+1));; INCONCLUSIVE) inc=$((inc+1)); [ "$cs" != regression ] || incr=$((incr+1));; esac
    tc=$(awk -v a="$tc" -v b="$COST" 'BEGIN{printf "%.4f", a+b}'); tl=$((tl + LOOPS))
    printf '  %-12s %-26s %-8s %5s  %s\n' "$VERDICT" "$(case_name "$f")" "$(meta "$f" kind)" \
      "$(awk -v m="$DUR" 'BEGIN{printf "%.1fs", m/1000}')" "$(meta "$f" title)"
    [ -z "$DETAIL" ] || printf '               ↳ %s\n' "$DETAIL"
    # --show: what the probe actually printed, which a graded case otherwise never shows — the verdict is a digest
    # match and says only same-or-different, and reading a model's answers item by item is the whole of an A/B.
    # It does not open the hidden half. What it prints is what THIS tree answered, which anyone could get by
    # running the case's own subject; what stays hidden is whether that is the blessed answer, and blessing is
    # still the owner's at a terminal.
    [ "$show" = 1 ] && [ -n "$PROBE_OUT" ] && printf '%s\n' "$PROBE_OUT" | sed 's/^/               | /'
    rows+=$(printf '{"name":"%s","set":"%s","kind":"%s","verdict":"%s","duration_s":%s,"cost_usd":%s,"loops":%s,"detail":"%s"}\n' \
      "$(case_name "$f")" "$cs" "$(meta "$f" kind)" "$VERDICT" \
      "$(awk -v m="$DUR" 'BEGIN{printf "%.3f", m/1000}')" "$COST" "$LOOPS" "$(printf '%s' "$DETAIL" | tr '"\n' "' " | tr -s ' ')")$'\n'
  done 3<<<"$list"
  local wall; wall=$(awk -v m="$(( $(now_ms) - t0 ))" 'BEGIN{printf "%.1f", m/1000}')
  # ONE verdict line, last, and it is what cc-audit shows: red or green, what it cost, how long, how many loops.
  # A REGRESSION CASE THAT COULD NOT RUN IS RED. An all-inconclusive run used to print "green — 0/10 passed": a
  # baseline that stopped running reads exactly like a baseline that holds, which is the failure mode the whole
  # suite exists to catch. Inconclusive stays soft only in the capability set, where a probe may need a live thing.
  local verdict="green"; [ $((fl + vac + incr)) -eq 0 ] || verdict="RED"
  local line
  line=$(printf 'cc-evals: %s — %s/%s passed, %s failed, %s vacuous, %s inconclusive, %s skipped · $%s, %ss, %s loops (%s set)' \
    "$verdict" "$p" "$n" "$fl" "$vac" "$inc" "$sk" "$tc" "$wall" "$tl" "$want")
  if [ "$record" = 1 ]; then mkdir -p "$RUNS" 2>/dev/null
    printf '%s' "$rows" | jq -s --arg s "$want" --arg v "$verdict" --arg st "$(date -u +%FT%TZ)" \
      --argjson c "$tc" --argjson d "$wall" --argjson l "$tl" \
      '{stamp:$st,set:$s,verdict:$v,cost_usd:$c,duration_s:$d,loops:$l,cases:.}' \
      > "$RUNS/$(date -u +%Y%m%dT%H%M%SZ).json" 2>/dev/null; fi
  if [ "$json" = 1 ]; then printf '%s' "$rows" | jq -s . ; fi
  say "$line"
  [ $((fl + vac + incr)) -eq 0 ]
}

cmd_list(){ local f; while IFS= read -r f; do [ -n "$f" ] || continue
  printf '%-26s %-11s %-11s %s\n' "$(case_name "$f")" "$(meta "$f" set)" "$(meta "$f" kind)" "$(meta "$f" title)"
  done <<<"$(cases_all)"; }

# Blessing is a PERSON's act, and the wall around it is `cc-settings apply`'s, for the same reason: the reference is
# the whole of what a graded case is judged against, so a process that can re-bless can grade itself. A worker that
# widened cc-guard could otherwise run `cc-evals bless cap-guard-decision-table` and freeze the widened table as the
# expected answer — the case would stay green through exactly the change it exists to catch.
bless_refuse(){ printf 'cc-evals bless: %s\n' "$1" >&2
  printf '  Deliberate: a blessed reference is the only thing a graded case is judged against, so only the owner\n' >&2
  printf '  writes one. Type `cc-evals bless %s` yourself in a shell on the box.\n' "$2" >&2; exit 3; }
cmd_bless(){   # bless <case> — run it HERE and freeze the answer, hidden.
  local name=${1:?usage: cc-evals bless <case>} f="$CASES/${1}.sh" d
  [ -z "${CC_ROLE:-}" ] || bless_refuse "refusing — CC_ROLE=${CC_ROLE} (a worker or member session)" "$name"
  d=$PWD; while [ -n "$d" ] && [ "$d" != / ]; do
    [ -e "$d/.cc/track" ] && bless_refuse "refusing — $d is a track worktree" "$name"; d=$(dirname "$d"); done
  { [ -t 0 ] && [ -t 1 ]; } || bless_refuse "refusing — no terminal (this is only ever typed by hand)" "$name"
  [ -f "$f" ] || die "no case $name in ${CASES:-<none>}"
  run_probe "$f" "$TOP" || die "$name does not pass here — nothing worth blessing"
  mkdir -p "$REFS"; chmod 700 "$S" "$REFS" 2>/dev/null
  (umask 077; digest "$(norm "$PROBE_OUT" "$TOP")" > "$REFS/$name.ref")
  say "cc-evals: blessed $name ($(wc -l <<<"$PROBE_OUT") lines, digest only — the answer itself is not stored)"
}

cmd_last(){ local f; f=$(find "$RUNS" -name '*.json' 2>/dev/null | sort | tail -1)
  [ -n "$f" ] || { say "cc-evals: no run recorded yet"; return 1; }
  jq -r '"cc-evals \(.stamp): \(.verdict) — \(.set) set, \([.cases[]|select(.verdict=="PASS")]|length)/\(.cases|length) passed, $\(.cost_usd), \(.duration_s)s, \(.loops) loops"' "$f"; }

# ---- selfcheck: the runner's own gate. Fixture cases in a temp dir, never this box's real ones. ----
selfcheck(){   # the cases are tests/selfcheck/cc-evals.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-evals.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  list) cmd_list ;;
  bless) shift; cmd_bless "$@" ;;
  last) cmd_last ;;
  ask) shift; cmd_ask "$@" ;;
  selfcheck) selfcheck ;;
  ""|-h|--help) sed -n '2,9p' "$0" | sed 's/^# \?//' ;;
  *) die "unknown command: $1 (run|list|bless|last|ask|selfcheck)" ;;
esac
