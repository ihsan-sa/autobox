#!/usr/bin/env bash
# cc-audit — hands-off recurring audit of this box: the mechanical checks, and no model reading them (the review
# half came out in shrink M3, docs/scaffolding.md). Reports live in ~/.cc/state/audit/; Slack gets ONE line (the
# long form goes to the control repo's channel canvas). Never fixes anything.
# It does own ONE thing, though: the `main-gate` board row. Every mode runs the `## suites` gates, and the first red one
# becomes a single row on the control repo's board that updates in place and closes itself on green — see main_gate().
#   cc-audit checks|auto|selfcheck [--dry] [--no-post]
#   cc-audit failure <claim> [--dry] [--no-post] [--no-llm]   one recorded failure cluster, investigated (FAILURE below; no checks, no gates)
#   checks = mechanical, no model: the `## suites` gates, the units, the daemon, disk, drift, spend — and the main-gate row.
#   auto (the timer, 03:30 UTC) = the gates, the main-gate row and the day's report, every day: a quiet day is quiet
#           to the owner, not blind to a red main. Nothing is posted: the canvas and the notify are `cc-audit checks`
#           by hand. The dated report is written all the same — the Slack Home tab and the canvas read that file.
#   selfcheck = the checks' own fixtures, the main-gate row against a real cc-board in a throwaway HOME, the failure
#           path against a stub model: no network, no spend, nothing written outside its own temp dir.
#   --dry: everything (reports, evidence) goes to a mktemp dir wiped on exit and the report prints to stdout — but
#          `failure` still SPENDS. --no-llm (implies --no-post) is `failure`'s: the packet only, no model.
# READ-ONLY BY CONSTRUCTION: the LLM child gets Read/Grep/Glob/LS and nothing that can write or run a command —
# see the three layers at the ALLOW/DENY definitions below. Everything it needs is collected by THIS script into
# <run>/evidence/ first, so it never needs a shell. CC_ROLE=worker is exported for anything that reads it, but the
# child loads no settings and therefore no hooks: cc-guard does NOT gate it — the tool set is the guarantee.
# FAILURE — `cc-audit failure <claim>` (docs/design-failure-noticing-2026-09-11.md, The investigation). The claim is a
# line cc-reconcile took with `cc-failures claim` (or a cluster id, by hand); `cc-failures packet` is the whole
# evidence. Two passes of the SAME Claude child, behind the SAME wall: the broad pass (Sonnet) notices the pattern,
# locates the origin and writes a hypothesis, a rival and one test into a handoff; the narrow pass (a fresh context
# on the band the handoff names — routine Sonnet, interacting Opus, authority Opus at xhigh) runs that test. Caps for the job,
# broad pass included: $1 routine, $2 the other two; BUD_FAIL_BROAD is the broad pass's share ($0.60: why, at its
# line). `TEST: none` in the handoff means no narrow pass. A pass that ends without a result — budget, turns, timeout,
# an error — is named as such in the report, the message and audit.log (the JSON's subtype and is_error, via
# llm_why), never as a bare exit code.
# THREE STATES, AND ONLY THE FIRST IS A RESULT. A pass RAN AND FAILED (budget, turns, timeout, a model error): it
# happened and it cost money, and it stays booked as a failed run. A pass was REFUSED OR POSTPONED by a limit (the
# shared usage-limit stamp, or the account's monthly spend cap in the run's own JSON — see SPEND_REFUSED_RE): nothing
# ran and nothing was spent, so it is a deferral, not a try. A pass DID NOT RUN (no handoff to carry, no
# discriminating test). The report is written in every case, because a cluster nobody investigated has to stay
# visible — but when nothing was investigated it opens with
# `**Not investigated (deferred|failed):** <why> · again after <stamp>`, and cc-failures reads that line: the claim is
# offered again at the stamp instead of reading `reported`. Nothing was investigated when the broad pass left no
# handoff, and equally when the narrow pass — the discriminating test — was refused before it ran (i-b3fc3b8b).
# Same vocabulary as a usage-limited review in cc-land (`attempts - 1`, stage deferred): a run that never
# happened costs the work nothing and comes back.
# The report goes to ~/.cc/failures/reports/<claim>.md (CC_FAILURES moves the dir)
# and is delivered as ONE message with the file (cc-slack post --file), to the control repo's -updates lane
# (CC_AUDIT_FAILURE_TO names another, a test chat) — never top level in #<control repo>, which is the owner's, and
# with no "Decision:" head that reads like his card (the narrow pass's first line is re-headed "Review:"). No
# mention, no canvas, no board row: a finding cannot make work. Only when that post fails does it go to the seat
# instead, as one `cc-notify --ask` (--id failure-report:<claim>) naming the report. The tier is the launcher's
# check, not this file's: run by hand it runs.
# THE FAILURE LEDGER IS WRITTEN RULE-BASED, NO MODEL (docs/design-failure-noticing-2026-09-11.md).
# THE PIPELINE CHECKS ITSELF in `## failures` under checks: the ledger's door writes (a probe record into a scratch
# ledger), every producer the design names still calls cc-failures (a writer refactored away records nothing, and
# nothing else would notice), and an eligible cluster unclaimed for two reconcile passes while the investigation is on
# and the tier allows it is the pipeline stalled, not a quiet day. See pipeline_check.
# Env: CC_AUDIT_DATE=YYYY-MM-DD (tests) · CC_CLAUDE (stub the model) · CC_AUDIT_BUDGET_FAILURE_BROAD (the broad pass's
# share) · CC_AUDIT_FAILURE_TO (where the failure report is posted; default #<control repo>-updates).
set -uo pipefail
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac; export PATH   # systemd-started: no ~/bin
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"; cd "$R" || exit 1   # run the INSTALLED ~/bin/cc-audit: a worktree copy fails the suites (they assert against the live install)
BOX="${CC_BOX:-$(hostname -s)}"                                    # notify titles and report headings
CTL="$BOX"; case "$R" in "$HOME/dev/"*) CTL=${R#"$HOME/dev/"}; CTL=${CTL%%/*};; esac   # the control repo = the one this copy lives in: its Slack channel + board
AD="$HOME/.cc/state/audit"; LOG="$AD/audit.log"; mkdir -p "$AD"
CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"; LIMIT="$(dirname "$(readlink -f "$0")")/cc-limit"   # sibling, like the rest: a worktree copy uses its own
# The main-gate row is written through the CLI and never into the board file. Off $R, not $0 like LIMIT above: the cd
# on line 3 has already happened by here, so a relative `core/bin/cc-audit` no longer resolves through readlink -f.
BOARD="${CC_BOARD:-$R/bin/cc-board}"
cfgval(){ "$R/bin/cc-config" get "$1"; }   # the one reader of ~/.cc/config: it never sources that file, and exports nothing from it
CAP_ROUTINE=1; CAP_STRONG=2   # the failure job: "$1 routine, $2 strong", two passes inside it; the split below moves, the caps do not
# THE BROAD PASS'S SHARE. A Sonnet read of a real packet costs $0.33-0.35 when it finishes (i-a0410573, i-e9fb26ce), and
# claude checks the budget BETWEEN turns, so a run passes the cap by a turn before it is killed: at $0.40 the first live
# investigation (i-b3fc3b8b, 2026-09-12) died at $0.44 with no handoff, and the narrow pass never ran. $0.60 clears the
# measured read with a turn to spare and still leaves the routine narrow pass (measured $0.32) its $0.40 of the $1 cap.
BUD_FAIL_BROAD="${CC_AUDIT_BUDGET_FAILURE_BROAD:-0.60}"
stamp_init(){   # ONE UTC clock read for both: the header's date is the report's date, even at 23:59:59Z, and a
  local now      # CC_AUDIT_DATE (tests) pins the date beside the time rather than leaving the real day next to it.
  now="$(date -u +%FT%TZ)"; DAY="${CC_AUDIT_DATE:-${now%T*}}"; STAMP="${DAY}T${now#*T}"
}
stamp_init
header(){ printf '# %s audit — checks — %s\n' "$BOX" "$STAMP"; }   # the one place date and time are joined
log(){ printf '%s\t%s\n' "$STAMP" "$*" >> "$LOG"; }
USAGE="usage: cc-audit checks|auto|selfcheck [--dry] [--no-post] | failure <claim> [--dry] [--no-post] [--no-llm]"

mode=""; dry=0; post=1; llm_on=1; gate_only=0; FID=""; want_id=0
for a in "$@"; do
  if [ "$want_id" = 1 ]; then FID="$a"; want_id=0; continue; fi
  case "$a" in
  checks|auto) mode="$a" ;;
  failure) mode="$a"; want_id=1 ;;
  selfcheck) mode="$a"; dry=1; post=0 ;;   # --dry already guarantees the one thing a selfcheck must guarantee: it writes nothing real
  --dry) dry=1; post=0 ;;
  --no-post) post=0 ;;
  --no-llm) llm_on=0; post=0 ;;   # `failure` only: the packet, no model, nothing posted
  *) echo "$USAGE" >&2; exit 2 ;;
esac; done
[ -n "$mode" ] || { echo "$USAGE" >&2; exit 2; }
[ "$mode" != failure ] || [ -n "$FID" ] || { echo "cc-audit: failure needs a claim id (cc-failures claim)" >&2; echo "$USAGE" >&2; exit 2; }
# THE TIMER'S DAY IS QUIET IN SLACK, NOT QUIET ON DISK: checks, the main-gate row, the dated report, nothing posted.
# It used to exit before the gates on a day with no review due, which left the main-gate row up to three days stale —
# and a baseline that is red for three days is exactly the week rec #9 came out of. The report is written because the
# Slack Home tab and the #<repo> canvas both read the newest ~/.cc/state/audit/<date>-checks.md, and a timer that
# touched only the board left both of them on a report days old. No canvas, no notify: `cc-audit checks` by hand posts.
if [ "$mode" = auto ]; then mode=checks; gate_only=1; log "auto: $DAY — the gates, the main-gate row, the report"; fi
OUTDIR="$AD"; [ "$dry" = 1 ] && { OUTDIR=$(mktemp -d "${TMPDIR:-/tmp}/cc-audit.XXXXXX") && trap 'rm -rf "$OUTDIR"' EXIT || exit 1; }
EV="$OUTDIR/$DAY-$mode/evidence"; mkdir -p "$EV" || exit 1
prev=$(ls -t "$AD"/*-checks.md 2>/dev/null | head -1)   # the last report: the window for "since the last run"
SINCE_TS=$(date -u -d "$DAY -1 days" +%s)   # the window never shrinks below a day
if [ -n "$prev" ]; then p=$(stat -c %Y "$prev" 2>/dev/null || echo 0); [ "$p" -lt "$SINCE_TS" ] && SINCE_TS=$p; fi
SINCE=$(date -u -d "@$SINCE_TS" +'%F %T')

# ---- checks: every check records PASS/FAIL and CONTINUES; one broken check never ends the run ----
pass=0; fail=0; RPT=""; SUITE_FAIL=""
add(){ RPT+="$1"$'\n'; }
row(){ local st=$1; shift; add "- **$st** $*"; if [ "$st" = PASS ]; then pass=$((pass+1)); else fail=$((fail+1)); fi; }
ck(){ local st=FAIL; [ "$1" = 0 ] && st=PASS; shift; row "$st" "$@"; }   # ck <rc> <text…>
tf(){ if "$@"; then echo 0; else echo 1; fi; }                          # a condition as an rc, e.g. ck "$(tf test 1 -lt 2)" …
fail_line(){   # fail_line <output> <summary> — the first line of a failure somebody can ACT on. A suite opens with a
  local o l    # banner and ends with a tally, and neither says what broke; the ✗ line does. No such line: the tally.
  # A PASS is never the failure, whatever its text says: "✓ …cc-notify FAILS…" matched FAIL and titled this row for
  # a week while the real ✗ sat further down. So passes are dropped, and a ✗ outranks an earlier line merely saying error.
  o=$(printf '%s\n' "$1" | sed 's/\x1b\[[0-9;]*m//g' | grep -avE '^[[:space:]]*(✓|ok )')
  l=$(grep -m1 -aE '✗|✘|^[[:space:]]*not ok' <<<"$o" || grep -m1 -aE 'FAIL|Fail|ERROR|Error|error:' <<<"$o")
  short "$(printf '%s' "${l:-$2}" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//')"
}
gate(){   # gate <rc> <name> <summary> <output> — a `## suites` check, which also feeds the main-gate row
  ck "$1" "$2 — $3"
  # The FIRST red gate owns the row; a later one is the same red. Five workers meeting one broken baseline is what
  # this replaces, and five rows would be that same week over again with a board standing in for the five journals.
  [ "$1" = 0 ] || [ -n "$SUITE_FAIL" ] || SUITE_FAIL="$2 — $(fail_line "${4:-}" "$3")"
}
slack_probe(){   # slack_probe <cc-slack status output> — prints the line worth showing, rc 0 when the daemon is connected.
  # The WHOLE output, never a fixed line. This read `sed -n 3p`, PR #92 reshuffled status so line 3 became the policy
  # line, and the check sat red against a daemon that was up the entire time. A line's POSITION is not a contract.
  local dl; dl=$(grep -m1 -aE 'connected|^daemon:' <<<"$1")
  short "$(printf '%s' "${dl:-${1:-no status}}" | tr -s '[:space:]' ' ')"
  grep -qaw connected <<<"$1"   # -w, or "slack disconnected" passes on the substring: the down case must not read as up
}
spend_since(){   # spend_since <state root> <epoch> — worker $ since <epoch>, summed PER FILE and skipping what will
  # not parse. One `jq -s` over every run json concatenated failed WHOLE on a single bad document — and a worker
  # mid-run always has a half-written one — so on exactly the busy days this matters, spend reported $0.00.
  find "$1" -path '*/runs/*.json' -newermt "@$2" -print0 2>/dev/null |
    xargs -0 -I{} jq -r '.total_cost_usd // 0' {} 2>/dev/null | awk '{s+=$1} END{printf "%.2f", s+0}'
}
# ---- the failure ledger: findings that name a kind, and the pipeline's own check ----
FAILURES="${CC_AUDIT_FAILURES_BIN:-$R/bin/cc-failures}"   # the ledger's one door; a test points it at a stub
PRODUCERS="cc-reconcile cc-guard cc-audit"   # the writers this branch wires, plus this file; cc-land cc-green cc-loop join when their writers land (track a-red-gate-is-recorded-by-the-tool-that-saw-it)
pipeline_check(){   # pipeline_check <bin dir> — `## failures` rows into the report; mechanical, reads the objects themselves
  local bin=$1 scratch o rc p miss="" oldest=0 nel=0 age u v inv="off" tier="" word
  scratch=$(mktemp -d)
  o=$(CC_FAILURES=$scratch "$FAILURES" record --scope _ccaudit --kind pipeline/probe --observed "cc-audit probe" --writer cc-audit 2>&1); rc=$?
  rm -rf "$scratch"; ck $rc "failure ledger — cc-failures record $([ $rc = 0 ] && echo writes || echo "fails: $(short "$o")")"
  for p in $PRODUCERS; do [ -f "$bin/$p" ] && grep -q 'cc-failures' "$bin/$p" || miss="$miss $p"; done
  ck "$(tf test -z "$miss")" "failure writers — every producer names cc-failures${miss:+; broken:$miss}"
  # the oldest unclaimed eligible cluster, in minutes: `eligible` ends each line with `unclaimed 3d 6h` or `claimed …`
  while IFS=$'\t' read -r _ _ _ _ _ _ word; do
    case "$word" in unclaimed*) ;; *) continue;; esac
    nel=$((nel+1)); age=0
    for u in ${word#unclaimed }; do v=${u%?}; case "$u" in *d) age=$((age + v*1440));; *h) age=$((age + v*60));; *m) age=$((age + v));; esac; done
    [ "$age" -gt "$oldest" ] && oldest=$age
  done < <("$FAILURES" eligible 2>/dev/null)
  [ "$(cfgval CC_FAILURES_INVESTIGATE | tr 'A-Z' 'a-z')" = on ] && inv=on
  "$R/bin/cc-tier" allows explore >/dev/null 2>&1 && tier=allows || tier=holds
  if [ "$inv" = on ] && [ "$tier" = allows ]; then
    ck "$(tf test "$oldest" -le 40)" "failure pipeline — $nel eligible cluster(s) unclaimed, oldest ${oldest} min (two reconcile passes is 40)"
  else ck 0 "failure pipeline — $nel eligible cluster(s) unclaimed, oldest ${oldest} min; not stalled: investigation $inv, tier $tier explore"; fi
}

checks(){
  add "$(header)"; add ""; add "_window: since $SINCE UTC_"; add ""; add "## suites"
  # THE BASELINE. Red here belongs to main, not to whichever track happens to run next — every one of them hits it
  # and none of them can own it. So these go through gate(), and main_gate() below turns the first red into ONE row.
  local o rc
  o=$(bash tests/check.sh 2>&1); rc=$?; gate $rc "tests/check.sh" "$(printf '%s' "$o" | tail -1)" "$o"
  o=$(env -u CC_ROLE CC_NOTIFY_LOG_ONLY=1 tests/selftest.sh </dev/null 2>&1); rc=$?
  gate $rc "tests/selftest.sh" "$(printf '%s' "$o" | grep -o '== result:.*==' | tail -1)" "$o"
  o=$(cc-slack selfcheck 2>&1); rc=$?; gate $rc "cc-slack selfcheck" "$(printf '%s' "$o" | tail -1)" "$o"
  o=$(bin/cc-vitals selfcheck 2>&1); rc=$?; gate $rc "cc-vitals selfcheck" "$(printf '%s' "$o" | tail -1)" "$o"
  o=$(bin/cc-units selfcheck 2>&1); rc=$?; gate $rc "cc-units selfcheck" "$(printf '%s' "$o" | tail -1)" "$o"
  o=$(bin/cc-settings selfcheck 2>&1); rc=$?; gate $rc "cc-settings selfcheck" "$(printf '%s' "$o" | tail -1)" "$o"
  # The eval suite — the only gate here that asks whether the box can still DO its work, rather than whether its
  # scripts still parse. The regression set is the cheap half (seconds, no spend, no LLM); the full run is a
  # person's command before a model/harness/prompt change. Its last line IS the verdict, so it is the summary.
  # A tree with no cases (a bare install) says so and exits 0 — that is not a red, and not a green it did not earn.
  o=$(bin/cc-evals run --set regression 2>&1); rc=$?; gate $rc "cc-evals" "$(printf '%s' "$o" | tail -1)" "$o"
  add ""; add "## services"
  # Every unit in config/units.json, to that unit's own policy — no list here. The old list named five and the
  # installer enabled eight, so the model, reconcile and publish timers could land switched off unseen; and a
  # timer that is `active` but has no next trigger (a reloaded, unrestarted OnCalendar) counted as up.
  o=$(bin/cc-units check 2>&1); rc=$?; ck $rc "$o"
  local hb age; hb=$(cat "$HOME/.cc/state/heartbeat" 2>/dev/null); age=$(( $(date -u +%s) - $(date -u -d "${hb:-@0}" +%s 2>/dev/null || echo 0) ))
  ck "$(tf test "$age" -lt 60)" "heartbeat — ${age}s old (want < 60)"
  o=$(slack_probe "$(cc-slack status 2>&1)"); rc=$?; ck $rc "slack daemon — $o"
  local errs; errs=$(journalctl --user -u cc-slackd --since "$SINCE" --no-pager 2>/dev/null | grep -ciE 'error|traceback')
  ck "$(tf test "${errs:-0}" -le 5)" "cc-slackd journal — $errs error/traceback lines since $SINCE (fail above 5)"
  add ""; add "## host"
  local disk load
  disk=$(df -P / | awk 'NR==2{print $5}'); ck "$(tf test "${disk%\%}" -lt 85)" "disk / — $disk used (want < 85%)"
  load=$(cut -d' ' -f1-3 /proc/loadavg); ck "$(tf awk -v l="${load%% *}" -v n="$(nproc)" 'BEGIN{exit !(l < n*2)}')" "load — $load on $(nproc) cores"
  # The MANAGED subset only. This used to diff the whole file and fail on "N lines differ", which weighed a theme
  # change exactly as much as an unregistered hook — so it sat red for days with a real gate missing inside it and
  # nobody could tell. cc-settings names what is unapplied, and a user's own keys are not drift.
  o=$(bin/cc-settings check 2>&1); rc=$?; ck $rc "$o"
  add ""; add "## install"
  local f miss=0 dang
  for f in bin/*; do [ -f "$f" ] && [ -x "$f" ] || continue
    [ -x "$HOME/bin/$(basename "$f")" ] || miss=$((miss+1)); done   # -x follows the link, so a dangling one fails too
  dang=$(find "$HOME/bin" -maxdepth 1 -type l ! -xtype f 2>/dev/null | wc -l)
  ck "$(tf test $((miss + dang)) -eq 0)" "$HOME/bin links — $miss of bin/* unlinked, $dang dangling"
  local hd="$R/../home" tot=0                 # the private overlay's ~ docs (a bare core clone has none)
  miss=0; for f in "$hd"/*.md; do [ -f "$f" ] || continue; tot=$((tot+1)); [ -L "$HOME/$(basename "$f")" ] || miss=$((miss+1)); done
  ck "$(tf test "$miss" -eq 0)" "home doc symlinks — $miss of $tot missing"
  add ""; add "## failures"
  pipeline_check bin
  add ""; add "## leftovers"
  local old orph stale
  old=$(docker ps -a --filter status=exited --filter name=ccbox --format '{{.Names}} {{.Status}}' 2>/dev/null | grep -cE 'day|days|weeks|months')   # "About a day ago" counts
  ck "$(tf test "${old:-0}" -eq 0)" "ccbox containers — $old stopped for a day or more"
  orph=0; for f in "$HOME"/.cc/worktrees/*/*; do [ -d "$f" ] || continue
    cc-board get "$(basename "$(dirname "$f")")" "$(basename "$f")" title >/dev/null 2>&1 || orph=$((orph+1)); done
  ck "$(tf test "$orph" -eq 0)" "worktrees — $orph with no board entry"
  stale=$(jq -r '.projects // {} | keys[]' "$HOME/.claude.json" 2>/dev/null | while read -r f; do [ -d "$f" ] || echo x; done | wc -l)
  ck "$(tf test "${stale:-0}" -eq 0)" "$HOME/.claude.json trust — $stale entries whose dir is gone"
  add ""; add "- worker spend since $SINCE: \$$(spend_since "$HOME/.cc/state" "$SINCE_TS")"
}

# ---- the main-gate row: ONE board row that owns "main's own suite is red" ----
# In one week five workers hit the same red baseline, five journals said "pre-existing, not mine", all five were
# right, and nobody owned it (arch review 2026-08-31, rec #9). This row is the owner. The rules ARE the design:
#   · ONE row, fixed track name, and this function is the only thing that writes it. Never a second, never per-run.
#   · The SAME red writes nothing at all — not a note, not a timestamp. A red that has not changed is not news, and
#     a row that renoises itself every run is the thing this replaces.
#   · Green closes it. The row exists only while main is red, so its presence on the board is the whole message.
#   · ONCE SOMEBODY STARTS IT, IT IS THEIRS: a row with a worktree (or started) is an ordinary track from then on and
#     this function only ever reads it. cc-reconcile decides a started track's status, and two writers would fight.
# `queued` is deliberate and not interchangeable: it is the one live status cc-reconcile does not read as broken when
# there is no worktree ("a queued track has never been started: it is SUPPOSED to have no worktree"). `blocked` would
# have reconcile report "its worktree is gone" to the owner every single run.
MG=main-gate
mg_get(){ "$BOARD" get "$CTL" "$MG" "$1" 2>/dev/null; }
mg_adopted(){ local wt; wt=$(mg_get worktree)          # the row's OWN worktree, defaulted the way cc-reconcile defaults it
  [ -d "${wt:-$HOME/.cc/worktrees/$CTL/$MG}" ] && return 0
  case "$(mg_get started)" in True|true|1|yes) return 0 ;; *) return 1 ;; esac; }
main_gate(){   # main_gate <"<gate> — <first line>" | ""> — idempotent: the same argument twice writes once
  local f=$1 have title
  have=$(mg_get title) || true
  if [ -z "$f" ]; then
    [ -n "$have" ] || return 0                     # green, no row: the normal day, and it says nothing
    case "$have" in "main is red: "*) ;;           # the one destructive thing here only ever undoes cc-audit's own
      *) log "main-gate: a row this did not write is sitting on that name — left alone"; return 0 ;; esac
    mg_adopted && { log "main-gate: green, but it was started — its worker and cc-reconcile close it"; return 0; }
    "$BOARD" rm "$CTL" "$MG" >/dev/null 2>&1 || { log "main-gate: board rm failed"; return 1; }
    log "main-gate: green — row closed"; return 0
  fi
  title="main is red: $f"
  [ "$have" = "$title" ] && return 0               # same red, same row: nothing to write
  mg_adopted && { log "main-gate: still red, already started — left to its worker"; return 0; }
  # this row is cc-audit's own writing, not a brief someone typed: it goes past both of cc-brief's gates without
  # being counted as an override a person made, so nothing a judge says can swallow the red-main alert.
  CC_BRIEF_MACHINE=1 "$BOARD" add "$CTL" "$MG" "$title" \
    "main's own suite is red — every track dispatched now hits it and none of them can own it. Reproduce: \`cc-audit checks --dry\`. Fix on a branch off the default branch; cc-audit closes this row itself when the suite is green." \
    >/dev/null 2>&1 || { log "main-gate: board add failed (no board for $CTL?)"; return 1; }
  "$BOARD" note "$CTL" "$MG" "$STAMP $f" >/dev/null 2>&1
  log "main-gate: red — $title"
}

# ---- evidence: THIS script runs every command; the LLM only reads the files ----
scrub(){ sed -ri 's/xox[abpesr]-[A-Za-z0-9-]{6,}|gh[posru]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-ant-[A-Za-z0-9_-]{10,}/[redacted-token]/g' "$EV"/* 2>/dev/null; }

# ---- the model passes (`failure`'s two): no Bash, no writes, evidence-only ----
# Read-only by construction, in three layers, because no one of them is enough:
#   --setting-sources ''  ~/.claude/settings.json is NOT loaded, so its wide allow tier cannot union with the
#                         allow-list below; the allow-list becomes the session's whole permission surface. (It also
#                         drops the hooks, so a nested run can never checkpoint-commit either.)
#   --strict-mcp-config   with no --mcp-config, every MCP server is off: no cc-slack channel tool to post with.
#   --disallowedTools     names the escape hatches that are exposed without asking permission. `Bash` alone is NOT
#                         enough: a probe run reached the shell through `Monitor` and wrote a file (2026-08-27).
# Verified adversarially: a run ordered to create ./probe.txt by any means answers BLOCKED and creates nothing.
# Read/Grep ARE scopeable by path — `//abs/path` in a rule is one leading `/` plus $HOME, hence "/$HOME" below —
# so the secret stores are denied too; the evidence dir under ~/.cc/state stays readable. Verified: a run told to
# read ~/.cc/config gets "Permission to read … has been denied" from Read AND from Grep.
ALLOW="Read,Grep,Glob,LS"
DENY="Bash,BashOutput,KillShell,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch,Agent,Task,Monitor,Workflow,Skill,ToolSearch,CronCreate,CronDelete,CronList,ScheduleWakeup,SendMessage,RemoteTrigger,PushNotification,DesignSync,ListAgents,EnterWorktree,ExitWorktree"
# THE CANONICAL LIST. cc-land, cc-evals and cc-voice each keep a copy, because
# each of those files stands alone and imports no sibling — and a hand-copied list is how this one lost .cc/secrets
# in three files and .cc/members in six, each found by a person in a separate paid review. It is not hand-kept any
# more: every copy's selfcheck READS THIS LINE and fails when an entry here is missing there, so a path added here
# and nowhere else is a red gate. Keep the assignment on one line and quoted — that is what those cases parse.
SECRET_PATHS=".cc/config .cc/secrets/** .cc/members/** ccbox/env .ssh/** .claude/.credentials.json .claude.json .config/gh/**"
set -f; for s in $SECRET_PATHS; do   # set -f: four entries are globs, and this loop word-splits on purpose. Nothing
  DENY="$DENY,Read(/$HOME/$s),Grep(/$HOME/$s)"   # matches from $R, so this file was safe by accident; cc-evals was not.
done; set +f
LLM_COST=0
POSTPONED=""; DEFER_UNTIL=""   # the last run's deferral: why it never ran, and when it is worth trying again
DEFER_AGAIN=3600   # a deferral whose cause names no reset (a spend cap) comes back in an hour: being refused again costs nothing
# THE BOX'S BILLING STATE IS NOT THE MODEL FAILING THE TASK. i-b3fc3b8b's narrow pass came back {subtype: success,
# is_error: true, result: "You've hit your monthly spend limit …"} and was written down as a failed run on
# claude-fable-5-1. cc-limit reads a spend cap as a limit only when the message ALSO names a reset (its LIMIT_RE);
# that one named none, so it answered "not a limit" and the refusal fell through to llm_why. The wording is cc-limit's
# SPEND_RE, kept here because this is the only caller that has to tell a refusal from a failure after cc-limit passes.
SPEND_REFUSED_RE='spend(ing)? limit|spend cap|monthly (spend|usage) (limit|cap)'
dur(){ local s=${1:-0}; if [ "$s" -lt 90 ]; then printf '%ss' "$s"; else printf '%sm %ss' $((s/60)) $((s%60)); fi; }   # how long it ran, in the report: the only cost signal this mode has
postponed(){   # postponed <out> <why> [until-epoch] — the pass was refused or postponed: it never ran, so it is no result
  printf '_(postponed: %s — the next scheduled run picks this up)_\n' "$2" > "$1"; log "llm $1 postponed: $2"   # $2 names the model too
  POSTPONED="$2"; DEFER_UNTIL=$(date -u -d "@${3:-$(( $(date +%s) + DEFER_AGAIN ))}" +%FT%TZ); }
llm(){   # llm <out-file> <budget> <prompt> [model] [effort] — 20 min hard cap; a failed run leaves a stub and never aborts the audit
  local out=$1 bud=$2 prompt=$3 model=${4:-claude-opus-5-5} eff=() j rc res p mins; j=$(mktemp)
  [ -n "${5:-}" ] && eff=(--effort "$5")   # no effort named = the model's own default
  LLM_WHY=""; POSTPONED=""; DEFER_UNTIL=""; LLM_COST=0   # neither a postponed nor a failed run leaves the other's cause — or an earlier pass's cost — behind
  if p=$("$LIMIT" status 2>/dev/null); then   # a limit any run on this box hit: no LLM, no retry loop — the timer comes back
    mins=$(sed -n 's/.*(\([0-9]\{1,\}\)m left).*/\1/p' <<<"$p")   # "usage limit until HH:MMZ (37m left)": the reset, as a delta
    postponed "$out" "Claude $p" "$(( $(date +%s) + ${mins:-60} * 60 ))"; rm -f "$j"; return 1; fi
  CC_ROLE=worker timeout 20m "$CLAUDE" -p "$prompt" --model "$model" "${eff[@]}" --max-budget-usd "$bud" --max-turns 60 \
    --output-format json --setting-sources '' --strict-mcp-config --disable-slash-commands \
    --allowedTools "$ALLOW" --disallowedTools "$DENY" >"$j" 2>>"$LOG"
  rc=$?
  if p=$("$LIMIT" check "$j" 2>/dev/null); then   # hit it mid-audit: record it, postpone, leave the stamp for everyone else
    postponed "$out" "Claude usage limit until $(date -u -d "@${p#LIMIT }" +%H:%M)Z" "${p#LIMIT }"; rm -f "$j"; return 1; fi
  # …and the refusal cc-limit does not call a limit: a spend cap this account has hit. Refused, not run (SPEND_REFUSED_RE above).
  if [ "$(jq -r '.is_error // false' "$j" 2>/dev/null)" = true ] && grep -qiE "$SPEND_REFUSED_RE" <<<"$(jq -r '.result // empty' "$j" 2>/dev/null)"; then
    postponed "$out" "the account's monthly spend limit — no reset lifts it, only raising it at claude.ai/settings/usage"; rm -f "$j"; return 1; fi
  res=$(jq -r '.result // empty' "$j" 2>/dev/null); LLM_COST=$(jq -r '.total_cost_usd // 0' "$j" 2>/dev/null)
  # A RUN THAT ENDED WITHOUT A RESULT SAYS WHY, never a bare exit code: the JSON's subtype and is_error name the cause
  # (i-b3fc3b8b, 2026-09-12: the report said `rc=1` and the owner had to ask what happened). is_error true is a failed run whatever `.result` holds — that text is the error, not a report.
  if [ -n "$res" ] && [ "$(jq -r '.is_error // false' "$j" 2>/dev/null)" != true ]; then printf '%s\n' "$res" > "$out"; LLM_WHY=""
  else LLM_WHY=$(llm_why "$j" "$rc" "$bud" "$model"); printf '_(audit run failed: %s)_\n' "$LLM_WHY" > "$out"; log "llm $out failed: $LLM_WHY"; res=""; fi
  rm -f "$j"; [ -n "$res" ]
}
LLM_WHY=""   # why the last llm() run ended without a result, for a report that has to say so downstream (failure_run)
llm_why(){   # llm_why <json> <rc> <budget> <model> — one phone-readable clause from what the run left behind
  local j=$1 rc=$2 bud=$3 model=$4 sub err cost turns
  [ "$rc" = 124 ] && { printf 'timed out: the 20 min cap fell before %s answered (rc=124, no result JSON)' "$model"; return; }
  sub=$(jq -r '.subtype // empty' "$j" 2>/dev/null); cost=$(jq -r '.total_cost_usd // 0' "$j" 2>/dev/null); turns=$(jq -r '.num_turns // 0' "$j" 2>/dev/null)
  err=$(jq -r '[(.errors // [])[]?, (.error // empty), (if .is_error == true then .result else empty end)] | map(select(type == "string" and . != "")) | join("; ")' "$j" 2>/dev/null)
  case "$sub" in
    error_max_budget_usd) printf 'budget ran out: $%.2f spent of the $%s cap after %s turns (%s, subtype %s)' "$cost" "$bud" "$turns" "$model" "$sub" ;;
    error_max_turns) printf 'turns ran out: %s turns, $%.2f spent (%s, subtype %s)' "$turns" "$cost" "$model" "$sub" ;;
    '') if [ -s "$j" ]; then printf 'rc=%s and a result JSON with no result or subtype — stderr is in audit.log' "$rc"
        else printf 'rc=%s and nothing on stdout (%s) — stderr is in audit.log' "$rc" "$model"; fi ;;
    *) printf 'subtype %s, is_error %s, $%.2f spent after %s turns (%s)%s' "$sub" "$(jq -r '.is_error // false' "$j" 2>/dev/null)" "$cost" "$turns" "$model" "${err:+: $(short "$err")}" ;;
  esac
}
short(){ local s=$1; [ ${#s} -le 160 ] || { s="${s:0:160}"; s="${s% *}…"; }; printf '%s' "$s"; }   # a phone-readable cut: on a space, never mid-word

# ---- failure: one claimed cluster, two passes behind the wall, one report, one message (FAILURE, top of file) ----
failure_prompt(){ sed -e "s|@BOX@|$BOX|g" -e "s|@EVIDENCE@|$EV|g" -e "s|@ID@|$FID|g" "$R/config/audit-failure-$1-prompt.md"; }
failure_run(){
  local FDIR="${CC_FAILURES:-$HOME/.cc/failures}" packet="$EV/01-packet.md" hand="$EV/02-handoff.md" narrow="$EV/03-narrow.md"
  local rep band test model eff cap bud t0 secs cost_b cost_n why_b defer_b until_b msg msg_why kind ok=1 to="${CC_AUDIT_FAILURE_TO:-#$CTL-updates}"
  local outcome="" owhy="" oagain=""   # what the report IS, for cc-failures to read off its first line (THREE STATES, top of file)
  log "start mode=failure id=$FID dry=$dry post=$post ev=$EV"
  # the packet is the whole evidence; an id the ledger does not hold ends here, before any model runs
  if ! "$R/bin/cc-failures" packet "$FID" > "$packet" 2>"$EV/packet.err"; then
    echo "cc-audit: cc-failures packet $FID: $(cat "$EV/packet.err")" >&2; log "failure $FID: no packet"; exit 2; fi
  scrub; kind=$(sed -n 's/^kind: //p' "$packet" | head -1); t0=$(date +%s)
  [ "$llm_on" = 1 ] || { echo "$packet"; log "done mode=failure id=$FID no-llm: the packet only"; exit 0; }   # --no-llm: the packet, no spend, no post
  # steps 1-3, the broad pass: Sonnet, the packet, a handoff a fresh context can take
  llm "$hand" "$BUD_FAIL_BROAD" "$(failure_prompt broad)" claude-sonnet-5 || ok=0
  cost_b=${LLM_COST:-0}; why_b=$LLM_WHY; defer_b=$POSTPONED; until_b=$DEFER_UNTIL   # the BROAD pass's own state: the narrow pass overwrites all three
  band=$(sed -n 's/^BAND:[[:space:]]*\([a-z]*\).*/\1/p' "$hand" | tail -1); test=$(sed -n 's/^TEST:[[:space:]]*\([a-z]*\).*/\1/p' "$hand" | tail -1)
  # "Sonnet for a single-tool mechanism, Opus for interacting tools or concurrency, Opus at xhigh for authority, security or system-level reasoning"
  # (Anthropic's launch table has Opus 5.5 ahead of Fable 5.1 on every row, at 40% of its price: 2026-09-23)
  eff=""; case "$band" in interacting) model=claude-opus-5-5; cap=$CAP_STRONG ;; authority) model=claude-opus-5-5; eff=xhigh; cap=$CAP_STRONG ;; *) band=routine; model=claude-sonnet-5; cap=$CAP_ROUTINE ;; esac
  if [ "$ok" = 0 ]; then
    # THE BROAD PASS DECIDES WHAT THE REPORT IS: it is the pass that writes the content, so no handoff means nothing was
    # investigated. Deferred — refused or postponed by a limit: nothing ran, nothing was spent, and it comes back at the
    # reset. Failed — it ran, it cost money, and it stays a failed run; it comes back a day on, not at once, because
    # repeating it spends again. Either way the report is still written: "the stub is a permanent gravestone for work
    # that never happened" was the file EXISTING standing in for an investigation, not the file being there.
    # …with a stamp ALWAYS: the marker line is what cc-failures reads, and one with an empty `again after` matches
    # nothing there, which would put the claim back to reading `reported` — this bug, by the back door.
    if [ -n "$defer_b" ]; then outcome=deferred; owhy=$defer_b; oagain=${until_b:-$(date -u -d "+1 hour" +%FT%TZ)}
    else outcome=failed; owhy=${why_b:-it did not run}; oagain=$(date -u -d "+1 day" +%FT%TZ); fi
    printf '_(no narrow pass: the broad pass ended without a handoff — %s)_\n' "$owhy" > "$narrow"; cost_n=0   # the cause, named again where the reader lands
  elif [ "$test" = none ]; then printf '_(no narrow pass: the broad pass found no discriminating test — see its ## test)_\n' > "$narrow"; cost_n=0   # "If no discriminating test exists, stop here"
  else   # step 4, the narrow pass: a fresh context, the handoff and the packet, the band's model, what the cap has left
    bud=$(awk -v c="$cap" -v b="$cost_b" 'BEGIN{r=c-b; if (r<0.10) r=0.10; printf "%.2f", r}')
    llm "$narrow" "$bud" "$(failure_prompt narrow)" "$model" "$eff" || ok=0
    cost_n=${LLM_COST:-0}
    # THE SAME BUG ONE PASS LATER (i-b3fc3b8b): the broad pass handed off and the NARROW pass was refused by the spend
    # cap. The discriminating test never ran and nothing was spent on it, so the report is not a result either — it
    # gets the marker and the claim comes back, with the why naming the pass, since the handoff below is real content.
    # A narrow pass that RAN and failed is left alone: it ran, it cost money, and that is a result.
    if [ -n "$POSTPONED" ]; then outcome=deferred; owhy="the narrow pass was refused: $POSTPONED (the broad pass handed off — its work is below)"
      oagain=${DEFER_UNTIL:-$(date -u -d "+1 hour" +%FT%TZ)}; fi
  fi
  secs=$(( $(date +%s) - t0 ))
  rep="$FDIR/reports/$FID.md"; [ "$dry" = 1 ] && rep="$OUTDIR/$FID.md"
  mkdir -p "$(dirname "$rep")" || exit 1
  { [ -z "$outcome" ] || printf '**Not investigated (%s):** %s · again after %s\n\n' "$outcome" "$(printf '%s' "$owhy" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//')" "$oagain"   # cc-failures parses this line — ONE line: a model's raw text (llm_why's catch-all, short()) can carry an embedded newline, and cc-failures' NOT_INVESTIGATED regex is `\A...` with `.` not matching newline
    printf '_investigation %s · %s · band %s (%s) · Sonnet $%.2f + $%.2f · ran %s · %s_\n\n' "$FID" "$kind" "$band" "$model" "$cost_b" "$cost_n" "$(dur "$secs")" "$STAMP"
    printf '## broad pass (claude-sonnet-5)\n\n'; cat "$hand"; printf '\n---\n\n## narrow pass (%s)\n\n' "$model"; cat "$narrow"; } > "$rep"
  # the five lines the owner reads; a report with none gets one line and the file, never nothing
  # the narrow prompt opens them "**Decision:**"; in the -updates lane that head would read like the owner's card
  msg=$(sed -n '/^## message/,$p' "$narrow" | sed '1d' | grep -v '^[[:space:]]*$' | head -5 \
    | sed -E '1s/^(\*\*)?Decision:(\*\*)?/\1Review:\2/')
  if [ -n "$outcome" ]; then msg_why="not investigated ($outcome), $( [ "$outcome" = deferred ] && echo "the pass was refused or postponed" || echo "the model run ended without a result" ) — $owhy. It is offered again after $oagain"
  elif [ "$ok" = 1 ]; then msg_why="no five-line message came back"
  else msg_why="the model run ended without a result — ${LLM_WHY:-${POSTPONED:-postponed}}"; fi   # the broad pass handed off; the narrow one did not answer
  [ -n "$msg" ] || msg="**Investigation $FID** ($kind): $msg_why — the report is attached."
  if [ "$dry" = 1 ]; then cat "$rep"; else echo "$rep"; fi
  # ONE message, the file with it, in the -updates lane — and nothing else: no canvas, no board row. A post that fails
  # (a box with no such lane) goes to the seat as one planner request instead, never top level in #<control repo>
  [ "$post" = 0 ] || cc-slack post --file "$rep" --to "$to" -m "$msg" >/dev/null 2>>"$LOG" || {
    log "failure $FID: post to $to failed; asking the seat"
    cc-notify --ask --id "failure-report:$FID" -t "$CTL investigation" "$msg — report: $rep" >/dev/null 2>>"$LOG" ||
      log "failure $FID: cc-notify --ask failed"; }
  log "done mode=failure id=$FID band=$band model=$model cost=$cost_b+$cost_n secs=$secs ok=$ok outcome=${outcome:-investigated} test=${test:-?} out=$rep"
  exit 0
}

# ---- selfcheck: the wall and the scrub, the main-gate row against a real cc-board, the gates, the failure path
# against a stub model, the pipeline check. No network, no spend, no real files ----
selfcheck(){   # the cases are tests/selfcheck/cc-audit.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-audit.sh" || return 1
  selfcheck "$@"; }
[ "$mode" = selfcheck ] && { selfcheck; exit $?; }

# ---- run ----
[ "$mode" = failure ] && failure_run   # exits: the investigation runs no checks and owns no gate row
log "start mode=$mode dry=$dry post=$post day=$DAY since=$SINCE ev=$EV"
checks
[ "$dry" = 1 ] || main_gate "$SUITE_FAIL"   # ONE owned row for main's baseline: every run runs checks
verdict=$([ "$fail" -eq 0 ] && echo OK || echo ATTENTION)
add ""; add "**verdict: $verdict — $fail of $((pass+fail)) checks failed**"
body="$RPT"; out="$OUTDIR/$DAY-checks.md"
[ "$gate_only" = 1 ] || { printf '%s\n' "$body" > "$EV/00-checks.md"; scrub; }   # the timer collects no evidence
if [ "$dry" = 1 ]; then printf '%s\n' "$body"   # OUTDIR is a mktemp dir: the report and the evidence go with it on EXIT
else printf '%s\n' "$body" > "$out"; echo "$out"; fi   # the "since the last run" window is always a checks file
if [ "$gate_only" = 1 ]; then   # the timer's day ends here: the dated report, at most one board row, nothing in Slack
  rmdir "$EV" "$(dirname "$EV")" 2>/dev/null   # no evidence was collected: do not leave an empty dir behind each day
  log "done mode=gate-only verdict=$verdict fail=$fail suite_fail=${SUITE_FAIL:-none} out=$out"; exit 0
fi
if [ "$post" = 1 ]; then
  printf '%s\n' "$body" | cc-slack canvas "#$CTL" "$BOX audit" >/dev/null 2>&1 || log "canvas update failed"
  cc-notify -t "$BOX audit checks" "$verdict: $fail checks failed · canvas updated" || log "notify failed"
fi
log "done mode=$mode verdict=$verdict fail=$fail out=$out"
exit 0
