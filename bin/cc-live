#!/usr/bin/env python3
"""hive (cc-live is the same file) — the engine, hive (code name dispatch), on one screen: each project's loop and
the release it runs, its running and today's runs with their outcome and cost, what waits on a person, and the
host's health. Read-only; makes no model call. The old system's sections (sessions, workers, the board,
landings…) are cc-live-old, one key away.

WHY. The owner asked on 2026-10-14 whether cc-live showed the new architecture; it drew only cc-pulse's snapshot of
the old sessions, boards and landings. The engine is ~/dev/dispatch: dispatch-fx.service and one
dispatch-loop@<project>.service per project.

WHERE THE DATA COMES FROM. Only what the owner's user may read without root, and nothing a project keeps private:
  /var/lib/dispatch-status/        the engine's status door, written once a minute by dispatch-status.service
                                   (0640, group the owner's user). Per project <R>.json (schema v1) if there, else
                                   <R>.txt, whose lines are read by their opening word (Running:, Open:, Stuck:,
                                   Needs you:, Today, Loop) and any other line is shown as it is. Also digest.txt
                                   (the morning Slack line, re-rendered every minute) and health.json (fx_down).
                                   Only plain <name>.txt/.json files directly in it are read, never a symlink or a pipe.
  systemctl show                   dispatch-loop@*.service and dispatch-fx.service: up, down, since, restarts
  /opt/dispatch/current            the release (readlink); one release for every loop unless <R>.json names one
  /var/lib/dispatch-host/ledger.jsonl   the host's health and selftest failures (the box's checks write it)
  $CC_STATE/pulse.json             the old system's one-line count, when cc-pulse keeps it fresh
Never /var/lib/dispatch/<R> (a project's own state) or /var/lib/dispatch-fx. A cell no source gives draws "n/p"
(not published); a source the user can't open draws "unreadable", and so does a project whose file can't be
parsed or drawn, so one odd file is one odd row. A field of the wrong type is taken as absent (n/p). Control
characters are dropped from every line drawn, so no escape sequence in a title or a why reaches the terminal.

Sources are re-read when their mtime moves (checked each second, from a thread) and systemd is asked every 5 s, so
a step shows within about a second of the door's minute rewrite. A key redraws from memory with no I/O.

KEYS. ↑/↓ or j/k move, Enter opens the project under the cursor, Esc/←/Backspace back, h or e home, q quits.
  a  waiting on a person and stuck      H  health: the ledger and the digest in full
  o  cc-live-old's home; s w n l r p b f m x P g T : open that cc-live-old section directly (q there comes back)

  hive (or cc-live)    the view on a terminal; with no terminal, the main screen as text whenever it changes
  hive --once          print the main screen once and exit
  hive selfcheck       cases over fixtures in a temp dir; never the live host
Env (for tests and other hosts): CC_LIVE_STATUS_DIR, CC_LEDGER, CC_LIVE_RELEASE (the current link),
CC_LIVE_UNITS (a file of `systemctl show` output used instead of asking systemd), CC_PULSE.
"""
import curses
import importlib.machinery
import importlib.util
import json
import math
import os
import re
import stat
import subprocess
import sys
import threading
import time

NP = "n/p"
DAY = 86400
UNITS = ["dispatch-fx.service", "dispatch-loop@*.service"]
PROPS = "Id,ActiveState,SubState,ActiveEnterTimestamp,NRestarts"
NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*\.(txt|json)$")
ICON = {"running": "▶", "merged": "✓", "held": "✋", "stuck": "!", "failed": "✗", "lost": "?"}


def status_dir():
    return os.environ.get("CC_LIVE_STATUS_DIR") or "/var/lib/dispatch-status"


def ledger_path():
    return os.environ.get("CC_LEDGER") or "/var/lib/dispatch-host/ledger.jsonl"


def current_link():
    return os.environ.get("CC_LIVE_RELEASE") or "/opt/dispatch/current"


def pulse_path():
    return os.environ.get("CC_PULSE") or os.path.join(
        os.environ.get("CC_STATE") or os.path.expanduser("~/.cc/state"), "pulse.json")


# ── reading, all of it guarded: a source is text, "missing" or "unreadable" ───────────────────────────────────
def door(name):
    """A file directly in the status dir, as text; None when it isn't there, False when it can't be read. Anything
    but a plain file with a plain name (a symlink, a subdir, a path, a FIFO) is refused, so nothing outside the door
    is read. O_NONBLOCK so a FIFO's open returns at once instead of waiting for a writer; fstat then refuses it."""
    if not NAME.match(name):
        return False
    path = os.path.join(status_dir(), name)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        return None
    except OSError:
        return False
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        os.close(fd)
        return False
    with os.fdopen(fd, encoding="utf-8", errors="replace") as fh:
        return fh.read()


def listing():
    """The door's file names, or None when the dir can't be listed."""
    try:
        return sorted(n for n in os.listdir(status_dir()) if NAME.match(n))
    except OSError:
        return None


def stamp(path):
    try:
        st = os.lstat(path)
        return (st.st_mtime_ns, st.st_size, st.st_ino)
    except OSError as e:
        return type(e).__name__


def when(text):
    """systemd's 'Wed 2026-10-14 11:18:12 EDT' (local) as an epoch; None when empty or odd."""
    parts = (text or "").split()
    try:
        return time.mktime(time.strptime(" ".join(parts[1:3]), "%Y-%m-%d %H:%M:%S"))
    except (ValueError, OverflowError):
        return None


def parse_units(text):
    """`systemctl show` blocks → {Id: {active, sub, since, restarts}}."""
    out = {}
    for blk in re.split(r"\n\s*\n", text or ""):
        kv = dict(ln.split("=", 1) for ln in blk.splitlines() if "=" in ln)
        if kv.get("Id"):
            n = kv.get("NRestarts", "")
            out[kv["Id"]] = {"active": kv.get("ActiveState", ""), "sub": kv.get("SubState", ""),
                             "since": when(kv.get("ActiveEnterTimestamp")),
                             "restarts": int(n) if n.isdigit() else None}
    return out


def ask_units():
    """The units, or an error string: a fixture file under CC_LIVE_UNITS, else one read-only systemctl show."""
    fake = os.environ.get("CC_LIVE_UNITS")
    try:
        if fake:
            with open(fake, encoding="utf-8") as fh:
                return parse_units(fh.read())
        r = subprocess.run(["systemctl", "show", "--no-pager", "-p", PROPS, "--", *UNITS],
                           capture_output=True, text=True, timeout=5)
        if r.returncode:
            return f"systemctl show: {(r.stderr.strip() or 'exit %d' % r.returncode)[:80]}"
        return parse_units(r.stdout)
    except (OSError, subprocess.SubprocessError) as e:
        return f"systemctl show: {e}"[:80]


def release():
    """The release /opt/dispatch/current points at, short; None when it isn't there, False when unreadable."""
    try:
        return os.path.basename(os.readlink(current_link()))[:12] or None
    except FileNotFoundError:
        return None
    except OSError:
        return False


def ledger(now):
    """The host ledger's failures in the last 24 h, grouped: [{kind, why, repo, n, last}], newest first, and how
    many lines couldn't be read; None when there is no ledger, False when it can't be read."""
    try:
        with open(ledger_path(), encoding="utf-8", errors="replace") as fh:
            lines = fh.readlines()
    except FileNotFoundError:
        return None, 0
    except OSError:
        return False, 0
    groups, bad = {}, 0
    for ln in lines:
        try:
            r = json.loads(ln)
            at = float(r["at"])
        except (ValueError, KeyError, TypeError):
            bad += bool(ln.strip())
            continue
        if r.get("outcome") != "failed" or now - at > DAY:
            continue
        k = (str(r.get("kind") or "?"), str(r.get("why") or ""), r.get("repo") or "")
        g = groups.setdefault(k, {"kind": k[0], "why": k[1], "repo": k[2], "n": 0, "last": at})
        g["n"] += 1
        g["last"] = max(g["last"], at)
    return sorted(groups.values(), key=lambda g: -g["last"]), bad


def num(x):
    """x when it is a finite number, else None: NaN or Infinity in a door file draws n/p."""
    return x if isinstance(x, (int, float)) and not isinstance(x, bool) and math.isfinite(x) else None


def word(x):
    return x if isinstance(x, str) else None


def obj(x):
    return x if isinstance(x, dict) else {}


def tidy(r):
    """One run from <R>.json with each field the view reads in the shape it reads it; any other value is None."""
    t = dict(r)
    for k in ("state", "on", "why", "title"):
        t[k] = word(r.get(k))
    for k in ("trigger", "pr", "read"):
        t[k] = r[k] if isinstance(r.get(k), dict) else None
    for k in ("started_at", "ended_at", "spent"):
        t[k] = num(r.get(k))
    t["issue"] = r["issue"] if isinstance(r.get("issue"), (int, str)) and not isinstance(r["issue"], bool) else "?"
    return t


def from_json(text):
    """<R>.json (schema v1) as a project record; None when it isn't v1. Every nested read is type-checked, so a
    field of the wrong shape ("loop": "running", "pr": "x") draws n/p instead of raising."""
    try:
        d = json.loads(text)
    except ValueError:
        return None
    if not isinstance(d, dict) or d.get("v") != 1:
        return None
    loop, today = obj(d.get("loop")), obj(d.get("today"))
    runs = [tidy(r) for r in (d["runs"] if isinstance(d.get("runs"), list) else []) if isinstance(r, dict)]
    p = {"src": "json", "repo": word(d.get("repo")), "at": num(d.get("at")), "release": word(d.get("release")),
         "loop": word(loop.get("state")), "poll": num(loop.get("last_poll")),
         "runs_today": num(today.get("runs")), "merged": num(today.get("merged")), "spent": num(today.get("spent")),
         "runs": runs, "open": [], "asks": [], "stuck": [], "other": []}
    for r in runs:
        label = f"#{r['issue']} " + (f"PR #{r['pr'].get('number')} " if r["pr"] else "")
        line = label + (r.get("why") or r.get("state") or "")
        if r.get("state") == "held" and r.get("on"):
            p["asks"].append(f"held on {r['on']}: {line}")
        elif r.get("state") in ("stuck", "failed", "lost"):
            p["stuck"].append(f"{r['state']}: {line}")
    return p


HEAD = re.compile(r"^(\S+)(?: \(([^)]*)\))?(?:, (\d{4}-\d\d-\d\d \d\d:\d\d))?$")
RUNNING = re.compile(r'^Running: (?:issue #(\d+) "(.*)"|(.*?)), (.+)$')
TODAY = re.compile(r"^Today (\d+) merged, \$(\d+(?:\.\d+)?) spent")
POLL = re.compile(r"last poll (\d+) (min|h|days) ago")


def from_txt(text):
    """<R>.txt's sentences as a project record, by each line's opening word; the rest are kept verbatim."""
    lines = (text or "").splitlines()
    m = HEAD.match(lines[0].strip()) if lines else None
    p = {"src": "txt", "repo": m and m.group(2), "at": None, "release": None, "loop": None, "poll": None,
         "runs_today": None, "merged": None, "spent": None, "runs": [], "open": [], "asks": [], "stuck": [],
         "other": [], "loop_text": None}
    if m and m.group(3):
        try:
            p["at"] = time.mktime(time.strptime(m.group(3), "%Y-%m-%d %H:%M"))
        except (ValueError, OverflowError):        # "2026-13-45 99:99" is no time: the stamp draws n/p
            pass
    for ln in (x.strip() for x in lines[1:]):
        if not ln or ln == "Nothing running or open.":
            continue
        if ln.startswith("Running: "):
            r = RUNNING.match(ln)
            p["runs"].append({"issue": r and r.group(1) and int(r.group(1)), "title": r and (r.group(2) or r.group(3)),
                              "state": "running", "age": r and r.group(4), "text": ln[9:]})
        elif ln.startswith("Open: "):
            p["open"].append(ln[6:])
        elif ln.startswith("Needs you: "):
            p["asks"].append(ln[11:])
        elif ln.startswith("Stuck: "):
            p["stuck"].append(ln[7:])
        elif ln.startswith("Today "):
            t = TODAY.match(ln)
            if t:
                p["merged"], p["spent"] = int(t.group(1)), float(t.group(2))
            else:
                p["other"].append(ln)
        elif ln.startswith("Loop "):            # Loop running|<systemd word>|state unknown, last poll N min ago[, late]
            p["loop_text"], body = ln, ln[5:]
            word = body.split(",")[0]
            p["loop"] = ("off" if body.startswith("off") else None if word == "state unknown"
                         else "late" if body.endswith(", late") else "running" if word == "running" else "down")
            lp = POLL.search(body)
            if lp and p["at"]:
                p["poll"] = p["at"] - int(lp.group(1)) * {"min": 60, "h": 3600, "days": DAY}[lp.group(2)]
        else:
            p["other"].append(ln)
    return p


def collect(now=None, units=None):
    """One snapshot of the engine from every source. units: a prior systemd answer to reuse (asked if None)."""
    now = time.time() if now is None else now
    units = ask_units() if units is None else units
    names = listing()
    projects = {}
    loops = {} if isinstance(units, str) else {
        u[len("dispatch-loop@"):-len(".service")]: v for u, v in units.items() if u.startswith("dispatch-loop@")}
    tenants = set(loops)
    if names:
        tenants |= {n.rsplit(".", 1)[0] for n in names} - {"all", "digest", "health"}
    for t in sorted(tenants):
        # Each project is read and then drawn once here, inside its own guard: a file that can't be parsed or drawn
        # becomes one "unreadable" row with the error's name, never an exception that freezes the whole view.
        try:
            p = None
            if names is not None and f"{t}.json" in names:
                raw = door(f"{t}.json")
                p = from_json(raw) if raw else None
            if p is None:
                raw = door(f"{t}.txt") if names is not None else False
                p = from_txt(raw) if raw else dict(from_txt(""), src="unreadable" if raw is False else NP)
            p["name"], p["unit"] = t, loops.get(t)
            project({"projects": {t: p}, "units": units, "release": None}, t, now, 200)
        except Exception as x:
            p = dict(from_txt(""), src="unreadable", name=t, unit=loops.get(t),
                     other=[f"could not read it: {type(x).__name__}"])
        projects[t] = p
    health = door("health.json") if names is not None else False
    try:
        fx_down = json.loads(health).get("fx_down") if health else None
    except (ValueError, AttributeError):
        fx_down = None
    groups, bad = ledger(now)
    return {"at": now, "units": units, "fx": None if isinstance(units, str) else units.get("dispatch-fx.service"),
            "fx_down": fx_down, "release": release(), "projects": projects, "door": names is not None,
            "digest": door("digest.txt") if names is not None else False, "ledger": groups, "ledger_bad": bad,
            "old": old_count(now)}


def old_count(now):
    """The old system in one line, from cc-pulse's snapshot while it is under 90 s old; None otherwise."""
    try:
        with open(pulse_path(), encoding="utf-8") as fh:
            p = json.load(fh)
        g = p["glance"]
        if now - float(p.get("at", 0)) > 90:
            return None
        s, w, lg = g.get("sessions") or {}, g.get("workers") or {}, g.get("landing") or {}
        return (f"sessions {s.get('busy', 0)} busy {s.get('waiting', 0)} waiting · workers {w.get('live', 0)} live"
                f" · landing {lg.get('active', 0)} active {lg.get('queued', 0)} queued"
                f" · needs you {(g.get('needs') or {}).get('n', 0)}")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None


# ── drawing: lines of (text, tone, item) from a snapshot, no I/O ──────────────────────────────────────────────
def age(s):
    if s is None:
        return NP
    s = max(0, s)
    return f"{int(s)}s" if s < 60 else f"{int(s // 60)}m" if s < 5400 else f"{int(s // 3600)}h" if s < 2 * DAY \
        else f"{int(s // DAY)}d"


def hhmm(t):
    return time.strftime("%H:%M", time.localtime(t)) if num(t) else NP


def money(x):
    return f"${x:.2f}" if num(x) is not None else NP


CTRL = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def cut(s, w):
    """s with its control characters (C0, DEL, C1) taken out, cut to w. Every line drawn passes through here, so an
    escape sequence in a door file's title or why never reaches the terminal, in curses, --once or the stream."""
    s = CTRL.sub("", s)
    return s if len(s) <= w else s[:max(1, w - 1)] + "…"


def loop_cell(p, now, units):
    """('up 3h' | 'DOWN 12m' | …, tone)."""
    u = p.get("unit")
    if u:
        if u["active"] == "active":
            word, tone = f"up {age(now - u['since']) if u['since'] else NP}", ""
        else:
            word = f"{u['active'].upper() or 'DOWN'} {age(now - u['since']) if u['since'] else ''}".strip()
            tone = "bad"
        if u.get("restarts"):
            word += f" ↻{u['restarts']}"
        if p.get("loop") == "late":
            word, tone = word + " late", tone or "warn"
        return word, tone
    if p.get("loop") == "off":
        return "off", "dim"
    if p.get("loop"):
        return p["loop"] + (", no unit" if not isinstance(units, str) else ""), \
            "bad" if p["loop"] == "down" else "warn" if p["loop"] == "late" else ""
    return ("no unit" if not isinstance(units, str) else NP), "warn"


def flow(r, p, now):
    """One run as its flow: trigger → time → cost → PR → read → end. A field the door doesn't give draws n/p."""
    st = r.get("state") or NP
    if p["src"] == "txt":                             # the sentence door: issue, title and a rounded age only
        title = f' "{r["title"]}"' if r.get("title") else ""
        return (f"run #{r.get('issue') or '?'} {ICON.get(st, '·')}{title} · trigger {NP} → running {r.get('age') or NP}"
                f" · cost {NP}")
    tr = r.get("trigger") or {}
    trig = (tr.get("kind") or f"trigger {NP}") + (f" by {tr['via']}" if tr.get("via") else "")
    start, end = num(r.get("started_at")), num(r.get("ended_at"))
    out = [f"run #{r.get('issue', '?')} {ICON.get(st, '·')} {trig} {hhmm(start)}"]
    if st == "running":
        out.append(f"running {age(now - start) if start else NP} · {money(r.get('spent'))}")
    else:
        out.append(f"ran {age(end - start) if start and end else NP} · {money(r.get('spent'))}")
    pr = r.get("pr")
    if pr:
        out.append(f"PR #{pr.get('number', '?')}" + (f" ({pr['gh']})" if pr.get("gh") and st == "running" else ""))
    elif st not in ("running", "failed", "lost"):
        out.append(f"PR {NP}")
    rd = r.get("read")
    if rd:
        out.append(f"read: {rd.get('verdict') or NP}")
    if st == "merged":
        out.append(f"merged {hhmm(end)}")
    elif st == "held":
        out.append(f"held on {r.get('on') or NP}" + (f": {r['why']}" if r.get("why") else ""))
    elif st != "running":
        out.append(st + (f": {r['why']}" if r.get("why") else ""))
    return " → ".join(out)


def tone_of(r):
    return {"held": "warn", "stuck": "bad", "failed": "bad", "lost": "bad", "running": "bold"}.get(r.get("state"), "")


def header(e, now):
    ps, units = e["projects"].values(), e["units"]
    if isinstance(units, str):
        loops = f"loops {NP} ({units})"
    else:
        up = sum(1 for p in ps if p.get("unit") and p["unit"]["active"] == "active")
        loops = f"loops {up}/{sum(1 for p in ps if p.get('unit'))} up"
    fx = e["fx"]
    fx = NP if fx is None else "fx up" if fx["active"] == "active" else f"fx {fx['active'].upper()}"
    if e.get("fx_down"):
        fx += " (was down)"
    runs = [p["runs_today"] for p in ps]
    runs = sum(runs) if runs and all(num(x) is not None for x in runs) else NP
    spent = [p["spent"] for p in ps if num(p["spent"]) is not None]
    waiting = sum(len(p["asks"]) for p in ps)
    return (f"hive · {os.uname().nodename} · {time.strftime('%H:%M', time.localtime(now))} · {loops} · {fx}"
            f" · runs today {runs} · ${sum(spent):.2f} today · {waiting} waiting on a person")


def home(e, now, width):
    """The main screen: [(text, tone, item)] where item is a project name for a selectable row."""
    L = [(header(e, now), "bold", None), ("─" * min(width, 120), "dim", None)]
    if not e["door"]:
        L.append((f"status door {status_dir()}: unreadable", "bad", None))
    rel = e["release"]
    rel = "unreadable" if rel is False else rel or NP
    L.append((f"ENGINE{'':18}{'loop':17}{'release':14}{'runs':>5}{'merged':>7}{'spend':>8}  door", "dim", None))
    for p in e["projects"].values():
        word, tone = loop_cell(p, now, e["units"])
        r = (p.get("release") or rel)[:12]
        door_age = f"{age(now - p['at'])} ago" if p["at"] else p["src"] if p["src"] in (NP, "unreadable") else NP
        busy = p["runs"] or p["asks"] or p["stuck"] or p["open"]
        L.append((f"{'▸' if busy else ' '} {p['name'][:21]:22}{word[:16]:17}{r:14}"
                  f"{str(p['runs_today'] if p['runs_today'] is not None else NP):>5}"
                  f"{str(p['merged'] if p['merged'] is not None else NP):>7}{money(p['spent']):>8}  {door_age}",
                  tone or ("bold" if busy else ""), p["name"]))
        for run in p["runs"]:
            L.append(("    " + flow(run, p, now), tone_of(run), p["name"]))
        for o in p["open"]:
            L.append((f"    open: {o}", "", p["name"]))
    asks = [(p["name"], a) for p in e["projects"].values() for a in p["asks"]]
    stuck = [(p["name"], s) for p in e["projects"].values() for s in p["stuck"]]
    L.append((f"WAITING ON A PERSON ({len(asks)})   stuck {len(stuck)} (a: both in full)", "bold", None))
    for n, a in asks:
        L.append((f"  {n:20} {a}", "warn", n))
    L += health_lines(e, now, short=True)
    o = e["old"]
    L.append((f"OLD SYSTEM   {o or 'cc-pulse not running here'}   o: cc-live-old", "dim", None))
    return [(cut(t, width), tone, it) for t, tone, it in L]


def health_lines(e, now, short):
    g, out = e["ledger"], []
    if g is None:
        head = "ledger: none yet"
    elif g is False:
        head = "ledger: unreadable"
    else:
        head = f"{len(g)} failing in the ledger" + (f", {e['ledger_bad']} lines unreadable" if e["ledger_bad"] else "")
    d = e["digest"]
    dg = "unreadable" if d is False else NP if d is None else "quiet (empty)" if not d.strip() else "written"
    out.append((f"HEALTH (24 h)   {head}   digest: {dg}", "bad" if g else "bold", None))
    if g:
        items = [f"{x['kind']} {x['why']}" + (f" ({x['repo']})" if x["repo"] else "") + (f" ×{x['n']}" if x["n"] > 1
                 else "") + f" {hhmm(x['last'])}" for x in g]
        if short:
            out.append(("  " + " · ".join(items), "bad" if any(now - x["last"] < 3600 for x in g) else "", None))
        else:
            out += [("  " + i, "", None) for i in items]
    if d and d.strip():
        text = re.sub(r"<(https?://[^|>]+)\|([^>]+)>", r"\2", d.strip())   # Slack links as their labels
        out += [("  digest: " + text.splitlines()[0], "", None)] if short else \
            [("  digest:", "bold", None)] + [("  " + ln, "", None) for ln in text.splitlines()]
    return out


def waiting(e, now, width):
    L = [("WAITING ON A PERSON", "bold", None)]
    L += [(f"  {p['name']:20} {a}", "warn", p["name"]) for p in e["projects"].values() for a in p["asks"]] or \
        [("  nothing", "dim", None)]
    L.append(("STUCK", "bold", None))
    L += [(f"  {p['name']:20} {s}", "bad", p["name"]) for p in e["projects"].values() for s in p["stuck"]] or \
        [("  nothing", "dim", None)]
    return [(cut(t, width), tone, it) for t, tone, it in L]


def project(e, name, now, width):
    """One project: every field, what the door doesn't publish, and the lines it gave verbatim."""
    p = e["projects"].get(name)
    if not p:
        return [(cut(f"{name}: gone from the door", width), "warn", None)]
    word, _ = loop_cell(p, now, e["units"])
    u = p.get("unit") or {}
    L = [(f"{name}  ({p['repo'] or 'repo ' + NP})  from {p['src']}", "bold", None),
         (f"  loop: {word}" + (f" · systemd {u.get('active')}/{u.get('sub')} since {hhmm(u.get('since'))}"
                               if u else "") + (f" · {p['loop_text']}" if p.get("loop_text") else ""), "", None),
         (f"  last poll: {age(now - p['poll']) + ' ago' if p['poll'] else NP}   door written: "
          f"{hhmm(p['at'])}   release: {p.get('release') or e['release'] or NP}", "", None),
         (f"  today: runs {p['runs_today'] if p['runs_today'] is not None else NP} · merged "
          f"{p['merged'] if p['merged'] is not None else NP} · spent {money(p['spent'])}", "", None)]
    for r in p["runs"]:
        L.append(("  " + flow(r, p, now), tone_of(r), None))
        tr = r.get("trigger") or {}
        if tr.get("channel") and tr.get("ts"):
            L.append((f"      slack: https://slack.com/archives/{tr['channel']}/p{str(tr['ts']).replace('.', '')}",
                      "dim", None))
        if (r.get("pr") or {}).get("url"):
            L.append((f"      {r['pr']['url']}", "dim", None))
    L += [(f"  open: {o}", "", None) for o in p["open"]]
    L += [(f"  needs you: {a}", "warn", None) for a in p["asks"]]
    L += [(f"  stuck: {s}", "bad", None) for s in p["stuck"]]
    L += [(f"  {o}", "", None) for o in p["other"]]
    if p["src"] == "txt":
        L.append((f"  not published by {name}.txt: trigger, start time, cost so far, runs today, per-run PR, "
                  "fx's read, end state", "dim", None))
    return [(cut(t, width), tone, it) for t, tone, it in L]


def health(e, now, width):
    return [(cut(t, width), tone, it) for t, tone, it in health_lines(e, now, short=False)]


def render(view, e, now, width):
    if e is None:
        return [("reading the engine…", "dim", None)]
    if view[0] == "project":
        return project(e, view[1], now, width)
    return {"home": home, "waiting": waiting, "health": health}[view[0]](e, now, width)


def text(e, now=None, width=120):
    return "\n".join(t for t, _, _ in home(e, time.time() if now is None else now, width))


# ── the feed: a snapshot in memory, re-read when a source moves ───────────────────────────────────────────────
class Feed:
    def __init__(self):
        self.e, self.version, self._seen, self._units_at = None, 0, None, 0

    def sources(self):
        d = status_dir()
        return (stamp(d), tuple((n, stamp(os.path.join(d, n))) for n in (listing() or ())), stamp(ledger_path()),
                stamp(current_link()), stamp(pulse_path()))

    def step(self, now=None):
        """Re-read if a source moved or systemd is due (5 s); True when the snapshot changed."""
        now = time.time() if now is None else now
        src, units = self.sources(), None
        if self.e is not None and now - self._units_at < 5:
            if src == self._seen:
                return False
            units = self.e["units"]
        else:
            self._units_at = now
        e = collect(now, units)
        changed = self.e is None or {k: v for k, v in e.items() if k != "at"} != \
            {k: v for k, v in self.e.items() if k != "at"}
        self.e, self._seen = e, src
        self.version += changed
        return changed

    def start(self):
        def go():
            while True:
                try:
                    self.step()
                except Exception as x:   # a bad source must never stop the view; show it and keep going
                    self.err = str(x)[:80]
                time.sleep(1)
        self.err = None
        threading.Thread(target=go, daemon=True).start()
        return self


# ── the screen ────────────────────────────────────────────────────────────────────────────────────────────────
ENTER = (10, 13, curses.KEY_ENTER)
BACK = (27, 8, 127, curses.KEY_BACKSPACE, curses.KEY_LEFT)
OLD_KEYS = {ord(c) for c in "swnlrpbfmxPgT:/"}
FOOT = "↑↓ move · Enter project · a waiting · H health · o old system (s w n l r p b f m x P g T) · q quit"
FOOT_IN = "Esc back · h home · a waiting · H health · o old system · q quit"


class Nav:
    """Which view, the cursor and the scroll; key() changes them and returns an action, drawing nothing."""
    def __init__(self):
        self.stack, self.cur, self.top = [("home",)], [0], [0]

    @property
    def view(self):
        return self.stack[-1]

    def go(self, view):
        if view != self.view:
            self.stack.append(view)
            self.cur.append(0)
            self.top.append(0)

    def back(self):
        if len(self.stack) > 1:
            self.stack.pop()
            self.cur.pop()
            self.top.pop()

    def key(self, k, picks, nlines, rows):
        if k == ord("q"):
            return "quit"
        if k in OLD_KEYS or k == ord("o"):
            return "old"
        if k in (ord("h"), ord("e")):
            self.__init__()
        elif k == ord("a"):
            self.go(("waiting",))
        elif k == ord("H"):
            self.go(("health",))
        elif k in BACK:
            self.back()
        elif k in (curses.KEY_DOWN, ord("j")):
            self.cur[-1] = min(self.cur[-1] + 1, max(0, len(picks) - 1)) if picks else self.cur[-1]
            if not picks:
                self.top[-1] = min(self.top[-1] + 1, max(0, nlines - rows))
        elif k in (curses.KEY_UP, ord("k")):
            self.cur[-1] = max(0, self.cur[-1] - 1)
            if not picks:
                self.top[-1] = max(0, self.top[-1] - 1)
        elif k in ENTER and picks:
            self.go(("project", picks[min(self.cur[-1], len(picks) - 1)][1]))
        return None

    def fit(self, picks, nlines, rows):
        if picks:
            self.cur[-1] = min(self.cur[-1], len(picks) - 1)
            y = picks[self.cur[-1]][0]
            if y < self.top[-1]:
                self.top[-1] = y
            elif y >= self.top[-1] + rows:
                self.top[-1] = y - rows + 1
        self.top[-1] = max(0, min(self.top[-1], max(0, nlines - rows)))


def picks_of(lines):
    """(line number, project) for each selectable row: the first line of each project block."""
    out, last = [], None
    for y, (_, _, it) in enumerate(lines):
        if it and it != last:
            out.append((y, it))
        last = it
    return out


def colours():
    t = {"": 0, "bold": curses.A_BOLD, "dim": curses.A_DIM, "warn": curses.A_BOLD, "bad": curses.A_BOLD}
    try:
        if curses.has_colors():
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_RED, -1)
            curses.init_pair(2, curses.COLOR_YELLOW, -1)
            t["bad"], t["warn"] = curses.color_pair(1) | curses.A_BOLD, curses.color_pair(2)
    except curses.error:
        pass
    return t


def put(scr, y, text, attr):
    try:
        scr.addstr(y, 0, text, attr)
    except curses.error:
        pass


_OLD = {}


def old_ui(scr, k):
    """cc-live-old in this same terminal, opened on key k (o: its home); its q comes back here."""
    if "mod" not in _OLD:
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-live-old")
        loader = importlib.machinery.SourceFileLoader("cc_live_old", path)
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("cc_live_old", loader))
        loader.exec_module(mod)
        _OLD["mod"], _OLD["feed"] = mod, mod.Feed().start()
    if k != ord("o"):
        curses.ungetch(k)
    _OLD["mod"].ui(scr, _OLD["feed"])


def ui(scr, feed, clock=time.time, tones=None, timing=None, old=None):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    scr.keypad(True)
    scr.timeout(20)
    tones = tones if tones is not None else colours()
    nav, seen, drawn = Nav(), None, 0
    while True:
        h, w = scr.getmaxyx()
        rows = max(1, h - 1)
        state = (feed.version, nav.view, len(nav.stack), int(clock()))
        if state != seen:
            lines = render(nav.view, feed.e, clock(), w - 1)
            picks = picks_of(lines)
            nav.fit(picks, len(lines), rows)
            scr.erase()
            hi = picks[nav.cur[-1]][0] if picks else None
            for y, (ln, tone, _) in enumerate(lines[nav.top[-1]:nav.top[-1] + rows]):
                put(scr, y, ln, tones.get(tone, 0) | (curses.A_REVERSE if nav.top[-1] + y == hi else 0))
            err = getattr(feed, "err", None)
            put(scr, h - 1, cut(f"error: {err}" if err else FOOT if len(nav.stack) == 1 else FOOT_IN, w - 1),
                curses.A_DIM)
            scr.refresh()
            seen = state
            if timing is not None and drawn:
                timing.append(time.perf_counter() - drawn)
                drawn = 0
        k = scr.getch()
        if k == -1:
            continue
        drawn = time.perf_counter()
        act = nav.key(k, picks, len(lines), rows)
        if act == "quit":
            return 0
        if act == "old":
            (old or old_ui)(scr, k)
            tones = colours() if old is None else tones
            scr.timeout(20)
        seen = None


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.split("\n\n")[-1].rstrip())
        return 0
    if argv[:1] == ["--once"]:
        print(text(collect()))
        return 0
    if argv:
        print(__doc__.split("\n\n")[-1].rstrip(), file=sys.stderr)
        return 2
    feed = Feed().start()
    try:
        if sys.stdin.isatty() and sys.stdout.isatty() and os.environ.get("TERM", "dumb") != "dumb":
            import locale
            locale.setlocale(locale.LC_ALL, "")
            os.environ.setdefault("ESCDELAY", "10")
            return curses.wrapper(ui, feed)
        seen = 0
        while True:
            if feed.version != seen and feed.e:
                seen = feed.version
                print(text(feed.e) + "\n", flush=True)
            time.sleep(0.2)
    except KeyboardInterrupt:
        return 0


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-live.py, run in THIS namespace (as cc-live-old's are)."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-live.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
