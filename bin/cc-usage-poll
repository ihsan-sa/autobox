#!/usr/bin/env python3
"""cc-usage-poll — the account's plan usage, read live from Anthropic, with no model call.

  cc-usage-poll             one GET of the OAuth usage endpoint -> ~/.cc/state/usage/now.json; exit 0 (or a
                            Retry-After skip), else 1
  cc-usage-poll selfcheck

WHY (owner, 2026-10-18): the box's only five-hour reading was the `rate_limits` block cc-statusline writes when a
status line redraws. Idle sessions redraw nothing, so the box said 53% while the plan said 60-something. This asks
the same endpoint Claude Code's own /usage screen asks (GET <base>/api/oauth/usage, the login's OAuth bearer and the
`anthropic-beta: oauth-2025-04-20` header, Claude Code 2.1.42's cli.js), one request per run, CC_USAGE_TIMEOUT (10) s.
cc-usage-poll.timer runs it every 60 s.

now.json, replaced whole (tmp + rename), in the words the statusline file already uses so a reader takes either:
  {"at": <epoch read>, "five_hour": {"used_percentage": N, "resets_at": <epoch>}, "seven_day": {…}}
Readers (cc-room's five_hour(), the dashboard) prefer it while `at` is under 3 min old, then the statusline files.

THE TOKEN is read from the login it is given: $CLAUDE_CONFIG_DIR/.credentials.json (default ~/.claude), its
claudeAiOauth.accessToken. It goes in the Authorization header and nowhere else: never printed, logged, or written.
It is never refreshed here either: a refresh rotates the refresh token under the sessions that share the login. An
expired one is an error like any other, until a session refreshes it.

THE TOKEN GOES TO ANTHROPIC ONLY (permissions review of #1505). The URL is fixed, https, with no env or flag to
change it, and the opener refuses every 3xx: urllib would carry the Authorization header across a redirect. The one
other origin is _TEST_ORIGIN, a global only the selfcheck sets, in this process; nothing a real run is given reaches it.

ON ANY FAILURE now.json stays as it was and error.json beside it names the exception's type (and an HTTP status),
never its message; a good read removes it. A 429's Retry-After (seconds or a date, at most RETRY_CAP) is kept there
as `retry_after`, and every run before it skips without a request.
Env: CC_USAGE_DIR (~/.cc/state/usage) · CC_USAGE_TIMEOUT
"""
import datetime, email.utils, json, os, sys, time, urllib.error, urllib.request

URL = "https://api.anthropic.com/api/oauth/usage"
BETA = "oauth-2025-04-20"   # Claude Code's own OAuth beta header value
WINDOWS = ("five_hour", "seven_day")
RETRY_CAP = 3600            # a Retry-After further out than this is read as this
_TEST_ORIGIN = None         # selfcheck only: its loopback fake endpoint, "http://127.0.0.1:<port>"


def usage_dir():
    return os.environ.get("CC_USAGE_DIR") or os.path.expanduser("~/.cc/state/usage")


def token():
    d = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    o = json.load(open(os.path.join(d, ".credentials.json")))["claudeAiOauth"]
    exp = o.get("expiresAt")
    if isinstance(exp, (int, float)) and exp / 1000 <= time.time():
        raise RuntimeError("the login's OAuth token has expired; a Claude Code session refreshes it")
    if not o.get("accessToken"):
        raise RuntimeError("the login has no OAuth access token")
    return o["accessToken"]


def epoch(v):
    """resets_at as the endpoint gives it (ISO 8601) or a number, as epoch seconds; None stays None"""
    if v is None or isinstance(v, (int, float)):
        return v
    return datetime.datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()


def record(reply, now):
    out = {"at": now}
    for w in WINDOWS:
        b = reply.get(w) or {}
        u = b.get("utilization")
        out[w] = {"used_percentage": float(u) if isinstance(u, (int, float)) else None,
                  "resets_at": epoch(b.get("resets_at"))}
    return out


def write(name, d):
    os.makedirs(usage_dir(), exist_ok=True)
    p = os.path.join(usage_dir(), name)
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(d, f)
    os.replace(tmp, p)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *a, **k):
        return None   # urllib then raises HTTPError for the 3xx itself; the token never follows it


def opener():
    if _TEST_ORIGIN:
        return urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect()), _TEST_ORIGIN + "/api/oauth/usage"
    return urllib.request.build_opener(NoRedirect()), URL


def retry_after(v, now):
    """a 429's Retry-After (delta seconds or an HTTP date) as the epoch to wait until, capped at now + RETRY_CAP"""
    try:
        t = now + float(v)
    except (TypeError, ValueError):
        try:
            t = email.utils.parsedate_to_datetime(v).timestamp()
        except (TypeError, ValueError):
            t = now + 60   # a 429 with no readable Retry-After still waits one tick
    return min(max(t, now), now + RETRY_CAP)


def poll():
    now = time.time()
    try:
        until = json.load(open(os.path.join(usage_dir(), "error.json"))).get("retry_after")
    except (OSError, ValueError, AttributeError):
        until = None
    if isinstance(until, (int, float)) and now < until:
        return 0   # the endpoint asked us to wait: no request until then, and the files stay as they are
    err = {"at": now}
    try:
        op, url = opener()
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {token()}", "anthropic-beta": BETA,
                                                   "Content-Type": "application/json",
                                                   "User-Agent": "cc-usage-poll"})
        with op.open(req, timeout=float(os.environ.get("CC_USAGE_TIMEOUT") or 10)) as r:
            rec = record(json.load(r), now)
    except Exception as e:
        err["error"] = type(e).__name__   # the type only: a message can carry what it was handed
        if isinstance(e, urllib.error.HTTPError):
            err["status"] = e.code
            if e.code == 429:
                err["retry_after"] = retry_after(e.headers.get("Retry-After"), now)
    else:
        write("now.json", rec)
        try:
            os.unlink(os.path.join(usage_dir(), "error.json"))
        except OSError:
            pass
        return 0
    write("error.json", err)
    print(f"cc-usage-poll: {err['error']}" + (f" {err['status']}" if "status" in err else ""), file=sys.stderr)
    return 1


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-usage-poll.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-usage-poll.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


if __name__ == "__main__":
    sys.exit(selfcheck() if sys.argv[1:2] == ["selfcheck"] else poll())
