#!/usr/bin/env python3
"""cc-improve — try ONE proposed change to the landing on the replay, and keep it or revert it on the number.

  cc-improve next [--repo R]
      Print the first UNTRIED proposal — the first, in name order, with no `result` file. Nothing else.
  cc-improve propose [--source measurement|outside|row] [--n 1] [--repo R] [--base REF]
      Write the NEXT proposal with one headless model call: the ledger, every past `why`, the reading this box
      names, and the base landing go in; a patch and a `why` come back and are written as a new proposal.
  cc-improve trial <name> [--repo R] [--base REF]
      Score the base landing and the base+patch landing on the pinned trace, in this one run, decide by the keep
      rule, write the proposal's `result`, append one line to the trials ledger, and print the verdict line.
  cc-improve pulse [--source S] [--repo R] [--base REF]
      `propose` when nothing is untried, then `next`, then `trial` on it; and when the verdict is keep, commit
      the patch on a branch `improve/<name>` in a linked worktree and print the branch. Pushing it and queueing
      the PR is the orch's, not this tool's. One unattended run leaves one ledger line.
      Exits 1 if a kept change produced no branch, or if the proposal it had to write failed to generate.
  cc-improve selfcheck
      Keep, revert, a patch that does not apply, the propose path against a stubbed model, and the ledger's
      shape — on fixtures of its own.

A PROPOSAL is a directory `~/.cc/state/<repo>/improve/proposals/<name>/` holding two files, written by a person
or by `propose`:
  patch   a unified diff against `core/bin/cc-land`, one hunk where it can be, applying at the base named below;
  why     one paragraph — where the idea came from (a measurement, an outside view, or a row somebody raised),
          the mechanism, and what in the replay it should move.
A trial adds a third, `result`. Untried means there is no `result`, so a proposal is tried once and its answer is
kept; delete the `result` to try it again.

A MODEL-WRITTEN PROPOSAL is the same two files and is trialled by the same rule; its `why` ends with the line
`Written by cc-improve propose — <model>, source <source>, base <sha>, <when>`, which is what says nobody chose
it. The model is read-only — Read, Grep and Glob over a scratch directory holding the base landing, the ledger,
every past `why` and the paths named in `~/.cc/state/<repo>/improve/reading` — and is capped in dollars and
turns. A GENERATION THAT FAILS IS NOT A CRASH and is not a trial: the proposal is written with a `result` saying
what went wrong (no answer, a patch touching the wrong file, a patch that does not apply at the base), so `next`
walks past it and no replay run is spent on it. A run stopped by its own cap is not one of those failures: it
stops at the tool call carrying the answer, so when the envelope has none the session's transcript is read for
the call itself, and the proposal it already wrote is the proposal.

THE KEEP RULE is fixed in the candidates note before any trial, so no result can bend it:
  keep iff candidate.median < baseline.median − 0.5 min AND candidate.merged ≥ baseline.merged
       AND candidate.suites ≤ 1.1 × baseline.suites.  Anything else reverts.
The medians are compared at the resolution cc-replay prints them, one decimal, so the ledger's own numbers say
why the verdict went the way it did.

THE BASELINE IS SCORED FRESH IN EVERY TRIAL, from the base landing named in the ledger line — never a number
copied out of a doc. Both arms run on the same pinned trace with the same replay settings, so the only difference
between them is the patch.

THE LEDGER is `~/.cc/state/<repo>/improve/trials.tsv`, one line per trial, kept or reverted:
  at · name · base · baseline score line · candidate score line · verdict · reason · trace version
A line from before the trace-version column has seven fields and was scored on a v1 trace; it reads as `v1`.
Scores on a v1 and a v2 trace are not comparable (cc-replay's docstring says why).
The score lines are cc-replay's own, verbatim, so a kept change's PR body can carry its number next to the
baseline it beat. A reverted trial's line stays too — those are the research record.

NOTHING HERE IS ALLOWED TO LOSE A LEDGER LINE. A patch that does not apply, and a candidate cc-replay cannot
hold, are both a `revert` with that as the reason.

WHAT IT NEVER TOUCHES: the gates, the landing on the default branch, the live landing queue, GitHub, Slack. Its
only writes are the proposals' own `result` files, the ledger, and — for a kept change — a linked worktree under
`~/.cc/worktrees/<repo>/` and one commit on an `improve/*` branch. The orch pushes it and queues the PR.

The pinned trace is named in `~/.cc/state/<repo>/improve/trace`, one line, a path. Pinned deliberately: a trace
that grows is not a benchmark.

Stdlib only, and no box's names or paths in the code — the repo is an argument and everything hangs off $HOME.
"""
import contextlib, glob, io, json, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
STATE = f"{HOME}/.cc/state"
WORKTREES = f"{HOME}/.cc/worktrees"
BIN = os.path.dirname(os.path.realpath(__file__))
TARGET = "core/bin/cc-land"                  # the one file a proposal may patch
KEEP_MINUTES = 0.5                           # the rule, in the units the ledger prints
KEEP_SUITES = 1.1
PREPARE, CONFLICTS = 4, "history"            # the replay settings every CLI trial runs both arms with
# The propose call: cc-land's reviewer invocation, same shape — read-only tools, no settings file, no MCP server,
# one scratch directory, an answer the schema validates. The caps are the runner's, in dollars and in turns.
CLAUDE = os.environ.get("CC_CLAUDE", f"{HOME}/.local/bin/claude")
PROPOSE_PROMPT = "config/propose-prompt.md"  # relative to the repo THIS tool lives in, like cc-land's reviewer prompt
PROPOSE_MODEL = os.environ.get("CC_IMPROVE_MODEL") or "claude-opus-5"   # the worker model, not a box's fallback
PROPOSE_BUDGET = os.environ.get("CC_IMPROVE_BUDGET") or "2"
PROPOSE_TURNS = os.environ.get("CC_IMPROVE_TURNS") or "20"
PROPOSE_ALLOW = "Read,Grep,Glob,LS"          # it reads the base landing and the record; it writes nothing itself
PROPOSE_DENY = ("Bash,BashOutput,KillShell,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch,Agent,Task,Monitor,"
                "Workflow,Skill,ToolSearch,CronCreate,CronDelete,CronList,ScheduleWakeup,SendMessage,RemoteTrigger,"
                "PushNotification,DesignSync,ListAgents,EnterWorktree,ExitWorktree")
SOURCES = ("measurement", "outside", "row")  # where a proposal may come from; it says which in its `why`
READING = "reading"                          # one path per line in the improve dir: what else the proposer is given
TRIED = "tried.md"                           # every past proposal's `why`, in one file so it costs one read
# One argv for every place a proposal's patch is applied, so the pre-check and the trial cannot disagree about
# what applies. --recount infers each hunk's line counts from its own body instead of trusting the `@@` header:
# a diff written by hand gets those counts wrong while every context line is right, and the first patch a model
# wrote for this loop was thrown away for exactly that. The context lines still have to match the base.
APPLY = ["git", "apply", "-p1", "--whitespace=nowarn", "--recount"]
READING_MAX = 256 * 1024                     # …and the most of any one of them that is copied in
MARK = "Written by cc-improve propose"       # the line in a `why` that says no person chose this proposal
PROPOSE_SCHEMA = json.dumps({
    "type": "object", "additionalProperties": False, "required": ["name", "patch", "why"],
    "properties": {"name": {"type": "string"},      # three to six words; this tool puts the number in front
                   "patch": {"type": "string"},     # the unified diff, verbatim
                   "why": {"type": "string"}}})     # the paragraph a person reads the verdict against
SCORE_RE = re.compile(r"^score (\d+\.\d) suites=(\d+) reviews=(\d+) repairs=(\d+) unmerged=(\d+) merged=(\d+)/(\d+)$")
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


def stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def sh(argv, cwd=None, timeout=600, stdin=None, env=None):
    """Every outside call goes through here. Never raises: a dead tool is an rc and its output, like any other."""
    try:
        p = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, env=env,
                           input=stdin, stdin=None if stdin is not None else subprocess.DEVNULL)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except Exception as e:
        return 127, f"{e.__class__.__name__}: {e}"


def last(text):
    lines = [l.strip() for l in (text or "").splitlines() if l.strip()]
    return lines[-1] if lines else "no output"


# ── where things live ────────────────────────────────────────────────────────────────────────────────────
def checkout():
    """The repository this tool is being run out of — the main checkout, not whichever worktree cwd is in."""
    rc, o = sh(["git", "rev-parse", "--git-common-dir"], cwd=BIN, timeout=60)
    if rc:
        return ""
    return os.path.dirname(os.path.abspath(os.path.join(BIN, o.strip())))


def repo_name(given=""):
    if given:
        return given
    root = checkout()
    return os.path.basename(root) if root else ""


def improve_dir(repo):
    return f"{STATE}/{repo}/improve"


def proposals_dir(repo):
    return f"{improve_dir(repo)}/proposals"


def ledger_path(repo):
    return f"{improve_dir(repo)}/trials.tsv"


def pinned_trace(repo):
    """The trace every trial scores on, named in a file rather than picked by date: the newest trace on disk is
    whichever one somebody extracted last, and a benchmark whose input moves under it measures nothing."""
    try:
        with open(f"{improve_dir(repo)}/trace") as f:
            p = f.read().strip()
    except OSError:
        return ""
    return os.path.expanduser(p) if p else ""


def proposals(repo):
    """Every proposal, in name order — so `next` picks the same one twice and the loop is reproducible."""
    d = proposals_dir(repo)
    return sorted(p for p in glob.glob(f"{d}/*") if os.path.isfile(f"{p}/patch"))


def untried(repo):
    return [p for p in proposals(repo) if not os.path.exists(f"{p}/result")]


# ── the number ───────────────────────────────────────────────────────────────────────────────────────────
class Unscoreable(Exception):
    """The trial has an answer — revert — and this is the reason it goes in the ledger with."""


def parse_score(text):
    """cc-replay's first line, or nothing. Keeps the line verbatim: the ledger hands it to a PR body unchanged."""
    line = (text or "").splitlines()[0].strip() if (text or "").strip() else ""
    m = SCORE_RE.match(line)
    if not m:
        return None
    return {"line": line, "median": float(m.group(1)), "suites": int(m.group(2)), "reviews": int(m.group(3)),
            "repairs": int(m.group(4)), "unmerged": int(m.group(5)), "merged": int(m.group(6)), "total": int(m.group(7))}


def score(landing, trace, prepare, conflicts, which):
    replay = f"{BIN}/cc-replay"
    if not os.access(replay, os.X_OK):
        raise Unscoreable(f"no cc-replay beside this tool ({replay})")
    rc, o = sh([sys.executable, replay, "score", "--candidate", landing, "--trace", trace,
                "--prepare", str(prepare), "--conflicts", conflicts], timeout=3600)
    s = parse_score(o)
    if s is None:
        raise Unscoreable(f"cc-replay could not hold the {which} (rc {rc}): {last(o)}")
    return s


def verdict_of(base, cand):
    """The keep rule, quoted from the candidates note so the code beside it can be read against it:
    "keep iff candidate.median < baseline.median − 0.5 min AND candidate.merged ≥ baseline.merged AND
    candidate.suites ≤ 1.1 × baseline.suites. Else revert."

    Compared at the resolution cc-replay PRINTS — tenths of a minute — so the two lines in the ledger are enough
    to check the verdict by hand. In tenths and integers, no float ever decides anything."""
    faster = round(cand["median"] * 10) < round(base["median"] * 10) - round(KEEP_MINUTES * 10)
    merged = cand["merged"] >= base["merged"]
    suites = cand["suites"] * 10 <= base["suites"] * round(KEEP_SUITES * 10)
    if faster and merged and suites:
        return "keep", (f"{base['median']:.1f} → {cand['median']:.1f} min, "
                        f"{cand['median'] - base['median']:+.1f}; merged {base['merged']}→{cand['merged']}, "
                        f"suites {base['suites']}→{cand['suites']}")
    if not faster:
        why = (f"the median did not move by half a minute ({base['median']:.1f} → {cand['median']:.1f})"
               if round(cand["median"] * 10) != round(base["median"] * 10)
               else f"the median did not move at all ({base['median']:.1f})")
    elif not merged:
        why = f"faster but it merged fewer PRs ({base['merged']} → {cand['merged']})"
    else:
        why = f"faster but it ran more than a tenth again as many suites ({base['suites']} → {cand['suites']})"
    return "revert", why


# ── one trial ────────────────────────────────────────────────────────────────────────────────────────────
def base_landing(repo, sha, into):
    """The base landing, out of git, into a file of our own — never the working tree's, which is whatever
    somebody is editing right now."""
    root = checkout()
    if not root:
        raise Unscoreable("this tool is not in a git checkout, so no base landing can be read")
    rc, o = sh(["git", "show", f"{sha}:{TARGET}"], cwd=root, timeout=120)
    if rc:
        raise Unscoreable(f"git show {sha[:12]}:{TARGET}: {last(o)}")
    with open(into, "w") as f:
        f.write(o)
    return into


def apply_patch(patch, src, dst):
    """base + patch, in a scratch tree. `git apply` reads a/<path> and b/<path> and needs no index."""
    d = tempfile.mkdtemp(prefix="cc-improve-")
    try:
        os.makedirs(f"{d}/{os.path.dirname(TARGET)}", exist_ok=True)
        shutil.copyfile(src, f"{d}/{TARGET}")
        with open(patch) as f:
            body = f.read()
        rc, o = sh(APPLY + ["-"], cwd=d, timeout=120, stdin=body)
        if rc:
            raise Unscoreable(f"the patch does not apply: {last(o)}")
        shutil.copyfile(f"{d}/{TARGET}", dst)
        return dst
    finally:
        shutil.rmtree(d, ignore_errors=True)


def resolve_base(repo, given=""):
    """What this trial is built ON. Given, or the tip of the last KEPT change — two kept changes stack, and the
    ledger's `base` column is what says so — or the default branch's tip when nothing has been kept yet."""
    if given:
        rc, o = sh(["git", "rev-parse", f"{given}^{{commit}}"], cwd=checkout(), timeout=60)
        if rc:
            raise Unscoreable(f"no such base {given}: {last(o)}")
        return o.strip()
    for row in reversed(read_ledger(repo)):
        if row.get("verdict") == "keep":
            rc, o = sh(["git", "rev-parse", f"improve/{row['name']}^{{commit}}"], cwd=checkout(), timeout=60)
            if rc == 0:
                return o.strip()
            break       # the last kept change has no branch to stack on: fall through to the default branch
    rc, o = sh(["git", "rev-parse", "origin/HEAD^{commit}"], cwd=checkout(), timeout=60)
    if rc:
        rc, o = sh(["git", "rev-parse", "origin/main^{commit}"], cwd=checkout(), timeout=60)
    if rc:
        raise Unscoreable(f"no default branch to build on: {last(o)}")
    return o.strip()


LEDGER_COLUMNS = ("at", "name", "base", "baseline", "candidate", "verdict", "reason", "trace")


def trace_version(trace):
    """`v1` or `v2` as the trace file names itself, `-` when there is none to read."""
    try:
        with open(trace) as f:
            return f"v{json.load(f)['version']}"
    except (OSError, ValueError, KeyError, TypeError):
        return "-"


def read_ledger(repo):
    rows = []
    try:
        with open(ledger_path(repo)) as f:
            for line in f:
                c = line.rstrip("\n").split("\t")
                if len(c) in (7, 8):
                    rows.append(dict(zip(LEDGER_COLUMNS, c + ["v1"] * (8 - len(c)))))
    except OSError:
        pass
    return rows


def append_ledger(repo, row):
    """One line, appended, whatever happened. A trial that ends without one is a trial nobody can read back."""
    os.makedirs(improve_dir(repo), exist_ok=True)
    line = "\t".join(str(row[k]).replace("\t", " ").replace("\n", " ") for k in LEDGER_COLUMNS)
    with open(ledger_path(repo), "a") as f:
        f.write(line + "\n")
    return line


def short_base(base):
    """What the ledger's `base` column prints. A RESOLVED base is a SHA and twelve characters of it is a short SHA.
    An UNRESOLVED one — the trial died on `no such base` — is whatever somebody typed, and twelve characters of that
    is a lie shaped like a SHA, so it goes in whole, beside the reason that says it did not resolve."""
    return base[:12] if re.fullmatch(r"[0-9a-f]{40}", base or "") else (base or "-")


def trial(repo, name, base_sha="", trace="", prepare=PREPARE, conflicts=CONFLICTS):
    """Score both arms, decide, write the `result`, append the ledger line, and return it. The only way out of
    here without a ledger line is the process being killed."""
    d = f"{proposals_dir(repo)}/{name}"
    if not os.path.isfile(f"{d}/patch"):
        raise SystemExit(f"cc-improve: no proposal {name} in {proposals_dir(repo)}")
    trace = trace or pinned_trace(repo)
    at, base, baseline, candidate = stamp(), base_sha, None, None
    try:
        # RESOLVED FIRST, and resolved even when it was GIVEN. `--base origin/track/one-landing-queue` is a ref, and
        # what the ledger, the `result` and the worktree a keep is cut from all need is the one SHA it names — the
        # first twelve characters of a REFNAME are `origin/track`, which reads like a short SHA, is not one, and is
        # what `git worktree add` then refuses. Before the trace check so that every line's base column is a SHA.
        base = resolve_base(repo, base)
        if not trace or not os.path.isfile(trace):
            raise Unscoreable(f"no pinned trace to score on (name one in {improve_dir(repo)}/trace)")
        tmp = tempfile.mkdtemp(prefix="cc-improve-arms-")
        try:
            b = base_landing(repo, base, f"{tmp}/base")
            baseline = score(b, trace, prepare, conflicts, "base landing")
            c = apply_patch(f"{d}/patch", b, f"{tmp}/candidate")
            candidate = score(c, trace, prepare, conflicts, "candidate")
        finally:
            shutil.rmtree(tmp, ignore_errors=True)
        verdict, reason = verdict_of(baseline, candidate)
    except Unscoreable as e:
        verdict, reason = "revert", str(e)
    row = {"at": at, "name": name, "base": short_base(base), "verdict": verdict, "reason": reason,
           "baseline": baseline["line"] if baseline else "-", "candidate": candidate["line"] if candidate else "-",
           "trace": trace_version(trace) if trace else "-"}
    line = append_ledger(repo, row)
    with open(f"{d}/result", "w") as f:
        f.write(f"tried    {at}\nbase     {row['base']}\ntrace    {os.path.basename(trace) if trace else '-'} "
                f"({row['trace']}, --prepare {prepare} --conflicts {conflicts})\n"
                f"baseline {row['baseline']}\ncandidate {row['candidate']}\nverdict  {verdict} — {reason}\n")
    return row, line


def verdict_line(row):
    return f"{row['verdict']} {row['name']} on {row['base']} — {row['reason']}"


# ── a kept change becomes a branch ───────────────────────────────────────────────────────────────────────
def branch_it(repo, name, row, line):
    """One commit, the patch, on `improve/<name>` from the base it was scored against, in a linked worktree.
    The commit body carries both score lines and the ledger line, so the PR body is a copy and not a retelling.
    This tool does not push and does not open the PR — a worker may not push another branch.

    Returns (ok, one line). ok is FALSE when there is no branch to push — a worktree already on disk, a base git
    will not cut from, a patch that applied to the scored copy and not to the tree — and `pulse` exits non-zero on
    it. A kept trial whose branch was never built is not a finished cycle, and a loop driving this unattended has
    only the exit status to tell it so."""
    root, branch = checkout(), f"improve/{name}"
    tree = f"{WORKTREES}/{repo}/improve-{name}"
    if os.path.exists(tree):
        return False, f"cc-improve: {tree} is already there — read it, then remove it to rebuild the branch"
    os.makedirs(os.path.dirname(tree), exist_ok=True)
    rc, o = sh(["git", "worktree", "add", "-q", "-b", branch, tree, row["base"]], cwd=root, timeout=300)
    if rc:
        return False, f"cc-improve: no worktree for {branch}: {last(o)}"
    with open(f"{proposals_dir(repo)}/{name}/patch") as f:
        body = f.read()
    rc, o = sh(APPLY + ["-"], cwd=tree, timeout=120, stdin=body)
    if rc:
        return False, f"cc-improve: the patch did not apply in {tree}: {last(o)}"
    try:
        with open(f"{proposals_dir(repo)}/{name}/why") as f:
            why = f.read().strip()
    except OSError:
        why = ""
    msg = (f"{name}: kept by the replay ({row['reason']})\n\n"
           f"baseline  {row['baseline']}\ncandidate {row['candidate']}\n\n"
           f"{why}\n\nTrial: {line}\n")
    rc, o = sh(["git", "add", "--", TARGET], cwd=tree, timeout=120)
    if rc == 0:
        rc, o = sh(["git", "commit", "-q", "-F", "-"], cwd=tree, timeout=300, stdin=msg)
    if rc:
        return False, f"cc-improve: nothing committed on {branch}: {last(o)}"
    return True, f"branch {branch} in {tree} — one commit, the patch; push it and queue the PR"


# ── the model writes the next proposal ───────────────────────────────────────────────────────────────────
def clean_env():
    """The environment the model call runs in: the session's own CLAUDE* variables gone so it inherits no session,
    and anything credential-shaped dropped so a read-only reader carries no token. cc-land's clean_start, without
    the signal reset — nothing here runs a gate."""
    named = ("ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "GH_TOKEN", "GITHUB_TOKEN")
    shaped = ("_TOKEN", "_KEY", "_SECRET", "_CREDS", "_WEBHOOK", "_PASSWORD")
    return {k: v for k, v in os.environ.items()
            if k != "CLAUDECODE" and not k.startswith("CLAUDE_") and k not in named and not k.endswith(shaped)}


def keep_rule():
    """The rule, in the words the trial decides by and out of the same constants — so the prompt cannot drift from
    what `verdict_of` actually does."""
    return (f"keep iff candidate.median < baseline.median − {KEEP_MINUTES} min AND candidate.merged >= "
            f"baseline.merged AND candidate.suites <= {KEEP_SUITES} x baseline.suites. Anything else reverts.\n"
            f"The medians are compared at the resolution the replay prints them, one decimal: half a minute exactly "
            f"is a revert. A change that is faster and merges one fewer PR is a revert. So is one that is faster on "
            f"more than a tenth again as many suite runs.")


def reading_files(repo, into):
    """What this box gives the proposer besides the ledger and the base landing: every path named in the improve
    directory's `reading` file, one per line, copied into the scratch. Named in a file rather than written into
    this tool, because the seam map, the candidate list and the replay's own "what it cannot score" list live
    wherever a repo keeps them. Returns the names copied, in the order they were named."""
    try:
        with open(f"{improve_dir(repo)}/{READING}") as f:
            named = [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")]
    except OSError:
        named = []
    out = []
    for p in named:
        src = os.path.expanduser(p)
        if not os.path.isfile(src) or os.path.getsize(src) > READING_MAX:
            continue
        name = os.path.basename(src)
        shutil.copyfile(src, f"{into}/{name}")
        out.append(name)
    return out


def tried_whys(repo, into):
    """Every proposal's `why` under its own heading, in ONE file. The ledger says how each one scored; these say
    what each one WAS, which is what stops the next proposal being one of them with a different constant.

    One file and not one per proposal because the reader pays a turn and a slice of its two dollars for every
    read: three runs in a row spent the whole budget reading and were cut before they could answer, and the
    eighteen `why` files were the largest count of reads in front of them. Returns how many were written."""
    parts = []
    for d in proposals(repo):
        w = f"{d}/why"
        if os.path.isfile(w) and os.path.getsize(w) <= READING_MAX:
            with open(w) as f:
                parts.append(f"## {os.path.basename(d)}\n\n{f.read().strip()}\n")
    with open(f"{into}/{TRIED}", "w") as f:                  # always written: the prompt names it to be read
        f.write("\n".join(parts) if parts else "Nothing has been tried yet. This is the first proposal.\n")
    return len(parts)


def propose_prompt(source, files):
    """The template beside this tool, filled in. Every path in it is relative to the scratch directory the model
    is given, so the prompt names nothing of any particular box."""
    path = f"{os.path.dirname(BIN)}/{PROPOSE_PROMPT}"
    try:
        with open(path) as f:
            tpl = f.read()
    except OSError as e:
        raise Unscoreable(f"no propose prompt at {path} ({e.__class__.__name__}) — this checkout is not installed")
    reading = ("\n".join(f"   `reading/{n}` — given to you as the reading for this proposal." for n in files)
               if files else "   (this repo names no further reading; the ledger and the base landing are all "
                             "you have, so say so in your `why` if it bounds what you could propose.)")
    # The caps go in from the same constants the call is made with, like the keep rule: a prompt that says twenty
    # turns while the call allows ten is worse than one that says nothing. READ_BY is three fifths of them, which
    # is the point a run has to stop reading and answer to have anything to show for the budget.
    turns = int(PROPOSE_TURNS)
    vals = {"FILE": TARGET, "SOURCE": source, "LEDGER": "trials.tsv", "TRIED": TRIED,
            "TARGET": f"base/{TARGET}", "READING": reading.strip(), "RULE": keep_rule(),
            "TURNS": str(turns), "BUDGET": PROPOSE_BUDGET, "READ_BY": str(max(1, turns * 3 // 5))}
    return re.sub(r"@([A-Z_]+)@", lambda m: vals.get(m.group(1), m.group(0)), tpl)


def answer_from_transcript(session_id):
    """The answer the runner HAD and did not hand back, or None.

    A run stopped by its own budget cap stops at the tool call carrying the structured answer: the envelope it
    then prints has no `structured_output`, while the session's own transcript holds the call, answer and all.
    Twice in one night that threw away a finished proposal and the two dollars that bought it, so the envelope
    is not the only place this looks. The last such call wins — an earlier one was superseded."""
    if not re.fullmatch(r"[0-9a-fA-F-]{36}", session_id or ""):
        return None
    root = os.environ.get("CLAUDE_CONFIG_DIR") or f"{HOME}/.claude"
    got = None
    for path in glob.glob(f"{root}/projects/*/{session_id}.jsonl"):
        try:
            with open(path) as f:
                for line in f:
                    try:
                        content = (json.loads(line).get("message") or {}).get("content")
                    except ValueError:
                        continue
                    for b in content if isinstance(content, list) else []:
                        if (isinstance(b, dict) and b.get("type") == "tool_use"
                                and b.get("name") == "StructuredOutput" and isinstance(b.get("input"), dict)):
                            got = b["input"]
        except OSError:
            continue
    return got


def ask_model(prompt, tmp):
    """One headless call in the scratch directory, cc-land's reviewer shape. Returns (answer or None, one line
    saying what it cost or what went wrong). Never raises: a runner that is not there is a sentence, not a stack."""
    if not os.access(CLAUDE, os.X_OK):
        return None, f"no model runner at {CLAUDE} (CC_CLAUDE names another)"
    argv = [CLAUDE, "-p", prompt, "--model", PROPOSE_MODEL, "--effort", "high",
            "--max-budget-usd", PROPOSE_BUDGET, "--max-turns", PROPOSE_TURNS, "--output-format", "json",
            "--json-schema", PROPOSE_SCHEMA, "--setting-sources", "", "--strict-mcp-config",
            "--disable-slash-commands", "--add-dir", tmp, "--allowedTools", PROPOSE_ALLOW,
            "--disallowedTools", PROPOSE_DENY]
    rc, o = sh(argv, cwd=tmp, timeout=1800, env=clean_env())
    try:
        j = json.loads(o)
    except ValueError:
        j = {}
    got = j.get("structured_output")
    if not isinstance(got, dict):
        try:                                  # a runner without --json-schema answers in `result`, as the object
            got = json.loads((j.get("result") or "").strip())
        except ValueError:
            got = None
    recovered = ""
    if not isinstance(got, dict) or not (got.get("patch") or "").strip():
        got = answer_from_transcript(j.get("session_id"))   # the cap stopped it AT the answer; the answer stands
        recovered = ", recovered from the transcript" if isinstance(got, dict) else ""
    cost = f"${float(j.get('total_cost_usd') or 0):.2f}"
    if not isinstance(got, dict) or not (got.get("patch") or "").strip():
        return None, f"the model wrote no patch (rc {rc}, {cost}): {last(o)[:200]}"
    return got, f"{PROPOSE_MODEL}, {cost}, {j.get('num_turns') or '?'} turns{recovered}"


def patch_touches(body):
    """Every path a diff names, from both sides of its headers. A proposal that edits anything but the one file is
    refused here rather than at the trial: the replay scores one landing, so a second file is scored by nothing."""
    return sorted({m.group(1) for m in re.finditer(r"^(?:---|\+\+\+) [ab]/(\S+)", body, re.M)}
                  | {m.group(1) for m in re.finditer(r"^diff --git a/(\S+) b/\S+", body, re.M)})


def check_patch(body, base_file):
    """`git apply --check` against the base landing in a scratch tree, on APPLY's argv so it is exactly the check
    the trial would meet. "" when it applies, the reason when it does not, made before a replay run is spent."""
    d = tempfile.mkdtemp(prefix="cc-improve-check-")
    try:
        os.makedirs(f"{d}/{os.path.dirname(TARGET)}", exist_ok=True)
        shutil.copyfile(base_file, f"{d}/{TARGET}")
        rc, o = sh(APPLY + ["--check", "-"], cwd=d, timeout=120, stdin=body)
        return "" if rc == 0 else last(o)
    finally:
        shutil.rmtree(d, ignore_errors=True)


def next_name(repo, said):
    """`NN-<slug>`: the number after the highest already in the proposals directory, and the model's own name cut
    down to a slug. The number is what keeps `next`'s name order the order they were written in."""
    n = 0
    for p in glob.glob(f"{proposals_dir(repo)}/*"):
        m = re.match(r"(\d+)", os.path.basename(p))
        if m:
            n = max(n, int(m.group(1)))
    slug = re.sub(r"-+", "-", re.sub(r"[^a-z0-9]+", "-", (said or "").lower())).strip("-")[:48]
    return f"{n + 1:02d}-{slug or 'proposal'}"


def write_proposal(repo, name, patch, why, mark, failed=""):
    """The proposal on disk: `patch`, `why` ending in the line that says a model wrote it, and — when the
    generation failed — the `result` that keeps it out of `next` and out of the ledger."""
    d = f"{proposals_dir(repo)}/{name}"
    os.makedirs(d, exist_ok=True)
    body = (patch or "").rstrip("\n")
    with open(f"{d}/patch", "w") as f:
        f.write(body + "\n" if body else "")
    with open(f"{d}/why", "w") as f:
        f.write((why or "").strip() + "\n\n" + mark + "\n")
    if failed:
        with open(f"{d}/result", "w") as f:
            f.write(f"proposed {stamp()}\n{mark}\nresult   not tried — the generation failed: {failed}\n")
    return d


def propose(repo, source="measurement", base_sha=""):
    """One model call writes the next proposal. Returns (name, ok, one line).

    NEVER RAISES AND NEVER LEAVES NOTHING BEHIND: a runner that is not there, an answer that is not a patch, a
    patch naming another file and a patch that does not apply at the base are all the same thing here — a proposal
    on disk whose `result` says what went wrong. The two it cannot write a proposal for are a base that will not
    resolve and a missing prompt, because neither leaves anything to name a proposal after; both are a line and a
    non-zero exit."""
    if source not in SOURCES:
        return "", False, f"cc-improve: --source is one of {', '.join(SOURCES)}"
    tmp = tempfile.mkdtemp(prefix="cc-improve-propose-")
    try:
        try:
            base = resolve_base(repo, base_sha)
            os.makedirs(f"{tmp}/base/{os.path.dirname(TARGET)}", exist_ok=True)
            base_file = base_landing(repo, base, f"{tmp}/base/{TARGET}")
            os.makedirs(f"{tmp}/reading", exist_ok=True)
            with open(f"{tmp}/trials.tsv", "w") as f:
                f.write("\t".join(LEDGER_COLUMNS) + "\n"
                        + "".join("\t".join(r[k] for k in LEDGER_COLUMNS) + "\n" for r in read_ledger(repo)))
            tried_whys(repo, tmp)
            prompt = propose_prompt(source, reading_files(repo, f"{tmp}/reading"))
        except Unscoreable as e:
            return "", False, f"cc-improve: no proposal — {e}"
        got, said = ask_model(prompt, tmp)
        mark = f"{MARK} — {PROPOSE_MODEL}, source {source}, base {short_base(base)}, {stamp()}."
        if got is None:
            name = next_name(repo, "the-model-wrote-nothing")
            write_proposal(repo, name, "", f"source: {source}. The model was asked for a proposal on {TARGET} at "
                                           f"{short_base(base)} and did not write one.", mark, failed=said)
            return name, False, f"cc-improve: no proposal — {said} (written as {name}, not tried)"
        patch, name = got["patch"], next_name(repo, got.get("name"))
        touched = patch_touches(patch)
        failed = ""
        if [p for p in touched if p != TARGET] or not touched:
            failed = f"the patch names {', '.join(touched) or 'no file'}, and a proposal may only patch {TARGET}"
        else:
            failed = check_patch(patch, base_file)
        write_proposal(repo, name, patch, got.get("why") or f"source: {source}. The model gave no reason.", mark,
                       failed=failed)
        if failed:
            return name, False, f"cc-improve: {name} was written but not tried — {failed} ({said})"
        return name, True, f"cc-improve: {name} — {said}, applies at {short_base(base)}"
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ── commands ─────────────────────────────────────────────────────────────────────────────────────────────
def opt(argv, flag, default=""):
    return argv[argv.index(flag) + 1] if flag in argv and argv.index(flag) + 1 < len(argv) else default


def need_repo(argv):
    repo = repo_name(opt(argv, "--repo"))
    if not repo or not NAME_RE.fullmatch(repo):
        raise SystemExit("cc-improve: which repo? (--repo <name>; the default is the checkout this tool is in)")
    return repo


def cmd_next(argv):
    repo = need_repo(argv)
    left = untried(repo)
    if not left:
        print(f"cc-improve: nothing untried in {proposals_dir(repo)}")
        return 1
    print(os.path.basename(left[0]))
    return 0


def cmd_propose(argv):
    """`--n` proposals, one model call each. Exits 0 when at least one is untried — there is something for a trial
    to score; 1 when every call failed, and each failure is on disk as a proposal with its `result`."""
    repo, n = need_repo(argv), opt(argv, "--n", "1")
    try:
        n = max(1, int(n))
    except ValueError:
        print(f"cc-improve: --n takes a number, not {n!r}", file=sys.stderr)
        return 2
    wrote = 0
    for _ in range(n):
        name, ok, said = propose(repo, source=opt(argv, "--source", "measurement"), base_sha=opt(argv, "--base"))
        print(said)
        wrote += 1 if ok else 0
        if not name:                 # no base, no prompt: the next call would fail the same way
            break
    return 0 if wrote else 1


def cmd_trial(argv):
    if not argv or argv[0].startswith("-"):
        print("cc-improve trial <name> [--repo R] [--base REF]", file=sys.stderr)
        return 2
    repo, name = need_repo(argv), argv[0]
    row, _ = trial(repo, name, base_sha=opt(argv, "--base"))
    print(verdict_line(row))
    print(f"baseline  {row['baseline']}")
    print(f"candidate {row['candidate']}")
    return 0


def cmd_pulse(argv):
    repo = need_repo(argv)
    left = untried(repo)
    if not left:
        # The loop closes here: nothing untried is not an empty pulse, it is the pulse writing the next proposal
        # itself and then scoring it, so one unattended run leaves one ledger line.
        _, ok, said = propose(repo, source=opt(argv, "--source", "measurement"), base_sha=opt(argv, "--base"))
        print(said)
        left = untried(repo)
        if not ok or not left:
            return 1          # a generation that failed is on disk with its `result`; there is nothing to score
    name = os.path.basename(left[0])
    row, line = trial(repo, name, base_sha=opt(argv, "--base"))
    print(verdict_line(row))
    print(f"baseline  {row['baseline']}")
    print(f"candidate {row['candidate']}")
    if row["verdict"] == "keep":
        ok, said = branch_it(repo, name, row, line)
        print(said)
        return 0 if ok else 1     # a keep with no branch is a cycle nobody can push: say so in the exit status
    return 0


# ── selfcheck ────────────────────────────────────────────────────────────────────────────────────────────
def fixture_trace(t0=1_800_000_000, n=6):
    """Six PRs on disjoint files, a minute apart, each with its own gate durations — enough that a wider prepare
    pool visibly changes when the later ones merge. Written here rather than borrowed so the fixture cannot move
    under this selfcheck when cc-replay's own fixtures change."""
    landings = []
    for i in range(1, n + 1):
        files = [["M", f"bin/tool{i}"]]
        landings.append({"repo": "r", "pr": i, "title": f"change {i}", "branch": f"track/t{i}", "base": "main",
                         "created": rstamp(t0 - 600), "merged": rstamp(t0 + 3600 * i), "state": "MERGED",
                         "files": files, "perfile": {p: [10, 2] for _, p in files}, "adds": 10, "dels": 2,
                         "arrivals": [{"at": rstamp(t0 + 60 * i), "again": False}],
                         "heads": [{"at": rstamp(t0 - 600), "sha": f"{i:012x}", "gen": 0, "via": "push"}],
                         "verdicts": [], "fixes": [], "dones": [], "gates": {"check.sh": 60, "selftest.sh": 300 * i},
                         "red": {}, "green": [], "tiers": [], "review_secs": [200], "attempts": 1,
                         "conflicted": False, "queue_merged": True})
    return {"version": 1, "since": rstamp(t0), "until": rstamp(t0 + 86400),
            "repos": {"r": {"default_branch": "main", "gates": ["tests/check.sh", "tests/selftest.sh"], "control": None}},
            "medians": {"gate": {"check.sh": 60, "selftest.sh": 600}, "review": 200, "fix": 900},
            "landings": landings, "gaps": []}


def rstamp(e):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(e))


def diff_against(base, edited, path):
    """A unified diff of two files in the shape a proposal's `patch` is written in."""
    d = tempfile.mkdtemp(prefix="cc-improve-diff-")
    try:
        for side, src in (("a", base), ("b", edited)):
            os.makedirs(f"{d}/{side}/{os.path.dirname(TARGET)}", exist_ok=True)
            shutil.copyfile(src, f"{d}/{side}/{TARGET}")
        # The empty prefixes matter: the two sides already sit under a/ and b/, so git's own a/ b/ would make the
        # headers two levels deep and `git apply -p1` would look for a path no proposal has.
        rc, o = sh(["git", "diff", "--no-index", "--src-prefix=", "--dst-prefix=", "-U3",
                    "--", f"a/{TARGET}", f"b/{TARGET}"], cwd=d, timeout=120)
        with open(path, "w") as f:
            f.write(o)
        return o
    finally:
        shutil.rmtree(d, ignore_errors=True)


STUB_MODEL = '''#!/usr/bin/env python3
"""A model runner for the selfcheck: it answers with the file CC_IMPROVE_STUB names, and writes what it was
given — the scratch it was run in, its prompt and its argv — to CC_IMPROVE_STUB_LOG. No model is called."""
import json, os, sys

log = os.environ.get("CC_IMPROVE_STUB_LOG")
if log:
    seen = [os.path.relpath(os.path.join(r, f), ".") for r, _, fs in os.walk(".") for f in fs]
    with open(log, "w") as f:
        json.dump({"cwd": sorted(seen), "argv": sys.argv[1:],
                   "tried": open("tried.md").read() if os.path.isfile("tried.md") else "",
                   "prompt": sys.argv[sys.argv.index("-p") + 1] if "-p" in sys.argv else ""}, f)
out = os.environ.get("CC_IMPROVE_STUB") or ""
sys.stdout.write(open(out).read() if os.path.isfile(out) else "this is not an answer at all")
'''


def cmd_selfcheck():
    passed, failed = 0, 0

    def check(what, ok):
        nonlocal passed, failed
        if ok:
            passed += 1
        else:
            failed += 1
            print(f"  ✗ {what}")

    src = f"{BIN}/cc-land"
    if not os.path.isfile(src):
        print("cc-improve selfcheck: 0 passed, 1 failed")
        print(f"  ✗ no {TARGET} beside this tool to build fixtures on")
        return 1
    home = tempfile.mkdtemp(prefix="cc-improve-selfcheck-")
    saved = {"STATE": STATE, "WORKTREES": WORKTREES, "CLAUDE": CLAUDE}
    try:
        globals()["STATE"] = f"{home}/state"
        globals()["WORKTREES"] = f"{home}/worktrees"
        repo = "fixture"
        os.makedirs(proposals_dir(repo), exist_ok=True)
        with open(f"{improve_dir(repo)}/trace", "w") as f:
            f.write(f"{home}/trace.json\n")
        with open(f"{home}/trace.json", "w") as f:
            json.dump(fixture_trace(), f)

        with open(src) as f:
            body = f.read()
        knob = "PREPARE_AT_ONCE = int(os.environ.get(\"CC_LAND_PREPARE\") or gate_slots())"
        check("the fixture's knob is still in the landing this selfcheck patches", knob in body)
        # KEEP: a wider prepare pool. The fixture is scored with --prepare 1, so widening it to 6 gates the six
        # jobs side by side instead of one at a time — minutes, not a rounding error, and merged cannot fall.
        wide = f"{home}/wide"
        with open(wide, "w") as f:
            f.write(body.replace(knob, "PREPARE_AT_ONCE = max(6, int(os.environ.get(\"CC_LAND_PREPARE\") or gate_slots()))"))
        os.makedirs(f"{proposals_dir(repo)}/a-keeps", exist_ok=True)
        diff_against(src, wide, f"{proposals_dir(repo)}/a-keeps/patch")
        # REVERT: a comment. It applies, it scores, and it moves nothing — which is the commonest real answer.
        idle = f"{home}/idle"
        with open(idle, "w") as f:
            f.write(body.replace(knob, knob + "   # a fixture's no-op", 1))
        os.makedirs(f"{proposals_dir(repo)}/b-reverts", exist_ok=True)
        diff_against(src, idle, f"{proposals_dir(repo)}/b-reverts/patch")
        # DOES NOT APPLY: a hunk whose context was never in this file.
        os.makedirs(f"{proposals_dir(repo)}/c-rots", exist_ok=True)
        with open(f"{proposals_dir(repo)}/c-rots/patch", "w") as f:
            f.write(f"--- a/{TARGET}\n+++ b/{TARGET}\n@@ -1,3 +1,3 @@\n"
                    " a line this file never held\n-and another\n+and another one\n a third\n")
        for d in proposals(repo):      # every proposal carries a `why`; `propose` hands them to the model as the record
            with open(f"{d}/why", "w") as f:
                f.write(f"source: measurement. {os.path.basename(d)}, written by hand for this fixture.\n")

        check("`next` is the first untried proposal in name order", os.path.basename(untried(repo)[0]) == "a-keeps")

        # A REAL ref, not the word "fixture": a given base is rev-parsed now, and the whole point of the fix is
        # that an unresolvable one is an answer rather than something that quietly reaches `git worktree add`.
        head = sh(["git", "rev-parse", "HEAD^{commit}"], cwd=checkout(), timeout=60)[1].strip()

        def one(name):
            return trial(repo, name, base_sha="HEAD", trace=f"{home}/trace.json", prepare=1, conflicts="none")

        globals()["base_landing"] = lambda r, sha, into: (shutil.copyfile(src, into), into)[1]
        keep_row, keep_line = one("a-keeps")
        check(f"a patch the number likes is KEPT ({keep_row['reason']})", keep_row["verdict"] == "keep")
        check("...and its ledger line carries both score lines verbatim",
              keep_row["baseline"].startswith("score ") and keep_row["candidate"].startswith("score "))
        check("...and the proposal now has a result, so `next` walks past it",
              os.path.exists(f"{proposals_dir(repo)}/a-keeps/result")
              and os.path.basename(untried(repo)[0]) == "b-reverts")
        r2, _ = one("b-reverts")
        check(f"a patch that changes nothing REVERTS ({r2['reason']})",
              r2["verdict"] == "revert" and "did not move" in r2["reason"])
        check("...on the same baseline the kept one was scored against, re-scored in its own run",
              r2["baseline"] == keep_row["baseline"])
        r3, _ = one("c-rots")
        check(f"a patch that does not apply REVERTS with that as the reason ({r3['reason'][:40]})",
              r3["verdict"] == "revert" and "does not apply" in r3["reason"])
        check("...and it still scored the baseline, so the line is readable", r3["baseline"].startswith("score "))
        check("...and it wrote no candidate score it does not have", r3["candidate"] == "-")

        rows = read_ledger(repo)
        check("the ledger holds one eight-column line per trial, in the order they ran, naming the trace version",
              len(rows) == 3 and [r["name"] for r in rows] == ["a-keeps", "b-reverts", "c-rots"]
              and [r["trace"] for r in rows] == ["v1", "v1", "v1"])
        check("...every line names the base it was tried on, RESOLVED — twelve characters of the SHA the ref "
              "named, never twelve characters of the refname",
              all(r["base"] == head[:12] for r in rows) and len(head) == 40 and head[:12] != "HEAD")
        check("...and the verdict column reads keep or revert and nothing else",
              [r["verdict"] for r in rows] == ["keep", "revert", "revert"])
        with open(ledger_path(repo)) as f:
            raw = f.read().splitlines()
        check("...and a line is tab-separated with no tab or newline smuggled into a field",
              all(len(l.split("\t")) == 8 for l in raw) and len(raw) == 3)

        # The trace column, on fixtures of its own: a line from before it reads as v1, a v2 trace names itself.
        os.makedirs(improve_dir("old-ledger"), exist_ok=True)
        with open(ledger_path("old-ledger"), "w") as f:
            f.write("\t".join(["2026-09-08T17:17:30Z", "x", "e7b25da0b4af", "score 1.0", "score 1.0", "revert", "flat"]) + "\n")
        with open(f"{home}/trace-v2.json", "w") as f:
            json.dump(dict(fixture_trace(), version=2), f)
        check("a seven-column line from before the trace column reads as scored on v1; a v2 trace names v2",
              [r["trace"] for r in read_ledger("old-ledger")] == ["v1"] and trace_version(f"{home}/trace-v2.json") == "v2"
              and trace_version(f"{home}/gone.json") == "-")

        # Determinism: the same proposal on the same trace scores the same, twice, but for the stamp.
        os.unlink(f"{proposals_dir(repo)}/a-keeps/result")
        again, _ = one("a-keeps")
        check("the same trial twice writes the same ledger line but for its timestamp",
              {k: v for k, v in again.items() if k != "at"} == {k: v for k, v in keep_row.items() if k != "at"})

        # A missing trace is an answer, not a crash: the line still lands.
        os.unlink(f"{proposals_dir(repo)}/b-reverts/result")
        r4, _ = trial(repo, "b-reverts", base_sha="HEAD", trace=f"{home}/gone.json")
        check(f"no trace is a revert with that reason, not a crash ({r4['reason'][:30]})",
              r4["verdict"] == "revert" and "trace" in r4["reason"] and r4["baseline"] == "-")
        check("...and the ledger has grown by exactly the two lines those two trials wrote",
              len(read_ledger(repo)) == 5)

        # A REF THAT DOES NOT RESOLVE is an answer too — and its base column stays whole, because twelve
        # characters of `origin/track/one-landing-queue` is `origin/track`, which reads like a short SHA.
        os.unlink(f"{proposals_dir(repo)}/b-reverts/result")
        r5, _ = trial(repo, "b-reverts", base_sha="origin/no/such/ref", trace=f"{home}/trace.json",
                      prepare=1, conflicts="none")
        check(f"a base that does not resolve is a revert with that reason ({r5['reason'][:28]})",
              r5["verdict"] == "revert" and "no such base" in r5["reason"])
        check("...and the ledger keeps the ref WHOLE beside it, not sliced into something SHA-shaped",
              r5["base"] == "origin/no/such/ref" and len(read_ledger(repo)) == 6)

        # A KEEP THAT BUILDS NO BRANCH is not a finished cycle: branch_it says so, and pulse exits on what it says.
        tree = f"{WORKTREES}/{repo}/improve-a-keeps"
        os.makedirs(tree, exist_ok=True)
        ok, said = branch_it(repo, "a-keeps", keep_row, keep_line)
        check(f"a worktree already on disk means NO branch, and branch_it says so ({said[-24:]})",
              ok is False and tree in said)

        # ── the model writes the proposal, against a stub that is not one ────────────────────────────────
        # The stub answers with a file and records what it was handed, so these cases test the propose PATH —
        # what goes into the scratch, what the call may touch, and what comes of each kind of answer.
        stub = f"{home}/stub-claude"
        with open(stub, "w") as f:
            f.write(STUB_MODEL)
        os.chmod(stub, 0o755)
        globals()["CLAUDE"] = stub
        with open(f"{home}/map.md", "w") as f:
            f.write("# a seam map, standing in for whatever this repo names as its reading\n")
        with open(f"{improve_dir(repo)}/{READING}", "w") as f:
            f.write(f"# comments and a path that is not there are skipped\n{home}/map.md\n{home}/never-written.md\n")
        three = f"{home}/three"
        with open(three, "w") as f:
            f.write(body.replace(knob, "PREPARE_AT_ONCE = max(3, int(os.environ.get(\"CC_LAND_PREPARE\") or gate_slots()))"))
        good = diff_against(src, three, f"{home}/good.patch")
        os.environ["CC_IMPROVE_STUB_LOG"] = f"{home}/stub.json"

        def stubbed(answer):
            """What the next model call answers, in the shape the real runner's --output-format json prints."""
            with open(f"{home}/stub.out", "w") as f:
                f.write(answer)
            os.environ["CC_IMPROVE_STUB"] = f"{home}/stub.out"

        def answered(**kw):
            return json.dumps({"structured_output": kw, "total_cost_usd": 0.01, "num_turns": 3})

        def result_of(name):
            with open(f"{proposals_dir(repo)}/{name}/result") as f:
                return f.read()

        stubbed(answered(name="A Wider Prepare Pool", patch=good,
                         why="source: measurement. The ledger's own lines say the wait is the pool."))
        n1, ok1, said1 = propose(repo, source="measurement", base_sha="HEAD")
        check(f"a model answer whose patch applies is written as a proposal ({said1[:34]})",
              ok1 is True and n1 == "01-a-wider-prepare-pool")
        with open(f"{proposals_dir(repo)}/{n1}/patch") as f:
            wrote = f.read()
        with open(f"{proposals_dir(repo)}/{n1}/why") as f:
            said_why = f.read()
        check("...holding the patch the model returned, verbatim", wrote.rstrip("\n") == good.rstrip("\n"))
        check("...and a `why` naming the source, marked as nobody's choice but the model's",
              "source: measurement" in said_why and MARK in said_why and "source measurement" in said_why)
        check("...and no `result`, so `next` picks it and a trial scores it",
              not os.path.exists(f"{proposals_dir(repo)}/{n1}/result") and os.path.basename(untried(repo)[0]) == n1)
        with open(f"{home}/stub.json") as f:
            seen = json.load(f)
        check("the call was given the base landing, the ledger, every past `why`, and the reading this repo names",
              f"base/{TARGET}" in seen["cwd"] and "trials.tsv" in seen["cwd"] and "reading/map.md" in seen["cwd"]
              and TRIED in seen["cwd"])
        check("...the whys in ONE file, under a heading each, so the reader spends one turn on them and not one each",
              all(f"## {os.path.basename(d)}" in seen["tried"] for d in proposals(repo)
                  if os.path.basename(d) != n1) and f"## {n1}" not in seen["tried"])
        check("...and its prompt named the source, the file it may patch, and the rule it will be judged by",
              "measurement" in seen["prompt"] and TARGET in seen["prompt"]
              and f"{KEEP_MINUTES} min" in seen["prompt"] and f"{KEEP_SUITES} x" in seen["prompt"])
        check("...and the caps IN the prompt are the caps the call was made with, so it cannot be told the wrong one",
              f"{PROPOSE_TURNS} TURNS" in seen["prompt"] and f"${PROPOSE_BUDGET}," in seen["prompt"])
        argv = seen["argv"]
        check("...and the call is read-only: those tools and no others, no settings file, no MCP server",
              argv[argv.index("--allowedTools") + 1] == PROPOSE_ALLOW
              and argv[argv.index("--disallowedTools") + 1].startswith("Bash,")
              and argv[argv.index("--setting-sources") + 1] == "" and "--strict-mcp-config" in argv
              and argv[argv.index("--max-budget-usd") + 1] == PROPOSE_BUDGET
              and argv[argv.index("--max-turns") + 1] == PROPOSE_TURNS)

        stubbed(answered(name="a hunk from nowhere", why="source: measurement.",
                         patch=f"--- a/{TARGET}\n+++ b/{TARGET}\n@@ -1,3 +1,3 @@\n a line this file never held\n"
                               f"-and another\n+and another one\n a third\n"))
        n2, ok2, said2 = propose(repo, source="measurement", base_sha="HEAD")
        check(f"a patch that does not apply at the base is NOT tried, and says so in its result ({said2[-24:]})",
              ok2 is False and "does not apply" in result_of(n2) and "not tried" in result_of(n2))
        check("...and it is on disk all the same, so the record holds what the model wrote, and `next` walks past it",
              os.path.getsize(f"{proposals_dir(repo)}/{n2}/patch") > 0 and os.path.basename(untried(repo)[0]) == n1)

        stubbed(answered(name="two files at once", why="source: outside.", patch=good.replace(TARGET, "bin/other")))
        n3, ok3, _ = propose(repo, source="outside", base_sha="HEAD")
        check("a patch that edits any other file is refused, naming the file it reached for",
              ok3 is False and "bin/other" in result_of(n3) and "not tried" in result_of(n3))

        os.environ["CC_IMPROVE_STUB"] = f"{home}/no-such-answer"   # the stub then prints something that is not JSON
        n4, ok4, said4 = propose(repo, source="row", base_sha="HEAD")
        check(f"a runner that answers nothing usable is a proposal with a result, not a crash ({said4[-20:]})",
              ok4 is False and "no patch" in result_of(n4) and "not tried" in result_of(n4))
        check("...and every failed generation is still out of `next`, so no trial is spent on one",
              [os.path.basename(p) for p in untried(repo)] == [n1])

        # A RUN STOPPED BY ITS OWN BUDGET CAP stops at the tool call that carries the answer, and the envelope it
        # prints then holds none of it. Both arms on their own fixture: the same envelope, with the transcript and
        # without it. This box lost a finished proposal and $2 to it twice before the fallback was written.
        os.environ["CLAUDE_CONFIG_DIR"] = conf = f"{home}/claude-config"
        session, said_why = "d81f3bb4-5f9a-4c31-9a01-1f5ce0fb0a11", "source: outside. The cap stopped it at the answer."
        capped = json.dumps({"stop_reason": "tool_use", "session_id": session, "total_cost_usd": 2.04})
        stubbed(capped)
        n5, ok5, said5 = propose(repo, source="outside", base_sha="HEAD")
        check(f"an envelope with no answer and no transcript to find one in stays a failure ({said5[-18:]})",
              ok5 is False and "no patch" in result_of(n5))
        os.makedirs(f"{conf}/projects/-tmp-a-scratch", exist_ok=True)
        with open(f"{conf}/projects/-tmp-a-scratch/{session}.jsonl", "w") as f:
            for answer in ({"name": "superseded", "patch": "a patch it thought better of", "why": "no"},
                           {"name": "the cap stopped it at the answer", "patch": good, "why": said_why}):
                f.write(json.dumps({"message": {"content": [{"type": "text", "text": "thinking about it"},
                                                            {"type": "tool_use", "name": "StructuredOutput",
                                                             "input": answer}]}}) + "\n")
        stubbed(capped)
        n6, ok6, said6 = propose(repo, source="outside", base_sha="HEAD")
        check(f"...and with the transcript there, the answer it already wrote is recovered and tried ({said6[-34:]})",
              ok6 is True and n6 == "06-the-cap-stopped-it-at-the-answer" and "recovered from the transcript" in said6)
        with open(f"{proposals_dir(repo)}/{n6}/why") as f:
            check("...the LAST answer in the transcript, whole, and marked as the model's own like any other",
                  said_why in f.read() and open(f"{proposals_dir(repo)}/{n6}/patch").read().rstrip("\n")
                  == good.rstrip("\n"))
        del os.environ["CLAUDE_CONFIG_DIR"]


        check("an unknown --source writes nothing at all",
              propose(repo, source="guesswork", base_sha="HEAD")[:2] == ("", False)
              and not os.path.exists(f"{proposals_dir(repo)}/07-proposal"))
        check("a base that does not resolve is a line, not a proposal and not a stack",
              propose(repo, source="measurement", base_sha="origin/no/such/ref")[:2] == ("", False))

        # PULSE WITH NOTHING UNTRIED: it proposes first, then trials what it proposed — one ledger line, one run.
        for d in untried(repo):
            with open(f"{d}/result", "w") as f:
                f.write("tried by hand, so this fixture has nothing untried left\n")
        stubbed(answered(name="the pulse writes its own", patch=good,
                         why="source: measurement. The pulse had nothing untried, so it wrote this."))
        before = len(read_ledger(repo))
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            rc = cmd_pulse(["--repo", repo, "--base", "HEAD"])
        rows = read_ledger(repo)
        check(f"a pulse with nothing untried proposes, trials it, and leaves ONE ledger line (rc {rc})",
              rc == 0 and len(rows) == before + 1 and rows[-1]["name"] == "07-the-pulse-writes-its-own"
              and rows[-1]["verdict"] in ("keep", "revert"))
        check("...and said both what it proposed and how that scored",
              "applies at" in out.getvalue() and "07-the-pulse-writes-its-own" in out.getvalue()
              and "baseline  score " in out.getvalue())
        stubbed("")                       # a model that answers with nothing at all
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            rc = cmd_pulse(["--repo", repo, "--base", "HEAD"])
        check(f"...and a pulse whose proposal failed to generate exits non-zero rather than scoring nothing",
              rc == 1 and len(read_ledger(repo)) == before + 1)
        # --recount FORGIVES A COUNT, NOT A CONTEXT LINE. A diff written by hand gets the `@@` numbers wrong and
        # every context line right, and the first patch a model wrote for this loop was thrown away for that alone.
        # Both arms on their own fixture: the same wrong counts over the base's own text, and over text it never had.
        miscount = re.sub(r"@@ -(\d+),\d+ \+(\d+),\d+ @@", r"@@ -\1,99 +\2,99 @@", good)
        check("the fixture is really miscounted — its header claims 99 lines and its hunk is nothing like that long",
              miscount != good and "99 @@" in miscount and len(miscount.splitlines()) < 99)
        stubbed(answered(name="counts wrong lines right", why="source: measurement.", patch=miscount))
        n7, ok7, said7 = propose(repo, source="measurement", base_sha="HEAD")
        check(f"a patch whose `@@` counts are wrong over the base's OWN text is tried all the same ({said7[-20:]})",
              ok7 is True and not os.path.exists(f"{proposals_dir(repo)}/{n7}/result"))
        stubbed(answered(name="counts wrong lines wrong too", why="source: measurement.",
                         patch=f"--- a/{TARGET}\n+++ b/{TARGET}\n@@ -1,99 +1,99 @@\n a line this file never held\n"
                               f"-and another\n+and another one\n"))
        n8, ok8, _ = propose(repo, source="measurement", base_sha="HEAD")
        check("...and the same wrong counts over text the base never held are refused, so nothing was loosened",
              ok8 is False and "not tried" in result_of(n8)
              and n8 not in [os.path.basename(u) for u in untried(repo)])

        base = {"median": 21.6, "suites": 75, "merged": 90}
        check("the rule: half a minute EXACTLY is not enough — it must be more",
              verdict_of(base, {"median": 21.1, "suites": 75, "merged": 90})[0] == "revert")
        check("...a tenth more than half a minute is", verdict_of(base, {"median": 21.0, "suites": 75, "merged": 90})[0] == "keep")
        check("...faster but merging one fewer reverts",
              verdict_of(base, {"median": 10.0, "suites": 75, "merged": 89})[0] == "revert")
        check("...faster on a tenth again as many suites is kept; one more suite than that is not",
              verdict_of(base, {"median": 10.0, "suites": 82, "merged": 90})[0] == "keep"
              and verdict_of(base, {"median": 10.0, "suites": 83, "merged": 90})[0] == "revert")
    finally:
        globals().update(saved)
        globals()["base_landing"] = BASE_LANDING
        for k in ("CC_IMPROVE_STUB", "CC_IMPROVE_STUB_LOG", "CLAUDE_CONFIG_DIR"):
            os.environ.pop(k, None)
        shutil.rmtree(home, ignore_errors=True)
    print(f"cc-improve selfcheck: {passed} passed, {failed} failed")
    return 1 if failed else 0


BASE_LANDING = base_landing


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip().split("\n\n")[0] + "\n\n"
              + "\n".join(l for l in __doc__.splitlines()[2:18] if l.startswith("  ")))
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "next":
        return cmd_next(rest)
    if cmd == "propose":
        return cmd_propose(rest)
    if cmd == "trial":
        return cmd_trial(rest)
    if cmd == "pulse":
        return cmd_pulse(rest)
    if cmd == "selfcheck":
        return cmd_selfcheck()
    print(f"cc-improve: unknown command '{cmd}'", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
