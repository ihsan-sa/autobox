#!/usr/bin/env python3
"""cc-improve — RETIRED. It tried one proposed patch to the landing on cc-replay's trace and kept or reverted it on
the number. Every proposal was a diff against the old single-file landing tool, and the lander that replaced it is
a package that cc-replay's candidate harness cannot load, so there is nothing left for a trial to patch or score.

  cc-improve <anything>   one line saying it is retired, exit 2; nothing is read, written or spent
  cc-improve selfcheck    that line, and that nothing else runs

docs/improve-loop.md says what replaced it: a change to the lander goes through its own plan and checks, and
`lander times` is the landing's clock. A replay for the lander is a design of its own, not this file.
"""
import subprocess
import sys

RETIRED = ("cc-improve: retired — it patched the old single-file landing tool, and the lander is a package "
           "cc-replay cannot score (docs/improve-loop.md)")


def selfcheck():
    bad = 0
    for argv in (["next"], ["trial", "x", "--repo", "r"], ["pulse"], ["propose"], []):
        p = subprocess.run([sys.executable, __file__, *argv], capture_output=True, text=True, timeout=60)
        good = p.returncode == 2 and p.stderr.strip() == RETIRED and not p.stdout
        bad += not good
        print(f"  {'ok' if good else 'FAIL'}  `cc-improve {' '.join(argv)}` says it is retired, exit 2, nothing else")
    print(f"cc-improve selfcheck: {5 - bad} passed, {bad} failed")
    return 1 if bad else 0


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    print(RETIRED, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
