#!/usr/bin/env bash
# cc-rc — wait for internet, then run a Remote-Control Claude Code session named after the host
# (controllable from the Claude phone/web app). Respawns if claude exits; Ctrl-C during the pause drops to a shell.
# Started by cc-boot from systemd, whose default PATH lacks ~/bin and ~/.local/bin; prepend them (idempotent) so the session and its shells find cc-*.
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac; export PATH
# SCRATCH LIVES ON DISK: /tmp is a RAM tmpfs with a per-user quota, and sessions' scratch (Claude Code's claude-<uid>,
# every mktemp) filled it until landings died on "Disk quota exceeded". A TMPDIR somebody set is theirs and is kept.
[ -n "${TMPDIR:-}" ] || { TMPDIR="$HOME/.cc/tmp"; { [ -d "$TMPDIR" ] || { mkdir -p "$HOME/.cc" && { mkdir -m 700 "$TMPDIR" || [ -d "$TMPDIR" ]; }; }; } 2>/dev/null || TMPDIR=/tmp; export TMPDIR; }
CLAUDE="$HOME/.local/bin/claude"; NAME="${CC_BOX:-$(hostname -s)}"; SLACKON="$HOME/.cc/slack/enabled"   # the Remote-Control session is named after the box
"$HOME/bin/cc-trust" "$PWD"
trap 'echo; exec bash' INT
fast=0; notified=0   # a claude that exits in <15 s is broken (bad flag, no auth, no net): back off instead of spinning
until curl -sS -o /dev/null --max-time 5 https://api.anthropic.com/ 2>/dev/null; do echo "waiting for internet..."; sleep 5; done
while true; do
  t0=$SECONDS
  # A CLEAN SCREEN BEFORE EVERY LAUNCH. A claude that exits leaves its last screen up, and when that was the
  # dev-channels dialog, accept-dialog (started just below) read it at once and pressed Enter before the new claude
  # took input: the Enter was lost, its fallback Up wrapped the menu to "2. Exit", and every relaunch exited 1
  # (2026-09-23, Claude Code 2.1.280). Cleared, the text it looks for is the new dialog's. tmux keeps the old screen
  # in scrollback (scroll-on-clear), where cc-stall counts the relaunches.
  [ -t 1 ] && printf '\033[H\033[2J'
  CH=(); unset CC_SLACK_CHANNEL; [ -f "$SLACKON" ] && { CH=(--dangerously-load-development-channels server:cc-slack); export CC_SLACK_CHANNEL=1; ( "$HOME/bin/cc-slack" accept-dialog box >/dev/null 2>&1 & ); }   # Slack channel (target "box" — from cwd ~/dev), see cc-slack
  MO=(); m=$("$HOME/bin/cc-model" current 2>/dev/null) && [ -n "$m" ] && MO=(--model "$m")   # come back up on the model the box names: its primary, or the fallback while a limit is on
  "$CLAUDE" --permission-mode auto --remote-control "$NAME" "${CH[@]}" "${MO[@]}"; rc=$?   # auto mode from the first screen, like every session cc opens
  if [ $((SECONDS - t0)) -lt 15 ]; then fast=$((fast + 1)); else fast=0; notified=0; fi
  if [ "$fast" -gt 0 ] && p=$("$HOME/bin/cc-limit" status 2>/dev/null); then   # not a broken flag: Claude is rate-limited — wait for the reset, do not spin
    echo; echo "claude exited ($rc) - Claude $p; waiting for the reset (Ctrl-C for a shell)"; "$HOME/bin/cc-limit" wait || sleep 300; continue; fi   # wait refuses (>6 h stamp) → still back off, never tight-loop
  wait=15
  if [ "$fast" -ge 5 ]; then
    wait=120
    [ "$notified" = 1 ] || {
      "$HOME/bin/cc-notify" -t "$NAME cc-rc" -p high \
        "Remote-Control claude has exited $fast times in under 15 s (last rc=$rc) — backing off to ${wait}s between tries. Look: tmux attach -t main" >/dev/null 2>&1 || true
      notified=1; }
  fi
  echo; echo "claude exited ($rc) - restarting in ${wait}s (Ctrl-C for a shell)"; sleep "$wait"
done
