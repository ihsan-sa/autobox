#!/usr/bin/env python3
"""cc-board — shared per-repo task/status board for orchestrated Claude sessions.
Board file: ~/.cc/boards/<repo>.json  (sidecar; never in git, so no merge noise).
Every orchestrated session reads/writes it so sessions know what the others are doing.
`add` and `set … instructions` are the doors a brief comes in by: cc-brief refuses one that prescribes the steps
— by its own arithmetic and by a small model reading the prose, which says what to cut; a judge that cannot answer
does not stop it. CC_BRIEF_FORCE=1 sends it as typed and records that; CC_BRIEF_MACHINE=1 is for a row the box
wrote itself and records nothing. What other live tracks are holding is computed in."""
import sys, os, json, time, fcntl, calendar, errno, re, subprocess, stat, tempfile, glob
BOARDS = os.path.expanduser("~/.cc/boards")
# ONE VOCABULARY with the App Home tab (§02 of the Home handoff: the word is "queued", never "todo"). The board used to
# write `todo` and the tab only printed "queued" by accident — `todo` is not a state it knows, so it fell through the
# ladder's unknown-status branch, and a real unknown looked exactly like the normal path. The board says `queued` now;
# `todo` is still READ (boards written before this, and fingers used to typing it) and normalised on the way in.
STATES = ["queued","running","waiting","review","blocked","merged","done"]
# `waiting` vs `blocked`: waiting = a PERSON must answer before this moves (the worker declared it with a
# `STATUS: BLOCKED: <question>` journal line); blocked = it stopped for any other reason — a loop that gave up,
# a usage limit, a kill. Only `waiting` reaches the owner's NEEDS YOU list, and cc-reconcile is what writes it.
ALIAS = {"todo":"queued"}
def state(st): return ALIAS.get(st, st)
# A ROW'S KIND (owner, 2026-09-01): `track` is everything above — a brief, a worker or a session on it, a PR, done.
# `session` is a long-lived channel session (a course-builder's per-course sessions): no brief needed, no PR, never done,
# and alive is its NORMAL state — so cc-reconcile never touches its status, the Home tab groups it under its repo and
# never counts it as running, and `list` says `session` where a track says its status (cc ls / digest / resume read
# that column). Rows written before this carry no field and read as `track`. `cc <repo> <name> --session` sets it.
KINDS = ("track", "session")
def kind(t): return t.get("kind") or "track"
# THE ROW'S OWN VOCABULARY (2026-09-07). `set` used to write ANY key handed to it: `cc board set <repo> <track>
# state review` looks exactly like the real verb — the field is `status`, reached through `cc-board status` too —
# and `set` happily wrote a dead `state` beside it and printed nothing. A session before this one hit it, called
# it "silently did nothing", and moved on without finding the cause; the next one repeated it. Every name a track
# row actually carries is here — what `add` stamps, `agent`/`agent_at` (owner, 2026-09-04) and `instructions` (the
# door's own name, handled above and never reaching the check below) — so a typo is refused, naming this list,
# rather than writing a key nothing will ever read.
FIELDS = ("agent", "agent_at", "branch", "created", "held", "held_at", "held_by", "instructions", "kind", "notes",
          "pr", "session_id", "started", "status", "title", "updated", "worktree")
# A ROW SOMEBODY IS DELIBERATELY SITTING ON (2026-09-07). A status word says where the work got to; it cannot say
# "a person stopped this, and here is what has to happen first". So every watcher that judged a row by its status
# alone nagged about rows that were held on purpose: the secretary called a board undriven because of one, and the
# board watchdog told a reader four times to "review and land it" — once about a PR whose approval had been
# withdrawn because landing it early opened a hole. `held` is the reason, in the holder's own words, and it is
# read by cc-secretary's driving count, cc-reconcile's watchdog and cc-pulse's dispatch offer, each of which
# leaves such a row alone. It changes NOTHING else about the row — status, PR, notes and the `agent` mark all
# stand, and `cc board show` prints the row with its reason, because a held row must stay visible to be released.
# Set and cleared here and nowhere else: `set <repo> <track> held "<reason>"`, `set … held ""` to lift it.
# `held_by`/`held_at` are stamped beside it, like `agent_at` beside a mark, and neither is settable by hand.
def holder():
    """Who put a row on hold — the tmux window a session runs in, else the login name. Best effort and NEVER
    fatal: unlike a mark, a hold claims nothing and grants nothing, so a name nobody can read is a worse label
    and not a hole. The reason is what a reader acts on; this only says whom to go and ask."""
    pane = os.environ.get("TMUX_PANE") or ""
    if pane:
        try:
            p = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{window_name}"],
                               capture_output=True, text=True, timeout=10)
            if not p.returncode and (p.stdout or "").strip("\n"):
                return clean(p.stdout.strip("\n"))
        except Exception:
            pass
    return clean(os.environ.get("USER") or "?")
# WHO IS ON A ROW, when nothing on the box is (owner, 2026-09-04: backlog rows run as a planning session's own
# subagents). Such a row has no worker process, no cc-loop and no tmux window of its own, so cc-reconcile saw an
# empty worktree and called it abandoned ten minutes later, and cc-pulse offered it for dispatch on every tick.
# `agent` is the row field that session sets — `cc board set <repo> <track> agent me` — and it is the SESSION's
# window, not the subagent's: a subagent is not a process anything here can see, but the session running it is.
# The mark counts while that window holds a session AND while it is still warm: `set … agent me` stamps
# `agent_at` beside it, and cc-reconcile and cc-pulse both stop counting a mark older than CC_AGENT_MARK_HOURS
# (6 h). A session still on the row marks again, which refreshes the time; one that moved on without clearing the
# mark no longer holds the row for as long as its window happens to live (review of #242). After either the row
# is unattended again and is reported like any other. `agent ''` clears both fields by hand. A mark is MADE by
# the session it names and by nothing else, and only from a window a reader counts (agent_id); the one thing that
# may move an existing one is `handover` below — which moves the name and NOT the clock, so a mark that had
# already expired stays expired — and that is the whole of the exception.
# WHAT A READER COUNTS is one thing, and a mark that misses it is worse than no mark at all. Both readers ask
# the same of a mark's window: cc-pulse's agent_held lists `-t main` and keeps a mark only where
# `#{window_name}` is the row's own repo, and cc-reconcile's mark_why keeps one only where its wins[] entry —
# the window's name again — is that repo. A window named anything else is read by NEITHER, so a claim made from
# one records an owner nobody recognises: the row reads unowned, the watchdog calls it abandoned ten minutes
# later, and cc-pulse offers it for dispatch while the subagent is still writing it. The claim does the exact
# opposite of what it was for. Three live windows are named something else — `<repo>~old`, a session cc-handoff
# has retired and whose subagents are still running (found building #318, 2026-09-07); `<repo>@<alias>`, an
# orch; `<repo>/<track>`, a track session — so this is not only the retiring session's problem.
SESSION = "main"   # the tmux session cc puts every window in, and the only one cc-pulse lists
# LITERAL ON PURPOSE, never $CC_TMUX_SESSION. cc-limit, cc-started and cc-model read that override, so changing
# this to match them looks like tidying — but the two READERS, cc-pulse and cc-reconcile, hardcode `main`. This
# constant has to be whatever THEY ask for, not whatever cc launched into: an override honoured only here would
# let a mark through that neither reader counts, which is the hole below, reopened from the other side.
def agent_id(val, repo):
    """`me` = the window THIS process is in, as "<window id>:<tmux server pid>". The server pid is half the mark
    because window ids restart at @0 when the server does: without it a mark left by a session that died in a
    reboot matches whatever window is @3 now, and the row would never be reported again.

    THE ONLY TWO VALUES ARE `me` AND EMPTY, and a typed one is refused rather than stored. Every session on the
    box writes this one file, a member-facing one included: a hand-written id naming somebody else's live window
    would hold a row open silently — no worker, nothing to see, and no ask ever raised. A mark can only ever be
    made BY the session it names.

    …AND ONLY FROM A WINDOW A READER COUNTS: in tmux session `main`, named for `repo`. This adds no way to write
    a mark — `me` is still the only value and it is still this process's own window — it refuses one that would
    be written into the dark. The refusal comes BEFORE the lock, so the row keeps whatever it already had; a
    session that wants the row anyway asks from a window that is read, and `agent ''` still hands a row back
    from anywhere."""
    if val == "": return val
    if val != "me": sys.exit("cc-board set … agent: the only values are `me` and '' (a mark is made by the "
                             "session it names, never typed)")
    pane = os.environ.get("TMUX_PANE") or ""
    if not pane: sys.exit("cc-board set … agent me: not inside tmux ($TMUX_PANE is empty)")
    try:
        p = subprocess.run(["tmux", "display-message", "-p", "-t", pane,
                            "#{window_id}:#{pid}\t#{session_name}\t#{window_name}"],
                           capture_output=True, text=True, timeout=10)
    except Exception as e:
        sys.exit(f"cc-board set … agent me: tmux would not answer ({e})")
    # NEWLINES ONLY, never a bare .strip(): a window name may legally end in a space, and a reader compares
    # the name tmux prints. Trimming it here would pass a name no reader matches — the very hole below.
    out = (p.stdout or "").strip("\n")
    f = out.split("\t")
    if p.returncode or len(f) != 3 or not re.fullmatch(r"@\d+:\d+", f[0]):
        sys.exit(f"cc-board set … agent me: tmux would not name this window ({out or 'no answer'})")
    # "a claim made from a window no reader counts is refused … the row is left exactly as it was" — a
    # reader counts a window when it is in `main` AND named for the repo, so refuse when either fails.
    # ASK THE QUESTION THE READERS ASK — `tmux list-windows -t main` — NEVER the pane's `#{session_name}`.
    # Sessions grouped onto main (`tmux new-session -t main`) share its
    # windows, and tmux answers a pane's session_name with one of the group, not necessarily `main`. That
    # name refused a live planning session's own claim on 2026-09-07 while cc-pulse and cc-reconcile listed
    # the very same window under `main` and would have counted its mark.
    try:
        q = subprocess.run(["tmux", "list-windows", "-t", SESSION, "-F", "#{window_id}"],
                           capture_output=True, text=True, timeout=10)
    except Exception as e:
        sys.exit(f"cc-board set … agent me: tmux would not list '{SESSION}' ({e})")
    counted = q.returncode == 0 and f[0].split(":")[0] in (q.stdout or "").split()
    if not counted or f[2] != repo:
        sys.exit(f"cc-board set … agent me: refused — this window is '{f[2]}' in tmux session '{f[1]}'"
                 + ("" if counted else f", which '{SESSION}' does not list") + ", and a "
                 f"mark is only read off a window named '{repo}' in '{SESSION}'. cc-reconcile and cc-pulse would "
                 f"both ignore one made here, so the row would read as unowned and be offered for dispatch while "
                 f"you are still on it. Row unchanged — mark it from the '{repo}' window.")
    return f[0]
# A FIXTURE IS NOT A BOARD (owner, 2026-09-01). A suite names everything one run makes `_cc<suite><pid>` — board, lock,
# worktree, state, tmux windows — and a suite that dies mid-run leaves them behind: one such board's `waiting` row
# reached the owner's NEEDS YOU list. core/tests/selftest.sh is `_cctest<pid>`, cc-sandbox's selfchecks `_ccsbx<pid>`,
# and it was the second of those that the board watchdog reported as two worktrees of real work (2026-09-02) — the
# prefix is the namespace, not one suite's name. This is THE place that says what a real board is. A reader of
# ~/.cc/boards either calls `cc-board boards` / `list` (cc-digest, cc ls, cc-audit) or, where it must stay in-process
# (the Home tab, cc-reconcile, the landing queue), copies this one test and names it. Only cc-reconcile's copy carries
# the prefix so far — the other two still read `_cctest` alone, so a leaked `_ccsbx<pid>` board is a board to them until
# cc-janitor rule 6 removes it, a tick of the 20-min pass later; widening a paging gate is its own change. `--all` is
# how a fixture is seen from outside its run.
FIXTURE = "_cc"                          # every suite's scratch names start here…
SUITE = re.compile(r"^_cc[a-z]+(\d+)$")  # …and each carries the pid of the run that made it, which is the whole test
_LIN = None
def lineage():
    """This process's pid chain to init, from /proc — cached: a tool's ancestry does not move while it runs."""
    global _LIN
    if _LIN is None:
        _LIN, pid = set(), os.getpid()
        while pid > 1 and pid not in _LIN:
            _LIN.add(pid)
            try:
                with open(f"/proc/{pid}/status") as f: pid = int(next(l for l in f if l.startswith("PPid:")).split()[1])
            except (OSError, StopIteration, ValueError): break
    return _LIN
def real(name):
    """A `_cc<suite><pid>` board is a board only INSIDE the run that made it — to a process under <pid>, so the suite's own
    `cc ls` / `cc digest` see their track — and nowhere else: no timer, Home tab or landing queue descends from a suite.
    A name under the prefix carrying no pid is nobody's run either, so it is scaffolding too; a real repo that merely
    CONTAINS the word (myrepo_cctesting) does not start with it and is never touched by this."""
    n = os.path.basename(name).split(".", 1)[0]
    if not n.startswith(FIXTURE):
        return True
    m = SUITE.match(n)
    return bool(m) and int(m.group(1)) in lineage()
def boards(all_=False):
    """Board names in BOARDS, sorted — the real ones, or every one with all_."""
    if not os.path.isdir(BOARDS): return []
    return sorted(fn[:-5] for fn in os.listdir(BOARDS) if fn.endswith(".json") and (all_ or real(fn)))
def clean(s):
    """A title is display text. argv arrives surrogateescaped, so a shell-mangled emoji is a lone surrogate — json.dump
    stores it happily and every later print of the board raises. Replace it on the way in; never store one."""
    return s.encode("utf-8", "replace").decode("utf-8")
def now(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
def bpath(repo): return os.path.join(BOARDS, repo + ".json")
# THE HOST NEVER FOLLOWS A LINK A MEMBER COULD HAVE PLANTED (review of #224). A member workspace's board lives in
# ~/.cc/members/<h>/board/, a directory the MEMBER writes (cc-sandbox binds it as the session's ~/.cc/boards), and the
# host's ~/.cc/boards/<h>.json and .lock are links into it. Inside, `rm <h>.json; ln -s ~/.claude/settings.json <h>.json`
# was enough: the host's next save resolved the whole chain and renamed the board over any file the owner can write,
# and the lock, opened "w", truncated one. A WORKER can plant the same link one level out — ~/.cc/boards itself is bound
# rw in that sandbox. So the host's OWN entry is read as one link, and only to the board dir of the workspace whose name
# it carries (_target); what it names is opened O_NOFOLLOW — a link there is refused, not resolved — with O_NONBLOCK, so a FIFO planted there cannot
# hang the host, and the fd must be a regular file. The temp file is mkstemp's (O_CREAT|O_EXCL, a name nobody could
# have planted). A refusal leaves the previous board intact and exits with one line naming the path.
class Refused(Exception): pass
def _target(p):
    """The host's own entry may be ONE link (cc-sandbox board_dir): what it names, never what THAT names — and only the one
    place board_dir ever puts one, ~/.cc/members/<h>/board/<same name>. WHERE it pointed was not checked, and ~/.cc/boards is
    bind-mounted RW inside a WORKER too (cc-sandbox build), so from in there `rm <repo>.json; ln -s ~/.claude/settings.json
    <repo>.json` was enough: the host's next save renamed a board over the owner's settings, and the lock's open truncated
    whatever it named. Any other target is refused, which leaves the board and the file it aimed at exactly as they were."""
    if not os.path.islink(p): return p
    t = os.readlink(p)
    t = os.path.normpath(t if os.path.isabs(t) else os.path.join(os.path.dirname(p), t))
    b = os.path.basename(p)   # <h>.json / <h>.lock → ~/.cc/members/<h>/board/<h>.json, and nothing else
    want = os.path.normpath(os.path.join(BOARDS, os.pardir, "members", b.rsplit(".", 1)[0], "board", b))
    if t != want: raise Refused(f"cc-board: {p} is a link to {t}, not to {want} — refused")
    return t
def _open(t, flags, mode=0o644):
    """os.open that refuses a link, a pipe, a directory or anything but a regular file with ONE name at t; the caller
    closes the fd. One name: link(2) across two binds is EXDEV today, so a hard link at the name is belt and braces —
    it would put the in-place fallback's O_TRUNC on whatever inode the member linked there."""
    try: fd = os.open(t, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, mode)
    except OSError as e:
        if e.errno in (errno.ELOOP, errno.ENXIO, errno.EISDIR, errno.ENOTDIR):
            raise Refused(f"cc-board: {t} is a link, a pipe or a directory, not a board file — refused")
        raise
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_nlink > 1:
        os.close(fd); raise Refused(f"cc-board: {t} is not a regular file with one name — refused")
    return fd
def read(path):
    """A board file read the way the host must read one (above): None when there is nothing there, Refused for anything
    planted. EVERY HOST READER COMES THROUGH HERE — cc-janitor, cc-pulse, cc-land, cc-owed, cc-brief, cc-reconcile,
    cc-secretary and cc-slack import this file (the way cc-time is imported) and call read(); cc-audit runs `cc-board
    json`. A plain open of ~/.cc/boards/<h>.json followed whatever the member planted, and a pipe there hung the
    timer-driven ones for good. The selfcheck's tripwire says no sibling opens a board itself."""
    try: fd = _open(_target(path), os.O_RDONLY)
    except FileNotFoundError: return None
    with os.fdopen(fd) as f: return json.load(f)
def _load(repo): return read(bpath(repo))
# A rename that may fall back to writing in place — for ONE reason. Inside a member boundary the board FILE used to be
# bind-mounted (cc-sandbox member, until 2026-09-04: it is the board's DIRECTORY now, and the rename works in there — a file
# bind pinned the old inode, so every host rename left the session a stale board), and nothing can be renamed over a mount
# point: rename(2) says EBUSY (measured; EXDEV/EINVAL/EPERM are the other spellings a mount can give). A session launched
# before that change still holds the file bind, so the fallback stays. A full disk, an I/O error or a read-only filesystem are NOT that: the first version
# caught every OSError and `open(path, "w")` then truncated the live board to nothing before its write failed again — one
# `cc-board note` on a full disk emptied a repo's board (review-156d). So the errno must be the mount's, the text is in
# memory before the target is opened, and everything else re-raises with the previous board intact.
MOUNT_ERRNOS = (errno.EBUSY, errno.EXDEV, errno.EINVAL, errno.EPERM)
def _save(repo, d):
    os.makedirs(BOARDS, exist_ok=True)
    d["updated"] = now()
    p = _target(bpath(repo))   # a member workspace's board: the file the host's link names, in ~/.cc/members/<h>/board/ — the
    try: st = os.lstat(p)      # rename lands on that name, never on the link. A link or a pipe AT that name is the member's: refused
    except FileNotFoundError: st = None   # a first save; the rename creates it
    if st is not None and (not stat.S_ISREG(st.st_mode) or st.st_nlink > 1):
        raise Refused(f"cc-board: {p} is a link, not a file, or a file with two names — refused, board unchanged")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(p), prefix=repo + ".json.", suffix=".tmp")   # O_EXCL, a fresh name: nothing planted is opened
    os.fchmod(fd, 0o644)
    with os.fdopen(fd, "w") as f: json.dump(d, f, indent=2)
    try:
        os.replace(tmp, p)               # atomic: the inode is swapped, a reader sees the old board or the new one
    except OSError as e:                 # (a link swapped in at p after the lstat is REPLACED by the rename, never written through)
        if e.errno not in MOUNT_ERRNOS:
            try: os.unlink(tmp)          # the .tmp is garbage (and on a full disk, the space it took)
            except OSError: pass
            raise
        with open(tmp) as f: text = f.read()
        with os.fdopen(_open(p, os.O_WRONLY | os.O_TRUNC), "w") as f: f.write(text)   # in place, under the same lock every writer holds
        os.unlink(tmp)
LOCK_WAIT = 30   # seconds a writer waits for the lock. A member's lock file is in its own directory, so a member session
                 # can hold it as long as it likes: the host takes it non-blocking and gives up in one line, never for good.
                 # No writer holds it longer than a load and a save (`add` runs the judge BEFORE taking it).
class Lock:
    def __init__(self, repo):
        os.makedirs(BOARDS, exist_ok=True)   # not "w": nothing is truncated, and a link or a pipe where the lock should be is refused
        self.p = _target(os.path.join(BOARDS, repo + ".lock"))
        self.f = os.fdopen(_open(self.p, os.O_WRONLY | os.O_CREAT), "w")
    def __enter__(self):
        end = time.monotonic() + LOCK_WAIT
        while True:
            try: fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB); return self
            except BlockingIOError:
                if time.monotonic() >= end:
                    self.f.close(); raise Refused(f"cc-board: {self.p} is held by another process — gave up after {LOCK_WAIT} s")
                time.sleep(0.1)
    def __exit__(self,*a): fcntl.flock(self.f, fcntl.LOCK_UN); self.f.close()
def need(repo):
    d = _load(repo)
    if d is None: sys.exit(f"cc-board: no board for '{repo}' (run: cc-board init {repo} <path> <branch>)")
    return d
# ── THE BRIEF HAS ONE HOME: ~/.cc/state/<repo>/<track>/task.md ──────────────────────────────────────────────────
# It used to have two — this JSON's `instructions` and that file — reconciled by substring on every dispatch, and
# that merge destroyed the brief it was dispatched with on FOUR tracks (#71 and #79 each fixed one variant; a
# 4590-byte brief became one sentence on 2026-08-31). Two authorities cannot be kept equal, so there is now one:
# the file. This JSON keeps a display `title` and nothing a worker is meant to read. `instructions` survives only
# as the NAME callers already type for the brief — get/set route it to the file, they never touch the JSON.
STATE = os.path.expanduser("~/.cc/state")
def tpath(repo, track): return os.path.join(STATE, repo, track, "task.md")
def read_brief(repo, track):
    try:
        with open(tpath(repo, track), errors="replace") as f: return f.read()
    except OSError: return ""
def write_brief(repo, track, text):
    p = tpath(repo, track); os.makedirs(os.path.dirname(p), exist_ok=True)
    tmp = p + ".tmp"                                  # atomic: a half-written brief is worse than an old one
    with open(tmp, "w") as f: f.write(text if text.endswith("\n") else text + "\n")
    os.replace(tmp, p)
# cc-brief writes a delimited IN FLIGHT block into task.md and owns it; these are the same two markers. A reader
# asking for the BRIEF gets what a person typed — `cc done` builds the PR body out of this.
INFLIGHT_RE = re.compile(re.escape("<!-- cc-brief:inflight -->") + r".*?" + re.escape("<!-- /cc-brief:inflight -->") + r"\n?", re.S)
def brief(repo, track):
    """The brief, migrating a pre-#94 board copy into the file ONCE, on the first read of it. Never call this while
    holding Lock(repo): it takes the lock itself, and flock on a second fd of the same file deadlocks its owner.
    cc-brief's computed IN FLIGHT block is left out: it is the box's own annotation, recomputed at every dispatch,
    and it has no business in a PR body or in the text `add` compares against to decide it is a new brief."""
    b = INFLIGHT_RE.sub("", read_brief(repo, track)).rstrip("\n")
    b = b + "\n" if b else b
    if b.strip(): return b
    try: legacy = ((_load(repo) or {}).get("tracks") or {}).get(track, {}).get("instructions") or ""
    except Exception: return b     # unlocked and cheap: the common case is nothing to migrate, and pays no lock
    if not legacy.strip(): return b
    with Lock(repo):               # there IS an old copy: move it under the lock, re-reading in case of a race
        d = _load(repo); t = ((d or {}).get("tracks") or {}).get(track) or {}
        legacy = t.pop("instructions", "") or ""
        if not legacy.strip(): return read_brief(repo, track)   # somebody else migrated it while we waited
        try: write_brief(repo, track, legacy)                   # a brief that cannot be written is still ANSWERED,
        except OSError: return legacy                           # and its JSON copy kept — `show` must not die on it
        _save(repo, d)                                          # the file holds it now: drop the copy, one authority
    return legacy
# ── A FINISHED TRACK LEAVES THE DEFAULT VIEW (owner, 2026-08-30: "this should also remove it from the board") ──
# Not instantly: for SHOWN_FOR after the merge it stays, so the session that landed it — and an owner who looks
# straight after being told — sees WHAT landed rather than a row that vanished. Two hours is longer than any one
# merge-and-follow-up and short enough that a day's work does not pile up on the board. After that the row is
# history: `--all` still prints it, `cc digest` and the log still hold it, and nothing is deleted. The Slack Home
# tab drops finished tracks the moment they finish (cc-slack home_track_shown) — it is a NEEDS-YOU surface, this
# is a working view, so this one lingers. Filter at render: no archive file to get out of step with the board.
SHOWN_FOR = 2 * 3600
FINISHED = ("merged", "done")
def age(ts):
    """Seconds since an ISO stamp this board wrote; a missing or unparseable one reads as ancient, so a row that
    cannot prove it is recent is treated as old rather than pinned to the view forever."""
    try: return max(0.0, time.time() - calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%SZ")))
    except (ValueError, TypeError): return float("inf")
def shown(t, for_=SHOWN_FOR):
    """PURE: is this row on the DEFAULT board view? (cc-board selfcheck pins it.)"""
    return t.get("status") not in FINISHED or age(t.get("updated")) < for_

def delivery(repo, track):
    """One line for a row that cc-task has given a durable identity (bin/cc-task): the task UUID, which executor
    holds it, its phase and how long the claim has stood. The record at the ROW'S OWN path is what is shown — a
    record naming another row, or one that will not parse, shows nothing, and every other row prints as it always
    did. Read through `read` for the same reason a board is: what sits in a state dir is somebody's file, so a
    link, a pipe or a directory at that name is refused rather than followed."""
    if not all(re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", n) for n in (repo, track)): return ""
    try:
        # THE SHAPE IS CHECKED, NOT THE EXCEPTION. That state dir is bound read-write into the track's worker
        # sandbox and into a member workspace, so what is in it is somebody's file: valid JSON that is a string,
        # a number, or an object whose `claim` is a string all reach `.get` and would take the whole board down
        # with a traceback — every row, not just the bad one. Anything not shaped like a record shows nothing.
        d = read(os.path.join(STATE, repo, track, "delivery.json"))
        if not isinstance(d, dict) or (d.get("schema"), d.get("repo"), d.get("row")) != (1, repo, track): return ""
        c = d["claim"] if isinstance(d.get("claim"), dict) else {}
        seconds = age(c.get("started_at"))
        elapsed = f"{int(seconds)}s" if seconds != float("inf") else "unknown"
        # An ENDED claim says why it ended rather than what it was last doing: a worker's claim is handed back the
        # moment its window is up, and "released" alone would read as if the row had been dropped.
        phase = f"ended ({c.get('reason') or 'no reason'})" if c.get("ended_at") else (c.get("phase") or "?")
        return f"      delivery: {d['task_id']}  {c.get('executor') or '?'}  {phase}  claim age {elapsed}"
    except (OSError, ValueError, TypeError, KeyError, AttributeError, Refused): return ""

def _brief_tool(*args, **kw):
    """cc-brief, from the same bin/ as this copy. It is a gate, never a hazard: anything it cannot do is nothing."""
    tool = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-brief")
    # Longer than cc-brief's own judge timeout (120 s) on purpose: the inner one must fire first, so a slow
    # judge is reported as "not judged" rather than cut off here with no reason printed.
    try: return subprocess.run([sys.executable, tool, *args], timeout=180, **kw).returncode
    except (OSError, subprocess.SubprocessError): return 0
def check_shape(repo, track, text):
    """THE SHAPE IS CHECKED AT EVERY DOOR. Three write a brief — `add`, `set … instructions` and `cc … --go` —
    and all three ask this, so a brief that prescribes the steps is refused HERE, with cc-brief printing what made
    it one. Gating only some of them gates none: `set` then `--go ""` reaches a worker with no text for --go to
    check. Not a rule in a prompt: the rule is written down twice already and a session that had read both still
    typed one.
    TWO GATES, ANSWERING DIFFERENTLY. `check` is arithmetic over the shapes it can prove. `judge` is a small model
    reading the prose, and its exit code separates the two things a caller must not confuse: 1 = it read the brief
    and rejected it (hard, with what to cut), 2 = it could not judge at all, and then the brief goes through.
    CC_BRIEF_FORCE=1 turns either refusal into a flag, and cc-brief records that it was used."""
    for gate in ("check", "judge"):
        if _brief_tool(gate, "-", "--for", f"{repo}/{track}", input=text, text=True) == 1:
            sys.exit(1)
def refresh_inflight(repo, track):
    """…and what OTHER live tracks are holding is computed into the brief from the board, never typed into it."""
    _brief_tool("refresh", repo, track)
def offer_join(repo, track):
    """…and if a live row is ALREADY writing these files, `add` says so, here, before a second landing exists for
    them. Every row costs its own gates, review read and merge, and whether two asks are one concern was a match
    made from memory — missed exactly when the session had just changed hands. cc-brief does the arithmetic and
    prints the `cc board add` that would join them; nothing here decides, and a row is added either way.
    ON STDERR: `add` prints the row it wrote on stdout, and a caller reading that must not find an offer folded
    into it — the same lane the append notice above uses."""
    _brief_tool("belongs", repo, track, stdout=sys.stderr)

USAGE = {"init":3,"add":4,"set":5,"get":4,"status":4,"note":4,"rm":3,"tracks":2,"json":2,"show":2,"base":2,"list":1,"boards":1,"selfcheck":1,"handover":5}
def main(a):
    if not a: sys.exit("usage: cc-board {init|add|set|get|status|note|show [--all]|json|base|list [--all]|boards [--all]|rm|tracks|handover|selfcheck} ...")
    cmd = a[0]
    sys.stdout.reconfigure(errors="replace")   # a bad title already on disk prints as '?', never as a traceback
    if cmd in USAGE and len(a) < USAGE[cmd]:   # a short call must say so, not traceback
        sys.exit(f"cc-board {cmd}: needs {USAGE[cmd]-1} argument(s), got {len(a)-1}")
    if cmd == "init":
        repo, path, branch = a[1], a[2], (a[3] if len(a)>3 else "main")
        with Lock(repo):
            d = _load(repo) or {"repo":repo,"tracks":{},"log":[]}
            d.update({"path":path,"default_branch":branch,"created":d.get("created",now())})
            _save(repo, d)
        print(f"board ready: {repo} ({path}, base {branch})")
    elif cmd == "add":
        repo, track, title = a[1], a[2], clean(a[3])
        instr = " ".join(a[4:])
        have = brief(repo, track)            # migrate a legacy JSON copy FIRST — the pop below would drop it
        if instr.strip():                    # the brief goes to its one home; the board JSON keeps the title
            check_shape(repo, track, instr)  # …if it is a brief at all: a step list never reaches the file
            if not have.strip(): write_brief(repo, track, instr)
            elif instr.strip() not in have:   # something is already there: APPEND. Never clobber a brief as a side
                write_brief(repo, track, have.rstrip("\n") + "\n\n" + instr)   # effect of another command — that
                print(f"cc-board add: {repo}/{track} already had a brief — appended rather than replaced.\n"
                      f"  replace it deliberately: cc-board set {repo} {track} instructions '<brief>'", file=sys.stderr)
        with Lock(repo):
            d = need(repo)
            t = d["tracks"].get(track, {})
            t.pop("instructions", None)                 # a re-add drops the pre-#94 copy too
            t.update({"title":title, "kind":kind(t),
                      "status":state(t.get("status","queued")),
                      "branch":t.get("branch",f"track/{track}"),
                      "worktree":t.get("worktree", os.path.expanduser(f"~/.cc/worktrees/{repo}/{track}")),
                      "session_id":t.get("session_id",""),"started":t.get("started",False),
                      "pr":t.get("pr",""),"notes":t.get("notes",[]),
                      "created":t.get("created",now()),"updated":now()})
            d["tracks"][track]=t
            d["log"].append({"ts":now(),"track":track,"msg":f"added: {title}"})
            _save(repo,d)
        refresh_inflight(repo, track)        # the row exists now, so the block can name every OTHER live track
        print(f"track '{track}' added to {repo}")
        offer_join(repo, track)              # …and a live row already in these files is offered, not left to memory
    elif cmd == "set":
        repo, track, key, val = a[1], a[2], a[3], a[4]
        if key == "instructions":            # replacing a brief is an EXPLICIT act, and this is the verb for it
            if track not in need(repo)["tracks"]: sys.exit(f"no track '{track}'")
            brief(repo, track)               # migrate first, so the old copy cannot come back over the new one
            check_shape(repo, track, val)    # …and it is a door like `add`: `set` then `--go ""` would otherwise
            write_brief(repo, track, val); return    # dispatch a step list past both gates, --go having no text to check
        if key == "agent_at":
            # THE CLOCK ON A MARK IS NOT A FIELD ANYONE SETS. It is written only as a side effect of `set agent
            # me` / `agent ''` below, and for the same reason a mark can only be made by the session it names:
            # every session writes this one file, a member-facing one included, and a hand-set time would refresh
            # a stale mark for ever — holding a row out of the reconciler and out of cc-pulse with nothing on the
            # box doing it, which is the failure the expiry exists to end (review of #242).
            sys.exit("cc-board set … agent_at: not settable — the time is stamped by `set … agent me`, which is "
                     "also how a session still on a row refreshes it")
        if key in ("held_at", "held_by"):
            # Same rule, same reason as agent_at: both are stamped as a side effect of the hold itself, and a
            # hand-written holder would name somebody who never agreed to be asked about it.
            sys.exit(f"cc-board set … {key}: not settable — both are stamped by `set … held \"<reason>\"`, which "
                     "is also how a hold is lifted (`set … held \"\"`)")
        if key not in FIELDS:
            sys.exit(f"cc-board set: '{key}' is not a field this board knows — known fields: {', '.join(FIELDS)}")
        if key == "agent": val = agent_id(val, repo)  # `me` becomes this session's window — asked BEFORE the lock,
        held_by = ""                                  # because it shells out to tmux and the board is one file
        if key == "held":                             # …and holder() shells out to tmux the same way, with the same
            val = clean(val)                          # 10 s timeout: a board every session writes must not be held
            held_by = holder() if val else ""         # shut while one of them waits on a tmux server
        with Lock(repo):
            d = need(repo)
            if track not in d["tracks"]: sys.exit(f"no track '{track}'")
            if key=="started": val = val.lower() in ("1","true","yes")
            if key=="status": val = state(val)   # `cc-board set … status todo` speaks the same word as `cc-board status`
            if key=="title": val = clean(val)
            if key=="kind" and val not in KINDS: sys.exit(f"kind must be one of {list(KINDS)}")
            # WHEN the mark was made, beside it. `updated` cannot answer this — every other `set` moves it too —
            # and the readers need the age to expire a mark whose session moved on (see the note on agent_id).
            if key=="agent": d["tracks"][track]["agent_at"] = now() if val else ""
            # …and WHO and WHEN beside a hold, for the same reason: the readers below print the reason, and a
            # reader who wants it lifted has to know whom to ask. Logged both ways — a hold nobody can find in
            # the log is a hold nobody lifts.
            if key=="held":
                d["tracks"][track]["held_by"] = held_by
                d["tracks"][track]["held_at"] = now() if val else ""
                d["log"].append({"ts":now(),"track":track,"msg":f"held: {val}" if val else "hold lifted"})
            d["tracks"][track][key]=val; d["tracks"][track]["updated"]=now()
            _save(repo,d)
    elif cmd == "handover":
        # A MARK MOVES WHEN THE SESSION HOLDING IT IS RETIRED — the one exception to `agent_id`'s rule that a mark
        # is made by the session it names. A handoff renames the retiring session's window, and every mark it made
        # stops counting in that instant while its subagents are still running and still reporting to the successor
        # (cc-handoff, carry_marks): five rows were called abandoned and blocked ten minutes after a cutover, then
        # offered for dispatch a second time (2026-09-07). The successor takes those reports, so it holds the rows.
        #
        # WHY THIS IS NOT THE HOLE `agent me` REFUSES. That refusal exists because a typed mark naming somebody
        # else's live window would hold an UNOWNED row open in silence. This never claims a row: it rewrites only
        # rows that already carry `<from>` — rows already held out of the reconciler by that mark — and it must be
        # told each track by name, so it can never sweep a board. Aim it at a window that is not there and the row
        # is RELEASED, not held (a reader wants the mark's window to still be a session on this repo), so the
        # dangerous direction is the one it cannot go.
        repo, frm, to, names = a[1], a[2], a[3], a[4:]
        for m in (frm, to):
            if not re.fullmatch(r"@\d+:\d+", m):
                sys.exit(f"cc-board handover: '{m}' is not a mark (<window id>:<tmux server pid>)")
        if frm == to: sys.exit("cc-board handover: from and to name the same window")
        moved = []
        with Lock(repo):
            d = need(repo)
            for track in names:
                t = d["tracks"].get(track)
                # EXACTLY EQUAL, never a prefix: `@1:900` is not `@12:900`, and a prefix match here would hand one
                # session's live row to another in silence — worse than the bug this verb exists for.
                if t is None or (t.get("agent") or "").strip() != frm: continue
                # THE CLOCK IS CARRIED, NOT RESTARTED. `agent_at` is the age both readers expire a mark on
                # (cc-reconcile mark_why, cc-pulse agent_held), so a fresh stamp here would make a mark they had
                # both already given up on warm again: a row marked at 02:00 whose subagent died, cold by 09:00
                # and already `blocked`, would read `running` for six more hours with nothing on the box doing
                # it — 'loosening it would hide a real abandonment'. The successor inherits the hold that was
                # actually left, and refreshes it the ordinary way (`set … agent me`) because the row names its
                # own window now. The usage-limit half of mark_why is keyed on this stamp for the same reason.
                t["agent"], t["updated"] = to, now()
                d["log"].append({"ts": now(), "track": track, "msg": f"agent {frm} -> {to} (handoff)"})
                moved.append(track)
            if moved: _save(repo, d)
        print("\n".join(moved))
    elif cmd == "get":
        repo, track, key = a[1], a[2], a[3]
        if key == "instructions": print(brief(repo, track), end=""); return
        d = need(repo); t = d["tracks"].get(track)
        if key == "kind": print(kind(t) if t is not None else ""); return   # a row with no field IS a track
        print((t or {}).get(key,""))
    elif cmd == "status":
        repo, track, st = a[1], a[2], state(a[3])
        if st not in STATES: sys.exit(f"status must be one of {STATES}")
        with Lock(repo):
            d = need(repo)
            if track not in d["tracks"]: sys.exit(f"no track '{track}'")
            d["tracks"][track]["status"]=st; d["tracks"][track]["updated"]=now()
            d["log"].append({"ts":now(),"track":track,"msg":f"status -> {st}"})
            _save(repo,d)
        print(f"{repo}/{track}: {st}")
    elif cmd == "note":
        repo, track = a[1], a[2]; msg=" ".join(a[3:])
        with Lock(repo):
            d = need(repo)
            if track not in d["tracks"]: sys.exit(f"no track '{track}'")
            d["tracks"][track].setdefault("notes",[]).append({"ts":now(),"msg":msg})
            d["tracks"][track]["updated"]=now()
            d["log"].append({"ts":now(),"track":track,"msg":msg})
            _save(repo,d)
    elif cmd == "rm":
        repo, track = a[1], a[2]
        with Lock(repo):
            d = need(repo); d["tracks"].pop(track,None)
            d["log"].append({"ts":now(),"track":track,"msg":"removed"})
            _save(repo,d)
    elif cmd == "base":
        # THE PROJECT'S BASE BRANCH, from the one place that records it. cc-land already lands against this; `cc`
        # asks it before trusting origin/HEAD, which is only what a remote calls its default. No board yet = no
        # answer (empty, rc 0), because `cc` asks this while it is creating the board.
        d = _load(a[1]) or {}
        print(d.get("default_branch", ""))
    elif cmd == "tracks":
        d = need(a[1]); print("\n".join(d["tracks"].keys()))
    elif cmd == "json":
        print(json.dumps(need(a[1]), indent=2))
    elif cmd == "list":
        for name in boards("--all" in a[1:]):   # real boards; a selftest fixture only with --all (FIXTURE above)
            try: d = _load(name) or {}
            except Exception as e:   # one unreadable board must not hide every other repo
                print(f"{name}.json: unreadable ({e})", file=sys.stderr); continue
            for tr,t in d.get("tracks",{}).items():
                st = "session" if kind(t) == "session" else t.get("status","?")   # what the row IS, for cc ls/digest/resume
                print(f"{d.get('repo',name)}\t{tr}\t{st}\t{t.get('title','')}")
    elif cmd == "boards":
        print("\n".join(boards("--all" in a[1:])))   # the names, one per line: what a shell reader of ~/.cc/boards iterates
    elif cmd == "show":
        rest = [x for x in a[1:] if x != "--all"]; allrows = "--all" in a[1:]
        if not rest: sys.exit("cc-board show: needs a repo")
        repo = rest[0]; d = need(repo)
        ico = {"queued":"·","todo":"·","running":"▶","waiting":"❓","review":"◆","blocked":"■","merged":"✓","done":"✓"}
        rows = [(tr,t) for tr,t in d["tracks"].items() if allrows or shown(t)]
        rows.sort(key=lambda r: kind(r[1]) == "session")   # stable: the tracks, then the repo's sessions grouped under them
        hid = len(d["tracks"]) - len(rows)
        print(f"\n\033[1m{d['repo']}\033[0m  base:{d.get('default_branch','main')}  {d.get('path','')}")
        if not d["tracks"]: print("  (no tracks yet)")
        elif not rows: print("  (nothing open)")
        for tr,t in rows:
            if kind(t) == "session": print(f"  ↳ \033[1m{tr}\033[0m [session]  {t.get('title','')}")
            else: print(f"  {ico.get(t.get('status'),'?')} \033[1m{tr}\033[0m [{t.get('status')}]  {t.get('title','')}")
            detail = delivery(repo, tr) if kind(t) != "session" else ""
            if detail: print(detail)
            # THE HOLD IS THE FIRST THING UNDER THE ROW. Every watcher is quiet about a held row on purpose, so
            # this view is the only place it is offered to a person at all — and a hold with no reason in sight
            # is the note the watchdog could not read, again.
            if t.get("held"): print(f"      held ({t.get('held_by') or '?'}): {str(t['held'])[:160]}")
            b = brief(repo, tr).strip()   # a legacy row migrates on this read, like every other read of the brief
            if b: print(f"      task: {b[:200]}")
            if t.get("pr"): print(f"      PR: {t['pr']}")
            for n in t.get("notes",[])[-3:]: print(f"      - {n['msg'][:160]}")
        if hid: print(f"  \033[2m({hid} finished — cc board show {repo} --all)\033[0m")
        print()
    elif cmd == "selfcheck":
        sys.exit(selfcheck())
    else:
        sys.exit(f"cc-board: unknown command '{cmd}'")

def selfcheck():
    """STATIC: the two rules this file owns, checked against fixtures — no board, no state dir, no clock beyond
    its own. Run by tests/check.sh, so a regression fails the commit rather than the next `cc board show`."""
    n = 0
    def ok(what, cond):
        nonlocal n
        print(("  ok   " if cond else "  FAIL ") + what)
        if not cond: n += 1
    old_ = lambda st: {"status": st, "updated": "2000-01-01T00:00:00Z"}
    new_ = lambda st: {"status": st, "updated": now()}
    print("cc-board selfcheck")
    ok("a running track is on the default view", shown(new_("running")) and shown(old_("running")))
    ok("a track just merged is still shown, so the owner sees what landed", shown(new_("merged")))
    ok("…and leaves once the window is past", not shown(old_("merged")) and not shown(old_("done")))
    ok("a stamp that cannot be read counts as old, never as pinned", not shown({"status": "merged"})
       and not shown({"status": "done", "updated": "yesterday"}))
    ok("blocked and waiting never leave — they are what the board is for",
       shown(old_("blocked")) and shown(old_("waiting")) and shown(old_("review")))
    ok("the window is what the comment above it says", SHOWN_FOR == 2 * 3600 and shown(new_("merged"), 0) is False)
    # …and the invariant the whole change exists for, exercised for real in a HOME of its own: the brief lands in
    # the file, the JSON never carries a copy, and every route ADDS to a brief rather than eating it.
    import subprocess, tempfile, shutil
    th = tempfile.mkdtemp(prefix="ccboard-sc-")
    try:
        # CC_BRIEF_FAKE stands in for the judge `add` now asks: this suite has no API calls, and without it the
        # only reason no model runs is that $HOME/.local/bin/claude is missing under the fixture HOME — accident,
        # not assertion. cc-brief's own selfcheck is where the judge's verdicts are pinned.
        def run(*args):
            try: return subprocess.run([sys.executable, os.path.realpath(__file__), *args],
                                       env={**os.environ, "HOME": th, "CC_BRIEF_FAKE": '{"verdict":"approve","why":"","cut":[]}'},
                                       capture_output=True, text=True, timeout=60)
            except subprocess.TimeoutExpired as e:   # a hang is ONE failed case, not a suite that never ends
                out = e.stdout.decode(errors="replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
                return subprocess.CompletedProcess(e.cmd, 124, out, f"cc-board selfcheck: `{' '.join(args)}` hung for 60 s")
        def bounded(fn, secs=10):   # an in-process call that hangs (a blocking flock, a plain open of a pipe) fails THIS case, not the suite
            import threading
            box = []
            def go():
                try: box.append(fn())
                except Exception as e: box.append(e)
            t = threading.Thread(target=go, daemon=True); t.start(); t.join(secs)
            return box[0] if box else "hung"
        run("init", "r", "/tmp/r", "main"); run("add", "r", "t1", "T", "THE BRIEF, in full.")
        blob = run("json", "r").stdout
        ok("`add` writes the brief to task.md", open(f"{th}/.cc/state/r/t1/task.md").read().strip() == "THE BRIEF, in full.")
        ok("…and the board JSON keeps no copy of it", "instructions" not in blob and "THE BRIEF" not in blob)
        ok("`get instructions` reads that file", run("get", "r", "t1", "instructions").stdout.strip() == "THE BRIEF, in full.")
        # Its own fixture: cc-brief's block written into that file by hand, so this stands whether or not a board
        # anywhere has a live track. `cc done` builds the PR body out of this read.
        open(f"{th}/.cc/state/r/t1/task.md", "a").write(
            "\n<!-- cc-brief:inflight -->\nIN FLIGHT: core/bin/cc-foo — other [running]\n<!-- /cc-brief:inflight -->\n")
        ok("…without the computed IN FLIGHT block: a reader asking for the brief gets what a person typed",
           run("get", "r", "t1", "instructions").stdout.strip() == "THE BRIEF, in full.")
        run("add", "r", "t1", "T", "a one-line note")
        body = open(f"{th}/.cc/state/r/t1/task.md").read()
        ok("`add` appends to a brief instead of overwriting it (four tracks lost one that way)",
           "THE BRIEF, in full." in body and "a one-line note" in body)
        run("add", "r", "t1", "T", "a one-line note")
        ok("…and adding the same thing twice stacks nothing up",
           open(f"{th}/.cc/state/r/t1/task.md").read() == body)
        run("set", "r", "t1", "instructions", "REPLACED")
        ok("`set instructions` is the explicit way to replace it",
           open(f"{th}/.cc/state/r/t1/task.md").read().strip() == "REPLACED")
        # …and it is a door, so it is gated like `add`: `set` then `cc … --go ""` would otherwise walk a step list
        # past both gates, --go having no text of its own to check. The brief already there must survive the refusal.
        r = run("set", "r", "t1", "instructions",
                "Do this:\n- Add a --flag to cc-foo\n- Edit cc-bar to pass it through\n- Run the suite")
        ok("`set instructions` refuses a step list too, and the brief that was there is untouched",
           r.returncode == 1 and "step-list" in r.stderr
           and open(f"{th}/.cc/state/r/t1/task.md").read().strip() == "REPLACED")
        # migration: a row written before this still carries the brief in the JSON, and is moved once
        d = json.load(open(f"{th}/.cc/boards/r.json")); d["tracks"]["t2"] = {"title": "T2", "status": "queued",
            "instructions": "AN OLD BRIEF", "updated": now()}
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        got = run("get", "r", "t2", "instructions").stdout.strip()
        ok("a pre-#94 board copy migrates into task.md on first read",
           got == "AN OLD BRIEF" and open(f"{th}/.cc/state/r/t2/task.md").read().strip() == "AN OLD BRIEF")
        ok("…and is gone from the JSON afterwards, so there is only ever one authority",
           "AN OLD BRIEF" not in run("json", "r").stdout)
        ok("`show` prints the brief from the file", "REPLACED" in run("show", "r").stdout)
        d = json.load(open(f"{th}/.cc/boards/r.json")); d["tracks"]["t3"] = {"title": "T3", "status": "queued",
            "instructions": "A THIRD OLD BRIEF", "updated": now()}
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        run("add", "r", "t3", "renamed")     # a bare re-add drops the JSON copy — it must migrate it, not lose it
        ok("a re-add of a legacy row migrates its brief before dropping the JSON copy",
           open(f"{th}/.cc/state/r/t3/task.md").read().strip() == "A THIRD OLD BRIEF"
           and "A THIRD OLD BRIEF" not in run("json", "r").stdout)
        # a13's own proof, on rendered output rather than on the predicate: a merged row past its window is not in
        # `cc board show`, IS in `--all`, and the view says it hid something. This is the ledger row's check-cmd.
        run("add", "r", "m1", "M1 LANDED"); run("status", "r", "m1", "merged")
        fresh = run("show", "r").stdout
        d = json.load(open(f"{th}/.cc/boards/r.json")); d["tracks"]["m1"]["updated"] = "2000-01-01T00:00:00Z"
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        stale = run("show", "r").stdout
        ok("a13: a just-merged row is on the default board, one past its window is not",
           "M1 LANDED" in fresh and "M1 LANDED" not in stale)
        ok("a13: `--all` still prints it, and the default view says it hid something",
           "M1 LANDED" in run("show", "r", "--all").stdout and "finished" in stale)
        # a shell-mangled emoji reaches argv as a lone surrogate; stored once, it turned every `show` into a traceback
        bad = "T \udc94 mangled"
        r = run("add", "r", "s1", bad); run("set", "r", "s1", "title", bad)
        stored = json.load(open(f"{th}/.cc/boards/r.json"))["tracks"]["s1"]["title"]
        ok("`add` and `set title` never store a lone surrogate", r.returncode == 0 and "\udc94" not in stored and "mangled" in stored)
        d = json.load(open(f"{th}/.cc/boards/r.json")); d["tracks"]["s1"]["title"] = bad   # one written before this fix
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        sh, ls = run("show", "r"), run("list")
        ok("`show` and `list` print a bad title already on disk instead of crashing",
           sh.returncode == 0 and ls.returncode == 0 and "mangled" in sh.stdout and "mangled" in ls.stdout)
        # THE BASE IS A REPO FACT, and this is how a shell reader asks for it — cc, cc-loop and cc-checkpoint all
        # do, before they trust origin/HEAD. This is the contract those three read, so it is pinned on a base that
        # is NOT `main`: `main` is also the word every one of them falls back to, so a `base` that answered it
        # blindly would look right in all three (review of #230). A repo with no board answers an empty line and
        # rc 0 rather than failing — `cc` asks while it is creating one — and that empty answer is the callers' cue.
        run("init", "r", "/tmp/r", "trunk")
        ok("`base` prints the board's base, not the word its callers fall back to", run("base", "r").stdout == "trunk\n")
        run("init", "r", "/tmp/r", "main")   # …and back, so the rows below read the board every other case wrote
        nb = run("base", "nosuch")
        ok("…and a repo with no board answers an empty line and rc 0, which is how a caller knows to fall back",
           nb.stdout == "\n" and nb.returncode == 0 and run("base", "r").stdout == "main\n")
        # KIND: a row is a `track` unless it says `session`, and a session row says so wherever a row is printed
        ok("a row with no kind field is a track, and `add` stamps the kind on a new row",
           run("get", "r", "t2", "kind").stdout.strip() == "track"
           and json.load(open(f"{th}/.cc/boards/r.json"))["tracks"]["t1"]["kind"] == "track")
        r = run("set", "r", "t1", "kind", "channel")
        ok("`set kind` takes track or session and nothing else",
           r.returncode != 0 and run("get", "r", "t1", "kind").stdout.strip() == "track")
        # A FIELD NAME THAT DOES NOT EXIST IS AN ERROR, NOT A DEAD KEY (2026-09-07): `set … state review` used to
        # write a `state` key beside the real `status` and print nothing — the exact confusion that cost two
        # sessions a silent no-op before either found the cause.
        r = run("set", "r", "t1", "state", "review")
        ok("`set` refuses a field it does not know, naming the fields that do exist, and writes nothing",
           r.returncode != 0 and "state" in r.stderr and "status" in r.stderr
           and "state" not in json.load(open(f"{th}/.cc/boards/r.json"))["tracks"]["t1"])
        run("set", "r", "t1", "status", "review")
        ok("…while a field that does exist still sets, `status` included",
           run("get", "r", "t1", "status").stdout.strip() == "review")
        run("set", "r", "t1", "status", "queued")   # back to what later cases in this suite expect of t1
        run("add", "r", "sess9", "a course session", ""); run("set", "r", "sess9", "kind", "session")
        run("status", "r", "sess9", "running"); run("add", "r", "sess9", "a course session", "")
        ok("a session row keeps its kind across a re-add", run("get", "r", "sess9", "kind").stdout.strip() == "session")
        ls, sh = run("list").stdout, run("show", "r").stdout
        ok("`list` says `session` in the status column for a session row — cc ls, cc digest and cc resume read that "
           "column — and a track's status exactly as before",
           "r\tsess9\tsession\t" in ls and "r\tt1\tqueued\t" in ls)
        ok("`show` prints a session row after the tracks, indented, with no status icon; a track row as before",
           "  ↳ \033[1msess9\033[0m [session]  a course session" in sh and "  · \033[1mt1\033[0m [queued]" in sh
           and sh.index("[queued]") < sh.index("[session]"))
        # THE TASK IDENTITY ON THE ROW (bin/cc-task). It is read off the row's own state dir at render time, so
        # there is nothing on the board to get out of step with it — and a row without a record is byte-identical
        # to what it printed before this existed, which is what "preserve legacy rows" has to mean.
        def lay(row, rec):
            os.makedirs(f"{th}/.cc/state/r/{row}", exist_ok=True)
            with open(f"{th}/.cc/state/r/{row}/delivery.json", "w") as fh: fh.write(rec)
        task = {"schema": 1, "repo": "r", "row": "t1", "task_id": "00000000-0000-4000-8000-000000000001",
                "claim": {"executor": "subagent", "phase": "starting", "started_at": now()}}
        dp = f"{th}/.cc/state/r/t1/delivery.json"
        before, tsv = run("show", "r").stdout, run("list").stdout
        lay("t1", json.dumps(task)); projected = run("show", "r").stdout
        detail = next((l for l in projected.splitlines(True) if "delivery:" in l), "")
        ok("`show` projects the task UUID, executor, phase and claim age; every other byte, and the TSV, are unchanged",
           task["task_id"] in detail and "subagent  starting  claim age " in detail
           and re.search(r"claim age \d+s", detail) is not None
           and projected.replace(detail, "", 1) == before and run("list").stdout == tsv)
        task["claim"].update(executor="worker", phase="released", started_at="2000-01-01T00:00:00Z")
        lay("t1", json.dumps(task)); changed = run("show", "r").stdout
        ok("the line follows the durable record, an old claim included — no board field caches any of it",
           "worker  released  claim age " in changed and "claim age 0s" not in changed
           and "subagent  starting" not in changed)
        task["claim"].update(phase="released", ended_at=now(), reason="worker launched")
        lay("t1", json.dumps(task)); ended = run("show", "r").stdout
        ok("a claim that has ended says why, not what it was last doing — a worker's is handed back at launch",
           "worker  ended (worker launched)  claim age " in ended and "  released  " not in ended)
        task["claim"].pop("ended_at"); task["claim"].pop("reason")
        task["row"] = "sibling"; lay("t1", json.dumps(task))
        ok("a record naming another row is not this row's, and shows nothing", run("show", "r").stdout == before)
        junk = ('{', '"held"', '17', 'null', '[{"schema": 1}]', '{"schema": 1, "repo": "r", "row": "t1"}')
        for j in junk: lay("t1", j)
        outs = [(lay("t1", j), run("show", "r"))[1] for j in junk]
        ok("nothing shaped like a record shows one — unparseable, a bare scalar, a list, no task id — and the "
           "board is whole either way (that dir is bound rw into a worker sandbox and a member workspace)",
           all(o.stdout == before and "Traceback" not in o.stderr for o in outs))
        lay("t1", '{"schema": 1, "repo": "r", "row": "t1", "task_id": "x", "claim": "held"}')
        broken = run("show", "r")
        ok("…and a record whose claim is a string still prints its row, with the claim unknown rather than a traceback",
           "Traceback" not in broken.stderr and broken.returncode == 0
           and "delivery: x  ?  ?  claim age unknown" in broken.stdout
           and broken.stdout.replace("      delivery: x  ?  ?  claim age unknown\n", "", 1) == before)
        os.remove(dp); task["row"] = "sess9"; lay("sess9", json.dumps(task))
        ok("a row with no record, and a session row with a task-shaped file beside it, print exactly as before",
           run("show", "r").stdout == before and run("list").stdout == tsv)
        os.remove(f"{th}/.cc/state/r/sess9/delivery.json")
        # AGENT: who is on a row when nothing on the box is. `me` stamps the session's OWN tmux window, because a
        # subagent is not a process cc-reconcile or cc-pulse can see, and the session running it is (owner, 2026-09-04).
        stub = f"{th}/stub"; os.makedirs(stub, exist_ok=True)
        def tmux_stub(body):
            open(f"{stub}/tmux", "w").write("#!/bin/sh\n" + body + "\n"); os.chmod(f"{stub}/tmux", 0o755)
        def runt(*args, pane="%9"):
            return subprocess.run([sys.executable, os.path.realpath(__file__), *args],
                                  env={**os.environ, "HOME": th, "TMUX_PANE": pane,
                                       "PATH": stub + os.pathsep + os.environ.get("PATH", "")},
                                  capture_output=True, text=True)
        # the three fields agent_id asks for: the mark, and the two things a reader tests the window on
        # THE STUB ANSWERS BOTH QUESTIONS agent_id ASKS, because the second one is the whole check: the pane's
        # own line, and `list-windows -t main`, which is what cc-pulse and cc-reconcile ask. `listed=False` is a
        # window that session does not have.
        def win_stub(sess, name, mark="@7:4242", listed=True):
            wid = mark.split(":")[0]
            tmux_stub(f'[ "$1" = list-windows ] && {{ printf "@4\\n{wid if listed else "@6"}\\n"; exit 0; }}\n'
                      f'printf "{mark}\\t{sess}\\t{name}\\n"')
        win_stub("main", "r")
        runt("set", "r", "t1", "agent", "me")
        ok("`set … agent me` stores this session's window AND the tmux server that numbered it — window ids "
           "restart at @0 when the server does, and a mark left across a reboot must match nothing",
           run("get", "r", "t1", "agent").stdout.strip() == "@7:4242")
        r = runt("set", "r", "t1", "agent", "me", pane="")
        ok("…outside tmux it refuses rather than storing a mark that means nothing, and the old one stands",
           r.returncode != 0 and run("get", "r", "t1", "agent").stdout.strip() == "@7:4242")
        tmux_stub("exit 1")
        r = runt("set", "r", "t1", "agent", "me")
        ok("…and a tmux that will not name the window is a refusal too, never a blank mark",
           r.returncode != 0 and run("get", "r", "t1", "agent").stdout.strip() == "@7:4242")
        win_stub("main", "r")
        r = runt("set", "r", "t1", "agent", "@1:2")
        ok("A MARK IS MADE BY THE SESSION IT NAMES, never typed: every session writes this one file, so a "
           "hand-written id naming somebody else's live window would hold a row open with nothing to see",
           r.returncode != 0 and run("get", "r", "t1", "agent").stdout.strip() == "@7:4242")
        at1 = run("get", "r", "t1", "agent_at").stdout.strip()
        ok("a mark carries WHEN it was made, because a mark that never expires holds a row open for as long as "
           "the session's window lives — and `updated` cannot say, every other `set` moves it too",
           re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", at1) is not None)
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        d["tracks"]["t1"]["agent_at"] = "2020-01-01T00:00:00Z"
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        runt("set", "r", "t1", "agent", "me")
        ok("…and marking again refreshes it: that is how a session still on the row says so, and the one command "
           "it costs is the whole price of the mark expiring at all",
           run("get", "r", "t1", "agent_at").stdout.strip() >= at1)
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        d["tracks"]["t1"]["agent_at"] = "2020-01-01T00:00:00Z"
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        r = run("set", "r", "t1", "agent_at", "2099-01-01T00:00:00Z")
        ok("THE CLOCK IS NOT A FIELD ANYONE SETS: setting it by hand is refused and the cold mark stays cold — "
           "otherwise any writer of this file could refresh a stale mark for ever, or stamp a time onto a row "
           "with no mark at all",
           r.returncode != 0 and run("get", "r", "t1", "agent_at").stdout.strip() == "2020-01-01T00:00:00Z"
           and run("set", "r", "t2", "agent_at", "2099-01-01T00:00:00Z").returncode != 0
           and run("get", "r", "t2", "agent_at").stdout.strip() == "")
        runt("set", "r", "t1", "agent", "me")
        run("set", "r", "t1", "agent", "")
        ok("`agent ''` hands the row back, time and all",
           run("get", "r", "t1", "agent").stdout.strip() == ""
           and run("get", "r", "t1", "agent_at").stdout.strip() == "")
        # A MARK FROM A WINDOW NO READER COUNTS IS REFUSED (2026-09-07). Both readers keep a mark only where its
        # window is in tmux session `main` and named for the ROW'S OWN REPO — cc-pulse's agent_held lists `-t
        # main` and matches `#{window_name}` against the repo, cc-reconcile's mark_why matches the same name. A
        # claim from any other window therefore records an owner nobody recognises: the row reads unowned, the
        # watchdog calls it abandoned and it is offered for dispatch while the subagent is still writing it, so
        # the claim RELEASES the row instead of holding it. Its own row, marked by a window it does not use.
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        d["tracks"]["u1"] = {"title": "u1", "status": "running", "agent": "@5:900", "kind": "track",
                             "agent_at": "2020-01-01T00:00:00Z", "updated": "2020-01-01T00:00:00Z"}
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        u1 = lambda k="agent": json.load(open(f"{th}/.cc/boards/r.json"))["tracks"]["u1"].get(k, "")
        for sess, name, why in (("main", "r~old", "a session cc-handoff retired, subagents still running"),
                                ("main", "r@x1", "an orch"),
                                ("main", "r/t1", "a track session"),
                                ("main", "other", "a session speaking for another repo"),
                                ("work", "r", "the right name outside the tmux session cc-pulse lists")):
            win_stub(sess, name, listed=(sess != "work"))
            rf = runt("set", "r", "u1", "agent", "me")
            ok(f"a mark from {why} — window '{name}' in '{sess}' — is refused, the reason names both what this "
               "window is and what a read one would be, and the row keeps the mark and the clock it already "
               "had: a claim must never be the thing that releases a row",
               rf.returncode != 0 and f"'{name}' in tmux session '{sess}'" in rf.stderr
               and "named 'r' in 'main'" in rf.stderr
               and u1() == "@5:900" and u1("agent_at") == "2020-01-01T00:00:00Z"
               and u1("updated") == "2020-01-01T00:00:00Z")
        # A SESSION GROUPED ONTO `main` IS ON `main`. `tmux new-session -t main` shares main's windows, and tmux
        # answers a pane's #{session_name} with whichever session of the group it resolves — `main-13`, say.
        # Testing that NAME refused a live planning session's claim on its own row (2026-09-07) while both
        # readers, which ask `list-windows -t main`, listed the very same window and
        # would have counted the mark. The window a reader counts is the window `main` lists, so ask that.
        win_stub("main-13", "r")
        rf = runt("set", "r", "u1", "agent", "me")
        ok("a session grouped onto `main` — tmux answers 'main-13' for its pane — marks its own row, because "
           "the readers list that window under `main` and would count it",
           rf.returncode == 0 and u1() == "@7:4242")
        run("set", "r", "u1", "agent", "@5:900")
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        d["tracks"]["u1"]["agent"] = "@5:900"; d["tracks"]["u1"]["agent_at"] = "2020-01-01T00:00:00Z"
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        win_stub("main", "r")
        rf = runt("set", "r", "u1", "agent", "me")
        ok("…and from the window a reader DOES count the same command claims exactly as it always did — this "
           "refuses a bad mark, it does not add a way to write one",
           rf.returncode == 0 and u1() == "@7:4242" and u1("agent_at") > "2020-01-01T00:00:00Z")
        win_stub("main", "r~old")
        rf = runt("set", "r", "u1", "agent", "")
        ok("…while HANDING A ROW BACK is not a claim and still works from any window at all: the refusal is "
           "about writing an owner nobody reads, never about a session letting go of a row",
           rf.returncode == 0 and u1() == "" and u1("agent_at") == "")
        # HANDOVER: the one way a mark moves to a window other than the one that made it. cc-handoff calls it at a
        # cutover, because the retiring session's subagents keep running and report into its successor — without it
        # the watchdog called five such rows abandoned ten minutes later and put them back in the pool (2026-09-07).
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        for row, ag in (("h1", "@3:900"), ("h2", "@3:900"), ("h3", "@30:900"), ("h4", "")):
            d["tracks"][row] = {"title": row, "status": "running", "agent": ag, "kind": "track",
                                "agent_at": "2020-01-01T00:00:00Z", "updated": "2020-01-01T00:00:00Z"}
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        fld = lambda row, k: json.load(open(f"{th}/.cc/boards/r.json"))["tracks"][row].get(k, "")
        mv = run("handover", "r", "@3:900", "@7:900", "h1", "h3", "h4", "nosuch")
        ok("`handover` moves the rows it is named that carry exactly that mark, and prints what moved",
           mv.returncode == 0 and mv.stdout == "h1\n" and fld("h1", "agent") == "@7:900"
           and fld("h1", "updated") > "2020-01-01T00:00:00Z")
        ok("…carrying the mark's CLOCK rather than restarting it: a mark both readers had already expired stays "
           "expired, or a cutover would revive a row whose subagent died hours ago and hold it six hours more",
           fld("h1", "agent_at") == "2020-01-01T00:00:00Z")
        ok("…and only those: a row carrying the same mark that was not named is left where it was",
           fld("h2", "agent") == "@3:900")
        ok("…never on a prefix of the window id: `@3:900` is not `@30:900`, and that match would hand one "
           "session's live row to another in silence", fld("h3", "agent") == "@30:900")
        ok("…and it never CLAIMS a row — an unmarked row named on the line stays unmarked, which is why this is "
           "not the hole `set … agent` refuses: nothing is held that was not held already",
           fld("h4", "agent") == "")
        bad = run("handover", "r", "@3:900", "@7", "h2")
        same = run("handover", "r", "@7:900", "@7:900", "h1")
        ok("…a destination that is not a mark, and a move onto the same window, are refused and write nothing",
           bad.returncode != 0 and same.returncode != 0 and fld("h2", "agent") == "@3:900"
           and fld("h1", "agent") == "@7:900")
        typed = run("set", "r", "h2", "agent", "@7:900")
        ok("…and `set … agent` still takes only `me` and '': the exception is this verb, not the field",
           typed.returncode != 0 and fld("h2", "agent") == "@3:900")
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        for row in ("h1", "h2", "h3", "h4"): d["tracks"].pop(row)
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        # A ROW SOMEBODY IS DELIBERATELY SITTING ON (see `held` up top). The watchers each have their own case;
        # these are the ones this file owns — the word goes on, the word comes off, and the row is otherwise
        # exactly the row it was.
        d = json.load(open(f"{th}/.cc/boards/r.json"))
        d["tracks"]["k1"] = {"title": "k1", "status": "review", "kind": "track", "pr": "#325",
                             "agent": "@3:900", "agent_at": "2020-01-01T00:00:00Z",
                             "notes": [{"ts": now(), "msg": "behind #309"}], "updated": now()}
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        run("set", "r", "k1", "held", "behind #309, which carries a paid verdict — #309 first, then rebase")
        sh = run("show", "r").stdout
        ok("`set … held` stores the reason and stamps who held it and when",
           fld("k1", "held").startswith("behind #309") and fld("k1", "held_by") and fld("k1", "held_at"))
        ok("…and `show` still lists a held row, with its reason: every watcher is quiet about it on purpose, so "
           "this is the only place a person is offered it at all",
           "\033[1mk1\033[0m [review]" in sh and "      held (" in sh and "behind #309" in sh)
        ok("…while NOTHING ELSE about the row changes — status, PR, notes and the `agent` mark all stand",
           (fld("k1", "status"), fld("k1", "pr"), fld("k1", "agent")) == ("review", "#325", "@3:900")
           and fld("k1", "agent_at") == "2020-01-01T00:00:00Z" and "#325" in sh and "behind #309" in sh)
        by, at = run("set", "r", "k1", "held_by", "someone"), run("set", "r", "k1", "held_at", now())
        ok("neither stamp is settable by hand — a typed holder names somebody who never agreed to be asked — "
           "and the hold is left exactly as it was",
           by.returncode != 0 and at.returncode != 0 and fld("k1", "held_by") != "someone"
           and fld("k1", "held").startswith("behind #309"))
        run("set", "r", "k1", "held", "")
        ok("`set … held ''` lifts the hold and clears both stamps: the row goes back to being every watcher's",
           (fld("k1", "held"), fld("k1", "held_by"), fld("k1", "held_at")) == ("", "", ""))
        d = json.load(open(f"{th}/.cc/boards/r.json")); d["tracks"].pop("k1")
        json.dump(d, open(f"{th}/.cc/boards/r.json", "w"))
        # A FIXTURE IS NOT A BOARD: a `_cctest<pid>` board with a waiting row beside the real one is in neither `list`
        # nor `boards` unless `--all` asks — the one rule every reader of ~/.cc/boards calls or names
        json.dump({"repo": "_cctest99999999", "tracks": {"w1": {"status": "waiting", "title": "push refused", "updated": now()}}},
                  open(f"{th}/.cc/boards/_cctest99999999.json", "w"))
        ls, la, bs, ba = run("list").stdout, run("list", "--all").stdout, run("boards").stdout, run("boards", "--all").stdout
        ok("a `_cctest<pid>` board is a selftest fixture, not a board: `list` and `boards` skip it and print the real one beside it",
           "_cctest" not in ls and "r\tt1\t" in ls and bs.split() == ["r"])
        ok("…and `--all` is the only way to see it", "_cctest99999999\tw1\twaiting" in la and ba.split() == ["_cctest99999999", "r"])
        # …but INSIDE its run it is a board: the suite's own `cc ls` / `cc digest` descend from <pid>. This selfcheck
        # stands in for the suite — the cc-board it spawns is under our pid — and the 99999999 one stays hidden beside it
        own = f"_cctest{os.getpid()}"
        json.dump({"repo": own, "tracks": {"w1": {"status": "running", "title": "own run", "updated": now()}}},
                  open(f"{th}/.cc/boards/{own}.json", "w"))
        lo, bo = run("list").stdout, run("boards").stdout.split()
        ok("…while the run that made a fixture — any process under its <pid> — sees it as a board without --all",
           f"{own}\tw1\trunning" in lo and "_cctest99999999" not in lo and bo == [own, "r"])
        os.remove(f"{th}/.cc/boards/_cctest99999999.json"); os.remove(f"{th}/.cc/boards/{own}.json")
        # THE PREFIX IS THE NAMESPACE, NOT ONE SUITE'S NAME: cc-sandbox's selfchecks name their scratch `_ccsbx<pid>`,
        # and a leaked one was read as a real repo whose worktrees no board knew (2026-09-02). Its own fixtures, both
        # sides: the dead suite's board is hidden, this run's is not, and a repo that merely contains the word is real.
        json.dump({"repo": "_ccsbx99999999", "tracks": {"t": {"status": "running", "title": "leak", "updated": now()}}},
                  open(f"{th}/.cc/boards/_ccsbx99999999.json", "w"))
        json.dump({"repo": "myrepo_cctesting", "tracks": {"t": {"status": "running", "title": "real", "updated": now()}}},
                  open(f"{th}/.cc/boards/myrepo_cctesting.json", "w"))
        mine = f"_ccsbx{os.getpid()}"
        json.dump({"repo": mine, "tracks": {"t": {"status": "running", "title": "ours", "updated": now()}}},
                  open(f"{th}/.cc/boards/{mine}.json", "w"))
        bs, ba = run("boards").stdout.split(), run("boards", "--all").stdout.split()
        ok("a leaked `_ccsbx<pid>` board is a fixture on the same rule as `_cctest<pid>` — the suite is gone, so it is "
           "scaffolding — while this run's own is a board, and a real repo that merely CONTAINS the word always was",
           bs == [mine, "myrepo_cctesting", "r"] and "_ccsbx99999999" in ba)
        for b in ("_ccsbx99999999", "myrepo_cctesting", mine):
            os.remove(f"{th}/.cc/boards/{b}.json")
        # ── A NEW ROW IS TOLD WHICH LIVE ROW IS ALREADY IN THESE FILES, at the door it comes in by. Every extra
        # row costs its own gates, review read and merge, so two asks in one file that could have been one brief
        # buy a second landing for nothing — and whether they are one concern was a match made from memory, missed
        # exactly when the session had just changed hands. cc-brief does the arithmetic; this OFFERS and never
        # joins, so the row is added either way and a person runs the command or does not.
        jr = os.path.join(th, "jrepo")
        os.makedirs(jr)
        genv = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t",
                "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}
        def jgit(*g): subprocess.run(["git", "-C", jr, *g], capture_output=True, env=genv)
        subprocess.run(["git", "init", "-q", "-b", "main", jr], capture_output=True)
        for fn in ("shared.txt", "alone.txt"): open(os.path.join(jr, fn), "w").write("base\n")
        jgit("add", "-A"); jgit("commit", "-qm", "base"); jgit("checkout", "-q", "-b", "track/first-row", "main")
        open(os.path.join(jr, "shared.txt"), "a").write("held\n")
        jgit("add", "-A"); jgit("commit", "-qm", "held"); jgit("checkout", "-q", "main")
        run("init", "j", jr, "main")
        run("add", "j", "first-row", "the row already writing it", "GOAL: shared.txt is wrong.")
        run("status", "j", "first-row", "running")
        a = run("add", "j", "second-ask", "a second ask in the same file",
                "GOAL: shared.txt is wrong in one more way.")
        ok("`add` says which LIVE row is already in these files, and how the ask would reach whoever is on it",
           "first-row [running]" in a.stderr and "shared.txt" in a.stderr and "cc j first-row --say" in a.stderr)
        ok("…and the offer is the command that appends the ask to that row's brief — joining is one line",
           "cc board add j first-row 'the row already writing it'" in a.stderr)
        ok("…and the row is added all the same: the box offers here, it never decides",
           a.returncode == 0 and "track 'second-ask' added to j" in a.stdout and "second-ask" in run("json", "j").stdout)
        b = run("add", "j", "on-its-own", "an ask nobody else is in", "GOAL: alone.txt is wrong.")
        ok("an add that overlaps nothing is left completely alone — no offer, no heading, no line",
           "already on this work" not in b.stderr and "track 'on-its-own' added to j" in b.stdout)
        # A MEMBER WORKSPACE'S BOARD IS A LINK: cc-sandbox keeps the file in ~/.cc/members/<h>/board/ and binds that directory
        # as the session's ~/.cc/boards, leaving ~/.cc/boards/<h>.json a symlink so every host path still works. A rename onto
        # the link's own path would replace the LINK with a plain file, and the two sides would hold two boards again.
        os.makedirs(f"{th}/.cc/members/lk/board"); os.symlink(f"{th}/.cc/members/lk/board/lk.json", f"{th}/.cc/boards/lk.json")
        run("init", "lk", "/tmp/lk", "main"); run("add", "lk", "t1", "T")
        ok("a save through a linked board lands in the file the link names, and the link is still a link",
           os.path.islink(f"{th}/.cc/boards/lk.json") and "t1" in json.load(open(f"{th}/.cc/members/lk/board/lk.json"))["tracks"]
           and "lk" in run("boards").stdout.split() and not os.path.exists(f"{th}/.cc/boards/lk.json.tmp"))
        # …AND THE HOST NEVER FOLLOWS A LINK PLANTED IN THAT DIRECTORY (review of #224): the member writes it, so a link
        # in place of the board, a link at the .tmp name, or a link or a pipe in place of the lock is the member's — and
        # each used to be followed: a save renamed the board over any owner-writable file, the lock's open truncated one.
        # Every case: refused (or simply unused), the victim byte for byte, the previous board intact, no hang.
        victim = f"{th}/victim"; open(victim, "w").write("SECRET\n")
        mb = f"{th}/.cc/members/lk/board"
        os.replace(f"{mb}/lk.json", f"{mb}/lk.real"); os.symlink(victim, f"{mb}/lk.json")
        r1, r2, r3 = run("status", "lk", "t1", "running"), run("get", "lk", "t1", "status"), run("list")
        ok("a link planted where the member's board file was is refused by the host's save and its read — exit 1, one line, the victim untouched",
           r1.returncode == 1 and "refused" in r1.stderr and r2.returncode == 1 and "refused" in r2.stderr
           and open(victim).read() == "SECRET\n" and os.readlink(f"{mb}/lk.json") == victim)
        ok("…and `list` skips that board and still lists the others", "r\t" in r3.stdout and "lk.json: unreadable" in r3.stderr)
        os.remove(f"{mb}/lk.json"); os.mkfifo(f"{mb}/lk.json")
        r1, r2 = run("status", "lk", "t1", "running"), run("get", "lk", "t1", "status")
        ok("a pipe planted there is refused the same way, and neither the save nor the read hangs on it",
           r1.returncode == 1 and "refused" in r1.stderr and r2.returncode == 1 and "refused" in r2.stderr)
        os.remove(f"{mb}/lk.json"); os.replace(f"{mb}/lk.real", f"{mb}/lk.json")
        os.symlink(victim, f"{mb}/lk.json.tmp")
        r1 = run("status", "lk", "t1", "running")
        unused = os.path.islink(f"{mb}/lk.json.tmp") and os.readlink(f"{mb}/lk.json.tmp") == victim   # gone = a save renamed it onto the board
        ok("a link planted at the .tmp name is never what the save writes: the save lands, the victim untouched, the link unused",
           r1.returncode == 0 and json.load(open(f"{mb}/lk.json"))["tracks"]["t1"]["status"] == "running"
           and open(victim).read() == "SECRET\n" and unused)
        if os.path.lexists(f"{mb}/lk.json.tmp"): os.remove(f"{mb}/lk.json.tmp")
        os.remove(f"{th}/.cc/boards/lk.lock"); os.symlink(f"{mb}/lk.lock", f"{th}/.cc/boards/lk.lock")   # as board_dir leaves it
        os.symlink(victim, f"{mb}/lk.lock")
        r1 = run("status", "lk", "t1", "queued")
        os.remove(f"{mb}/lk.lock"); os.mkfifo(f"{mb}/lk.lock")
        r2 = run("status", "lk", "t1", "queued")
        ok("a link, then a pipe, in place of the lock is refused — the victim is not truncated, the host does not hang, the board is as it was",
           r1.returncode == 1 and "refused" in r1.stderr and r2.returncode == 1 and "refused" in r2.stderr
           and open(victim).read() == "SECRET\n" and json.load(open(f"{mb}/lk.json"))["tracks"]["t1"]["status"] == "running")
        os.remove(f"{mb}/lk.lock"); open(f"{mb}/lk.lock", "w").close()
        ok("…and with a plain file back at the lock the save goes through the host's link as before",
           run("status", "lk", "t1", "queued").returncode == 0 and json.load(open(f"{mb}/lk.json"))["tracks"]["t1"]["status"] == "queued")
        # …AND THE SAME AT THE HOST'S OWN ENTRY, which is where a WORKER can plant one: ~/.cc/boards is bind-mounted rw
        # inside that sandbox too. `rm r.json; ln -s <the owner's file> r.json` and the host's next save renames a board
        # over it. A link there is followed only to ~/.cc/members/<h>/board/<h>.json, what board_dir makes, and to nothing else.
        for name, why in (("r.json", "board"), ("r.lock", "lock")):
            keep = f"{th}/.cc/boards/{name}.keep"
            if os.path.lexists(f"{th}/.cc/boards/{name}"): os.replace(f"{th}/.cc/boards/{name}", keep)
            os.symlink(victim, f"{th}/.cc/boards/{name}")
            r1, r2 = run("status", "r", "t1", "running"), run("get", "r", "t1", "status")
            os.remove(f"{th}/.cc/boards/{name}")
            if os.path.lexists(keep): os.replace(keep, f"{th}/.cc/boards/{name}")
            ok(f"a link planted at the host's own {why} entry — what a sandboxed worker can write — is refused before "
               f"anything opens it, and the file it aimed at is byte for byte what it was",
               r1.returncode == 1 and "refused" in r1.stderr and "Traceback" not in r1.stderr
               and (why == "lock" or (r2.returncode == 1 and "refused" in r2.stderr))
               and open(victim).read() == "SECRET\n")
        ok("…and the board that link stood in front of is untouched and still saves",
           run("status", "r", "t1", "queued").returncode == 0
           and json.load(open(f"{th}/.cc/boards/r.json"))["tracks"]["t1"]["status"] == "queued")
        # BELT AND BRACES (the second pass of that review): a board file has ONE name — link(2) across two binds is EXDEV
        # today — and a DIRECTORY made at the lock's name or the board's is one line, not a traceback.
        os.link(f"{mb}/lk.json", f"{mb}/lk.two")
        r1, r2 = run("status", "lk", "t1", "running"), run("get", "lk", "t1", "status")
        os.remove(f"{mb}/lk.two")
        ok("a board file with a second name (a hard link) is refused, save and read alike",
           r1.returncode == 1 and "refused" in r1.stderr and r2.returncode == 1 and "refused" in r2.stderr)
        os.remove(f"{mb}/lk.lock"); os.mkdir(f"{mb}/lk.lock")
        r1 = run("status", "lk", "t1", "running")
        os.rmdir(f"{mb}/lk.lock"); open(f"{mb}/lk.lock", "w").close()
        os.replace(f"{mb}/lk.json", f"{mb}/lk.real"); os.mkdir(f"{mb}/lk.json")
        r2, r3 = run("status", "lk", "t1", "running"), run("get", "lk", "t1", "status")
        os.rmdir(f"{mb}/lk.json"); os.replace(f"{mb}/lk.real", f"{mb}/lk.json")
        ok("a directory made at the lock's name, or at the board's, is refused in one line — no traceback",
           all(r.returncode == 1 and "refused" in r.stderr and "Traceback" not in r.stderr for r in (r1, r2, r3)))
        # NO SIBLING OPENS A BOARD ITSELF: the host readers import `read` (the way cc-time is imported), cc-audit runs
        # `cc-board json`. A tripwire, not a proof, in two passes per function: every name bound to a board path (BOARDS,
        # bpath(), a string under .cc/boards — by `x = …`, `for x in …`, `with … as x`) is collected, and a line that reads
        # (open, json.load, read_text/read_bytes, shutil.copy*, a cat/cp/jq call) with such a name as an argument, or with
        # the path spelled out, is flagged. A line that writes ("w") is a suite laying a fixture in its own directory. A
        # shell file gets the one-line rule: cat/cp/jq with the board path in the same command.
        here = os.path.dirname(os.path.realpath(__file__))
        MARK = re.compile(r'\bBOARDS\b|\.cc/boards|\bbpath\(')
        VERB = re.compile(r'\b(open|load|loads|read_text|read_bytes|copy|copy2|copyfile|cat|cp|jq)\b')
        def plain_opens(path):
            out, bound = [], {}
            lines = open(path, errors="replace").read().split("\n")
            py = lines[0].startswith("#!") and "python" in lines[0]
            for i, line in enumerate(lines, 1):
                code = line.split("#")[0].rstrip()
                if not code.strip(): continue
                indent = len(code) - len(code.lstrip())
                if re.match(r'\s*def\s', code): bound = {k: v for k, v in bound.items() if v <= indent}   # a new function: its predecessor's names are gone
                write = '"w"' in code or "'w'" in code
                marked = bool(MARK.search(code))
                if not py:
                    if not write and re.search(r'\b(cat|cp|jq)\b[^|;&]*(\.cc/boards|\bBOARDS\b)', code): out.append(f"{os.path.basename(path)}:{i}")
                    continue
                if marked and not write:   # pass one: a name bound to a board path
                    m = (re.match(r'\s*for\s+(\w+)\s+in\b', code) or re.match(r'\s*with\b.*\bas\s+(\w+)\s*:', code)
                         or re.match(r'\s*([\w\s,]+?)\s*=[^=]', code))
                    for nm in (m.group(1).split(",") if m else []): bound[nm.strip()] = indent
                if write or not VERB.search(code): continue
                if marked or any(re.search(r'[(,\[]\s*' + re.escape(nm) + r'\s*[,)\]]', code) for nm in bound if nm):   # pass two
                    out.append(f"{os.path.basename(path)}:{i}")
            return out
        bad = [x for n in sorted(os.listdir(here)) if n.startswith("cc") and n != "cc-board" and os.path.isfile(f"{here}/{n}")
               for x in plain_opens(f"{here}/{n}")]
        ok("no sibling tool opens ~/.cc/boards/<repo>.json itself — each reads through `read` or `cc-board json` (tripwire)", not bad)
        if bad: print("       " + ", ".join(bad))
        # …AND THAT TRIPWIRE ONLY GUARDS ANYTHING IF IT RUNS. A suite runs a tool's selfcheck when that tool or
        # something that invokes it changed (tests/green.sh), and the case above guards code that is not this
        # file's: scoped that way it slept through the change that broke it. green.sh answers `want_selfcheck` for
        # cc-board whatever changed — pinned here in both halves, the rule and the two gates that ask it, because
        # the rule on its own is dead the moment a suite goes back to asking `want`.
        tests = os.path.normpath(f"{here}/../tests")
        def src(name):
            try: return open(f"{tests}/{name}").read().split("\n")
            except OSError: return []
        sb = f"{th}/scopebin"; os.makedirs(sb, exist_ok=True)
        for nm in ("cc-board", "cc-leaf"): open(f"{sb}/{nm}", "w").write("#!/bin/sh\n")
        def asks(fn):   # a diff of one tool that cc-board neither is nor calls
            r = subprocess.run(["bash", "-c", '. "$1" || exit 1; CC_LAND_CHANGED=core/bin/cc-leaf land_scope "$2"; '
                                f'{fn} cc-board && echo yes || echo no', "_", f"{tests}/green.sh", sb],
                               capture_output=True, text=True)
            return r.stdout.strip()
        chk_sh, self_sh = src("check.sh"), src("selftest.sh")
        loop = [l for l in chk_sh if re.match(r'\s*want_selfcheck "\$c"', l)]           # check.sh's selfcheck loop…
        listed = [l for l in chk_sh if re.match(r'\s*for c in cc-', l) and " cc-board " in l]   # …over a list holding cc-board
        gate = [l for l in self_sh if re.match(r'\s*want_selfcheck "\$t"', l)]          # selftest.sh's chk()
        at = self_sh.index("chk cc-board") if "chk cc-board" in self_sh else -1
        stz = next((self_sh[k] for k in range(at, -1, -1) if re.match(r'(if )?stanza "', self_sh[k])), "") if at >= 0 else ""
        ok("…and a landing that changes any tool under bin/ runs these cases: green.sh says yes for cc-board "
           "whatever changed, where the invoke graph alone says no, and both suites gate this selfcheck on that",
           asks("want_selfcheck") == "yes" and asks("want") == "no"
           and len(loop) == 1 and len(listed) == 1 and len(gate) == 1 and stz.rstrip().endswith("always"))
        # A FAILED RENAME LEAVES THE PREVIOUS BOARD (review-156d). The in-place fallback exists for the bind-mounted board
        # inside a member boundary — rename over a mount point is EBUSY — and for nothing else: a full or read-only disk used
        # to truncate the live board to zero bytes on the way to failing. os.replace is stood in for; the board dir is this
        # run's own; _save is called in-process, the way every writer calls it.
        global BOARDS, LOCK_WAIT
        real_boards, real_replace, real_wait = BOARDS, os.replace, LOCK_WAIT
        BOARDS = f"{th}/.cc/boards"
        try:
            # A LOCK HELD FROM INSIDE IS A MEMBER-CONTROLLED HANG: the lock file is in the member's directory. The host
            # takes it non-blocking, waits LOCK_WAIT, then refuses in one line — it never sits on a member's flock for good.
            LOCK_WAIT = 0.5
            holder = open(f"{mb}/lk.lock", "w"); fcntl.flock(holder, fcntl.LOCK_EX)
            def take():
                with Lock("lk"): return "taken"
            t0 = time.monotonic(); got = bounded(take, 5)   # a lock that blocks (the old LOCK_EX) sits here: the guard fails the case, the suite goes on
            waited = time.monotonic() - t0; holder.close()
            ok("a board lock somebody else holds is waited for, briefly, then refused in one line — not a hang — and taken once it is free",
               isinstance(got, Refused) and 0.4 < waited < 5 and bounded(take, 5) == "taken")
            before = open(f"{th}/.cc/boards/r.json").read()
            def failing(code):
                def rep(a, b): raise OSError(code, os.strerror(code))
                return rep
            for code in (errno.ENOSPC, errno.EROFS, errno.EIO):
                os.replace = failing(code)
                try: _save("r", {"repo": "r", "tracks": {}}); raised = False
                except OSError as e: raised = e.errno == code
                ok(f"a rename that fails with {errno.errorcode[code]} (full or read-only target) re-raises and leaves the previous board intact",
                   raised and open(f"{th}/.cc/boards/r.json").read() == before and not glob.glob(f"{th}/.cc/boards/r.json.*tmp"))
            os.replace = failing(errno.EBUSY)
            _save("r", {"repo": "r", "tracks": {"z": {"status": "queued", "title": "in place"}}})
            ok("…while the mount point's EBUSY writes in place, whole, and clears the .tmp",
               json.load(open(f"{th}/.cc/boards/r.json"))["tracks"] == {"z": {"status": "queued", "title": "in place"}}
               and not glob.glob(f"{th}/.cc/boards/r.json.*tmp"))
        finally:
            BOARDS, os.replace, LOCK_WAIT = real_boards, real_replace, real_wait
    finally:
        shutil.rmtree(th, ignore_errors=True)
    print(f"cc-board selfcheck: {n} failed")
    return 1 if n else 0

if __name__ == "__main__":
    try: main(sys.argv[1:])
    except Refused as e: sys.exit(str(e))   # a planted link or pipe where a board file should be: one line, exit 1, board unchanged
