#!/usr/bin/env bash
# cc-limit — LLM-free detection of Claude usage/rate limits, and one shared "wait until it resets" stamp.
#   cc-limit check <claude-json> [<stderr-file>]   prints "LIMIT <epoch>" + exit 0 when that run hit a limit, else exit 1
#                      (a run refused for usage credits is exit 1 too: one model this account cannot run is not a
#                      limit — cc-model is told it is unavailable and moves the box off it; see USAGE CREDITS below;
#                      a MONTHLY SPEND CAP is a limit no reset lifts: the backoff stamp, source `spend-cap`, and the
#                      owner told once per episode that only raising it clears it — see A SPEND CAP IS NOT LIFTED)
#   cc-limit status    "usage limit until HH:MMZ (Nm left)" + exit 0 when the stamp binds THIS caller, else
#                      "clear" + exit 1 (with a note on stderr when a stamp exists that does not bind it)
#   cc-limit wait      sleep until the stamp expires (exit 0); exit 1 if the wait would exceed CC_LIMIT_MAX_WAIT;
#                      exit 0 at once when the stamp does not bind this caller — there is nothing to wait for
#   cc-limit clear     forget it (every caller does this after a run that reached the API)
#   cc-limit record [--dry] [<pane|window-id> <window>]   note an INTERACTIVE session the limit interrupted (no
#                      args = every live session, answering with the best code it found). exit 0 = recorded ·
#                      2 = the pane IS sitting on the limit but this is not a record (nothing corroborates it yet,
#                      no reset time yet, or it was nudged inside the half hour) — a caller must not type there
#                      either · 1 = no limit line at all
#   cc-limit resume    nudge each recorded session whose reset has passed, ONCE, then forget it — ending a turn
#                      that never finished first (see A TURN THAT NEVER ENDED), publishing the episode for
#                      whoever else it killed (see WHAT ELSE THE LIMIT KILLED), and telling the owner in one
#                      line what the limit stalled and when it went again
#   cc-limit selfcheck the record/resume state machine, on stubs
# Stamp: ~/.cc/state/claude-limit = "<until-epoch>\t<source>\t<first-seen-epoch>\t<model-family>\t<observers>" — shared,
# so a second loop waits instead of burning its retries; the model is what cc-model needs to know whose limit it was
# (may be empty when the message names none); the observers are which RUNS have hit it (see below). No secrets in it.
# Env: CC_LIMIT_MAX_WAIT (default 21600 = 6 h)
# · CC_LIMIT_MIN_WAIT (test hook: cap any sleep at N seconds) · CC_LIMIT_STAMP (test hook: put the stamp somewhere
#   else, so a test limit never makes the box's real loops wait) · CC_LIMIT_OBSERVER (test hook: the key that says
#   which run this is; the run's cwd otherwise) · CC_LIMIT_RECORD · CC_LIMIT_NUDGED · CC_LIMIT_ARM
#   (test hook: what to arm with — it is called as `<seconds> <unit-name>`; "-" = arm nothing)
#   · CC_LIMIT_RESUMED (where the ended episode is published — see WHAT ELSE THE LIMIT KILLED) · CC_LIMIT_NOW
#   · CC_LIMIT_SETTLE (seconds between the Escape that ends a dead turn and the message typed after it)
#   · CC_LIMIT_BIN · CC_TMUX_SESSION.
#
# RESUMING AN INTERACTIVE SESSION. A headless worker parks and reruns itself at the reset; an interactive session just
# prints the limit line and sits at its prompt, and the turn it was in the middle of is lost until a human comes back.
# So: whoever notices the line (cc-pulse on its rounds, or `check` on the run that hit the same limit) calls `record`,
# which writes <pane-id, window, reset-epoch, episode-start, tags> to ~/.cc/state/limit-interrupted (the last two are
# the FIRST sighting's answers and are never revised — see record()) and arms a ONE-SHOT systemd-run timer at
# the reset — no new always-on unit. At the reset `resume` types one line into each recorded session through cc-msg
# (which owns the dialog guard and the "is anyone there" test) and forgets it. One nudge per record, ever: a session
# whose pane no longer shows the limit line moved on by itself and is skipped, and a record whose reset has moved out
# is rescheduled rather than sent early, and a pane nudged in the last half hour is not recorded again — the limit
# line stays on its screen after it comes back, and a stale line must not buy a second nudge.
# A TURN THAT NEVER ENDED. 2026-09-05 09:05Z a planning session took the 429 INSIDE a turn, and that turn never
# finished: the limit lifted at 11:10Z and the session was still sitting in it at 16:26Z, when a person restarted
# it. The model switch, the 12:54Z pulse and every lander event were spooled behind it, undelivered. A nudge
# alone does not reach such a session — nothing can be typed at a pane that is mid-turn, so the nudge spools too.
# So `resume` presses Escape first, and ONLY at a due record that was mid-turn when it was RECORDED (`working` in
# field 5) and is still mid-turn now. Both halves, because the ordinary 429 does end the turn: cc-msg's drain then
# types the spooled lines at the freed pane, a new turn starts, and the stale limit line is still on screen at the
# reset — on the footer alone Escape would kill that live turn mid-tool-call (review of #264). cc-msg must never
# interrupt a turn by accident; this one is deliberate and narrow. cc-msg spools before it types, so whatever
# queued behind the dead turn goes in first, in order, and the nudge last.
# A RECORD IS NOT ALWAYS A SECOND WITNESS. cc-model counts a record as the second run that hit a limit, which is
# what makes the switch follow the stamp instead of an hour-late pane scan. But record() corroborates a pane's
# line with that same stamp, so a one-observer stamp plus any pane still showing THIS MORNING'S limit wording
# would be two witnesses that are really one (review of #264) — the 2026-09-04 regression the two-observer rule
# exists to stop. So a record is tagged `indep` only when this pane's limit LINE was first seen at or after the
# stamp's own first-seen, i.e. inside the current episode; cc-model counts only those, and everything else still
# needs two observers on the stamp. first_seen() is keyed on the LINE, so two episodes whose message reads exactly
# alike inside a day share one sighting and the second gets no tag — what that gives back is the old answer (two
# observers, or the pane scan), which is the safe way for this to be wrong.
# WHAT ELSE THE LIMIT KILLED. A nudge puts a SESSION back on its work; the subagents it had out when the 429 came
# are gone, and the board rows they were working still carry the `agent` mark that says somebody is doing them.
# That mark holds a row for six hours (cc-reconcile mark_why; cc-pulse reads its snapshot), so a row whose subagent died at
# 09:05Z on 2026-09-05 stayed in flight until six hours after its mark was written — nearly four hours after the
# limit had lifted, offered to nobody the whole time. So `resume` publishes the episode
# it just ended to ~/.cc/state/limit-resumed, "<started>\t<reset>\t<resumed>", one line, latest episode wins.
# THE BAR IS THE START, NOT THE RESET (review of #264). The box does not stop for the episode — cc-model moves
# every session to the fallback about a minute after the stamp — so a mark made between the switch and the reset
# belongs to a subagent that is alive and working, and judging it by the reset would offer a row that is in
# flight. A mark older than the START is the one that cannot have survived: it was made before the 429 that killed
# the subagent holding it. Both readers treat such a mark as cold whatever its age, and the row is offered again.
# The session that IS still on the row says so by marking again, exactly as it does for the six-hour bound.
# An episode nobody recorded publishes nothing — `resume` is armed by `record` — and neither does one whose
# records do not all carry a start: a guessed start would call live rows dead, and the six-hour bound still covers
# them, as it did before.
# ONE RUN'S LIMIT IS NOT THE BOX'S. On 2026-09-04 at 09:13:29Z one headless worker was told "usage limit until
# 06:00Z" and exited. That stamped the box: `status` read "usage limit until 06:00Z (898m left)" and every session
# believed it for six hours, while opus went on answering (the spend ledger has successful rows at 14:54, 14:55 and
# 14:59Z from three different sessions). A person ended it, as they had three times on 09-03. So the stamp now says
# WHO hit it, and two things read that:
#   The OBSERVERS. `check` adds the run's own key (an md5 of its cwd — one per worktree, so one per worker) to the
#   stamp. One observer = the limit binds that run alone: it parks and reruns itself exactly as before, and every
#   other caller reads `clear`. Two = account-wide, and the box parks exactly as it does today. A real account-wide
#   limit confirms itself on the very next run that tries, and the one attempt that costs is rejected outright, so
#   it burns no reset — which is the asymmetry to hold: believing a limit wrongly costs a day of work.
#   THE ACCOUNT ANSWERING. A limit that two runs hit can still be wrong. cc-spend's ledger records every call this
#   box makes, so a stamp is dropped outright once TWO different sessions have completed calls (on the limited
#   model's family, or any family when the stamp names none) more than five minutes (GRACE) past the moment it
#   was first seen: nothing answers under a real account-wide limit. Dropping it pushes the owner one line, once per episode
#   — six hours of dead box against a working account must not happen again without somebody being told.
# A pane line alone is not proof — this box's own docs and briefs say "usage limit" too — so a record needs the line
# AND corroboration: the shared stamp is live, or cc-model itself judged a limit recently — a live
# ~/.cc/state/model-override, or a switch in ~/.cc/state/model.log inside the last 6 h. Both files are cc-model's;
# this reads them and writes neither. The hashes in ~/.cc/state/model-seen are NOT corroboration: cc-model banks one
# for every probe it adjudicated, "was not a live limit" included.
set -uo pipefail
SELF=$(readlink -f "$0")
BIN="${CC_LIMIT_BIN:-$(dirname "$SELF")}"   # siblings come from the same bin/ as this copy
S="${CC_LIMIT_STAMP:-$HOME/.cc/state/claude-limit}"; MAX="${CC_LIMIT_MAX_WAIT:-21600}"
REC="${CC_LIMIT_RECORD:-$HOME/.cc/state/limit-interrupted}"
NUDGED="${CC_LIMIT_NUDGED:-$HOME/.cc/state/limit-nudged}"; QUIET=1800   # see nudged_recently
RESUMED="${CC_LIMIT_RESUMED:-$HOME/.cc/state/limit-resumed}"   # see WHAT ELSE THE LIMIT KILLED
SEEN="${CC_LIMIT_SEEN:-$HOME/.cc/state/limit-seen}"; JUDGE=3600         # see first_seen: how long an uncorroborated line stays "not judged yet"
DISB="$S.disbelieved"; GRACE=300   # see answering: how long after a limit was first seen a completed call disproves it
now="${CC_LIMIT_NOW:-$(date -u +%s)}"; DRY=""
# What a session shows when the limit stopped it. Tighter than cc-model's (which only decides which MODEL to use):
# this one ends in a message typed at a human's session, so prose that merely mentions limits must not match.
PANE_RE='usage limit reached|out of usage credits|limit will reset|limit reached.*reset'
TAIL=15   # the pane's LAST 15 visible lines (capture-pane piped through tail). A session STOPPED by the limit
          # shows that line just above its input box; higher up may be anything — including a file that quotes
          # the wording. Narrow beats clever: the window is read again at the reset, before anything is typed.
WORK_MARK='esc to interrupt'      # Claude Code's footer for the whole of a turn (cc-msg, cc-pulse and cc-started read the same)
SETTLE="${CC_LIMIT_SETTLE:-2}"    # after the Escape that ends a dead turn, before cc-msg reads that pane
stamp(){   # the shared stamp's five fields. Split by awk and NOT by `IFS=$'\t' read`: tab is IFS WHITESPACE, so bash
           # folds "\t\t" into one delimiter — and the stamp of 2026-09-04 named no model, so its empty field 4 slid
           # the observers into $mdl and the run that hit the limit could not find its own key.
  ends=0; src=""; first=0; mdl=""; obs=""
  [ -f "$S" ] && { IFS= read -r ends; IFS= read -r src; IFS= read -r first; IFS= read -r mdl; IFS= read -r obs; } \
    < <(awk -F'\t' 'NR==1{for (i = 1; i <= 5; i++) print $i}' "$S")
  [[ "$ends" =~ ^[0-9]+$ ]] || ends=0; [[ "$first" =~ ^[0-9]+$ ]] || first=0; }

# ---- whose limit is it? (see "ONE RUN'S LIMIT IS NOT THE BOX'S" above)
mykey(){   # which RUN this is. The cwd, because that is one per worktree and so one per worker — the unit the
           # incident was about ("one headless worker on this repo"). Hashed to keep paths out of a shared file.
  printf '%s' "${CC_LIMIT_OBSERVER:-$PWD}" | md5sum | cut -c1-8; }
obs_list(){ tr ',' '\n' <<<"${obs:-}" | grep -x '[0-9a-f]\{8\}'; }   # the stamp's observers, one per line (none = no output)
nobs(){ obs_list | grep -c . || true; }                              # how many distinct runs have hit it
add_obs(){   # $1 = a key -> the observer list with $1 on the end, oldest dropped past four
  { obs_list | grep -vx "$1"; echo "$1"; } | tail -4 | paste -sd, -; }

answering(){   # Is the ACCOUNT answering, this long after the stamp was first seen? Then no limit it names is
               # account-wide, whoever wrote it. cc-spend's ledger is every call this box completed:
               # ~/.cc/state/spend/<day>.tsv, "<ts> <session> <cwd> <repo> <track> <kind> <model> …", ts in UTC
               # ISO seconds — the resolution it is compared at, so a row ON the cutoff second is not past it.
               # TWO different sessions, not one: a person can go on answering a real limit out of usage credits,
               # and believing a limit wrongly costs a day of work while disbelieving one wrongly costs a reset.
  local cutoff day f
  stamp; [ "$first" -gt 0 ] || return 1
  cutoff=$(date -u -d "@$((first + GRACE))" +%Y-%m-%dT%H:%M:%SZ)
  # EVERY calendar day the stamp has lived through, first seen to now: reading only those two days left a limit
  # first seen late on day 1 with a reset a week out (the weekly one cc-land anticipates) believed on day 3 while
  # day 2's rows disproved it (review of #215).
  day=$(date -u -d "$(date -u -d "@$first" +%F)" +%s)   # midnight UTC of the day it was first seen
  while [ "$day" -le "$now" ]; do
    f="$HOME/.cc/state/spend/$(date -u -d "@$day" +%F).tsv"; [ -f "$f" ] && cat "$f"
    day=$((day + 86400))
  done | awk -F'\t' -v cutoff="$cutoff" -v fam="${mdl:-}" '
      $1 !~ /^#/ && $1 > cutoff && $7 ~ fam { seen[$2] = 1 }         # fam empty = the stamp named no model = any row
      END { exit !(length(seen) >= 2) }'; }

disbelieve(){   # drop a stamp the account has plainly outlived, and tell the owner ONCE per episode — the cure for
                # every one of these has been a person noticing, four times in two days.
  local was="$first" till="$ends"
  rm -f "$S"; ends=0
  [ "$(cat "$DISB" 2>/dev/null)" = "$was" ] && return 0
  mkdir -p "$(dirname "$DISB")"; printf '%s\n' "$was" > "$DISB"
  [ -x "$BIN/cc-notify" ] && "$BIN/cc-notify" -t "$(hostname -s) limit" \
    "A usage limit seen at $(date -d "@$was" +%H:%M) parked this box until $(date -d "@$till" +%H:%M), but the account has gone on answering since. Dropped it; autonomous work carries on." >/dev/null 2>&1
  return 0; }

believe(){   # exit 0 = the live stamp binds THIS caller, and stamp()'s variables are loaded. The one gate `status`
             # and `wait` share, so no caller has to know the rule.
  stamp
  [ "$ends" -gt "$now" ] || return 1
  answering && { disbelieve; return 1; }
  [ "$(nobs)" -ge 2 ] && return 0            # two runs hit it: account-wide, and the box parks as it always has
  obs_list | grep -qx "$(mykey)"; }          # one run: it binds that run, and nobody else

parse_reset(){   # a reset time named anywhere in $1 -> $u (epoch; 0 = the message named none) and $how (how it was read)
  local txt="$1" m c d y yn n rest zc tz=UTC
  local RS='reset[a-z]*[^0-9]{0,8}'   # "resets at ", "reset: ", "resets " — a bare timestamp in a log line must not count
  local MON='(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?' ORD='(st|nd|rd|th)?'
  local YR='(19|20)[0-9]{2}' CLK='([0-9]{1,2}(:[0-9]{2})? *(am|pm)|[0-9]{1,2}:[0-9]{2})' DAY
  DAY="(${MON} +[0-9]{1,2}${ORD}|[0-9]{1,2}${ORD} +${MON})"   # "Sep 7" and "7 Sep": both orderings get written
  local AHEAD=1209600   # a fortnight. No usage limit on this account has ever run longer than a week.
  # THE ZONE THE MESSAGE NAMES: the first Area/City that IS a zone, not the first thing in the text with a slash in
  # it. A limit message carries a URL as well ("…claude.ai/settings/usage?from=cc_cli_limit_message"), and taking
  # the first match handed "ai/settings" to the zonefile test, missed, and left the clock being read as UTC. Two-
  # and three-segment names both match whole; a zone buried deeper inside a path is not dug for, because no
  # message has ever carried one that way.
  while read -r zc; do
    [ -f "/usr/share/zoneinfo/$zc" ] && { tz="$zc"; break; }
  done < <(grep -oE '[A-Za-z][A-Za-z_]*/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)?' <<<"$txt")
  u=0; how=""; rolled=0
  if m=$(grep -oiE "${RS}[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:?[0-9]{2})?" <<<"$txt" | head -1) && [ -n "$m" ]; then
    u=$(TZ="$tz" date -d "$(grep -oE '[0-9]{4}-.*' <<<"$m")" +%s 2>/dev/null); how=iso
  elif m=$(grep -oiE 'reset[a-z]* in +[0-9]+ *[a-z]+' <<<"$txt" | head -1) && [ -n "$m" ]; then
    n=$(grep -oE '[0-9]+' <<<"$m"); case "$(grep -oiE '[a-z]+$' <<<"$m" | tr A-Z a-z)" in
      h*) u=$((now + n * 3600));; s*) u=$((now + n));; *) u=$((now + n * 60));; esac; how=in
  # A DAY AND A CLOCK, IN EITHER ORDER — "resets Sep 7, 10am (America/Los_Angeles)", "resets at 10am on Sep 7",
  # "resets 7 Sep, 10am". The clock branch below takes the first number after "reset" for an hour, so it read the
  # DAY, 7, and parked the box at 07:00 Los Angeles instead of 10:00 — three hours early, on a weekly limit that
  # stood for days (2026-09-03). The day is cut back out of the match before the clock is looked for, so its
  # number can never be mistaken for an hour whichever way round the two were written.
  elif m=$(grep -oiE "reset[a-z]*[^0-9A-Za-z]{0,3}((on +|at +)?${DAY},? *(${YR})?,? *(at +)?${CLK}?|(at +)?${CLK},? +(on +)?${DAY},? *(${YR})?)" <<<"$txt" | head -1) && [ -n "$m" ]; then
    d=$(grep -oiE "$DAY" <<<"$m" | head -1)
    rest=${m/"$d"/}                                          # …the day taken back out
    d=$(sed -E 's/([0-9]+)(st|nd|rd|th)/\1/Ig; s/\.//g' <<<"$d")   # "Sept. 7th" is no date to date(1); "Sept 7" is
    c=$(grep -oiE "$CLK" <<<"$rest" | head -1)
    yn=$(TZ="$tz" date -d "@$now" +%Y)                       # the year the BOX is in, so a test clock moves it too
    y=$(grep -oE "$YR" <<<"$rest" | head -1)
    u=$(TZ="$tz" date -d "$d ${y:-$yn} ${c:-00:00}" +%s 2>/dev/null)   # no clock named = the start of that day
    # A day already gone by is next year's — but only when next year's lands inside the fortnight ("resets Jan 2",
    # read on Dec 31). A year the message names itself is taken as written and never rolled.
    if [ -z "$y" ] && [ "${u:-0}" -gt 0 ] && [ "$u" -le "$now" ]; then
      n=$(TZ="$tz" date -d "$d $((yn + 1)) ${c:-00:00}" +%s 2>/dev/null)
      { [ -n "$n" ] && [ "$n" -gt "$now" ] && [ "$n" -lt $((now + AHEAD)) ]; } && { u="$n"; rolled=1; }
    fi
    # …and a day landing further out than that is not a reset at all. "resets Dec 31" read on Jan 3 is this
    # December, "Sep 7 2077" is fifty years — both misreads, and the caller only ever guards against the past, so
    # either would park the box for good. u=0 hands it to the backoff, which is the safe read of a garbled day.
    [ "${u:-0}" -gt $((now + AHEAD)) ] && u=0
    how='date'
  elif m=$(grep -oiE "${RS}[0-9]{1,2}(:[0-9]{2})? *(am|pm)?" <<<"$txt" | head -1) && [ -n "$m" ]; then
    c=$(grep -oiE '[0-9]{1,2}(:[0-9]{2})? *(am|pm)?$' <<<"$m")
    u=$(TZ="$tz" date -d "$c" +%s 2>/dev/null)                                        # a clock time
    [ -n "$u" ] && [ "$u" -le "$now" ] && { u=$(TZ="$tz" date -d "tomorrow $c" +%s 2>/dev/null); rolled=1; }   # …already past today = tomorrow
    how="at"
  fi
  [[ "${u:-0}" =~ ^[0-9]+$ ]] || u=0; }

# ---- interactive sessions: record what the limit interrupted, nudge it once when the limit lifts
corroborated(){   # $1 pane, $2 window (unused — kept for the callers). The stamp is live, or cc-model itself
                  # JUDGED a limit recently: a live override, or a `switch` in model.log (the only event it writes
                  # that means "a limit moved this box"). model-seen is NOT proof — cc-model banks that hash for
                  # every probe that DECIDED, including "was not a live limit" (review of #171).
  stamp; [ "$ends" -gt "$now" ] && return 0
  [ -s "$HOME/.cc/state/model-override" ] && return 0
  awk -F'\t' -v c=$((now - 21600)) '$3=="switch" && ($2+0)>c{f=1} END{exit !f}' \
    "$HOME/.cc/state/model.log" 2>/dev/null; }

first_seen(){   # $1 pane, $2 the limit line -> the epoch THIS sighting of THAT line was first seen (stamped on first
                # sight, not in --dry). It bounds the window in which nothing corroborates the line yet: cc-model
                # needs up to a minute to judge a live limit, not for ever — an old episode's wording, or a pane
                # merely SHOWING the words, would otherwise keep the pulse away from that session for good
                # (review-171b).
                # KEYED ON THE LINE, not the pane alone. A row per pane, kept for ever, expires that pane's window
                # permanently: a pane that showed the wording on Monday is read as old news when the limit really
                # stops it on Wednesday, so record answers 1 and the pulse types at a limited session (review of
                # #171). Ageing the row out instead would re-open the window for a line that never left the screen,
                # which is the case review-171b closed. The line's own text separates the two: a new limit prints a
                # new line, and that is a new sighting with its own hour. Rows older than a day are dropped on the
                # way through, the way note_nudge prunes its own.
  local k t
  k="$1:$(printf '%s' "$2" | md5sum | cut -c1-16)"
  t=$(awk -F'\t' -v k="$k" '$1==k{print $2+0; exit}' "$SEEN" 2>/dev/null)
  if [ -z "$t" ]; then
    t=$now
    [ -n "$DRY" ] || { mkdir -p "$(dirname "$SEEN")"
      { [ -f "$SEEN" ] && awk -F'\t' -v k="$k" -v c=$((now - 86400)) '$1!=k && ($2+0)>c' "$SEEN"
        printf '%s\t%s\n' "$k" "$now"; } > "$SEEN.t"; mv "$SEEN.t" "$SEEN"; }
  fi
  echo "$t"; }
nudged_recently(){   # $1 pane. The limit line does not leave the pane when the session comes back, so the SAME stale
                    # line would be read as a fresh interruption on the next round and buy a second nudge. One nudge
                    # per pane per half hour, then; a genuine new limit is hours away, far outside this window.
  local t; t=$(awk -F'\t' -v p="$1" '$1==p{print $2+0; exit}' "$NUDGED" 2>/dev/null)
  [ "${t:-0}" -gt $((now - QUIET)) ]; }

note_nudge(){   # $1 pane; entries older than a day are dropped on the way through
  mkdir -p "$(dirname "$NUDGED")"
  { [ -f "$NUDGED" ] && awk -F'\t' -v p="$1" -v c=$((now - 86400)) '$1!=p && ($2+0)>c' "$NUDGED"
    printf '%s\t%s\n' "$1" "$now"; } > "$NUDGED.t"; mv "$NUDGED.t" "$NUDGED"; }

arm(){   # one-shot at the earliest reset still on file. NOT a unit that lives on the box: systemd-run makes a transient
         # timer that fires once and disposes of itself, so a box with nothing recorded runs nothing.
  local at secs real unit mine u
  at=$(awk -F'\t' '($3+0)>0 && (m==0 || ($3+0)<m){m=$3+0} END{print m+0}' "$REC" 2>/dev/null)
  [ "${at:-0}" -gt 0 ] || return 0
  secs=$((at - now + 15)); [ "$secs" -lt 15 ] && secs=15   # a few seconds past the reset: the limit lifts on their clock
  unit="cc-limit-resume-$at"   # ONE TRANSIENT UNIT PER RESET TIME — see the sweep below for why the name must differ
  if [ -n "${CC_LIMIT_ARM:-}" ]; then [ "$CC_LIMIT_ARM" = - ] || "$CC_LIMIT_ARM" "$secs" "$unit" >/dev/null 2>&1; return 0; fi
  real=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)
  { [ -n "$real" ] && [ "$HOME" != "$real" ]; } && return 0   # a test HOME never arms a timer on the real box
  command -v systemd-run >/dev/null 2>&1 || return 0
  # Clear the arming this one supersedes — but NEVER the unit this process is running under. `resume` re-arms
  # whatever it left on file, and when resume IS the one-shot, stopping its own unit SIGTERMs the whole cgroup,
  # which is this shell: the systemd-run below would never run and every record still on file would lose its timer
  # (review of #171). The names cannot collide — an arming is always for a reset in the future, and ours has fired.
  mine=$(grep -oE 'cc-limit-resume-[0-9]+\.service' /proc/self/cgroup 2>/dev/null | tail -1)
  for u in $(systemctl --user list-units --all --plain --no-legend 'cc-limit-resume-*' 2>/dev/null | awk '{print $1}'); do
    case "$u" in "$mine" | "${mine%.service}.timer") continue ;; esac
    systemctl --user stop "$u" >/dev/null 2>&1; systemctl --user reset-failed "$u" >/dev/null 2>&1
  done
  systemd-run --user --quiet --unit="$unit" --on-active="${secs}s" --timer-property=AccuracySec=5 \
    "$SELF" resume >/dev/null 2>&1 || true; }

record(){   # $1 pane id, or a window id/name to resolve  $2 window name
            # exit 0 = recorded · 2 = the pane is on the limit, this is not a record · 1 = no limit line there
  # `u` and `how` are LOCAL because parse_reset writes them as globals: `check` parses its own reset, then calls
  # scan -> record at the end, and without this line that record's parse_reset overwrites the epoch check is about
  # to print — "LIMIT 0", and the owner is told the limit resumes at 00:00Z (review of #171).
  local pane="$1" win="$2" cap line at old p u how rolled from_pane=0
  # A window id or a window name is accepted and resolved to the PANE id first: the record is keyed on the pane, so
  # cc-pulse (which holds window ids) and scan (which holds pane ids) write one record for a session, not two — and
  # two records for one session is two nudges.
  p=$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null | head -1); case "$p" in %[0-9]*) pane="$p";; esac
  cap=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$TAIL")   # the LAST lines: -S sets a history start, it does not bound the read
  line=$(grep -iE "$PANE_RE" <<<"$cap" | tail -1); [ -n "$line" ] || return 1
  # Past this line the pane IS sitting on the limit, and every "no" below is exit 2, not 1: a caller that read a
  # plain failure as "nothing wrong here" would type at a limited session, which is what cc-pulse must not do.
  nudged_recently "$pane" && return 2
  if ! corroborated "$cap" "$win"; then
    # Nothing corroborates the line. For its first hour that means "cc-model has not judged it yet" — exit 2, no
    # tick. After that it is scrollback (an episode hours old, or a pane just showing the words) and the pane is
    # safe to tick: exit 1. Left open-ended, exit 2 stopped the pulse waking that session for good (review-171b).
    [ $((now - $(first_seen "$pane" "$line"))) -lt "$JUDGE" ] && return 2
    return 1
  fi
  # A reset the stamp only GUESSED is not a reset. `check` writes src=backoff:N when the message named no time, and
  # a nudge at that guess reaches a session that is still limited — and spends the one nudge that was owed at the
  # real time. So a backoff stamp is passed over and the pane's own wording is read instead.
  stamp; at=0; case "$src" in backoff:*) ;; *) [ "$ends" -gt "$now" ] && at="$ends";; esac
  if [ "$at" = 0 ]; then
    parse_reset "$cap"; from_pane=1
    # A clock time the pane names that is already past is NOT tomorrow's. parse_reset rolls it over because `check`
    # hands it a fresh message; a screen is of unknown age, and the rollover recorded a session for a day out
    # (review-171c). So the rollover is never recorded — and a record already on file stays exactly where it is.
    # …and a pane whose ONLY named reset is already past is safe to type at: exit 1, not 2 — exit 2 kept the pulse away
    # from that session for hours after its limit had lifted (review-171e). A record already on file stays where it is.
    [ "${rolled:-0}" = 1 ] && return 1
    [ "$u" -gt "$now" ] && at="$u"
  fi
  [ "$at" -gt "$now" ] || return 2   # limited, but no reset time yet: whoever looks next records it once there is one
  old=0; [ -f "$REC" ] && old=$(awk -F'\t' -v p="$pane" '$1==p{print $3+0; exit}' "$REC")
  # A pane re-read never moves a record out: its line is stale text, and "in 30 minutes" is 30 minutes from whenever
  # it is read — every round pushed the record past its own due time and the nudge was never sent (review-171c).
  # Only a live stamp, a reset the API itself named, moves an existing record — and never shorter.
  [ "$from_pane" = 1 ] && [ "${old:-0}" -gt 0 ] && at="$old"
  [ "${old:-0}" -gt "$at" ] && at="$old"   # one record per pane, and a record is never shortened
  # FIELDS 4 AND 5 ARE WRITTEN ONCE, BY THE FIRST SIGHTING, and a later read never revises them: both answer a
  # question about the MOMENT the limit stopped this session, and a pane re-read minutes later is a different moment.
  # · started — the stamp's first-seen ($first), which is when this episode began. `resume` publishes it, and both
  #   readers call an `agent` mark cold only if it predates it: see WHAT ELSE THE LIMIT KILLED.
  # · tags — `working` if the pane was mid-turn when it was recorded (see A TURN THAT NEVER ENDED: resume presses
  #   Escape only at a turn that was already running then), and `indep` if this pane's limit LINE was first seen at
  #   or after $first, i.e. inside this episode (see A RECORD IS NOT ALWAYS A SECOND WITNESS).
  local started tags="" seen_at
  grep -qF "$WORK_MARK" <<<"$cap" && tags=working
  seen_at=$(first_seen "$pane" "$line")   # stamps the line on first sight, exactly as the uncorroborated branch does
  # The stamp's first-seen is the box's own answer to "when did this episode begin". Where there is no stamp —
  # corroborated by a model-override or a `switch` cc-model wrote — this pane's own line is: it went up when this
  # session took its 429, which is the moment its subagents died.
  started="$first"; [ "$started" -le 0 ] && started="$seen_at"
  # …and `indep` needs a stamp to be independent OF: cc-model's rule is about a stamp with one observer on it, and
  # a sighting inside that episode is the second witness. No stamp, no claim — cc-model wants a live one anyway.
  [ "$first" -gt 0 ] && [ "$seen_at" -ge "$first" ] && tags="${tags:+$tags,}indep"
  if [ -f "$REC" ]; then   # an existing record's own first sighting stands
    # Split by LINE, not by `IFS=$'\t' read`: tab is IFS whitespace, so an empty tags field would fold away and
    # slide nothing into $ot — the same trap the stamp's empty model field sprang on 2026-09-04.
    local os="" ot=""
    { IFS= read -r os; IFS= read -r ot; } < <(awk -F'\t' -v p="$pane" '$1==p{print $4+0; print $5; exit}' "$REC")
    [ "${os:-0}" != 0 ] && { started="$os"; tags="$ot"; }
  fi
  [ -n "$DRY" ] && { printf 'would record %s (%s) until %sZ\n' "$win" "$pane" "$(date -u -d "@$at" +%H:%M)"; return 0; }
  mkdir -p "$(dirname "$REC")"
  { [ -f "$REC" ] && awk -F'\t' -v p="$pane" '$1!=p' "$REC"
    printf '%s\t%s\t%s\t%s\t%s\n' "$pane" "$win" "$at" "$started" "$tags"; } > "$REC.t"
  mv "$REC.t" "$REC"; arm
  printf 'recorded %s (%s) until %sZ\n' "$win" "$pane" "$(date -u -d "@$at" +%H:%M)"; }

live_claude(){   # is there an interactive `claude` ANYWHERE under pane pid $1? The DIRECT-child test was wrong here in
                 # the one case that matters: a `cc-handoff --overlap` successor runs `bash -c '… cc __runnext …'`,
                 # so its claude is a GRANDCHILD, and calling that session dead is never recording the very session
                 # this file exists to rescue (review of #171). Same subtree walk cc-msg and cc-pulse make; `-p` is
                 # excluded because a headless worker parks and reruns itself and has no prompt to type into.
  local pid
  for pid in $(ps -eo pid=,ppid=,comm= | awk -v root="${1:-0}" '
        { kids[$2] = kids[$2] " " $1; name[$1] = $3 }
        END { q[1] = root; n = 1                                     # breadth-first over the pane subtree
              for (i = 1; i <= n; i++) { m = split(kids[q[i]], c, " "); for (j = 1; j <= m; j++) q[++n] = c[j] }
              for (i = 2; i <= n; i++) if (name[q[i]] == "claude") print q[i] }'); do
    tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qx -e '-p' -e '--print' || return 0
  done
  return 1; }

scan(){   # every live INTERACTIVE session under this tmux session
  local id pp name rc=1 r
  while read -r id pp name; do
    [ -n "${pp:-}" ] || continue
    live_claude "$pp" || continue
    pgrep -P "$pp" -f cc-loop >/dev/null 2>&1 && continue   # a headless worker's pane: it parks and reruns itself
    record "$id" "$name"; r=$?
    case "$r" in 0) rc=0 ;; 2) [ "$rc" = 1 ] && rc=2 ;; esac   # the best of what it found, so the whole-box form
  done < <(tmux list-panes -s -t "${CC_TMUX_SESSION:-main}" -F '#{pane_id} #{pane_pid} #{window_name}' 2>/dev/null)
  return "$rc"; }                                             # answers in the same three codes as one pane does

resume(){   # everything due, once each; everything not due, left exactly where it was
  [ -s "$REC" ] || return 0
  local pane win at started tags cap keep="" woke="" lifted=0 due=0 began=0 began_ok=1
  # Five fields since the review of #264 — see record(). A record written before that has three, and every "no"
  # below is the safe answer for it: no start (the episode is not published at all) and no `working` (no Escape).
  while IFS=$'\t' read -r pane win at started tags; do
    { [ -n "${pane:-}" ] && [[ "${at:-}" =~ ^[0-9]+$ ]]; } || continue
    started="${started:-0}"; [[ "$started" =~ ^[0-9]+$ ]] || started=0; tags="${tags:-}"
    if [ "$at" -gt "$now" ]; then keep+="$pane	$win	$at	$started	$tags"$'\n'; continue; fi   # nothing is sent before the reset
    stamp
    if [ "$ends" -gt "$now" ]; then keep+="$pane	$win	$ends	$started	$tags"$'\n'   # the limit moved out: wait for the new time
      printf '%s: reset moved to %sZ — not nudged\n' "$win" "$(date -u -d "@$ends" +%H:%M)"; continue; fi
    # Past here this record's limit really is over — the reset has passed and no live stamp moved it out. The
    # LATEST such reset is the episode, nudge or no nudge: see WHAT ELSE THE LIMIT KILLED below.
    [ "$at" -gt "$due" ] && due="$at"
    # …and the EARLIEST start, because that is the bar a mark is judged against and the earliest one calls the
    # fewest marks dead. A due record that carries no start at all makes the episode unpublishable rather than
    # guessed: the whole rule is that a mark predating the start is dead, and a wrong start kills live rows.
    if [ "$started" -gt 0 ]; then { [ "$began" = 0 ] || [ "$started" -lt "$began" ]; } && began="$started"
    else began_ok=0; fi
    cap=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$TAIL")   # same bounded read as record()
    grep -qiE "$PANE_RE" <<<"$cap" || { printf '%s: moved on already — no nudge\n' "$win"; continue; }
    # "a session whose pane still shows a limit error after the reset is kicked (the turn ended, the queued input
    # delivered)". The turn that took the 429 does not end by itself — see A TURN THAT NEVER ENDED — and while it
    # runs, cc-msg spools instead of typing, so the nudge below would join everything else already stuck behind it.
    # Escape only HERE, and only for a turn that was ALREADY RUNNING when the record was written (`working` in
    # field 5). Review of #264: when the 429 did end the turn — the ordinary case — cc-msg's drain types the
    # spooled lines at the freed pane and the session starts a NEW turn, and the stale limit line is still on
    # screen at the reset, so "limit line + footer" alone would Escape a live turn mid-tool-call. Both halves,
    # then: mid-turn when it was recorded AND mid-turn now. Nothing is pressed at any other pane.
    if [[ ",$tags," == *,working,* ]] && grep -qF "$WORK_MARK" <<<"$cap"; then
      tmux send-keys -t "$pane" Escape >/dev/null 2>&1
      sleep "$SETTLE"   # the pane needs to redraw before cc-msg reads it, or it judges the turn still running
      printf '%s: still mid-turn at the reset — ended it\n' "$win"
    fi
    # Dropped whether or not cc-msg got through. A nudge is worth one try: retrying is how a session behind a dialog
    # gets typed at over and over, and the pulse still comes round.
    note_nudge "$pane"   # before the send, and whether or not it lands: one try is one try
    if "$BIN/cc-msg" "$win" "usage limit lifted at $(date -d "@$at" +%H:%M) — continue the turn you were on; your journal and board say where you were" </dev/null >/dev/null 2>&1
    then printf '%s: nudged\n' "$win"; woke+="${woke:+, }$win"; [ "$at" -gt "$lifted" ] && lifted="$at"
    else printf '%s: cc-msg would not type there — dropped, not retried\n' "$win"; fi
  done < "$REC"
  # See WHAT ELSE THE LIMIT KILLED: the subagents this episode took with it are found by their marks predating
  # its START. Written whether or not a nudge landed — a pane that moved on by itself still lost them.
  [ "$due" -gt 0 ] && [ "$began_ok" = 1 ] && [ "$began" -gt 0 ] \
    && { mkdir -p "$(dirname "$RESUMED")"; printf '%s\t%s\t%s\n' "$began" "$due" "$now" > "$RESUMED"; }
  # ONE line for the episode, not one per session: this runs once, at the reset, and the owner's question on
  # 2026-09-05 was "why has nothing run since 2am" — what stalled, and when it went again, answers it.
  [ -n "$woke" ] && [ -x "$BIN/cc-notify" ] && "$BIN/cc-notify" -t "$(hostname -s) limit lifted" \
    "A usage limit stalled $woke. It lifted at $(date -d "@$lifted" +%H:%M) and they were put back on their work at $(date -d "@$now" +%H:%M)." >/dev/null 2>&1
  if [ -n "$keep" ]; then printf '%s' "$keep" > "$REC"; arm; else rm -f "$REC"; fi; }

selfcheck(){   # stubs only: its own HOME, a stub tmux and cc-msg, and a clock it is handed. No tmux server, no timer,
               # no session on this box is read or written.
  local d n=0 bad=0 t0=1000000000 t1 t2 t3 t4 rc h out deep work OBS=runA cutoff
  d=$(mktemp -d) || return 1
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  mkdir -p "$d/bin" "$d/.cc/state" "$d/panes"
  cat > "$d/bin/tmux" <<'EOF'
#!/usr/bin/env bash
# selfcheck stub: capture-pane prints $CC_FAKE_PANES/<pane-id>, or nothing when that pane is gone; display-message
# resolves a window id to a pane id out of $CC_FAKE_PANES/<id>.id, the way tmux does; list-panes reads the fake
# session out of $CC_FAKE_PANELIST ("<pane-id> <pane-pid> <window>" lines, the format scan asks for); send-keys is
# logged AND acted on — Escape ends the turn, so the working footer leaves that pane exactly as it does on the box.
set -u; cmd="${1:-}"; shift || true; targ=""; args="$*"
while [ $# -gt 0 ]; do case "$1" in -t) targ="${2:-}"; shift 2;; *) shift;; esac; done
case "$cmd" in
  display-message) cat "$CC_FAKE_PANES/$targ.id" 2>/dev/null;;
  capture-pane) cat "$CC_FAKE_PANES/$targ" 2>/dev/null;;
  list-panes) cat "${CC_FAKE_PANELIST:-/dev/null}" 2>/dev/null;;
  send-keys) printf 'keys %s :: %s\n' "$targ" "$args" >> "$CC_FAKE_CALLS"
             case "$args" in *Escape*) grep -v 'esc to interrupt' "$CC_FAKE_PANES/$targ" > "$CC_FAKE_PANES/$targ.t" 2>/dev/null
                                       mv "$CC_FAKE_PANES/$targ.t" "$CC_FAKE_PANES/$targ" 2>/dev/null;; esac;;
esac
exit 0
EOF
  cat > "$d/bin/cc-msg" <<'EOF'
#!/usr/bin/env bash
# selfcheck stub: the real cc-msg SPOOLS instead of typing when the pane is mid-turn, and that is the whole of the
# 2026-09-05 failure — so does this one, for any window with a $CC_FAKE_PANES/<window>.win pane mapping on file.
set -u; p=""; [ -n "${1:-}" ] && p=$(cat "$CC_FAKE_PANES/$1.win" 2>/dev/null)
if [ -n "$p" ] && grep -qF 'esc to interrupt' "$CC_FAKE_PANES/$p" 2>/dev/null
then printf 'spool %s :: %s\n' "${1:-}" "${2:-}" >> "$CC_FAKE_CALLS"
else printf 'msg %s :: %s\n' "${1:-}" "${2:-}" >> "$CC_FAKE_CALLS"; fi
EOF
  cat > "$d/bin/arm" <<'EOF'
#!/usr/bin/env bash
set -u; printf 'arm %s %s\n' "${1:-}" "${2:-}" >> "$CC_FAKE_CALLS"
EOF
  cat > "$d/bin/cc-model" <<'EOF'
#!/usr/bin/env bash
set -u; printf 'model %s\n' "$*" >> "$CC_FAKE_CALLS"
EOF
  cat > "$d/bin/cc-notify" <<'EOF'
#!/usr/bin/env bash
set -u; printf 'notify %s\n' "$*" >> "$CC_FAKE_CALLS"
EOF
  chmod +x "$d/bin/tmux" "$d/bin/cc-msg" "$d/bin/arm" "$d/bin/cc-model" "$d/bin/cc-notify"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  : > "$d/calls"
  # EVERY CC_LIMIT_* path is pinned under $d, not just inherited from HOME: a caller may hold its own in the
  # environment — selftest.sh exports CC_LIMIT_STAMP so that a test limit never makes a real loop wait — and a
  # selfcheck that read the caller's stamp would be testing the caller's state instead of its own fixtures.
  me(){ local at="$1"; shift; HOME="$d" PATH="$d/bin:$PATH" CC_LIMIT_BIN="$d/bin" CC_LIMIT_ARM="$d/bin/arm" \
    CC_LIMIT_STAMP="$d/.cc/state/claude-limit" CC_LIMIT_RECORD="$d/.cc/state/limit-interrupted" \
    CC_LIMIT_NUDGED="$d/.cc/state/limit-nudged" CC_LIMIT_SEEN="$d/.cc/state/limit-seen" \
    CC_LIMIT_RESUMED="$d/.cc/state/limit-resumed" \
    CC_FAKE_PANES="$d/panes" CC_FAKE_CALLS="$d/calls" CC_FAKE_PANELIST="$d/panes.list" \
    CC_LIMIT_OBSERVER="$OBS" CC_LIMIT_MIN_WAIT='' CC_LIMIT_MAX_WAIT='' CC_LIMIT_SETTLE=0 \
    CC_LIMIT_NOW="$at" bash "$SELF" "$@"; }
  led(){   # one row of cc-spend's ledger — $1 epoch, $2 session, $3 model: "<ts> <session> <cwd> <repo> <track>
           # <kind> <model> <in> <out> <cache_read> <cache_write> <est_usd>", ts in the UTC ISO seconds it prints
    mkdir -p "$d/.cc/state/spend"
    printf '%s\ts%s\t/x\tmyrepo\tt\theadless\t%s\t1\t1\t0\t0\t0.01\n' \
      "$(date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ)" "$2" "$3" >> "$d/.cc/state/spend/$(date -u -d "@$1" +%F).tsv"; }
  calls(){ grep -c "$1" "$d/calls" 2>/dev/null | tr -d '\n'; }

  me "$t0" record @1 alpha >/dev/null 2>&1
  t 'a limit line ALONE is not recorded (this box says "usage limit" in its own docs)' \
    "$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" no
  printf '%s\t%s\t%s\t%s\n' "$((t0 + 1800))" iso "$t0" fable > "$d/.cc/state/claude-limit"
  out=$(me "$t0" record --dry @1 alpha 2>&1)
  t '--dry says what it would record and writes nothing' \
    "$(grep -c would <<<"$out")$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" 1no
  me "$t0" record @1 alpha >/dev/null 2>&1
  t 'an interrupted session is recorded as <pane, window, reset, episode start, tags>' \
    "$(cat "$d/.cc/state/limit-interrupted" 2>/dev/null)" "$(printf '@1\talpha\t%s\t%s\tindep' $((t0 + 1800)) "$t0")"
  t '…and the start is the STAMP\'"'"'s first-seen, not the reset and not the moment it was recorded: that is when
     the 429 killed this session\'"'"'s subagents' \
    "$(cut -f4 "$d/.cc/state/limit-interrupted")" "$t0"
  t 'recording arms ONE one-shot, a few seconds past the reset, in a unit named for that reset' \
    "$(grep -c "^arm 181[0-9] cc-limit-resume-$((t0 + 1800))\$" "$d/calls")" 1
  me "$t0" record @1 alpha >/dev/null 2>&1
  t 'the same pane twice is one record, not two' "$(wc -l < "$d/.cc/state/limit-interrupted")" 1

  me $((t0 + 60)) resume >/dev/null 2>&1
  t 'NOTHING is sent before the reset, and the record survives' \
    "$(calls '^msg ')$(wc -l < "$d/.cc/state/limit-interrupted")" 01
  me $((t0 + 1900)) resume >/dev/null 2>&1
  t 'at the reset the session is nudged, once, through cc-msg' "$(calls '^msg alpha ')" 1
  t 'the nudge names the time, box-local (no Z), and points at the journal and the board' \
    "$(grep -cE 'usage limit lifted at [0-9]{2}:[0-9]{2} — continue the turn you were on; your journal and board say where you were' "$d/calls")" 1
  t 'and the record is cleared by the nudge' "$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" no
  me $((t0 + 1901)) resume >/dev/null 2>&1
  t 'a second resume nudges nobody: one message per interruption, ever' "$(calls '^msg alpha ')" 1
  # The pane still shows the line it was stopped by — the nudge does not wipe its screen. Recording that stale line
  # again is the OTHER way one interruption becomes two nudges, and the live stamp below is there so the quiet
  # window is the only thing refusing it.
  printf '%s\t%s\t%s\t%s\n' "$((t0 + 3700))" iso "$t0" fable > "$d/.cc/state/claude-limit"
  me $((t0 + 1902)) record @1 alpha >/dev/null 2>&1
  t 'the stale limit line on a pane just nudged is not a second record' \
    "$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" no

  # cc-model's own VERDICT stands in for the stamp once the stamp has expired: a switch event in model.log.
  # The banked hash in model-seen does NOT — it is written for every adjudicated probe, "not a live limit" included.
  t1=$((t0 + 7200))   # the rest of the cases are a later episode: past the quiet window the nudge above opened
  h=$(printf '%s' "alpha$(grep -iE "$PANE_RE" "$d/panes/@1" | tail -1)" | md5sum | cut -c1-16)
  printf '%s\n' "$h" > "$d/.cc/state/model-seen"; rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted"
  me "$t1" record @1 alpha >/dev/null 2>&1
  t 'the banked probe hash alone corroborates nothing: adjudicated is not limited' \
    "$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" no
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t1 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t1" record @1 alpha >/dev/null 2>&1
  t 'a switch cc-model judged corroborates it with no live stamp, and the pane names the reset' \
    "$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" $((t1 + 1800))
  printf '> \n' > "$d/panes/@1"   # the session came back by itself
  me $((t1 + 1900)) resume >/dev/null 2>&1
  t 'a session that moved on is skipped, not nudged, and forgotten' \
    "$(calls '^msg alpha ')$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" 1no
  me "$t1" record @9 gone >/dev/null 2>&1
  t 'a pane that shows no limit at all is not a record' \
    "$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" no

  # cc-pulse holds WINDOW ids and `scan` holds pane ids: one session must not become two records, which is two nudges.
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/%7"
  printf '%s\n' '%7' > "$d/panes/@5.id"
  printf '%s\t%s\t%s\t%s\n' "$((t1 + 1800))" iso "$t1" fable > "$d/.cc/state/claude-limit"
  me "$t1" record @5 alpha >/dev/null 2>&1; me "$t1" record %7 alpha >/dev/null 2>&1
  t 'a window id and a pane id for the same session are ONE record' \
    "$(wc -l < "$d/.cc/state/limit-interrupted")$(cut -f1 "$d/.cc/state/limit-interrupted")" '1%7'


  # FINDING 1 (review of #171): two sessions, two resets. The one-shot that fires for the first has to leave a timer
  # behind for the second — an arming that stopped the unit it was running in would SIGTERM this shell before it got
  # there, and the second session would wait for a pulse that may never come. Each arming names its own unit.
  t2=$((t1 + 7200)); rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/claude-limit" "$d/.cc/state/limit-nudged"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf 'Claude usage limit reached. Your limit will reset in 60 minutes\n> \n' > "$d/panes/%7"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t2 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t2" record @1 alpha >/dev/null 2>&1; me "$t2" record %7 beta >/dev/null 2>&1
  t 'two interrupted sessions are two records, and the arming is for the EARLIER reset' \
    "$(wc -l < "$d/.cc/state/limit-interrupted")$(tail -1 "$d/calls" | cut -d' ' -f3)" "2cc-limit-resume-$((t2 + 1800))"
  : > "$d/calls"
  me $((t2 + 1815)) resume >/dev/null 2>&1
  t 'the first reset nudges only the first, and the second is still on file' \
    "$(calls '^msg alpha ')$(calls '^msg beta ')$(wc -l < "$d/.cc/state/limit-interrupted")" 101
  t 'and that same run arms a NEW unit for the second — never the one it is running in' \
    "$(grep -c "^arm [0-9]* cc-limit-resume-$((t2 + 3600))\$" "$d/calls")" 1

  # FINDING 2: `check` writes a 5-minute GUESS into the stamp (src=backoff:N) when the message named no time. A nudge
  # at a guess reaches a session that is still limited, and spends the one nudge that was owed at the real reset.
  t3=$((t2 + 7200)); rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged"; : > "$d/calls"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf '%s\t%s\t%s\t%s\n' "$((t3 + 300))" backoff:5 "$t3" fable > "$d/.cc/state/claude-limit"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t3 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t3" record @1 alpha >/dev/null 2>&1
  t 'a backoff GUESS is not a reset: the time the PANE names is recorded, not the guess' \
    "$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" $((t3 + 1800))

  # THE EXIT CODE IS A CONTRACT (finding 4): cc-pulse reads it to decide whether that pane may be typed at, so
  # "limited, and I am not recording it" must not look like "nothing to see here".
  rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf 'Claude usage limit reached.\n> \n' > "$d/panes/@3"   # limited, and names no reset at all
  me "$t3" record @3 gamma >/dev/null 2>&1; rc=$?
  t 'a guess and a pane with no time = nothing recorded, and exit 2: the pane is still limited' \
    "$rc$([ -e "$d/.cc/state/limit-interrupted" ] && echo yes || echo no)" 2no
  me "$t3" record @9 gone >/dev/null 2>&1; rc=$?
  t 'a pane with no limit line at all is exit 1 — that one IS safe to type at' "$rc" 1
  rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/model.log" "$d/.cc/state/limit-seen"   # a line first seen NOW
  me "$t3" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'a limit line nothing corroborates yet is exit 2, not 1: it is still a limited pane' "$rc" 2
  me "$((t3 + 7200))" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'the same line two hours later, still uncorroborated, is exit 1: scrollback, not a limit — that pane may be ticked (review-171b)' "$rc" 1
  # …and the other half of that rule, which a row kept per PANE would get wrong: two days on, the limit really
  # stops this session, so the pane shows a NEW line. That is a new sighting with its own hour — reading the old
  # one as "old news" is how the pulse comes to type at a session the limit has just stopped (review of #171).
  printf 'Claude usage limit reached. Your limit will reset at 2026-09-04 19:00Z\n> \n' > "$d/panes/@1"
  me "$((t3 + 172800))" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'a NEW limit line on a pane that showed the wording days ago is exit 2, not 1 — the old sighting is not this one' \
    "$rc" 2
  t 'and the day-old row is dropped on the way through, so the file does not grow for ever' \
    "$(wc -l < "$d/.cc/state/limit-seen")" 1
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t3 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t3" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'and a pane that becomes a record is exit 0' "$rc$(cut -f3 "$d/.cc/state/limit-interrupted")" "0$((t3 + 1800))"
  me "$t3" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'a pane already on file is recorded again, not refused — the record is one row, and it stays exit 0' \
    "$rc$(wc -l < "$d/.cc/state/limit-interrupted")" 01


  # FINDING 2 (review of #171, third round): a `cc-handoff --overlap` successor runs `bash -c '… cc __runnext …'`,
  # so its claude is a GRANDCHILD of the pane — and the direct-child test called that session dead and never
  # recorded the very session this file exists to rescue. Real processes, because the walk reads /proc: a COPY OF
  # BASH named claude, since `ps` and the `-p` test both read the name the kernel holds.
  t4=$((t3 + 7200)); rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen"
  cp "$(readlink -f /bin/bash)" "$d/bin/claude"
  bash -c "bash -c \"'$d/bin/claude' -c 'sleep 20; true'; true\"; true" </dev/null >/dev/null 2>&1 &
  deep=$!
  bash -c "'$d/bin/claude' -p -c 'sleep 20; true'; true" </dev/null >/dev/null 2>&1 &
  work=$!
  sleep 0.6                                    # both panes need their children to exist before anything walks them
  printf '@1 %s alpha\n@2 %s beta\n' "$deep" "$work" > "$d/panes.list"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@2"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t4 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t4" record >/dev/null 2>&1
  t 'a session whose claude is a GRANDCHILD is scanned and recorded, not called dead' \
    "$(cut -f1,2 "$d/.cc/state/limit-interrupted" 2>/dev/null)" "$(printf '@1\talpha')"
  t 'and a pane whose only claude is headless is left out — it parks and reruns itself' \
    "$(grep -c '^@2' "$d/.cc/state/limit-interrupted" 2>/dev/null)" 0

  # FINDING 1: `check` prints LIMIT <epoch> AFTER that scan, and parse_reset writes $u as a global. A record made
  # for some other pane must not rewrite the reset this run is about to print — "LIMIT 0" is what the owner reads
  # as "resumes at 00:00Z". The pane says 30 minutes, the message below names no time at all, so the stamp's own
  # 5-minute backoff is the only right answer to print.
  rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-seen"
  printf '{"is_error":true,"result":"API Error 429 too many requests"}\n' > "$d/run.json"
  out=$(me "$t4" check "$d/run.json" 2>/dev/null)
  t 'the scan at the end of `check` cannot rewrite the reset check prints' "$out" "LIMIT $((t4 + 300))"
  t 'and that same run did record the pane, at the time the PANE named, not the backoff guess' \
    "$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" $((t4 + 1800))
  kill "$deep" "$work" >/dev/null 2>&1; pkill -f "$d/bin/claude" >/dev/null 2>&1   # $d is a fresh mktemp: matches nothing else

  # FINDING 1 (review-171c): a pane's line is STALE TEXT. Re-reading "in 30 minutes" on every round moved the record
  # 30 minutes past each read, so the nudge owed at the reset was never sent. A pane re-read never moves a record.
  t5=$((t4 + 7200)); rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen"; : > "$d/calls"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((t5 - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$t5" record @1 alpha >/dev/null 2>&1                     # recorded at T for T+1800
  me "$((t5 + 7200))" record @1 alpha >/dev/null 2>&1; rc=$?   # the same unchanged pane, two hours later
  t 'a record re-read from the same stale pane two hours on still says its ORIGINAL reset' \
    "$rc$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" "0$((t5 + 1800))"
  me "$((t5 + 7200))" resume >/dev/null 2>&1
  t 'and the resume in that same round nudges it — the reset is long past' "$(calls '^msg alpha ')" 1
  # The absolute form was worse: "reset at 3pm" re-read at 16:00 rolled over to TOMORROW's 3pm in one step. In
  # `record` a clock time already past is "no reset time yet". Real clock: parse_reset's clock times are today's,
  # and today's 00:00 is the one clock time that is always already past.
  nowr=$(date -u +%s); mid=$(date -u -d "00:00" +%s)
  rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged"; : > "$d/calls"
  printf 'Claude usage limit reached. Your limit will reset at 00:00\n> \n' > "$d/panes/@1"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((nowr - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$((mid - 7200))" record @1 alpha >/dev/null 2>&1         # last evening: 00:00 was still ahead
  t 'a clock time still ahead is recorded for today' "$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" "$mid"
  me "$nowr" record @1 alpha >/dev/null 2>&1; rc=$?
  t 'the same line once that time has passed is NOT rolled over to tomorrow: exit 1 (safe to tick), record untouched' \
    "$rc$(cut -f3 "$d/.cc/state/limit-interrupted" 2>/dev/null)" "1$mid"
  me "$nowr" resume >/dev/null 2>&1
  t 'and resume nudges it now, not tomorrow' "$(calls '^msg alpha ')" 1

  # ── WHAT ELSE THE LIMIT KILLED: publishing the episode so a dead subagent's row comes back ──────────────────
  # Own fixture and own clock: a session nudged above must not be what makes any of these pass, and the file
  # under test is removed before each case so its absence means something.
  rez(){ cat "$d/.cc/state/limit-resumed" 2>/dev/null; }
  ta=$((t5 + 43200)); rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted" \
    "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen" "$d/.cc/state/limit-resumed"; : > "$d/calls"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((ta - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$ta" record @1 alpha >/dev/null 2>&1
  me $((ta + 60)) resume >/dev/null 2>&1
  t 'no episode is published before the reset: the limit is still on and its subagents are not dead yet' \
    "$([ -e "$d/.cc/state/limit-resumed" ] && echo yes || echo no)" no
  me $((ta + 1900)) resume >/dev/null 2>&1
  t 'at the reset the episode is published as <started, reset, resumed>, so a mark older than its START is cold' \
    "$(rez)" "$(printf '%s\t%s\t%s' "$ta" $((ta + 1800)) $((ta + 1900)))"

  # A reset the stamp has moved OUT is not an episode that ended — publishing it would call every live subagent
  # dead in the middle of a limit that is still standing.
  tb=$((ta + 7200)); rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted" \
    "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen" "$d/.cc/state/limit-resumed"; : > "$d/calls"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((tb - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$tb" record @1 alpha >/dev/null 2>&1                                          # recorded for tb+1800
  printf '%s\t%s\t%s\t%s\n' "$((tb + 3600))" iso "$tb" fable > "$d/.cc/state/claude-limit"   # …the API moved it to tb+3600
  me $((tb + 1900)) resume >/dev/null 2>&1
  t 'a record whose reset the stamp moved out publishes nothing — that limit has not lifted' \
    "$([ -e "$d/.cc/state/limit-resumed" ] && echo yes || echo no)" no
  rm -f "$d/.cc/state/claude-limit"
  me $((tb + 3700)) resume >/dev/null 2>&1
  t '…and once the moved reset really passes, THAT is the episode published, not the one first recorded' \
    "$(rez)" "$(printf '%s\t%s\t%s' "$tb" $((tb + 3600)) $((tb + 3700)))"

  # A pane that came back by itself is not nudged — but the subagents it had out still died on the 429.
  tc=$((tb + 7200)); rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" \
    "$d/.cc/state/limit-seen" "$d/.cc/state/limit-resumed"; : > "$d/calls"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((tc - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  me "$tc" record @1 alpha >/dev/null 2>&1
  printf '> \n' > "$d/panes/@1"   # it moved on: no limit line left on the screen
  me $((tc + 1900)) resume >/dev/null 2>&1
  t 'a pane that moved on by itself gets no nudge, and the episode is published all the same' \
    "$(calls '^msg alpha ')$(rez)" "0$(printf '%s\t%s\t%s' "$tc" $((tc + 1800)) $((tc + 1900)))"

  # Two sessions, two resets, one episode: the LATEST reset is the bar, or a mark made between the two resets
  # would be read as older than the limit and a live subagent called dead.
  td=$((tc + 7200)); rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" \
    "$d/.cc/state/limit-seen" "$d/.cc/state/limit-resumed"; : > "$d/calls"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((td - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf 'Claude usage limit reached. Your limit will reset in 90 minutes\n> \n' > "$d/panes/@2"
  me "$td" record @2 beta >/dev/null 2>&1                 # the LATER reset first, so the last row read is the
  me $((td + 120)) record @1 alpha >/dev/null 2>&1        # EARLIER one — and two minutes later, so two starts
  me $((td + 5500)) resume >/dev/null 2>&1
  t 'two records, one episode: the LATEST reset is published, not the last row read' \
    "$(cut -f2 <<<"$(rez)")" $((td + 5400))
  t '…and the EARLIEST start, because that is the bar every mark is judged against and the earliest one calls
     the fewest live subagents dead' \
    "$(cut -f1 <<<"$(rez)")" "$td"

  # A due record carrying NO start (written before the review of #264 added the field) makes the episode
  # unpublishable rather than guessed: a start that is too late reads live marks as dead, which is the whole
  # failure this file is here to avoid.
  te=$((td + 21600)); rm -f "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-resumed"; : > "$d/calls"
  printf '@1\talpha\t%s\n' $((te + 1800)) > "$d/.cc/state/limit-interrupted"   # three fields, the old shape
  me $((te + 1900)) resume >/dev/null 2>&1
  t 'a due record with no start publishes no episode at all — a guessed start would call live rows dead,
     and the nudge that record was written for still goes' \
    "$([ -e "$d/.cc/state/limit-resumed" ] && echo yes || echo no)$(calls '^msg alpha ')" no1

  # ── A RECORD IS NOT ALWAYS A SECOND WITNESS (review of #264) ─────────────────────────────────────────────────
  # cc-model counts a record as the second run that hit a limit, and record() corroborates a pane's line with the
  # very stamp cc-model is about to believe — so a one-observer stamp plus this morning's leftover wording would be
  # two witnesses that are really one. Own fixture and own clock: the SAME pane is recorded twice, once with a line
  # older than the episode and once with a line inside it, and both answers are asserted.
  tg=$((te + 21600)); : > "$d/calls"
  rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen" \
    "$d/.cc/state/claude-limit" "$d/.cc/state/limit-resumed"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf '%s\t%s\t%s\t%s\t%s\n' $((tg - 3600)) iso $((tg - 7200)) fable aaaaaaaa > "$d/.cc/state/claude-limit"
  me $((tg - 7200)) record @1 alpha >/dev/null 2>&1   # the morning's episode: that line is first seen HERE
  rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged"
  printf '%s\t%s\t%s\t%s\t%s\n' $((tg + 1800)) iso "$tg" fable bbbbbbbb > "$d/.cc/state/claude-limit"
  me $((tg + 60)) record @1 alpha >/dev/null 2>&1     # …and hours later a fresh stamp, one observer, same screen
  t 'a stale limit line under a fresh stamp is still recorded — that session IS stopped — but not as an
     independent sighting: it is the witness the stamp already is, so cc-model still wants two observers' \
    "$(awk -F'\t' '$2=="alpha"{print $3 "/" $5}' "$d/.cc/state/limit-interrupted")" "$((tg + 1800))/"
  printf 'Claude usage limit reached. Your limit will reset in 90 minutes\n> \n' > "$d/panes/%7"
  me $((tg + 60)) record @5 beta >/dev/null 2>&1      # a line this episode put there, first seen inside it
  t '…while a line first seen at or after the stamp'"'"'s own first-seen IS a second witness, and is tagged so' \
    "$(awk -F'\t' '$2=="beta"{print $5}' "$d/.cc/state/limit-interrupted")" indep

  # ── ONE RUN'S LIMIT IS NOT THE BOX'S (2026-09-04) ────────────────────────────────────────────────────────────
  # 09:13:29Z one headless worker was told "usage limit until 06:00Z" and exited 8; every other session read that
  # stamp and did nothing for six hours while opus went on answering. Own fixture, own state: nothing above leaves
  # a stamp, a ledger or an observer these cases could lean on.
  t6=$((t5 + 86400)); rm -rf "$d/.cc/state/spend"
  rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/claude-limit.disbelieved" "$d/.cc/state/limit-interrupted" \
    "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen" "$d/.cc/state/model.log"
  : > "$d/panes.list"; : > "$d/calls"
  printf '{"is_error":true,"result":"claude-fable-5: Claude usage limit reached. Your limit resets at %s"}\n' \
    "$(date -u -d "@$((t6 + 54000))" +%Y-%m-%dT%H:%M:%SZ)" > "$d/run.json"   # 15 h out, the way that morning read
  OBS=worker-a; me "$t6" check "$d/run.json" >/dev/null 2>&1
  t 'the run that hit the limit is written into the stamp as its one observer' \
    "$(cut -f5 "$d/.cc/state/claude-limit")" "$(printf worker-a | md5sum | cut -c1-8)"
  out=$(me "$t6" status 2>/dev/null); rc=$?
  t 'and THAT run is stopped by it, exactly as before' "$rc$(grep -c 'this run only' <<<"$out")" 01
  t 'and it still refuses to wait out a 15 h limit (CC_LIMIT_MAX_WAIT) — it parks and reruns itself' \
    "$(me "$t6" wait >/dev/null 2>&1; echo $?)" 1
  OBS=worker-b; out=$(me "$t6" status 2>&1); rc=$?
  t 'every OTHER run reads clear: one run hitting a limit stops that run and nothing else' \
    "$rc$(grep -c '^clear$' <<<"$out")" 11
  t '…and is told on stderr what it is not being stopped by' \
    "$(grep -c 'no second run has hit it' <<<"$out")" 1
  t '…in words cc-land cannot read back as a live limit out of its merged stdout+stderr' \
    "$(grep -cE 'usage limit until [0-9]{2}:[0-9]{2}Z' <<<"$out")" 0
  t 'a run the stamp does not bind has nothing to wait for' "$(me "$t6" wait >/dev/null 2>&1; echo $?)" 0
  t 'and one run does not move the box off its model either' "$(calls '^model ')" 0
  me $((t6 + 60)) check "$d/run.json" >/dev/null 2>&1   # a SECOND worker hits the same limit
  t 'two runs on the same limit make it account-wide' \
    "$(cut -f5 "$d/.cc/state/claude-limit" | tr ',' '\n' | grep -c .)" 2
  OBS=worker-c; out=$(me $((t6 + 60)) status 2>/dev/null); rc=$?
  t 'and then every run is parked by it — a real account-wide limit parks the box as it does today' \
    "$rc$(grep -c 'this run only' <<<"$out")" 00
  t 'and only then is cc-model told whose limit it was' "$(calls '^model limited fable')" 1

  # THE ACCOUNT ANSWERING. A limit two runs hit can still be wrong: on 09-04 the ledger had successful opus rows at
  # 14:54, 14:55 and 14:59Z from three different sessions while the box sat parked. Two DIFFERENT sessions, on the
  # limited model, past the grace — believing a limit wrongly costs a day, disbelieving one wrongly costs a reset.
  cutoff=$((t6 + 300))   # GRACE past the moment the stamp was first seen
  led $((cutoff + 60)) 1 claude-fable-5-1
  t 'ONE session answering is not proof — a person can pay a real limit out in usage credits' \
    "$(me $((t6 + 7200)) status >/dev/null 2>&1; echo $?)" 0
  led $((cutoff + 70)) 2 claude-opus-5
  t 'and two sessions on ANOTHER model do not disprove a limit that named fable' \
    "$(me $((t6 + 7200)) status >/dev/null 2>&1; echo $?)" 0
  led "$cutoff" 3 claude-fable-5-1
  t 'a row ON the cutoff second is not past it: the ledger prints seconds and is compared as seconds' \
    "$(me $((t6 + 7200)) status >/dev/null 2>&1; echo $?)" 0
  led $((cutoff + 80)) 3 claude-fable-5-1
  out=$(me $((t6 + 7200)) status 2>/dev/null); rc=$?
  t 'TWO sessions answering the limited model past the grace drops the stamp — no six-hour dead box' \
    "$rc$out$([ -e "$d/.cc/state/claude-limit" ] && echo yes || echo no)" 1clearno
  t 'and the owner is told, once' "$(calls '^notify ')" 1
  t 'the notice names both times box-local — no Z, no zone: core/ names neither' \
    "$(grep -cE 'A usage limit seen at [0-9]{2}:[0-9]{2} parked this box until [0-9]{2}:[0-9]{2}, but the account has gone on answering since\. Dropped it; autonomous work carries on\.' "$d/calls")" 1
  me $((t6 + 7260)) status >/dev/null 2>&1
  t 'a second look does not push a second line for the same episode' "$(calls '^notify ')" 1
  me $((t6 + 7260)) clear
  t 'clear forgets the episode too, so the next one gets its own line' \
    "$([ -e "$d/.cc/state/claude-limit.disbelieved" ] && echo yes || echo no)" no

  # A LIMIT THAT SPANS DAYS. answering() read two ledger files — the day the stamp was first seen and today — so a
  # stamp first seen late on day 1 with a reset a week out, disproved all through day 2, was still believed on day 3
  # (review of #215). Own fixture: a fresh two-observer stamp, and rows on the MIDDLE day only.
  rm -rf "$d/.cc/state/spend"; rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/claude-limit.disbelieved"; : > "$d/calls"
  t7=$(date -u -d "$(date -u -d "@$t6" +%F) 23:00:00" +%s)   # 23:00Z on day 1
  printf '{"is_error":true,"result":"claude-fable-5: Claude usage limit reached. Your limit resets at %s"}\n' \
    "$(date -u -d "@$((t7 + 7 * 86400))" +%Y-%m-%dT%H:%M:%SZ)" > "$d/run3.json"   # a week out: the weekly reset
  OBS=worker-a; me "$t7" check "$d/run3.json" >/dev/null 2>&1
  OBS=worker-b; me $((t7 + 60)) check "$d/run3.json" >/dev/null 2>&1   # a second run: account-wide, the box parks
  led $((t7 + 43200)) 5 claude-fable-5-1; led $((t7 + 43260)) 6 claude-fable-5-1   # day 2, 11:00Z: two sessions answer
  OBS=worker-c; out=$(me $((t7 + 2 * 86400)) status 2>/dev/null); rc=$?   # day 3: no row on day 1, none today
  t 'a stamp spanning three days is disproved by rows on the MIDDLE day, not only its first day and today' \
    "$rc$out" 1clear

  # THE STAMP THAT STARTED ALL THIS NAMED NO MODEL, so its field 4 is empty. Its own fixture: a fresh stamp and no
  # ledger, so nothing here but the split is under test.
  rm -rf "$d/.cc/state/spend"; rm -f "$d/.cc/state/claude-limit"; OBS=worker-d
  printf '{"is_error":true,"result":"Claude usage limit reached. Your limit resets at %s"}\n' \
    "$(date -u -d "@$((t6 + 54000))" +%Y-%m-%dT%H:%M:%SZ)" > "$d/run2.json"
  me "$t6" check "$d/run2.json" >/dev/null 2>&1
  t 'a limit naming no model leaves field 4 empty and field 5 still readable' \
    "$(cut -f4,5 "$d/.cc/state/claude-limit")" "$(printf '\t%s' "$(printf worker-d | md5sum | cut -c1-8)")"
  t '…and the run that hit it still finds its own key there' \
    "$(me "$t6" status 2>/dev/null | grep -c 'this run only')" 1

  # USAGE CREDITS ARE NOT A LIMIT (2026-09-03). Every call to Fable on a Pro account answered "Fable 5.1 requires
  # usage credits" — one model this account cannot run, for good — and the word "credits" in the limit pattern
  # wrote a box-wide stamp for it. Own fixture: no stamp, no ledger, and the message verbatim.
  rm -rf "$d/.cc/state/spend"; rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/claude-limit.disbelieved"; : > "$d/calls"; OBS=worker-e
  printf '{"is_error":true,"stop_reason":"stop_sequence","terminal_reason":"api_error","result":"Fable 5.1 requires usage credits","modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":9},"claude-fable-5-1":{"inputTokens":2}}}\n' > "$d/credits.json"
  out=$(me "$t6" check "$d/credits.json" 2>/dev/null); rc=$?
  t 'a model that needs usage credits is not a limit: check says so (exit 1) and prints no LIMIT' "$rc$out" 1
  t 'and writes no stamp, so nothing else on the box is held by it' "$([ -e "$d/.cc/state/claude-limit" ] && echo yes || echo no)" no
  t 'and tells cc-model that model is unavailable, in the words the API used' \
    "$(grep -c '^model unavailable fable Fable 5.1 requires usage credits$' "$d/calls")" 1
  # the 2026-08-28 wording came with a 429 on it and named no model in its text: the run's own main model is the one,
  # never the haiku side-call
  printf '{"is_error":true,"api_error_status":429,"result":"You'"'"'re out of usage credits. Switch to another model, or manage usage credits at claude.ai/settings/usage?from=cc_cli_limit_message, to continue.","modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":9},"claude-fable-5":{"inputTokens":2}}}\n' > "$d/credits2.json"
  : > "$d/calls"; me "$t6" check "$d/credits2.json" >/dev/null 2>&1; rc=$?
  t 'out of usage credits (2026-08-28) is the same: no stamp, and the model is the run'"'"'s own, not the side-call' \
    "$rc$([ -e "$d/.cc/state/claude-limit" ] && echo yes || echo no)$(grep -c "^model unavailable fable You're out of usage credits$" "$d/calls")" 1no1
  # A MONTHLY SPEND CAP IS NOT A WEEKLY LIMIT (2026-09-09 06:41Z): the reset the line names is the weekly limit's,
  # and the cap lifts only when the owner raises it. Own fixture: no stamp, the line verbatim with a reset 22 h out.
  rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/claude-limit.disbelieved"; : > "$d/calls"; OBS=worker-f
  printf '{"is_error":true,"result":"You'"'"'ve hit your monthly spend limit · raise it at claude.ai/settings/usage · your weekly limit resets %s (UTC)"}\n' \
    "$(date -u -d "@$((t6 + 79200))" +%H:%M)" > "$d/cap.json"
  out=$(me "$t6" check "$d/cap.json" 2>/dev/null); rc=$?
  t 'a monthly spend cap is a limit (exit 0, LIMIT printed) but NOT one the named weekly reset lifts: the stamp is the 5-minute backoff, tagged spend-cap' \
    "$rc:${out#LIMIT }:$(cut -f2 "$d/.cc/state/claude-limit")" "0:$((t6 + 300)):spend-cap:5"
  t '…and the owner is told once that a cap only he can raise stopped the box' "$(grep -c '^notify .*spend cap' "$d/calls")" 1
  me $((t6 + 400)) check "$d/cap.json" >/dev/null 2>&1
  t '…the next probe on the same cap doubles the backoff and does not tell him again' \
    "$(cut -f1,2 "$d/.cc/state/claude-limit")$(grep -c '^notify .*spend cap' "$d/calls")" "$(printf '%s\tspend-cap:10' $((t6 + 1000)))1"
  # …while a real limit whose text names no model is still caught, still shared, and names the right family
  printf '{"is_error":true,"api_error_status":429,"result":"Claude usage limit reached. Your limit resets at %s","modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":9},"claude-opus-5":{"inputTokens":2}}}\n' \
    "$(date -u -d "@$((t6 + 1800))" +%Y-%m-%dT%H:%M:%SZ)" > "$d/opuslim.json"
  : > "$d/calls"; out=$(me "$t6" check "$d/opuslim.json" 2>/dev/null); rc=$?
  t 'a real limit is still a timed stamp' "$rc$out" "0LIMIT $((t6 + 1800))"
  t 'and it names the model that hit it, not the CLI'"'"'s haiku side-call (the 09-03 stamp named the wrong family)' \
    "$(cut -f4 "$d/.cc/state/claude-limit")" opus
  t 'and cc-model is not told anything is unavailable' "$(calls '^model unavailable')" 0
  printf '{"is_error":true,"result":"Claude usage limit reached · continuing on Fable 5 uses usage credits · resets at %s"}\n' \
    "$(date -u -d "@$((t6 + 3600))" +%Y-%m-%dT%H:%M:%SZ)" > "$d/both.json"
  rm -f "$d/.cc/state/claude-limit"; : > "$d/calls"; out=$(me "$t6" check "$d/both.json" 2>/dev/null); rc=$?
  t 'a limit hit with no credits left to continue on is still a limit: the limit wording wins' \
    "$rc$out$(calls '^model unavailable')" "0LIMIT $((t6 + 3600))0"

  # A DAY IS NOT AN HOUR, AND THE ZONE IS THE ONE THE MESSAGE NAMES (2026-09-03). The weekly limit read "resets
  # Sep 7, 10am (America/Los_Angeles)": the clock branch took the 7 out of "Sep 7" for an hour, so the box was
  # parked to 07:00 Los Angeles — three hours early on a limit with days to run. The URL in the same line is the
  # second half of it: the zone used to be the FIRST thing in the text with a slash in it, which was "ai/settings",
  # and the clock was then read as UTC. Fixed clocks throughout, so these hold whatever year the suite runs in.
  rm -rf "$d/.cc/state/spend"; rm -f "$d/.cc/state/claude-limit.disbelieved"; OBS=worker-f
  t8=$(date -u -d '2026-09-04 22:53:00' +%s); t9=$(date -u -d '2026-12-31 20:00:00' +%s)
  rt(){   # $1 the clock, $2 the wording -> "<the epoch check stamped, UTC> <how it read it>". The stamp is dropped
          # first, so a case that ends in backoff always gets the first step of it and never a doubling of the case
          # before, and every case reads only its own message.
    local o; rm -f "$d/.cc/state/claude-limit"
    printf '{"is_error":true,"result":"Claude usage limit reached · %s"}\n' "$2" > "$d/rt.json"
    o=$(me "$1" check "$d/rt.json" 2>/dev/null)
    printf '%s %s' "$(date -u -d "@${o#LIMIT }" +%FT%H:%MZ 2>/dev/null)" "$(cut -f2 "$d/.cc/state/claude-limit" 2>/dev/null)"; }
  back(){ printf '%s backoff:5' "$(date -u -d "@$(($1 + 300))" +%FT%H:%MZ)"; }   # what a message with no readable time gets
  t 'a day and a clock are read in the zone the message names: Sep 7 10am Los Angeles = 17:00Z, not 14:00Z' \
    "$(rt "$t8" 'resets Sep 7, 10am (America/Los_Angeles) · manage usage at claude.ai/settings/usage?from=cc_cli_limit_message')" \
    '2026-09-07T17:00Z date'
  t 'the same day and clock naming no zone is UTC, never whatever the host clock is set to' \
    "$(rt "$t8" 'resets Sep 7, 10am')" '2026-09-07T10:00Z date'
  # BOTH ORDERINGS GET WRITTEN, and either read as a bare clock lands on today: 10am on the 5th, two days early.
  t 'the clock written before the day is still the day'"'"'s clock' \
    "$(rt "$t8" 'resets at 10am on Sep 7 (America/Los_Angeles)')" '2026-09-07T17:00Z date'
  t 'the day written first, the way most of the world writes it, reads the same' \
    "$(rt "$t8" 'resets 7 Sep, 10am (America/Los_Angeles)')" '2026-09-07T17:00Z date'
  t 'a day with no clock on it is the start of that day, and the ordinal and the dot are not part of the date' \
    "$(rt "$t8" 'resets Sept. 7th (America/Los_Angeles)')" '2026-09-07T07:00Z date'
  # THE YEAR THE MESSAGE LEAVES OUT. A day already past is next year's when next year's is days out…
  t 'a day already past is next year'"'"'s when next year'"'"'s is days out' \
    "$(rt "$t9" 'resets Jan 2, 9am (America/Los_Angeles)')" '2027-01-02T17:00Z date'
  t '…but not when next year'"'"'s is months out: that is a stale message, and the backoff is the safe read' \
    "$(rt "$t9" 'resets Mar 4, 9am (America/Los_Angeles)')" "$(back "$t9")"
  # NOTHING FURTHER OUT THAN A FORTNIGHT IS A RESET. check only ever guards against the past, so either of these
  # would have written a stamp months or decades out and parked the box for good.
  t 'a day that lands eleven months out is a misread, not a reset — "resets Dec 31" read on Jan 3' \
    "$(rt "$(date -u -d '2027-01-03 12:00:00' +%s)" 'resets Dec 31, 10am (America/Los_Angeles)')" \
    "$(back "$(date -u -d '2027-01-03 12:00:00' +%s)")"
  t 'and a year the message names itself is bounded the same way' \
    "$(rt "$t8" 'resets Sep 7 2077, 10am (America/Los_Angeles)')" "$(back "$t8")"
  t '…while a year it names inside the fortnight is taken as written' \
    "$(rt "$(date -u -d '2026-12-28 12:00:00' +%s)" 'resets Jan 2 2027, 9am (America/Los_Angeles)')" \
    '2027-01-02T17:00Z date'

  # ── A TURN THAT NEVER ENDED (2026-09-05) ─────────────────────────────────────────────────────────────────────
  # The planning session took the 429 inside a turn that never finished, so the nudge owed at the reset would have
  # spooled behind that turn exactly as the model switch, the pulse and every lander event did. Own fixture, own
  # clock, own state: two sessions, one still mid-turn at the reset and one already back at its input box — the
  # case that gets the Escape and the case that must not are both asserted here.
  ta=$((t0 + 400000)); : > "$d/calls"; : > "$d/panes.list"
  rm -f "$d/.cc/state/claude-limit" "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" \
    "$d/.cc/state/limit-seen"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((ta - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n✻ Thinking… (esc to interrupt)\n' > "$d/panes/@1"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/%7"
  printf '%s\n' '%7' > "$d/panes/@5.id"
  printf '@1\n' > "$d/panes/alpha.win"; printf '%s\n' '%7' > "$d/panes/beta.win"   # so the stub cc-msg can spool
  me "$ta" record @1 alpha >/dev/null 2>&1; me "$ta" record @5 beta >/dev/null 2>&1
  me $((ta + 1900)) resume >/dev/null 2>&1
  t 'a session still mid-turn at the reset has that turn ended first, with one Escape' \
    "$(grep -c '^keys @1 :: .*Escape' "$d/calls")" 1
  t '…and is nudged after it, so the line is TYPED instead of spooling behind a turn that never ends' \
    "$(calls '^msg alpha ')$(calls '^spool alpha ')" 10
  t 'a session already back at its input box is nudged with NO keystroke: Escape at a live pane interrupts it' \
    "$(grep -c '^keys %7' "$d/calls")$(calls '^msg beta ')" 01
  t 'the owner gets ONE line for the episode, naming what stalled and when it went again, box-local (no Z)' \
    "$(grep -c 'notify .*A usage limit stalled alpha, beta\. It lifted at [0-9][0-9]:[0-9][0-9] and they were put back on their work at [0-9][0-9]:[0-9][0-9]\.' "$d/calls")" 1
  : > "$d/calls"; me $((ta + 1901)) resume >/dev/null 2>&1
  t 'and a resume with nothing left on file tells the owner nothing' "$(calls '^notify ')" 0

  # …AND NOT A TURN THAT STARTED AFTER THE 429 (review of #264). The ordinary 429 DOES end the turn; cc-msg's
  # drain then types the spooled lines at the freed pane and a new turn starts, with the stale limit line still on
  # screen. On the footer alone the reset would Escape that live turn mid-tool-call. Own fixture, own clock: one
  # session recorded IDLE and mid-turn at the reset (the case that must not be pressed) and one recorded mid-turn
  # and mid-turn still (the case that must), so neither can pass on the other's state.
  tf=$((ta + 7200)); : > "$d/calls"
  rm -f "$d/.cc/state/limit-interrupted" "$d/.cc/state/limit-nudged" "$d/.cc/state/limit-seen"
  printf '%s\t%s\tswitch\t%s\t%s\n' iso "$((tf - 60))" claude-opus-5 "1 session(s); test" > "$d/.cc/state/model.log"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n> \n' > "$d/panes/@1"
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n✻ Thinking… (esc to interrupt)\n' > "$d/panes/%7"
  me "$tf" record @1 alpha >/dev/null 2>&1; me "$tf" record @5 beta >/dev/null 2>&1
  t 'the record says which of the two was mid-turn when it was written, and only that one' \
    "$(awk -F'\t' '{printf "%s=%s ", $2, $5}' "$d/.cc/state/limit-interrupted")" 'alpha= beta=working '
  # …and now the OTHER way round at the reset: alpha has started a fresh turn, beta is still in the old one.
  printf 'Claude usage limit reached. Your limit will reset in 30 minutes\n✻ Thinking… (esc to interrupt)\n' > "$d/panes/@1"
  me $((tf + 1900)) resume >/dev/null 2>&1
  t 'a session that was NOT mid-turn when it was recorded is never Escaped, however busy it is at the reset:
     that is a turn it started after the 429, and the nudge waits behind it the way any line does' \
    "$(grep -c '^keys @1' "$d/calls")$(calls '^spool alpha ')$(calls '^msg alpha ')" 010
  t '…while the one that WAS mid-turn then and is mid-turn now is still ended and typed at' \
    "$(grep -c '^keys %7 :: .*Escape' "$d/calls")$(calls '^msg beta ')" 11

  rm -rf "$d"; printf 'cc-limit selfcheck: %d passed, %d failed\n' $((n - bad)) "$bad"; [ "$bad" = 0 ]; }

case "${1:-}" in
  clear) rm -f "$S" "$DISB"; exit 0 ;;
  status) if ! believe; then echo clear
      # A stamp that does not bind this caller is still worth SAYING — on stderr, where a person reading `cc-limit
      # status` sees it and a caller capturing stdout does not have its answer changed. NOT in the words "usage
      # limit until HH:MMZ": cc-land captures stdout and stderr together and reads that phrase out of the text as a
      # reset to defer a merge to, so this line would park a queue on the very limit it says does not apply.
      [ "$ends" -gt "$now" ] && printf 'note: another run hit a limit that resets %sZ; no second run has hit it, so the box is not held by it.\n' "$(date -u -d "@$ends" +%H:%M)" >&2
      exit 1; fi
    only=""; [ "$(nobs)" -ge 2 ] || only=" (this run only)"
    printf 'usage limit until %sZ (%dm left)%s%s\n' "$(date -u -d "@$ends" +%H:%M)" $(( (ends - now + 59) / 60 )) "${mdl:+ [$mdl]}" "$only"; exit 0 ;;
  wait) believe || exit 0; s=$((ends - now))
    { [ -n "${CC_LIMIT_MIN_WAIT:-}" ] && [ "$s" -gt "$CC_LIMIT_MIN_WAIT" ]; } && s="$CC_LIMIT_MIN_WAIT"
    [ "$s" -gt "$MAX" ] && exit 1; sleep "$s"; exit 0 ;;
  record) shift; [ "${1:-}" = --dry ] && { DRY=1; shift; }
    [ -n "${1:-}" ] && { record "$1" "${2:?usage: cc-limit record [--dry] [<pane-id> <window>]}"; exit $?; }
    scan; exit $? ;;
  resume) resume; exit 0 ;;
  selfcheck) selfcheck; exit $? ;;
  check) ;;
  *) sed -n '2,15p' "$0" >&2; exit 2 ;;
esac
# ---- check: is_error / a run that produced no result (a non-zero rc), AND limit wording somewhere in result or stderr
j="${2:?usage: cc-limit check <claude-json> [<stderr-file>]}"; res=""
res=$(jq -r '[.result?, .error?, .subtype?] | map(select(type == "string")) | join(" ")' "$j" 2>/dev/null)
{ [ "$(jq -r '.is_error // empty' "$j" 2>/dev/null)" = true ] || [ -z "$res" ]; } || exit 1
txt="$res $(tail -c 4000 "${3:-/dev/null}" 2>/dev/null)"
# whose limit was it? the model family the message names, else the run's own main model (the modelUsage keys, minus
# the haiku side-call the CLI runs for titles: read off the json's first 2000 bytes that call came first, and the
# stamp of 2026-09-03 named haiku for a limit opus had hit)
newm=$(grep -oiE 'claude-(fable|opus|sonnet|haiku)[a-z0-9._-]*|\b(fable|opus|sonnet|haiku)\b' <<<"$txt" | head -1 | tr 'A-Z' 'a-z')
[ -n "$newm" ] || newm=$(jq -r '.modelUsage? // {} | keys[]?' "$j" 2>/dev/null | grep -iE 'fable|opus|sonnet' | head -1 | tr 'A-Z' 'a-z')
case "$newm" in *fable*) newm=fable;; *opus*) newm=opus;; *sonnet*) newm=sonnet;; *haiku*) newm=haiku;; *) newm="";; esac
# USAGE CREDITS ARE NOT A LIMIT. "Fable 5.1 requires usage credits" (2026-09-03, the account went Pro) and "You're out
# of usage credits" (2026-08-28) say one model cannot be run on this account: no reset lifts that, and the other
# models answer. Read as a limit, the first parked the whole box for 14 h on a model nobody else was using. So: no
# stamp, cc-model records the model as unavailable and moves the box off it, and the caller reads "not a limit"
# (exit 1) and walks the chain. Real limit wording beside it still wins: a limit hit with no credits left to
# continue on is a limit.
LIMIT_RE='usage limit|rate limit|rate_limit|429|too many requests|overloaded|resets? (at )?'
CREDITS_RE='usage credits|out of credits|insufficient credits'
if grep -qiE "$CREDITS_RE" <<<"$txt" && ! grep -qiE "$LIMIT_RE" <<<"$txt"; then
  why=$(jq -r '.result // "" | tostring' "$j" 2>/dev/null | head -1 | sed -E 's/(\. | · ).*//' | head -c 120)
  [ -n "$newm" ] && [ -x "$BIN/cc-model" ] && "$BIN/cc-model" unavailable "$newm" "$why" >/dev/null 2>&1
  exit 1
fi
grep -qiE "$LIMIT_RE" <<<"$txt" || exit 1
parse_reset "$txt"
# A SPEND CAP IS NOT LIFTED BY A RESET. "You've hit your monthly spend limit · raise it at claude.ai/settings/usage ·
# your weekly limit resets 10pm" (2026-09-09 06:41Z) names a reset, and it is the WEEKLY limit's — the cap it
# reports lifts when the owner raises it, and not before. Read as a limit until 10pm, it parked the planning seat
# for 14 h, three of them after the owner had raised it. So the reset in the text is discarded, the stamp takes
# the backoff below (the box re-probes, and clears itself the first time a call completes), the source says
# `spend-cap`, and the owner is told ONCE per episode that a cap only he can raise is what stopped the box.
SPEND_RE='spend(ing)? limit|spend cap|monthly (spend|usage) (limit|cap)'
cap=""; grep -qiE "$SPEND_RE" <<<"$txt" && cap=1
stamp; same=0; { [ "$first" -gt 0 ] && [ "$ends" -gt $((now - 900)) ]; } && same=1   # still the same limit episode
[ "$same" = 1 ] || first=$now
[ -n "$cap" ] && u=0   # the reset the message names is not this cap's lift
if [ "$u" -le "$now" ]; then   # no time in the message: exponential backoff, remembered in the stamp (5, 10, 20, 40, 60 min)
  b=5; [ "$same" = 1 ] && case "$src" in backoff:[0-9]*|spend-cap:[0-9]*) b=$(( ${src#*:} * 2 )); [ "$b" -gt 60 ] && b=60;; esac
  u=$((now + b * 60)); how="backoff:$b"; [ -n "$cap" ] && how="spend-cap:$b"
fi
if [ -n "$cap" ] && [ "$same" != 1 ] && [ -x "$BIN/cc-notify" ]; then
  "$BIN/cc-notify" -t "$(hostname -s) spend cap" \
    "The monthly spend cap stopped a run; no reset lifts it. Raise it at claude.ai/settings/usage and the box picks up on its next probe." >/dev/null
fi
[ -n "$newm" ] || newm="$mdl"   # same episode, a message that names no model: keep what we already knew
[ "$same" = 1 ] || obs=""       # a new episode: the runs on the old stamp saw a different limit and do not vouch for this one
obs=$(add_obs "$(mykey)")       # THIS run has now hit it — one observer binds this run alone, two make it the box's
mkdir -p "$(dirname "$S")"; printf '%s\t%s\t%s\t%s\t%s\n' "$u" "$how" "$first" "$newm" "$obs" > "$S"
# A limit on the box's primary model moves every session to the fallback (cc-model decides if it was) — but only once
# a SECOND run has hit the same limit. One worker's word moved every session for six hours on 2026-09-04.
[ "$(nobs)" -ge 2 ] && [ -n "$newm" ] && [ -x "$BIN/cc-model" ] && "$BIN/cc-model" limited "$newm" "$newm limit" >/dev/null 2>&1
scan >/dev/null 2>&1   # the same limit is on every session, not just this run: whatever it interrupted is nudged at the reset
echo "LIMIT $u"
