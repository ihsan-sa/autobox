#!/usr/bin/env bash
# cc-limit — LLM-free detection of Claude usage/rate limits, and one shared "wait until it resets" stamp.
#   cc-limit check <claude-json> [<stderr-file>] [<asked-model>]   prints "LIMIT <epoch>" + exit 0 when that run hit
#                      a limit, else exit 1. A run refused for USAGE CREDITS or by the MONTHLY SPEND CAP is exit 1 too:
#                      that is one model this account cannot run right now, not a limit — no stamp, nothing waits;
#                      cc-model is told it is unavailable, moves the work bound to it off it, and tells the owner once
#                      per episode what lifts it (see USAGE CREDITS below). <asked-model> is the model the run was
#                      dispatched on, for a message that names none (the cap line does) — cc-loop passes it.
#   cc-limit status    "usage limit until HH:MMZ (Nm left)" + exit 0 when the stamp binds THIS caller, else
#                      "clear" + exit 1 (with a note on stderr when a stamp exists that does not bind it, or when
#                      `cc-model status` answers within CC_LIMIT_MODEL_WAIT s, default 5, that a model is unavailable)
#   cc-limit wait      sleep until the stamp expires (exit 0); exit 1 if the wait would exceed CC_LIMIT_MAX_WAIT;
#                      exit 0 at once when the stamp does not bind this caller — there is nothing to wait for
#   cc-limit clear     forget it (every caller does this after a run that reached the API)
#   cc-limit record [--dry] [<pane|window-id> <window>]   note an INTERACTIVE session the limit interrupted (no
#                      args = every live session, answering with the best code it found). exit 0 = recorded ·
#                      2 = the pane IS sitting on the limit but this is not a record (nothing corroborates it yet,
#                      no reset time yet, or it was nudged inside the half hour) — a caller must not type there
#                      either · 1 = no limit line at all
#   cc-limit resume    nudge each recorded session whose reset has passed, ONCE, then forget it — ending a turn
#                      that never finished first (see A TURN THAT NEVER ENDED), publishing the episode for
#                      whoever else it killed (see WHAT ELSE THE LIMIT KILLED), and telling the owner in one
#                      line what the limit stalled and when it went again
#   cc-limit selfcheck the record/resume state machine, on stubs
# Stamp: ~/.cc/state/claude-limit = "<until-epoch>\t<source>\t<first-seen-epoch>\t<model-family>\t<observers>" — shared,
# so a second loop waits instead of burning its retries; the model is what cc-model needs to know whose limit it was
# (may be empty when the message names none); the observers are which RUNS have hit it (see below). No secrets in it.
# Env: CC_LIMIT_MAX_WAIT (default 21600 = 6 h)
# · CC_LIMIT_MIN_WAIT (test hook: cap any sleep at N seconds) · CC_LIMIT_STAMP (test hook: put the stamp somewhere
#   else, so a test limit never makes the box's real loops wait) · CC_LIMIT_OBSERVER (test hook: the key that says
#   which run this is; the run's cwd otherwise) · CC_LIMIT_RECORD · CC_LIMIT_NUDGED · CC_LIMIT_ARM
#   (test hook: what to arm with — it is called as `<seconds> <unit-name>`; "-" = arm nothing)
#   · CC_LIMIT_RESUMED (where the ended episode is published — see WHAT ELSE THE LIMIT KILLED) · CC_LIMIT_NOW
#   · CC_LIMIT_SETTLE (seconds between the Escape that ends a dead turn and the message typed after it)
#   · CC_LIMIT_BIN · CC_TMUX_SESSION.
#
# RESUMING AN INTERACTIVE SESSION. A headless worker parks and reruns itself at the reset; an interactive session just
# prints the limit line and sits at its prompt, and the turn it was in the middle of is lost until a human comes back.
# So: whoever notices the line (cc-reconcile's wake on its rounds, or `check` on the run that hit the same limit) calls `record`,
# which writes <pane-id, window, reset-epoch, episode-start, tags> to ~/.cc/state/limit-interrupted (the last two are
# the FIRST sighting's answers and are never revised — see record()) and arms a ONE-SHOT systemd-run timer at
# the reset — no new always-on unit. At the reset `resume` types one line into each recorded session through cc-msg
# (which owns the dialog guard and the "is anyone there" test) and forgets it. One nudge per record, ever: a session
# whose pane no longer shows the limit line moved on by itself and is skipped, and a record whose reset has moved out
# is rescheduled rather than sent early, and a pane nudged in the last half hour is not recorded again — the limit
# line stays on its screen after it comes back, and a stale line must not buy a second nudge.
# A TURN THAT NEVER ENDED. 2026-09-05 09:05Z a planning session took the 429 INSIDE a turn, and that turn never
# finished: the limit lifted at 11:10Z and the session was still sitting in it at 16:26Z, when a person restarted
# it. The model switch, the 12:54Z pulse and every lander event were spooled behind it, undelivered. A nudge
# alone does not reach such a session — nothing can be typed at a pane that is mid-turn, so the nudge spools too.
# So `resume` presses Escape first, and ONLY at a due record that was mid-turn when it was RECORDED (`working` in
# field 5) and is still mid-turn now. Both halves, because the ordinary 429 does end the turn: cc-msg's drain then
# types the spooled lines at the freed pane, a new turn starts, and the stale limit line is still on screen at the
# reset — on the footer alone Escape would kill that live turn mid-tool-call (review of #264). cc-msg must never
# interrupt a turn by accident; this one is deliberate and narrow. cc-msg spools before it types, so whatever
# queued behind the dead turn goes in first, in order, and the nudge last.
# A RECORD IS NOT ALWAYS A SECOND WITNESS. cc-model counts a record as the second run that hit a limit, which is
# what makes the switch follow the stamp instead of an hour-late pane scan. But record() corroborates a pane's
# line with that same stamp, so a one-observer stamp plus any pane still showing THIS MORNING'S limit wording
# would be two witnesses that are really one (review of #264) — the 2026-09-04 regression the two-observer rule
# exists to stop. So a record is tagged `indep` only when this pane's limit LINE was first seen at or after the
# stamp's own first-seen, i.e. inside the current episode; cc-model counts only those, and everything else still
# needs two observers on the stamp. first_seen() is keyed on the LINE, so two episodes whose message reads exactly
# alike inside a day share one sighting and the second gets no tag — what that gives back is the old answer (two
# observers, or the pane scan), which is the safe way for this to be wrong.
# WHAT ELSE THE LIMIT KILLED. A nudge puts a SESSION back on its work; the subagents it had out when the 429 came
# are gone, and the board rows they were working still carry the `agent` mark that says somebody is doing them.
# That mark holds a row for six hours (cc-reconcile mark_why), so a row whose subagent died at
# 09:05Z on 2026-09-05 stayed in flight until six hours after its mark was written — nearly four hours after the
# limit had lifted, offered to nobody the whole time. So `resume` publishes the episode
# it just ended to ~/.cc/state/limit-resumed, "<started>\t<reset>\t<resumed>", one line, latest episode wins.
# THE BAR IS THE START, NOT THE RESET (review of #264). The box does not stop for the episode — cc-model moves
# every session to the fallback about a minute after the stamp — so a mark made between the switch and the reset
# belongs to a subagent that is alive and working, and judging it by the reset would offer a row that is in
# flight. A mark older than the START is the one that cannot have survived: it was made before the 429 that killed
# the subagent holding it. Both readers treat such a mark as cold whatever its age, and the row is offered again.
# The session that IS still on the row says so by marking again, exactly as it does for the six-hour bound.
# An episode nobody recorded publishes nothing — `resume` is armed by `record` — and neither does one whose
# records do not all carry a start: a guessed start would call live rows dead, and the six-hour bound still covers
# them, as it did before.
# UNDER TIER STOP (`cc-tier allows continue` exit 1) `resume` nudges nobody and ends no turn: a session carrying on at
# the reset is what stop holds. Every record stays on file and the one-shot is armed again STOP_RECHECK s out (15 min),
# so the nudges go on the first round after the tier lifts — to panes that still show the line, as ever.
# ONE RUN'S LIMIT IS NOT THE BOX'S. On 2026-09-04 at 09:13:29Z one headless worker was told "usage limit until
# 06:00Z" and exited. That stamped the box: `status` read "usage limit until 06:00Z (898m left)" and every session
# believed it for six hours, while opus went on answering (the spend ledger has successful rows at 14:54, 14:55 and
# 14:59Z from three different sessions). A person ended it, as they had three times on 09-03. So the stamp now says
# WHO hit it, and two things read that:
#   The OBSERVERS. `check` adds the run's own key (an md5 of its cwd — one per worktree, so one per worker) to the
#   stamp. One observer = the limit binds that run alone: it parks and reruns itself exactly as before, and every
#   other caller reads `clear`. Two = account-wide, and the box parks exactly as it does today. A real account-wide
#   limit confirms itself on the very next run that tries, and the one attempt that costs is rejected outright, so
#   it burns no reset — which is the asymmetry to hold: believing a limit wrongly costs a day of work.
#   THE ACCOUNT ANSWERING. A limit that two runs hit can still be wrong. cc-spend's ledger records every call this
#   box makes — and, since 2026-09-22, the hosted tutor's chats too, which run on the TUTOR's account and prove
#   nothing about this one, so rows on the `tutor` track are not read here. A stamp is dropped outright once TWO
#   different sessions of this box's own have completed calls (on the limited
#   model's family, or any family when the stamp names none) more than five minutes (GRACE) past the moment it
#   was first seen: nothing answers under a real account-wide limit. Dropping it pushes the owner one line, once per episode
#   — six hours of dead box against a working account must not happen again without somebody being told.
# A pane line alone is not proof — this box's own docs and briefs say "usage limit" too — so a record needs the line
# AND corroboration: the shared stamp is live, or cc-model itself judged a limit recently — a live
# ~/.cc/state/model-override, or a switch in ~/.cc/state/model.log inside the last 6 h. Both files are cc-model's;
# this reads them and writes neither. The hashes in ~/.cc/state/model-seen are NOT corroboration: cc-model banks one
# for every probe it adjudicated, "was not a live limit" included.
set -uo pipefail
SELF=$(readlink -f "$0")
BIN="${CC_LIMIT_BIN:-$(dirname "$SELF")}"   # siblings come from the same bin/ as this copy
S="${CC_LIMIT_STAMP:-$HOME/.cc/state/claude-limit}"; MAX="${CC_LIMIT_MAX_WAIT:-21600}"
REC="${CC_LIMIT_RECORD:-$HOME/.cc/state/limit-interrupted}"
NUDGED="${CC_LIMIT_NUDGED:-$HOME/.cc/state/limit-nudged}"; QUIET=1800   # see nudged_recently
RESUMED="${CC_LIMIT_RESUMED:-$HOME/.cc/state/limit-resumed}"   # see WHAT ELSE THE LIMIT KILLED
SEEN="${CC_LIMIT_SEEN:-$HOME/.cc/state/limit-seen}"; JUDGE=3600         # see first_seen: how long an uncorroborated line stays "not judged yet"
STOP_RECHECK=900   # see UNDER TIER STOP
DISB="$S.disbelieved"; GRACE=300   # see answering: how long after a limit was first seen a completed call disproves it
now="${CC_LIMIT_NOW:-$(date -u +%s)}"; DRY=""
# What a session shows when the limit stopped it. Tighter than cc-model's (which only decides which MODEL to use):
# this one ends in a message typed at a human's session, so prose that merely mentions limits must not match.
PANE_RE='usage limit reached|out of usage credits|limit will reset|limit reached.*reset'
TAIL=15   # the pane's LAST 15 visible lines (capture-pane piped through tail). A session STOPPED by the limit
          # shows that line just above its input box; higher up may be anything — including a file that quotes
          # the wording. Narrow beats clever: the window is read again at the reset, before anything is typed.
WORK_MARK='esc to interrupt'      # Claude Code's footer for the whole of a turn (cc-msg, cc-reconcile and cc-started read the same)
SETTLE="${CC_LIMIT_SETTLE:-2}"    # after the Escape that ends a dead turn, before cc-msg reads that pane
stamp(){   # the shared stamp's five fields. Split by awk and NOT by `IFS=$'\t' read`: tab is IFS WHITESPACE, so bash
           # folds "\t\t" into one delimiter — and the stamp of 2026-09-04 named no model, so its empty field 4 slid
           # the observers into $mdl and the run that hit the limit could not find its own key.
  ends=0; src=""; first=0; mdl=""; obs=""
  [ -f "$S" ] && { IFS= read -r ends; IFS= read -r src; IFS= read -r first; IFS= read -r mdl; IFS= read -r obs; } \
    < <(awk -F'\t' 'NR==1{for (i = 1; i <= 5; i++) print $i}' "$S")
  [[ "$ends" =~ ^[0-9]+$ ]] || ends=0; [[ "$first" =~ ^[0-9]+$ ]] || first=0; }

# ---- whose limit is it? (see "ONE RUN'S LIMIT IS NOT THE BOX'S" above)
mykey(){   # which RUN this is. The cwd, because that is one per worktree and so one per worker — the unit the
           # incident was about ("one headless worker on this repo"). Hashed to keep paths out of a shared file.
  printf '%s' "${CC_LIMIT_OBSERVER:-$PWD}" | md5sum | cut -c1-8; }
obs_list(){ tr ',' '\n' <<<"${obs:-}" | grep -x '[0-9a-f]\{8\}'; }   # the stamp's observers, one per line (none = no output)
nobs(){ obs_list | grep -c . || true; }                              # how many distinct runs have hit it
add_obs(){   # $1 = a key -> the observer list with $1 on the end, oldest dropped past four
  { obs_list | grep -vx "$1"; echo "$1"; } | tail -4 | paste -sd, -; }

answering(){   # Is the ACCOUNT answering, this long after the stamp was first seen? Then no limit it names is
               # account-wide, whoever wrote it. cc-spend's ledger is every call this box completed — plus the
               # hosted tutor's, made on the tutor's own account (sandbox.gaps() refuses this box's login), so
               # the `tutor` track is skipped: two student chats are not this account answering. The rows:
               # ~/.cc/state/spend/<day>.tsv, "<ts> <session> <cwd> <repo> <track> <kind> <model> …", ts in UTC
               # ISO seconds — the resolution it is compared at, so a row ON the cutoff second is not past it.
               # TWO different sessions, not one: a person can go on answering a real limit out of usage credits,
               # and believing a limit wrongly costs a day of work while disbelieving one wrongly costs a reset.
  local cutoff day f
  stamp; [ "$first" -gt 0 ] || return 1
  cutoff=$(date -u -d "@$((first + GRACE))" +%Y-%m-%dT%H:%M:%SZ)
  # EVERY calendar day the stamp has lived through, first seen to now: reading only those two days left a limit
  # first seen late on day 1 with a reset a week out (the weekly one cc-land anticipates) believed on day 3 while
  # day 2's rows disproved it (review of #215).
  day=$(date -u -d "$(date -u -d "@$first" +%F)" +%s)   # midnight UTC of the day it was first seen
  while [ "$day" -le "$now" ]; do
    f="$HOME/.cc/state/spend/$(date -u -d "@$day" +%F).tsv"; [ -f "$f" ] && cat "$f"
    day=$((day + 86400))
  done | awk -F'\t' -v cutoff="$cutoff" -v fam="${mdl:-}" '
      $1 !~ /^#/ && $1 > cutoff && $5 != "tutor" && $7 ~ fam { seen[$2] = 1 }   # fam empty = the stamp named no model = any row
      END { exit !(length(seen) >= 2) }'; }

disbelieve(){   # drop a stamp the account has plainly outlived — ONCE per episode, marked in $DISB. Routine and
                # automatic: no owner post (a debugging engineer reads $DISB's timestamp), the cure for every one
                # of these used to be a person noticing, four times in two days.
  local was="$first"
  rm -f "$S"; ends=0
  [ "$(cat "$DISB" 2>/dev/null)" = "$was" ] && return 0
  mkdir -p "$(dirname "$DISB")"; printf '%s\n' "$was" > "$DISB"
  return 0; }

believe(){   # exit 0 = the live stamp binds THIS caller, and stamp()'s variables are loaded. The one gate `status`
             # and `wait` share, so no caller has to know the rule.
  stamp
  [ "$ends" -gt "$now" ] || return 1
  answering && { disbelieve; return 1; }
  [ "$(nobs)" -ge 2 ] && return 0            # two runs hit it: account-wide, and the box parks as it always has
  obs_list | grep -qx "$(mykey)"; }          # one run: it binds that run, and nobody else

parse_reset(){   # a reset time named anywhere in $1 -> $u (epoch; 0 = the message named none) and $how (how it was read)
  local txt="$1" m c d y yn n rest zc tz=UTC
  local RS='reset[a-z]*[^0-9]{0,8}'   # "resets at ", "reset: ", "resets " — a bare timestamp in a log line must not count
  local MON='(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?' ORD='(st|nd|rd|th)?'
  local YR='(19|20)[0-9]{2}' CLK='([0-9]{1,2}(:[0-9]{2})? *(am|pm)|[0-9]{1,2}:[0-9]{2})' DAY
  DAY="(${MON} +[0-9]{1,2}${ORD}|[0-9]{1,2}${ORD} +${MON})"   # "Sep 7" and "7 Sep": both orderings get written
  local AHEAD=1209600   # a fortnight. No usage limit on this account has ever run longer than a week.
  # THE ZONE THE MESSAGE NAMES: the first Area/City that IS a zone, not the first thing in the text with a slash in
  # it. A limit message carries a URL as well ("…claude.ai/settings/usage?from=cc_cli_limit_message"), and taking
  # the first match handed "ai/settings" to the zonefile test, missed, and left the clock being read as UTC. Two-
  # and three-segment names both match whole; a zone buried deeper inside a path is not dug for, because no
  # message has ever carried one that way.
  while read -r zc; do
    [ -f "/usr/share/zoneinfo/$zc" ] && { tz="$zc"; break; }
  done < <(grep -oE '[A-Za-z][A-Za-z_]*/[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)?' <<<"$txt")
  u=0; how=""; rolled=0
  if m=$(grep -oiE "${RS}[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:?[0-9]{2})?" <<<"$txt" | head -1) && [ -n "$m" ]; then
    u=$(TZ="$tz" date -d "$(grep -oE '[0-9]{4}-.*' <<<"$m")" +%s 2>/dev/null); how=iso
  elif m=$(grep -oiE 'reset[a-z]* in +[0-9]+ *[a-z]+' <<<"$txt" | head -1) && [ -n "$m" ]; then
    n=$(grep -oE '[0-9]+' <<<"$m"); case "$(grep -oiE '[a-z]+$' <<<"$m" | tr A-Z a-z)" in
      h*) u=$((now + n * 3600));; s*) u=$((now + n));; *) u=$((now + n * 60));; esac; how=in
  # A DAY AND A CLOCK, IN EITHER ORDER — "resets Sep 7, 10am (America/Los_Angeles)", "resets at 10am on Sep 7",
  # "resets 7 Sep, 10am". The clock branch below takes the first number after "reset" for an hour, so it read the
  # DAY, 7, and parked the box at 07:00 Los Angeles instead of 10:00 — three hours early, on a weekly limit that
  # stood for days (2026-09-03). The day is cut back out of the match before the clock is looked for, so its
  # number can never be mistaken for an hour whichever way round the two were written.
  elif m=$(grep -oiE "reset[a-z]*[^0-9A-Za-z]{0,3}((on +|at +)?${DAY},? *(${YR})?,? *(at +)?${CLK}?|(at +)?${CLK},? +(on +)?${DAY},? *(${YR})?)" <<<"$txt" | head -1) && [ -n "$m" ]; then
    d=$(grep -oiE "$DAY" <<<"$m" | head -1)
    rest=${m/"$d"/}                                          # …the day taken back out
    d=$(sed -E 's/([0-9]+)(st|nd|rd|th)/\1/Ig; s/\.//g' <<<"$d")   # "Sept. 7th" is no date to date(1); "Sept 7" is
    c=$(grep -oiE "$CLK" <<<"$rest" | head -1)
    yn=$(TZ="$tz" date -d "@$now" +%Y)                       # the year the BOX is in, so a test clock moves it too
    y=$(grep -oE "$YR" <<<"$rest" | head -1)
    u=$(TZ="$tz" date -d "$d ${y:-$yn} ${c:-00:00}" +%s 2>/dev/null)   # no clock named = the start of that day
    # A day already gone by is next year's — but only when next year's lands inside the fortnight ("resets Jan 2",
    # read on Dec 31). A year the message names itself is taken as written and never rolled.
    if [ -z "$y" ] && [ "${u:-0}" -gt 0 ] && [ "$u" -le "$now" ]; then
      n=$(TZ="$tz" date -d "$d $((yn + 1)) ${c:-00:00}" +%s 2>/dev/null)
      { [ -n "$n" ] && [ "$n" -gt "$now" ] && [ "$n" -lt $((now + AHEAD)) ]; } && { u="$n"; rolled=1; }
    fi
    # …and a day landing further out than that is not a reset at all. "resets Dec 31" read on Jan 3 is this
    # December, "Sep 7 2077" is fifty years — both misreads, and the caller only ever guards against the past, so
    # either would park the box for good. u=0 hands it to the backoff, which is the safe read of a garbled day.
    [ "${u:-0}" -gt $((now + AHEAD)) ] && u=0
    how='date'
  elif m=$(grep -oiE "${RS}[0-9]{1,2}(:[0-9]{2})? *(am|pm)?" <<<"$txt" | head -1) && [ -n "$m" ]; then
    c=$(grep -oiE '[0-9]{1,2}(:[0-9]{2})? *(am|pm)?$' <<<"$m")
    u=$(TZ="$tz" date -d "$c" +%s 2>/dev/null)                                        # a clock time
    [ -n "$u" ] && [ "$u" -le "$now" ] && { u=$(TZ="$tz" date -d "tomorrow $c" +%s 2>/dev/null); rolled=1; }   # …already past today = tomorrow
    how="at"
  fi
  [[ "${u:-0}" =~ ^[0-9]+$ ]] || u=0; }

# ---- interactive sessions: record what the limit interrupted, nudge it once when the limit lifts
corroborated(){   # $1 pane, $2 window (unused — kept for the callers). The stamp is live, or cc-model itself
                  # JUDGED a limit recently: a live override, or a `switch` in model.log (the only event it writes
                  # that means "a limit moved this box"). model-seen is NOT proof — cc-model banks that hash for
                  # every probe that DECIDED, including "was not a live limit" (review of #171).
  stamp; [ "$ends" -gt "$now" ] && return 0
  [ -s "$HOME/.cc/state/model-override" ] && return 0
  awk -F'\t' -v c=$((now - 21600)) '$3=="switch" && ($2+0)>c{f=1} END{exit !f}' \
    "$HOME/.cc/state/model.log" 2>/dev/null; }

first_seen(){   # $1 pane, $2 the limit line -> the epoch THIS sighting of THAT line was first seen (stamped on first
                # sight, not in --dry). It bounds the window in which nothing corroborates the line yet: cc-model
                # needs up to a minute to judge a live limit, not for ever — an old episode's wording, or a pane
                # merely SHOWING the words, would otherwise keep the pulse away from that session for good
                # (review-171b).
                # KEYED ON THE LINE, not the pane alone. A row per pane, kept for ever, expires that pane's window
                # permanently: a pane that showed the wording on Monday is read as old news when the limit really
                # stops it on Wednesday, so record answers 1 and the pulse types at a limited session (review of
                # #171). Ageing the row out instead would re-open the window for a line that never left the screen,
                # which is the case review-171b closed. The line's own text separates the two: a new limit prints a
                # new line, and that is a new sighting with its own hour. Rows older than a day are dropped on the
                # way through, the way note_nudge prunes its own.
  local k t
  k="$1:$(printf '%s' "$2" | md5sum | cut -c1-16)"
  t=$(awk -F'\t' -v k="$k" '$1==k{print $2+0; exit}' "$SEEN" 2>/dev/null)
  if [ -z "$t" ]; then
    t=$now
    [ -n "$DRY" ] || { mkdir -p "$(dirname "$SEEN")"
      { [ -f "$SEEN" ] && awk -F'\t' -v k="$k" -v c=$((now - 86400)) '$1!=k && ($2+0)>c' "$SEEN"
        printf '%s\t%s\n' "$k" "$now"; } > "$SEEN.t"; mv "$SEEN.t" "$SEEN"; }
  fi
  echo "$t"; }
nudged_recently(){   # $1 pane. The limit line does not leave the pane when the session comes back, so the SAME stale
                    # line would be read as a fresh interruption on the next round and buy a second nudge. One nudge
                    # per pane per half hour, then; a genuine new limit is hours away, far outside this window.
  local t; t=$(awk -F'\t' -v p="$1" '$1==p{print $2+0; exit}' "$NUDGED" 2>/dev/null)
  [ "${t:-0}" -gt $((now - QUIET)) ]; }

note_nudge(){   # $1 pane; entries older than a day are dropped on the way through
  mkdir -p "$(dirname "$NUDGED")"
  { [ -f "$NUDGED" ] && awk -F'\t' -v p="$1" -v c=$((now - 86400)) '$1!=p && ($2+0)>c' "$NUDGED"
    printf '%s\t%s\n' "$1" "$now"; } > "$NUDGED.t"; mv "$NUDGED.t" "$NUDGED"; }

arm(){   # $1 = the soonest it may fire, in seconds (default 15). One-shot at the earliest reset still on file. NOT a unit that lives on the box: systemd-run makes a transient
         # timer that fires once and disposes of itself, so a box with nothing recorded runs nothing.
  local at secs real unit mine u
  at=$(awk -F'\t' '($3+0)>0 && (m==0 || ($3+0)<m){m=$3+0} END{print m+0}' "$REC" 2>/dev/null)
  [ "${at:-0}" -gt 0 ] || return 0
  secs=$((at - now + 15)); [ "$secs" -lt "${1:-15}" ] && secs="${1:-15}"   # a few seconds past the reset: the limit lifts on their clock
  unit="cc-limit-resume-$at"   # ONE TRANSIENT UNIT PER RESET TIME — see the sweep below for why the name must differ
  if [ -n "${CC_LIMIT_ARM:-}" ]; then [ "$CC_LIMIT_ARM" = - ] || "$CC_LIMIT_ARM" "$secs" "$unit" >/dev/null 2>&1; return 0; fi
  real=$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6)
  { [ -n "$real" ] && [ "$HOME" != "$real" ]; } && return 0   # a test HOME never arms a timer on the real box
  command -v systemd-run >/dev/null 2>&1 || return 0
  # Clear the arming this one supersedes — but NEVER the unit this process is running under. `resume` re-arms
  # whatever it left on file, and when resume IS the one-shot, stopping its own unit SIGTERMs the whole cgroup,
  # which is this shell: the systemd-run below would never run and every record still on file would lose its timer
  # (review of #171). The names cannot collide — an arming is always for a reset in the future, and ours has fired.
  mine=$(grep -oE 'cc-limit-resume-[0-9]+\.service' /proc/self/cgroup 2>/dev/null | tail -1)
  for u in $(systemctl --user list-units --all --plain --no-legend 'cc-limit-resume-*' 2>/dev/null | awk '{print $1}'); do
    case "$u" in "$mine" | "${mine%.service}.timer") continue ;; esac
    systemctl --user stop "$u" >/dev/null 2>&1; systemctl --user reset-failed "$u" >/dev/null 2>&1
  done
  systemd-run --user --quiet --unit="$unit" --on-active="${secs}s" --timer-property=AccuracySec=5 \
    "$SELF" resume >/dev/null 2>&1 || true; }

record(){   # $1 pane id, or a window id/name to resolve  $2 window name
            # exit 0 = recorded · 2 = the pane is on the limit, this is not a record · 1 = no limit line there
  # `u` and `how` are LOCAL because parse_reset writes them as globals: `check` parses its own reset, then calls
  # scan -> record at the end, and without this line that record's parse_reset overwrites the epoch check is about
  # to print — "LIMIT 0", and the owner is told the limit resumes at 00:00Z (review of #171).
  local pane="$1" win="$2" cap line at old p u how rolled from_pane=0
  # A window id or a window name is accepted and resolved to the PANE id first: the record is keyed on the pane, so
  # cc-reconcile's wake (which holds window ids) and scan (which holds pane ids) write one record for a session, not two — and
  # two records for one session is two nudges.
  p=$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null | head -1); case "$p" in %[0-9]*) pane="$p";; esac
  cap=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$TAIL")   # the LAST lines: -S sets a history start, it does not bound the read
  line=$(grep -iE "$PANE_RE" <<<"$cap" | tail -1); [ -n "$line" ] || return 1
  # Past this line the pane IS sitting on the limit, and every "no" below is exit 2, not 1: a caller that read a
  # plain failure as "nothing wrong here" would type at a limited session, which is what the wake must not do.
  nudged_recently "$pane" && return 2
  if ! corroborated "$cap" "$win"; then
    # Nothing corroborates the line. For its first hour that means "cc-model has not judged it yet" — exit 2, no
    # tick. After that it is scrollback (an episode hours old, or a pane just showing the words) and the pane is
    # safe to tick: exit 1. Left open-ended, exit 2 stopped the pulse waking that session for good (review-171b).
    [ $((now - $(first_seen "$pane" "$line"))) -lt "$JUDGE" ] && return 2
    return 1
  fi
  # A reset the stamp only GUESSED is not a reset. `check` writes src=backoff:N when the message named no time, and
  # a nudge at that guess reaches a session that is still limited — and spends the one nudge that was owed at the
  # real time. So a backoff stamp is passed over and the pane's own wording is read instead.
  stamp; at=0; case "$src" in backoff:*) ;; *) [ "$ends" -gt "$now" ] && at="$ends";; esac
  if [ "$at" = 0 ]; then
    parse_reset "$cap"; from_pane=1
    # A clock time the pane names that is already past is NOT tomorrow's. parse_reset rolls it over because `check`
    # hands it a fresh message; a screen is of unknown age, and the rollover recorded a session for a day out
    # (review-171c). So the rollover is never recorded — and a record already on file stays exactly where it is.
    # …and a pane whose ONLY named reset is already past is safe to type at: exit 1, not 2 — exit 2 kept the pulse away
    # from that session for hours after its limit had lifted (review-171e). A record already on file stays where it is.
    [ "${rolled:-0}" = 1 ] && return 1
    [ "$u" -gt "$now" ] && at="$u"
  fi
  [ "$at" -gt "$now" ] || return 2   # limited, but no reset time yet: whoever looks next records it once there is one
  old=0; [ -f "$REC" ] && old=$(awk -F'\t' -v p="$pane" '$1==p{print $3+0; exit}' "$REC")
  # A pane re-read never moves a record out: its line is stale text, and "in 30 minutes" is 30 minutes from whenever
  # it is read — every round pushed the record past its own due time and the nudge was never sent (review-171c).
  # Only a live stamp, a reset the API itself named, moves an existing record — and never shorter.
  [ "$from_pane" = 1 ] && [ "${old:-0}" -gt 0 ] && at="$old"
  [ "${old:-0}" -gt "$at" ] && at="$old"   # one record per pane, and a record is never shortened
  # FIELDS 4 AND 5 ARE WRITTEN ONCE, BY THE FIRST SIGHTING, and a later read never revises them: both answer a
  # question about the MOMENT the limit stopped this session, and a pane re-read minutes later is a different moment.
  # · started — the stamp's first-seen ($first), which is when this episode began. `resume` publishes it, and both
  #   readers call an `agent` mark cold only if it predates it: see WHAT ELSE THE LIMIT KILLED.
  # · tags — `working` if the pane was mid-turn when it was recorded (see A TURN THAT NEVER ENDED: resume presses
  #   Escape only at a turn that was already running then), and `indep` if this pane's limit LINE was first seen at
  #   or after $first, i.e. inside this episode (see A RECORD IS NOT ALWAYS A SECOND WITNESS).
  local started tags="" seen_at
  grep -qF "$WORK_MARK" <<<"$cap" && tags=working
  seen_at=$(first_seen "$pane" "$line")   # stamps the line on first sight, exactly as the uncorroborated branch does
  # The stamp's first-seen is the box's own answer to "when did this episode begin". Where there is no stamp —
  # corroborated by a model-override or a `switch` cc-model wrote — this pane's own line is: it went up when this
  # session took its 429, which is the moment its subagents died.
  started="$first"; [ "$started" -le 0 ] && started="$seen_at"
  # …and `indep` needs a stamp to be independent OF: cc-model's rule is about a stamp with one observer on it, and
  # a sighting inside that episode is the second witness. No stamp, no claim — cc-model wants a live one anyway.
  [ "$first" -gt 0 ] && [ "$seen_at" -ge "$first" ] && tags="${tags:+$tags,}indep"
  if [ -f "$REC" ]; then   # an existing record's own first sighting stands
    # Split by LINE, not by `IFS=$'\t' read`: tab is IFS whitespace, so an empty tags field would fold away and
    # slide nothing into $ot — the same trap the stamp's empty model field sprang on 2026-09-04.
    local os="" ot=""
    { IFS= read -r os; IFS= read -r ot; } < <(awk -F'\t' -v p="$pane" '$1==p{print $4+0; print $5; exit}' "$REC")
    [ "${os:-0}" != 0 ] && { started="$os"; tags="$ot"; }
  fi
  [ -n "$DRY" ] && { printf 'would record %s (%s) until %sZ\n' "$win" "$pane" "$(date -u -d "@$at" +%H:%M)"; return 0; }
  mkdir -p "$(dirname "$REC")"
  { [ -f "$REC" ] && awk -F'\t' -v p="$pane" '$1!=p' "$REC"
    printf '%s\t%s\t%s\t%s\t%s\n' "$pane" "$win" "$at" "$started" "$tags"; } > "$REC.t"
  mv "$REC.t" "$REC"; arm
  printf 'recorded %s (%s) until %sZ\n' "$win" "$pane" "$(date -u -d "@$at" +%H:%M)"; }

live_claude(){   # is there an interactive `claude` ANYWHERE under pane pid $1? The DIRECT-child test was wrong here in
                 # the one case that matters: a `cc-handoff --overlap` successor runs `bash -c '… cc __runnext …'`,
                 # so its claude is a GRANDCHILD, and calling that session dead is never recording the very session
                 # this file exists to rescue (review of #171). Same subtree walk cc-msg and cc-reconcile make; `-p` is
                 # excluded because a headless worker parks and reruns itself and has no prompt to type into.
  local pid
  for pid in $(ps -eo pid=,ppid=,comm= | awk -v root="${1:-0}" '
        { kids[$2] = kids[$2] " " $1; name[$1] = $3 }
        END { q[1] = root; n = 1                                     # breadth-first over the pane subtree
              for (i = 1; i <= n; i++) { m = split(kids[q[i]], c, " "); for (j = 1; j <= m; j++) q[++n] = c[j] }
              for (i = 2; i <= n; i++) if (name[q[i]] == "claude") print q[i] }'); do
    tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null | grep -qx -e '-p' -e '--print' || return 0
  done
  return 1; }

scan(){   # every live INTERACTIVE session under this tmux session
  local id pp name rc=1 r
  while read -r id pp name; do
    [ -n "${pp:-}" ] || continue
    live_claude "$pp" || continue
    pgrep -P "$pp" -f cc-loop >/dev/null 2>&1 && continue   # a headless worker's pane: it parks and reruns itself
    record "$id" "$name"; r=$?
    case "$r" in 0) rc=0 ;; 2) [ "$rc" = 1 ] && rc=2 ;; esac   # the best of what it found, so the whole-box form
  done < <(tmux list-panes -s -t "${CC_TMUX_SESSION:-main}" -F '#{pane_id} #{pane_pid} #{window_name}' 2>/dev/null)
  return "$rc"; }                                             # answers in the same three codes as one pane does

resume(){   # everything due, once each; everything not due, left exactly where it was
  [ -s "$REC" ] || return 0
  "$BIN/cc-tier" allows continue >/dev/null 2>&1
  if [ $? = 1 ]; then printf 'the spend tier is stop: nobody nudged, %s record(s) kept\n' "$(grep -c . "$REC")"
    arm "$STOP_RECHECK"; return 0; fi
  local pane win at started tags cap keep="" due=0 began=0 began_ok=1
  # Five fields since the review of #264 — see record(). A record written before that has three, and every "no"
  # below is the safe answer for it: no start (the episode is not published at all) and no `working` (no Escape).
  while IFS=$'\t' read -r pane win at started tags; do
    { [ -n "${pane:-}" ] && [[ "${at:-}" =~ ^[0-9]+$ ]]; } || continue
    started="${started:-0}"; [[ "$started" =~ ^[0-9]+$ ]] || started=0; tags="${tags:-}"
    if [ "$at" -gt "$now" ]; then keep+="$pane	$win	$at	$started	$tags"$'\n'; continue; fi   # nothing is sent before the reset
    stamp
    if [ "$ends" -gt "$now" ]; then keep+="$pane	$win	$ends	$started	$tags"$'\n'   # the limit moved out: wait for the new time
      printf '%s: reset moved to %sZ — not nudged\n' "$win" "$(date -u -d "@$ends" +%H:%M)"; continue; fi
    # Past here this record's limit really is over — the reset has passed and no live stamp moved it out. The
    # LATEST such reset is the episode, nudge or no nudge: see WHAT ELSE THE LIMIT KILLED below.
    [ "$at" -gt "$due" ] && due="$at"
    # …and the EARLIEST start, because that is the bar a mark is judged against and the earliest one calls the
    # fewest marks dead. A due record that carries no start at all makes the episode unpublishable rather than
    # guessed: the whole rule is that a mark predating the start is dead, and a wrong start kills live rows.
    if [ "$started" -gt 0 ]; then { [ "$began" = 0 ] || [ "$started" -lt "$began" ]; } && began="$started"
    else began_ok=0; fi
    cap=$(tmux capture-pane -p -t "$pane" 2>/dev/null | tail -n "$TAIL")   # same bounded read as record()
    grep -qiE "$PANE_RE" <<<"$cap" || { printf '%s: moved on already — no nudge\n' "$win"; continue; }
    # "a session whose pane still shows a limit error after the reset is kicked (the turn ended, the queued input
    # delivered)". The turn that took the 429 does not end by itself — see A TURN THAT NEVER ENDED — and while it
    # runs, cc-msg spools instead of typing, so the nudge below would join everything else already stuck behind it.
    # Escape only HERE, and only for a turn that was ALREADY RUNNING when the record was written (`working` in
    # field 5). Review of #264: when the 429 did end the turn — the ordinary case — cc-msg's drain types the
    # spooled lines at the freed pane and the session starts a NEW turn, and the stale limit line is still on
    # screen at the reset, so "limit line + footer" alone would Escape a live turn mid-tool-call. Both halves,
    # then: mid-turn when it was recorded AND mid-turn now. Nothing is pressed at any other pane.
    if [[ ",$tags," == *,working,* ]] && grep -qF "$WORK_MARK" <<<"$cap"; then
      tmux send-keys -t "$pane" Escape >/dev/null 2>&1
      sleep "$SETTLE"   # the pane needs to redraw before cc-msg reads it, or it judges the turn still running
      printf '%s: still mid-turn at the reset — ended it\n' "$win"
    fi
    # Dropped whether or not cc-msg got through. A nudge is worth one try: retrying is how a session behind a dialog
    # gets typed at over and over, and the pulse still comes round.
    note_nudge "$pane"   # before the send, and whether or not it lands: one try is one try
    if "$BIN/cc-msg" "$win" "usage limit lifted at $(date -d "@$at" +%H:%M) — continue the turn you were on; your journal and board say where you were" </dev/null >/dev/null 2>&1
    then printf '%s: nudged\n' "$win"
    else printf '%s: cc-msg would not type there — dropped, not retried\n' "$win"; fi
  done < "$REC"
  # See WHAT ELSE THE LIMIT KILLED: the subagents this episode took with it are found by their marks predating
  # its START. Written whether or not a nudge landed — a pane that moved on by itself still lost them.
  [ "$due" -gt 0 ] && [ "$began_ok" = 1 ] && [ "$began" -gt 0 ] \
    && { mkdir -p "$(dirname "$RESUMED")"; printf '%s\t%s\t%s\n' "$began" "$due" "$now" > "$RESUMED"; }
  # No owner post: automatic resume is routine (comms review, 2026-09-22). $RESUMED above is the record —
  # cc-reconcile's digest and a debugging engineer read it; the nudge into each session above is the delivery.
  if [ -n "$keep" ]; then printf '%s' "$keep" > "$REC"; arm; else rm -f "$REC"; fi; }

selfcheck(){   # the cases are tests/selfcheck/cc-limit.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-limit.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  clear) rm -f "$S" "$DISB"; exit 0 ;;
  status) if ! believe; then echo clear
      # …and a model the account cannot run right now (usage credits, the spend cap) is not a limit and holds nobody,
      # but a person reading `status` should still hear it — stderr, so a caller's "clear" is unchanged.
      # Asked ONCE and for at most CC_LIMIT_MODEL_WAIT s (default 5): under load a bare `cc-model status` did not
      # return in 400 s and 48 `cc-limit status` piled up behind a note. Its answer goes to a file, not a pipe, so a
      # child it leaves behind cannot hold this open after `timeout` has ended it; no answer in time is no note.
      mst=$(mktemp) || mst=/dev/null
      mrc=1; [ -x "$BIN/cc-model" ] && { timeout -k 1 "${CC_LIMIT_MODEL_WAIT:-5}" "$BIN/cc-model" status >"$mst" 2>/dev/null; mrc=$?; }
      ms=""; case "$mrc" in 124|137) ;; *) ms=$(cat "$mst" 2>/dev/null);; esac; [ "$mst" = /dev/null ] || rm -f "$mst"
      case "$ms" in *'not available to this account'*)
        printf 'note: %s — not a limit: nothing waits; work bound to it runs on the next model and returns when it answers again.\n' "$ms" >&2;; esac
      # A stamp that does not bind this caller is still worth SAYING — on stderr, where a person reading `cc-limit
      # status` sees it and a caller capturing stdout does not have its answer changed. NOT in the words "usage
      # limit until HH:MMZ": cc-land captures stdout and stderr together and reads that phrase out of the text as a
      # reset to defer a merge to, so this line would park a queue on the very limit it says does not apply.
      [ "$ends" -gt "$now" ] && printf 'note: another run hit a limit that resets %sZ; no second run has hit it, so the box is not held by it.\n' "$(date -u -d "@$ends" +%H:%M)" >&2
      exit 1; fi
    only=""; [ "$(nobs)" -ge 2 ] || only=" (this run only)"
    printf 'usage limit until %sZ (%dm left)%s%s\n' "$(date -u -d "@$ends" +%H:%M)" $(( (ends - now + 59) / 60 )) "${mdl:+ [$mdl]}" "$only"; exit 0 ;;
  wait) believe || exit 0; s=$((ends - now))
    { [ -n "${CC_LIMIT_MIN_WAIT:-}" ] && [ "$s" -gt "$CC_LIMIT_MIN_WAIT" ]; } && s="$CC_LIMIT_MIN_WAIT"
    [ "$s" -gt "$MAX" ] && exit 1; sleep "$s"; exit 0 ;;
  record) shift; [ "${1:-}" = --dry ] && { DRY=1; shift; }
    [ -n "${1:-}" ] && { record "$1" "${2:?usage: cc-limit record [--dry] [<pane-id> <window>]}"; exit $?; }
    scan; exit $? ;;
  resume) resume; exit 0 ;;
  selfcheck) selfcheck; exit $? ;;
  check) ;;
  *) sed -n '2,15p' "$0" >&2; exit 2 ;;
esac
# ---- check: is_error / a run that produced no result (a non-zero rc), AND limit wording somewhere in result or stderr
j="${2:?usage: cc-limit check <claude-json> [<stderr-file>] [<asked-model>]}"; res=""; asked="${4:-}"
res=$(jq -r '[.result?, .error?, .subtype?] | map(select(type == "string")) | join(" ")' "$j" 2>/dev/null)
{ [ "$(jq -r '.is_error // empty' "$j" 2>/dev/null)" = true ] || [ -z "$res" ]; } || exit 1
txt="$res $(tail -c 4000 "${3:-/dev/null}" 2>/dev/null)"
# whose limit was it? the model family the message names, else the run's own main model (the modelUsage keys, minus
# the haiku side-call the CLI runs for titles: read off the json's first 2000 bytes that call came first, and the
# stamp of 2026-09-03 named haiku for a limit opus had hit)
newm=$(grep -oiE 'claude-(fable|opus|sonnet|haiku)[a-z0-9._-]*|\b(fable|opus|sonnet|haiku)\b' <<<"$txt" | head -1 | tr 'A-Z' 'a-z')
[ -n "$newm" ] || newm=$(jq -r '.modelUsage? // {} | keys[]?' "$j" 2>/dev/null | grep -iE 'fable|opus|sonnet' | head -1 | tr 'A-Z' 'a-z')
case "$newm" in *fable*) newm=fable;; *opus*) newm=opus;; *sonnet*) newm=sonnet;; *haiku*) newm=haiku;; *) newm="";; esac
# USAGE CREDITS AND THE MONTHLY SPEND CAP ARE NOT A LIMIT — THEY ARE ONE MODEL THIS ACCOUNT CANNOT RUN RIGHT NOW.
# "Fable 5.1 requires usage credits" (2026-09-03, the account went Pro), "You're out of usage credits" (2026-08-28) and
# "You've hit your monthly spend limit · your weekly limit resets 10pm" (2026-09-09) all say the model that draws on
# credits is out: no reset lifts that — the cap's line names the WEEKLY limit's reset, which is not the cap's lift;
# credits, the cap raised at claude.ai/settings/usage, or a re-login do — and the other models answer. Read as a
# limit, the first parked the whole box for 14 h on a model nobody else was using, and the cap parked the planning
# seat for 14 h, three of them after the owner had raised it; until 2026-09-15 the cap still wrote a backoff stamp
# every caller waited on. So: NO STAMP for any of them. cc-model records the model as unavailable, moves the work
# bound to it to the next rung, brings it back when a probe answers as that model, and tells the owner once per
# episode what lifts it; the caller reads "not a limit" (exit 1) and walks the chain. Real limit wording beside the
# credits wording still wins: a limit hit with no credits left to continue on is a limit. The cap wins over the
# reset it quotes (owner, 2026-09-15: "a Fable-only outage — 'requires usage credits', the monthly spend limit").
LIMIT_RE='usage limit|rate limit|rate_limit|429|too many requests|overloaded|resets? (at )?'
CREDITS_RE='usage credits|out of credits|insufficient credits'
SPEND_RE='spend(ing)? limit|spend cap|monthly (spend|usage) (limit|cap)'
if grep -qiE "$SPEND_RE" <<<"$txt" || { grep -qiE "$CREDITS_RE" <<<"$txt" && ! grep -qiE "$LIMIT_RE" <<<"$txt"; }; then
  why=$(jq -r '.result // "" | tostring' "$j" 2>/dev/null | head -1 | sed -E 's/(\. | · ).*//' | head -c 120)
  if [ -z "$newm" ]; then   # the cap line names no model: it is the one the run was dispatched on (cc-loop passes it)
    case "$(tr 'A-Z' 'a-z' <<<"$asked")" in *fable*) newm=fable;; *opus*) newm=opus;; *sonnet*) newm=sonnet;; *haiku*) newm=haiku;; esac; fi
  [ -n "$newm" ] && [ -x "$BIN/cc-model" ] && "$BIN/cc-model" unavailable "$newm" "$why" >/dev/null 2>&1
  exit 1
fi
grep -qiE "$LIMIT_RE" <<<"$txt" || exit 1
parse_reset "$txt"
stamp; same=0; { [ "$first" -gt 0 ] && [ "$ends" -gt $((now - 900)) ]; } && same=1   # still the same limit episode
[ "$same" = 1 ] || first=$now
if [ "$u" -le "$now" ]; then   # no time in the message: exponential backoff, remembered in the stamp (5, 10, 20, 40, 60 min)
  b=5; [ "$same" = 1 ] && case "$src" in backoff:[0-9]*) b=$(( ${src#*:} * 2 )); [ "$b" -gt 60 ] && b=60;; esac
  u=$((now + b * 60)); how="backoff:$b"
fi
[ -n "$newm" ] || newm="$mdl"   # same episode, a message that names no model: keep what we already knew
[ "$same" = 1 ] || obs=""       # a new episode: the runs on the old stamp saw a different limit and do not vouch for this one
obs=$(add_obs "$(mykey)")       # THIS run has now hit it — one observer binds this run alone, two make it the box's
mkdir -p "$(dirname "$S")"; printf '%s\t%s\t%s\t%s\t%s\n' "$u" "$how" "$first" "$newm" "$obs" > "$S"
# A limit on the box's primary model moves every session to the fallback (cc-model decides if it was) — but only once
# a SECOND run has hit the same limit. One worker's word moved every session for six hours on 2026-09-04.
[ "$(nobs)" -ge 2 ] && [ -n "$newm" ] && [ -x "$BIN/cc-model" ] && "$BIN/cc-model" limited "$newm" "$newm limit" >/dev/null 2>&1
scan >/dev/null 2>&1   # the same limit is on every session, not just this run: whatever it interrupted is nudged at the reset
echo "LIMIT $u"
