#!/usr/bin/env python3
"""cc-probe — cheap problem-finding on the box's own commands.

  cc-probe run [--only <probe>…] [--model haiku|sonnet] [--dry]   a batch: every probe under core/probes (or the ones
                                                                 named), one after another, until the day's budget is spent
  cc-probe show [<run>]    one run in one place: what it cost, what each probe found, which rows were filed and which
                           were already on the board (default: the latest run)
  cc-probe list            the probes, their model and target
  cc-probe budget          today's spend against the day's budget
  cc-probe selfcheck

WHY (owner, 2026-09-11): "a system which just spawns sonnet and haiku agents that just try to test a bunch of edge
cases, test weird problems and just do a bunch of cheap problem finding". The week's 33 raised- rows were all found
by expensive sessions tripping over them.

A PROBE is one file, core/probes/<name>.md: a few header lines (model, target, turns) then the prompt — ONE command
or flow and a short list of odd inputs. A Haiku or Sonnet session gets that prompt, runs inside `cc-sandbox probe`
with HOME set to a FIXTURE this runner built (a throwaway board, repo and config under ~/.cc/state/probes/home),
and writes ~/findings.json: what it ran, what came out, what should have. It reproduces each finding once before
writing it; a flake or a taste note is not a finding.

THE FIXTURE IS ALL A PROBE CAN REACH. The boundary (cc-sandbox, `probe`) has nothing of the box in it: no
~/.cc/config, no boards, no Slack socket or token, no mail, no GitHub, no tmux, no landing queue — absent, not
denied. So a Slack post in there stops at "no SLACK_BOT_TOKEN" (the fixture's config has none), the board a probe
corrupts is the fixture's, and the one live thing it holds is the same stripped access token a worker gets, because
a session cannot run without one. The selfcheck below proves the doors absent, on this box's real boundary.

FILING. A probe files nothing itself (it cannot: the real boards are not in there). This runner reads its
findings and files each as ONE raised- row on the control repo's board — `raised-<slug>`, with the exact command,
its output, what was expected, and what the probe cost to find it — the judge's raised- route (cc-brief does not
judge a raised- row). DEDUPLICATED against the board first: a row with that key already there, or a raised- row
whose words mostly overlap the finding's, is not filed again and is listed in the run as a duplicate, with the
row it matched. Nothing else leaves: no PR, no post, no dispatch.

THE BUDGET. CC_PROBE_DAILY_USD (~/.cc/config, default 3) caps what a UTC day of probes may spend; CC_PROBE_EACH_USD
(default 0.40) caps one probe. Every probe's cost (claude's own total_cost_usd) goes to ~/.cc/state/probes/ledger.tsv;
a probe is capped at the smaller of the two, and a batch stops once less than ten cents of the day is left (a probe
with less finds nothing). The spend tier is read first: under stop and
essential no probe runs (`cc-tier allows goals` — a probe batch is cheap work the box finds for itself).

WHERE A RUN IS READ: ~/.cc/state/probes/runs/<stamp>/ holds run.json (the summary `show` prints), each probe's
prompt, claude output, stderr and findings. One batch at a time (a lock); nothing here opens the box outward, and
no timer starts one — a schedule comes once a day of findings has been read.

Config (~/.cc/config): CC_PROBE_DAILY_USD · CC_PROBE_EACH_USD · CC_PROBE_REPO (the board rows go to; default: the
repo this copy lives in, ~/dev/<repo>/core/bin). Environment only: CC_CLAUDE names claude, as it does for cc and
cc-loop. The state root is fixed at ~/.cc/state/probes — cc-sandbox refuses a probe home anywhere else.
"""
import datetime
import fcntl
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
SELF = os.path.realpath(__file__)
BIN = os.path.dirname(SELF)
PROBES = os.path.join(os.path.dirname(BIN), "probes")
ROOT = os.environ.get("CC_PROBE_ROOT") or f"{HOME}/.cc/state/probes"   # NOT a knob: cc-sandbox binds a probe home only
CLAUDE = os.environ.get("CC_CLAUDE") or f"{HOME}/.local/bin/claude"     # under the real root; the selfcheck's stub
SANDBOX = os.environ.get("CC_PROBE_SANDBOX") or f"{BIN}/cc-sandbox"     # sandbox is the one thing that moves it
MODELS = {"haiku": "claude-haiku-4-5-20251001", "sonnet": "claude-sonnet-5"}
PROBE_TIMEOUT = 1500   # seconds of wall clock one probe gets; a stuck one costs its cap at most, not the day's
MIN_CAP = 0.10         # under this much of the day left, the day is over — `run` and `budget` read the same line

# THE PROBE'S STANDING ORDERS, appended to every prompt with the fixture's path filled in. Short on purpose: a cheap
# model follows a page, not a book. The path is spelled out because a model reads `~` as /home/<user>, and the first
# live run wrote its findings there (denied by the hook, then retried) before it wrote them where they are read.
ORDERS = """
# YOU ARE A PROBE
You try odd inputs against ONE command of this box and report what really breaks. Your HOME is {home} — a
throwaway fixture built for you: the board at {home}/.cc/boards/fx.json (repo `fx`, rows t1 and t2), a git repo at
{home}/dev/fx, and a config at {home}/.cc/config with no secrets — so anything that needs a token (a Slack post,
mail) stops at "no token", which is expected and not a finding. Break the fixture freely; nothing of the real box
is reachable. A command of yours that the session's own hook refuses before it runs (cc-guard says "blocked") is
this session's guard, not the command under test: try another shape or skip it; that is never a finding.
RULES: no network (no curl/wget/pip/npm, nothing outward); do not edit anything under ~/bin; do not try to fix what
you find; do not spend turns on things that are clearly working — run the odd inputs, read the output, move on.
WHAT IS A FINDING: a traceback or crash · a wrong result · a silent no-op where the usage text says something
happens · a state left inconsistent (the board says one thing, the file another) · an input accepted that should
have been refused, or refused with a message that names the wrong reason · usage text that lies.
NOT A FINDING: a clear refusal with a true reason · a flake you could not reproduce · style, wording, taste ·
a missing feature. REPRODUCE each finding once more before writing it.
YOUR REPORT is {home}/findings.json — a JSON list, empty when nothing broke — one object per DISTINCT failure:
{"slug": "what-happened-in-a-few-words" (lowercase, dashes, no command name needed, ≤ 50 chars), "title": "one
line saying what happened, not the fix", "command": "the exact command line", "output": "what it printed, first
15 lines", "expected": "what should have happened", "reproduced": true}. WRITE IT EARLY: an empty list before your
first command, then rewrite the file after every finding you reproduce — your turns are capped, and when they run
out only what is in the file counts. Stop when the list above is done or the file holds everything you found.
"""


# ── config and paths ────────────────────────────────────────────────────────────────────────────────────────────
def cfg(key, default=""):
    """~/.cc/config through cc-config (never sourced); the environment wins, as it does everywhere."""
    r = subprocess.run([f"{BIN}/cc-config", "get", key, str(default)], capture_output=True, text=True)
    return (r.stdout.strip() or str(default)) if r.returncode in (0, 1) else str(default)


def control_repo():
    """Where the rows go: CC_PROBE_REPO, else the repo this copy lives in (~/bin links into ~/dev/<repo>/core/bin)."""
    r = cfg("CC_PROBE_REPO")
    if r: return r
    pre = f"{HOME}/dev/"
    if BIN.startswith(pre): return BIN[len(pre):].split("/", 1)[0]
    sys.exit("cc-probe: cannot tell which board the rows go to — set CC_PROBE_REPO in ~/.cc/config")


def board(repo):
    r = subprocess.run([f"{BIN}/cc-board", "json", repo], capture_output=True, text=True)
    try: return json.loads(r.stdout) if r.returncode == 0 else {}
    except ValueError: return {}


# ── probes ──────────────────────────────────────────────────────────────────────────────────────────────────────
def load_probes(only=()):
    """core/probes/<name>.md → [{name, model, target, turns, body}]. Header: `key: value` lines up to `---`."""
    out = []
    for f in sorted(glob.glob(f"{PROBES}/*.md")):
        name = os.path.basename(f)[:-3]
        if only and name not in only: continue
        head, _, body = open(f).read().partition("\n---\n")
        p = {"name": name, "model": "haiku", "target": "", "turns": 30}
        for line in head.splitlines():
            k, _, v = line.partition(":")
            if k.strip() in p: p[k.strip()] = v.strip()
        p["turns"] = int(p["turns"]); p["body"] = body.strip()
        if p["model"] not in MODELS: sys.exit(f"cc-probe: {name}: model must be haiku or sonnet, not {p['model']}")
        if not p["body"]: sys.exit(f"cc-probe: {name}: no prompt after the --- line")
        out.append(p)
    missing = set(only) - {p["name"] for p in out}
    if missing: sys.exit(f"cc-probe: no probe named {', '.join(sorted(missing))} under {PROBES}")
    return out


# ── the fixture ─────────────────────────────────────────────────────────────────────────────────────────────────
def fx_env(home):
    """The environment the fixture is BUILT in, on the host: HOME is the fixture, so cc-board and git write there."""
    return dict(PATH=f"{BIN}:{HOME}/.local/bin:/usr/bin:/bin", HOME=home, LANG="C.UTF-8", TERM="dumb",
                CC_BRIEF_FAKE="", CC_CONFIG=f"{home}/.cc/config",
                GIT_AUTHOR_NAME="probe", GIT_AUTHOR_EMAIL="probe@fixture", GIT_COMMITTER_NAME="probe",
                GIT_COMMITTER_EMAIL="probe@fixture")


def build_fixture(home):
    """A throwaway HOME: a board with two rows, a repo with a commit, a config with nothing in it worth having."""
    if not os.path.realpath(home).startswith(os.path.realpath(ROOT) + "/"):
        sys.exit(f"cc-probe: refusing to rebuild {home}: not under {ROOT}")
    shutil.rmtree(home, ignore_errors=True)
    for d in (".cc/boards", ".cc/slack", ".cc/state", "dev/fx"): os.makedirs(f"{home}/{d}")
    with open(f"{home}/.cc/config", "w") as f:
        os.fchmod(f.fileno(), 0o600); f.write("CC_SPEND_TIER=autonomous\nPUBLISH_REPO=fx\nCC_SELF_LAND_REPOS=fx\n")
    env = fx_env(home)
    def sh(*cmd):
        r = subprocess.run(cmd, env=env, capture_output=True, text=True, cwd=home)
        if r.returncode: sys.exit(f"cc-probe: building the fixture: {' '.join(cmd[:3])} → {r.stderr.strip() or r.stdout.strip()}")
    sh("git", "-C", f"{home}/dev/fx", "init", "-q", "-b", "main")
    open(f"{home}/dev/fx/README.md", "w").write("fixture repo\n")
    sh("git", "-C", f"{home}/dev/fx", "add", "."); sh("git", "-C", f"{home}/dev/fx", "commit", "-qm", "init")
    sh(f"{BIN}/cc-board", "init", "fx", f"{home}/dev/fx", "main")
    sh(f"{BIN}/cc-board", "add", "fx", "t1", "the first fixture row", "GOAL: a row to try things on. DONE: when the probe says so.")
    sh(f"{BIN}/cc-board", "add", "fx", "t2", "the second fixture row", "GOAL: another. DONE: likewise.")
    sh(f"{BIN}/cc-board", "status", "fx", "t2", "running")


# ── budget and ledger ───────────────────────────────────────────────────────────────────────────────────────────
def today(): return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d")


def spent_today():
    """The ledger's rows for this UTC day, summed. Columns: stamp run probe model cost turns findings filed."""
    total = 0.0
    try:
        for line in open(f"{ROOT}/ledger.tsv"):
            c = line.rstrip("\n").split("\t")
            if len(c) >= 5 and c[0].startswith(today()):
                try: total += float(c[4])
                except ValueError: pass
    except FileNotFoundError: pass
    return total


def ledger(run, probe, model, cost, turns, nfind, nfiled):
    os.makedirs(ROOT, exist_ok=True)
    with open(f"{ROOT}/ledger.tsv", "a") as f:
        f.write("\t".join([time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), run, probe, model, f"{cost:.4f}",
                           str(turns), str(nfind), str(nfiled)]) + "\n")


def budgets():
    def num(k, d):
        try: return float(cfg(k, d))
        except ValueError: sys.exit(f"cc-probe: {k} in ~/.cc/config is not a number")
    return num("CC_PROBE_DAILY_USD", 3), num("CC_PROBE_EACH_USD", 0.40)


# ── one probe ───────────────────────────────────────────────────────────────────────────────────────────────────
def run_probe(p, home, rundir, cap, model_override):
    """Launch one probe inside the boundary; return (result dict for run.json, cost)."""
    model = model_override or p["model"]
    prompt = f"# PROBE: {p['name']} (target: {p['target']})\n\n{p['body']}\n{ORDERS.replace('{home}', home)}"
    open(f"{rundir}/{p['name']}.prompt.md", "w").write(prompt)
    args = [CLAUDE, "-p", prompt, "--permission-mode", "auto", "--max-turns", str(p["turns"]),
            "--max-budget-usd", f"{cap:.2f}", "--output-format", "json", "--model", MODELS[model]]
    # env inside the boundary: the brief judge is a model call of its own, so it is stubbed out — a probe that adds a
    # board row must not spend a second session's worth outside its own cap; and cc-config reads the fixture's file
    cmd = [SANDBOX, "probe", home, "--", "env", "CC_BRIEF_FAKE=", f"CC_CONFIG={home}/.cc/config",
           "timeout", str(PROBE_TIMEOUT)] + args
    t0 = time.time()
    with open(f"{rundir}/{p['name']}.out.json", "w") as out, open(f"{rundir}/{p['name']}.err", "w") as err:
        rc = subprocess.run(cmd, stdout=out, stderr=err, stdin=subprocess.DEVNULL).returncode
    res = {"probe": p["name"], "model": model, "rc": rc, "seconds": round(time.time() - t0), "cost": 0.0, "turns": 0,
           "findings": [], "filed": [], "duplicates": [], "dropped": [], "error": ""}
    try:
        o = json.load(open(f"{rundir}/{p['name']}.out.json"))
        res["cost"] = float(o.get("total_cost_usd") or 0); res["turns"] = int(o.get("num_turns") or 0)
        if o.get("is_error"):
            sub = str(o.get("subtype") or "")
            res["error"] = ("ran out of turns — what findings.json held by then is all that counts" if sub == "error_max_turns"
                            else str(o.get("result") or sub or "claude reported an error")[:300])
    except (ValueError, OSError):
        res["error"] = f"claude wrote no JSON result (rc {rc}) — see {p['name']}.err"
    try:
        raw = json.load(open(f"{home}/findings.json"))
        shutil.copy(f"{home}/findings.json", f"{rundir}/{p['name']}.findings.json")
    except (ValueError, OSError):
        raw = []
        if not res["error"]: res["error"] = "the probe wrote no findings.json"
    res["findings"], res["dropped"] = clean_findings(raw)
    return res


def slugify(s):
    s = re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    return s[:50].rstrip("-")


def clean_findings(raw):
    """Keep what has the shape of a finding; say why the rest was dropped. A probe's word is checked, not trusted."""
    keep, dropped = [], []
    for f in raw if isinstance(raw, list) else []:
        if not isinstance(f, dict): dropped.append("not an object"); continue
        slug = slugify(str(f.get("slug") or f.get("title") or ""))
        if not slug or not str(f.get("title", "")).strip() or not str(f.get("command", "")).strip():
            dropped.append(f"missing slug, title or command: {json.dumps(f)[:120]}"); continue
        if f.get("reproduced") is not True:
            dropped.append(f"not reproduced: {slug}"); continue
        # output and expected are kept byte for byte: the first live finding WAS whitespace, and a strip here erased it
        keep.append({"slug": slug, "title": str(f["title"]).strip()[:160], "command": str(f["command"]).strip()[:600],
                     "output": str(f.get("output", ""))[:1500], "expected": str(f.get("expected", ""))[:600]})
    return keep, dropped


# ── dedup and filing ────────────────────────────────────────────────────────────────────────────────────────────
STOP = set("a an the of to in on is it its as and or not for with when that this from by at be are was does do did".split())


def words(*texts):
    w = set()
    for t in texts:
        w |= {x for x in re.split(r"[^a-z0-9]+", t.lower()) if len(x) > 2 and x not in STOP}
    return w


def duplicate_of(finding, rows, batch):
    """The board row (or earlier finding of this batch) this one repeats, or None. Exact key first, then words:
    most of the finding's words already in one raised- row's key and title is the same problem said twice."""
    key = "raised-" + finding["slug"]
    if key in rows: return key
    mine = words(finding["slug"], finding["title"])
    if not mine: return None
    for k, t in [(k, (v or {}).get("title", "")) for k, v in rows.items() if k.startswith("raised-")] + batch:
        theirs = words(k.replace("raised-", "", 1), t)
        if theirs and len(mine & theirs) / len(mine | theirs) >= 0.5: return k
    return None


def file_row(repo, f, p, model, cost, run):
    key = "raised-" + f["slug"]
    body = (f"FOUND BY cc-probe ({p['name']}, {model}, ${cost:.2f} to find, run {run}) on {today()} — a probe against a "
            f"fixture, not the live box; reproduce it in one first.\n\nCOMMAND:\n{f['command']}\n\nOUTPUT:\n{f['output']}\n\n"
            f"EXPECTED:\n{f['expected']}\n\nRUN: cc-probe show {run}")
    # CC_BRIEF_MACHINE: this row is the box's own writing, not a brief someone typed — a multi-line command/output
    # (cc-config set A 1\ncc-config set A 2\n...) would otherwise trip cc-brief's arithmetic `check` gate and the
    # reproduced finding would land in `dropped` instead of the board (review of #421; cc-audit:261 same convention).
    r = subprocess.run([f"{BIN}/cc-board", "add", repo, key, f["title"], body], capture_output=True, text=True,
                        env={**os.environ, "CC_BRIEF_MACHINE": "1"})
    return key, (r.returncode == 0), (r.stderr.strip() or r.stdout.strip())[:300]


# ── the batch ───────────────────────────────────────────────────────────────────────────────────────────────────
def cmd_run(argv):
    only, model, dry = [], "", False
    it = iter(argv)
    for a in it:
        if a == "--only": only.append(next(it, "") or sys.exit("cc-probe: --only takes a probe name"))
        elif a == "--model": model = next(it, ""); model in MODELS or sys.exit("cc-probe: --model haiku|sonnet")
        elif a == "--dry": dry = True
        else: sys.exit(f"cc-probe run: unknown argument {a}")
    tier = subprocess.run([f"{BIN}/cc-tier", "allows", "goals"], capture_output=True, text=True)
    if tier.returncode == 1:
        print(f"cc-probe: tier {subprocess.run([f'{BIN}/cc-tier'], capture_output=True, text=True).stdout.strip()}: probes are off until moderate"); return 0
    if tier.returncode not in (0, 1): sys.exit(f"cc-probe: cc-tier could not answer: {tier.stderr.strip()}")
    daily, each = budgets(); probes = load_probes(only); repo = control_repo()
    spent = spent_today()
    if dry:
        print(f"budget ${daily:.2f}/day, ${spent:.2f} spent today, ${each:.2f} per probe, rows → {repo}")
        for p in probes: print(f"  {p['name']:32} {model or p['model']:7} {p['target']}")
        return 0
    os.makedirs(f"{ROOT}/runs", exist_ok=True)
    lock = open(f"{ROOT}/.lock", "w")
    try: fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError: sys.exit("cc-probe: a batch is already running (the lock is held)")
    run = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()); rundir = f"{ROOT}/runs/{run}"; os.makedirs(rundir)
    home = f"{ROOT}/home"
    summary = {"run": run, "started": run, "repo": repo, "daily": daily, "each": each, "spent_before": round(spent, 4),
               "probes": [], "stopped": ""}
    rows = board(repo).get("tracks", {}); batch = []
    for p in probes:
        cap = min(each, daily - spent)
        if cap < MIN_CAP:
            summary["stopped"] = f"the day's budget (${daily:.2f}) is spent: ${spent:.2f}"; break
        build_fixture(home)
        print(f"{p['name']} ({model or p['model']}, cap ${cap:.2f}) …", end="", flush=True)
        res = run_probe(p, home, rundir, cap, model)
        spent += res["cost"]
        for f in res["findings"]:
            d = duplicate_of(f, rows, batch)
            if d: res["duplicates"].append({"slug": f["slug"], "same_as": d}); continue
            key, ok, msg = file_row(repo, f, p, res["model"], res["cost"], run)
            if ok: res["filed"].append(key); rows[key] = {"title": f["title"]}; batch.append((key, f["title"]))
            else: res["dropped"].append(f"cc-board refused {key}: {msg}")
        ledger(run, p["name"], res["model"], res["cost"], res["turns"], len(res["findings"]), len(res["filed"]))
        summary["probes"].append(res)
        print(f" ${res['cost']:.2f}, {res['turns']} turns, {len(res['findings'])} finding(s), {len(res['filed'])} filed"
              + (f", ERROR: {res['error']}" if res["error"] else ""))
        json.dump(summary, open(f"{rundir}/run.json", "w"), indent=1)   # after every probe: a killed batch still reads
    summary["spent_after"] = round(spent, 4); summary["ended"] = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    json.dump(summary, open(f"{rundir}/run.json", "w"), indent=1)
    shutil.rmtree(home, ignore_errors=True)   # the fixture is the run's; the record under runs/ is what stays
    if summary["stopped"]: print(summary["stopped"])
    print(f"run {run}: ${summary['spent_after'] - summary['spent_before']:.2f}, "
          f"{sum(len(r['filed']) for r in summary['probes'])} row(s) filed — cc-probe show {run}")
    return 0


def cmd_show(argv):
    runs = sorted(glob.glob(f"{ROOT}/runs/*/run.json"))
    if not runs: print("cc-probe: no run yet"); return 1
    f = f"{ROOT}/runs/{argv[0]}/run.json" if argv else runs[-1]
    try: s = json.load(open(f))
    except OSError: sys.exit(f"cc-probe: no run {argv[0]} under {ROOT}/runs")
    cost = s.get("spent_after", s["spent_before"]) - s["spent_before"]   # a killed batch has no spent_after yet
    print(f"run {s['run']}  ${cost:.2f} of ${s['daily']:.2f}/day (${s.get('spent_after', s['spent_before']):.2f} spent today)"
          f"  rows → {s['repo']}" + (f"  — {s['stopped']}" if s.get("stopped") else "") + ("" if s.get("ended") else "  (still running)"))
    for r in s["probes"]:
        print(f"  {r['probe']} [{r['model']}] ${r['cost']:.2f} {r['turns']} turns" + (f"  ERROR: {r['error']}" if r["error"] else ""))
        for k in r["filed"]: print(f"    filed      {k}")
        for d in r["duplicates"]: print(f"    duplicate  {d['slug']} = {d['same_as']}")
        for d in r["dropped"]: print(f"    dropped    {d}")
    print(f"  files: {os.path.dirname(f)}/")
    return 0


def cmd_list():
    for p in load_probes(): print(f"{p['name']:32} {p['model']:7} {p['target']}")
    return 0


def cmd_budget():
    daily, each = budgets(); s = spent_today()
    print(f"${s:.2f} of ${daily:.2f} spent today ({today()} UTC), ${each:.2f} cap per probe, "
          + ("nothing left" if daily - s < MIN_CAP else f"${daily - s:.2f} left"))
    return 0


# ── selfcheck ───────────────────────────────────────────────────────────────────────────────────────────────────
def selfcheck():
    """Two halves. THE BOUNDARY, on this box's real cc-sandbox: a probe home under the real ~/.cc/state/probes, a
    shell inside it, and every live door read as absent. THE RUNNER, in a HOME of its own with a stub claude and a
    stub sandbox: the budget stops the batch, a finding files one row, a repeat is a duplicate, an unreproduced
    one is dropped, the tier holds, and `show` reads it all back from run.json."""
    import tempfile
    n = [0, 0]
    def ok(name, cond, extra=""):
        n[0] += 1
        if not cond: n[1] += 1; print(f"FAIL {name}" + (f": {extra}" if extra else ""))
    # ── the boundary ──
    real_root = f"{HOME}/.cc/state/probes"; os.makedirs(real_root, exist_ok=True)
    fx = tempfile.mkdtemp(prefix="selfcheck-", dir=real_root)
    probe_sh = r'''e(){ [ -e "$1" ] && echo present || echo absent; }; R=%s
echo home=$HOME; echo cfg=$(e $R/.cc/config); echo boards=$(e $R/.cc/boards); echo slack=$(e $R/.cc/slack); echo land=$(e $R/.cc/state/land)
echo dev=$(ls $R/dev 2>/dev/null | wc -l); echo gh=$(e $R/.config/gh); echo ssh=$(e $R/.ssh); echo realcred=$(e $R/.claude/.credentials.json)
echo run=$(e /run/user); echo tmux=${TMUX:-unset}; echo role=$CC_ROLE; echo env=$(env | grep -c "SLACK\|TOKEN\|MAIL_\|SECRET")
echo cred=$(jq -c "[(.claudeAiOauth.accessToken != null), (.claudeAiOauth.refreshToken != null)]" ~/.claude/.credentials.json 2>/dev/null)
echo settings=$(touch ~/.claude/settings.json 2>/dev/null && echo rw || echo ro)
echo boardcmd="$(cc-board boards 2>&1 | head -1)"; echo cfgtok=$(cc-config get SLACK_BOT_TOKEN none 2>/dev/null)
echo slackpost=$(cc-slack post local hi 2>&1 >/dev/null | grep -c "no SLACK_BOT_TOKEN")
touch ~/wrote && echo homerw=yes''' % HOME
    if shutil.which("bwrap"):
        r = subprocess.run([f"{BIN}/cc-sandbox", "probe", fx, "--", "sh", "-c", probe_sh], capture_output=True, text=True)
        got = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
        ok("boundary: a shell runs inside cc-sandbox probe", r.returncode == 0, r.stderr.strip()[-300:])
        ok("boundary: HOME is the fixture", got.get("home") == fx, got.get("home"))
        for door, want in (("cfg", "absent"), ("boards", "absent"), ("slack", "absent"), ("land", "absent"), ("gh", "absent"),
                           ("ssh", "absent"), ("realcred", "absent"), ("run", "absent"), ("tmux", "unset"), ("env", "0")):
            ok(f"boundary: the box's {door} is not there", got.get(door) == want, f"{door}={got.get(door)}")
        ok("boundary: ~/dev holds the control repo's core/bin and nothing else", got.get("dev") in ("0", "1"), got.get("dev"))
        ok("boundary: the credential inside is the access token without its refresh token", got.get("cred") == "[true,false]", got.get("cred"))
        ok("boundary: the credential copy is in a tmpfs, not on disk under the fixture", os.listdir(f"{fx}/.claude") == [], str(os.listdir(f"{fx}/.claude")))
        ok("boundary: settings.json is read-only inside", got.get("settings") == "ro", got.get("settings"))
        ok("boundary: CC_ROLE is worker", got.get("role") == "worker", got.get("role"))
        ok("boundary: cc-board sees no board at all", got.get("boardcmd", "?") == "", got.get("boardcmd"))
        ok("boundary: cc-config reads the fixture's config, which has no token", got.get("cfgtok") == "none", got.get("cfgtok"))
        ok("boundary: a Slack post stops at 'no SLACK_BOT_TOKEN' — the fixture's config has none", got.get("slackpost") == "1", got.get("slackpost"))
        ok("boundary: the fixture itself is writable", got.get("homerw") == "yes")
        bad = subprocess.run([f"{BIN}/cc-sandbox", "probe", HOME, "--", "true"], capture_output=True, text=True)
        ok("boundary: a home outside ~/.cc/state/probes is refused", bad.returncode == 2 and "probe home" in bad.stderr, bad.stderr[:120])
        # SETTINGS_COPY FORCED TO FAIL (review of #421): a HOME of its own whose settings.json parses but breaks the merge
        # (permissions.allow a string), so the launcher falls back to binding his file unchanged — and it has to land at
        # the FIXTURE's ~/.claude/settings.json, where claude reads it, not at a path inside the tmpfs nothing reads.
        T0 = tempfile.mkdtemp(prefix="cc-probe-sc-home-"); os.makedirs(f"{T0}/.claude"); os.makedirs(f"{T0}/.local/bin"); os.makedirs(f"{T0}/.cc/state/probes/x")
        os.symlink(f"{HOME}/bin", f"{T0}/bin")
        json.dump({"permissions": {"allow": "Bash(x)"}, "hooks": {"PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "$HOME/bin/cc-guard"}]}]}},
                  open(f"{T0}/.claude/settings.json", "w"))
        json.dump({"claudeAiOauth": {"accessToken": "sc", "refreshToken": "sc-r", "expiresAt": 0}}, open(f"{T0}/.claude/.credentials.json", "w"))
        r = subprocess.run([f"{BIN}/cc-sandbox", "probe", f"{T0}/.cc/state/probes/x", "--", "sh", "-c",
                            'echo at=$([ -f ~/.claude/settings.json ] && echo present || echo absent); echo hook=$(jq -r ".hooks.PreToolUse[0].hooks[0].command" ~/.claude/settings.json 2>/dev/null)'],
                           capture_output=True, text=True, env=dict(os.environ, HOME=T0))
        got = dict(l.split("=", 1) for l in r.stdout.splitlines() if "=" in l)
        ok("boundary: with settings_copy failing the launcher says it fell back", "binding ~/.claude/settings.json unchanged" in r.stderr, r.stderr[-300:])
        ok("boundary: …and the fallback lands at the FIXTURE's ~/.claude/settings.json, so the session still has its hook",
           got.get("at") == "present" and got.get("hook") == "$HOME/bin/cc-guard", f"{got} {r.stderr[-200:]}")
        shutil.rmtree(T0, ignore_errors=True)
    else:
        print("cc-probe selfcheck: bwrap is not installed — the boundary half is skipped")
    shutil.rmtree(fx, ignore_errors=True); shutil.rmtree(f"{HOME}/.claude/projects/{fx.replace('/', '-').replace('.', '-')}", ignore_errors=True)
    # ── the runner ──
    T = tempfile.mkdtemp(prefix="cc-probe-sc-"); root = f"{T}/root"; os.makedirs(f"{T}/bin")
    stub_claude = f"{T}/bin/claude"
    open(stub_claude, "w").write('''#!/bin/sh
# the stub: writes the canned findings the case put at $CC_PROBE_STUB into ~/findings.json, and answers as claude does
[ -n "$CC_PROBE_STUB" ] && cp "$CC_PROBE_STUB" "$HOME/findings.json"
printf '{"type":"result","is_error":false,"num_turns":4,"total_cost_usd":%s,"result":"done"}\\n' "${CC_PROBE_STUB_COST:-0.30}"
''')
    stub_sandbox = f"{T}/bin/cc-sandbox"
    open(stub_sandbox, "w").write('''#!/bin/sh
# the stub boundary: HOME=<home> and the command, nothing else — the real one is proved above
[ "$1" = probe ] || exit 9; home="$2"; shift 3; exec env HOME="$home" "$@"
''')
    os.chmod(stub_claude, 0o755); os.chmod(stub_sandbox, 0o755)
    probes = f"{T}/probes"; os.makedirs(probes)
    open(f"{probes}/one.md", "w").write("model: haiku\ntarget: cc-board\n---\nTry cc-board add with odd names.\n")
    open(f"{probes}/two.md", "w").write("model: sonnet\ntarget: cc-config\n---\nTry cc-config set with odd values.\n")
    canned = f"{T}/findings.json"
    json.dump([{"slug": "add-accepts-an-empty-row-name", "title": "cc-board add accepts an empty row name and writes a row keyed ''",
                "command": "cc-board add fx '' t", "output": "ok", "expected": "a refusal", "reproduced": True},
               {"slug": "flaky-thing", "title": "something odd once", "command": "cc-board x", "output": "?", "expected": "?", "reproduced": False},
               {"slug": "", "title": "no slug", "command": "", "reproduced": True},
               # a two-line command (review of #421): without CC_BRIEF_MACHINE this trips cc-brief's command-run
               # gate and the reproduced finding is thrown into `dropped` instead of reaching the board.
               {"slug": "config-set-twice", "title": "cc-config set A twice leaves both lines instead of the last write",
                "command": "cc-config set A 1\ncc-config set A 2\ncc-config list", "output": "A=1\nA=2",
                "expected": "one line", "reproduced": True}], open(canned, "w"))
    env = dict(os.environ, HOME=T, CC_PROBE_ROOT=root, CC_CLAUDE=stub_claude, CC_PROBE_SANDBOX=stub_sandbox, CC_PROBE_REPO="ctl",
               CC_CONFIG=f"{T}/config", CC_PROBE_STUB=canned, CC_BRIEF_FAKE="", PATH=f"{BIN}:{os.environ.get('PATH', '')}")
    for k in ("CC_PROBE_DAILY_USD", "CC_PROBE_EACH_USD", "CC_SPEND_TIER"): env.pop(k, None)
    open(f"{T}/config", "w").write("CC_PROBE_DAILY_USD=0.50\nCC_PROBE_EACH_USD=0.40\n")
    os.makedirs(f"{T}/dev/ctl"); subprocess.run(["git", "-C", f"{T}/dev/ctl", "init", "-q"], capture_output=True)
    subprocess.run([f"{BIN}/cc-board", "init", "ctl", f"{T}/dev/ctl", "main"], env=env, capture_output=True)
    def probe(*a, **kw):
        e = dict(env, **kw)
        return subprocess.run([sys.executable, SELF] + list(a), env=e, capture_output=True, text=True, cwd=T)
    env["CC_PROBE_PROBES"] = probes   # the cases run this file as a subprocess, on the stub probe set
    r = probe("run")
    rows = json.loads(subprocess.run([f"{BIN}/cc-board", "json", "ctl"], env=env, capture_output=True, text=True).stdout or "{}").get("tracks", {})
    ok("run: the reproduced finding is filed as one raised- row with the command in its brief",
       "raised-add-accepts-an-empty-row-name" in rows and "cc-board add fx '' t" in open(f"{T}/.cc/state/ctl/raised-add-accepts-an-empty-row-name/task.md").read(), r.stdout + r.stderr)
    ok("run: a reproduced finding whose command spans two lines is filed too, not thrown into dropped by cc-brief's command-run gate (review of #421)",
       "raised-config-set-twice" in rows and "cc-config set A 2" in open(f"{T}/.cc/state/ctl/raised-config-set-twice/task.md").read(), str(list(rows)))
    ok("run: the unreproduced finding and the shapeless one are dropped, not filed", len([k for k in rows if k.startswith("raised-")]) == 2, str(list(rows)))
    ok("run: the second probe found the same thing and it is a duplicate of the first, not a second row",
       "duplicate" in probe("show").stdout and "two" in r.stdout, probe("show").stdout)
    ok("run: the ledger has one line per probe with its cost", open(f"{root}/ledger.tsv").read().count("\n") == 2 and "0.3000" in open(f"{root}/ledger.tsv").read())
    ok("run: the fixture home is gone after the batch", not os.path.exists(f"{root}/home"))
    s = probe("show")
    ok("show: one run reads back cost, filed and duplicate in one place", "$0.60" in s.stdout and "filed      raised-add-accepts" in s.stdout and "duplicate  add-accepts" in s.stdout, s.stdout)
    ok("budget: today's spend is read from the ledger", "$0.60 of $0.50" in probe("budget").stdout, probe("budget").stdout)
    r2 = probe("run")
    ok("budget: a day already over its cap runs no probe and says so", "budget" in r2.stdout and "spent" in r2.stdout and open(f"{root}/ledger.tsv").read().count("\n") == 2, r2.stdout + r2.stderr)
    open(f"{T}/config", "w").write("CC_PROBE_DAILY_USD=0.35\nCC_PROBE_EACH_USD=0.40\n")
    shutil.rmtree(root); os.makedirs(root)
    r3 = probe("run", CC_PROBE_STUB=f"{T}/none.json")
    ok("budget: the batch stops before the probe that would pass the day's cap (one ran, the cap is the remainder)",
       "one (" in r3.stdout and "two (" not in r3.stdout and "cap $0.35" in r3.stdout and "is spent" in r3.stdout, r3.stdout)
    ok("run: a probe that writes no findings is reported, not filed", "wrote no findings.json" in probe("show").stdout, probe("show").stdout)
    ok("run: the prompt names the fixture's path, never a bare ~", "{home}" not in open(glob.glob(f"{root}/runs/*/one.prompt.md")[-1]).read()
       and f"{root}/home/findings.json" in open(glob.glob(f"{root}/runs/*/one.prompt.md")[-1]).read())
    open(f"{T}/config", "w").write("CC_PROBE_DAILY_USD=3\n")
    d = probe("run", "--dry")
    ok("dry: lists the probes and the budget, runs nothing", "one" in d.stdout and "two" in d.stdout and "budget $3.00/day" in d.stdout
       and open(f"{root}/ledger.tsv").read().count("\n") == 1, d.stdout + d.stderr)
    open(f"{T}/config", "w").write("CC_PROBE_DAILY_USD=3\nCC_SPEND_TIER=essential\n")
    r4 = probe("run")
    ok("tier: under essential no probe runs and the answer is one line, exit 0", r4.returncode == 0 and "probes are off" in r4.stdout and "one (" not in r4.stdout, r4.stdout + r4.stderr)
    open(f"{T}/config", "w").write("CC_PROBE_DAILY_USD=3\nCC_SPEND_TIER=stop\n")
    ok("tier: under stop likewise", "probes are off" in probe("run").stdout)
    ok("list: names every probe with its model", "one " in probe("list").stdout and "sonnet" in probe("list").stdout)
    shutil.rmtree(T, ignore_errors=True)
    print(f"cc-probe selfcheck: {n[0] - n[1]} passed, {n[1]} failed")
    return 1 if n[1] else 0


if __name__ == "__main__":
    if os.environ.get("CC_PROBE_PROBES"): PROBES = os.environ["CC_PROBE_PROBES"]   # the selfcheck's stub probe set
    a = sys.argv[1:]
    cmd = a[0] if a else ""
    if cmd == "run": sys.exit(cmd_run(a[1:]))
    elif cmd == "show": sys.exit(cmd_show(a[1:]))
    elif cmd == "list": sys.exit(cmd_list())
    elif cmd == "budget": sys.exit(cmd_budget())
    elif cmd == "selfcheck": sys.exit(selfcheck())
    else: sys.exit("usage: cc-probe run [--only <probe>…] [--model haiku|sonnet] [--dry] | show [<run>] | list | budget | selfcheck")
