#!/usr/bin/env python3
"""cc-context — how full a Claude session's context is, and whether it is past the hand-off line.

  cc-context                       the session this runs inside ($CLAUDE_CODE_SESSION_ID), else the newest
                                   session for this cwd
  cc-context <repo> <track>        that track's session (session id from the board); `<repo>/<track>` is the same
  cc-context <repo>                the newest session in ~/dev/<repo> — the one a person steers, or an
                                   orchestrator beside it: whichever wrote its status-line file last
                                   --since EPOCH bounds it: a session that stopped writing before that
                                   instant is not read at all (the box measures a live seat that carries no
                                   session id by its checkout, and the seat the owner quit is not it)
  cc-context --transcript PATH | --session ID
  cc-context --all                 TSV, one row per session active in the last day:
                                   repo track pct used window src age level -  (level: handoff or -).
                                   A session with a status-line file is read off it (src statusline); a track
                                   worktree with none — every headless `--go` worker — off its transcript
                                   (src transcript), or `cc ls` and the dashboard would show no track at all.
                                   --all --json: the same rows, each also carrying ts (ISO-8601 UTC of the
                                   session's last activity) and level as handoff or null
  cc-context selfcheck
    also: --json · -q (exit code only) · --over [PCT] (exit 0 at/over, 1 under, 2 unmeasurable; bare = the
          hand-off line)

THE NUMBER IS THE HARNESS'S OWN when it has one: cc-statusline writes ~/.cc/state/statusline/<session-id>.json
every turn with the harness's used/window/pct, and a file fresher than STATUSLINE_MAX_AGE is the answer
(window from "statusline"). Without one — a headless worker has no status line; a session that has not ended
a turn has no file — the transcript is read. USED = the last assistant entry's input + cache_creation +
cache_read; a compact_boundary after it means its postTokens instead; sidechain (subagent) entries never
count. WINDOW is the first evidence found, and the source is always printed: env CC_CTX_WINDOW · the
session's own compact_boundary.preTokens · the transcript's cost-state model ids ([1m] survives there) · the
live claude process's --model · the box's own model (cc-model) when it is the same family, which also raises a
suffix-less id to the size the box runs that family at · else 200k, flagged as assumed. Used above the window
raises the window.

THE HAND-OFF LINE IS ONE ABSOLUTE NUMBER: CC_CONTEXT_HANDOFF_TOKENS (~/.cc/config, default 150000). Past it
answers degrade whatever the window holds, and every wake re-reads the whole context as cache, so a session
past the line hands off (`cc-handoff --overlap <target>`) as a spend choice of its own; the Stop hook nags it
once an hour. THE ROTATE LINE IS A SECOND ONE, ABOVE IT: CC_CONTEXT_ROTATE_TOKENS (default 200000; 0 = off).
A seat still past that one is handed off BY THE BOX — `cc-handoff --sweep`, on the cc-reconcile tick, opens
the overlap for it — because five course seats sat on five nags each and grew to 487k (2026-09-19). This file
measures and says which lines are crossed (`level`, `rotate_line`, `rotate` in --json); the sweep decides.
The level column and a bare --over read the hand-off line.

Env: CC_CTX_WINDOW · CC_CTX_BOX_MODEL (empty = never ask the box; the selfcheck sets it) · CC_STATUSLINE_DIR ·
CC_CONTEXT_HANDOFF_TOKENS · CC_CONTEXT_ROTATE_TOKENS.
"""
import glob, json, os, re, shutil, subprocess, sys, time

STATE = os.path.expanduser("~/.cc/state")
DEV = os.path.expanduser("~/dev")
STATUSLINE_DIR = os.environ.get("CC_STATUSLINE_DIR") or os.path.join(STATE, "statusline")
STATUSLINE_MAX_AGE = 120   # seconds: fresher is trusted as this turn's; older is a session that has moved on
LISTED_MAX_AGE = 86400     # --all: a file older than a day is a session that is gone
PROJECTS = os.path.expanduser("~/.claude/projects")
WORKTREES = os.path.expanduser("~/.cc/worktrees")   # <repo>/<track>: every track's own tree, and nothing else lives here
BIN = os.path.dirname(os.path.realpath(__file__))
DEFAULT_WINDOW = 200_000
BIG_WINDOW = 1_000_000
TAIL = 256 * 1024          # enough for many turns; grown when no assistant entry is in it
MAX_TAIL = 32 * 1024 * 1024
ADDRESS_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,63})?$")


def cfg(name, default):
    """A number from the environment, else ~/.cc/config — through cc-config, which applies that precedence
    for every tool on the box and never sources the file (it holds tokens)."""
    try:
        r = subprocess.run([os.path.join(BIN, "cc-config"), "get", name], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=10)
        v = r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        v = None
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def handoff_line():
    """The hand-off line in tokens: CC_CONTEXT_HANDOFF_TOKENS, env else ~/.cc/config, default 150k."""
    return cfg("CC_CONTEXT_HANDOFF_TOKENS", 150000)


def rotate_line():
    """The rotate line in tokens: CC_CONTEXT_ROTATE_TOKENS, env else ~/.cc/config, default 200k; 0 switches the
    box's rotation off."""
    return cfg("CC_CONTEXT_ROTATE_TOKENS", 200000)


def judge(m):
    """Add the lines and the level to a measurement: level is "handoff" at or past the hand-off line, else None;
    rotate is True at or past the rotate line (never when that line is 0)."""
    m["handoff_line"] = handoff_line()
    m["level"] = "handoff" if m["used"] >= m["handoff_line"] else None
    m["rotate_line"] = rotate_line()
    # "a seat over the hard line is handed off ... a seat under the line is untouched" (the brief): at the line counts as over
    m["rotate"] = bool(m["rotate_line"] > 0 and m["used"] >= m["rotate_line"])
    return m


# ---- the transcript estimate ---------------------------------------------------------------------------

def human(n):
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M".replace(".0M", "M")
    if n >= 1000:
        return f"{round(n/1000)}k"
    return str(n)

def tail_lines(path, nbytes):
    """The last <=nbytes of a file as whole lines (a truncated first line is dropped)."""
    with open(path, "rb") as f:
        size = f.seek(0, 2)
        start = max(0, size - nbytes)
        f.seek(start)
        buf = f.read()
    if start:
        buf = buf.split(b"\n", 1)[1] if b"\n" in buf else b""
    return [l for l in buf.decode("utf-8", "replace").split("\n") if l.strip()]

def scan(lines):
    """Last assistant usage, last compact boundary, last cost-state, the session's cwd."""
    usage = model = None
    compact = cost_models = cwd = None
    seen_assistant_at = compact_at = -1
    for i, line in enumerate(lines):
        if '"' not in line:
            continue
        try:
            d = json.loads(line)
        except Exception:
            continue                                   # a half-written last line is normal while a session runs
        if not isinstance(d, dict) or d.get("isSidechain"):
            continue
        cwd = d.get("cwd") or cwd
        t = d.get("type")
        if t == "assistant":
            m = d.get("message") or {}
            u = m.get("usage") or {}
            if u:
                usage, model, seen_assistant_at = u, m.get("model"), i
        elif t == "system" and d.get("subtype") == "compact_boundary":
            compact, compact_at = d.get("compactMetadata") or {}, i
        elif t == "cost-state":
            mu = d.get("modelUsage") or {}
            if mu:
                cost_models = list(mu)
    return usage, model, compact, compact_at, seen_assistant_at, cost_models, cwd

def window_from_model(model):
    return BIG_WINDOW if model and "[1m]" in model else DEFAULT_WINDOW

def family(model):
    m = re.search(r"fable|opus|sonnet|haiku", model or "", re.I)
    return m.group(0).lower() if m else None

def process_model(session_id, cwd=None):
    """The --model a live session was launched with — the only place the [1m] suffix survives.
    By session id when the command line carries one; otherwise by cwd, which is how a headless
    worker is found (it is given no --session-id at all). Ambiguous cwd -> no answer."""
    by_cwd = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read().decode("utf-8", "replace").split("\0")
        except OSError:
            continue
        if not cmd or "claude" not in os.path.basename(cmd[0]):
            continue
        model = None
        for i, a in enumerate(cmd):
            if a == "--model" and i + 1 < len(cmd):
                model = cmd[i + 1]
            elif a.startswith("--model="):
                model = a.split("=", 1)[1]
        if not model:
            continue                                   # says nothing about the window; and a `grep <sid>` is not a session
        if session_id and session_id in cmd:
            return model
        try:
            if cwd and os.readlink(f"/proc/{pid}/cwd") == cwd:
                by_cwd.append(model)
        except OSError:
            continue
    return by_cwd[0] if len(set(by_cwd)) == 1 else None

_BOX = {}   # the answer below, asked once per run: --all measures every live track, and a fork per row cost 2 s of `cc ls`

def box_model():
    """What the box starts sessions with now: the model override, else the settings default.
    CC_CTX_BOX_MODEL overrides both (empty = don't ask the box; the selfcheck sets it)."""
    v = os.environ.get("CC_CTX_BOX_MODEL")
    if v is not None:
        return v or None
    if "m" not in _BOX:
        m = None
        try:
            m = subprocess.run([os.path.join(BIN, "cc-model"), "current"],
                               capture_output=True, text=True, timeout=10).stdout.strip() or None
        except Exception:
            pass
        if not m:
            try:
                with open(os.path.expanduser("~/.claude/settings.json")) as f:
                    m = (json.load(f).get("model") or "").strip() or None
            except Exception:
                m = None
        _BOX["m"] = m
    return _BOX["m"]

def measure(path, session_id=None):
    """{used, window, pct, ...} for a transcript, or None when it holds no usable turn yet."""
    n = TAIL
    while True:
        lines = tail_lines(path, n)
        usage, model, compact, compact_at, assistant_at, cost_models, cwd = scan(lines)
        if usage or compact or n >= MAX_TAIL or n >= os.path.getsize(path):
            break
        n *= 8
    if not usage and not compact:
        return None
    used = 0
    if usage:
        used = (usage.get("input_tokens", 0) + usage.get("cache_creation_input_tokens", 0)
                + usage.get("cache_read_input_tokens", 0))
    compacted = False
    if compact and compact_at > assistant_at and compact.get("postTokens"):
        used, compacted = compact["postTokens"], True     # the pre-compact number describes a context that is gone

    window, src = None, None
    env = os.environ.get("CC_CTX_WINDOW")
    if env and env.isdigit():
        window, src = int(env), "env"
    if window is None and compact and compact.get("preTokens"):
        pre = compact["preTokens"]                        # where this very session hit the wall: the best evidence there is
        window, src = (BIG_WINDOW if pre > DEFAULT_WINDOW * 1.25 else DEFAULT_WINDOW), "compacted"
    if window is None and cost_models:
        window, src = max(window_from_model(m) for m in cost_models), "cost-state"
    if window is None:
        pm = process_model(session_id, cwd)
        if pm:
            window, src, model = window_from_model(pm), "process", pm
    if window is None:
        bm = box_model()
        if bm and family(bm) and family(bm) == family(model):   # same family, so the same window; a different one says nothing
            window, src, model = window_from_model(bm), "cc-model", bm
    if src in ("process", "cost-state"):
        bm = box_model()                                  # the box runs ONE model family, and it runs it at one size:
        if bm and family(bm) == family(model) and window_from_model(bm) > window:   # a headless worker is launched
            window, src = window_from_model(bm), src + "+cc-model"                  # `--model claude-opus-5`, no suffix
    if window is None:
        window, src = DEFAULT_WINDOW, "assumed"
    if used > window:                                     # evidence beats every assumption above it
        window, src = BIG_WINDOW if used <= BIG_WINDOW else used, src + "+observed"
    return {"used": used, "window": window, "pct": round(100.0 * used / window, 1),
            "model": model, "window_src": src, "compacted": compacted,
            "transcript": path, "session_id": session_id,
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


# ---- the status line's own number ----------------------------------------------------------------------
# cc-statusline (Claude Code's own statusLine command) writes ~/.cc/state/statusline/<session-id>.json every
# turn from the harness's OWN figures. Preferred over measure()'s transcript estimate whenever it exists and is
# fresh enough to describe the CURRENT turn — trusting the file's own pct: asking for the real number and then
# recomputing it here would be the estimate again with extra steps.

def statusline_measure(sid):
    """{used, window, pct, model, window_src: "statusline", ...} from that session's own status-line file, or
    None when there is no session id, no file, the file is stale, or it holds nothing usable yet (a session
    barely started writes used/window/pct as null)."""
    if not sid:
        return None
    path = os.path.join(STATUSLINE_DIR, sid + ".json")
    try:
        mtime = os.path.getmtime(path)
        with open(path) as f:
            d = json.load(f)
    except Exception:
        return None
    if time.time() - mtime > STATUSLINE_MAX_AGE:
        return None
    used, window, pct = d.get("used"), d.get("window"), d.get("pct")
    if not isinstance(used, (int, float)) or not isinstance(window, (int, float)) or window <= 0 \
            or not isinstance(pct, (int, float)):
        return None
    return {"used": int(used), "window": int(window), "pct": float(pct),
            "model": d.get("model"), "window_src": "statusline", "compacted": False,
            "transcript": None, "session_id": sid,
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}


# ---- finding a session's transcript ------------------------------------------------------------

def transcript_for_session(sid):
    hits = glob.glob(os.path.join(PROJECTS, "*", sid + ".jsonl"))
    return max(hits, key=os.path.getmtime) if hits else None

def transcript_for_cwd(cwd, since=0):
    """The newest transcript written from that cwd; `since` (an epoch, 0 = no bound) drops one last written
    before it — see newest_in()."""
    d = os.path.join(PROJECTS, re.sub(r"[/.]", "-", os.path.realpath(cwd)))
    hits = [p for p in glob.glob(os.path.join(d, "*.jsonl")) if not since or os.path.getmtime(p) >= since]
    return max(hits, key=os.path.getmtime) if hits else None

def board_get(repo, track, field):
    try:
        r = subprocess.run([os.path.join(BIN, "cc-board"), "get", repo, track, field],
                           capture_output=True, text=True, timeout=35)   # past cc-board's LOCK_WAIT (30 s): a lock held from inside a member workspace is refused there, not cut off here
        return r.stdout.strip()
    except Exception:
        return ""

def resolve(repo=None, track=None, sid=None, cwd=None):
    """-> (transcript_path, session_id) or (None, None)."""
    if sid:
        return transcript_for_session(sid), sid
    if not (repo and track):
        # A BARE RUN FROM INSIDE A SESSION IS ABOUT THAT SESSION. The harness exports its id into every tool
        # call it makes, and "the newest transcript for this cwd" is whichever of two sessions sharing the
        # directory wrote last: during an overlap the successor's first `cc-context` reported the
        # predecessor's 154k / 15% "hand off" as its own (2026-09-09, raised-handoff-fires-on-a-stale-session-id).
        mine = os.environ.get("CLAUDE_CODE_SESSION_ID") or ""
        p = transcript_for_session(mine) if mine else None
        if p:
            return p, mine
    if repo and track:
        sid = board_get(repo, track, "session_id")
        p = transcript_for_session(sid) if sid else None
        if not p:
            p = transcript_for_cwd(os.path.join(WORKTREES, repo, track))
        return p, (sid or None)
    p = transcript_for_cwd(cwd or os.getcwd())
    return p, (os.path.basename(p)[:-6] if p else None)

def track_of(cwd):
    """(repo, track) off the .cc/track marker at cwd OR IN ANY DIRECTORY ABOVE IT, the way cc-guard walks. A
    session's cwd is often a subdirectory of its worktree (~/.cc/worktrees/<repo>/<track>/core); read only at
    the raw cwd, the marker was missed, and the row printed `- -` for a track that is right there."""
    d = os.path.realpath(cwd)
    while True:
        try:
            with open(os.path.join(d, ".cc/track")) as f:
                repo, track = [l.strip() for l in f.read().splitlines()[:2]]
                return repo, track
        except Exception:
            pass
        parent = os.path.dirname(d)
        if parent == d:
            return None, None
        d = parent



# ---- the sessions with a status-line file, for --all and for `cc-context <repo>` ----------------------------

def named(cwd):
    """(repo, track) a cwd names: a track's worktree by its .cc/track marker, a checkout under ~/dev by its
    directory name (track None), else (None, None)."""
    if not cwd:
        return None, None
    repo, track = track_of(cwd)
    if repo:
        return repo, track
    dev = os.path.realpath(DEV) + "/"
    rc = os.path.realpath(cwd)
    if rc.startswith(dev):
        return rc[len(dev):].split("/", 1)[0], None
    return None, None


def track_rows(now, seen):
    """The live tracks --all would otherwise miss: a headless `claude -p` worker — every `--go` track — draws no
    status line and writes no file, so the transcript in its worktree's own project dir is the only number there
    is. One row per track worktree not already `seen` whose newest transcript answered inside LISTED_MAX_AGE."""
    rows = []
    for wt in glob.glob(os.path.join(WORKTREES, "*", "*")):
        repo, track = os.path.basename(os.path.dirname(wt)), os.path.basename(wt)
        if (repo, track) in seen:
            continue                      # its own status-line file is the better number, stale or not
        try:
            p = transcript_for_cwd(wt)
            if not p:
                continue
            mtime = os.path.getmtime(p)
            if now - mtime > LISTED_MAX_AGE:
                continue                  # a worktree nobody has worked in since yesterday is not a session
            m = measure(p, os.path.basename(p)[:-6])
        except OSError:
            continue                      # its transcript went between the glob and the read (a worktree removed, a session
                                          # rotated): one gone row, not an --all that dies and prints none of the others
        if not m:
            continue
        rows.append({"session_id": m["session_id"], "repo": repo, "track": track, "cwd": wt, "used": m["used"],
                     "window": m["window"], "pct": m["pct"], "model": m.get("model"), "src": "transcript",
                     "age": int(now - mtime), "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(mtime))})
    return rows


def sessions(tracks=False):
    """Every status-line file under LISTED_MAX_AGE with a usable number, newest first: session_id, repo,
    track, cwd, used, window, pct, model, src, age, ts (ISO-8601 UTC of the file's own mtime — the session's last
    activity, which age is measured from). A file that holds nulls (a session barely started) is skipped.
    With tracks=True (--all), a live track worktree with no status-line file is added from its transcript."""
    rows = []
    now = time.time()
    for p in glob.glob(os.path.join(STATUSLINE_DIR, "*.json")):
        try:
            mtime = os.path.getmtime(p)
            with open(p) as f:
                d = json.load(f)
        except Exception:
            continue
        age = now - mtime
        if age > LISTED_MAX_AGE or not isinstance(d, dict):
            continue
        used, window, pct = d.get("used"), d.get("window"), d.get("pct")
        if not isinstance(used, (int, float)) or not isinstance(window, (int, float)) or window <= 0 \
                or not isinstance(pct, (int, float)):
            continue
        cwd = (d.get("raw") or {}).get("cwd") or ""
        repo, track = named(cwd)
        rows.append({"session_id": d.get("session_id") or os.path.basename(p)[:-5], "repo": repo, "track": track,
                     "cwd": cwd, "used": int(used), "window": int(window), "pct": float(pct),
                     "model": d.get("model"), "src": "statusline", "age": int(age),
                     "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(mtime))})
    if tracks:
        rows += track_rows(now, {(r["repo"], r["track"]) for r in rows})
    rows.sort(key=lambda r: r["age"])
    return rows


def newest_in(cwd, since=0):
    """The session id of the newest status-line file whose cwd is this directory, or None. `since` (an epoch,
    0 = no bound) drops a session whose last activity predates it: a seat carrying no session id is measured
    by its checkout, and a session that stopped writing before that seat started is not that seat."""
    want, now = os.path.realpath(cwd), time.time()
    for r in sessions():
        if since and now - r["age"] < since:
            continue
        if r["cwd"] and os.path.realpath(r["cwd"]) == want:
            return r["session_id"]
    return None


def line(m):
    s = f"{m['pct']:.0f}%  {human(m['used'])}/{human(m['window'])}"
    if m.get("model"):
        s += f"  {m['model']}"
    s += f"  window from {m['window_src']}"
    if m["window_src"] == "assumed":
        s += " — NO evidence for the window, so the % may be wrong"
    if m.get("compacted"):
        s += "  (just compacted)"
    if m.get("level"):
        s += f"  — hand off (past the {human(m['handoff_line'])} line)"
    if m.get("rotate"):
        s += f"; past the {human(m['rotate_line'])} rotate line too, so the box hands it off"
    return s


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    as_json = quiet = do_all = False
    over = since = None
    path = sid = repo = track = None
    args = []
    while argv:
        a = argv.pop(0)
        if a == "--json":
            as_json = True
        elif a in ("-q", "--quiet"):
            quiet = True
        elif a == "--all":
            do_all = True
        elif a == "--over":
            over = float(argv.pop(0)) if argv and not argv[0].startswith("-") and argv[0][:1].isdigit() \
                else "line"                       # bare --over = the hand-off line
        elif a == "--transcript":
            path = argv.pop(0)
        elif a == "--session":
            sid = argv.pop(0)
        elif a == "--since":
            v = argv.pop(0) if argv else ""
            if not re.match(r"^\d+(\.\d+)?$", v):
                print(f"cc-context: --since takes an epoch in seconds, not '{v}'", file=sys.stderr)
                return 2
            since = float(v)
        elif a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        elif a.startswith("-"):
            print(f"cc-context: unknown option {a}", file=sys.stderr)
            return 2
        else:
            args.append(a)
    if len(args) >= 2:
        repo, track = args[0], args[1]
    elif len(args) == 1:
        if not ADDRESS_RE.match(args[0]):
            print(f"cc-context: '{args[0]}' is not <repo>, <repo>/<track> or <repo> <track> (an orchestrator "
                  f"shares its checkout: `cc-context <repo>` is the newest session there)", file=sys.stderr)
            return 2
        repo, track = (args[0].split("/", 1) + [None])[:2]

    if do_all:
        hl = handoff_line()
        rows = []
        for r in sessions(tracks=True):
            over = r["used"] >= hl
            rows.append({"repo": r["repo"] or "-", "track": r["track"] or "-", "pct": r["pct"], "used": r["used"],
                         "window": r["window"], "src": r["src"], "age": r["age"],
                         "level": "handoff" if over else None, "ts": r["ts"]})
        if as_json:
            print(json.dumps(rows, indent=2))
        else:
            for row in rows:
                print(f"{row['repo']}\t{row['track']}\t{row['pct']:.0f}\t{row['used']}\t{row['window']}"
                      f"\t{row['src']}\t{row['age']}\t{row['level'] or '-'}\t-")
        return 0

    if not path:
        if repo and not track:                    # the newest session in that checkout, by its status-line file
            cwd = os.path.join(DEV, repo)
            sid = sid or newest_in(cwd, since or 0)     # --since: only what has been written since then is this seat
            path = transcript_for_session(sid) if sid else transcript_for_cwd(cwd, since or 0)
            sid = sid or (os.path.basename(path)[:-6] if path else None)
        else:
            path, sid = resolve(repo, track, sid)
    m = statusline_measure(sid)
    if not m:
        if not path or not os.path.exists(path):
            if not quiet:
                what = f"{repo}/{track}" if track else (repo or sid or os.getcwd())
                print(f"cc-context: no transcript for {what}", file=sys.stderr)
            return 2
        m = measure(path, sid)
        if not m:
            if not quiet:
                print(f"cc-context: {path} has no answered turn yet", file=sys.stderr)
            return 2
    judge(m)
    if as_json:
        print(json.dumps(m, indent=2))
    elif not quiet:
        print(line(m))
    if over is not None:
        if over == "line":
            return 0 if m["level"] else 1
        return 0 if m["pct"] >= over else 1
    return 0


# ---- selfcheck ---------------------------------------------------------------------------------

def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-context.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-context.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


if __name__ == "__main__":
    try:
        rc = main(sys.argv[1:])
        sys.stdout.flush()   # inside the try: a small output sits in the buffer until here
    except BrokenPipeError:
        # the reader left early (`| grep -q`): point stdout at /dev/null, or Python's own flush at exit hits the
        # same closed pipe and the exit becomes 120, which a caller under pipefail reads as a failure
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        rc = 0
    sys.exit(rc)
