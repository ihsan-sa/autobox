#!/usr/bin/env python3
"""prompt-mirror — an editable copy of every prompt the box gives an agent, in five folders, synced both ways.

  prompt-mirror sync        one pass each way (what the path unit runs, on a save in the mirror or a change in git)
  prompt-mirror list        each draft and the file it feeds, as the README says it
  prompt-mirror selfcheck   the sync both ways, on throwaway repositories

THE MIRROR is ~/prompts (PROMPT_MIRROR moves it): one draft per prompt, named <repo>.<path with / as .>, in one of
five folders (FOLDERS below), and a README at the top saying which file feeds which agent and when git last changed
it. 1-start-here holds the few prompts every agent of a kind reads (START_HERE), 2-hive and 3-box the rest of the
hive's and of this box's own repo (the one CC_BOX names), 4-projects every other repo's, and 5-quiet those of a repo
with no commit in QUIET_DAYS. Five folders and nothing deeper, because a systemd path unit watches one directory and
not a tree: the unit carries a PathChanged line for each folder, and the selfcheck fails if its lines and FOLDERS
disagree. The prompts are found, not listed: in each git checkout under ~/dev (PROMPT_MIRROR_DEV), the tracked
files named like a prompt (PATTERNS below), outside docs/ and tests/. A repo the box adds, and a prompt a PR adds, show up on the next pass. A member's workspace
(~/dev/<handle> with ~/.cc/members/<handle>, or its own .cc/member-workspace marker) is left out entirely, git
included, and so is a member-facing repo (recorded as cc-perms reads it, or its own .cc/member-facing marker). Only a regular file reached through no link and at most MAX_BYTES (256 KiB) is read, so a link, a FIFO
or a device at a prompt's path is skipped, and a PR never writes through a link the default branch carries.

THE STATE is ~/prompts/.state/map.json: per draft, its source (repo, path), `dir` (the folder it is in), `base` (the
source text the draft was last made from) and `sent` (the draft text last opened as a PR). Four rules, and nothing
else decides:
  · git → mirror: a draft still equal to its base is unedited, so a source that moved replaces it (and the base).
    A draft that differs from its base is being edited and is NEVER written over by a change in git.
  · mirror → git: an edited draft that is not what was last sent opens (or updates) a PR: a branch
    prompt-mirror/<draft> cut from the repo's default branch, the draft copied over its source, pushed, `gh pr
    create`, `cc-land queue <repo> <pr>`, and the PR link to Slack (cc-notify). A second save while that PR is
    open force-pushes the same branch, so one draft is one PR. If the source moved since the draft was made, the
    edit is carried onto it with `git merge-file` in the PR, so the PR reverts nothing git did meanwhile; on a
    clash nothing is pushed and he is told how to start over. Either way the draft itself is never written.
  · landed: a sent draft whose edit git now carries (merging it onto the source changes nothing) becomes the
    source's text, others' changes included, and follows git again. Until then it is left exactly as he saved it.
  · folders: a draft is made in its folder, and an unedited one moves when that changes (its repo went quiet). An
    edited draft NEVER moves, so the file he has open stays put; its PR branch is named for the draft, not the
    folder. The one exception is leaving the old flat mirror: an entry with no `dir` is at the top, and the first
    pass moves it into its folder whatever it holds. A file at the top the state does not know is left alone.
A draft not where its `dir` says (a pass killed after a move, before the state was saved) is looked for in every
folder and at the top, and taken up where it is found. A draft deleted by hand comes back from git, which is also
how an edit is dropped. A draft it cannot read (a link, not UTF-8, over MAX_BYTES), or one map.json has no entry for
(the state was lost), is left as it is and logged unless it already is git's text; and a move never replaces a draft
of the same name. A source that left git takes
its draft with it unless the draft is edited, which is then left alone and never pushed. Passes repeat until one
finds nothing to do, so a save made while a PR was being opened is not lost to the path unit's single trigger.
"""
import fcntl, json, os, shutil, signal, socket, stat, subprocess, sys, tempfile, time

BIN = os.path.dirname(os.path.realpath(__file__))
PATTERNS = ["*CLAUDE.md", "*-prompt.md", "prompts/*.md", "*/prompts/*.md", "*/agents/*.md", "*/self-review.md",
            ":(glob).dispatch/*.md"]   # the last: a repo's own hive briefs, which the hive reads before its own
HIVE = "dispatch"
REPO_PATTERNS = {   # prompts a repo names its own way: the hive's, which every lead and run starts from
    HIVE: ["philosophy.md", ":(glob)briefs/*.md", "host/improve.md", "judge/policy.md", "tribunal/rules.md",
                 ":(glob)warden/control/*.md"],
}
SKIP = ("docs/", "tests/", "fixtures/")
MAX_BYTES = 256 * 1024   # the largest real prompt is ~/CLAUDE.md's source at under 7 KB; anything near this is not a prompt


def env_path(var, default):
    return os.path.expanduser(os.environ.get(var) or default)


def mirror_dir():
    return env_path("PROMPT_MIRROR", "~/prompts")


def dev_dir():
    return env_path("PROMPT_MIRROR_DEV", "~/dev")


def tool(var, name):   # CC_GH / CC_LAND / CC_NOTIFY: test hooks; the box's own copies otherwise
    return os.environ.get(var) or (name if name == "gh" else os.path.join(BIN, name))


def git(repo, *args, check=True):
    r = subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True)
    if check and r.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.strip()}")
    return r


def log(msg):
    print(f"prompt-mirror: {msg}", file=sys.stderr)


def read(p, cap=MAX_BYTES):   # a regular file's text, or None: never through a link, never a FIFO or device, never past cap
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:   # missing, or a link (ELOOP); O_NONBLOCK keeps a FIFO from waiting for a writer
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > cap:
            return None
        data = b""
        while len(data) <= cap and (chunk := os.read(fd, 1 << 16)):
            data += chunk
    finally:
        os.close(fd)
    if len(data) > cap:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def member_workspace(dev, repo):   # ~/dev/<handle> is a member's, and a member-facing repo is shared with members:
    # both are written from inside a sandbox, so never read, never run git in. The records are cc-perms' own
    return any(os.path.lexists(p) for p in (
        os.path.join(env_path("PROMPT_MIRROR_MEMBERS", "~/.cc/members"), repo),
        os.path.join(env_path("PROMPT_MIRROR_MF", "~/.cc/member-facing"), repo),
        os.path.join("/var/lib/cc/member-facing", repo),
        os.path.join(dev, repo, ".cc", "member-workspace"), os.path.join(dev, repo, ".cc", "member-facing")))


def plain_file(rd, path):   # a regular file reached through no link at any depth, and small enough to be a prompt
    full = os.path.join(rd, path)
    try:
        st = os.lstat(full)
    except OSError:
        return False
    return (stat.S_ISREG(st.st_mode) and st.st_size <= MAX_BYTES
            and os.path.realpath(full) == os.path.join(os.path.realpath(rd), path))


def write(p, text):   # whole or not at all: an editor watching the file never sees half of it
    d = os.path.dirname(p)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".pm-")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, p)


def sources():   # → {draft name: (repo name, repo dir, path)}
    out, dev = {}, dev_dir()
    for repo in sorted(os.listdir(dev)) if os.path.isdir(dev) else []:
        rd = os.path.join(dev, repo)
        if repo.startswith(".") or os.path.islink(rd) or not os.path.exists(os.path.join(rd, ".git")) \
                or member_workspace(dev, repo):   # a dot dir is put away (.trash-*), not a repo anyone works in
            continue
        r = git(rd, "ls-files", "--", *PATTERNS, *REPO_PATTERNS.get(repo, []), check=False)
        for path in r.stdout.splitlines():
            if any(path.startswith(s) or f"/{s}" in path for s in SKIP) or not plain_file(rd, path):
                continue
            out[f"{repo}.{path.replace('/', '.')}"] = (repo, rd, path)
    return out


WARDEN_LIVE = " (live from /etc/dispatch-warden, so a merged edit waits for perms to install it)"
FEEDS = {   # what a source feeds, by its path's tail; the README's second column
    "config/worker-prompt.md": "every headless worker (cc-loop): its system prompt. {track} {repo} {state} {base} are filled in; line breaks become spaces",
    "config/dispatch-prompt.md": "every session kind, appended: when to use a subagent, a worker or an orch, and the model bands",
    "config/writing-prompt.md": "every session kind and the Slack tool: the writing rules",
    "config/writing-ref-prompt.md": "a worker that loads ~/CLAUDE.md (the host, its sandbox, the owner's own workspace): the one-line pointer to the writing rules",
    "config/review-prompt.md": "the lander's review gate: the one read every PR gets before it merges",
    "config/raise-prompt.md": "workers and seats: how to raise a problem with the box",
    "config/spend-prompt.md": "workers and seats: how to curb spend",
    "config/mail-prompt.md": "workers and seats: when the box sends mail",
    "config/library-prompt.md": "workers and seats: filing a PDF in the library",
    "config/ask-prompt.md": "workers and seats: where to look first, and whom to ask",
    "config/propose-prompt.md": "cc-improve: proposes the next change to try on a replay of real landings",
    "config/audit-failure-broad-prompt.md": "cc-audit's session that looks into a failure (broad pass)",
    "config/audit-failure-narrow-prompt.md": "cc-audit's session that looks into a failure (narrow pass)",
    "config/mail-route-prompt.md": "the mail router: which session an incoming mail goes to",
    "config/mail-vet-prompt.md": "the mail vetter, for an unknown sender",
    "config/mail-vet-known-prompt.md": "the mail vetter, for a known sender",
    "config/mail-vet-security-prompt.md": "the mail vetter's security pass",
    "templates/channel-CLAUDE.md": "a Slack channel's own session: its CLAUDE.md, written when the channel's directory is made",
    "templates/self-review.md": "the worker prompt's self-review: its six headings are copied into every worker's prompt",
    "templates/home/CLAUDE.md": "~/CLAUDE.md on a box with no overlay of its own (a seed, copied once)",
    "templates/home/agents/builder.md": "the builder subagent type (~/.claude/agents, copied in by install.sh)",
    "templates/home/agents/reviewer.md": "the reviewer subagent type (~/.claude/agents, copied in by install.sh)",
    "templates/home/agents/security-reviewer.md": "the security-reviewer subagent type (~/.claude/agents, copied in by install.sh)",
    "home/CLAUDE.md": "~/CLAUDE.md: every session on the box",
    "home/claude/CLAUDE.md": "~/.claude/CLAUDE.md: every session the owner runs (it imports BOX.md and OWNER.md)",
    "philosophy.md": "every hive lead and run: the rules it starts from, read from each release",
    "briefs/talk.md": "the hive lead in each project's channel: its brief",
    "briefs/ask.md": "a hive run doing one ask (an issue or a thread): its brief",
    "briefs/drain.md": "a hive run working toward a project's goals with nobody waiting: its brief",
    "briefs/continue.md": "a hive run picking up one that stopped at its limit: its brief",
    "briefs/gate.md": "a hive run fixing a branch whose gate failed on main: its brief",
    "briefs/merge.md": "a hive run finishing a merge of main that stopped on conflicts: its brief",
    "briefs/fix.md": "a hive run addressing a review's findings: its brief",
    "host/improve.md": "the hive's improve run, filed by its timer: its task",
    "judge/policy.md": "the hive's judge: the policy it reads on every ruling",
    "tribunal/rules.md": "the Tribunal's seats: their rules",
    "warden/control/brief.md": "the Warden: its brief" + WARDEN_LIVE,
    "warden/control/intake.md": "the Warden's intake judge" + WARDEN_LIVE,
    "warden/control/classify.md": "the Warden's action classifier" + WARDEN_LIVE,
}
START_HERE = {   # 1-start-here/: the few prompts every agent of a kind reads, by FEEDS key, and whose repo they are in
    "home/CLAUDE.md": "box", "home/claude/CLAUDE.md": "box", "config/worker-prompt.md": "box",
    "config/writing-prompt.md": "box", "config/dispatch-prompt.md": "box", "config/review-prompt.md": "box",
    "philosophy.md": "hive",
}
QUIET_DAYS = 21   # 5-quiet/: a repo whose newest commit is older than this. Only where a draft is shown, nothing else
FOLDERS = {   # the mirror's folders, in the README's order; the path unit has a PathChanged line for each
    "1-start-here": "The few prompts every agent of a kind reads. Start here.",
    "2-hive": "The rest of the hive's prompts.",
    "3-box": "The rest of this box's own prompts.",
    "4-projects": "Every other project's prompts.",
    "5-quiet": f"Prompts of a project with no commit in {QUIET_DAYS // 7} weeks.",
}


def feed_key(path):   # the FEEDS tail a source matches, or None
    return next((tail for tail in FEEDS if path == tail or path.endswith("/" + tail)), None)


def box_name():   # this box's own repo is named for the box: CC_BOX (env, then ~/.cc/config), else the host's short name
    r = subprocess.run([os.path.join(BIN, "cc-config"), "get", "CC_BOX", socket.gethostname().split(".")[0]],
                       capture_output=True, text=True)
    return r.stdout.strip()


def places(srcs):   # → {draft name: the folder it belongs in}
    box, quiet = box_name(), set()
    for repo, rd in {(r, d) for r, d, _ in srcs.values()}:
        ct = git(rd, "log", "-1", "--format=%ct", check=False).stdout.strip()
        if ct and time.time() - int(ct) > QUIET_DAYS * 86400:
            quiet.add(repo)
    out = {}
    for name, (repo, _, path) in srcs.items():
        kind = "hive" if repo == HIVE else "box" if repo == box else ""
        if repo in quiet:
            out[name] = "5-quiet"
        elif not kind:
            out[name] = "4-projects"
        elif START_HERE.get(feed_key(path)) == kind:
            out[name] = "1-start-here"
        else:
            out[name] = "2-hive" if kind == "hive" else "3-box"
    return out


def feeds(path):
    if (tail := feed_key(path)):
        return FEEDS[tail]
    if path.startswith(".dispatch/"):
        return f"this repo's hive runs of that kind: used instead of the hive's briefs/{os.path.basename(path)}"
    if path == "CLAUDE.md":
        return "every session working in this repo (its project CLAUDE.md)"
    if path.endswith("CLAUDE.md"):
        return "sessions working under " + (os.path.dirname(path) or ".") + "/"
    return "read by this repo's own code (grep the file name to see where)"


README_HEAD = """# Prompts

Every prompt the box gives an agent, one draft each. Edit and save: within seconds a PR opens with your change,
queues to land, and its link comes to you in Slack. Saving again while it is open updates the same PR.
You never touch git here.

- A draft you have edited is never overwritten. One you have not follows git: when a PR changes the prompt,
  the draft changes with it.
- To drop an edit, delete the draft. It comes back from git.
- If git changed the prompt while you were editing, the PR carries your edit onto the new text. If the two clash,
  no PR opens and Slack tells you so; your draft is left as you saved it. Delete it to get the current text back,
  then redo the edit.
- The drafts are sorted into the folders below. One you have edited never moves; one you have not moves when its
  folder changes, as when its project goes quiet.
- This file is rewritten on every pass, so edits to it are lost.
"""


def readme(srcs, state):   # a heading per folder, its drafts where they are, each with the day git last changed it
    out = README_HEAD
    for d, what in FOLDERS.items():
        names = sorted(n for n in srcs if state.get(n, {}).get("dir") == d)
        out += f"\n## {d}\n\n{what}\n\n| draft | feeds | last changed | source |\n|---|---|---|---|\n" if names else ""
        for n in names:
            r, rd, p = srcs[n]
            out += f"| {n} | {feeds(p)} | {git(rd, 'log', '-1', '--format=%cs', '--', p, check=False).stdout.strip()} | {r}: {p} |\n"
    return out


def default_branch(rd):
    r = git(rd, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", check=False)
    b = r.stdout.strip().removeprefix("origin/")
    return b if b and not b.startswith("track/") else "main"


def open_pr(name, repo, rd, path, text):   # → the PR url; raises on any step before the PR exists
    base = default_branch(rd)
    branch = f"prompt-mirror/{name.removesuffix('.md')}"
    git(rd, "fetch", "-q", "origin", base)
    # a scratch checkout of its own, outside ~/.cc/worktrees where every name is a track's
    wt = os.path.join(env_path("PROMPT_MIRROR_WORKTREES", "~/.cache/prompt-mirror"), repo)
    git(rd, "worktree", "remove", "--force", wt, check=False)
    shutil.rmtree(wt, ignore_errors=True)
    os.makedirs(os.path.dirname(wt), exist_ok=True)
    git(rd, "worktree", "add", "-q", "-f", "-B", branch, wt, f"origin/{base}")
    try:
        target = os.path.join(wt, path)
        # the default branch may carry the path as a link (or a link above it): writing, or making a directory,
        # through it would land outside, so this is checked before anything is made
        if os.path.realpath(os.path.dirname(target)) != os.path.dirname(os.path.join(os.path.realpath(wt), path)):
            raise RuntimeError(f"{path}: a directory above it is a link on {base}; not written")
        os.makedirs(os.path.dirname(target), exist_ok=True)
        if os.path.lexists(target) and not stat.S_ISREG(os.lstat(target).st_mode):
            raise RuntimeError(f"{path} is not a regular file on {base}; not written")
        fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        git(wt, "add", "--", path)
        if not git(wt, "diff", "--cached", "--quiet", check=False).returncode:
            return None   # already what the default branch says: nothing to propose
        git(wt, "commit", "-q", "-m", f"Prompt edit: {path}\n\nEdited in the prompt mirror as {name}.")
        git(wt, "push", "-q", "-f", "origin", f"{branch}:{branch}")
        gh = tool("CC_GH", "gh")
        r = subprocess.run([gh, "pr", "view", branch, "--json", "url,state", "-q", 'select(.state=="OPEN").url'],
                           cwd=wt, capture_output=True, text=True)
        url = r.stdout.strip() if r.returncode == 0 else ""
        if not url:
            body = (f"The owner edited `{path}` in the prompt mirror (`{name}`); `prompt-mirror` opened this PR "
                    "from his saved draft. The diff is the whole change.")
            r = subprocess.run([gh, "pr", "create", "--base", base, "--head", branch,
                                "--title", f"Prompt edit: {path}", "--body", body],
                               cwd=wt, capture_output=True, text=True)
            if r.returncode:
                raise RuntimeError(f"gh pr create: {r.stderr.strip()}")
            url = (r.stdout.strip().splitlines() or [""])[-1]
            if not url:
                raise RuntimeError("gh pr create printed no PR link")
    finally:
        git(rd, "worktree", "remove", "--force", wt, check=False)
    num = url.rstrip("/").rsplit("/", 1)[-1]
    q = subprocess.run([tool("CC_LAND", "cc-land"), "queue", repo, num], capture_output=True, text=True)
    queued = "queued to land" if q.returncode == 0 else f"NOT queued (cc-land queue said: {(q.stderr or q.stdout).strip()[:200]})"
    notify(repo, f"Your prompt edit to {path} is {url} — {queued}.")
    return url


def notify(repo, text):
    r = subprocess.run([tool("CC_NOTIFY", "cc-notify"), "-t", f"{repo} prompt-mirror", "--keep", text],
                       capture_output=True, text=True)
    if r.returncode:
        log(f"cc-notify failed ({r.returncode}): {text}")


def merge3(ours, base, theirs):   # → (merged text, 0 or the number of clashes), as git merge-file says it
    with tempfile.TemporaryDirectory() as td:
        f = [os.path.join(td, x) for x in ("ours", "base", "theirs")]
        for p, text in zip(f, (ours, base, theirs)):
            with open(p, "w", encoding="utf-8") as h:
                h.write(text)
        m = subprocess.run(["git", "merge-file", "-p", "-L", "your draft", "-L", "before", "-L", "git now", *f],
                           capture_output=True, text=True)
    return m.stdout, m.returncode


def one_pass(state, srcs, where):   # → True when it did anything (wrote or moved a draft, or opened a PR)
    md, did = mirror_dir(), False
    for name in sorted(set(state) | set(srcs)):
        st, draft, dp = state.get(name), None, None
        for d in (st.get("dir", ""), *FOLDERS, "") if st else (where[name],):   # no `dir`: the flat mirror's, at the top
            if os.path.lexists(p := os.path.join(md, d, name)):   # a pass cut short after a move saved no `dir`
                dp, draft = p, read(p)
                if st and d:
                    st["dir"] = d
                elif st:
                    st.pop("dir", None)
                break
        src = None
        if name in srcs:
            repo, rd, path = srcs[name]
            src = read(os.path.join(rd, path))
        if src is None:   # the source left git: its draft goes with it, unless it is being edited
            if st is not None and draft is not None and draft != st["base"]:
                continue
            if draft is not None and st is not None:
                os.remove(dp); did = True
            state.pop(name, None)
            continue
        if dp and draft != src and (st is None or draft is None):   # nothing says it is unedited: never written over
            log(f"{name}: left as it is, " + ("unread (a link, not UTF-8 or over 256 KiB)" if draft is None else "not in map.json"))
            continue
        if st is None or draft is None:   # new, or deleted by hand: made from git, in its folder
            write(os.path.join(md, where[name], name), src)
            state[name] = {"repo": repo, "path": path, "dir": where[name], "base": src, "sent": src}; did = True
            continue
        if st.get("dir") != where[name] and ("dir" not in st or draft == st["base"]):   # an edited draft moves only off the flat mirror
            if os.path.lexists(new := os.path.join(md, where[name], name)):
                log(f"{name}: not moved, {where[name]} already has a draft of that name")
            else:
                os.replace(dp, new)
                dp = new; st["dir"] = where[name]; did = True
        if draft == st["base"]:   # unedited: follows git
            if src != draft:
                write(dp, src); st.update(base=src, sent=src); did = True
            continue
        if draft == src:   # the edit landed
            st.update(base=src, sent=src)
            continue
        if draft == st["sent"]:   # edited and sent: its PR is open, and git merges it when it lands
            if src != st["base"] and merge3(draft, st["base"], src) == (src, 0):   # landed, with others' changes
                write(dp, src); st.update(base=src, sent=src); did = True
            continue
        # "a draft he's editing is never overwritten" (the brief): from here on the draft is only read. If git moved
        # under it, the PR gets his edit carried onto git's text, never his whole file over it; the draft stays as saved.
        text, clash = merge3(draft, st["base"], src) if src != st["base"] else (draft, 0)
        if clash:   # nothing to propose that would not undo git's change: tell him, once per save
            st["sent"] = draft; did = True
            notify(repo, f"Your edit to {path} clashes with a change made in git since you opened it, so no PR was "
                         f"opened. Delete {name} in the prompt mirror to get the current text back, then redo the edit.")
            continue
        try:
            url = open_pr(name, repo, rd, path, text)
        except (RuntimeError, OSError) as e:
            log(f"{name}: no PR — {e}")
            continue
        st["sent"] = draft; did = True
        log(f"{name}: {url or 'already on the default branch'}")
    return did


def sync():
    md = mirror_dir()
    for d in (".state", *FOLDERS):
        os.makedirs(os.path.join(md, d), exist_ok=True)
    with open(os.path.join(md, ".state", "lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        sp = os.path.join(md, ".state", "map.json")
        text = read(sp, sys.maxsize)   # no cap: every draft's text twice is far past MAX_BYTES on a real box
        if text is None and os.path.lexists(sp):   # read as empty, every edit would be written over from git
            raise SystemExit(f"prompt-mirror: {sp} is not a regular file it can read; nothing done")
        state = json.loads(text) if text is not None else {}   # an empty or broken map raises: never read as no state
        for _ in range(10):
            srcs = sources()
            busy = one_pass(state, srcs, places(srcs))
            write(sp, json.dumps(state, indent=1))
            if not busy:
                break
        rd = readme(srcs, state)
        if read(os.path.join(md, "README.md")) != rd:
            write(os.path.join(md, "README.md"), rd)
    return 0


W0 = "You are worker {track}.\nLine two.\nmiddle\nLine four.\n"
WP, BP, CP = "core/config/worker-prompt.md", "core/templates/home/agents/builder.md", "CLAUDE.md"
W, B, C = "box.core.config.worker-prompt.md", "box.core.templates.home.agents.builder.md", "box.CLAUDE.md"
BR = "prompt-mirror/box.core.config.worker-prompt"
OLD = "2020-01-01T00:00:00Z"   # a commit date far past QUIET_DAYS: a repo whose newest commit it is has gone quiet
FAKES = {   # each logs its argv to $PM_CALLS; gh keeps one PR per branch under $PM_PRS
    "gh": 'echo "gh $*" >> "$PM_CALLS"\ncase "$1 $2" in "pr view") cat "$PM_PRS/$(echo "$3" | tr / _)" 2>/dev/null || exit 1;;\n'
          '"pr create") [ -n "$PM_GH_SILENT" ] && exit 0; n=$(ls "$PM_PRS" | wc -l); u="https://example.invalid/pull/$((n+7))"; echo "$u" > "$PM_PRS/$(echo "$6" | tr / _)"; echo "$u";; esac',
    "cc-land": 'echo "land $*" >> "$PM_CALLS"',
    "cc-notify": 'echo "notify $*" >> "$PM_CALLS"',
}


def commit_at(rd, date):   # what is staged, committed as made on `date`
    os.environ["GIT_COMMITTER_DATE"] = date
    try:
        git(rd, "commit", "-qm", "dated")
    finally:
        del os.environ["GIT_COMMITTER_DATE"]


class Fixture:   # one case's own world: a remote, the live checkout under dev/, the mirror, and its own call log
    def __init__(self, root, k):
        d = self.d = os.path.join(root, f"case{k}")
        self.rd, self.md, self.calls_f = f"{d}/dev/box", f"{d}/prompts", f"{d}/calls"
        os.makedirs(f"{d}/prs")
        os.environ.update(PROMPT_MIRROR=self.md, PROMPT_MIRROR_DEV=f"{d}/dev", PROMPT_MIRROR_WORKTREES=f"{d}/wt",
                          PROMPT_MIRROR_MEMBERS=f"{d}/members", PROMPT_MIRROR_MF=f"{d}/member-facing",
                          PM_CALLS=self.calls_f, PM_PRS=f"{d}/prs")
        subprocess.run(["git", "init", "-q", "--bare", "-b", "main", f"{d}/up.git"], check=True)
        subprocess.run(["git", "clone", "-q", f"{d}/up.git", self.rd], check=True, capture_output=True)
        for p, text in {WP: W0, BP: "builder\n", CP: "project rules\n", "docs/old-prompt.md": "not a prompt\n",
                        "core/bin/tool": "code\n"}.items():
            self.put(p, text)
        self.commit("init")
        git(self.rd, "remote", "set-head", "origin", "main")
        sync()
        self.clear()

    def upstream(self, p, link):   # main gains p as a link to `link`, and the live checkout does not move
        d = f"{self.d}/other"
        if not os.path.isdir(d):
            subprocess.run(["git", "clone", "-q", f"{self.d}/up.git", d], check=True, capture_output=True)
        git(d, "pull", "-q", "origin", "main")
        shutil.rmtree(os.path.join(d, p)) if os.path.isdir(os.path.join(d, p)) else os.remove(os.path.join(d, p))
        os.symlink(link, os.path.join(d, p))
        git(d, "add", "-A"); git(d, "commit", "-qm", "link"); git(d, "push", "-q", "origin", "main")

    def put(self, p, text):
        os.makedirs(os.path.dirname(os.path.join(self.rd, p)) or self.rd, exist_ok=True)
        with open(os.path.join(self.rd, p), "w") as f:
            f.write(text)

    def commit(self, msg):
        git(self.rd, "add", "-A"); git(self.rd, "commit", "-qm", msg); git(self.rd, "push", "-q", "origin", "main")

    def land(self, p, text, msg="land"):   # a change merged in git: the live checkout moves with it
        self.put(p, text); self.commit(msg)

    def path(self, name):   # where a draft is now: in one of the folders, else at the top (the README, a flat mirror's)
        return next((p for d in FOLDERS if os.path.exists(p := f"{self.md}/{d}/{name}")), f"{self.md}/{name}")

    def drafts(self):   # → {draft: its folder}
        return {x: d for d in FOLDERS for x in os.listdir(f"{self.md}/{d}")}

    def draft(self, name):
        return read(self.path(name))

    def save(self, name, text):
        write(self.path(name), text)

    def flatten(self):   # the mirror as the flat code left it: every draft at the top, no `dir`; → that state
        sp = f"{self.md}/.state/map.json"
        flat = json.loads(read(sp, sys.maxsize))
        for x, st in flat.items():
            os.replace(f"{self.md}/{st.pop('dir')}/{x}", f"{self.md}/{x}")
        write(sp, json.dumps(flat))
        for d in FOLDERS:
            os.rmdir(f"{self.md}/{d}")
        return flat

    def repo(self, name, files, date=None):   # another checkout under dev/, its one commit made on `date` if given
        rd = f"{self.d}/dev/{name}"
        subprocess.run(["git", "init", "-q", rd], check=True)
        for p, text in files.items():
            os.makedirs(os.path.dirname(f"{rd}/{p}"), exist_ok=True)
            with open(f"{rd}/{p}", "w") as h:
                h.write(text)
        git(rd, "add", "-A")
        commit_at(rd, date) if date else git(rd, "commit", "-qm", "i")

    def calls(self):
        return read(self.calls_f) or ""

    def clear(self):
        open(self.calls_f, "w").close()

    def pushed(self, branch, p):
        git(self.rd, "fetch", "-q", "origin")
        return git(self.rd, "show", f"origin/{branch}:{p}", check=False).stdout


def selfcheck():
    n = bad = 0

    def t(label, got, want):
        nonlocal n, bad
        n += 1
        if got != want:
            bad += 1
            print(f"FAIL {label}: got {got!r}, want {want!r}")

    root = tempfile.mkdtemp(prefix="pm-sc-")
    try:
        os.environ.update(GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t",
                          GIT_COMMITTER_EMAIL="t@t", GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1",
                          CC_BOX="box")   # the fixture's repo is the box's own
        os.makedirs(f"{root}/fake")
        for name, body in FAKES.items():
            with open(f"{root}/fake/{name}", "w") as f:
                f.write("#!/bin/sh\n" + body + "\n")
            os.chmod(f"{root}/fake/{name}", 0o755)
        os.environ.update(CC_GH=f"{root}/fake/gh", CC_LAND=f"{root}/fake/cc-land", CC_NOTIFY=f"{root}/fake/cc-notify")
        k = iter(range(100))

        f = Fixture(root, next(k))
        t("the first pass mirrors each prompt straight into its folder, and no doc, no code",
          (f.drafts(), sorted(x for x in os.listdir(f.md) if not x.startswith("."))),
          ({W: "1-start-here", B: "3-box", C: "3-box"}, sorted([*FOLDERS, "README.md"])))
        t("a draft is its source's text", f.draft(W), W0)
        rm = f.draft("README.md")
        t("the README says what each draft feeds, and from where",
          ("every headless worker (cc-loop)" in rm, f"| box: {BP} |" in rm), (True, True))
        day = git(f.rd, "log", "-1", "--format=%cs").stdout.strip()
        t("…under a heading per folder that has drafts, each with the day git last changed it",
          (rm.index("## 1-start-here") < rm.index(f"| {W} |") < rm.index("## 3-box") < rm.index(f"| {B} |"),
           f"| {W} | {feeds(WP)} | {day} | box: {WP} |" in rm, "## 5-quiet" in rm), (True, True, False))
        f.save("README.md", "mine\n"); sync()
        t("the README is the tool's: an edit to it is rewritten and proposes nothing",
          (f.draft("README.md") == rm, f.calls()), (True, ""))

        ud = os.path.join(os.path.dirname(os.path.dirname(BIN)), "config", "systemd-user")
        if os.path.isdir(ud):   # the overlay that installs the path unit (core alone ships none)
            units = [read(os.path.join(ud, u)) or "" for u in os.listdir(ud) if u.endswith("prompt-mirror.path")]
            t("the path unit watches each folder, and no other: a path unit sees one directory, not a tree",
              [sorted(x.split("/", 2)[2] for x in u.splitlines() if x.startswith("PathChanged=%h/prompts/")) for u in units],
              [sorted(FOLDERS)])

        f = Fixture(root, next(k))
        f.put("home/CLAUDE.md", "live\n"); f.put("core/templates/home/CLAUDE.md", "seed\n"); f.commit("homes")
        f.repo("dispatch", {"philosophy.md": "rules\n", "briefs/talk.md": "lead\n"})
        f.repo("other", {"CLAUDE.md": "theirs\n"})
        f.repo("old", {"CLAUDE.md": "asleep\n"}, OLD)
        sync()
        want = {"box.home.CLAUDE.md": "1-start-here", W: "1-start-here", "dispatch.philosophy.md": "1-start-here",
                "dispatch.briefs.talk.md": "2-hive", "box.core.templates.home.CLAUDE.md": "3-box", C: "3-box",
                "other.CLAUDE.md": "4-projects", "old.CLAUDE.md": "5-quiet"}
        t("each kind lands in its folder: start-here by name and repo, then the hive's, the box's, others', quiet ones",
          {x: f.drafts().get(x) for x in want}, want)

        f = Fixture(root, next(k))
        mine = W0.replace("Line two.", "Line two, edited.")
        f.save(W, mine); sync(); f.clear()   # an edited draft whose PR is open
        sp = f"{f.md}/.state/map.json"
        flat = f.flatten()
        write(f"{f.md}/mine.md", "my notes\n")
        sync()
        t("migration: each draft of a flat mirror moves into its folder, the edited one too, its state only gaining `dir`",
          (f.drafts(), f.draft(W), {x: {a: v for a, v in st.items() if a != "dir"} for x, st in json.loads(read(sp, sys.maxsize)).items()},
           f.calls()), ({W: "1-start-here", B: "3-box", C: "3-box"}, mine, flat, ""))
        t("…and a file at the top the state does not know is left alone", read(f"{f.md}/mine.md"), "my notes\n")
        again = W0.replace("Line two.", "Line two, edited again.")
        f.save(W, again); sync()
        c = f.calls()
        t("…the moved draft keeps its PR: a save in its folder updates the same branch, no second PR",
          ("pr create" in c, "land queue box 7" in c, f.pushed(BR, WP)), (False, True, again))

        f = Fixture(root, next(k))
        f.flatten()
        f.save(C, "my rules\n"); f.save(W, mine)   # two edited drafts, neither sent yet, at the top of a flat mirror
        real = open_pr

        def killed(*_):   # the pass dies here, right after moving C, as under systemd's kill: no state is saved
            raise SystemExit(143)
        globals()["open_pr"] = killed
        try:
            sync()
        except SystemExit:
            pass
        finally:
            globals()["open_pr"] = real
        moved = f.drafts()
        sync()
        c = f.calls()
        t("a pass killed right after moving an edited draft: the next finds it in its folder, keeps the edit, opens its PR",
          (moved, f.drafts(), f.draft(C), f.draft(W), "--head prompt-mirror/box.CLAUDE --title" in c, f"--head {BR} --title" in c),
          ({C: "3-box"}, {W: "1-start-here", B: "3-box", C: "3-box"}, "my rules\n", mine, True, True))

        f = Fixture(root, next(k))
        os.environ["PM_GH_SILENT"] = "1"
        try:
            f.save(W, mine); sync()
        finally:
            del os.environ["PM_GH_SILENT"]
        c = f.calls()
        t("gh printing no PR link is a failed attempt, not a crash: nothing queued, the draft as saved",
          ("land queue" in c, f.draft(W)), (False, mine))
        f.clear(); sync()
        t("…and the next pass opens the PR", "land queue box 7" in f.calls(), True)

        f = Fixture(root, next(k))
        sp = f"{f.md}/.state/map.json"
        os.replace(sp, f"{sp}.real"); os.symlink(f"{sp}.real", sp)
        f.save(W, mine)
        try:
            sync(); stopped = False
        except SystemExit:
            stopped = True
        t("a state file that is a link is not followed: the pass stops, the edit untouched, nothing proposed",
          (stopped, f.draft(W), f.calls()), (True, mine, ""))
        write(sp, "")   # replaces the link with an empty file
        try:
            sync(); stopped = False
        except ValueError:
            stopped = True
        t("…and an empty one stops it too: read as no state, the edit would be written over from git",
          (stopped, f.draft(W), f.calls()), (True, mine, ""))

        f = Fixture(root, next(k))
        f.save(W, mine); sync(); f.clear()
        f.put("core/bin/tool", "code v2\n"); git(f.rd, "add", "-A"); commit_at(f.rd, OLD)   # the repo goes quiet
        sync()
        t("a repo gone quiet: its unedited drafts move to 5-quiet, the edited one stays put, and nothing is proposed",
          (f.drafts(), f.draft(W), f.calls()), ({W: "1-start-here", B: "5-quiet", C: "5-quiet"}, mine, ""))
        f.save(C, "my rules\n"); sync()
        c = f.calls()
        t("a save in a folder opens its PR, on a branch named for the draft and not its folder",
          ("gh pr create --base main --head prompt-mirror/box.CLAUDE" in c, f.pushed("prompt-mirror/box.CLAUDE", CP)),
          (True, "my rules\n"))

        f = Fixture(root, next(k))
        f.land(BP, "builder v2\n"); sync()
        t("git → mirror: an unedited draft follows git, and proposes nothing", (f.draft(B), f.calls()), ("builder v2\n", ""))

        f = Fixture(root, next(k))
        mine = W0.replace("Line two.", "Line two, edited.")
        f.save(W, mine); sync()
        c = f.calls()
        t("mirror → git: a saved draft is pushed on its own branch, cut from main", f.pushed(BR, WP), mine)
        t("…changing only its file", git(f.rd, "diff", "--name-only", "origin/main", f"origin/{BR}").stdout.split(), [WP])
        t("…a PR opened against main, queued with cc-land, its link sent to Slack",
          (f"gh pr create --base main --head {BR}" in c, "land queue box 7" in c,
           f"notify -t box prompt-mirror --keep Your prompt edit to {WP} is https://example.invalid/pull/7" in c),
          (True, True, True))
        t("…the live checkout and the draft left as they were", (read(f"{f.rd}/{WP}"), f.draft(W)), (W0, mine))
        f.clear(); sync()
        t("a pass with nothing new proposes nothing", f.calls(), "")

        f = Fixture(root, next(k))
        f.save(W, W0.replace("Line two.", "Line two, edited.")); sync(); f.clear()
        again = W0.replace("Line two.", "Line two, edited again.")
        f.save(W, again); sync()
        c = f.calls()
        t("a second save updates the same PR: no second PR, queued again", ("pr create" in c, "land queue box 7" in c), (False, True))
        t("…with the new text", f.pushed(BR, WP), again)

        f = Fixture(root, next(k))
        mine = W0.replace("Line two.", "Line two, edited.")
        f.save(W, mine); sync(); f.clear()
        f.land(WP, W0.replace("Line four.", "Line four, from git.")); sync()
        t("a draft whose PR is open is never overwritten by another change landing, and proposes nothing",
          (f.draft(W), f.calls()), (mine, ""))
        both = mine.replace("Line four.", "Line four, from git.")
        f.land(WP, both, "the PR lands, merged with that change"); sync()
        t("once git carries the edit, the draft is git's merged text", f.draft(W), both)
        later = both.replace("Line two, edited.", "Line two, later.")
        f.land(WP, later); sync()
        t("…and follows git again, proposing nothing", (f.draft(W), f.calls()), (later, ""))

        f = Fixture(root, next(k))
        mine = W0.replace("Line two.", "Line two, stale edit.")
        f.save(W, mine)
        f.land(WP, W0.replace("Line four.", "Line four, newer."))   # git moves before the save is seen
        sync()
        t("an edit saved over a draft git has since moved: the PR carries the edit onto git's text, reverting nothing",
          f.pushed(BR, WP), mine.replace("Line four.", "Line four, newer."))
        t("…and the draft is left exactly as he saved it", f.draft(W), mine)

        f = Fixture(root, next(k))
        f.save(C, "my rules\n"); f.land(CP, "their rules\n"); sync()
        c = f.calls()
        t("a clash opens no PR, tells him how to start over, and leaves the draft as saved",
          ("gh pr create" in c, "clashes" in c and f"Delete {C}" in c, f.draft(C)), (False, True, "my rules\n"))
        f.clear(); sync()
        t("…once: the next pass says nothing", f.calls(), "")
        os.remove(f.path(C)); sync()
        t("a draft deleted by hand comes back as git's text, proposing nothing", (f.draft(C), f.calls()), ("their rules\n", ""))

        f = Fixture(root, next(k))
        os.remove(f"{f.md}/.state/map.json")
        f.save(W, mine); sync()
        t("a lost map.json: an edited draft is left as it is, and nothing is proposed", (f.draft(W), f.calls()), (mine, ""))

        for label, junk in (("over 256 KiB", b"x" * (MAX_BYTES + 1)), ("not UTF-8", b"\xffmy edit\n")):
            f = Fixture(root, next(k))
            with open(f.path(W), "wb") as h:
                h.write(junk)
            f.land(WP, "git moved\n"); sync()
            with open(f.path(W), "rb") as h:
                t(f"a draft {label} is left as it is, not made again from git", (h.read(), f.calls()), (junk, ""))

        f = Fixture(root, next(k))
        write(f"{f.md}/5-quiet/{B}", "mine\n")
        f.put("core/bin/tool", "code v2\n"); git(f.rd, "add", "-A"); commit_at(f.rd, OLD)   # the repo goes quiet
        sync()
        t("a move never replaces a draft of the same name in its new folder",
          (read(f"{f.md}/5-quiet/{B}"), read(f"{f.md}/3-box/{B}")), ("mine\n", "builder\n"))

        f = Fixture(root, next(k))
        f.save(C, "kept edit\n")
        f.put("core/templates/home/agents/new.md", "new agent\n"); f.commit("new")
        git(f.rd, "rm", "-q", BP, CP); f.commit("rm")
        sync()
        t("a prompt added in git appears", f.draft("box.core.templates.home.agents.new.md"), "new agent\n")
        t("a prompt removed from git takes its unedited draft with it", os.path.exists(f.path(B)), False)
        t("…but an edited one stays, and is never pushed", (f.draft(C), "pr create" in f.calls()), ("kept edit\n", False))

        f = Fixture(root, next(k))
        secret = f"{f.d}/config-secret"
        with open(secret, "w") as h:
            h.write("TOKEN=s3cret\n")
        os.remove(f"{f.rd}/{CP}"); os.symlink(secret, f"{f.rd}/{CP}")   # a tracked prompt turned into a link
        sync()
        t("a prompt whose file is a link is not followed: its draft goes, and the linked file's text is nowhere",
          (os.path.exists(f.path(C)), any("s3cret" in (f.draft(x) or "") for x in [*f.drafts(), "README.md"])),
          (False, False))

        f = Fixture(root, next(k))
        os.remove(f"{f.rd}/{BP}"); os.mkfifo(f"{f.rd}/{BP}")   # a FIFO with no writer at a prompt's path
        signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutError()))
        signal.alarm(20)
        try:
            sync(); hung = False
        except TimeoutError:
            hung = True
        finally:
            signal.alarm(0)
        t("a FIFO at a prompt's path never hangs the pass, and is not mirrored", (hung, os.path.exists(f.path(B))), (False, False))

        f = Fixture(root, next(k))
        f.land(CP, "x" * (MAX_BYTES + 1)); sync()
        t("a file over the size limit is not a prompt: no draft", os.path.exists(f.path(C)), False)

        f = Fixture(root, next(k))
        f.land(CP, "x" * (MAX_BYTES // 2)); sync()   # its base and sent alone put the state past MAX_BYTES
        mine = W0.replace("Line two.", "Line two, edited.")
        f.save(W, mine); sync()
        t("a state larger than MAX_BYTES is still read: a save opens its PR and is not written over from git",
          (os.path.getsize(f"{f.md}/.state/map.json") > MAX_BYTES, f.draft(W), "land queue box 7" in f.calls()),
          (True, mine, True))

        f = Fixture(root, next(k))
        os.makedirs(f"{f.d}/members/alice")
        subprocess.run(["git", "clone", "-q", f"{f.d}/up.git", f"{f.d}/dev/alice"], check=True, capture_output=True)
        os.makedirs(f"{f.d}/dev/bob/.cc"); open(f"{f.d}/dev/bob/.cc/member-workspace", "w").close()
        subprocess.run(["git", "init", "-q", f"{f.d}/dev/bob"], check=True)
        with open(f"{f.d}/dev/bob/CLAUDE.md", "w") as h:
            h.write("bob\n")
        git(f"{f.d}/dev/bob", "add", "-A"); git(f"{f.d}/dev/bob", "commit", "-qm", "b")
        sync()
        t("a member's workspace is left out entirely (by its record, or by its own marker)",
          sorted(x for x in f.drafts() if x.startswith(("alice.", "bob."))), [])

        f = Fixture(root, next(k))
        f.repo("shared", {"CLAUDE.md": "shared\n"}); f.repo("marked", {"CLAUDE.md": "marked\n", ".cc/member-facing": ""})
        os.makedirs(f"{f.d}/member-facing"); open(f"{f.d}/member-facing/shared", "w").close()
        sync()
        t("a member-facing repo is left out entirely (by the host's record, or by its own marker)",
          sorted(x for x in f.drafts() if x.startswith(("shared.", "marked."))), [])

        f = Fixture(root, next(k))
        for repo, files in {".trash-old": {"CLAUDE.md": "old\n"},
                            "dispatch": {"philosophy.md": "rules\n", "briefs/talk.md": "lead\n",
                                         "briefs/notes/main.md": "notes\n", ".dispatch/drain.md": "drain\n",
                                         ".dispatch/notes/1.md": "a run's note\n", "README.md": "doc\n"},
                            "other": {"philosophy.md": "not the hive's\n"}}.items():
            f.repo(repo, files)
        sync()
        t("the hive's prompts are mirrored by name, and a repo's own hive briefs; a put-away dot dir, run notes and "
          "another repo's file of the same name are not",
          sorted(x for x in f.drafts() if not x.startswith("box.")),
          ["dispatch..dispatch.drain.md", "dispatch.briefs.talk.md", "dispatch.philosophy.md"])
        t("…and the README says what each feeds", ("every hive lead and run: the rules it starts from" in f.draft("README.md"),
          "used instead of the hive's briefs/drain.md" in f.draft("README.md")), (True, True))

        f = Fixture(root, next(k))
        target = f"{f.d}/outside"
        with open(target, "w") as h:
            h.write("untouched\n")
        f.save(C, "my rules\n")
        f.upstream(CP, target)   # main now carries CLAUDE.md as a link out of the repo; the live checkout has not moved
        sync()
        c = f.calls()
        t("a PR never writes through a link the default branch carries: the link's target is untouched, nothing pushed",
          (read(target), "pr create" in c, f.pushed(BR.replace("box.core.config.worker-prompt", "box.CLAUDE"), CP)),
          ("untouched\n", False, ""))

        f = Fixture(root, next(k))
        os.makedirs(f"{f.d}/outdir")
        f.save(B, "my builder\n")
        f.upstream("core/templates", f"{f.d}/outdir")   # main carries a directory above the prompt as a link out
        sync()
        t("a PR makes no directory through a link above the path: the link's target stays empty, nothing pushed",
          (os.listdir(f"{f.d}/outdir"), "pr create" in f.calls()), ([], False))
    finally:
        shutil.rmtree(root, ignore_errors=True)
    print(f"prompt-mirror selfcheck: {n - bad} passed, {bad} failed")
    return 1 if bad else 0


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ""
    if cmd == "sync":
        return sync()
    if cmd == "list":
        for n, (r, _, p) in sorted(sources().items()):
            print(f"{n}\t{feeds(p)}\t{r}: {p}")
        return 0
    if cmd == "selfcheck":
        return selfcheck()
    print(__doc__.split("\n\n")[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
