#!/usr/bin/env python3
"""cc-subagent-bound — a subagent's context has a bound, the way a seat's hand-off line bounds a seat.

  cc-subagent-bound hook < payload.json     PreToolUse, every tool: a subagent's first call past the save line is
                                            refused once with an order to write its deliverable now; its call past
                                            the bound is refused with an order to save its work and return a report
  cc-subagent-bound measure [--since YYYY-MM-DD] [--over TOKENS]
                                            the spend figure the bound is judged by, over ~/.claude/projects/*/*/
                                            subagents/agent-*.jsonl touched since that day (UTC, default 7 days ago)
  cc-subagent-bound selfcheck               fixture transcripts and payloads in a HOME of their own

WHY. A seat hands off near 150k (cc-context) and a worker starts fresh every cc-loop iteration, but a subagent had
no bound at all, and every call re-reads its whole context as cache, so its cost grows with the square of its
length. Since 2026-09-24, 18 of 615 subagent transcripts grew past 300k and carried 3.9B of the 6.6B cache-read
tokens all subagents read; one Sonnet builder made 2070 calls and reached 966k.

THE RULE. The hook acts only on a payload carrying agent_id, which the harness sets on a subagent's own tool calls
and never on a session's. It reads that subagent's transcript (agent_transcript_path when the payload has one,
else <transcript_path minus .jsonl>/subagents/agent-<agent_id>.jsonl) and takes USED as cc-context does: the last
assistant entry's input + cache_creation + cache_read, or a later compact_boundary's postTokens.
  used < SAVE                    nothing: no output, the call runs
  SAVE <= used < BOUND, first    the call is REFUSED once with the save order (write what you have to the
                                 deliverable file now and keep writing as you go; the next calls run normally);
                                 the save is claimed by an atomic create of <session>-<agent>.json.saved beside
                                 the per-agent file below, so it never fires twice, even for parallel calls
  SAVE <= used < BOUND, saved    nothing: the call runs
  used >= BOUND, first time      the call is REFUSED with the wrap-up order (save the work in the worktree and a
                                 progress file there, then end the turn with a report the parent can re-spawn from);
                                 the crossing is recorded in ~/.cc/state/subagent-bound/<session>-<agent>.json
  crossed, used < crossed+GRACE  the call runs: this is the room to commit and write the report
  crossed, used >= crossed+GRACE every call is refused: end the turn now. Ending a turn needs no tool, so the report
                                 still reaches the parent and nothing the subagent wrote is lost.
BOUND is CC_SUBAGENT_CONTEXT_TOKENS (env, else ~/.cc/config; default 150000, the seat's hand-off figure; 0 = off),
GRACE is CC_SUBAGENT_WRAPUP_TOKENS (default 30000). SAVE is CC_SUBAGENT_SAVE_TOKENS (default 60% of BOUND, so 90000;
0 = off): a long reader that has written nothing by the bound has only GRACE left to write a large deliverable, and
at 60% it still has 60k of room to write it. At the bound counts as past it. No model call is made, and any error
decides nothing: a hook that cannot read its input or transcript, or cannot record the save, leaves the call alone.

MEASURE prints, per the method the brief used: the files, the sum of cache_read_input_tokens over every assistant
line, the count of files whose largest context passed --over (default 300000) and their share of that sum. The
harness logs one message's usage once per content block, so that sum counts a turn more than once; the same
figures deduplicated by requestId follow on a second line, which is the real spend.
"""
import datetime, fcntl, glob, json, os, re, shutil, subprocess, sys, tempfile, time

BIN = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.join(os.path.expanduser("~"), ".cc", "state", "subagent-bound")
PROJECTS = os.path.join(os.path.expanduser("~"), ".claude", "projects")
AGENT_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
TAIL = 256 * 1024
MAX_TAIL = 32 * 1024 * 1024

WRAP = ("CONTEXT BOUND: this subagent's context is {used:,} tokens, at or past the box's bound of {bound:,} "
        "(CC_SUBAGENT_CONTEXT_TOKENS), and every further call re-reads all of it. This call was NOT run. Wrap up now, "
        "and do not start new work: (1) save what you have, so leave or commit your edits in your worktree and write "
        "a short progress file there (what is done, what is left, the next step); (2) then end your turn with a final "
        "report the parent can re-spawn you from, saying you stopped at the context bound, what is done and where it "
        "is, what is left, and the exact next step. You have about {grace:,} more tokens for that; after them every "
        "tool call is refused.")
SAVE = ("SAVE NOW: this subagent's context is {used:,} tokens, {left:,} short of the box's bound of {bound:,} "
        "(CC_SUBAGENT_CONTEXT_TOKENS), where its calls start being refused. This one call was NOT run; run it again "
        "after this. First write what you have to your deliverable file now (your edits, findings or draft so far, "
        "in the worktree or the file your brief names) and keep writing to it as you go, so the work survives if you "
        "reach the bound. Your next calls run normally.")
STOP = ("CONTEXT BOUND: this subagent is {used:,} tokens in, past the bound of {bound:,} plus its {grace:,}-token "
        "wrap-up. Every tool call is refused from here. End your turn now with your final report: that you stopped "
        "at the context bound, what is done and where it is, what is left, and the exact next step.")


def cfg(name, default):
    """A number from the environment, else ~/.cc/config through cc-config (which never sources the file)."""
    v = os.environ.get(name)
    if v is None:
        try:
            r = subprocess.run([os.path.join(BIN, "cc-config"), "get", name], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=5)
            v = r.stdout.strip() if r.returncode == 0 else None
        except Exception:
            v = None
    try:
        return int(float(v))
    except (TypeError, ValueError):
        return default


def used_of(path):
    """The subagent's context now: the last assistant usage in the file's tail, or a later compact's postTokens.
    None when there is no assistant entry at all (a subagent's first call)."""
    n = TAIL
    size = os.path.getsize(path)
    while True:
        with open(path, "rb") as f:
            start = max(0, size - n)
            f.seek(start)
            buf = f.read()
        if start:
            buf = buf.split(b"\n", 1)[1] if b"\n" in buf else b""
        used = None
        for line in buf.decode("utf-8", "replace").split("\n"):
            if '"assistant"' not in line and '"compact_boundary"' not in line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue                      # a half-written last line is normal while the subagent runs
            if not isinstance(d, dict):
                continue
            if d.get("type") == "assistant":
                u = (d.get("message") or {}).get("usage") or {}
                if u:
                    used = sum(int(u.get(k) or 0) for k in
                               ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            elif d.get("type") == "system" and d.get("subtype") == "compact_boundary":
                post = (d.get("compactMetadata") or {}).get("postTokens")
                if isinstance(post, int):
                    used = post
        if used is not None or start == 0 or n >= MAX_TAIL:
            return used
        n *= 4


def transcript_of(p):
    t = p.get("agent_transcript_path")
    if isinstance(t, str) and t:
        return t
    base = p.get("transcript_path")
    if not (isinstance(base, str) and base.endswith(".jsonl")):
        return None
    return os.path.join(base[:-len(".jsonl")], "subagents", f"agent-{p['agent_id']}.jsonl")


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))


def hook(raw):
    """The decision for one payload, printed; 0 always (a deny is JSON on exit 0, never exit 2)."""
    try:
        p = json.loads(raw)
    except Exception:
        return 0
    if not isinstance(p, dict):
        return 0
    agent = p.get("agent_id")
    if not (isinstance(agent, str) and AGENT_RE.match(agent)):
        return 0                              # a session's own call: seats have cc-context, workers cc-loop
    bound = cfg("CC_SUBAGENT_CONTEXT_TOKENS", 150000)
    if bound <= 0:
        return 0
    grace = max(0, cfg("CC_SUBAGENT_WRAPUP_TOKENS", 30000))
    save = cfg("CC_SUBAGENT_SAVE_TOKENS", bound * 3 // 5)
    try:
        path = transcript_of(p)
        used = used_of(path) if path and os.path.isfile(path) else None
    except Exception:
        used = None
    if used is None:
        return 0
    sid = p.get("session_id") if isinstance(p.get("session_id"), str) and AGENT_RE.match(p["session_id"]) else "-"
    mark = os.path.join(STATE, f"{sid}-{agent}.json")
    # ONE HOOK AT A TIME PER AGENT (review of #1319): parallel tool calls fire their PreToolUse hooks together, and two
    # that both read no record would both issue the one-time save refusal. The read, the check and the write are held
    # under a per-agent flock; a lock that cannot be taken leaves the hook unlocked, and the save's O_EXCL claim below
    # still lets only one of them refuse.
    lk = None
    try:
        os.makedirs(STATE, exist_ok=True)
        lk = os.open(mark + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        fcntl.flock(lk, fcntl.LOCK_EX)
    except OSError:
        pass

    def decide():
        try:
            with open(mark) as f:
                rec = json.load(f)
            rec = rec if isinstance(rec, dict) else {}
        except Exception:
            rec = {}
        try:
            crossed = int(rec["used"])
        except Exception:
            crossed = None
        if crossed is None:
            # "a subagent past a configurable context bound ... is made to wrap up and return" (the brief): at counts as past
            if used < bound:
                if save <= 0 or used < save or "saved" in rec:
                    return 0
                # the early save: once, and only when it is recorded, or a subagent that cannot record it never runs again.
                # The claim is an O_EXCL create of <mark>.saved, atomic on its own, so only one hook can issue it even when
                # the lock above could not be taken (review of #1319: the check and the record are one step).
                time.sleep(float(os.environ.get("CC_SUBAGENT_BOUND_PAUSE") or 0))   # test hook: widens the read-to-write gap
                try:
                    os.makedirs(STATE, exist_ok=True)
                    os.close(os.open(mark + ".saved", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
                except OSError:
                    return 0                      # already claimed by another hook, or unrecordable: the call runs
                try:
                    with open(mark, "w") as f:
                        json.dump({"saved": used, "save": save, "bound": bound, "ts": int(time.time()), "transcript": path}, f)
                except OSError:
                    pass                          # the claim above already records it
                deny(SAVE.format(used=used, left=bound - used, bound=bound))
                return 0
            try:
                os.makedirs(STATE, exist_ok=True)
                with open(mark, "w") as f:
                    json.dump(dict(rec, used=used, bound=bound, ts=int(time.time()), transcript=path), f)
            except OSError:
                pass                              # unrecorded, the next call is refused the same way: never lets it run on
            deny(WRAP.format(used=used, bound=bound, grace=grace))
            return 0
        if used < crossed + grace:
            return 0
        deny(STOP.format(used=used, bound=bound, grace=grace))
        return 0

    try:
        return decide()
    finally:
        if lk is not None:
            os.close(lk)


def measure(since, over, out=sys.stdout, root=None):
    files = n_over = 0
    tot = [0, 0]
    big = [0, 0]
    for f in glob.glob(os.path.join(root or PROJECTS, "*", "*", "subagents", "agent-*.jsonl")):
        try:
            if os.path.getmtime(f) < since:
                continue
            fh = open(f, errors="replace")
        except OSError:
            continue
        files += 1
        s = [0, 0]
        peak = 0
        seen = set()
        with fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if not isinstance(d, dict) or d.get("type") != "assistant":
                    continue
                m = d.get("message") or {}
                u = m.get("usage") or {}
                cr = int(u.get("cache_read_input_tokens") or 0)
                s[0] += cr
                key = d.get("requestId") or m.get("id") or id(d)
                if key not in seen:
                    seen.add(key)
                    s[1] += cr
                peak = max(peak, int(u.get("input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0) + cr)
        tot = [tot[0] + s[0], tot[1] + s[1]]
        if peak > over:
            n_over += 1
            big = [big[0] + s[0], big[1] + s[1]]
    day = datetime.datetime.fromtimestamp(since, datetime.timezone.utc).strftime("%Y-%m-%d")
    share = lambda a, b: f"{100 * a / b:.0f}%" if b else "-"
    print(f"since {day}: {files} subagent transcripts; cache_read summed per line {tot[0] / 1e9:.2f}B; "
          f"{n_over} over {over:,} context carry {big[0] / 1e9:.2f}B ({share(big[0], tot[0])})", file=out)
    print(f"  deduplicated by requestId: {tot[1] / 1e9:.2f}B; those {n_over} carry {big[1] / 1e9:.2f}B "
          f"({share(big[1], tot[1])})", file=out)
    return files, tot, n_over, big


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-subagent-bound.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-subagent-bound.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def main(argv):
    if argv[:1] == ["hook"]:
        try:
            return hook(sys.stdin.read())
        except Exception:
            return 0
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    if argv[:1] == ["measure"]:
        since = time.time() - 7 * 86400
        over = 300000
        a = argv[1:]
        try:
            while a:
                k = a.pop(0)
                if k == "--since":
                    since = datetime.datetime.strptime(a.pop(0), "%Y-%m-%d").replace(
                        tzinfo=datetime.timezone.utc).timestamp()
                elif k == "--over":
                    over = int(a.pop(0))
                else:
                    raise ValueError(k)
        except (ValueError, IndexError):
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
        measure(since, over)
        return 0
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
