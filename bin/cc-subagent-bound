#!/usr/bin/env python3
"""cc-subagent-bound — a subagent is told once, early, to save its work as it goes; the model's window is its bound.

  cc-subagent-bound hook < payload.json     PreToolUse, every tool: a subagent's first call at or past the save line
                                            is refused once with an order to write its work now; every other call runs
  cc-subagent-bound measure [--since YYYY-MM-DD] [--over TOKENS]
                                            the spend figure long subagents are judged by, over ~/.claude/projects/*/*/
                                            subagents/agent-*.jsonl touched since that day (UTC, default 7 days ago)
  cc-subagent-bound selfcheck               fixture transcripts and payloads in a HOME of their own

WHY. A seat hands off near 150k (cc-context) and a worker starts fresh every cc-loop iteration, but a subagent had
no bound at all, and every call re-reads its whole context as cache, so its cost grows with the square of its
length. Since 2026-09-24, 18 of 615 subagent transcripts grew past 300k and carried 3.9B of the 6.6B cache-read
tokens all subagents read; one Sonnet builder made 2070 calls and reached 966k. This hook then refused a subagent's
calls past a 150k bound, with a wrap-up room after it. That refusal was cut on 2026-10-20 (owner: the box's core
keeps no count caps; the model's window is the bound). Only the one-time save nudge remains, so a long subagent
has its work on disk before anything can cut it short.

THE RULE. The hook acts only on a payload carrying agent_id, which the harness sets on a subagent's own tool calls
and never on a session's. It reads that subagent's transcript (agent_transcript_path when the payload has one,
else <transcript_path minus .jsonl>/subagents/agent-<agent_id>.jsonl) and takes USED as cc-context does: the last
assistant entry's input + cache_creation + cache_read, or a later compact_boundary's postTokens.
  used < SAVE                    nothing: no output, the call runs
  used >= SAVE, first            the call is REFUSED once with the save order (run this call again; if the brief
                                 names a file or you are editing a worktree, write what you have there now and keep
                                 writing as you go; the next calls run normally). The save is claimed by an atomic
                                 O_EXCL create of ~/.cc/state/subagent-bound/<session>-<agent>.json.saved, so it
                                 never fires twice, even for parallel calls
  used >= SAVE, saved            nothing: the call runs, however large the context grows
SAVE is CC_SUBAGENT_SAVE_TOKENS (env, else ~/.cc/config; default 90000; 0 = off). At the line counts as past it. No
model call is made, and any error decides nothing: a hook that cannot read its input or transcript, or cannot
record the save, leaves the call alone. The figure costs one cc-config call at most per hook, and only when the
environment does not set it.

NUMBER. A subagent's first call takes it the next number of the box's agent sequence (number()), kept in
<session>-<agent>.json.no, so the box's ledger counts every subagent it saw spawn. A session's own first call runs
`cc-agent-number bind` with its claude pid (kept in <session>-<pid>.json.no): the ledger then names the process that
carries the number, and a session no launcher numbered takes one there.

PRUNING. Each subagent leaves <session>-<agent>.json.lock and .json.no in the state dir, and one that got the save order also
leaves .json.saved and .json (the save's record). A hook that creates a new lock first deletes the files there
older than PRUNE_DAYS (7): no subagent runs that long, and a missing record only means a fresh save order.

MEASURE prints, per the method the brief used: the files, the sum of cache_read_input_tokens over every assistant
line, the count of files whose largest context passed --over (default 300000) and their share of that sum. The
harness logs one message's usage once per content block, so that sum counts a turn more than once; the same
figures deduplicated by requestId follow on a second line, which is the real spend.
"""
import datetime, fcntl, glob, json, os, re, shutil, subprocess, sys, tempfile, time

BIN = os.path.dirname(os.path.realpath(__file__))
STATE = os.path.join(os.path.expanduser("~"), ".cc", "state", "subagent-bound")
PROJECTS = os.path.join(os.path.expanduser("~"), ".claude", "projects")
AGENT_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
TAIL = 256 * 1024
MAX_TAIL = 32 * 1024 * 1024
PRUNE_DAYS = 7
CFG_KEYS = ("CC_SUBAGENT_SAVE_TOKENS",)
PAUSE = 0.0                                   # selfcheck only: widens the read-to-write gap; nothing else sets it

SAVE = ("SAVE NOW: this subagent's context is {used:,} tokens. This one call was NOT run; run it again after this. "
        "If your brief names a file to write, or you are editing a worktree, write what you have there now (your edits, "
        "findings or draft so far) and keep writing as you go, so the work survives if the run is cut short. If your "
        "brief says to write no files, write none. Your next calls run normally.")


_file_cfg = None


def file_cfg():
    """CFG_KEYS as ~/.cc/config sets them, from ONE cc-config call per process (it never sources the file); the
    other keys it lists are dropped here."""
    global _file_cfg
    if _file_cfg is None:
        _file_cfg = {}
        try:
            r = subprocess.run([os.path.join(BIN, "cc-config"), "list", *CFG_KEYS], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=5)
            for line in r.stdout.splitlines() if r.returncode == 0 else ():
                k, _, v = line.partition("=")
                if k in CFG_KEYS:
                    _file_cfg[k] = v.strip()
        except Exception:
            pass
    return _file_cfg


def cfg(name, default):
    """A number from the environment, else ~/.cc/config."""
    v = os.environ.get(name)
    if v is None:
        v = file_cfg().get(name)
    try:
        return int(float(v))
    except (TypeError, ValueError):
        return default


def used_of(path):
    """The subagent's context now: the last assistant usage in the file's tail, or a later compact's postTokens.
    None when there is no assistant entry at all (a subagent's first call)."""
    n = TAIL
    size = os.path.getsize(path)
    while True:
        with open(path, "rb") as f:
            start = max(0, size - n)
            f.seek(start)
            buf = f.read()
        if start:
            buf = buf.split(b"\n", 1)[1] if b"\n" in buf else b""
        used = None
        for line in buf.decode("utf-8", "replace").split("\n"):
            if '"assistant"' not in line and '"compact_boundary"' not in line:
                continue
            try:
                d = json.loads(line)
            except Exception:
                continue                      # a half-written last line is normal while the subagent runs
            if not isinstance(d, dict):
                continue
            if d.get("type") == "assistant":
                u = (d.get("message") or {}).get("usage") or {}
                if u:
                    used = sum(int(u.get(k) or 0) for k in
                               ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens"))
            elif d.get("type") == "system" and d.get("subtype") == "compact_boundary":
                post = (d.get("compactMetadata") or {}).get("postTokens")
                if isinstance(post, int):
                    used = post
        if used is not None or start == 0 or n >= MAX_TAIL:
            return used
        n *= 4


def transcript_of(p):
    t = p.get("agent_transcript_path")
    if isinstance(t, str) and t:
        return t
    base = p.get("transcript_path")
    if not (isinstance(base, str) and base.endswith(".jsonl")):
        return None
    return os.path.join(base[:-len(".jsonl")], "subagents", f"agent-{p['agent_id']}.jsonl")


def number(key, *argv):
    """Run `cc-agent-number <argv>` once per key: the O_EXCL create of <key>.json.no claims it, so parallel first calls
    take one number between them, and the file keeps it. Any error takes none."""
    try:
        os.makedirs(STATE, exist_ok=True)
        fd = os.open(os.path.join(STATE, f"{key}.json.no"), os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    except OSError:
        return
    try:
        r = subprocess.run([os.path.join(BIN, "cc-agent-number"), *argv], capture_output=True, text=True, timeout=10)
        os.write(fd, r.stdout.encode())
    except (OSError, subprocess.SubprocessError):
        pass
    os.close(fd)


def claude_pid():
    """The claude process this hook runs under: the nearest ancestor called claude, else the parent."""
    pid = os.getppid()
    for _ in range(4):
        try:
            with open(f"/proc/{pid}/comm") as f:
                if f.read().strip() == "claude":
                    return pid
            with open(f"/proc/{pid}/stat") as f:
                pid = int(f.read().rpartition(")")[2].split()[1])
        except (OSError, ValueError, IndexError):
            break
    return os.getppid()


def prune():
    """Delete the state dir's files older than PRUNE_DAYS; any error leaves that file."""
    cut = time.time() - PRUNE_DAYS * 86400
    try:
        names = os.listdir(STATE)
    except OSError:
        return
    for n in names:
        if not n.endswith((".json", ".json.lock", ".json.saved", ".json.no")):
            continue
        f = os.path.join(STATE, n)
        try:
            if os.lstat(f).st_mtime < cut:
                os.unlink(f)
        except OSError:
            pass


def deny(reason):
    print(json.dumps({"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                             "permissionDecisionReason": reason}}))


def hook(raw):
    """The decision for one payload, printed; 0 always (a deny is JSON on exit 0, never exit 2)."""
    try:
        p = json.loads(raw)
    except Exception:
        return 0
    if not isinstance(p, dict):
        return 0
    agent = p.get("agent_id")
    sid = p.get("session_id") if isinstance(p.get("session_id"), str) and AGENT_RE.match(p["session_id"]) else "-"
    if not (isinstance(agent, str) and AGENT_RE.match(agent)):
        pid = claude_pid()                    # a session's own call: bind its claude pid to its number, once
        number(f"{sid}-{pid}", "bind", os.path.basename(str(p.get("cwd") or "")) or sid, str(pid))
        return 0                              # seats have cc-context, workers cc-loop
    number(f"{sid}-{agent}", "next", "subagent", f"{os.environ.get('CC_AGENT_NO') or sid}/{agent}", "0")
    save = cfg("CC_SUBAGENT_SAVE_TOKENS", 90000)
    if save <= 0:
        return 0
    try:
        path = transcript_of(p)
        used = used_of(path) if path and os.path.isfile(path) else None
    except Exception:
        used = None
    if used is None:
        return 0
    mark = os.path.join(STATE, f"{sid}-{agent}.json")
    # ONE HOOK AT A TIME PER AGENT (review of #1319): parallel tool calls fire their PreToolUse hooks together, and two
    # that both read no record would both issue the one-time save refusal. The read, the check and the write are held
    # under a per-agent flock; a lock that cannot be taken leaves the hook unlocked, and the save's O_EXCL claim below
    # still lets only one of them refuse.
    lk = None
    try:
        os.makedirs(STATE, exist_ok=True)
        if not os.path.lexists(mark + ".lock"):
            prune()                           # once per subagent, not per call
        lk = os.open(mark + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        fcntl.flock(lk, fcntl.LOCK_EX)
    except OSError:
        pass

    def decide():
        if used < save:
            return 0
        # the save: once, and only when it is recorded, or a subagent that cannot record it would be refused forever.
        # The claim is an O_EXCL create of <mark>.saved, atomic on its own, so only one hook can issue it even when
        # the lock above could not be taken (review of #1319: the check and the record are one step).
        if PAUSE:
            time.sleep(PAUSE)
        try:
            os.makedirs(STATE, exist_ok=True)
            os.close(os.open(mark + ".saved", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
        except OSError:
            return 0                              # already claimed by another hook, or unrecordable: the call runs
        try:
            with open(mark, "w") as f:
                json.dump({"saved": used, "save": save, "ts": int(time.time()), "transcript": path}, f)
        except OSError:
            pass                                  # the claim above already records it
        deny(SAVE.format(used=used))
        return 0

    try:
        return decide()
    finally:
        if lk is not None:
            os.close(lk)


def measure(since, over, out=sys.stdout, root=None):
    files = n_over = 0
    tot = [0, 0]
    big = [0, 0]
    for f in glob.glob(os.path.join(root or PROJECTS, "*", "*", "subagents", "agent-*.jsonl")):
        try:
            if os.path.getmtime(f) < since:
                continue
            fh = open(f, errors="replace")
        except OSError:
            continue
        files += 1
        s = [0, 0]
        peak = 0
        seen = set()
        with fh:
            for line in fh:
                if '"usage"' not in line:
                    continue
                try:
                    d = json.loads(line)
                except Exception:
                    continue
                if not isinstance(d, dict) or d.get("type") != "assistant":
                    continue
                m = d.get("message") or {}
                u = m.get("usage") or {}
                cr = int(u.get("cache_read_input_tokens") or 0)
                s[0] += cr
                key = d.get("requestId") or m.get("id") or id(d)
                if key not in seen:
                    seen.add(key)
                    s[1] += cr
                peak = max(peak, int(u.get("input_tokens") or 0) + int(u.get("cache_creation_input_tokens") or 0) + cr)
        tot = [tot[0] + s[0], tot[1] + s[1]]
        if peak > over:
            n_over += 1
            big = [big[0] + s[0], big[1] + s[1]]
    day = datetime.datetime.fromtimestamp(since, datetime.timezone.utc).strftime("%Y-%m-%d")
    share = lambda a, b: f"{100 * a / b:.0f}%" if b else "-"
    print(f"since {day}: {files} subagent transcripts; cache_read summed per line {tot[0] / 1e9:.2f}B; "
          f"{n_over} over {over:,} context carry {big[0] / 1e9:.2f}B ({share(big[0], tot[0])})", file=out)
    print(f"  deduplicated by requestId: {tot[1] / 1e9:.2f}B; those {n_over} carry {big[1] / 1e9:.2f}B "
          f"({share(big[1], tot[1])})", file=out)
    return files, tot, n_over, big


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-subagent-bound.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-subagent-bound.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def main(argv):
    if argv[:1] == ["hook"]:
        try:
            return hook(sys.stdin.read())
        except Exception:
            return 0
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    if argv[:1] == ["measure"]:
        since = time.time() - 7 * 86400
        over = 300000
        a = argv[1:]
        try:
            while a:
                k = a.pop(0)
                if k == "--since":
                    since = datetime.datetime.strptime(a.pop(0), "%Y-%m-%d").replace(
                        tzinfo=datetime.timezone.utc).timestamp()
                elif k == "--over":
                    over = int(a.pop(0))
                else:
                    raise ValueError(k)
        except (ValueError, IndexError):
            print(__doc__.split("\n\n")[1], file=sys.stderr)
            return 2
        measure(since, over)
        return 0
    print(__doc__.split("\n\n")[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
