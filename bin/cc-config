#!/usr/bin/env bash
# cc-config — the one reader and writer of ~/.cc/config. Every tool that needs a key comes through here, so the
# file has one format, one precedence rule, and is never executed.
#   cc-config get KEY [default]   the value; exit 0 it was set, 1 it fell back to <default> (empty if none given)
#   cc-config set KEY VALUE       replaces every earlier line for KEY; mode 600, under a lock, atomic rename
#   cc-config unset KEY           exit 0 it was there, 1 it was not
#   cc-config list [KEY…]         KEY=VALUE for every key in the file, plus any KEY named here that only the environment has
#   cc-config path                where the file is
#   cc-config selfcheck           this reader's own invariants, in a config of its own
#   CC_CONFIG=FILE                read/write FILE instead · CC_CONFIG_DENY=FILE  that one file reads as empty, is never written
#
# NEVER SOURCED, ANYWHERE. That file holds the box's Slack tokens, and a config that is `.`-ed is code: a value
# like $(rm -rf ~) RUNS, and every key in it lands in the environment of whatever the script spawns next. Here a
# value is a literal string end to end — `set K '$(x)'` stores those characters and `get K` prints them back,
# having run nothing. Two of the four readers this replaced sourced the file.
#
# PRECEDENCE: the environment wins over the file, and a variable that is SET wins even when it is EMPTY —
# `PUBLISH_REMOTE= cc-publish` means "off" and must not fall through to whatever the file says. One rule for
# every consumer: of the four that used to read this file, two had the file win instead.
#
# FORMAT, unchanged — no migration: KEY=VALUE one per line; blank lines and #-comments ignored; whitespace around
# key and value trimmed; one layer of matching "…" or '…' quotes stripped; the LAST line for a key wins. A line
# whose key is not a shell variable name is not a key: no command here reads it, and set/unset leave it in place.
#
# CC_CONFIG points this at another file (tests, and the selfcheck below).
#
# CC_CONFIG_DENY names ONE file this run reads as EMPTY and refuses to write. A landing's gate points it at the
# box's live ~/.cc/config, so nothing a PR's suite runs reaches a credential through here — on PR #323
# (2026-09-09) a gate fell through to the live keys and completed a billed turn — while a fixture HOME's own
# .cc/config still reads, which pinning CC_CONFIG (it outranks HOME) would have broken in every such suite.
set -uo pipefail
CFG="${CC_CONFIG:-$HOME/.cc/config}"
denied(){ [ -n "${CC_CONFIG_DENY:-}" ] && [ "$(realpath -m -- "$CFG")" = "$(realpath -m -- "$CC_CONFIG_DENY")" ]; }
# shellcheck disable=SC2034   # read by the selfcheck, whose cases are tests/selfcheck/cc-config.sh
SELF="$(realpath "$0")"
USAGE="usage: cc-config get KEY [default] | set KEY VALUE | unset KEY | list [KEY…] | path | selfcheck"
umask 077   # this file is secrets: never create it, its lock or its temp file group- or world-readable

key_ok(){ case "$1" in ""|[!A-Za-z_]*|*[!A-Za-z0-9_]*) return 1;; esac; return 0; }

# The key a config line declares, or nothing. The one place the format is decided.
line_key(){
  local l="$1" k
  l="${l#"${l%%[![:space:]]*}"}"                                     # leading whitespace
  case "$l" in ''|'#'*) return 1;; *=*) ;; *) return 1;; esac
  k="${l%%=*}"; k="${k#"${k%%[![:space:]]*}"}"; k="${k%"${k##*[![:space:]]}"}"
  key_ok "$k" || return 1
  printf '%s' "$k"
}

line_value(){
  local v="$1"
  v="${v#*=}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
  case "$v" in '"'*'"'|"'"*"'") v="${v:1:${#v}-2}" ;; esac        # ONE layer of matching quotes, and nothing else
  printf '%s' "$v"
}

declare -A FVAL=(); FKEYS=()
load_file(){
  local line k
  [ -f "$CFG" ] || return 0
  ! denied || return 0                                             # the denied file reads as empty
  while IFS= read -r line || [ -n "$line" ]; do
    k="$(line_key "$line")" || continue
    [ -n "${FVAL[$k]+x}" ] || FKEYS+=("$k")                        # first appearance fixes the order, last wins the value
    FVAL["$k"]="$(line_value "$line")"
  done < "$CFG"
}

# Rewrite the file without KEY, appending KEY=VALUE when keep=1. Returns 0 if a line for KEY was there.
rewrite(){
  local k="$1" keep="$2" v="${3-}" line lk tmp rc=1
  ! denied || { echo "cc-config: $CFG is denied here (CC_CONFIG_DENY): nothing written" >&2; exit 1; }
  case "$CFG" in */*) mkdir -p "${CFG%/*}" || { echo "cc-config: cannot create ${CFG%/*}" >&2; exit 1; };; esac
  # One writer at a time. Without this, two `set`s that read the same file both write their own copy of it and
  # the first key is simply gone — `cc slack setup` writes three keys, and cc-notify setup writes while it does.
  exec 9>"$CFG.lock" || { echo "cc-config: cannot lock $CFG" >&2; exit 1; }
  command -v flock >/dev/null 2>&1 && flock 9
  tmp="$CFG.tmp.$$"
  : > "$tmp" || { echo "cc-config: cannot write $CFG" >&2; exit 1; }
  if [ -f "$CFG" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      lk="$(line_key "$line")" && [ "$lk" = "$k" ] && { rc=0; continue; }
      printf '%s\n' "$line" >> "$tmp"                              # comments and anything unparseable are kept as they are
    done < "$CFG"
  fi
  [ "$keep" = 1 ] && printf '%s=%s\n' "$k" "$v" >> "$tmp"
  mv -f "$tmp" "$CFG" || { rm -f "$tmp"; echo "cc-config: cannot replace $CFG" >&2; exit 1; }
  exec 9>&-
  return "$rc"
}

get(){
  local k="$1" def="${2-}"
  key_ok "$k" || { echo "cc-config: not a variable name: $k" >&2; exit 2; }
  if printenv -- "$k" >/dev/null 2>&1; then printenv -- "$k"; return 0; fi   # the ENVIRONMENT wins, empty included — printenv, not ${!k}: the shell's OWN state (CFG, HOSTNAME, FVAL) is nobody's environment
  load_file
  if [ -n "${FVAL[$k]+x}" ]; then printf '%s\n' "${FVAL[$k]}"; return 0; fi
  printf '%s\n' "$def"; return 1
}

list(){
  local k
  load_file
  for k in ${FKEYS[@]+"${FKEYS[@]}"}; do
    if [ -n "${!k+x}" ]; then printf '%s=%s\n' "$k" "${!k}"; else printf '%s=%s\n' "$k" "${FVAL[$k]}"; fi
  done
  for k in "$@"; do                                                # named keys the file does not have but the environment does
    key_ok "$k" || continue
    [ -n "${FVAL[$k]+x}" ] && continue
    [ -n "${!k+x}" ] && printf '%s=%s\n' "$k" "${!k}"
  done
  return 0
}

selfcheck(){   # the cases are tests/selfcheck/cc-config.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-config.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  get)       shift; [ $# -ge 1 ] && [ $# -le 2 ] || { echo "$USAGE" >&2; exit 2; }; get "$@" ;;
  set)       shift; [ $# -eq 2 ] || { echo "$USAGE" >&2; exit 2; }
             key_ok "$1" || { echo "cc-config: not a variable name: $1" >&2; exit 2; }
             case "$2" in *$'\n'*) echo "cc-config: a value cannot contain a newline" >&2; exit 2;; esac
             rewrite "$1" 1 "$2"; exit 0 ;;
  unset)     shift; [ $# -eq 1 ] || { echo "$USAGE" >&2; exit 2; }
             key_ok "$1" || { echo "cc-config: not a variable name: $1" >&2; exit 2; }
             rewrite "$1" 0 ;;
  list)      shift; list "$@" ;;
  path)      printf '%s\n' "$CFG" ;;
  selfcheck) selfcheck ;;
  *)         echo "$USAGE" >&2; exit 2 ;;
esac
