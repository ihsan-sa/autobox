#!/usr/bin/env python3
"""cc-time — the ONE place a time is rendered for a person to READ.

Everything the box writes INTO SLACK — posts, cards, the Home tab, cc-notify's pushes, the vitals chart — is
stamped HH:MM in the owner's zone and carries no Z. Everything it LOGS or RECORDS — logs, journals, board files,
audit reports, the landing queue — stays UTC and keeps its Z: those are read by machines and by whoever is
reconstructing an incident, and a local zone in them is one more thing to get wrong. The rule is one line in
COMMS.md, and it exists because every stamp the owner saw was UTC with a Z on it (owner, 2026-09-01).

    cc-time slack [WHEN…]          HH:MM, one line per WHEN (default: now)
    cc-time slack --date [WHEN…]   "%Y-%m-%d %H:%M" — for text where the day is not obvious from context
    cc-time zone                   the zone in force
    cc-time selfcheck

WHEN is a unix epoch (a fraction is allowed and dropped), a UTC ISO stamp — "2026-09-01T04:33:58Z", the shape
every record on this box writes — or `now`.

IMPORTED, NOT SHELLED OUT TO. The python tools load this file and call slack()/slack_all()/zone() directly:

    import importlib.machinery, importlib.util
    _s = importlib.util.spec_from_loader("cctime", importlib.machinery.SourceFileLoader("cctime", f"{BIN}/cc-time"))
    cctime = importlib.util.module_from_spec(_s); _s.loader.exec_module(cctime)

cc-slack redraws the Home tab every 5 s with a dozen stamps on it, and its selfcheck stubs subprocess.run to
prove no case shells out — a renderer that was a subprocess would be both a cost and a lie there. The shell
tools use the CLI above.

THE ZONE: CC_TZ when it is set and this box has that zone (the environment first, then ~/.cc/config through
cc-config — the same precedence every other key has); otherwise TZ; otherwise /etc/localtime, the box's own. A
CC_TZ naming a zone this box does not have is REFUSED to stderr and the box's own used instead: the alternative
is a silent UTC, which is the one failure this file exists to end.
"""
import datetime as dt
import os
import subprocess
import sys
import time
import zoneinfo

BIN = os.path.dirname(os.path.realpath(__file__))
USAGE = "usage: cc-time slack [--date] [WHEN…] | zone | selfcheck"
_FILE_TZ = []                       # ~/.cc/config's CC_TZ, read at most once a process: a zone does not move


def _configured():
    """CC_TZ as cc-config would answer it: the environment first, the file second, read once and remembered."""
    z = os.environ.get("CC_TZ")
    if z is not None:
        return z
    if not _FILE_TZ:
        try:
            r = subprocess.run([f"{BIN}/cc-config", "get", "CC_TZ", ""], capture_output=True, text=True,
                               stdin=subprocess.DEVNULL, timeout=10)
            _FILE_TZ.append(r.stdout.strip() if r.returncode == 0 else "")
        except Exception:
            _FILE_TZ.append("")
    return _FILE_TZ[0]


def zone():
    """The zone name in force. "" only when nothing on this box names one."""
    z = _configured()
    if z:
        try:
            zoneinfo.ZoneInfo(z)
            return z
        except Exception:
            print(f"cc-time: no zone called {z} on this box — using its own", file=sys.stderr)
    if os.environ.get("TZ"):
        return os.environ["TZ"]
    link = os.path.realpath("/etc/localtime")
    return link.split("/zoneinfo/", 1)[1] if "/zoneinfo/" in link else ""


def tz():
    """The zone as a tzinfo. Falls back to this process's own local zone — never to UTC, which is the bug."""
    name = zone()
    if name:
        try:
            return zoneinfo.ZoneInfo(name)
        except Exception:
            pass
    return dt.datetime.now().astimezone().tzinfo


def epoch(when):
    """WHEN → seconds. None or `now` is now; a UTC ISO stamp and a unix epoch are both accepted."""
    if when is None or when == "" or when == "now":
        return time.time()
    try:
        return float(when)
    except (TypeError, ValueError):
        pass
    s = str(when).strip()
    return dt.datetime.fromisoformat(s[:-1] + "+00:00" if s.endswith("Z") else s).timestamp()


def slack_all(whens, day=False):
    """One HH:MM per WHEN, in the owner's zone, never with a Z."""
    fmt = "%Y-%m-%d %H:%M" if day else "%H:%M"
    z = tz()
    return [dt.datetime.fromtimestamp(epoch(w), z).strftime(fmt) for w in whens]


def slack(when=None, day=False):
    return slack_all([when], day)[0]


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-time.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-time.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def io_capture():
    """Everything printed to stderr from here on, as a callable. The unknown-zone case is about what gets SAID."""
    import io
    buf, real = io.StringIO(), sys.stderr
    sys.stderr = buf

    def done():
        sys.stderr = real
        return buf.getvalue()
    return done


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    if argv[0] == "zone":
        print(zone() or time.strftime("%Z"))
        return 0
    if argv[0] == "selfcheck":
        return selfcheck()
    if argv[0] == "slack":
        rest = argv[1:]
        day = bool(rest) and rest[0] == "--date"
        whens = rest[1:] if day else rest
        try:
            for line in slack_all(whens or [None], day):
                print(line)
        except (ValueError, OverflowError, OSError) as e:
            print(f"cc-time: cannot read a time from {whens!r} ({e})", file=sys.stderr)
            return 2
        return 0
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
