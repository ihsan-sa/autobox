#!/usr/bin/env bash
# dashboard — the engine's dashboard (hive, which is cc-live), under a name nothing else on the box takes. hive-lite
# installs its own `hive` into ~/.local/bin, ahead of ~/bin on PATH, so a bare `hive` opens Hive Lite; and `dash` is
# the system shell, which cc-guard reads as one. This runs the hive beside it with every argument unchanged.
exec "$(dirname "$(readlink -f "$0")")/hive" "$@"
