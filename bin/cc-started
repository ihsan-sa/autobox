#!/usr/bin/env bash
# cc-started — ONE check, run just after a session is launched: did it actually get going, and if not, clear
# what the box can clear and tell the owner what it cannot.  Called from every `cc __run*` branch, so it covers
# `cc <repo>`, `cc <repo> <track>`, a member workspace's session, an orch, the handoff successor (`cc __runnext`,
# the window cc-handoff opens), Slack autostart and cc-msg's hung-session restart — all of which come up through
# the same six branches.
#
#   cc-started <window> [--wait SEC] [--quiet]   watch main:<window> for about a minute; exit 0 once it is up
#                                      --quiet: another watcher already owns this window's deadline AND its
#                                      dialogs (cc-handoff's kick does), so press nothing and page only for what
#                                      nothing else looks for — a login screen, or a standing permission prompt
#   cc-started selfcheck
#
# Exit: 0 the session is up · 1 it never got going (the owner was told) · 2 no such window · 3 logged out (told).
#
# WHY. Until now a startup glitch was caught only when the owner happened to be watching the pane (2026-09-05):
# a handoff successor sat on a permission prompt for 48 minutes, and a login screen, a startup popup and an
# opening message that never landed have each parked a session behind a window that looked perfectly healthy.
#
# THE THREE SHAPES, and what is done about each. Nothing here is new machinery — each one hands off to the tool
# that already owns it:
#   A STARTUP POPUP — Claude Code's MCP-trust prompt or its development-channels warning. `cc-slack accept-dialog`
#     presses those two through — but ONE PRESSER PER WINDOW, never two (see presser_running below): `cc`'s
#     chan_accept already starts one on this window whenever Slack is on, and cc-handoff's kick owns the
#     successor's, so this asks only when nobody else is on it and otherwise just re-reads the pane.
#     A PERMISSION dialog is NOT one of them: pressing an owner gate unattended is the one thing a script must
#     never do, so it is left standing and he is told.
#   AN OPENING MESSAGE THAT NEVER LANDED — the session is at an EMPTY input box, its transcript holds no
#     assistant record yet, and cc-msg's spool for that window is not empty: the message was typed at a dialog
#     and spooled behind it.  `cc-msg --drain` delivers it once, now, instead of waiting out the 60 s timer.
#   A LOGIN SCREEN — nothing the box does fixes it, so it is one line to the owner and this stops.
#
# READ NARROWLY. Every marker below is looked for in the pane's LAST $CC_STARTED_TAIL lines only — a dialog and
# a login screen are both drawn at the FOOT of the pane, while a session whose scrollback quotes their words
# (this file's own header does, and a replayed transcript does) must not be called logged out or blocked.  The
# markers themselves come off the shipped binary's strings, not from memory.
#
# Env: CC_STARTED_WAIT (90 s) · CC_STARTED_POLL (3 s) · CC_STARTED_TAIL (25) · CC_STARTED_BIN · CC_TMUX_SESSION.
# A window named _cctest…/_selfcheck… is a fixture: this returns at once and pages nobody.
set -uo pipefail
SELF=$(readlink -f "$0"); BIN="${CC_STARTED_BIN:-$(dirname "$SELF")}"
SESSION="${CC_TMUX_SESSION:-main}"
WAIT="${CC_STARTED_WAIT:-90}"; POLL="${CC_STARTED_POLL:-3}"; TAIL="${CC_STARTED_TAIL:-25}"; QUIET=0; START=0

# Off the binary (2.1.261): "Select login method:" is the screen itself; "Please run /login" is the tail of every
# expired/revoked/no-key variant ("Not logged in ·", "Login expired ·", "OAuth token revoked ·", "API Error: 401
# Invalid API key ·", "Session expired."). Two markers, both unambiguous — and NOT "Welcome to Claude Code",
# which a perfectly healthy fresh session draws too.
LOGIN_MARKS=('Select login method' 'Please run /login')
# cc-slack's STARTUP_MCP + STARTUP_DEV: the two dialogs a script may press.
STARTUP_MARKS=('Use this MCP server' 'MCP servers may execute code' 'development channels' 'local development')
# cc-msg's PERMISSION_MARKS: the owner's, always — not answered here either.
OWNER_MARKS=('Do you want to' 'No, and tell Claude what to do differently' 'Would you like to proceed?'
             'I trust this folder')
WORKING_MARK='esc to interrupt'     # Claude Code's footer for the whole of a turn (cc-msg and cc-reconcile read the same)
IDLE_HINT='? for shortcuts'         # …and what it draws under an idle input box

has(){ case "$2" in *"$1"*) return 0;; esac; return 1; }   # $1 needle in $2 haystack
any(){ local s="$1" n; shift; for n in "$@"; do has "$n" "$s" && return 0; done; return 1; }   # $1 haystack, then the marks

win_id(){ tmux list-windows -t "$SESSION" -F '#{window_id} #W' 2>/dev/null |
            awk -v n="$1" '$2==n{print $1; exit}'; }        # by id: names with dots/slashes break -t <session>:<name>

boxes(){ printf '%s\n' "$1" | grep -E '^[^A-Za-z0-9]*(>|❯)'; }   # every input-box/echo line the TUI has drawn
prompt_drawn(){ has "$IDLE_HINT" "$1" || [ -n "$(boxes "$1")" ]; }
box_empty(){   # is the BOTTOM-MOST box empty — nothing typed, nothing taken? (a placeholder counts as empty)
  local l; l=$(boxes "$1" | tail -1 |
    sed -E -e 's/^[^A-Za-z0-9]*(>|❯)//' -e 's/\xc2\xa0/ /g' -e 's/^[[:space:]]+//' -e 's/[[:space:]]+$//')
  [ -z "$l" ] || case "$l" in 'Try "'*) return 0;; esac
  [ -z "$l" ]
}

pane_cwd(){ tmux display-message -p -t "$1" '#{pane_current_path}' 2>/dev/null; }

first_turn(){   # $1 pane cwd · $2 window → 0 when THIS session's transcript already holds an assistant record.
  # The slug cc-context uses (realpath, `/` and `.` to `-`); a member workspace keeps its transcripts inside its
  # own boundary, so that root is tried too. ONLY TRANSCRIPTS TOUCHED SINCE THE LAUNCH COUNT: a worktree that has
  # ever held a session has old .jsonl files full of assistant records, and reading those would say "it got going"
  # about every session ever started there — the drain below would then never fire anywhere but a fresh box. A
  # resumed session appends, so its file's mtime moves past $START too.
  local cwd slug d
  cwd=$(readlink -f "$1" 2>/dev/null) || cwd="$1"; [ -n "$cwd" ] || return 1
  slug=$(printf '%s' "$cwd" | sed 's#[/.]#-#g')
  for d in "$HOME/.claude/projects/$slug" "$HOME/.cc/members/${2%%/*}/claude/projects/$slug"; do
    [ -d "$d" ] || continue
    # …and the match is judged by what grep PRINTS: with no file newer than $START, `find -exec … +` runs nothing
    # and still exits 0, which would read as "it got going" for every window on the box. Read into a substitution,
    # never `… | grep -q .`: grep -q quits at the first line, find takes SIGPIPE, and `set -o pipefail` above
    # reports that as no match — a session that HAD taken its first turn would then be re-sent its opening prompt.
    [ -n "$(find "$d" -maxdepth 1 -name '*.jsonl' -newermt "@$START" \
                 -exec grep -l '"type":"assistant"' {} + 2>/dev/null)" ] && return 0
  done
  return 1
}

spooled(){ [ -s "$HOME/.cc/state/$1/inbox.spool" ]; }   # cc-msg's spool for that window (its sdir)

presser_running(){   # is a press loop for this window already somebody else's job?
  # `cc`'s chan_accept starts `cc-slack accept-dialog <win>` on this exact window, on the line before this tool is
  # called, in every one of the six __run* branches — whenever Slack is on. Under --quiet the window is a handoff
  # successor's and cc-handoff's kick presses it itself. TWO PRESSERS ARE WORSE THAN ONE: both poll the same
  # dialog about a second apart, and the loser sends its "2" and its Enter AFTER the winner has cleared it — into
  # the live input box, submitted as the session's first user turn. So when someone else is on it this presses
  # nothing, and only re-reads the pane and reports. $HOME is read here, not at load, so a fixture's own HOME wins.
  [ "$QUIET" = 1 ] || [ -f "$HOME/.cc/slack/enabled" ]
}

page(){   # $1 window · $2 extra cc-notify flags ("" for none) · $3 the one line
  # HOW LOUD IS THE CALLER'S TO SAY. cc-notify reads the kind off the title's second word, and "startup" is not a
  # word its table knows — so every notice from here is ambient unless $2 says otherwise. THE TEST IS WHETHER THE
  # NOTICE ASKS THE OWNER FOR SOMETHING ONLY HE CAN DO: a login screen and a standing permission prompt do, and
  # both pass --decision; a startup dialog and a window that drew nothing are the box's own to report and stay
  # ambient. A startup notice that rings his phone about something any session could have cleared is worse than
  # one that does not, so this is decided per call below, never in a blanket.
  local repo="${1%%/*}"; repo="${repo%%@*}"; repo="${repo%\~next}"
  # shellcheck disable=SC2086
  "$BIN/cc-notify" -p high $2 -t "$repo startup" "$3" >/dev/null 2>&1 || true
}

started(){   # $1 window → the exit code documented above
  local win="$1" wid pane tailp end pressed=0 drained=0 dialog=0
  case "$win" in _cctest*|_selfcheck*) return 0;; esac
  START=$(( $(date +%s) - 1 ))   # the launch, near enough: what first_turn calls THIS session's transcript. -1 so a
  end=$(( START + 1 + WAIT ))    # file written in the same second as this stamp is still newer than it
  while :; do
    wid=$(win_id "$win")
    [ -n "$wid" ] || return 2                    # the window went away: whoever killed it owns that, not this
    pane=$(tmux capture-pane -p -t "$wid" 2>/dev/null)
    tailp=$(printf '%s\n' "$pane" | tail -n "$TAIL")
    if any "$tailp" "${LOGIN_MARKS[@]}"; then
      page "$win" --decision "$SESSION:$win came up logged out — nothing on this box runs until you run /login there."
      return 3
    # MID-TURN IS ASKED BEFORE ANY DIALOG, as cc-msg's blocked() does: no dialog draws the working footer, so a
    # pane showing both is a busy session with a dialog in its SCROLLBACK. Asked the other way round, a session
    # resuming a track — whose replayed transcript re-renders an already-answered permission prompt — never
    # returned 0: it burned the full 90 s and then paged the owner about a session that was running perfectly well.
    elif has "$WORKING_MARK" "$pane"; then
      return 0                                   # mid-turn: it got going
    # …and the owner's gate is read AT THE FOOT ONLY, like every other marker: "Do you want to" halfway up a pane
    # is the session's own prose, not a prompt anyone is waiting on.
    elif any "$tailp" "${OWNER_MARKS[@]}"; then
      dialog=2                                   # standing on the owner's gate: waited out, never pressed
    elif any "$tailp" "${STARTUP_MARKS[@]}"; then
      # THE OWNER'S GATE IS STILL ASKED BEFORE THE STARTUP WORDS. A dialog is drawn at the bottom of the pane;
      # "development channels" higher up is the session's own scrollback. Matched the other way round, a permission
      # prompt under a startup line sent accept-dialog's Enter INTO that prompt — the one key this must never press.
      dialog=1
      if ! presser_running && [ "$pressed" = 0 ]; then
        ( "$BIN/cc-slack" accept-dialog "$win" >/dev/null 2>&1 & ); pressed=1
      fi
    elif prompt_drawn "$pane"; then
      if [ "$drained" = 0 ] && box_empty "$pane" && ! first_turn "$(pane_cwd "$wid")" "$win" && spooled "$win"; then
        drained=1; "$BIN/cc-msg" --drain "$win" >/dev/null 2>&1 || true   # its first message never landed: deliver it once
      else
        return 0
      fi
    fi
    [ "$(date +%s)" -lt "$end" ] || break
    sleep "$POLL"
  done
  # A LOGIN SCREEN AND A STANDING PERMISSION PROMPT ARE ALWAYS SAID. Nothing else looks for either: cc-handoff's
  # kick reads "the prompt did not land", which is what a permission prompt looks like from there, and that is
  # exactly the successor that sat on one for 48 minutes. The other two ARE its news — it alerts and journals when
  # a successor never gets its opening prompt — so under --quiet they are left to it rather than said twice.
  if [ "$dialog" = 2 ]; then
    # --decision, because the sentence IS the reason: pressing an owner gate unattended is the one thing this must
    # never do, so the session stands there until a person answers — and a person who is only told in the ambient
    # lane comes when he happens to look. That is the 48-minute successor above, reported and still not reached.
    page "$win" --decision "$SESSION:$win is sitting on a permission prompt from its first turn — only you can answer it (tmux select-window -t $SESSION:$win)."
    return 1
  fi
  [ "$QUIET" = 1 ] && return 1
  # AMBIENT ON PURPOSE, both of them: a startup dialog is script-pressable (accept-dialog owns it, and a press that
  # did not take is this box's bug, not his decision), and a window that drew nothing needs restarting, which any
  # session can do. Neither asks him for anything only he can give, so neither buys a push.
  case "$dialog" in
    1) page "$win" "" "$SESSION:$win never got past its startup dialog, so the session behind it has not started (tmux select-window -t $SESSION:$win)." ;;
    *) page "$win" "" "$SESSION:$win came up but drew no prompt in ${WAIT}s — nothing is running in it (tmux select-window -t $SESSION:$win)." ;;
  esac
  return 1
}

selfcheck(){   # the cases are tests/selfcheck/cc-started.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-started.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  selfcheck) selfcheck; exit $? ;;
  ""|-h|--help) sed -n '2,13p' "$SELF"; exit 2 ;;
esac
win="$1"; shift
while [ $# -gt 0 ]; do
  case "$1" in --wait)  WAIT="${2:?--wait SEC}"; shift 2 ;;
               --quiet) QUIET=1; shift ;;
               *) echo "cc-started: unknown argument '$1'" >&2; exit 2 ;; esac
done
started "$win"
