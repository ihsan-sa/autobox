        def woke():
            return open(f"{tb}/cc.log").read().splitlines() if os.path.exists(f"{tb}/cc.log") else []
        quietly(tick, {}, True)
        # "cc-pulse.timer ... INSTALLED OFF: ... switching that on is the owner's call, not the installer's" (units.json)
