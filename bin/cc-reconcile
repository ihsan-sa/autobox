        json.dump({"repo": "chan", "tracks": {"s1": {"kind": "session", "status": "running", "updated": old},
                                              "s2": {"kind": "session", "status": "queued", "updated": old}}},
                  open(f"{tb}/.cc/boards/chan.json", "w"))
