#!/usr/bin/env bash
# cc-sandbox — a worker's `claude -p` inside bwrap: the box's secrets, the container and tmux sockets, the other tracks and
# the control plane's source are ABSENT from the process's world, not denied by a regex (docs: design-worker-sandbox, stage 1a).
#   cc-sandbox <repo> <track> -- <cmd...>   CC_WORKER_SANDBOX=1 → bwrap around <cmd>; anything else → exec <cmd> untouched
#   cc-sandbox reconcile <repo> <track>     fold what the worker committed in its own branch namespace onto the host's
#                                           refs/heads/track/<track> (compare-and-swap). cc-loop runs it after every
#                                           iteration, before the checkpoint that pushes; a no-op if nothing moved.
#   cc-sandbox selfcheck                    a scratch repo + worktree: the world inside is what this header says
#   CC_MEMBER_V2=1 cc-sandbox member <workspace> <task> -- /absolute/command [args...]
#     Opt-in task launcher; provision with cc-member-v2 first. Pipes or /dev/null only.
#   cc-sandbox member <handle> [<track>] -- <cmd...>   A MEMBER WORKSPACE'S BOUNDARY (docs/design-member-workspaces.md): ALWAYS bwrap,
#     no opt-in. Inside: ~/dev/<handle> rw (the whole workspace, its .git included — it is the member's own repo — but .git/config,
#     .git/hooks and every config.worktree ro: the host runs git in there and must not run what a member wrote. NONE of those
#     binds names its source — see `pin`: the host opens each one and hands bwrap a descriptor, because a name in a tree the
#     member writes can be turned into a link, moved out from under the mount, or swapped by a second live session of the same
#     handle between the check and the mount. `.git` and `.git/worktrees` are bound onto themselves as well, which makes them
#     MOUNTPOINTS the session cannot rename) · ~/.cc/worktrees/<handle>
#     and ~/.cc/state/<handle> rw (every track of the workspace, no other repo's) · the workspace's board, in a DIRECTORY of its
#     own (~/.cc/members/<handle>/board/, seen AS ~/.cc/boards; ~/.cc/boards/<handle>.json is a link into it — board_dir says why)
#     · ~/.cc/slack/member/<handle>/ seen AS ~/.cc/slack: the daemon's member-scoped socket, an `enabled` flag and the attachment cache —
#     the bot token, the owner-level socket and every other channel stay outside · a private ~/.claude/projects, ~/.npm and ~/.cache under
#     ~/.cc/members/<handle>/ · the control plane's core/bin bound ro AS ~/bin, so ~/dev/<control repo> does not exist inside · ONE credential
#     at ~/.claude/.credentials.json — the workspace's OWN (~/.cc/members/<handle>/credentials.json, minted by the owner with
#     `cc-sandbox mint`, kept whole, BOUND rw at that path so the refresh a session makes inside is what the next launch
#     starts from; its host path is not inside) and
#     whichever account the owner minted for it, his own included: a member can print whatever is in there, so that is his call to
#     make per workspace. With no credential of its own the workspace does not start · a
#     ~/.claude.json copy holding only this workspace's projects, only the cc-slack MCP server, and two first-run flags MINTED for the
#     workspace (`hasCompletedOnboarding` and `hasTrustDialogAccepted` on its own paths) so the member is not walked through the setup
#     wizard and asked to sign in on every start. The flags are generated here from no value of his; his file is read for its
#     `projects` alone, filtered as before, and is never written. The environment is CLEARED and rebuilt
#     (HOME, PATH, TERM, LANG…, CC_MEMBER_SANDBOX=1, CC_ROLE=member, git identity = the handle). ABSENT: every other ~/dev/*, ~/.cc/config,
#     ~/.ssh, ~/.config, ~/.gitconfig, ~/.npmrc, the ledger (~/.cc/state/member-spend.json), other boards, the docker and tmux sockets.
#   cc-sandbox mint <handle> [--from <file>]   THE WORKSPACE'S OWN CREDENTIAL, the one thing `member` will not start without.
#     It runs claude in a THROWAWAY HOME so <handle> logs in there, then installs what that login produced at
#     ~/.cc/members/<handle>/credentials.json, mode 600 — the path and shape the boundary reads. `--from <file>` installs a
#     credential a login made somewhere else. Nothing is invented, copied or forwarded, and the owner's own token never rides
#     in on the environment. IT INSTALLS, OR IT EXITS NON-ZERO SAYING IT DID NOT — and an install that ends a wall
#     #<handle> was told about posts one line there saying it is ready. Closing claude instead of quitting it
#     (/exit) no longer takes mint down between the login and the copy: INT, TERM and HUP are caught and what that login
#     already wrote is installed anyway. Any end that installs nothing NAMES the throwaway home it left and prints the
#     `--from` line that finishes from it, so nobody logs in twice; the throwaway home is deleted only once the credential
#     is installed, or when the login produced none. A credential that turns out to be the OWNER'S — his file, his access
#     or refresh token, or a login signed in as his account — is INSTALLED, and mint SAYS SO in plain words (owner, 2026-09-02: "These are trusted people
#     just treat minting my account like any other account"). Inside the boundary a member can print whatever is there, so
#     that person can use the account anywhere: mint his account only for someone trusted with the account itself.
#   cc-sandbox convert <repo>   ~/dev/<repo>, an ordinary repo already on this box, BECOMES a member workspace: the two
#     markers, `.cc/` excluded from commits, `git init` and a first commit if it has neither, a board of its own, and the
#     member instructions in its README (appended if it already has one) — the same workspace cc-slack's join flow makes,
#     and it prints what it changed, including a README it could not write. Refused, with the reason: the box's own
#     control repo, a repo with git worktrees or live tracks, and a handle the box already answers to (#box, #approvals,
#     #alerts, an -updates lane, a name in routes.json). Then `mint`; the Slack channel pair stays the daemon's.
# INSIDE rw: the track worktree · THREE PLACES IN the parent repo's .git (the worktree's .git is a pointer into it),
#   which is otherwise A TMPFS holding mountpoints of the real one and nothing else: .git/objects apart from
#   objects/pack, this track's own .git/worktrees/<n>, and — AT the fixed paths refs/heads/track and
#   logs/refs/heads/track, but NOT the host's directories of that name — a per-track branch namespace of this track's
#   OWN, holding its branch and no sibling's (`rstore`). What it commits there the host folds onto refs/heads/track/<track>
#   afterwards, by compare-and-swap on that one constant name: `cc-sandbox reconcile <repo> <track>`, which cc-loop runs
#   before its checkpoint and `build` runs again at the next launch, so an iteration killed in between is not lost.
#   So the worker commits on its own branch and the checkpoint pushes it, while
#   refs/heads/main, HEAD, the tags, the remotes, packed-refs, config, config.worktree, hooks and every OTHER track's
#   git dir are read-only — as are the two files that say where THIS worktree's git dir and common dir are, the
#   worktree's own .git and .git/worktrees/<n>/commondir, so the host's git can never be sent to a directory a worker
#   wrote. A name the real .git does not have is the worker's own and reaches the host nowhere —
#   the checkpoint that commits and pushes runs OUTSIDE with the MAIN checkout's hooks
#   (cc-loop), and a worker must not re-point its hooksPath or its remotes, nor write a hook the host would run. Every
#   source in a tree this list hands the worker rw is bound BY DESCRIPTOR and not by name (see `pin`, and the paragraph
#   in `build`) ·
#   ~/.cc/state/<repo>/<track> · ~/.npm · ~/.cache · /tmp · a private ~/.claude with settings ro, this cwd's
#   transcripts and the repo's memory rw, nothing else of it · a COPY of ~/.claude.json with every other project's history
#   and the MCP servers stripped (Slack stops loading: workers do not post).
# INSIDE ro: ~/.cc/boards, and each ~/.cc/members/*/board under it (a member's board is a link into one — board_dir). A worker
#   READS every board and writes none: cc-loop makes this track's board writes out here, around the sandbox. It was rw, and
#   that let a worker plant a link at ~/.cc/boards/<repo>.json for the host to save through — cc-board's _target refuses
#   that link now as well, two walls, but the bind is the one that stops it being written in the first place.
# PERMISSIONS (both boundaries, and only where there IS one — with the sandbox off nothing below happens): the session
#   sees a read-only COPY of ~/.claude/settings.json, his own file plus a baseline appropriate to a sealed session.
#   The copy is the one thing a launch WRITES outside the binds above: ~/.cc/sandbox/<repo|handle>/<track|_workspace>/
#   settings.json, rewritten each launch, ro-bound at his path — that dir is under no bind, so its source is not
#   reachable from inside. It carries his hook registrations and deny rules, so on the HOST it is one of the box's
#   secrets to a gated session, exactly as ~/.claude/settings.json is (cc-guard: secret_path, and the member rule).
#   Silent in there: Bash, the file tools, and reading the session's own Slack channel — their effects land on the
#   binds above and nowhere else. STILL PROMPTS: sudo, and a direct call to one of the network clients (curl, wget,
#   nc, ssh, scp…), plus WebFetch/WebSearch. WHAT THAT IS AND IS NOT: the ask rules match the COMMAND NAME, so they
#   catch the obvious way out and nothing else — measured, `sh -c 'curl …'` and `/usr/bin/curl …` are both Bash(*)
#   and both run silent. sudo has a second wall behind it (cc-guard); egress has none. So egress is not
#   contained here and this does not claim to contain it: it is contained when stage 1b (ccbox, an allowlist proxy)
#   exists. His file is read, never written, and never edited by this box — the paragraph at SBX_ALLOW says why each
#   way round.
# INSIDE ro: ~/bin and the bin it links into · ~/.local/bin + ~/.local/share/claude (claude itself) · ~/.gitconfig · ~/.npmrc
#   · /usr · /etc.  ABSENT: ~/.config/gh · ~/ccbox · ~/.cc/config · ~/.ssh · /run and /var/run (the container socket) · $TMUX
#   and its socket · every other track, the rest of ~/dev · and the docker group itself (bwrap maps one uid; supplementary
#   groups become nobody).
# AUTH (a WORKER; a member workspace's is the `cc-sandbox member` paragraph above): claude reads a STRIPPED copy of
#   ~/.claude/.credentials.json at its normal path — the current access token and its
#   expiry, no refresh token — so the read claude needs is the one cc-guard's credential rule denies the worker, and nothing
#   goes in the environment (CLAUDE_CODE_OAUTH_TOKEN is unset inside: `env` is not gated, that path is). An iteration is ≤1 h
#   and whichever session next needs the token refreshes the real file, so a launch with <65 min left is logged: if it
#   expires mid-run that iteration errors and the next one starts on a fresh copy.
# NETWORK: untouched (--unshare-net is all-or-nothing, and "none" kills claude). Own pid namespace; same process group and
#   --die-with-parent, so cc-loop's kill of the group and the `timeout` inside both end everything.
# BREAKS INSIDE, BY DESIGN: git push and gh (no credential — cc-loop pushes and opens the PR from outside), cc-notify (no
#   ~/.cc/config — `STATUS: BLOCKED` in the journal is the escalation), cc --go (no tmux). And, since the ref store went
#   read-only: `git tag` and `git stash`, neither of which a worker is launched to do. Commit, rebase, amend, reset,
#   checkout and the checkpoint's own commit on its own branch all work, measured end to end. Missing a path? Add ONE bind line
#   here, reviewable — never a wider one.
# KNOWN COST, WHAT IS LEFT OF IT — ONE carve-out, ACCEPTED, and the selfcheck drives it rather than this line claiming it:
#   .git/objects is rw, because every commit a worker makes writes one, so a LOOSE object it can also DELETE. Bounded,
#   not open: objects/pack AND objects/info are ro on top, so the packed history — nearly all of a repo older than a
#   day — cannot be deleted, an `alternates` cannot point the host's git at an object directory the worker named, and a
#   planted `commit-graph` cannot break every host git call in the repo; and the branch a deletion could strand is its
#   own (the namespace is per-track now). What is left is exactly the loose objects of the last hour. Closing that too
#   wants a private object store the host merges back, and a merge that is even slightly incomplete leaves a branch
#   pointing at objects that are not there, which is worse than the deletion it prevents. So it stays accepted.
#   THE OTHER TWO ARE CLOSED, and each is one bind: a SIBLING track's branch (the namespace above), and re-pointing the
#   host's git at a directory the worker wrote (the worktree's .git and the admin dir's commondir, both ro, below).
#   AND ONE THAT IS NOT THIS FILE'S TO CLOSE: a relative core.hooksPath (this repo's core/.githooks) names TRACKED
#   files the worker edits. cc-loop pins the main checkout's copy for its own host-side git, so the checkpoint and its
#   push never run a hook a worker wrote — but `cc done` typed by hand on that worktree still merges with the
#   worktree's. Review the branch before running it.
set -uo pipefail
H="$HOME"; SELF=$(readlink -f "$0")
slug(){ printf '%s' "$1" | tr '/.' '--'; }   # claude's per-cwd dir under ~/.claude/projects: every / and . becomes -
# ── THE PERMISSION BASELINE OF A SEALED SESSION ───────────────────────────────────────────────────────────────────
# A prompt the boundary already answers buys no safety and costs the owner a message. Worse, a stream of harmless ones
# trains him to approve without reading, so the one that matters gets waved through with the rest (three in seven
# minutes, 2026-09-02: two to READ the session's own Slack channel, one to chmod and byte-compile a file in its own
# worktree). So the baseline is a DENY-LIST OF WHAT CROSSES, not an allow-list of blessed commands: the allow-list
# shape is what produced those prompts, because it can never be complete and a worktree that did not exist yesterday
# starts it empty. Compound commands are the visible symptom — the harness rates `chmod +x X && python3 -m py_compile
# X && ./X --check` by its least-approved clause, so the whole line prompts for `./X`.
# ASK, because it leaves the sealed world and the boundary does not stop it:
#   the outward network — --unshare-net is all-or-nothing and "none" kills claude, so the net is UNTOUCHED in here
#   (see NETWORK above) and a client is the ordinary way data gets out. `ask` outranks `allow`, so these prompt even
#   though ~/.claude/settings.json allows `curl` box-wide: inside the boundary the box is STRICTER than outside it.
#   ITS CEILING, MEASURED (2026-09-03, these same rules through `claude -p --settings`): they are command-NAME rules
#   and they cover a direct call, nothing more. `curl -sS https://example.com/` prompted; `sh -c 'curl …'` and
#   `/usr/bin/curl …` did not — no denial, 559 bytes off the box, twice. `env curl` and three lines of python are the
#   same shape. That is not a hole this list can close: a name list cannot express "reaches the network", and unlike
#   sudo there is no second wall behind it. It raises the cost of the obvious path and buys the owner a look at it;
#   the thing that actually contains egress is stage 1b (ccbox, an allowlist proxy), and until that exists egress is
#   NOT contained. Say that plainly wherever this is described — a boundary claimed wider than it is, is worse than
#   a narrow one.
#   sudo — bwrap here does not --unshare-user, so root inside the namespace is root on the host kernel (modprobe);
#   a mount namespace is not a privilege boundary and this one was never audited as one. cc-guard refuses it for a
#   gated role too, and that is not a reason to drop it here: two walls with two owners, each doing its own job. It is
#   also NOT the `gh` case below — `gh` cannot function in here at all, where this can.
# NOT asked, deliberately: `git push` and `gh`, which the boundary already broke by leaving the credential outside
#   (BREAKS INSIDE, BY DESIGN above) — guarding the impossible is the failure mode, not the safe default; and
#   `npm`/`pip install`, which fetch INWARD into a world that is thrown away.
# EVERYTHING ELSE IS SILENT because its effects land on the binds above and nowhere else, and because the harness
# prompt is the third gate on those, not the first: cc-guard is a PreToolUse hook that runs whatever the permission
# rules say, and it still denies merging, deploying, comms in the owner's name, destructive ops and the box's
# secrets for CC_ROLE=worker|member. Two walls with two owners — do not widen one to quiet the other.
# NEVER his file: this is a COPY, built here, read-only INSIDE (a session that could rewrite its own settings.json
# could unregister cc-guard from it). His hooks, his deny, his ask and his allow come through in his own order with
# the baseline appended. ~/.claude/settings.json is his and is only ever read.
# MEASURED, not guessed (2.1.259, 2026-09-02): a rule in a SETTINGS FILE needs its specifier. Bare `Bash` is honoured
# from `--settings` and silently matches nothing from ~/.claude/settings.json, so the wildcard is spelled out here and
# the file rules carry the same `//**` his own `Read` rule does. Re-measure before changing a specifier.
SBX_ALLOW='["Bash(*)","Read(//**)","Edit(//**)","Write(//**)","NotebookEdit(//**)","mcp__cc-slack__history","mcp__cc-slack__thread"]'
SBX_ASK='["Bash(sudo:*)","Bash(curl:*)","Bash(wget:*)","Bash(nc:*)","Bash(ncat:*)","Bash(netcat:*)","Bash(telnet:*)","Bash(socat:*)","Bash(ssh:*)","Bash(scp:*)","Bash(sftp:*)","WebFetch","WebSearch"]'
settings_copy(){   # stdout: the settings.json the sealed session sees. Read-only in there; his own file is never written.
  # rc 1 = NO copy, and the caller then binds his file unchanged and says the baseline is not applied. THE MERGE CAN
  # FAIL ON A FILE THAT PARSES: `jq -e .` proves his file is JSON, not that this filter can run on it — a hand-edited
  # `"allow": "Bash(x)"` (a string where a list belongs) parses and then aborts jq mid-stream, because `$a - "Bash(x)"`
  # is a type error. jq's exit status is the only thing that says so, so it is not discarded: a swallowed failure here
  # ro-binds an EMPTY settings.json at his path, which is a session with no rules and no cc-guard hook registration,
  # silently — the one outcome this whole function exists to prevent.
  local s="$H/.claude/settings.json"
  # AND HIS FILE IS WHERE THE HOOKS LIVE, so a baseline built without one is a session with permissions and no
  # cc-guard registered — while SBX_ALLOW opens Bash all the way, which makes it MORE open than no baseline at
  # all, not less. Absent is therefore refused exactly like a file that will not parse: the caller binds nothing
  # and the session prompts as an unsandboxed one does (review of #198).
  if [ ! -f "$s" ]; then
    echo "cc-sandbox: ~/.claude/settings.json does not exist." >&2
    return 1; fi
  if ! jq -e . "$s" >/dev/null 2>&1; then
    echo "cc-sandbox: ~/.claude/settings.json does not parse." >&2   # the reason; settings_bind prints the consequence
    return 1; fi
  jq --argjson a "$SBX_ALLOW" --argjson k "$SBX_ASK" \
     '. + {permissions: ((.permissions // {}) + {
            allow: ((.permissions.allow // []) + ($a - (.permissions.allow // []))),
            ask:   ((.permissions.ask   // []) + ($k - (.permissions.ask   // [])))})}' "$s" \
    || { echo "cc-sandbox: the sealed-session baseline would not merge into ~/.claude/settings.json — is permissions.allow or permissions.ask something other than a list?" >&2; return 1; }; }
settings_bind(){   # $1 a host dir NO bind of this boundary reaches → put the copy there and mount it ro at his path
  # It has to be a REAL FILE ON THE HOST, ro-bound like any other path. Measured 2026-09-02: handed in over an fd
  # (`--ro-bind-data`, `--file`) the copy is readable inside — jq reads it — and claude applies NONE of it, his own
  # rules included, so a session got no settings at all. The mount, not the copy, is what makes it read-only, and a
  # session that could rewrite its own settings.json could unregister cc-guard from it.
  local d="$1" f
  if mkdir -p "$d" 2>/dev/null; then
    f="$d/settings.json"
    # THREE things have to hold before it is installed, and the middle one is not redundant: settings_copy can fail
    # (above), and a write that runs out of disk or quota leaves a TRUNCATED file behind with a zero exit status.
    # Either way the copy is not the file it claims to be, so it is re-read as JSON here and a bad one is never
    # mounted — the fallback below is strictly better than a session holding an empty settings.json.
    if ( umask 077; settings_copy > "$f.tmp.$$" ) && jq -e . "$f.tmp.$$" >/dev/null 2>&1 && mv "$f.tmp.$$" "$f"; then
      B+=(--ro-bind "$f" "$H/.claude/settings.json"); return 0; fi
    rm -f "$f.tmp.$$"; fi
  # No usable copy — it could not be built, or could not be written. Bind HIS file unchanged rather than nothing:
  # the hooks in there are the box's mechanical gates, and a session with no settings at all has no cc-guard either.
  # A copy an earlier launch left at $f is deliberately left alone: another sealed session may have that very file
  # mounted right now, and it is not this launch's to delete.
  if [ -f "$H/.claude/settings.json" ]; then
    echo "cc-sandbox: no sealed-session settings copy under $d — binding ~/.claude/settings.json unchanged instead. The permission baseline is NOT applied: this session prompts like an unsandboxed one." >&2
  else
    echo "cc-sandbox: no ~/.claude/settings.json to build a sealed-session copy from — binding no settings at all. The permission baseline is NOT applied and no hook is registered: this session prompts like an unsandboxed one." >&2
  fi
  [ -f "$H/.claude/settings.json" ] && B+=(--ro-bind "$H/.claude/settings.json" "$H/.claude/settings.json"); return 0; }
track_gitdir(){   # $1 the parent repo · $2 the track worktree → $1/.git/worktrees/<n>, THE ONE BOTH SIDES AGREE ON, or 1
  # The worktree's `.git` is a gitlink FILE in a tree the worker writes, so its text is not on its own a reason to bind
  # anything rw. It is read here for the NAME only, and the name is then required to be a plain entry under the host's
  # own $1/.git/worktrees/ whose `gitdir` file points back at this worktree. `<track>` is not reliably that name: git
  # appends a digit when the basename is already taken, so a track re-created after a stale entry gets <track>1.
  local gd rest; gd=$(sed -n '1s/^gitdir: //p' "$2/.git" 2>/dev/null) || return 1
  rest=${gd#"$1/.git/worktrees/"}; [ -n "$rest" ] && [ "$rest" != "$gd" ] || return 1
  case "$rest" in */*|.|..) return 1;; esac
  [ -d "$gd" ] && [ "$(cat "$gd/gitdir" 2>/dev/null)" = "$2/.git" ] || return 1
  printf '%s' "$gd"; }
NSD=refs/heads/track   # THE ONE REF DIRECTORY A WORKER MAY WRITE. A CONSTANT, chosen here and read from nothing inside:
# `cc` puts every track branch in it (branch=track/<track>), so no worker needs another one and none may name one. It is
# a DIRECTORY bind, so a slashed track name (track/a/b) is covered by the same mount and needs no second decision.
branch_warn(){   # $1 the track's own git dir → nothing bound and nothing decided; one line on stderr if a commit will fail
  # $1/HEAD IS INSIDE THE WORKER'S RW WORLD, so its text is the worker's own and must never choose a mount. It did once,
  # and that reopened the whole hole: measured on the version this replaced, one launch wrote `ref: refs/heads/main/x`
  # into its own HEAD, and the NEXT launch read `refs/heads/main` out of it and bound the host's refs/heads/main — a
  # FILE, which is the shape a live repo's own branch has — read-write, after which the worker overwrote main with any
  # sha it liked. So the text is only ever a MESSAGE now. Two shapes are fine and silent: HEAD detached (a rebase in
  # progress, finishing onto track/<t>) and a branch already under $NSD.
  local ref; ref=$(sed -n '1s/^ref: //p' "$1/HEAD" 2>/dev/null)
  case "$ref" in ""|"$NSD"/?*) return 0;; esac
  echo "cc-sandbox: this worktree is on '${ref#refs/heads/}', a branch outside $NSD — the ref store is read-only inside, so a commit on it will fail. Track branches are track/<track>." >&2; }
# ── THE BRANCH NAMESPACE A WORKER WRITES IS ITS OWN COPY, AND THE HOST FOLDS IT FORWARD ─────────────────────────────
# The rw bind used to be the host's own $NSD directory, which is the box's WHOLE track namespace: every other track's
# branch sat in there with this one, so a worker could move a sibling's — measured, one `update-ref refs/heads/track/u`
# from inside came back `moved` and the host's track/u really was on the worker's commit. The directory is the smallest
# unit the files backend allows (a bind of the ref FILE makes the `<branch>.lock` rename onto it EBUSY and breaks every
# commit), so the fix is not a narrower mount but a DIFFERENT directory: this track's own, holding its own ref and
# nothing else. A sibling is not refused in there, it is ABSENT — there is no name to move.
# WHY NOT ro-bind THE SIBLINGS INSTEAD, which is the obvious smaller change: a mount marks the DENTRY, not one mount
# namespace, so a ro bind of refs/heads/track/u in THIS sandbox makes the sibling worker's own `rename(u.lock, u)`
# return EBUSY in ITS sandbox. That does not wall the attacker off, it stops every other worker committing. Recorded
# so the smaller-looking change is not tried again.
# THE PRICE, AND WHO PAYS IT: what a worker commits is now in ITS OWN file, so the host's ref does not move until
# something folds it forward — rs_fold, called by cc-loop after every iteration and again by `build` before the next
# one starts, so an iteration killed between the two is folded at the next launch instead of being lost. Kill the LOOP
# in that window and never relaunch the track, and the fold is `cc-sandbox reconcile <repo> <track>` by hand. Nothing is
# lost while it waits: the commits are loose objects in the shared store from the moment they are written, `git gc`
# leaves a loose object alone for two weeks, and the worktree's own logs/HEAD names them for longer than that.
rstore(){ printf '%s' "$H/.cc/sandbox/$1/$2/refstore"; }   # beside the settings copy, and for the same reason: ~/.cc/sandbox is under no bind, so the source is not reachable from inside
rs_fold(){   # $1 repo · $2 track → the private branch file becomes the host's ref, or it does not and this says why
  # THE REF NAME IS THE CONSTANT $NSD/<track> FROM ARGV AND NOTHING ELSE. Not the worktree's HEAD, not a name found in
  # the store: both live in trees the worker writes, and branch_warn is the note on what happened the one time a mount
  # was chosen from one. So a worker that plants OTHER names in there moves nothing — they are counted and said out
  # loud, never folded.
  local dev="$H/dev/$1" rs ref="$NSD/$2" new base cur others rsr rf
  rs=$(rstore "$1" "$2"); rsr=$(realpath -e "$rs/refs" 2>/dev/null) || return 0
  # …AND IT IS READ FROM A REAL FILE INSIDE THE STORE, NEVER THROUGH A LINK. Every name BELOW $rs/refs is the worker's,
  # because that directory is its rw bind: it can delete its own branch file and leave a symlink standing at the name.
  # `[ -f ]` follows one and so does `<`, and they follow it OUT HERE — on the host, as the owner, with no namespace
  # around them. Measured (review of #339): a link planted at that name made this function read a host file and print
  # its bytes onto cc-loop's pane. So the leaf may not be a link, nothing on the way down to it may be one either
  # (realpath resolves the lot, and the answer has to land back inside the store), and neither refusal repeats a byte.
  if [ -L "$rs/refs/$2" ]; then
    echo "cc-sandbox: $1/$2 left a symlink where its branch file goes — $ref was not moved, and what the link pointed at was not read." >&2; return 1; fi
  rf=$(realpath -e "$rs/refs/$2" 2>/dev/null) || return 0
  case "$rf" in "$rsr"/*) ;; *) echo "cc-sandbox: $1/$2's branch file resolves out of its own ref store — $ref was not moved, and nothing outside the store was read." >&2; return 1;; esac
  [ -f "$rf" ] || return 0
  new=$(tr -d ' \t\n' < "$rf"); base=$(cat "$rs/base" 2>/dev/null || true)
  others=$(find "$rs/refs" ! -type d 2>/dev/null | grep -vxF "$rs/refs/$2" | wc -l)   # ! -type d rather than -type f: a link left beside it is a name of its own too, and -type f cannot see one
  [ "$others" = 0 ] || echo "cc-sandbox: $1/$2 left $others branch name(s) of its own in its private ref store — ignored; the host folds $ref and no other name." >&2
  # WHAT IT LEFT IS DESCRIBED, NOT REPEATED. Printing it is how the link above turned a read into a leak on cc-loop's
  # pane, so a shape that is not a commit id is answered with its length and a hash of it and nothing else.
  case "$new" in ''|*[!0-9a-f]*) echo "cc-sandbox: $1/$2 left ${#new} byte(s) that are not a commit id where one goes (sha256 $(printf '%s' "$new" | sha256sum | cut -c1-12)) — $ref was not moved, and what it left is not repeated here." >&2; return 1;; esac
  git -C "$dev" cat-file -e "$new^{commit}" 2>/dev/null || { echo "cc-sandbox: $1/$2 left $new, which is no commit in $1 — $ref was not moved." >&2; return 1; }
  cur=$(git -C "$dev" rev-parse -q --verify "$ref" 2>/dev/null || true)
  [ "$new" = "$cur" ] && { rm -f "$rs/refs/$2" "$rs/base"; return 0; }
  # COMPARE AND SWAP against where the branch stood when this run was SEEDED, so a fold never overwrites a move the
  # host itself made meanwhile (a rebase by hand, `cc done`). An empty base is git's "this ref must not exist".
  # hooksPath OFF for it: `update-ref` fires the `reference-transaction` hook, and this fold is plumbing the host runs
  # on a worker's say-so. The main checkout's own hooks are not a worker's to write, so this is the belt to that brace.
  if git -C "$dev" -c core.hooksPath=/dev/null update-ref -m "cc-sandbox: $2" "$ref" "$new" "$base" 2>/dev/null; then rm -f "$rs/refs/$2" "$rs/base"; return 0; fi
  echo "cc-sandbox: $ref moved to ${cur:-nothing} while $2 was running, so its own $new was not folded in and nothing was overwritten. The commits are in the object store — recover by pointing $ref at $new in ~/dev/$1." >&2
  return 1; }
rs_seed(){   # $1 repo · $2 track → a private $NSD holding this track's own ref and its reflog, and nothing else
  local dev="$H/dev/$1" rs cur; rs=$(rstore "$1" "$2")
  # A FOLD THAT COULD NOT HAPPEN IS NOT DISCARDED: the store is moved aside under a name that says so, and the launch
  # goes on. Wiping it here would throw away the one file naming the commits the last run made.
  rs_fold "$1" "$2" || mv "$rs" "$rs.unfolded.$(date -u +%Y%m%dT%H%M%SZ)" 2>/dev/null
  rm -rf "$rs"; mkdir -p "$rs/refs/$(dirname "./$2")" "$rs/logs/$(dirname "./$2")" || return 1
  cur=$(git -C "$dev" rev-parse -q --verify "$NSD/$2" 2>/dev/null || true)
  printf '%s' "$cur" > "$rs/base"                                  # where the branch stood: the fold's expected-old
  [ -n "$cur" ] && printf '%s\n' "$cur" > "$rs/refs/$2"            # …and an unborn branch seeds nothing, as git leaves it
  [ -f "$dev/.git/logs/$NSD/$2" ] && cp "$dev/.git/logs/$NSD/$2" "$rs/logs/$2"   # its own reflog, so an amend inside has something to walk back to
  return 0; }
build(){   # $1 repo · $2 track → the global array B (bwrap arguments); the rw targets that may not exist yet are created
  local dev="$H/dev/$1" wt="$H/.cc/worktrees/$1/$2" st="$H/.cc/state/$1/$2" proj mem cb f gd rs
  proj="$H/.claude/projects/$(slug "$wt")"; mem="$H/.claude/projects/$(slug "$dev")/memory"
  mkdir -p "$proj" "$mem" "$H/.npm" "$H/.cache" "$H/.cc/boards" "$st"
  B=(--die-with-parent --unshare-pid
     --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin
     --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$H")
  # THE WORKER'S SOURCES ARE DESCRIPTORS TOO — the same wall as the member boundary's, not a second one (see `pin`).
  # The parent `.git` is NOT rw any more: it is a tmpfs holding mountpoints of the real one (below), so `config` and
  # `hooks` are names in a directory no worker can write and neither is the reason for the pin. What this list still
  # hands a worker READ-WRITE is the worktree, `.git/objects`, this track's own admin dir, the two $NSD directories, the
  # track state and the two claude dirs — and the pin is for the sources that sit INSIDE those: the worktree's `.git`
  # and the admin dir's `commondir`, both pinned ro a few lines down, plus the rw sources themselves against a sibling
  # session. Named, each is resolved a second time by mount(2): what a worker leaves at one of those names is what the
  # NEXT launch mounts, and what a process racing this one puts there is what THIS launch mounts.
  # MEASURED BEFORE IT WAS CHANGED, because a wall nobody can climb is not worth the code. Today a live worker cannot
  # swap any of these itself, and not one of the reasons is a decision made here: bwrap binds each source ONTO ITS OWN
  # NAME, so the name is a MOUNTPOINT inside and renaming it is EBUSY (`mv .git/config .git/cfgx` → Device or resource
  # busy); a symlink left at one of them kills the launch, because this bwrap version will not resolve a bind DEST
  # through a link; and `unshare -Urm`, which would drop the mount and free the name, is Operation not permitted in
  # here. Bind a source anywhere but its own name, or leave a name absent at launch, and all three stop applying —
  # `[ -d "$dev/.git/hooks" ] &&` was the second of those and is gone below. The pin is the decision, stated once.
  # ORDER IS MOUNT ORDER: $H is a tmpfs above, so every path under it is pinned after that line, `.git` before what
  # sits in it.
  pinq --bind "$wt"
  # THE PARENT .git IS THE HOST'S, AND THE WORKER WRITES THREE PLACES IN IT. It used to be bound rw whole, which handed
  # every worker the box's entire ref store; measured on this file before the change, one `sh -c` inside moved
  # refs/heads/main, deleted a sibling track's branch, repointed the main checkout's HEAD, truncated packed-refs and
  # left `core.hooksPath = /tmp/evil` in the host's .git/config.worktree for its own git to run. None of that is work a
  # worker is launched to do. So the worker's `.git` is A TMPFS OF ITS OWN holding nothing but mountpoints of the real
  # one, and only these three are mounted rw, in mount order:
  #   objects/           the objects it commits (the Stop hook commits INSIDE the boundary; cc-loop pushes outside) —
  #                      APART FROM objects/pack, ro on top: a commit only ever writes a loose object, so nothing a
  #                      worker is launched to do needs the packed history writable.
  #   worktrees/<n>/     ITS OWN per-worktree git dir — HEAD, index, logs/HEAD, a rebase in progress. Every OTHER
  #                      track's is ro now, and was not.
  #   refs/heads/track/ and logs/refs/heads/track/  a DIRECTORY, not the ref file: the files backend creates
  #                      `<branch>.lock` beside the ref and renames it over, and a rename onto a bound FILE is EBUSY,
  #                      so a bind of the ref itself would break every commit. The PATH is the CONSTANT $NSD, and
  #                      refs/heads/main is not in it; the DIRECTORY behind it is this track's own (rstore), so no
  #                      sibling's branch is in it either. Neither is derived from the worktree's HEAD or from anything
  #                      else the worker writes — see branch_warn for what happened when it was.
  # WHY A TMPFS AND NOT A READ-ONLY BIND OF .git, WHICH IS WHAT THIS WAS FIRST: `git commit` clears MERGE_HEAD and
  # CHERRY_PICK_HEAD, and the files backend takes $GIT_COMMON_DIR/packed-refs.lock for that DELETE. With the directory
  # itself ro it could not, said `error: Unable to create …/packed-refs.lock: Read-only file system`, and left
  # CHERRY_PICK_HEAD behind — after which `git commit --amend` refused with "You are in the middle of a cherry-pick"
  # (measured, on a rebase-then-commit-then-amend the box does every day). A lock file needs a writable DIRECTORY, and
  # this gives it one that is the worker's own: a name the real `.git` does not already have is the worker's to create
  # and NOTHING the host reads, so the wall is deny-by-default — only what is bound below exists in there at all.
  # WHAT IT STILL LEAVES, plainly and measured: ONE thing, and it is objects/. A loose object a worker writes it can
  # also delete — the work in progress it has not pushed, and nothing else, because objects/pack is ro on top and every
  # branch but its own is now out of the namespace it writes. refs/heads/main, HEAD, the tags, the remotes,
  # packed-refs, config, config.worktree, hooks, every sibling track's branch and every other track's git dir are all
  # out of reach, and the selfcheck drives each one, the carve-out included.
  B+=(--tmpfs "$dev/.git")
  # …and hooks is MADE here rather than tested for, so its bind is unconditional. `[ -d ] &&` was a name test that
  # skipped quietly: a repo without the directory left the name free for a worker to take, and the next launch bound
  # whatever it found there — or, the link spelling, refused to start with a bwrap message naming neither cause nor cure.
  # …and so are the two rw ref directories, for the same reason and BEFORE the enumeration below, so that `refs` and
  # `logs` are always among the names it walls off and the rw binds land ON TOP of a ro mount rather than beside a gap.
  mkdir -p "$dev/.git/hooks" "$dev/.git/objects/pack" "$dev/.git/objects/info" "$dev/.git/$NSD" "$dev/.git/logs/$NSD" 2>/dev/null   # the host's checkpoint runs hooks: none of them may be the worker's
  for f in "$dev"/.git/* "$dev"/.git/.[!.]*; do   # every entry the real .git HAS, ro; the three rw ones are mounted over it below
    [ -e "$f" ] || continue                        # config, hooks, HEAD, packed-refs, index, info, refs, logs, worktrees…
    case "${f##*/}" in objects) pinq --bind "$f";; *) pinq --ro-bind "$f";; esac; done
  # …AND objects/pack RO ON TOP OF IT. A worker has to WRITE objects — every commit it makes is one — but it never has
  # to write a PACK: `git commit`, `rebase` and `amend` only ever write loose objects, and the two commands that do
  # write packs are already impossible in here (`fetch` and `push`, no credential). So the repository's packed history —
  # which is what `git gc` has already folded away, and the bulk of every repo the box has had for more than a day —
  # stops being deletable, while ordinary work is untouched. It does NOT close the objects carve-out: loose objects,
  # this worker's own and any a sibling wrote in the last hour, are still deletable, and that is written down at
  # "Known cost" in the header rather than implied away here. Pinned, because objects/ is a tree the worker writes; and
  # MADE above rather than tested for, on the same rule as hooks — a name test that skips quietly leaves the name free.
  pinq --ro-bind "$dev/.git/objects/pack"
  # …AND objects/info WITH IT, for a reason that is not deletion at all. `alternates` in there names another directory
  # the host's git then reads objects FROM, and `commit-graph` is a file every host git call in the repo parses.
  # Measured (review of #339): an alternates file written inside outlived the sandbox and the host's git read from a
  # directory the worker had named; a planted commit-graph made every host git call in ~/dev/<repo> error. Neither is
  # anything a worker has to write — git writes both in gc and repack, and neither can run in here — so the directory
  # is ro whole. Made above rather than tested for, on the same rule as hooks: a name test that skips leaves the name.
  pinq --ro-bind "$dev/.git/objects/info"
  gd=$(track_gitdir "$dev" "$wt") || { echo "cc-sandbox: $wt is not a linked worktree of $dev/.git — its .git and the git dir it names do not agree. Nothing was bound and nothing started." >&2; exit 2; }
  pinq --bind "$gd"
  # …AND THE TWO REDIRECT FILES OUT OF IT, ro. $gd is rw — the worker's own HEAD, index and rebase state live in it —
  # and the worktree is rw too, so both of the files that tell git where this worktree's git dir and common dir ARE sit
  # in a tree the worker writes. Left rw they hand back everything the tmpfs above took: `printf /tmp/evil >
  # .git/worktrees/<n>/commondir` (or `gitdir: /tmp/evil` into the worktree's own `.git`) re-points the host's next
  # `git -C "$wt" …` — `cc done`'s, running as the owner — at a common dir the worker wrote, config, hooks and
  # core.fsmonitor included. The member boundary pins exactly these two for exactly this reason (build_member,
  # review-156b). Unconditional: git writes both when it creates a linked worktree, so an absent one is a name free for
  # a worker to take and the launch should refuse rather than bind whatever is there next time.
  pinq --ro-bind "$wt/.git"; pinq --ro-bind "$gd/commondir"
  # …AND THE BRANCH NAMESPACE IS THIS TRACK'S OWN COPY OF IT, not the host's directory (rstore, above). The DEST is the
  # constant $NSD, never a name anything inside supplies; the SOURCE is under ~/.cc/sandbox, which no bind here reaches,
  # so it needs no pin — a name a worker cannot reach is not a name it can swap.
  rs=$(rstore "$1" "$2"); rs_seed "$1" "$2" || { echo "cc-sandbox: could not build $1/$2's own branch namespace under $rs — nothing was bound and nothing started." >&2; exit 2; }
  B+=(--bind "$rs/refs" "$dev/.git/$NSD" --bind "$rs/logs" "$dev/.git/logs/$NSD")
  branch_warn "$gd"   # AFTER the binds and changing none of them: a diagnostic, never an input
  pinq --bind "$st"; pinq --bind "$proj"; pinq --bind "$mem"
  B+=(--ro-bind "$H/.cc/boards" "$H/.cc/boards" --bind "$H/.npm" "$H/.npm" --bind "$H/.cache" "$H/.cache"
     --ro-bind "$H/bin" "$H/bin" --ro-bind "$H/.local/bin" "$H/.local/bin"
     --unsetenv TMUX --unsetenv TMUX_PANE --unsetenv SSH_AUTH_SOCK --unsetenv DOCKER_HOST --unsetenv CLAUDE_CODE_OAUTH_TOKEN
     --unsetenv CC_SANDBOX_TEST_DELAY --chdir "$wt")
  # STILL BOUND BY NAME, and why: every source below, and settings_bind's copy, is host-owned with a PARENT no sandbox on
  # this box can reach, so there is no name here for a walled-off session to redefine. ~/.cc/members/<h>/board is the
  # near miss — a member writes its CONTENTS (it is their ~/.cc/boards) but never sees the directory above it, so the
  # name is the host's. Refusing every worker launch because one member's board directory looks odd is the worse trade.
  for f in "$H"/.cc/members/*/board; do [ -d "$f" ] && B+=(--ro-bind "$f" "$f"); done   # ~/.cc/boards/<h>.json is a link in here (board_dir): ro, it resolves, and a worker writes no member's board
  settings_bind "$H/.cc/sandbox/$1/$2"   # ~/.cc/sandbox is under no bind above, so the source of the copy is not reachable from inside
  cb=$(dirname "$(readlink -f "$H/bin/cc-loop" 2>/dev/null || echo "$H/bin/cc-loop")")   # ~/bin is symlinks into the control repo's core/bin
  [ "$cb" != "$H/bin" ] && [ -d "$cb" ] && B+=(--ro-bind "$cb" "$cb")
  [ -d /run/systemd/resolve ] && B+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)   # /etc/resolv.conf points here
  for f in .local/share/claude .config/git .claude/plugins .gitconfig .npmrc; do [ -e "$H/$f" ] && B+=(--ro-bind "$H/$f" "$H/$f"); done; :; }
launch(){   # $1 repo · $2 track · the rest is the command
  local wt="$H/.cc/worktrees/$1/$2" cred="$H/.claude/.credentials.json" tok="" exp left
  # AHEAD OF build, not after it: build pins the worktree now, and a track that was never created is a plain mistake
  # that deserves its own sentence rather than pin's "that is not the path it should be".
  [ -d "$wt" ] || { echo "cc-sandbox: no worktree $wt" >&2; exit 2; }
  build "$1" "$2"; shift 2
  tok=$(jq -r '.claudeAiOauth.accessToken // empty' "$cred" 2>/dev/null) || tok=""
  if [ -z "$tok" ]; then echo "cc-sandbox: no access token in $cred — claude inside will not authenticate" >&2
  else exp=$(jq -r '.claudeAiOauth.expiresAt // 0' "$cred" 2>/dev/null); left=$(( ${exp:-0} / 1000 - $(date +%s) ))
    [ "$left" -lt 3900 ] && echo "cc-sandbox: the access token expires in $((left / 60)) min — if it does mid-run, this iteration errors and the next starts on the refreshed one" >&2; fi
  # fd 3: the ~/.claude.json copy — BUILT FROM A WHITELIST (projects, mcpServers), never the file minus a mask: Claude Code keeps
  #       oauthAccount (the owner's email) and userID at the top level, and a mask copied them inside (review-156e)
  #       fd 4: the credentials copy — claudeAiOauth minus its refresh token, nothing else of the file
  # THE WINDOW BETWEEN THE PINS AND THE MOUNT, WIDENED ON DEMAND — the same knob launch_member uses, for the same reason:
  # a race case that has to hit a microsecond is a case that passes by luck, and one that passes by luck cannot go red.
  # A NUMBER, never a command, and only ever set on the host — build --unsetenv's it, so nothing inside carries it on.
  case "${CC_SANDBOX_TEST_DELAY:-}" in ''|*[!0-9.]*) ;; *) sleep "$CC_SANDBOX_TEST_DELAY";; esac
  exec bwrap "${B[@]}" --file 3 "$H/.claude.json" --perms 0600 --file 4 "$cred" -- "$@" \
    3< <(jq --arg wt "$wt" '{projects: ((.projects // {}) | with_entries(select(.key == $wt))), mcpServers: {}}' "$H/.claude.json" 2>/dev/null || printf '{}') \
    4< <(jq '{claudeAiOauth: ((.claudeAiOauth // {}) | del(.refreshToken))}' "$cred" 2>/dev/null || printf '{}'); }
board_dir(){   # $1 handle — THE BOARD IS ONE FILE ON BOTH SIDES. ~/.cc/boards/<h>.json and .lock become links into
  # ~/.cc/members/<h>/board/, and build_member binds THAT DIRECTORY as the session's ~/.cc/boards. The file itself used to be
  # bound, and a file bind pins an inode: cc-board saves by renaming a new file over the old one, so every host save swapped
  # the board out from under the mount and a workspace read a track as running for half an hour after the host had marked it
  # done (2026-09-04). A directory bind sees new entries. Every host reader keeps its path through the link, and cc-board
  # resolves the link before it renames (_save), so the link is never replaced by a plain file. The lock goes first, as a
  # HARD link — same inode, so a holder on either path holds the same lock — and the board moves under that lock. A session
  # launched before this still holds a file bind and cc-board's in-place fallback; it converges on its next launch.
  local h="$1" bd="$H/.cc/members/$1/board" f src
  for f in "$h.lock" "$h.json"; do
    src="$H/.cc/boards/$f"; [ -L "$src" ] && continue
    ( if [ "$f" = "$h.json" ]; then exec 9>>"$H/.cc/boards/$h.lock"; flock 9; fi
      [ -L "$src" ] && exit 0   # another launch moved it while this one waited for the lock
      { ln -f "$src" "$bd/$f" 2>/dev/null || cp -p "$src" "$bd/$f"; } || exit 0
      ln -sfn "$bd/$f" "$src.ln.$$" && mv -Tf "$src.ln.$$" "$src" ) || :
  done; :; }
pin(){   # $1 --bind|--ro-bind · $2 the host object · [$3 where it is seen inside, default $2] → an fd-pinned bind, or 1
  # A BIND SOURCE IS NOT A NAME. bwrap resolves its sources at mount time, in the host's namespace, and BOTH boundaries
  # hand their session trees that hold some of those sources read-write (build_member: the workspace and its git dir;
  # build: the worktree and this track's own admin dir, which is where the two redirect files live — the parent `.git`
  # itself is no longer rw) — so a name there is a promise the walled-off side can break, three ways,
  # all three measured on this box: plant a symlink at it and the mount follows; rename a parent so it resolves somewhere
  # else; or, from a SECOND live session, swap it between the host's check and bwrap's mount. A
  # launch lock does not close the third — the attacker is a session that is already running — and a fourth name check
  # would not either, because whatever is checked gets resolved again by mount(2). So the host OPENS the object here,
  # confirms the descriptor is still the path it asked for, and hands bwrap /proc/self/fd/<n>: no name is resolved a
  # second time, and a symlink anywhere in the path shows up as a descriptor whose readlink is the target, not the path.
  # Refusing beats binding the wrong thing, so a mismatch returns 1 and the caller stops the launch.
  # THE DESCRIPTOR GOES TO BWRAP AS A DESCRIPTOR (--bind-fd/--ro-bind-fd), not as /proc/self/fd/<n>. Both mount the same
  # pinned inode, but bwrap CLOSES an fd it was handed this way and does not close one it merely read a path through:
  # measured, the /proc form left every one of these open in the member's own process, and `openat(dirfd, "../..")` on an
  # inherited directory fd walks the HOST tree — from the fd for ~/.cc/worktrees/<h> a session listed ~/.cc itself, which
  # this boundary exists to keep out. A wall that opens a door behind it is not a wall.
  # `exec {fd}<` and nothing else: an `exec` carrying a redirection with no command applies it to THIS SHELL for good,
  # so the quieting has to be a group around it (`exec {fd}<"$p" 2>/dev/null` sent every later launch message, the
  # settings-baseline warnings included, to /dev/null — caught by the baseline cases, which is what they are for).
  # The open is plain O_RDONLY, so a FIFO parked at one of these names would block it: [ -f ]/[ -d ] first keeps a
  # member from hanging their own launch. That test is for liveness only — the security decision is the readlink below,
  # which is made on the descriptor and cannot be raced, and never on a path that gets resolved a second time.
  local flag="$1" p="$2" tgt="${3:-$2}" fd
  [ -f "$p" ] || [ -d "$p" ] || return 1
  { exec {fd}<"$p"; } 2>/dev/null || return 1
  [ "$(readlink "/proc/self/fd/$fd" 2>/dev/null)" = "$p" ] || { exec {fd}<&-; return 1; }
  B+=("${flag}-fd" "$fd" "$tgt"); return 0; }
pinq(){ pin "$@" || { echo "cc-sandbox: $2 is not the path it should be — a link, a rename, or a swap by another live session. Nothing was bound and nothing started; put the real path back." >&2; exit 2; }; }
build_member(){   # $1 handle · $2 track ("" = the workspace root) → B; a member's world and nothing of the box's
  local h="$1" tr="$2" dev="$H/dev/$1" m="$H/.cc/members/$1" sl="$H/.cc/slack/member/$1" cb v cwd twt tname gw gd
  [ -f "$dev/.cc/member-workspace" ] || { echo "cc-sandbox: ~/dev/$h is not a member workspace (no .cc/member-workspace)" >&2; exit 2; }
  cwd="$dev"; [ -n "$tr" ] && cwd="$H/.cc/worktrees/$h/$tr"
  cb=$(dirname "$SELF")   # the bin THIS copy lives in (~/bin is symlinks into the control repo's core/bin; a track worktree tests its own), bound AS ~/bin
  gw="$H/.cc/sandbox/$h/gitwall"   # THE HOST'S OWN COPIES, in a dir under no bind below: the source of a wall is never a path the walled-off session can reach
  mkdir -p "$m/claude/projects" "$m/npm" "$m/cache" "$m/board" "$H/.cc/worktrees/$h" "$H/.cc/state/$h" "$sl/files" "$H/.cc/boards" "$gw"; : >> "$sl/enabled"
  : > "$gw/config.worktree"
  [ -f "$H/.cc/boards/$h.json" ] || "$cb/cc-board" init "$h" "$dev" main >/dev/null 2>&1 || : > "$H/.cc/boards/$h.json"
  : >> "$H/.cc/boards/$h.lock"
  board_dir "$h"
  B=(--die-with-parent --unshare-pid --clearenv
     --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin
     --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --tmpfs "$H")
  # THE WORKSPACE IS THE MEMBER'S; ITS GIT DIRECTORY IS NOT. The HOST runs git in this very repo — `cc <h> <track>`
  # fetches and adds a worktree here — so a hook the member drops in, a core.hooksPath they point at their own tree, or
  # an `ext::sh -c …` remote would execute as the OWNER outside the boundary, where ~/.ssh, ~/.cc/config and the
  # container socket are. Every source below is pinned by descriptor (pin), and the ORDER is the mount order: the
  # workspace, then .git, then what sits in it. Binding `.git` ITSELF is not a duplicate of the workspace bind — it
  # makes `.git` a MOUNTPOINT in the session's own namespace, and a mountpoint cannot be renamed or unlinked from the
  # namespace it is mounted in. Without it, measured: a session runs `mv ~/dev/<h>/.git .gitx && mkdir .git`, walks the
  # ro binds of config and hooks away with the old directory, and the host's next `git -C ~/dev/<h>` reads a git dir the
  # member wrote. A mount does NOT pin the name for anyone else — another namespace renames it freely, also measured —
  # but every member session of this workspace goes through here, so the name is pinned wherever a member has a shell.
  # NOTHING IS REPAIRED THROUGH A NAME THAT IS ALREADY WRONG, which is why `git init` comes after the pin and not before
  # it: with `.git` a link to another repo, an init run first would have made ITS git dir, out here, as the owner.
  pinq --bind "$dev"
  if ! pin --bind "$dev/.git"; then
    { [ -e "$dev/.git" ] || [ -L "$dev/.git" ]; } && pinq --bind "$dev/.git"   # something IS there and it is not this workspace's git dir: refuse, never repair
    git -C "$dev" init -q >/dev/null 2>&1   # nothing there at all: the repo must exist OUT here first, or there is nothing to hold read-only
    pinq --bind "$dev/.git"
  fi
  [ -f "$dev/.git/config" ] || git -C "$dev" init -q >/dev/null 2>&1   # a git dir that is this workspace's, but half made
  mkdir -p "$dev/.git/hooks" 2>/dev/null
  pinq --ro-bind "$dev/.git/config"
  pinq --ro-bind "$dev/.git/hooks"
  # A CONFIG FILE THE MEMBER WROTE AND THE HOST READ. git reads exactly two repo-level config files: the common dir's
  # `config`, held ro above, and `$GIT_DIR/config.worktree`, which it reads when extensions.worktreeConfig is on. The
  # admin dirs must stay writable — a member's own commit writes its index and HEAD in there, which is why they cannot
  # be held whole (the selfcheck's commit case proves it) — so config.worktree is a name a member can CREATE, in the
  # workspace's own git dir and in every track's. A bind made only where the file already existed was one they stepped
  # around by creating it. So the host binds ITS OWN empty file at every one of those names, present or not, from $gw
  # where no session reaches. Nothing in core turns the extension on and the config that would is ro above; if it is
  # ever on, the file is live and its content is not the host's, so the launch refuses rather than guess.
  # --type=bool, not a string compare: `--get` hands back the RAW text, and git honours 1/yes/on/TRUE as true, so
  # comparing against the literal "true" left the extension LIVE for every other spelling git accepts (review of #298).
  [ "$(git config --file "$dev/.git/config" --type=bool --get extensions.worktreeConfig 2>/dev/null)" = true ] && {
    echo "cc-sandbox: ~/dev/$h/.git/config turns extensions.worktreeConfig on — every config.worktree in there goes live and this boundary does not own their content. Turn it off, or take this to the owner." >&2; exit 2; }
  pinq --ro-bind "$gw/config.worktree" "$dev/.git/config.worktree"
  mkdir -p "$dev/.git/worktrees" 2>/dev/null   # made here so the pin below is unconditional: a workspace with no track yet would otherwise leave the name free for a session to take
  pinq --bind "$dev/.git/worktrees"
  # THE ONE BIND WHOSE DESTINATION IS A MEMBER'S NAME. Everywhere else pin() checks the SOURCE, which is the whole
  # point of this file; here the source is the host's own $gw and the DEST is `<admin dir>/config.worktree`, under a
  # directory name a member creates. The glob's trailing `/` matches a symlink-to-directory and `[ -d ]` follows it,
  # so `ln -s <somewhere the owner can write> .git/worktrees/x` aimed the dest through the link (review of #298).
  # A symlinked admin dir is not a real one — git never makes it — so refuse the launch rather than skip it quietly.
  # The glob loses its trailing `/` and the link test comes BEFORE the -d one, both for the same reason: `*/` matches
  # only directories and -d follows a link, so a DANGLING link was neither iterated nor tested — and that is the
  # easier plant of the two, since the target need not exist yet.
  # This is the one name test left in here, and it is check-then-use: a live session can still swap the name between
  # this line and the mount. What it cannot do is turn that into a wrong mount — measured on bwrap 0.11.1, a bind DEST
  # is not resolved through a symlink at all, so losing the race costs the launch, not the boundary. Both walls stand
  # or neither is enough; do not drop this one on the strength of the other.
  for gd in "$dev"/.git/worktrees/*; do
    [ -e "$gd" ] || [ -L "$gd" ] || continue   # an empty worktrees dir leaves the pattern itself in $gd
    [ -L "$gd" ] && { echo "cc-sandbox: ~/dev/$h/.git/worktrees/$(basename "$gd") is a symlink, not an administration directory — git does not make one, so something put it there. Remove it, or take this to the owner." >&2; exit 2; }
    [ -d "$gd" ] || continue
    pinq --ro-bind "$gw/config.worktree" "$gd/config.worktree"; done
  # …and the per-track gitlinks (review-156b): the worktree tree is rw, so its `.git` FILE could otherwise be replaced
  # with a member git dir whose hooks the host's checkpoint would run as the owner. The REDIRECT files are the repo's,
  # not the member's — the gitlink and the admin dir's `commondir` (re-pointing it swaps in a member-owned common dir,
  # config and hooks included). The host-side checkpoint pins core.hooksPath on top (core/bin/cc).
  pinq --bind "$H/.cc/worktrees/$h"
  for twt in "$H/.cc/worktrees/$h"/*/; do
    [ -f "${twt}.git" ] || continue
    tname=$(basename "$twt")
    pinq --ro-bind "${twt}.git"
    [ -f "$dev/.git/worktrees/$tname/commondir" ] && pinq --ro-bind "$dev/.git/worktrees/$tname/commondir"
  done
  B+=(--bind "$H/.cc/state/$h" "$H/.cc/state/$h"
     --bind "$m/board" "$H/.cc/boards"
     --bind "$sl" "$H/.cc/slack" --bind "$m/claude/projects" "$H/.claude/projects" --bind "$m/npm" "$H/.npm" --bind "$m/cache" "$H/.cache"
     --ro-bind "$cb" "$H/bin" --ro-bind "$H/.local/bin/claude" "$H/.local/bin/claude"
     --setenv HOME "$H" --setenv PATH "$H/bin:$H/.local/bin:/usr/local/bin:/usr/bin:/bin" --setenv CC_MEMBER_SANDBOX 1 --setenv CC_ROLE member
     --setenv GIT_AUTHOR_NAME "$h" --setenv GIT_AUTHOR_EMAIL "$h@member.$(hostname -s)" --setenv GIT_COMMITTER_NAME "$h" --setenv GIT_COMMITTER_EMAIL "$h@member.$(hostname -s)"
     --chdir "$cwd")
  # His hooks (cc-guard: depth inside the wall) come through this copy unchanged, with the sealed-session permissions
  # appended. ~/.cc/sandbox is under no bind above, so the source of the copy is not reachable from inside.
  settings_bind "$H/.cc/sandbox/$h/${tr:-_workspace}"
  [ -d "$H/.local/share/claude" ] && B+=(--ro-bind "$H/.local/share/claude" "$H/.local/share/claude")
  [ -d /run/systemd/resolve ] && B+=(--ro-bind /run/systemd/resolve /run/systemd/resolve)
  # CC_LOOP_TRIM crosses like the rest: it is set in front of a dispatch on the HOST, and the loop it steers runs in HERE
  # (`cc <h> <t> --go` opens the window as `cc-sandbox member … -- cc-loop`), so without it a member's track is the one
  # track on the box that cannot be trimmed from the dispatch line.
  for v in TERM LANG LC_ALL COLORTERM USER LOGNAME SHELL CC_SLACK_CHANNEL CC_CLAUDE CC_NOTIFY_LOG_ONLY CC_NOTIFY_LOG CC_LIMIT_STAMP CC_LOOP_TRIM CC_GUARD_ASKS CC_GUARD_ASK_TTL; do
    [ -n "${!v:-}" ] && B+=(--setenv "$v" "${!v}"); done; :; }
launch_member(){   # $1 handle · $2 track · the rest is the command — the WORKSPACE'S OWN credential, or no launch at all;
                   # a narrower ~/.claude.json
  local h="$1" tr="$2" dev="$H/dev/$1" cred="$H/.claude/.credentials.json" own="$H/.cc/members/$1/credentials.json" mcp='{}' cwd why
  build_member "$h" "$tr"; shift 2
  [ -z "$tr" ] || [ -d "$H/.cc/worktrees/$h/$tr" ] || { echo "cc-sandbox: no worktree for $h/$tr" >&2; exit 2; }
  cwd="$dev"; [ -n "$tr" ] && cwd="$H/.cc/worktrees/$h/$tr"   # the same cwd build_member chdirs to: the trust key is its git root
  # WHATEVER CREDENTIAL IS INSIDE, THE MEMBER CAN PRINT IT — they drive a session in there. A workspace runs on the credential
  # MINTED FOR IT at ~/.cc/members/<h>/credentials.json (bound rw at ~/.claude/.credentials.json — the member sees the file
  # at claude's path and never its host path), and without one it does not start. What it must never be again is the
  # owner's by FALLBACK: that is what it was until review-156c, announced on every launch, and since every workspace shipped
  # without one, every member session would have held the box's token from day one. His own account may be minted here
  # deliberately (owner, 2026-09-02) and mint says so when it is; what stays refused is starting on his because none was set.
  # Fail closed, and say what to mint.
  # This is the LAST wall: cc checks the same file on the host before it opens the window (member_credential), and tells
  # #<h> and the owner — a refusal here lands in a pane nobody reads (review-156d).
  if ! cred_usable "$own"; then
    why=$(cred_why "$own")
    echo "cc-sandbox: $h has no credential of its own ($own: $why) — a workspace never falls back to anyone else's. Mint one: cc-sandbox mint $h — it walks the login and installs what that login produced at $own, mode 600. Nothing starts here until then." >&2
    exit 2
  fi
  # THE FILE ITSELF, bound rw at claude's path — not a copy of its content. A copy landed in the tmpfs, so the refresh a
  # session made inside was lost at exit and every start began from the minted token again; once the server had rotated
  # the refresh token the minted one no longer refreshed, and the workspace came up 'Not logged in' (2026-09-04, 43 h past
  # expiry) until the owner re-minted it. Measured on 2.1.261: claude writes the credential IN PLACE (O_TRUNC|O_NOFOLLOW,
  # no rename), so a file bind takes the write — and it refuses a symlink there, so a link would not have done. The mode is
  # the file's own (mint installs 600).
  B+=(--bind "$own" "$cred")
  [ -f "$H/.cc/slack/enabled" ] && mcp=$(jq -cn --arg c "$H/bin/cc-slack" '{"cc-slack": {type: "stdio", command: $c, args: ["channel"], env: {}}}')
  # fd 3: the ~/.claude.json copy (the credential is the bind above, not a copy)
  # THE FIRST-RUN FLAGS ARE MINTED HERE, NOT CARRIED ACROSS. The whitelist stays two keys wide, so the copy used to say
  # "this machine has never run claude": 2.1.258 gates the setup wizard on `!hasCompletedOnboarding` of the GLOBAL config
  # and the login is a STEP of that wizard, so a member was walked through setup and asked to sign in on every start with
  # a valid credential already in place. Same for the trust dialog, gated per project on
  # `projects[<git root of cwd>].hasTrustDialogAccepted`. This copy is rebuilt from scratch each start and nothing written
  # inside it survives, so both are GENERATED true here — literals in this program, not values read out of his file (the
  # only thing read out of it is `projects`, filtered as before; nothing here writes it).
  # Trust: the workspace IS the member's own repo, and the boundary is what makes running its code safe, so his own
  # answer for that path is not the question being answered and does not carry over either way.
  # Only paths of this workspace get it ($dev and the cwd — a track worktree is its own git root, and the owner's file
  # carries no entry for one). lastOnboardingVersion is not set: 2.1.258 only ever writes it, nothing reads it.
  # HIS projects RIDE A PIPE, NEVER argv, and an unusable source still gets the flags (review-189a): as one argv element
  # a projects object past MAX_ARG_STRLEN (128 KiB) makes execve fail E2BIG and jq never runs, and an empty ~/.claude.json
  # makes the inner jq exit 0 with no output — either way fd 3 would write nothing, `--file 3` would make an EMPTY
  # ~/.claude.json inside, and the wizard would be back with only a stderr line in a pane nobody reads. `input? // {}`
  # is the fallback: no projects to filter, flags minted all the same.
  # THE WINDOW BETWEEN THE PINS AND THE MOUNT, ON PURPOSE. build_member opened every member-side source above; bwrap
  # mounts them below. A racing session of the same handle gets whatever time passes in between, and the selfcheck has
  # to be able to lose that race on demand instead of hoping to hit a microsecond — so it widens the window with this.
  # A NUMBER, never a command, and only ever set on the host: the environment inside is cleared, so no session sets it.
  case "${CC_SANDBOX_TEST_DELAY:-}" in ''|*[!0-9.]*) ;; *) sleep "$CC_SANDBOX_TEST_DELAY";; esac
  exec bwrap "${B[@]}" --file 3 "$H/.claude.json" -- "$@" \
    3< <({ jq -c '.projects // {}' "$H/.claude.json" 2>/dev/null || printf '{}'; } \
         | jq -n --arg d "$dev" --arg cwd "$cwd" --arg w "$H/.cc/worktrees/$h/" --argjson m "$mcp" \
           '{projects: (((input? // {}) | with_entries(select(.key == $d or (.key | startswith($w)))))
                        | reduce ($d, $cwd) as $k (.; .[$k] = ((.[$k] // {}) + {hasTrustDialogAccepted: true}))),
             mcpServers: $m, hasCompletedOnboarding: true}'); }
CLAUDEBIN="${CC_CLAUDE:-$H/.local/bin/claude}"   # the same knob cc and cc-loop use to name claude
handle_ok(){ [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]]; }   # a workspace's dir name IS its handle and its channel name
owners_own(){   # $1 candidate credentials file · $2 the .claude.json that login wrote ("" = none) → prints WHY, exit 0, when it is the OWNER'S
  # This used to REFUSE, and until 2026-09-02 that was right: a member drives the session inside their boundary and can print
  # whatever sits at ~/.claude/.credentials.json, so his credential in there is a working key to his account. The owner has
  # since decided otherwise, three times and plainly — "These are trusted people just treat minting my account like any other
  # account" — so 0 (true) HERE no longer stops anything; it is what lets mint NAME what is being installed. The detection is
  # kept whole for that: it is his file, it carries his token, or the login signed in as his account (a fresh token for the
  # same account is still his). Do not restore the refusal, and do not add a flag or a confirmation he did not ask for.
  local cand="$1" cj="${2:-}" oc="$H/.claude/.credentials.json" oj="$H/.claude.json" a b
  if [ -e "$oc" ]; then
    [ "$(readlink -f "$cand")" = "$(readlink -f "$oc")" ] && { echo "that file IS ~/.claude/.credentials.json — the owner's own"; return 0; }
    a=$(jq -r '.claudeAiOauth.accessToken // empty' "$cand" 2>/dev/null); b=$(jq -r '.claudeAiOauth.accessToken // empty' "$oc" 2>/dev/null)
    [ -n "$a" ] && [ "$a" = "$b" ] && { echo "it carries the owner's own access token"; return 0; }
    a=$(jq -r '.claudeAiOauth.refreshToken // empty' "$cand" 2>/dev/null); b=$(jq -r '.claudeAiOauth.refreshToken // empty' "$oc" 2>/dev/null)
    [ -n "$a" ] && [ "$a" = "$b" ] && { echo "it carries the owner's own refresh token"; return 0; }
  fi
  if [ -n "$cj" ] && [ -f "$cj" ] && [ -f "$oj" ]; then
    a=$(jq -r '.oauthAccount.accountUuid // empty' "$cj" 2>/dev/null); b=$(jq -r '.oauthAccount.accountUuid // empty' "$oj" 2>/dev/null)
    [ -n "$a" ] && [ "$a" = "$b" ] && { echo "that login signed in as the owner's own account"; return 0; }
    a=$(jq -r '(.oauthAccount.emailAddress // empty) | ascii_downcase' "$cj" 2>/dev/null); b=$(jq -r '(.oauthAccount.emailAddress // empty) | ascii_downcase' "$oj" 2>/dev/null)
    [ -n "$a" ] && [ "$a" = "$b" ] && { echo "that login signed in as the owner (same email address)"; return 0; }
  fi
  return 1; }
cred_usable(){   # $1 a credentials file — THE test of "this credential can authenticate", and the only one.
  # mint asked it with jq and the trap that keeps a scratch asked it with -s, so a truncated or wrong-shaped file was
  # kept and advertised with a --from line that could not work. Every wall in here answers it the same way, and so does
  # the host's own (member_credential in cc), or they drift again.
  # A BLANK TOKEN IS NOT A TOKEN. `jq -e '.claudeAiOauth.accessToken'` is TRUE for "" — only false and null are falsy in
  # jq — and "" is exactly what claude leaves in the file when a refresh is refused: accessToken and refreshToken emptied
  # in place, expiresAt 0, scopes and subscriptionType intact. So every wall waved it through and the session came up
  # "Not logged in · Run /login" while the board said running and nobody was told (a member's sub-project session,
  # 2026-09-08: hours alive, 0 context, injected messages never read). Require a non-empty STRING, so a token of the
  # wrong type is no token either.
  # This predicate sits OUTSIDE the slice member_v2.py digests (that one ends at CLAUDEBIN= above), so the freeze pin
  # does not guard it. Its behaviour cases do: the blanked-credential case in selfcheck_member below, and the host
  # wall's in tests/selftest.sh. Change the rule here and those go red, not the digest.
  [ -s "${1:-}" ] && jq -e '.claudeAiOauth.accessToken | type == "string" and length > 0' "${1:-}" >/dev/null 2>&1; }
cred_why(){   # $1 a credentials file that cred_usable refused — the half of the reason a person acts on
  [ -e "${1:-}" ] || { echo missing; return; }
  jq -e '.claudeAiOauth.accessToken == ""' "${1:-}" >/dev/null 2>&1 \
    && { echo 'present, but its access token is EMPTY — that workspace was signed out (a refused refresh blanks the token in place), so it needs minting again'; return; }
  echo 'present, but has no .claudeAiOauth.accessToken'; }
MINT_SCRATCH=""; MINT_HANDLE=""; MINT_DEST=""   # the login's throwaway HOME while nothing has been installed from it yet
mint_left_behind(){   # THE END THAT IS NOT AN INSTALL — on EXIT, however mint got there. The first real mint (2026-09-02)
  # ended here without this: claude was closed rather than quit, mint died with it between the login and the copy, and the
  # scratch holding a valid credential was left with nobody told which one it was. So when a login is still sitting in there
  # it is KEPT and NAMED, with the line that finishes from it — the owner has already typed that login once. Only a scratch
  # whose login produced nothing INSTALLABLE is deleted — an unreadable file is nothing to recover, and naming it would
  # promise a --from that fails.
  local s="$MINT_SCRATCH"; MINT_SCRATCH=""
  [ -n "$s" ] || return 0
  if cred_usable "$s/.claude/.credentials.json"; then
    echo "cc-sandbox: NOTHING WAS INSTALLED at $MINT_DEST. The login is still in $s — kept, so nobody has to log in twice." >&2
    echo "  Finish it: cc-sandbox mint $MINT_HANDLE --from $s/.claude/.credentials.json" >&2
    echo "  Then delete $s — it holds a working credential." >&2
  else rm -rf "$s"; fi; }
mint(){   # $1 handle · [--from <file>] — INSTALL WHAT A LOGIN PRODUCED, and nothing else. No credential is invented here and
  # none is forwarded: either claude runs in a throwaway HOME so <handle> logs in there, or --from names the file a login
  # somewhere else produced. Both go through owners_own, which now NAMES the owner's own rather than stopping it. Run inside a member's own boundary this
  # writes into that tmpfs HOME and dies with it — ~/.cc/members is not bound in there.
  local h="${1:-}" src="" cj="" scratch="" dest own why old="" closed=0 told=0
  [ -n "$h" ] && shift
  while [ $# -gt 0 ]; do case "$1" in
    --from) src="${2:-}"; [ -n "$src" ] || { echo "cc-sandbox: --from needs a file" >&2; return 2; }; shift;;
    *) echo "usage: cc-sandbox mint <handle> [--from <file>]" >&2; return 2;; esac; shift; done
  handle_ok "$h" || { echo "cc-sandbox: '$h' is not a handle (lower case, digits and -)" >&2; return 2; }
  [ -f "$H/dev/$h/.cc/member-workspace" ] || { echo "cc-sandbox: ~/dev/$h is not a member workspace — make one first (cc-sandbox convert $h), then mint into it" >&2; return 2; }
  dest="$H/.cc/members/$h/credentials.json"
  if [ -z "$src" ]; then
    [ -x "$CLAUDEBIN" ] || { echo "cc-sandbox: no claude at $CLAUDEBIN — there is nothing to log in with" >&2; return 2; }
    scratch=$(mktemp -d "${TMPDIR:-/tmp}/cc-mint-XXXXXX") || return 2; chmod 700 "$scratch"; mkdir -p "$scratch/.claude"
    MINT_SCRATCH="$scratch"; MINT_HANDLE="$h"; MINT_DEST="$dest"; trap mint_left_behind EXIT   # from here on, no silent end
    echo "cc-sandbox: logging $h in inside a throwaway HOME ($scratch) — nothing of yours is in there, and it is deleted once the credential is installed."
    echo "  Sign in AS $h, not as yourself; then quit claude (/exit). Whatever that login wrote is what gets installed."
    # A CLOSE IS NOT A QUIT. Ctrl-C, a shut window or a killed claude signals the whole foreground group, so the same signal
    # that ends claude ends mint — on 2026-09-02 that happened after a good login and before the copy, and mint installed
    # nothing without a word. Catch the three that carry, then install what the login already wrote.
    trap 'closed=1' INT TERM HUP
    # the owner's token must not ride in on the environment either: with one of these set claude never asks who is logging in
    ( cd "$scratch" && env -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_API_KEY -u CLAUDE_CODE_API_KEY -u CLAUDE_CONFIG_DIR HOME="$scratch" "$CLAUDEBIN" )
    trap 'exit 2' INT TERM HUP   # past the login, the same signals end mint — through the EXIT trap, which names the scratch
    [ "$closed" = 1 ] && echo "cc-sandbox: claude was closed rather than quit (/exit) — carrying on with whatever that login wrote." >&2
    src="$scratch/.claude/.credentials.json"; cj="$scratch/.claude.json"
  else cj="$(dirname "$(dirname "$src")")/.claude.json"   # a login writes .claude.json a level above its .claude/: if it is there, WHO logged in is checkable too
  fi
  if ! cred_usable "$src"; then
    why=$(cred_why "$src")
    echo "cc-sandbox: that login produced no credential ($src: $why) — nothing was written to $dest." >&2
    return 2; fi   # the EXIT trap deletes the scratch: there is no credential in it to leave anyone
  if why=$(owners_own "$src" "$cj"); then
    echo "cc-sandbox: this is the OWNER'S OWN credential — $why. Installing it, because that is what you asked for."
    echo "  Once, so it is never a surprise: $h can print this from inside their workspace and use that account anywhere, not just on this box."; fi
  mkdir -p "$H/.cc/members/$h" && chmod 700 "$H/.cc/members/$h" \
    || { echo "cc-sandbox: could not make $H/.cc/members/$h — nothing was installed" >&2; return 2; }
  [ -e "$dest" ] && old=" (replacing the one there since $(date -r "$dest" +%F 2>/dev/null))"
  own="$dest.tmp.$$"
  # 0600, and the shape `cc-sandbox member` reads: claudeAiOauth whole, refresh token included — the workspace refreshes itself
  if ! ( umask 077; jq '{claudeAiOauth: .claudeAiOauth}' "$src" > "$own" ) || ! chmod 600 "$own" || ! mv "$own" "$dest"; then
    rm -f "$own"; echo "cc-sandbox: could not write $dest — nothing was installed" >&2; return 2; fi
  # SAY IT INSTALLED ONLY AFTER READING BACK WHAT LANDED: the message below is the owner's only evidence, and the boundary
  # reads this exact file next. A dest that does not parse is a mint that installed nothing, and says so, non-zero.
  if ! cred_usable "$dest"; then
    echo "cc-sandbox: $dest is not a credential the boundary can read — nothing was installed" >&2; return 2; fi
  if [ -n "$scratch" ]; then rm -rf "$scratch"; MINT_SCRATCH=""; trap - EXIT; fi   # installed: now there is nothing to keep
  # THE CHANNEL THAT WAS TOLD THE WALL IS TOLD IT IS GONE (owner, 2026-09-04). While there was no credential #<h> got
  # the mint command once, from `cc` (member_credential), and the credential-told stamp records that. The wall ends
  # HERE, so the good news goes out here — but ONLY where the bad news went: a credential ROTATED on a workspace that
  # is already answering never had a wall, and "ready" in that channel is a line about nothing. Both stamps go either
  # way, so a workspace that loses its credential later gets a fresh line and a fresh page, not an inherited silence.
  # --major: this line is routine text, and without it post() files it in the #<h>-updates twin, not the channel the
  # member is waiting in.
  [ -e "$H/.cc/members/$h/credential-told" ] && told=1
  rm -f "$H/.cc/members/$h/credential-told" "$H/.cc/members/$h/credential-asked"
  [ "$told" = 1 ] && { "$(dirname "$SELF")/cc-slack" post -c "#$h" --major "\`$h\` is ready — message this channel and it answers." >/dev/null 2>&1 || true; }
  echo "cc-sandbox: minted $h's credential at $dest, mode 600$old — that is the one file the boundary reads, and the only credential inside it."
  echo "  Start the workspace: cc $h"; }
convert(){   # $1 repo — an ORDINARY ~/dev/<repo> becomes a member workspace, or is refused with the reason. The four that
  # exist were made by cc-slack's join flow; a repo already on the box has no such path, and hand-editing the markers leaves
  # out the board, the exclude and the first commit. This makes the same workspace that flow makes, and says what it changed.
  local r="${1:-}" dev ctl live n why br x did=()
  handle_ok "$r" || { echo "cc-sandbox: '$r' is not a handle (lower case, digits and -)" >&2; return 2; }
  dev="$H/dev/$r"
  [ -d "$dev" ] || { echo "cc-sandbox: no ~/dev/$r to convert" >&2; return 2; }
  [ -f "$dev/.cc/member-workspace" ] && { echo "cc-sandbox: ~/dev/$r is already a member workspace — nothing changed."; return 0; }
  # THE CONTROL REPO IS NOT SOMEBODY'S WORKSPACE. This command lives in it; converting it would put the box's own source —
  # every script that runs the box, this one included — inside one member's world, where they may edit it.
  ctl=$(dirname "$(dirname "$(dirname "$SELF")")")
  if [ "$(readlink -f "$dev")" = "$(readlink -f "$ctl")" ] || [ -f "$dev/core/bin/cc-sandbox" ]; then
    echo "cc-sandbox: refusing ~/dev/$r — it is the box's own control repo (this command ships in it). A member workspace cannot be the thing that runs the box." >&2; return 2; fi
  # LIVE TRACKS RUN OUTSIDE THE BOUNDARY. Converting under them would leave half of this repo in and half out: their
  # worktrees, state and windows were made on the host, and the workspace's are made inside.
  live=""; n=$(git -C "$dev" worktree list --porcelain 2>/dev/null | grep -c '^worktree ') || n=0
  [ "${n:-0}" -gt 1 ] && live="it has $((n - 1)) git worktree(s) of its own"
  if [ -n "$(ls -A "$H/.cc/worktrees/$r" 2>/dev/null)" ]; then
    live="${live:+$live, and }tracks live under ~/.cc/worktrees/$r ($(ls -A "$H/.cc/worktrees/$r" | tr '\n' ' ' | sed 's/ $//'))"; fi
  [ -n "$live" ] && { echo "cc-sandbox: refusing ~/dev/$r — $live. Those run outside the boundary; finish or remove them (cc rm $r <track>), then convert." >&2; return 2; }
  # A COLLIDING HANDLE IS REFUSED, NEVER ADOPTED (docs/design-member-workspaces.md, "Open risks"): a workspace routes by its
  # NAME, so a name the box already answers to would hand this person a channel that is somebody else's.
  why=""; case "$r" in box|approvals|alerts) why="\`$r\` is one of the box's own channels";; *-updates) why="\`$r\` reads as the updates lane of #${r%-updates}";; esac
  if [ -z "$why" ] && [ -f "$H/.cc/slack/routes.json" ]; then
    why=$(jq -r --arg n "$r" 'to_entries[] | select(((.key|tostring|ltrimstr("#")|ascii_downcase) == $n) or ((.value|tostring|split("/")[0]|ascii_downcase) == $n)) | "`" + $n + "` is already routed to a session on this box"' "$H/.cc/slack/routes.json" 2>/dev/null | head -1) || why=""; fi
  [ -n "$why" ] && { echo "cc-sandbox: refusing ~/dev/$r — $why. Rename the repo to a free handle and convert that one." >&2; return 2; }
  mkdir -p "$dev/.cc" || { echo "cc-sandbox: could not make $dev/.cc — nothing was changed" >&2; return 2; }
  printf '%s\n%s\n' "# member workspace — the DIRECTORY NAME is the handle; nothing reads this file's contents" \
                    "# (docs/design-member-workspaces.md)" > "$dev/.cc/member-workspace"
  : >> "$dev/.cc/member-facing"; did+=(".cc/member-workspace and .cc/member-facing — the boundary and the guard tier key on these")
  # THE MEMBER INSTRUCTIONS, which this path used to leave out ENTIRELY: the join flow writes them, convert never ran it,
  # and a converted workspace's session was left with no way to know a project channel is asked for (2026-09-02). One
  # definition, in cc-slack, so this cannot drift from what the join flow writes. Before the first commit below, so a
  # repo with no HEAD gets it into that commit.
  if x=$("$(dirname "$SELF")/cc-slack" member instructions "$r" 2>&1); then did+=("$x")
  else echo "cc-sandbox: the member instructions were NOT written into ~/dev/$r/README.md ($x). Its sessions still get them from their own prompt, but the member cannot read how a project channel is made — write them by hand." >&2; fi
  [ -e "$dev/.git" ] || { git -C "$dev" init -q >/dev/null 2>&1 && did+=("git init: a workspace's work is tracked"); }
  mkdir -p "$dev/.git/info" 2>/dev/null
  grep -qx '\.cc/' "$dev/.git/info/exclude" 2>/dev/null || { echo '.cc/' >> "$dev/.git/info/exclude" && did+=(".cc/ excluded from commits — a committed marker travels into every worktree as an editable file claiming an identity"); }
  if ! git -C "$dev" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    git -C "$dev" add -A >/dev/null 2>&1 && git -C "$dev" -c user.name=cc -c user.email=cc@localhost commit -q -m "$r's workspace" >/dev/null 2>&1 \
      && did+=("a first commit: with no HEAD there is nothing for its tracks to branch from"); fi
  br=$(git -C "$dev" symbolic-ref --short HEAD 2>/dev/null) || br=main; [ -n "$br" ] || br=main
  "$(dirname "$SELF")/cc-board" init "$r" "$dev" "$br" >/dev/null 2>&1 && did+=("its board (~/.cc/boards/$r.json) — rows it already had are kept")
  echo "cc-sandbox: ~/dev/$r is a member workspace now. Changed:"
  for x in ${did[@]+"${did[@]}"}; do echo "  - $x"; done
  echo "Next: cc-sandbox mint $r — it starts on nothing else. Its Slack channel pair and members.json record are the daemon's: cc-slack member add <@user>."; }
selfcheck_member(){   # a scratch member workspace next to a scratch OTHER repo: inside, the other repo, the config, the ledger and the
                      # control repo's path do not exist; the workspace, its track, its board and its Slack dir do; git and cc-board work
  local h="_ccsbxm$$" o="_ccsbxo$$" dev out ctl c rc mcpw own mine miner kf cb real0 real1
  cb=$(dirname "$SELF")   # the host side of every board case below: THIS tree's cc-board, which resolves a linked board before it renames
  dev="$H/dev/$h"; mkdir -p "$dev/.cc" "$H/dev/$o" "$H/.cc/state/$o" "$H/.cc/state/$h" || return 1
  : > "$dev/.cc/member-workspace"; : > "$dev/.cc/member-facing"; echo x > "$H/dev/$o/secret"; echo '{}' > "$H/.cc/boards/$o.json"
  git -C "$dev" init -q -b main && git -C "$dev" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init || return 1
  git -C "$dev" worktree add -q -b track/t "$H/.cc/worktrees/$h/t" >/dev/null 2>&1 || return 1; mkdir -p "$H/.cc/worktrees/$h/t/.cc"; printf '%s\n%s\n' "$h" t > "$H/.cc/worktrees/$h/t/.cc/track"
  # A KEY OF ITS OWN in the box's secrets dir, so the case below is a real one on a box that has no app yet:
  # the GitHub App private key can push to and create repositories in the org, and it must be unreachable from
  # inside every workspace (docs/github-app.md, cc-gh-token). Only this file is planted, and only it is removed.
  kf="$H/.cc/secrets/_ccsbxkey$$.pem"; mkdir -p "$H/.cc/secrets" 2>/dev/null; ( umask 077; echo fixture-key > "$kf" ) || return 1
  ctl=$(dirname "$(dirname "$(dirname "$SELF")")")   # ~/dev/<control repo> (or the worktree this copy is tested from): must not exist inside
  c="$H/.claude/.credentials.json"; own="$H/.cc/members/$h/credentials.json"
  # NO CREDENTIAL OF ITS OWN → NO LAUNCH (review-156c: the owner's used to be the fallback here). None, then a file without an
  # access token: the command never runs — its marker must not come back — and the refusal says what to mint and where.
  rm -f "$own"; out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
  t 'member: with no credential of its own the workspace does NOT start — the owner'"'"'s is no fallback' "$rc/$(grep -c STARTED <<<"$out")" 2/0
  t 'member: and the refusal names the command that mints one' "$(grep -cF "Mint one: cc-sandbox mint $h" <<<"$out")" 1
  mkdir -p "$(dirname "$own")" && echo '{"claudeAiOauth": {}}' > "$own" || return 1
  out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
  t 'member: a credential file without an access token is no credential — still no start' "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'has no .claudeAiOauth.accessToken' <<<"$out")" 2/0/1
  # …AND NEITHER IS A BLANKED ONE. This exact file — accessToken and refreshToken emptied in place, expiresAt 0, the rest
  # of a real credential intact — is what claude leaves behind when a refresh is refused, and `jq -e .accessToken` says
  # true for "". So the wall passed it and a member's sub-project session sat for hours showing "Not logged in · Run
  # /login" while its row said running (2026-09-08). It is a signed-out workspace, not an unminted
  # one, and the refusal has to say which: only one of the two is a mint that never happened.
  echo '{"claudeAiOauth": {"accessToken": "", "refreshToken": "", "expiresAt": 0, "subscriptionType": "max"}}' > "$own" || return 1
  out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
  t 'member: a credential BLANKED by a refused refresh is no credential either — no start, and the reason says signed out rather than unminted' \
    "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'access token is EMPTY' <<<"$out")" 2/0/1
  # THE WORLD INSIDE, on a credential of its own (the fixture this needs, built here). Only booleans come back out — never a token.
  mine="mbr-only-access-$$"; miner="mbr-only-refresh-$$"
  { jq -n --arg a "$mine" --arg r "$miner" '{claudeAiOauth: {accessToken: $a, refreshToken: $r, expiresAt: 99999999999999}}' > "$own" && chmod 600 "$own"; } || return 1   # 600, as mint installs it
  out=$(TMUX=/tmp/tmux-0/x CLAUDE_CODE_OAUTH_TOKEN=leak SLACK_BOT_TOKEN=leak CC_LOOP_TRIM=trim-77 "$SELF" member "$h" t -- sh -c '
    e(){ [ -e "$1" ] && echo present || echo absent; }
    echo other=$(e ~/dev/'"$o"'); echo ctl=$(e '"$ctl"'); echo devls=$(ls -A ~/dev | tr "\n" " "); echo ccls=$(ls -A ~/.cc | sort | tr "\n" " ")
    echo ccconfig=$(e ~/.cc/config); echo secrets=$(e ~/.cc/secrets); echo appkey=$(e '"$kf"'); echo keyread=$(cat '"$kf"' 2>/dev/null || echo unreadable); echo ledger=$(e ~/.cc/state/member-spend.json); echo states=$(ls ~/.cc/state | tr "\n" " "); echo boards=$(ls ~/.cc/boards | sort | tr "\n" " ")
    echo mine=$(jq -c "[(.claudeAiOauth.accessToken == \"'"$mine"'\"), (.claudeAiOauth.refreshToken == \"'"$miner"'\"), (keys | length)]" '"$c"' 2>/dev/null)
    echo credfile=$([ -e ~/.cc/members ] && echo present || echo absent)
    echo ssh=$(e ~/.ssh); echo gh=$(e ~/.config/gh); echo gitconfig=$(e ~/.gitconfig); echo sock=$(e /var/run/docker.sock)$(e /run/docker.sock); echo tmux=${TMUX:-unset}
    echo env=$(env | grep -cE "^(CLAUDE_CODE_OAUTH_TOKEN|SLACK_BOT_TOKEN|TMUX)="); echo inside=${CC_MEMBER_SANDBOX:-unset}/${CC_ROLE:-unset}
    echo trim=${CC_LOOP_TRIM:-unset}
    echo bin=$([ -L ~/bin/cc ] && echo symlink || echo file)$(touch ~/bin/x 2>/dev/null && echo -writable || echo -ro); echo slack=$(ls -A ~/.cc/slack | sort | tr "\n" " ")
    echo cwd=$PWD; echo status=$(git status --short >/dev/null 2>&1 && echo ok || echo broken)
    echo hooks=$(touch ~/dev/'"$h"'/.git/hooks/post-checkout 2>/dev/null && echo writable || echo ro)
    echo gitcfg=$(git config --file ~/dev/'"$h"'/.git/config core.hooksPath /tmp 2>/dev/null && echo writable || echo ro)
    echo hookspath=$(git -C ~/dev/'"$h"' config core.hooksPath 2>/dev/null || echo none)
    echo trackgit=$( (rm -f ~/.cc/worktrees/'"$h"'/t/.git || echo x > ~/.cc/worktrees/'"$h"'/t/.git) 2>/dev/null && echo writable || echo ro)
    echo commondir=$( (echo /tmp/evil > ~/dev/'"$h"'/.git/worktrees/t/commondir) 2>/dev/null && echo writable || echo ro)
    echo x > f && git add f && git commit -qm c >/dev/null 2>&1 && echo commit=$(git log -1 --format=%an) || echo commit=broken
    echo board=$(cc-board add '"$h"' t2 t2 "" >/dev/null 2>&1 && cc-board get '"$h"' t2 branch)
    echo mcp=$(jq -r "(.mcpServers | keys | join(\",\")),(.projects | length)" ~/.claude.json | tr "\n" ",")
    echo cjkeys=$(jq -r "keys|join(\",\")" ~/.claude.json)
    echo projs=$(jq -r ".projects | keys | sort | join(\" \")" ~/.claude.json | sed "s|$HOME/||g")
    echo onboard=$(jq -r ".hasCompletedOnboarding" ~/.claude.json)
    echo trust=$(jq -r "[.projects[] | .hasTrustDialogAccepted | tostring] | sort | join(\",\")" ~/.claude.json)
    echo pid1=$(ls /proc | grep -c "^[0-9]" | awk "{print (\$1 < 20) ? \"few\" : \"many\"}"); echo tmp=$(touch /tmp/x && echo ok)' 2>&1)
  mcpw="cc-slack,"; [ -f "$H/.cc/slack/enabled" ] || mcpw=","
  t 'member: another repo is ABSENT' "$(g other)" absent;  t 'member: the control repo path is ABSENT' "$(g ctl)" absent
  t 'member: ~/dev holds the workspace alone' "$(g devls)" "$h";  t 'member: ~/.cc holds boards, slack, state, worktrees and nothing else' "$(g ccls)" 'boards slack state worktrees'
  t 'member: ~/.cc/config absent' "$(g ccconfig)" absent
  # The app key is org admin: it pushes AND creates repositories. A workspace is member-facing, so whoever is
  # in its channel would hold anything it holds — the key stays outside, and this proves it on its own fixture.
  t 'member: the secrets dir and the GitHub App private key in it are ABSENT, and the key is unreadable from inside' \
    "$(g secrets)/$(g appkey)/$(g keyread)" absent/absent/unreadable
    t 'member: the spend ledger absent' "$(g ledger)" absent
  t 'member: only its own state' "$(g states)" "$h";  t 'member: only its own board' "$(g boards)" "$h.json $h.lock"
  t 'member: the credential inside is the one minted for that workspace, whole — nothing arrives by fallback' "$(g mine)" '[true,true,1]'
  t 'member: the credential FILE is still outside — only its content is inside' "$(g credfile)" absent
  t 'member: and a workspace that has one is not refused' "$(grep -c "has no credential of its own" <<<"$out")" 0
  t 'member: ssh absent' "$(g ssh)" absent;  t 'member: config/gh absent' "$(g gh)" absent
  t 'member: .gitconfig absent' "$(g gitconfig)" absent;  t 'member: the container socket absent' "$(g sock)" absentabsent;  t 'member: TMUX unset' "$(g tmux)" unset
  t 'member: the environment was cleared' "$(g env)" 0;  t 'member: CC_MEMBER_SANDBOX=1 and CC_ROLE=member inside' "$(g inside)" 1/member
  # the clearing is a whitelist, not a wall: the knob a dispatch sets in front of the loop has to reach the loop, which runs in here
  t 'member: …and the trim knob set in front of a member dispatch arrives inside, where the loop it steers runs' "$(g trim)" trim-77
  t 'member: ~/bin is the control bin itself, read-only' "$(g bin)" file-ro;  t 'member: ~/.cc/slack is the member dir' "$(g slack)" 'enabled files'
  t 'member: cwd is the track worktree' "$(g cwd)" "$H/.cc/worktrees/$h/t";  t 'member: git status works' "$(g status)" ok
  # the host runs git in this workspace: a hook or a hooksPath written from inside would execute out there, as the owner
  t 'member: .git/hooks is ro — no hook the host would run' "$(g hooks)" ro
  t 'member: .git/config is ro — no core.hooksPath, no ext:: remote' "$(g gitcfg)" ro
  t 'member: no core.hooksPath survives the attempt' "$(g hookspath)" none
  t 'member: a track worktree gitlink is ro — it cannot become a member git dir' "$(g trackgit)" ro
  t 'member: its commondir is ro — the common dir cannot be re-pointed at member files' "$(g commondir)" ro
  t 'member: a commit works and is the handle'"'"'s' "$(g commit)" "$h";  t 'member: cc-board writes the bind-mounted board' "$(g board)" track/t2
  t 'member: claude.json copy = this workspace'"'"'s two project entries, the cc-slack MCP only' "$(g mcp)" "${mcpw}2,"
  t 'member: that copy holds NOTHING but projects, mcpServers and the minted hasCompletedOnboarding — no oauthAccount, no userID (review-156e)' \
    "$(g cjkeys)" hasCompletedOnboarding,mcpServers,projects
  # THE SETUP WIZARD AND ITS LOGIN STEP DO NOT RUN. 2.1.258 gates the wizard on `!hasCompletedOnboarding` and the trust
  # dialog on `projects[<git root of cwd>].hasTrustDialogAccepted`; the copy is rebuilt every start, so both are minted
  # here. The only project entries are this workspace's two — the root and the cwd — and both are trusted.
  t 'member: onboarding is already done — no setup wizard, so no login prompt on a start that has a credential' "$(g onboard)" true
  t 'member: and the only projects are this workspace'"'"'s own root and cwd, both trusted — no trust dialog either' \
    "$(g projs)/$(g trust)" ".cc/worktrees/$h/t dev/$h/true,true"
  t 'member: own pid namespace' "$(g pid1)" few;  t 'member: /tmp writable' "$(g tmp)" ok
  # ── THE BOARD IS ONE FILE, BOTH WAYS. The row the world above added inside is on the HOST's board; a host write made
  #    while a session runs is read inside on its next command (a file bind never showed it — the host renames a new file
  #    over the board and the mount kept the old inode, 2026-09-04); and through it all the host path stays a link.
  t 'board: a row added inside is the host'"'"'s row' "$("$cb/cc-board" get "$h" t2 branch 2>/dev/null)" track/t2
  ( sleep 0.7; "$cb/cc-board" status "$h" t2 running >/dev/null 2>&1 ) &
  out=$("$SELF" member "$h" t -- sh -c 'i=0; s=; while [ $i -lt 60 ]; do s=$(cc-board get '"$h"' t2 status 2>/dev/null); [ "$s" = running ] && break; i=$((i+1)); sleep 0.25; done; echo seen=$s' 2>&1); wait
  t 'board: a host write made while the session runs is read inside on its next command' "$(g seen)" running
  t 'board: ~/.cc/boards/<h>.json and .lock are links into ~/.cc/members/<h>/board/, and still links after that host save' \
    "$([ -L "$H/.cc/boards/$h.lock" ] && readlink "$H/.cc/boards/$h.json")" "$H/.cc/members/$h/board/$h.json"
  # ── THE REFRESH REACHES THE HOST COPY, AND NOTHING ELSE. A session writes its credential the way claude does (in place,
  #    no rename); the file minted for the workspace holds it, the next launch starts from it, and the box's own
  #    ~/.claude/.credentials.json is byte for byte what it was.
  real0=$(md5sum "$c" 2>/dev/null | cut -d' ' -f1); real0="${real0:-absent}"
  out=$("$SELF" member "$h" t -- sh -c 'jq -c ".claudeAiOauth.accessToken = \"refreshed-'"$$"'\"" ~/.claude/.credentials.json > /tmp/c && cat /tmp/c > ~/.claude/.credentials.json && echo wrote=$(stat -c %a ~/.claude/.credentials.json)' 2>&1)
  t 'credential: a session writes its credential in place, mode kept' "$(g wrote)" 600
  t 'credential: the refresh is in the workspace'"'"'s own file on the host, still 600' "$(jq -r .claudeAiOauth.accessToken "$own" 2>/dev/null)/$(stat -c %a "$own" 2>/dev/null)" "refreshed-$$/600"
  out=$("$SELF" member "$h" t -- sh -c 'echo next=$(jq -r .claudeAiOauth.accessToken ~/.claude/.credentials.json)' 2>&1)
  t 'credential: …and the next launch starts from it, with no person' "$(g next)" "refreshed-$$"
  real1=$(md5sum "$c" 2>/dev/null | cut -d' ' -f1); real1="${real1:-absent}"
  t 'credential: the box'"'"'s own ~/.claude/.credentials.json is untouched by all of that' "$real1" "$real0"
  # ── THE GIT DIR IS THE HOST'S, THREE WAYS. Every source of a member-side bind is opened here and handed to bwrap as a
  #    descriptor (pin), so there is no name left for a member to redirect; `.git` and `.git/worktrees` are bound onto
  #    themselves, which makes them mountpoints their own session cannot rename. One case per class that got here.
  # (1) A CONFIG FILE THE MEMBER WROTE AND THE HOST READ: config.worktree, in the workspace's git dir and in the track's.
  out=$("$SELF" member "$h" t -- sh -c '
    echo root=$( (echo "[core]" > ~/dev/'"$h"'/.git/config.worktree) 2>/dev/null && echo writable || echo ro)
    echo track=$( (echo "[core]" > ~/dev/'"$h"'/.git/worktrees/t/config.worktree) 2>/dev/null && echo writable || echo ro)
    echo mvgit=$( (mv ~/dev/'"$h"'/.git ~/dev/'"$h"'/.gitx) 2>/dev/null && echo moved || echo pinned)
    echo mvwt=$( (mv ~/dev/'"$h"'/.git/worktrees ~/dev/'"$h"'/.git/wtx) 2>/dev/null && echo moved || echo pinned)
    echo mkwt=$(mkdir -p ~/dev/'"$h"'/.git/worktrees/made-inside 2>/dev/null && echo ok || echo no)
    echo leakfds=$(ls -l /proc/self/fd 2>/dev/null | sed -n "s|.* -> ||p" | grep -c "^$HOME/")' 2>&1)
  t 'gitwall: config.worktree is the host'"'"'s empty file, in the workspace git dir and in the track'"'"'s — a member creating one does not make it theirs' "$(g root)/$(g track)" ro/ro
  # (2) A NAME MOVED SO THE HOST FOLLOWS IT SOMEWHERE ELSE — the worst form, because `mv .git .gitx && mkdir .git` walks
  #     the ro binds away with the old directory and leaves the HOST's next `git -C ~/dev/<h>` reading a member git dir.
  t 'gitwall: .git and .git/worktrees are mountpoints — the session cannot rename the git dir out from under the host' "$(g mvgit)/$(g mvwt)" pinned/pinned
  t 'gitwall: …and a track admin dir can still be made in there, so a member'"'"'s own worktree still works' "$(g mkwt)" ok
  # THE DESCRIPTORS DO NOT SURVIVE THE LAUNCH. bwrap closes what --bind-fd/--ro-bind-fd consume; handed the same objects
  # as /proc/self/fd/<n> paths it closes nothing, and `openat(dirfd, "../..")` on an inherited directory fd walks the
  # HOST tree the namespace is there to hide — from the one for ~/.cc/worktrees/<h>, ~/.cc itself.
  t 'gitwall: not one of the pinned descriptors reaches the session — an inherited directory fd walks out of the namespace' "$(g leakfds)" 0
  t 'gitwall: the host still has its git dir, and neither config.worktree holds anything' \
    "$([ -d "$dev/.git" ] && echo dir)/$(cat "$dev/.git/config.worktree" 2>/dev/null)$(cat "$dev/.git/worktrees/t/config.worktree" 2>/dev/null)" 'dir/'
  rmdir "$dev/.git/worktrees/made-inside" 2>/dev/null
  for c in .git .git/config .git/hooks; do
    mv "$dev/$c" "$dev/$c.real" || return 1
    case "$c" in .git/config) ln -sfn "$H/dev/$o/secret" "$dev/$c";; *) ln -sfn "$H/dev/$o" "$dev/$c";; esac
    out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
    t "gitwall: a link planted at $c stops the launch, and binds nothing" \
      "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'is not the path it should be' <<<"$out")" 2/0/1
    rm -f "$dev/$c"; mv "$dev/$c.real" "$dev/$c"
  done
  t 'gitwall: …and a refused launch left the other repo alone — no git dir was made in it through the link' \
    "$([ -e "$H/dev/$o/.git" ] && echo made || echo untouched)" untouched
  # THE ONE BIND WHOSE DESTINATION IS A MEMBER'S NAME (review of #298). The source of the config.worktree walls is the
  # host's own file; the DEST is `<admin dir>/config.worktree`, and the admin dir is a name a member creates. A link
  # there aims the destination somewhere the owner can write. Both spellings are refused, the dangling one included:
  # -d follows a link, so testing it first would have skipped exactly the plant that is easiest to make.
  mkdir -p "$H/dev/$o/plantdir"
  for pl in "$H/dev/$o/plantdir" "$H/dev/$o/plantdir/not-there-yet"; do
    ln -sfn "$pl" "$dev/.git/worktrees/planted"
    out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
    t "gitwall: a symlink where a track's administration directory goes stops the launch (${pl##*/})" \
      "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'is a symlink, not an administration directory' <<<"$out")" 2/0/1
    rm -f "$dev/.git/worktrees/planted"
  done
  t 'gitwall: …and nothing of the host'"'"'s was written through the link' "$(ls -A "$H/dev/$o/plantdir" | wc -l)" 0
  # AND THE EXTENSION IS A BOOLEAN, NOT THE WORD "true": git honours 1/yes/on/TRUE for it, so a string compare against
  # "true" left every other spelling live, and every config.worktree in the workspace with it (review of #298).
  git config --file "$dev/.git/config" extensions.worktreeConfig on
  out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1); rc=$?
  t 'gitwall: extensions.worktreeConfig spelled `on` is the extension turned on — the launch refuses, as it does for `true`' \
    "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'turns extensions.worktreeConfig on' <<<"$out")" 2/0/1
  git config --file "$dev/.git/config" extensions.worktreeConfig off
  out=$("$SELF" member "$h" t -- sh -c 'echo STARTED' 2>&1)
  t 'gitwall: …and a spelling that means false is not refused — the case above is the extension, not the key' "$(grep -c STARTED <<<"$out")" 1
  git config --file "$dev/.git/config" --unset extensions.worktreeConfig
  # (3) THE SWAP, DRIVEN — not a comment claiming the window is shut. A second process of this workspace renames the
  #     track worktree aside and puts its own directory, with its own gitlink, at that name, inside the window
  #     CC_SANDBOX_TEST_DELAY opens between the pins and the mount. A launch lock would not help: on a real box that
  #     process is another LIVE SESSION of the same handle, not a racing launch. A rename is the shape that decides it —
  #     measured, this bwrap follows a symlink in a bind SOURCE but refuses to create a bind DEST through one, so a
  #     link swap only kills the launch, while a rename leaves the destination valid and the source pointing at the
  #     member's own file. Named, the session gets that file; pinned, it gets the gitlink the host opened.
  ( sleep 0.4; mv "$H/.cc/worktrees/$h/t" "$H/.cc/worktrees/$h/t.real" 2>/dev/null \
      && mkdir -p "$H/.cc/worktrees/$h/t" && printf 'gitdir: /tmp/decoy-git\n' > "$H/.cc/worktrees/$h/t/.git"
    sleep 1.4; rm -rf "$H/.cc/worktrees/$h/t"; mv "$H/.cc/worktrees/$h/t.real" "$H/.cc/worktrees/$h/t" 2>/dev/null ) &
  out=$(CC_SANDBOX_TEST_DELAY=1 "$SELF" member "$h" t -- sh -c 'echo RAN=yes; echo gitlink=$(cat ~/.cc/worktrees/'"$h"'/t/.git 2>/dev/null)' 2>&1); wait
  t 'gitwall: a second session swapping a track name DURING the launch never reaches the mount — the descriptor was already the real gitlink' \
    "$(g RAN)/$(grep -c decoy-git <<<"$out")" yes/0
  out=$("$SELF" member "$o" -- true 2>&1); t 'member: a repo without the marker is refused' "${out#*: ~/dev/}" "$o is not a member workspace (no .cc/member-workspace)"
  rm -f "$own" "$kf"
  git -C "$dev" worktree remove --force "$H/.cc/worktrees/$h/t" >/dev/null 2>&1
  rm -rf "${dev:?}" "${H:?}/dev/${o:?}" "$H/.cc/worktrees/$h" "$H/.cc/state/$h" "$H/.cc/state/$o" "$H/.cc/boards/$h.json" "$H/.cc/boards/$h.lock" "$H/.cc/boards/$o.json" \
         "$H/.cc/members/$h" "$H/.cc/slack/member/$h" "$H/.cc/sandbox/$h"; }
selfcheck_member_whitelist(){   # THE ~/.claude.json COPY IS A PRIVACY BOUNDARY, and the first-run flags in it are MINTED, not carried.
  # This case needs to plant things in the SOURCE .claude.json, so it builds its own HOME (as selfcheck_mint does) and
  # never writes the box's. Planted there: an account-shaped mark on every key an owner's file carries account data in,
  # and another repo's project entry — none may appear inside. Planted alongside: hasCompletedOnboarding FALSE and this
  # workspace's own trust FALSE — both must read true inside, which only holds if the boundary generated them.
  local fh h dev out mark probe pad
  fh=$(mktemp -d "${TMPDIR:-/tmp}/ccsbxwl-XXXXXX") || return 1; chmod 700 "$fh"
  h="_ccsbxw$$"; dev="$fh/dev/$h"; mark="ownr-only-$$"   # per run, like every other mark here: a fixed word matches the shell that invoked this
  mkdir -p "$dev/.cc" "$fh/.claude" "$fh/.local/bin" "$fh/.cc/members/$h" || return 1
  : > "$dev/.cc/member-workspace"   # claude is only a bind target here, never run: a stub is enough if the box has none
  { [ -e "$CLAUDEBIN" ] && ln -sf "$CLAUDEBIN" "$fh/.local/bin/claude"; } || printf '#!/bin/sh\n' > "$fh/.local/bin/claude"
  git -C "$dev" init -q -b main >/dev/null 2>&1
  jq -n --arg m "$mark" --arg d "$dev" '{oauthAccount: {accountUuid: $m, emailAddress: ($m + "@example.invalid")},
      userID: $m, machineID: $m, theme: $m, hasCompletedOnboarding: false,
      projects: {($d): {hasTrustDialogAccepted: false}, "/home/someone/other-repo": {lastSessionId: $m}}}' > "$fh/.claude.json"
  jq -n '{claudeAiOauth: {accessToken: "wl-access", refreshToken: "wl-refresh", expiresAt: 99999999999999}}' > "$fh/.cc/members/$h/credentials.json"
  probe='
    echo keys=$(jq -r "keys|join(\",\")" ~/.claude.json)
    echo mark=$(grep -c '"$mark"' ~/.claude.json)
    echo onboard=$(jq -r ".hasCompletedOnboarding" ~/.claude.json)
    echo trust=$(jq -r "[.projects[] | .hasTrustDialogAccepted | tostring] | sort | join(\",\")" ~/.claude.json)
    echo projs=$(jq -r ".projects | keys | join(\" \")" ~/.claude.json | sed "s|$HOME/||g")'
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c "$probe" 2>&1)
  t 'whitelist: an oauthAccount, a userID, a machineID and a theme in the source reach the copy as NOTHING — not one byte of the mark' \
    "$(g mark)/$(g keys)" "0/hasCompletedOnboarding,mcpServers,projects"
  t 'whitelist: another repo'"'"'s project entry does not cross either' "$(g projs)" "dev/$h"
  # the source says false for both; true inside is only possible if the boundary minted them for this workspace
  t 'whitelist: the first-run flags are GENERATED, not carried — false in the source, true inside' "$(g onboard)/$(g trust)" true/true
  # ── THE SAME SOURCE, TOO BIG TO RIDE IN argv (review-189a). His projects used to be one argv element: past Linux's
  # 128 KiB MAX_ARG_STRLEN execve fails E2BIG, jq never runs, fd 3 writes nothing and `--file 3` hands the member an
  # EMPTY ~/.claude.json — the wizard back, silently. A quarter of a megabyte of projects here, and the copy is the
  # same three keys with the same two trusted entries: size does not decide whether the flags are minted.
  pad=$(head -c 300 /dev/zero | tr '\0' x)
  jq -n --arg m "$mark" --arg d "$dev" --arg pad "$pad" '{oauthAccount: {emailAddress: $m}, hasCompletedOnboarding: false,
      projects: (reduce range(0; 700) as $i ({($d): {hasTrustDialogAccepted: false}};
                   .["/home/someone/repo-\($i)"] = {lastSessionId: ($m + $pad)}))}' > "$fh/.claude.json"
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c "$probe" 2>&1)
  t 'whitelist: the fixture for that really is past what argv takes' \
    "$(awk -v n="$(wc -c < "$fh/.claude.json")" 'BEGIN{print (n > 204800) ? "big" : "too small: " n}')" big
  t 'whitelist: a source too big for argv still mints the flags and still crosses nothing' \
    "$(g keys)/$(g onboard)/$(g trust)/$(g projs)/$(g mark)" "hasCompletedOnboarding,mcpServers,projects/true/true/dev/$h/0"
  # ── and the other end: nothing to read at all. jq exits 0 with no output on an empty file, so the old `--argjson p`
  # took an empty string and errored; the flags must survive that too.
  : > "$fh/.claude.json"
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c "$probe" 2>&1)
  t 'whitelist: an EMPTY ~/.claude.json still mints the flags — no projects to filter, no wizard either' \
    "$(g keys)/$(g onboard)/$(g trust)/$(g projs)" "hasCompletedOnboarding,mcpServers,projects/true/true/dev/$h"
  rm -rf "${fh:?}"; }
selfcheck_mint(){   # MINTING AND CONVERTING, IN A HOME OF THEIR OWN. Everything either command reads or writes hangs off $fh —
  # its own owner credential, its own ~/dev, its own ~/.cc — so the box's real ~/.claude is not something these cases have to
  # avoid touching: it is not reachable from them, and the hash at the end says so out loud.
  local fh real0 real1 dest d1 out rc r1 r2 sd sc x o1 o2 cb doc orig="$SELF"
  fh=$(mktemp -d "${TMPDIR:-/tmp}/ccsbxmint-XXXXXX") || return 1
  real0=$(md5sum "$H/.claude/.credentials.json" 2>/dev/null | cut -d' ' -f1); real0="${real0:-absent}"
  mkdir -p "$fh/.claude" "$fh/dev" "$fh/.local/bin" "$fh/.cc" || return 1
  jq -n '{claudeAiOauth: {accessToken: "owner-access", refreshToken: "owner-refresh", expiresAt: 99999999999999}}' > "$fh/.claude/.credentials.json"
  jq -n '{oauthAccount: {accountUuid: "owner-uuid", emailAddress: "owner@example.invalid"}}' > "$fh/.claude.json"
  : > "$fh/.local/bin/claude"; chmod +x "$fh/.local/bin/claude"   # the member launch binds this one ro
  # a stand-in for `claude`: a LOGIN writes a credential into whatever HOME it was handed, exactly where the real one does
  cat > "$fh/login" <<'EOS'
#!/bin/sh
mkdir -p "$HOME/.claude"
jq -n --arg a "$LOGIN_ACCESS" --arg r "$LOGIN_REFRESH" '{claudeAiOauth: {accessToken: $a, refreshToken: $r, expiresAt: 99999999999999}}' > "$HOME/.claude/.credentials.json"
[ -n "${LOGIN_UUID:-}" ] && jq -n --arg u "$LOGIN_UUID" --arg e "$LOGIN_EMAIL" '{oauthAccount: {accountUuid: $u, emailAddress: $e}}' > "$HOME/.claude.json"
exit 0
EOS
  printf '#!/bin/sh\nexit 0\n' > "$fh/login-empty"
  # …and a login that leaves a NON-EMPTY file that is not a credential: killed mid-write, or a different auth shape.
  printf '#!/bin/sh\nmkdir -p "$HOME/.claude"\nprintf %%s "{\\"claudeAiOauth\\": {" > "$HOME/.claude/.credentials.json"\nexit 0\n' > "$fh/login-junk"
  chmod +x "$fh/login" "$fh/login-empty" "$fh/login-junk"
  # a login CLOSED rather than quit: it signals its whole process group, the way Ctrl-C or a shut window does. One writes its
  # credential first, one is closed before signing in at all. The cases that use them run mint under `setsid --wait`, so that
  # signal reaches mint's process group and stops there instead of arriving in this selfcheck's.
  cat > "$fh/login-closed" <<'EOS'
#!/bin/sh
mkdir -p "$HOME/.claude"
jq -n --arg a "$LOGIN_ACCESS" --arg r "$LOGIN_REFRESH" '{claudeAiOauth: {accessToken: $a, refreshToken: $r, expiresAt: 99999999999999}}' > "$HOME/.claude/.credentials.json"
kill -INT 0
exit 130
EOS
  printf '#!/bin/sh\nkill -INT 0\nexit 130\n' > "$fh/login-closed-empty"; chmod +x "$fh/login-closed" "$fh/login-closed-empty"
  # EVERY CASE BELOW RUNS A COPY OF THIS SCRIPT, with a cc-slack of its own beside it. An install posts one line to
  # #<handle>, and a selfcheck must never be what posts it. These commands find their siblings next to THEMSELVES, so
  # a copy in $fh/bin finds this one: it records a `post` and forwards everything else (convert's `member
  # instructions` is a real call on a fixture README). `local SELF` keeps the swap inside this function.
  mkdir -p "$fh/bin" && cp "$orig" "$fh/bin/cc-sandbox" && chmod +x "$fh/bin/cc-sandbox" || return 1
  ln -sf "$(dirname "$orig")/cc-board" "$fh/bin/cc-board"
  printf '#!/bin/sh\n[ "$1" = post ] && { printf "%%s\\n" "$*" >> "%s/slack.args"; exit 0; }\nexec %s/cc-slack "$@"\n' \
    "$fh" "$(dirname "$orig")" > "$fh/bin/cc-slack"; chmod +x "$fh/bin/cc-slack"
  local SELF="$fh/bin/cc-sandbox"
  # ── convert: an ordinary repo already on the box becomes the same workspace the join flow makes ────────────────────
  mkdir -p "$fh/dev/alice"; echo hi > "$fh/dev/alice/README.md"
  out=$(HOME="$fh" "$SELF" convert alice 2>&1); rc=$?
  t 'convert: an ordinary repo becomes a workspace — both markers, a git repo, a HEAD its tracks can branch from' \
    "$rc/$([ -f "$fh/dev/alice/.cc/member-workspace" ] && echo ws)/$([ -f "$fh/dev/alice/.cc/member-facing" ] && echo mf)/$(git -C "$fh/dev/alice" rev-parse -q --verify HEAD >/dev/null 2>&1 && echo head)" 0/ws/mf/head
  t 'convert: .cc/ is excluded from its commits, and a board of its own exists' \
    "$(grep -cx '\.cc/' "$fh/dev/alice/.git/info/exclude" 2>/dev/null)/$([ -f "$fh/.cc/boards/alice.json" ] && echo board)" 1/board
  t 'convert: it says what it changed, and what has to happen next' "$(grep -c 'member-workspace' <<<"$out")/$(grep -c 'cc-sandbox mint alice' <<<"$out")" 1/1
  out=$(HOME="$fh" "$SELF" convert alice 2>&1); rc=$?
  t 'convert: converting one twice changes nothing and says so' "$rc/$(grep -c 'already a member workspace' <<<"$out")" 0/1
  # ── convert and the MEMBER INSTRUCTIONS: the join flow writes them, this path used to write none. Own fixtures: a repo
  #    that already has a README (the shape that produced this on 2026-09-02) and one that has none.
  mkdir -p "$fh/dev/hasdoc"; printf '# hasdoc\nnotes of my own\n' > "$fh/dev/hasdoc/README.md"
  out=$(HOME="$fh" "$SELF" convert hasdoc 2>&1); rc=$?; doc="$fh/dev/hasdoc/README.md"
  t 'convert: a repo that already has a README keeps it and GAINS the member instructions — the phrase, that it counts only from a person, and the session'"'"'s own way in' \
    "$rc/$(grep -c 'notes of my own' "$doc")/$(grep -c 'new project <name>' "$doc")/$(grep -c 'cc slack project <name>' "$doc")/$(grep -c 'a SESSION saying it is ignored' "$doc")" 0/1/1/1/1
  t 'convert: …and it SAYS it appended them, so nothing is left out quietly' "$(grep -c 'member instructions appended' <<<"$out")" 1
  out=$(HOME="$fh" "$(dirname "$SELF")/cc-slack" member instructions hasdoc 2>&1); rc=$?
  t 'member instructions: run again on a workspace that has them, it says so and appends no second copy' \
    "$rc/$(grep -c 'left as it is' <<<"$out")/$(grep -c 'new project <name>' "$doc")" 0/1/1
  mkdir -p "$fh/dev/nodoc"; out=$(HOME="$fh" "$SELF" convert nodoc 2>&1); rc=$?
  t 'convert: a repo with NO README gets the whole member README written' \
    "$rc/$(grep -c 'new project <name>' "$fh/dev/nodoc/README.md")/$(head -1 "$fh/dev/nodoc/README.md")" "0/1/# nodoc"
  mkdir -p "$fh/dev/plain"; out=$(HOME="$fh" "$(dirname "$SELF")/cc-slack" member instructions plain 2>&1); rc=$?
  t 'member instructions: refused on a directory that is not a member workspace, and it writes nothing there' \
    "$rc/$(grep -c 'not a member workspace' <<<"$out")/$([ -e "$fh/dev/plain/README.md" ] && echo wrote || echo none)" 1/1/none
  # ── convert: what must NOT be converted, each on a fixture of its own, each refused with its reason ────────────────
  mkdir -p "$fh/dev/ctl/core/bin"; cp "$SELF" "$fh/dev/ctl/core/bin/cc-sandbox"; chmod +x "$fh/dev/ctl/core/bin/cc-sandbox"
  out=$(HOME="$fh" "$fh/dev/ctl/core/bin/cc-sandbox" convert ctl 2>&1); rc=$?
  t 'convert: the repo this cc-sandbox ships in is refused — the box cannot be one member'"'"'s world' \
    "$rc/$(grep -c 'control repo' <<<"$out")/$([ -e "$fh/dev/ctl/.cc" ] && echo made || echo none)" 2/1/none
  mkdir -p "$fh/dev/clone/core/bin"; : > "$fh/dev/clone/core/bin/cc-sandbox"
  out=$(HOME="$fh" "$SELF" convert clone 2>&1); rc=$?
  t '…and so is a copy of that repo this command does NOT ship in' \
    "$rc/$(grep -c 'control repo' <<<"$out")/$([ -e "$fh/dev/clone/.cc" ] && echo made || echo none)" 2/1/none
  mkdir -p "$fh/dev/proj" "$fh/.cc/worktrees/proj/t1"
  out=$(HOME="$fh" "$SELF" convert proj 2>&1); rc=$?
  t 'convert: a repo with a track live outside the boundary is refused, and the reason names the track' \
    "$rc/$(grep -c 't1' <<<"$out")/$([ -e "$fh/dev/proj/.cc" ] && echo made || echo none)" 2/1/none
  rmdir "$fh/.cc/worktrees/proj/t1"
  # A BOARD THE REPO ALREADY HAD IS SOMEBODY'S WORK, not this command's to start over: converting adopts it, so a row a
  # person put there and a status a person set are still there afterwards.
  cb="$(dirname "$SELF")/cc-board"
  HOME="$fh" "$cb" init proj "$fh/dev/proj" main >/dev/null 2>&1
  HOME="$fh" "$cb" add proj t9 'a row that was already on the board' >/dev/null 2>&1
  HOME="$fh" "$cb" set proj t9 status waiting >/dev/null 2>&1
  out=$(HOME="$fh" "$SELF" convert proj 2>&1); rc=$?
  t '…and that same repo converts once the track is gone, keeping the board rows it already had' \
    "$rc/$([ -f "$fh/dev/proj/.cc/member-workspace" ] && echo ws)/$(HOME="$fh" "$cb" get proj t9 status 2>&1)" 0/ws/waiting
  mkdir -p "$fh/dev/proj2" && git -C "$fh/dev/proj2" init -q -b main >/dev/null 2>&1 \
    && git -C "$fh/dev/proj2" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init \
    && git -C "$fh/dev/proj2" worktree add -q -b w "$fh/wt2" >/dev/null 2>&1
  out=$(HOME="$fh" "$SELF" convert proj2 2>&1); rc=$?
  t 'convert: a repo carrying a git worktree of its own is refused for the same reason' "$rc/$(grep -c 'git worktree' <<<"$out")" 2/1
  mkdir -p "$fh/dev/box" "$fh/dev/alice-updates"
  o1=$(HOME="$fh" "$SELF" convert box 2>&1); r1=$?; o2=$(HOME="$fh" "$SELF" convert alice-updates 2>&1); r2=$?
  t 'convert: a handle the box already answers to is refused, never adopted (#box, an -updates lane)' \
    "$r1/$r2/$([ -e "$fh/dev/box/.cc" ] && echo made || echo none)/$([ -e "$fh/dev/alice-updates/.cc" ] && echo made || echo none)/$(grep -c 'own channels' <<<"$o1")/$(grep -c 'updates lane' <<<"$o2")" 2/2/none/none/1/1
  mkdir -p "$fh/.cc/slack" "$fh/dev/notes"; jq -n '{"#notes": "other/x"}' > "$fh/.cc/slack/routes.json"
  out=$(HOME="$fh" "$SELF" convert notes 2>&1); rc=$?
  t '…and one routes.json already points at a session on this box' "$rc/$(grep -c 'routed to a session' <<<"$out")/$([ -e "$fh/dev/notes/.cc" ] && echo made || echo none)" 2/1/none
  mkdir -p "$fh/dev/free"; out=$(HOME="$fh" "$SELF" convert free 2>&1); rc=$?   # …and the same routes file does not refuse a handle it does NOT name
  t '…while a handle that file does not name converts with it sitting right there' \
    "$rc/$([ -f "$fh/dev/free/.cc/member-workspace" ] && echo ws)" 0/ws
  rm -f "$fh/.cc/slack/routes.json"
  # ── mint: what a login produced, and only that ────────────────────────────────────────────────────────────────────
  dest="$fh/.cc/members/alice/credentials.json"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=alice-access LOGIN_REFRESH=alice-refresh LOGIN_UUID=alice-uuid LOGIN_EMAIL=alice@example.invalid "$SELF" mint alice 2>&1); rc=$?
  t 'mint: the login walk installs what THAT login produced, where the boundary reads it, mode 600' \
    "$rc/$(jq -r '.claudeAiOauth.accessToken' "$dest" 2>/dev/null)/$(jq -r '.claudeAiOauth.refreshToken' "$dest" 2>/dev/null)/$(stat -c %a "$dest" 2>/dev/null)" 0/alice-access/alice-refresh/600
  t 'mint: and nothing of that login but claudeAiOauth' "$(jq -r 'keys|join(",")' "$dest" 2>/dev/null)" claudeAiOauth
  sd=$(sed -n 's/.*throwaway HOME (\([^)]*\)).*/\1/p' <<<"$out" | head -1)
  t 'mint: the throwaway HOME it logged in with is named, and is gone afterwards' "${sd:+named}/$([ -n "$sd" ] && [ -e "$sd" ] && echo left || echo gone)" named/gone
  # ── AN INSTALL ENDS THE WALL OUT LOUD (owner, 2026-09-04) ──────────────────────────────────────────────────────────
  # While there is no credential, `cc` tells #<handle> ONCE what to mint and stamps that it did (credential-told, beside
  # credential-asked). The install is the end of that, so it says so in the same channel and drops both stamps: a
  # workspace that loses its credential later has to be able to say it again instead of inheriting the silence.
  : > "$fh/.cc/members/alice/credential-told"; : > "$fh/.cc/members/alice/credential-asked"; rm -f "$fh/slack.args"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=alice-access LOGIN_REFRESH=alice-refresh "$SELF" mint alice 2>&1); rc=$?
  t 'mint: an install posts ONE ready line to #<handle> — --major, or post() files it in the -updates twin — and clears both stamps of the wall it just ended' \
    "$rc/$(grep -c -- '^post -c #alice --major .* is ready' "$fh/slack.args" 2>/dev/null)/$([ -e "$fh/.cc/members/alice/credential-told" ] && echo told)$([ -e "$fh/.cc/members/alice/credential-asked" ] && echo asked)" 0/1/
  : > "$fh/.cc/members/alice/credential-told"; rm -f "$fh/slack.args"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login-empty" "$SELF" mint alice 2>&1); rc=$?
  t 'mint: …and a mint that installed nothing says nothing there and leaves the stamp — that wall is still up' \
    "$rc/$([ -s "$fh/slack.args" ] && echo posted || echo silent)/$([ -e "$fh/.cc/members/alice/credential-told" ] && echo told)" 2/silent/told
  rm -f "$fh/slack.args" "$fh/.cc/members/alice/credential-told"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=alice-access LOGIN_REFRESH=alice-refresh "$SELF" mint alice 2>&1); rc=$?
  t 'mint: a credential ROTATED on a workspace that was never walled says nothing in its channel — "ready" belongs to '\
'the channel that heard the wall, and #<handle> was never told there was one' \
    "$rc/$([ -s "$fh/slack.args" ] && echo posted || echo silent)" 0/silent
  rm -f "$fh/slack.args"
  d1=$(md5sum "$dest" 2>/dev/null | cut -d' ' -f1)
  # THE OWNER'S OWN CREDENTIAL: INSTALLED, AND NAMED. This refused until 2026-09-02, when the owner settled it — "These are
  # trusted people just treat minting my account like any other account". So each case below now asserts the opposite of what
  # it used to: the mint SUCCEEDS, the file really changes from what the case above minted ($d1), and the output says whose
  # credential it is, because the one thing that must never happen is installing his account silently.
  out=$(env HOME="$fh" "$SELF" mint alice --from "$fh/.claude/.credentials.json" 2>&1); rc=$?
  t 'mint: --from the owner'"'"'s own credential file installs it, and says whose it is' \
    "$rc/$(grep -c "OWNER'S OWN" <<<"$out")/$([ "$(md5sum "$dest" 2>/dev/null | cut -d' ' -f1)" = "$d1" ] && echo unchanged || echo replaced)" "0/1/replaced"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=owner-access LOGIN_REFRESH=owner-refresh LOGIN_UUID=owner-uuid LOGIN_EMAIL=owner@example.invalid "$SELF" mint alice 2>&1); rc=$?
  t 'mint: a login that signed in as the owner himself installs, and names the account as his' \
    "$rc/$(grep -c "OWNER'S OWN" <<<"$out")/$(jq -r '.claudeAiOauth.accessToken' "$dest" 2>/dev/null)" "0/1/owner-access"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=fresh-access LOGIN_REFRESH=fresh-refresh LOGIN_UUID=owner-uuid LOGIN_EMAIL=owner@example.invalid "$SELF" mint alice 2>&1); rc=$?
  t 'mint: …and a FRESH token for his account is still RECOGNISED as his — tokens differ, the account does not' \
    "$rc/$(grep -c "as the owner's own account" <<<"$out")/$(jq -r '.claudeAiOauth.accessToken' "$dest" 2>/dev/null)" "0/1/fresh-access"
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=other-access LOGIN_REFRESH=other-refresh LOGIN_UUID=other-uuid LOGIN_EMAIL=OWNER@Example.Invalid "$SELF" mint alice 2>&1); rc=$?
  t 'mint: …and so is one whose account id differs but whose address is his, in any case' \
    "$rc/$(grep -c 'same email address' <<<"$out")/$(jq -r '.claudeAiOauth.accessToken' "$dest" 2>/dev/null)" "0/1/other-access"
  # The owner-credential cases above deliberately REPLACE $dest now, so alice's own goes back before the rest of the chain,
  # which is also the swap the owner asked for ("change it later"): re-minting is how an account is changed.
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=alice-access LOGIN_REFRESH=alice-refresh LOGIN_UUID=alice-uuid LOGIN_EMAIL=alice@example.invalid "$SELF" mint alice 2>&1); rc=$?
  t 'mint: re-minting swaps the account back — his out, hers in, no flag and no extra step' \
    "$rc/$(jq -r '.claudeAiOauth.accessToken' "$dest" 2>/dev/null)/$(grep -c "OWNER'S OWN" <<<"$out")" 0/alice-access/0
  d1=$(md5sum "$dest" 2>/dev/null | cut -d' ' -f1)
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login-empty" "$SELF" mint alice 2>&1); rc=$?
  t 'mint: a login that produced no credential installs nothing' "$rc/$(grep -c 'produced no credential' <<<"$out")/$(md5sum "$dest" 2>/dev/null | cut -d' ' -f1)" "2/1/$d1"
  # ── MINT CANNOT END QUIETLY ────────────────────────────────────────────────────────────────────────────────────────
  # 2026-09-02, the first real mint: the login worked, claude was CLOSED rather than quit (/exit), the signal that ended it
  # ended mint too before the copy, and the scratch holding that credential was left behind with nothing said. Three cases,
  # a workspace of its own each, so none of them reads state another left: closed with a credential (installs), closed
  # without one (nothing to recover), and an install that cannot happen (the scratch is kept and named).
  for x in carol dora erin; do mkdir -p "$fh/dev/$x"; HOME="$fh" "$SELF" convert "$x" >/dev/null 2>&1; done
  out=$(setsid --wait env HOME="$fh" CC_CLAUDE="$fh/login-closed" LOGIN_ACCESS=carol-access LOGIN_REFRESH=carol-refresh "$SELF" mint carol 2>&1); rc=$?
  sd=$(sed -n 's/.*throwaway HOME (\([^)]*\)).*/\1/p' <<<"$out" | head -1)
  t 'mint: claude closed rather than quit still installs what that login wrote, says so, and exits 0' \
    "$rc/$(jq -r '.claudeAiOauth.accessToken' "$fh/.cc/members/carol/credentials.json" 2>/dev/null)/$(grep -c 'closed rather than quit' <<<"$out")/$([ -n "$sd" ] && [ -e "$sd" ] && echo left || echo gone)" 0/carol-access/1/gone
  out=$(setsid --wait env HOME="$fh" CC_CLAUDE="$fh/login-closed-empty" "$SELF" mint dora 2>&1); rc=$?
  sd=$(sed -n 's/.*throwaway HOME (\([^)]*\)).*/\1/p' <<<"$out" | head -1)
  t 'mint: closed BEFORE the login wrote anything installs nothing, exits non-zero, and leaves no scratch — there is none to recover' \
    "$rc/$(grep -c 'produced no credential' <<<"$out")/$([ -e "$fh/.cc/members/dora/credentials.json" ] && echo file || echo none)/$([ -n "$sd" ] && [ -e "$sd" ] && echo left || echo gone)" 2/1/none/gone
  : > "$fh/.cc/members/erin"   # a FILE where that workspace's credential directory has to go: the install cannot happen
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login" LOGIN_ACCESS=erin-access LOGIN_REFRESH=erin-refresh "$SELF" mint erin 2>&1); rc=$?
  sc=$(sed -n 's/.*login is still in \([^ ]*\) — kept.*/\1/p' <<<"$out" | head -1)
  t 'mint: an install that cannot happen exits non-zero, says nothing was installed, and KEEPS the login it already has' \
    "$rc/$(grep -c 'NOTHING WAS INSTALLED' <<<"$out")/$([ -n "$sc" ] && [ -s "$sc/.claude/.credentials.json" ] && echo kept || echo lost)" 2/1/kept
  t 'mint: …and names the one command that finishes from there, so nobody logs in twice' \
    "$(grep -cF "cc-sandbox mint erin --from $sc/.claude/.credentials.json" <<<"$out")" 1
  rm -f "$fh/.cc/members/erin"
  out=$(env HOME="$fh" "$SELF" mint erin --from "$sc/.claude/.credentials.json" 2>&1); rc=$?
  t 'mint: …and that command really does install it, out of the scratch the failed mint named' \
    "$rc/$(jq -r '.claudeAiOauth.accessToken' "$fh/.cc/members/erin/credentials.json" 2>/dev/null)" 0/erin-access
  [ -n "$sc" ] && rm -rf "$sc"
  # A SCRATCH IS ONLY WORTH KEEPING IF WHAT IS IN IT CAN FINISH THE JOB (review of PR #208). The keep-and-name
  # branch used to ask only whether the file was non-empty, while mint itself asked whether it PARSED — so a login
  # killed mid-write left a scratch that was kept, named, and advertised with a --from line that fails the same way.
  out=$(env HOME="$fh" CC_CLAUDE="$fh/login-junk" "$SELF" mint erin 2>&1); rc=$?
  x=$(sed -n 's/.*login is still in \([^ ]*\) — kept.*/\1/p' <<<"$out" | head -1)
  t 'mint: a login that wrote something unreadable installs nothing, keeps no scratch, and promises no --from' \
    "$rc/$(grep -c 'produced no credential' <<<"$out")/$(grep -c 'NOTHING WAS INSTALLED' <<<"$out")/${x:-none}" 2/1/0/none
  mkdir -p "$fh/dev/bob"
  out=$(env HOME="$fh" "$SELF" mint bob 2>&1); rc=$?
  t 'mint: a repo that is not a member workspace is refused, and told what makes it one' \
    "$rc/$(grep -c 'cc-sandbox convert bob' <<<"$out")/$([ -e "$fh/.cc/members/bob" ] && echo made || echo none)" 2/1/none
  # ── and the pair end to end: a repo the box already had, converted and minted, is a workspace the boundary starts ──
  out=$(env HOME="$fh" "$SELF" member alice -- sh -c 'echo inside=$(jq -r .claudeAiOauth.accessToken ~/.claude/.credentials.json)' 2>&1); rc=$?
  t 'convert + mint: the boundary starts that workspace, and the one credential inside it is the minted one' \
    "$rc/$(sed -n 's/^inside=//p' <<<"$out" | head -1)" 0/alice-access
  real1=$(md5sum "$H/.claude/.credentials.json" 2>/dev/null | cut -d' ' -f1); real1="${real1:-absent}"
  t 'mint/convert: through all of that, the box'"'"'s real ~/.claude/.credentials.json is untouched' "$real1" "$real0"
  git -C "$fh/dev/proj2" worktree remove --force "$fh/wt2" >/dev/null 2>&1
  rm -rf "${fh:?}"; }
selfcheck_baseline(){   # THE SEALED-SESSION PERMISSION BASELINE, in a HOME of its own: the box's real settings.json is
  # neither read nor written by anything here, and the last case hashes it to say so. Every case asserts BOTH sides —
  # what the boundary contains is silent AND what crosses it still asks — because a baseline that only ever says yes
  # is the wholesale switch this was not allowed to be.
  local fh h dev out probe real0 real1 w
  fh=$(mktemp -d "${TMPDIR:-/tmp}/ccsbxperm-XXXXXX") || return 1; chmod 700 "$fh"
  real0=$(md5sum "$H/.claude/settings.json" 2>/dev/null | cut -d' ' -f1); real0="${real0:-absent}"
  h="_ccsbxp$$"; dev="$fh/dev/$h"; w="_ccsbxpw$$"
  mkdir -p "$dev/.cc" "$fh/.claude" "$fh/.local/bin" "$fh/bin" "$fh/.npm" "$fh/.cache" "$fh/.cc/boards" "$fh/.cc/members/$h" || return 1
  : > "$dev/.cc/member-workspace"   # claude is only a bind target in these cases, never run
  { [ -e "$CLAUDEBIN" ] && ln -sf "$CLAUDEBIN" "$fh/.local/bin/claude"; } || printf '#!/bin/sh\n' > "$fh/.local/bin/claude"
  git -C "$dev" init -q -b main >/dev/null 2>&1
  jq -n '{claudeAiOauth: {accessToken: "perm-access", expiresAt: 99999999999999}}' > "$fh/.cc/members/$h/credentials.json"
  # HIS FILE, the fixture: a hook (the box's mechanical gates), a deny, an ask and an allow of his own. None of it is
  # this program's to change, and each is asserted back below in the position he put it in. `Bash(curl *)` is in the
  # allow list because it is in HIS: the conflict the "inside is stricter" case turns on only exists if the fixture
  # has the same one, and a fixture that quietly lacks it proves nothing.
  jq -n '{theme: "ownr-theme",
          hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: "$HOME/bin/cc-guard"}]}]},
          permissions: {allow: ["Bash(hisown *)", "Bash(curl *)"], deny: ["Bash(tmux kill-server:*)"], ask: ["Bash(sudo tee *)"]}}' > "$fh/.claude/settings.json"
  probe='s=$HOME/.claude/settings.json
    echo silent=$(jq -r "[(.permissions.allow|index(\"Bash(*)\")!=null),(.permissions.allow|index(\"Write(//**)\")!=null),(.permissions.allow|index(\"mcp__cc-slack__history\")!=null),(.permissions.allow|index(\"mcp__cc-slack__thread\")!=null)]|join(\",\")" $s)
    echo crosses=$(jq -r "[(.permissions.ask|index(\"Bash(curl:*)\")!=null),(.permissions.ask|index(\"Bash(ssh:*)\")!=null),(.permissions.ask|index(\"Bash(sudo:*)\")!=null),(.permissions.ask|index(\"WebFetch\")!=null)]|join(\",\")" $s)
    echo impossible=$(jq -r "[(.permissions.ask|index(\"Bash(gh:*)\")==null),(.permissions.ask|index(\"Bash(git push:*)\")==null)]|join(\",\")" $s)
    echo his=$(jq -r "[.permissions.allow[0],.permissions.deny[0],.permissions.ask[0],.theme,.hooks.PreToolUse[0].hooks[0].command]|join(\"|\")" $s)
    echo keys=$(jq -r "keys|join(\",\")" $s)
    echo ro=$( (echo x >> $s) 2>/dev/null && echo writable || echo ro)'
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c "$probe" 2>&1)
  t 'baseline: inside a member workspace, what the boundary contains is silent — Bash, Write, and reading its own Slack channel' \
    "$(g silent)" true,true,true,true
  t 'baseline: …and what leaves the sealed world still asks — the network clients, WebFetch and sudo' \
    "$(g crosses)" true,true,true,true
  # `curl` is in HIS allow list box-wide (and in this fixture's, for that reason), so the copy carries it in BOTH
  # lists at once and only `ask` outranking `allow` decides it. That is the whole "inside is stricter, not looser"
  # claim, so the case asserts the conflict is really there — allow AND ask — not just that an ask rule was appended.
  t 'baseline: a command his own allow list permits is in the copy'"'"'s allow AND its ask — inside is stricter, not looser' \
    "$(env HOME="$fh" "$SELF" member "$h" -- sh -c 'jq -r "[(.permissions.allow|index(\"Bash(curl *)\")!=null),(.permissions.ask|index(\"Bash(curl:*)\")!=null),(.permissions.allow|index(\"Bash(hisown *)\")!=null)]|join(\",\")" $HOME/.claude/settings.json' 2>/dev/null)" true,true,true
  t 'baseline: nothing already broken by the boundary is asked about — no gh, no git push, because there is no credential in here to push with' \
    "$(g impossible)" true,true
  t 'baseline: his hook, his deny, his ask and his allow come through in his own order, and the rest of his file with them' \
    "$(g his)/$(g keys)" 'Bash(hisown *)|Bash(tmux kill-server:*)|Bash(sudo tee *)|ownr-theme|$HOME/bin/cc-guard/hooks,permissions,theme'
  # A SESSION THAT COULD REWRITE ITS OWN settings.json COULD UNREGISTER cc-guard FROM IT: the ro comes from the mount.
  t 'baseline: the copy is read-only inside — no session grants itself permissions or drops the hook gates' "$(g ro)" ro
  # ── THE WORKER PATH GETS THE SAME COPY, on its own fixture in the same HOME ────────────────────────────────────
  mkdir -p "$fh/dev/$w" "$fh/.cc/state/$w/t" "$fh/.cc/worktrees/$w" || return 1
  git -C "$fh/dev/$w" init -q -b main >/dev/null 2>&1 \
    && git -C "$fh/dev/$w" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init >/dev/null 2>&1 \
    && git -C "$fh/dev/$w" worktree add -q -b track/t "$fh/.cc/worktrees/$w/t" >/dev/null 2>&1 || return 1
  out=$(env HOME="$fh" CC_WORKER_SANDBOX=1 "$SELF" "$w" t -- sh -c "$probe" 2>&1)
  t 'baseline: a track worktree gets the same copy, read-only, with his own rules kept' \
    "$(g silent)/$(g crosses)/$(g ro)/$(g his)" 'true,true,true,true/true,true,true,true/ro/Bash(hisown *)|Bash(tmux kill-server:*)|Bash(sudo tee *)|ownr-theme|$HOME/bin/cc-guard'
  # …and with the sandbox OFF there is no boundary, so there is no baseline either: the command runs untouched and
  # reads whatever settings.json the host session already had.
  out=$(env HOME="$fh" CC_WORKER_SANDBOX='' "$SELF" "$w" t -- sh -c 'echo off=$(jq -r "(.permissions.allow|index(\"Bash(*)\"))==null" $HOME/.claude/settings.json)' 2>&1)
  t 'baseline: with the sandbox off nothing is applied — no boundary, no baseline' "$(g off)" true
  git -C "$fh/dev/$w" worktree remove --force "$fh/.cc/worktrees/$w/t" >/dev/null 2>&1
  # ── HIS FILE DOES NOT PARSE. Dropping to the baseline alone would silently drop the box's hook gates with it, so
  #    his file is bound unchanged — the session sees it byte for byte — and the launch says the baseline was not applied.
  printf 'not json {' > "$fh/.claude/settings.json"
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c 'echo raw=$(cat $HOME/.claude/settings.json)' 2>&1)
  t 'baseline: an unparseable settings.json goes through unchanged, and the launch says the baseline is NOT applied' \
    "$(g raw)/$(grep -c 'does not parse' <<<"$out")/$(grep -c 'NOT applied' <<<"$out")" 'not json {/1/1'
  # ── HIS FILE PARSES AND THE MERGE STILL CANNOT RUN — `allow` a string where a list belongs is a jq type error
  #    mid-stream, and a full disk truncates the same way. If that failure is swallowed the session is ro-bound an
  #    EMPTY settings.json: no permission rules and NO cc-guard hook, with nothing said. So what this case asserts is
  #    his hook arriving intact, the file still being his own (allow is still the string he wrote), and both lines
  #    the launch owes him.
  jq -n '{hooks: {PreToolUse: [{matcher: "Bash", hooks: [{type: "command", command: "$HOME/bin/cc-guard"}]}]},
          permissions: {allow: "Bash(x)"}}' > "$fh/.claude/settings.json"
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c 'echo hook=$(jq -r ".hooks.PreToolUse[0].hooks[0].command // \"GONE\"" $HOME/.claude/settings.json)
    echo allow=$(jq -r ".permissions.allow|type" $HOME/.claude/settings.json)' 2>&1)
  t 'baseline: a settings.json the baseline cannot merge into keeps his hook and says so — never an empty file bound in its place' \
    "$(g hook)/$(g allow)/$(grep -c 'would not merge' <<<"$out")/$(grep -c 'NOT applied' <<<"$out")" '$HOME/bin/cc-guard/string/1/1'
  # ── …and no settings.json of his at all: NOTHING is bound, because his file is where the hooks live and a
  #    baseline without them would be a session holding Bash(*) with cc-guard unregistered — more open than
  #    default, in the function written to make it less (review of #198). It says so, and it does not invent one.
  rm -f "$fh/.claude/settings.json"
  out=$(env HOME="$fh" "$SELF" member "$h" -- sh -c "$probe" 2>&1)
  t 'baseline: with no settings.json of his at all, NO baseline is installed and the launch says why' \
    "[$(g keys)]/$(grep -c 'no ~/.claude/settings.json to build' <<<"$out")/$(grep -c 'NOT applied' <<<"$out")" '[]/1/1'
  real1=$(md5sum "$H/.claude/settings.json" 2>/dev/null | cut -d' ' -f1); real1="${real1:-absent}"
  t 'baseline: through all of that, the box'"'"'s real ~/.claude/settings.json is untouched — it is his, and this only reads it' "$real1" "$real0"
  rm -rf "${fh:?}"; }
selfcheck(){   # a scratch repo with two tracks, real bwrap: secrets and sockets absent, git whole, the other track gone; off = untouched
  local r="_ccsbx$$" mb="_ccsbxb$$" dev wt st n=0 bad=0 out out2 want rc c m0 t0 u0 hd held rsd rsd2 sec
  dev="$H/dev/$r"; wt="$H/.cc/worktrees/$r/t"; st="$H/.cc/state/$r/t"
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  g(){ sed -n "s/^$1=//p" <<<"$out" | head -1; }
  command -v bwrap >/dev/null 2>&1 || { echo "cc-sandbox selfcheck: bwrap is not installed"; return 1; }
  mkdir -p "$dev" "$st" "$H/.cc/state/$r/u" "$H/.cc/worktrees/$r" || return 1
  git -C "$dev" init -q -b main && git -C "$dev" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init || return 1
  git -C "$dev" worktree add -q -b track/t "$wt" && git -C "$dev" worktree add -q -b track/u "$H/.cc/worktrees/$r/u" || return 1
  mkdir -p "$wt/.cc"; : > "$wt/.cc/track"
  # Two delete targets nothing else in here touches, so each reads its own effect: one OUTSIDE the worker's branch
  # namespace, which must survive, and one inside it, which does not — that is the limit, measured below and not claimed.
  git -C "$dev" branch other >/dev/null 2>&1 && git -C "$dev" branch track/x >/dev/null 2>&1 || return 1
  printf '[core]\n\thooksPath = /host/own\n' > "$dev/.git/config.worktree"   # a repo that HAS one, so the ro bind over it is the thing being driven
  # main moves on AFTER the tracks are cut, so the rebase the worker does inside has real work to replay — which is what
  # sets CHERRY_PICK_HEAD, and clearing that is what needs a writable .git directory (build).
  git -C "$dev" -c user.name=t -c user.email=t@t commit -q --allow-empty -m 'main moves on' || return 1
  m0=$(git -C "$dev" rev-parse main); t0=$(git -C "$dev" rev-parse track/t)   # where main and the track's own branch stand before a worker runs
  u0=$(git -C "$dev" rev-parse track/u)   # …and the SIBLING track's, which nothing a worker does may move
  git -C "$dev" repack -a -d -q   # …and a real repo's OBJECTS are packed too: this puts a pack under the ro bind inside, which is what the two pack cases below drive
  git -C "$dev" pack-refs --all   # a real repo's refs are PACKED: it puts a packed-refs file under the ro bind, and leaves
  # refs/heads/main with no loose file at all — so `no loose ref can be planted` below is the shadowing attack, not a rewrite
  # a MEMBER's board beside it, as board_dir leaves one: the file and lock in ~/.cc/members/<h>/board/, ~/.cc/boards/<h>.json and .lock links to them
  mkdir -p "$H/.cc/members/$mb/board" && printf '{"repo":"%s","tracks":{"t":{"status":"running","title":"m"}}}\n' "$mb" > "$H/.cc/members/$mb/board/$mb.json" \
    && : > "$H/.cc/members/$mb/board/$mb.lock" && ln -sfn "$H/.cc/members/$mb/board/$mb.json" "$H/.cc/boards/$mb.json" \
    && ln -sfn "$H/.cc/members/$mb/board/$mb.lock" "$H/.cc/boards/$mb.lock" || return 1
  # ON: what the world inside contains — every line a fact a reviewer of the bind list would ask about
  out=$(CC_WORKER_SANDBOX=1 TMUX=/tmp/tmux-0/x CLAUDE_CODE_OAUTH_TOKEN=leak "$SELF" "$r" t -- sh -c '
    e(){ [ -e "$1" ] && echo present || echo absent; }
    echo cred=$(jq -c "[(.claudeAiOauth.accessToken != null), (.claudeAiOauth.refreshToken != null), (keys | length)]" ~/.claude/.credentials.json 2>/dev/null)$(stat -c %a ~/.claude/.credentials.json 2>/dev/null)
    echo gh=$(e ~/.config/gh); echo ccbox=$(e ~/ccbox); echo ccconfig=$(e ~/.cc/config); echo hooks=$(touch ~/dev/'"$r"'/.git/hooks/x 2>/dev/null && echo writable || echo ro)
    echo ssh=$(e ~/.ssh); echo sock=$(e /var/run/docker.sock)$(e /run/docker.sock); echo tmux=${TMUX:-unset}
    echo dockergrp=$(id -Gn | tr " " "\n" | grep -c "^docker$"); echo pid1=$(ls /proc | grep -c "^[0-9]" | awk "{print (\$1 < 20) ? \"few\" : \"many\"}")
    echo cwd=$PWD; echo status=$(git status --short >/dev/null 2>&1 && echo ok || echo broken); echo common=$(git rev-parse --git-common-dir)
    echo x > f && git add f >/dev/null 2>&1
    cerr=$( (git -c user.name=t -c user.email=t@t commit -qm c >/dev/null) 2>&1 ); crc=$?
    echo commit=$([ "$crc" = 0 ] && echo ok || echo broken); echo cerrlines=$(printf "%s" "$cerr" | grep -c .)
    # THE SEQUENCE THE BOX RUNS EVERY DAY: rebase onto the base, commit, amend. The commit after a rebase is the one that
    # clears CHERRY_PICK_HEAD, and a .git it cannot take a lock in leaves that behind and breaks the amend.
    echo rebase=$( (git -c user.name=t -c user.email=t@t rebase main) >/dev/null 2>&1 && echo ok || echo broken)
    echo y > f3; git add f3 >/dev/null 2>&1
    echo commit2=$( (git -c user.name=t -c user.email=t@t commit -qm c2) >/dev/null 2>&1 && echo ok || echo broken)
    echo cph=$([ -e "$(git rev-parse --git-path CHERRY_PICK_HEAD)" ] && echo left || echo cleared)
    echo amend=$( (git -c user.name=t -c user.email=t@t commit -q --amend -m c3) >/dev/null 2>&1 && echo ok || echo broken)
    mine=$(git rev-parse HEAD); echo mine=$mine; p=~/dev/'"$r"'; d=$p/.git   # THE REF STORE, from inside, AFTER real work
    echo tagref=$( (git -C $p tag sbxtag) 2>/dev/null && echo made || echo refused)
    echo movemain=$( (git -C $p update-ref refs/heads/main "$mine") 2>/dev/null && echo moved || echo refused)
    echo rawmain=$( (printf "%s\n" "$mine" > $d/refs/heads/main) 2>/dev/null && echo wrote || echo refused)
    echo newref=$( (printf "%s\n" "$mine" > $d/refs/heads/planted) 2>/dev/null && echo wrote || echo refused)
    echo delother=$( (git -C $p update-ref -d refs/heads/other) 2>/dev/null && echo deleted || echo refused)
    echo mainhead=$( (printf "ref: refs/heads/track/u\n" > $d/HEAD) 2>/dev/null && echo wrote || echo refused)
    echo packed=$( (printf "" > $d/packed-refs) 2>/dev/null && echo wrote || echo refused)
    echo cfgwt=$( (printf "[core]\n\thooksPath = /tmp/evil\n" > $d/config.worktree) 2>/dev/null && echo wrote || echo refused)
    echo otherwt=$( (printf "ref: refs/heads/main\n" > $d/worktrees/u/HEAD) 2>/dev/null && echo wrote || echo refused)
    echo sibling=$( (git -C $p update-ref refs/heads/track/u "$mine") 2>/dev/null && echo moved || echo refused)
    echo packedx=$( (git -C $p update-ref -d refs/heads/track/x) 2>/dev/null && echo deleted || echo refused)   # PACKED: deleting it needs packed-refs, which is ro
    echo newns=$( (git -C $p update-ref refs/heads/track/planted "$mine") 2>/dev/null && echo made || echo refused)
    echo delns=$( (git -C $p update-ref -d refs/heads/track/planted) 2>/dev/null && echo deleted || echo refused)   # …a loose one it made itself does go
    # THE OBJECT STORE, BOTH HALVES. A worker must be able to WRITE objects, so a loose one it makes it can also
    # delete — the carve-out. What it may not delete is the PACKED history, which is where a repo older than a day
    # keeps nearly all of itself. A throwaway of its own is the delete target, so this case cannot cost any later one
    # the commit it reads.
    ob=$(printf throwaway | git -C $p hash-object -w --stdin 2>/dev/null)
    op=$d/objects/$(echo "$ob" | cut -c1-2)/$(echo "$ob" | cut -c3-)
    echo madeloose=$([ -f "$op" ] && echo yes || echo no)
    echo delloose=$( (rm -f "$op") 2>/dev/null && echo deleted || echo refused)
    echo packn=$(ls $d/objects/pack/ 2>/dev/null | grep -c "[.]pack$")
    echo delpack=$( (rm -f $d/objects/pack/*.pack) 2>/dev/null && echo deleted || echo refused)
    echo mvpack=$( (mv $d/objects/pack $d/objects/packx) 2>/dev/null && echo moved || echo pinned)
    echo packn2=$(ls $d/objects/pack/ 2>/dev/null | grep -c "[.]pack$")
    # …and objects/info, which is not about deleting anything: `alternates` names a directory the HOST'"'"'s git then reads
    # objects from, and a bogus `commit-graph` is parsed by every host git call in the repo.
    echo alternates=$( (mkdir -p $d/objects/info; printf "%s\n" $p/plantedobjects > $d/objects/info/alternates) 2>/dev/null && echo wrote || echo refused)
    echo cgraph=$( (printf notagraph > $d/objects/info/commit-graph) 2>/dev/null && echo wrote || echo refused)
    # THE TWO REDIRECT FILES: where the host'"'"'s own git is TOLD this worktree'"'"'s git dir and common dir are. Both sit in a
    # tree the worker writes, and both still resolve for the worker'"'"'s own git — so each is read here as well as written.
    # `resolves` FIRST, because with the pins gone the writes below make every later git call in this cwd resolve into
    # /tmp/evil; the assertion out there restores both files so no case after this one inherits a poisoned fixture.
    echo resolves=$(git rev-parse --absolute-git-dir)/$(git rev-parse --git-common-dir)
    echo gitlink=$( (printf "gitdir: /tmp/evil\n" > $PWD/.git) 2>/dev/null && echo wrote || echo refused)
    echo commondir=$( (printf "/tmp/evil\n" > $d/worktrees/t/commondir) 2>/dev/null && echo wrote || echo refused)
    echo newname=$( (printf x > $d/shallow) 2>/dev/null && echo wrote || echo refused)   # LAST: a bogus shallow file breaks every git call after it
    echo gitconfig=$(git config user.name z 2>/dev/null && echo writable || echo ro); echo bin=$(touch ~/bin/x 2>/dev/null && echo writable || echo ro)
    echo nsdls=$(ls -A ~/dev/'"$r"'/.git/refs/heads/track 2>/dev/null | tr "\n" " ")   # the branch namespace, from inside: this track only, no sibling to move
    echo sbxdir=$([ -e ~/.cc/sandbox ] && echo present || echo absent)                # …and the host dir that namespace is a copy of is not in here at all
    echo tracks=$(ls ~/.cc/worktrees/'"$r"' | tr "\n" " "); echo states=$(ls ~/.cc/state/'"$r"' | tr "\n" " "); echo dev=$(ls -A ~/dev/'"$r"' | tr "\n" " ")
    echo tok=${CLAUDE_CODE_OAUTH_TOKEN:+set}; echo cj=$(jq -r "(.projects|length),(.mcpServers|length)" ~/.claude.json | tr "\n" ","); echo cjkeys=$(jq -r "keys|join(\",\")" ~/.claude.json); echo settings=$(touch ~/.claude/settings.json 2>/dev/null && echo writable || echo ro)
    echo tmp=$(touch /tmp/x && echo ok); echo runuser=$(ls -A /run/user/$(id -u) 2>/dev/null | wc -l)
    echo mboard=$(~/bin/cc-board get '"$mb"' t status 2>/dev/null); echo mwrite=$(~/bin/cc-board status '"$mb"' t done >/dev/null 2>&1 && echo wrote || echo refused)
    echo plant=$(ln -sfn ~/.claude/settings.json ~/.cc/boards/planted.json 2>/dev/null && echo planted || echo ro)
    echo leakfds=$(ls -l /proc/self/fd 2>/dev/null | sed -n "s|.* -> ||p" | grep -c "^$HOME/")' 2>&1)
  want='[false,false,0]'; jq -e '.claudeAiOauth.accessToken' "$H/.claude/.credentials.json" >/dev/null 2>&1 && want='[true,false,1]'   # the real file has one → the copy has it, no refresh token, nothing else
  t 'credentials: a stripped copy, mode 600' "$(g cred)" "${want}600";  t 'config/gh absent' "$(g gh)" absent;  t 'ccbox absent' "$(g ccbox)" absent;  t '.git/hooks is ro' "$(g hooks)" ro
  t 'cc/config absent' "$(g ccconfig)" absent;  t 'ssh absent' "$(g ssh)" absent;  t 'the container socket absent' "$(g sock)" absentabsent
  t 'TMUX unset' "$(g tmux)" unset;  t 'not in the docker group' "$(g dockergrp)" 0;  t 'own pid namespace' "$(g pid1)" few
  t 'cwd is the worktree' "$(g cwd)" "$wt";  t 'git status works' "$(g status)" ok;  t 'the parent .git resolves' "$(g common)" "$dev/.git"
  t 'a commit works' "$(g commit)" ok;  t '.git/config is ro' "$(g gitconfig)" ro;  t 'bin is ro' "$(g bin)" ro
  # ── THE PARENT REF STORE IS THE HOST'S (build) ──────────────────────────────────────────────────────────────────
  # Measured against this same file with `.git` bound rw, as it was: every line below came back moved/wrote/deleted and
  # the host's main really moved, refs/heads/track/u was really gone, and .git/config.worktree really carried a
  # core.hooksPath for the host's own git to run. Turn the ro-bind back into --bind and they go red again.
  t 'refs/heads/main cannot be moved from inside — not through git, and not by writing the ref' "$(g movemain)/$(g rawmain)" refused/refused
  t '…and the host'"'"'s main is where it was, not on the commit the worker just made' \
    "$(git -C "$dev" rev-parse main)/$([ "$(git -C "$dev" rev-parse main)" = "$(g mine)" ] && echo same || echo differs)" "$m0/differs"
  t 'no loose ref can be planted in refs/heads either — a name there shadows the packed ref of the same branch' "$(g newref)" refused
  t 'a branch outside the worker'"'"'s own namespace cannot be deleted' \
    "$(g delother)/$(git -C "$dev" rev-parse -q --verify refs/heads/other >/dev/null && echo alive || echo gone)" refused/alive
  t 'the main checkout'"'"'s HEAD cannot be repointed' "$(g mainhead)/$(cat "$dev/.git/HEAD")" 'refused/ref: refs/heads/main'
  t 'packed-refs cannot be rewritten' "$(g packed)" refused
  t 'no tag can be created or moved in the parent ref store' "$(g tagref)" refused
  # THE HALF THAT KEEPS THE WORK WORKING, and the reason .git is a tmpfs rather than a ro bind. With it ro, `git commit`
  # could not take $GIT_COMMON_DIR/packed-refs.lock to clear CHERRY_PICK_HEAD: it printed `error: Unable to create
  # …/packed-refs.lock: Read-only file system`, left the pseudo-ref behind, and the NEXT `git commit --amend` refused
  # with "You are in the middle of a cherry-pick". Measured on git 2.53. Turn the tmpfs back into a ro bind of .git and
  # all four fields below go red.
  t 'a commit says nothing on stderr — the .git a worker writes is its own, so the lock it takes to clear a pseudo-ref succeeds' \
    "$(g cerrlines)" 0
  t 'rebase onto the base, commit, amend — the sequence the box runs every day, with no CHERRY_PICK_HEAD left behind' \
    "$(g rebase)/$(g commit2)/$(g cph)/$(g amend)" ok/ok/cleared/ok
  # DENY BY DEFAULT, which is what the tmpfs buys: only what `build` binds exists in there. A name the real .git does
  # not have is the worker's to create and is nothing the host will ever read — `shallow` would make the host repo
  # look shallow if it landed there, and it does not land there.
  t 'a name the real .git does not have is the worker'"'"'s own and reaches the host nowhere' \
    "$(g newname)/$([ -e "$dev/.git/shallow" ] && echo left || echo none)" wrote/none
  t '.git/config.worktree cannot be written — a core.hooksPath there is a hook the HOST'"'"'s git runs' \
    "$(g cfgwt)/$(sed -n 2p "$dev/.git/config.worktree")" 'refused/	hooksPath = /host/own'
  t 'another track'"'"'s per-worktree git dir is ro — its HEAD and index are not this worker'"'"'s' "$(g otherwt)" refused
  # THE REDIRECT ROUND THE WHOLE TMPFS. The worktree tree and this track's admin dir are rw, so the two files that say
  # WHERE the git dir and the common dir are sit in what the worker writes — and the host runs `git -C "$wt" …` out
  # there as the owner (cc-loop's checkpoint, `cc done`). Left rw, `gitdir: /tmp/evil` or a rewritten `commondir`
  # points that git at a directory the worker made, whose config and hooks it also made, and every wall above is moot.
  # Measured with the two ro pins removed: both came back `wrote`, and the host's git then resolved into /tmp/evil.
  # Read against the fixture's own paths, so it fails if the pin binds the right file at the wrong place.
  t 'the worktree gitlink and the admin dir'"'"'s commondir are ro — the HOST'"'"'s git cannot be re-pointed at a directory the worker wrote' \
    "$(g gitlink)/$(g commondir)/$(cat "$wt/.git")/$(cat "$dev/.git/worktrees/t/commondir")" \
    "refused/refused/gitdir: $dev/.git/worktrees/t/../.."
  t '…and they still do their job for the worker'"'"'s own git, which is why they are pinned ro rather than absent' \
    "$(g resolves)" "$dev/.git/worktrees/t/$dev/.git"
  # …and PUT THEM BACK, after the two cases above have read them and before anything else runs. With the pins in place
  # this rewrites what is already there; with them removed it is what keeps the removal proof pointing at these two
  # cases instead of every later one that shares this scratch repo (measured: 7 red, of which 5 were the poisoned
  # gitlink, not the guard).
  printf 'gitdir: %s\n' "$dev/.git/worktrees/t" > "$wt/.git"; printf '../..\n' > "$dev/.git/worktrees/t/commondir"
  # THE WORK STILL LANDS, which is the half that matters more: the commit made inside moved the HOST's track/t, so the
  # checkpoint outside has something to push. A wall that costs the worker its branch is worse than the hole.
  # `mine` alone would be green with no commit at all — HEAD and track/t agree either way — so the branch is also read
  # against where IT started, t0, not against main. Drop the rw bind of the ref directory and this goes red on that field.
  # …and it lands through the FOLD, which is the line cc-loop runs before its checkpoint. Both halves are read, in
  # order: while the worker runs the host's branch has not moved (the namespace inside is this track's own copy), and
  # after `cc-sandbox reconcile` it is on the worker's commit with a reflog entry for it. Drop the reconcile call from
  # cc-loop and the third field below goes `stuck` — which is the whole risk this design carries, so it is a case.
  held=$(git -C "$dev" rev-parse refs/heads/track/t)
  "$SELF" reconcile "$r" t 2>/dev/null
  t 'the host'"'"'s track/t does not move while the worker runs, and cc-loop'"'"'s fold is what puts the commit on it' \
    "$([ "$held" = "$t0" ] && echo held || echo moved)/$(git -C "$dev" rev-parse refs/heads/track/t)/$([ "$(git -C "$dev" rev-parse refs/heads/track/t)" = "$t0" ] && echo stuck || echo advanced)" \
    "held/$(g mine)/advanced"
  t '…with a reflog entry on the host'"'"'s own branch, so the checkpoint has a history to push' \
    "$(git -C "$dev" reflog show track/t --format=%H 2>/dev/null | head -1)" "$(g mine)"
  # A SIBLING TRACK'S BRANCH, WHICH USED TO BE REACHABLE AND IS NOT (rstore). Driven both ways in one case: the write
  # inside still REPORTS success, because refs/heads/track in there is this track's own directory and `track/u` is a
  # name the worker made in it — and the host's track/u is exactly where the fixture left it. Turn the two --bind lines
  # in `build` back into `pinq --bind "$dev/.git/$NSD"` and the second field becomes the worker's own commit.
  t 'a sibling track'"'"'s branch cannot be moved: the write lands in this track'"'"'s own namespace and the host'"'"'s track/u never moves' \
    "$(g sibling)/$(git -C "$dev" rev-parse refs/heads/track/u)/$([ "$(git -C "$dev" rev-parse refs/heads/track/u)" = "$u0" ] && echo untouched || echo moved)" \
    "moved/$u0/untouched"
  t '…and the namespace inside holds this track and what the worker itself put there, while the host'"'"'s holds only the folded branch' \
    "$(g nsdls)/$(g sbxdir)/$(ls -A "$dev/.git/$NSD" 2>/dev/null | tr '\n' ' ')" 't u/absent/t '
  t '…so a loose ref made inside is made and deleted inside, and reaches the host'"'"'s ref store nowhere' \
    "$(g newns)/$(g delns)" made/deleted
  # THE FOLD ITSELF, DRIVEN. It moves the ONE constant name from argv and no other, whatever a worker leaves beside it;
  # and it is a compare-and-swap, so a branch the host moved while the worker ran keeps the host's move and the worker's
  # commit is named in the refusal rather than thrown away.
  # Each of the two builds the store it reads — the ref it asks the fold to move FROM is read here, not inherited from
  # whatever the case above happened to leave, so neither passes because of the other.
  rsd=$(rstore "$r" t); mkdir -p "$rsd/refs"
  hd=$(git -C "$dev" rev-parse refs/heads/track/t)   # where the branch stands NOW: this store's honest base
  printf '%s\n' "$m0" > "$rsd/refs/u"; printf '%s\n' "$m0" > "$rsd/refs/t"; printf '%s' "$hd" > "$rsd/base"
  "$SELF" reconcile "$r" t 2>/dev/null
  t 'the fold moves refs/heads/track/<track> and no other name a worker leaves in its own store' \
    "$(git -C "$dev" rev-parse refs/heads/track/t)/$(git -C "$dev" rev-parse refs/heads/track/u)" "$m0/$u0"
  # …and now a base that is deliberately NOT where the branch stands, which is what a host-side move during the run looks like
  hd=$(git -C "$dev" rev-parse refs/heads/track/t)
  printf '%s\n' "$(g mine)" > "$rsd/refs/t"; printf '%s' "$t0" > "$rsd/base"
  out2=$("$SELF" reconcile "$r" t 2>&1); rc=$?
  t 'a fold whose branch moved on the host meanwhile overwrites nothing, exits non-zero, and names the commit to recover' \
    "$rc/$([ "$t0" = "$hd" ] && echo same-base || echo stale-base)/$(git -C "$dev" rev-parse refs/heads/track/t)/$(grep -c "$(g mine)" <<<"$out2")" \
    "1/stale-base/$hd/1"
  # A LINK WHERE THE BRANCH FILE GOES — the one that leaked. Everything under the store's refs/ is the worker's, so it
  # can delete its own ref file and leave a symlink at that name; `[ -f ]` and `<` both follow it, out here, as the
  # owner. Measured before the fix: the fold read a host file through the link and printed its bytes onto cc-loop's
  # pane. Two shapes, refused by two different lines — the link AT the leaf, and a link on the way DOWN to it — and
  # both are read against the planted secret's own bytes rather than against an exit code.
  sec="TOKENthatmustnotbeprinted$$"; printf '%s\n' "$sec" > "$H/.cc/state/$r/b"
  hd=$(git -C "$dev" rev-parse refs/heads/track/t)
  rm -f "$rsd/refs/t"; ln -sfn "$H/.cc/state/$r/b" "$rsd/refs/t"; printf '%s' "$t0" > "$rsd/base"
  out2=$("$SELF" reconcile "$r" t 2>&1); rc=$?
  t 'a symlink left where the branch file goes is refused, what it pointed at is never read out, and the branch does not move' \
    "$rc/$(grep -c "$sec" <<<"$out2")/$(grep -c 'left a symlink' <<<"$out2")/$(git -C "$dev" rev-parse refs/heads/track/t)" "1/0/1/$hd"
  rm -f "$rsd/refs/t"
  # …and the same reached through a DIRECTORY link, where the leaf itself is an ordinary file: a track name with a
  # component in it, and that component a link out of the store. `[ -L ]` on the leaf is false here — the confinement
  # is what refuses it.
  rsd2=$(rstore "$r" a/b); mkdir -p "$rsd2/refs"; ln -sfn "$H/.cc/state/$r" "$rsd2/refs/a"; printf '%s' "$t0" > "$rsd2/base"
  out2=$("$SELF" reconcile "$r" a/b 2>&1); rc=$?
  t '…and a link on the WAY to the branch file is refused too: the leaf is a plain file, but it resolves out of the store' \
    "$rc/$(grep -c "$sec" <<<"$out2")/$(grep -c 'resolves out of its own ref store' <<<"$out2")" 1/0/1
  rm -rf "$rsd2"
  # WHAT THE FILE HOLDS IS DESCRIBED, NOT REPEATED — the second half of the same leak: a worker can put anything in
  # there, so the refusal answers with a length and a hash. Then the id that is well formed and is no commit here.
  printf '%s\n' "$sec" > "$rsd/refs/t"; printf '%s' "$t0" > "$rsd/base"
  out2=$("$SELF" reconcile "$r" t 2>&1); rc=$?
  t 'what is not a commit id is refused by its shape, and the refusal says how long it was and never what it said' \
    "$rc/$(grep -c "$sec" <<<"$out2")/$(grep -c 'not a commit id' <<<"$out2")/$(git -C "$dev" rev-parse refs/heads/track/t)" "1/0/1/$hd"
  printf '%s\n' 0000000000000000000000000000000000000001 > "$rsd/refs/t"; printf '%s' "$t0" > "$rsd/base"
  out2=$("$SELF" reconcile "$r" t 2>&1); rc=$?
  t '…and an id that is well formed but is no commit in the repo is refused before update-ref is ever asked' \
    "$rc/$(grep -c 'which is no commit' <<<"$out2")/$(git -C "$dev" rev-parse refs/heads/track/t)" "1/1/$hd"
  # A FOLD THAT COULD NOT HAPPEN IS NOT THROWN AWAY (rs_seed). The store is still unfoldable from the case above, so
  # the NEXT launch moves it aside under a name that says so and seeds a fresh one, rather than wiping the one file
  # naming the commits the last run made. A real launch, because rs_seed is what `build` calls.
  rm -rf "$rsd".unfolded.*
  out2=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo STARTED' 2>&1)   # out2, never out: every object-store case below still reads the FIRST probe through `g`
  t 'a store that could not be folded is moved aside and kept, and the launch goes on with a freshly seeded one' \
    "$(grep -c STARTED <<<"$out2")/$(cat "$rsd".unfolded.*/refs/t 2>/dev/null)/$(cat "$rsd/refs/t" 2>/dev/null)" \
    "1/0000000000000000000000000000000000000001/$(git -C "$dev" rev-parse refs/heads/track/t)"
  rm -rf "$rsd".unfolded.*
  # THE OBJECT STORE: WHAT IS CLOSED AND WHAT IS ACCEPTED, each read against the other rather than one of them claimed.
  # objects/ is rw because every commit a worker makes writes one, so a LOOSE object it can delete and this says so.
  # objects/pack is ro on top, so the packed history cannot be deleted and the directory cannot be walked away from —
  # remove that one bind and delpack comes back `deleted` with the host's pack really gone.
  t 'the packed history cannot be deleted or renamed away, and every pack is still there afterwards' \
    "$(g packn)/$(g delpack)/$(g mvpack)/$(g packn2)/$(shopt -s nullglob; set -- "$dev"/.git/objects/pack/*.pack; echo $#)" 1/refused/pinned/1/1
  t 'objects/info is ro too — no alternates to point the host'"'"'s git at an object directory a worker named, and no commit-graph to break every host git call in the repo' \
    "$(g alternates)/$(g cgraph)/$([ -e "$dev/.git/objects/info/alternates" ] && echo left || echo none)/$([ -e "$dev/.git/objects/info/commit-graph" ] && echo left || echo none)/$(git -C "$dev" rev-parse main)" \
    "refused/refused/none/none/$m0"
  t 'accepted, and driven rather than asserted: a LOOSE object a worker writes it can also delete — the objects it has not pushed yet, and no more' \
    "$(g madeloose)/$(g delloose)" yes/deleted
  t '…but a PACKED sibling it cannot delete, because that would rewrite packed-refs' \
    "$(g packedx)/$(git -C "$dev" rev-parse -q --verify refs/heads/track/x >/dev/null && echo alive || echo gone)" refused/alive
  t 'only this track is there' "$(g tracks)" t;  t 'only this track state' "$(g states)" t;  t 'the rest of the repo is gone' "$(g dev)" .git
  t 'no token in the environment' "$(g tok)" "";  t 'claude.json copy: no other projects, no MCP' "$(g cj)" '0,0,'
  t 'claude.json copy: only projects and mcpServers, nothing of the account' "$(g cjkeys)" mcpServers,projects
  t 'settings.json is ro' "$(g settings)" ro;  t '/tmp is writable' "$(g tmp)" ok;  t 'the host /run/user (its sockets) is not there' "$(g runuser)" 0
  # a member's board is a link into ~/.cc/members/<h>/board/ (board_dir); ~/.cc/boards alone left it dangling and every member track gone from cc-board inside (review of #224)
  t 'a member'"'"'s board — a link out of ~/.cc/boards — is read inside' "$(g mboard)" running
  t '…and cannot be written from inside: the write is refused and the host file is as it was' "$(g mwrite)/$(jq -r .tracks.t.status "$H/.cc/members/$mb/board/$mb.json")" refused/running
  # ~/.cc/boards ITSELF is ro (it was rw): a link planted there is one the HOST saves through, and that renamed a board over
  # the owner's settings.json. cc-board refuses the link too; this is the bind that stops it being written at all.
  t 'nothing can be planted in ~/.cc/boards: the directory is ro, so a link there for the host to save through cannot be made' \
    "$(g plant)/$([ -e "$H/.cc/boards/planted.json" ] && echo left || echo none)" ro/none
  t 'not one of the pinned descriptors reaches the session — an inherited directory fd walks out of the namespace' "$(g leakfds)" 0
  # ── A BIND SOURCE IS NOT A NAME, ON THIS SIDE TOO (build, and `pin`) ────────────────────────────────────────────
  # The parent `.git` is a tmpfs holding mountpoints of the real one, so `config` and `hooks` are names in a directory
  # no worker can write, and that is NOT what the pin is for. The pin is for the sources that sit in trees the worker
  # or a sibling session DOES write — the worktree, `.git/objects`, this track's admin dir and the two $NSD
  # directories. `config` and `hooks` are what these tests plant at because the host holds the two of them READ-ONLY
  # for its own checkpoint, and the shapes they prove hold for every pinned source. Each shape below is driven,
  # not argued, and each was measured against the same file with only the pins turned back into names: the link ones
  # gave a bwrap message naming neither cause nor cure, and the race handed the session the racer's directory.
  mkdir -p "$dev/decoydir"; : > "$dev/decoyfile"   # a link is only worth testing where it RESOLVES: pin's liveness test follows one
  for c in .git/config .git/hooks; do
    mv "$dev/$c" "$dev/$c.real"
    case "$c" in */config) ln -sfn "$dev/decoyfile" "$dev/$c";; *) ln -sfn "$dev/decoydir" "$dev/$c";; esac
    out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo STARTED' 2>&1); rc=$?
    t "a link planted at $c stops the launch, and binds nothing" \
      "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'is not the path it should be' <<<"$out")" 2/0/1
    rm -f "$dev/$c"; mv "$dev/$c.real" "$dev/$c"
  done
  # …and the wall is there even when git's own directory is not: `[ -d ] &&` skipped the bind quietly, which left the
  # name free for the worker to take and the NEXT launch mounting whatever it found. It is made now, so the pin is
  # unconditional. `mkdir -p` inside is the test: on a name-bound build it succeeds and the touch after it writes.
  mv "$dev/.git/hooks" "$dev/.git/hooks.gone"
  out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo hooks=$(mkdir -p ~/dev/'"$r"'/.git/hooks 2>/dev/null; touch ~/dev/'"$r"'/.git/hooks/x 2>/dev/null && echo writable || echo ro)' 2>&1)
  t 'a repo with no .git/hooks gets the ro wall all the same — the name is never left free' "$(g hooks)" ro
  rm -rf "$dev/.git/hooks"; mv "$dev/.git/hooks.gone" "$dev/.git/hooks"
  # ── WHAT IS BOUND RW IN .git IS NOT TAKEN FROM A FILE THE WORKER WRITES (track_gitdir, branch_warn) ──────────────
  # The worktree's `.git` gitlink names the per-worktree git dir this launch binds rw, and it lives in a tree the worker
  # writes. So the name is checked against the host's own side — the dir it names must be a plain entry under
  # $dev/.git/worktrees whose `gitdir` file points back at this worktree. Aimed at a SIBLING track's dir it is not, and
  # the launch stops rather than handing this worker that track's HEAD and index.
  cp "$wt/.git" "$wt/.git.real"; printf 'gitdir: %s\n' "$dev/.git/worktrees/u" > "$wt/.git"
  out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo STARTED' 2>&1); rc=$?
  t 'a gitlink aimed at another track'"'"'s git dir stops the launch, and binds nothing' \
    "$rc/$(grep -c STARTED <<<"$out")/$(grep -c 'is not a linked worktree' <<<"$out")" 2/0/1
  mv "$wt/.git.real" "$wt/.git"
  # …AND THE BRANCH IN ITS HEAD IS NOT A NAME EITHER, which is the same lesson learned the expensive way. The worktree's
  # own HEAD is rw by design — the worker rebases and checks out with it — so `ref: refs/heads/main/x` is one printf
  # away, and a build that read the ref DIRECTORY out of it bound the host's refs/heads/main on the NEXT launch and
  # handed the whole hole back. Two launches below, the shape a cc-loop iteration actually has: one poisons the HEAD,
  # the next tries to spend it. Both ref shapes are driven, because they fail differently — a LOOSE main is a file to
  # bind rw, a PACKED one is a name mkdir would plant a directory at in the host's own ref store.
  hd="$dev/.git/worktrees/t/HEAD"; cp "$hd" "$hd.real"
  printf '%s\n' "$m0" > "$dev/.git/refs/heads/main"   # loose, as a live repo's own branch is between packs
  printf 'ref: refs/heads/main/x\n' > "$hd"           # …and this is what one iteration can leave for the next
  out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'd=~/dev/'"$r"'/.git
    echo hijack=$( (printf "%s\n" 0000000000000000000000000000000000000001 > $d/refs/heads/main) 2>/dev/null && echo wrote || echo refused)
    echo hijacklog=$( (printf x > $d/logs/refs/heads/main) 2>/dev/null && echo wrote || echo refused)' 2>&1)
  t 'the rw ref directory is a constant: a HEAD rewritten to refs/heads/main/x buys the next launch nothing, and the host'"'"'s loose main is untouched' \
    "$(g hijack)/$(g hijacklog)/$(cat "$dev/.git/refs/heads/main")" "refused/refused/$m0"
  rm -f "$dev/.git/refs/heads/main"   # …and the packed shape, where the same name is free for a mkdir to take
  out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo plant=$( (printf "%s\n" 0000000000000000000000000000000000000001 > ~/dev/'"$r"'/.git/refs/heads/main) 2>/dev/null && echo wrote || echo refused)' 2>&1)
  t '…and nothing is MADE in the host'"'"'s ref store on that say-so either: no refs/heads/main directory, and main still resolves where it did' \
    "$(g plant)/$([ -e "$dev/.git/refs/heads/main" ] && echo planted || echo none)/$(git -C "$dev" rev-parse main)" "refused/none/$m0"
  mv "$hd.real" "$hd"
  # A branch outside that one directory is therefore ro, whatever it is called: the launch SAYS which branch that costs
  # rather than leaving a commit to fail with nothing to read, and says it AFTER the binds, changing none of them.
  git -C "$dev" worktree add -q -b flat "$H/.cc/worktrees/$r/v" >/dev/null 2>&1
  out=$(CC_WORKER_SANDBOX=1 "$SELF" "$r" v -- sh -c 'echo commit=$(echo y > g && git add g && git -c user.name=t -c user.email=t@t commit -qm c >/dev/null 2>&1 && echo ok || echo broken)' 2>&1)
  t 'a worktree on a branch outside refs/heads/track is told so, and the ref store stays ro for it' \
    "$(grep -c 'outside refs/heads/track' <<<"$out")/$(g commit)/$(git -C "$dev" rev-parse main)" "1/broken/$m0"
  # THE SWAP, DRIVEN. A second process — here the test, on a real box the host's own git or a sibling track, both of
  # which reach these names — renames the source aside and puts its own directory at that name inside the window
  # CC_SANDBOX_TEST_DELAY opens between the pins and the mount. A rename is the shape that decides it: a link only kills
  # the launch (above), while a rename leaves the destination valid and the source pointing at the racer's directory.
  for c in "the track worktree:$wt" "the parent .git/hooks:$dev/.git/hooks"; do
    ( sleep 0.4; mv "${c#*:}" "${c#*:}.real" 2>/dev/null && mkdir -p "${c#*:}" && : > "${c#*:}/decoy-swapped"
      sleep 1.4; rm -rf "${c#*:}"; mv "${c#*:}.real" "${c#*:}" 2>/dev/null ) &
    out=$(CC_SANDBOX_TEST_DELAY=1 CC_WORKER_SANDBOX=1 "$SELF" "$r" t -- sh -c 'echo RAN=yes; ls -A '"${c#*:}"' 2>/dev/null' 2>&1); wait
    t "a process swapping ${c%%:*} DURING the launch never reaches the mount — the descriptor was already the real one" \
      "$(g RAN)/$(grep -c decoy-swapped <<<"$out")" yes/0
  done
  # OFF: nothing changes — argv byte for byte, the environment untouched
  out=$(CC_WORKER_SANDBOX='' TMUX=T "$SELF" "$r" t -- sh -c 'printf "%s|" "$0" "$@"; printf "tok=%s tmux=%s" "${CLAUDE_CODE_OAUTH_TOKEN:-unset}" "${TMUX:-unset}"' x 'a b' 'c"d' '$e' 2>&1)
  t 'off: argv passes byte for byte' "${out%%tok=*}" 'x|a b|c"d|$e|';  t 'off: environment untouched' "${out#*tok=}" 'unset tmux=T'
  out=$(CC_WORKER_SANDBOX=0 "$SELF" "$r" t -- sh -c 'echo ${CLAUDE_CODE_OAUTH_TOKEN:-unset}' 2>&1); t 'off: 0 is off' "$out" unset
  selfcheck_member; selfcheck_member_whitelist; selfcheck_mint; selfcheck_baseline
  # Keep the executable v2 enumeration beside the legacy canary; failure is never a skip.
  local BIN; BIN=$(dirname "$SELF")
  "$BIN/cc-member-v2" selfcheck; t 'v2 cases' "$?" 0
  for c in "$wt" "$H/.cc/worktrees/$r/u" "$H/.cc/worktrees/$r/v"; do git -C "$dev" worktree remove --force "$c" >/dev/null 2>&1; done
  rm -rf "$dev" "$H/.cc/worktrees/$r" "$H/.cc/state/$r" "$H/.cc/sandbox/$r" "$H/.claude/projects/$(slug "$wt")" \
         "$H/.claude/projects/$(slug "$H/.cc/worktrees/$r/v")" "$H/.claude/projects/$(slug "$dev")" \
         "$H/.cc/members/$mb" "$H/.cc/boards/$mb.json" "$H/.cc/boards/$mb.lock"
  printf 'cc-sandbox selfcheck: %s passed, %s failed\n' "$((n - bad))" "$bad"; [ "$bad" = 0 ]; }
case "${1:-}" in selfcheck) selfcheck; exit $?;;
  __settings-copy) settings_copy; exit $?;;   # private host-side reuse of the exact legacy merge
  reconcile) [ $# -eq 3 ] || { echo "usage: cc-sandbox reconcile <repo> <track>" >&2; exit 2; }
             rs_fold "$2" "$3"; exit $?;;   # cc-loop, after every iteration — a no-op when the sandbox was off or the branch did not move
  mint) shift; mint "$@"; exit $?;;
  convert) shift; convert "${1:-}"; exit $?;;
  member) h="${2:?handle}"; shift 2; tr=""; if [ "${1:-}" != -- ]; then tr="${1:-}"; shift; fi; [ "${1:-}" = -- ] && shift   # <handle> [<track>|""] [--] cmd
          [ $# -gt 0 ] || { echo "usage: cc-sandbox member <handle> [<track>] -- <cmd...>" >&2; exit 2; }
          if [ "${CC_MEMBER_V2:-}" = 1 ]; then
            BIN=$(dirname "$SELF"); exec "$BIN/cc-member-v2" run "$h" "${tr:-$h}" -- "$@"
          fi
          launch_member "$h" "$tr" "$@";;
esac
repo="${1:?repo}"; track="${2:?track}"; shift 2; [ "${1:-}" = -- ] && shift
[ $# -gt 0 ] || { echo "usage: cc-sandbox <repo> <track> -- <cmd...>   |   cc-sandbox member <handle> [<track>] -- <cmd...>   |   cc-sandbox reconcile <repo> <track>   |   cc-sandbox mint <handle> [--from <file>]   |   cc-sandbox convert <repo>   |   cc-sandbox selfcheck" >&2; exit 2; }
[ "${CC_WORKER_SANDBOX:-}" = 1 ] || exec "$@"   # opt-in only: off means the command runs exactly as given, nothing added
launch "$repo" "$track" "$@"
