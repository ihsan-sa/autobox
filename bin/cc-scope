#!/usr/bin/env python3
"""cc-scope — the ask ledger: every ask the owner makes is written down, and 'done' is measured against it.

The board tracks what the BOX decided to do. Nothing tracked what the OWNER asked for, so a compound ask
("do X, and also Y") was closed on X, and a standing rule said once in a thread was forgotten by the next
session. This is the missing half: one row per ask, opened when it is made, closed only against evidence.

Ledger: ~/.cc/scope/<repo>.json  (sidecar like the board — never in git, so no merge noise).
Every owner message the capture path saw is logged to ~/.cc/scope/seen.log whether it was captured or not:
the classifier below is a filter, not an oracle, and `cc-scope missed` is how a miss is found and added.

An ask moves  open → claimed → merged → delivered → verified,  or leaves the queue as  declined.

MERGED IS NOT DELIVERED. A merge puts code on the default branch; it does not put anything on the owner's
screen. The daemon still runs the old code until it is restarted, the file is not linked until install.sh
runs, the tab does not carry the block until it is rendered. Rows were closed on "merged as PR #N" and the
owner himself found the chart was not there — so a PR number is no longer evidence of delivery, and no
sentence is. A row names its OWN verification, `check`: a shell command whose EXIT CODE decides. `deliver`
RUNS it. Exit 0 and the row is delivered, because something observable was true at that moment. Anything
else and the row stays exactly where it was.

A ROW WITH NO CHECK IS NOT DONE, IT IS UNVERIFIED. That is the honest answer and it is the point: not every
ask has a mechanical check, and where one genuinely cannot exist the row stays on the queue and says so
(`unverified`) rather than quietly counting as done. A person may still close it with `verify --evidence`,
which is them putting their own name on it — but that is a person's word, in a terminal, and it is refused
outright while the row names a check that has not passed. Nothing automated can reach `verified`.

DECLINED IS A DECISION, NOT A DROP: a session may judge that something should not be built, and that is a
legitimate answer — but it must say why, in its own words, and the reason stays in the ledger next to the ask.
`--why` is therefore required. An omission leaves an open item; a decision leaves a reason; the two can never
be mistaken for each other, which is the whole point of writing the asks down.

  cc-scope add <repo> "<ask>" [--src REF] [--track T] [--done-when "..."] [--check "<cmd>"] [--who W] [--at ISO]
  cc-scope list [<repo>] [--all] [--status S] [--track T] [--json]   unsettled asks (all repos if none named)
  cc-scope show <repo> <id>                                          one ask in full: parts, repeats, notes
  cc-scope claim <repo> <id> [--track T]                             a session/track has taken it on
  cc-scope check-cmd <repo> <id> "<command>"                         the row's own verification; exit 0 = true
  cc-scope merged <repo> <id> --evidence "<PR or commit>"            it landed. NOT delivered — still work
  cc-scope deliver <repo> <id>                                       RUNS the check; exit 0 → delivered
  cc-scope verify <repo> <id> [--evidence "…"]                       a PERSON measured it against the ask
  cc-scope unverified [<repo>]                                       landed with nothing observed; exit 1 if any
  cc-scope decline <repo> <id> --why "<why it should not be built>"  a decision, kept in the ledger
  cc-scope track|note <repo> <id> "<text>"                           link an ask to a track / add a note
  cc-scope check <repo> [--track T]                                  exit 1 while anything is unsettled
  cc-scope capture <repo> [--src REF] [--who W]                      classify a message on stdin
  cc-scope missed [<repo>] [--since HOURS]                           owner messages the classifier skipped
  cc-scope digest [<repo>] · count [<repo>] · import <repo> <file> · selfcheck
  cc-scope hook                                                      UserPromptSubmit hook (always 0; speaks only for cc-handoff --relay)

Exit, for the commands a caller acts on: 0 did it · 1 the check ran and FAILED · 2 the row names no check.
"""
import sys, os, re, json, time, fcntl, hashlib, calendar, subprocess

HOME = os.path.expanduser("~")
SCOPE = os.environ.get("CC_SCOPE_DIR", os.path.join(HOME, ".cc", "scope"))
SEEN = "seen.log"
STATES = ["open", "claimed", "merged", "delivered", "verified", "declined"]
# Off the queue. `merged` is deliberately NOT here — that is the whole fix: code on the default branch is
# still work until something observes it. Declined is settled and STAYS VISIBLE — see the header.
SETTLED = ("delivered", "verified", "declined")
DONE = ("delivered", "verified")     # it actually happened, by a check or by a person's own word
MARK = {"open": "·", "claimed": "▸", "merged": "→", "delivered": "✓", "verified": "✓", "declined": "⊘"}
EXAMPLES = "systemctl --user is-active <unit> · test bin/x -nt <the merge> · a grep of what the tab renders"
CHECK_TIMEOUT = 300  # a verification is meant to be CHEAP: one grep, one systemctl is-active, one curl
MAXTEXT = 800          # a whole essay is not an ask; the source ref is how you read the rest
SEEN_KEEP = 400        # lines of seen.log kept — enough to catch a miss the same day


def now(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
def path(repo): return os.path.join(SCOPE, repo + ".json")


class Lock:
    def __init__(self, repo):
        os.makedirs(SCOPE, exist_ok=True)
        self.f = open(os.path.join(SCOPE, repo + ".lock"), "w")
    def __enter__(self): fcntl.flock(self.f, fcntl.LOCK_EX); return self
    def __exit__(self, *a): fcntl.flock(self.f, fcntl.LOCK_UN); self.f.close()


def load(repo):
    try:
        with open(path(repo)) as f: return json.load(f)
    except (OSError, ValueError): return {"repo": repo, "asks": {}}


def save(repo, d):
    os.makedirs(SCOPE, exist_ok=True)
    d["updated"] = now()
    tmp = path(repo) + ".tmp"
    with open(tmp, "w") as f: json.dump(d, f, indent=2)
    os.replace(tmp, path(repo))


def repos():
    try: return sorted(f[:-5] for f in os.listdir(SCOPE) if f.endswith(".json"))
    except OSError: return []


# ---- what counts as an ask -------------------------------------------------------------------------
# Deterministic, no LLM: the capture path runs on every prompt and must be cheap, silent and predictable.
# It keeps DIRECTIVES — the things that outlive the reply. A plain question is answered in the reply and
# would bury the ledger, so it is logged to seen.log and not opened; `missed` is where you go looking.
ACK = re.compile(r"^\W*(thanks?|thx|ty|ok(ay)?|k|cool|nice|great|good|sure|yes|yeah|yep|no|nope|perfect|"
                 r"lgtm|got ?it|right|agreed|👍|👌|🙏|🎉|❤️)\b", re.I)
CUE_START = re.compile(r"^\W*(add|allow|always|answer|archive|ask|attach|be|break|build|cancel|change|"
                       r"check|clean|close|come|connect|cut|delete|deny|deploy|describe|disable|do|don'?t|"
                       r"drop|enable|ensure|explain|fix|fold|give|go|group|handle|have|hide|hold|install|"
                       r"keep|kill|label|leave|let|link|list|log|look|make|mark|merge|move|name|never|open|"
                       r"ping|post|prefer|print|pull|push|put|react|read|reduce|remind|remove|rename|reply|"
                       r"report|restart|review|rewrite|run|say|send|set|share|show|sort|split|start|stop|"
                       r"switch|take|tell|test|track|try|turn|update|upload|use|verify|wait|write)\b", re.I)
CUE_ANY = re.compile(r"\b(should|shouldn'?t|must|from now on|going forward|i want|i'?d like|i would like|"
                     r"can you|could you|would you|please|needs? to|has to|have to|make sure|instead of|"
                     r"stop \w+ing|no longer|(is|are|was|were|does|do)n'?t work(ing)?|not work(ing)?|i don'?t like|"
                     r"i do not like|not intuitive|rather than)\b", re.I)
SPLIT = re.compile(r"(?<=[.!?;])\s+|\n+")


def parts_of(text):
    """The directive sentences inside a message. A compound ask is where scope goes missing, so they are
    kept separately and shown by `show` — the row is the message, the parts are what it actually asked."""
    out = []
    for s in SPLIT.split(text):
        s = s.strip(" -*·\t")
        if len(s.split()) < 2 or ACK.match(s): continue
        if CUE_START.match(s) or CUE_ANY.search(s): out.append(s[:200])
    return out


def is_ask(text):
    t = text.strip()
    if not t or t.startswith(("!", "/")): return False        # a free ! command / slash command is not an ask
    if len(t.split()) < 3 and ACK.match(t): return False
    if ACK.match(t) and len(t.split()) < 6: return False       # "thanks, that looks great"
    return bool(parts_of(t))


def norm(text):
    return re.sub(r"[^a-z0-9 ]", "", re.sub(r"\s+", " ", text.lower())).strip()


def fingerprint(text): return hashlib.sha1(norm(text).encode()).hexdigest()[:12]


# ---- the ledger ------------------------------------------------------------------------------------
def add(repo, text, who="owner", src="", track="", done_when="", check="", at="", replay=False):
    """Returns (id, repeated). The same ask made twice does not open a second row — it bumps `repeats`,
    which is the signal that matters: 'asked twice, no answer yet' is a line from a real handoff. Asked
    again after it was DECLINED, it goes back on the queue (the reason stays); asked again after it was
    VERIFIED it is a new row, because that is a regression, not a repeat. `replay` (import) matches every
    status and changes nothing — re-running a seed file must be a no-op, not a second ledger."""
    text = " ".join(text.split())[:MAXTEXT]
    if not text: return None, False
    fp = fingerprint(text)
    with Lock(repo):
        d = load(repo)
        for a in d["asks"].values():
            if a["fp"] != fp: continue
            if replay: return a["id"], True
            if a["status"] in DONE and settled(a): continue
            a["repeats"] = a.get("repeats", 1) + 1
            a.setdefault("seen", []).append({"ts": at or now(), "src": src})
            if a["status"] == "declined":
                a["status"] = "open"; a["closed"] = ""
                a["notes"].append({"ts": now(), "msg": "asked again after it was declined — back on the "
                                                       "queue, with the reason it was declined kept above"})
            save(repo, d)
            return a["id"], True
        n = 1
        while "a%d" % n in d["asks"]: n += 1
        aid = "a%d" % n
        d["asks"][aid] = {"id": aid, "text": text, "parts": parts_of(text), "fp": fp, "who": who,
                          "src": src, "track": track, "done_when": done_when, "status": "open",
                          "asked": at or now(), "repeats": 1, "evidence": "", "reason": "", "closed": "",
                          "check": check.strip(), "checked": {}, "notes": []}
        save(repo, d)
        return aid, False


# ---- the verification: a command, not a sentence ---------------------------------------------------
def repo_dir(repo):
    """Where a row's check runs. The repo's own checkout if there is one, so a check can say `test -x bin/x`;
    otherwise the home directory, which is where a deployed thing actually lives."""
    p = os.path.join(HOME, "dev", repo)
    return p if os.path.isdir(p) else HOME


def has_check(a): return bool((a.get("check") or "").strip())


def passed(a): return (a.get("checked") or {}).get("rc") == 0


def settled(a):
    """Off the queue. `delivered` counts only if a check ACTUALLY PASSED. Every row this code delivers has
    one by construction — but rows written before it exists sit in `delivered` on sentences like "merged as
    PR #64 on main; deployed", which is the precise thing that is no longer evidence. Promoting those to
    settled because the word matches would close five real asks nobody ever measured, which is the failure
    this whole file is here to stop, committed by the fix for it. They go back on the queue instead."""
    if a.get("status") == "delivered":
        return passed(a)
    return a.get("status") in SETTLED


def run_check(repo, a):
    """(rc, output). The EXIT CODE is the whole answer — a check prints for the human reading the failure,
    and decides nothing by what it prints. Anything that goes wrong running it is a failure, not a pass:
    the one direction this must never err in is towards 'delivered'."""
    env = dict(os.environ)
    # A check names the box's own tools the way a person would at a prompt (`cc-limit selfcheck`), so they have to
    # BE on PATH when it runs. The landing queue's worker has a PATH without the user's bin dir, and three checks
    # in a row died there with rc=127 while the same command passed by hand (2026-09-02) — a tooling failure read
    # as "not delivered". The dir this file lives in is that bin dir, so prepend it and let a check stay readable.
    # os.defpath is the floor: passing env= makes subprocess resolve the INTERPRETER through this PATH too, so an
    # inherited PATH that is empty or broken would lose `bash` itself and every check would read as rc=127.
    env["PATH"] = os.pathsep.join([os.path.dirname(os.path.realpath(__file__)), env.get("PATH", "") or os.defpath])
    try:
        r = subprocess.run(["bash", "-c", a["check"]], cwd=repo_dir(repo), capture_output=True, text=True,
                           timeout=CHECK_TIMEOUT, stdin=subprocess.DEVNULL, env=env)
        return r.returncode, r.stdout + r.stderr
    except Exception as e:
        return 127, "%s: %s" % (e.__class__.__name__, e)


def get(repo, aid):
    a = load(repo)["asks"].get(aid)
    if not a: sys.exit("cc-scope: %s has no ask '%s'" % (repo, aid))
    return a


def edit(repo, aid, fn):
    with Lock(repo):
        d = load(repo)
        if aid not in d["asks"]: sys.exit("cc-scope: %s has no ask '%s'" % (repo, aid))
        fn(d["asks"][aid]); save(repo, d)


def select(repo, status=None, track=None, everything=False):
    """No status named = the unsettled ones: what is still owed. A declined ask is settled — it is a decision
    already taken, so it stops being work — but `--all` and `--status declined` still show it, with its reason."""
    asks = sorted(load(repo)["asks"].values(), key=lambda a: a["asked"])
    if not everything:
        asks = [a for a in asks if (a["status"] == status if status else not settled(a))]
    if track: asks = [a for a in asks if a.get("track") == track]
    return asks


def line(repo, a, many=False):
    flag = " ⚠ asked %d×" % a["repeats"] if a.get("repeats", 1) > 1 else ""
    tail = " [%s]" % a["track"] if a.get("track") else ""
    head = "%s/" % repo if many else ""
    why = "\n       ⊘ %s" % a["reason"] if a["status"] == "declined" and a.get("reason") else ""
    # A merged row is the one the ledger used to call done. It says so on the line you actually read, because
    # "has home been updated yet?" is the question this is here to answer without anyone having to go and look.
    if a["status"] == "merged":
        why = "\n       ⚠ merged, NOT delivered — %s" % ("its check has not passed: %s" % a["check"] if has_check(a)
                                                         else "it names no check, so nothing has observed it")
    elif a["status"] == "delivered" and not passed(a):
        why = "\n       ⚠ NOT delivered — closed on a sentence before a check was required, so it is back on the queue"
    return "%s %s%-4s %s%s%s%s" % (MARK.get(a["status"], "?"), head, a["id"], a["text"][:96], tail, flag, why)


# ---- capture ---------------------------------------------------------------------------------------
TAG = re.compile(r"<channel\s([^>]*)>", re.S)
ATTR = re.compile(r'(\w+)="([^"]*)"')


def strip_tag(text):
    """Slack arrives wrapped in a <channel …> tag. Returns (body, attrs) — the tag carries who is speaking
    (role=owner|member) and where, both of which decide whether this is an owner ask and how to cite it."""
    m = TAG.search(text)
    if not m: return text.strip(), {}
    attrs = dict(ATTR.findall(m.group(1)))
    body = (text[:m.start()] + text[m.end():])
    body = re.sub(r"</channel>", "", body).strip()
    return body, attrs


def log_seen(repo, decision, text, src):
    try:
        os.makedirs(SCOPE, exist_ok=True)
        p = os.path.join(SCOPE, SEEN)
        with open(p, "a") as f:
            f.write("%s\t%s\t%s\t%s\t%s\n" % (now(), repo, decision, src or "-",
                                              " ".join(text.split())[:160]))
        with open(p) as f: lines = f.readlines()
        if len(lines) > SEEN_KEEP * 2:                      # trim in batches, not on every write
            with open(p + ".tmp", "w") as f: f.writelines(lines[-SEEN_KEEP:])
            os.replace(p + ".tmp", p)
    except OSError: pass


# The Slack path: a channel message reaches the session as a user turn, so the UserPromptSubmit hook sees it
# with its <channel …> tag intact and `capture` takes the rest from there — no hook inside cc-slack. If a
# delivery ever bypasses that turn, one line in cc-slack's deliver() closes the gap and nothing else changes:
#   subprocess.run([f"{BIN}/cc-scope", "capture", repo, "--src", f"slack {chan} {thread_ts}"], input=text, text=True)
def capture(repo, text, who="owner", src=""):
    body, attrs = strip_tag(text)
    if attrs:
        if attrs.get("role") and attrs["role"] != "owner":
            log_seen(repo, "skip:not-owner", body, src); return None, False   # the ledger is the OWNER's asks
        who = attrs.get("user") or who
        if not src and attrs.get("channel"):
            src = "slack %s %s" % (attrs["channel"], attrs.get("thread_ts") or attrs.get("ts") or "")
    if not is_ask(body):
        log_seen(repo, "skip:no-directive", body, src); return None, False
    aid, repeated = add(repo, body, who=who, src=src.strip())
    log_seen(repo, "kept:%s%s" % (aid, "+" if repeated else ""), body, src)
    return aid, repeated


def repo_of(cwd):
    """A session's repo from its cwd: ~/dev/<repo> or ~/.cc/worktrees/<repo>/<track>."""
    cwd = os.path.realpath(cwd or "")
    for base, depth in ((os.path.join(HOME, "dev"), 1), (os.path.join(HOME, ".cc", "worktrees"), 1)):
        base = os.path.realpath(base)
        if cwd == base or cwd.startswith(base + os.sep):
            rest = cwd[len(base):].strip(os.sep).split(os.sep)
            if rest and rest[0]: return rest[0]
    return ""


def worker_cwd(cwd):
    """A track worktree (marker .cc/track) is a WORKER: its prompts are the task it was dispatched with,
    not asks the owner made. Same marker cc-guard walks, for the same reason — the marker is the truth."""
    d = os.path.realpath(cwd or "")
    while d and d != "/":
        if os.path.exists(os.path.join(d, ".cc", "track")): return True
        d = os.path.dirname(d)
    return False


# ---- what is not a person asking ------------------------------------------------------------------
# Everything below reached UserPromptSubmit as a user turn and opened a row somebody then had to decline by
# hand (a28, a29, a54, a60, a61, a63 on 2026-08-31). The ledger is the authority on what the OWNER asked
# for, so a wrong row costs more than a missed one. Matched on the start of the prompt — every one of these
# wrappers leads — and NOT written to seen.log: that file is 400 lines of owner messages the classifier may
# have got wrong, and one night of task-notifications is enough to flush a real miss out of it.
NOT_A_PERSON = (
    "<task-notification",           # the harness reporting a background task or subagent finished
    "<cross-session-message",       # a peer session writing into this one over its socket
    "[SYSTEM NOTIFICATION",         # the harness in its own voice: limits, restarts, context
    "[Cross-session idle notice]",  # the idle sweep saying another session went quiet
    "<command-name",                # a slash command the session ran — the invocation, not an ask
    "<local-command-stdout",        # ...and its output, handed back as the next turn
    "[cc-handoff]",                 # a prompt cc-handoff typed into a session: it tags every one (its MACHINE)
)


def not_a_person(text, attrs):
    """True when this prompt was written by a machine. `attrs` is the <channel …> tag if there was one:
    a Slack message is an owner ask only when a real owner really typed it in a real channel. `inject` is a
    local, unauthenticated door any process on the box may use and it stamps role="owner" chat_id="local",
    which is how the board watchdog's own line became an owner ask (a54)."""
    if text.lstrip().startswith(NOT_A_PERSON): return True
    if attrs:
        if attrs.get("role") != "owner": return True                        # member, bot, anything but him
        if attrs.get("chat_id") == "local" or attrs.get("channel") == "local": return True   # injected here
        if attrs.get("source", "cc-slack") != "cc-slack": return True       # absent = the ordinary Slack path
    return False


def relayed(payload):
    """`cc-handoff --relay`, with the hook's own payload: it answers with a block decision (JSON on stdout) when
    this session is the RETIRING side of a handoff and the prompt went to its successor, and with nothing
    otherwise. Its stdout is handed back as ours; any failure is no decision — the hook must never break a session."""
    try:
        r = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-handoff"), "--relay"],
                           input=json.dumps(payload), capture_output=True, text=True, timeout=20)
        if r.returncode == 0 and r.stdout.strip():
            sys.stdout.write(r.stdout); sys.stdout.flush()
            return True
    except Exception: pass
    return False


def hook():
    """UserPromptSubmit. Prints NOTHING of its own (stdout would land in the session's context) and always exits
    0: a ledger that can break a session is worse than no ledger. The one thing it passes through is cc-handoff's
    --relay decision — a prompt typed into a retiring session goes to its successor and is blocked here."""
    try:
        payload = json.load(sys.stdin)
        text = payload.get("prompt") or ""
        cwd = payload.get("cwd") or os.getcwd()
        if not text.strip(): return
        if relayed(payload): return                          # the successor's ask now, not this session's
        _, attrs = strip_tag(text)
        if not_a_person(text, attrs): return                 # machine chatter, not an ask — see NOT_A_PERSON
        if not attrs:                                        # no channel tag: a prompt typed into the session
            if os.environ.get("CC_ROLE") in ("worker", "member") or worker_cwd(cwd): return
        repo = repo_of(cwd) or os.environ.get("CC_REPO") or "box"
        src = "slack" if attrs else "terminal %s" % (payload.get("session_id") or "")[:8]
        capture(repo, text, src="" if attrs else src)
    except Exception: pass


# ---- commands --------------------------------------------------------------------------------------
def opt(args, name, default=""):
    if name in args:
        i = args.index(name)
        v = args[i + 1] if len(args) > i + 1 else ""
        del args[i:i + 2]
        return v
    return default


def flag(args, name):
    if name in args: args.remove(name); return True
    return False


def main(argv):
    if not argv or argv[0] in ("-h", "--help"): sys.exit(__doc__)
    cmd, args = argv[0], list(argv[1:])
    js = flag(args, "--json")

    if cmd == "add":
        repo, text = args[0], args[1]
        aid, rep = add(repo, text, who=opt(args, "--who", "owner"), src=opt(args, "--src"),
                       track=opt(args, "--track"), done_when=opt(args, "--done-when"),
                       check=opt(args, "--check"), at=opt(args, "--at"))
        print("%s %s%s" % (repo, aid, " (asked again)" if rep else ""))

    elif cmd == "capture":
        repo = args[0]
        aid, rep = capture(repo, sys.stdin.read(), who=opt(args, "--who", "owner"), src=opt(args, "--src"))
        print("%s %s" % (repo, aid + (" (asked again)" if rep else "")) if aid else "not an ask (logged)")

    elif cmd == "list":
        status, track, everything = opt(args, "--status") or None, opt(args, "--track") or None, flag(args, "--all")
        rs = [args[0]] if args else repos()
        rows = [(r, a) for r in rs for a in select(r, status, track, everything)]
        if js: print(json.dumps([a for _, a in rows], indent=2)); return
        if not rows: print("no asks" if everything else "nothing %s" % (status or "unsettled")); return
        for r, a in rows: print(line(r, a, many=len(rs) > 1))

    elif cmd == "show":
        a = get(args[0], args[1])
        print("%s %s [%s]%s" % (args[0], a["id"], a["status"],
                                "  ⚠ asked %d×" % a["repeats"] if a.get("repeats", 1) > 1 else ""))
        print("  asked   %s by %s%s" % (a["asked"], a["who"], "  (%s)" % a["src"] if a["src"] else ""))
        if a.get("track"):     print("  track   %s" % a["track"])
        if a.get("done_when"): print("  done when %s" % a["done_when"])
        if a.get("reason"):    print("  declined because %s" % a["reason"])
        print("  %s" % a["text"])
        for p in a.get("parts", []): print("    – %s" % p)
        for s in a.get("seen", []): print("  again   %s %s" % (s["ts"], s.get("src", "") or "-"))
        if a["evidence"]: print("  evidence %s%s" % (a["evidence"], "  (%s)" % a["closed"] if a["closed"] else ""))
        for n in a["notes"]: print("  note    %s %s" % (n["ts"], n["msg"]))

    elif cmd == "check-cmd":
        repo, aid, c = args[0], args[1], args[2].strip()
        if not c: sys.exit("cc-scope: check-cmd needs a command — one that exits 0 only when the ask is TRUE")
        edit(repo, aid, lambda a: a.update(check=c, checked={}))
        print("%s %s check: %s" % (repo, aid, c))

    elif cmd == "deliver":
        # THE HOLE THIS CLOSES: this used to take `--evidence "merged as PR #N"` and believe it. It now runs
        # the row's own check and believes only the exit code. There is no argument that can talk it round.
        repo, aid = args[0], args[1]
        track, ev = opt(args, "--track"), opt(args, "--evidence")
        a = get(repo, aid)
        if track: edit(repo, aid, lambda x: x.update(track=track))
        if not has_check(a):
            print("cc-scope: %s %s names no check — UNVERIFIED. It stays '%s' and it stays on the queue: a merge\n"
                  "  is not delivery, and nothing here has observed this reach anyone. Give it one —\n"
                  "    cc-scope check-cmd %s %s '<command that exits 0 only when the ask is true>'\n"
                  "  (%s)\n"
                  "  or, if no mechanical check can exist, put your own name on it and say what you looked at:\n"
                  "    cc-scope verify %s %s --evidence \"...\"" % (repo, aid, a["status"], repo, aid, EXAMPLES,
                                                                   repo, aid),
                  file=sys.stderr)
            return 2
        rc, o = run_check(repo, a)
        tail = " ".join((o or "").split())[-300:]
        def upd(x):
            x["checked"] = {"ts": now(), "cmd": x["check"], "rc": rc, "out": tail}
            if rc == 0:
                x["status"], x["closed"] = "delivered", now()
                x["evidence"] = ((ev + " \u00b7 ") if ev else "") + "check passed: " + x["check"]
            else:
                x["notes"].append({"ts": now(), "msg": "check FAILED (rc %d) %s \u2014 %s" % (rc, x["check"], tail[:160])})
        edit(repo, aid, upd)
        if rc:
            print("cc-scope: %s %s is NOT delivered — its check failed (rc %d), so it stays '%s' and stays open.\n"
                  "  %s\n  %s" % (repo, aid, rc, a["status"], a["check"], tail[:200] or "(no output)"),
                  file=sys.stderr)
            return 1
        print("%s %s delivered — its check passed: %s" % (repo, aid, a["check"]))

    elif cmd in ("claim", "merged", "verify", "declined", "decline", "done", "drop"):
        state = {"claim": "claimed", "merged": "merged", "verify": "verified", "done": "verified",
                 "decline": "declined", "declined": "declined", "drop": "declined"}[cmd]
        repo, aid = args[0], args[1]
        track, ev, why = opt(args, "--track"), opt(args, "--evidence"), opt(args, "--why")
        a = load(repo)["asks"].get(aid, {})
        if state == "merged":
            if not ev:
                sys.exit("cc-scope: merged needs --evidence — the PR or commit that landed")
            if a.get("status") in DONE:   # a re-run must never drag a delivered row backwards
                print("%s %s is already %s — a re-merge does not undo it" % (repo, aid, a["status"])); return 0
        if state == "verified":
            # A person may close what no machine can measure. They may NOT overrule a check they themselves wrote:
            # a red check with a confident sentence beside it is the pair that closed two rows the owner then reopened.
            if has_check(a) and not passed(a):
                sys.exit("cc-scope: %s names a check and it has not passed — the ledger runs the check, it does "
                         "not take a sentence for it.\n  %s\nRun it (`cc-scope deliver %s %s`), or replace it "
                         "with one that can pass (`cc-scope check-cmd %s %s ...`)."
                         % (aid, a["check"], repo, aid, repo, aid))
            if not (ev or a.get("evidence")):
                sys.exit("cc-scope: verify needs --evidence — name what YOU looked at, in your own words. This is "
                         "the by-hand path for an ask no command can measure, so a PR number is not an answer.")
        if state == "declined" and not why:   # the reason IS the decision: without one this is a drop, and a drop
            sys.exit("cc-scope: decline needs --why — a decline without a reason is the drop this ledger exists "
                     "to catch. Say, in your own words, why it should not be built.")
        def upd(a):
            a["status"] = state
            if track: a["track"] = track
            if ev: a["evidence"] = ev
            if why: a["reason"] = why
            a["closed"] = now() if state in SETTLED else ""
        edit(repo, aid, upd)
        print("%s %s %s%s" % (repo, aid, state,
              " — NOT delivered: nothing has observed this yet" if state == "merged" else ""))

    elif cmd == "unverified":
        # The honest column. Every row the box has said landed, where no check has ever gone green: the merged
        # ones still owed, and the ones a person closed on their own word. Both are real; neither was measured.
        rs = [args[0]] if args else repos()
        rows = [(r, a) for r in rs for a in select(r, None, opt(args, "--track") or None, everything=True)
                if a["status"] in ("merged", "delivered", "verified") and not passed(a)]
        if js: print(json.dumps([a for _, a in rows], indent=2)); return 1 if rows else 0
        if not rows:
            print("cc-scope: nothing unverified — everything the box says landed was checked, and it passed")
            return 0
        print("cc-scope: %d ask(s) the box says landed with nothing observed at the other end:" % len(rows))
        for r, a in rows:
            if a["status"] == "merged":
                why = ("STILL OPEN, names no check — cc-scope check-cmd %s %s '<cmd>'" % (r, a["id"])
                       if not has_check(a) else "STILL OPEN, its check has not passed: %s" % a["check"])
            elif a["status"] == "delivered":   # written before a check was required — a sentence, not a measurement
                why = "STILL OPEN, closed on a sentence: %s" % (a.get("evidence") or "no evidence")
            else:   # verified: a person's own word, which is allowed and is not the same as measured
                why = "closed by hand, never measured: %s" % (a.get("evidence") or "no evidence")
            print("  %-4s %s%s" % (a["id"], "%s/" % r if len(rs) > 1 else "", a["text"][:88]))
            print("       %s" % why)
        return 1

    elif cmd == "track":
        edit(args[0], args[1], lambda a: a.update(track=args[2])); print("%s %s → %s" % tuple(args[:3]))

    elif cmd == "note":
        edit(args[0], args[1], lambda a: a["notes"].append({"ts": now(), "msg": args[2]}))
        print("%s %s noted" % (args[0], args[1]))

    elif cmd == "check":          # 'done' measured against the asks: exit 1 while anything is still open
        repo = args[0]; track = opt(args, "--track") or None
        open_ = select(repo, None, track)
        where = " for %s" % track if track else ""
        if not open_: print("cc-scope: nothing unsettled%s" % where); return 0
        m = sum(1 for a in open_ if a["status"] == "merged")
        print("cc-scope: %d unsettled ask(s)%s%s. Each one is delivered by its OWN check passing "
              "(`cc-scope check-cmd %s <id> \"<cmd>\"` then `cc-scope deliver %s <id>`), or closed by hand when "
              "no command can measure it (`cc-scope verify %s <id> --evidence \"what you looked at\"`), or "
              "declined with a reason (`cc-scope decline %s <id> --why \"…\"`). A PR number is not any of "
              "those — leaving it is the one thing that is not a decision:"
              % (len(open_), where, " — %d of them merged but NOT delivered" % m if m else "",
                 repo, repo, repo, repo))
        for a in open_: print("  " + line(repo, a))
        return 1

    elif cmd in ("count", "digest"):
        rs = [args[0]] if args else repos()
        n = sum(len(select(r)) for r in rs)
        again = sum(1 for r in rs for a in select(r) if a.get("repeats", 1) > 1)
        if cmd == "count": print(n); return
        # "merged but not delivered" is its own number because it is the owner's own question — he asked
        # "has it landed yet / what is not done yet" three times, and a single open count could not answer it.
        m = sum(1 for r in rs for a in select(r) if a["status"] == "merged")
        why = ", ".join(filter(None, ["%d merged but not delivered" % m if m else "",
                                      "%d asked more than once" % again if again else ""]))
        if n: print("• 📋 %d ask%s of yours still open%s" % (n, "" if n == 1 else "s",
                                                            " (%s)" % why if why else ""))

    elif cmd == "missed":
        since = float(opt(args, "--since", "24")) * 3600
        repo = args[0] if args else None
        cut = time.time() - since
        try: rows = open(os.path.join(SCOPE, SEEN)).read().splitlines()
        except OSError: rows = []
        out = []
        for r in rows:
            f = r.split("\t")
            if len(f) < 5 or not f[2].startswith("skip"): continue
            if repo and f[1] != repo: continue
            try:
                if calendar.timegm(time.strptime(f[0], "%Y-%m-%dT%H:%M:%SZ")) < cut: continue
            except ValueError: continue
            out.append("  %s %s  %s" % (f[0], f[1], f[4]))
        print("owner messages the classifier did not open an ask for (last %gh):" % (since / 3600) if out
              else "nothing skipped in the last %gh" % (since / 3600))
        for o in out[-40:]: print(o)

    elif cmd == "import":         # seed/replay: <at>TAB<src>TAB<track>TAB<status>TAB<evidence>TAB<text>
        repo, f = args[0], args[1]
        n = new = 0
        for raw in open(f):
            raw = raw.rstrip("\n")
            if not raw.strip() or raw.lstrip().startswith("#"): continue
            c = raw.split("\t")
            if len(c) < 6: sys.exit("cc-scope import: 6 tab-separated columns expected, got %d: %s" % (len(c), raw[:60]))
            at, src, track, status, ev, text = [x.strip() for x in c[:6]]
            aid, rep = add(repo, text, src=src, track=track, at=at, replay=True)
            n += 1; new += 0 if rep else 1
            if status and status != "open":
                if status not in STATES: sys.exit("cc-scope import: '%s' is not one of %s" % (status, "/".join(STATES)))
                edit(repo, aid, lambda a, s=status, e=ev: a.update(   # no `closed` on a backfill: when it was
                    status=s, **({"reason": e} if s == "declined" else {"evidence": e})))   # settled is not recorded
        print("cc-scope: imported %d ask(s) into %s (%d new)" % (n, repo, new))

    elif cmd == "hook":
        hook()

    elif cmd == "selfcheck":
        return selfcheck()

    else:
        sys.exit(__doc__)
    return 0


# ---- selfcheck -------------------------------------------------------------------------------------
def selfcheck():
    global SCOPE
    import tempfile, shutil
    SCOPE = tempfile.mkdtemp(prefix="cc-scope-selfcheck-")
    p = f = 0
    def ok(n): nonlocal p; p += 1; print("  ✓ %s" % n)
    def bad(n): nonlocal f; f += 1; print("  ✗ %s" % n)
    def t(n, cond): ok(n) if cond else bad(n)
    try:
        R = "_scopetest"
        t("an imperative is an ask", is_ask("add a scope ledger to the digest"))
        t("a standing rule is an ask", is_ask("from now on lead with the TLDR"))
        t("a complaint that names the fix is an ask", is_ask("the thread marks aren't working reliably, make them stick"))
        t("a bare thanks is not an ask", not is_ask("thanks!"))
        t("an ack with a few words is not an ask", not is_ask("ok cool, thanks a lot"))
        t("a ! command is not an ask", not is_ask("!status"))
        # A check runs with this file's own bin dir on PATH, so a row may name a sibling tool plainly (review of
        # the rc=127 landings, 2026-09-02): scrub PATH entirely and a bare sibling name still resolves.
        _sib = os.path.basename(os.path.realpath(__file__))
        _keep = os.environ.get("PATH", "")
        try:
            os.environ["PATH"] = ""
            t("a check finds this file's siblings on PATH even when PATH is empty",
              run_check(R, {"check": "command -v %s >/dev/null" % _sib})[0] == 0)
            t("and a name that is not a sibling still fails, so PATH is prepended and not replaced",
              run_check(R, {"check": "command -v definitely-not-a-tool-xyz >/dev/null"})[0] != 0)
        finally:
            os.environ["PATH"] = _keep
        t("a plain question is not opened as an ask", not is_ask("how full is the context?"))
        t("a compound ask keeps both parts",
          len(parts_of("react with :ok_hand: in #approvals. this should also remove it from the board.")) == 2)

        a1, rep = add(R, "make the digest show open asks", src="slack #demo 1788")
        t("add opens an ask", a1 == "a1" and not rep)
        a2, rep = add(R, "Make the digest   show open ASKS!", src="slack #demo 1799")
        t("the same ask twice is one row with repeats=2", a2 == a1 and rep and get(R, a1)["repeats"] == 2)
        t("check exits 1 while an ask is unsettled", quiet(["check", R]) == 1)
        quiet(["claim", R, a1, "--track", "digest"])
        t("a claimed ask is still work", get(R, a1)["status"] == "claimed" and quiet(["check", R]) == 1)

        # ---- MERGED IS NOT DELIVERED -------------------------------------------------------------------
        # The failure this whole section exists for: rows were closed on "merged as PR #N" while the daemon
        # still ran the old code, and the owner was the one who found out. A merge is now its own state, it
        # is not settled, and the only thing that moves a row past it is a command exiting 0.
        try:
            quiet(["merged", R, a1]); bad("merged without evidence is refused")
        except SystemExit as e: t("merged without evidence is refused", "evidence" in str(e))
        quiet(["merged", R, a1, "--evidence", "PR #64"])
        t("a MERGED ask is still work — a PR number is not delivery",
          get(R, a1)["status"] == "merged" and quiet(["check", R]) == 1)
        t("the line you read says so, in as many words",
          "NOT delivered" in run_capture(["list", R]) and "names no check" in run_capture(["list", R]))
        t("a merged ask with no check is listed as unverified and stays open",
          quiet(["unverified", R]) == 1 and "names no check" in run_capture(["unverified", R])
          and get(R, a1)["status"] == "merged")

        # a row with NO check cannot be delivered at all: exit 2, and it does not move
        t("deliver on a row that names no check is refused (exit 2) and the row does not move",
          quiet(["deliver", R, a1]) == 2 and get(R, a1)["status"] == "merged")

        # a check that FAILS cannot reach delivered, however many times it is run
        quiet(["check-cmd", R, a1, "exit 3"])
        t("a row whose check fails is NOT delivered and stays exactly where it was",
          quiet(["deliver", R, a1]) == 1 and get(R, a1)["status"] == "merged"
          and get(R, a1)["checked"]["rc"] == 3)
        t("the failure is written next to the ask, not swallowed",
          any("check FAILED" in n["msg"] for n in get(R, a1)["notes"]))
        try:
            quiet(["verify", R, a1, "--evidence", "I looked and it is fine, honestly"])
            bad("a red check cannot be talked round with a sentence")
        except SystemExit as e:
            t("a red check cannot be talked round with a sentence", "has not passed" in str(e))
        t("...and the row is still not settled", get(R, a1)["status"] == "merged" and quiet(["check", R]) == 1)

        # and a check that PASSES is what delivery means
        quiet(["check-cmd", R, a1, "true"])
        t("a check that passes is what makes a row delivered",
          quiet(["deliver", R, a1]) == 0 and get(R, a1)["status"] == "delivered")
        t("the evidence is the check itself, not a sentence about it",
          "check passed: true" in get(R, a1)["evidence"])
        t("a delivered ask is settled: it stops being work", quiet(["check", R]) == 0)
        t("a delivered ask is not unverified", quiet(["unverified", R]) == 0)
        t("re-running deliver is a no-op — same state, still delivered",
          quiet(["deliver", R, a1]) == 0 and get(R, a1)["status"] == "delivered")
        t("re-marking it merged does not drag a delivered row backwards",
          quiet(["merged", R, a1, "--evidence", "PR #64 again"]) == 0 and get(R, a1)["status"] == "delivered")

        # the by-hand path, for the ask no command can measure — it is a PERSON's word and it is marked as one
        a2b, _ = add(R, "make the tone of the updates warmer")
        t("an ask with no possible check still cannot be delivered", quiet(["deliver", R, a2b]) == 2)
        quiet(["verify", R, a2b, "--evidence", "read the last six updates in the channel myself"])
        t("a person may close what no command can measure", get(R, a2b)["status"] == "verified")
        t("...and it is still counted as never measured",
          quiet(["unverified", R]) == 1 and "closed by hand" in run_capture(["unverified", R]))

        # A row written before any of this existed sits in `delivered` on a sentence. Reading it as settled
        # now — same word, new meaning — would close it without anything ever having been measured, which is
        # this bug wearing the fix's clothes. It goes back on the queue.
        with Lock(R):
            d = load(R); d["asks"][a1] = dict(d["asks"][a1], status="delivered", checked={},
                                              evidence="merged as PR #64 on main; deployed"); save(R, d)
        t("a row closed on a sentence before checks existed is NOT settled by the word 'delivered'",
          quiet(["check", R]) == 1 and a1 in run_capture(["list", R]))
        t("it says why, on the line you read", "back on the queue" in run_capture(["list", R]))
        t("and it is reported unverified, with the sentence it was closed on",
          quiet(["unverified", R]) == 1 and "closed on a sentence" in run_capture(["unverified", R]))
        quiet(["check-cmd", R, a1, "true"]); quiet(["deliver", R, a1])
        t("giving it a check that passes is what settles it", quiet(["check", R]) == 0)

        a3, _ = add(R, "rewrite the whole box in rust")
        try:
            quiet(["verify", R, a3]); bad("verify without any evidence is refused")
        except SystemExit as e: t("verify without any evidence is refused", "evidence" in str(e))

        # A decline is a DECISION: it needs a reason, it leaves the queue, and it stays in the ledger.
        try:
            quiet(["decline", R, a3]); bad("decline without a reason is refused")
        except SystemExit as e: t("decline without a reason is refused", "why" in str(e))
        quiet(["decline", R, a3, "--why", "no reader would gain anything and the box would be down for a week"])
        t("a declined ask stops counting as work", quiet(["check", R]) == 0)
        t("a declined ask stays in the ledger with its reason",
          get(R, a3)["status"] == "declined" and "down for a week" in get(R, a3)["reason"])
        t("the reason is on the line you actually read",
          "down for a week" in run_capture(["list", R, "--status", "declined"]))
        t("a declined ask is not hidden by --all", a3 in run_capture(["list", R, "--all"]))

        t("a replay matches any status and changes nothing",
          add(R, "make the digest show open asks", replay=True) == (a1, True) and get(R, a1)["repeats"] == 2)
        t("a check is carried on the row from the moment it is opened",
          get(R, add(R, "keep the tmux server up", check="test -d /")[0])["check"] == "test -d /")
        quiet(["decline", R, a3, "--why", "still no"]) if get(R, a3)["status"] != "declined" else None
        a4, rep4 = add(R, "rewrite the whole box in rust")
        t("asked again after a decline, it is back on the queue with the reason kept",
          a4 == a3 and rep4 and get(R, a3)["status"] == "open" and "down for a week" in get(R, a3)["reason"])
        quiet(["decline", R, a3, "--why", "same answer as before"])
        a5, rep5 = add(R, "make the digest show open asks")
        t("asked again after it was delivered, it is a NEW row — that is a regression, not a repeat",
          a5 != a1 and not rep5)
        quiet(["decline", R, a5, "--why", "fixture"])

        add(R, "always run the gates before a PR", track="gates")
        t("check --track only measures that track's asks", quiet(["check", R, "--track", "nope"]) == 0)
        t("check --track sees its own", quiet(["check", R, "--track", "gates"]) == 1)

        aid, _ = capture(R, '<channel source="cc-slack" chat_id="C1" thread_ts="17.1" ts="17.2" '
                            'user="ada.byron" role="owner" channel="#demo">\nplease put the open asks on Home',
                         src="")
        t("an owner Slack message is captured with its thread as the source",
          aid and get(R, aid)["src"].startswith("slack #demo 17.1"))
        t("a member's message is not an owner ask",
          capture(R, '<channel source="cc-slack" role="member" channel="#help" user="sam">fix the printer')[0] is None)
        t("a skipped message is still logged, so a miss can be found",
          "skip:not-owner" in open(os.path.join(SCOPE, SEEN)).read())

        t("the hook is silent on a worker's own task prompt", capture_worker_silent())

        # ---- ONLY A PERSON OPENS A ROW ----------------------------------------------------------------
        # One case per shape in NOT_A_PERSON. `would_have` is the half that matters: each fixture carries a
        # real directive, so before the skip list every one of these opened a row that was declined by hand.
        def would_have(x): return is_ask(strip_tag(x)[0])
        def skipped(x): return would_have(x) and hook_asks(x) == 0
        t("a harness task-notification is not an ask",
          skipped("<task-notification>\n<task-id>b9j3x</task-id>\n"
                  "<summary>the digest is not working, you must restart it</summary>\n</task-notification>"))
        t("a peer session's cross-session-message is not an ask",
          skipped('<cross-session-message from="uds:/run/user/1000/cc-socks/505378.sock" from-name="dev-2b">'
                  "\nplease add the failing track to the board."))
        t("a SYSTEM NOTIFICATION is not an ask",
          skipped("[SYSTEM NOTIFICATION] the session is near its context limit and must be restarted before the next task"))
        t("a cross-session idle notice is not an ask",
          skipped('[Cross-session idle notice] "demo-01" is idle now; you should check what it left behind'))
        t("a slash-command block is not an ask",
          skipped("<command-name>/gates</command-name>\n<command-args>please run the gates and open the PR</command-args>"))
        t("a local command's own stdout is not an ask",
          skipped("<local-command-stdout>from now on the gates must be green before a PR</local-command-stdout>"))
        t("the board watchdog talking to itself through inject is not an owner ask",
          skipped('<channel source="cc-slack" chat_id="local" thread_ts="" ts="1788229590.5" user="local" '
                  'role="owner" channel="local" target="demo">board watchdog: demo/worker-sandbox — '
                  "it is waiting on you; ccbox refuses demo by design and runs claude with no "
                  "cc-guard inside. (set to waiting)"))
        t("a non-owner Slack message is not an ask, through the hook too",
          skipped('<channel source="cc-slack" chat_id="C9" ts="18.1" user="sam" role="member" '
                  'channel="#help">please fix the printer'))
        # cc-handoff types a prompt into a session at both ends of a handoff — the successor's opening prompt
        # and the retiring session's stop message — and each opened a row that session then declined by hand
        # (a121, a126, a131; a132). It leads every prompt it types with `[cc-handoff]` (its MACHINE), so what
        # is matched here is the tag: the first two fixtures are shaped like today's prompts, the third is a
        # sentence this file has never seen, and all three are skipped the same way.
        t("the prompt that starts a successor session is not an owner ask",
          skipped("[cc-handoff] 9f2c1a7b04d3: you are the SUCCESSOR for myrepo/x — your brief is in your "
                  "system prompt. Start now: run `cc-handoff --brief myrepo/x` first, and ask the "
                  "predecessor what the packet did not answer."))
        t("the stop message the retiring session gets is not either",
          skipped("[cc-handoff] Handoff complete: your successor is live and owns this target now. Append "
                  "your final entry to the journal — what is done, what is next, gotchas — and stop. You "
                  "are no longer the live session: anything typed here is relayed to your successor."))
        t("...nor is a prompt cc-handoff types later, in wording this file has never been taught",
          skipped("[cc-handoff] your predecessor left the branch unpushed. Push it before you journal."))
        # ...and the three things the filter must never eat.
        t("an owner ask that merely starts with the word cc-handoff still records",
          hook_asks("cc-handoff leaves the old window alive after a retire — please fix that before the "
                    "next one") == 1)
        t("an owner prompt typed in the terminal still records",
          hook_asks("add the skip list to the ask-capture hook") == 1)
        t("an owner Slack message still records",
          hook_asks('<channel source="cc-slack" chat_id="C1" thread_ts="17.1" ts="17.2" user="ada.byron" '
                    'role="owner" channel="#demo">put the open asks on Home, please') == 1)
        # ---- THE RETIRING SIDE OF A HANDOFF: cc-handoff --relay decides (payload over stdin), the hook hands it back
        retired = {"id": "fixture", "target": "_hooktest", "live": "successor", "phase": "retired",
                   "predecessor": {"session_id": "sid-retired", "tmux": "", "window": "_hooktest~old"},
                   "successor": {"session_id": "sid-live", "tmux": "", "window": "_hooktest"}}
        n, out = hook_run("please add the relay case to the hook", sid="sid-retired", record=retired)
        t("a prompt into a RETIRED session comes back blocked with the pointer, and opens no row",
          n == 0 and '"block"' in out and "use window _hooktest" in out)
        t("...and from any other session the same prompt is neither blocked nor lost",
          hook_run("please add the relay case to the hook", record=retired) == (1, ""))
        n = int(run_capture(["count", R]))
        t("count is the number of unsettled asks", n == len(select(R)))
        t("digest says nothing when nothing is open", run_capture(["digest", "_empty"]).strip() == "")
    finally:
        shutil.rmtree(SCOPE, ignore_errors=True)
    print("== cc-scope selfcheck: %d passed, %d failed ==" % (p, f))
    return 1 if f else 0


def quiet(argv):
    """main() with its output swallowed — the selfcheck asserts on exit codes, not on the printed report.
    stderr too: the refusals below are meant to be long and explain themselves, and a passing suite should
    not scroll a page of advice for a case that behaved exactly as it was asserted to."""
    import io, contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf): return main(argv) or 0


def run_capture(argv):
    import io, contextlib
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf): main(argv)
    return buf.getvalue()


def hook_asks(text):
    return hook_run(text)[0]


def hook_run(text, sid="selfcheck", record=None):
    """Run the UserPromptSubmit hook over one prompt: (rows the ledger gained, what it printed). The hook's
    other two guards are neutralised: the selfcheck usually runs inside a worker's worktree, which would
    pass every skip case for entirely the wrong reason and fail the two that must still record. Hermetic:
    `cc-handoff --relay` reads CC_HANDOFF_DIR, and here that is the temp dir — `record` (a handoff record) or
    nothing — never the box's own."""
    import tempfile, shutil, io, contextlib
    d = tempfile.mkdtemp(prefix="cc-scope-hooktest-")       # under /tmp: no .cc/track marker, no repo name
    keep, old = {k: os.environ.get(k) for k in ("CC_ROLE", "CC_REPO", "CC_HANDOFF_DIR")}, sys.stdin
    os.environ.pop("CC_ROLE", None); os.environ["CC_REPO"] = "_hooktest"; os.environ["CC_HANDOFF_DIR"] = d
    if record: json.dump(record, open(os.path.join(d, "fixture.json"), "w"))
    try:
        before = len(load("_hooktest")["asks"])
        sys.stdin = io.StringIO(json.dumps({"prompt": text, "cwd": d, "session_id": sid}))
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf): hook()
        return len(load("_hooktest")["asks"]) - before, buf.getvalue()
    finally:
        sys.stdin = old
        for k, v in keep.items(): os.environ.pop(k, None) if v is None else os.environ.update({k: v})
        shutil.rmtree(d, ignore_errors=True)


def capture_worker_silent():
    """The hook must ignore a track worktree — cc dispatches workers by writing their task into the prompt."""
    import tempfile, shutil, io, contextlib
    d = tempfile.mkdtemp()
    try:
        os.makedirs(os.path.join(d, ".cc")); open(os.path.join(d, ".cc", "track"), "w").write("r\nt\n")
        payload = json.dumps({"prompt": "build the ledger and open a PR", "cwd": d, "session_id": "x"})
        old = sys.stdin; sys.stdin = io.StringIO(payload)
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf): hook()
        sys.stdin = old
        return buf.getvalue() == "" and not os.path.exists(path(repo_of(d) or "box"))
    finally:
        shutil.rmtree(d, ignore_errors=True)


if __name__ == "__main__":
    try: sys.exit(main(sys.argv[1:]) or 0)
    except IndexError: sys.exit(__doc__)
    except BrokenPipeError: sys.exit(0)
