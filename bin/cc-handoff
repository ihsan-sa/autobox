#!/usr/bin/env python3
"""cc-handoff — overlapping handoff: the successor starts ALONGSIDE its predecessor, reads the journal, asks
what the journal missed, and only then retires it. Nothing has to be idle for a session to start, so there is
nothing to defer on — which is what dissolves the "handoff PENDING, deferred again" loop.

  cc-handoff --overlap <target> [--pct N] [--session ID] [--in-flight "…"]   start a successor alongside
  cc-handoff --ready [<target>] [--forced]                run BY THE SUCCESSOR: preflight, commit, retire
  cc-handoff --replace <target> [--over [PCT]]            the OLD path: journal, exit, restart on fresh context
  cc-handoff --abandon <target> [--why "…"]               give up: successor's window goes, record clears
  cc-handoff --due <target> [--over-ceiling]              the deadline: below the ceiling abandon, at/over force
  cc-handoff --event <target> [--level L] [--pct N] [--session ID] [--in-flight "…"] [--live] [--taken]
                                    a context line was crossed (cc-context): decide and take the phase, print it
  cc-handoff --sweep                records no session is left to finish (run from the cc-reconcile timer)
  cc-handoff --retire <target>                            internal: END the predecessor, rename, clear
  cc-handoff --status [<target>] [--json]                 what phase, who is live, how long left
  cc-handoff selfcheck

ONE OWNER (2026-08-31, review rec #8). The handoff path used to be three files: `cc` held the stop-then-restart
sequence, `cc-context` decided which phase to take, and this file held the overlap. That split is what let a
survivor's un-gate depend on a marker nobody swept. Now `cc-context` MEASURES and emits one --event; every phase
decision, both paths and the sweep live here. `cc handoff <repo> <track>` delegates to --replace, and the overlap
still fails INTO it.

TARGET is `<repo>` (a planning session) or `<repo>/<track>` — the same address the Slack layer routes on, and
also the tmux window name in session `main`. The successor's window is `<target>~next` until cutover.

THE INVARIANT. One record file, ~/.cc/state/handoff/<target>.json, names the LIVE session. The live one owns
the channel and may act on the world; the other is muted and gated (cc-guard reads the same record). Cutover
is ONE atomic os.replace() of that record — the single commit point — and everything after it is derived,
idempotent and retried, never rolled back. Ownership only ever moves forward, on an explicit successful act,
so every failure lands on "the predecessor is still in charge": a missing, corrupt or unreadable record means
the predecessor keeps the channel and the successor stays gated.

BOUNDED. deadline = started + CC_HANDOFF_OVERLAP_MAX (default 45 min, ~/.cc/config). The watchdog is the
predecessor's own Stop hook, which already runs every turn — no new timer, no new daemon. At the deadline the
context ceiling decides: below it, abandon and tell the owner once; at or over it, force the cutover, or fall
back to today's stop-then-restart `cc handoff`. The new path fails INTO the old one and cannot take it down.

NOTHING IS LEFT TO A SESSION THAT MAY BE GONE. Every phase above is driven by a session's own Stop hook, which
is exactly what a crashed one no longer has — so --sweep, on the EXISTING cc-reconcile timer, finishes what no
session can: a record whose predecessor is gone past the grace is finalized (the marker cc-guard reads, then the
record), and an overlap that never reached --ready expires quietly past its deadline.

RETIREMENT ENDS THE PREDECESSOR. A session cannot exit itself — `/exit` is a slash command a human types into
the TUI — so waiting for its pane to disappear waits for an event only a watching person can cause. --retire
therefore gives it CC_HANDOFF_RETIRE_GRACE (120 s: a turn in flight, and the journal flushed) and then KILLS
its window. The grace expires into a kill, never into "it keeps its window".

Env: CC_HANDOFF (the successor's own record id, exported into its process by `cc __runnext`) ·
CC_HANDOFF_RETIRE_GRACE, CC_HANDOFF_DONE_TTL (~/.cc/config) ·
CC_HANDOFF_DIR, CC_CTX_RECORDS (test hooks: put the record and the ledger somewhere else).
"""
import json, os, re, shlex, subprocess, sys, time, uuid

STATE = os.path.expanduser("~/.cc/state")
HANDOFF = os.environ.get("CC_HANDOFF_DIR") or os.path.join(STATE, "handoff")
RECORDS = os.environ.get("CC_CTX_RECORDS") or os.path.join(STATE, "context")
BIN = os.path.dirname(os.path.realpath(__file__))
SESSION = "main"
NEXT = "~next"                     # the successor's window suffix; `~` is not legal in a repo/track name
DEFAULT_MAX = 45 * 60
TARGET_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}(/[A-Za-z0-9_][A-Za-z0-9._-]{0,63})?$")


def cfg(name, default):
    """A number from the environment, else ~/.cc/config — through cc-config, which applies that precedence
    for every tool on the box and never sources the file (it holds tokens)."""
    try:
        r = subprocess.run([os.path.join(BIN, "cc-config"), "get", name], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=10)
        v = r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        v = None
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def enabled():
    """`CC_HANDOFF_OVERLAP=1` in ~/.cc/config turns the whole path on; the default is off, and flipping it is
    the owner's call. cc-slack mutes the non-live session since 2026-08-31 (delivery, the permission fanout
    and its own reply/react/file), so one channel keeps one voice while an overlap is open."""
    return cfg("CC_HANDOFF_OVERLAP", 0) >= 1


# ---- the record ----------------------------------------------------------------------------------------

def slug(target):
    return target.replace("/", "--")


def path(target):
    return os.path.join(HANDOFF, slug(target) + ".json")


def read(target):
    """The open overlap for this target, or None. Missing and corrupt read the same on purpose: both mean
    'nobody has taken over', which is the direction every failure here must fall."""
    try:
        with open(path(target)) as f:
            r = json.load(f)
    except Exception:
        return None
    return r if isinstance(r, dict) and r.get("id") and r.get("target") else None


def read_all():
    out = []
    for n in sorted(os.listdir(HANDOFF) if os.path.isdir(HANDOFF) else []):
        if not n.endswith(".json"):
            continue
        try:
            with open(os.path.join(HANDOFF, n)) as f:
                r = json.load(f)
        except Exception:
            continue                      # one bad record never hides the rest
        if isinstance(r, dict) and r.get("id") and r.get("target"):
            out.append(r)
    return out


def by_id(hid):
    for r in read_all():
        if r.get("id") == hid:
            return r
    return None


def write(rec):
    """THE COMMIT POINT. One os.replace(): every consumer sees either the whole old record or the whole new
    one, and there is no instant in which nobody is in charge."""
    os.makedirs(HANDOFF, exist_ok=True)
    p = path(rec["target"])
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump(rec, f)
    os.replace(tmp, p)
    return rec


def brief_path(target):
    return os.path.join(HANDOFF, slug(target) + ".brief")


def clear(target):
    for f in (path(target), brief_path(target)):
        try:
            os.remove(f)
        except OSError:
            pass


ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")       # a record id, and safe to build a filename from


def done_path(hid):
    """Where a COMPLETED retirement is remembered, keyed on the successor's own $CC_HANDOFF id."""
    return os.path.join(HANDOFF, hid + ".done") if ID_RE.match(hid or "") else None


def mark_done(rec):
    """Evidence that the retirement FINISHED, and it must outlive clear(). The successor keeps $CC_HANDOFF for
    the life of its process (by design — the model must not be able to unset it), so without this a handoff
    that went RIGHT is indistinguishable from a record lost because something went WRONG, and cc-guard gates
    the only session left. On 2026-08-31 that bricked the session that won the first real handoff: it lost
    dispatch mid-sentence. Written BEFORE clear(), so there is no instant in which the record is gone and the
    reason it is gone is not on disk."""
    p = done_path(rec.get("id") or "")
    if not p:
        return False
    os.makedirs(HANDOFF, exist_ok=True)
    tmp = p + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"id": rec["id"], "target": rec.get("target"), "retired": time.time()}, f)
    os.replace(tmp, p)
    ttl = cfg("CC_HANDOFF_DONE_TTL", 30 * 86400)   # once, not once per marker
    for n in sorted(os.listdir(HANDOFF)):          # no session outlives the TTL, so an older marker is litter
        if n.endswith(".done") and n != os.path.basename(p):
            q = os.path.join(HANDOFF, n)
            try:
                if os.path.getmtime(q) < time.time() - ttl:
                    os.remove(q)
            except OSError:
                pass
    return True


def live_side(rec):
    return "successor" if rec.get("live") == "successor" else "predecessor"


def ledger(rec, kind, why=""):
    """One countable line per phase — the handoff count stays a `wc -l`. `phases` in the record is what makes
    it once and not once per retry; an abandoned record is deleted, so a second --abandon is a no-op."""
    if kind in rec.setdefault("phases", []):
        return False
    rec["phases"].append(kind)
    os.makedirs(RECORDS, exist_ok=True)
    repo, _, track = rec["target"].partition("/")
    row = {"ts": time.time(), "kind": kind, "handoff": rec["id"], "target": rec["target"],
           "repo": repo, "track": track or None, "pct": rec.get("pct_at_start"),
           "session_id": (rec.get(live_side(rec)) or {}).get("session_id")}
    if why:
        row["why"] = why
    with open(os.path.join(RECORDS, "handoffs.jsonl"), "a") as f:
        f.write(json.dumps(row) + "\n")
    return True


# ---- tmux ----------------------------------------------------------------------------------------------

def tmux(*args, timeout=10):
    try:
        r = subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=timeout)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def win_id(name):
    """Address windows by id: names with `.` or `/` break `-t main:<name>`."""
    for l in (tmux("list-windows", "-t", SESSION, "-F", "#{window_id} #W") or "").splitlines():
        wid, _, n = l.partition(" ")
        if n == name:
            return wid
    return None


def pane_live_id(wid):
    """A window whose wrapper shell has a child = a real session; a bare fallback shell has none."""
    if not wid:
        return False
    pids = (tmux("list-panes", "-t", wid, "-F", "#{pane_pid}") or "").split()
    if not pids:
        return False
    try:
        return subprocess.run(["pgrep", "-P", pids[0]], capture_output=True).returncode == 0
    except Exception:
        return False


def pane_live(name):
    return pane_live_id(win_id(name))


def side_live(rec, side):
    """Is that side's SESSION still there — asked BOTH ways, because either one alone says 'gone' too easily: by
    the window name it should hold, and by the window id the record names (a renamed window is still that
    session). The sweep un-gates on this answer, so a false 'gone' is the expensive direction."""
    s = rec.get(side) or {}
    return pane_live(s.get("window") or "") or pane_live_id(s.get("tmux") or "")


def win_alive(wid):
    """Is that window id still on the server? Ids are never reused, so this is the one safe way to ask."""
    return bool(wid) and wid in (tmux("list-windows", "-t", SESSION, "-F", "#{window_id}") or "").split()


def self_wid():
    """The window THIS process is running in, from $TMUX_PANE — never a bare `display-message`, which answers
    with whatever window is ACTIVE and would cheerfully name somebody else's session."""
    pane = os.environ.get("TMUX_PANE") or ""
    if not pane:
        return ""
    return (tmux("display-message", "-p", "-t", pane, "#{window_id}") or "").strip()


def run(argv, wait=True):
    try:
        if wait:
            return subprocess.run(argv, capture_output=True, text=True, timeout=60).returncode == 0
        logd = os.path.join(os.path.expanduser("~"), ".cc", "state", "context")
        os.makedirs(logd, exist_ok=True)           # a detached fallback that REFUSES must leave its one line somewhere
        out = open(os.path.join(logd, "handoff.log"), "a")
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=out, start_new_session=True)
        return True
    except Exception:
        return False


def notify(title, msg):
    run([os.path.join(BIN, "cc-notify"), "-t", title, msg])


def alert(msg):
    """#alerts (owner, 2026-09-01): every handover leaves one line there. Best-effort like notify —
    a handover must never fail on Slack being down."""
    run([os.path.join(BIN, "cc-slack"), "post", "-c", "#alerts", msg])


# ---- phases --------------------------------------------------------------------------------------------

BRIEF = """You are the SUCCESSOR in an overlapping handoff of {target}. Read {journal} first — that file, and \
what your predecessor tells you, is everything you start from. You are NOT the live session yet: the live one \
owns this target's channel and may act on the world, and cc-guard refuses merging, pushing, deploying, \
dispatching workers, `cc done` and outward posts from you until you take over. Read, search, think and ask — \
and NEVER ask your predecessor to run something you are denied. Your predecessor is still working in this same \
directory: it is the peer whose tmux id is {tmux} in `ListAgents`, so reach it with `SendMessage` (bidirectional, \
out of band from the channel) and ask what the journal does not answer; subscribe with notify_when_idle, which \
is also how you hear if it exits. {flight} When you have the context and NOT BEFORE, run `cc-handoff --ready` — \
that single call is the commit point: it makes you live and retires your predecessor. If you cannot get there, \
say so in the journal; the overlap expires on its own and your predecessor simply carries on."""


def start(target, pct=None, session_id="", flight=""):
    """--overlap: the successor comes up beside the predecessor, muted and gated, with the same working
    directory. Refused while a record for this target is open — one successor at a time, never a chain."""
    if not TARGET_RE.match(target):
        print(f"cc-handoff: '{target}' is not a target (<repo> or <repo>/<track>)", file=sys.stderr)
        return 1
    old = read(target)
    if old:
        print(f"cc-handoff: {target} already has an overlap open "
              f"(phase {old.get('phase')}, live {live_side(old)}) — one successor at a time")
        return 1
    wid = win_id(target)
    if not wid:
        print(f"cc-handoff: no live window main:{target} — nothing to start alongside")
        return 1
    if win_id(target + NEXT):
        print(f"cc-handoff: main:{target}{NEXT} already exists with no record — clear it by hand first")
        return 1
    now = time.time()
    hid = uuid.uuid4().hex[:12]
    sid = str(uuid.uuid4())
    rec = {"id": hid, "target": target, "phase": "overlap", "live": "predecessor",
           "predecessor": {"session_id": session_id or "", "tmux": wid, "window": target},
           "successor": {"session_id": sid, "tmux": "", "window": target + NEXT},
           "started": now, "deadline": now + cfg("CC_HANDOFF_OVERLAP_MAX", DEFAULT_MAX),
           "pct_at_start": pct, "told_owner": None, "phases": []}
    ledger(rec, "overlap-started")
    write(rec)          # before the window, never after: a successor whose record is missing must find itself gated
    repo, _, track = target.partition("/")
    journal = (f"~/.cc/state/{repo}/{track}/progress.md" if track else f"~/.cc/state/{repo}/planning-handoff.md")
    with open(brief_path(target), "w") as f:
        f.write(BRIEF.format(target=target, journal=journal, tmux=wid,
                             flight=(f"Unfinished RIGHT NOW, which a journal always omits: {flight} — ask about it."
                                     if flight else "")))
    cmd = ""
    for v in ("CC_CLAUDE", "CC_NOTIFY_LOG_ONLY", "CC_NOTIFY_LOG", "CC_HANDOFF_DIR", "CC_CTX_RECORDS"):
        if os.environ.get(v):                     # the new window has the tmux server's env, not ours
            cmd += "%s=%s " % (v, shlex.quote(os.environ[v]))
    cmd += "%s __runnext %s %s %s; echo; echo '[successor exited — shell stays]'; exec bash" % (
        shlex.quote(os.path.join(BIN, "cc")), shlex.quote(target), hid, sid)
    if tmux("new-window", "-d", "-t", SESSION, "-n", target + NEXT, cmd) is None:
        clear(target)                             # nothing came up: leave no record claiming there is a successor
        print(f"cc-handoff: could not start main:{target}{NEXT} — no overlap opened", file=sys.stderr)
        return 1
    rec["successor"]["tmux"] = win_id(target + NEXT) or ""
    write(rec)
    print(f"cc-handoff: {target} — successor started in main:{target}{NEXT} (id {hid}); "
          f"it is muted and gated until it runs `cc-handoff --ready`")
    return 0


def ready(target=None, forced=False):
    """--ready: run BY THE SUCCESSOR, because the session that knows whether the transfer worked is the one
    that received it. Preflight, then the single os.replace(), then derive."""
    hid = os.environ.get("CC_HANDOFF") or ""
    rec = read(target) if target else (by_id(hid) if hid else None)
    if not rec:
        print(f"cc-handoff: no open overlap for {target or 'this session'}", file=sys.stderr)
        return 1
    target = rec["target"]
    if live_side(rec) == "successor":
        derive(rec)                                # idempotent: a retried --ready re-derives, never rolls back
        print(f"cc-handoff: {target} already cut over")
        return 0
    if not forced and hid != rec["id"]:
        print("cc-handoff: --ready belongs to the successor (its CC_HANDOFF must match the record); "
              "the predecessor's watchdog uses --forced", file=sys.stderr)
        return 1
    if forced and not pane_live(rec["successor"]["window"]):
        print(f"cc-handoff: {target} has no live successor to force onto", file=sys.stderr)
        return 2
    rec["live"] = "successor"                      # ---- THE COMMIT POINT ----
    rec["phase"] = "cutover"
    rec["cutover"] = time.time()
    alert(f"🔁 {target}: handover — the successor is live; the predecessor is retiring")
    ledger(rec, "overlap-forced" if forced else "overlap-cutover")
    write(rec)
    derive(rec)
    print(f"cc-handoff: {target} — the successor is live; the predecessor is journalling, then retiring")
    return 0


def derive(rec):
    """Everything after the commit point: idempotent, retried, never rolled back. A failure here leaves the
    record right about WHO IS LIVE and wrong only about cosmetics, and a later turn re-derives the same state."""
    target = rec["target"]
    repo, _, track = target.partition("/")
    sid = (rec.get("successor") or {}).get("session_id")
    if track and sid:
        board = os.path.join(BIN, "cc-board")
        run([board, "set", repo, track, "session_id", sid])
        run([board, "set", repo, track, "started", "true"])
        run([board, "note", repo, track, "handoff: the overlapping successor took over"])
    if pane_live(target):
        run([os.path.join(BIN, "cc-msg"), target,
             f"Handoff complete: your successor is live and owns this target now. Append your final entry to "
             f"the journal — what is done, what is next (ordered), gotchas — then run /exit. You are no longer "
             f"the live session: merging, pushing, dispatching and posting outward are refused from here on."])
    run([os.path.realpath(__file__), "--retire", target], wait=False)


def refuse_kill(rec, wid):
    """THE ONE GENUINELY DANGEROUS ACT IN THIS FILE. Killing the wrong window ends a working session and loses
    a context nobody can get back, so the kill is fenced by three refusals and each says which one it was.
    A caller that gets a reason back must kill NOTHING."""
    if not wid:
        return "there is no window left to end"
    if wid != ((rec.get("predecessor") or {}).get("tmux") or ""):
        return (f"tmux window {wid} is not the one the record names as the predecessor "
                f"({(rec.get('predecessor') or {}).get('tmux') or 'none'})")
    if wid == ((rec.get("successor") or {}).get("tmux") or ""):
        return "the record names the same window on both sides"
    if wid == self_wid():
        return "that is the window --retire is running in"
    return ""


def retire(target):
    """--retire: END the predecessor, take its window name, clear the record — every time, not only when a
    human happened to be watching. The old wait-it-out could never complete on its own: a session has no way
    to exit itself, so 'still running, it keeps its window' was the normal outcome, and on 2026-08-31 a
    retired session ran on for 35 minutes as a second live voice on the same channel (its window still the
    ACTIVE one, so an owner attaching landed on it). The grace period is for a turn in flight and the journal
    flush; it expires into a kill.
    Kills ONLY the pane the record names as the predecessor, ONLY once the record says the successor is live,
    and never the caller's own — see refuse_kill(). No record, or no cutover: nothing is killed at all."""
    rec = read(target)
    if not rec or live_side(rec) != "successor":
        return 0                                   # missing, corrupt, or before cutover: kill NOTHING
    deadline = time.time() + cfg("CC_HANDOFF_RETIRE_GRACE", 120)
    while time.time() < deadline and pane_live(target):
        time.sleep(5)
    wid = win_id(target)                           # the window still carrying the predecessor's name
    pre = (rec.get("predecessor") or {}).get("tmux") or ""
    if not wid and win_alive(pre):
        wid = pre                                  # renamed out from under us — the record still names the id,
    if wid:                                        # and a live predecessor must never outlive its own record
        why = refuse_kill(rec, wid)
        if why:                                    # the record and tmux disagree: the record stays, and so does the gate
            print(f"cc-handoff: {target}'s predecessor was NOT ended — {why}. It keeps its window and "
                  f"everything stays gated; this needs a hand.", file=sys.stderr)
            return 1
        tmux("kill-window", "-t", wid)
    nid = win_id(target + NEXT)
    if nid:
        tmux("rename-window", "-t", nid, target)
    rec["phase"] = "done"
    ledger(rec, "overlap-retired")
    write(rec)
    mark_done(rec)                                 # before clear(), always: it is what tells cc-guard this went RIGHT
    clear(target)                                  # nobody is gated any more: the successor is the only session left
    print(f"cc-handoff: {target} — the predecessor is ended, the successor has its window, nothing is gated")
    return 0


def abandon(target, why=""):
    """--abandon: the deadline below the ceiling. The successor's window goes, the record clears, the owner
    hears it ONCE — the record's absence is what makes a second call a no-op. Never two sessions forever."""
    rec = read(target)
    if not rec:
        return 0
    if live_side(rec) == "successor":
        print(f"cc-handoff: {target} has already cut over — nothing to abandon", file=sys.stderr)
        return 1
    wid = win_id(rec["successor"]["window"])
    if wid:
        tmux("kill-window", "-t", wid)
    rec["told_owner"] = time.time()
    ledger(rec, "overlap-abandoned", why)
    clear(target)
    notify(target, f"Overlapping handoff abandoned for {target}: {why or 'the successor never became ready'}. "
                   f"The original session is still running and still in charge.")
    print(f"cc-handoff: {target} — overlap abandoned, the predecessor carries on")
    return 0


def due(target, over_ceiling=False):
    """--due: the predecessor's Stop hook, every turn. Silent until the deadline; then the ceiling decides."""
    rec = read(target)
    if not rec or live_side(rec) == "successor" or time.time() < rec.get("deadline", 0):
        return 0
    if not over_ceiling:
        return abandon(target, "the successor did not become ready inside the overlap window")
    if pane_live(rec["successor"]["window"]):
        return ready(target, forced=True)          # it has the journal, which is all a fresh session ever got
    _, _, track = target.partition("/")
    abandon(target, "at the context ceiling with no live successor")
    if track:                                      # fall back INTO the old path: stop, journal, restart fresh
        run([os.path.realpath(__file__), "--replace", target], wait=False)
    else:
        notify(target, f"{target} is at its context ceiling and the overlapping handoff did not take. "
                       f"There is no stop-then-restart path for a planning session — it needs a hand.")
    return 0


def replace(target, over=None):
    """--replace: the ORIGINAL handoff, and the one the overlap falls back INTO — tell the session to journal,
    wait for it to exit, then restart it on a fresh context. It was `cc handoff <repo> <track>` until
    2026-08-31; `cc` still spells it that way and delegates here, so the lifecycle has one owner and one file
    to read. Every refusal leaves the session running and says why: a restart that loses a context nobody
    journalled is worse than no restart.
    A handoff costs the session its working memory, so --over decides on the MEASURED number, never a hunch."""
    repo, _, track = target.partition("/")
    if not track:
        print(f"cc-handoff: {target} is a planning session — there is no stop-then-restart path for one",
              file=sys.stderr)
        return 1
    if not win_id(target):
        print(f"cc-handoff: no live window {target}")
        return 1
    st = os.path.join(STATE, repo, track)
    jrn = os.path.join(st, "progress.md")
    if over:
        argv = [os.path.join(BIN, "cc-context"), repo, track, "--over"] + ([] if over == "any" else [over])
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=120)
            rc, ctx = r.returncode, r.stdout.split("  ")[0].strip()
        except Exception:
            rc, ctx = 2, ""
        line = "under the handoff line" if over == "any" else f"under {over}%"
        if rc == 2:
            print(f"cc-handoff: cannot measure {target}'s context (no answered turn yet) — "
                  f"not handing off on a guess")
            return 1
        if rc == 1:
            print(f"cc-handoff: {target} is at {ctx}, {line} — nothing to hand off")
            return 0
        print(f"cc-handoff: {target} is at {ctx} (over {line[len('under '):]}) — handing off")
    else:
        try:
            r = subprocess.run([os.path.join(BIN, "cc-context"), repo, track],
                               capture_output=True, text=True, timeout=120)
            if r.returncode == 0:
                print(f"cc-handoff: {target} is at {r.stdout.split('  ')[0].strip()} — handing off")
        except Exception:
            pass
    def mtime():
        try:
            return os.stat(jrn).st_mtime
        except OSError:
            return 0
    before = mtime()
    if not run([os.path.join(BIN, "cc-msg"), target,
                f"Handoff: append to {jrn} a dated handoff entry for a fresh session — what is done, what is "
                f"next (ordered), gotchas/decisions — then run /exit."]):
        print(f"cc-handoff: cc-msg could not reach {target} (dialog open, or no interactive session) — "
              f"not restarting", file=sys.stderr)
        return 1
    for _ in range(120):
        if not pane_live(target):
            break
        time.sleep(5)
    if pane_live(target):
        print("cc-handoff: session did not exit in 10 min; the handoff journal may still be written. "
              "Not restarting.", file=sys.stderr)
        return 1
    if mtime() == before:
        print(f"cc-handoff: {jrn} never changed — no handoff journal was written, so a fresh context would "
              f"start blind. Not restarting (read the pane, then: cc {repo} {track})", file=sys.stderr)
        return 1
    wid = win_id(target)
    if wid:
        tmux("kill-window", "-t", wid)
    board = os.path.join(BIN, "cc-board")
    run([board, "set", repo, track, "session_id", str(uuid.uuid4())])
    run([board, "set", repo, track, "started", "false"])
    run([board, "note", repo, track, "handoff: restarted with fresh context"])
    run([os.path.join(BIN, "cc"), repo, track])
    return 0


def event(target, level="", pct=None, session="", busy="", live=False, taken=False):
    """--event: the ONE call cc-context makes. It measures and says WHAT was crossed; which phase that means is
    decided here, in the file that owns every phase. Returns the action taken, for the caller's own record:
      ""         nothing — the line was the journal nudge, or a phase is already open, or nothing could start
      "overlap"  a successor is coming up alongside (the predecessor is not interrupted)
      "replace"  the old stop-then-restart path is running, detached
    `taken` = that session has already taken a phase, or a Stop hook is holding it: nothing NEW starts, but the
    level still decides the watchdog below, which is why cc-context sends it either way.
    Never from the SUCCESSOR: $CC_HANDOFF is in its environment and nowhere else, and a session must not police,
    abandon or restart the handoff it is itself the second half of."""
    if os.environ.get("CC_HANDOFF"):
        return ""
    if read(target):
        due(target, level == "ceiling")     # an overlap is open: its deadline, every turn, from the predecessor
    if taken or not level or level == "journal" or not live or read(target):
        return ""                           # the journal line is a nudge, not a phase; and one phase at a time
    if enabled() and start(target, pct, session, busy) == 0:
        return "overlap"                    # nothing has to be idle: starting a second session interrupts nobody
    if "/" in target and not busy:          # the overlap is off or would not open: fail INTO the old path, which
        run([os.path.realpath(__file__), "--replace", target], wait=False)   # DOES have to wait for idle
        return "replace"
    return ""


def finalize(rec, why):
    """A retirement nobody is left to finish. mark_done() BEFORE clear(), always: that order is the only reason
    the survivor of a completed handoff is not gated by the record of its own success."""
    target = rec["target"]
    nid = win_id(target + NEXT)
    if nid and not win_id(target):                 # the predecessor is gone: its name is free
        tmux("rename-window", "-t", nid, target)
    rec["phase"] = "done"
    alert(f"🔁 {target}: handover finalized by the sweep — {why}")
    ledger(rec, "overlap-swept", why)
    write(rec)
    mark_done(rec)
    clear(target)
    repo, _, track = target.partition("/")
    if track:
        run([os.path.join(BIN, "cc-board"), "note", repo, track, f"handoff: swept — {why}"])
    print(f"cc-handoff: {target} — {why}; the record is finalized and nothing is gated by it")


def sweep():
    """--sweep: the reaper, run from the EXISTING cc-reconcile timer (no new unit). Everything else here is
    driven by a session's own Stop hook, which is precisely what a crashed session no longer has: a retirement
    that dies between mark_done() and clear() leaves the survivor gated by the record of its own success, and a
    predecessor that dies mid-overlap leaves a record nothing reaps. Two cases, both unambiguous:
      the predecessor's session is GONE past the retire grace -> finalize. Nobody but the successor is in
        charge of that target, and a record saying otherwise is gating the only session left.
      an overlap that never reached --ready is past its deadline -> it expires QUIETLY. The predecessor never
        stopped working and was never told anything, so there is nothing to tell it now; --due, which the
        predecessor's own hook runs, gets first refusal (hence the extra grace) and tells the owner when it acts.
    A sweep only ever un-gates, so a WRONG 'gone' is the expensive direction: if tmux cannot be read at all —
    no server, no session main — every window looks gone, so nothing is swept."""
    if tmux("list-windows", "-t", SESSION, "-F", "#{window_id}") is None:
        return 0
    grace, now = cfg("CC_HANDOFF_RETIRE_GRACE", 120), time.time()
    for rec in read_all():
        target = rec["target"]
        if not TARGET_RE.match(target):
            continue                               # a record naming something that is not a target: not ours to act on
        pred_live = side_live(rec, "predecessor")
        if pred_live and rec.get("gone_since"):
            rec.pop("gone_since", None)            # it came back: a misread, which is exactly what the stamp absorbs
            write(rec)
        if not pred_live and now - (rec.get("cutover") or rec.get("started") or 0) > grace:
            # TWO STRIKES, a sweep apart. One transient tmux/pgrep misread here would un-gate the successor while
            # the predecessor keeps working — two un-gated voices, the 2026-08-31 incident class. The first sweep
            # that finds nobody only writes down WHEN; the finalize needs a later sweep still finding nobody.
            gone = rec.get("gone_since") or 0
            if not gone:
                rec["gone_since"] = now
                write(rec)
            elif now - gone >= cfg("CC_HANDOFF_GONE_CONFIRM", 300):
                finalize(rec, "the predecessor's session is gone (two sweeps apart)")
        elif live_side(rec) == "predecessor" and now > rec.get("deadline", 0) + grace:
            rec = read(target)                     # the DECIDING read: a --ready committing after the loop copied
            if not rec or live_side(rec) != "predecessor" or now <= rec.get("deadline", 0) + grace:
                continue                           # this record means the kill below would hit the LIVE successor
            wid = win_id((rec.get("successor") or {}).get("window") or "")
            if wid:
                tmux("kill-window", "-t", wid)
            ledger(rec, "overlap-expired", "the overlap window passed with no --ready")
            clear(target)
            print(f"cc-handoff: {target} — the overlap expired without a cutover; the predecessor carries on")
    return 0


def status(target=None, as_json=False):
    recs = [r for r in ([read(target)] if target else read_all()) if r]
    if as_json:
        print(json.dumps(recs))
        return 0 if recs else 1
    if not recs:
        print("no overlapping handoff is open" + (f" for {target}" if target else ""))
        return 1
    now = time.time()
    for r in recs:
        left = int((r.get("deadline", 0) - now) / 60)
        alive = "alive" if pane_live(r["successor"]["window"]) else "gone"
        print(f"{r['target']:<24} {r.get('phase', '?'):<9} live={live_side(r):<11} "
              f"{left:>4}m left   successor main:{r['successor']['window']} ({alive})   id {r['id']}")
    return 0


# ---- selfcheck -----------------------------------------------------------------------------------------

def selfcheck():
    import tempfile
    global HANDOFF, RECORDS, win_id, pane_live, tmux, run, notify, self_wid
    p = f = 0

    def ok(what, cond):
        nonlocal p, f
        if cond:
            p += 1
            print(f"  ✓ {what}")
        else:
            f += 1
            print(f"  ✗ {what}")

    with tempfile.TemporaryDirectory() as d:
        HANDOFF = os.path.join(d, "handoff")
        RECORDS = os.path.join(d, "context")
        # nothing real is started, killed or pushed from a selfcheck: tmux and the shell-outs are stubbed
        wins, msgs, dead, me = {"r1": "@1"}, [], set(), [""]

        def win_id(n):
            return wins.get(n)

        def pane_live(n):
            return n in wins and n not in dead      # `dead` = the window is still there, the session in it is not

        def self_wid():
            return me[0]                            # the window --retire is pretending to run in

        def tmux(*a, **k):
            if a[0] == "list-windows":
                return "\n".join(wins.values())
            if a[0] == "new-window":
                wins[a[a.index("-n") + 1]] = "@%d" % (len(wins) + 1)
            elif a[0] == "kill-window":
                for n, i in list(wins.items()):
                    if i == a[-1]:
                        del wins[n]
            elif a[0] == "rename-window":
                for n, i in list(wins.items()):
                    if i == a[a.index("-t") + 1]:
                        wins[a[-1]] = wins.pop(n)
            return ""

        def run(argv, wait=True):
            msgs.append(list(argv))
            return True

        def notify(t, m):
            msgs.append(["notify", t, m])

        ok("a target with a track slugs to one flat file",
           os.path.basename(path("r1/t1")) == "r1--t1.json" and os.path.basename(path("r1")) == "r1.json")
        ok("a target cannot escape the record dir", not TARGET_RE.match("../etc")
           and not TARGET_RE.match("r1/t1/x") and TARGET_RE.match("r1/t1"))

        os.environ.pop("CC_HANDOFF", None)
        ok("no record at all -> nothing is open", read("r1") is None and status("r1") == 1)
        ok("an overlap needs a live window", start("nosuch") == 1)
        ok("an overlap starts on a live window", start("r1", pct=41.2) == 0)
        rec = read("r1")
        ok("the record names the predecessor as live", rec and rec["live"] == "predecessor")
        ok("the deadline is bounded", rec["deadline"] - rec["started"] == DEFAULT_MAX)
        ok("a second overlap for the same target is refused", start("r1") == 1)

        os.environ["CC_HANDOFF"] = "wrong-id"
        ok("--ready from a session whose CC_HANDOFF does not match is refused", ready("r1") == 1)
        ok("...and the predecessor is still live", read("r1")["live"] == "predecessor")

        os.environ["CC_HANDOFF"] = rec["id"]
        ok("--ready with no target finds the record by CC_HANDOFF", by_id(rec["id"])["target"] == "r1")
        ok("the successor cuts over", ready() == 0)
        ok("the commit point moved ownership forward", read("r1")["live"] == "successor")
        ok("the predecessor was told to journal and exit",
           any("cc-msg" in a[0] for a in msgs if isinstance(a, list)))
        ok("--ready is idempotent, never a rollback", ready() == 0 and read("r1")["live"] == "successor")
        ok("--abandon after cutover is refused", abandon("r1") == 1 and read("r1")["live"] == "successor")

        lines = [json.loads(l) for l in open(os.path.join(RECORDS, "handoffs.jsonl"))]
        ok("one ledger line per phase, and never two",
           [l["kind"] for l in lines] == ["overlap-started", "overlap-cutover"])

        # a successor that dies before --ready: ownership never moved, so the predecessor never noticed
        clear("r1")
        os.environ.pop("CC_HANDOFF", None)
        wins.pop("r1~next", None)
        wins["r1"] = "@1"
        ok("a fresh overlap opens once the last one is cleared", start("r1") == 0)
        wins.pop("r1~next", None)                       # the successor's window is gone
        ok("successor dead before --ready -> the predecessor is still live",
           read("r1")["live"] == "predecessor" and ready("r1", forced=True) == 2)
        ok("--due before the deadline does nothing", due("r1") == 0 and read("r1") is not None)

        r = read("r1")
        r["deadline"] = time.time() - 1
        write(r)
        ok("--due past the deadline below the ceiling abandons", due("r1") == 0 and read("r1") is None)
        ok("the owner heard it once", sum(1 for m in msgs if m and m[0] == "notify") == 1)
        ok("--due on a cleared record is a no-op (never twice)", due("r1") == 0
           and sum(1 for m in msgs if m and m[0] == "notify") == 1)

        # at the ceiling with no successor: fall back INTO today's stop-then-restart path
        wins["r1/t1"] = "@2"
        start("r1/t1")
        r = read("r1/t1")
        r["deadline"] = time.time() - 1
        write(r)
        wins.pop("r1/t1~next", None)
        due("r1/t1", over_ceiling=True)
        ok("at the ceiling with no successor, the old path runs — and it is OURS now, not a call back into cc",
           any(isinstance(a, list) and a[-2:] == ["--replace", "r1/t1"] for a in msgs))
        ok("...and the record is cleared, so nothing stays gated", read("r1/t1") is None)

        # ---- retirement ENDS the predecessor. A session cannot exit itself, so the grace expires into a KILL.
        os.environ["CC_HANDOFF_RETIRE_GRACE"] = "0"

        def cutover(t):
            """a target at the moment after the commit point: predecessor alive, successor waiting"""
            wins[t] = "@" + t
            start(t)
            os.environ["CC_HANDOFF"] = read(t)["id"]
            ready(t)
            return read(t)

        os.environ.pop("CC_HANDOFF", None)
        wins["r2"] = "@r2"
        ok("--retire with no record kills nothing", retire("r2") == 0 and wins.get("r2") == "@r2")
        start("r2")
        ok("--retire BEFORE cutover kills nothing", retire("r2") == 0 and wins.get("r2") == "@r2"
           and read("r2") is not None)
        clear("r2")
        del wins["r2~next"]

        r = cutover("r2")
        suc = r["successor"]["tmux"]
        ok("a predecessor still alive after the grace is ENDED, and its window name taken",
           retire("r2") == 0 and wins.get("r2") == suc and "r2~next" not in wins)
        ok("...the record is cleared afterwards, so nothing stays gated", read("r2") is None)
        ok("...and the completed retirement is remembered where clear() cannot reach it (2026-08-31: a "
           "finished handoff gated the only session left)", os.path.exists(done_path(r["id"])))
        marked = done_path(r["id"])
        ok("one ledger line for the retirement",
           [json.loads(l)["kind"] for l in open(os.path.join(RECORDS, "handoffs.jsonl"))][-1] == "overlap-retired")

        r = cutover("r3")
        dead.add("r3")                                  # /exit was typed: the window is a bare shell now
        ok("a predecessor that already exited still renames and clears (today's path, unchanged)",
           retire("r3") == 0 and wins.get("r3") == r["successor"]["tmux"] and read("r3") is None)

        r = cutover("r4")
        me[0] = r["predecessor"]["tmux"]                # --retire called from the very window it would kill
        ok("--retire never kills the pane it is called from",
           retire("r4") == 1 and wins.get("r4") == r["predecessor"]["tmux"] and read("r4") is not None)
        me[0] = ""
        r["predecessor"]["tmux"] = "@somebody-else"     # the record and tmux disagree about who is there
        write(r)
        ok("a window the record does not name as the predecessor is not killed",
           retire("r4") == 1 and wins.get("r4") == "@r4" and read("r4") is not None)
        ok("...and a refused kill leaves no completion marker: the successor stays gated",
           not os.path.exists(done_path(r["id"])))
        clear("r4")                                     # a refused retirement keeps its record: the rest of the check wants a clean dir

        r = cutover("r6")
        wins["r6-renamed"] = wins.pop("r6")              # its window no longer carries the target's name
        ok("a predecessor whose window was renamed is still ended, by the id the record names",
           retire("r6") == 0 and r["predecessor"]["tmux"] not in wins.values()
           and wins.get("r6") == r["successor"]["tmux"] and read("r6") is None)

        r = cutover("r5")
        os.environ["CC_HANDOFF_DONE_TTL"] = "0"         # every marker is now older than the TTL
        retire("r5")
        ok("a completion marker is pruned once no session can still be holding that id",
           os.path.exists(done_path(r["id"])) and not os.path.exists(marked))
        os.environ.pop("CC_HANDOFF_DONE_TTL", None)
        os.environ.pop("CC_HANDOFF", None)

        # ---- --event: cc-context measures and says which LINE was crossed; the PHASE is decided here
        ov0 = os.environ.get("CC_HANDOFF_OVERLAP")
        os.environ["CC_HANDOFF_OVERLAP"] = "1"
        wins["e1/t"] = "@e1"
        ok("the journal line is a nudge, not a phase", event("e1/t", "journal", live=True) == ""
           and read("e1/t") is None)
        ok("no live window, no phase — a headless worker's loop is its handoff", event("e1/t", "handoff") == "")
        ok("the handoff line starts the successor ALONGSIDE, work in flight or not",
           event("e1/t", "handoff", 41.0, "sid-e", "uncommitted work in t", live=True) == "overlap"
           and read("e1/t")["live"] == "predecessor")
        ok("...and what is unfinished RIGHT NOW goes into its brief",
           "uncommitted work in t" in open(brief_path("e1/t")).read())
        ok("...while it is open, no second phase is taken for that target",
           event("e1/t", "ceiling", live=True) == "")
        clear("e1/t")
        wins.pop("e1/t~next", None)
        os.environ["CC_HANDOFF_OVERLAP"] = "0"
        ok("with the overlap off the event fails INTO the old path — and it is ours to run",
           event("e1/t", "handoff", live=True) == "replace"
           and any(isinstance(a, list) and a[-2:] == ["--replace", "e1/t"] for a in msgs))
        ok("...which is the one that HAS to wait for idle, so work in flight defers it",
           event("e1/t", "handoff", busy="uncommitted work in t", live=True) == "")
        ok("a planning session has no stop-then-restart path to fall into", event("e1", "ceiling", live=True) == "")
        ok("a session that already took a phase only runs the watchdog",
           event("e1/t", "ceiling", live=True, taken=True) == "")
        os.environ["CC_HANDOFF"] = "somebody-elses-handoff"
        ok("the SUCCESSOR never drives the handoff it is the second half of",
           event("e1/t", "ceiling", live=True) == "" and read("e1/t") is None)
        os.environ.pop("CC_HANDOFF", None)

        # ---- --sweep: what no session is left to finish. It only ever UN-GATES, so a wrong "gone" is the
        # expensive direction and every case below is about not taking one.
        r = cutover("s1")
        ok("a record whose predecessor is still there is left alone", sweep() == 0 and read("s1") is not None)
        pw = wins["s1"]
        del wins["s1"]                                  # the predecessor is gone: --retire never got to finish
        ok("one sweep alone never finalizes — a single misread must not un-gate the successor",
           sweep() == 0 and read("s1") is not None and bool(read("s1").get("gone_since")))
        wins["s1"] = pw                                 # it came back: the "gone" was a misread
        ok("...a predecessor seen again withdraws the stamp",
           sweep() == 0 and read("s1") is not None and not read("s1").get("gone_since"))
        del wins["s1"]
        sweep()                                         # strike one: the stamp
        rr = read("s1"); rr["gone_since"] = time.time() - 301; write(rr)   # a sweep later, still nobody
        ok("a predecessor gone past the grace is finalized (two sweeps apart)", sweep() == 0 and read("s1") is None)
        ok("...and the handover leaves one line in #alerts (owner, 2026-09-01)",
           any(a[:4] == [os.path.join(BIN, "cc-slack"), "post", "-c", "#alerts"] for a in msgs if isinstance(a, list)))
        ok("...with the marker cc-guard reads, so the survivor is not gated by the record of its own success",
           os.path.exists(done_path(r["id"])))
        ok("...and the successor is left holding the target's window name",
           wins.get("s1") == r["successor"]["tmux"] and "s1~next" not in wins)
        ok("...one ledger line, saying it was swept",
           [json.loads(l)["kind"] for l in open(os.path.join(RECORDS, "handoffs.jsonl"))][-1] == "overlap-swept")
        ok("...and a swept record is not swept again", sweep() == 0 and read("s1") is None)

        os.environ.pop("CC_HANDOFF", None)
        told = sum(1 for m in msgs if m and m[0] == "notify")
        wins["s2"] = "@s2"
        start("s2")
        ok("an overlap still inside its deadline is not swept", sweep() == 0 and read("s2") is not None)
        rr = read("s2")
        rr["deadline"] = time.time() - 1
        write(rr)
        ok("an overdue overlap that never reached --ready expires",
           sweep() == 0 and read("s2") is None and "s2~next" not in wins)
        ok("...QUIETLY: its predecessor never stopped working, so there is nothing to tell the owner",
           sum(1 for m in msgs if m and m[0] == "notify") == told)

        wins["s3"] = "@s3"
        start("s3")
        keep_tmux = tmux
        tmux = lambda *a, **k: None                     # noqa: E731 — the tmux server cannot be read at all
        ok("with tmux unreadable nothing is swept: every window would look gone",
           sweep() == 0 and read("s3") is not None)
        tmux = keep_tmux
        clear("s3")
        wins.pop("s3~next", None)
        if ov0 is None:
            os.environ.pop("CC_HANDOFF_OVERLAP", None)
        else:
            os.environ["CC_HANDOFF_OVERLAP"] = ov0

        # a corrupt record reads exactly like a missing one: the predecessor is in charge
        os.makedirs(HANDOFF, exist_ok=True)
        with open(path("r1"), "w") as fh:
            fh.write("{not json")
        ok("a corrupt record is not an open overlap", read("r1") is None and read_all() == [])

    print(f"cc-handoff selfcheck: {p} passed, {f} failed")
    return 1 if f else 0


# ---- cli -----------------------------------------------------------------------------------------------

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "selfcheck":
        return selfcheck()
    cmd, rest = argv[0], argv[1:]
    opt = {}
    pos = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--pct", "--session", "--why", "--in-flight", "--level"):
            opt[a[2:].replace("-", "_")] = rest[i + 1] if i + 1 < len(rest) else ""
            i += 1
        elif a == "--over":                 # its value is optional: bare --over = that session's own handoff line
            if i + 1 < len(rest) and not rest[i + 1].startswith("-"):
                opt["over"] = rest[i + 1]
                i += 1
            else:
                opt["over"] = "any"
        elif a in ("--forced", "--over-ceiling", "--json", "--live", "--taken"):
            opt[a.lstrip("-").replace("-", "_")] = True
        elif a.startswith("--"):
            print(f"cc-handoff: unknown option {a}", file=sys.stderr)
            return 1
        else:
            pos.append(a)
        i += 1
    target = pos[0] if pos else None
    if target and not TARGET_RE.match(target):
        print(f"cc-handoff: '{target}' is not a target (<repo> or <repo>/<track>)", file=sys.stderr)
        return 1
    if cmd == "--overlap":
        if not target:
            print("cc-handoff: --overlap needs a target", file=sys.stderr)
            return 1
        if not enabled():
            print("cc-handoff: the overlapping handoff is off — the owner turns it on with CC_HANDOFF_OVERLAP=1 "
                  "in ~/.cc/config (the channel layer mutes the non-live session since 2026-08-31)", file=sys.stderr)
            return 1
        try:
            pct = float(opt.get("pct"))
        except (TypeError, ValueError):
            pct = None
        return start(target, pct, opt.get("session", ""), opt.get("in_flight", ""))
    if cmd == "--ready":
        return ready(target, bool(opt.get("forced")))
    if cmd == "--replace":
        return replace(target, opt.get("over")) if target else 1
    if cmd == "--sweep":
        return sweep()
    if cmd == "--event":
        if not target:
            return 1
        try:
            pct = float(opt.get("pct"))
        except (TypeError, ValueError):
            pct = None
        import contextlib
        with contextlib.redirect_stdout(sys.stderr):   # stdout is the answer; a phase's own words are not
            act = event(target, opt.get("level", ""), pct, opt.get("session", ""),
                        opt.get("in_flight", ""), bool(opt.get("live")), bool(opt.get("taken")))
        print(json.dumps({"action": act}))
        return 0
    if cmd == "--abandon":
        return abandon(target, opt.get("why", "")) if target else 1
    if cmd == "--due":
        return due(target, bool(opt.get("over_ceiling"))) if target else 1
    if cmd == "--retire":
        return retire(target) if target else 1
    if cmd == "--status":
        return status(target, bool(opt.get("json")))
    print(__doc__.strip(), file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
