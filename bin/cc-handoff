            fh.write("filler that is never read\n" * 2000)
            fh.write("## 2026-01-02 05:00Z - journal at 31% ctx\nTHE-MARKED-ENTRY-TO-KEEP\n")
            for i in range(3):
                fh.write("## 2026-01-02 0%d:00Z - OVERLAP STARTED\n" % (6 + i))
                fh.write("an unmarked entry after the marked one\n" * 120)
            fh.write("## 2026-01-02 09:00Z - TAKEOVER\n- 09:1xZ: THE-LAST-DATED-LINE\n")
        ptext, pread, panchor = tail_entry(pj)
        ok("a marked entry buried under pages of unmarked ones is still where the packet starts",
           panchor == "last 'journal at N%' entry" and "THE-MARKED-ENTRY-TO-KEEP" in ptext
           and ptext.startswith("## 2026-01-02 05:00Z"))
        ok("...with every unmarked entry after it kept, and the marked entry before it left out",
           "OVERLAP STARTED" in ptext and "THE-LAST-DATED-LINE" in ptext
           and "OLDER-MARKED-ENTRY" not in ptext and pread <= BRIEF_CAP)


        # WHERE gh IS ASKED IS PART OF THE ANSWER. It resolves a repo from its cwd, and --brief is run from
        # wherever the caller stands: from another repo's checkout that printed that repo's PRs under this
        # one's heading, and from a dir that is no checkout it printed none — read as "nothing is open".
        ok("gh is asked inside the target's own checkout, not wherever the caller happens to be",
           ghcwd == [os.path.join(DEV, "r9")])
        ok("...a target with no checkout to ask in says so, and never shows an empty PR list",
           prs("r-none").startswith("(unavailable:") and "r-none" in prs("r-none"))
        ok("...and a helper that could not run says so too, while one that ran is passed through",
           real_out(["false"], fail="(unavailable: x)") == "(unavailable: x)"
           and real_out(["printf", "hi"], fail="(unavailable: x)") == "hi"
           and real_out(["no-such-binary-here"], fail="(unavailable: x)") == "(unavailable: x)")
        clear("r9/t9")
        wins.pop("lane7", None)
        DEV = dev0
        if home0 is None:
            os.environ.pop("HOME", None)
        else:
            os.environ["HOME"] = home0

    if nlo is not None:
        os.environ["CC_NOTIFY_LOG_ONLY"] = nlo
    print(f"cc-handoff selfcheck: {p} passed, {f} failed")
    return 1 if f else 0


# ---- cli -----------------------------------------------------------------------------------------------

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "selfcheck":
        return selfcheck()
    cmd, rest = argv[0], argv[1:]
    opt = {}
    pos = []
    i = 0
    while i < len(rest):
        a = rest[i]
        if a in ("--pct", "--session", "--why", "--in-flight", "--level"):
            opt[a[2:].replace("-", "_")] = rest[i + 1] if i + 1 < len(rest) else ""
            i += 1
        elif a == "--over":                 # its value is optional: bare --over = that session's own handoff line
            if i + 1 < len(rest) and not rest[i + 1].startswith("-"):
                opt["over"] = rest[i + 1]
                i += 1
            else:
                opt["over"] = "any"
        elif a in ("--forced", "--over-ceiling", "--json", "--live", "--taken"):
            opt[a.lstrip("-").replace("-", "_")] = True
        elif a.startswith("--"):
            print(f"cc-handoff: unknown option {a}", file=sys.stderr)
            return 1
        else:
            pos.append(a)
        i += 1
    target = pos[0] if pos else None
    if target and not TARGET_RE.match(target):
        print(f"cc-handoff: '{target}' is not a target (<repo> or <repo>/<track>)", file=sys.stderr)
        return 1
    if cmd == "--overlap":
        if not target:
            print("cc-handoff: --overlap needs a target", file=sys.stderr)
            return 1
        if not enabled():
            print("cc-handoff: the overlapping handoff is off — the owner turns it on with CC_HANDOFF_OVERLAP=1 "
                  "in ~/.cc/config (the channel layer mutes the non-live session since 2026-08-31)", file=sys.stderr)
            return 1
        try:
            pct = float(opt.get("pct"))
        except (TypeError, ValueError):
            pct = None
        return start(target, pct, opt.get("session", ""), opt.get("in_flight", ""))
    if cmd == "--kick":                            # internal: the detached child start() leaves behind
        return kick(target, pos[1] if len(pos) > 1 else "") if target else 1
    if cmd == "--ready":
        return ready(target, bool(opt.get("forced")))
    if cmd == "--replace":
        return replace(target, opt.get("over")) if target else 1
    if cmd == "--sweep":
        return sweep()
    if cmd == "--event":
        if not target:
            return 1
        try:
            pct = float(opt.get("pct"))
        except (TypeError, ValueError):
            pct = None
        import contextlib
        with contextlib.redirect_stdout(sys.stderr):   # stdout is the answer; a phase's own words are not
            act = event(target, opt.get("level", ""), pct, opt.get("session", ""),
                        opt.get("in_flight", ""), bool(opt.get("live")), bool(opt.get("taken")))
        print(json.dumps({"action": act}))
        return 0
    if cmd == "--abandon":
        return abandon(target, opt.get("why", "")) if target else 1
    if cmd == "--due":
        return due(target, bool(opt.get("over_ceiling"))) if target else 1
    if cmd == "--retire":
        return retire(target) if target else 1
    if cmd == "--relay":                           # the hook's payload on stdin; never a word unless it blocks
        try:
            payload = json.load(sys.stdin)
            return relay(payload if isinstance(payload, dict) else {})
        except Exception:
            return 0
    if cmd == "--brief":
        if not target:
            print("cc-handoff: --brief needs a target (<repo> or <repo>/<track>)", file=sys.stderr)
            return 1
        return brief(target)
    if cmd == "--status":
        return status(target, bool(opt.get("json")))
    print(__doc__.strip(), file=sys.stderr)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        sys.exit(130)
