class Channel:
    def __init__(self, target):
        self.target, self.cfg, self.link, self.daemon_ok = target, load_cfg(), None, None
        self.alias = os.environ.get("CC_SLACK_ALIAS") or None   # set by `cc <repo> --orch <alias>`; peer session, same target
        self.handoff = os.environ.get("CC_HANDOFF") or None     # set by `cc __runnext`: this session is the SUCCESSOR of that record
        self.member = os.environ.get("CC_MEMBER_SANDBOX") == "1"   # inside a workspace's boundary: no token here — the socket is the member's scoped link
        self.link_started = False   # daemon link starts only after the host's notifications/initialized (else backlog is emitted pre-handshake and dropped)
        import asyncio
        self.aio = asyncio
        self.out_lock = asyncio.Lock()

    async def send(self, obj):
        async with self.out_lock:
            sys.stdout.buffer.write((json.dumps(obj) + "\n").encode()); sys.stdout.buffer.flush()

    async def run(self):
        loop = self.loop = self.aio.get_running_loop()
        reader = self.aio.StreamReader()
        await loop.connect_read_pipe(lambda: self.aio.StreamReaderProtocol(reader), sys.stdin.buffer)
        if os.environ.get(REEXEC) and not self.link_started:
            self.link_started = True                        # a re-exec lands mid-session: the host initialised the copy
            self.aio.create_task(self._link_when_ready())   # before us and never says so twice, so the link starts itself
        while True:
            line = await reader.readline()
            if not line:
                break
            try:
                msg = json.loads(line)
            except Exception:
                continue
            try:
                await self.handle(msg)
            except Exception as e:
                log(f"channel error: {e!r}")
            if self.should_reexec(msg.get("method")):
                self.reexec()
        os._exit(0)

    # ── running the code that is deployed, not the code we started with ──────────────────────────────────
    def stale(self):
        """Has this file been replaced under us? A session's channel server is a child of that session's own
        `claude` and keeps the bytes it started with for the session's whole life — so install.sh plus a
        `systemctl restart cc-slackd` updates the daemon and silently un-deploys every cc-slack change for every
        session already open. On 2026-08-31 a retired session posted into a channel 45 s after its cutover: the
        mute that would have refused it had been deployed hours earlier, into a file that process no longer read."""
        try:
            now = os.path.realpath(SELF_LINK)   # the ~/bin symlink may point somewhere new since we started
            return now != SELF or os.path.getmtime(now) != SELF_MTIME
        except OSError:
            return False                        # mid-install the file can be briefly absent: ask again next time

    def should_reexec(self, method):
        """Only between requests, and only after a tools/call: there the host has our answer and is waiting on
        nothing, so becoming a new process loses nothing. During the handshake it would drop a message the host
        sends exactly once — and that message is what subscribes this session to Slack."""
        return method == "tools/call" and self.stale()

    def reexec(self):
        """Same pid, same stdin and stdout: a stdio server can step into the deployed copy without the host
        noticing. Cheap enough to need no machinery — no version negotiation, no state to carry, no restart."""
        log(f"channel: {SELF_LINK} was redeployed — re-exec into it")
        try:
            sys.stdout.buffer.flush()
            os.execve(sys.executable, [sys.executable, SELF_LINK] + sys.argv[1:], {**os.environ, REEXEC: "1"})
        except Exception as e:
            log(f"channel: re-exec failed ({e!r}) — carrying on with the code we have")

    async def handle(self, msg):
        m, id_, p = msg.get("method"), msg.get("id"), msg.get("params") or {}
        if m == "initialize":
            pv = p.get("protocolVersion", "2025-06-18")
            if pv not in ("2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"):
                pv = "2025-06-18"
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {
                "protocolVersion": pv,
                "capabilities": {"tools": {}, "experimental": {"claude/channel": {}, "claude/channel/permission": {}}},
                "serverInfo": {"name": "cc-slack", "version": VERSION}, "instructions": INSTRUCTIONS}})
        elif m == "notifications/initialized":
            if not self.link_started:   # 2026-08-27: subscribing at process start raced the handshake — a queued DM was flushed and silently dropped
                self.link_started = True
                self.aio.create_task(self._link_when_ready())
        elif m == "ping":
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {}})
        elif m == "tools/list":
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {"tools": TOOLS}})
        elif m == "tools/call":
            text, err = await self.aio.to_thread(self.call, p.get("name"), p.get("arguments") or {})
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {"content": [{"type": "text", "text": text}], "isError": err}})
        elif m == "notifications/claude/channel/permission_request":
            await self.to_daemon({"type": "permission_request", **{k: str(v) for k, v in p.items()}})
        elif m and m.startswith("notifications/"):
            pass
        elif id_ is not None:
            await self.send({"jsonrpc": "2.0", "id": id_, "error": {"code": -32601, "message": f"unknown method {m}"}})

    def muted(self):
        """The non-live side of an open handoff may READ Slack and must not speak into it. The daemon's mute
        covers what it hands us; these tools call the Slack API straight from this process, so they carry
        their own. An orch is not a side of the handoff (it has its own channel), and is never muted."""
        if self.alias:
            return False
        rec = handoff_record(self.target)
        return rec is not None and handoff_muted(rec, self.handoff)

    def call(self, name, a):
        if os.environ.get("CC_ROLE") == "worker":
            return "Slack tools are for interactive sessions", True   # a --go worker must not post to the owner's channels
        if self.member:
            return self.member_call(name, a)
        if name in ("reply", "react", "file") and self.muted():
            return ("not sent — a handoff overlap is open on this target and the OTHER session is live: it owns the "
                    "channel until the cutover, so nothing you post here would be the box's one voice. Read the "
                    "thread, ask it what you need, and speak once you are live (`cc-handoff --status`)."), True
        try:
            if name == "reply":
                chat = a.get("chat_id") or ""
                # WHAT THE MESSAGE WILL ACTUALLY DO, computed before it goes: an @handle that resolves to nobody is
                # sent as code (never as a plain "@Name" that reads like a ping) and named back to this session in
                # the tool result. Silence here is what let an escalation reach nobody with the sender none the wiser.
                missed = unresolved_mentions(self.cfg, a.get("text", ""), chat if chat != "local" else None)
                n, _ = post(self.cfg, chat, a.get("text", ""), a.get("thread_ts") or None, username=display_name(self.target, self.alias))
                if a.get("ts"):
                    react(self.cfg, chat, a["ts"], "eyes", remove=True)   # V2: the 👀 comes off, nothing replaces it
                root = a.get("thread_ts") or a.get("ts")
                # THE SENDER DECIDES. ❓ = NEEDS YOU, and this session saying needs_owner is the only thing that puts a
                # thread there — apart from the two forms the box emits itself (asks_owner). Nothing is read out of the
                # prose. ("local" is the box's own inject path, not Slack: nothing to mark.)
                if root and chat != "local" and (bool(a.get("needs_owner")) or asks_owner(a.get("text", ""))):
                    self.tell_daemon({"type": "asked", "chat": chat, "root": root})   # the ONE writer times it: the sweep agrees
                    react(self.cfg, chat, root, STATUS_EMOJI["🔴"], remove=True)   # at most ONE mark: their 🔴 goes first
                    react(self.cfg, chat, root, STATUS_EMOJI["🟠"], remove=True)   # … and a 🟠 too (an ask after a handled thread)
                    react(self.cfg, chat, root, STATUS_EMOJI["❓"])                 # …and the owner sees it now, not in ≤45 s
                return ((f"sent ({n} message(s))" if n else "logged to ~/.cc/slack/outbox.log (no SLACK_BOT_TOKEN)")
                        + mention_warning(missed)), False
            if name == "file":
                chat = a.get("chat_id") or ""
                try:
                    path = check_upload_path(a.get("path", ""))
                    fid, _ = upload_file(self.cfg, path, chat, a.get("thread_ts") or None,
                                         comment=a.get("text") or None, title=a.get("title") or None)
                except UploadRefused as e:
                    return f"not sent — {e}", True
                if a.get("ts"):
                    react(self.cfg, chat, a["ts"], "eyes", remove=True)   # the file IS the answer: their 👀 comes off
                if not fid:
                    return (f"NOT sent to Slack — logged to {DIR}/outbox.log (no SLACK_BOT_TOKEN, or chat_id=local); "
                            "nothing reached anyone, so do not say the file arrived"), False
                missed = unresolved_mentions(self.cfg, a.get("text") or "", chat)
                return (f"sent {os.path.basename(path)}" + (" in the thread" if a.get("thread_ts") else "")
                        + mention_warning(missed)), False
            if name == "react":
                chat, ts, emoji = a.get("chat_id", ""), a.get("ts", ""), str(a.get("emoji", "eyes"))
                react(self.cfg, chat, ts, emoji, thread=a.get("thread_ts") or None)
                if ts and emoji.strip(":") not in ("eyes", "👀"):
                    react(self.cfg, chat, ts, "eyes", remove=True)   # this reaction IS our answer: the "received" 👀 comes off
                if emoji.strip(":") in SESSION_MARKS:
                    self.tell_daemon({"type": "mark", "chat": chat, "ts": ts, "name": emoji.strip(":")})   # ✅/🔧: the daemon times it
                return "ok", False
            if name == "history":
                tok = self.cfg.get("SLACK_BOT_TOKEN")
                if not tok:
                    return "no SLACK_BOT_TOKEN", True
                chat = resolve_chat(self.cfg, a.get("chat_id", ""))
                msgs = api("conversations.history", tok, channel=chat, limit=str(clamp_n(str(a.get("n", "")), 20, 100)))["messages"]
                return fmt_history(self.cfg, list(reversed(msgs))), False
            if name == "thread":
                tok = self.cfg.get("SLACK_BOT_TOKEN")
                if not tok:
                    return "no SLACK_BOT_TOKEN", True
                chat = resolve_chat(self.cfg, a.get("chat_id", ""))
                msgs = replies_tail(self.cfg, chat, a.get("ts", ""), clamp_n(str(a.get("n", "")), 50, 50))
                return fmt_history(self.cfg, msgs), False
            return f"unknown tool {name}", True
        except Exception as e:
            return f"failed: {e}", True

    def member_call(self, name, a):
        """Inside the boundary the daemon makes the Slack call, scoped to this workspace's channels (Daemon.member_verb)."""
        req = {name: a.get("chat_id") or "", "target": self.target}
        if name == "reply":
            req.update(text=a.get("text", ""), thread_ts=a.get("thread_ts") or None, ts=a.get("ts") or "", needs_owner=bool(a.get("needs_owner")))
        elif name == "react":
            req.update(ts=a.get("ts", ""), emoji=str(a.get("emoji", "eyes")), thread_ts=a.get("thread_ts") or None)
        elif name == "file":
            try:
                req.update(path=check_upload_path(a.get("path", "")), thread_ts=a.get("thread_ts") or None, ts=a.get("ts") or "",
                           text=a.get("text") or None, title=a.get("title") or None)
            except UploadRefused as e:
                return f"not sent — {e}", True
        elif name in ("history", "thread"):
            req.update(n=a.get("n"), ts=a.get("ts", ""))
        else:
            return f"unknown tool {name}", True
        try:
            r = sock_request(req, timeout=120)
        except Exception as e:
            return f"the box's Slack link did not answer ({e.__class__.__name__}) — nothing was sent", True
        return (r.get("text") or r.get("error") or ""), not r.get("ok")

    async def to_daemon(self, obj):
        if self.link:
            try:
                self.link.write((json.dumps(obj) + "\n").encode()); await self.link.drain(); return
            except Exception:
                pass
        log(f"no daemon link; dropped {obj.get('type')}")

    def tell_daemon(self, obj):
        """to_daemon from a tool call, which runs on a worker thread: hand the write to the loop; never blocks the tool."""
        loop = getattr(self, "loop", None)
        if loop is None:
            log(f"no loop yet; dropped {obj.get('type')}"); return
        self.aio.run_coroutine_threadsafe(self.to_daemon(obj), loop)

    async def _link_when_ready(self):
        await self.aio.sleep(2)
        await self.daemon_link()

    async def daemon_link(self):
        if os.environ.get("CC_SLACK_CHANNEL") != "1":     # set by cc/cc-rc next to --dangerously-load-development-channels
            log("session was not started as a channel session (CC_SLACK_CHANNEL unset): tools only, no Slack subscription")
            return
        while True:
            try:
                r, w = await self.aio.open_unix_connection(SOCK)
                self.link = w
                w.write((json.dumps({"hello": self.target, "alias": self.alias, "handoff": self.handoff,
                                     "pid": os.getpid()}) + "\n").encode()); await w.drain()
                if self.daemon_ok is not True:
                    log(f"linked to cc-slackd as {self.target}"); self.daemon_ok = True
                while True:
                    line = await r.readline()
                    if not line:
                        break
                    ev = json.loads(line)
                    if ev.get("type") == "message":
                        await self.send({"jsonrpc": "2.0", "method": "notifications/claude/channel",
                                         "params": {"content": ev.get("content", ""), "meta": {k: str(v) for k, v in (ev.get("meta") or {}).items()}}})
                    elif ev.get("type") == "permission":
                        await self.send({"jsonrpc": "2.0", "method": "notifications/claude/channel/permission",
                                         "params": {"request_id": ev.get("request_id"), "behavior": ev.get("behavior")}})
            except Exception as e:
                if self.daemon_ok is not False:
                    log(f"cc-slackd not reachable ({e.__class__.__name__}); retrying — start it with: cc slack on"); self.daemon_ok = False
            self.link = None
            await self.aio.sleep(3)


# ---------------------------------------------------------------- CLI
def cmd_status():
    cfg = load_cfg()
    print(f"tokens: bot {'set' if cfg.get('SLACK_BOT_TOKEN') else 'MISSING'}, app {'set' if cfg.get('SLACK_APP_TOKEN') else 'MISSING'}; "
          f"owner: {cfg.get('SLACK_OWNER_ID') or 'not paired'}; sessions get the channel: {'yes' if os.path.exists(f'{DIR}/enabled') else 'no (cc slack on)'}")
    print("who is heard: channels — anyone who can post in one that routes to a session, reactions included (a member's "
          ":+1:/🏁 counts as the owner's); DMs — the owner only. "
          "Only the owner answers permission prompts, runs `!` commands beyond !help/!status, and passes the box's owner gates.")
    print(f"policy: every channel the bot is in answers — one with no project yet gets ~/dev/<name> on its first message "
          f"(member-facing, max {PROVISION_MAX}/h); DMs are the owner's alone; #{APPROVALS}/#{ALERTS} are not sessions.")
    try:
        cid, member = find_channel(cfg, APPROVALS) if cfg.get("SLACK_BOT_TOKEN") else (None, False)
        print(f"approvals: #{APPROVALS} {cid} — a :+1: from anyone in that channel on a PR post squash-merges it" if cid and member
              else f"approvals: no #{APPROVALS} channel the bot is in (cc slack mkchannel {APPROVALS})")
    except Exception as e:
        print(f"approvals: lookup failed ({e})")
    try:
        st = sock_request({"status": True})
    except Exception as e:
        print(f"daemon: not running ({e.__class__.__name__}) — cc slack on"); return 1
    print(f"daemon: up {st['uptime']}s, slack {'connected' if st['connected'] else ('off' if not st['slack'] else 'DISCONNECTED')}"
          f"{', bot ' + st['bot_user'] if st.get('bot_user') else ''}")
    if st.get("pair_code"):
        print(f"PAIRING: DM the bot in Slack:  pair {st['pair_code']}")
    print(f"subscribed sessions: {fmt_subs(st['subs'])}   queued: {st['queued'] or 'none'}")
    return 0


def fmt_subs(subs):
    """{target: [alias|None, ...]} -> 'myrepo [main], myrepo@ai-dev' for `cc slack status` / `!sessions`."""
    return ", ".join(f"{t}@{a}" if a else f"{t} [main]" for t, aliases in subs.items() for a in aliases) or "none"


def cmd_channels():
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("no SLACK_BOT_TOKEN"); return 1
    routes, prov, orchs = load_routes(), load_provisioned(), load_orchs()
    cur, rows = None, []
    while True:
        r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
        for ch in r["channels"]:
            if not ch.get("is_member"):
                continue
            t = routes.get(ch["id"]) or routes.get("#" + ch["name"]) or ch["name"].replace("--", "/", 1)
            base = main_lane(ch["name"])
            if not (routes.get(ch["id"]) or routes.get("#" + ch["name"])) and base and valid_target(base.replace("--", "/", 1)):
                t = base.replace("--", "/", 1)               # an -updates lane is the same session, other lane (Daemon.route)
            if valid_target(t):
                shown = t + (" [updates lane]" if main_lane(ch["name"]) == t.replace("/", "--") else "")
            elif ch["id"] in orchs or ch["name"] in (APPROVALS, ALERTS) or not chan_target(t) or "/" in chan_target(t):
                shown = f"(unmapped: {t})"
            else:                                    # a channel that has no dir yet still answers: it gets one on its first message
                shown = f"{chan_target(t)} (dir on first message)"
            if prov.get(t if valid_target(t) else chan_target(t) or ""):
                shown += " [auto-provisioned]"
            rows.append((ch["name"], ch["id"], shown, bool(ch.get("is_private"))))
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            break
    for name, cid, t, priv in sorted(rows):
        # no API converts a public channel (Slack's admin.conversations.convertToPrivate is Enterprise Grid only): the owner does it
        print(f"#{name:<24} {cid:<14} → {t}" + ("" if priv else "   (public — change to private in Slack: channel → Settings → Change to private)"))
    print(f"{len(rows)} channel(s) the bot is in. Invite it to more with /invite @<bot> in Slack.")
    print("Anyone who can post in one of these reaches that session — the membership of the channel is the access control.")
    print(f"[auto-provisioned] = the box created ~/dev/<name> for that channel (member-facing, read-only outside its own dir); "
          f"at most {PROVISION_MAX} such dirs an hour.")
    return 0


def cmd_setup(argv):
    bot = app = email = None
    i = 0
    while i < len(argv):
        if argv[i] == "--bot":
            bot = argv[i + 1]; i += 2
        elif argv[i] == "--app":
            app = argv[i + 1]; i += 2
        elif argv[i] == "--owner-email":
            email = argv[i + 1]; i += 2
        else:
            i += 1
    if bot or app:
        if bot:
            set_cfg("SLACK_BOT_TOKEN", bot)
        if app:
            set_cfg("SLACK_APP_TOKEN", app)
        print("tokens saved to ~/.cc/config")
    cfg = load_cfg()
    if cfg.get("SLACK_BOT_TOKEN"):
        try:
            a = api("auth.test", cfg["SLACK_BOT_TOKEN"])
            print(f"bot token OK: {a.get('user')} in workspace {a.get('team')}")
        except Exception as e:
            print(f"bot token FAILED: {e}")
    if cfg.get("SLACK_APP_TOKEN"):
        try:
            api("apps.connections.open", cfg["SLACK_APP_TOKEN"]); print("app token OK (Socket Mode)")
        except Exception as e:
            print(f"app token FAILED: {e}")
    if email and cfg.get("SLACK_BOT_TOKEN"):
        try:
            uid = api("users.lookupByEmail", cfg["SLACK_BOT_TOKEN"], email=email)["user"]["id"]
            set_cfg("SLACK_OWNER_ID", uid); print(f"owner set to {uid} ({email}) — no pairing needed")
        except Exception as e:
            print(f"owner lookup FAILED: {e} (pair by DM instead)")
    if bot or app or email:
        subprocess.run(["systemctl", "--user", "try-restart", "cc-slackd.service"], capture_output=True)
    if not (cfg.get("SLACK_BOT_TOKEN") and cfg.get("SLACK_APP_TOKEN")):
        print(f"""Create the Slack app (once, ~3 minutes):
  1. https://api.slack.com/apps → Create New App → From a manifest → pick your workspace →
     paste {ROOT}/slack/app-manifest.json (replace <box> in it with this box's name) → Create.
  2. Basic Information → App-Level Tokens → Generate Token: name "socket", scope connections:write → copy xapp-…
  3. Install App → Install to Workspace → copy the Bot User OAuth Token xoxb-…
  4. On the box:  cc slack setup --bot xoxb-… --app xapp-… --owner-email you@example.com    then  cc slack on
     (without --owner-email: DM the bot  pair <code>  — code from: cc slack status)
  5. cc slack mkchannel <repo> <repo> …   one PRIVATE channel per project (--public opts out), invites you, sets the topic.
     Whoever you add to a channel can talk to that session; a DM only ever reaches you. `cc slack status` restates it.
     DMs (or #box) reach the box session; #<repo>--<track> reaches a track session.""")
    return 0


def cmd_post(argv):
    cfg = load_cfg()
    chan = thread = route = None
    mention = major = False
    args = []
    i = 0
    while i < len(argv):
        if argv[i] == "--mention":
            mention = True; i += 1
        elif argv[i] in ("--major", "--main"):
            major = True; i += 1
        elif argv[i] == "-c":
            chan = argv[i + 1]; i += 2
        elif argv[i] == "--thread":
            thread = argv[i + 1]; i += 2
        elif argv[i] == "--route":
            route = argv[i + 1]; i += 2
        else:
            args.append(argv[i]); i += 1
    text = " ".join(args) if args else sys.stdin.read()
    if os.environ.get("CC_MEMBER_SANDBOX") == "1":   # inside a boundary (cc-guard's 🔐 line, cc's budget notice): the member socket, scoped
        try:
            r = sock_request({"reply": chan or "", "text": text, "thread_ts": thread}, timeout=60)
        except Exception as e:
            print(f"cc-slack post: the member socket did not answer ({e.__class__.__name__})", file=sys.stderr); return 3
        print("" if r.get("ok") else r.get("error", ""), file=sys.stdout if r.get("ok") else sys.stderr); return 0 if r.get("ok") else 3
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    if route and not chan:
        # AN AUTOMATED POST IS AN UPDATE (owner, 2026-09-01). --route is the machinery's door — cc-notify, landings,
        # digests, milestones — so it aims at the -updates lane whenever the box is in one, and falls back to today's
        # channel where there is none. `-c` is untouched: a reply goes where the question was asked, never here.
        words = route.strip().lstrip("[").split()
        # BOX, not socket.gethostname(): "everything else titles on CC_BOX" (audit 2026-09-01, F6) — cc-notify
        # builds its title from CC_BOX, so on a box that overrides it this asked the kernel, got a different name
        # and sent "<box> limit" to a project channel instead of #alerts.
        if len(words) >= 2 and words[1].lower() in ALERT_KINDS and words[0].lower() in (BOX.lower(), "box"):
            chan = "#" + (cfg.get("SLACK_ALERTS") or ALERTS)   # "<box> boot|limit|audit|review": machinery, never a project thread
            if not mention and words[1].lower() in UPDATE_KINDS and resolve_channel(cfg, updates_name(words[0])):
                chan = "#" + updates_name(words[0])            # …but a digest is PROGRESS: the box's own updates lane, #alerts only if it has none
        else:
            name = re.split(r"[/\s\]]", route.strip().lstrip("["), maxsplit=1)[0].lower()   # "[repo] PR #n …" (landing titles) → repo
            chan = "#" + (updates_name(name) if not mention and resolve_channel(cfg, updates_name(name)) else name) if name else None
    if chan and chan.startswith("#") and not (mention or thread or major):
        # THE MAIN LANE IS THE OWNER'S (owner, 2026-09-01, after a routine cross-session bug report sat in a main
        # channel three hours after the split): -c '#<repo>' takes a question, a decision for him, or a MAJOR update —
        # nothing routine.
        # A question is a '?', a decision is a ❓ or an @-mention (inline, or --mention: rung 1), and major is the
        # caller's own deliberate word, --major. Everything else is redirected to the -updates twin when the box has
        # one. A --thread post is a reply and stays where its thread is; a raw C… id is the reply tool's door, not gated.
        name = chan[1:].lower()
        if lane_split(name) and routine_text(text) and resolve_channel(cfg, updates_name(name)):
            print(f"cc-slack: routine → #{updates_name(name)} (#{name} takes a question, a decision or --major)", file=sys.stderr)
            chan = "#" + updates_name(name)
    if chan and chan.startswith("#"):
        chan = resolve_channel(cfg, chan[1:])
    if not chan:                                     # no project channel for this title: machinery notices go to #alerts, then SLACK_CHANNEL
        chan = resolve_channel(cfg, cfg.get("SLACK_ALERTS") or ALERTS) or cfg.get("SLACK_CHANNEL")
    if not chan:
        print("cc-slack post: no channel (use -c, --route with a matching #channel, or SLACK_CHANNEL)", file=sys.stderr); return 3
    if chan.startswith("#"):
        chan = resolve_channel(cfg, chan[1:]) or chan
    if mention and cfg.get("SLACK_OWNER_ID"):
        # RUNG 1 of the ladder: an @-mention in the MAIN channel is "you, NOW" — the raw <@U…> form, because it has to
        # notify for real and no caller here knows the owner's handle. Unpaired, the post still goes to the main lane.
        text = f"<@{cfg['SLACK_OWNER_ID']}> {text}"
    missed = unresolved_mentions(cfg, text, chan)
    n, ts = post(cfg, chan, text, thread)
    print(ts or "")
    if missed:                                       # stderr, so a caller piping the ts is unaffected and a human still sees it
        print("cc-slack:" + mention_warning(missed).strip(), file=sys.stderr)
    return 0


def cmd_post_file(argv):
    """post --file PATH [--to C…|U…|#name] [--thread TS] [--title T] [-m TEXT] — the upload_file() helper, the same one the
    channel server's `file` tool uses. Default target: the owner's DM. Pure Web API. Exit 2 usage/refused, 3 no token, 1 API error."""
    usage = "cc-slack post --file <path> [--to <channel-or-user-id|#name>] [--thread <ts>] [--title <t>] [-m|--text <msg>]"
    cfg = load_cfg(); opt = {"--file": None, "--to": None, "--thread": None, "--title": None, "-m": None}
    i = 0
    while i + 1 < len(argv) and argv[i] in ("--file", "--to", "--thread", "--title", "-m", "--text"):
        opt["-m" if argv[i] == "--text" else argv[i]] = argv[i + 1]; i += 2
    path = opt["--file"]
    if i != len(argv) or not path or not os.path.isfile(path):
        print(usage, file=sys.stderr); return 2
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post --file: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    try:
        fid, to = upload_file(cfg, path, opt["--to"], opt["--thread"], comment=opt["-m"], title=opt["--title"])
    except UploadRefused as e:
        print(f"cc-slack post --file: {e}", file=sys.stderr); return 2
    except Exception as e:
        tgt = opt["--to"] or "the owner's DM"
        hint = {"missing_scope": "the installed app lacks a scope (files:write to upload, im:write to DM): cc-slack manifest …, then Reinstall the app",
                "not_in_channel": f"the bot is not a member of {tgt}: /invite it there, or cc-slack mkchannel <name>",
                "channel_not_found": f"no channel {tgt}: give a C…/D… id, a U… user id, or #name of a channel the bot is in"}
        err = str(e)
        print(f"cc-slack post --file failed: {err}. {next((h for k, h in hint.items() if k in err), '')}".strip(), file=sys.stderr); return 1
    print(f"ok file={fid} channel={to}"); return 0


def find_channel(cfg, name):
    """#name → (id, is_member) across all channels the bot can see, or (None, False)."""
    cur = None
    while True:
        r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
        for ch in r["channels"]:
            if ch["name"] == name:
                return ch["id"], bool(ch.get("is_member"))
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            return None, False


class ChannelExists(RuntimeError):
    """#name is taken by a channel the bot cannot see. conversations.list only lists private channels the bot is IN, so an
    existing private #name looks absent and conversations.create answers name_taken: actionable for the owner, never a crash."""


def channel_members(cfg, chat):
    """Every user id in a channel (conversations.members, cursor-paged)."""
    out, cur = [], None
    while True:
        r = api("conversations.members", cfg["SLACK_BOT_TOKEN"], channel=chat, limit="200", cursor=cur)
        out += r.get("members") or []
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            return out


def inherit_members(cfg, parent, cid, name):
    """A channel the box creates under another one starts with the parent's PEOPLE already in it — the point of a private
    channel is that the right humans are in it from the first message, not after someone remembers to invite them.
    One conversations.invite for all of them; bots and apps are dropped (they are not the audience, and one bad id fails
    the whole call). Best effort by design: a failed inherit logs one line and never fails the channel that was created."""
    tok = cfg["SLACK_BOT_TOKEN"]
    try:
        users = []
        for uid in channel_members(cfg, parent):
            try:
                u = api("users.info", tok, user=uid)["user"]
            except Exception:
                continue                       # cannot tell what it is → never invite it
            if not (u.get("is_bot") or u.get("is_app_user") or u.get("deleted") or uid == "USLACKBOT"):
                users.append(uid)
        if not users:
            return 0
        try:
            api("conversations.invite", tok, channel=cid, users=",".join(users))
        except RuntimeError as e:
            if not any(w in str(e) for w in ("already_in_channel", "cant_invite_self")):
                raise
        log(f"#{name}: inherited {len(users)} member(s) from the parent channel")
        return len(users)
    except Exception as e:
        log(f"#{name}: could not inherit the parent channel's members ({e!r}) — invite them in Slack")
        return 0


def ensure_channel(cfg, name, private=True, parent=None, invite=()):
    """#name exists, the bot is in it and the owner is invited → (id, "created"|"joined"|"member"). One place for it:
    `mkchannel` and a sub-orch's own channel are the same three calls (channels:manage / groups:write cover all of them).
    PRIVATE by default: what the box creates is visible to the people invited to it, and those people ARE who the session
    there answers. `parent` (a channel id) hands the new channel the parent's humans — on creation only, never a re-sync.
    `invite` = ids to put in alongside the owner (a member, for their own workspace and project channels). THE OWNER IS
    NEVER OPTIONAL: every channel the box makes for somebody else is a channel he is in."""
    tok = cfg["SLACK_BOT_TOKEN"]
    cid, member = find_channel(cfg, name)
    how = "member"
    if not cid:
        try:
            cid = api("conversations.create", tok, name=name, is_private="true" if private else "false")["channel"]["id"]; how = "created"
        except RuntimeError as e:
            if "name_taken" not in str(e):
                raise
            raise ChannelExists(f"#{name} exists as a private channel the bot cannot see — invite the bot to it in Slack, then re-run") from None
        if parent:
            inherit_members(cfg, parent, cid, name)   # before the owner invite: one clean batch into an empty channel
    elif not member:
        api("conversations.join", tok, channel=cid); how = "joined"
    for who in [cfg.get("SLACK_OWNER_ID")] + [u for u in invite if u]:
        if not who:
            continue
        try:
            api("conversations.invite", tok, channel=cid, users=who)
        except RuntimeError as e:
            if "already_in_channel" not in str(e):
                log(f"invite {who} to #{name}: {e}")
    try:
        os.unlink(f"{DIR}/channels.json")            # the name→id cache predates this channel
    except FileNotFoundError:
        pass
    return cid, how


def lane_topic(name, target):
    """Topic of an -updates lane: what it is for, and where the other half of the conversation lives."""
    return (f"→ Claude session `{target}` on {BOX} — the UPDATES lane: digests, milestones, progress, audits, janitor "
            f"lines, anything automated. Questions, answers and decisions belong in #{name}.")


def ensure_updates_lane(cfg, name, cid, private=True):
    """#<name>-updates exists, the bot is in it, it starts with #<name>'s people and its topic says what it is for.
    Returns (id, "created"|"joined"|"member"). IDEMPOTENT, which is what lets this be both the tail of `mkchannel` and
    the whole of `updates-sweep`: the lane routes to the same session by NAME (Daemon.route strips the suffix), so
    there is no table that a second run could get out of step."""
    un = updates_name(name)
    ucid, how = ensure_channel(cfg, un, private, cid)
    with contextlib.suppress(RuntimeError):
        api("conversations.setTopic", cfg["SLACK_BOT_TOKEN"], channel=ucid,
            topic=lane_topic(name, name.replace("--", "/", 1)))
    return ucid, how


def archive_channel(cfg, cid, orchs=None):
    """conversations.archive + mark it archived in the routing table (the caller saves). Already archived / gone counts as
    done; any other refusal leaves the entry alone, so the channel keeps routing instead of going silently deaf."""
    ok = True
    try:
        api("conversations.archive", cfg["SLACK_BOT_TOKEN"], channel=cid)
    except Exception as e:
        ok = any(w in str(e) for w in ("already_archived", "channel_not_found"))
        if not ok:
            log(f"archive {cid}: {e!r}")
    if ok and orchs is not None and cid in orchs:
        orchs[cid]["archived"] = True
    return ok


def cmd_mkchannel(argv):
    cfg = load_cfg(); tok = cfg.get("SLACK_BOT_TOKEN")
    if not tok:
        print("no SLACK_BOT_TOKEN — cc slack setup first"); return 1
    private = "--public" not in argv       # private by default; --private is still accepted and is now a no-op
    names = [a.lstrip("#").lower() for a in argv if not a.startswith("--")]
    if not names:
        print("cc-slack mkchannel <name>… [--public]"); return 2
    rc = 0
    for name in names:
        parent = None
        if "--" in name:                   # #<repo>--<sub> under an existing #<repo>: start it with #<repo>'s people
            with contextlib.suppress(Exception):
                parent = find_channel(cfg, name.split("--", 1)[0])[0]
        try:
            cid, how = ensure_channel(cfg, name, private, parent)
        except ChannelExists as e:
            print(e); rc = 1; continue
        print(f"created {'private' if private else 'public'} #{name} ({cid})" + (f", with #{name.split('--', 1)[0]}'s members" if parent else "")
              if how == "created" else f"joined existing #{name}" if how == "joined" else f"#{name} exists, bot is a member")
        target = name.replace("--", "/", 1)
        try:
            api("conversations.setTopic", tok, channel=cid,
                topic=f"→ Claude session `{target}` on {BOX} — messages here reach it, replies come back in threads" if valid_target(target)
                else f"{BOX} PRs land here — :+1: from anyone in this channel squash-merges" if name == APPROVALS
                else f"{BOX} machinery notices: boots, power, Claude usage limits, audits, digests — nothing here needs a reply" if name == ALERTS
                else f"{BOX} — no project with this name on the box (rename, or add a route in ~/.cc/slack/routes.json)")
        except RuntimeError as e:
            print(f"  topic: {e}")
        print(f"  #{name} → {target if valid_target(target) else '(PR approvals)' if name == APPROVALS else '(unmapped)'}")
        if not lane_split(name):
            continue
        try:                                     # a repo channel is a PAIR: the sibling comes with it, never separately
            ucid, uhow = ensure_updates_lane(cfg, name, cid, private)
        except ChannelExists as e:
            print(f"  {e}"); rc = 1; continue
        except Exception as e:
            print(f"  #{updates_name(name)}: {e}"); rc = 1; continue
        print(f"  #{updates_name(name)} ({ucid}) {'created' if uhow == 'created' else 'already there'} → {target} "
              f"— the updates lane: automated posts and depth, so #{name} stays one sentence per idea")
    print("Anyone you add to a channel can talk to that session and their reactions count as yours (:+1: merges, 🏁 closes); "
          "only you answer permission prompts and the owner gates.")
    return rc


def resolve_user(cfg, who):
    """A user id out of what a person types: `<@U123>`, `<@U123|name>`, `U123`, `@handle`, or a bare handle."""
    t = (who or "").strip().lstrip("<").rstrip(">").split("|")[0].lstrip("@").strip()
    if re.fullmatch(r"[UW][A-Z0-9]{6,}", t):
        return t
    table = user_table(cfg)
    return table.get(t.lower()) or table.get(member_handle(t))


def cmd_member(argv):
    """`cc-slack member add <@user>…` — the owner's hand-run half of a team_join. Same ensure_member, same
    idempotence: running it on somebody who already has a workspace prints so and changes nothing. Exempt from the
    hourly provisioning cap — the cap is there to bound a channel-creation spree, and this is the owner typing.

    `member instructions <handle>` is the other half: the member instructions into a workspace no join flow made
    (`cc-sandbox convert` calls it). No token, no Slack, no member record — one README."""
    if argv[:1] == ["instructions"]:
        # For a workspace no join flow made: `cc-sandbox convert` writes the markers itself, so nothing ever wrote
        # the member instructions into it. No token and no Slack — this touches that one workspace's README.
        if len(argv) != 2:
            print("cc-slack member instructions <handle>", file=sys.stderr); return 2
        h = argv[1]
        if not os.path.isfile(f"{DEV}/{h}/{MEMBER_MARKER}"):
            print(f"~/dev/{h} is not a member workspace — nothing was written", file=sys.stderr); return 1
        print({"wrote": "README.md: the member instructions — how a project channel is made, and by whom",
               "merged": "README.md: the member instructions appended, under the README that was already there",
               "kept": "README.md: it already says how a project channel is made — left as it is",
               }[ensure_member_readme(h, h)])
        return 0
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("no SLACK_BOT_TOKEN — cc slack setup first", file=sys.stderr); return 1
    if len(argv) < 2 or argv[0] != "add":
        print("cc-slack member add <@user>… | member instructions <handle>", file=sys.stderr); return 2
    rc = 0
    for who in argv[1:]:
        uid = resolve_user(cfg, who)
        if not uid:
            print(f"{who}: no such person in this workspace (give <@U…> or their handle)", file=sys.stderr); rc = 1; continue
        try:
            status, handle, msg = ensure_member(cfg, uid, by="owner")
        except Exception as e:
            print(f"{who}: {e.__class__.__name__}: {e}", file=sys.stderr); rc = 1; continue
        print(f"{who} → {status}: {msg}")
        if status == "refused":
            rc = 1
    return rc


def member_projects(handle):
    """Project channels this workspace has, from its own board — one shell-out, and none if it has no board yet."""
    try:
        r = EFFECTS.run([f"{BIN}/cc-board", "json", handle], capture_output=True, text=True,
                        stdin=subprocess.DEVNULL, timeout=15)
        return sorted((json.loads(r.stdout) or {}).get("tracks") or {})
    except Exception:
        return []


def cmd_members():
    """handle → channel(s) → workspace → budget used today: who the box has let in, and what they have spent."""
    cfg = load_cfg(); members = load_members(); cap = member_budget(cfg)
    if not members:
        print("no member workspaces yet — `cc-slack member add <@user>`, or let a team_join make one"); return 0
    for h in sorted(members):
        e = members[h]
        chans = [f"#{e.get('chan') or h}", f"#{e.get('updates') or updates_name(h)}"]
        chans += [f"#{h}--{p}" for p in member_projects(h)]
        print(f"{h:<16} {e.get('uid') or '?':<12} ~/dev/{h:<16} ${member_spent(h):.2f}/${cap:.2f} today")
        print(f"{'':<16} {', '.join(chans)}")
    print("The owner is in every one of those channels. No member session runs yet: it starts inside the sandbox "
          "(docs/design-member-workspaces.md).")
    return 0


def cmd_updates_sweep(argv):
    """updates-sweep [--dry-run] — give every repo channel the bot is in its -updates sibling. Idempotent, so this is
    the ONE-SHOT for channels that predate the split; anything made after it gets the lane from `mkchannel`. Skipped:
    #approvals and #alerts (they keep their own jobs), a lane itself, a `#<repo>--<track>` channel and a sub-orch
    channel — each of those is already somebody's detail lane and inherits the cap instead of being split again —
    and any channel whose only member is the bot (#cc-vitals-store), which is a store, not a place people talk."""
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("no SLACK_BOT_TOKEN — cc slack setup first", file=sys.stderr); return 1
    dry, orchs, cur, seen, rc = "--dry-run" in argv, load_orchs(), None, [], 0
    while True:
        r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
        seen += [(ch["name"], ch["id"]) for ch in r["channels"] if ch.get("is_member") and ch["id"] not in orchs]
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            break
    have = {n for n, _ in seen}
    todo = [(n, c) for n, c in sorted(seen) if lane_split(n) and not bot_only(cfg, c)]
    for name, cid in todo:
        un = updates_name(name)
        if dry:
            print(f"#{name} → #{un} {'(already there)' if un in have else '(would create)'}"); continue
        try:
            ucid, how = ensure_updates_lane(cfg, name, cid)
        except ChannelExists as e:
            print(e, file=sys.stderr); rc = 1; continue
        except Exception as e:
            print(f"#{un}: {e}", file=sys.stderr); rc = 1; continue
        print(f"#{un} ({ucid}) {how} → {name.replace('--', '/', 1)}")
    print(f"{len(todo)} repo channel(s); the rest are not split (#{APPROVALS}, #{ALERTS}, lanes, tracks, sub-orchs, bot-only stores).")
    return rc


def cmd_orch_channel(argv):
    """orch-channel <target> <alias> [--parent-alias <a>] [--brief <text>] — `cc <repo> --orch <alias>` calls this so the
    orch gets its own channel. The DAEMON does the work (it knows the parent thread and is the single writer of orchs.json);
    with no daemon there is simply no channel — the orch is still reachable as `@alias` in the repo channel."""
    opts, pos, i = {"--parent-alias": None, "--brief": ""}, [], 0
    while i < len(argv):
        if argv[i] in opts:
            opts[argv[i]] = argv[i + 1] if i + 1 < len(argv) else ""; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 2:
        print("cc-slack orch-channel <target> <alias> [--parent-alias <a>] [--brief <text>]", file=sys.stderr); return 2
    try:
        r = sock_request({"orch": pos[0], "alias": pos[1], "parent_alias": opts["--parent-alias"], "brief": opts["--brief"]}, timeout=60)
    except Exception as e:
        print(f"cc-slack orch-channel: daemon not running ({e.__class__.__name__}) — no channel, @{pos[1]} still works in #{pos[0]}", file=sys.stderr); return 1
    if not r.get("ok"):
        print(f"cc-slack orch-channel: {r.get('error')}", file=sys.stderr); return 1
    print(f"#{r.get('name')} ({r.get('channel')}){'' if r.get('created') else ' — already had one'}"); return 0


def cmd_archive(argv):
    """archive <#chan|C…> | --orch <target> <alias> — archive a sub-orch's channel and stop routing it. Plain Web API +
    the table on disk, so it works with the daemon down (that is the point: `cc` calls it when an orch session exits)."""
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack archive: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    orchs = load_orchs()
    if argv[:1] == ["--orch"]:
        if len(argv) != 3:
            print("cc-slack archive --orch <target> <alias>", file=sys.stderr); return 2
        cid = orch_lookup(orchs, argv[1], argv[2])
        if not cid:
            print(f"no live orch channel for {argv[1]}@{argv[2]} — nothing to archive"); return 0
    elif len(argv) == 1 and argv[0]:
        cid = argv[0] if re.fullmatch(r"[CG][A-Z0-9]+", argv[0]) else (find_channel(cfg, argv[0].lstrip("#").lower())[0] or "")
        if not cid:
            print(f"cc-slack archive: no channel {argv[0]}", file=sys.stderr); return 1
        if cid not in orchs:                             # this command archives SUB-ORCH channels; #<repo> and #alerts are not its business
            print(f"cc-slack archive: {argv[0]} is not a sub-orch channel (archive it in Slack if you mean it)", file=sys.stderr); return 1
    else:
        print("cc-slack archive <#chan|C…> | --orch <target> <alias>", file=sys.stderr); return 2
    with orchs_locked():
        orchs = load_orchs()
        ok = archive_channel(cfg, cid, orchs)
        save_orchs(orchs)
    print(f"{'archived' if ok else 'could NOT archive'} {cid}" + (f" (#{orchs[cid].get('name')})" if cid in orchs else ""))
    return 0 if ok else 1


LANDED_RE = re.compile(r"  ·  (?:landed ✓|closed ✗) \d\d:\d\dZ?$")    # a card that no longer reads as pending —
# the Z is optional so a card edited before the stamps went local is still recognised and not edited a second time
PENDING_TAIL = re.compile(r"\s+·\s+:\+1:.*$", re.S)                       # "  ·  :+1: from the owner merges (squash)"
SWEEP_EVERY = 900                                                        # approvals-sweep: one real sweep per 15 min unless --now
SWEEP_MAX = 40                                                           # …and at most this many edits per run: under Slack's rate limit, over in a minute


def approval_cards(cfg, cid, limit=200):
    """Every card in #approvals — a post of OURS matching "[repo] PR #n: …" — newest first, as (repo, n, message).
    Matches on our own user id, exactly as on_approval does, so a human's lookalike text is never a card. Raises
    when the channel cannot be read: the caller decides whether that means post anyway or touch nothing."""
    me = api("auth.test", cfg["SLACK_BOT_TOKEN"]).get("user_id")
    msgs = api("conversations.history", cfg["SLACK_BOT_TOKEN"], channel=cid, limit=str(limit))["messages"]
    out = []
    for m in msgs:
        g = PR_RE.match(m.get("text") or "")
        if g and m.get("user") == me:
            out.append((g.group(1), g.group(2), m))
    return out


def approval_card(cfg, cid, repo, n):
    """The card the daemon would merge on (the newest, if there are several), or None. Two actors reach a finished
    track (the loop when it ends, a session when it merges) and each used to post its own card; two cards mean two
    :+1:, two overlapping merges, and a "merge failed" for one that actually landed. #approvals is itself the record
    of who got there first, so ask it rather than keep state: a card the owner deleted is gone."""
    return next((m for r, k, m in approval_cards(cfg, cid) if r == repo and k == str(n)), None)


def approval_card_ts(cfg, cid, repo, n, limit=200):
    m = approval_card(cfg, cid, repo, n)
    return m.get("ts") if m else None


def iso_hhmm(s):
    """GitHub's "2026-09-01T04:33:58Z" → "21:33", the owner's clock; anything else → now."""
    return hhmm(s if isinstance(s, str) and re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d", s) else None)


def land_card(cfg, cid, m, state="MERGED", when=None):
    """Edit one card so it stops reading as pending — "… · landed ✓ 21:33" (the owner's clock) or "closed ✗", in place of the ":+1:
    from the owner merges" tail — and put :ok_hand: on a landed one. #approvals is a queue the owner reads on a phone:
    a card for a PR that is already in must not look like it still wants a 👍 (four of them did, 2026-09-01). The
    "[repo] PR #n:" head stays, so the card is still found and a late 👍 still reaches the landing, which says "already
    merged". Idempotent: an edited card is left alone. True when it edited."""
    text, ts = m.get("text") or "", m.get("ts")
    if LANDED_RE.search(text):
        return False
    tail = "  ·  landed ✓ " if state == "MERGED" else "  ·  closed ✗ "
    api("chat.update", cfg["SLACK_BOT_TOKEN"], channel=cid, ts=ts,
        text=PENDING_TAIL.sub("", text).rstrip() + tail + (when or hhmm()))
    if state == "MERGED":
        try:
            api("reactions.add", cfg["SLACK_BOT_TOKEN"], channel=cid, timestamp=ts, name="ok_hand")
        except Exception as e:
            if "already_reacted" not in str(e):
                raise
    return True


def pr_facts(repo, n):
    """{"state", "mergedAt", "closedAt"} from gh, or None (no such repo here, no network, no such PR)."""
    if not os.path.isdir(f"{DEV}/{repo}/.git"):
        return None
    try:
        r = subprocess.run(["gh", "pr", "view", str(n), "--json", "state,mergedAt,closedAt"], cwd=f"{DEV}/{repo}",
                           capture_output=True, text=True, timeout=30)
        return json.loads(r.stdout) if r.returncode == 0 else None
    except Exception:
        return None


def cmd_post_approval(argv):
    """post-approval [--force|--landed] <repo> <n|url> — "[repo] PR #n: title — url" into #approvals (the daemon merges it
    on the owner's :+1:). One card per PR: whoever gets there second finds the first and exits 0 without posting; --force
    posts regardless — after a FAILED merge the session is told to re-post. A PR GitHub says is MERGED or CLOSED never
    gets a card, --force or not (a re-run of the landing over an already-merged list posted six for one PR, 2026-09-01):
    the card it has is edited to "landed ✓" / "closed ✗" instead. --landed is that edit on the caller's word — the
    landing has just merged it, whatever gh has caught up to — and never posts. Prints the card's ts. Exit 2 usage,
    3 no token, 4 landed PR with no card (nothing to edit, nothing posted), 1 gh/Slack."""
    force, landed = "--force" in argv, "--landed" in argv
    argv = [a for a in argv if a not in ("--force", "--landed")]
    m = re.fullmatch(r"(?:https://github\.com/[^/\s]+/[^/\s]+/pull/)?([0-9]+)/?", argv[1] if len(argv) == 2 else "")
    if not m or not re.fullmatch(r"[a-z0-9_-]+", argv[0]) or not os.path.isdir(f"{DEV}/{argv[0]}/.git"):
        print("cc-slack post-approval [--force|--landed] <repo-in-~/dev> <pr-number|pr-url>", file=sys.stderr); return 2
    repo, n, cfg = argv[0], m.group(1), load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post-approval: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    r = subprocess.run(["gh", "pr", "view", n, "--json", "title,url,state,mergedAt,closedAt"], cwd=f"{DEV}/{repo}",
                       capture_output=True, text=True, timeout=60)
    cid, member = find_channel(cfg, APPROVALS)
    if r.returncode != 0 or not (cid and member):
        print(f"cc-slack post-approval: {r.stderr.strip()[-300:] or f'no #{APPROVALS} channel the bot is in (cc slack mkchannel {APPROVALS})'}", file=sys.stderr); return 1
    pr = json.loads(r.stdout)
    state = (pr.get("state") or "").upper()
    done = landed or state in ("MERGED", "CLOSED")
    try:
        have = approval_card(cfg, cid, repo, n)
    except Exception as e:
        if done:
            print(f"cc-slack post-approval: could not read #{APPROVALS} ({e}) — the card for PR #{n} is not edited", file=sys.stderr); return 1
        log(f"post-approval: could not read #{APPROVALS} ({e}) — posting anyway"); have = None
    if done:
        if not have:
            print(f"cc-slack post-approval: PR #{n} is {state or 'landed'} and #{APPROVALS} has no card for it — none posted "
                  f"(a PR that is already in must not look pending)", file=sys.stderr); return 4
        kind = "CLOSED" if state == "CLOSED" else "MERGED"
        try:
            did = land_card(cfg, cid, have, kind, iso_hhmm(pr.get("mergedAt") or pr.get("closedAt")))
        except Exception as e:
            print(f"cc-slack post-approval: the card for PR #{n} ({have.get('ts')}) was not edited: {e}", file=sys.stderr); return 1
        log(f"post-approval: [{repo}] PR #{n} {kind.lower()} — card {have.get('ts')} {'edited' if did else 'already reads so'}, nothing posted")
        print(have.get("ts")); return 0
    if have and not force:
        log(f"post-approval: [{repo}] PR #{n} already has a card ({have.get('ts')}) — second caller posts nothing")
        print(have.get("ts")); return 0
    _, ts = post(cfg, cid, f"[{repo}] PR #{n}: {pr['title']} — {pr['url']}  ·  :+1: from the owner merges (squash)")
    print(ts or ""); return 0


def cmd_approvals_sweep(argv):
    """approvals-sweep [--dry-run] [--now] — every card of ours in #approvals that still says "merges" and whose PR GitHub
    says is MERGED or CLOSED gets the "landed ✓" / "closed ✗" edit, once (an edited card no longer says "merges", so it
    is never asked about again). The landing edits its own card; this catches the ones nothing did — a merge in
    GitHub's UI, a card posted after the landing, the four from before the edit existed. cc-reconcile gives it a
    turn every run; it sweeps for real at most once per SWEEP_EVERY unless --now. Exit 3 no token, 1 no channel."""
    dry, now = "--dry-run" in argv, "--now" in argv
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack approvals-sweep: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    stamp = f"{DIR}/approvals-sweep.at"
    try:
        age = time.time() - os.path.getmtime(stamp)
    except OSError:
        age = None
    if age is not None and age < SWEEP_EVERY and not (now or dry):
        print(f"swept {int(age // 60)} min ago — next in {int((SWEEP_EVERY - age) // 60) + 1} min (--now sweeps anyway)"); return 0
    cid, member = find_channel(cfg, APPROVALS)
    if not (cid and member):
        print(f"cc-slack approvals-sweep: no #{APPROVALS} channel the bot is in", file=sys.stderr); return 1
    try:
        cards = approval_cards(cfg, cid)
    except Exception as e:
        print(f"cc-slack approvals-sweep: could not read #{APPROVALS} ({e})", file=sys.stderr); return 1
    facts, edited, left = {}, [], 0
    for repo, n, m in cards:
        text = m.get("text") or ""
        if "merges" not in text or LANDED_RE.search(text):
            continue
        if len(edited) >= SWEEP_MAX and not dry:
            left += 1; continue                     # the rest next turn — one run stays short and under the rate limit
        if (repo, n) not in facts:
            facts[(repo, n)] = pr_facts(repo, n) or {}
        f = facts[(repo, n)]
        state = (f.get("state") or "").upper()
        if state not in ("MERGED", "CLOSED"):
            left += 1; continue
        word = "landed ✓" if state == "MERGED" else "closed ✗"
        try:
            if dry or land_card(cfg, cid, m, state, iso_hhmm(f.get("mergedAt") or f.get("closedAt"))):
                edited.append(f"[{repo}] PR #{n} {m.get('ts')} → {word}")
                dry or time.sleep(0.5)              # two Slack calls per card; Tier 3 is ~50 a minute
        except Exception as e:
            print(f"  [{repo}] PR #{n} {m.get('ts')}: not edited — {e}", file=sys.stderr); left += 1
    if not dry:
        try:
            os.makedirs(DIR, exist_ok=True); open(stamp, "a").close(); os.utime(stamp, None)
        except OSError:
            pass
    for line in edited:
        print("  " + line)
    print(f"{len(edited)} card{'' if len(edited) == 1 else 's'} {'would be ' if dry else ''}edited · {left} still pending"
          + (" (more than one run's worth — again with --now)" if len(edited) >= SWEEP_MAX else ""))
    return 0


def cmd_selfcheck():
    global DIR
    import tempfile
    DIR = tempfile.mkdtemp(prefix="cc-slack-selfcheck-")     # every state file a case touches (marks, flags, queue, last…) lands here, never in the live dir
    """Unit checks that need no Slack: mrkdwn, chunking, target detection, validation. Exit 1 on any failure."""
    import contextlib, io, tempfile
    # EVERY EXTERNAL EFFECT IS DENIED FOR THE WHOLE RUN, and ~/dev is a scratch tree (see Effects). A case that wants
    # one declares it — `globals()["api"] = fake` for Slack, `EFFECTS.run_impl = fake` for a shell-out — and puts it
    # back. Undeclared, a call raises here instead of reaching Slack, shelling to the real tools, or reading this box's
    # repositories; and it is recorded, so an `except Exception` that swallows the raise still ends the run red. This
    # is what makes `cc-slack selfcheck` runnable on a bare clone with no ~/.cc and no network, which is what makes it
    # usable as a health probe and a ledger check-cmd.
    scratch_dev = tempfile.mkdtemp(prefix="cc-slack-selfcheck-dev-")
    real_effects = Effects("selfcheck", dev=scratch_dev).install()

    @contextlib.contextmanager
    def offline_slack():
        """A Slack that is reachable and has nothing to say — DECLARED, so it is not a denial, and empty, so no case
        can accidentally assert on it. For the cases whose subject is not the API call they make on the way: routing
        an event also marks it and reads its thread root. Those calls used to go out over the wire, for real."""
        was = globals()["api"]
        globals()["api"] = lambda method, token, **kw: {}
        try:
            yield
        finally:
            globals()["api"] = was

    fails = []
    def check(name, cond):
        print(("  ✓ " if cond else "  ✗ ") + name)
        if not cond:
            fails.append(name)
    # NOT ONE THING THIS RUN MAKES MAY REACH THE OWNER. Cases stub subprocess.run one at a time, but land_soon()
    # and publish_soon() do their work on a BACKGROUND thread: the call lands after the stub was put back, on a
    # thread the case never had — so the REAL cc-notify paged the owner about a fixture. That is where four days
    # of "[_cctest…] PR #7 merged, deploy stopped 🚨" in #alerts came from, and stubbing each new case inherits
    # none of it. So the whole PROCESS is pinned instead: every cc-notify any thread spawns can only write a log,
    # and a temp one. (The product-side gate is in cc-notify: a synthetic repo name is never pushed, from anywhere.)
    os.environ["CC_NOTIFY_LOG_ONLY"] = "1"
    os.environ["CC_NOTIFY_LOG"] = tempfile.mktemp(prefix="_selfcheck_notify_")
    # …and the CLOCK, for the same reason: every Slack-facing stamp is rendered in the owner's zone (cc-time), so a
    # case that asserts one would read differently on every box. Asia/Tokyo is nobody's zone here, has no DST, and
    # is far enough east that the DAY moves with the hour — a renderer that only stripped the Z fails these.
    os.environ["CC_TZ"] = "Asia/Tokyo"
    # …and the same for the WORK those cases set off. Every :+1: case runs the real on_approval, and every tick case
    # runs the real loop_tick — so queue_land() shelled to the REAL cc-land and publish_soon() to the real cc-publish.
    # Against a fixture that is only noise; but `nameMM` below is deliberately the first REAL repo in ~/dev
    # (on_approval requires a repo that exists), so it ran for real, six times, and paged the owner with a title
    # indistinguishable from a real failed deploy — which the synthetic-name gate cannot catch, because the name is
    # real. It is worse now than it was then: `cc-land queue` writes a REAL job into the box's landing queue and
    # starts a REAL worker, which gates, MERGES and deploys. So the class is pinned for the whole run, once: a case
    # that asserts on these sets its own (an instance attribute shadows this), and the methods themselves are still
    # exercised directly, through the names kept here, with an injected `run`.
    deferred = []
    real_queue_land, real_land_sweep = Daemon.queue_land, Daemon.land_sweep
    real_publish_soon = Daemon.publish_soon
    Daemon.queue_land = lambda self, repo, n, chat, ts, who="", run=None: (
        deferred.append(("queue", repo, n)) or (True, f"[{repo}] PR #{n} queued (a stand-in for the selfcheck)"))
    Daemon.land_sweep = lambda self, run=None: deferred.append(("sweep", "", ""))
    Daemon.publish_soon = lambda self, repo: deferred.append(("publish", repo))
    real_notify_log = f"{HOME}/.cc/notify.log"
    before_notify = os.path.getsize(real_notify_log) if os.path.exists(real_notify_log) else None
    real_outbox_log = f"{DIR}/outbox.log"                    # any real post()/outbox() call this run must not touch it
    before_outbox = open(real_outbox_log).read() if os.path.exists(real_outbox_log) else None
    tmp_outbox_log = tempfile.mktemp(prefix="_selfcheck_outbox_")
    real_outbox = outbox                                     # kept for the 0600-permissions check (L22)
    globals()["outbox"] = lambda kind, chat, thread, text: open(tmp_outbox_log, "a").write(f"{kind}\t{chat}\t{thread or ''}\t{text}\n")
    real_load_flags, real_save_flags = load_flags, save_flags   # every 🏁 check runs on an empty, unsaved flag file (L23 tests the real pair)
    flag_writes = []
    globals()["load_flags"] = lambda: {}
    globals()["save_flags"] = lambda flags: flag_writes.append(dict(flags))
    check("mrkdwn: heading/bold/list/link", mrkdwn("# Title\n**b** and [t](https://u/x)\n- item") == "*Title*\n*b* and <https://u/x|t>\n• item")
    check("mrkdwn: code blocks untouched", mrkdwn("```\n**x** # y\n```") == "```\n**x** # y\n```")
    # ---- @-mentions: a session addressing a real PERSON in a channel (linkify_mentions + the clean() round-trip)
    real_api_m, real_orchs_m = api, load_orchs
    ucalls = []
    chan_mem = {"CONE": ["UALAN", "UADA"], "CBOTH": ["UALAN", "UALAN2"], "CNONE": []}   # who is in which channel (channel-scoped @-resolution)
    def api_users(method, token, **kw):
        ucalls.append(method)
        if method == "conversations.members":
            return {"members": chan_mem.get(kw.get("channel"), [])}
        if method == "users.list":
            return {"members": [{"id": "UADA", "name": "ada.byron", "profile": {"display_name": "Ada", "display_name_normalized": "Ada"}},
                                # an EMPTY display_name and a real name — the profile shape that reached nobody
                                {"id": "UALAN", "name": "a.turing", "profile": {"display_name": "", "real_name": "Alan Turing", "real_name_normalized": "Alan Turing"}},
                                {"id": "UALAN2", "name": "a.kay", "profile": {"display_name": "", "real_name": "Alan Kay"}},
                                {"id": "UGRACE", "name": "gh-grace", "profile": {"display_name": "", "real_name": "Grace"}},
                                {"id": "UD1", "name": "d.one", "profile": {"display_name": "twin", "display_name_normalized": "twin"}},
                                {"id": "UD2", "name": "d.two", "profile": {"display_name": "Twin", "display_name_normalized": "Twin"}},
                                {"id": "UHELP", "name": "helper", "is_bot": True, "profile": {}},
                                {"id": "UGONE", "name": "ghost", "deleted": True, "profile": {}},
                                {"id": "USLACKBOT", "name": "slackbot", "profile": {}},
                                {"id": "UALIAS", "name": "ai-dev", "profile": {}}]}   # a PERSON whose handle is also an orch alias
        raise RuntimeError(f"selfcheck: unexpected {method}")
    globals()["api"] = api_users
    globals()["load_orchs"] = lambda: {"CORCH": {"target": "myrepo", "alias": "ai-dev", "archived": False}}
    _users.update(t=0.0, map=None, miss=0.0)
    cfgm = {"SLACK_BOT_TOKEN": "xoxb-selfcheck"}
    lm = lambda t: linkify_mentions(cfgm, t)
    check("mentions: a known handle becomes a real mention — case-insensitive, trailing punctuation left outside",
          lm("hi @ada.byron, ok") == "hi <@UADA>, ok" and lm("(@Ada) and @ADA.BYRON!") == "(<@UADA>) and <@UADA>!"
          and lm("@ada.byron. end") == "<@UADA>. end")
    check("mentions: one users.list built the table for all of them", ucalls.count("users.list") == 1)
    check("mentions: an unknown token goes out as CODE, never as plain text that reads like a ping",
          lm("ping @nobody-here yet") == "ping `@nobody-here` yet")
    check("mentions: @main and an orch alias stay handover vocabulary — even when a person answers to that handle",
          lm("@main over to you, @ai-dev") == "@main over to you, @ai-dev" and user_table(cfgm).get("ai-dev") == "UALIAS")
    check("mentions: a noted target/alias is never a person either",
          note_handover("selfchecky") is None and lm("@selfchecky") == "@selfchecky")
    check("mentions: @here/@channel/@everyone are never linked", lm("@here @channel @everyone") == "@here @channel @everyone")
    check("mentions: inside a ``` fence and inside a `code` span nothing is rewritten",
          lm("`@ada` and ```\n@ada\n``` but @ada") == "`@ada` and ```\n@ada\n``` but <@UADA>")
    check("mentions: an @ that is not at a word boundary is not a mention (addresses, urls, foo@bar)",
          lm("to a@b.com, see https://x/@ada, foo@bar") == "to a@b.com, see https://x/@ada, foo@bar")
    check("mentions: one handle two people answer to is ambiguous — never guessed, and marked as not-a-mention",
          lm("@twin vs @d.one") == "`@twin` vs <@UD1>")
    check("mentions: bots, apps, deleted accounts and Slackbot are not mentionable",
          lm("@helper @ghost @slackbot") == "`@helper` `@ghost` `@slackbot`")
    _users["miss"] = 0.0
    n_miss = ucalls.count("users.list")
    lm("@typo-one"); lm("@typo-two")
    check("mentions: a miss refreshes the table at most once every few minutes (a typo cannot hammer users.list)",
          ucalls.count("users.list") == n_miss + 1)
    n_cache = ucalls.count("users.list")
    _users.update(t=0.0, map=None)                          # forget the process copy: the disk cache alone must carry it
    check("mentions: the table is read back from <DIR>/users.json, with no second users.list",
          lm("@ada.byron") == "<@UADA>" and ucalls.count("users.list") == n_cache
          and json.load(open(f"{DIR}/users.json"))["map"]["ada"] == "UADA")
    # -- name forms + channel-scoped resolution (an escalation that used to reach nobody) ------
    lmc = lambda t, chat: linkify_mentions(cfgm, t, chat)
    check("mentions: the real name and its FIRST token are indexed too — an empty display_name is why @Alan reached nobody",
          lm("@a.turing") == "<@UALAN>" and lm("@Grace") == "<@UGRACE>"
          and user_table(cfgm).get("alan turing") == "UALAN" and user_table(cfgm).get("grace") == "UGRACE")
    check("mentions: a first name several people in the workspace answer to resolves against THAT channel's members — "
          "one Alan in the channel is the Alan meant",
          user_table(cfgm).get("alan") is None and lm("@Alan escalating") == "`@Alan` escalating"
          and lmc("@Alan escalating", "CONE") == "<@UALAN> escalating")
    check("mentions: two members of the SAME channel answer to it — never guessed",
          lmc("@Alan escalating", "CBOTH") == "`@Alan` escalating")
    n_mem = ucalls.count("conversations.members")
    lmc("@Alan again", "CONE"); lmc("@Alan and @Alan", "CONE")
    check("mentions: a channel's members are cached, not re-read for every @token",
          ucalls.count("conversations.members") == n_mem)
    buf_m = io.StringIO()
    with contextlib.redirect_stderr(buf_m):
        unresolved = lmc("ping @nobody-here and @Alan", "CBOTH")
    logged = buf_m.getvalue()
    check("mentions: a token that resolves to nobody is logged (channel, token, table state) — a "
          "session's escalation never vanishes silently",
          unresolved == "ping `@nobody-here` and `@Alan`" and logged.count("resolves to nobody") == 2
          and "CBOTH" in logged and "@nobody-here" in logged and "@Alan" in logged
          and ("refreshed" in logged or "cached" in logged))
    buf_q = io.StringIO()
    with contextlib.redirect_stderr(buf_q):
        got = []
        out_q = linkify_mentions(cfgm, "escalating to @Alan and @nobody-here", "CBOTH", unresolved=got)
    check("mentions: a caller that COLLECTS them is handed every handle that reached nobody, and why",
          [h for h, _ in got] == ["Alan", "nobody-here"] and "more than one person" in got[0][1]
          and "nobody in this workspace" in got[1][1] and out_q == "escalating to `@Alan` and `@nobody-here`"
          and buf_q.getvalue() == "")          # reported to the sender, so not ALSO shouted at the log
    warn_q = mention_warning(got)
    check("mentions: the sender is told loudly, and told that it has NOT escalated",
          "@Alan" in warn_q and "@nobody-here" in warn_q and "REACHED NOBODY" in warn_q
          and "YOU HAVE NOT" in warn_q and mention_warning([]) == "")
    with contextlib.redirect_stderr(io.StringIO()):
        check("mentions: unresolved_mentions() reads the message the same way the post does — and stays quiet when all resolve",
              [h for h, _ in unresolved_mentions(cfgm, "hi @nobody-here", "CONE")] == ["nobody-here"]
              and unresolved_mentions(cfgm, "hi @Alan", "CONE") == []
              and unresolved_mentions(cfgm, "`@nobody-here` @main @here", "CONE") == [])
    with contextlib.redirect_stderr(io.StringIO()):
        check("mentions: no regression — reserved vocabulary and code spans are never rewritten, channel scope or not",
              lmc("@main @here @channel @everyone @ai-dev", "CONE") == "@main @here @channel @everyone @ai-dev"
              and lmc("`@Alan` and ```\n@Alan\n``` but @Alan", "CONE") == "`@Alan` and ```\n@Alan\n``` but <@UALAN>")
    dmm = Daemon(use_slack=False); dmm.cfg = dict(cfgm); dmm.bot_user = "UBOT"
    dmm.users["UADA"] = ("Ada Byron", "ada.byron")          # what ONE users.info fills in: readable name + the handle
    check("clean: an inbound <@U…> reads as the HANDLE, so a reply can mention that same person back",
          dmm.clean("<@UBOT> ask <@UADA> please") == "ask @ada.byron please"
          and lm(dmm.clean("<@UBOT> ask <@UADA> please")) == "ask <@UADA> please"
          and dmm.user_name("UADA") == "Ada Byron")
    check("history/thread: in-text mentions render as the handle, the author column keeps the readable name",
          plain("hi <@UADA>", lambda u: "Ada Byron", lambda u: "ada.byron") == "hi @ada.byron"
          and plain("hi <@UADA>", lambda u: "Ada Byron") == "hi @Ada Byron")
    globals()["api"], globals()["load_orchs"] = real_api_m, real_orchs_m
    os.remove(f"{DIR}/users.json")
    _users.update(t=time.time(), map={}, ids={}, miss=time.time())   # the rest of this selfcheck: an empty table, no users.list, @tokens as typed
    _chan_members.clear()
    cs = chunks("\n".join(f"line {i} " + "x" * 50 for i in range(300)))
    check("chunks: within the limit, several pieces", all(len(c) <= CHUNK + 8 for c in cs) and len(cs) >= 4)
    cf = chunks("```\n" + "\n".join("code " + "y" * 60 for _ in range(200)) + "\n```")
    check("chunks: code fences stay balanced", len(cf) > 1 and all(c.count("```") % 2 == 0 for c in cf))
    check("chunks: one over-long line is split", all(len(c) <= CHUNK for c in chunks("z" * (CHUNK * 2 + 5))))
    with tempfile.TemporaryDirectory(dir=DEV, prefix="_selfcheck") as d:
        name = os.path.basename(d)
        os.makedirs(f"{d}/wt/.cc"); open(f"{d}/wt/.cc/track", "w").write(f"{name}\nt1\n")
        check("detect: ~/dev/<repo> → repo", detect_target(d) == name and detect_target(f"{d}/wt/sub") == f"{name}/t1" if os.makedirs(f"{d}/wt/sub") is None else False)
        check("detect: ~/dev → box, ~ → box", detect_target(DEV) == "box" and detect_target(HOME) == "box")
        os.makedirs(f"{d}/.git")                        # a "repo" for the approvals checks (tempfile names are lowercase → PR_RE-safe)
        dm = Daemon(use_slack=False); dm.cfg = {"SLACK_OWNER_ID": "UOWNER"}; dm.bot_user = "UBOT"; dm.names.update({"CAPPR": APPROVALS, "CREPO": "myrepo"})
        posts = {"1.1": {"user": "UBOT", "text": f"[{name}] PR #7: t — https://x/7"}, "1.2": {"user": "UOWNER", "text": f"[{name}] PR #8: t"},
                 "1.3": {"user": "UBOT", "text": f"merged [{name}] PR #9:"}, "1.4": {"user": "UBOT", "text": "[no-such-repo-zz] PR #1: t"}}
        dm.fetch_message = lambda chat, ts: posts.get(ts); said, calls = [], []
        dm.say = lambda chat, text, thread=None: said.append((chat, thread))
        qok = [True]
        dm.queue_land = lambda repo, n, chat, ts, who="", run=None: calls.append((repo, n, chat, ts, who)) or (
            (True, f"[{repo}] PR #{n} queued — the gates run first, then the merge, then the deploy") if qok[0]
            else (False, "cc-land: cannot write /home/x/.cc/state/land/x-7.json: Read-only file system — nothing merged"))
        ev = lambda **k: {"type": "reaction_added", "reaction": "+1", "user": "UOWNER", "item": {"type": "message", "channel": "CAPPR", "ts": "1.1"}, **k}
        it = lambda ts, chan="CAPPR", kind="message": {"type": kind, "channel": chan, "ts": ts}
        dm.users.update({"UOWNER": ("The Owner", "owner"), "UMEM": ("Ada", "ada.byron")})
        bad = [ev(user="UMEM", item=it("1.2")), ev(reaction="eyes"), ev(item=it("1.1", "CREPO")), ev(item=it("1.2")), ev(item=it("1.3")), ev(item=it("1.4")),
               ev(item=it("1.1", kind="file")), ev(item=it("9.9")), {"type": "message", "channel": "CAPPR", "ts": "1", "user": "UOWNER", "text": "hi"}]
        notes, injected = [], []                               # failure routing: no real cc-notify, no real session inject
        EFFECTS.run_impl = lambda cmd, **kw: notes.append(cmd) or type("R", (), {"returncode": 0, "stdout": "", "stderr": ""})()
        dm.deliver = lambda target, payload, **kw: injected.append((target, payload["content"]))
        marks, real_react_ap = [], react
        globals()["react"] = lambda cfg, chat, ts, name, remove=False, **k: marks.append((chat, ts, name))
        try:
            with contextlib.redirect_stderr(io.StringIO()):
                check("reaction: wrong emoji/channel, non-bot author (a member's :+1: on one too), bad text, unknown repo/ts, "
                      "non-message, plain message → ignored",
                      all(dm.on_event(e) is None for e in bad) and not calls and not said and not marks)
                out = dm.on_event(ev(reaction="thumbsup"))
                check("reaction: a :+1: on the bot's PR post MERGES NOTHING HERE — it hands the PR to cc-land, the one "
                      "thing on this box that merges, and the gates run before that merge. Merging here and calling "
                      "cc-land afterwards is how every PR the owner approved on 2026-08-31 went in ungated",
                      calls == [(name, "7", "CAPPR", "1.1", "The Owner")] and "queued" in (out or ""))
                check("reaction: a queued 👍 is marked 👀 and says nothing else — the landing owns the ✅/❌ and the one "
                      "result the owner reads, and it can only say it once the gates, the merge and the deploy are done",
                      marks == [("CAPPR", "1.1", "eyes")] and not said and not notes and not injected)
                calls.clear(); marks.clear()
                out5 = dm.on_event(ev(user="UMEM"))
                check("reaction: a MEMBER's :+1: is worth exactly the owner's — the owner curates who is in #approvals, "
                      "so being in that channel IS the approval right (owner's decision, 2026-08-30)",
                      calls == [(name, "7", "CAPPR", "1.1", "Ada")] and "queued" in (out5 or "")
                      and marks == [("CAPPR", "1.1", "eyes")])
                calls.clear(); marks.clear(); qok[0] = False
                out6 = dm.on_event(ev())
                check("reaction: FAIL CLOSED — a queue that will not take the PR is ❌ and a plain 'NOT merged' in the "
                      "thread. Nothing here merges without the queue, and there is no fallback that merges without the "
                      "gates: that fallback was the bug",
                      "NOT merged" in (out6 or "") and "Read-only file system" in (out6 or "")
                      and marks == [("CAPPR", "1.1", "x")] and said == [("CAPPR", "1.1")])
                check("reaction: ...and it does not die in #approvals, which no session reads — the owner is paged and "
                      "the repo's own planning session is told, in as many words, that nothing merged",
                      notes and notes[-1][:5] == [f"{BIN}/cc-notify", "-p", "high", "-t",
                                                  f"[{name}] PR #7 was NOT merged"]
                      and injected and injected[-1][0] == name and "could not even be queued" in injected[-1][1]
                      and "Nothing merged" in injected[-1][1])
                qok[0] = True
                del dm.queue_land          # nothing stubbing it now: the 👍 path lands on the process-wide pin at the
                dm.on_event(ev())          # top of this selfcheck, which is the only thing standing between a fixture
        finally:                           # and a REAL job in this box's landing queue
            globals()["react"] = real_react_ap
        qrec = []
