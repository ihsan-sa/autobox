    def with_latest(roots, replies):
        """Slack stamps latest_reply on every thread root; bucket_threads anchors its 1-message read there (M3)."""
        for r in roots:
            rs = replies.get(r["ts"]) or []
            if rs:
                r["latest_reply"] = rs[-1]["ts"]
        return roots
