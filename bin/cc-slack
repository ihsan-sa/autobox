          fb == [hlt(hE), hlt(hB), hlt(hI), "not a stamp"] and fb_card == hlt(hE)
          and fb_boot == f"last boot {hlt(hB)} (power cut)" and bool(re.fullmatch(r"\d\d:\d\d", fb_now)))
