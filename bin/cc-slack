#!/usr/bin/env python3
"""cc-slack — two-way Slack for this box, built on Claude Code channels.

  cc-slack daemon [--no-slack]        the box's one Slack connection (Socket Mode) + local router on ~/.cc/slack/sock; user unit cc-slackd (`cc slack on|off`); no tokens or --no-slack = local router only.
  cc-slack channel [<target>]         stdio MCP channel server, one per session (claude spawns it); target defaults from the session cwd: ~/dev/<repo>→<repo>, a track worktree (.cc/track)→<repo>/<track>, ~/dev or ~→box.
  cc-slack inject [--no-start] <target> "text"      push a message into a session as if from Slack (tests/scripts); `<repo>@<alias>` is that orch's own session, never started for it.
  cc-slack post [-c CHANNEL] [--thread TS] [--ts TS] [--route TITLE] [--id PRODUCER-ID] [--mention] [--major] "text" post as the bot (cc-notify uses --route). --id posts an event once, ever: a replay or retry returns the same ts, never a second post (~/.cc/slack/sent/). --ts is the message this answers. -c into another session's channel hands it to that session (Daemon.wake), --route never does; one that wakes nobody (queued, no-session, live-no-channel, no-track — not a paused or unminted target, which has no session by design) is written to the failures ledger by the daemon (channel-wake/nobody-woken) and the stderr line names the record: `cc-slack: woke nobody on <target> (<verdict>) — recorded f-…`. --mention opens with ❓ and an @-mention of the owner — the only post allowed to page him (a typed @handle of his is sent as code). -c '#<repo>' wants a question, a decision, or --major (alias --main); anything else goes to #<repo>-updates, one stderr line says so.
  cc-slack sent <PRODUCER-ID>         did Slack accept that id? prints its ts (exit 0), or exit 1 if not yet; an unknown flag is always exit 2, never text.
  cc-slack post --file PATH [--to C…|U…|#name] [--thread TS] [--ts TS] [--title T] [-m "text"] upload a file as the bot; --thread lands it in that thread (default target: DM the owner); --ts as above; Web API only.
  cc-slack post-approval [--force|--landed] [--print-chat] <repo> <pr-number|url> "[repo] PR #n: title — url" into #approvals, where the owner's :+1: squash-merges it — or, for a repo that lands itself (any not in CC_SELF_LAND_EXCEPT), into #<repo>-updates as a landing record nobody taps. One card per PR — a repeat call finds the first and does nothing (--force re-posts); a merged/closed PR's card is edited to "landed ✓" instead (--landed: on the caller's word).
  cc-slack approvals-sweep [--dry-run] [--now]      edit every card whose PR is in (or closed) but still reads pending.
  cc-slack history <#chan|C…|D…> [n] | thread <#chan|C…> <ts> [n]      read a channel or a full thread, newest first, cursor-paged.
  cc-slack edit <chan> <ts> "new text" | unsay <chan> <ts>      rewrite or delete one of the bot's own posts (signed ones too).
  cc-slack pin <chan> <ts> | unpin <chan> <ts> | canvas <chan> "Title" < file.md      pin a message; replace a channel's canvas.
  cc-slack revisit [--json]           the threads the owner 📌'd to come back to: when, channel, root line, link (no daemon needed).
  cc-slack status | channels [--for <repo>] | setup [--bot xoxb-…] [--app xapp-…] [--owner-email you@x] | accept-dialog <tmux-window>      --for lists one project's channels: its two lanes, any legacy #<repo>--<track> channels, its sub-orch channels.
  cc-slack member add <@user>…        give each a private #<handle> (+ -updates) with the owner in it and ~/dev/<handle>; idempotent, the owner is exempt.
  cc-slack member instructions <handle>     put the member instructions into that workspace's README (appending if it already has one).
  cc-slack member register <handle> [<@user>]   put a workspace no join flow made (cc-sandbox convert) on record in members.json from the channel pair it already has; creates nothing.
  cc-slack members                    who has a workspace: handle → channels → folder → budget used today.
  cc-slack track-thread <repo>/<track> [--title T]   the ONE thread a --go track lives in, in #<repo> (a member workspace: its own #<handle>): opened by `cc … --go`, idempotent, prints `<chat> <ts>`; a track gets no channel of its own. Its worker's lines (post --route "<repo>/<track> …") and its landing line go there, and a reply there reaches the track's session — or, for a headless or finished track, the repo's session with the track named; no notice line is posted.
  cc-slack mkchannel <name>… [--public]     create #<name> if missing (PRIVATE unless --public), join it, invite the owner, set the topic; a #<repo>--<sub> name inherits #<repo>'s people; comes paired with #<name>-updates.
  cc-slack project <name>             from a member workspace's session, ask the daemon for the project's board row and its one thread in #<this workspace> (no channel); at most 3 an hour; the human way is `new project <name>` typed in the channel.
  cc-slack ask [-t "title"] "text"      from a member workspace's session, ask the box's planning seat (a repo, a host-side push, a question): the daemon posts a 🙋 card in the control repo's #<repo>-threads lane on the workspace's behalf, hands it to the planning session, and carries every reply in the card's thread (the seat's or the owner's) back to #<workspace>, handed to its session; at most 5 an hour. Never ask the owner to relay.
  cc-slack seat                          the seat the daemon says owns this process (`<repo>`, `<repo>/<track>`, `<repo>@<alias>`), from the socket's pid chain and the live subscriptions; empty and exit 1 when none does, exit 2 when the daemon could not be reached at all. cc-notify reads it to decide who may ask the owner, and a caller it cannot identify (exit 2) is not the box's own hand.
  cc-slack grant allow '<rule>' [-t "why"]   from a box session (planning or a track) that a permission layer refused: the daemon posts a 🔐 grant card in the control repo's #<repo>-threads lane naming that ONE allow line; the owner's `yes <id> fix` there has the daemon write it into ~/.claude/settings.json (cc-settings grant), `no <id>` declines; the card shows ⚙️ or ❌. Never a member workspace's verb, never answerable by a session; at most 5 an hour. `cc-slack grant unit <file.service|.timer>` is the same card for a user unit install (file, sha256 and the enable both named). `cc-slack grant confirm '<command>' -w <window>` is the same card for a seat parked on the auto-mode confirm dialog behind a command that is not read-only (cc-model's tick raises it): the owner's `yes <id>` / `no <id>` is written to ~/.cc/state/confirm-answers/<id>, and cc-model's next tick presses that answer into the dialog — this once, never for good. Design: docs/design-seat-grant-from-slack.md.
  cc-slack permission <id> yes|no [fix]     answer a 🔐 prompt from here, the same path as a `yes <id>` Slack reply; every session's prompt but the planning session's own goes to the control repo's #<repo>-threads lane for it to decide; `fix` marks the capability granted for good.
  cc-slack updates-sweep [--dry-run]  give every repo channel that predates the split its -updates lane (idempotent; skips a bot-only channel).
  cc-slack orch-channel <target> <alias> [--parent-alias A] [--brief "…"]     give a sub-orchestrator its own channel, recorded in ~/.cc/slack/orchs.json (`cc <repo> --orch` calls it).
  cc-slack archive <#chan|C…> | archive --orch <target> <alias>      archive a sub-orch channel; it stops routing and leaves home.json's channel list.
  cc-slack selfcheck                  unit checks, no Slack needed (tests/selftest.sh runs it); the cases are core/tests/slack_selfcheck.py, run in this file's namespace; every state it touches is its own scratch dir, never the box's.
  cc-slack manifest --print | --config-token xoxe.xoxp-… --app A0…      paste-ready manifest, or push it onto an existing app; the owner still taps Reinstall and generates the app-level token.

Routing: #<repo> → its planning session, a reply in a track's 🧵 thread in #<repo> → that track's session (a legacy #<repo>--<track> channel routes the same), DMs and #box → the box's own Remote-Control session.
Two lanes per project: #<repo> is for the owner (questions, decisions), #<repo>-updates carries what is automated or long; a reply stays on the lane it was asked on.
A third name is not a session: #<repo>-ask is the question lane — what is typed there goes to `cc-ask <repo>` (one small-model read of the docs and the knowledge library, the source named in the reply) and comes back in the thread; no session is woken, started or provisioned for it, and a reaction there reaches nobody.
#approvals and #alerts keep their own jobs; a sub-orch or track channel isn't split, it inherits its parent's lanes.
A sub-orchestrator gets its own channel (~/.cc/slack/orchs.json): "@alias" in the repo channel reaches it, "@main"/"@other" hands the thread back.
Override routing in ~/.cc/slack/routes.json.
EVERY channel the bot is in answers: an unmapped one starts its own session on first message (~/dev/<name>, CLAUDE.md, .cc/member-facing, a git repo), capped at 3 new dirs an hour, never for a DM, #approvals, #alerts, an archived sub-orch channel or a name that normalises to nothing.
A message never starts a <repo>/<track> session on its own; with none live (a headless worker, or a finished track) it goes to the <repo> session with the track named, and no notice is posted. Only `!restart <repo>/<track>` starts one.
ANYONE who can post in a routed channel is heard — Slack channel membership is the access control, the owner curates it; DMs stay owner-only, a stranger's DM gets 👋 and no session.
A reply can @-mention a person already in the channel; @main/@<alias> are session hand-offs, not people.
A session's post naming @main, an orch alias or a live track (reply tool, `cc-slack post`, a card) reaches that session: mirrored into its own channel with a link back, delivered once in the original thread, the poster told where it went.
A session handed another session's post 👍s it on the first tool call of the turn that post woke, so the channel shows it was read and taken on even when no reply follows; the box's 👀 still only means received, and the owner's own messages keep the reply-or-react rule.
A reaction is a verdict from anyone in the channel (a member's :+1: in #approvals merges the PR, exactly as the owner's does); DM reactions stay the owner's.
A :+1: on cc-model's return card — `[return] <window>: Fable 5.1 is back…`, posted when the outage that moved a session off the primary lifts — runs `cc-model return <window>`: that session's overlapping handoff back to it (✅ when it started, ❌ and one line when it did not).
The owner's 📌 marks a thread "revisit", not a verdict — kept until the 📌 comes off, listed by `cc-slack revisit`.
Only the owner steers: permission answers, `!` commands and @alias hand-offs.
The `!` commands are `!pause`/`!resume` (each also as `-only` and `-under`), `!restart <box|repo[/track]|slack|tmux>` and `!reboot`, owner-only, any channel or thread; anything else typed is a message to the session.
`!pause` parks this channel's project and everything declared under it, queuing what arrives; `!resume` unparks it; a project parked on its own stays parked when its parent resumes.
`!pause-only`/`!resume-only` stop at this project and leave what is under it exactly as it was; `!pause-under`/`!resume-under` say the walk out loud and mean what the bare verbs already do. Either way the answer ends with a `Reach:` line naming how far it went, so nobody has to predict it from CC_PROJECT_CHILDREN.
~/.cc/state/home.json is the box's one live view and the dashboard reads it: rewritten every 30 s and within 2 s of any event, leading with what needs the owner, then running/idle counts, the backlog, the channels, load, handoff count, audit and boot. There is no Slack App Home tab: the daemon publishes a one-line pointer to the dashboard once at start and never again.
While a handoff overlap is open on a target, only the session the record calls live is delivered to (permission answers included); the muted one's reply/react/file are refused. The muted one is never delivered to, even alone: a message with no live side subscribed is held and handed over at the cutover (cc-handoff's `{"cutover"}` word, or the 30 s tick) or at the live side's hello. At the cutover the successor also gets what the predecessor was handed from 10 min before the overlap and never answered (no box post in its thread, no box reaction but 👀 on it, no 👍 from a woken turn), with a line saying so. An orch is a seat of its own: it reads its own record, `<repo>@<alias>`, never the repo's.
See ~/COMMS.md and ~/USAGE.md.

Config (~/.cc/config): SLACK_BOT_TOKEN SLACK_APP_TOKEN SLACK_OWNER_ID SLACK_CHANNEL SLACK_AUTOSTART(=1)
"""
import calendar, collections, contextlib, fcntl, glob, io, json, os, re, shutil, signal, socket, stat, struct, subprocess, sys, tempfile, threading, time, types, urllib.parse, urllib.request

HOME = os.path.expanduser("~")
DIR = os.environ.get("CC_SLACK_DIR", f"{HOME}/.cc/slack")
SOCK = f"{DIR}/sock"
SELF_LINK = os.path.abspath(__file__)                # how this copy was invoked — usually the ~/bin symlink
SELF = os.path.realpath(SELF_LINK)                   # …and where that points: the file a deploy actually rewrites
SELF_MTIME = os.path.getmtime(SELF)                  # what it was when this process started (see Channel.stale)
BIN = os.path.dirname(SELF)                          # helpers come from the same bin/ as this copy (like `cc`)
ROOT = os.path.dirname(BIN)                          # the core tree: slack/app-manifest.json lives here
DEV = f"{HOME}/dev"
BOX = os.environ.get("CC_BOX") or socket.gethostname().split(".")[0]   # this box's name: it signs every post
CTL = BOX                                            # the box's control repo = the one this copy lives in
if SELF.startswith(DEV + os.sep):
    CTL = SELF[len(DEV) + 1:].split(os.sep)[0]
VERSION = "0.1"
PERM_CARD_PREVIEW = 300   # chars of the tool input a 🔐 card shows; a longer one follows whole as the next message in its thread
PERM_RE = re.compile(r"^\s*(y|yes|n|no)\s+([a-km-z]{5})(?:\s+(fix))?\s*$", re.I)   # `fix` = capability granted for good
SENT_USING_RE = re.compile(r"\s*\*Sent using\*\s+\S+\s*$")     # claude.ai's Slack connector signs every message it sends
CHUNK = 3900
APPROVALS = "approvals"                                        # #approvals is not a session: the owner's :+1: on a bot post there merges the PR
