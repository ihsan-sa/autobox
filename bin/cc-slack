          hhmm(hI) == "00:02" and hhmm(hI, day=True) == "2026-09-02 00:02" and hhmm_all([hI, hI + 3600]) == ["00:02", "01:02"]
          and hhmm_all([]) == [] and "Z" not in hhmm())
