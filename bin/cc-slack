#!/usr/bin/env python3
"""cc-slack — two-way Slack for this box, built on Claude Code channels.

  cc-slack daemon [--no-slack]        the box's one Slack connection (Socket Mode) + local router on ~/.cc/slack/sock; user unit cc-slackd (`cc slack on|off`); no tokens or --no-slack = local router only.
  cc-slack channel [<target>]         stdio MCP channel server, one per session (claude spawns it); target defaults from the session cwd: ~/dev/<repo>→<repo>, a track worktree (.cc/track)→<repo>/<track>, ~/dev or ~→box.
  cc-slack inject [--no-start] <target> "text"      push a message into a session as if from Slack (tests/scripts); `<repo>@<alias>` is that orch's own session, never started for it; a repo with no channel and no live session that CC_PROJECT_CHILDREN puts under a parent reaches the parent's session instead, the text opening `[<repo>]`.
  cc-slack post [-c CHANNEL] [--thread TS] [--ts TS] [--route TITLE] [--id PRODUCER-ID] [--mention] [--major] [--keep] [--ask|--no-ask] "text" post as the bot (cc-notify uses --route; a channel-less child's title goes to its CC_PROJECT_CHILDREN parent's channel, the text opening `[<child>]` unless it names it; --route with --major stays on the title's main lane, #<repo>, never a track's thread or the -updates lane). --id posts an event once, ever: a replay or retry returns the same ts, never a second post (~/.cc/slack/sent/). --ts is the message this answers. -c into another session's channel ('#name', a bare name or its id) hands it to that session (Daemon.wake) — from a process no session owns, a service or a shell, as role=bot, and never into the -updates lane or back to a track's own loop — --route never does; one that wakes nobody (queued, no-session, live-no-channel, no-track — not a paused or unminted target, which has no session by design) is written to the failures ledger by the daemon (channel-wake/nobody-woken) and the stderr line names the record: `cc-slack: woke nobody on <target> (<verdict>) — recorded f-…`. --mention opens with 🔒 and an @-mention of the owner — the only post allowed to page him (a typed @handle of his is sent as code), and an ask he owes an answer (`!needs`) unless --no-ask; --ask makes any post such an ask (cc-notify --owner's DM) — and lands only in #<repo> or #approvals: #alerts moves to the control repo's channel, an orch's channel to its repo's, a -updates, -threads or `--` lane to its base repo's, one stderr line says where. A post for another session (no --mention, and a -c into its channel, a text opening `<#…>` or 🤖, or a -threads lane) opens with 🤖 and still wakes that session. --keep is accepted and changes nothing (the engagement hold it lifted is gone).
  cc-slack sent <PRODUCER-ID>         did Slack accept that id? prints its ts (exit 0), or exit 1 if not yet; an unknown flag is always exit 2, never text.
  cc-slack live-id <SUBJECT>          the producer id of the one live ask about SUBJECT: the newest <SUBJECT>@<stamp> on file while it is under 12 h old, else a fresh one (cc-notify --live).
  cc-slack post --file PATH [--to C…|U…|#name] [--thread TS] [--ts TS] [--title T] [-m "text"] upload a file as the bot (a PDF goes as its library link, and one not yet filed is refused); --thread lands it in that thread (default target: DM the owner); --ts as above; Web API only.
  cc-slack post-approval [--force|--landed] [--print-chat] <repo> <pr-number|url> "[repo] PR #n: title — url" into #approvals, where the owner's :+1: squash-merges it — or, for a repo that lands itself (any not in CC_SELF_LAND_EXCEPT), into #<repo>-updates (a channel-less child's: its parent's, per CC_PROJECT_CHILDREN) as a landing record nobody taps. One card per PR — a repeat call finds the first and does nothing (--force re-posts); a merged/closed PR's card is edited to "landed ✓" instead (--landed: on the caller's word).
  cc-slack approvals-sweep [--dry-run] [--now]      edit every card whose PR is in (or closed) but still reads pending.
  cc-slack history <#chan|C…|D…> [n] | thread <#chan|C…> <ts> [n]      read a channel or a full thread, newest first, cursor-paged.
  cc-slack edit <chan> <ts> "new text" | unsay <chan> <ts>      rewrite or delete one of the bot's own posts (signed ones too).
  cc-slack pin <chan> <ts> | unpin <chan> <ts> | canvas <chan> "Title" < file.md      pin a message; replace a channel's canvas.
  cc-slack revisit [--json]           the threads the owner 📌'd to come back to: when, channel, root line, link (no daemon needed).
  cc-slack status | channels [--for <repo>] | setup [--bot xoxb-…] [--app xapp-…] [--owner-email you@x] | accept-dialog <tmux-window>      --for lists one project's channels: its two lanes, any legacy #<repo>--<track> channels, its sub-orch channels. Inside a member workspace's boundary (no token there) `channels`, `history` and `thread` go through the member socket: its own channels and the mirror channels routes.json sends it (SLACK_MIRROR_<N>), each by its name there (#home), read and posted with that workspace's token; a channel of anyone else's is refused.
  cc-slack member add <@user>…        give each a private #<handle> (+ -updates) with the owner in it and ~/dev/<handle>; idempotent, the owner is exempt. A new handle `cc-sandbox handle` refuses (the box's own ~/.cc/state dirs, a repo's) is refused, and so is one it cannot ask.
  cc-slack member instructions <handle>     put the member instructions into that workspace's README (appending if it already has one).
  cc-slack member register <handle> [<@user>]   put a workspace no join flow made (cc-sandbox convert) on record in members.json from the channel pair it already has; creates nothing.
  cc-slack members                    who has a workspace: handle → channels → folder → budget used today.
  cc-slack workspace list | move <handle> <ws> [--uid U…] [--apply]   the extra Slack workspaces (config below) and whether their tokens answer; `move` carries a member workspace's channel-id records (routes, orchs, track threads, its members.json ids) over to the same-named channels in <ws>, a dry run without --apply, which refuses while the daemon runs. Nothing under ~/dev moves.
  cc-slack workspace route <ws> <C…> <target> | channel <ws> <name> <target> [--title T] [--purpose P] [--with U…] | employee <ws> <name> <U…>   route one channel of <ws> to a target of its member workspace (routes.json, by id); `channel` makes it PRIVATE first, invites the owner's id there, SLACK_INVITE_<N> and --with, and sets its topic and purpose; `employee` is `channel` for one person, routed to the track <member>/<name>. A mirror's channels (SLACK_MIRROR_<N>=1) come in this way, under any name.
  cc-slack track-thread <repo>/<track> [--title T]   the ONE thread a --go track lives in, in #<repo>-updates when the repo has that lane, else #<repo> (a member workspace: its own #<handle>): opened by `cc … --go`, idempotent, prints `<chat> <ts>`; a track gets no channel of its own, and a repo with none of its own that CC_PROJECT_CHILDREN puts under a parent gets its threads — and its --route lines and PR cards — in the parent's channels. Its worker's lines (post --route "<repo>/<track> …") and its landing line go there, and a reply there reaches the track's session — or, for a headless or finished track, the repo's session with the track named; no notice line is posted.
  cc-slack mkchannel <name>… [--public]     create #<name> if missing (PRIVATE unless --public), join it, invite the owner, set the topic; a #<repo>--<sub> name inherits #<repo>'s people. No -updates twin is made (only a member's join makes one): a routine line with no twin of its own goes to the box's one log lane, #<box>-updates.
  cc-slack project <name>             from a member workspace's session, ask the daemon for the project's board row and its one thread in #<this workspace> (no channel); at most 3 an hour; the human way is `new project <name>` typed in the channel.
  cc-slack escalate --notice [--file P] [--id ID] -t "<h>/<track> <kind>" "text"   from inside a member boundary: a worker's END LINE or its Slack deliverable — posted by the host into the track's thread (the file with it, under the text) and one `loop:` line to the control seat; never a request or a page. --id posts it once (the ledger keeps it under the workspace's name); the seat's line goes every time. cc-notify (a plain call titled with the track) and cc-loop use it. Without --notice, `escalate` is cc-notify's --ask relay, and one titled `<h>/<track> …` (cc-loop's stop) also hands that workspace's own seat a `loop:` line.
  cc-slack ask [-t "title"] "text"      from a member workspace's session, ask the box's planning seat (a repo, a host-side push, a question): the daemon posts a 🙋 card in the control repo's #<repo>-threads lane on the workspace's behalf, hands it to the planning session, and carries every reply in the card's thread (the seat's or the owner's) back to #<workspace>, handed to its session; at most 5 an hour. Never ask the owner to relay.
  cc-slack seat                          the seat the daemon says owns this process (`<repo>`, `<repo>/<track>`, `<repo>@<alias>`), from the socket's pid chain and the live subscriptions; empty and exit 1 when none does, exit 2 when the daemon could not be reached at all. cc-notify reads it to decide who may ask the owner, and a caller it cannot identify (exit 2) is not the box's own hand.
  cc-slack grant allow '<rule>' [-t "why"]   from a box session (planning or a track) that a permission layer refused: the daemon posts a 🔐 grant card in the control repo's #<repo>-threads lane naming that ONE allow line; the owner's `yes <id> fix` there has the daemon write it into ~/.claude/settings.json (cc-settings grant), `no <id>` declines; the card shows ⚙️ or ❌. `cc-slack grant config KEY VALUE` is the same for one ~/.cc/config key (never a credential's). An allow or config ask goes to the box's approver first (cc-approve, APPROVER=off skips it): what the owner's merged grants cover, asked by a planning seat, the daemon writes with no card and a ⚙️ line in that lane; the rest is the card. Never a member workspace's verb, never answerable by a session. `cc-slack grant unit <file.service|.timer>` is the same card for a user unit install (file, sha256 and the enable both named). `cc-slack grant confirm '<command>' -w <window>` is the same card for a seat parked on the auto-mode confirm dialog behind a command that is not read-only (cc-model's tick raises it): the owner's `yes <id>` / `no <id>` is written to ~/.cc/state/confirm-answers/<id>, and cc-model's next tick presses that answer into the dialog — this once, never for good. Design: docs/design-seat-grant-from-slack.md.
  cc-slack permission <id> yes|no [fix]     answer a 🔐 prompt from here, the same path as a `yes <id>` Slack reply; every session's prompt but the planning session's own goes to the control repo's #<repo>-threads lane for it to decide. `fix` grants something lasting on one kind of card only: on a member workspace's WebFetch or WebSearch card, `yes <id> fix` (here or the owner's in Slack) grants that workspace the web (`cc-sandbox web`) and the card gets ⚙️; on any other card a fix is a plain yes, and the thread says nothing lasting was written. With the web grant, from its next launch those two tools are no ask rule, and auto mode judges each call. It re-reads the session's pane: a dialog still standing unchanged after the answer went out is reported as not landed (exit 1, the prompt stays open), never as delivered.
  cc-slack retire <C…>… [--to <#chan|C…>] [--dry-run]   archive channels BY ID (never by name or suffix) after recording each in ~/.cc/slack/retired.json with where its posts go now (--to, else the log lane #<box>-updates). Refuses #alerts, #approvals, the log lane, the vitals store, a member's channel and a channel a live seat routes to. --dry-run archives nothing and prints, per id, its name, whether it is archived already, and where a post aimed at it would land.
  cc-slack engine add <C…> [--name N] | rm <C…> | list   channels the dispatch engine owns, BY ID (~/.cc/slack/engine.json): this daemon hears nothing there — no session, no dir made for its name, no reply, no ! command — while the bot stays in it, since the engine reads it with the same token. One thing it does there: a person's post (not a bot's, ours, an edit or a delete; a thread reply counts) in a channel some hive loop's /var/lib/dispatch-door/<R>.poke/channel names (CC_DISPATCH_DOOR_ROOT overrides the root; the dirs are re-read at most once a minute) runs `dispatch-door <dir> poke` for R, fire and forget, at most once per R per 5 s, which ends that loop's 60 s wait. A queue its folder already holds (a paused project's) is left as it is.
  cc-slack orch-channel <target> <alias> [--parent-alias A] [--brief "…"]     give a sub-orchestrator its own channel, recorded in ~/.cc/slack/orchs.json (`cc <repo> --orch` calls it). A member workspace's orch gets #<h>--<alias> in that member's own Slack workspace (an existing one is adopted), and the janitor never archives it.
  cc-slack archive <#chan|C…> | archive --orch <target> <alias>      archive a sub-orch channel; it stops routing and leaves home.json's channel list.
  cc-slack unarchive <C…> [--superseded-by <C…>]   bring an archived sub-orch channel back and route it again; with --superseded-by a newer live channel stays the orch's home, and the old one keeps its history with one pinned line pointing there.
  cc-slack run-approved <chat> <ts>   run the command a `cc-notify --approval --run` card carries, once, as this user, and
                                      reply in the card's thread with the exit code only; the output tail goes to the owner's
                                      DM, since members read #approvals. The daemon starts it
                                      (a transient user unit, so a command that restarts the daemon still reports) when the
                                      OWNER's own 👍 lands on such a card in #approvals; anyone else's 👍 is logged and runs
                                      nothing. It checks everything again itself — the record on the host (its own, 0600, its
                                      sha256 still the command's), the card (the bot's, never edited, ENDING with that command and
                                      its `run:` stamp once a link Slack made of a domain is put back as the text it stood for,
                                      with no fence of its own or hidden character in either) and the owner's
                                      👍 on it through Slack. The owner, the token, #approvals and the record dir come from the
                                      password database's home and its ~/.cc/config, never the environment, and the command runs
                                      in an environment built there, not the caller's (SSH_AUTH_SOCK only this user's own
                                      agent socket at /run/user/<uid>/openssh_agent, so an approved push can reach its remote). It claims the card twice before
                                      it runs, on the host (an O_EXCL .ran file) and in Slack (the bot's ⏳ on the card), and
                                      either one already there refuses the run. The DM masks tokens, keys and NAME=secret
                                      values in the output's last 16 KB (RUN_MASK_CAP), cut before masking; the whole output stays in ~/.cc/approvals/run/<ts>.ran. Every refusal and
                                      every run is a line in ~/.cc/approvals/run/log. The card's thread gets ✅ or ❌ and one
                                      line: ran (exit 0), ran and failed (its exit code), or not run and why, for every
                                      refusal found once his 👍 is on a card on file in #approvals. A Slack autolink in the
                                      card (<http://host|host>, <mailto:a|a>) is read as its words when its label is its own
                                      target; one with any other label, or a backtick in it, stays a link and refuses. When
                                      systemd-run starts no unit, the daemon tries a scope of its own; when systemd gives
                                      neither, the thread gets ❌ and nothing runs. Only with no systemd-run on PATH does it
                                      start as a detached child (which dies if the command restarts cc-slackd). When his 👍
                                      is refused or the command fails, the seat that posted the card (the record's `from`) is
                                      told why by cc-msg.
  cc-slack selfcheck                  unit checks, no Slack needed (tests/selftest.sh runs it); the cases are core/tests/slack_selfcheck.py, run in this file's namespace; every state it touches is its own scratch dir, never the box's.
  cc-slack manifest --print | --config-token xoxe.xoxp-… --app A0…      paste-ready manifest, or push it onto an existing app; the owner still taps Reinstall and generates the app-level token.

Routing: #<repo> → its planning session, a reply in a track's 🧵 thread in #<repo> → that track's session (a legacy #<repo>--<track> channel routes the same), DMs and #box → the box's own Remote-Control session.
Two lanes per project: #<repo> is for the owner (questions, decisions), #<repo>-updates carries what is automated or long; a reply stays on the lane it was asked on.
A third name is not a session: #<repo>-ask is the question lane — what is typed there goes to `cc-ask <repo>` (one small-model read of the docs and the knowledge base, the source named in the reply) and comes back in the thread; no session is woken, started or provisioned for it, and a reaction there reaches nobody. The owner's ask there for a filed document ("001-0004", "the pitch") comes back as a signed-in link to it in the library, never the PDF itself.
#approvals and #alerts keep their own jobs; a sub-orch or track channel isn't split, it inherits its parent's lanes.
A sub-orchestrator gets its own channel (~/.cc/slack/orchs.json): "@alias" in the repo channel reaches it, "@main"/"@other" hands the thread back.
Override routing in ~/.cc/slack/routes.json.
EVERY channel the bot is in answers: an unmapped one starts its own session on first message (~/dev/<name>, CLAUDE.md, .cc/member-facing, a git repo), capped at 3 new dirs an hour, never for a DM, #approvals, #alerts, an archived sub-orch channel or a name that normalises to nothing.
A message never starts a <repo>/<track> session on its own; with none live (a headless worker, or a finished track) it goes to the <repo> session with the track named, and no notice is posted. Only `!restart <repo>/<track>` starts one.
ANYONE who can post in a routed channel is heard — Slack channel membership is the access control, the owner curates it; DMs stay owner-only, a stranger's DM gets 👋 and no session.
A reply can @-mention a person already in the channel; @main/@<alias> are session hand-offs, not people.
A session's post naming @main, an orch alias or a live track (reply tool, `cc-slack post`, a card) reaches that session: mirrored into its own channel with a link back, delivered once in the original thread, the poster told where it went.
A session handed another session's post 👍s it on the first tool call of the turn that post woke, so the channel shows it was read and taken on even when no reply follows; the box's 👀 still only means received, and the owner's own messages keep the reply-or-react rule.
A reaction is a verdict from anyone in the channel (a member's :+1: in #approvals merges the PR, exactly as the owner's does); DM reactions stay the owner's, and so does the :+1: on a card that carries a command (`cc-notify --approval --run`, see run-approved above). His :+1: on a 🔐 card that names no PR and carries no command runs nothing, and the card's thread says so.
A :+1: on cc-model's return card — `[return] <window>: Fable 5.1 is back…`, posted when the outage that moved a session off the primary lifts — runs `cc-model return <window>`: that session's overlapping handoff back to it (✅ when it started, ❌ and one line when it did not).
The owner's 📌 marks a thread "revisit", not a verdict — kept until the 📌 comes off, listed by `cc-slack revisit`.
Only the owner steers: permission answers, `!` commands and @alias hand-offs.
The `!` commands are `!pause`/`!resume` (each also as `-only` and `-under`), `!restart <box|repo[/track]|slack|tmux>`, `!reboot`, `!handoff`, `!status` and `!needs`, owner-only, any channel or thread; anything else typed is a message to the session.
`!status` reads back what runs, lands and idles; `!needs` reads back NEEDS YOU, which includes every post that paged the owner (a 🔒 with his mention, or a DM to his user id) until he replies in its thread, reacts to it, or a week passes (owner-asks.json).
`!pause` parks this channel's project and everything declared under it, queuing what arrives; `!resume` unparks it; a project parked on its own stays parked when its parent resumes.
`!pause-only`/`!resume-only` stop at this project and leave what is under it exactly as it was; `!pause-under`/`!resume-under` say the walk out loud and mean what the bare verbs already do. Either way the answer ends with a `Reach:` line naming how far it went, so nobody has to predict it from CC_PROJECT_CHILDREN.
~/.cc/state/owner-words.jsonl is the owner's own words: a line per message he sends where the daemon hears him, and per edit or deletion of one. It is a cache, not evidence: cc-infer fetches a cited message from Slack itself, and reads a deletion here as revoking every goal citing it.
~/.cc/state/home.json is the box's one live view and the dashboard reads it: rewritten every 30 s and within 2 s of any event, leading with what needs the owner, then running/idle counts, the backlog, the channels, load, handoff count, audit and boot. There is no Slack App Home tab: the daemon publishes a one-line pointer to the dashboard once at start and never again.
While a handoff overlap is open on a target, only the session the record calls live is delivered to (permission answers included); the muted one's reply/react/file are refused. The muted one is never delivered to, even alone: a message with no live side subscribed is held and handed over at the cutover (cc-handoff's `{"cutover"}` word, or the 30 s tick) or at the live side's hello. At the cutover the successor also gets what the predecessor was handed from 10 min before the overlap and never answered (no box post in its thread, no box reaction but 👀 on it, no 👍 from a woken turn), with a line saying so. An orch is a seat of its own: it reads its own record, `<repo>@<alias>`, never the repo's.
Every hop of a person's message leaves one receipt line in ~/.cc/receipts/<day>.jsonl (CC_RECEIPTS_DIR): received with the session its route picked, each delivery try and its result (a track's hand-on to its repo or parent seat says where it went), an expiry, and the reply, file, Slack-accepted reaction or 👍, or threaded `post -c`, that answered it with the session that made it. Every post Slack takes also leaves `posted` (its chat and ts, and the tmux window that posted it), so cc-live can draw who talks where. `cc-receipts check` reads them; nothing here does.
See ~/COMMS.md and ~/USAGE.md.

Config (~/.cc/config): SLACK_BOT_TOKEN SLACK_APP_TOKEN SLACK_OWNER_ID SLACK_CHANNEL SLACK_AUTOSTART(=1)
More Slack workspaces: SLACK_WORKSPACES="<n> …" and, per name (<N> upper-cased, - as _), SLACK_BOT_TOKEN_<N>
SLACK_APP_TOKEN_<N> SLACK_OWNER_ID_<N> SLACK_MEMBER_WS_<N>. Each gets its own Socket Mode listener; a call naming one
of its chats or users goes out with its token; only channels of member workspace SLACK_MEMBER_WS_<N> are heard there,
and everyone there but SLACK_OWNER_ID_<N> is a member. SLACK_MIRROR_<N>=1 makes it a second face on the same sessions
rather than a move: names stay in the default workspace and its channels route by id (`workspace route|channel|employee`).
SLACK_APPROVER_ID_<N> is the id there whose word counts as the member's; SLACK_INVITE_<N>="U… …" joins every channel made there.
"""
import calendar, collections, contextlib, fcntl, glob, io, json, os, pwd, re, select, shutil, signal, socket, stat, struct, subprocess, sys, tempfile, threading, time, types, unicodedata, urllib.parse, urllib.request

HOME = os.path.expanduser("~")
DIR = os.environ.get("CC_SLACK_DIR", f"{HOME}/.cc/slack")
SOCK = f"{DIR}/sock"
SELF_LINK = os.path.abspath(__file__)                # how this copy was invoked — usually the ~/bin symlink
SELF = os.path.realpath(SELF_LINK)                   # …and where that points: the file a deploy actually rewrites
SELF_MTIME = os.path.getmtime(SELF)                  # what it was when this process started (see Channel.stale)
BIN = os.path.dirname(SELF)                          # helpers come from the same bin/ as this copy (like `cc`)
ROOT = os.path.dirname(BIN)                          # the core tree: slack/app-manifest.json lives here
DEV = f"{HOME}/dev"
BOX = os.environ.get("CC_BOX") or socket.gethostname().split(".")[0]   # this box's name: it signs every post
CTL = BOX.lower()                                    # the box's control repo = the one this copy lives in; a name from an
if SELF.startswith(DEV + os.sep):
    CTL = SELF[len(DEV) + 1:].split(os.sep)[0]
VERSION = "0.1"
PERM_CARD_PREVIEW = 300   # chars of the tool input a 🔐 card shows; a longer one follows whole as the next message in its thread
PERM_RE = re.compile(r"^\s*(y|yes|n|no)\s+([a-km-z]{5})(?:\s+(fix))?\s*$", re.I)   # `fix` = lasting grant, where one exists (fix_lasts)
SENT_USING_RE = re.compile(r"\s*\*Sent using\*\s+\S+\s*$")     # claude.ai's Slack connector signs every message it sends
CHUNK = 3900
APPROVALS = "approvals"                                        # #approvals is not a session: the owner's :+1: on a bot post there merges the PR
try:   # run-approved's home, from the password database: $HOME is whoever started it, and it takes nothing from its caller
    _PW = pwd.getpwuid(os.getuid())
except KeyError:
    _PW = None
PW_HOME, PW_USER = (_PW.pw_dir or None, _PW.pw_name) if _PW else (None, "")   # no entry: run-approved refuses (run_cfg)
RUN_CARDS = f"{PW_HOME or '/nonexistent'}/.cc/approvals/run"   # cc-notify --approval --run: <card ts>.json holds the command the owner's 👍 runs (/nonexistent: passwd's own word for no home)
PLAIN_CARDS = f"{PW_HOME or '/nonexistent'}/.cc/approvals/cards"   # cc-notify --approval with no --run: <card ts>.json names the seat that asked, and the owner's 👍 is stamped in it (on_plain_card)
RUN_TS_RE = re.compile(r"^[0-9]{6,12}\.[0-9]{1,9}$")           # a card ts, and the only thing a path under RUN_CARDS is built from
RUN_TIMEOUT = 900                                              # seconds an approved command may run before it is killed and reported as exit 124
RUN_TAIL = 1500                                                # characters of its output the owner's DM shows (never #approvals: members read it)
RUN_MASK_CAP = 16384                                           # characters of its output's end that are masked at all: the tail is cut from these, so no output's length sets the mask's time
RUN_LINE = "Your 👍 runs this once on the box; the exit code comes back here and the output in your DM"   # cc-notify --run writes these words; the selfcheck holds the two to each other
# Slack stores emoji as :name:, so history hands a run card back with :+1: etc., never the glyphs cc-notify sent.
# run_card_refusal reads the card and the tail it expects through this one table.
SLACK_STORED_EMOJI = {":closed_lock_with_key:": "🔐", ":+1:": "👍", ":thumbsup:": "👍", ":question:": "❓"}
RUN_CLAIM = "hourglass_flowing_sand"                            # the bot's own reaction on a run card, placed before its command starts: Slack's record that it ran
# NAME=value, NAME: value and "NAME":"value" are masked in a run's report; quoted values mask whole, spaces included.
# Linear on purpose: the keyword is found by lookahead from the word's start (a 40 KB `token` word once took 54 s).
RUN_KEYWORDS = r"token|secret|passw(?:or)?d|api_?key|topic|webhook|credential|private_?key"
RUN_SECRET_RE = re.compile(r"(?i)\b(?=[a-z0-9_]*?(?:" + RUN_KEYWORDS + r"))([a-z0-9_]+)"
                           r"(\"?\s*[=:]\s*)(\"[^\"\n]*\"|'[^'\n]*'|[\"']?[^\s\"']+)")
RUN_NAME_RE = re.compile(r"(?i)" + RUN_KEYWORDS)   # a name the cut parted from its `=` (run_capped)
RUN_WS, RUN_TOKEN = re.compile(r"\s*"), re.compile(r"\S*")   # run_capped steps over the tokens a cut pair owes with these, by index
RUN_MASKS = (   # what SECRET_RE (the tool-preview mask) does not know, each seen in a real config or credentials file
    (re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?(?:-----END [A-Z0-9 ]*PRIVATE KEY-----|\Z)", re.S), "[redacted private key]"),
    (re.compile(r"\bsk-(?:ant-)?[A-Za-z0-9_-]{16,}"), "[redacted]"),               # Anthropic/OpenAI keys and OAuth tokens
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{20,}"), "[redacted]"),                 # a fine-grained GitHub PAT
    (re.compile(r"https?://hooks\.slack\.com/\S+"), "[redacted]"),                 # a Slack webhook: posting rights in its URL
    (re.compile(r"(\b[a-z][a-z0-9+.-]{0,63}://)[^\s/:@]+:[^\s/@]+@", re.I), r"\1[redacted]@"),   # user:pass@ in a URL; the scheme bounded, as an unbounded one tried at every `\b` of `sk-sk-…` was quadratic
)
ACK_MAX = 10                                                   # agent posts one session can be waiting to 👍 at once
REEXEC = "CC_SLACK_REEXEC"                                     # set on a re-exec'd channel server: the host initialised the copy before it
GIT_WORK = threading.Lock()                                    # two publishes fetching the same checkout at once race index.lock
