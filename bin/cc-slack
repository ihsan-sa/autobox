        f.write('#!/usr/bin/env bash\nd=$(dirname "$0")\nprintf "%s " "$@" >> "$d/calls"; printf "\\n" >> "$d/calls"\n'
                '[ -e "$d/fail" ] && { echo "no project \'$2\' — ~/dev/$2 does not exist" >&2; exit 2; }\n'
