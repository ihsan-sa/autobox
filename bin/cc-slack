    # ── the button gate: the Home tab is published PER USER, so a member gets their own copy of these buttons
    dmA = Daemon(use_slack=False); dmA.cfg = {"SLACK_OWNER_ID": "UOWNER", "SLACK_BOT_TOKEN": "xoxb-x"}; dmA.use_slack = True
