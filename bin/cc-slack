          "so meta carries ~/.cc/slack/files/X; the host path it was told before is ENOENT on every image a member "
          "sends. A target that is NOT a workspace keeps the host path it always had",
          len(gotF) == 2 and fseen == [hF, None]
          and gotF[0][1]["meta"]["file_path"] == inb + fnames[0]
          and gotF[0][1]["meta"]["file_paths"] == ",".join(inb + n for n in fnames)
          and f"{member_dir(hF)}/files/" not in "".join(str(v) for v in gotF[0][1]["meta"].values())
          and gotF[1][1]["meta"]["file_path"] == f"{DIR}/files/{fnames[0]}"
          and gotF[1][1]["meta"]["file_paths"] == ",".join(f"{DIR}/files/{n}" for n in fnames)
          # and the pair round-trips: the `file` verb translates that same in-boundary path back to the host one
          and member_files_inside(hF, f"{member_dir(hF)}/files/{fnames[0]}") == inb + fnames[0]
          and member_files_inside(hF, f"{DEV}/{hF}/x.png") == f"{DEV}/{hF}/x.png")

    subprocess.run(["rm", "-rf", f"{DEV}/alice", f"{DEV}/bob", f"{DEV}/myrepo", f"{DEV}/other",
                    f"{DEV}/{hF}", f"{DEV}/{rF}"])

    check("selfcheck: the channel-is-a-session checks never touched the ~/dev they were handed",
          DEV == scratch_dev and not os.path.exists(devP))
    # Every thread a case set off is DONE before its effects are judged — joined here, and anything still alive at
    # the deadline is NAMED, not waited out in silence. A thread that never ends must be ended by ITS case: the idle
    # worker of the per-chat executor M5's dispatch() made blocked on its queue for ever, so this join proved
    # nothing about it and burned the whole deadline (20 s of a 29 s run) — M5 now shuts its executor down.
    deadline = time.time() + 20
    for t in threading.enumerate():
        if t is not threading.current_thread():
            t.join(timeout=max(0.0, deadline - time.time()))
    lingering = [t.name for t in threading.enumerate() if t is not threading.current_thread()]
    check("selfcheck: every thread a case set off has finished — a background land/publish is judged, never raced"
          + (": still alive " + ", ".join(lingering) if lingering else ""), not lingering)
    # THE PIN is what keeps a fixture off the owner's phone, so THE PIN is what is asserted: still set at the end (no
    # case unset it or pointed it elsewhere) and every cc-notify of this run in the temp log, none in the real one.
    # Until 2026-09-01 this asserted that the real ~/.cc/notify.log had not GROWN during the run — but that log is
    # shared, and any other track finishing on this box inside those 29 s grew it: four cc-land gates went red that
    # day on a check that passed every time standalone. What is ours to assert about the real log is narrower: no
    # line it gained names a repo this run made up.
    def gained(path, before):
        """What `path` gained since it was `before` bytes long — from byte 0 when it did not exist then. A fixture
        that pages the owner on a fresh box CREATES the real log, and a scan that skipped the no-file case let
        exactly that pass (review of #148)."""
        if not os.path.exists(path):
            return ""
        with open(path, "rb") as f:
            f.seek(before or 0)
            return f.read().decode("utf-8", "replace")
    with tempfile.TemporaryDirectory(prefix="_selfcheck_nlog_") as td:
        fresh = f"{td}/notify.log"
        absent = gained(fresh, None)                                  # never created: nothing gained
        open(fresh, "a").write("[mmrepo] PR #7 merged\n")            # created mid-run, no file at the start
        created = gained(fresh, None)
        mark = os.path.getsize(fresh)
        open(fresh, "a").write("[other] fine\n")                     # existed at the start: only the tail
        grown = gained(fresh, mark)
    check("selfcheck: a real notify.log that did not exist when the run began is scanned from byte 0 — a fixture that "
          "CREATES it on a fresh box is the one that paged the owner, not a pass",
          absent == "" and "mmrepo" in created and grown == "[other] fine\n" and "mmrepo" not in grown)
    grew = gained(real_notify_log, before_notify)
    fixture_names = ("_selfcheck", "_cctest", "mmrepo", "myrepo", "no-such-repo-zz")
    named = [n for n in fixture_names if n in grew]
    check("selfcheck: NOTHING this run could reach the owner — the log-only pin is still on the whole process at the "
          "end, its log is this run's temp file, and the real ~/.cc/notify.log gained no line about a fixture"
          + (" (it did: " + ", ".join(named) + ")" if named else ""),
          os.environ.get("CC_NOTIFY_LOG_ONLY") == "1" and "_selfcheck_notify_" in os.environ.get("CC_NOTIFY_LOG", "")
          and not named)
    check("selfcheck: post()/outbox() calls this run went to a temp file — the real outbox.log is untouched", after_outbox == before_outbox)
    check("selfcheck: no case shelled out to the real cc-land or cc-publish — a queue command here would write a real "
          "landing job into this box's own queue and start a real worker that gates, MERGES and deploys, so the class "
          "is pinned for the whole process, and cases DID reach that pin (it is load-bearing, not decoration)",
          Daemon.queue_land is not real_queue_land and Daemon.land_sweep is not real_land_sweep
          and Daemon.publish_soon is not real_publish_soon and any(k == "queue" for k, *_ in deferred)
          and any(k == "sweep" for k, *_ in deferred) and any(k == "publish" for k, *_ in deferred))
    Daemon.queue_land, Daemon.land_sweep = real_queue_land, real_land_sweep
    Daemon.publish_soon = real_publish_soon
    check("selfcheck: no check wrote the live ~/.cc/slack/flags.json", not os.path.exists(f"{DIR}/{FLAGS}.selfcheck"))
    check("selfcheck: the Home dump of a fixture tab landed under the redirected DIR, never in the live ~/.cc/state "
          "(a fixture tab reached cc-secretary as the owner's view once, 2026-09-01)",
          os.path.exists(f"{DIR}/home.json") and json.load(open(f"{DIR}/home.json"))["state"].get("box") == "abox")
    denied = list(EFFECTS.denied)
    real_effects.install()
    subprocess.run(["rm", "-rf", scratch_dev])
    check("selfcheck: not one case reached an EXTERNAL effect it had not declared — no Slack call, no shell-out to "
          "another cc-* tool, no repository of this box's. Denials are counted here as well as raised because most of "
          "these calls sit inside an `except Exception: log(...)`, so the raise alone would vanish: "
          + ("; ".join(denied[:3]) if denied else "none"), not denied)
    check("selfcheck: it ran on a scratch ~/dev and put the real one back — this command has to work on a bare clone",
          DEV == f"{HOME}/dev" and EFFECTS.api_impl is slack_api and not os.path.exists(scratch_dev))
    # A FIXTURE IS NOT A BOARD (owner, 2026-09-01): a `_cctest<pid>` board — a selftest suite's — beside a real one, each
    # with the waiting row and live question that put "w1 · push refused" on the NEEDS YOU list. Every tab input reads
    # boards through home_boards, so nothing the tab renders carries the fixture while the real board's row still shows.
    _homeR = globals()["HOME"]
    hr = tempfile.mkdtemp(prefix="cc-slack-fixture-")
    try:
        globals()["HOME"] = hr
        os.makedirs(f"{hr}/.cc/boards")
        for repo in ("abox", "_cctest99999999"):
            os.makedirs(f"{hr}/.cc/state/{repo}/w1", exist_ok=True)
            open(f"{hr}/.cc/state/{repo}/w1/progress.md", "w").write("STATUS: BLOCKED: push refused: origin/track\n")
            json.dump({"repo": repo, "tracks": {"w1": {"status": "waiting", "title": "push refused", "pr": "",
                                                       "updated": "2026-08-30T21:00:00Z"}}},
                      open(f"{hr}/.cc/boards/{repo}.json", "w"))
        ftr, _, _ = home_tracks(set(), {})
        fneeds = "\n".join(home_needs({"tracks": ftr}))
        fbrows, fboards = home_board_rows(), [os.path.basename(fn) for fn, _ in home_boards()]
        own = f"_cctest{os.getpid()}"                    # …and INSIDE its run (our own pid: the suite reading its board) it is one
        json.dump({"repo": own, "tracks": {}}, open(f"{hr}/.cc/boards/{own}.json", "w"))
        fown = [os.path.basename(fn) for fn, _ in home_boards()]
        def bounded(fn, secs=10):   # a read that hangs on the pipe (a plain open would, for good) fails THIS case, not the suite
            import threading
            box = []
            def go():
                try: box.append(fn())
                except Exception as e: box.append(e)
            t = threading.Thread(target=go, daemon=True); t.start(); t.join(secs)
            return box[0] if box else "hung"
        os.mkfifo(f"{hr}/.cc/boards/pipe.json")   # A PIPE PLANTED WHERE A BOARD SHOULD BE (review of #224): the read is cc-board's opener now, so it is no board, never a hang
        fpipe = bounded(lambda: [os.path.basename(fn) for fn, _ in home_boards()])
    finally:
        globals()["HOME"] = _homeR
        subprocess.run(["rm", "-rf", hr], check=False)
    check("home_boards: a `_cctest<pid>` board is a selftest fixture, not a board — every tab input reads boards through "
          "this one pass, so its waiting row never reaches NEEDS YOU, RUNNING or a board view, while the real one's does",
          fboards == ["abox.json"] and [t["name"] for t in ftr] == ["abox/w1"]
          and fneeds.count("❓") == 1 and "push refused" in fneeds and "_cctest" not in fneeds
          and [r[0] for r in fbrows] == ["abox"])
    check("home_boards: a `_cctest<pid>` board IS a board to a process under <pid> — the same rule as cc-board `real`, so "
          "a suite reading its own board sees it while this daemon, never under a suite, does not",
          fown == [f"{own}.json", "abox.json"])
    check("home_boards: a pipe planted where a board should be is skipped, not a hang — every tab input reads boards through "
          "cc-board's opener, so a member cannot stop this daemon by planting one",
          fpipe == [f"{own}.json", "abox.json"])
    print(f"selfcheck: {len(fails)} failed")
    return 1 if fails else 0


def cmd_manifest(argv):
    """apps.manifest.update with an app configuration token (api.slack.com/apps → Your App Configuration Tokens)."""
    tok = app = None
    i = 0
    while i < len(argv):
        if argv[i] == "--config-token":
            tok = argv[i + 1]; i += 2
        elif argv[i] == "--app":
            app = argv[i + 1]; i += 2
        else:
            i += 1
    manifest = open(f"{ROOT}/slack/app-manifest.json").read().replace("<box>", BOX)   # the shipped manifest is a template
    if "--print" in argv:                                    # paste-ready copy for api.slack.com/apps → App Manifest (Slack rejects the raw template)
        print(manifest, end=""); return 0
    if not (tok and app):
        print("cc-slack manifest --print | --config-token xoxe.xoxp-… --app A0…   (App ID: api.slack.com/apps → the app → Basic Information)"); return 2
    try:
        v = api("apps.manifest.validate", tok, manifest=manifest, app_id=app)
    except RuntimeError as e:
        print(f"manifest rejected: {e}"); return 1
    r = api("apps.manifest.update", tok, app_id=app, manifest=manifest)
    print(f"manifest applied to {r.get('app_id', app)}; permissions changed: {r.get('permissions_updated')}")
    print(f"remaining taps: 1) https://api.slack.com/apps/{app}/install-on-team → Reinstall → Allow → copy the Bot User OAuth Token (xoxb-…)\n"
          f"                2) https://api.slack.com/apps/{app}/general → App-Level Tokens → Generate (connections:write) → copy xapp-…\n"
          f"                3) on the box: cc slack setup --bot xoxb-… --app xapp-… --owner-email <email>; cc slack on; cc slack mkchannel <repo> …")
    return 0


def resolve_channel(cfg, name):
    """#name → channel id (only channels the bot is a member of); cached on disk for an hour."""
    path = f"{DIR}/channels.json"
    try:
        c = json.load(open(path))
        if time.time() - c.get("_t", 0) < 3600 and name in c:
            return c[name]
    except Exception:
        c = {}
    cur, found = None, {}
    try:
        while True:
            r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
            for ch in r["channels"]:
                if ch.get("is_member"):
                    found[ch["name"]] = ch["id"]
            cur = r.get("response_metadata", {}).get("next_cursor") or None
            if not cur:
                break
        found["_t"] = time.time()
        os.makedirs(DIR, exist_ok=True)
        json.dump(found, open(path, "w"))
    except Exception:
        pass
    return found.get(name)


def resolve_chat(cfg, s):
    """#name → channel id via resolve_channel; a bare C…/D…/U… id passes through unchanged."""
    return (resolve_channel(cfg, s[1:]) or s) if s.startswith("#") else s


def clamp_n(s, default, cap):
    """Parse a user-given count, clamped to [1, cap]; blank/non-numeric → default. The clamp IS the information diet."""
    return min(max(int(s), 1), cap) if s and s.isdigit() else default


def plain(text, uname, handle=None):
    """Slack markup -> readable text. `handle` (default: uname) renders in-text mentions as the @handle a session can
    write back; the caller keeps uname for the readable author column."""
    handle = handle or uname
    text = re.sub(r"<@(U[A-Z0-9]+)>", lambda m: "@" + handle(m.group(1)), text or "")
    text = re.sub(r"<(https?://[^|>]+)\|([^>]+)>", r"\2 (\1)", text)
    text = re.sub(r"<(https?://[^>]+)>", r"\1", text)
    return text.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")


def fmt_history(cfg, msgs):
    """Compact "HH:MM user: text" lines, each message truncated at 300 chars (marked). Shared by the CLI and the history/thread tools."""
    tok = cfg.get("SLACK_BOT_TOKEN"); names = {}
    def info(uid):
        if uid not in names:
            try:
                u = api("users.info", tok, user=uid)["user"]
                names[uid] = (u.get("real_name") or uid, (u.get("name") or "").strip() or None)
            except Exception:
                names[uid] = (uid, None)
        return names[uid]
    def uname(uid):
        return info(uid)[0]
    def handle(uid):
        return info(uid)[1] or info(uid)[0]
    out = []
    for m in msgs:
        who = m.get("username") if m.get("bot_id") and not m.get("user") else uname(m.get("user", "?"))
        t = time.strftime("%H:%M", time.localtime(float(m.get("ts") or 0)))
        text = plain(m.get("text", ""), uname, handle)
        text = text[:300] + " …[truncated]" if len(text) > 300 else text
        out.append(f"{t} {who}: {text}")
    return "\n".join(out) or "(no messages)"


def replies_tail(cfg, chat, ts, n, pages=10):
    """The LAST n messages of a thread (root first if it fits). conversations.replies is oldest-first and limit=N returns the
    OLDEST N, so a thread with ≥20 replies read with limit=20 shows nothing recent: page through the cursor and keep the tail."""
    tok = cfg["SLACK_BOT_TOKEN"]
    msgs, cur = [], None
    for _ in range(pages):
        kw = {"cursor": cur} if cur else {}
        r = api("conversations.replies", tok, channel=chat, ts=ts, limit="200", **kw)
        msgs.extend(r.get("messages") or [])
        cur = (r.get("response_metadata") or {}).get("next_cursor") or None
        if not (r.get("has_more") and cur):
            break
    return msgs[-n:] if n and len(msgs) > n else msgs


def own_message(cfg, chat, ts):
    """The message at (chat, ts) exists and was posted by this bot — required before chat.update/chat.delete touch it."""
    tok = cfg["SLACK_BOT_TOKEN"]
    msgs = api("conversations.history", tok, channel=chat, latest=ts, inclusive="true", limit="1")["messages"]
    msg = msgs[0] if msgs and msgs[0].get("ts") == ts else None
    if not msg:
        return False
    me = api("auth.test", tok)
    # a signed post (username= override ⇒ subtype bot_message) carries bot_id and NO user: matching only user_id refused our own posts
    return msg.get("user") == me.get("user_id") or bool(me.get("bot_id")) and msg.get("bot_id") == me.get("bot_id")


def display_name(target, alias=None):
    """<box> · <session> for chat.postMessage username= (chat:write.customize); CC_SLACK_PLAIN_NAME=1 disables (Channel.call handles that).
    An aliased orchestrator (peer of target's main session) is "<box> · <alias>"; the control repo's own session is "· planning"."""
    if alias:
        return f"{BOX} · {alias}"
    return f"{BOX} · " + ("box" if target == "box" else "planning" if target == CTL else target)


STARTUP_MCP = ("Use this MCP server", "MCP servers may execute code")      # Claude Code's MCP-server trust prompt
STARTUP_DEV = ("development channels", "local development")               # …and its development-channels warning


def startup_prompt(pane):
    """Is one of the two startup dialogs on the pane? Read-only — accept_prompts is what presses them."""
    return any(m in pane for m in STARTUP_MCP + STARTUP_DEV)


def accept_prompts(wid):
    """Press through the two startup dialogs that block a session from ever loading its channel: Claude Code's MCP-server
    trust prompt ("Use this MCP server" — option 2 = this and all future servers in the project) and the development-channels
    warning. Returns True when something was pressed (the session is now starting), False when the pane shows no prompt."""
    rc, pane = tmux("capture-pane", "-p", "-t", wid)
    if rc != 0:
        return False
    if any(m in pane for m in STARTUP_MCP):
        tmux("send-keys", "-t", wid, "-l", "--", "2"); time.sleep(0.3); tmux("send-keys", "-t", wid, "Enter")
        return True
    if any(m in pane for m in STARTUP_DEV):
        tmux("send-keys", "-t", wid, "Enter")
        time.sleep(1.5)
        rc, pane = tmux("capture-pane", "-p", "-t", wid)
        if "local development" in pane:          # still open: select the first option explicitly
            tmux("send-keys", "-t", wid, "Up", "Enter")
        return True
    return False


def cmd_accept_dialog(win, seconds=180):
    """Auto-accept the startup dialogs in a tmux window (dev-channels warning, MCP-server trust) for up to `seconds`."""
    deadline = time.time() + seconds; pressed = 0
    while time.time() < deadline:
        wid, _ = tmux_window(win)
        if wid and accept_prompts(wid):
            pressed += 1; time.sleep(2)               # a second prompt may follow the first (trust, then dev-channels)
            if pressed >= 2:
                return 0
        elif pressed:
            return 0
        time.sleep(1)
    return 0 if pressed else 1


def cmd_history(argv):
    if not (1 <= len(argv) <= 2):
        print("cc-slack history <#chan|C…|D…> [n]   (default 20, max 100)", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack history: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    n = clamp_n(argv[1] if len(argv) == 2 else None, 20, 100)
    try:
        msgs = api("conversations.history", cfg["SLACK_BOT_TOKEN"], channel=resolve_chat(cfg, argv[0]), limit=str(n))["messages"]
    except Exception as e:
        print(f"cc-slack history: {e}", file=sys.stderr); return 1
    print(fmt_history(cfg, list(reversed(msgs)))); return 0


def cmd_thread(argv):
    if not (2 <= len(argv) <= 3):
        print("cc-slack thread <#chan|C…> <ts> [n]   (default full thread, max 50)", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack thread: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    n = clamp_n(argv[2] if len(argv) == 3 else None, 50, 50)
    try:
        msgs = replies_tail(cfg, resolve_chat(cfg, argv[0]), argv[1], n)
    except Exception as e:
        print(f"cc-slack thread: {e}", file=sys.stderr); return 1
    print(fmt_history(cfg, msgs)); return 0


def cmd_edit(argv):
    if len(argv) < 3:
        print("cc-slack edit <chan> <ts> <new text>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack edit: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, ts = resolve_chat(cfg, argv[0]), argv[1]
    try:
        if not own_message(cfg, chat, ts):
            print("cc-slack edit: refusing — not a message this bot posted", file=sys.stderr); return 1
        api("chat.update", cfg["SLACK_BOT_TOKEN"], channel=chat, ts=ts, text=linkify_mentions(cfg, mrkdwn(" ".join(argv[2:])), chat))
    except Exception as e:
        print(f"cc-slack edit: {e}", file=sys.stderr); return 1
    return 0


def cmd_unsay(argv):
    if len(argv) != 2:
        print("cc-slack unsay <chan> <ts>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack unsay: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, ts = resolve_chat(cfg, argv[0]), argv[1]
    try:
        if not own_message(cfg, chat, ts):
            print("cc-slack unsay: refusing — not a message this bot posted", file=sys.stderr); return 1
        api("chat.delete", cfg["SLACK_BOT_TOKEN"], channel=chat, ts=ts)
    except Exception as e:
        print(f"cc-slack unsay: {e}", file=sys.stderr); return 1
    return 0


def cmd_pin(argv, remove=False):
    verb = "unpin" if remove else "pin"
    if len(argv) != 2:
        print(f"cc-slack {verb} <chan> <ts>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print(f"cc-slack {verb}: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    try:
        api("pins.remove" if remove else "pins.add", cfg["SLACK_BOT_TOKEN"], channel=resolve_chat(cfg, argv[0]), timestamp=argv[1])
    except Exception as e:
        print(f"cc-slack {verb}: {e}", file=sys.stderr); return 1
    return 0


def load_canvases():
    """Which canvas is which channel's, as we last saw it (see CANVASES). Read from disk on every use, like the other
    small tables: a canvas is written from the CLI, never from the daemon, so there is no cache to invalidate."""
    try:
        d = json.load(open(f"{DIR}/{CANVASES}"))
        return {k: v for k, v in d.items() if isinstance(v, dict)} if isinstance(d, dict) else {}
    except Exception:
        return {}


def remember_canvas(chat, canvas_id, title):
    """Atomic, 0600, like flags/marks. This table is what makes the SECOND `cc-slack canvas` an edit: on a free plan
    Slack may report no canvas for a channel that has one, and then a create comes back free_team_canvas_tab_already_exists."""
    cans = load_canvases()
    cans[chat] = {"canvas_id": canvas_id, "title": title, "updated": int(time.time())}
    try:
        os.makedirs(DIR, exist_ok=True)
        tmp = f"{DIR}/{CANVASES}.tmp"
        with open(tmp, "w") as f:
            os.fchmod(f.fileno(), 0o600); json.dump(cans, f)
        os.replace(tmp, f"{DIR}/{CANVASES}")
    except Exception as e:
        log(f"canvases: save failed: {e!r}")      # only costs the next call a lookup


def canvas_of(tok, chat):
    """The id of the channel's existing canvas, or None — asked of Slack itself, in one conversations.info: the
    documented properties.canvas.file_id, and the canvas TAB (properties.tabs) this workspace's plan fills in instead."""
    try:
        props = api("conversations.info", tok, channel=chat)["channel"].get("properties") or {}
    except Exception:
        return None                               # a channel we cannot read is the create branch's problem to report
    return ((props.get("canvas") or {}).get("file_id")
            or next((t["data"]["file_id"] for t in (props.get("tabs") or [])
                     if t.get("type") == "canvas" and (t.get("data") or {}).get("file_id")), None))


def canvas_in_files(tok, chat):
    """Last resort: the channel's canvas as a file shared into it (a canvas is a "quip" file). This is the only lookup
    that answers when conversations.info reports no canvas at all — which is exactly when a create would be rejected."""
    try:
        files = api("files.list", tok, channel=chat, types="canvases", count="200").get("files") or []
    except Exception:
        return None
    return next((f["id"] for f in files if f.get("id") and f.get("filetype") in ("quip", "canvas")), None)


def cmd_canvas(argv):
    """canvas <#chan|C…> <title>, markdown on stdin. Creates the channel's canvas if it has none, else replaces its content wholesale."""
    if len(argv) != 2:
        print("cc-slack canvas <#chan|C…> <title>   (markdown on stdin)", file=sys.stderr); return 2
    cfg = load_cfg(); tok = cfg.get("SLACK_BOT_TOKEN")
    if not tok:
        print("cc-slack canvas: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, title, md = resolve_chat(cfg, argv[0]), argv[1], sys.stdin.read()
    changes = json.dumps([{"operation": "replace", "document_content": {"type": "markdown", "markdown": md}}])
    def replace(cid):
        api("canvases.edit", tok, canvas_id=cid, changes=changes); return cid
    try:
        canvas_id, cached = None, (load_canvases().get(chat) or {}).get("canvas_id")
        if cached:                                # the id we wrote last time: no lookup at all in the common case
            try:
                canvas_id = replace(cached)
            except RuntimeError as e:
                if "not_found" not in str(e):
                    raise
                log(f"canvas: {cached} is gone — resolving {chat}'s canvas again")
        if not canvas_id:
            found = canvas_of(tok, chat) or canvas_in_files(tok, chat)
            if found:
                canvas_id = replace(found)
            else:
                try:
                    canvas_id = api("conversations.canvases.create", tok, channel_id=chat,
                                    document_content=json.dumps({"type": "markdown", "markdown": md}), title=title)["canvas_id"]
                except RuntimeError as e:
                    if "free_team_canvas_tab_already_exists" not in str(e):
                        raise
                    found = canvas_in_files(tok, chat)     # Slack says one exists, so it does: find it and replace it
                    if not found:
                        print(f"cc-slack canvas: {argv[0]} already has a canvas, but its id could not be resolved "
                              "(conversations.info and files.list both report none) — open the channel's canvas tab and "
                              "pass its F… id to canvases.edit by hand", file=sys.stderr)
                        return 1
                    canvas_id = replace(found)
        remember_canvas(chat, canvas_id, title)
    except Exception as e:
        print(f"cc-slack canvas: {e}", file=sys.stderr); return 1
    print(canvas_id or ""); return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "daemon":
        Daemon(use_slack="--no-slack" not in rest).run()
    elif cmd == "channel":
        target = rest[0] if rest else detect_target()
        if not valid_target(target):
            print(f"cc-slack channel: no target for cwd {os.getcwd()} (give one: cc-slack channel <repo>[/<track>]|box)", file=sys.stderr); return 2
        log(f"channel server for target {target}")
        ch = Channel(target); ch.aio.run(ch.run())
    elif cmd == "inject":
        start = True
        if rest and rest[0] == "--no-start":
            start = False; rest = rest[1:]
        if len(rest) < 2:
            print("cc-slack inject [--no-start] <target> \"text\"", file=sys.stderr); return 2
        try:
            r = sock_request({"inject": rest[0], "content": " ".join(rest[1:]), "start": start})
        except Exception as e:
            print(f"daemon not running ({e.__class__.__name__}) — cc slack on", file=sys.stderr); return 1
        print(r.get("result") or r.get("error")); return 0 if r.get("ok") else 1
    elif cmd == "dispatch":   # inside a member boundary: `cc <h> <track> --go` asks the host to run it (Daemon.member_verb)
        if not rest:
            print("cc-slack dispatch <handle>/<track> [--loop N] [--budget USD] [--model M] [--turns N] [--effort E]", file=sys.stderr); return 2
        try:
            r = sock_request({"dispatch": rest[0], "opts": rest[1:]}, timeout=200)
        except Exception as e:
            print(f"the box's socket did not answer ({e.__class__.__name__}) — nothing dispatched", file=sys.stderr); return 1
        print(r.get("text") or r.get("error") or ""); return 0 if r.get("ok") else 1
    elif cmd == "escalate":   # inside a member boundary: cc-notify's push rungs need ~/.cc/config, which is not in there.
        # The daemon makes the call with the token and delivers it to the OWNER (Daemon.member_verb "escalate").
        title, prio, args = "", "default", []
        i = 0
        while i < len(rest):
            if rest[i] == "-t" and i + 1 < len(rest):
                title = rest[i + 1]; i += 2
            elif rest[i] == "-p" and i + 1 < len(rest):
                prio = rest[i + 1]; i += 2
            else:
                args.append(rest[i]); i += 1
        text = " ".join(args) if args else sys.stdin.read()
        try:
            r = sock_request({"escalate": title, "priority": prio, "text": text}, timeout=60)
        except Exception as e:
            print(f"the workspace's Slack link did not answer ({e.__class__.__name__}) — nobody was told", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "project":   # inside a member boundary: the session ASKS, the daemon creates (Daemon.member_verb
        # "project"). Only the leaf travels — the workspace half is the socket's, so this cannot name another lane.
        name = rest[0] if rest else ""
        if not name or name.startswith("-"):
            print("cc-slack project <name>   ask for #<this workspace>--<name>", file=sys.stderr); return 2
        try:
            r = sock_request({"project": name}, timeout=120)   # longer than escalate's 60: making the pair is
            # two channel creates, a topic and the invites, all inside the daemon's answer to this one request
        except Exception as e:
            print(f"the workspace's Slack link did not answer ({e.__class__.__name__}) — no channel was asked for", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "status":
        return cmd_status()
    elif cmd == "channels":
        return cmd_channels()
    elif cmd == "mkchannel":
        return cmd_mkchannel(rest)
    elif cmd == "updates-sweep":
        return cmd_updates_sweep(rest)
    elif cmd == "member":
        return cmd_member(rest)
    elif cmd == "members":
        return cmd_members()
    elif cmd == "orch-channel":
        return cmd_orch_channel(rest)
    elif cmd == "archive":
        return cmd_archive(rest)
    elif cmd == "manifest":
        return cmd_manifest(rest)
    elif cmd == "selfcheck":
        return cmd_selfcheck()
    elif cmd == "setup":
        return cmd_setup(rest)
    elif cmd == "post":
        return cmd_post_file(rest) if "--file" in rest else cmd_post(rest)
    elif cmd == "post-approval":
        return cmd_post_approval(rest)
    elif cmd == "approvals-sweep":
        return cmd_approvals_sweep(rest)
    elif cmd == "accept-dialog":
        return cmd_accept_dialog(rest[0] if rest else "box")
    elif cmd == "history":
        return cmd_history(rest)
    elif cmd == "thread":
        return cmd_thread(rest)
    elif cmd == "edit":
        return cmd_edit(rest)
    elif cmd == "unsay":
        return cmd_unsay(rest)
    elif cmd == "pin":
        return cmd_pin(rest)
    elif cmd == "unpin":
        return cmd_pin(rest, remove=True)
    elif cmd == "canvas":
        return cmd_canvas(rest)
    else:
        print(__doc__.strip()); return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
