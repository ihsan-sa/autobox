                        r"|AKIA[0-9A-Z]{12,}|gh[pousr]_[A-Za-z0-9]{20,})")   # what a tool preview relayed to Slack must never carry
BROADCAST = ("here", "channel", "everyone", "group")          # left as literal text: the box does not notify a whole channel
