class Channel:
    def __init__(self, target):
        self.target, self.cfg, self.link, self.daemon_ok = target, load_cfg(), None, None
        self.alias = os.environ.get("CC_SLACK_ALIAS") or None   # set by `cc <repo> --orch <alias>`: peer session, same target
        if not self.alias and perms_seat_repo(os.getcwd()):
            self.alias = DEAF_ALIAS   # the permission seat: the repo's target passes the hello check, and this alias is deaf in the daemon
        self.handoff = os.environ.get("CC_HANDOFF") or None     # set by `cc __runnext`: this is the successor session
        self.member = os.environ.get("CC_MEMBER_SANDBOX") == "1"   # in a workspace boundary: no token, socket is the member's scoped link
        self.link_started = False   # link starts only after notifications/initialized, else backlog is emitted pre-handshake and dropped
        self.acks = []              # agent posts handed to this session, waiting for the 👍 its next turn puts on them
        self.asked = {}             # (chat, ts) of posts handed to this session: a reply there answers, anywhere else it wakes
        import asyncio
        self.aio = asyncio
        self.out_lock = asyncio.Lock()

    async def send(self, obj):
        async with self.out_lock:
            sys.stdout.buffer.write((json.dumps(obj) + "\n").encode()); sys.stdout.buffer.flush()

    async def run(self):
        loop = self.loop = self.aio.get_running_loop()
        reader = self.aio.StreamReader()
        await loop.connect_read_pipe(lambda: self.aio.StreamReaderProtocol(reader), sys.stdin.buffer)
        if os.environ.get(REEXEC) and not self.link_started:
            self.link_started = True                        # a re-exec lands mid-session, after the host's init: start the link ourselves
            self.aio.create_task(self._link_when_ready())
        while True:
            line = await reader.readline()
            if not line:
                break
            try:
                msg = json.loads(line)
            except Exception:
                continue
            try:
                await self.handle(msg)
            except Exception as e:
                log(f"channel error: {e!r}")
            if self.should_reexec(msg.get("method")):
                self.reexec()
        os._exit(0)

    # -- running the code that is deployed, not the code we started with
    def stale(self):
        """Has this file been replaced under us? A session's channel server keeps the bytes it started with for its whole life, so a daemon restart silently un-deploys every change for every session already open."""
        try:
            now = os.path.realpath(SELF_LINK)   # the ~/bin symlink may point somewhere new since we started
            return now != SELF or os.path.getmtime(now) != SELF_MTIME
        except OSError:
            return False                        # mid-install the file can be briefly absent: ask again next time

    def should_reexec(self, method):
        """Only between requests, after a tools/call: the host is waiting on nothing then. Mid-handshake it would drop the one-time message that subscribes this session to Slack."""
        return method == "tools/call" and self.stale()

    def reexec(self):
        """Same pid, same stdin/stdout: a stdio server can step into the deployed copy without the host noticing."""
        log(f"channel: {SELF_LINK} was redeployed — re-exec into it")
        try:
            sys.stdout.buffer.flush()
            os.execve(sys.executable, [sys.executable, SELF_LINK] + sys.argv[1:], {**os.environ, REEXEC: "1"})
        except Exception as e:
            log(f"channel: re-exec failed ({e!r}) — carrying on with the code we have")

    async def handle(self, msg):
        m, id_, p = msg.get("method"), msg.get("id"), msg.get("params") or {}
        if m == "initialize":
            pv = p.get("protocolVersion", "2025-06-18")
            if pv not in ("2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"):
                pv = "2025-06-18"
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {
                "protocolVersion": pv,
                "capabilities": {"tools": {}, "experimental": {"claude/channel": {}, "claude/channel/permission": {}}},
                "serverInfo": {"name": "cc-slack", "version": VERSION}, "instructions": INSTRUCTIONS}})
        elif m == "notifications/initialized":
            if not self.link_started:   # subscribing at process start would race the handshake and drop a queued message
                self.link_started = True
                self.aio.create_task(self._link_when_ready())
        elif m == "ping":
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {}})
        elif m == "tools/list":
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {"tools": TOOLS}})
        elif m == "tools/call":
            text, err = await self.aio.to_thread(self.call, p.get("name"), p.get("arguments") or {})
            await self.send({"jsonrpc": "2.0", "id": id_, "result": {"content": [{"type": "text", "text": text}], "isError": err}})
            await self.ack_woken()      # this session is in a turn: 👍 the agent post that woke it (after the result, never before)
        elif m == "notifications/claude/channel/permission_request":
            await self.to_daemon({"type": "permission_request", **{k: str(v) for k, v in p.items()}})
        elif m and m.startswith("notifications/"):
            pass
        elif id_ is not None:
            await self.send({"jsonrpc": "2.0", "id": id_, "error": {"code": -32601, "message": f"unknown method {m}"}})

    def muted(self):
        """The non-live side of an open handoff may read Slack but must not speak into it; these tools call the Slack API directly so they carry their own mute. An orch reads its own record (handoff_key), never the repo's."""
        rec = handoff_record(handoff_key(self.target, self.alias))
        return rec is not None and handoff_muted(rec, self.handoff)

    def woke_by(self, meta):
        """Remember an agent's post so this session's next turn can 👍 it. `from` is in the meta of a post routed by
        Daemon.wake_channel / route_mentions and of nothing else, so it marks exactly a post another session handed
        to this one — never the owner's own message (which keeps its reply-or-react rule) and never this session's
        own post (a poster is handed back "own", never the post itself). Kept here and not in the daemon: the turn
        that reads the post is the one this server sees the next tools/call from."""
        if meta.get("from") and meta.get("chat_id") and meta.get("ts"):
            self.acks.append((meta["chat_id"], meta["ts"]))
            del self.acks[:-ACK_MAX]     # woken this often with no turn in between: queueing, not reading

    def asked_in(self, meta):
        """Where this session was asked: a reply or file there answers the asker, one anywhere else is this session's
        post into another's channel and wakes it (wants_wake)."""
        for k in ("thread_ts", "ts"):
            if meta.get("chat_id") and meta.get(k):
                self.asked[(meta["chat_id"], meta[k])] = 1
        while len(self.asked) > 500:
            del self.asked[next(iter(self.asked))]

    def wants_wake(self, chat, a):
        """True for a reply/file into a thread or channel this session was not asked in (owner, 2026-09-23: agents'
        posts were never read in). The daemon's wake decides the rest: its own channel is "own", a DM nobody's."""
        where = a.get("thread_ts") or a.get("ts")
        return chat != "local" and not (where and (chat, where) in self.asked)

    async def ack_woken(self):
        """👍 each agent post this turn woke, once, riding that turn — no extra wake-up, no poll, no message.
        The daemon puts the reaction on: it holds the token, and inside a member workspace this process has none.
        Nothing is said by the muted half of a handoff (the live side owns the channel) or by a --go worker, which
        never speaks in the owner's channels; either way the post is dropped rather than held for a later turn."""
        if not self.acks:
            return
        posts, self.acks = self.acks, []
        if os.environ.get("CC_ROLE") == "worker" or self.muted():
            return
        for chat, ts in posts:
            await self.to_daemon({"type": "ack", "chat": chat, "ts": ts})

    def call(self, name, a):
        if os.environ.get("CC_ROLE") == "worker":
            return "Slack tools are for interactive sessions", True   # a --go worker must not post to the owner's channels
        if name in ("reply", "react", "file"):
            why = not_a_chat(a.get("chat_id") or "")      # a box wake has no thread: refused before anything is sent or logged
            if why:
                return why, True
        if self.member:
            return self.member_call(name, a)
        if name in ("reply", "react", "file") and self.muted():
            return ("not sent — a handoff overlap is open on this target and the OTHER session is live: it owns the "
                    "channel until the cutover, so nothing you post here would be the box's one voice. Read the "
                    "thread, ask it what you need, and speak once you are live (`cc-handoff --status`)."), True
        try:
            if name == "reply":
                chat = a.get("chat_id") or ""
                m = PERM_RE.match(a.get("text", "") or "")
                if m:
                    # the reply tool also answers a relayed permission prompt: `yes <id>` takes the same socket verb `cc-slack permission` does; nothing is posted here, the daemon's own thread line says what was decided.
                    try:
                        r = sock_request({"permission": m.group(2).lower(), "answer": m.group(1).lower(),
                                          "fix": bool(m.group(3))}, timeout=60)
                    except Exception as e:
                        return f"not answered — the daemon did not take it ({e.__class__.__name__}); nothing was posted", True
                    if not r.get("ok"):
                        return f"not answered — {r.get('error')}; nothing was posted", True
                    return r.get("text") or "answered", False
                # short by construction: measures what a reader would skip and hands it back unsent rather than send a message he won't read; not for a member-facing session or the box's own inject path.
                if chat != "local" and not member_facing_here():
                    why = reply_shape(a.get("text", ""))
                    if why:
                        return why, True
                # an @handle that resolves to nobody is sent as code, not a plain "@Name", and named back in the result so a missed escalation is noticed. needs_owner is the only way to mention the owner for real.
                dec = bool(a.get("needs_owner"))
                if dec and undeclared_permission(a, a.get("text", "")):
                    return DECLARE_PERMISSION, True
                asked = ""
                ctl_seat = self.target == CTL and not self.alias
                if dec and a.get("permission"):
                    # A PERMISSION QUESTION GOES TO THE PERMISSION SESSION FIRST, from every seat, this repo's own
                    # included: an ask line in its ledger and nobody mentioned. Only when the ledger does not take it
                    # does another seat's ask go on to its planner request below; the control seat's is handed back.
                    frm = self.target + (f"@{self.alias}" if self.alias else "")
                    where = msg_link(self.cfg, chat, a.get("thread_ts") or a.get("ts") or "") or (
                        f"{chat}" + (f" thread {a.get('thread_ts')}" if a.get("thread_ts") else ""))
                    filed, asked, pwhy = perms_ask(self.target.split("/")[0], a.get("text", ""), frm, where)
                    if filed:
                        dec = False
                    elif ctl_seat:
                        # THE CONTROL SEAT'S USUAL WAY IS HIS DOOR (the 🔒 head here, owner_decision's card from a
                        # -threads lane), and a permission question never takes it because the ledger was busy or
                        # broken: nothing is posted and the session gets a failure it can retry. The other seats'
                        # usual way, below, is a planner request, which a person reads and which pages nobody.
                        return (f"not sent — this is a permission question and the permission session's ledger did not "
                                f"take it ({pwhy}). Nothing was posted and the owner was not mentioned. Send the same "
                                "reply again in a minute; if the ledger keeps refusing, post it without needs_owner and "
                                "say in it that the permission session's ledger is refusing asks."), True
                lane = chat_name(self.cfg, chat) if dec and ctl_seat else ""   # only this seat's post can carry the head
                if dec and ctl_seat and threads_lane(lane):
                    # …AND ONLY WHERE HE READS IT. The rule below is WHO is asking; this one is WHERE the ask would
                    # land, and the seat that passes the first still fails this one in a -threads lane: answering a
                    # member's 🙋 card, or the 🔐 card tell_seat hands this seat with that card's chat and thread,
                    # put "🔒 @owner" inside a thread only sessions read. The reply stays in that thread without the
                    # head and the question becomes the one 🔒 card in #<ctl> (owner_decision).
                    asked += owner_decision(self.cfg, a.get("text", ""), chat, a.get("thread_ts") or a.get("ts") or "", lane)
                    dec = False
                elif dec and not ctl_seat:
                    # …AND ONLY THE CONTROL REPO'S OWN SEAT DECLARES IT. The same reading the daemon uses for a 🔐 card
                    # (permission_chat, relay_permission): a track, an orch, the box session or another repo's planning
                    # seat is not it, so its needs_owner is the planner request every other ask of theirs is, and the
                    # reply goes into the thread without 🔒 and his mention (comms-contract.md, "Questions go to
                    # whoever can answer them"). The target is cwd's (detect_target, checked against the caller's own
                    # cwd when it says hello) and not the socket's: this post carries the box's token and never passes
                    # the daemon, so a daemon that is down must not quietly demote the seat's own escalation to a
                    # request nobody has been woken for. The ASK is read again out there — cc-notify's is_control asks
                    # `cc-slack seat`, and names the asker from that, which is why no --from is passed here.
                    asked += owner_ask(f"{self.target} needs a decision", a.get("text", ""),
                                      where=f"{chat}" + (f" thread {a.get('thread_ts')}" if a.get("thread_ts") else ""))
                    dec = False
                missed = unresolved_mentions(self.cfg, a.get("text", ""), chat if chat != "local" else None, decision=dec)
                n, pts = post(self.cfg, chat, a.get("text", ""), a.get("thread_ts") or None, username=display_name(self.target, self.alias),
                              ts=a.get("ts") or None, decision=dec)
                if n:
                    answered(chat, a.get("ts"), a.get("thread_ts"), seat_name(self.target, self.alias), "reply", pid=os.getpid())
                routed, named = "", bool(alias_mentions(a.get("text", "")))
                wake = self.wants_wake(chat, a)
                if pts and chat != "local" and (named or a.get("thread_ts") or wake):
                    # @<alias> is a hand-off: the daemon routes it (route_mentions); a threaded reply may answer a member
                    # workspace's ask, which the daemon carries to the member (ask_hop) — one local call tells both
                    r = {}
                    try:
                        r = sock_request({"wake" if wake else "mention": chat, "ts": pts, "thread_ts": a.get("thread_ts") or None, "text": a.get("text", ""),
                                          "self": [self.target, self.alias]}, timeout=15)
                        if named:
                            routed = ("\n\nMENTIONS NOT ROUTED: the box sees no live session behind this reply, so no session you @-named was woken"
                                      if r.get("result") == "not-a-session" else mentions_line(r.get("mentions")) if r.get("ok") else
                                      f"\n\nMENTIONS NOT ROUTED: the daemon refused ({str(r.get('error'))[:120]}), so no session you @-named was woken")
                    except Exception as e:
                        if named:
                            routed = f"\n\nMENTIONS NOT ROUTED: the daemon did not answer ({e.__class__.__name__}), so no session you @-named was woken"
                    routed += ask_line(r.get("ask"))
                    if wake and r.get("target"):
                        routed += (f"\n\nWOKE NOBODY on {r['target']} ({r.get('result')}) — {r['recorded']}" if r.get("recorded")
                                   else f"\n\nhanded to {r['target']} ({r.get('result')})")
                if a.get("ts"):
                    react(self.cfg, chat, a["ts"], "eyes", remove=True)   # the 👀 comes off, nothing replaces it
                return ((f"sent ({n} message(s))" if n else "logged to ~/.cc/slack/outbox.log (no SLACK_BOT_TOKEN)")
                        + mention_warning(missed) + routed + asked), False
            if name == "file":
                chat = a.get("chat_id") or ""
                try:
                    path = check_upload_path(a.get("path", ""))
                    fid, _ = upload_file(self.cfg, path, chat, a.get("thread_ts") or None,
                                         comment=a.get("text") or None, title=a.get("title") or None,
                                         ts=a.get("ts") or None)
                except UploadRefused as e:
                    return f"not sent — {e}", True
                if a.get("ts"):
                    react(self.cfg, chat, a["ts"], "eyes", remove=True)   # the file is the answer: 👀 comes off
                if fid:
                    answered(chat, a.get("ts"), a.get("thread_ts"), seat_name(self.target, self.alias), "file", pid=os.getpid())
                if not fid:
                    return (f"NOT sent to Slack — logged to {DIR}/outbox.log (no SLACK_BOT_TOKEN); "
                            "nothing reached anyone, so do not say the file arrived"), False
                missed = unresolved_mentions(self.cfg, a.get("text") or "", chat)
                woke = file_wake(chat, a.get("thread_ts"), a.get("text") or os.path.basename(path), own=[self.target, self.alias]) if self.wants_wake(chat, a) else ""
                return (f"sent {os.path.basename(path)}" + (" in the thread" if a.get("thread_ts") else "")
                        + mention_warning(missed) + woke), False
            if name == "react":
                chat, ts, emoji = a.get("chat_id", ""), a.get("ts", ""), str(a.get("emoji", "eyes"))
                took = react(self.cfg, chat, ts, emoji, thread=a.get("thread_ts") or None)
                if ts and emoji.strip(":") not in ("eyes", "👀"):
                    react(self.cfg, chat, ts, "eyes", remove=True)   # this reaction is our answer: 👀 comes off
                    if took:                                         # …but only one Slack took is an answer
                        answered(chat, ts, a.get("thread_ts"), seat_name(self.target, self.alias), "react", pid=os.getpid())
                return "ok", False
            if name == "history":
                tok = self.cfg.get("SLACK_BOT_TOKEN")
                if not tok:
                    return "no SLACK_BOT_TOKEN", True
                chat = resolve_chat(self.cfg, a.get("chat_id", ""))
                msgs = api("conversations.history", tok, channel=chat, limit=str(clamp_n(str(a.get("n", "")), 20, 100)))["messages"]
                return fmt_history(self.cfg, list(reversed(msgs))), False
            if name == "thread":
                tok = self.cfg.get("SLACK_BOT_TOKEN")
                if not tok:
                    return "no SLACK_BOT_TOKEN", True
                chat = resolve_chat(self.cfg, a.get("chat_id", ""))
                msgs = replies_tail(self.cfg, chat, a.get("ts", ""), clamp_n(str(a.get("n", "")), 50, 50))
                return fmt_history(self.cfg, msgs), False
            return f"unknown tool {name}", True
        except Exception as e:
            return f"failed: {e}", True

    def member_call(self, name, a):
        """Inside the boundary the daemon makes the Slack call, scoped to this workspace's channels (Daemon.member_verb)."""
        req = {name: a.get("chat_id") or "", "target": self.target}
        if name == "reply":
            req.update(text=a.get("text", ""), thread_ts=a.get("thread_ts") or None, ts=a.get("ts") or "", needs_owner=bool(a.get("needs_owner")))
            if a.get("permission") is not None:   # forwarded as declared, absent stays absent; `permission` is the 🔐-answer verb on the socket
                req["perm_ask"] = bool(a.get("permission"))
        elif name == "react":
            req.update(ts=a.get("ts", ""), emoji=str(a.get("emoji", "eyes")), thread_ts=a.get("thread_ts") or None)
        elif name == "file":
            try:
                req.update(path=check_upload_path(a.get("path", "")), thread_ts=a.get("thread_ts") or None, ts=a.get("ts") or "",
                           text=a.get("text") or None, title=a.get("title") or None)
            except UploadRefused as e:
                return f"not sent — {e}", True
        elif name in ("history", "thread"):
            req.update(n=a.get("n"), ts=a.get("ts", ""))
        else:
            return f"unknown tool {name}", True
        try:
            r = sock_request(req, timeout=120)
        except Exception as e:
            return f"the box's Slack link did not answer ({e.__class__.__name__}) — nothing was sent", True
        return (r.get("text") or r.get("error") or ""), not r.get("ok")

    async def to_daemon(self, obj):
        if self.link:
            try:
                self.link.write((json.dumps(obj) + "\n").encode()); await self.link.drain(); return
            except Exception:
                pass
        log(f"no daemon link; dropped {obj.get('type')}")

    async def _link_when_ready(self):
        await self.aio.sleep(2)
        await self.daemon_link()

    async def daemon_link(self):
        if os.environ.get("CC_SLACK_CHANNEL") != "1":     # set by cc/cc-rc next to --dangerously-load-development-channels
            log("session was not started as a channel session (CC_SLACK_CHANNEL unset): tools only, no Slack subscription")
            return
        while True:
            try:
                r, w = await self.aio.open_unix_connection(SOCK)
                self.link = w
                w.write((json.dumps({"hello": self.target, "alias": self.alias, "handoff": self.handoff,
                                     "pid": os.getpid()}) + "\n").encode()); await w.drain()
                if self.daemon_ok is not True:
                    log(f"linked to cc-slackd as {self.target}"); self.daemon_ok = True
                while True:
                    line = await r.readline()
                    if not line:
                        break
                    ev = json.loads(line)
                    if ev.get("type") == "message":
                        meta = {k: str(v) for k, v in (ev.get("meta") or {}).items()}
                        await self.send({"jsonrpc": "2.0", "method": "notifications/claude/channel",
                                         "params": {"content": ev.get("content", ""), "meta": meta}})
                        self.woke_by(meta)
                        self.asked_in(meta)
                    elif ev.get("type") == "permission":
                        await self.send({"jsonrpc": "2.0", "method": "notifications/claude/channel/permission",
                                         "params": {"request_id": ev.get("request_id"), "behavior": ev.get("behavior")}})
            except Exception as e:
                if self.daemon_ok is not False:
                    log(f"cc-slackd not reachable ({e.__class__.__name__}); retrying — start it with: cc slack on"); self.daemon_ok = False
            self.link = None
            await self.aio.sleep(3)

# ---------------------------------------------------------------- CLI
def cmd_status():
    cfg = load_cfg()
    print(f"tokens: bot {'set' if cfg.get('SLACK_BOT_TOKEN') else 'MISSING'}, app {'set' if cfg.get('SLACK_APP_TOKEN') else 'MISSING'}; "
          f"owner: {cfg.get('SLACK_OWNER_ID') or 'not paired'}; sessions get the channel: {'yes' if os.path.exists(f'{DIR}/enabled') else 'no (cc slack on)'}")
    print("who is heard: channels — anyone who can post in one that routes to a session, reactions included (a member's "
          ":+1: counts as the owner's); DMs — the owner only. "
          "Only the owner answers permission prompts, runs `!` commands, and passes the box's owner gates.")
    print(f"policy: every channel the bot is in answers — one with no project yet gets ~/dev/<name> on its first message "
          f"(member-facing, max {PROVISION_MAX}/h); DMs are the owner's alone; #{APPROVALS}/#{ALERTS} are not sessions.")
    try:
        cid, member = find_channel(cfg, APPROVALS) if cfg.get("SLACK_BOT_TOKEN") else (None, False)
        print(f"approvals: #{APPROVALS} {cid} — a :+1: from anyone in that channel on a PR post squash-merges it" if cid and member
              else f"approvals: no #{APPROVALS} channel the bot is in (cc slack mkchannel {APPROVALS})")
    except Exception as e:
        print(f"approvals: lookup failed ({e})")
    try:
        st = sock_request({"status": True})
    except Exception as e:
        print(f"daemon: not running ({e.__class__.__name__}) — cc slack on"); return 1
    print(f"daemon: up {st['uptime']}s, slack {'connected' if st['connected'] else ('off' if not st['slack'] else 'DISCONNECTED')}"
          f"{', bot ' + st['bot_user'] if st.get('bot_user') else ''}")
    if st.get("pair_code"):
        print(f"PAIRING: DM the bot in Slack:  pair {st['pair_code']}")
    print(f"subscribed sessions: {fmt_subs(st['subs'])}   queued: {st['queued'] or 'none'}")
    return 0

def fmt_subs(subs):
    """{target: [alias|None, ...]} -> 'myrepo [main], ai-dev@myrepo'; an orch wears its shown name (orch_shown)."""
    return ", ".join(orch_shown(t, a) if a else f"{t} [main]" for t, aliases in subs.items() for a in aliases) or "none"

def project_channels(cfg, repo):
    """Every channel the bot is in that belongs to project <repo> — both lanes, each track channel, each live sub-orch channel — as (id, "#name") pairs, for a caller like cc-pause telling all of them at once.
    A prefix match is not enough: `#<repo>-skill` merely starts with these letters but is a different project. A name counts only when it is the repo, its `-updates` twin, or splits on its first `--` into this repo and a track."""
    repo = (repo or "").strip().lower()
    if not repo:
        return []
    routes, orchs = load_routes(), load_orchs()
    out, cur = [], None
    while True:
        r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel",
                exclude_archived="true", limit="200", cursor=cur)
        for ch in r.get("channels", ()):
            if not ch.get("is_member"):
                continue
            name = (ch.get("name") or "").lower()
            entry = orchs.get(ch["id"]) or {}
            target = (entry.get("target") if not entry.get("archived") else None) \
                or routes.get(ch["id"]) or routes.get("#" + name)
            if target:
                mine = target.split("/")[0].split("@")[0].lower() == repo
            else:
                base = main_lane(name) or name                      # the -updates lane belongs where its twin does
                mine = base == repo or ("--" in base and base.split("--", 1)[0] == repo)
            if mine:
                out.append((ch["id"], "#" + name))
        cur = (r.get("response_metadata") or {}).get("next_cursor") or None
        if not cur:
            break
    return sorted(out, key=lambda p: p[1])

def member_sock_cli(what, req):
    """A CLI read inside a member boundary (CC_MEMBER_SANDBOX=1): there is no token in there, so the member socket
    makes the call, scoped to the workspace's own channels and its mirror channels (Daemon.member_verb)."""
    try:
        r = sock_request(req, timeout=60)
    except Exception as e:
        print(f"cc-slack {what}: the member socket did not answer ({e.__class__.__name__})", file=sys.stderr); return 3
    print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
    return 0 if r.get("ok") else 1

def cmd_channels(argv=()):
    if os.environ.get("CC_MEMBER_SANDBOX") == "1" and not argv:
        return member_sock_cli("channels", {"channels": ""})
    cfg = load_cfg()
    argv = list(argv)
    if "--for" in argv:
        # stdout is a list and nothing else: cc-pause reads it line by line and posts into every id it finds.
        i = argv.index("--for")
        repo = argv[i + 1] if i + 1 < len(argv) else ""
        if not repo or repo.startswith("-"):
            print("cc-slack channels --for <repo>", file=sys.stderr); return 2
        if not cfg.get("SLACK_BOT_TOKEN"):
            print("no SLACK_BOT_TOKEN", file=sys.stderr); return 1   # cc-pause stays quiet on 1, reports every other exit
        try:
            rows = project_channels(cfg, repo)
        except Exception as e:
            print(f"cc-slack channels --for {repo}: {e.__class__.__name__}: {e}", file=sys.stderr); return 4
        for cid, name in rows:
            print(f"{cid} {name}")
        return 0
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("no SLACK_BOT_TOKEN"); return 1
    routes, prov, orchs = load_routes(), load_provisioned(), load_orchs()
    cur, rows = None, []
    while True:
        r = api("conversations.list", cfg["SLACK_BOT_TOKEN"], types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
        for ch in r["channels"]:
            if not ch.get("is_member"):
                continue
            t = routes.get(ch["id"]) or routes.get("#" + ch["name"]) or ch["name"].replace("--", "/", 1)
            base = main_lane(ch["name"])
            if not (routes.get(ch["id"]) or routes.get("#" + ch["name"])) and base and valid_target(base.replace("--", "/", 1)):
                t = base.replace("--", "/", 1)               # an -updates lane is the same session's other lane
            if ask_lane(ch["name"]) and not (routes.get(ch["id"]) or routes.get("#" + ch["name"])):
                shown = f"cc-ask ({ask_lane(ch['name'])}'s question lane — no session)"
            elif valid_target(t):
                shown = t + (" [updates lane]" if main_lane(ch["name"]) == t.replace("/", "--") else "")
            elif ch["id"] in orchs or ch["name"] in (APPROVALS, ALERTS) or not chan_target(t) or "/" in chan_target(t):
                shown = f"(unmapped: {t})"
            else:                                    # a channel that has no dir yet still answers: it gets one on its first message
                shown = f"{chan_target(t)} (dir on first message)"
            if prov.get(t if valid_target(t) else chan_target(t) or ""):
                shown += " [auto-provisioned]"
            rows.append((ch["name"], ch["id"], shown, bool(ch.get("is_private"))))
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            break
    for name, cid, t, priv in sorted(rows):
        # no API converts a public channel to private (Enterprise Grid only): the owner does it by hand
        print(f"#{name:<24} {cid:<14} → {t}" + ("" if priv else "   (public — change to private in Slack: channel → Settings → Change to private)"))
    print(f"{len(rows)} channel(s) the bot is in. Invite it to more with /invite @<bot> in Slack.")
    print("Anyone who can post in one of these reaches that session — the membership of the channel is the access control.")
    print(f"[auto-provisioned] = the box created ~/dev/<name> for that channel (member-facing, read-only outside its own dir); "
          f"at most {PROVISION_MAX} such dirs an hour.")
    return 0

def cmd_setup(argv):
    bot = app = email = None
    i = 0
    while i < len(argv):
        if argv[i] == "--bot":
            bot = argv[i + 1]; i += 2
        elif argv[i] == "--app":
            app = argv[i + 1]; i += 2
        elif argv[i] == "--owner-email":
            email = argv[i + 1]; i += 2
        else:
            i += 1
    if bot or app:
        if bot:
            set_cfg("SLACK_BOT_TOKEN", bot)
        if app:
            set_cfg("SLACK_APP_TOKEN", app)
        print("tokens saved to ~/.cc/config")
    cfg = load_cfg()
    if cfg.get("SLACK_BOT_TOKEN"):
        try:
            a = api("auth.test", cfg["SLACK_BOT_TOKEN"])
            print(f"bot token OK: {a.get('user')} in workspace {a.get('team')}")
        except Exception as e:
            print(f"bot token FAILED: {e}")
    if cfg.get("SLACK_APP_TOKEN"):
        try:
            api("apps.connections.open", cfg["SLACK_APP_TOKEN"]); print("app token OK (Socket Mode)")
        except Exception as e:
            print(f"app token FAILED: {e}")
    if email and cfg.get("SLACK_BOT_TOKEN"):
        try:
            uid = api("users.lookupByEmail", cfg["SLACK_BOT_TOKEN"], email=email)["user"]["id"]
            set_cfg("SLACK_OWNER_ID", uid); print(f"owner set to {uid} ({email}) — no pairing needed")
        except Exception as e:
            print(f"owner lookup FAILED: {e} (pair by DM instead)")
    if bot or app or email:
        subprocess.run(["systemctl", "--user", "try-restart", "cc-slackd.service"], capture_output=True)
    if not (cfg.get("SLACK_BOT_TOKEN") and cfg.get("SLACK_APP_TOKEN")):
        print(f"""Create the Slack app (once, ~3 minutes):
  1. https://api.slack.com/apps → Create New App → From a manifest → pick your workspace →
     paste {ROOT}/slack/app-manifest.json (replace <box> in it with this box's name) → Create.
  2. Basic Information → App-Level Tokens → Generate Token: name "socket", scope connections:write → copy xapp-…
  3. Install App → Install to Workspace → copy the Bot User OAuth Token xoxb-…
  4. On the box:  cc slack setup --bot xoxb-… --app xapp-… --owner-email you@example.com    then  cc slack on
     (without --owner-email: DM the bot  pair <code>  — code from: cc slack status)
  5. cc slack mkchannel <repo> <repo> …   one PRIVATE channel per project (--public opts out), invites you, sets the topic.
     Whoever you add to a channel can talk to that session; a DM only ever reaches you. `cc slack status` restates it.
     DMs (or #box) reach the box session; a track is a thread in #<repo> (cc-slack track-thread), never a channel.""")
    return 0

def post_flag(tok):
    """Is this argv token a flag? A dash and a word with no space in it — so "- first point" and "-3" are text."""
    return bool(re.match(r"^--?[A-Za-z][\w-]*$", tok))

SENDER = {}   # the daemon's `sender` answer this process last had: cmd_post reads the calling seat from it, no second ask

def sender_name(chat=None):
    """(display name, own) for the post about to go: the session the daemon says is calling, and whether `chat` is that session's own channel. Always asked of the daemon, never worked out locally. No daemon or no session behind the caller: (None, True), the app's plain name and no mention. CC_SLACK_PLAIN_NAME=1 drops the name only, not who the post is addressed to. The seat it names is kept in SENDER."""
    SENDER.clear()
    try:
        r = sock_request({"sender": chat or ""}, timeout=5)
    except Exception:
        return None, True
    SENDER["seat"] = r.get("seat") or None
    name = None if os.environ.get("CC_SLACK_PLAIN_NAME") == "1" else (r.get("name") or None)
    return name, bool(r.get("own", True))

def cmd_post(argv):
    cfg = load_cfg()
    chan = thread = route = ts = pid = rtrack = None
    mention = major = False
    ask = None                                       # None: an ask iff it opens with his 🔒 head (owner_asked)
    args = []
    i = 0
    while i < len(argv):
        if argv[i] == "--mention":
            mention = True; i += 1
        elif argv[i] == "--keep":   # accepted from callers that still pass it; the engagement hold it lifted is gone
            i += 1
        elif argv[i] in ("--ask", "--no-ask"):       # cc-notify says it: --owner's DM is an ask, `cc-notify test` is not
            ask = argv[i] == "--ask"; i += 1
        elif argv[i] in ("--major", "--main"):
            major = True; i += 1
        elif argv[i] in ("-c", "--thread", "--ts", "--route", "--id") and i + 1 >= len(argv):
            print(f"cc-slack post: {argv[i]} needs a value", file=sys.stderr); return 2
        elif argv[i] == "-c":
            chan = argv[i + 1]; i += 2
        elif argv[i] == "--id":   # producer's name for this event: submit() posts it once, ever
            pid = argv[i + 1]; i += 2
        elif argv[i] == "--thread":
            thread = argv[i + 1]; i += 2
        elif argv[i] == "--ts":   # the message this answers, e.g. the reply tool's own `ts`; the mail door reads it too
            ts = argv[i + 1]; i += 2
        elif argv[i] == "--route":
            route = argv[i + 1]; i += 2
        elif post_flag(argv[i]):
            # a flag this command does not know is an error, not text to post — else it goes out word for word.
            print(f"cc-slack post: unknown option {argv[i]} — cc-slack post [-c CHANNEL] [--thread TS] [--ts TS] "
                  f"[--route TITLE] [--id PRODUCER-ID] [--mention] [--major] [--keep] [--ask|--no-ask] \"text\" (a file goes with post --file PATH --to CHANNEL)",
                  file=sys.stderr); return 2
        else:
            args.append(argv[i]); i += 1
    text = " ".join(args) if args else sys.stdin.read()
    # any `-c` post may wake another session (see below), however the channel is named: '#lessons', 'lessons' or its
    # C… id. Only '#name' asked before, so a planning seat's `-c lessons` request (2026-09-24) and a `-c C0…` post into
    # an orch's channel (2026-09-21) reached nobody until a person chased them. A --route post is machinery: no -c, no wake.
    named = bool(chan)
    if os.environ.get("CC_MEMBER_SANDBOX") == "1":   # inside a boundary: use the member socket, scoped to it
        try:
            r = sock_request({"reply": chan or "", "text": text, "thread_ts": thread, "ts": ts or ""}, timeout=60)
        except Exception as e:
            print(f"cc-slack post: the member socket did not answer ({e.__class__.__name__})", file=sys.stderr); return 3
        print("" if r.get("ok") else r.get("error", ""), file=sys.stdout if r.get("ok") else sys.stderr); return 0 if r.get("ok") else 3
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    if route and not chan:
        # an automated post is an update: --route is machinery's door, aiming at the -updates lane where the box has one, else today's channel; `-c` is untouched, a reply goes where the question was asked.
        words = route.strip().lstrip("[").split()
        # BOX, not socket.gethostname(): cc-notify titles from CC_BOX, so asking the kernel can misname the box and misroute a "<box> limit" line away from #alerts.
        if len(words) >= 2 and words[1].lower() in ALERT_KINDS and words[0].lower() in (BOX.lower(), "box"):
            chan = "#" + (cfg.get("SLACK_ALERTS") or ALERTS)   # "<box> boot|limit|audit|review": machinery, never a project thread
            if not mention and words[1].lower() in UPDATE_KINDS and own_twin(cfg, words[0].lower()):
                chan = "#" + updates_name(words[0])            # a digest is progress: the updates lane, #alerts only if none
        elif not (mention or major) and track_thread(words[0].lower() if words else ""):
            # "<repo>/<track> done|round over|<stop>": the track's own thread in #<repo> — the brief: "its worker's
            # progress lines … live in ONE thread"; a --mention still goes to the main lane, where paging him lives.
            chan, thread = track_thread(words[0].lower()); rtrack = words[0].lower()
        else:
            name = re.split(r"[/\s\]]", route.strip().lstrip("["), maxsplit=1)[0].lower()   # "[repo] PR #n …" → repo
            home = home_of(cfg, name) if name else name       # a channel-less child's title lands in its parent's lane…
            if home != name and name not in text:
                text = f"[{name}] {text}"                     # …and says whose it is there, where the title alone would not
            name = home
            # --major keeps it on the main lane: the one line of a landing the owner is told (cc-land's landed())
            lane = ambient_lane(cfg, name) if name and not (mention or major) else None
            if lane and lane != updates_name(name):
                text = text if name in text else f"[{name}] {text}"   # and say whose line it is
            chan = "#" + (lane or name) if name else None
    if chan and chan.startswith("#") and main_lane(chan[1:].lower()) and not mention and not own_twin(cfg, main_lane(chan[1:].lower())):
        # `-c '#<repo>-updates'` for a twin that is gone (retired, never made, or a name someone else made — own_twin):
        # the log lane, labelled, and no wake, since the lane is nobody's seat — a spend line from `cc` must not wake
        # the box's planning seat instead. Top level: a thread ts of the old lane means nothing in the log lane, so a
        # reply says it was one (retired_note, as post() does). A --mention skips this: decision_lane takes it to #<repo>.
        base = main_lane(chan[1:].lower())
        if resolve_channel(cfg, log_lane(cfg)):
            chan, named = "#" + log_lane(cfg), False
            text = (retired_note(updates_name(base), thread) + text if thread
                    else text if base in text else f"[{base}] {text}")
            thread = None
    if mention:
        # a decision lands only in #<repo> or #approvals (decision_lane): #alerts, an orch's channel, a -updates,
        # -threads or `--` sub-lane move to the repo's main lane, and a thread there means nothing in the new one.
        was = chan or "#" + (cfg.get("SLACK_ALERTS") or ALERTS)
        moved, home = decision_lane(cfg, was)
        base = main_lane(str(was)[1:].lower()) if str(was).startswith("#") else None
        if not home and base and not own_twin(cfg, base) and resolve_channel(cfg, CTL.lower()):
            moved, home = "#" + CTL.lower(), CTL.lower()   # #<repo> is gone too: never the twin's name, which anyone can hold
        if home:
            print(f"cc-slack: decision → #{home} (a 🔒 post lands only in #<repo> or #{APPROVALS})", file=sys.stderr)
            chan, thread = moved, None
    pre = str(chan or "")                            # the lane as named, before it becomes an id (an addressed post reads it)
    if chan and chan.startswith("#"):
        chan = resolve_channel(cfg, chan[1:])
    if not chan:                                     # no project channel for this title: machinery notices go to #alerts, then SLACK_CHANNEL
        chan = resolve_channel(cfg, cfg.get("SLACK_ALERTS") or ALERTS) or cfg.get("SLACK_CHANNEL")
    if not chan:
        print("cc-slack post: no channel (use -c, --route with a matching #channel, or SLACK_CHANNEL)", file=sys.stderr); return 3
    if chan.startswith("#"):
        chan = resolve_channel(cfg, chan[1:]) or chan
    elif re.match(r"^[a-z0-9][a-z0-9_-]*$", chan):     # a bare `-c lessons` (Slack names are lower case, ids never are): its id, so the wake and the woken seat's reply name the channel as Slack does
        chan = resolve_channel(cfg, chan) or chan
    # --mention is rung 1, "you, now": post() opens it with 🔒 and the raw <@U…> form; without --mention a typed @handle of his is code. Every post signs with the calling session's name; a `-c '#name'` post into ANOTHER session's channel also opens with a mention of that channel, so it reads as addressed, not anonymous.
    SENDER.clear()                                   # a stale seat from an earlier ask in this process names nobody
    uname, own = sender_name(chan)
    seat = SENDER.get("seat")                        # the daemon's word for who is calling, for the answered receipt below
    if rtrack and not uname and os.environ.get("CC_SLACK_PLAIN_NAME") != "1":   # a headless loop has no seat: its line into the track's thread is signed with the track (posts name their sender)
        uname = display_name(rtrack)
    # a post one agent makes for another (owner, 2026-10-01) opens with 🤖 (agent_head) and never goes top level in
    # #<repo>, which is his: addressed = no --mention, and a -c into another session's channel, a text that already
    # opens `<#…>` or 🤖, or a -threads lane. Top level into a main lane with an -updates twin, it goes to the twin.
    lane = (pre[1:] if pre.startswith("#") else pre if re.match(r"^[a-z0-9][a-z0-9_-]*$", pre) else chat_name(cfg, chan)).lower()
    addressed = not mention and ((named and not own) or text.lstrip().startswith(("<#", AGENT_MARK)) or threads_lane(lane))
    to = chan
    if named and not own:
        text = f"<#{to}> {AGENT_HEAD_RE.sub('', text)}"   # the session it is for, even from its -updates lane
    if addressed:
        text = agent_head(text)
    missed = unresolved_mentions(cfg, text, chan, decision=mention)
    if pid:
        try:
            n, posted_ts, how = submit(cfg, pid, chan, text, thread, username=uname, ts=ts, decision=mention, ask=ask)
        except Exception as e:
            print(f"cc-slack post: {pid} not sent ({e.__class__.__name__}: {str(e)[:160]}) — the intent stands, the "
                  f"same --id sends it once", file=sys.stderr); return 1
        if how in ("already", "found"):
            print(posted_ts or "")
            print(f"cc-slack: {pid} already sent as {posted_ts} — nothing posted", file=sys.stderr); return 0
    else:
        try:
            n, posted_ts = post(cfg, chan, text, thread, username=uname, ts=ts, decision=mention, ask=ask)
        except Exception as e:
            print(f"cc-slack post: not sent ({e.__class__.__name__}: {str(e)[:160]})", file=sys.stderr); return 1
    print(posted_ts or "")
    if posted_ts and named and (ts or thread):
        # a session answering in a thread from the shell (`-c`, never --route machinery) is an answer like its reply
        # tool's: where it really went (chan and thread after every redirect above) and the seat the daemon sees
        answered(chan, ts, thread, seat, "post", pid=os.getpid())
    if missed:                                       # stderr, so a caller piping the ts is unaffected and a human still sees it
        print("cc-slack:" + mention_warning(missed).strip(), file=sys.stderr)
    if posted_ts and (named or alias_mentions(text) or thread):
        # one session's post into another session's channel wakes it (Daemon.wake decides); a `--route` post is machinery and never asks.
        # any post naming @<alias> asks too (Daemon.route_mentions), and a threaded one may answer a member's ask (Daemon.ask_hop);
        # the mentions and the ask hop answer only a caller that is a session; the channel wake answers any box process.
        try:
            r = sock_request({"wake" if named else "mention": chan, "ts": posted_ts, "thread_ts": thread, "text": text}, timeout=15)
        except Exception:
            r = {}                                   # no daemon: the post stands, and there is no session to hand it to
        if r.get("recorded"):                    # nobody took it: the daemon wrote the ledger record, and this line names it
            print(f"cc-slack: woke nobody on {r['target']} ({r.get('result')}) — {r['recorded']}", file=sys.stderr)
        elif r.get("target"):
            print(f"cc-slack: handed to {r['target']} ({r.get('result')})", file=sys.stderr)
        if r.get("mentions"):
            print("cc-slack: " + mentions_line(r["mentions"]).strip(), file=sys.stderr)
        elif not named and alias_mentions(text) and r.get("ok") is False:     # an old daemon without the verb: say so, never a silent no-wake
            print(f"cc-slack: mentions not routed — the daemon refused ({str(r.get('error'))[:120]})", file=sys.stderr)
        if r.get("ask"):
            print("cc-slack: " + ask_line(r["ask"]).strip(), file=sys.stderr)
    return 0

def file_wake(chat, thread, text, own=None):
    """A file a session posts into another session's channel wakes that session, as `post -c` does (Daemon.wake
    decides: its own channel is "own", a DM or a caller that is no session wakes nobody). The upload hands back no
    message ts, so the wake carries none. `own` is the channel server's (target, alias) when the file tool sends it,
    so a seat with no live subscriber is not handed its own file (Daemon.wake_channel). Returns the line for the
    caller's result, "" when nobody was handed it."""
    try:
        r = sock_request({"wake": chat, "ts": "", "thread_ts": thread or None, "text": f"[file] {text}", "self": own}, timeout=15)
    except Exception:
        return ""                                    # no daemon: the file stands, and there is no session to hand it to
    if r.get("recorded"):
        return f" (woke nobody on {r['target']}: {r.get('result')} — {r['recorded']})"
    return f" (handed to {r['target']}: {r.get('result')})" if r.get("target") else ""

def cmd_post_file(argv):
    """post --file PATH [--to C…|U…|#name] [--thread TS] [--ts TS] [--title T] [-m TEXT] — same upload_file() helper as the channel server's `file` tool, so a PDF goes as its library link (`ok link=<ts>`) and an unfiled one is refused (exit 2). Default target: the owner's DM. Exit 2 usage/refused, 3 no token, 1 API error."""
    usage = "cc-slack post --file <path> [--to <channel-or-user-id|#name>] [--thread <ts>] [--ts <ts>] [--title <t>] [-m|--text <msg>]"
    cfg = load_cfg(); opt = {"--file": None, "--to": None, "--thread": None, "--ts": None, "--title": None, "-m": None}
    i = 0
    while i + 1 < len(argv) and argv[i] in ("--file", "--to", "--thread", "--ts", "--title", "-m", "--text"):
        opt["-m" if argv[i] == "--text" else argv[i]] = argv[i + 1]; i += 2
    path = opt["--file"]
    if i != len(argv) or not path or not os.path.isfile(path):
        print(usage, file=sys.stderr); return 2
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post --file: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    try:
        fid, to = upload_file(cfg, path, opt["--to"], opt["--thread"], comment=opt["-m"], title=opt["--title"], ts=opt["--ts"])
    except UploadRefused as e:
        print(f"cc-slack post --file: {e}", file=sys.stderr); return 2
    except Exception as e:
        tgt = opt["--to"] or "the owner's DM"
        hint = {"missing_scope": "the installed app lacks a scope (files:write to upload, im:write to DM): cc-slack manifest …, then Reinstall the app",
                "not_in_channel": f"the bot is not a member of {tgt}: /invite it there, or cc-slack mkchannel <name>",
                "channel_not_found": f"no channel {tgt}: give a C…/D… id, a U… user id, or #name of a channel the bot is in"}
        err = str(e)
        print(f"cc-slack post --file failed: {err}. {next((h for k, h in hint.items() if k in err), '')}".strip(), file=sys.stderr); return 1
    print(f"ok {'link' if is_pdf(path) and fid else 'file'}={fid} channel={to}")
    woke = file_wake(to, opt["--thread"], opt["-m"] or os.path.basename(path)) if fid else ""
    if woke:
        print("cc-slack:" + woke, file=sys.stderr)
    return 0

def find_channel(cfg, name, ws=None):
    """#name → (id, is_member) across all channels the bot can see, or (None, False); a name another workspace's
    member workspace owns is looked for in that workspace alone (ws_of_name), and so is any name when `ws` names it."""
    cur, ws = None, ws_of_name(name) if ws is None else ws
    while True:
        r = api("conversations.list", WS["extra"][ws]["bot"] if ws else cfg["SLACK_BOT_TOKEN"],
                types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
        for ch in r["channels"]:
            if ch["name"] == name:
                ws_remember("chan", ch["id"], ws)
                return ch["id"], bool(ch.get("is_member"))
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            return None, False

class ChannelExists(RuntimeError):
    """#name is taken by a private channel the bot cannot see, so it looked absent and conversations.create answered name_taken: actionable for the owner, never a crash."""

def channel_members(cfg, chat):
    """Every user id in a channel (conversations.members, cursor-paged)."""
    out, cur = [], None
    while True:
        r = api("conversations.members", cfg["SLACK_BOT_TOKEN"], channel=chat, limit="200", cursor=cur)
        out += r.get("members") or []
        cur = r.get("response_metadata", {}).get("next_cursor") or None
        if not cur:
            return out

def inherit_members(cfg, parent, cid, name):
    """A channel the box creates under another one starts with the parent's people already in it. One conversations.invite for all of them; bots and apps are dropped since one bad id fails the whole call. Best effort: a failed inherit never fails the channel that was created."""
    tok = cfg["SLACK_BOT_TOKEN"]
    try:
        users = []
        for uid in channel_members(cfg, parent):
            try:
                u = api("users.info", tok, user=uid)["user"]
            except Exception:
                continue                       # cannot tell what it is → never invite it
            if not (u.get("is_bot") or u.get("is_app_user") or u.get("deleted") or uid == "USLACKBOT"):
                users.append(uid)
        if not users:
            return 0
        try:
            api("conversations.invite", tok, channel=cid, users=",".join(users))
        except RuntimeError as e:
            if not any(w in str(e) for w in ("already_in_channel", "cant_invite_self")):
                raise
        log(f"#{name}: inherited {len(users)} member(s) from the parent channel")
        return len(users)
    except Exception as e:
        log(f"#{name}: could not inherit the parent channel's members ({e!r}) — invite them in Slack")
        return 0

def ensure_channel(cfg, name, private=True, parent=None, invite=(), ws=None):
    """#name exists, the bot is in it and the owner is invited → (id, "created"|"joined"|"member"). `parent` (a channel id) hands the new channel the parent's humans, on creation only, never a re-sync. `invite` = ids to add alongside the owner. The owner is never optional: every channel the box makes is one he is in — in another Slack workspace as his id there (SLACK_OWNER_ID_<N>), and none when he is not in it. `ws` makes it in that extra workspace whatever the name (a mirror's own channels), with that workspace's own bot token."""
    ws = ws_of_name(name) if ws is None else ws
    tok = WS["extra"][ws]["bot"] if ws else cfg["SLACK_BOT_TOKEN"]
    owner = WS["extra"][ws]["owner"] if ws else cfg.get("SLACK_OWNER_ID")   # his id in that workspace; none if he is not in it
    cid, member = find_channel(cfg, name) if ws == ws_of_name(name) else find_channel(cfg, name, ws)
    how = "member"
    if not cid:
        try:
            cid = api("conversations.create", tok, name=name, is_private="true" if private else "false")["channel"]["id"]; how = "created"
            ws_remember("chan", cid, ws)
            with contextlib.suppress(Exception):
                record_twin(cid, name)                # an -updates lane the box makes is its own, under this name
        except RuntimeError as e:
            if "name_taken" not in str(e):
                raise
            raise ChannelExists(f"#{name} exists as a private channel the bot cannot see — invite the bot to it in Slack, then re-run") from None
        if parent:
            inherit_members(cfg, parent, cid, name)   # before the owner invite: one clean batch into an empty channel
    elif not member:
        api("conversations.join", tok, channel=cid); how = "joined"
    for who in [owner] + [u for u in invite if u]:
        if not who:
            continue
        try:
            api("conversations.invite", tok, channel=cid, users=who)
        except RuntimeError as e:
            if "already_in_channel" not in str(e):
                log(f"invite {who} to #{name}: {e}")
    try:
        os.unlink(f"{DIR}/channels-{ws}.json" if ws else f"{DIR}/channels.json")   # the name→id cache predates this channel
    except FileNotFoundError:
        pass
    return cid, how

def lane_topic(name, target):
    """Topic of an -updates lane: what it is for, and where the other half of the conversation lives."""
    return (f"→ Claude session `{target}` on {BOX} — the UPDATES lane: digests, milestones, progress, audits, janitor "
            f"lines, anything automated. Questions, answers and decisions belong in #{name}.")

def ensure_updates_lane(cfg, name, cid, private=True):
    """#<name>-updates exists, the bot and the owner are in it — nobody else, never #<name>'s people — and its topic
    says what it is for. It is the owner's ambient view, so a member (or anyone else) invited into #<name> is never
    carried into its -updates twin. Idempotent: the lane routes by name (Daemon.route strips the suffix), so no
    table can get out of step. `cid` names the twin for the topic only; it is never passed on as a parent to inherit
    from."""
    un = updates_name(name)
    ucid, how = ensure_channel(cfg, un, private)
    with contextlib.suppress(RuntimeError):
        api("conversations.setTopic", cfg["SLACK_BOT_TOKEN"], channel=ucid,
            topic=lane_topic(name, name.replace("--", "/", 1)))
    return ucid, how

def archive_channel(cfg, cid, orchs=None):
    """conversations.archive + mark it archived in the routing table (the caller saves). Already archived or gone counts as done; any other refusal leaves the entry alone so the channel keeps routing."""
    ok = True
    try:
        api("conversations.archive", cfg["SLACK_BOT_TOKEN"], channel=cid)
    except Exception as e:
        ok = any(w in str(e) for w in ("already_archived", "channel_not_found"))
        if not ok:
            log(f"archive {cid}: {e!r}")
    if ok and orchs is not None and cid in orchs:
        orchs[cid]["archived"] = True
    return ok

def cmd_track_thread(argv):
    """track-thread <repo>/<track> [--title T] — open (or find) the track's one thread (#<repo>-updates, else #<repo>) and print `<chat> <ts>`.
    `cc <repo> <track> --go` runs it before the loop starts, so the worker's first line already has a home. No channel
    is created. Exit 2 usage, 3 no token, 1 no repo channel (nothing opened, the caller's posts take the old routes)."""
    title, rest = "", []
    i = 0
    while i < len(argv):
        if argv[i] == "--title" and i + 1 < len(argv):
            title = argv[i + 1]; i += 2
        else:
            rest.append(argv[i]); i += 1
    target = rest[0].strip().lower() if len(rest) == 1 else ""
    if not valid_target(target) or "/" not in target:
        print("cc-slack track-thread <repo>/<track> [--title T]", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack track-thread: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    got = open_track_thread(cfg, target, title, username=sender_name()[0])
    if not got:
        print(f"cc-slack track-thread: no #{target.partition('/')[0]} channel the bot is in — no thread for {target}", file=sys.stderr); return 1
    print(f"{got[0]} {got[1]}"); return 0

def cmd_mkchannel(argv):
    cfg = load_cfg(); tok = cfg.get("SLACK_BOT_TOKEN")
    if not tok:
        print("no SLACK_BOT_TOKEN — cc slack setup first"); return 1
    private = "--public" not in argv       # private by default; --private is a no-op
    names = [a.lstrip("#").lower() for a in argv if not a.startswith("--")]
    if not names:
        print("cc-slack mkchannel <name>… [--public]"); return 2
    rc = 0
    for name in names:
        parent = None
        if "--" in name:                   # #<repo>--<sub> starts with #<repo>'s members
            with contextlib.suppress(Exception):
                parent = find_channel(cfg, name.split("--", 1)[0])[0]
        try:
            cid, how = ensure_channel(cfg, name, private, parent)
        except ChannelExists as e:
            print(e); rc = 1; continue
        print(f"created {'private' if private else 'public'} #{name} ({cid})" + (f", with #{name.split('--', 1)[0]}'s members" if parent else "")
              if how == "created" else f"joined existing #{name}" if how == "joined" else f"#{name} exists, bot is a member")
        target = name.replace("--", "/", 1)
        try:
            api("conversations.setTopic", tok, channel=cid,
                topic=f"→ Claude session `{target}` on {BOX} — messages here reach it, replies come back in threads" if valid_target(target)
                else f"{BOX} — ask anything about the box (how do I, where is, what does): answered from the docs and the record by a small model, each answer names its source" if ask_lane(name)
                else f"{BOX} PRs land here — :+1: from anyone in this channel squash-merges" if name == APPROVALS
                else f"{BOX} machinery notices: boots, power, Claude usage limits, audits, digests — nothing here needs a reply" if name == ALERTS
                else f"{BOX} — no project with this name on the box (rename, or add a route in ~/.cc/slack/routes.json)")
        except RuntimeError as e:
            print(f"  topic: {e}")
        print(f"  #{name} → {target if valid_target(target) else '(PR approvals)' if name == APPROVALS else f'cc-ask ({ask_lane(name)} question lane, no session)' if ask_lane(name) else '(unmapped)'}")
        # no -updates twin (comms-only-read-channels-remain): the owner read none of them, so a routine line goes to
        # the box's one log lane instead; only a member's join still makes a twin, the member's own lane
    print("Anyone you add to a channel can talk to that session and their reactions count as yours (:+1: merges); "
          "only you answer permission prompts and the owner gates.")
    return rc

def resolve_user(cfg, who):
    """A user id out of what a person types: `<@U123>`, `<@U123|name>`, `U123`, `@handle`, or a bare handle."""
    t = (who or "").strip().lstrip("<").rstrip(">").split("|")[0].lstrip("@").strip()
    if re.fullmatch(r"[UW][A-Z0-9]{6,}", t):
        return t
    table = user_table(cfg)
    return table.get(t.lower()) or table.get(member_handle(t))

def cmd_member(argv):
    """`member add <@user>…` — the owner's manual team_join, idempotent and exempt from the hourly cap. `member instructions <handle>` writes them into a workspace no join flow made (`cc-sandbox convert` calls it) — no token, no Slack, no member record. `member register <handle> [<@user>]` writes that record for such a workspace from the channels it already has (read, never made): until it exists `members` does not list the workspace, the mail bridge has no home for it and the member's word in their own channel is weighed, not an instruction (a member workspace, 2026-09-18)."""
    if argv[:1] == ["register"]:
        if len(argv) not in (2, 3):
            print("cc-slack member register <handle> [<@user>]", file=sys.stderr); return 2
        return member_register(argv[1], argv[2] if len(argv) == 3 else "")
    if argv[:1] == ["instructions"]:
        if len(argv) != 2:
            print("cc-slack member instructions <handle>", file=sys.stderr); return 2
        h = argv[1]
        if not os.path.isfile(f"{DEV}/{h}/{MEMBER_MARKER}"):
            print(f"~/dev/{h} is not a member workspace — nothing was written", file=sys.stderr); return 1
        print({"wrote": "README.md: the member instructions — how a project is made, and by whom",
               "merged": "README.md: the member instructions appended, under the README that was already there",
               "kept": "README.md: it already says how a project is made — left as it is",
               }[ensure_member_readme(h, h)])
        return 0
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("no SLACK_BOT_TOKEN — cc slack setup first", file=sys.stderr); return 1
    if len(argv) < 2 or argv[0] != "add":
        print("cc-slack member add <@user>… | member instructions <handle> | member register <handle> [<@user>]", file=sys.stderr); return 2
    rc = 0
    for who in argv[1:]:
        uid = resolve_user(cfg, who)
        if not uid:
            print(f"{who}: no such person in this workspace (give <@U…> or their handle)", file=sys.stderr); rc = 1; continue
        try:
            status, handle, msg = ensure_member(cfg, uid, by="owner")
        except Exception as e:
            print(f"{who}: {e.__class__.__name__}: {e}", file=sys.stderr); rc = 1; continue
        print(f"{who} → {status}: {msg}")
        if status == "refused":
            rc = 1
    return rc

def member_register(handle, who=""):
    """The members.json record for a workspace made outside the join flow. Refused unless ~/dev/<handle> carries the
    marker; the channel pair must already exist (nothing here creates a channel — that is ensure_member's, on a join);
    `who` (optional) is the member whose word is an instruction in #<handle>, refused when that handle is on record
    for somebody else. Idempotent: a record already complete is left as it is."""
    cfg = load_cfg()
    if not os.path.isfile(f"{DEV}/{handle}/{MEMBER_MARKER}"):
        print(f"~/dev/{handle} is not a member workspace — nothing was written", file=sys.stderr); return 1
    uid = ""
    if who:
        if not cfg.get("SLACK_BOT_TOKEN"):
            print("no SLACK_BOT_TOKEN — cc slack setup first", file=sys.stderr); return 1
        uid = resolve_user(cfg, who)
        if not uid:
            print(f"{who}: no such person in this workspace (give <@U…> or their handle)", file=sys.stderr); return 1
    members = load_members(); known = members.get(handle) or {}
    if uid and known.get("uid") and known["uid"] != uid:
        print(f"#{handle} already belongs to {known['uid']} — two people cannot share one workspace", file=sys.stderr); return 1
    cid, ucid = known.get("chan_id"), known.get("updates_id")
    if not (cid and ucid):
        if not cfg.get("SLACK_BOT_TOKEN"):
            print("no SLACK_BOT_TOKEN — cc slack setup first", file=sys.stderr); return 1
        cid = cid or find_channel(cfg, handle)[0]
        ucid = ucid or find_channel(cfg, updates_name(handle))[0]
        missing = [f"#{n}" for n, c in ((handle, cid), (updates_name(handle), ucid)) if not c]
        if missing:
            print(f"{', '.join(missing)}: no such channel — register records the pair a workspace has, it makes none", file=sys.stderr); return 1
    rec = dict(known, uid=uid or known.get("uid") or "", chan=handle, chan_id=cid, updates=updates_name(handle),
               updates_id=ucid, at=known.get("at") or time.time())
    if rec == known:
        print(f"{handle}: already on record — nothing changed"); return 0
    members[handle] = rec
    save_members(members)
    print(f"{handle}: on record — #{handle} {cid}, #{updates_name(handle)} {ucid}" + (f", member {rec['uid']}" if rec["uid"] else ", no member named"))
    return 0

def member_projects(handle):
    """Project channels this workspace has, from its own board; none if it has no board yet."""
    try:
        r = EFFECTS.run([f"{BIN}/cc-board", "json", handle], capture_output=True, text=True,
                        stdin=subprocess.DEVNULL, timeout=15)
        return sorted((json.loads(r.stdout) or {}).get("tracks") or {})
    except Exception:
        return []

def cmd_members():
    """Who the box has let in and what they've spent: handle, channels, workspace, budget used today."""
    cfg = load_cfg(); members = load_members()
    if not members:
        print("no member workspaces yet — `cc-slack member add <@user>`, or let a team_join make one"); return 0
    for h in sorted(members):
        e = members[h]
        chans = [f"#{e.get('chan') or h}", f"#{e.get('updates') or updates_name(h)}"]
        chans += [f"#{h}--{p}" for p in member_projects(h)]
        print(f"{h:<16} {e.get('uid') or '?':<12} ~/dev/{h:<16} ${member_spent(h):.2f}/${member_cap(h, cfg):.2f} today")
        print(f"{'':<16} {', '.join(chans)}")
    print("The owner is in every one of those channels. No member session runs yet: it starts inside the sandbox "
          "(docs/design-member-workspaces.md).")
    return 0

def retire_dest(cfg, dest, ids):
    """Why `dest` (#name or C…) cannot take a retired channel's posts, or "" when it can: it resolves, is not one of
    `ids` or retired already, is not archived, and has the bot in it (a post there is not refused)."""
    cid = (resolve_channel(cfg, dest[1:].lower()) if dest.startswith("#") else dest) or ""
    if not cid:
        return "no channel the bot is in has that name"
    if cid in ids or cid in load_retired():
        return "it is being retired itself"
    try:
        ch = api("conversations.info", cfg["SLACK_BOT_TOKEN"], channel=cid)["channel"]
    except Exception as e:
        return f"it cannot be read ({str(e)[:80]})"
    if ch.get("is_archived"):
        return "it is archived"
    return "" if ch.get("is_member") else "the bot is not in it, so a post there is refused"

def cmd_retire(argv):
    """retire <C…>… [--to <#chan|C…>] [--dry-run] — archive channels by ID from an explicit list, never by name or
    suffix. Each is written to retired.json first (with `to`, else the log lane), so a post, a persisted job or a
    stale cached id aimed at it goes there instead of failing. Refused: #alerts, #approvals, the log lane, the vitals
    store, the box's own #<box>, the mail channel (MAIL_CHANNEL), the control repo's -threads lane, a member's channel,
    and a channel a live seat (tmux window) routes to. The destination is checked first, dry run too: one that does not
    resolve, is archived, is being retired or does not have the bot in it archives nothing (exit 1). Exit 2 usage,
    3 no token, 1 when any id was refused or not archived."""
    dry, to, ids, i = "--dry-run" in argv, "", [], 0
    while i < len(argv):
        if argv[i] == "--to" and i + 1 < len(argv):
            to = argv[i + 1]; i += 2
        elif argv[i] == "--dry-run":
            i += 1
        else:
            ids.append(argv[i]); i += 1
    if not ids or not all(re.fullmatch(r"[CG][A-Z0-9]+", c) for c in ids) or (to and not re.fullmatch(r"#[a-z0-9_-]+|[CG][A-Z0-9]+", to)):
        print("cc-slack retire <C…>… [--to <#chan|C…>] [--dry-run]   (channel ids only — never a name)", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack retire: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    keep = {APPROVALS, ALERTS, VITALS_STORE, log_lane(cfg), BOX.lower(), (cfg.get("SLACK_ALERTS") or ALERTS),
            threads_name(CTL), (cfg.get("MAIL_CHANNEL") or "").strip().lstrip("#").lower()} - {""}
    home = to or "#" + log_lane(cfg)
    bad = retire_dest(cfg, home, ids)
    if bad:                                          # before any record or archive: a post must have somewhere live to go
        print(f"cc-slack retire: its posts would go to {home}, but {bad} — nothing archived", file=sys.stderr); return 1
    members = load_members()
    member_ids = {e.get(k) for e in members.values() for k in ("chan_id", "updates_id")} - {None, ""}
    member_names = {n for h, e in members.items() for n in (h, e.get("chan"), e.get("updates"))} - {None, ""}
    wins, orchs, rc = set(home_windows()), load_orchs(), 0
    for cid in ids:
        try:
            ch = api("conversations.info", cfg["SLACK_BOT_TOKEN"], channel=cid)["channel"]
        except Exception as e:
            print(f"{cid}: cannot read it ({str(e)[:80]}) — refused", file=sys.stderr); rc = 1; continue
        name = (ch.get("name") or "").lower()
        o = orchs.get(cid) or {}
        seat = (f"{o.get('target')}@{o.get('alias')}" if o and not o.get("archived")
                else None if main_lane(name) else name.replace("--", "/", 1))
        why = ("kept by rule" if name in keep else "a member's channel" if cid in member_ids or name in member_names
               or any(name.startswith(f"{h}--") for h in members)
               else f"live seat {seat}" if seat and seat in wins else "")
        eff = (load_retired().get(cid) or {}).get("to") or home    # retire_record keeps a `to` already recorded
        bad = retire_dest(cfg, eff, ids) if not why and eff != home else ""
        why = why or (f"its recorded destination {eff}: {bad}" if bad else "")
        if why:
            print(f"{cid} #{name}: refused — {why}", file=sys.stderr); rc = 1; continue
        state = "archived already" if ch.get("is_archived") else f"{ch.get('num_members', '?')} members"
        if dry:
            print(f"{cid} #{name}: {state}; would archive, its posts → {eff}"); continue
        prev = load_retired().get(cid)
        retire_record(cfg, cid, name, home)
        with orchs_locked():
            orchs = load_orchs()
            ok = archive_channel(cfg, cid, orchs)
            save_orchs(orchs)
        if not ok:                                   # the channel is still live: take back the record, or its posts detour
            r = load_retired()
            if prev is None:
                r.pop(cid, None)
            else:
                r[cid] = prev
            save_table(RETIRED, r)
        print(f"{cid} #{name}: {'archived' if ok else 'could NOT archive'}; its posts → {eff}")
        rc |= 0 if ok else 1
    return rc

def cmd_orch_channel(argv):
    """orch-channel <target> <alias> [--parent-alias <a>] [--brief <text>] — gives the orch its own channel. The daemon does the work (owns the parent thread and orchs.json); with no daemon, no channel, but `@alias` still works."""
    opts, pos, i = {"--parent-alias": None, "--brief": ""}, [], 0
    while i < len(argv):
        if argv[i] in opts:
            opts[argv[i]] = argv[i + 1] if i + 1 < len(argv) else ""; i += 2
        else:
            pos.append(argv[i]); i += 1
    if len(pos) != 2:
        print("cc-slack orch-channel <target> <alias> [--parent-alias <a>] [--brief <text>]", file=sys.stderr); return 2
    try:
        r = sock_request({"orch": pos[0], "alias": pos[1], "parent_alias": opts["--parent-alias"], "brief": opts["--brief"]}, timeout=60)
    except Exception as e:
        print(f"cc-slack orch-channel: daemon not running ({e.__class__.__name__}) — no channel, @{pos[1]} still works in #{pos[0]}", file=sys.stderr); return 1
    if not r.get("ok"):
        print(f"cc-slack orch-channel: {r.get('error')}", file=sys.stderr); return 1
    print(f"#{r.get('name')} ({r.get('channel')}){'' if r.get('created') else ' — already had one'}"); return 0

def cmd_archive(argv):
    """archive <#chan|C…> | --orch <target> <alias> — archive a sub-orch channel and stop routing it; works with the daemon down, since `cc` calls it when an orch session exits."""
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack archive: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    orchs = load_orchs()
    if argv[:1] == ["--orch"]:
        if len(argv) != 3:
            print("cc-slack archive --orch <target> <alias>", file=sys.stderr); return 2
        cid = orch_lookup(orchs, argv[1], argv[2])
        if not cid:
            print(f"no live orch channel for {orch_shown(argv[1], argv[2])} — nothing to archive"); return 0
    elif len(argv) == 1 and argv[0]:
        cid = argv[0] if re.fullmatch(r"[CG][A-Z0-9]+", argv[0]) else (find_channel(cfg, argv[0].lstrip("#").lower())[0] or "")
        if not cid:
            print(f"cc-slack archive: no channel {argv[0]}", file=sys.stderr); return 1
        if cid not in orchs:                             # this only archives sub-orch channels, not #<repo> or #alerts
            print(f"cc-slack archive: {argv[0]} is not a sub-orch channel (archive it in Slack if you mean it)", file=sys.stderr); return 1
    else:
        print("cc-slack archive <#chan|C…> | --orch <target> <alias>", file=sys.stderr); return 2
    with orchs_locked():
        orchs = load_orchs()
        ok = archive_channel(cfg, cid, orchs)
        save_orchs(orchs)
    print(f"{'archived' if ok else 'could NOT archive'} {cid}" + (f" (#{orchs[cid].get('name')})" if cid in orchs else ""))
    return 0 if ok else 1

def cmd_engine(argv):
    """engine add <C…> [--name N] | rm <C…> | list — the channels the dispatch engine owns (ENGINE, engine_owned), by
    id. Writes the table only: the bot stays in the channel, nothing is archived, and a queue already held for its
    folder is not touched. Exit 2 usage, 1 for an id that is not a channel id or (rm) is not on the list."""
    verb, rest = (argv[0] if argv else ""), argv[1:]
    usage = "cc-slack engine add <C…> [--name N] | rm <C…> | list"
    table = load_table(ENGINE)
    if verb == "list" and not rest:
        for cid, rec in sorted(table.items()):
            print(f"{cid}\t#{rec.get('name') or '?'}\tsince {rec.get('at') or '?'}")
        return 0
    name = None
    if verb == "add" and len(rest) == 3 and rest[1] == "--name":
        name = rest[2].lstrip("#")
    elif verb not in ("add", "rm") or len(rest) != 1:
        print(usage, file=sys.stderr); return 2
    cid = rest[0]
    if not re.fullmatch(r"[CG][A-Z0-9]{6,}", cid):       # by id alone: a name could be anyone's channel
        print(f"cc-slack engine: {cid} is not a channel id (C…)", file=sys.stderr); return 1
    if verb == "rm":
        if cid not in table:
            print(f"cc-slack engine: {cid} is not on the engine's list", file=sys.stderr); return 1
        del table[cid]
        save_table(ENGINE, table, indent=1, sort_keys=True)
        print(f"{cid} is this daemon's again: its next message routes as before"); return 0
    rec = table.get(cid) or {}
    table[cid] = {"name": name or rec.get("name") or "", "at": rec.get("at") or time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                  "by": rec.get("by") or os.environ.get("CC_SLACK_TARGET") or os.environ.get("USER") or ""}
    save_table(ENGINE, table, indent=1, sort_keys=True)
    print(f"{cid} is the engine's: this daemon starts no session and makes no dir for it from its next event"); return 0

def cmd_unarchive(argv):
    """unarchive <C…> [--superseded-by <C…>] — undo an archive the box should not have made (2026-09-26: a SIGKILLed orch
    archived its live channel). conversations.unarchive, then the routing table says open again. With --superseded-by
    the orch already has a newer live channel: that one stays its home (orch_lookup skips a superseded entry), and the
    old one stays open for its history with one pinned line pointing at the live one. Archives nothing else."""
    sup = None
    if len(argv) == 3 and argv[1] == "--superseded-by":
        sup = argv[2]
    elif len(argv) != 1:
        print("cc-slack unarchive <C…> [--superseded-by <C…>]", file=sys.stderr); return 2
    cid = argv[0]
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack unarchive: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    orchs = load_orchs()
    if cid not in orchs or (sup and sup not in orchs):   # like archive: only a sub-orch channel the table knows
        print(f"cc-slack unarchive: {cid if cid not in orchs else sup} is not a sub-orch channel", file=sys.stderr); return 1
    if sup:   # the pointer must name the same orch's live home, or the orch is left with none (or someone else's)
        o, n = orchs[cid], orchs[sup]
        why = ("is the channel being brought back" if sup == cid else
               "is archived" if n.get("archived") else
               f"is itself superseded by {n.get('superseded_by')}" if n.get("superseded_by") else
               f"belongs to {orch_shown(n.get('target'), n.get('alias'))}, not {orch_shown(o.get('target'), o.get('alias'))}"
               if (n.get("target"), n.get("alias")) != (o.get("target"), o.get("alias")) else "")
        if why:
            print(f"cc-slack unarchive: --superseded-by {sup} {why}; it must be the same orch's live channel", file=sys.stderr); return 1
    try:
        api("conversations.unarchive", cfg["SLACK_BOT_TOKEN"], channel=cid)
    except Exception as e:
        if "not_archived" not in str(e):
            print(f"cc-slack unarchive: could NOT unarchive {cid}: {e}", file=sys.stderr); return 1
    try:
        api("conversations.join", cfg["SLACK_BOT_TOKEN"], channel=cid)   # an archive drops every member, the bot too
    except Exception as e:
        if "method_not_supported_for_channel_type" not in str(e):   # a private channel keeps its members through an archive
            log(f"unarchive {cid}: join {e!r}")
    with orchs_locked():
        orchs = load_orchs()
        e = orchs.get(cid, {})
        e["archived"], e["seen"] = False, time.time()
        if sup:
            e["superseded_by"] = sup
        else:
            e.pop("superseded_by", None)
        orchs[cid] = e
        save_orchs(orchs)
    if sup and not e.get("pinned"):
        try:
            r = api("chat.postMessage", cfg["SLACK_BOT_TOKEN"], channel=cid,
                    text=f"This channel is kept open for its history. {orch_shown(e.get('target'), e.get('alias'))} now lives in <#{sup}>, so talk to it there.")
            api("pins.add", cfg["SLACK_BOT_TOKEN"], channel=cid, timestamp=r["ts"])
            with orchs_locked():
                orchs = load_orchs()
                if cid in orchs:
                    orchs[cid]["pinned"] = r["ts"]
                    save_orchs(orchs)
        except Exception as x:
            print(f"cc-slack unarchive: {cid} is open, but the pointer line failed: {x}", file=sys.stderr); return 1
    print(f"unarchived {cid} (#{e.get('name')})" + (f", pointing at {sup}" if sup else ""))
    return 0

LANDED_RE = re.compile(r"  ·  (?:landed ✓|closed ✗) \d\d:\d\dZ?$")    # a card no longer pending (Z optional, so an old-format card still matches and isn't edited twice)
PENDING_TAIL = re.compile(r"\s+·\s+(?::\+1:|lands itself).*$", re.S)       # "  ·  :+1: from the owner merges (squash)" / "  ·  lands itself (squash)"
PENDING_RE = re.compile(r"  ·  (?::\+1: .*merges|lands itself)")              # a card still waiting on its landing
SWEEP_EVERY = 900                                                        # one real sweep per 15 min unless --now
SWEEP_MAX = 40                                                           # cap edits per run, under Slack's rate limit

CARD_ID = "pr-card:{repo}:{n}"       # the producer id a PR card is posted under: the ledger (SENT_DIR) is how it is found again

def self_lands(cfg, repo):
    """Does `repo` land its own PRs? Every project does unless CC_SELF_LAND_EXCEPT (~/.cc/config) names it; then cc-loop
    queues its landings and no 👍 is waited on. `cc lands` answers — the one reader of that rule — handed this cfg's
    exception list, so a card's lane and the loop's queue cannot disagree. Anything but 0 keeps the card in #approvals."""
    env = dict(os.environ, CC_SELF_LAND_EXCEPT=cfg.get("CC_SELF_LAND_EXCEPT") or "")
    try:
        return subprocess.call([os.path.join(BIN, "cc"), "lands", repo], env=env, stdin=subprocess.DEVNULL,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30) == 0
    except (OSError, subprocess.SubprocessError):
        return False

def card_lane(cfg, repo):
    """(channel id or None, channel name) for `repo`'s PR cards. A repo that lands its own PRs needs nobody's 👍, so
    its card is a landing record and goes to a log lane — #<repo>-updates while it has one (a member's), else the box's
    one log lane #<box>-updates — routine PR
    cards leave #approvals, which is for actions that need the owner's OK (the brief comms-requests-reach-who-decides).
    Every other repo's card stays in #approvals, where the owner's 👍 IS the merge; a self-landing repo with no log
    lane falls back there too, so no card is lost. A landing that STOPS asks for his 👍 wherever its card stands, so
    his own 👍 on a card in the log lane RE-QUEUES that landing (Daemon.owner_card_thumb) — a queue, not an
    authorization: it carries no --approved-by and lifts no protected-path hold."""
    if self_lands(cfg, repo):
        lane = ambient_lane(cfg, home_of(cfg, repo))     # its own twin (a member's), else the box's one log lane
        cid = resolve_channel(cfg, lane) if lane else None
        if cid:
            return cid, lane
    cid, member = find_channel(cfg, APPROVALS)
    return (cid if member else None), APPROVALS

def fetch_card(cfg, chat, ts):
    """The message at (chat, ts) as the sweep and the landed edit read it — with `chat` on it, since a ledger card may
    stand in a lane other than the one the caller looked in. None when Slack has no such message."""
    try:
        msgs = api("conversations.history", cfg["SLACK_BOT_TOKEN"], channel=chat, latest=ts, inclusive="true", limit="1")["messages"]
    except Exception:
        return None
    if msgs and msgs[0].get("ts") == ts:
        return dict(msgs[0], chat=chat)
    return None

def card_at(chat, ts):
    """(repo, n) when the ledger has a PR card of ours standing at (chat, ts), else None — the reading behind
    Daemon.owner_card_thumb, which is how his 👍 on a card in a log lane reaches on_approval. The RECORD is what
    makes a message a card: a post of a session's own that happens to read like one has none, so it can never
    become a merge trigger. Off disk, so an ordinary reaction costs no Slack call to rule out."""
    for f in glob.glob(f"{SENT_DIR}/pr-card:*.json"):
        try:
            rec = json.load(open(f))
        except (OSError, ValueError):
            continue
        g = re.fullmatch(r"pr-card:([a-z0-9_-]+):([0-9]+)", str(rec.get("id") or ""))
        if g and rec.get("accepted") and rec.get("chat") == chat and rec.get("ts") == ts:
            return g.group(1), g.group(2)
    return None

def ledger_cards(cfg, landed=False):
    """The PR cards the ledger knows (posted under CARD_ID) — (repo, n, message-with-chat) — still pending unless
    `landed`. Read from SENT_DIR, so a card in the log lane is found without reading that lane's history; a record
    whose message is gone is skipped, never invented."""
    out = []
    for f in sorted(glob.glob(f"{SENT_DIR}/pr-card:*.json")):
        try:
            rec = json.load(open(f))
        except (OSError, ValueError):
            continue
        g = re.fullmatch(r"pr-card:([a-z0-9_-]+):([0-9]+)", str(rec.get("id") or ""))
        if not g or not rec.get("accepted") or not rec.get("ts") or not rec.get("chat") or (rec.get("landed") and not landed):
            continue
        m = fetch_card(cfg, rec["chat"], rec["ts"])
        if m:
            out.append((g.group(1), g.group(2), m))
    return out

def approval_cards(cfg, cid, limit=200):
    """Every card in #approvals — our own "[repo] PR #n: …" posts, matched by user id — newest first, as (repo, n, message). Raises when unreadable, leaving the caller to decide whether to post anyway."""
    me = api("auth.test", cfg["SLACK_BOT_TOKEN"]).get("user_id")
    msgs = api("conversations.history", cfg["SLACK_BOT_TOKEN"], channel=cid, limit=str(limit))["messages"]
    out = []
    for m in msgs:
        g = PR_RE.match(m.get("text") or "")
        if g and m.get("user") == me:
            out.append((g.group(1), g.group(2), m))
    return out

def approval_card(cfg, cid, repo, n):
    """The card the daemon would merge on, or None. THE LEDGER FIRST: a card posted under CARD_ID is found by its
    record (chat and ts), wherever it stands — the log lane of a self-landing repo, or #approvals — and comes back
    with `chat` on it; a card the owner deleted is gone, and the ledger record is not a card. Then `cid`'s own
    history (newest, if several), for cards older than the ledger: #approvals is itself the record of those."""
    rec = sent_record(CARD_ID.format(repo=repo, n=n))
    if rec and rec.get("accepted") and rec.get("ts") and rec.get("chat"):
        m = fetch_card(cfg, rec["chat"], rec["ts"])
        if m:
            return m
    return next((m for r, k, m in approval_cards(cfg, cid) if r == repo and k == str(n)), None)

def iso_hhmm(s):
    """GitHub's "2026-09-01T04:33:58Z" → "21:33", the owner's clock; anything else → now."""
    return hhmm(s if isinstance(s, str) and re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d", s) else None)

def land_card(cfg, cid, m, state="MERGED", when=None):
    """Edits a card so it stops reading as pending — "… · landed ✓ 21:33" or "closed ✗" — replacing the ":+1: merges" tail; the "[repo] PR #n:" head stays so a late 👍 just gets told it's merged. No reaction marks a landed card, only this text — never a 👌 (reads as an AI approval). Idempotent; True when edited."""
    text, ts = m.get("text") or "", m.get("ts")
    if LANDED_RE.search(text):
        return False
    tail = "  ·  landed ✓ " if state == "MERGED" else "  ·  closed ✗ "
    api("chat.update", cfg["SLACK_BOT_TOKEN"], channel=m.get("chat") or cid, ts=ts,   # a ledger card says which lane it stands in
        text=PENDING_TAIL.sub("", text).rstrip() + tail + (when or hhmm()))
    g = PR_RE.match(text)
    if g:                                    # the ledger stops offering it to the sweep: the edit is the record
        rec = sent_record(CARD_ID.format(repo=g.group(1), n=g.group(2)))
        if rec and rec.get("ts") == ts:
            sent_write(rec["id"], dict(rec, landed=True))
    return True

PULL_URL = re.compile(r"\Ahttps://github\.com/([^/\s]+)/([^/\s]+)/pull/(\d+)\Z")

def pull_path(n):
    """The REST path of the pull a board's pr field names, as cc-reconcile's pull_path: a URL names its own repo (every
    row of a box board holds one), a bare number or #N is the checkout's, gh filling {owner}/{repo}. None else."""
    s = str(n or "").strip()
    m = PULL_URL.match(s)
    if m:
        return f"repos/{m.group(1)}/{m.group(2)}/pulls/{m.group(3)}"
    m = re.fullmatch(r"#?(\d+)", s)
    return f"repos/{{owner}}/{{repo}}/pulls/{m.group(1)}" if m else None

def gh_pr(repo, n, timeout=30):
    """PR n of ~/dev/<repo> in `gh pr view --json`'s names ({state MERGED|OPEN|CLOSED, mergedAt, closedAt, title, url})
    -> (dict, "") | (None, why). n is a number or a PR URL (pull_path). Over REST: gh pr view spends the login's GraphQL
    hour, and on 2026-10-19 that ran out with REST to spare. rc first: a refusal's stdout is GitHub's error JSON, never
    the PR."""
    path = pull_path(n)
    if not path:
        return None, f"not a PR number or URL: {n!r}"
    try:
        r = subprocess.run(["gh", "api", path], cwd=f"{DEV}/{repo}",
                           capture_output=True, text=True, timeout=timeout)
        p = json.loads(r.stdout) if r.returncode == 0 else None
    except Exception as e:
        return None, str(e)
    if not isinstance(p, dict):
        return None, (r.stderr or "").strip()[-300:] or f"gh exit {r.returncode}"
    return {"state": "MERGED" if p.get("merged_at") else str(p.get("state") or "").upper(),
            "mergedAt": p.get("merged_at"), "closedAt": p.get("closed_at"), "title": p.get("title") or "",
            "url": p.get("html_url") or ""}, ""

def pr_facts(repo, n):
    """{"state", "mergedAt", "closedAt", ...} from gh, or None (no such repo here, no network, no such PR)."""
    if not os.path.isdir(f"{DEV}/{repo}/.git"):
        return None
    return gh_pr(repo, n)[0]

def run_log(line):
    """One line to the daemon's own log and to ~/.cc/approvals/run/log, the trail the owner (or a seat) reads for why a
    👍 on a run card did or did not run anything."""
    log(f"run-card: {line}")
    try:
        with open(f"{RUN_CARDS}/log", "a") as fh:
            fh.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {line}\n")
    except OSError:
        pass

def run_card_known(ts):
    """Does a run record exist for this card? Off disk, so an ordinary reaction in #approvals costs no Slack call."""
    return bool(ts and RUN_TS_RE.match(ts) and os.path.isfile(f"{RUN_CARDS}/{ts}.json"))

def run_approved_argv(chat, ts):
    """How the daemon starts `run-approved`: its own transient user unit where systemd has one, so a command that
    restarts cc-slackd does not kill the run that is reporting on it; a detached child only when systemd-run is not on
    PATH, and that child dies with the daemon. The unit name is the
    card's, so a second start while the first still runs is refused by systemd too (the .ran claim is the real once)."""
    me = [sys.executable, SELF, "run-approved", chat, ts]
    if shutil.which("systemd-run"):
        return ["systemd-run", "--user", "--quiet", "--collect", f"--unit=cc-run-approved-{ts.replace('.', '-')}",
                f"--setenv=PATH={os.environ.get('PATH', '')}", f"--setenv=HOME={HOME}", *me]
    return me

RUN_SCOPE_MARK = "cc-run-approved: in its own scope"   # what the scope's first process says before it becomes run-approved
RUN_SCOPE_WAIT = 30                                    # seconds systemd-run --scope gets to say so (its own bus timeout is 25)

def run_approved_scope(chat, ts):
    """The second way to start `run-approved` when the transient unit was refused: `systemd-run --scope`, which moves
    the run into a scope of its own, out of cc-slackd's cgroup, so a command that restarts the daemon does not kill the
    run before it reports. A new session alone does not do that. The scope runs as this process's child, so it is not
    waited on; its sh says RUN_SCOPE_MARK and only then execs run-approved, and the mark is what is waited for.
    True: started. False: systemd-run ended without the mark, so nothing ran and a plain child is safe to start.
    None: no answer in RUN_SCOPE_WAIT; our end of the pipe is closed, so a scope that comes up later dies on its echo,
    but nobody can say it never ran, so nothing else starts (`&&`: an echo that fails execs nothing)."""
    me = [sys.executable, SELF, "run-approved", chat, ts]
    argv = ["systemd-run", "--user", "--scope", "--quiet", "--collect", f"--unit=cc-run-approved-{ts.replace('.', '-')}",
            "sh", "-c", f'echo "{RUN_SCOPE_MARK}" && exec "$@" >/dev/null 2>&1', "sh", *me]
    p = EFFECTS.popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                      start_new_session=True)
    out, deadline = b"", time.monotonic() + RUN_SCOPE_WAIT
    try:
        fd = p.stdout.fileno()
        while RUN_SCOPE_MARK.encode() not in out:
            left = deadline - time.monotonic()
            if left <= 0 or not select.select([fd], [], [], left)[0]:
                return None, f"systemd-run --scope gave no answer in {RUN_SCOPE_WAIT}s"
            chunk = os.read(fd, 4096)
            if not chunk:
                with contextlib.suppress(Exception):
                    p.wait(timeout=5)
                return False, f"systemd-run --scope: {last_line(out.decode(errors='replace')) or '(no output)'}"
            out += chunk
        return True, ""
    finally:
        with contextlib.suppress(Exception):
            p.stdout.close()

def run_card_tail(cmd, sha):
    """The exact end of a run card, as cc-notify --run builds it: the command, escaped as Slack keeps it, in a code block,
    then RUN_LINE and the stamp. A card is run only if its text ENDS with this (both read through run_card_glyphs,
    since Slack hands the card back with :+1: for 👍, and the card through run_card_unlink, since it hands a hostname
    back as a link), so a stamp or a code block that
    somebody else's words carry in the middle of a card (a PR title on a merge card) matches nothing."""
    shown = cmd.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    return f"\n```\n{shown}\n```\n{RUN_LINE} · `run:{sha[:16]}`"

def run_card_glyphs(text):
    """text with each :name: Slack stores for an emoji (SLACK_STORED_EMOJI) put back as the glyph it was sent as."""
    return re.sub("|".join(map(re.escape, SLACK_STORED_EMOJI)), lambda m: SLACK_STORED_EMOJI[m.group(0)], text)

RUN_CARD_LINK_RE = re.compile(r"<((https?://|mailto:)([^|<>\s`]+))(?:\|([^<>]*))?>")

def run_card_unlink(text):
    """text with each link Slack made on its own put back as the words that were sent. Slack stores a hostname, URL or
    address in a card, even inside its code block, as <http://host|host> or <mailto:a@b|a@b> (a DNS card,
    2026-10-06), so the card no longer ended with the command. A link is undone only when its label is exactly the
    URL minus its scheme (minus mailto: for an address), or it is an http(s) link with no label and shows the URL
    itself (or a label that is the whole URL, PR #1010), so what is put back is what the owner saw. A link whose label says anything else is left as it is, so the
    card does not match and nothing runs: a card may not show one target and carry another. A link holding a backtick
    is never undone, because <http://```|```> would put back the code fence that a link had stood in for, and the
    command between two such links shows as formatted text (security read of this change). A literal < in a command is &lt; on the
    card (run_card_tail), so a link here was made by Slack, never sent."""
    def put_back(m):
        url, scheme, rest, label = m.groups()
        if label is None:
            return url if scheme != "mailto:" else m.group(0)
        return label if label in (rest, url) else m.group(0)
    return RUN_CARD_LINK_RE.sub(put_back, text)

RUN_CFG_KEYS = ("SLACK_BOT_TOKEN", "SLACK_OWNER_ID", "SLACK_APPROVALS")

def run_cfg():
    """The three keys run-approved trusts — the bot token, the owner's id and #approvals' name — from the config file in
    this user's password-database home, and from nowhere else. cc-config (the one parser) runs with an environment
    built here, so no SLACK_OWNER_ID, CC_CONFIG or $HOME of the caller's can move one: with the environment winning,
    any session could name the bot as the owner and have the bot's own 👍 run a card (security read of PR #659). A
    gate's CC_CONFIG_DENY is the one thing passed on, since all it can do is make the file read as empty. Anything
    that fails gives {}, which refuses."""
    if not PW_HOME:
        return {}
    env = {"PATH": "/usr/bin:/bin", "HOME": PW_HOME, "CC_CONFIG": f"{PW_HOME}/.cc/config"}
    if os.environ.get("CC_CONFIG_DENY"):
        env["CC_CONFIG_DENY"] = os.environ["CC_CONFIG_DENY"]
    try:
        r = subprocess.run([f"{BIN}/cc-config", "list", "--secrets"], env=env, capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=10)
    except Exception:
        return {}
    if r.returncode != 0:
        return {}
    return {k: v for k, eq, v in (line.partition("=") for line in r.stdout.splitlines()) if eq and k in RUN_CFG_KEYS}

RUN_RUNTIME = f"/run/user/{os.getuid()}"   # this user's runtime dir: what systemd gives XDG_RUNTIME_DIR, fixed

def run_env():
    """What an approved command runs in: built from the password database and fixed values, never the caller's, so
    no BASH_ENV, PATH or HOME of theirs decides what the approved text does — and it runs the same whoever started it.
    An approved `git push` must reach its remote (security read of #659): over https git asks `gh auth git-credential`,
    which reads its token from ~/.config/gh under HOME, so no token is put here; over SSH it needs an agent, and the one
    this user's systemd starts listens at RUN_RUNTIME/openssh_agent (ssh-agent.socket), so SSH_AUTH_SOCK names that path
    when it is a socket of this user's own — never the caller's SSH_AUTH_SOCK, and nothing when there is none."""
    uid = os.getuid()
    env = {"HOME": PW_HOME, "USER": PW_USER, "LOGNAME": PW_USER, "SHELL": "/bin/bash", "LANG": "C.UTF-8",
           "PATH": f"{PW_HOME}/bin:{PW_HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
           "XDG_RUNTIME_DIR": RUN_RUNTIME, "DBUS_SESSION_BUS_ADDRESS": f"unix:path={RUN_RUNTIME}/bus"}
    agent = f"{RUN_RUNTIME}/openssh_agent"
    try:
        st = os.lstat(agent)
        if stat.S_ISSOCK(st.st_mode) and st.st_uid == uid:
            env["SSH_AUTH_SOCK"] = agent
    except OSError:
        pass
    return env

def run_hidden(s):
    r"""Does s hold a character that makes a card show one command and bash run another? cc-notify refuses the same set
    before it posts (perl: `(?![\t\n])\p{Cc}|[\p{Cf}\p{Zl}\p{Zp}]`): control characters bar a tab and a newline,
    every invisible format character (bidi marks, overrides and isolates, zero-width ones, the BOM, tag characters)
    and the Unicode line and paragraph separators, which Slack breaks a line on and bash does not."""
    return any(ch not in "\t\n" and unicodedata.category(ch) in ("Cc", "Cf", "Zl", "Zp") for ch in s or "")

def run_card_refusal(cfg, chat, ts):
    """(None, record) when the card at (chat, ts) may run, else (why not, None). The brief: "the command is fixed when
    the card is posted, stored on the host beside the card and hashed; an edited card or a changed file does not run",
    and "only a reaction by the owner's own Slack user id counts". Each is checked here, in the process that runs it,
    and none of it is taken from the daemon that started this — so a session calling run-approved by hand gets nothing
    the owner's 👍 did not already give it. The bot's own post is its user id or, for a signed one, its bot_id. The third
    value says whether the refusal is his to hear in the thread: only those found once the card is in #approvals, has a
    record on file and carries his 👍, so no one else can make the bot speak."""
    import hashlib
    if not RUN_TS_RE.match(ts or ""):
        return "not a card ts", None, False
    tok, owner = cfg.get("SLACK_BOT_TOKEN"), cfg.get("SLACK_OWNER_ID")
    if not tok or not owner:
        return "no bot token or owner id in the config", None, False
    path = f"{RUN_CARDS}/{ts}.json"
    try:
        for p, want_dir in ((RUN_CARDS, True), (path, False)):
            st = os.lstat(p)
            if stat.S_ISLNK(st.st_mode) or stat.S_ISDIR(st.st_mode) != want_dir or st.st_uid != os.getuid() or st.st_mode & 0o022:
                return f"{p} is not this user's own, unshared {'dir' if want_dir else 'file'}", None, False
        rec = json.load(open(path))
    except (OSError, ValueError) as e:
        return f"no readable run record ({e.__class__.__name__})", None, False
    try:
        # #approvals asked of Slack itself, never of the channel cache: that file sits under CC_SLACK_DIR, the caller's
        cid, member = find_channel(cfg, cfg.get("SLACK_APPROVALS") or APPROVALS)
        if not cid or not member or chat != cid:
            return f"{chat} is not #approvals", None, False
        me = api("auth.test", tok)
        bot, bot_id = me.get("user_id"), me.get("bot_id")
        msgs = api("conversations.history", tok, channel=chat, latest=ts, inclusive="true", limit="1").get("messages") or []
        msg = msgs[0] if msgs and msgs[0].get("ts") == ts else None
        got = api("reactions.get", tok, channel=chat, timestamp=ts, full="true").get("message") or {}
    except Exception as e:
        return f"Slack could not be read ({e.__class__.__name__})", None, False
    if not msg or not bot:
        return "the card is not the bot's own post", None, False
    if not any(r.get("name") in ("+1", "thumbsup") and owner in (r.get("users") or []) for r in got.get("reactions") or []):
        return "the owner's 👍 is not on the card", None, False
    # A card is a SIGNED post (username= <box>-box · <seat>), and Slack gives a signed post bot_id and no user: matching
    # user alone refused every card on record (09-25, 09-26) and told nobody. With a record on file, in #approvals and
    # the owner's 👍 on it, the refusal is his to hear — he tapped it, and silence left four PRs unmerged for 3 h.
    if msg.get("user") != bot and not (bot_id and msg.get("bot_id") == bot_id):
        return "the card is not the bot's own post", None, True
    if any(r.get("name") == RUN_CLAIM and bot in (r.get("users") or []) for r in got.get("reactions") or []):
        return f"the bot's :{RUN_CLAIM}: claim is already on the card, so it ran (or began to) once", None, False
    cmd, sha = rec.get("cmd"), rec.get("sha256") or ""
    if not isinstance(cmd, str) or not cmd or rec.get("ts") != ts or hashlib.sha256(cmd.encode()).hexdigest() != sha:
        return "the command on file was changed after the card went out (its sha256 no longer matches)", None, True
    if msg.get("edited"):
        return "the card was edited after it went out", None, True
    text, tail = run_card_unlink(run_card_glyphs(msg.get("text") or "")), run_card_glyphs(run_card_tail(cmd, sha))
    if "🔐 *Approval needed:*" not in text or not text.endswith(tail):
        return "the card does not end with this command and its run: stamp", None, True
    # cc-notify refuses both before it posts; they are asked again here because a card need not have come from it
    # (a `cc-slack post` and a hand-written record): an open fence turns the code block inside out, and a hidden
    # character makes the card show one command while bash runs another.
    if "```" in cmd or "```" in text[:-len(tail)]:
        return "the card or its command holds three backticks of its own, so it may not show what runs", None, True
    if run_hidden(cmd) or run_hidden(text) or run_hidden(msg.get("text") or ""):   # raw too: unlinking drops the URL
        return "the card or its command holds a control, bidi or zero-width character, so it may not show what runs", None, True
    return None, rec, False

def run_approved(cfg, chat, ts, run=None):
    """Check the card (run_card_refusal), claim it once, run its command as this user with `bash -c` on the STORED
    text — nothing from Slack reaches the shell — and reply in the card's thread. Returns the exit code, or None when
    nothing ran. "It runs once": before the command starts it is claimed twice, by an O_EXCL file beside the record and
    by the bot's RUN_CLAIM reaction on the card, so a second 👍, a re-added one or a second start finds one of them and
    runs nothing — and the card itself says it ran, where a lost or restored .ran file cannot."""
    why, rec, tell = run_card_refusal(cfg, chat, ts)
    if why:
        run_log(f"{ts}: not run — {why}")
        if tell:   # the brief (10-06): "the owner sees the outcome of each 👍 in the card's thread, with a ✅ or ❌"
            post(cfg, chat, f"❌ Not run: {why}. Nothing ran on the box.", thread=ts, mail=False)
            react(cfg, chat, ts, "x")
            run_tell_seat(ts, f"was refused: {why}. Nothing ran.")
        return None
    try:
        fd = os.open(f"{RUN_CARDS}/{ts}.ran", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        run_log(f"{ts}: not run — it already ran once ({RUN_CARDS}/{ts}.ran)"); return None
    try:
        api("reactions.add", cfg["SLACK_BOT_TOKEN"], channel=chat, timestamp=ts, name=RUN_CLAIM)
    except Exception as e:   # already_reacted, or Slack down: either way the card is not claimed there, so nothing runs
        with os.fdopen(fd, "w") as fh:
            json.dump({"rc": None, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                       "out": f"not run: the claim reaction was not placed ({e})"}, fh)
        run_log(f"{ts}: not run — the bot's :{RUN_CLAIM}: claim could not be placed on the card ({e}); the .ran claim "
                f"stays, so this card runs nothing now"); return None
    run_log(f"{ts}: running {rec['cmd'][:200]!r}")
    try:
        r = (run or EFFECTS.run)(["bash", "-c", rec["cmd"]], cwd=PW_HOME, env=run_env(), stdin=subprocess.DEVNULL,
                                 capture_output=True, text=True, timeout=RUN_TIMEOUT)
        rc, out = r.returncode, (r.stdout or "") + (r.stderr or "")
    except subprocess.TimeoutExpired as e:
        rc = 124
        out = "".join(x.decode(errors="replace") if isinstance(x, bytes) else (x or "") for x in (e.stdout, e.stderr))
        out += f"\n(killed after {RUN_TIMEOUT}s)"
    except Exception as e:
        rc, out = 127, f"{e.__class__.__name__}: {e}"
    with os.fdopen(fd, "w") as fh:
        json.dump({"rc": rc, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "out": out}, fh)
    run_log(f"{ts}: exit {rc}")
    # #approvals has members in it, so the card's thread gets the exit code and not a word of the output. The tail goes
    # to the owner's DM, masked all the same since Slack keeps it; the whole output stays in the .ran file beside the
    # record, which only this user reads.
    mark = "✅" if rc == 0 else "❌"
    said = "Ran it: exit 0" if rc == 0 else f"It ran and failed on its own: exit {rc}"
    post(cfg, chat, f"{mark} {said}. The output went to the owner's DM.", thread=ts, mail=False)
    try:
        post(cfg, cfg["SLACK_OWNER_ID"], f"{mark} The command on your #approvals card {ts} exited {rc}:\n"
             f"```\n{run_shown(rec['cmd'], 300)}\n```\nIts output, secrets masked:\n```\n{run_shown(out.strip(), RUN_TAIL) or '(no output)'}\n```\n"
             f"The whole output is in ~/.cc/approvals/run/{ts}.ran", mail=False)
    except Exception as e:
        run_log(f"{ts}: the output did not reach the owner's DM ({e!r}); it is in the .ran file")
    react(cfg, chat, ts, "white_check_mark" if rc == 0 else "x")
    if rc != 0:
        run_tell_seat(ts, f"ran, and its command exited {rc}. The whole output is in {RUN_CARDS}/{ts}.ran.")
    return rc

def run_capped(text, cap=RUN_MASK_CAP):
    """The last `cap` characters of text, cut before masking so a long output cannot make the mask slow (security read
    of #659), and cut at a line start so no NAME=value pair loses its name to the cut and walks past the mask as a bare
    value (nor a value on the line below its `NAME:`). A key block the cut split has an END line with no BEGIN above
    it, so everything up to that END goes too, and one still open at the end of the output takes all that is kept."""
    text = text or ""
    if len(text) <= cap:
        return text
    dropped, t = text[:-cap], text[-cap:]
    dropped, t = (dropped + t[:t.find("\n") + 1], t[t.find("\n") + 1:]) if "\n" in t else (dropped + t, "")
    # A pair the cut split across lines goes whole: the masks' \s* crosses any run of blank space, so the name may sit in
    # dropped with its value, or its `=`, kept below it after that run (#850's read: 16 KB of spaces between `password:`
    # and the value hid the name from a check of dropped's last 256 characters). Read the last tokens of dropped with the
    # blank space stripped from both sides of the cut, then drop each owed token and the rest of its line. Linear: strips
    # and splits, no pattern with a star tried at every offset.
    # What goes may itself open a pair (#850's second read: `Progress:` owed one token, that token was `password:`, and
    # its value was then shown bare), so the same test runs again on what went, until it owes nothing. Each round reads
    # only the text the last one dropped, by index into t, so the whole is still one pass over what is kept.
    i, ctx = 0, dropped
    while True:
        s = ctx.rstrip()
        toks = s.rsplit(None, 2)[-2:]
        last, before = (toks[-1].lower() if toks else ""), (toks[0].lower() if len(toks) == 2 else "")
        j = RUN_WS.match(t, i).end()
        if last.endswith("authorization:"):
            owed = 2                                # SECRET_RE's `Authorization:\s*\S+(?:\s+\S+)?`: the scheme and the token
        elif "authorization:" in last or before.endswith("authorization:") or last.endswith("bearer") or s.endswith(("=", ":")):
            owed = 1                                # the token after `Authorization: Basic`/`Bearer`, the value after NAME= / NAME:
        elif RUN_NAME_RE.search(last) and t[j:j + 1] in ("=", ":"):
            j, owed = j + 1, 1                      # a bare NAME line with `= value` below it: the `=` and its value
        else:
            break
        for _ in range(owed):
            j = RUN_TOKEN.match(t, RUN_WS.match(t, j).end()).end()
        nl = t.find("\n", j)
        j = nl + 1 if nl >= 0 else len(t)
        ctx, i = t[i:j], j
    gone, t = t[:i], t[i:]
    end = re.search(r"-----END [A-Z0-9 ]*PRIVATE KEY-----", t)
    begin = t.find("-----BEGIN ")
    # A key block opened in what the rounds above dropped is open at the cut just as one opened in `dropped` is.
    gb, ge = gone.rfind("-----BEGIN "), gone.rfind("-----END ")
    still_open = gb > ge if gb >= 0 or ge >= 0 else dropped.rfind("-----BEGIN ") > dropped.rfind("-----END ")
    if end and (begin < 0 or begin > end.start()):
        t = "[redacted private key]" + t[end.end():]
    elif not end and still_open:
        t = "[redacted private key]"   # a block open at the cut and never closed: all of what is kept is its body
    return "(the output's start is cut)\n" + t

RUN_SEAT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._@/-]{0,79}$")

def run_tell_seat(ts, what):
    """Tell the seat that posted the card (the record's `from`, written by cc-notify) that the owner's 👍 did not do what
    the card asked, so it re-posts the card fixed or finishes the step another way. Before this only the owner heard
    "Not run" or ❌, and 16 of 25 approved cards (09-27..10-11) ended so with nobody acting on it. Called only where the
    thread is told too: his 👍 on a card in #approvals with a record on file, so no one else can make it speak. The
    reason is the daemon's own words; no output goes in the message, since it may hold a secret."""
    try:
        seat = (json.load(open(f"{RUN_CARDS}/{ts}.json")).get("from") or "").strip()
    except (OSError, ValueError, AttributeError):
        seat = ""
    if not RUN_SEAT_RE.match(seat):
        run_log(f"{ts}: no seat on the record to tell ({seat[:80]!r})"); return
    text = (f"Your #approvals run card {ts} got the owner's 👍 but {what} Re-post it fixed (cc-notify --approval "
            f"--run), or finish the step another way. The trail is {RUN_CARDS}/log.")
    try:
        r = EFFECTS.run([f"{BIN}/cc-msg", window_for(seat), text], env=dict(os.environ, CC_MSG_FROM=f"run-card:{ts}"),
                        stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
        run_log(f"{ts}: told {seat} why (cc-msg exit {r.returncode})")
    except Exception as e:
        run_log(f"{ts}: could not tell {seat} why ({e!r})")

def plain_card_approve(ts, who):
    """Stamp the owner's 👍 (approved_at, approved_by) into PLAIN_CARDS/<ts>.json: (record, first), first False when it
    was stamped already, and (None, False) when it cannot be written. A card with no record (posted before cc-notify
    kept them, or by hand) gets one holding the stamp alone, so the approval is on file either way."""
    if not (ts and RUN_TS_RE.match(ts)):
        return None, False
    path = f"{PLAIN_CARDS}/{ts}.json"
    try:
        with open(path) as fh:
            rec = json.load(fh)
        if not isinstance(rec, dict):
            rec = {}
    except (OSError, ValueError):
        rec = {}
    if rec.get("approved_at"):
        return rec, False
    rec.update(ts=ts, approved_at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), approved_by=who)
    try:
        os.makedirs(PLAIN_CARDS, mode=0o700, exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            json.dump(rec, fh)
        os.replace(tmp, path)
    except OSError as e:
        log(f"approvals: plain card {ts}: {e!r}")
        return None, False
    return rec, True

def plain_card_tell(ts, rec):
    """Tell the seat named in a plain card's record (`from`, written by cc-notify) that the owner approved it, so it
    carries the step on. True once cc-msg took the message; False with no seat on file or when cc-msg failed."""
    seat = (rec.get("from") or "").strip() if isinstance(rec.get("from"), str) else ""
    if not RUN_SEAT_RE.match(seat):
        return False
    what = rec.get("id") if isinstance(rec.get("id"), str) and rec.get("id") else ts
    text = (f"The owner approved your #approvals card {what} (ts {ts}) with 👍. It carried no command, so nothing ran "
            f"on the box: go ahead with the step it asked for. The record is {PLAIN_CARDS}/{ts}.json.")
    try:
        r = EFFECTS.run([f"{BIN}/cc-msg", window_for(seat), text], env=dict(os.environ, CC_MSG_FROM=f"approval-card:{ts}"),
                        stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90)
        return r.returncode == 0
    except Exception as e:
        log(f"approvals: could not tell {seat} about card {ts} ({e!r})")
        return False

def run_mask(text):
    """A run's output with every secret shape this box has met masked: SECRET_RE's, RUN_MASKS' and NAME=value pairs.
    Every pattern runs in time linear in the text; run_shown caps the text first (run_capped)."""
    text = SECRET_RE.sub("[redacted]", text or "")
    for rx, to in RUN_MASKS:
        text = rx.sub(to, text)
    def masked(m):   # a quoted value keeps its quotes, so the line still reads as the file had it
        v = m.group(3)
        q = v[0] if len(v) > 1 and v[0] in "\"'" and v[-1] == v[0] else ""
        return f"{m.group(1)}{m.group(2)}{q}[redacted]{q}"
    return RUN_SECRET_RE.sub(masked, text)

def run_shown(text, n):
    """The last n characters of text, masked, fit for a Slack code block: no fence of its own and nothing read as a link."""
    return (run_mask(run_capped(text))[-n:].replace("```", "ˋˋˋ").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;"))

def cmd_run_approved(argv):
    if len(argv) != 2:
        print("cc-slack run-approved <chat> <ts>", file=sys.stderr); return 2
    try:
        rc = run_approved(run_cfg(), argv[0], argv[1])
    except Exception as e:   # the trail says so, where a dead unit said nothing (09-28); the thread is not told, since
        run_log(f"{argv[1]}: run-approved stopped with {e.__class__.__name__}: {str(e)[:200]}")   # nothing here was checked
        raise
    return 1 if rc is None else (0 if rc == 0 else 3)

def cmd_post_approval(argv):
    """post-approval [--force|--landed] <repo> <n|url> — posts "[repo] PR #n: title — url" into #approvals (the daemon merges on :+1:), or into #<repo>-updates for a repo that lands itself (`cc lands`: a landing record — cc-loop queues the landing and no 👍 is waited on, though the OWNER's own 👍 on that card re-queues a landing that STOPPED — card_lane, owner_card_thumb — which is what such a stop asks him for; it approves nothing and lifts no protected-path hold). Posted under the ledger id pr-card:<repo>:<n>, which is how --landed and the sweep find it again in either lane. One card per PR: a second caller finds the first and exits 0; --force posts anyway, for re-posting after a failed merge. A PR GitHub already reports MERGED/CLOSED gets its card edited to "landed ✓"/"closed ✗" instead of a new one; --landed does that edit on the caller's word and never posts. Prints the ts, or `<channel> <ts>` with --print-chat for a caller handing the card on. Exit 2 usage, 3 no token, 4 landed PR with no card, 1 gh/Slack."""
    force, landed = "--force" in argv, "--landed" in argv
    pchat = "--print-chat" in argv
    argv = [a for a in argv if a not in ("--force", "--landed", "--print-chat")]
    m = re.fullmatch(r"(?:https://github\.com/[^/\s]+/[^/\s]+/pull/)?([0-9]+)/?", argv[1] if len(argv) == 2 else "")
    if not m or not re.fullmatch(r"[a-z0-9_-]+", argv[0]) or not os.path.isdir(f"{DEV}/{argv[0]}/.git"):
        print("cc-slack post-approval [--force|--landed] [--print-chat] <repo-in-~/dev> <pr-number|pr-url>", file=sys.stderr); return 2
    repo, n, cfg = argv[0], m.group(1), load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack post-approval: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    pr, why = gh_pr(repo, n, 60)
    cid, lane = card_lane(cfg, repo)
    if pr is None or not cid:
        print(f"cc-slack post-approval: {(why if pr is None else '') or f'no #{APPROVALS} channel the bot is in (cc slack mkchannel {APPROVALS})'}", file=sys.stderr); return 1
    def say(ts, chat=None):               # the channel goes in front only with --print-chat: the lane the card really stands in
        print(f"{chat or cid} {ts}" if pchat else (ts or ""))
    state = (pr.get("state") or "").upper()
    done = landed or state in ("MERGED", "CLOSED")
    try:
        have = approval_card(cfg, cid, repo, n)
    except Exception as e:
        if done:
            print(f"cc-slack post-approval: could not read #{lane} ({e}) — the card for PR #{n} is not edited", file=sys.stderr); return 1
        log(f"post-approval: could not read #{lane} ({e}) — posting anyway"); have = None
    if done:
        if not have:
            print(f"cc-slack post-approval: PR #{n} is {state or 'landed'} and #{lane} has no card for it — none posted "
                  f"(a PR that is already in must not look pending)", file=sys.stderr); return 4
        kind = "CLOSED" if state == "CLOSED" else "MERGED"
        try:
            did = land_card(cfg, cid, have, kind, iso_hhmm(pr.get("mergedAt") or pr.get("closedAt")))
        except Exception as e:
            print(f"cc-slack post-approval: the card for PR #{n} ({have.get('ts')}) was not edited: {e}", file=sys.stderr); return 1
        log(f"post-approval: [{repo}] PR #{n} {kind.lower()} — card {have.get('ts')} {'edited' if did else 'already reads so'}, nothing posted")
        say(have.get("ts"), have.get("chat")); return 0
    if have and not force:
        log(f"post-approval: [{repo}] PR #{n} already has a card ({have.get('ts')}) — second caller posts nothing")
        say(have.get("ts"), have.get("chat")); return 0
    # the tail says what moves it: the owner's 👍 in #approvals, or nothing at all in the log lane, where the box lands it
    tail = "  ·  lands itself (squash)" if lane != APPROVALS else "  ·  :+1: from the owner merges (squash)"
    text = f"[{repo}] PR #{n}: {pr['title']} — {pr['url']}{tail}"
    pid = CARD_ID.format(repo=repo, n=n)
    with contextlib.suppress(OSError):
        os.remove(sent_path(pid))            # a NEW card (--force, or the old one deleted): the old record is not the answer
    _, ts, _how = submit(cfg, pid, cid, text)
    say(ts); return 0

def cmd_approvals_sweep(argv):
    """approvals-sweep [--dry-run] [--now] — cards still pending (":+1: … merges" in #approvals, "lands itself" in a log lane, the latter found through the ledger) whose PR GitHub reports MERGED/CLOSED get the "landed ✓"/"closed ✗" edit, once; catches merges the landing itself missed. cc-reconcile calls it every run; a real sweep happens at most once per SWEEP_EVERY unless --now. Exit 3 no token, 1 no channel."""
    dry, now = "--dry-run" in argv, "--now" in argv
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack approvals-sweep: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    stamp = f"{DIR}/approvals-sweep.at"
    try:
        age = time.time() - os.path.getmtime(stamp)
    except OSError:
        age = None
    if age is not None and age < SWEEP_EVERY and not (now or dry):
        print(f"swept {int(age // 60)} min ago — next in {int((SWEEP_EVERY - age) // 60) + 1} min (--now sweeps anyway)"); return 0
    cid, member = find_channel(cfg, APPROVALS)
    if not (cid and member):
        print(f"cc-slack approvals-sweep: no #{APPROVALS} channel the bot is in", file=sys.stderr); return 1
    try:
        cards = approval_cards(cfg, cid)
    except Exception as e:
        print(f"cc-slack approvals-sweep: could not read #{APPROVALS} ({e})", file=sys.stderr); return 1
    seen = {m.get("ts") for _, _, m in cards}
    cards += [c for c in ledger_cards(cfg) if c[2].get("ts") not in seen]   # the log lane's cards, by the ledger, not by reading that lane
    facts, edited, left = {}, [], 0
    for repo, n, m in cards:
        text = m.get("text") or ""
        if not PENDING_RE.search(text) or LANDED_RE.search(text):
            continue
        if len(edited) >= SWEEP_MAX and not dry:
            left += 1; continue                     # rest next turn — keeps one run short and under the rate limit
        if (repo, n) not in facts:
            facts[(repo, n)] = pr_facts(repo, n) or {}
        f = facts[(repo, n)]
        state = (f.get("state") or "").upper()
        if state not in ("MERGED", "CLOSED"):
            left += 1; continue
        word = "landed ✓" if state == "MERGED" else "closed ✗"
        try:
            if dry or land_card(cfg, m.get("chat") or cid, m, state, iso_hhmm(f.get("mergedAt") or f.get("closedAt"))):
                edited.append(f"[{repo}] PR #{n} {m.get('ts')} → {word}")
                dry or time.sleep(0.5)              # two calls per card, Tier 3 allows ~50/min
        except Exception as e:
            print(f"  [{repo}] PR #{n} {m.get('ts')}: not edited — {e}", file=sys.stderr); left += 1
    if not dry:
        try:
            os.makedirs(DIR, exist_ok=True); open(stamp, "a").close(); os.utime(stamp, None)
        except OSError:
            pass
    for line in edited:
        print("  " + line)
    print(f"{len(edited)} card{'' if len(edited) == 1 else 's'} {'would be ' if dry else ''}edited · {left} still pending"
          + (" (more than one run's worth — again with --now)" if len(edited) >= SWEEP_MAX else ""))
    return 0

def member_channels(tok, handle):
    """{name: id} of every channel one workspace's bot is in that member workspace `handle` owns: #<h>, #<h>--<sub>
    and their -updates lanes (ws_of_name's rule)."""
    out, cur = {}, None
    while True:
        r = api("conversations.list", tok, types="public_channel,private_channel", exclude_archived="true",
                limit="200", cursor=cur)
        for ch in r.get("channels") or []:
            n = ch.get("name") or ""
            b = main_lane(n) or n
            if ch.get("is_member") and (b == handle or b.startswith(handle + "--")):
                out[n] = ch["id"]
        cur = (r.get("response_metadata") or {}).get("next_cursor") or None
        if not cur:
            return out

def daemon_running():
    """Does a cc-slack daemon hold DIR/daemon.lock (Daemon.__init__ takes it for its whole life)? Never creates it."""
    try:
        fh = open(f"{DIR}/daemon.lock")
    except OSError:
        return False
    with fh:
        try:
            fcntl.flock(fh, fcntl.LOCK_SH | fcntl.LOCK_NB)
        except OSError:
            return True
        fcntl.flock(fh, fcntl.LOCK_UN)
    return False

def cmd_workspace(args):
    """`workspace list`: every extra Slack workspace, its member workspace and whether its two tokens answer.
    `workspace move <handle> <ws> [--uid U…] [--apply]`: the records keyed by a channel id of the default workspace
    (routes.json, orchs.json, track-threads.json) are moved to the same-named channel in <ws>, which the owner made
    and invited the bot to; ~/dev/<handle> and everything else on disk is untouched. SLACK_MEMBER_WS_<N> must already
    name <handle>: that key is the binding, this command only carries the ids over. Without --apply it prints the plan
    and writes nothing; with it, a channel missing in <ws> refuses the whole move. --uid sets the member's own user id
    in <ws> (members.json), the one whose word is an instruction in its channels. members.json's own channel ids
    (chan_id, updates_id) are carried over the same way, so every reader of the member record posts in <ws>. --apply
    refuses while a daemon holds DIR/daemon.lock: a live one keeps the old routes in memory."""
    cfg = load_cfg()
    if args[:1] == ["list"]:
        if not WS["extra"]:
            print("no extra workspace (SLACK_WORKSPACES is unset)")
        for name, w in WS["extra"].items():
            try:
                team = api("auth.test", w["bot"]).get("team") or "?"; bot = f"bot OK ({team})"
            except Exception as e:
                bot = f"bot FAILED: {e}"
            try:
                api("apps.connections.open", w["app"]); app = "app OK"
            except Exception as e:
                app = f"app FAILED: {e}"
            print(f"{name}: member workspace {w['member'] or '(none)'}{' (mirror)' if w.get('mirror') else ''}, "
                  f"owner {w['owner'] or '(not in it)'}, approver {w.get('approver') or '(none)'}; {bot}; {app}")
        return 0
    if args[:1] in (["route"], ["channel"], ["employee"]):
        return workspace_face(cfg, args)
    pos, flags, uid, it = [], set(), "", iter(args)
    for a in it:
        if a == "--uid":
            uid = next(it, "")
        if a.startswith("--"):
            flags.add(a)
        else:
            pos.append(a)
    if pos[:1] != ["move"] or len(pos) != 3 or flags - {"--uid", "--apply"} or ("--uid" in flags and not re.match(r"[UW][A-Z0-9]+\Z", uid)):
        print("usage: cc-slack workspace list | move <handle> <ws> [--uid U…] [--apply]\n" + WS_FACE_USAGE, file=sys.stderr); return 2
    handle, ws = pos[1], pos[2]
    w = WS["extra"].get(ws)
    if not w:
        print(f"{ws} is not a configured workspace (SLACK_WORKSPACES, SLACK_BOT_TOKEN_<N>, SLACK_APP_TOKEN_<N>)", file=sys.stderr); return 1
    if w["member"] != handle:
        print(f"SLACK_MEMBER_WS_{ws.upper().replace('-', '_')} is {w['member'] or 'unset'}, not {handle}: set it first", file=sys.stderr); return 1
    old, new = member_channels(cfg["SLACK_BOT_TOKEN"], handle), member_channels(w["bot"], handle)
    ids = {}
    for n in sorted(old):
        print(f"#{n}  {old[n]} -> {new.get(n) or 'MISSING in ' + ws}")
        if new.get(n):
            ids[old[n]] = new[n]
    missing = [n for n in old if n not in new]
    if "--apply" not in flags:
        print("dry run: nothing written (--apply moves it)"); return 0
    if missing:
        print(f"not moved: make {', '.join('#' + n for n in sorted(missing))} in {ws} and invite the bot", file=sys.stderr); return 1
    if daemon_running():
        print("not moved: cc-slackd is running and would keep the old routes — stop it first "
              "(systemctl --user stop cc-slackd), then run this again", file=sys.stderr); return 1
    routes = load_routes()
    save_table("routes.json", {ids.get(k, k): v for k, v in routes.items()}, indent=1)
    orchs = load_orchs()
    if any(k in ids for k in orchs):
        save_orchs({ids.get(k, k): v for k, v in orchs.items()})
    tracks = load_table(TRACKS)
    gone = [t for t, e in tracks.items() if e.get("chat") in ids]
    if gone:   # their next line opens a fresh thread in the new channel
        save_table(TRACKS, {t: e for t, e in tracks.items() if t not in gone}, indent=1)
    for n, cid in new.items():
        ws_remember("chan", cid, ws)
    with contextlib.suppress(FileNotFoundError):
        os.unlink(f"{DIR}/channels.json")              # name -> id cache of the default workspace: re-read
    m = load_members()
    moved = {h: {k: ids.get(v, v) if isinstance(v, str) else v for k, v in (r or {}).items()} for h, r in m.items()}
    if uid and handle in moved:
        moved[handle]["uid"] = uid
        ws_remember("user", uid, ws)
    if moved != m:                                     # chan_id, updates_id: MailPlaces and every member post read them
        save_members(moved)
    print(f"moved {len(ids)} channel(s) of {handle} to {ws}; {len(gone)} track thread(s) reopen at their next line")
    return 0

WS_FACE_USAGE = ("usage: cc-slack workspace route <ws> <C…> <target>\n"
                 "       cc-slack workspace channel <ws> <name> <target> [--title T] [--purpose P] [--with U…]\n"
                 "       cc-slack workspace employee <ws> <name> <U…> [--title T] [--purpose P]")

def workspace_face(cfg, args):
    """A channel of extra workspace <ws> routed to one target of its member workspace — the way a mirror's channels,
    plainly named, reach the sessions that already exist. `route` records an existing channel's id in routes.json.
    `channel` makes #<name> there (always PRIVATE), invites the owner's id there, SLACK_INVITE_<N> and any --with,
    sets its topic (--title) and purpose (--purpose), and routes it. `employee <ws> <name> <U…>` is `channel` for one
    person: #<name>, routed to the track <member>/<name>, with them invited too; their session starts at their first
    message, inside the member workspace like any of its tracks, and they are a member there, never its approver. Each
    is idempotent: a channel already there is reused, a route already right is left. The target must belong to the
    member workspace <ws> is bound to (SLACK_MEMBER_WS_<N>): no channel there can be routed to the box's own sessions."""
    pos, opt, it = [], {"--title": "", "--purpose": "", "--with": []}, iter(args)
    for a in it:
        if a in ("--title", "--purpose"):
            opt[a] = next(it, "")
        elif a == "--with":
            opt[a].append(next(it, ""))
        elif a.startswith("--"):
            print(WS_FACE_USAGE, file=sys.stderr); return 2
        else:
            pos.append(a)
    verb = pos[0]
    uid_re = r"[UW][A-Z0-9]+\Z"
    if len(pos) != 4 or (verb == "route" and not re.match(r"[CG][A-Z0-9]+\Z", pos[2])) \
            or (verb != "route" and not re.match(r"[a-z0-9][a-z0-9_-]{0,79}\Z", pos[2])) \
            or (verb == "employee" and not re.match(uid_re, pos[3])) or not all(re.match(uid_re, u) for u in opt["--with"]):
        print(WS_FACE_USAGE, file=sys.stderr); return 2
    ws = pos[1]
    w = WS["extra"].get(ws)
    if not w:
        print(f"{ws} is not a configured workspace (SLACK_WORKSPACES, SLACK_BOT_TOKEN_<N>, SLACK_APP_TOKEN_<N>)", file=sys.stderr); return 1
    h = w["member"]
    target = f"{h}/{pos[2]}" if verb == "employee" else pos[3]
    if not h or target.partition("/")[0] != h or not valid_target(target):
        print(f"{target} is not a target of {ws}'s member workspace ({h or 'SLACK_MEMBER_WS_' + ws.upper().replace('-', '_') + ' unset'})", file=sys.stderr); return 1
    if verb == "route":
        cid = pos[2]
        try:
            info = api("conversations.info", w["bot"], channel=cid)["channel"]
        except Exception as e:
            print(f"{cid} is not a channel the bot can see in {ws}: {e}", file=sys.stderr); return 1
        name = info.get("name") or cid
    else:
        name = pos[2]
        invite = [u for u in dict.fromkeys(w.get("invite", []) + opt["--with"] + ([pos[3]] if verb == "employee" else []))
                  if u != w["owner"]]                   # ensure_channel invites the owner's id there itself
        cid, how = ensure_channel(cfg, name, True, invite=invite, ws=ws)
        print(f"#{name} {cid}: {how} in {ws}, invited {' '.join(invite) or 'nobody else'}")
        title = opt["--title"] or (f"{name.replace('-', ' ').title()}'s own channel" if verb == "employee" else "")
        purpose = opt["--purpose"] or ("Ask for anything here, or suggest a project. Your assistant answers in this "
                                       "channel." if verb == "employee" else "")
        for method, key, text in (("conversations.setTopic", "topic", title), ("conversations.setPurpose", "purpose", purpose)):
            if text:
                try:
                    api(method, w["bot"], channel=cid, **{key: text})
                except Exception as e:
                    print(f"#{name}: {key} not set ({e})", file=sys.stderr)
    ws_remember("chan", cid, ws)
    routes = load_routes() or {}
    if routes.get(cid) == target:
        print(f"#{name} {cid} already routes to {target}"); return 0
    routes[cid] = target
    save_table("routes.json", routes, indent=1)
    print(f"#{name} {cid} in {ws} → {target}")
    return 0

def cmd_selfcheck():
    """Unit checks that need no Slack. Exit 1 on any failure. The cases are core/tests/slack_selfcheck.py, run in THIS
    namespace so their patches (globals()["api"] = fake, global DIR) land on the tool as they did when the body was here."""
    path = os.path.join(ROOT, "tests", "slack_selfcheck.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    # Every scratch dir the cases make is made inside this one and goes with it, on a red or raised run too;
    # a gate's timeout sends TERM, which is turned into an exit so the cleanup still runs.
    import signal
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    with tempfile.TemporaryDirectory(prefix="cc-slack-selfcheck-", ignore_cleanup_errors=True) as tempfile.tempdir:
        try:
            return globals()["run_selfcheck"]()
        finally:
            tempfile.tempdir = None

def cmd_manifest(argv):
    """apps.manifest.update with an app configuration token (api.slack.com/apps → Your App Configuration Tokens)."""
    tok = app = None
    i = 0
    while i < len(argv):
        if argv[i] == "--config-token":
            tok = argv[i + 1]; i += 2
        elif argv[i] == "--app":
            app = argv[i + 1]; i += 2
        else:
            i += 1
    manifest = open(f"{ROOT}/slack/app-manifest.json").read().replace("<box>", BOX)   # the shipped manifest is a template
    if "--print" in argv:                                    # paste-ready for App Manifest (Slack rejects the raw template)
        print(manifest, end=""); return 0
    if not (tok and app):
        print("cc-slack manifest --print | --config-token xoxe.xoxp-… --app A0…   (App ID: api.slack.com/apps → the app → Basic Information)"); return 2
    try:
        v = api("apps.manifest.validate", tok, manifest=manifest, app_id=app)
    except RuntimeError as e:
        print(f"manifest rejected: {e}"); return 1
    r = api("apps.manifest.update", tok, app_id=app, manifest=manifest)
    print(f"manifest applied to {r.get('app_id', app)}; permissions changed: {r.get('permissions_updated')}")
    print(f"remaining taps: 1) https://api.slack.com/apps/{app}/install-on-team → Reinstall → Allow → copy the Bot User OAuth Token (xoxb-…)\n"
          f"                2) https://api.slack.com/apps/{app}/general → App-Level Tokens → Generate (connections:write) → copy xapp-…\n"
          f"                3) on the box: cc slack setup --bot xoxb-… --app xapp-… --owner-email <email>; cc slack on; cc slack mkchannel <repo> …")
    return 0

NAME_MISSES, NAME_MISS_S = {}, 60   # {(channels file, #name): (when a full list did not have it, the file's stamp)}

def table_stamp(path):
    """The channel table's mtime, or None with no table: a remembered miss holds only while the table it was read
    against is the one on disk (ensure_channel unlinks it on every channel it makes)."""
    try:
        return os.stat(path).st_mtime_ns
    except OSError:
        return None

def resolve_channel(cfg, name):
    """#name → channel id (only channels the bot is a member of); cached on disk for an hour, and a miss for a minute
    (NAME_MISSES) so a name asked for again and again lists once. A name a member
    workspace of another Slack workspace owns (ws_of_name) is looked up in that workspace alone, cached apart.

    The same rebuild writes channels-about.json beside it: each channel's purpose, or its topic when it has no
    purpose, as conversations.list already returns them. The mail classifier reads that to know what a channel
    is for (MailPlaces._about), so describing a channel costs no call of its own. Another workspace's rebuild
    writes its own channels-about-<ws>.json, so it never overwrites the home workspace's file."""
    ws = ws_of_name(name)
    tok = WS["extra"][ws]["bot"] if ws else cfg["SLACK_BOT_TOKEN"]
    path = f"{DIR}/channels-{ws}.json" if ws else f"{DIR}/channels.json"
    about_path = f"{DIR}/channels-about-{ws}.json" if ws else f"{DIR}/channels-about.json"
    try:
        c = json.load(open(path))
        if time.time() - c.get("_t", 0) < 3600 and name in c and c[name] not in load_retired():
            return c[name]         # a cached id of a channel since retired is a miss: re-list, which skips archived ones
    except Exception:
        c = {}
    miss = NAME_MISSES.get((path, name))
    if miss and time.time() - miss[0] < NAME_MISS_S and miss[1] == table_stamp(path):
        return None                # just listed and not there: asked again and again, it would spend the rate limit
    cur, found, about, made = None, {}, {}, []
    try:
        while True:
            r = api("conversations.list", tok, types="public_channel,private_channel", exclude_archived="true", limit="200", cursor=cur)
            for ch in r["channels"]:
                if ch.get("is_member"):
                    found[ch["name"]] = ch["id"]
                    if ws_of_name(ch["name"]) == ws:
                        ws_remember("chan", ch["id"], ws)
                    made.append((ch["id"], ch["name"], ch.get("creator")))
                    said = channel_about(ch)
                    if said:
                        about[ch["name"]] = said
            cur = r.get("response_metadata", {}).get("next_cursor") or None
            if not cur:
                break
        found["_t"] = about["_t"] = time.time()
        os.makedirs(DIR, exist_ok=True)
        with contextlib.suppress(Exception):
            retired_back([v for k, v in found.items() if k != "_t"])   # an unarchived channel is live again
        with contextlib.suppress(Exception):
            seed_twins(cfg, made)                                      # once: the -updates twins the bot made
        json.dump(found, open(path, "w"))
        json.dump(about, open(about_path, "w"))
    except Exception:
        pass
    if name not in found:
        NAME_MISSES[(path, name)] = (time.time(), table_stamp(path))
    return found.get(name)

def channel_about(ch):
    """One conversations.list entry's purpose, else its topic, else "" — raw; whoever shows it folds it."""
    for k in ("purpose", "topic"):
        v = ch.get(k)
        v = v.get("value") if isinstance(v, dict) else ""
        if isinstance(v, str) and v.strip():
            return v.strip()
    return ""

def resolve_chat(cfg, s):
    """#name → channel id via resolve_channel; a bare C…/D…/U… id passes through unchanged."""
    return (resolve_channel(cfg, s[1:]) or s) if s.startswith("#") else s

def clamp_n(s, default, cap):
    """Parse a user-given count, clamped to [1, cap]; blank/non-numeric → default. The clamp IS the information diet."""
    return min(max(int(s), 1), cap) if s and s.isdigit() else default

def plain(text, uname, handle=None):
    """Slack markup -> readable text; `handle` (default uname) renders @mentions as the @handle a session can write back."""
    handle = handle or uname
    text = re.sub(r"<@(U[A-Z0-9]+)>", lambda m: "@" + handle(m.group(1)), text or "")
    text = re.sub(r"<(https?://[^|>]+)\|([^>]+)>", r"\2 (\1)", text)
    text = re.sub(r"<(https?://[^>]+)>", r"\1", text)
    return text.replace("&lt;", "<").replace("&gt;", ">").replace("&amp;", "&")

def fmt_history(cfg, msgs):
    """Compact "HH:MM user: text" lines, each message whole. Shared by the CLI and the history/thread tools."""
    tok = cfg.get("SLACK_BOT_TOKEN"); names = {}
    def info(uid):
        if uid not in names:
            try:
                u = api("users.info", tok, user=uid)["user"]
                names[uid] = (u.get("real_name") or uid, (u.get("name") or "").strip() or None)
            except Exception:
                names[uid] = (uid, None)
        return names[uid]
    def uname(uid):
        return info(uid)[0]
    def handle(uid):
        return info(uid)[1] or info(uid)[0]
    out = []
    for m in msgs:
        who = m.get("username") if m.get("bot_id") and not m.get("user") else uname(m.get("user", "?"))
        t = time.strftime("%H:%M", time.localtime(float(m.get("ts") or 0)))
        text = plain(m.get("text", ""), uname, handle)
        out.append(f"{t} {who}: {text}")
    return "\n".join(out) or "(no messages)"

def replies_tail(cfg, chat, ts, n, pages=10):
    """The last n messages of a thread; conversations.replies is oldest-first, so page the cursor and keep the tail or a long thread shows nothing recent."""
    tok = cfg["SLACK_BOT_TOKEN"]
    msgs, cur = [], None
    for _ in range(pages):
        kw = {"cursor": cur} if cur else {}
        r = api("conversations.replies", tok, channel=chat, ts=ts, limit="200", **kw)
        msgs.extend(r.get("messages") or [])
        cur = (r.get("response_metadata") or {}).get("next_cursor") or None
        if not (r.get("has_more") and cur):
            break
    return msgs[-n:] if n and len(msgs) > n else msgs

def own_message(cfg, chat, ts):
    """The message at (chat, ts) exists and was posted by this bot — required before chat.update/chat.delete touch it."""
    tok = cfg["SLACK_BOT_TOKEN"]
    msgs = api("conversations.history", tok, channel=chat, latest=ts, inclusive="true", limit="1")["messages"]
    msg = msgs[0] if msgs and msgs[0].get("ts") == ts else None
    if not msg:
        return False
    me = api("auth.test", tok)
    # a signed post (username= override ⇒ subtype bot_message) carries bot_id and NO user: matching only user_id refused our own posts
    return msg.get("user") == me.get("user_id") or bool(me.get("bot_id")) and msg.get("bot_id") == me.get("bot_id")

def display_name(target, alias=None):
    """`<box>-box · <session>` for chat.postMessage username=, so the owner sees who sent what without reading the text: an aliased orchestrator uses its alias, everyone else its own target. CC_SLACK_PLAIN_NAME=1 disables it."""
    return f"{BOX}-box · " + (alias or target or "box")

STARTUP_MCP = ("Use this MCP server", "MCP servers may execute code")      # Claude Code's MCP-server trust prompt
STARTUP_DEV = ("development channels", "local development")               # …and its development-channels warning

def startup_prompt(pane):
    """Is one of the two startup dialogs on the pane? Read-only — accept_prompts is what presses them."""
    return any(m in pane for m in STARTUP_MCP + STARTUP_DEV)

def limit_option(pane):
    """Pane text → the digit for the session/usage-limit dialog's "continue automatically" option, or None.
    Ported from cc-msg's limit_option() (awk) — the box waits limits out, so that option is always the answer
    (a session sat on this dialog ~40 min, 2026-09-24; #557 already covers the MODEL-switch dialog, not this one).
    Only the dialog at the FOOT of the pane counts: after the last line holding "hit your" and "limit" the next
    line with words must be "What do you want to do?", then only numbered option lines, then the
    "Enter to confirm" / "Esc to cancel" footer with nothing but blank lines below it. Anything else: not it."""
    lines = pane.split("\n")
    h = next((i for i in range(len(lines) - 1, -1, -1) if "hit your" in lines[i] and "limit" in lines[i]), None)
    if h is None:
        return None
    i = h + 1
    while i < len(lines) and not re.search(r'[A-Za-z0-9]', lines[i]):
        i += 1
    if i >= len(lines) or "What do you want to do?" not in lines[i]:
        return None
    d, foot = "", False
    i += 1
    while i < len(lines):
        l = lines[i]; i += 1
        if not re.search(r'[A-Za-z0-9]', l):
            continue
        if foot:
            return None                                    # words under the footer: not the foot of the pane
        if "Enter to confirm" in l or "Esc to cancel" in l:
            foot = True; continue
        if not re.match(r'^[^A-Za-z0-9]*[0-9]\. ', l):
            return None                                    # not an option line
        if "continue automatically" in l:
            m = re.search(r'[0-9]', l); d = m.group(0) if m else ""
    return d if foot and d else None

def accept_prompts(wid):
    """Press through the dialogs blocking a session (MCP-server trust: option 2 trusts this and future servers;
    dev-channels warning; the session/usage-limit dialog: "continue automatically", never a fixed digit — the box
    waits limits out). True if something was pressed."""
    rc, pane = tmux("capture-pane", "-p", "-t", wid)
    if rc != 0:
        return False
    if any(m in pane for m in STARTUP_MCP):
        tmux("send-keys", "-t", wid, "-l", "--", "2"); time.sleep(0.3); tmux("send-keys", "-t", wid, "Enter")
        return True
    if any(m in pane for m in STARTUP_DEV):
        tmux("send-keys", "-t", wid, "Enter")
        time.sleep(1.5)
        rc, pane = tmux("capture-pane", "-p", "-t", wid)
        if "local development" in pane:          # still open: select the first option explicitly
            tmux("send-keys", "-t", wid, "Up", "Enter")
        return True
    d = limit_option(pane)
    if d:
        tmux("send-keys", "-t", wid, "-l", "--", d); time.sleep(0.3); tmux("send-keys", "-t", wid, "Enter")
        return True
    return False

def cmd_accept_dialog(win, seconds=180):
    """Auto-accept the startup dialogs in a tmux window (dev-channels warning, MCP-server trust) and the
    session/usage-limit dialog ("continue automatically") for up to `seconds`."""
    deadline = time.time() + seconds; pressed = 0
    while time.time() < deadline:
        wid, _ = tmux_window(win)
        if wid and accept_prompts(wid):
            pressed += 1; time.sleep(2)               # a second prompt may follow the first (trust, then dev-channels)
            if pressed >= 2:
                return 0
        elif pressed:
            return 0
        time.sleep(1)
    return 0 if pressed else 1

def cmd_history(argv):
    if not (1 <= len(argv) <= 2):
        print("cc-slack history <#chan|C…|D…> [n]   (default 20, max 100)", file=sys.stderr); return 2
    if os.environ.get("CC_MEMBER_SANDBOX") == "1":
        return member_sock_cli("history", {"history": argv[0], "n": argv[1] if len(argv) == 2 else None})
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack history: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    n = clamp_n(argv[1] if len(argv) == 2 else None, 20, 100)
    try:
        msgs = api("conversations.history", cfg["SLACK_BOT_TOKEN"], channel=resolve_chat(cfg, argv[0]), limit=str(n))["messages"]
    except Exception as e:
        print(f"cc-slack history: {e}", file=sys.stderr); return 1
    print(fmt_history(cfg, list(reversed(msgs)))); return 0

def cmd_thread(argv):
    if not (2 <= len(argv) <= 3):
        print("cc-slack thread <#chan|C…> <ts> [n]   (default full thread, max 50)", file=sys.stderr); return 2
    if os.environ.get("CC_MEMBER_SANDBOX") == "1":
        return member_sock_cli("thread", {"thread": argv[0], "ts": argv[1], "n": argv[2] if len(argv) == 3 else None})
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack thread: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    n = clamp_n(argv[2] if len(argv) == 3 else None, 50, 50)
    try:
        msgs = replies_tail(cfg, resolve_chat(cfg, argv[0]), argv[1], n)
    except Exception as e:
        print(f"cc-slack thread: {e}", file=sys.stderr); return 1
    print(fmt_history(cfg, msgs)); return 0

def cmd_edit(argv):
    if len(argv) < 3:
        print("cc-slack edit <chan> <ts> <new text>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack edit: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, ts = resolve_chat(cfg, argv[0]), argv[1]
    try:
        if not own_message(cfg, chat, ts):
            print("cc-slack edit: refusing — not a message this bot posted", file=sys.stderr); return 1
        api("chat.update", cfg["SLACK_BOT_TOKEN"], channel=chat, ts=ts, text=linkify_mentions(cfg, mrkdwn(" ".join(argv[2:])), chat))
    except Exception as e:
        print(f"cc-slack edit: {e}", file=sys.stderr); return 1
    return 0

def cmd_unsay(argv):
    if len(argv) != 2:
        print("cc-slack unsay <chan> <ts>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print("cc-slack unsay: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, ts = resolve_chat(cfg, argv[0]), argv[1]
    try:
        if not own_message(cfg, chat, ts):
            print("cc-slack unsay: refusing — not a message this bot posted", file=sys.stderr); return 1
        api("chat.delete", cfg["SLACK_BOT_TOKEN"], channel=chat, ts=ts)
    except Exception as e:
        print(f"cc-slack unsay: {e}", file=sys.stderr); return 1
    return 0

def cmd_pin(argv, remove=False):
    verb = "unpin" if remove else "pin"
    if len(argv) != 2:
        print(f"cc-slack {verb} <chan> <ts>", file=sys.stderr); return 2
    cfg = load_cfg()
    if not cfg.get("SLACK_BOT_TOKEN"):
        print(f"cc-slack {verb}: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    try:
        api("pins.remove" if remove else "pins.add", cfg["SLACK_BOT_TOKEN"], channel=resolve_chat(cfg, argv[0]), timestamp=argv[1])
    except Exception as e:
        print(f"cc-slack {verb}: {e}", file=sys.stderr); return 1
    return 0

def cmd_revisit(argv):
    """`cc-slack revisit [--json]` — threads the owner 📌'd, newest first: when, channel, first line, permalink; read off REVISIT, no daemon or Slack call needed. --json gives the same rows for a tool."""
    if argv not in ([], ["--json"]):
        print("cc-slack revisit [--json]", file=sys.stderr); return 2
    rows = revisit_rows(load_revisit())
    if argv:
        print(json.dumps(rows)); return 0
    if not rows:
        print("nothing pinned to revisit — the owner's 📌 on a thread puts it here"); return 0
    for r in rows:
        print("\t".join(x for x in (r["when"], r["channel"], r["text"] or "(no text)", r["link"]) if x))
    return 0

def load_canvases():
    """Which canvas is which channel's, as last seen (see CANVASES); read from disk every use, written only by the CLI, so there's no cache to invalidate."""
    try:
        d = json.load(open(f"{DIR}/{CANVASES}"))
        return {k: v for k, v in d.items() if isinstance(v, dict)} if isinstance(d, dict) else {}
    except Exception:
        return {}

def remember_canvas(chat, canvas_id, title):
    """Atomic, 0600; makes a second `cc-slack canvas` an edit, since a free plan can report no canvas for a channel that has one (a create then fails with free_team_canvas_tab_already_exists)."""
    cans = load_canvases()
    cans[chat] = {"canvas_id": canvas_id, "title": title, "updated": int(time.time())}
    try:
        os.makedirs(DIR, exist_ok=True)
        tmp = f"{DIR}/{CANVASES}.tmp"
        with open(tmp, "w") as f:
            os.fchmod(f.fileno(), 0o600); json.dump(cans, f)
        os.replace(tmp, f"{DIR}/{CANVASES}")
    except Exception as e:
        log(f"canvases: save failed: {e!r}")

def canvas_of(tok, chat):
    """The channel's existing canvas id, or None — via conversations.info: properties.canvas.file_id, or the canvas tab (properties.tabs) this workspace's plan uses instead."""
    try:
        props = api("conversations.info", tok, channel=chat)["channel"].get("properties") or {}
    except Exception:
        return None                               # a channel we cannot read is the create branch's problem to report
    return ((props.get("canvas") or {}).get("file_id")
            or next((t["data"]["file_id"] for t in (props.get("tabs") or [])
                     if t.get("type") == "canvas" and (t.get("data") or {}).get("file_id")), None))

def canvas_in_files(tok, chat):
    """Last resort: the channel's canvas as a shared file (a canvas is a "quip" file) — finds one when conversations.info reports none, exactly when a create would be rejected."""
    try:
        files = api("files.list", tok, channel=chat, types="canvases", count="200").get("files") or []
    except Exception:
        return None
    return next((f["id"] for f in files if f.get("id") and f.get("filetype") in ("quip", "canvas")), None)

def cmd_canvas(argv):
    """canvas <#chan|C…> <title>, markdown on stdin. Creates the channel's canvas if it has none, else replaces its content wholesale."""
    if len(argv) != 2:
        print("cc-slack canvas <#chan|C…> <title>   (markdown on stdin)", file=sys.stderr); return 2
    cfg = load_cfg(); tok = cfg.get("SLACK_BOT_TOKEN")
    if not tok:
        print("cc-slack canvas: no SLACK_BOT_TOKEN", file=sys.stderr); return 3
    chat, title, md = resolve_chat(cfg, argv[0]), argv[1], sys.stdin.read()
    changes = json.dumps([{"operation": "replace", "document_content": {"type": "markdown", "markdown": md}}])
    def replace(cid):
        api("canvases.edit", tok, canvas_id=cid, changes=changes); return cid
    try:
        canvas_id, cached = None, (load_canvases().get(chat) or {}).get("canvas_id")
        if cached:                                # the id we wrote last time: no lookup at all in the common case
            try:
                canvas_id = replace(cached)
            except RuntimeError as e:
                if "not_found" not in str(e):
                    raise
                log(f"canvas: {cached} is gone — resolving {chat}'s canvas again")
        if not canvas_id:
            found = canvas_of(tok, chat) or canvas_in_files(tok, chat)
            if found:
                canvas_id = replace(found)
            else:
                try:
                    canvas_id = api("conversations.canvases.create", tok, channel_id=chat,
                                    document_content=json.dumps({"type": "markdown", "markdown": md}), title=title)["canvas_id"]
                except RuntimeError as e:
                    if "free_team_canvas_tab_already_exists" not in str(e):
                        raise
                    found = canvas_in_files(tok, chat)     # Slack says one exists, so it does: find it and replace it
                    if not found:
                        print(f"cc-slack canvas: {argv[0]} already has a canvas, but its id could not be resolved "
                              "(conversations.info and files.list both report none) — open the channel's canvas tab and "
                              "pass its F… id to canvases.edit by hand", file=sys.stderr)
                        return 1
                    canvas_id = replace(found)
        remember_canvas(chat, canvas_id, title)
    except Exception as e:
        print(f"cc-slack canvas: {e}", file=sys.stderr); return 1
    print(canvas_id or ""); return 0

def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip()); return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "daemon":
        _POSTER_DAEMON.append(True)
        Daemon(use_slack="--no-slack" not in rest).run()
    elif cmd == "channel":
        target = rest[0] if rest else detect_target()
        if not valid_target(target):
            print(f"cc-slack channel: no target for cwd {os.getcwd()} (give one: cc-slack channel <repo>[/<track>]|box)", file=sys.stderr); return 2
        log(f"channel server for target {target}")
        ch = Channel(target); ch.aio.run(ch.run())
    elif cmd == "inject":
        start = True
        if rest and rest[0] == "--no-start":
            start = False; rest = rest[1:]
        if len(rest) < 2:
            print("cc-slack inject [--no-start] <target> \"text\"", file=sys.stderr); return 2
        try:
            r = sock_request({"inject": rest[0], "content": " ".join(rest[1:]), "start": start})
        except Exception as e:
            print(f"daemon not running ({e.__class__.__name__}) — cc slack on", file=sys.stderr); return 1
        print(r.get("result") or r.get("error")); return 0 if r.get("ok") else 1
    elif cmd == "dispatch":   # inside a member boundary: `cc <h> <track> --go` (or `cc <h> --orch <alias>`) asks the host to run it (Daemon.member_verb)
        if not rest:
            print("cc-slack dispatch <handle>/<track> [--loop N] [--budget USD] [--model M] [--turns N] [--effort E] | <handle>@<alias> [--brief TEXT]", file=sys.stderr); return 2
        try:
            r = sock_request({"dispatch": rest[0], "opts": rest[1:]}, timeout=200)
        except Exception as e:
            print(f"the box's socket did not answer ({e.__class__.__name__}) — nothing dispatched", file=sys.stderr); return 1
        print(r.get("text") or r.get("error") or ""); return 0 if r.get("ok") else 1
    elif cmd in ("escalate", "ask"):
        # escalate: member boundary lacks ~/.cc/config, so the daemon relays it as a request to the planning seat.
        # escalate --notice [--file P] [--id ID]: a WORKER'S END LINE or its Slack deliverable, `-t "<h>/<track> <kind>"` — into
        # the track's thread and one line to the seat, never a request (Daemon.member_notice); cc-notify and cc-loop
        # inside the boundary use it, a person has no reason to.
        # ask: the workspace's question to the box's PLANNING SEAT (a repo, a host-side push, a question) — the daemon
        # posts the card in the control repo's -threads lane on its behalf and hands the thread's answer back to the
        # workspace's session, never its channel (Daemon.relay_ask / answer_ask). Same -t title; `-p` is escalate's and dropped either way.
        title, args, req = "", [], {}
        i = 0
        while i < len(rest):
            if rest[i] == "-t" and i + 1 < len(rest):
                title = rest[i + 1]; i += 2
            elif rest[i] == "-p" and i + 1 < len(rest):
                i += 2                     # severity is the table's call, not the caller's; drop it so `-p high` doesn't leak into the message
            elif cmd == "escalate" and rest[i] == "--notice":
                req["notice"] = True; i += 1
            elif cmd == "escalate" and rest[i] == "--file" and i + 1 < len(rest):
                req["attach"] = os.path.realpath(rest[i + 1]); i += 2
            elif cmd == "escalate" and rest[i] == "--id" and i + 1 < len(rest):
                req["id"] = rest[i + 1]; i += 2   # the notice's dedup id; the daemon checks it and files it under the workspace
            elif rest[i] == "--" :
                args += rest[i + 1:]; break
            else:
                args.append(rest[i]); i += 1
        text = " ".join(args) if args else sys.stdin.read()
        nothing = "nobody was told" if cmd == "escalate" else "nothing was asked"
        try:
            r = sock_request({cmd: title, "text": text, **req}, timeout=90)
        except Exception as e:
            print(f"the workspace's Slack link did not answer ({e.__class__.__name__}) — {nothing}", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "project":   # member boundary: the session asks, the daemon creates; only the leaf name travels, so it can't name another lane
        name = rest[0] if rest else ""
        if not name or name.startswith("-"):
            print("cc-slack project <name>   ask for #<this workspace>--<name>", file=sys.stderr); return 2
        try:
            r = sock_request({"project": name}, timeout=120)   # longer than escalate's 60: the pair is two channel creates, a topic and the invites
        except Exception as e:
            print(f"the workspace's Slack link did not answer ({e.__class__.__name__}) — no channel was asked for", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "seat":   # the daemon's word on who this process is — cc-notify's authority reading, never the caller's own claim
        try:
            r = sock_request({"sender": ""}, timeout=5)
        except Exception as e:
            # EXIT 2 IS "I COULD NOT ASK", AND IT IS NOT EXIT 1'S "the daemon says nobody owns this pid". cc-notify
            # reads a missing seat as the box's own hand and opens the owner's door to it (is_control), so a socket
            # that is down, refused or slow must answer differently from the daemon itself, or every caller is
            # control for as long as a restart lasts. Only where Slack is set up at all: with no token there is no
            # daemon to have a word, and that is a "none", the way it has always been on a box without Slack.
            if load_cfg().get("SLACK_BOT_TOKEN"):
                print(f"cc-slack seat: the daemon did not answer ({e.__class__.__name__}) — who is calling is unknown",
                      file=sys.stderr)
                return 2
            return 1
        if r.get("seat"):
            print(r["seat"]); return 0
        return 1
    elif cmd == "permission":   # second way a 🔐 prompt is answered (first: `yes <id>` in Slack); lets the -threads session unblock a member without the owner
        if len(rest) not in (2, 3) or rest[0].startswith("-") or (len(rest) == 3 and rest[2] != "fix"):
            print("cc-slack permission <request_id> yes|no [fix]   (fix: lasting only on a member's WebFetch/WebSearch card — ⚙️)", file=sys.stderr); return 2
        try:
            r = sock_request({"permission": rest[0], "answer": rest[1], "fix": len(rest) == 3}, timeout=60)
        except Exception as e:
            print(f"the Slack daemon did not answer ({e.__class__.__name__}) — nothing was answered", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "grant":   # a box session raising its own 🔐 grant card; the owner's `yes <id> fix` in Slack writes it (Daemon.relay_grant)
        why, window, args = "", "", []
        i = 0
        while i < len(rest):
            if rest[i] == "-t" and i + 1 < len(rest):
                why = rest[i + 1]; i += 2
            elif rest[i] == "-w" and i + 1 < len(rest):
                window = rest[i + 1]; i += 2
            else:
                args.append(rest[i]); i += 1
        if (len(args) != (3 if args[:1] == ["config"] else 2) or args[0] not in ("allow", "config", "unit", "confirm")
                or (args[0] == "confirm") != bool(window)):
            print("cc-slack grant allow '<Tool(pattern)>' [-t why]   |   cc-slack grant config KEY VALUE [-t why]"
                  "   |   cc-slack grant unit </abs/path/name.service|.timer> [-t why]"
                  "   |   cc-slack grant confirm '<command>' -w <window>", file=sys.stderr); return 2
        what = os.path.abspath(args[1]) if args[0] == "unit" else args[1]
        try:
            r = sock_request({"grant": args[0], "what": what, "why": why, "window": window,
                              "value": args[2] if args[0] == "config" else ""}, timeout=60)
        except Exception as e:
            print(f"the Slack daemon did not answer ({e.__class__.__name__}) — no card was raised", file=sys.stderr); return 1
        print(r.get("text") or "") if r.get("ok") else print(r.get("error") or "", file=sys.stderr)
        return 0 if r.get("ok") else 1
    elif cmd == "status":
        return cmd_status()
    elif cmd == "channels":
        return cmd_channels(rest)
    elif cmd == "track-thread":
        sys.exit(cmd_track_thread(sys.argv[2:]))
    elif cmd == "mkchannel":
        return cmd_mkchannel(rest)
    elif cmd == "retire":
        return cmd_retire(rest)
    elif cmd == "member":
        return cmd_member(rest)
    elif cmd == "members":
        return cmd_members()
    elif cmd == "workspace":
        return cmd_workspace(rest)
    elif cmd == "orch-channel":
        return cmd_orch_channel(rest)
    elif cmd == "archive":
        return cmd_archive(rest)
    elif cmd == "unarchive":
        return cmd_unarchive(rest)
    elif cmd == "engine":
        return cmd_engine(rest)
    elif cmd == "manifest":
        return cmd_manifest(rest)
    elif cmd == "selfcheck":
        return cmd_selfcheck()
    elif cmd == "setup":
        return cmd_setup(rest)
    elif cmd == "post":
        return cmd_post_file(rest) if "--file" in rest else cmd_post(rest)
    elif cmd == "sent":   # has this producer id been accepted by Slack? prints its ts, exit 0; else exit 1
        rec = sent_record(rest[0]) if rest else None
        if not rest:
            print("cc-slack sent: which id?", file=sys.stderr); return 2
        if rec and rec.get("accepted"):
            print(rec.get("ts") or ""); return 0
        return 1
    elif cmd == "live-id":   # the producer id of the one live ask about <subject> (live_id): cc-notify --live
        if not rest:
            print("cc-slack live-id: which subject?", file=sys.stderr); return 2
        print(live_id(rest[0])[0]); return 0
    elif cmd == "post-approval":
        return cmd_post_approval(rest)
    elif cmd == "run-approved":
        return cmd_run_approved(rest)
    elif cmd == "approvals-sweep":
        return cmd_approvals_sweep(rest)
    elif cmd == "accept-dialog":
        return cmd_accept_dialog(rest[0] if rest else "box")
    elif cmd == "history":
        return cmd_history(rest)
    elif cmd == "thread":
        return cmd_thread(rest)
    elif cmd == "edit":
        return cmd_edit(rest)
    elif cmd == "unsay":
        return cmd_unsay(rest)
    elif cmd == "pin":
        return cmd_pin(rest)
    elif cmd == "unpin":
        return cmd_pin(rest, remove=True)
    elif cmd == "revisit":
        return cmd_revisit(rest)
    elif cmd == "canvas":
        return cmd_canvas(rest)
    else:
        print(__doc__.strip()); return 2
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) or 0)
