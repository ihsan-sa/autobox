CANVASES = "canvases.json"                                     # {"<chat>": {canvas_id, title, updated}}: the canvas WE keep for a channel (see canvas_of)
REVISIT = "revisit.json"                                       # {"<chat>:<root_ts>": {...}}: threads the owner 📌'd, until the 📌 comes off
ASK_TIMEOUT = 150                  # cc-ask's own cap is CC_ASK_TIMEOUT (120 s); this is the daemon's patience past it
ASK_CONTEXT = 8                    # the most thread messages a follow-up carries to cc-ask as context
PR_RE = re.compile(r"^\[([a-z0-9_-]+)\] PR #([0-9]+):")
# The card in #approvals ("❓ <@owner> 🔐 *Approval needed:* [repo] PR #n …"): cc-land posts one itself for
# a head held under a protected path, and the owner's own 👍 on THAT card is what queues the head (on_approval) — the
# routine PR card of a self-landing repo lives in the log lane now, where only HIS 👍 on the card itself counts
# (owner_card_thumb) — and there it RE-QUEUES a stopped landing and approves nothing, so this card stays the
# only one an authorization can be read off.
APPROVAL_RE = re.compile(r"🔐 \*Approval needed:\* \[([a-z0-9_-]+)\] PR #([0-9]+)\b")
RETURN_RE = re.compile(r"^(?:<#[A-Z0-9]+(?:\|[^>]*)?>\s+)?\[return\] (\S+):")   # cc-model's card (its card_text): a 👍 on it runs `cc-model return <window>`
QUEUE_TTL = 4 * 3600                                                # a message queued for a session that never came up is dropped (and the owner told) after 15 min
