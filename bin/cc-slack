MENTION_RE = re.compile(r"(^|[\s(\[])@([A-Za-z0-9][A-Za-z0-9._-]*)")   # only at a word boundary: a@b.com / foo@bar / .../@x are not mentions
PERM_OPEN, PERM_WINDOW = 5, 300                              # 🔐 prompts one target may have open in this window — more is a loop, not a question
