#!/usr/bin/env bash
# cc-notify — the one door a request or a notice leaves a session by. Always logs to ~/.cc/notify.log.
#   cc-notify [-t title] [--heading <text>] [--kind <kind>] [--ask|--decision|--approval|--owner] [--id <id>] [--from <seat>]
#                                                                                      [-p …] "message"   (or message on stdin)
#     --ask       A PLANNER REQUEST: what a session cannot settle itself (a block, a refusal, a fault, a member's
#                 escalation). Written to ~/.cc/requests/<id>.json and handed to the control repo's planning seat
#                 through cc-broker — durable, retried every 60 s, and never a Slack post. Prints the request id.
#                 --from names the asker when the caller relays for one (the daemon, for a member socket); a caller
#                 that is not control cannot choose it — its marker or its seat is the name.
#     --decision  A CHOICE ONLY THE OWNER CAN MAKE: #<repo>, `❓ @owner *Decision needed:* <one question>`.
#     --approval  AN AUTHORIZATION (a protected path, a restart, spend beyond authority): #approvals,
#                 `❓ @owner 🔐 *Approval needed:* <action and consequence>`. One live card per --id.
#     --run '<cmd>'  with --approval only: the card carries the exact command and a `run:<sha>` stamp, and the command
#                 is stored on the host beside it (~/.cc/approvals/run/<card ts>.json, 0600). The owner's own 👍 on that
#                 card runs it once, as the box's user: the exit code comes back in the card's thread, the output in his DM
#                 (`cc-slack run-approved`). Refused, with nothing posted, anywhere a --approval card cannot be made:
#                 a caller that is not the control seat, a member workspace, or a box with no bot token.
#     --owner     the owner's DM. Same authority as --decision.
#     --heading   the bold line a person sees in place of the title. The title still routes, dedups and names the kind.
#     AUTHORITY: only the CONTROL SEAT reaches the owner — the control repo's planning session, or the box's own hand
#                 (a unit, the operator's shell). From a worker, a member session, an orch or another repo's seat, a
#                 RUNG 1 KIND — however it was picked: the flag, `--kind decision`, or a title whose second word is
#                 one — is a --ask instead, and one stderr line says so: a flag, a prefix or a payload is not
#                 authority (is_control below). The seat that gets the request decides, and only it escalates what
#                 it verified it cannot settle.
#     --id names the EVENT (land:<repo>:<pr>:<outcome>, credential:<member>, …): cc-slack's ledger sends it once, ever —
#     a replay of an id Slack already accepted is logged `dedup` and reaches no door, phone included (rec 4, 2026-09-08);
#     a request under an id that is already on file and still open is the same request, not a second one; once
#     answered, the same id asked again is a new request (the answered file moves to ~/.cc/requests/closed/).
#   cc-notify requests [--retry]           the requests still open (the broker's untaken ones marked) / hand the untaken to it again
#   cc-notify requests answer <id> "text"  CLOSE a request: post the answer once where it came from (a track's thread,
#                 a workspace's channel; under --id answer:<id>@<asked-at>, so a retry never posts twice), then mark the file
#                 answered (answered_at, by) so it is no longer listed. Control seat or its own requests seat
#                 (<box>@requests — the peer session that owns the 🙋 queue) only; no other seat. An unknown or
#                 already answered id exits 1 and posts nothing; a request whose asker left no seat is closed with no post.
#   cc-notify report [today|yesterday|YYYY-MM-DD]   how much was sent to the owner that day, at which rungs
#   cc-notify setup        create the ntfy topic + show the phone subscription steps
#   cc-notify test         send a test push
#   cc-notify selfcheck    unit checks (own HOME, own log, no network beyond a closed local port)
#   cc-notify -h | --help   this block, wherever it sits among the arguments — no post, no push, no log line
# THE ROUTES, in one line each (core/docs/comms-contract.md is the contract this implements):
#   planner request  --ask        ~/.cc/requests + cc-broker inject <control repo>      never Slack, never dropped
#   owner choice     --decision   #<repo>   ❓ @owner *Decision needed:* …               control seat only
#   authorization    --approval   #approvals ❓ @owner 🔐 *Approval needed:* …           control seat only
#   work reply       (the session's own reply tool / cc-slack post --thread)             not this script
#   machine log      a plain call: the table below, #<repo>-updates or #alerts           ambient
# HOW IT MUST READ. He sees a title and a line or two on a phone, so the point goes FIRST and in bold, and anything
# that does not change what he does next is cut rather than moved lower down (his own words, three times over: "just
# cut it out"). This script cannot judge prose, and a filter that truncated what a session wrote would be worse than
# the length — so a message longer than a phone shows gets one line back on stderr and is sent exactly as written.
# That line lands in the context of the session that wrote it, which is the only place it can change the next one.
# Exit: 0 if at least one configured channel took the message (or none is configured — the log is the channel),
#   1 only if every configured channel failed, so callers (cc-boot-notify) can retry on status instead of on text.
#
# THE TABLE — ONE PLACE DECIDES HOW LOUDLY A THING REACHES THE OWNER (owner, 2026-09-07: "i get pinged on things
# that don't really matter … but then i miss the important threads"). 51 phone pushes in 24 h, about 5 of which
# warranted him. The push channel was INVERTED: this script pushed to ntfy on every call that had a topic, above all
# routing, and the rung only changed the Priority header — so rung 5 always rang and rungs 2 and 3 never did. So the
# caller now says only WHAT happened — its `--kind`, or the second word of its title — and this table says how loud
# that is. Same shape as cc-broker's rules: a whitelist a person can read, and anything not in it is ambient.
#   RUNG   is ~/COMMS.md's ladder, and it decides the destination:
#          1 = the main channel, opening with ❓ and a real @-mention (a decision ask), or the owner's DM ("you, now"),
#              or #approvals for an --approval — reachable from the control seat alone (see AUTHORITY above)
#          4 = #alerts ("notable, nothing to do")            5 = the #<repo>-updates lane ("ambient")
#          P = a planner request (--ask): not a Slack rung at all — the broker, and the request file
#          (rungs 2, 3 and 6 belong to tools of their own: the session's `reply`, an approvals card, the digest.)
#   PHONE  is the ntfy push, and what rings it is --decision, a member escalation, and `cc-notify test` itself. What
#          every other rung means is that it can wait for him to open Slack — SO LONG AS THERE IS A SLACK: on a box
#          with none configured the push is the only door and carries every rung, at the table's prio (see "WHICH
#          DOORS ARE OPEN" below). A track that finished (24 of those 51), a
#          landing that stopped (11), a publish that is blocked (6), the secretary, the digest: none of them ring.
#          A worker's "needs you" does not either — the board row goes `waiting`, which IS his NEEDS YOU list.
#   WINDOW is the dedup, in seconds. 0 = never deduped (each one is its own event).
#   PRIO   is the ntfy priority and the 🚨 on the Slack post. The caller's -p is accepted and no longer obeyed:
#          a siren the reader learns to ignore is worse than no siren.
declare -A RUNGS=(
  #             rung phone window prio     raised by
  [decision]="1 yes 1800  high"    # --decision: a choice only the owner can make, asked by the control seat in #<repo>
  [approval]="1 yes 1800  high"    # --approval: an authorization only he can give, asked by the control seat in #approvals
  [escalation]="1 yes 0   high"    # --owner from the control seat: the owner's DM. No window — a person typed it, and one
                                   #   who has to ask twice must be able to. (A member-facing session's --owner is a
                                   #   request to the planning seat now, not this row: the member cannot promote itself.)
  [notify-test]="1 yes 0  high"    # `cc-notify test`: the one call whose whole job is to prove the push works, so it is
                                   #   never deduped — someone runs it twice while getting the phone subscribed, and a
                                   #   second one that pushes nothing and exits 0 says the opposite of what it checked.
                                   #   NAMED so no title can reach it: kind_of reads a title's SECOND WORD, and a row
                                   #   called `test` would put "<repo>/<track> test suite red" on his phone at rung 1
  [cc-rc]="4 no 900       high"    # cc-rc: the box's own services did not come back
  [limit]="4 no 3600      default" # a Claude usage limit. Notable; the loop resumes itself
  [boot]="4 no 0          default" # cc-boot-notify. NO WINDOW: a boot message differs from the last one only in
                                   #   digits — times, seconds dark, the SSD count — and the key strips digits, so a
                                   #   600 s window made a power-flap reboot loop, the very thing it exists to
                                   #   report, one event. cc-boot-notify then stamps boot-announced for a notice
                                   #   nobody got. Each boot is its own event, as `done` and `digest` are
  [power]="4 no 600       default" # cc-vitals: a power event
  [alerts]="4 no 900      default" # cc-vitals: a watchdog flip (DNS away/back)
  [heartbeat]="4 no 3600  default"
  [audit]="4 no 3600      default" # cc-audit's nightly report is filed, not acted on
  [review]="4 no 3600     default"
  [secretary]="5 no 14400 low"     # it already paces itself at one page per 4 h window; this matches it, without the siren
  [digest]="5 no 0        low"     # the 11:00 digest: it IS rung 6, and it posts itself into the box's updates lane
  [board]="5 no 3600      low"     # cc-reconcile's board findings
  [done]="5 no 0          low"     # a track finished. Its PR is what needs him, and that is a card he taps
  [update]="5 no 86400    low"     # ANYTHING NOT NAMED ABOVE — a landing that stopped, a publish that is blocked, a
                                   #   round that is over, a worker that needs him. Ambient, and a new caller starts here.
                                   #   A DAY, not 15 min: an ambient line that says the same thing again is not news.
                                   #   cc-publish runs every 30 min and one blocked commit was announced 29 times in
                                   #   14 h under a 900 s window (docs/2026-09-12-owner-messages.md, shape 1)
)
# Config: ~/.cc/config  (NTFY_TOPIC=..., NTFY_SERVER=https://ntfy.sh, SLACK_WEBHOOK=https://hooks.slack.com/...;
#   with SLACK_BOT_TOKEN set (cc slack setup) the bot posts instead)
# ESCALATION — with --owner from the control seat: the bot DMs the OWNER instead of routing by title. Unpaired owner:
#   #alerts. From a member-facing session (cc-guard's `.cc/member-facing` marker, walked up from the cwd) the same call
#   is a planner request: the session dir's name — its channel's too — is the `from`, and the default title.
# NEVER PUSHED: anything naming a synthetic test repo (_cctest…, _selfcheck…) is logged and stops there.
# INSIDE A MEMBER BOUNDARY (CC_MEMBER_SANDBOX=1): none of the config below exists there, so the message goes out over the
#   workspace's own socket instead (`cc-slack escalate`) and the daemon hands it to the planning seat as a request. A failure exits 1.
#   The table is not applied in there — the daemon re-enters THIS script with --ask on the outside, where it is — so
#   nothing but the TITLE and the WORDS crosses that boundary, and what they buy is a request to the planning seat —
#   except a plain call titled `<h>/<track> <kind>` (a loop's end line, a worker's deliverable), which crosses as a
#   notice (`escalate --notice`) and is re-entered plain: the track's thread and one line to the seat. The caller's `-p` used to, and it was the last place a
#   caller's own loudness travelled anywhere: it arrived at a call the table overwrites, so it decided nothing and
#   read as though it did.
# Env: CC_NOTIFY_LOG_ONLY (log, never push) · CC_NOTIFY_LOG (test hook: write the log somewhere else, so a run counts
#   its own lines instead of the owner's; the dedup state lives beside it, so a run dedups against itself alone).
set -uo pipefail
# -h/--help ANYWHERE stops here, before a single thing below runs: 09-13 and 09-15 a seat ran `cc-notify --help`
# to find the usage and the flag-parsing loop below fell through to `*) break`, making the literal word "--help"
# the MESSAGE — logged and posted into the owner's updates lane. Checked before `--`, which still ends flag
# parsing for a relayed message (a member's own words, or `--kind` typed as text, line 337's case): a caller that
# wants "--help" delivered as a real message says so with `--`, same as it would for any other flag-looking word.
for __a in "$@"; do case "$__a" in --) break;; -h|--help) sed -n '2,10p' "$0"; exit 0;; esac; done
BIN="$(dirname "$(realpath "$0")")"
LOG="${CC_NOTIFY_LOG:-$HOME/.cc/notify.log}"; mkdir -p "$HOME/.cc" "$(dirname "$LOG")"   # CC_NOTIFY_LOG: tests give each run its own log instead of counting lines in the owner's
SEEN="$(dirname "$LOG")/notify-seen"          # one file per dedup key, its mtime = when that event last went out
# Every key through cc-config: one precedence rule (the environment wins), and the file is READ, never sourced —
# it holds the box's Slack tokens, and `. ~/.cc/config` handed every one of them to the curl and cc-slack below.
cfg(){ "$BIN/cc-config" get "$1"; }
# THE CONTROL REPO: the one this copy lives in under ~/dev, the same rule cc-slack's CTL follows; elsewhere (a
# worktree, a fixture) the box's name. Its planning seat is where a request goes and the one seat that may ask him.
SELF="$(realpath "$0")"; CTL=""
case "$SELF" in "$HOME/dev/"*) CTL=${SELF#"$HOME/dev/"}; CTL=${CTL%%/*};; esac
REQ="$HOME/.cc/requests"           # one JSON file per planner request: id, from, title, text, delivered, attempts

# WHO MAY REACH THE OWNER (the brief, 2026-09-20: "only the control/planning session can escalate to the owner …
# a --decision, needs_owner, prefix or member payload is not authority"). Three readings, none of them the caller's
# word: the boundary (CC_MEMBER_SANDBOX), cc-guard's own walk (CC_ROLE, then the `.cc/track` / `.cc/member-facing`
# marker above the cwd — the marker is the truth), then the daemon's word on which live seat owns this pid (`cc-slack
# seat`: socket and subscription, never the payload). A seat that is not the control repo's own — a track, an orch,
# a member, another repo's planning session — is not control. No seat and no marker is the box's own hand (a systemd
# unit, the operator's shell), which is — but only where the daemon ANSWERED "none": a daemon that could not be
# reached says nothing about who is calling, and that reading fails closed (exit 2 below). `from_seat` is left
# naming the asker for the request record.
from_seat=""
is_control(){
  [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && return 1
  case "${CC_ROLE:-}" in worker|member) return 1;; esac
  local d="$PWD"
  while [ -n "$d" ] && [ "$d" != / ]; do
    if [ -f "$d/.cc/track" ]; then from_seat="$(sed -n '1p' "$d/.cc/track")/$(sed -n '2p' "$d/.cc/track")"; return 1; fi
    [ -f "$d/.cc/member-facing" ] && { from_seat=${d##*/}; return 1; }
    d=${d%/*}
  done
  local out rc
  out=$("$HOME/bin/cc-slack" seat 2>/dev/null); rc=$?
  from_seat=${out%%$'\n'*}
  # EXIT 2 IS NOT "NO SEAT". `cc-slack seat` exits 1 when the daemon itself says no seat owns this pid — the box's
  # own hand, which is control — and 2 when it could not be asked at all (socket down, a restart, a timeout). Only
  # the first is an answer. An unidentified caller must not inherit the owner's door for as long as a daemon
  # restart lasts, so this fails closed: not control, and the call is filed as a request instead, kept and retried.
  [ "$rc" = 2 ] && { from_seat=""; return 1; }
  [ -z "$from_seat" ] && return 0
  [ "$from_seat" = "${CTL:-$BOX}" ] && { from_seat=""; return 0; }
  return 1
}

# A PLANNER REQUEST. Written down first (the file is the request; the broker is its transport), then handed to
# cc-broker for the control repo's seat — which holds it in pending.json and retries every 60 s, so "queued" here
# is "preserved", never "handled". A broker that cannot even take it leaves delivered=false, and `cc-notify requests
# --retry` (cc-reconcile's tick, or a hand) offers it again. Nothing here posts to Slack and nothing reaches the
# owner: the seat that reads it decides, and escalates what it verified it cannot settle.
req_line(){   # the one message the seat gets: who, what, and how to answer them — decide it, or escalate it yourself
  local id=$1 from=$2 title=$3 text=$4 how
  case "$from" in
    # A TRACK IS ANSWERED IN ITS BRIEF, not by typing at it: most of these requests come from a headless worker
    # (cc-loop's stop, the --ask line in its prompt), and `--say` needs a live interactive pane. cc-loop's own
    # words for the way back, so the seat is told one path that works whether the loop is still up or stopped.
    */*) how="append the answer to ~/.cc/state/${from%%/*}/${from#*/}/task.md, drop the STATUS line from progress.md, then \`cc ${from%%/*} ${from#*/} --go \"\"\` (--say only reaches a live interactive session)";;
    "")  how="the asker left no seat: answer on the board or in its thread";;
    *)   how="cc-slack post -c '#$from' \"…\" (it wakes that session)";;
  esac
  printf '🙋 request %s from %s: %s — %s\n(answer: %s · decide it, or if only the owner can, ask him yourself: cc-notify --decision / --approval · still untaken on file: cc-notify requests)' \
    "$id" "${from:-?}" "$title" "$text" "$how"
}
req_write(){   # $1 id $2 from $3 title $4 text $5 delivered(true|false) $6 attempts $7 why
  mkdir -p "$REQ"
  jq -n --arg id "$1" --arg from "$2" --arg title "$3" --arg text "$4" --argjson d "$5" --argjson n "$6" --arg why "$7" \
     --arg at "$(date -u +%FT%TZ)" --arg to "${CTL:-$BOX}" \
     '{id:$id, at:$at, from:$from, to:$to, title:$title, text:$text, delivered:$d, attempts:$n, why:$why}' > "$REQ/$1.json.tmp" \
   && mv "$REQ/$1.json.tmp" "$REQ/$1.json"
}
req_send(){   # $1 id — hand the record's line to the broker; sets delivered on success. Returns the broker's status.
  local f="$REQ/$1.json" from title text n rc
  from=$(jq -r .from "$f"); title=$(jq -r .title "$f"); text=$(jq -r .text "$f"); n=$(jq -r .attempts "$f")
  if "$HOME/bin/cc-broker" inject --source request "${CTL:-$BOX}" "$(req_line "$1" "$from" "$title" "$text")" >/dev/null 2>&1; then rc=0; else rc=1; fi
  jq --argjson d "$([ $rc = 0 ] && echo true || echo false)" --argjson n "$((n + 1))" '.delivered=$d | .attempts=$n' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  return $rc
}
requests(){   # `cc-notify requests [--retry]`: what is still open; --retry hands each untaken one to the broker again
  local f id d n
  [ "${1:-}" = answer ] && { shift; req_answer "$@"; return $?; }
  [ -d "$REQ" ] || { echo "no requests on file"; return 0; }
  for f in "$REQ"/*.json; do
    [ -f "$f" ] || continue
    [ -n "$(jq -r '.answered_at // ""' "$f")" ] && continue   # answered is closed: nothing left to do for it
    id=$(jq -r .id "$f"); d=$(jq -r .delivered "$f"); n=$(jq -r .attempts "$f")
    if [ "${1:-}" = --retry ]; then
      [ "$d" = true ] && continue
      if req_send "$id"; then echo "$id: handed to the broker on try $((n + 1))"; else echo "$id: the broker did not take it (try $((n + 1))) — still on file"; fi
    else echo "$id  from $(jq -r .from "$f")  tries $n  $([ "$d" = true ] || echo 'UNTAKEN  ')$(jq -r .title "$f")"; fi
  done
  return 0
}
# THE CLOSING VERB. A request was written, handed over and then left open forever: nothing marked it answered, so the
# file said the same thing a day later as the minute it was made. The answer goes back ONCE the way req_line names
# (a track's own thread by its title, a workspace's channel), under a producer id so a retry after a failed write
# never posts twice, and only then is the file closed. A post that fails leaves it open for the retry.
req_answer(){   # $1 id  $2 text
  local id=${1:-} text=${2:-} f from ts by pid
  [ -n "$id" ] && [ -n "$text" ] || { echo 'usage: cc-notify requests answer <id> "text"' >&2; return 2; }
  id=$(printf '%s' "$id" | tr -c 'A-Za-z0-9._:@-' '_'); f="$REQ/$id.json"
  [ -f "$f" ] || { echo "cc-notify: no request $id on file — nothing posted" >&2; return 1; }
  [ -z "$(jq -r '.answered_at // ""' "$f")" ] || { echo "cc-notify: request $id was already answered ($(jq -r .answered_at "$f")) — nothing posted" >&2; return 1; }
  # THE QUEUE'S OWN SEAT ANSWERS TOO. `<box>@requests` is the peer session set up to own the 🙋 queue (an orch
  # alias, never a claim in the payload): `is_control` names it in `from_seat` and refuses it like any other
  # non-control seat, so it is let back in here by that exact name — and by nothing looser, so no other seat's
  # name ever matches this line.
  if ! is_control; then
    [ "$from_seat" = "${CTL:-$BOX}@requests" ] \
      || { echo "cc-notify: only ${CTL:-$BOX}'s planning seat or its requests seat answers a request (this is ${from_seat:-an unidentified caller}) — nothing posted" >&2; return 1; }
  fi
  from=$(jq -r '.from // ""' "$f"); ts=""
  pid="answer:$id@$(jq -r '.at // ""' "$f")"   # the ask's own stamp: the same id asked again after an answer is a new ask, not a ledger dedup
  case "$from" in
    "")  echo "cc-notify: $id names no asker, so the answer has nowhere to go — closed without a post" >&2 ;;
    */*) ts=$("$HOME/bin/cc-slack" post --route "$from answer" --id "$pid" "$text" 2>/dev/null) \
           || { echo "cc-notify: the answer to $id did not post — the request stays open" >&2; return 1; } ;;
    *)   ts=$("$HOME/bin/cc-slack" post -c "#$from" --id "$pid" "$text" 2>/dev/null) \
           || { echo "cc-notify: the answer to $id did not post — the request stays open" >&2; return 1; } ;;
  esac
  by="${CC_SLACK_ALIAS:+${CTL:-$BOX}@$CC_SLACK_ALIAS}"; by="${by:-${CTL:-$BOX}}"
  jq --arg at "$(date -u +%FT%TZ)" --arg by "$by" --arg a "$text" --arg ts "$ts" \
     '.answered_at=$at | .by=$by | .answer=$a | .answer_ts=$ts' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
  printf '%s\tanswer %s\t%s\trung=P kind=request send=%s\n' "$(date -u +%FT%TZ)" "$id" "$(printf '%s' "$text" | tr '\n\t' '  ')" "$([ -n "$from" ] && echo slack || echo none)" >> "$LOG"
  echo "$id: answered${from:+ in $from}"
}

# THE ONE PLACE A TITLE BECOMES A KIND. A caller's own `--kind` wins; otherwise the second word of the title — the
# "<box> boot" / "<repo> board" / "<repo>/<track> done" shape every caller already writes — is looked up in the
# table above. Nothing else is guessed: an unrecognised event is ambient, and a caller that wants more says so.
kind_of(){
  local k=$1 t=$2 w
  # `*` AND `@` NEVER BECOME A KIND. As an array subscript each is the whole-array expansion — `${RUNGS[*]}` is
  # every row of the table concatenated — and a lookup that took that branch would hand `read` the first row bash
  # hashed rather than the row asked for, which can be `1 yes … high`: a push and an @-mention of the owner, bought
  # by a title whose second word is a star. MEASURED, 2026-09-07, bash 5.3.9: that expansion needs a LITERAL `*`
  # in the source, and a subscript that merely expands to one is an ordinary missing key here, so the lookups below
  # are already safe on this shell. They are not safe BY CONSTRUCTION, and this tree is published and runs on bash
  # versions this box does not have. Two lines make it impossible rather than merely improbable; the selfcheck
  # below asserts the property (an unknown second word is ambient) rather than this shell's version of the bug.
  case "$k" in '*'|'@') k="";; esac
  if [ -n "$k" ]; then [ -n "${RUNGS[$k]+x}" ] && { printf '%s' "$k"; return; }; fi
  w=$(printf '%s\n' "$t" | awk '{print tolower($2)}')
  case "$w" in '*'|'@') w="";; esac
  [ -n "$w" ] && [ -n "${RUNGS[$w]+x}" ] && { printf '%s' "$w"; return; }
  printf 'update'
}

# WHAT THE EVENT IS ABOUT: the repo the title leads with (its track too, when the title is "<repo>/<track> …"), plus
# the PR number if it names one. Half of the dedup key — so "[r] PR #7 merged" and "[r] PR #8 merged" are two events,
# while two runs of the same stuck publish are one.
scope_of(){
  local t pr
  t=$(printf '%s' "$1" | tr -d '[]')
  pr=$(printf '%s\n' "$t" | grep -oE '#[0-9]+' | head -1)
  printf '%s%s' "$(printf '%s\n' "$t" | awk '{print tolower($1)}')" "$pr"
}

# how much was sent to the owner on one day, and at which rungs — the question the log exists to answer.
report(){
  local day=${1:-yesterday}
  case "$day" in today) day=$(date -u +%F);; yesterday) day=$(date -u -d yesterday +%F);; esac
  [ -s "$LOG" ] || { echo "$day — nothing in $LOG"; return 0; }
  awk -F'\t' -v d="$day" '
    index($1, d) != 1 { next }
    { rung="?"; kind="?"; send="?"
      if (match($NF, /rung=[^ ]+/))  rung = substr($NF, RSTART+5,  RLENGTH-5)
      if (match($NF, /kind=[^ ]+/))  kind = substr($NF, RSTART+5,  RLENGTH-5)
      if (match($NF, /send=[^ ]+/))  send = substr($NF, RSTART+5,  RLENGTH-5)
      if (rung == "P") { req++; next }     # a planner request never reached him: counted apart, below
      total++
      # a line older than this table went out too — it just never said at which rung: rung "?", not "not sent"
      # send is now the DOORS THAT TOOK IT — ntfy, slack, ntfy+slack, ntfy-fallback, socket — so this matches a
      # door rather than a fixed list of labels; "?" is a line older than this table: it went out, unsaid how.
      if (send ~ /ntfy|slack|socket/ || send == "?") { sent++; byrung[rung]++; kinds[rung " " kind]++ }
      else notsent[send]++
      if (send ~ /ntfy/) phone++ }
    END {
      printf "%s — %d notice(s) logged, %d sent to the owner, %d rang his phone, %d request(s) to the planning seat\n", d, total+0, sent+0, phone+0, req+0
      n = split("1 4 5 ?", order, " ")
      for (i = 1; i <= n; i++) { r = order[i]; if (!(r in byrung)) continue
        line = ""; for (k in kinds) { split(k, p, " "); if (p[1] == r) line = line (line ? " · " : "") p[2] " " kinds[k] }
        printf "  rung %-2s %4d   %s\n", r, byrung[r], (r == "?" ? "logged before this table existed" : line) }
      for (s in notsent) printf "  %-9s %4d   not sent\n", s, notsent[s] }' "$LOG"
}

# ── selfcheck ────────────────────────────────────────────────────────────────────────────────────────────
# Its own HOME, its own log and its own dedup state under a temp dir: no channel of this box's is posted to and
# nothing of the owner's is read. THE NTFY SERVER IS A REAL ONE, on 127.0.0.1 and a port the kernel picks, which
# records every request and answers 200 — so "did the phone ring" is answered by a request that arrived, and "which
# door took it" by a push that really succeeded, which is what the log is now written from. `deadntfy` points the
# same config at a port nothing listens on when a FAILING push is the thing under test. The assertion is the wire,
# never a flag we set ourselves, and nothing leaves this machine.
selfcheck(){
  local n=0 f=0 rc=0 T NH log out
  T=$(mktemp -d); NH="$T/h"; log="$NH/.cc/notify.log"; mkdir -p "$NH/bin" "$NH/.cc"
  # the cc-slack this fixture hands cc-notify: `slackstub 0` takes the message, `slackstub 1` refuses it the way an
  # expired token or a channel that is gone does. A channel that FAILS is half of what this script promises.
  slackstub(){ printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\nexit %s\n' "$T/slack.args" "$1" > "$NH/bin/cc-slack"
               chmod +x "$NH/bin/cc-slack"; }
  slackstub 0
  # THE NTFY THE FIXTURE PUSHES TO: 200 to anything, and one line per request so a case can assert the push arrived
  # AND at which priority. Ephemeral port, localhost only, killed at the end of this function.
  python3 - "$T" <<'PY' >/dev/null 2>&1 &
import http.server, socketserver, sys, os
d = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0))
        with open(os.path.join(d, "ntfy.reqs"), "a") as fh:
            fh.write("%s\tPriority=%s\tTitle=%s\t%s\n" % (self.path, self.headers.get("Priority"),
                     self.headers.get("Title"), body.decode("utf-8", "replace").replace("\n", " ")))
        self.send_response(200); self.end_headers(); self.wfile.write(b"ok")
    def log_message(self, *a): pass
socketserver.TCPServer.allow_reuse_address = True
with socketserver.TCPServer(("127.0.0.1", 0), H) as srv:
    with open(os.path.join(d, "ntfy.port"), "w") as fh: fh.write(str(srv.server_address[1]))
    srv.serve_forever()
PY
  local ntfypid=$!
  for _ in $(seq 1 100); do [ -s "$T/ntfy.port" ] && break; sleep 0.1; done
  [ -s "$T/ntfy.port" ] || { echo "cc-notify selfcheck: the local ntfy listener never bound — cannot test the wire"; return 1; }
  # `cfg <ntfy-server> <slack yes|no>` — the two axes every case below turns: is there a phone, is there a Slack.
  cfg_(){ { echo CC_BOX=abox; echo NTFY_TOPIC=t; echo "NTFY_SERVER=$1"
            [ "$2" = yes ] && { echo SLACK_BOT_TOKEN=xoxb-test; echo SLACK_OWNER_ID=UOWNER; }; } > "$NH/.cc/config"; }
  local LIVE DEAD; LIVE="http://127.0.0.1:$(cat "$T/ntfy.port")"; DEAD="http://127.0.0.1:1"
  cfg_ "$LIVE" yes
  pushed(){ test -s "$T/ntfy.reqs"; }               # a request really reached the listener
  prio_(){ head -1 "$T/ntfy.reqs" | cut -f2 | cut -d= -f2; }   # the listener writes <path>TAB Priority=…TAB Title=…
  # -u for every config key: the environment WINS over the file (cc-config's one rule), so a key exported by
  # whatever session runs this would beat the fixture's own config.
  # NC <dir> … runs from <dir>: the marker walk reads the cwd, so a case about a worker or a member stands in one.
  # The broker the fixture hands cc-notify records its argv like the cc-slack stub; `brokerstub 1` refuses.
  brokerstub(){ printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\nexit %s\n' "$T/broker.args" "$1" > "$NH/bin/cc-broker"
                chmod +x "$NH/bin/cc-broker"; }
  brokerstub 0
  # a cc-slack whose `seat` answers with a name: the daemon's word on who owns the calling pid
  seatstub(){ printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\ncase "$1" in seat) echo "%s";; esac\nexit 0\n' "$T/slack.args" "$1" > "$NH/bin/cc-slack"
              chmod +x "$NH/bin/cc-slack"; }
  NC(){ local d=$1; shift; : > "$T/slack.args"; : > "$T/broker.args"; : > "$T/err"; : > "$T/ntfy.reqs"; : > "$T/out"
       ( cd "$d" && env -u CC_NOTIFY_LOG_ONLY -u CC_MEMBER_SANDBOX -u CC_ROLE -u SLACK_BOT_TOKEN -u SLACK_OWNER_ID \
             -u SLACK_WEBHOOK -u SLACK_ALERTS -u NTFY_TOPIC -u NTFY_SERVER -u CC_BOX \
             HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" "$@" >"$T/out" 2>"$T/err" ); }
  N(){ NC "$T" "$@"; }
  k(){ n=$((n + 1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else f=$((f + 1)); echo "  FAIL $2"; fi; }
  yes_(){ if "$@" >/dev/null 2>&1; then echo 0; else echo 1; fi; }
  no_(){ if "$@" >/dev/null 2>&1; then echo 1; else echo 0; fi; }
  last(){ tail -1 "$log"; }
  args(){ cat "$T/slack.args"; }
  bargs(){ cat "$T/broker.args"; }
  reqs(){ ls "$NH/.cc/requests" 2>/dev/null | wc -l; }
  reqf(){ jq -r "$1" "$NH/.cc/requests/$(cat "$T/out").json" 2>/dev/null; }   # a field of the request the last call printed

  # THE TABLE ITSELF. A row a person edited into four-and-a-half columns would otherwise be read as a rung of
  # whatever `read` happened to put there, silently, for every event of that kind.
  local bad="" kk rr pp ww qq extra
  for kk in "${!RUNGS[@]}"; do
    read -r rr pp ww qq extra <<<"${RUNGS[$kk]}"
    case "$rr" in 1|4|5) ;; *) bad="$bad $kk:rung";; esac
    case "$pp" in yes|no) ;; *) bad="$bad $kk:phone";; esac
    case "$ww" in ''|*[!0-9]*) bad="$bad $kk:window";; esac
    case "$qq" in low|default|high|urgent) ;; *) bad="$bad $kk:prio";; esac
    [ -z "$extra" ] || bad="$bad $kk:extra"
    [ "$pp" = no ] || [ "$rr" = 1 ] || bad="$bad $kk:rings-below-rung-1"
  done
  k "$(yes_ test -z "$bad")" "every row is rung(1|4|5) phone(yes|no) window(int) prio, and only rung 1 rings the phone —$bad"

  N -t "demorepo board" "a row is stale"
  k "$(yes_ grep -q 'rung=5 kind=board send=slack$' <<<"$(last)")" "an ambient event is rung 5 and the log says so"
  k "$(no_ pushed)" "…and it never reaches the phone: no request arrived at the ntfy the fixture is really running"
  k "$(yes_ grep -q -- '--route demorepo board' <<<"$(args)")" "…and it still routes by title, into that repo's -updates lane"

  N -t "demorepo board" "a row is stale"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "a repeat inside the kind's window is logged and NOT sent a second time"
  k "$(yes_ test ! -s "$T/slack.args")" "…and nothing at all went to Slack the second time"
  N -t "demorepo board" "a different row is stale"
  k "$(yes_ test -s "$T/slack.args")" "…while a different message of the same kind is its own event and goes out"

  # THE KEY IS THE EVENT, NOT THE WORDS. A caller whose reason quotes a line number signs itself differently every
  # run and defeats any hash of its message — 6 pages in a day for one cosmetic cause. Numbers come out of the key.
  N -t "[demorepo] publish blocked" "identity gate: 12:the commit message names this box"
  k "$(yes_ test -s "$T/slack.args")" "the first run of a stuck cause goes out"
  N -t "[demorepo] publish blocked" "identity gate: 47:the commit message names this box"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "…and the same cause quoting a line number that has SHIFTED is the same event, not a new one"
  # AN AMBIENT LINE HOLDS FOR A DAY. The stamp is aged by hand: an hour on, the same cause is still the same event
  # (a 900 s window let a 30-min timer announce one blocked commit 29 times); a day and more on, it is news again.
  N -t "[demorepo] deploy blocked" "identity gate: the tree names this box"
  find "$NH/.cc/notify-seen" -type f -exec touch -d "-3600 seconds" {} +
  N -t "[demorepo] deploy blocked" "identity gate: the tree names this box"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "an ambient cause repeated an HOUR later is still the same event — the update window is a day, not 15 min"
  find "$NH/.cc/notify-seen" -type f -exec touch -d "-90000 seconds" {} +
  N -t "[demorepo] deploy blocked" "identity gate: the tree names this box"
  k "$(yes_ test -s "$T/slack.args")" "…and a day and more later it goes out again: the window is bounded"
  # …but a number that IS the event lives in the scope, and two of those are two events.
  N -t "[demorepo] PR #7 merged" "landing stopped"
  N -t "[demorepo] PR #8 merged" "landing stopped"
  k "$(yes_ test -s "$T/slack.args")" "a different PR is a different event: the scope carries the number the prose drops"

  N --decision -t "demorepo blocked" "which database do I restore?"
  k "$(yes_ grep -q 'rung=1 kind=decision send=ntfy+slack$' <<<"$(last)")" "--decision is rung 1 and the log says the phone was rung"
  k "$(yes_ pushed)" "…and the push really arrived on the wire, not just claimed"
  k "$(yes_ test "$(prio_)" = high)" "…at the prio the TABLE gives a decision, which is what the phone reads as a buzz"
  k "$(yes_ grep -q -- '--mention' <<<"$(args)")" "…and it @-mentions the owner in the main channel"
  k "$(yes_ grep -q -- '--route demorepo blocked --mention \*Decision needed:\* which database do I restore?' <<<"$(args)")" "…as the contract's card: ❓ @owner *Decision needed:* <the one question> — the title routes it and is not the message"
  N --decision -t "demorepo blocked" "which database do I restore?"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "…and asking him the SAME question again inside the window does not ring him twice"
  N --decision -t "demorepo blocked" "should I drop the old branches?"
  k "$(yes_ test -s "$T/slack.args")" "…while a different question is a different decision and does reach him"

  # THE SYSTEM PROMPT IS A CALLER TOO, AND IT IS THE ONE THAT MATTERS MOST. Every track and planning session is
  # TOLD, in the prompt bin/cc builds for it, the one command to run when it is truly blocked. When the table moved
  # the rung-1 door to --decision, that sentence was left behind, so the box's whole blocked-escalation path — a
  # worker with nobody else to ask — filed itself in an updates lane. Two reviews found it, one at a time, and the
  # second time it had already been fixed once and lost again. So the command is TAKEN OUT OF sp_track/sp_main and
  # run here: retyped into this file it would stay green for ever after the next person edits the prompt, which is
  # exactly the regression. It runs on the change that breaks it, too: `cc` is two characters, which tests/green.sh
  # treats as too short to build a caller graph from, so a change to bin/cc widens the scope back to everything and
  # every selfcheck runs — this one with it.
  local spsrc cmd fn got spok=1; local -a argv
  spsrc=$(awk '/^(sp_(track|main)|ctl_repo|intake_sp)\(\)/{p=1} p{print} p && /; [}]$/{p=0}' "$BIN/cc" 2>/dev/null)
  # …WITH THE TWO HELPERS sp_main READS, because half of what it says is the control repo's alone: the intake and
  # the owner door are that seat's (req_send hands every request to it, is_control refuses the door to anybody
  # else), so bin/cc asks ctl_repo which repo this is and intake_sp writes the half that is true. Left out of the
  # eval, sp_main builds its prompt with two commands that do not exist and says nothing about a door at all.
  # Bounded before anything is evaluated: if these definitions ever stop ending in "; }" the awk above runs to the
  # end of bin/cc, and evaluating THAT would run the front door of the box instead of defining four functions.
  [ -n "$spsrc" ] && grep -q '^sp_main()' <<<"$spsrc" && [ "$(grep -c . <<<"$spsrc")" -le 24 ] && spok=0
  k "$spok" "bin/cc's prompt builders are read out of bin/cc, whole and alone — nothing below is a copy of their words"
  for fn in sp_track sp_main; do
    cmd=""
    # SELF is the one thing ctl_repo reads, the same file path this script's own CTL reads, so the fixture repo is
    # made the CONTROL repo here — the seat the two sp_main cases below are about, and the only one whose prompt
    # names an owner door at all (bin/cc's own selfcheck holds the other half: what every other repo is told).
    # shellcheck disable=SC2034  # STBASE is not unused: sp_track reads it, and shellcheck cannot see into the eval
    [ "$spok" = 0 ] && cmd=$( ( STBASE=/state; SELF="$HOME/dev/demorepo/core/bin/cc"; eval "$spsrc"
        case "$fn" in sp_track) sp_track demorepo atrack main;; *) sp_main demorepo main;; esac ) \
      | grep -oE "'cc-notify [^']+'" | head -1 | tr -d "'" )
    k "$(yes_ test -n "$cmd")" "$fn hands a blocked session one quoted cc-notify command to reach the owner with"
    # No command found is not a pass: the two cases below then run the ambient form and go red, rather than
    # asserting nothing at all.
    [ -n "$cmd" ] || cmd='cc-notify -t "demorepo blocked" "the prompt named no command"'
    # xargs, not eval: the prompt's own quoting is honoured and NOTHING in it is expanded or globbed a second time
    # — printf has already done that once, and a test that re-expands its input is a test that can run it.
    mapfile -t argv < <(printf '%s\n' "${cmd#cc-notify }" | xargs -n1 printf '%s\n')
    N "${argv[@]}"
    got=$(grep -oE 'rung=[0-9P?]+ kind=[a-z-]+' <<<"$(last)")   # say which rung it DID get: rung=5 kind=update is the regression, by name
    if [ "$fn" = sp_track ]; then
      # A WORKER'S BLOCKED LINE REACHES THE PLANNING SEAT, NOT THE OWNER (the brief: "worker blocks … go to the
      # planning session as intake"): its command is a request, over the broker, and rings no phone.
      k "$(yes_ grep -q 'rung=P kind=request send=broker' <<<"$(last)")" "…and run exactly as $fn writes it, that command is a PLANNER REQUEST — $cmd → ${got:-nothing logged}"
      k "$(no_ pushed)" "…which rings no phone: a worker's block is the seat's to settle first"
    else
      k "$(yes_ grep -q 'rung=1 ' <<<"$(last)")" "…and run exactly as $fn writes it, that command is RUNG 1 — $cmd → ${got:-nothing logged}"
      k "$(yes_ pushed)" "…and the push really arrives, so the seat told to escalate is not filing an ambient note"
    fi
  done

  N --owner "the disk is filling up"
  k "$(yes_ grep -q 'rung=1 kind=escalation send=ntfy+slack$' <<<"$(last)")" "an escalation is rung 1 and rings the phone"
  k "$(yes_ grep -q -- '-c UOWNER' <<<"$(args)")" "…as a DM, never the channel it came from"
  N --owner "the disk is filling up"
  k "$(yes_ test -s "$T/slack.args")" "…and it has NO window: a person who has to ask twice must be able to"

  # ── THE ROUTES OF THE CONTRACT (core/docs/comms-contract.md; the brief comms-requests-reach-who-decides) ──
  # AN AUTHORIZATION goes to #approvals as a 🔐 card, from the control seat, and rings the phone like a decision.
  N --approval -t "demorepo approval" "PR #7 touches core/bin/cc-slack: land it, which restarts the daemon"
  k "$(yes_ grep -q 'rung=1 kind=approval send=ntfy+slack$' <<<"$(last)")" "--approval is rung 1, its own kind, and rings the phone"
  k "$(yes_ grep -q -- '-c #approvals --mention 🔐 \*Approval needed:\* PR #7 touches' <<<"$(args)")" "…posted in #approvals as ❓ @owner 🔐 *Approval needed:* <action and consequence>"
  k "$(no_ grep -q -- '--route' <<<"$(args)")" "…and never routed by title into the main lane: an authorization is not a decision"

  # A CARD THAT CARRIES A COMMAND (--run): the command and its stamp are on the card, and the command is stored on the
  # host under the card's ts, 0600 in a 0700 dir — cc-slack run-approved reads it from there, never from Slack.
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\n[ "$1" = post ] && echo 1790000000.000100\nexit 0\n' "$T/slack.args" > "$NH/bin/cc-slack"
  chmod +x "$NH/bin/cc-slack"; rm -rf "$NH/.cc/approvals"
  runcmd='systemctl --user restart cc-land-lane@a.service && echo "done > ok"'
  runsha=$(printf '%s' "$runcmd" | sha256sum | cut -c1-64)
  N --approval --run "$runcmd" -t "demorepo approval" "restart the landing lane, which drops its queue"
  rrec="$NH/.cc/approvals/run/1790000000.000100.json"
  k "$(yes_ grep -qF -- "restart cc-land-lane@a.service &amp;&amp; echo \"done &gt; ok\"" <<<"$(args)")" "--run: the card shows the exact command, &<> escaped so Slack cannot read it as a link"
  k "$(yes_ grep -qF -- "\`run:${runsha:0:16}\`" <<<"$(args)")" "…and carries the run:<sha256> stamp run-approved checks the card by"
  k "$(yes_ test "$(jq -r .cmd "$rrec" 2>/dev/null)" = "$runcmd")" "…and the command is stored on the host under the card's ts, as written (unescaped)"
  k "$(yes_ test "$(jq -r .sha256 "$rrec" 2>/dev/null)" = "$runsha")" "…with its sha256"
  k "$(yes_ test "$(stat -c %a "$rrec" 2>/dev/null)/$(stat -c %a "${rrec%/*}" 2>/dev/null)" = 600/700)" "…in a file only this user reads (0600, dir 0700)"
  echo '{"cmd":"kept"}' > "$rrec"
  N --approval --run "echo other" -t "demorepo approval" "a second card the stub gives the same ts"
  k "$(yes_ test "$(jq -r .cmd "$rrec")" = kept)" "…and a record already on file for that ts is never rewritten"
  mkdir -p "$T/rwt/.cc"; printf 'demorepo\nrtrack\nsid\n' > "$T/rwt/.cc/track"; rm -rf "$NH/.cc/approvals"
  NC "$T/rwt" --approval --run "echo from a worker" -t "demorepo approval" "may a worker's card run this?"
  k "$(yes_ test "$(no_ test -s "$T/slack.args")$(no_ test -e "$NH/.cc/approvals/run")$(grep -c 'nothing posted' "$T/err")" = 001)" "--run from a worker is refused whole: nothing posted, no record, one stderr line"
  N --decision --run "echo on a decision" -t "demorepo blocked" "does a decision card run this?"
  k "$(yes_ test "$(no_ grep -q "^post" "$T/slack.args")$(no_ test -e "$NH/.cc/approvals/run")" = 00)" "--run on anything but --approval is refused, nothing posted"
  : > "$T/slack.args"
  ( cd "$T" && env -u CC_NOTIFY_LOG_ONLY -u CC_ROLE CC_MEMBER_SANDBOX=1 HOME="$NH" CC_NOTIFY_LOG="$log" \
      "$BIN/cc-notify" --approval --run "echo from a workspace" "may a workspace's card run this?" >/dev/null 2>"$T/err" ); rc=$?
  k "$(yes_ test "$rc/$(no_ test -s "$T/slack.args")" = 2/0)" "--run inside a member workspace is refused (exit 2), and nothing crosses its socket"
  # A CARD THAT SHOWS ONE COMMAND AND RUNS ANOTHER (security read): an open fence in the description, or a character
  # that hides or reorders the command, is refused whole — no post, no record.
  rm -rf "$NH/.cc/approvals"
  N --approval --run "echo real" -t "demorepo approval" 'restart it. ```echo harmless'
  k "$(yes_ test "$(no_ grep -q "^post" "$T/slack.args")$(no_ test -e "$NH/.cc/approvals/run")$(grep -c 'three backticks anywhere' "$T/err")" = 001)" "--run: three backticks in the DESCRIPTION are refused too, nothing posted, no record"
  for bad in "RLO:"$'echo a\xe2\x80\xaeb' "LRI:"$'echo a\xe2\x81\xa6b' "ZWSP:"$'echo a\xe2\x80\x8bb' "BOM:"$'echo a\xef\xbb\xbfb' "CR:"$'echo a\rb' "ESC:"$'echo a\x1b[2Kb' \
             "RLM:"$'echo a\xe2\x80\x8fb' "LSEP:"$'echo a\xe2\x80\xa8b' "TAG:"$'echo a\xf3\xa0\x80\x81b'; do
    N --approval --run "${bad#*:}" -t "demorepo approval" "restart it"
    k "$(yes_ test "$(no_ grep -q "^post" "$T/slack.args")$(no_ test -e "$NH/.cc/approvals/run")$(grep -c 'control, bidi or zero-width' "$T/err")" = 001)" "--run holding a ${bad%%:*} character is refused, nothing posted, no record"
  done
  N --approval --run "echo plain" -t "demorepo approval" $'restart it\xe2\x80\xae ti trats'
  k "$(yes_ test "$(no_ grep -q "^post" "$T/slack.args")$(no_ test -e "$NH/.cc/approvals/run")$(grep -c 'control, bidi or zero-width' "$T/err")" = 001)" "--run: an RLO in the DESCRIPTION is refused too (run-approved would refuse the card), nothing posted, no record"
  N --approval --run $'echo a\tb\necho done' -t "demorepo approval" "a tab and a newline are plain"
  k "$(yes_ grep -q "^post" "$T/slack.args")" "…while a command with a tab and a newline in it still makes its card"
  slackstub 0

  # A PLANNER REQUEST: on file, then over the broker to the control repo's seat; no Slack, no phone.
  rm -rf "$NH/.cc/requests"       # the sp_track case above already filed one; these count their own
  N --ask -t "demorepo blocked" "the image script is missing; may I rebuild it from the notes?"
  k "$(yes_ grep -q 'rung=P kind=request send=broker$' <<<"$(last)")" "--ask is a planner request: rung P, and the log says the broker took it"
  k "$(yes_ grep -q -- '^inject --source request abox 🙋 request req-.* the image script is missing' <<<"$(bargs)")" "…handed to cc-broker for the control repo's seat, as one line naming the asker and the ask"
  k "$(yes_ test "$(reqs)" = 1)" "…and written to ~/.cc/requests first: the file is the request, the broker its transport"
  k "$(yes_ test "$(reqf .delivered)" = true)" "…marked delivered once the broker took it"
  k "$(yes_ grep -q '^req-' "$T/out")" "…and its id is printed, for the caller to quote"
  k "$(no_ grep -q -- '^post' <<<"$(args)")" "…nothing posted to Slack"
  k "$(no_ pushed)" "…and no phone: a request is the seat's, and only the seat escalates"
  N --ask -t "demorepo blocked" "the image script is missing; may I rebuild it from the notes?"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "the same request inside the window is not asked twice"
  k "$(yes_ test "$(reqs)" = 1)" "…and leaves no second file"
  N --ask --id block:demorepo:atrack -t "demorepo blocked" "which port?"
  N --ask --id block:demorepo:atrack -t "demorepo blocked" "which port, still?"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "a request under an --id already on file is the same request: logged dedup"
  k "$(yes_ test "$(reqs)" = 2)" "…one file per id (the durable id is the dedupe, not the words)"
  k "$(yes_ test "$(cat "$T/out")" = block:demorepo:atrack)" "…and the replay prints the id it already has"

  # AUTHORITY IS NOT THE FLAG. A worker (a .cc/track marker above its cwd) asking --decision is a request instead.
  mkdir -p "$T/wt/.cc"; printf 'demorepo\natrack\nsid\n' > "$T/wt/.cc/track"
  NC "$T/wt" --decision -t "demorepo/atrack blocked" "which database do I restore?"
  k "$(yes_ grep -q 'rung=P kind=request send=broker$' <<<"$(last)")" "a --decision from under a .cc/track marker is a planner request, not an owner card"
  k "$(yes_ grep -q 'only the control seat asks the owner' "$T/err")" "…and one stderr line tells the session where it went"
  k "$(no_ grep -q -- '--mention' <<<"$(args)")" "…nothing @-mentions him"
  k "$(no_ pushed)" "…and his phone stays quiet"
  k "$(yes_ test "$(reqf .from)" = demorepo/atrack)" "…the request names the asker from the marker (repo/track), not from anything the caller said"
  k "$(yes_ test "$(reqf .why)" = decision)" "…and remembers it was asked as a decision, for the seat to weigh"
  k "$(yes_ grep -qF 'cc demorepo atrack --go ""' <<<"$(bargs)")" "…and the seat is told how to answer that worker"
  # AND THE FLAG IS ONLY ONE OF THE THREE WAYS IN. `--kind` names a rung 1 row outright, and kind_of reads a title's
  # second word, so both of these used to walk past a gate that read --decision/--approval/--owner and nothing else:
  # the same worker got the card, the @-mention and the push by spelling it differently (review of #558).
  NC "$T/wt" --kind decision -t "demorepo blocked" "may I drop the staging table?"
  k "$(yes_ grep -q 'rung=P kind=request send=broker$' <<<"$(last)")" "a track's --kind decision is a planner request too: the gate reads the KIND, not the flag"
  k "$(no_ grep -q -- '--mention' <<<"$(args)")" "…nothing @-mentions him for it"
  k "$(no_ pushed)" "…and his phone stays quiet"
  k "$(yes_ test "$(reqf .why)" = decision)" "…and the record still remembers it was asked as a decision"
  NC "$T/wt" -t "demorepo approval" "may I restart the indexer?"
  k "$(yes_ grep -q 'rung=P kind=request send=broker$' <<<"$(last)")" "…and a title whose second word is a rung 1 kind buys no more: \"<repo> approval\" from a track is a request"
  k "$(no_ grep -q -- '#approvals' <<<"$(args)")" "…no 🔐 card in #approvals"
  k "$(no_ pushed)" "…and no push"
  # THE WAY BACK TO A TRACK HAS TO WORK ON A HEADLESS ONE, which is where most of these come from: cc-loop's
  # stop_unheard files its stop as an --ask, and `cc … --say` needs a live interactive pane it does not have. So
  # the line names the brief and a re-dispatch, in cc-loop's own words for it.
  NC "$T/wt" --ask --id "stop:demorepo/atrack:20260921T0100Z" -t "demorepo/atrack needs you" "which port do I use?"
  k "$(yes_ grep -qF 'append the answer to ~/.cc/state/demorepo/atrack/task.md' <<<"$(bargs)")" "a cc-loop stop's request tells the seat to answer in that worker's own brief…"
  k "$(yes_ grep -qF 'drop the STATUS line from progress.md, then `cc demorepo atrack --go ""`' <<<"$(bargs)")" "…and to re-dispatch it from there, rather than --say at a session that is not there"
  # A MEMBER-FACING SESSION (host side: the .cc/member-facing marker) — its --owner used to be his DM.
  mkdir -p "$T/alice/.cc"; : > "$T/alice/.cc/member-facing"
  NC "$T/alice" --owner "I need a repo on GitHub"
  k "$(yes_ grep -q 'rung=P kind=request send=broker$' <<<"$(last)")" "a member-facing session's --owner is a planner request: the member cannot promote itself to his DM"
  k "$(no_ grep -q -- '-c UOWNER' <<<"$(args)")" "…and no DM went out"
  k "$(yes_ test "$(reqf .from)" = alice)" "…the request is from the workspace the marker names"
  k "$(yes_ grep -q -- "cc-slack post -c '#alice'" <<<"$(bargs)")" "…and the seat is told the way back to it"
  # --from IS THE RELAYER'S WORD, honoured from control alone: the daemon naming a member socket's workspace.
  N --ask --from bob -t "bob: blocked" "the daemon relays bob's escalation"
  k "$(yes_ test "$(reqf .from)" = bob)" "--from names the asker when the control seat (the daemon, here) relays for it"
  k "$(yes_ grep -q -- "cc-slack post -c '#bob'" <<<"$(bargs)")" "…and the seat is told the way back to that workspace"
  NC "$T/wt" --ask --from bob -t "demorepo/atrack blocked" "a worker claims to be bob"
  k "$(yes_ test "$(reqf .from)" = demorepo/atrack)" "…while a worker's --from is not its to choose: the marker names it"
  # CC_ROLE alone (a headless worker exports it; the marker is the truth but the env is honoured too)
  ( cd "$T" && env -u CC_MEMBER_SANDBOX CC_ROLE=worker HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" --decision -t "demorepo blocked" "may I?" >/dev/null 2>"$T/err" )
  k "$(yes_ grep -q 'rung=P kind=request' <<<"$(last)")" "CC_ROLE=worker with no marker is a request too"
  # THE DAEMON'S WORD: a caller whose pid a track's live subscription owns is that track, wherever it stands.
  seatstub demorepo/atrack
  N --decision -t "demorepo blocked" "may I drop the branch?"
  k "$(yes_ grep -q 'rung=P kind=request' <<<"$(last)")" "a caller the daemon says belongs to a track's seat is not control, whatever its cwd"
  k "$(yes_ test "$(reqf .from)" = demorepo/atrack)" "…and the request names that seat"
  seatstub abox
  N --decision -t "demorepo blocked" "may I drop the old branch?"
  k "$(yes_ grep -q 'rung=1 kind=decision' <<<"$(last)")" "…while the control repo's own seat (its name is the box's here) is control: rung 1"
  seatstub "abox@improve"
  N --decision -t "demorepo blocked" "may I drop the older branch?"
  k "$(yes_ grep -q 'rung=P kind=request' <<<"$(last)")" "…and an orch of the control repo (<repo>@<alias>) is not: it asks the planning seat"
  # THE DAEMON CAN BE DOWN, and then `seat` cannot say who is calling: it exits 2 (could not ask), which is not
  # exit 1's "the daemon says none". Reading the failure as "no seat" made every unmarked caller the box's own
  # hand for as long as a restart lasted, and the owner's door with it. This fails closed.
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\n[ "$1" = seat ] && exit 2\nexit 0\n' "$T/slack.args" > "$NH/bin/cc-slack"
  chmod +x "$NH/bin/cc-slack"
  N --decision -t "demorepo blocked" "may I drop the newest branch?"
  k "$(yes_ grep -q 'rung=P kind=request' <<<"$(last)")" "a seat reading that FAILED (cc-slack seat exit 2, the daemon unreachable) is not control: the call is filed as a request"
  k "$(no_ pushed)" "…and his phone stays quiet: a door nobody could be identified at is shut, not open"
  k "$(yes_ test -z "$(reqf .from)")" "…and the request names no asker, because nothing could name one"
  slackstub 0

  # QUEUED IS NOT HANDLED. A broker that does not take the request leaves it on file, said so, and exit 1;
  # `requests --retry` hands it over again, and nothing is dropped or sent to the owner in between.
  brokerstub 1
  N --ask -t "demorepo blocked" "the deploy key is gone"; rc=$?
  k "$(yes_ test "$rc" = 1)" "a request the broker refuses exits 1"
  k "$(yes_ grep -q 'rung=P kind=request send=none$' <<<"$(last)")" "…and the log says none took it"
  k "$(yes_ test "$(reqf .delivered)" = false)" "…the file stays, delivered=false"
  k "$(no_ grep -q -- '^post' <<<"$(args)")" "…and it was not dumped on the owner instead"
  lost=$(cat "$T/out")
  out=$( cd "$T" && env HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" requests 2>&1 )
  k "$(yes_ grep -q "^$lost  from" <<<"$out")" "cc-notify requests lists what the broker has not taken"
  k "$(yes_ grep -q "^$lost  from .*UNTAKEN" <<<"$out")" "…marked UNTAKEN"
  k "$(yes_ grep -q "^block:demorepo:atrack  from .*tries 1  demorepo blocked" <<<"$out")" "…and what it took but nobody answered is still open, listed without the mark"
  brokerstub 0
  out=$( cd "$T" && env HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" requests --retry 2>&1 )
  k "$(yes_ grep -q "^$lost: handed to the broker on try 2" <<<"$out")" "…--retry hands it over again"
  k "$(yes_ test "$(jq -r .delivered "$NH/.cc/requests/$lost.json")" = true)" "…and the file says delivered once it is"
  k "$(yes_ test "$(jq -r .attempts "$NH/.cc/requests/$lost.json")" = 2)" "…counting the tries"

  # THE CLOSING VERB. `requests answer <id> "text"` posts the answer once where the request came from and closes the
  # file; nothing else it is given posts anything. Each case has its own request, filed here.
  rm -rf "$NH/.cc/requests"
  NC "$T/wt" --ask --id ans:track -t "demorepo/atrack needs you" "which port?"
  NC "$T/alice" --ask --id ans:member "I need a repo"
  N --ask --id ans:nobody -t "demorepo blocked" "nobody named"
  N --ask --from bob --id ans:fails -t "bob: blocked" "the post will fail"
  A(){ NC "$1" requests answer "${@:2}"; }
  posts(){ grep -c '^post' "$T/slack.args"; }
  A "$T" ans:track "use 8080"; rc=$?
  k "$(yes_ test "$rc" = 0)" "answer exits 0 once the answer is posted"
  k "$(yes_ grep -qx -- "post --route demorepo/atrack answer --id answer:ans:track@$(jq -r .at "$NH/.cc/requests/ans:track.json") use 8080" "$T/slack.args")" "…posted into the track's own thread (routed by its repo/track title), under the producer id answer:<id>@<asked-at>"
  k "$(yes_ test "$(posts)" = 1)" "…exactly one post"
  k "$(yes_ test -n "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:track.json")")" "…and the file is closed: answered_at set"
  k "$(yes_ test "$(jq -r .by "$NH/.cc/requests/ans:track.json")" = abox)" "…by the control seat"
  out=$( cd "$T" && env HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" requests 2>&1 )
  k "$(no_ grep -q '^ans:track ' <<<"$out")" "a closed request is no longer listed"
  k "$(yes_ grep -q '^ans:member ' <<<"$out")" "…while one still open is"
  A "$T" ans:track "use 9090"; rc=$?
  k "$(yes_ test "$rc" = 1)" "a second answer to a closed request is refused"
  k "$(yes_ test "$(posts)" = 0)" "…and posts nothing"
  k "$(yes_ test "$(jq -r .answer "$NH/.cc/requests/ans:track.json")" = "use 8080")" "…and the first answer stands"
  A "$T" ans:nosuch "anything"; rc=$?
  k "$(yes_ test "$rc" = 1)" "an unknown id is refused"
  k "$(yes_ test "$(posts)" = 0)" "…and posts nothing"
  A "$T/wt" ans:member "a worker answers"; rc=$?
  k "$(yes_ test "$rc" = 1)" "a track cannot answer a request: only the control seat does"
  k "$(yes_ test "$(posts)" = 0)" "…nothing posted"
  k "$(yes_ test -z "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:member.json")")" "…and the request stays open"

  # THE QUEUE'S OWN SEAT (<box>@requests) IS LET IN BY THAT EXACT NAME, and no orch alias gets the same door
  # just for being an orch: `cc-slack seat` is asked here the same way it named `abox@improve` above.
  N --ask --id ans:queue -t "demorepo blocked" "the queue's own seat closes this one"
  seatstub "abox@requests"
  A "$T" ans:queue "closed by the queue's seat"; rc=$?
  k "$(yes_ test "$rc" = 0)" "the seat that owns the 🙋 queue (<box>@requests) answers a request too"
  k "$(yes_ test -n "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:queue.json")")" "…and closes it"
  k "$(yes_ test "$(jq -r .by "$NH/.cc/requests/ans:queue.json")" = abox)" "…filed under the box's own name, same as the control seat"
  N --ask --id ans:otherseat -t "demorepo blocked" "no other orch alias gets this"
  seatstub "abox@improve"
  A "$T" ans:otherseat "not the requests seat"; rc=$?
  k "$(yes_ test "$rc" = 1)" "no other orch of the control repo shares that door — only the exact name <box>@requests does"
  k "$(yes_ test -z "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:otherseat.json")")" "…and the request stays open"
  slackstub 0

  A "$T" ans:member "it is made"
  k "$(yes_ grep -qx -- "post -c #alice --id answer:ans:member@$(jq -r .at "$NH/.cc/requests/ans:member.json") it is made" "$T/slack.args")" "a workspace's request is answered in its channel, the way back its request line names"
  A "$T" ans:nobody "noted"; rc=$?
  k "$(yes_ test "$rc:$(posts)" = 0:0)" "a request that names no asker is closed with no post"
  k "$(yes_ test -n "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:nobody.json")")" "…and it is closed"
  slackstub 1
  A "$T" ans:fails "try this"; rc=$?
  k "$(yes_ test "$rc" = 1)" "an answer Slack refuses exits 1"
  k "$(yes_ test -z "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:fails.json")")" "…and leaves the request open for the retry, which the producer id keeps to one post"
  slackstub 0
  brokerstub 0
  NC "$T/wt" --ask --id ans:track -t "demorepo/atrack needs you" "which port now?"
  k "$(yes_ test "$(jq -r '.answered_at // ""' "$NH/.cc/requests/ans:track.json"):$(jq -r .text "$NH/.cc/requests/ans:track.json")" = ":which port now?")" "an answered id asked again is a new, open request, not a dedup"
  k "$(yes_ test "$(jq -r .answer "$NH/.cc/requests/closed/ans:track@"*.json)" = "use 8080")" "…and the answered one is kept under closed/"

  N --ask -t "[_cctest9] blocked" "a fixture asks"
  k "$(yes_ grep -q 'send=test$' <<<"$(last)")" "synthetic test state is never a request either: logged, no file, no broker"
  k "$(yes_ test ! -s "$T/broker.args")" "…nothing handed to the broker"

  # INSIDE A MEMBER BOUNDARY there is no config and no token, so the one door out is the workspace's own socket and
  # the daemon applies this table on the far side. What must not cross with it is the CALLER'S OWN LOUDNESS: a `-p`
  # relayed through there arrived at a cc-notify call that overwrites it one line later — the look of a rung a member
  # could set, and none of the effect. Title and words cross; how loudly it lands is the escalation row's, out here.
  M(){ : > "$T/slack.args"; : > "$T/err"; : > "$T/ntfy.reqs"
       ( cd "$T" && env -u CC_NOTIFY_LOG_ONLY -u CC_ROLE -u SLACK_BOT_TOKEN -u SLACK_OWNER_ID -u SLACK_WEBHOOK \
             -u SLACK_ALERTS -u NTFY_TOPIC -u NTFY_SERVER -u CC_BOX CC_MEMBER_SANDBOX=1 \
             HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" "$@" >/dev/null 2>"$T/err" ); }
  M -p high -t "alice help" "I am blocked and need the owner"
  k "$(yes_ grep -qx 'escalate -t alice help' <<<"$(args)")" "inside a member boundary the escalation leaves over the workspace's socket carrying the title and the words — and nothing at all about how loudly it should land"
  k "$(yes_ grep -q 'send=socket$' <<<"$(last)")" "…and the log names the door that really took it"
  # A TRACK'S OWN LINE IS NOT A REQUEST: a plain call titled `<h>/<track> <kind>` (a loop's done, needs you, round
  # over; the worker's deliverable) crosses as a NOTICE, which the daemon re-enters plain out here — the track's
  # thread and one line to the seat — and never as the --ask card a member's DONE became on 2026-09-20.
  M -t "alice/pna done" "Customs documents. PR: https://x/pull/3"
  k "$(yes_ grep -qx 'escalate --notice -t alice/pna done' <<<"$(args)")" "a plain call titled with the workspace's track crosses as escalate --notice: the track's line, not a request"
  k "$(yes_ grep -q 'kind=notice send=socket$' <<<"$(last)")" "…and the log says notice"
  M --id "done:alice/pna:pr3" -t "alice/pna done" "Customs documents. PR: https://x/pull/3"
  k "$(yes_ grep -qx 'escalate --notice --id done:alice/pna:pr3 -t alice/pna done' <<<"$(args)")" "…and a notice with an --id carries it across (cc-loop's done card, one card per PR): the daemon files it under the workspace and posts it once (review of #561)"
  M --ask --id "q:alice/pna:1" -t "alice/pna needs you" "which database?"
  k "$(yes_ grep -qx 'escalate -t alice/pna needs you' <<<"$(args)")" "…while a request's --id stays on this side: only the notice door takes one"
  M --ask -t "alice/pna needs you" "which database?"
  k "$(yes_ grep -qx 'escalate -t alice/pna needs you' <<<"$(args)")" "…but a door the caller NAMED (--ask) is a request whatever the title says"
  M -t "alice done" "no track in this title"
  k "$(yes_ grep -qx 'escalate -t alice done' <<<"$(args)")" "…and a title that names no track is the request it was"
  M -t "alice/pna decision" "may I drop the staging table?"
  k "$(yes_ grep -qx 'escalate -t alice/pna decision' <<<"$(args)")" "…and a track title whose second word is a rung 1 kind is the request too, never a notice: the daemon re-enters a notice as the box's own hand, and the table reads that word out there (review of #558)"
  k "$(yes_ grep -q 'kind=request send=socket$' <<<"$(last)")" "…logged as the request it crossed as"
  M --kind approval -t "alice/pna done" "may I restart the indexer?"
  k "$(yes_ grep -qx 'escalate -t alice/pna done' <<<"$(args)")" "…as is a --kind that names one, whatever the title says"

  # THE ROUND TRIP, member → seat → owner → member, every hop through the real code with only Slack and the broker
  # stubbed (the brief's DONE line; the review of #558 asked for it chained). Hop 1 is the socket line above; hop 2
  # is what the daemon's `escalate` verb runs for it — the argv cc-slack builds, quoted here so the two stay in step:
  #   cc-notify -t "<h>: <title>" --ask --from <h> -- <text>
  rm -rf "$NH/.cc/requests"; N -t "alice: help" --ask --from alice -- "I am blocked and need the owner"
  trip=$(cat "$T/out")
  k "$(yes_ test "$(jq -r .from "$NH/.cc/requests/$trip.json")" = alice)" "round trip 2/4: the daemon's relay of that socket line is a request on file from alice"
  k "$(yes_ grep -q -- "^inject --source request abox 🙋 request $trip from alice: alice: help — I am blocked" <<<"$(bargs)")" "…handed to the control seat by the broker, naming her"
  k "$(no_ grep -q -- '^post' <<<"$(args)")" "…and nothing of it posted to Slack: the seat reads it, not the owner"
  how=$(sed -n "s/.*(answer: \(cc-slack post -c '#[a-z]*'\) .*/\1/p" "$T/broker.args" | head -1)   # the way back, as the seat was told it (N clears the file)
  # hop 3: the seat cannot settle it and asks the owner — one card, in #<repo>, an @-mention; the request is still hers
  N --decision -t "abox blocked" -- "alice needs the owner: restore her staging DB from Friday's snapshot?"
  k "$(yes_ grep -q -- "--route abox blocked --mention \*Decision needed:\* alice needs the owner" <<<"$(args)")" "round trip 3/4: the seat's --decision is the one ❓ @owner card in #<repo>"
  k "$(yes_ grep -q 'rung=1 kind=decision send=ntfy+slack$' <<<"$(last)")" "…rung 1, phone rung — the first thing of hers that reaches him, and it is the seat's word"
  k "$(yes_ test "$(reqs)" = 1)" "…and no second request came of it: the seat asking the owner is not another ask"
  # hop 4: his answer comes back to #alice by the command the request line itself named — read off the broker's line
  # and run as printed (the stub cc-slack records it), so the line the seat is told is a line that works
  : > "$T/slack.args"
  ( PATH="$NH/bin:$PATH"; eval "$how \"restore it: yes, from Friday's snapshot\"" )
  k "$(yes_ grep -qx "post -c #alice restore it: yes, from Friday's snapshot" <<<"$(args)")" "round trip 4/4: the answer reaches #alice by the way back the request line named (it wakes her session)"

  N -p high -t "abox limit" "Claude usage limit until 12:00Z"
  k "$(yes_ grep -q -- '-c #alerts' <<<"$(args)")" "the TABLE picks #alerts for rung 4 — not the title's second word, and not the caller"
  k "$(no_ grep -q 'rotating_light' <<<"$(args)")" "…and the caller's -p high buys no siren: the kind decides the urgency"
  k "$(no_ pushed)" "…and rung 4 does not ring the phone either"

  N -p high -t "abox secretary" "3 findings are standing"
  k "$(yes_ grep -q 'rung=5 kind=secretary' <<<"$(last)")" "the secretary is ambient — it was a siren in the ambient lane, which is the worst of both"
  k "$(yes_ grep -q -- '--route' <<<"$(args)")" "…so it goes to the updates lane by route, not to #alerts"

  # A TITLE CANNOT BUY A RUNG. Whatever a caller interpolates into a title, a second word the table does not name
  # is ambient — `*` and `@` included, the two that are special as array subscripts (see kind_of). These assert the
  # property, so they hold on any shell; breaking kind_of's fallthrough turns them red.
  N -t "demorepo * failed" "a star stands where a kind would"
  k "$(yes_ grep -q 'rung=5 kind=update' <<<"$(last)")" "a title whose second word is * is ambient, like any word the table does not name"
  k "$(no_ grep -q 'ntfy push failed' "$T/err")" "…so it never reaches his phone"
  k "$(no_ grep -q -- '--mention' <<<"$(args)")" "…and never @-mentions him"
  N -t "demorepo @ failed" "an at-sign stands where a kind would"
  k "$(yes_ grep -q 'rung=5 kind=update' <<<"$(last)")" "…and so is one whose second word is @, the other subscript that is special"
  k "$(no_ grep -qE 'integer expression|not found' "$T/err")" "…with no integer-expression error from a window the table never set"

  N -t "demorepo test suite red" "3 cases"
  k "$(yes_ grep -q 'rung=5 kind=update' <<<"$(last)")" "…and a title whose second word happens to be the word test stays ambient: only the subcommand reaches that row"
  N -t "demorepo whatever happened here" "x"
  k "$(yes_ grep -q 'rung=5 kind=update' <<<"$(last)")" "an event kind nothing in the table names is ambient, never loud"
  N -t "demorepo board" -- --kind decision
  k "$(yes_ grep -q 'kind=board' <<<"$(last)")" "after --, a message that looks like --kind is the MESSAGE: a relayed line cannot buy a rung"

  # -h/--help ANYWHERE STOPS FIRST, before a single door opens (the row this case exists for: 09-13 and 09-15 a
  # seat's own `cc-notify --help` fell through the flag loop below, made the literal word "--help" the MESSAGE,
  # and it was logged and posted into the owner's updates lane). A line count taken before the call is the
  # fixture: "writes no log line" means the log did not grow, not that it happened to start empty.
  lc=$(wc -l < "$log" 2>/dev/null || echo 0); : > "$T/slack.args"; : > "$T/ntfy.reqs"
  helpout=$( cd "$T" && env -u CC_NOTIFY_LOG_ONLY -u CC_MEMBER_SANDBOX -u CC_ROLE -u SLACK_BOT_TOKEN -u SLACK_OWNER_ID \
        -u SLACK_WEBHOOK -u SLACK_ALERTS -u NTFY_TOPIC -u NTFY_SERVER -u CC_BOX \
        HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" -t "demorepo board" --help 2>"$T/err" ); helprc=$?
  k "$(yes_ test "$helprc" = 0)" "--help anywhere in the arguments exits 0"
  k "$(yes_ grep -q 'cc-notify \[-t title\]' <<<"$helpout")" "…and prints the usage header on stdout, not to a channel"
  k "$(yes_ test "$(wc -l < "$log")" = "$lc")" "…and writes NO notify.log line — the log did not grow at all"
  k "$(no_ pushed)" "…never reaches the phone"
  k "$(yes_ test ! -s "$T/slack.args")" "…and nothing at all is handed to Slack — the 09-15 incident, exactly: '--help' read as the message"
  N -t "demorepo board" -- --help
  k "$(yes_ grep -q 'kind=board' <<<"$(last)")" "…while after --, --help is the MESSAGE again, the same escape hatch as --kind above: a relayed line still cannot be swallowed either"

  N -t "[_cctest9] PR #7 merged" "cc-land: not a git repo"
  k "$(yes_ grep -q 'send=test$' <<<"$(last)")" "synthetic test state is logged as such and pushed nowhere"
  k "$(yes_ test ! -s "$T/slack.args")" "…with nothing handed to Slack"

  # A SEND THAT FAILED IS NOT A SEND. The dedup stamp went down before any channel was tried, so a failure was
  # recorded as delivered and the caller's retry — cc-boot-notify's, 10 s later — hit the dedup branch, exited 0 and
  # marked the notice posted. The retry has to REALLY re-send, so the channel here really fails first.
  cfg_ "$DEAD" yes; slackstub 1                      # every door shut: Slack refuses and the phone does not answer
  N -t "demorepo stalled" "the channel is down"; rc=$?
  k "$(yes_ test "$rc" = 1)" "every configured channel refusing the message exits 1, so the caller knows to retry"
  N -t "demorepo stalled" "the channel is down"; rc=$?
  k "$(yes_ grep -q 'send=none$' <<<"$(last)")" "…and the retry is not held by the dedup: a send that failed left no stamp behind — and the log says none, not a door"
  k "$(yes_ test -s "$T/slack.args")" "…it is handed to the channel a second time, which is the whole point of exiting 1"
  slackstub 0
  N -t "demorepo stalled" "the channel is down"; rc=$?
  k "$(yes_ test "$rc" = 0)" "…and once the channel is back the retry gets through"
  N -t "demorepo stalled" "the channel is down"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "…and only THAT one arms the window: the stamp follows delivery, not the attempt"
  cfg_ "$LIVE" yes

  # `cc-notify test` IS the proof that the push works (README, RUNBOOK, docs/AUDIT.md all send a person here), and
  # someone runs it twice while getting the phone subscribed. Its message differs only in a clock, whose digits this
  # file strips out of the key on purpose — so borrowing another kind's window made the second run a silent no-op.
  N test
  k "$(yes_ grep -q 'rung=1 kind=notify-test send=ntfy+slack$' <<<"$(last)")" "cc-notify test is its own kind, rung 1, and really goes to the phone"
  N test
  k "$(yes_ grep -q 'send=ntfy+slack$' <<<"$(last)")" "…and a second test minutes later pushes AGAIN: the call whose job is to prove the push works is never deduped"
  k "$(yes_ grep -q '^post ' "$T/slack.args")" "…the second one really reached a channel, rather than logging send=dedup and exiting 0"

  # A BOX WITH NO SLACK AT ALL. README:53 is `cc-notify setup && cc-notify test` — a topic and nothing else — and
  # there the push is the only door there is. Gating it on rung 1 alone made boot, limit, cc-rc, audit and power
  # reach NOBODY on such a box, silently, at exit 0.
  cfg_ "$LIVE" no
  N -t "abox boot" "up at 12:00"
  k "$(yes_ grep -q 'rung=4 kind=boot send=ntfy$' <<<"$(last)")" "with no Slack configured anywhere, a rung 4 notice goes out over ntfy — the only door the box has"
  k "$(yes_ pushed)" "…and the push really arrived, which is why the log is allowed to say ntfy"
  k "$(yes_ test ! -s "$T/slack.args")" "…without inventing a Slack channel to send it to"
  N -t "abox secretary" "a page is waiting to be read"
  k "$(yes_ grep -q 'rung=5 kind=secretary send=ntfy$' <<<"$(last)")" "…and so does an ambient one, rather than being dropped"
  k "$(yes_ test "$(prio_)" = low)" "…at the table's own prio: ntfy reads low as no sound and no vibration, which is what keeps it quiet"
  cfg_ "$LIVE" yes
  N -t "abox boot" "up at 13:00"
  k "$(no_ pushed)" "…while the same rung 4 notice on a box that HAS Slack stays off the phone, which is what this table was for"

  # TWO BOOTS ARE TWO EVENTS. A boot message differs from the last one only in digits — the time, the seconds dark,
  # the SSD counter, "Boots today: N" — and the key strips digits on purpose, so any window at all made a power-flap
  # reboot loop, the exact thing this message exists to report, into one notice; cc-boot-notify then stamps
  # boot-announced for a notice nobody received.
  N -t "abox boot" "Up at 04:00 UTC. 12s dark. Sudden-power-loss count: 4. Boots today: 2."
  k "$(no_ grep -q 'send=dedup$' <<<"$(last)")" "a boot notice goes out"
  N -t "abox boot" "Up at 04:09 UTC. 31s dark. Sudden-power-loss count: 5. Boots today: 3."
  k "$(no_ grep -q 'send=dedup$' <<<"$(last)")" "…and the next boot nine minutes later is its OWN event: a reboot loop is reported every time, not once"

  # CONFIGURED IS NOT WORKING. A token that is set but dead — revoked, or the bot dropped from the channel — is not
  # a channel, and the box's own rung 4 news (cc-rc, power, limit) would sit in the log and nowhere else, unnoticed:
  # cc-rc, cc-vitals and cc-limit all discard this script's exit status. The phone is the last door.
  slackstub 1
  N -t "abox cc-rc" "services did not come back"; rc=$?
  k "$(yes_ pushed)" "when the only Slack channel REFUSES a rung 4 notice, the push fires as the last door and really arrives"
  k "$(yes_ grep -q 'rung=4 kind=cc-rc send=ntfy-fallback$' <<<"$(last)")" "…and THE LOG SAYS SO — the door it actually went through, not the one it was routed to"
  k "$(yes_ test "$rc" = 0)" "…and it exits 0, because a door did take it"
  slackstub 0
  N -t "abox cc-rc" "services did not come back at all"
  k "$(no_ pushed)" "…while a rung 4 notice Slack ACCEPTS still stays off his phone: the fallback is a failure path, not a second channel"
  k "$(yes_ grep -q 'send=slack$' <<<"$(last)")" "…and that one logs the door it really used too"

  # THE PRODUCER ID (arch review 2026-09-08, rec 4). `idstub <sent-rc> <post-rc>`: a cc-slack whose ledger answers
  # `sent <id>` with the first code and whose `post` exits with the second, logging both calls as the stub above does.
  idstub(){ printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s"\ncase "$1" in sent) exit %s;; esac\nexit %s\n' "$T/slack.args" "$1" "$2" > "$NH/bin/cc-slack"
            chmod +x "$NH/bin/cc-slack"; }
  # --heading: a person reads the work's name, while the title still routes the post to its thread
  idstub 1 0; : > "$T/slack.args"
  N --heading "Done: a plain title" -t "demorepo/w1 done" "The PR is open."
  k "$(yes_ grep -q -- '^post --route demorepo/w1 done \*Done: a plain title\*' <<<"$(args)")" "--heading is the bold line and the title still routes"
  k "$(no_ grep -q -- '\*demorepo/w1 done\*' <<<"$(args)")" "…and the title itself is not shown"
  idstub 1 0
  N --owner -t alice --id credential:alice "alice needs a credential minted"
  k "$(yes_ grep -q -- '^sent credential:alice$' <<<"$(args)")" "an --id is asked of cc-slack's ledger first (cc-slack sent <id>)"
  k "$(yes_ grep -q -- '^post .* --id credential:alice ' <<<"$(args)")" "…and one it has not accepted is posted WITH the id, so cc-slack sends it once"
  k "$(yes_ pushed)" "…and a rung 1 notice still rings the phone the first time"
  idstub 0 0
  N --owner -t alice --id credential:alice "alice needs a credential minted"
  k "$(yes_ grep -q 'send=dedup$' <<<"$(last)")" "a replay of an id Slack already accepted is logged dedup"
  k "$(no_ pushed)" "…and reaches no door: the phone does not ring again for the same event"
  k "$(no_ grep -q -- '^post' <<<"$(args)")" "…and nothing is posted — permanent, not a window: the ledger, not this script, remembers"
  N --owner -t bob "bob needs a credential minted"
  k "$(no_ grep -q -- '^sent' <<<"$(args)")" "…while a call without --id never asks the ledger: the window dedup is its only memory, as before"
  slackstub 0

  # HOW IT READS ON HIS PHONE. The rule he has asked for three times, said at the moment a session is writing to him
  # rather than in a memory that dies with that session — and it is a NOTE: every case below asserts the message
  # itself goes out untouched, because a door that shortened what a session wrote would be the worse failure. It only
  # fires on a door that actually rings his phone (RUNGS phone=yes): a routine note into an updates lane sits in
  # Slack until he opens it, so scolding a session over THAT length is a rung 5 note dressed as a rung 1 problem.
  N --decision -t "demorepo blocked" "$(printf 'one\ntwo\nthree\nfour\nfive\nsix')"
  k "$(yes_ grep -q 'Bold the one thing that matters at the top, or cut it' "$T/err")" \
    "a message longer than a phone shows, on a lane that rings his phone, gets the rule back on stderr, where the session that wrote it reads it"
  k "$(yes_ grep -q 'one two three four five six' <<<"$(last)")" "…and it is sent exactly as written: this is a note, never a filter"
  N --decision -t "demorepo blocked" "$(head -c 401 /dev/zero | tr '\0' x)"
  k "$(yes_ grep -q 'Bold the one thing that matters at the top, or cut it' "$T/err")" "…and a single line over 400 characters trips the same nudge, not just a line count"
  N --decision -t "demorepo blocked" "PR #7 is up."
  k "$(no_ grep -q 'Bold the one thing' "$T/err")" "…while a message that already fits on a phone is told nothing at all"

  N -t "demorepo done" "$(printf 'one\ntwo\nthree\nfour\nfive\nsix')"
  k "$(no_ grep -q 'Bold the one thing' "$T/err")" "…and a routine note into the updates lane (phone=no) is told nothing either, however long: the nudge is gated on the door, not the word count"

  out=$( cd "$T" && env -u CC_NOTIFY_LOG_ONLY -u CC_BOX HOME="$NH" CC_NOTIFY_LOG="$log" "$BIN/cc-notify" report today 2>&1 )
  k "$(yes_ grep -qE 'rung 1 +[0-9]' <<<"$out")" "report says how much was sent that day, broken out by rung"
  k "$(yes_ grep -q 'rang his phone' <<<"$out")" "…and how much of it rang his phone"

  kill -TERM "$ntfypid" 2>/dev/null; wait "$ntfypid" 2>/dev/null   # the fixture's own ntfy goes with it
  rm -rf "$T"
  echo "cc-notify selfcheck: $((n - f)) passed, $f failed"
  [ "$f" -eq 0 ]
}

BOX="$(cfg CC_BOX)"; BOX="${BOX:-$(hostname -s)}"   # this box's name (override with CC_BOX in ~/.cc/config): default title + ntfy topic prefix
title="$BOX"; prio="default"; decision=0; want=""; pid=""; heading=""
case "${1:-}" in
  setup)
    NTFY_TOPIC="$(cfg NTFY_TOPIC)"
    if [ -z "$NTFY_TOPIC" ]; then NTFY_TOPIC="$BOX-$(tr -dc a-z0-9 </dev/urandom | head -c 12)"; "$BIN/cc-config" set NTFY_TOPIC "$NTFY_TOPIC"; fi
    echo "ntfy topic: $NTFY_TOPIC"; echo "Phone: install the 'ntfy' app (iOS/Android) -> Subscribe to topic -> enter: $NTFY_TOPIC"
    echo "Then run: cc-notify test"; exit 0 ;;
  test) exec "$0" -t "$BOX test" --kind notify-test "Notifications work. $("$BIN/cc-time" slack)" ;;
  report) shift; report "${1:-}"; exit 0 ;;
  requests) shift; requests "$@"; exit $? ;;
  selfcheck) selfcheck; exit $?;;
esac
NTFY_TOPIC="$(cfg NTFY_TOPIC)"; NTFY_SERVER="$(cfg NTFY_SERVER)"; NTFY_SERVER="${NTFY_SERVER:-https://ntfy.sh}"
SLACK_WEBHOOK="$(cfg SLACK_WEBHOOK)"; SLACK_BOT_TOKEN="$(cfg SLACK_BOT_TOKEN)"
SLACK_OWNER_ID="$(cfg SLACK_OWNER_ID)"; SLACK_ALERTS="$(cfg SLACK_ALERTS)"; SLACK_APPROVALS="$(cfg SLACK_APPROVALS)"
CC_NOTIFY_LOG_ONLY="$(cfg CC_NOTIFY_LOG_ONLY)"
# Is this a member-facing session's call? Same walk as cc-guard: the marker is the truth, CC_ROLE only a convenience.
# `from` is the session dir's name — its Slack channel's name too — and it makes a better default title than the
# box's. Such a call is a request to the planning seat (it used to be the owner's DM: the member cannot promote itself).
owner=0; ask=0; approval=0; from=""; from_arg=""; run=""; [ "${CC_ROLE:-}" = member ] && ask=1
d="$PWD"; while [ -n "$d" ] && [ "$d" != / ]; do
  [ -f "$d/.cc/member-facing" ] && { ask=1; from=${d##*/}; break; }; d=${d%/*}; done
[ -n "$from" ] && title="$from escalation"
asked=0   # a door the CALLER named (--ask/--decision/--approval/--owner), as against one the marker or the role implies
while [ $# -gt 0 ]; do case "$1" in -t) title="$2"; shift 2;; --heading) heading="$2"; shift 2;; -p) prio="$2"; shift 2;; --owner) owner=1; asked=1; shift;;
  --kind) want="$2"; shift 2;;
  --id) pid="$2"; shift 2;;
  --ask) ask=1; asked=1; shift;; --approval) approval=1; asked=1; shift;; --from) from_arg="$2"; shift 2;; --run) run="$2"; shift 2;;
  --decision) decision=1; asked=1; shift;; --) shift; break;; *) break;; esac; done   # `--`: the message is next whatever it starts with — a caller relaying somebody else's words (the member socket) cannot let them become flags
msg="${*:-$(cat)}"; [ -z "$msg" ] && exit 0
# --run is refused here rather than carried: a workspace's words cross its socket as text, never as a command.
[ -n "$run" ] && [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && { echo "cc-notify: --run cannot leave a member workspace — nothing posted" >&2; exit 2; }

# INSIDE A MEMBER WORKSPACE'S BOUNDARY (cc-sandbox member) there is no ~/.cc/config and no token: every rung below is
# unconfigured, `tried` would stay 0 and this would exit 0 having reached NOBODY — a blocked member told its call
# worked. The one door out is the workspace's own socket; the daemon re-enters this script outside as a --ask, so
# the planning seat gets it. THE LOUDNESS IS NOT RELAYED: this used to hand the socket the caller's own -p, which
# the daemon passed to a cc-notify that overwrites it from the table — the appearance of a rung a member could set,
# and none of the effect. Title and words cross; what they buy is decided out here.
# …EXCEPT A TRACK'S OWN LINE. A plain call titled `<h>/<track> <kind>` — cc-loop's done, round over, needs you, its
# stops, the worker's deliverable — is not asking the seat for anything, so it is not a request: it crosses as a
# NOTICE (`cc-slack escalate --notice`) and the daemon runs this very call on the host, where the title routes it
# into the track's thread and one `loop:` line reaches the control seat. A member's DONE used to cross as an
# escalation and land in the owner's DM, with nothing in the project thread (2026-09-20, a-finished-worker-reaches-
# its-thread). A door the caller NAMED (--ask and the owner doors) is still a request, whatever the title says.
if [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; then
  rung=P; kind=request; door=(escalate)
  # …AND ONLY A LINE THE TABLE READS AS AMBIENT. The daemon re-enters a notice plain, as the box's own hand, and
  # kind_of reads a title's second word (review of #558): `<h>/<track> decision` crossing as a notice would buy the
  # ❓ @owner card from inside the boundary that #558 shut on the host. A rung 1 kind, by title or --kind, stays a request.
  if [ "$asked" = 0 ] && [[ "$title" =~ ^[a-z0-9][a-z0-9-]{0,39}/[A-Za-z0-9_][A-Za-z0-9._-]{0,63}\  ]]; then
    read -r nrung _ <<<"${RUNGS[$(kind_of "${want:-}" "$title")]}"
    # a notice carries its id (cc-loop's done card: one card per PR); the daemon files it under the workspace
    [ "$nrung" = 1 ] || { rung=5; kind=notice; door=(escalate --notice ${pid:+--id "$pid"}); }
  fi
  if printf '%s' "$msg" | "$HOME/bin/cc-slack" "${door[@]}" -t "$title"; then
    printf '%s\t%s\t%s\trung=%s kind=%s send=%s\n' "$(date -u +%FT%TZ)" "$title" "$(printf '%s' "$msg" | tr '\n\t' '  ')" "$rung" "$kind" socket >> "$LOG"; exit 0; fi
  printf '%s\t%s\t%s\trung=%s kind=%s send=%s\n' "$(date -u +%FT%TZ)" "$title" "$(printf '%s' "$msg" | tr '\n\t' '  ')" "$rung" "$kind" none >> "$LOG"
  echo "cc-notify: the workspace's Slack link did not take this — it is in $LOG and nowhere else" >&2; exit 1
fi

# THE TABLE DECIDES WHAT THIS IS, AND IT DECIDES BEFORE AUTHORITY, because the kind is what authority is about. The
# rung is also what the log records, so `cc-notify report` can answer how much reached him yesterday and how loudly.
[ "$decision" = 1 ] && want=decision
[ "$approval" = 1 ] && want=approval
[ "$owner" = 1 ] && want=escalation
kind=$(kind_of "$want" "$title")
read -r rung phone window prio <<<"${RUNGS[$kind]}"   # the caller's -p is read and dropped here: the table decides

# AUTHORITY, DECIDED HERE AND NOT BY THE FLAG. Read once, and only when a door needs it (an ambient note asks
# nobody's leave). An owner door asked for by a caller that is not the control seat is a request to the planning
# seat instead — said on stderr, so the session that wrote it learns where it went.
# WHAT COUNTS AS THAT DOOR IS THE RESOLVED KIND, NOT THE FOUR FLAGS. A flag is only one of three ways a rung 1 kind
# is picked: `--kind decision|approval|escalation` names a row outright, and kind_of reads a title's second word, so
# `-t "demorepo approval"` reaches the same row. Gating on the flags alone left both open, and a track could buy an
# ❓ @owner card, a 🔐 #approvals card and a phone push by its title (review of #558). Rung 1 however it was reached
# is the gate, and the three owner kinds by name as well, so a table edit that lowered one of their rungs could not
# quietly reopen it.
ownerdoor=0; [ "$rung" = 1 ] && ownerdoor=1
case "$kind" in decision|approval|escalation) ownerdoor=1;; esac
control=1
if [ "$ask" = 1 ] || [ "$ownerdoor" = 1 ]; then is_control || control=0; fi
if [ "$ask" = 0 ] && [ "$control" = 0 ]; then
  echo "cc-notify: only the control seat asks the owner — this is a request to ${CTL:-$BOX}'s planning seat instead (from ${from_seat:-${from:-this session}})" >&2
  ask=1
fi
# WHO THE REQUEST IS FROM: the marker or the seat, read above; `--from` only where the caller is control (the daemon
# relaying a member socket's words names that workspace), since it is where the seat's answer goes, and a caller that
# is not control does not choose it.
[ "$ask" = 1 ] && [ -z "$from" ] && { if [ "$control" = 1 ]; then from="$from_arg"; else from="$from_seat"; fi; }
# WHAT IT WAS ASKED AS, for the seat to weigh: the resolved kind, since the caller may have named it with --kind or
# in its title rather than with a flag. Anything else is a plain ask.
why=ask; case "$kind" in decision|approval) why=$kind;; escalation) why=owner;; esac

# A COMMAND THE OWNER'S 👍 RUNS rides only on a card the control seat itself posts to #approvals; anything else that
# names one is refused whole, never downgraded to a request that drops the command and asks anyway. The command goes
# into the message, so the card, the log and the dedup key all carry it, with the stamp cc-slack checks the card by.
if [ -n "$run" ]; then
  if [ "$ask" = 1 ] || [ "$kind" != approval ] || [ "$owner" = 1 ]; then
    echo "cc-notify: --run rides only on the control seat's --approval card — nothing posted" >&2; exit 2; fi
  [ -n "${SLACK_BOT_TOKEN:-}" ] || { echo "cc-notify: --run needs the bot's own post (no SLACK_BOT_TOKEN) — nothing posted" >&2; exit 2; }
  # Three backticks ANYWHERE on the card, not just in the command: an open fence in the description turns the code
  # block below inside out, and the command that runs reads as plain text under a harmless-looking one.
  case "$run$msg$title$heading" in *'```'*) echo "cc-notify: a --run card cannot hold three backticks anywhere (the card shows its command in a code block) — nothing posted" >&2; exit 2;; esac
  # Characters that make the card show one command and bash run another: control characters (Cc; a tab and a
  # newline are kept), every invisible format character (Cf: bidi marks, overrides and isolates, zero-width ones, the
  # BOM, tag characters) and the Unicode line and paragraph separators, which Slack breaks a line on and bash does not.
  # The whole card, as with the backticks: `cc-slack run-approved` asks both again of the card it finds, and a card
  # this posted with one in its description would never run.
  if perl -CA -e 'exit($ARGV[0] =~ /(?![\t\n])\p{Cc}|[\p{Cf}\p{Zl}\p{Zp}]/ ? 0 : 1)' "$run$msg$title$heading"; then
    echo "cc-notify: a --run card holds a control, bidi or zero-width character, so it would not show what runs — nothing posted" >&2; exit 2; fi
  [ "${#run}" -le 2000 ] || { echo "cc-notify: --run is over 2000 characters, and a card split in two runs nothing — nothing posted" >&2; exit 2; }
  runsha=$(printf '%s' "$run" | sha256sum | cut -c1-64)
  shown=$(printf '%s' "$run" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g')   # Slack reads <…> as a link
  msg="$(printf '%s\n```\n%s\n```\nYour 👍 runs this once on the box; the exit code comes back here and the output in your DM · `run:%s`' "$msg" "$shown" "${runsha:0:16}")"
fi

# A PLANNER REQUEST leaves by the broker and stops here: no rung, no phone, no Slack. Its id is the caller's --id
# when it gave one (the same event asked twice is one request), else a stamp; the window below is the same as the
# table's for a decision, so a worker re-running its blocked line every iteration does not re-ask every iteration.
if [ "$ask" = 1 ]; then
  rung=P; kind=request
  rid="${pid:-req-$(date -u +%Y%m%dT%H%M%SZ)-$$}"; rid=$(printf '%s' "$rid" | tr -c 'A-Za-z0-9._:@-' '_')
  logreq(){ printf '%s\t%s\t%s\trung=%s kind=%s send=%s\n' "$(date -u +%FT%TZ)" "$title" "$(printf '%s' "$msg" | tr '\n\t' '  ')" "$rung" "$kind" "$1" >> "$LOG"; }
  # THROWAWAY TEST STATE NEVER REACHES THE PLANNING SEAT EITHER — the same gate the doors below keep, kept here too,
  # because a fixture that ran a real cc-land would otherwise leave a real request on file and wake a real seat.
  case " $title $msg " in *[!A-Za-z0-9]_cctest*|*[!A-Za-z0-9]_selfcheck*)
    logreq test; echo "cc-notify: synthetic test state, logged and not asked ($title)" >&2; exit 0;; esac
  [ -n "${CC_NOTIFY_LOG_ONLY:-}" ] && { logreq log-only; exit 0; }
  # AN ANSWERED ID ASKED AGAIN IS A NEW ASK: the closed file moves to closed/ (its record kept) and this one is filed
  # fresh. Only an OPEN request under the id is "the same request".
  if [ -f "$REQ/$rid.json" ] && [ -n "$(jq -r '.answered_at // ""' "$REQ/$rid.json" 2>/dev/null)" ]; then
    mkdir -p "$REQ/closed" && mv -f "$REQ/$rid.json" "$REQ/closed/$rid@$(jq -r .answered_at "$REQ/$rid.json" | tr -c 'A-Za-z0-9._:@-' '_').json"; fi
  if [ -f "$REQ/$rid.json" ]; then
    logreq dedup; echo "cc-notify: request $rid is already on file — not asked twice" >&2; echo "$rid"; exit 0; fi
  key="$(printf '%s\t%s\t%s' request "$(scope_of "$title")" "$(printf '%s' "$msg" | tr -d '0-9')" | cksum | tr ' ' '-')"
  if [ -z "$pid" ] && [ -f "$SEEN/$key" ] && [ $(( $(date +%s) - $(stat -c %Y "$SEEN/$key" 2>/dev/null || echo 0) )) -lt 1800 ]; then
    logreq dedup; echo "cc-notify: the same request was made less than 1800s ago — logged, not asked again" >&2; exit 0; fi
  req_write "$rid" "$from" "$title" "$msg" false 0 "$why"
  if req_send "$rid"; then logreq broker; mkdir -p "$SEEN" 2>/dev/null && : > "$SEEN/$key"; echo "$rid"; exit 0; fi
  logreq none; echo "cc-notify: the broker did not take request $rid — it is on file in $REQ and \`cc-notify requests --retry\` offers it again" >&2
  echo "$rid"; exit 1
fi

# THE ONE NUDGE, and it is a note, never a gate: the message goes out unchanged whatever this says. It is here
# because this is the door every line of prose to him passes through, so it is the only place the rule can be said
# while the writing is still happening — three earlier tellings each lived in one session's memory and died with it.
# Only a message that actually rings his phone earns it: a routine rung 5 note into #<repo>-updates was getting
# scolded for a length nobody but a phone screen minds.
if [ "$phone" = yes ]; then
  nline=$(wc -l <<<"$msg")
  if [ "${#msg}" -gt 400 ] || [ "$nline" -gt 5 ]; then
    echo "cc-notify: that is $nline lines, ${#msg} characters, and he reads it on a phone. Bold the one thing that matters at the top, or cut it — depth belongs in the journal, docs/ or the canvas. Sending it as written." >&2
  fi
fi
# THE DEDUP KEY is the KIND, what it is ABOUT, and what it says with the numbers taken out. The numbers are the
# point: a caller whose message changes every run defeats a plain hash on purpose, and that is how one cosmetic
# publish failure signed itself differently 6 times in a day (its reason quotes `grep -in`, whose line numbers shift
# as the file grows) and how a dialog standing at a pane says a new minute count every tick. Stripping them keys on
# the event instead of on the clock, here at the door, so no caller has to be taught to sign itself — and a caller
# whose numbers ARE the event says so in its scope (a PR number) rather than in its prose.
# cksum's "<crc> <len>" is enough to key a file name on.
key="$(printf '%s\t%s\t%s' "$kind" "$(scope_of "$title")" "$(printf '%s' "$msg" | tr -d '0-9')" | cksum | tr ' ' '-')"
# THE LOG IS WRITTEN FROM WHAT HAPPENED, NOT FROM WHAT WAS PLANNED. This block used to decide a `send` label from
# the CONFIG, write the line, and only then try to deliver — so a Slack post that failed and a phone fallback that
# succeeded both logged `send=slack`, and `cc-notify report` told the owner 0 pushes on the day his phone was the
# only thing that rang. Three rounds of review found three different bugs in that gap. There is no gap now: `took`
# collects the doors that ACTUALLY took the message and `record` is the one writer, called once per path with what
# `took` collected. Nothing writes the log ahead of the outcome, so the log cannot disagree with it.
record(){ printf '%s\t%s\t%s\trung=%s kind=%s send=%s\n' "$(date -u +%FT%TZ)" "$title" \
    "$(printf '%s' "$msg" | tr '\n\t' '  ')" "$rung" "$kind" "$1" >> "$LOG"; }
went=""; took(){ went="${went:+$went+}$1"; }   # the doors the message really went through, in the order it took them
stop=""
case " $title $msg " in
  # THROWAWAY TEST STATE MUST NEVER PAGE THE OWNER. Selfchecks and selftests work on synthetic repos named
  # _cctest…/_selfcheck…, and their failures are REAL calls to this script from cc-slack, cc-land, cc-handoff and
  # cc-reconcile: four days of "[_cctest…] PR #7 merged, deploy stopped :rotating_light:" in #alerts, at high
  # priority, produced by nothing more than running the gates. Stubbing each call site was tried and every new
  # case inherits none of it — and cc-slack's land runs on a background thread, so the stub is already back by the
  # time the call happens. The gate therefore lives HERE, at the one door every outward notification goes through,
  # and it keys on the NAME so it holds for a caller nobody thought to configure. Anchored on a non-alphanumeric
  # so a real repo that merely contains the word (myrepo_cctesting) still pages. The line is still logged: the
  # trail is what a test asserts on, and it is the only thing that was ever wanted from a fixture.
  *[!A-Za-z0-9]_cctest*|*[!A-Za-z0-9]_selfcheck*) stop="test";;
esac
[ -z "$stop" ] && [ -n "${CC_NOTIFY_LOG_ONLY:-}" ] && stop="log-only"   # tests set this: log, never push
case "$stop" in
  test)     record test;     echo "cc-notify: synthetic test state, logged and not pushed ($title)" >&2; exit 0;;
  log-only) record log-only; exit 0;;
esac
# A SEND THAT FAILED IS NOT A SEND. This stamp used to be written HERE, before any channel had been tried, so a
# failure was recorded as delivered: cc-boot-notify's first try fails and exits 1, its retry 10 s later lands in the
# dedup branch and exits 0, the caller writes ~/.cc/state/boot-announced, and the boot notice reached nobody and is
# never retried again. So it is called below instead, once a channel has taken the message — or once it is certain
# there was no channel to take it, which is the other way this exits 0.
stamp(){ mkdir -p "$SEEN" 2>/dev/null && : > "$SEEN/$key"
         find "$SEEN" -type f -mmin +1440 -delete 2>/dev/null; }   # a key nothing has repeated in a day is not holding anything back
# THE PRODUCER ID IS THE PERMANENT DEDUP, and cc-slack keeps it (arch review 2026-09-08, rec 4): an id Slack has
# already accepted reaches no door here — not the phone either, which the window below never governed for rung 1.
# Below the sandbox for the same reason the window is: in there the daemon re-enters this script, and it asks then.
if [ -n "$pid" ] && "$HOME/bin/cc-slack" sent "$pid" >/dev/null 2>&1; then
  record dedup; echo "cc-notify: $pid was already sent (cc-slack's ledger) — logged, not sent again" >&2; exit 0
fi
# THE DEDUP, and it sits BELOW the sandbox on purpose: the table is not applied inside a member boundary, so an
# escalation in there is never held back by a window this side of it.
if [ "$window" -gt 0 ] && [ -f "$SEEN/$key" ]; then
  now=$(date +%s); was=$(stat -c %Y "$SEEN/$key" 2>/dev/null || echo 0)
  if [ $((now - was)) -lt "$window" ]; then
    record dedup; echo "cc-notify: the same $kind was sent less than ${window}s ago — logged, not sent again" >&2; exit 0
  fi
fi
# WHICH DOORS ARE OPEN. The table says whether this rings the phone; the config says which doors exist at all. A box
# set up the way the README says (`cc-notify setup && cc-notify test`) has a topic and NO Slack, and there the push is
# the ONLY door: gating it on rung 1 alone drops boot, limit, cc-rc, audit and power on the floor — that is silence,
# not restraint, and "it can wait for him to open Slack" means nothing on a box with no Slack. So when no Slack channel
# is configured the push carries every rung, and the table's PRIO is what keeps it quiet: ntfy reads `low` as no sound
# and no vibration and `default` without the long buzz that `high` gets, which is the ladder the phone already speaks.
to_slack=0; { [ -n "${SLACK_BOT_TOKEN:-}" ] || [ -n "${SLACK_WEBHOOK:-}" ]; } && to_slack=1
to_ntfy=0;  [ -n "${NTFY_TOPIC:-}" ] && { [ "$phone" = yes ] || [ "$to_slack" = 0 ]; } && to_ntfy=1
# post <url> <curl args...> — url via -K (kept out of argv/ps), body via stdin (a message starting with @ is text, not a filename)
post() { local u=$1; shift; curl -sS --fail --max-time 10 --data-binary @- -K <(printf 'url = "%s"\n' "$u") "$@" >/dev/null 2>&1; }
tried=0
# THE PHONE RINGS FOR RUNG 1 — and for everything, on a box whose only door it is (see "WHICH DOORS ARE OPEN" above).
# Until 2026-09-07 this block sat ABOVE all routing and fired on every call that had a topic configured, so the ladder
# — which only ever existed on the Slack side — never reached the push at all.
push_ntfy(){ tried=$((tried + 1))   # $1 names the door for the log: the push proper, or the fallback below
  if printf '%s' "$msg" | post "$NTFY_SERVER/$NTFY_TOPIC" -H "Title: ${heading:-$title}" -H "Priority: $prio" -H "Tags: robot"
    then took "$1"; else echo "cc-notify: ntfy push failed (logged)" >&2; fi; }
[ "$to_ntfy" = 1 ] && push_ntfy ntfy
if [ "$to_slack" = 1 ]; then   # one channel: the bot, else the webhook
  tried=$((tried + 1)); bang=$( { [ "$prio" = high ] || [ "$prio" = urgent ]; } && echo ' :rotating_light:')
  # THE RUNG IS THE DESTINATION. An escalation is DELIVERED, not routed: the owner's DM — unpaired, #alerts (cc-slack
  # falls that back to SLACK_CHANNEL). Rung 4 names #alerts here rather than hoping the title's second word happens to
  # be in cc-slack's ALERT_KINDS — that mismatch is what put the secretary's siren in the ambient lane. Rung 5 keeps
  # --route: cc-slack already turns a title into that repo's -updates lane, which is what ambient means.
  # THE CARD READS AS THE CONTRACT SAYS (core/docs/comms-contract.md): cc-slack's --mention opens it with ❓ and his
  # mention; what follows names the kind of answer wanted — a choice, or an authorization — and then the one question.
  body="$(printf '*%s*%s\n%s' "${heading:-$title}" "$bang" "$msg")"
  if [ "$owner" = 1 ]; then dest=(-c "${SLACK_OWNER_ID:-#${SLACK_ALERTS:-alerts}}")   # a DM already IS rung 1
  elif [ "$kind" = approval ]; then dest=(-c "#${SLACK_APPROVALS:-approvals}" --mention); body="🔐 *Approval needed:* $msg"
  elif [ "$kind" = decision ]; then dest=(--route "$title" --mention); body="*Decision needed:* $msg"
  elif [ "$rung" = 4 ]; then dest=(-c "#${SLACK_ALERTS:-alerts}")
  else dest=(--route "$title"); [ "$rung" = 1 ] && dest+=(--mention); fi   # rung 1: the main channel, @-mentioned
  [ -n "$pid" ] && dest+=(--id "$pid")   # the event's name: cc-slack posts it once and answers a replay with the ts it has
  if [ -n "${SLACK_BOT_TOKEN:-}" ] && cardts=$("$HOME/bin/cc-slack" post "${dest[@]}" "$body" 2>/dev/null); then
    took slack   # posted by the bot (owner DM, project channel or SLACK_CHANNEL)
    # THE RUN RECORD, written once the card has a ts: the command lives here, on the host, and never comes back from
    # Slack. A replay of the same --id answers with the ts it has, and a record already there is never rewritten.
    if [ -n "$run" ]; then
      rdir="$HOME/.cc/approvals/run"; cardts=$(printf '%s' "$cardts" | tail -1)
      if ! printf '%s' "$cardts" | grep -qE '^[0-9]+\.[0-9]+$'; then
        echo "cc-notify: the card went out but cc-slack gave no ts — no run record, so a 👍 on it runs nothing" >&2
      elif [ -e "$rdir/$cardts.json" ]; then
        echo "cc-notify: a run record for card $cardts is already on file — left as it was" >&2
      elif ! (umask 077 && mkdir -p "$rdir" && chmod 700 "$rdir" &&
              jq -n --arg ts "$cardts" --arg cmd "$run" --arg sha "$runsha" --arg from "${from_seat:-${BOX:-}}" \
                 --arg at "$(date -u +%FT%TZ)" '{ts:$ts, cmd:$cmd, sha256:$sha, from:$from, posted_at:$at}' \
                 > "$rdir/$cardts.json.tmp" && mv "$rdir/$cardts.json.tmp" "$rdir/$cardts.json"); then
        echo "cc-notify: the card went out but its run record could not be written — a 👍 on it runs nothing" >&2
      fi
    fi
  elif [ -z "$run" ] && [ -n "${SLACK_WEBHOOK:-}" ] &&
       jq -cn --arg t "${heading:-$title}" --arg m "$msg" --arg b "$bang" \
         'def esc: gsub("&";"&amp;") | gsub("<";"&lt;") | gsub(">";"&gt;");
          {text: ("*" + ($t|esc) + "*" + $b + "\n" + ($m|esc))}' |
       post "$SLACK_WEBHOOK" -H 'Content-Type: application/json'; then
    took slack
  else
    echo "cc-notify: slack post failed (logged)" >&2
  fi
fi
# THE PUSH IS THE LAST DOOR. Deciding the fallback on whether Slack is CONFIGURED is not the same as deciding it on
# whether Slack WORKED: a revoked token, or the bot removed from the channel, leaves to_slack=1, to_ntfy=0 and ok=0,
# and a rung 4 notice about the box's own services would sit in the log and nowhere else — while cc-rc, cc-vitals and
# cc-limit all discard this script's exit status, so nothing downstream would notice either. Before this table that
# call always pushed. So when every door that was tried has failed and the phone is still there, ring it, at the
# table's prio. (to_ntfy=0 with a topic set means to_slack was 1: the push was held back FOR Slack, and Slack is gone.)
if [ -z "$went" ] && [ "$to_ntfy" = 0 ] && [ -n "${NTFY_TOPIC:-}" ]; then
  echo "cc-notify: no Slack channel took this — falling back to the phone" >&2; push_ntfy ntfy-fallback
fi
# ONE LINE, WRITTEN LAST, SAYING WHICH DOORS TOOK IT — `ntfy`, `slack`, `ntfy+slack`, `ntfy-fallback`, or `none`.
record "${went:-none}"
[ -n "$went" ] && { stamp; exit 0; }         # at least one door took it
[ "$tried" -eq 0 ] && { stamp; exit 0; }     # nothing configured: the log is the only channel, that is not a failure
exit 1                                       # every configured channel failed — no stamp, so the caller's retry re-sends
