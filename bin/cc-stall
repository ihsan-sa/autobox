#!/usr/bin/env python3
"""cc-stall — notice a box session that is stuck with nobody looking, clear it when that is safe, else raise a row.

  cc-stall              look at every window in tmux session main and print what is stuck; press nothing, raise nothing
  cc-stall --apply      …and clear what the KNOWN table below clears, and raise a `raised-stall-*` row for the rest
  cc-stall selfcheck    the decisions against fake panes and a stub board; no tmux, no board

It rides cc-broker.timer every 2 min (cc-broker's tick), before cc-msg's sweep and run apart from it: a failure here is a
line in ~/.cc/state/stall.log and never stops the sweep behind it. It asks no model and no network.

WHAT IT CLEARS (--apply). Only a dialog in the KNOWN table, only at a pane where an interactive `claude` is alive
(a dead pane still shows the last dialog it drew — pressing at that was the 2026-09-23 relaunch loop), only when the
dialog's footer is the bottom of the screen, never with a permission dialog's words anywhere on it, never in copy
mode, never mid-turn. Today the table holds two rows:
  dev-channels  "WARNING: Loading development channels" (1 I am using this for local development · 2 Exit):
                the digit 1, which picks option 1 and confirms it wherever the cursor sits. Never Up: the menu
                wraps, and Up from option 1 is "2. Exit" (that is what cc-slack accept-dialog's fallback pressed).
  usage-limit   "Stop and wait for limit to reset" (1 stop · 2 wait here, then continue · 3 add funds): the digit 2,
                so the session carries on by itself once the limit resets. Owner 2026-10-16: seats clear each
                other's limit prompt, perms' included (it sat on one twice that day, holding the release and every
                security read). Never 3, which spends money.
A dialog it pressed and that is still up afterwards is treated as unknown from then on.
WHAT IT DECLINES (--apply). A tool-permission dialog (its "No, and tell Claude what to do differently" option on screen)
standing DECLINE_S at a live, idle claude gets Esc, which is that No: nothing runs. Then cc-msg tells the window which
command was declined and why, so the session carries on instead of waiting for a person nobody has. Once per dialog,
and not under tier stop. (2026-10-20: perms sat about 3 h at a dialog on `sudo sh -c` with a glob that no rule can
pass; every read and LAND waited, no seat may type into perms' pane, and its own card went into its own queue.)
UNDER THE SPEND TIER. `cc-tier allows continue` exit 1 (tier stop) leaves the usage-limit prompt unpressed and
unreported: option 2 is a session carrying on by itself at the reset, which stop holds. `cc-tier allows pulse` exit 1
holds the dead-orch word to the seat below until the tier lifts. Any other answer, or no cc-tier, is "go".

WHAT IT REPORTS (a `raised-stall-<window>-<kind>` row on the control repo's board, CC_BRIEF_MACHINE=1):
  loop    a relaunch loop: cc-rc's "claude exited (N) - restarting" line grew by LOOP_MIN or more between two passes,
          or grew on LOOP_STREAK passes running. Nothing is pressed: a loop has a cause a key cannot know.
  dialog  any other dialog standing STAND_S or longer at a live, idle claude: the same screen on two passes.
          The row quotes the dialog itself (its lines below the last rule, up to its options, and its question),
          never the session's prose above it.
ONCE PER STALL: a report is stamped in ~/.cc/state/stall.json and re-armed only after a pass where that stall is
gone (the dialog closed, the count stood still past LOOP_REARM, cc-rc's longest wait), so the same stall never raises twice. A board that refused the row
is retried on the next pass under the same row name, TRIES times at most, and a retry that finds the row already on the
board (an add that wrote it, then timed out or exited non-zero) counts it raised.
A healthy window — no dialog, or mid-turn, or a count that does not move — is left alone and its state dropped.

A DEAD ORCH (a window named <repo>@<alias> with no interactive claude under it, seen on two passes DEAD_S apart, not
in copy mode and with no open handoff record) is said ONCE to its repo's planning seat, the window named <repo>, by
cc-msg: the window, since when, and its last screen lines. When cc-msg keeps refusing for DEAD_S (that seat is down
too, not just mid-handoff) it is raised as a `raised-stall-<window>-dead-*` row instead, like a stall. A claude back
under the window re-arms it. Nothing is restarted: cc-recover brings orchs back only after a mass loss, a boot or an
outage, and treats one lone exit as deliberate. (2026-10-17: main:<repo>@landing sat as a bare shell, cc-msg refused every handback with "runs no
interactive claude", and #1458, #1465 and two dispatch stalls waited until planning happened to look. The same
evening the seat handed off at 19:20Z, refused one message at 19:23Z, and two rows went up for orchs it could have
been told about a pass later.)
"""
import hashlib, json, os, re, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.realpath(__file__))
STATE = os.environ.get("CC_STALL_STATE") or f"{HOME}/.cc/state/stall.json"
LOG = os.environ.get("CC_STALL_LOG") or f"{HOME}/.cc/state/stall.log"
SESSION = os.environ.get("CC_STALL_SESSION") or "main"
STAND_S = int(os.environ.get("CC_STALL_STAND_S") or 180)      # an unknown dialog stands this long before it is raised
DECLINE_S = int(os.environ.get("CC_STALL_DECLINE_S") or 900)  # a permission dialog stands this long before Esc
LOOP_MIN = int(os.environ.get("CC_STALL_LOOP_MIN") or 3)      # relaunches between two passes that make a loop
LOOP_STREAK = 3                                               # …or this many passes running that each saw one
LOOP_GAP = 900                                                # passes further apart than this start a new baseline
LOOP_REARM = 300                                              # a count still longer than this is a stopped loop: cc-rc's
                                                              # longest wait between relaunches (120 s backoff, 300 s limit fallback)
TRIES = 3                                                     # a row the board refused is tried this many times
DEAD_S = int(os.environ.get("CC_STALL_DEAD_S") or 360)      # an orch with no claude this long is dead: past cc-rc's
                                                              # longest relaunch wait (LOOP_REARM) and a handoff's swap
ORCH_RE = re.compile(r"([A-Za-z0-9._-]+)@([A-Za-z0-9._-]+)")  # <repo>@<alias>; `~next`/`~old` handoff windows never match
HANDOFF = os.environ.get("CC_HANDOFF_DIR") or f"{HOME}/.cc/state/handoff"
SETTLE = float(os.environ.get("CC_STALL_SETTLE") or 1.5)      # after a key, before the pane is read again

RELAUNCH_RE = re.compile(r"^claude exited \(\d+\) - restarting", re.M)     # cc-rc's own line, one per relaunch
WORKING = "esc to interrupt"
PROMPT_LINE = re.compile(r"^[^\w>❯]*[>❯](.*)$")   # the input box, as cc-handoff reads it (`❯` since 2.1)
DIALOG_MARKS = ("Enter to confirm", "Esc to cancel", "Do you want to", "Would you like to proceed?",
                "No, and tell Claude what to do differently")
PERMISSION_MARKS = ("Do you want to", "No, and tell Claude what to do differently", "Would you like to proceed?",
                    "I trust this folder")
# name, every substring that must be on the screen, the footer that must be at its bottom, the literal key
KNOWN = [("dev-channels", ("WARNING: Loading development channels", "1. I am using this for local development", "2. Exit"),
          "Enter to confirm", "1"),
         ("usage-limit", ("Stop and wait for limit to reset", "2. Wait here, then continue automatically", "3. Add funds"),
          "Enter to confirm", "2")]


def log(line):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\t{line}\n")
    except OSError:
        pass


def ctl():
    """The control repo: the one this bin/ is checked out under in ~/dev (cc-msg's ctl()), else CC_STALL_REPO."""
    if os.environ.get("CC_STALL_REPO"):
        return os.environ["CC_STALL_REPO"]
    rel = os.path.relpath(BIN, f"{HOME}/dev")
    return rel.split(os.sep)[0] if not rel.startswith("..") else "box"


class Tmux:
    """The real box. Every call swallows its own failure: a window that vanished mid-pass is just skipped."""
    def run(self, *a):
        try:
            r = subprocess.run(["tmux", *a], capture_output=True, text=True, timeout=10)
            return r.stdout if r.returncode == 0 else None
        except Exception:
            return None

    def windows(self):
        out = self.run("list-windows", "-t", SESSION, "-F", "#{window_id}\t#W\t#{pane_pid}\t#{pane_in_mode}") or ""
        seen = []
        for line in out.splitlines():
            p = line.split("\t")
            if len(p) == 4 and p[0] not in (w[0] for w in seen):
                seen.append((p[0], p[1], p[2], p[3] == "1"))
        return seen

    def screen(self, wid):
        return self.run("capture-pane", "-p", "-t", wid)

    def history(self, wid):
        return self.run("capture-pane", "-p", "-J", "-S", "-3000", "-t", wid)

    def live_claude(self, pane_pid):
        """An interactive `claude` somewhere under the pane (not `claude -p`)."""
        kids = {}
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue
            try:
                with open(f"/proc/{d}/stat") as f:
                    s = f.read()
                comm = s[s.index("(") + 1:s.rindex(")")]
                ppid = s[s.rindex(")") + 2:].split()[1]
                kids.setdefault(ppid, []).append((d, comm))
            except (OSError, ValueError, IndexError):
                continue
        q = [str(pane_pid)]
        while q:
            for pid, comm in kids.get(q.pop(), []):
                q.append(pid)
                if comm == "claude":
                    try:
                        argv = open(f"/proc/{pid}/cmdline").read().split("\0")
                    except OSError:
                        return True
                    if "-p" not in argv and "--print" not in argv:
                        return True
        return False

    def press(self, wid, key):
        return self.run("send-keys", "-t", wid, "-l", "--", key) is not None


def on_board(repo, name):
    """True when the board already holds this row: an add that wrote it and then timed out or exited non-zero."""
    board = os.environ.get("CC_STALL_BOARD") or f"{BIN}/cc-board"
    try:
        r = subprocess.run([board, "get", repo, name, "title"], capture_output=True, text=True, timeout=30,
                           stdin=subprocess.DEVNULL)
        return r.returncode == 0 and bool(r.stdout.strip())
    except Exception:
        return False


def raise_row(repo, name, title, brief):
    board = os.environ.get("CC_STALL_BOARD") or f"{BIN}/cc-board"
    try:
        r = subprocess.run([board, "add", repo, name, title, brief], capture_output=True, text=True, timeout=60,
                           env={**os.environ, "CC_BRIEF_MACHINE": "1"}, stdin=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def row_name(window, kind, now=None):
    """One row per stall: the minute it was raised is part of the name, so a later stall of the same kind in the
    same window never lands in the first one's (maybe closed) row."""
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", window).strip("-") or "window"
    head = "raised-stall-"
    stamp = time.strftime("%m%d%H%M", time.gmtime(time.time() if now is None else now))
    tail_ = "-" + kind + "-" + stamp
    return head + slug[:64 - len(head) - len(tail_)] + tail_


def tail(screen, n=12):
    lines = [l for l in (screen or "").splitlines() if l.strip()]
    return lines[-n:]


def known(screen):
    """The KNOWN row this screen shows live, or None. A permission word anywhere vetoes the whole table."""
    if any(m in screen for m in PERMISSION_MARKS):
        return None
    last, block = tail(screen, 1), "\n".join(tail(screen))
    for name, marks, footer, key in KNOWN:  # marks only in the bottom block: the same words in scrollback are history
        if all(m in block for m in marks) and last and footer in last[0]:
            return name, key
    return None


def is_dialog(screen):
    """A dialog word in the bottom block, below the bottom-most EMPTY input box. A dialog replaces the box, so words
    above an empty one are a finished reply asking its reader something (2026-10-14 a member window: an idle screen,
    "✻ Cooked for 15s", raised as a dialog). A dialog's own `❯ 1. …` cursor line is not an empty box."""
    lines = tail(screen)
    for i in range(len(lines) - 1, -1, -1):
        m = PROMPT_LINE.match(lines[i])
        if m and (not m.group(1).strip() or m.group(1).strip().startswith('Try "')):   # strip() takes the NBSP
            lines = lines[i + 1:]
            break
    return any(m in l for l in lines for m in DIALOG_MARKS)


RULE = set("─━▔╌ ")
ASKS = ("Do you want to", "Would you like to proceed?")


def question(screen):
    """What the dialog says, for the row: its lines below the last rule or box top in the bottom block, up to its
    options, and the question it asks. Never the session's own prose above the dialog: on 2026-10-14 a row quoted
    "Sending the repairs now." and nobody could tell which dialog had stood."""
    lines, start = tail(screen), 0
    for i, l in enumerate(lines):
        s = l.strip()
        if s.startswith("╭") or (s and set(s) <= RULE):
            start = i + 1
    body = [s for s in (l.strip(" │─╭╮╰╯") for l in lines[start:]) if s and not set(s) <= RULE]
    head = []
    for s in body:
        if s.startswith("❯") or re.match(r"\d+\. ", s) or any(m in s for m in ASKS):
            break
        head.append(s)
    ask = next((s for s in body if any(m in s for m in ASKS)), None)
    quote = " · ".join(head[:3] + ([ask] if ask else [])) or (body[0] if body else "")
    return quote[:240] or "(unreadable)"


def report(st, key, repo, window, kind, what, detail, apply_):
    """Raise the row once per stall. True when this pass raised it."""
    ent = st.setdefault(key, {})
    if ent.get("told") or ent.get("tries", 0) >= TRIES:
        return False
    # ONE NAME PER STALL, KEPT ACROSS RETRIES (raised-stall-ai-lab-dialog-10140621): a retry used to stamp a new
    # minute into the name, so an add that wrote its row and then reported failure raised the same dialog three
    # times (main:ai-lab, 2026-10-14 06:19/06:21/06:23Z, three workers on one stall). A retry looks first.
    name = ent.setdefault("name", row_name(window, kind))
    if ent.get("tries", 0) and on_board(repo, name):
        ent["told"] = True
        log(f"{window}\t{kind}\tfound {repo}/{name} on the board after a refused add")
        return False
    title = f"main:{window} is stuck: {what}"
    brief = (f"GOAL: main:{window} runs again, and whatever stalled it is fixed at its cause.\n"
             f"WHY: cc-stall saw it at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}: {what}. "
             f"The screen: {detail}\n"
             f"DONE: the window takes a turn again, and the cause is fixed or written up.")
    print(f"  stuck      main:{window:<24} {kind:<7} {what}")
    if not apply_:
        return False
    if raise_row(repo, name, title, brief):
        ent["told"] = True
        log(f"{window}\t{kind}\traised {repo}/{name}\t{what}")
        return True
    ent["tries"] = ent.get("tries", 0) + 1
    log(f"{window}\t{kind}\tboard refused {repo}/{name} (try {ent['tries']})")
    return False


HOLD = set()   # the tier verbs this pass is held on (run sets it): "continue", "pulse"


def held(what):
    """`cc-tier allows <what>` exit 1, as cc-broker reads it; any other exit, or a cc-tier that cannot run, is "go"."""
    tier = os.environ.get("CC_STALL_TIER") or f"{BIN}/cc-tier"
    try:
        return subprocess.run([tier, "allows", what], capture_output=True, timeout=10,
                              stdin=subprocess.DEVNULL).returncode == 1
    except Exception:
        return False


def tell_seat(seat, text):
    """cc-msg the planning seat. True when it was typed or spooled (rc 0); a seat with no claude refuses (rc 1)."""
    msg = os.environ.get("CC_STALL_MSG") or f"{BIN}/cc-msg"
    try:
        r = subprocess.run([msg, seat, text], capture_output=True, text=True, timeout=120,
                           env={**os.environ, "CC_MSG_FROM": "cc-stall"}, stdin=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def check_orch(t, st, now, ctl_repo, win, apply_):
    """An orch window whose claude is gone: one word to its repo's planning seat (the module doc, A DEAD ORCH)."""
    wid, name, pane_pid, in_mode = win
    m = ORCH_RE.fullmatch(name)
    if not m:
        return
    dk = f"{name}\tdead"
    if t.live_claude(pane_pid):
        st.pop(dk, None)                               # alive (again): re-armed
        return
    if in_mode or os.path.exists(f"{HANDOFF}/{name.replace('/', '--')}.json"):
        return                                         # somebody is scrolling it, or a handoff is swapping it
    d = st.setdefault(dk, {})
    d.setdefault("first", now)
    d["passes"] = d.get("passes", 0) + 1
    if d["passes"] < 2 or now - d["first"] < DEAD_S or d.get("told") or d.get("tries", 0) >= TRIES:
        return
    seat = m.group(1)
    since = time.strftime("%H:%MZ", time.gmtime(d["first"]))
    last = " | ".join(tail(t.history(wid) or t.screen(wid) or "", 4))[:300] or "(empty)"
    what = f"orch window main:{name} ({wid}) has had no claude since {since} or earlier"
    text = (f"{what}: anything routed to it (lane handbacks, lander stalls) sits unworked. Its last lines: {last}. "
            f"Reroute its work, or start it again with: cc {seat} --orch {m.group(2)} \"\"")
    print(f"  dead       main:{name:<24} orch, no claude since {since}")
    if not apply_ or "pulse" in HOLD:              # tier stop: said on the first pass after it lifts
        return
    if tell_seat(seat, text):
        d["told"] = True
        log(f"{name}\tdead\ttold {seat}\t{what}")
        return
    if now - d.setdefault("refused", now) < DEAD_S:  # a seat mid-handoff refuses for a minute or two: ask again
        log(f"{name}\tdead\tcc-msg {seat} refused; asking again next pass")
        return
    log(f"{name}\tdead\tcc-msg {seat} refused since {time.strftime('%H:%MZ', time.gmtime(d['refused']))}; raising a row")
    report(st, dk, ctl_repo, name, "dead", what + f" (and the planning seat main:{seat} refused the message)", last, apply_)


def check_window(t, st, now, repo, win, apply_):
    check_orch(t, st, now, repo, win, apply_)
    wid, name, pane_pid, in_mode = win
    # ── the relaunch loop, read from scrollback whatever runs in the pane now ──
    hist = t.history(wid)
    if hist is not None:
        n = len(RELAUNCH_RE.findall(hist))
        lp = st.setdefault(f"{name}\tloop", {})
        prev, prev_t = lp.get("count"), lp.get("t", 0)
        if prev is None or n < prev or now - prev_t > LOOP_GAP:
            grew = 0                                   # first look, a cleared history or a long gap: a new baseline
        else:
            grew = n - prev
        lp["count"], lp["t"] = n, now
        lp["streak"] = lp.get("streak", 0) + 1 if grew > 0 else 0
        if grew >= LOOP_MIN or lp["streak"] >= LOOP_STREAK:
            report(st, f"{name}\tloop", repo, name, "loop", f"relaunched {grew} time(s) since the last look",
                   " | ".join(tail(hist, 4)), apply_)
        if grew > 0:
            lp.pop("still_since", None)
        else:                                          # a pass inside one cc-rc backoff sees no growth either:
            lp.setdefault("still_since", now)          # re-arm only once the count has stood still longer than that
            if now - lp["still_since"] > LOOP_REARM:
                lp.pop("told", None); lp.pop("tries", None)
    # ── a dialog at a live session ──
    dk = f"{name}\tdialog"
    if in_mode or not t.live_claude(pane_pid):
        if not in_mode:
            st.pop(dk, None)                           # nothing live to be stuck; a scroller is left as found
        return
    scr = t.screen(wid)
    if scr is None:
        return
    if WORKING in scr or not is_dialog(scr):
        st.pop(dk, None)                               # mid-turn, or free: healthy
        return
    k = known(scr)
    if k and k[0] == "usage-limit" and "continue" in HOLD:
        st.pop(dk, None)                               # tier stop holds it: neither pressed nor a stall
        print(f"  held       main:{name:<24} {k[0]}, the tier is stop")
        return
    if k and apply_ and not st.get(dk, {}).get("pressed"):
        t.press(wid, k[1])
        log(f"{name}\t{k[0]}\tpressed {k[1]!r}")
        print(f"  cleared    main:{name:<24} {k[0]}")
        time.sleep(SETTLE)
        after = t.screen(wid)
        if after is not None and not is_dialog(after):
            st.pop(dk, None)
            return
        st.setdefault(dk, {})["pressed"] = True        # still up after its key: unknown from here on
        scr = after or scr
    elif k and not apply_:
        print(f"  would clear main:{name:<23} {k[0]}")
        return
    h = hashlib.sha1("\n".join(tail(scr)).encode()).hexdigest()[:12]
    d = st.setdefault(dk, {})
    if d.get("hash") != h:
        d.update({"hash": h, "first": now, "passes": 0}); d.pop("told", None); d.pop("tries", None)
        d.pop("declined", None)
    d["passes"] = d.get("passes", 0) + 1
    if d["passes"] >= 2 and now - d["first"] >= STAND_S:
        report(st, dk, repo, name, "dialog", f"a dialog has stood {int(now - d['first']) // 60} min", question(scr),
               apply_)
    if (d["passes"] >= 2 and now - d["first"] >= DECLINE_S and apply_ and "continue" not in HOLD
            and not d.get("declined") and "No, and tell Claude what to do differently" in "\n".join(tail(scr))):
        d["declined"] = True
        t.press(wid, "\x1b")
        mins = int(now - d["first"]) // 60
        log(f"{name}\tdialog\tdeclined after {mins} min")
        print(f"  declined   main:{name:<24} a permission dialog, {mins} min")
        time.sleep(SETTLE)
        tell_seat(name, f"cc-stall pressed Esc (No) on your permission dialog after {mins} min, because nobody watches "
                        f"this pane. It asked: {question(scr)}. Do it in a form the checker can pass (no sh -c, glob, "
                        f"$VAR or $(...)), or hand it to a seat that can.")


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(st):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE))
        with os.fdopen(fd, "w") as f:
            json.dump(st, f, indent=1)
        os.replace(tmp, STATE)
    except OSError:
        pass


def run(t, apply_, now=None):
    global HOLD
    HOLD = {w for w in ("continue", "pulse") if held(w)} if apply_ else set()
    st = load() if apply_ else {}
    now = now or time.time()
    repo = ctl()
    wins = t.windows()
    for w in wins:
        try:
            check_window(t, st, now, repo, w, apply_)
        except Exception as e:                         # one odd window never stops the pass
            log(f"{w[1]}\terror\t{e.__class__.__name__}: {e}")
    names = {w[1] for w in wins}
    for k in [k for k in st if k.split("\t")[0] not in names]:
        del st[k]                                      # a window that is gone takes its stalls with it
    if apply_:
        save(st)
    return st


# ── selfcheck ─────────────────────────────────────────────────────────────────────────────────────────────────
DEV = """────────────────────────────────
  WARNING: Loading development channels

  --dangerously-load-development-channels is for local channel development only.

  Channels: server:cc-slack

  ❯ 1. I am using this for local development
    2. Exit

  Enter to confirm · Esc to cancel
"""
LIMIT = """  ⎿  You've hit your session limit · resets 7am (America/New_York)
▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔
   What do you want to do?

   ❯ 1. Stop and wait for limit to reset
     2. Wait here, then continue automatically shortly
     3. Add funds to continue with usage credits

   Enter to confirm · Esc to cancel
"""
READY = """ ▐▛███▛█   Claude Code
❯ Try "fix typecheck errors"
  ⏵⏵ auto mode on (shift+tab to cycle)
"""
BUSY = "⏺ Reading files…\n  ✻ Thinking… (esc to interrupt)\n"
