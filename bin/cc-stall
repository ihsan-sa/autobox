#!/usr/bin/env python3
"""cc-stall — notice a box session that is stuck with nobody looking, clear it when that is safe, else raise a row.

  cc-stall              look at every window in tmux session main and print what is stuck; press nothing, raise nothing
  cc-stall --apply      …and clear what the KNOWN table below clears, and raise a `raised-stall-*` row for the rest
  cc-stall selfcheck    the decisions against fake panes and a stub board; no tmux, no board

It rides cc-broker.timer every 2 min (cc-broker's tick), before cc-msg's sweep and run apart from it: a failure here is a
line in ~/.cc/state/stall.log and never stops the sweep behind it. It asks no model and no network.

WHAT IT CLEARS (--apply). Only a dialog in the KNOWN table, only at a pane where an interactive `claude` is alive
(a dead pane still shows the last dialog it drew — pressing at that was the 2026-09-23 relaunch loop), only when the
dialog's footer is the bottom of the screen, never with a permission dialog's words anywhere on it, never in copy
mode, never mid-turn. Today the table holds two rows:
  dev-channels  "WARNING: Loading development channels" (1 I am using this for local development · 2 Exit):
                the digit 1, which picks option 1 and confirms it wherever the cursor sits. Never Up: the menu
                wraps, and Up from option 1 is "2. Exit" (that is what cc-slack accept-dialog's fallback pressed).
  usage-limit   "Stop and wait for limit to reset" (1 stop · 2 wait here, then continue · 3 add funds): the digit 2,
                so the session carries on by itself once the limit resets. Owner 2026-10-16: seats clear each
                other's limit prompt, perms' included (it sat on one twice that day, holding the release and every
                security read). Never 3, which spends money.
A dialog it pressed and that is still up afterwards is treated as unknown from then on.

WHAT IT REPORTS (a `raised-stall-<window>-<kind>` row on the control repo's board, CC_BRIEF_MACHINE=1):
  loop    a relaunch loop: cc-rc's "claude exited (N) - restarting" line grew by LOOP_MIN or more between two passes,
          or grew on LOOP_STREAK passes running. Nothing is pressed: a loop has a cause a key cannot know.
  dialog  any other dialog standing STAND_S or longer at a live, idle claude: the same screen on two passes.
ONCE PER STALL: a report is stamped in ~/.cc/state/stall.json and re-armed only after a pass where that stall is
gone (the dialog closed, the count stood still past LOOP_REARM, cc-rc's longest wait), so the same stall never raises twice. A board that refused the row
is retried on the next pass, TRIES times at most.
A healthy window — no dialog, or mid-turn, or a count that does not move — is left alone and its state dropped.
"""
import hashlib, json, os, re, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.realpath(__file__))
STATE = os.environ.get("CC_STALL_STATE") or f"{HOME}/.cc/state/stall.json"
LOG = os.environ.get("CC_STALL_LOG") or f"{HOME}/.cc/state/stall.log"
SESSION = os.environ.get("CC_STALL_SESSION") or "main"
STAND_S = int(os.environ.get("CC_STALL_STAND_S") or 180)      # an unknown dialog stands this long before it is raised
LOOP_MIN = int(os.environ.get("CC_STALL_LOOP_MIN") or 3)      # relaunches between two passes that make a loop
LOOP_STREAK = 3                                               # …or this many passes running that each saw one
LOOP_GAP = 900                                                # passes further apart than this start a new baseline
LOOP_REARM = 300                                              # a count still longer than this is a stopped loop: cc-rc's
                                                              # longest wait between relaunches (120 s backoff, 300 s limit fallback)
TRIES = 3                                                     # a row the board refused is tried this many times
SETTLE = float(os.environ.get("CC_STALL_SETTLE") or 1.5)      # after a key, before the pane is read again

RELAUNCH_RE = re.compile(r"^claude exited \(\d+\) - restarting", re.M)     # cc-rc's own line, one per relaunch
WORKING = "esc to interrupt"
DIALOG_MARKS = ("Enter to confirm", "Esc to cancel", "Do you want to", "Would you like to proceed?",
                "No, and tell Claude what to do differently")
PERMISSION_MARKS = ("Do you want to", "No, and tell Claude what to do differently", "Would you like to proceed?",
                    "I trust this folder")
# name, every substring that must be on the screen, the footer that must be at its bottom, the literal key
KNOWN = [("dev-channels", ("WARNING: Loading development channels", "1. I am using this for local development", "2. Exit"),
          "Enter to confirm", "1"),
         ("usage-limit", ("Stop and wait for limit to reset", "2. Wait here, then continue automatically", "3. Add funds"),
          "Enter to confirm", "2")]


def log(line):
    try:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}\t{line}\n")
    except OSError:
        pass


def ctl():
    """The control repo: the one this bin/ is checked out under in ~/dev (cc-msg's ctl()), else CC_STALL_REPO."""
    if os.environ.get("CC_STALL_REPO"):
        return os.environ["CC_STALL_REPO"]
    rel = os.path.relpath(BIN, f"{HOME}/dev")
    return rel.split(os.sep)[0] if not rel.startswith("..") else "box"


class Tmux:
    """The real box. Every call swallows its own failure: a window that vanished mid-pass is just skipped."""
    def run(self, *a):
        try:
            r = subprocess.run(["tmux", *a], capture_output=True, text=True, timeout=10)
            return r.stdout if r.returncode == 0 else None
        except Exception:
            return None

    def windows(self):
        out = self.run("list-windows", "-t", SESSION, "-F", "#{window_id}\t#W\t#{pane_pid}\t#{pane_in_mode}") or ""
        seen = []
        for line in out.splitlines():
            p = line.split("\t")
            if len(p) == 4 and p[0] not in (w[0] for w in seen):
                seen.append((p[0], p[1], p[2], p[3] == "1"))
        return seen

    def screen(self, wid):
        return self.run("capture-pane", "-p", "-t", wid)

    def history(self, wid):
        return self.run("capture-pane", "-p", "-J", "-S", "-3000", "-t", wid)

    def live_claude(self, pane_pid):
        """An interactive `claude` somewhere under the pane (not `claude -p`)."""
        kids = {}
        for d in os.listdir("/proc"):
            if not d.isdigit():
                continue
            try:
                with open(f"/proc/{d}/stat") as f:
                    s = f.read()
                comm = s[s.index("(") + 1:s.rindex(")")]
                ppid = s[s.rindex(")") + 2:].split()[1]
                kids.setdefault(ppid, []).append((d, comm))
            except (OSError, ValueError, IndexError):
                continue
        q = [str(pane_pid)]
        while q:
            for pid, comm in kids.get(q.pop(), []):
                q.append(pid)
                if comm == "claude":
                    try:
                        argv = open(f"/proc/{pid}/cmdline").read().split("\0")
                    except OSError:
                        return True
                    if "-p" not in argv and "--print" not in argv:
                        return True
        return False

    def press(self, wid, key):
        return self.run("send-keys", "-t", wid, "-l", "--", key) is not None


def raise_row(repo, name, title, brief):
    board = os.environ.get("CC_STALL_BOARD") or f"{BIN}/cc-board"
    try:
        r = subprocess.run([board, "add", repo, name, title, brief], capture_output=True, text=True, timeout=60,
                           env={**os.environ, "CC_BRIEF_MACHINE": "1"}, stdin=subprocess.DEVNULL)
        return r.returncode == 0
    except Exception:
        return False


def row_name(window, kind, now=None):
    """One row per stall: the minute it was raised is part of the name, so a later stall of the same kind in the
    same window never lands in the first one's (maybe closed) row."""
    slug = re.sub(r"[^A-Za-z0-9._-]+", "-", window).strip("-") or "window"
    head = "raised-stall-"
    stamp = time.strftime("%m%d%H%M", time.gmtime(time.time() if now is None else now))
    tail_ = "-" + kind + "-" + stamp
    return head + slug[:64 - len(head) - len(tail_)] + tail_


def tail(screen, n=12):
    lines = [l for l in (screen or "").splitlines() if l.strip()]
    return lines[-n:]


def known(screen):
    """The KNOWN row this screen shows live, or None. A permission word anywhere vetoes the whole table."""
    if any(m in screen for m in PERMISSION_MARKS):
        return None
    last = tail(screen, 1)
    for name, marks, footer, key in KNOWN:
        if all(m in screen for m in marks) and last and footer in last[0]:
            return name, key
    return None


def is_dialog(screen):
    return any(m in l for l in tail(screen) for m in DIALOG_MARKS)


def question(screen):
    """The dialog's first line worth quoting (the top of the bottom block), for the row."""
    for l in tail(screen):
        s = l.strip(" │─╭╮╰╯")
        if s and not s.startswith("─"):
            return s[:160]
    return "(unreadable)"


def report(st, key, repo, window, kind, what, detail, apply_):
    """Raise the row once per stall. True when this pass raised it."""
    ent = st.setdefault(key, {})
    if ent.get("told") or ent.get("tries", 0) >= TRIES:
        return False
    name = row_name(window, kind)
    title = f"main:{window} is stuck: {what}"
    brief = (f"GOAL: main:{window} runs again, and whatever stalled it is fixed at its cause.\n"
             f"WHY: cc-stall saw it at {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())}: {what}. "
             f"The screen: {detail}\n"
             f"DONE: the window takes a turn again, and the cause is fixed or written up.")
    print(f"  stuck      main:{window:<24} {kind:<7} {what}")
    if not apply_:
        return False
    if raise_row(repo, name, title, brief):
        ent["told"] = True
        log(f"{window}\t{kind}\traised {repo}/{name}\t{what}")
        return True
    ent["tries"] = ent.get("tries", 0) + 1
    log(f"{window}\t{kind}\tboard refused {repo}/{name} (try {ent['tries']})")
    return False


def check_window(t, st, now, repo, win, apply_):
    wid, name, pane_pid, in_mode = win
    # ── the relaunch loop, read from scrollback whatever runs in the pane now ──
    hist = t.history(wid)
    if hist is not None:
        n = len(RELAUNCH_RE.findall(hist))
        lp = st.setdefault(f"{name}\tloop", {})
        prev, prev_t = lp.get("count"), lp.get("t", 0)
        if prev is None or n < prev or now - prev_t > LOOP_GAP:
            grew = 0                                   # first look, a cleared history or a long gap: a new baseline
        else:
            grew = n - prev
        lp["count"], lp["t"] = n, now
        lp["streak"] = lp.get("streak", 0) + 1 if grew > 0 else 0
        if grew >= LOOP_MIN or lp["streak"] >= LOOP_STREAK:
            report(st, f"{name}\tloop", repo, name, "loop", f"relaunched {grew} time(s) since the last look",
                   " | ".join(tail(hist, 4)), apply_)
        if grew > 0:
            lp.pop("still_since", None)
        else:                                          # a pass inside one cc-rc backoff sees no growth either:
            lp.setdefault("still_since", now)          # re-arm only once the count has stood still longer than that
            if now - lp["still_since"] > LOOP_REARM:
                lp.pop("told", None); lp.pop("tries", None)
    # ── a dialog at a live session ──
    dk = f"{name}\tdialog"
    if in_mode or not t.live_claude(pane_pid):
        if not in_mode:
            st.pop(dk, None)                           # nothing live to be stuck; a scroller is left as found
        return
    scr = t.screen(wid)
    if scr is None:
        return
    if WORKING in scr or not is_dialog(scr):
        st.pop(dk, None)                               # mid-turn, or free: healthy
        return
    k = known(scr)
    if k and apply_ and not st.get(dk, {}).get("pressed"):
        t.press(wid, k[1])
        log(f"{name}\t{k[0]}\tpressed {k[1]!r}")
        print(f"  cleared    main:{name:<24} {k[0]}")
        time.sleep(SETTLE)
        after = t.screen(wid)
        if after is not None and not is_dialog(after):
            st.pop(dk, None)
            return
        st.setdefault(dk, {})["pressed"] = True        # still up after its key: unknown from here on
        scr = after or scr
    elif k and not apply_:
        print(f"  would clear main:{name:<23} {k[0]}")
        return
    h = hashlib.sha1("\n".join(tail(scr)).encode()).hexdigest()[:12]
    d = st.setdefault(dk, {})
    if d.get("hash") != h:
        d.update({"hash": h, "first": now, "passes": 0}); d.pop("told", None); d.pop("tries", None)
    d["passes"] = d.get("passes", 0) + 1
    if d["passes"] >= 2 and now - d["first"] >= STAND_S:
        report(st, dk, repo, name, "dialog", f"a dialog has stood {int(now - d['first']) // 60} min", question(scr),
               apply_)


def load():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save(st):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(STATE))
        with os.fdopen(fd, "w") as f:
            json.dump(st, f, indent=1)
        os.replace(tmp, STATE)
    except OSError:
        pass


def run(t, apply_, now=None):
    st = load() if apply_ else {}
    now = now or time.time()
    repo = ctl()
    wins = t.windows()
    for w in wins:
        try:
            check_window(t, st, now, repo, w, apply_)
        except Exception as e:                         # one odd window never stops the pass
            log(f"{w[1]}\terror\t{e.__class__.__name__}: {e}")
    names = {w[1] for w in wins}
    for k in [k for k in st if k.split("\t")[0] not in names]:
        del st[k]                                      # a window that is gone takes its stalls with it
    if apply_:
        save(st)
    return st


# ── selfcheck ─────────────────────────────────────────────────────────────────────────────────────────────────
DEV = """────────────────────────────────
  WARNING: Loading development channels

  --dangerously-load-development-channels is for local channel development only.

  Channels: server:cc-slack

  ❯ 1. I am using this for local development
    2. Exit

  Enter to confirm · Esc to cancel
"""
LIMIT = """  ⎿  You've hit your session limit · resets 7am (America/New_York)
▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔▔
   What do you want to do?

   ❯ 1. Stop and wait for limit to reset
     2. Wait here, then continue automatically shortly
     3. Add funds to continue with usage credits

   Enter to confirm · Esc to cancel
"""
READY = """ ▐▛███▛█   Claude Code
❯ Try "fix typecheck errors"
  ⏵⏵ auto mode on (shift+tab to cycle)
"""
BUSY = "⏺ Reading files…\n  ✻ Thinking… (esc to interrupt)\n"
ODD = "  Something new happened\n\n  ❯ 1. Carry on\n    2. Stop\n\n  Enter to confirm · Esc to cancel\n"
PERM = "  Do you want to make this edit?\n  WARNING: Loading development channels\n  1. I am using this for local development\n  2. Exit\n  Enter to confirm · Esc to cancel\n"


class Fake:
    def __init__(self):
        self.wins, self.scr, self.hist, self.live, self.keys, self.after = [], {}, {}, {}, [], {}

    def add(self, name, scr, hist="", live=True, mode=False, after=None):
        wid = f"@{len(self.wins)}"
        self.wins.append((wid, name, wid, mode)); self.scr[wid] = scr; self.hist[wid] = hist
        self.live[wid] = live; self.after[wid] = after
        return wid

    def windows(self): return list(self.wins)
    def screen(self, wid): return self.scr[wid]
    def history(self, wid): return self.hist[wid]
    def live_claude(self, pid): return self.live[pid]

    def press(self, wid, key):
        self.keys.append((wid, key))
        if self.after[wid] is not None:
            self.scr[wid] = self.after[wid]
        return True


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-stall.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-stall.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    if argv and argv[0] not in ("--apply",):
        print(__doc__.split("\n\n")[0], file=sys.stderr)
        return 2
    try:
        run(Tmux(), "--apply" in argv)
    except Exception as e:                             # a timer job never goes red over one bad read
        log(f"-\terror\t{e.__class__.__name__}: {e}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
