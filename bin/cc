#!/usr/bin/env bash
# cc — Claude Code sessions on this box: tmux + git worktrees + shared board + autonomous workers.
#
#   cc                        attach tmux "main"
#   cc <repo>                 MAIN/planning session for ~/dev/<repo> (primary worktree, default branch)
#   cc <repo> <track>         TRACK session: own worktree + branch track/<track>, own context (created on first use)
#   cc <repo> <track> --session   …as a long-lived SESSION (board kind=session): a channel, not a task — never reconciled,
#                             never "done", never RUNNING on the Home tab (e.g. a course-builder's per-course sessions)
#   cc <repo> <track> --go "instruction" [--loop N] [--budget USD] [--model M]
#                             autonomous headless worker (ralph loop via cc-loop) on that track; ends with a PR
#                             --go "" re-dispatches the task.md already there (e.g. after answering a BLOCKED)
#                             the instruction is a covering note ADDED ABOVE any existing brief, never over it
#                             a note that prescribes the STEPS is refused here — by cc-brief's own arithmetic and
#                             by a small model reading the prose, which says what to cut; a judge that cannot
#                             answer at all does NOT stop the dispatch. CC_BRIEF_FORCE=1 sends it as typed and
#                             records that. What other live tracks are holding is computed in from the board.
#                             a worker runs on CC_WORKER_MODEL (claude-opus-5), not the box's interactive default; --model is
#                             the dispatcher's call for that one task (fable[1m] for creative or sub-orchestrating work)
#                             --resume-last: the first iteration continues this track's last session instead of
#                             a cold one — for a repair round, where re-deriving what it already found is the cost
#   cc <repo> <track> --say "text"           type text into that track's running interactive session
#   --go and --say are both REFUSED while the project is parked (`cc-pause on <repo>`, or `!pause` in its channel)
#   cc <repo> --orch <alias> ["brief"]       peer orchestrator session, its own Slack channel (archived when it exits)
#   cc handoff <repo> <track> [--over [PCT]]  ask the running session to journal a handoff, then restart it with
#                             fresh context; --over only if its context REALLY is that full (cc-context; bare = the 40% line)
#   cc handoff --overlap|--ready|--abandon|--status <target>   OVERLAPPING handoff (cc-handoff): the successor
#                             starts alongside, then retires its predecessor; target = <repo> or <repo>/<track>
#   cc resume                 menu of every session (mains + tracks) -> pick to reattach/resume
#   cc ls | cc digest         live windows + board status | full digest (cc digest --notify pushes it)
#   cc quick [doing|done] "…"  log a small task done without a track (Slack Home shows the last 24 h)
#   cc done <repo> <track>    push + open a PR into the default branch (nothing auto-merges)
#   cc rm <repo> <track>      remove a track (worktree + local branch + board entry + state)
#   cc board <args>           shared board (cc board show <repo>; --all also shows finished tracks)
#                             cc -c <repo> [track]  force --continue
#   cc slack on|off|status|setup|channels|mkchannel <repo>|archive <#chan>|manifest   Slack ↔ sessions (cc-slack): #<repo> reaches that repo's session
#                                              anyone in the channel is heard (membership is the access control), DMs are the owner's; new channels are private
#   cc slack project <name>   from INSIDE a member workspace: ask the daemon for #<workspace>--<name> and its lane (it makes them; 3 an hour)
#   cc rc status|restart      the always-on boot session (window box); restart to pick up new flags (ends its conversation)
set -uo pipefail
# Every session and worker starts through this script. Panes spawned from a systemd-started client (boot, cc-slackd) arrive without ~/bin,
# so make PATH right here once instead of relying on who spawned the window.
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac; export PATH
SELF=$(readlink -f "$0"); BIN=$(dirname "$SELF"); ROOT=$(dirname "$BIN")   # helpers come from the same bin/ as this copy (~/bin symlinks resolve into the repo; a track worktree tests its own); ROOT = the core tree
DEV="$HOME/dev"; SESSION=main; CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"; WTBASE="$HOME/.cc/worktrees"; STBASE="$HOME/.cc/state"; BOARD="$BIN/cc-board"
SLACKON="$HOME/.cc/slack/enabled"   # `cc slack on` creates it: sessions load the Slack channel server (bin/cc-slack)
chan_args(){ [ -f "$SLACKON" ] || return 0; printf '%s\n' --dangerously-load-development-channels "server:cc-slack"; }   # the server itself is registered in user scope by `cc slack on`; it finds its target from the cwd
model_args(){ local m; m=$("$BIN/cc-model" current 2>/dev/null) && [ -n "$m" ] && printf '%s\n%s\n' --model "$m"; return 0; }   # while the box's primary model is limited, new sessions start on the fallback
worker_model(){ "$BIN/cc-loop" worker-model "${1:-}"; }   # what a --go worker will run on; cc-loop owns that order (--model, then the override, then CC_WORKER_MODEL) and this only names it
chan_accept(){ [ -f "$SLACKON" ] && { export CC_SLACK_CHANNEL=1; ( "$BIN/cc-slack" accept-dialog "$1" >/dev/null 2>&1 & ); }; return 0; }   # auto-accepts the dev-channels dialog in that tmux window
sp_track(){ local repo="$1" track="$2" base="$3" st="$STBASE/$1/$2"
  printf %s "You are an orchestrated session for track '$track' of repo '$repo' (own git worktree, branch track/$track). Durable state: journal $st/progress.md (read it first if it exists; append dated entries: done / next / gotchas — a fresh session rehydrates from it), task $st/task.md if present. Board: 'cc board show $repo'; report with 'cc board note $repo $track \"...\"' and 'cc board status $repo $track running|review|blocked'. Your work is auto-committed and pushed to track/$track after every turn — do NOT run git commit/push yourself, and never touch branch '$base'. When done run 'cc done $repo $track' (opens a PR; do not merge). Reach the owner only when truly blocked: 'cc-notify -t \"$repo/$track\" \"question\"'. Batch independent tool calls in one turn; edit with targeted replacements, never whole-file rewrites. Keep answers concise; use subagents for large read/search work to protect your context — 'cc-context' says how full it actually is, and you will be told when it is time to write a handoff entry so a fresh session can take over."; }
sp_main(){ local repo="$1" base="$2"
  printf %s "You are the planning/coordination session for repo '$repo' (primary worktree, branch '$base'). Board: 'cc board show $repo'. To dispatch work: 'cc board add $repo <track> \"<title>\" \"<brief>\"' (the brief's one home is ~/.cc/state/$repo/<track>/task.md; add and --go only ever ADD to it — replacing one is 'cc board set $repo <track> instructions \"...\"') then either 'cc $repo <track> --go \"<instructions>\" [--loop N]' (autonomous headless worker on its own worktree; ends with a PR) or tell the operator to open 'cc $repo <track>' interactively. Send a running track a message: 'cc $repo <track> --say \"...\"'. Status of everything: 'cc digest'. Small fixes you make yourself (no track): log them with 'cc quick \"<what>\"' so the owner sees them on the Slack Home tab. Reach the owner: 'cc-notify -t \"$repo\" \"...\"'. You are on '$base' — your edits are NOT auto-committed; keep '$base' clean, let tracks do the writing, and review their PRs (never merge without the owner). Batch independent tool calls in one turn; edit with targeted replacements, never whole-file rewrites. Keep answers concise; use subagents for large reads; 'cc-context' says how full a session's context really is, and 'cc handoff <repo> <track> --over' hands one off only when it has really crossed the line."; }
member_facing(){ [ -f "$1/.cc/member-facing" ]; }   # marker file, like .cc/track: cc-guard reads it off the cwd and gates that session as role=member
MEMBER_SP="This session is MEMBER-FACING (the repo carries .cc/member-facing): anybody in its Slack channel can talk to it, so cc-guard denies the owner gates DETERMINISTICALLY — merging/deploying, host, service and destructive changes, external comms, dispatching workers, reading the box's secrets, re-wiring Slack, and edits outside this directory. Do not try to work around a denial: say plainly that it needs the owner and escalate with cc-notify (which stays allowed — inside a member workspace's boundary it goes out over that workspace's own Slack link and reaches the owner, and tells you if it did not). A NEW PROJECT CHANNEL IS NOT ONE OF THOSE. In a member workspace you ask for one yourself: \`cc slack project <name>\` gets you #<workspace>--<name>, its updates lane and its board row (the folder comes with the first session), at most 3 an hour. The name is always under your own workspace — the workspace half is not yours to choose, and an ask that tries to carry one is refused with the reason. There is also a human way in, \`new project <name>\` typed in the workspace channel, but it ONLY counts from the member or the owner: a session saying it is ignored, so ask a person for that line rather than posting it yourself. Either way, do not run cc slack mkchannel and do not send the owner a request the box answers by itself."
MEMBER_SPEND="$STBASE/member-spend.json"   # {"<handle>": {"day": "YYYY-MM-DD", "usd": n}} — the ledger behind the per-workspace daily cap
member_workspace(){ [ -f "$DEV/$1/.cc/member-workspace" ]; }   # ~/dev/<handle> is one member's whole world: docs/design-member-workspaces.md (overlay)
inside(){ [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; }   # set by `cc-sandbox member`, never by hand: this process runs INSIDE a workspace's boundary
member_credential(){   # $1 handle · $2 track ("" = the main session) — THE HOST'S HALF OF THE CREDENTIAL WALL. A workspace
  # runs only on a credential minted for it at ~/.cc/members/<h>/credentials.json (`cc-sandbox mint <h>` makes one, `cc-sandbox
  # member` refuses without one), but that refusal landed in a tmux pane nobody reads: a member's message autostarted a
  # window that died with the reason in it,
  # the board row said running, and neither the member nor the owner heard a thing (review-156d). So the same file is checked
  # HERE, before any window or board write: without it #<h> gets one line (the member sees why there is no answer), the owner
  # is paged once a day (a stamp beside the file; released when the page failed, so the next attempt retries), and nothing
  # opens. Returns 1 = do not start.
  local h="$1" tr="${2:-}" own="$HOME/.cc/members/$1/credentials.json" stamp="$HOME/.cc/members/$1/credential-asked" what day
  [ -s "$own" ] && jq -e '.claudeAiOauth.accessToken' "$own" >/dev/null 2>&1 && return 0
  what="\`$h\`"; [ -n "$tr" ] && what="\`$h/$tr\`"
  echo "cc: $h has no credential of its own ($own) — nothing starts until one is minted (cc-sandbox mint $h); #$h was told, the owner is paged (once a day)."
  "$BIN/cc-slack" post -c "#$h" "$what has no session yet: this workspace needs a credential minted by the owner before it can answer. He has been asked." >/dev/null 2>&1 || true
  day=$(date -u +%F); mkdir -p "$(dirname "$stamp")"
  if [ "$(cat "$stamp" 2>/dev/null)" != "$day" ]; then
    "$BIN/cc-notify" -t "$h" --owner -- "$what needs a credential minted: a message in #$h tried to start its session and there is none at $own. Mint one on the box: \`cc-sandbox mint $h\` walks that person's login in a throwaway HOME and installs what it produced. The next message starts the session. If you mint your OWN account it installs that too and says so — whoever uses that workspace can then use the account anywhere." >/dev/null 2>&1 && echo "$day" > "$stamp"
  fi
  return 1; }
# THE BOUNDARY (docs/design-member-workspaces.md). A member workspace's session and every worker it dispatches run inside
# `cc-sandbox member <handle> [<track>]`: only ~/dev/<handle>, its tracks and its member-scoped Slack socket exist there. The
# host side of a launch (tmux, the board row, the budget ledger, the window) is this script OUTSIDE; claude and cc-loop go
# in. Inside there is no tmux and no ledger, so `cc <h> <track> --go` writes the brief and asks the daemon (cc-slack dispatch)
# to run the same command out here. The bare internals (__run*) refuse a workspace repo outside the boundary: depth.
MEMBER_WS_SP="This session belongs to a MEMBER WORKSPACE and runs INSIDE its boundary: only its own folder, its tracks and its Slack channels exist here — nothing else of the box does, by design, so never treat a missing path, socket or tool as a fault to work around. Reaching the owner works from in here: 'cc-notify -t \"<what>\" \"...\"' is delivered to him by the box (it exits non-zero if it was not), and reply(needs_owner) marks the thread for him. Dispatch work with 'cc <handle> <track> --go \"...\"' (the box runs it inside the same boundary and charges the workspace's daily budget); a track session is opened from Slack (#<handle>--<track>) or by the owner, never from here."
member_gate(){   # $1 repo — a member workspace dispatches only within MEMBER_DAILY_USD/day. The cost is PRE-charged at
  # dispatch (budget x loops), so the cap bounds exposure rather than accounting for it, and the owner is told in the
  # workspace's own updates lane when it bites. Nothing here applies to any other repo.
  member_workspace "$1" || return 0
  local repo="$1" budget="" loops="${LOOPN:-1}" prev="" a want cap day cur spent mention=0
  if [ ${#XTRA[@]} -gt 0 ]; then for a in "${XTRA[@]}"; do [ "$prev" = --budget ] && budget="$a"; prev="$a"; done; fi
  # `--budget 1e9` was charged as $8 (not a number → the default) and passed through as-is: a cap the dispatch it
  # gates then ignores. A budget the ledger cannot add up is refused here, before anything is charged (cc-loop too).
  if [ -n "$budget" ] && ! [[ "$budget" =~ ^[0-9]+([.][0-9]+)?$ ]]; then echo "cc: --budget must be a plain number in USD (got '$budget')"; return 1; fi
  [ -n "$budget" ] || budget=8      # cc-loop's own default when --budget is not given
  case "$loops" in ''|*[!0-9]*) loops=1;; esac
  want=$(awk -v b="$budget" -v n="$loops" 'BEGIN{printf "%.2f", b * n}')
  cap=$("$BIN/cc-config" get MEMBER_DAILY_USD 20 2>/dev/null) || cap=20   # >= cc-loop's own default budget ($8/iter), or every plain --go is refused
  case "$cap" in ''|*[!0-9.]*) cap=20;; esac
  day=$(date -u +%F); mkdir -p "$STBASE"
  exec 8>"$MEMBER_SPEND.lock" || return 0; flock 8            # two dispatches at once must not both see the same headroom
  cur=$(jq -c . "$MEMBER_SPEND" 2>/dev/null) || cur='{}'; [ -n "$cur" ] || cur='{}'
  spent=$(printf '%s' "$cur" | jq -r --arg h "$repo" --arg d "$day" 'if (.[$h].day // "") == $d then (.[$h].usd // 0) else 0 end' 2>/dev/null) || spent=0
  case "$spent" in ''|*[!0-9.]*) spent=0;; esac
  if awk -v s="$spent" -v w="$want" -v c="$cap" 'BEGIN{exit !(s + w > c)}'; then
    # Only the owner can raise the cap, so a refusal is a decision waiting on him rather than an ambient event: it
    # @-mentions him in the workspace's own channel. ONCE a day — the day-stamp is claimed here, still under the
    # ledger's lock, so of two refusals racing (or fifty in a --loop) exactly one posts and every other stays silent.
    if [ "$(printf '%s' "$cur" | jq -r --arg h "$repo" --arg d "$day" '(.[$h].mentioned // "") == $d' 2>/dev/null)" != true ]; then
      printf '%s' "$cur" | jq --arg h "$repo" --arg d "$day" \
        '.[$h] = ((if (.[$h].day // "") == $d then .[$h] else {} end) + {day: $d, mentioned: $d})' > "$MEMBER_SPEND.tmp" \
        && mv "$MEMBER_SPEND.tmp" "$MEMBER_SPEND" && mention=1
    fi
    exec 8>&-
    echo "cc: $repo has used \$$spent of its \$$cap/day and this dispatch asks for \$$want — refused."
    "$BIN/cc-slack" post -c "#$repo-updates" "💸 \`$repo\` has used its \$$cap for today, so a dispatch was refused. Raise \`MEMBER_DAILY_USD\` or let it roll over." >/dev/null 2>&1 || true
    if [ "$mention" = 1 ]; then
      # DIRECT to the workspace's main channel: cc-notify's escalation walk turns a --decision raised from a
      # member-facing cwd — and the workspace's own session is exactly who dispatches here — into an owner DM
      # and drops the mention (review of #168). cmd_post prefixes <@owner>; -c is cwd-independent. The
      # day-stamp holds only for a message somebody could hear: a failed post releases the claim, so the
      # next refusal retries instead of inheriting a stamp for silence.
      if ! "$BIN/cc-slack" post -c "#$repo" --mention \
        "\`$repo\` hit its \$$cap/day (\$$spent used, this run asked \$$want) — raise it: \`cc-config set MEMBER_DAILY_USD <n>\`, or it resets at 00:00 UTC." >/dev/null 2>&1; then
        { exec 8>"$MEMBER_SPEND.lock" && flock 8 \
          && jq --arg h "$repo" 'del(.[$h].mentioned)' "$MEMBER_SPEND" > "$MEMBER_SPEND.tmp" 2>/dev/null \
          && mv "$MEMBER_SPEND.tmp" "$MEMBER_SPEND"; } || true
        exec 8>&-
      fi
    fi
    return 1
  fi
  printf '%s' "$cur" | jq --arg h "$repo" --arg d "$day" --argjson w "$want" \
    '.[$h] = ((if (.[$h].day // "") == $d then .[$h] else {} end) + {day: $d, usd: ((if (.[$h].day // "") == $d then (.[$h].usd // 0) else 0 end) + $w)})' > "$MEMBER_SPEND.tmp" \
    && mv "$MEMBER_SPEND.tmp" "$MEMBER_SPEND"
  exec 8>&-
  return 0
}
write_brief(){   # $st/task.md from $text — THE BRIEF HAS ONE HOME (see the --go case for the history)
  # THE SHAPE IS CHECKED AT THE DOOR, not remembered by whoever is dispatching (cc-brief): a note that prescribes
  # the steps is refused here, with the lines that made it one, before anything is written. CC_BRIEF_FORCE=1 turns
  # the refusal into a flag for a note that really must carry a command. What is IN FLIGHT is then computed from
  # the board into the brief, so no dispatcher types a list of files that was true when they typed it.
  # Two gates, and they answer differently on purpose. `check` is arithmetic: the shapes it can prove. `judge`
  # is a small model reading the prose, because a page of prescription written as paragraphs is what got past two
  # written copies of the rule — it exits 1 when it READ the brief and rejected it (hard, with what to cut) and 2
  # when it could not judge at all (no binary, timeout, usage limit), and 2 dispatches: a box that cannot start
  # work because a judge is down is worse than a box that dispatches a wordy brief.
  if [ -n "$text" ]; then
    printf '%s\n' "$text" | "$BIN/cc-brief" check - --for "$repo/$track" || return 1
    printf '%s\n' "$text" | "$BIN/cc-brief" judge - --for "$repo/$track"; [ $? = 1 ] && return 1
  fi
  mkdir -p "$st"
  "$BOARD" get "$repo" "$track" instructions >/dev/null 2>&1   # migrates a pre-#94 board copy into the file, once
  if [ -n "$text" ]; then
    t0=$(printf '%s' "$text"); n=$(printf '%s' "$t0" | wc -c)   # both sides trailing-newline-stripped by $( )
    if [ "$(head -c "$n" "$st/task.md" 2>/dev/null)" != "$t0" ]; then   # not already on top (a re-dispatch
      { printf '%s\n' "$text"                                          # repeating its note): don't stack it up.
        if [ -s "$st/task.md" ]; then echo; cat "$st/task.md"; fi; } > "$st/task.md.tmp"   # this only ever looks
      mv "$st/task.md.tmp" "$st/task.md"                                # at the head, which this same code
    fi                                                                  # wrote — never at the brief below it
  else [ -s "$st/task.md" ] || { echo "cc: --go \"\" re-dispatches $st/task.md, but it is empty or missing"; exit 1; }; fi
  "$BIN/cc-brief" refresh "$repo" "$track" 2>/dev/null   # …and the IN FLIGHT block is recomputed at every dispatch,
  return 0; }                                            # including a bare --go "" — that is when it must be true
ensure_main(){ tmux has-session -t "$SESSION" 2>/dev/null || "$BIN/cc-boot"; }   # server creation goes through tmux-main.service (cgroup ownership; 2026-08-26 incident)
attach_main(){ [ -t 0 ] || return 0; if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$SESSION" 2>/dev/null || true; else exec tmux attach -t "$SESSION"; fi; }
win_id(){ tmux list-windows -t "$SESSION" -F '#{window_id} #W' 2>/dev/null | awk -v n="$1" '$2==n{print $1; exit}'; }   # address windows by id: names with . or / break -t main:<name>
have_window(){ [ -n "$(win_id "$1")" ]; }
pane_live(){ local p; p=$(tmux list-panes -t "$(win_id "$1")" -F '#{pane_pid}' 2>/dev/null | head -1); [ -n "$p" ] && pgrep -P "$p" >/dev/null 2>&1; }   # wrapper bash always shows as pane cmd; a session/worker = it has a child
# CC'S OWN GIT RUNS EXECUTE NOTHING OF THE REPO. Creating a worktree is plumbing, not a checkout somebody asked for, and
# for a MEMBER workspace the repo's contents are written from inside a boundary: a post-checkout hook there would run out
# here as the owner. cc-sandbox holds .git/config and .git/hooks read-only inside; this is the same wall from the outside.
GITNH=(-c core.hooksPath=/dev/null)
member_gitdir(){   # $1 repo $2 worktree → 0 when a member workspace's track really hangs off ~/dev/<handle>/.git (an ordinary repo always passes)
  # The gitlink and the admin dir behind it are written from INSIDE the boundary (`cc <h> <t> --go` runs ensure_track in there), so `.git`
  # can name a member git dir whose config carries core.fsmonitor or an ext:: remote — code the host-side `cc done` would run as the
  # owner, hooksPath pin or not (review-156c). Nothing but this rev-parse touches the worktree until its common dir is the workspace's own.
  member_workspace "$1" || return 0
  local main gcd; main=$(git "${GITNH[@]}" -C "$DEV/$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$DEV/$1/.git")
  gcd=$(git "${GITNH[@]}" -C "$2" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  [ "$gcd" = "$main" ] && return 0
  echo "cc: refusing to run git in $2 — its .git resolves to ${gcd:-nothing}, not $main: a member workspace's track hangs off ~/dev/$1/.git or nothing runs in it"; return 1; }
default_branch(){ git "${GITNH[@]}" -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || echo main; }
valid_name(){ [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$ ]] || { echo "cc: invalid repo/track name '$1' (allowed: ^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}\$) — no /, no . or .., no leading -"; exit 1; }; }
lock(){ mkdir -p "$(dirname "$1")"; exec 9>"$1"; flock 9; }   # two concurrent `cc <repo> <track>` would otherwise create twin windows tmux can no longer address
unlock(){ exec 9>&-; }
usage(){ sed -n '2,26p' "$0"; }

ensure_track(){  # $1 repo $2 track -> creates worktree/branch/state/board entry if missing
  local repo="$1" track="$2" wt="$WTBASE/$1/$2" branch="track/$2" gcd base
  valid_name "$repo"; valid_name "$track"
  git "${GITNH[@]}" -C "$DEV/$repo" rev-parse --git-dir >/dev/null 2>&1 || { echo "cc: ~/dev/$repo is not a git repo — tracks need git"; exit 1; }
  git "${GITNH[@]}" -C "$DEV/$repo" check-ref-format --branch "$branch" >/dev/null 2>&1 || { echo "cc: '$branch' is not a usable branch name"; exit 1; }
  if [ ! -d "$wt" ]; then
    mkdir -p "$WTBASE/$repo"; git "${GITNH[@]}" -C "$DEV/$repo" worktree prune   # a hand-deleted dir stays registered ("missing but already registered")
    git "${GITNH[@]}" -C "$DEV/$repo" fetch -q origin 2>/dev/null || true; base=$(default_branch "$DEV/$repo")
    if git "${GITNH[@]}" -C "$DEV/$repo" show-ref --verify --quiet "refs/heads/$branch"; then git "${GITNH[@]}" -C "$DEV/$repo" worktree add -q "$wt" "$branch"
    elif git "${GITNH[@]}" -C "$DEV/$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then git "${GITNH[@]}" -C "$DEV/$repo" worktree add -q --track -b "$branch" "$wt" "origin/$branch"   # re-created track: keep its upstream, don't fork from local HEAD
    elif git "${GITNH[@]}" -C "$DEV/$repo" show-ref --verify --quiet "refs/remotes/origin/$base"; then git "${GITNH[@]}" -C "$DEV/$repo" worktree add -q -b "$branch" "$wt" "origin/$base"
    else git "${GITNH[@]}" -C "$DEV/$repo" worktree add -q -b "$branch" "$wt"; fi
    git "${GITNH[@]}" -C "$wt" rev-parse --show-toplevel >/dev/null 2>&1 || { rm -rf "$wt"; echo "cc: could not create the worktree $wt (git error above) — nothing was stamped"; exit 1; }
    gcd=$(git "${GITNH[@]}" -C "$DEV/$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$DEV/$repo/.git")
    mkdir -p "$gcd/info"; grep -qxF '.cc/' "$gcd/info/exclude" 2>/dev/null || echo '.cc/' >> "$gcd/info/exclude"
    mkdir -p "$wt/.cc"; printf '%s\n%s\n' "$repo" "$track" > "$wt/.cc/track"
    "$BIN/cc-trust" "$wt" >/dev/null 2>&1 || true
  fi
  mkdir -p "$STBASE/$repo/$track"
  "$BOARD" json "$repo" >/dev/null 2>&1 || "$BOARD" init "$repo" "$DEV/$repo" "$(default_branch "$DEV/$repo")" >/dev/null
  [ -n "$("$BOARD" get "$repo" "$track" branch 2>/dev/null)" ] || "$BOARD" add "$repo" "$track" "$track" "" >/dev/null
  "$BOARD" set "$repo" "$track" worktree "$wt"
  [ -n "$("$BOARD" get "$repo" "$track" session_id)" ] || "$BOARD" set "$repo" "$track" session_id "$(cat /proc/sys/kernel/random/uuid)"
}

case "${1:-}" in __run|__runmain|__runplain|__runorch|__runnext)   # depth: a workspace session starts through __runmember → cc-sandbox member, never bare
  r="${2%%/*}"; member_workspace "$r" && ! inside && { echo "cc: ~/dev/$r is a member workspace — its sessions run only inside the boundary (cc $r ...), never bare on the host. Refused."; exit 1; };; esac
case "${1:-}" in
  "") ensure_main; attach_main; exit 0 ;;
  -h|--help) usage; exit 0 ;;
  board) shift; exec "$BOARD" "$@" ;;
  slack)  # cc slack on|off|status|setup|channels|mkchannel|manifest|project — Slack ↔ sessions through Claude Code channels (bin/cc-slack, unit cc-slackd)
    case "${2:-status}" in
      on)  mkdir -p ~/.cc/slack; [ -x ~/.cc/slack/venv/bin/python ] || { python3 -m venv ~/.cc/slack/venv && ~/.cc/slack/venv/bin/pip install -q -r "$ROOT/slack/requirements.txt"; }
           "$CLAUDE" mcp remove --scope user cc-slack >/dev/null 2>&1; "$CLAUDE" mcp add --scope user cc-slack -- "$BIN/cc-slack" channel >/dev/null && echo "registered MCP server cc-slack (user scope)"
           systemctl --user daemon-reload; systemctl --user enable --now cc-slackd.service && touch "$SLACKON"
           echo "cc-slack on: sessions started from now on carry the Slack channel. Live sessions pick it up after a restart (cc handoff <repo> <track>; boot session: cc rc restart)."
           "$BIN/cc-slack" status;;
      off) rm -f "$SLACKON"; "$CLAUDE" mcp remove --scope user cc-slack >/dev/null 2>&1; systemctl --user disable --now cc-slackd.service; echo "cc-slack off: new sessions have no Slack channel; live ones keep theirs until restarted";;
      setup|channels|status|mkchannel|archive|orch-channel|manifest|project) shift; exec "$BIN/cc-slack" "$@";;   # `project` is
        # the member workspace's own door (MEMBER_SP tells a session to type it): without it here the advertised
        # command dies on the usage arm below, having created nothing and said nothing a session can act on
      *) echo "cc slack on|off|status|setup|channels|mkchannel <repo>|archive <#chan>|manifest|project <name>"; exit 1;;
    esac; exit 0 ;;
  rc)  # cc rc status|restart — the always-on boot session (window "box": cc-rc → Remote Control "$(hostname)", Slack target "box")
    case "${2:-status}" in
      restart) tmux has-session -t "$SESSION" 2>/dev/null || { ensure_main; echo "tmux $SESSION was down — started it, and the boot session came up with it (nothing to restart)."; exit 0; }
               w=$(win_id box)   # only now: before ensure_main the server may not exist yet, and we would open a second box window
               tmux run-shell -b "tmux new-window -d -t $SESSION -n box -c $DEV $BIN/cc-rc${w:+; tmux kill-window -t $w}"
               echo "boot session restarting (window box). The old Remote-Control conversation ends — in the phone app pick session '$(hostname)' again.";;
      *) w=$(win_id box); if [ -n "$w" ]; then echo "boot window box: $(tmux list-panes -t "$w" -F '#{pane_current_command}' | head -1); Slack channel for new sessions: $([ -f "$SLACKON" ] && echo on || echo off)"; else echo "no boot window — cc rc restart"; fi;;
    esac; exit 0 ;;
  digest) shift; exec "$BIN/cc-digest" "$@" ;;
  quick)   # cc quick ["doing"|"done"] "<text>" — small tasks a session does itself (no track): shown on the Slack Home tab for 24 h
    st="done"; case "${2:-}" in doing|"done") st="$2"; shift;; esac; txt="${2:-}"; [ -n "$txt" ] || { echo 'cc quick [doing|done] "<text>"'; exit 2; }
    r=$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"); mkdir -p "$HOME/.cc/state"
    printf '%s\t%s\t%s\t%s\n' "$(date -u +%s)" "$st" "$r" "$(tr -d '\t\n' <<<"$txt")" >> "$HOME/.cc/state/quick.log"; exit 0 ;;
  ls) echo "== live windows (tmux $SESSION) =="; tmux list-windows -t "$SESSION" -F '  #I #W  [#{pane_current_command}]' 2>/dev/null || echo "  (none)"
      lim=$("$BIN/cc-limit" status 2>/dev/null) && echo "== ⏳ Claude $lim =="
      echo "== board =="
      declare -A CTX; while IFS=$'\t' read -r cr ct cp _ _ _ ca cl cpend; do   # last measured context per track (the Stop hook records it; newest first, so the first wins)
        [ -n "${cr:-}" ] && [ "$cr" != - ] && [ -z "${CTX[$cr/$ct]:-}" ] && [ "${ca:-0}" -lt 86400 ] || continue
        CTX["$cr/$ct"]="  ctx $cp%"; case "$cl" in journal) CTX["$cr/$ct"]+=" journal!";; handoff|ceiling) CTX["$cr/$ct"]+=" handoff!";; esac
        [ "$cpend" = pending ] && CTX["$cr/$ct"]+=" (pending)"
      done < <("$BIN/cc-context" --all 2>/dev/null)
      # cc-reconcile is the sole decider of effective state (review rec #7): its snapshot outranks the word a worker
      # last wrote between turns, and carries whether a stopped track waits on a PERSON or on the CLOCK. Missing or
      # stale, the board's own word stands — `cc ls` never blocks on anything.
      declare -A EFF WHO WHY   # `cc-reconcile view`: one row per track — repo/track, state, waiting_on, why; none when the snapshot is missing or stale
      while IFS=$'\t' read -r k es ew ey; do [ -n "${k:-}" ] && { EFF["$k"]=$es; WHO["$k"]=$ew; WHY["$k"]=$ey; }
      done < <("$BIN/cc-reconcile" view 2>/dev/null)
      while IFS=$'\t' read -r r t s ti; do [ -z "$r" ] && continue; p=""   # the checkpoint hook fails quietly by design; these two files are how you hear about it
        [ -f "$WTBASE/$r/$t/.cc/checkpoint.err" ] && p="  commit!"; [ -f "$WTBASE/$r/$t/.cc/push.err" ] && p="$p  push!"
        s="${EFF[$r/$t]:-$s}"; w="${WHY[$r/$t]:-}"; w="${w:0:50}"   # :- matters: with a stale snapshot every key here is unset, and `set -u` would kill the whole listing
        case "$s" in waiting) p="  ❓ ${w:-waiting on you}$p";; esac
        [ "${WHO[$r/$t]:-}" = clock ] && p="  ⏳ held by the usage limit$p"   # whatever word it wears: a loop sitting out the limit is not working
        printf "  %-16s %-14s %-9s %s%s%s\n" "$r" "$t" "$s" "$ti" "${CTX[$r/$t]:-}" "$p"; done < <("$BOARD" list 2>/dev/null); exit 0 ;;
  resume)
    echo "Sessions:"; i=0; declare -a SEL
    while read -r w; do case "$w" in */*|box) ;; *) i=$((i+1)); SEL[$i]="main|$w|"; printf "  %2d) [main]   %s\n" "$i" "$w";; esac; done < <(tmux list-windows -t "$SESSION" -F '#W' 2>/dev/null)
    while IFS=$'\t' read -r repo tr st ti; do [ -z "$repo" ] && continue; i=$((i+1)); SEL[$i]="track|$repo|$tr"; live=""; have_window "$repo/$tr" && live=" (live)"; printf "  %2d) [%s]%s %s / %s — %s\n" "$i" "$st" "$live" "$repo" "$tr" "$ti"; done < <("$BOARD" list 2>/dev/null)
    [ "$i" = 0 ] && { echo "  (nothing yet — start with: cc <repo> [track])"; exit 0; }
    printf "pick #: "; read -r n; [ -z "${n:-}" ] && exit 0
    [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le "$i" ] || { echo "no such option"; exit 1; }
    IFS='|' read -r kind a2 a3 <<<"${SEL[$n]}"
    if [ "$kind" = main ]; then ensure_main; tmux select-window -t "$(win_id "$a2")"; attach_main; else exec "$SELF" "$a2" "$a3"; fi; exit 0 ;;
  done)
    repo="${2:?repo}"; track="${3:?track}"; valid_name "$repo"; valid_name "$track"
    wt="$WTBASE/$repo/$track"; [ -d "$wt" ] || { echo "no worktree for $repo/$track"; exit 1; }
    # Two callers reach this for one track — the loop when the worker writes STATUS: DONE, a session when it finishes by
    # hand — and each used to open its own PR (#24/#25, #29/#30, same head SHA). One at a time, then reuse what is there.
    mkdir -p "$wt/.cc"; exec 9>"$wt/.cc/done.lock"
    flock -w "${CC_DONE_LOCK_WAIT:-600}" 9 || { echo "cc: another 'cc done $repo $track' is still running — nothing opened"; exit 1; }   # CC_DONE_LOCK_WAIT: test hook
    base=$(default_branch "$DEV/$repo"); branch="track/$track"
    member_gitdir "$repo" "$wt" || exit 1   # BEFORE any git runs in the worktree: a redirected .git is refused, not run (review-156c)
    # the MAIN checkout's hooks, never the worktree's: a member could otherwise plant a git dir whose hooks this
    # host-side commit would run as the owner (review-156b) — same pin cc-loop applies to its own git calls
    hp=$(git -C "$DEV/$repo" config --type=path --get core.hooksPath 2>/dev/null); case "$hp" in "") hp="$DEV/$repo/.git/hooks";; /*) ;; *) hp="$DEV/$repo/$hp";; esac
    HG=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp")
    ( cd "$wt" && env CC_ROLE=worker "${HG[@]}" "$BIN/cc-checkpoint" ) || true
    if member_workspace "$repo" && ! git -C "$wt" remote get-url origin >/dev/null 2>&1; then   # a workspace lives on the box alone: the branch IS the delivery
      "$BOARD" status "$repo" "$track" done >/dev/null; "$BOARD" note "$repo" "$track" "cc done: no remote, so no PR — the work is on track/$track in ~/dev/$repo" >/dev/null 2>&1 || true
      echo "done: $repo has no remote, so no PR — track/$track is committed in ~/dev/$repo"; exit 0; fi
    if git -C "$wt" remote get-url origin >/dev/null 2>&1; then   # a PR on an un-pushed branch is worse than no PR: stop here and say why
      # cc-checkpoint --push owns the push, lease and all — a worker that rebased its own branch would otherwise be
      # rejected non-fast-forward here and finish green with no PR at all (2026-08-31). Exit 2 is the one case the
      # lease refuses: something else wrote to the branch. It has already journalled and told the board; do not
      # open a PR over the top of it.
      member_gitdir "$repo" "$wt" || exit 1   # the same wall in front of the push (review-156c)
      ( cd "$wt" && env CC_ROLE=worker "${HG[@]}" "$BIN/cc-checkpoint" --push ) || { echo "cc: push failed — no PR opened (reason above; also in $wt/.cc/push.err)"; exit 1; }
    fi
    title=$("$BOARD" get "$repo" "$track" title); [ -z "$title" ] && title="$track"
    instr=$("$BOARD" get "$repo" "$track" instructions)   # the brief, from its one home: $STBASE/$repo/$track/task.md
    url=$(cd "$wt" && gh pr list --head "$branch" --state open --json url -q '.[0].url' 2>/dev/null)   # `gh pr view` also returns a MERGED PR and would silently reuse it
    if [ -z "$url" ]; then   # no OPEN PR is not the same as no PR: a squash-merge deletes the branch, so the late caller
      tip=$(git -C "$wt" rev-parse "$branch" 2>/dev/null)   # saw nothing open and opened a duplicate of commits already merged
      merged=$(cd "$wt" && gh pr list --head "$branch" --state merged --limit 20 --json url,headRefOid -q "[.[]|select(.headRefOid==\"$tip\")][0].url" 2>/dev/null)
      if [ -n "$merged" ]; then   # same tip, already merged: nothing to review — no second PR and no second approval card
        "$BOARD" set "$repo" "$track" pr "$merged"; "$BOARD" status "$repo" "$track" merged >/dev/null
        "$BOARD" note "$repo" "$track" "cc done: $branch was already merged as $merged (no new commits) — no duplicate PR" >/dev/null 2>&1 || true
        echo "already merged: $merged (no commits on $branch beyond it)"
        [ -f "$SLACKON" ] && "$BIN/cc-slack" archive --orch "$repo" "$track" >/dev/null 2>&1
        exit 0
      fi
      url=$(cd "$wt" && gh pr create --base "$base" --head "$branch" --title "$title" --body "$(printf '%s\n\n---\nOpened by cc from track %s. Review before merge.\nJournal: ~/.cc/state/%s/%s/progress.md' "$instr" "$track" "$repo" "$track")" 2>&1 | grep -oE 'https://github.com/[^ ]+' | head -1)
    fi
    "$BIN/cc-scope" check "$repo" --track "$track" 2>/dev/null   # 'done' measured against what was asked: the unsettled asks this track was meant to close, printed where the session still sees them. Never fatal — a ledger does not get to block a PR
    if [ -n "$url" ]; then "$BOARD" set "$repo" "$track" pr "$url"; "$BOARD" status "$repo" "$track" review >/dev/null; echo "PR: $url"; echo "land it with:  cc-land $repo ${url##*/}   (gates, merge, card, board, ledger, install, units, restarts — or just 👍 the card to merge)"; [ -f "$SLACKON" ] && "$BIN/cc-slack" post-approval "$repo" "$url" >/dev/null 2>&1 || true; else echo "PR creation failed (no remote? try: cd $wt && gh pr create --base $base)"; "$BOARD" status "$repo" "$track" review >/dev/null; fi
    [ -f "$SLACKON" ] && "$BIN/cc-slack" archive --orch "$repo" "$track" >/dev/null 2>&1   # if that name was an orch with its own channel, it is done: archive it
    exit 0 ;;
  rm)
    repo="${2:?repo}"; track="${3:?track}"; valid_name "$repo"; valid_name "$track"; wt="$WTBASE/$repo/$track"
    real=$(readlink -f "$wt" 2>/dev/null); [ -n "$real" ] || real=$(readlink -m "$wt")
    case "$real" in "$WTBASE"/?*/?*) ;; *) echo "cc: refusing to remove '$wt' — it resolves to $real, outside $WTBASE"; exit 1;; esac
    id=$(win_id "$repo/$track"); [ -n "$id" ] && tmux kill-window -t "$id" 2>/dev/null
    git -C "$DEV/$repo" worktree remove --force "$wt" 2>/dev/null || rm -rf "$real"
    git "${GITNH[@]}" -C "$DEV/$repo" worktree prune 2>/dev/null; git -C "$DEV/$repo" branch -D "track/$track" >/dev/null 2>&1 || true
    "$BIN/cc-trust" rm "$wt" >/dev/null 2>&1 || true
    rm -rf "${STBASE:?}/${repo:?}/${track:?}"; rmdir "$WTBASE/$repo" "$STBASE/$repo" 2>/dev/null   # leave no empty per-repo shells behind
    "$BOARD" rm "$repo" "$track" >/dev/null 2>&1; echo "removed $repo/$track (remote branch, if pushed, left intact)"; exit 0 ;;
  handoff)   # ONE OWNER: every phase of a handoff lives in cc-handoff (review rec #8), including the
    # stop-then-restart sequence that used to be spelled out right here. `cc handoff` is the spelling, not the
    # implementation — so the overlap, the deadline, the old path and the sweep are all read in one file.
    case "${2:-}" in --*) shift; exec "$BIN/cc-handoff" "$@";; esac   # --overlap/--ready/--abandon/--status/--replace <target>
    repo="${2:?repo}"; track="${3:?track}"; valid_name "$repo"; valid_name "$track"; shift 3
    exec "$BIN/cc-handoff" --replace "$repo/$track" "$@" ;;
  __run)   # internal: interactive track session inside its worktree
    repo="$2"; track="$3"; force_cont="${4:-}"; wt="$WTBASE/$repo/$track"; st="$STBASE/$repo/$track"; cd "$wt" || exit 1
    sid=$("$BOARD" get "$repo" "$track" session_id); started=$("$BOARD" get "$repo" "$track" started); base=$(default_branch "$DEV/$repo")
    sp=$(sp_track "$repo" "$track" "$base")
    args=(--append-system-prompt "$sp" --remote-control "$repo/$track"); mapfile -t CH < <(chan_args "$repo/$track"); args+=("${CH[@]}"); chan_accept "$repo/$track"
    mapfile -t MO < <(model_args); args+=("${MO[@]}")
    # a session id whose transcript is gone (crash before the first write, or the 30-day prune) makes --resume fail forever: mint a fresh one instead
    [ "$started" = True ] && ! compgen -G "$HOME/.claude/projects/*/$sid.jsonl" >/dev/null 2>&1 && { sid=""; "$BOARD" note "$repo" "$track" "session transcript missing — new session id" >/dev/null 2>&1; }
    if [ "$force_cont" = "-c" ]; then args+=(--continue)
    elif [ "$started" = True ] && [ -n "$sid" ]; then args+=(--resume "$sid")
    else [ -n "$sid" ] || { sid=$(cat /proc/sys/kernel/random/uuid); "$BOARD" set "$repo" "$track" session_id "$sid"; }
         args+=(--session-id "$sid"); "$BOARD" set "$repo" "$track" started true; fi
    "$BOARD" status "$repo" "$track" running >/dev/null 2>&1 || true
    "$CLAUDE" "${args[@]}"; echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
  __runmember)  # internal: a MEMBER WORKSPACE session — the host side. Board and dialog bookkeeping here; claude inside cc-sandbox member.
    repo="$2"; track="${3:-}"; force_cont="${4:-}"; export CC_ROLE=member; args=()
    if [ -n "$track" ]; then wt="$WTBASE/$repo/$track"; cd "$wt" || exit 1; win="$repo/$track"; sp="$(sp_track "$repo" "$track" "$(default_branch "$DEV/$repo")") $MEMBER_SP $MEMBER_WS_SP"
      sid=$("$BOARD" get "$repo" "$track" session_id); started=$("$BOARD" get "$repo" "$track" started)
      [ "$started" = True ] && ! compgen -G "$HOME/.cc/members/$repo/claude/projects/*/$sid.jsonl" >/dev/null 2>&1 && { sid=""; "$BOARD" note "$repo" "$track" "session transcript missing — new session id" >/dev/null 2>&1; }   # transcripts live in the member's own ~/.claude
      if [ "$force_cont" = "-c" ]; then args+=(--continue)
      elif [ "$started" = True ] && [ -n "$sid" ]; then args+=(--resume "$sid")
      else [ -n "$sid" ] || { sid=$(cat /proc/sys/kernel/random/uuid); "$BOARD" set "$repo" "$track" session_id "$sid"; }
           args+=(--session-id "$sid"); "$BOARD" set "$repo" "$track" started true; fi
      "$BOARD" status "$repo" "$track" running >/dev/null 2>&1 || true
    else cd "$DEV/$repo" || exit 1; win="$repo"; sp="$(sp_main "$repo" "$(default_branch "$DEV/$repo")") $MEMBER_SP $MEMBER_WS_SP"; fi
    args+=(--append-system-prompt "$sp"); mapfile -t CH < <(chan_args "$win"); args+=("${CH[@]}"); chan_accept "$win"; mapfile -t MO < <(model_args); args+=("${MO[@]}")   # no --remote-control: a member session is not on the owner's phone
    "$BIN/cc-sandbox" member "$repo" "$track" -- "$CLAUDE" "${args[@]}"; echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
  __runnext)  # internal: the SUCCESSOR of an overlapping handoff (cc-handoff --overlap started this window)
    target="$2"; hid="$3"; sid="$4"; repo="${target%%/*}"; track=""; [ "$target" != "$repo" ] && track="${target#*/}"
    if [ -n "$track" ]; then wt="$WTBASE/$repo/$track"; else wt="$DEV/$repo"; fi
    cd "$wt" || exit 1; base=$(default_branch "$DEV/$repo")
    # Per-process, and that is the whole point: the two sessions share this cwd, so a marker file would gate
    # BOTH. cc-guard reads this and refuses the world-gates until the record says this session is live.
    export CC_HANDOFF="$hid"
    if [ -n "$track" ]; then sp=$(sp_track "$repo" "$track" "$base"); else sp=$(sp_main "$repo" "$base"); fi
    b="${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}/${target//\//--}.brief"   # cc-handoff wrote the opening brief there
    [ -f "$b" ] && sp="$sp $(cat "$b")"
    member_facing "$wt" && { export CC_ROLE=member; sp="$sp $MEMBER_SP"; }
    # The successor's window is "$target~next", not "$target": accepting in the latter pressed keys at the
    # PREDECESSOR (harmless — it is long past its dialog) and left this session parked on its own.
    mapfile -t CH < <(chan_args "$target"); mapfile -t MO < <(model_args); chan_accept "${CC_HANDOFF_WINDOW:-$target}"
    "$CLAUDE" --append-system-prompt "$sp" --remote-control "$target" --session-id "$sid" "${CH[@]}" "${MO[@]}"
    echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
  __runmain)  # internal: planning session in the primary worktree
    repo="$2"; cd "$DEV/$repo" || exit 1; base=$(default_branch "$DEV/$repo")
    sp=$(sp_main "$repo" "$base")
    mapfile -t CH < <(chan_args "$repo"); mapfile -t MO < <(model_args); chan_accept "$repo"
    member_facing "$DEV/$repo" && { export CC_ROLE=member; sp="$sp $MEMBER_SP"; }   # convenience only — the marker is what cc-guard actually reads
    "$CLAUDE" --append-system-prompt "$sp" --remote-control "$repo" "${CH[@]}" "${MO[@]}"; echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
  __runorch)  # internal: peer orchestrator session in the primary worktree, addressable in Slack by alias
    repo="$2"; alias="$3"; cd "$DEV/$repo" || exit 1; base=$(default_branch "$DEV/$repo")
    sp="You are orchestrator '$alias' for repo '$repo' — a peer of the main planning session, same primary worktree and branch '$base' (no auto-commit; you may merge). You own Slack threads where you were @'d, and every thread in your OWN channel (#<parent>-$alias-<id>, created for you — no @ needed there; your replies land wherever the message came from). Dispatch work with 'cc $repo <track> --go \"<instructions>\"' (headless worker tracks, each ends with a PR); an orch you spawn with 'cc $repo --orch <alias> \"<brief>\"' gets its own channel under yours. Your Slack replies are signed automatically. Hand a thread back to the main session by writing '@$repo over to you'. Board: 'cc board show $repo'."
    export CC_SLACK_ALIAS="$alias"
    mapfile -t CH < <(chan_args "$repo"); mapfile -t MO < <(model_args); chan_accept "$repo@$alias"
    "$CLAUDE" --append-system-prompt "$sp" --remote-control "$repo@$alias" "${CH[@]}" "${MO[@]}"
    [ -f "$SLACKON" ] && "$BIN/cc-slack" archive --orch "$repo" "$alias" >/dev/null 2>&1   # the orch is finished: its channel is history, not a live route
    echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
  __runplain)  # internal: plain session in a folder that is not a git repo
    repo="$2"; cont="${3:-}"; cd "$DEV/$repo" || exit 1
    mapfile -t CH < <(chan_args "$repo"); mapfile -t MO < <(model_args); chan_accept "$repo"
    MF=(); member_facing "$DEV/$repo" && { export CC_ROLE=member; MF=(--append-system-prompt "$MEMBER_SP"); }   # a member-facing folder need not be a git repo
    "$CLAUDE" ${cont:+--continue} --remote-control "$repo" "${CH[@]}" "${MO[@]}" "${MF[@]}"; echo; echo "[claude exited — shell stays; 'exit' closes the window]"; exec bash ;;
esac

# ---- cc [-c] <repo> [track] [--go|--say ...] ----
CONT=""; [ "$1" = "-c" ] && { CONT="-c"; shift; }
repo="${1:?repo}"; track="${2:-}"; shift; [ -n "$track" ] && shift
valid_name "$repo"
inside || { ensure_main; "$BIN/cc-trust" "$DEV/$repo" >/dev/null 2>&1 || true; }   # inside the boundary there is no tmux server and the trust copy is already made
if [ "$track" = "--orch" ]; then
  member_workspace "$repo" && { echo "cc: a member workspace has no orchestrators — its one session lives in #$repo"; exit 1; }
  alias="${1:-}"; brief="${2:-}"; [[ "$alias" =~ ^[a-z0-9-]{2,20}$ ]] || { echo "cc: --orch alias must match ^[a-z0-9-]{2,20}\$"; exit 1; }
  win="$repo@$alias"; lock "$HOME/.cc/win.lock"; fresh=""
  if have_window "$win" && ! pane_live "$win"; then tmux kill-window -t "$(win_id "$win")"; fi   # the orch exited, only the fallback shell is left
  have_window "$win" || { tmux new-window -d -t "$SESSION" -n "$win" -c "$DEV/$repo" "$(printf 'CC_CLAUDE=%q %q __runorch %q %q' "$CLAUDE" "$SELF" "$repo" "$alias")"; fresh=1; }
  unlock
  # only a freshly STARTED orch asks for a channel: re-running this on a live one must never mint a second channel
  if [ -n "$fresh" ] && [ -f "$SLACKON" ]; then   # its own channel, once (nested under the spawner's when an orch spawns an orch); @alias in #<repo> keeps working either way
    oc=("$BIN/cc-slack" orch-channel "$repo" "$alias"); [ -n "${CC_SLACK_ALIAS:-}" ] && oc+=(--parent-alias "$CC_SLACK_ALIAS"); [ -n "$brief" ] && oc+=(--brief "$brief")
    ( "${oc[@]}" >/dev/null 2>&1 & )
  fi
  [ -t 0 ] && tmux select-window -t "$(win_id "$win")"; attach_main; exit 0
fi
case "$track" in --*) echo "cc: '$track' is an option, not a track — use: cc $repo <track> $track ..."; exit 1;; ?*) valid_name "$track";; esac
if [ -z "$track" ]; then
  [ -d "$DEV/$repo" ] || { echo "cc: no ~/dev/$repo (typo? create it first: mkdir ~/dev/$repo)"; exit 1; }
  lock "$HOME/.cc/win.lock"
  if have_window "$repo" && ! pane_live "$repo"; then tmux kill-window -t "$(win_id "$repo")"; fi   # claude exited, only the fallback shell is left
  if member_workspace "$repo"; then inside && { echo "cc: inside the boundary this session is opened from Slack (#$repo) or by the owner, not from here"; exit 1; }
    if ! have_window "$repo"; then member_credential "$repo" "" || { unlock; exit 1; }   # no credential, no window: #<h> and the owner are told instead
      tmux new-window -d -t "$SESSION" -n "$repo" -c "$DEV/$repo" "$(printf 'CC_CLAUDE=%q %q __runmember %q ""' "$CLAUDE" "$SELF" "$repo")"; fi   # the boundary: __runmember → cc-sandbox member
  elif git "${GITNH[@]}" -C "$DEV/$repo" rev-parse --git-dir >/dev/null 2>&1; then have_window "$repo" || tmux new-window -d -t "$SESSION" -n "$repo" -c "$DEV/$repo" "$(printf 'CC_CLAUDE=%q %q __runmain %q' "$CLAUDE" "$SELF" "$repo")"
  else have_window "$repo" || tmux new-window -d -t "$SESSION" -n "$repo" -c "$DEV/$repo" "$(printf 'CC_CLAUDE=%q %q __runplain %q %q' "$CLAUDE" "$SELF" "$repo" "$CONT")"; fi
  unlock; [ -t 0 ] && tmux select-window -t "$(win_id "$repo")"; attach_main; exit 0
fi
ensure_track "$repo" "$track"; win="$repo/$track"; wt="$WTBASE/$repo/$track"; st="$STBASE/$repo/$track"
mode=""; text=""; LOOPN=1; XTRA=(); SESS=""
while [ $# -gt 0 ]; do case "$1" in --go|--say) mode="${1#--}"; text="${2:-}"; shift;; --loop) LOOPN="$2"; shift;; --budget|--model|--effort|--turns) XTRA+=("$1" "$2"); shift;; --resume-last|--no-extend) XTRA+=("$1");; --session) SESS=1;; *) echo "cc: unknown option $1"; exit 1;; esac; shift; done
# --session marks the row's KIND (cc-board KINDS): a channel-like session with no task to finish — cc-reconcile leaves
# its status alone and the Home tab groups it under its repo instead of counting it as running. Idempotent; a row that
# was made a session by hand (`cc board set <repo> <name> kind session`) opens the same way without the flag.
[ -n "$SESS" ] && { "$BOARD" set "$repo" "$track" kind session || exit 1; }
case "$mode" in
  say) "$BIN/cc-pause" is "$repo" 2>/dev/null && { echo "cc: $repo is paused — \`cc-pause off $repo\` first"; exit 1; }   # typing at a session is a turn it spends
       have_window "$win" && pane_live "$win" || { echo "cc: no running session in $win (open it with: cc $repo $track)"; exit 1; }; exec "$BIN/cc-msg" "$win" "$text" ;;
  go)  if inside; then   # INSIDE the boundary: no tmux, no ledger. The brief is written here (this state dir is the workspace's own);
         # the launch is brokered — the daemon runs `cc <h> <track> --go ""` on the host: budget gate, window and boundary included.
         mkdir -p "$st"; write_brief || exit 1; exec "$BIN/cc-slack" dispatch "$repo/$track" --loop "$LOOPN" "${XTRA[@]}"; fi
       if have_window "$win" && pane_live "$win"; then echo "cc: $win already has a live session — use --say to instruct it, or cc rm/handoff first"; exit 1; fi
       if member_workspace "$repo"; then member_credential "$repo" "$track" || exit 1; fi   # before the cap: nothing is charged for a launch that cannot happen
       member_gate "$repo" || exit 1
       if "$BIN/cc-pause" is "$repo" 2>/dev/null; then   # the project is parked: `cc-pause off` is the only thing that starts a worker for it
         echo "cc: $repo is paused — \`cc-pause off $repo\` puts it back, this loop included"; exit 1; fi
       # THE BRIEF HAS ONE HOME: $st/task.md. It used to have two — that file and the board's `instructions` —
       # merged by substring on every dispatch, and that merge destroyed the brief it was dispatched with on FOUR
       # tracks (#71 and #79 each fixed one variant; on 2026-08-31 a 4590-byte brief became one sentence, on both
       # sides at once). There is nothing to reconcile now: the board carries a display title, `cc board add`
       # writes the file, and dispatching only ever ADDS to it — one atomic write, the note on top so the worker
       # reads it first. Replacing a brief stays an explicit act (`cc board set … instructions`), never a side
       # effect of dispatching. Regression tests: "the #71 case" in selftest.sh, and `cc-board selfcheck`.
       write_brief || exit 1
       for pid in $(pgrep -f -- '--max-budget-usd' 2>/dev/null); do   # a previous loop killed by hand can leave claude re-parented to systemd, still writing this worktree
         [ "$(readlink -f /proc/$pid/cwd 2>/dev/null)" = "$(readlink -f "$wt")" ] || continue
         echo "cc: killing orphaned worker pid $pid in $wt" | tee -a "$st/loop.log"
         pg=$(ps -o pgid= -p "$pid" 2>/dev/null | tr -d ' ')   # take its whole group (claude + tools), but never our own
         if [ -n "$pg" ] && [ "$pg" != "$(ps -o pgid= -p $$ | tr -d ' ')" ]; then kill -TERM -- -"$pg" 2>/dev/null; else kill -TERM "$pid" 2>/dev/null; fi; done
       "$BOARD" note "$repo" "$track" "dispatched headless worker (loop $LOOPN)" >/dev/null
       xq=""; [ ${#XTRA[@]} -gt 0 ] && xq=$(printf ' %q' "${XTRA[@]}")   # printf %q with no argument emits '' — cc-loop would see an empty arg
       lock "$st/.lock"; [ -n "$(win_id "$win")" ] && tmux kill-window -t "$(win_id "$win")"
       pre=""; for v in CC_NOTIFY_LOG_ONLY CC_NOTIFY_LOG CC_LIMIT_STAMP CC_WORKER_SANDBOX CC_WORKER_MODEL CC_LOOP_TRIM; do   # tests: the new tmux window has the server's env, not ours — carry the log-only flag (or the worker's DONE notice really posts) and the run's own log/stamp
         # …and every knob a person sets in FRONT of the dispatch (CC_WORKER_MODEL, CC_LOOP_TRIM): off this list the
         # variable never reaches the window, cc-config silently reads ~/.cc/config instead, and the run is the
         # opposite of what was asked for — in both directions, which is what would corrupt a shadow-week A/B.
         [ -n "${!v:-}" ] && pre="$pre$(printf '%s=%q ' "$v" "${!v}")"; done
       if member_workspace "$repo"; then   # the loop itself runs INSIDE the boundary; cc-loop's own cc-sandbox call is then a no-op (CC_WORKER_SANDBOX unset) — one wall, not two
         tmux new-window -d -t "$SESSION" -n "$win" -c "$wt" "$(printf '%s%q member %q %q -- cc-loop %q %q --max-iter %q%s; echo; echo %q; exec bash' "$pre" "$BIN/cc-sandbox" "$repo" "$track" "$repo" "$track" "$LOOPN" "$xq" '[worker finished — shell stays]')"
       else
         tmux new-window -d -t "$SESSION" -n "$win" -c "$wt" "$(printf '%sCC_CLAUDE=%q %q %q %q --max-iter %q%s; echo; echo %q; exec bash' "$pre" "$CLAUDE" "$BIN/cc-loop" "$repo" "$track" "$LOOPN" "$xq" '[worker finished — shell stays]')"
       fi
       wm=""; k=0; while [ "$k" -lt "${#XTRA[@]}" ]; do [ "${XTRA[$k]}" = --model ] && wm="${XTRA[$((k+1))]:-}"; k=$((k+1)); done
       unlock; echo "worker started on $(worker_model "$wm") in tmux main:$win — watch: cc $repo $track ; log: $st/loop.log"; exit 0 ;;
esac
lock "$st/.lock"
if have_window "$win" && ! pane_live "$win"; then tmux kill-window -t "$(win_id "$win")"; fi   # dead window (claude exited, `exec bash`): recreate instead of attaching to a shell
if ! have_window "$win"; then
  if member_workspace "$repo"; then inside && { echo "cc: inside the boundary a track session is opened from Slack (#$repo--$track) or by the owner, not from here"; exit 1; }
    member_credential "$repo" "$track" || { unlock; exit 1; }   # no credential: no window, and the row below never says running
    tmux new-window -d -t "$SESSION" -n "$win" -c "$wt" "$(printf 'CC_CLAUDE=%q %q __runmember %q %q %q' "$CLAUDE" "$SELF" "$repo" "$track" "$CONT")"   # the boundary
  else tmux new-window -d -t "$SESSION" -n "$win" -c "$wt" "$(printf 'CC_CLAUDE=%q %q __run %q %q %q' "$CLAUDE" "$SELF" "$repo" "$track" "$CONT")"; fi
  "$BOARD" status "$repo" "$track" running >/dev/null 2>&1
fi
unlock; [ -t 0 ] && tmux select-window -t "$(win_id "$win")"; attach_main
