                          ("host", {"ask": "open a host port for the game server", "kind": "service"}),
                          ("controls", {"ask": "add an allow rule to settings.json", "kind": "config"}),
                          ("kind alone", {"ask": "cc-config set CC_ASK_TURNS 16", "kind": "secret"})]:
            d = decide(dict(ask, evidence=ev + sev, reversible="minutes", reaches="box"))
            check(f"hard line holds against evidence: {name}", d["verdict"] == "ASK-OWNER")
        d = decide({"ask": "send the owner the site link", "kind": "mail", "reaches": "owner", "reversible": "minutes", "evidence": ev})
        check("mail is never the box's to grant, even to the owner", d["verdict"] == "ASK-OWNER")
        d = decide({"ask": "serve the app at x.example.org through a Cloudflare tunnel", "port": "22"})
        check("port 22 is REFUSE", d["verdict"] == "REFUSE")
        d = decide({"ask": ""})
        check("an empty ask is REFUSE", d["verdict"] == "REFUSE")
        # record: a grant writes the ledger and the spool; an ASK-OWNER writes neither
        watched = dict(cfg, reversible="hours")
        line = record(watched, decide(watched))
        spool = os.listdir(f"{td}/perms/watch-spool")
        check("GRANT+WATCH writes one spool registration", len(spool) == 1 and line["watcher"].endswith(spool[0]))
        reg = json.load(open(line["watcher"]))
        check("... carrying what, check, revert and expires", all(reg.get(k) for k in ("what", "check", "revert", "expires")))
        check("... and one ledger line", len(open(f"{td}/perms/inferred.jsonl").readlines()) == 1)
        hard = dict(svc, ask="open ssh to the host")
        check("ASK-OWNER records nothing", record(hard, decide(hard)) is None
              and len(open(f"{td}/perms/inferred.jsonl").readlines()) == 1)
        t = digest(24)
        check("the digest names the grant, its evidence and its undo", "CC_ASK_TURNS" in t and goals[:40] in t and "undo:" in t)
        check("the digest window leaves an old grant out", digest(0) == "")
        with open(f"{td}/perms/inferred.jsonl", "a") as f:
            f.write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "what": "x <!channel> & <@U1>",
                                "evidence": [{"source": "<!here>"}], "revert": "<http://x|y>"}) + "\n")
        t = digest(24)
        check("the digest escapes the ledger's text, so it can't ping or link", "&lt;!channel&gt; &amp; &lt;@U1&gt;" in t
              and "<!" not in t and "<http" not in t)
        # backtest: a false grant on an owner-refused ask fails the gate; a clean replay passes
        bt = f"{td}/bt.jsonl"
        good = {"id": "a", "ask": "systemctl --user restart cc-slackd", "kind": "service", "reaches": "box",
                "reversible": "minutes", "owner_outcome": "approved", "goal_evidence": "keep the slack daemon on live code",
                "source": "goals.md"}
        with open(bt, "w") as f:
            f.write(json.dumps(good) + "\n" + json.dumps(dict(good, id="b", ask="buy a GPU", owner_outcome="refused")) + "\n")
        with contextlib.redirect_stdout(io.StringIO()):
            rc_ok = backtest(bt)
        with open(bt, "a") as f:
            f.write(json.dumps(dict(good, id="c", owner_outcome="would-object")) + "\n")
        with contextlib.redirect_stdout(io.StringIO()) as o:
            rc_bad = backtest(bt)
        check("backtest passes when every refused ask stays with him", rc_ok == 0)
        check("backtest fails on a false grant and names it", rc_bad == 1 and "FALSE GRANT c" in o.getvalue())
        # an owner-only or perms-refused row that comes out a grant fails too; its own fixture, not the file above
        for label in ("owner-only", "perms-refused"):
            bt2 = f"{td}/bt-{label}.jsonl"
            with open(bt2, "w") as f:
                f.write(json.dumps(dict(good, id="kept", ask="raise the monthly spend limit", kind="money", money=True,
                                        owner_outcome=label)) + "\n")
            with contextlib.redirect_stdout(io.StringIO()):
                rc_kept = backtest(bt2)
            with open(bt2, "w") as f:
                f.write(json.dumps(dict(good, id="leak", owner_outcome=label)) + "\n")
            with contextlib.redirect_stdout(io.StringIO()) as o2:
                rc_leak = backtest(bt2)
            check(f"backtest: a {label} row kept with him passes, granted fails", rc_kept == 0 and rc_leak == 1
                  and "FALSE GRANT leak" in o2.getvalue())
    print(f"cc-infer selfcheck: {passed} passed, {len(failed)} failed")
    for f in failed:
        print(f"  FAIL {f}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
