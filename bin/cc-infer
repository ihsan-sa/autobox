                                             r"--force|-f|mv|update-ref") + r"|force[ -]?push|branch\s+-d|"
                                             r"push\s+\S+\s+\+|push\s+\S+\s+\+?:|(?:^|\s):?\s*>(?!>)\s*[~/$]"),
    ("widening a non-owner", W(r"members?|non-owner|workspaces?|guests?|collaborators?|teammates?|contractors?|"
                               r"clients?|customers?|invite[sd]?|invitation|maintainers?|chmod|chown|setfacl|usermod|useradd|adduser|"
                               r"groupadd|gpasswd|sudoers|visudo|"
                               r"write access|push access|admin access") + r"|" + W(r"give|grant|add|allow|let") +
                             r".{0,40}" + W(r"write|admin|push|access|roles?|permissions?|read|maintain|triage")),
    ("mail or posts in his name", r"[a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,}|in (his|her|their|the owner'?s) name|"
                                  r"as (him|her|them|the owner|the user)" + R + r"|on (his|her|their|the owner'?s) behalf|" +
                                  W(r"e-?mails?|e-?mailing|mail|mails|mailing|dm|dms|tweet|replies|reply|respond|"
                                    r"comments?|announce|newsletter|sms|whatsapp|linkedin|twitter|"
                                    r"upstream|outreach|curl|wget|gh issue|gh pr|gh api") + r"|" + W(r"send|sends|sending|post|posts|posting") +
                                  r".{0,60}" + W(r"to|on|in")),
    ("opening the host", W(r"ssh|sshd|authorized_keys|sftp|scp|rsync|telnet|vnc|rdp|socat|netcat|nc|ncat|ngrok|"
                           r"tailscale|zerotier|wireguard|wg|vpn|frp|tunnels?|cloudflared|port[ -]?forward\w*|"
                           r"reverse shell|bind shell|shell access|connectors?|expose[sd]?|exposing|listen|listening|"
                           r"lan|wan|host port|open (a |the )?port|upnp|dmz|bind|bound|every interface|all interfaces|"
                           r"http\.server|--host|--publish|-p \d+:\d+") + r"|0\.0\.0\.0"),
    ("code from outside the box", r"\|\s*(?:sudo\s+)?(?:sh|bash|zsh|dash|python3?|perl|ruby|node)" + R + r"|" +
                                  W(r"base64 -d|base64 --decode|eval")),
    # Perms' standing condition, now in code: "any ask that touches perms' own CLAUDE.md or settings, ~/.cc/approvals,
    # hooks, the guard, the sandbox or bwrap, or autoMode is always the owner's." cc-config is one unless it is the
    # config shape's own command on a listed key.
    ("the box's own controls", r"claude\.md|\.claude/|approvals|allow[ -]?list|allow rules?|guard|bwrap|bubblewrap|"
                               r"sandbox|automode|auto[ -]mode|crosssessioninbound|dangerously|seccomp|apparmor|"
                               r"sudo|setuid|polkit|cc-approve|cc-infer|ld_preload|ld_library_path|bashrc|zshrc|\.profile|~/bin|"
                               r"/usr/local/bin|send-keys|" +
                               L + r"cc-config(?! set (?:" + "|".join(CONFIG_KEYS).lower() + r") \d{1,6}$)|" +
                               W(r"settings?|settings[\w.-]*|hooks?|fence|perms|permissions?|bypass|/allow|cc_tier|tier|"
                                 r"spend|cc-msg|tmux|shim|shims|path|claude")),
    # Architect, 10-11 (third security read): "docker or any container run, crontab-style or every-N schedules,
    # stopping or disabling a box daemon, pushes to main or any default branch, writes to ~/.cc/config or ~/.cc/env,
    # and copying either of those anywhere."
    ("a container run", W(r"docker|podman|containerd|nerdctl|ctr|kubectl|k8s|kubernetes|helm|lxc|lxd|incus|runc|crun|"
                          r"buildah|containers?|compose|nspawn|systemd-nspawn|singularity|apptainer|firecracker|qemu|kvm|"
                          r"virsh|vagrant")),
    ("a recurring schedule", W(r"cron|crontab|cronjob|anacron|timers?|oncalendar|every|hourly|daily|weekly|monthly|"
                               r"nightly|weekdays?|periodic\w*|recurring|repeat\w*|intervals?|systemd-run|at now|at \d+|batch|watch|"
                               r"loop|forever|sleep") + r"|\*/\d|@(?:reboot|hourly|daily|weekly|monthly|yearly|annually|midnight)"),
    ("stopping or disabling a daemon", W(r"stop|stops|stopping|stopped|disable[sd]?|disabling|mask|masked|masking|kill|"
                                         r"kills|killall|pkill|killing|pause|suspend|freeze|sigterm|sigkill|sigstop|"
                                         r"terminate|terminating|shut down|turn off|switch off")),
    ("a push to main or a default branch", W(r"push|pushes|pushing|pushed|merge|merges|merging|merged|main|master|trunk|"
                                             r"default branch")),
    ("~/.cc/config or ~/.cc/env", r"\.cc[\s/\\.]*(?:config|env)" + R + r"|" + W(r"cc_config|cc_config_deny|cc_env")),
]
HARD_RE = [(n, re.compile(p)) for n, p in HARD]
# What the hard lines and the ports don't read (perms, 10-12: "no secrets", "no member widening", "03:21Z" and
# "origin/main" each sent a one-off promote to the owner): a negated clause of plain words that ends where the clause
# does, a Z-stamped or dated time, and a ref ending in a default branch. Only these are masked, so a verb beside them
# still matches ("merge origin/main", "push ..., no review"), a clause that runs on into more words isn't masked ("no
# problem rm -rf ~"), and a bare "at 03:21" is still an at job.
_WORD = r"[a-z]+(?:'[a-z]+)?"
_PHRASE = _WORD + r"(?:[\s-]+" + _WORD + r"){0,2}"
UNREAD = re.compile(
    L + r"(?:no|without|never|nor|zero)\s+" + _PHRASE + r"(?:\s+(?:or|nor)\s+" + _PHRASE + r")*" +
    r"(?=\s*(?:[,;.!?)]|$)|\s+(?:and|but|then|so|yet|while|because)" + R + r")"
    r"|" + L + r"(?:\d{4}-\d{2}-\d{2}[t ])?\d{1,2}:\d{2}(?::\d{2})?(?:\.\d+)?z" + R +
    r"|" + L + r"\d{4}-\d{2}-\d{2}[t ]\d{1,2}:\d{2}(?::\d{2})?" + R +
    r"|" + L + r"[\w.-]+/(?:main|master|trunk)" + R)


def unread(t):
    """The folded text with what UNREAD names blanked out: what the hard lines and the ports are matched on."""
    return squash(UNREAD.sub(" ", t))
_NEVER = {}


def never_touch_path():
    """The box's own never-touch literals, one per line, in the private overlay beside core/ (config/never-touch.txt),
    found the way cc-name finds config/names.json. No environment override: a caller can't point it elsewhere."""
    root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    default = os.path.join(os.path.dirname(root), "config", "never-touch.txt") if os.path.basename(root) == "core" else ""
    return place("never_touch", default)


def never_touch_rx():
    """A pattern for the overlay's literals, None when there is no file (the generic words still apply), or False when
    the file is there but can't be read, which fails closed."""
    p = never_touch_path()
    if p not in _NEVER:
        try:
            with open(p, encoding="utf-8") as f:
                lits = [fold(ln) for ln in f if fold(ln) and not ln.lstrip().startswith("#")]
            _NEVER[p] = re.compile("|".join(re.escape(x) for x in lits)) if lits else None
        except FileNotFoundError:
            _NEVER[p] = None
        except (OSError, UnicodeError):
            _NEVER[p] = False
    return _NEVER[p]
KIND_HARD = {"money": "real money", "secret": "secrets and credentials", "never-touch": "the never-touch list",
             "delete-shared": "unplanned deletion of shared state", "widen-member": "widening a non-owner",
             "open-host": "opening the host", "controls": "the box's own controls", "mail": "mail or posts in his name",
             "post": "mail or posts in his name"}
PORTS = re.compile(r"(?:" + W("port|ports") + r"\s*:?\s*|:)(\d{1,5})" + R)
ZERO_WIDTH = re.compile("[­͏؜ᅟᅠ឴឵᠎​-‏‪-‮⁠-⁤⁪-⁯﻿]")
# lowercase letters from other scripts that read as Latin ones (the Cyrillic e in "sеttings")
CONFUSABLE = str.maketrans("аеёорсухіїјѕһԁӏԛԝкмнтвьαοερικνυτχβηϲϳ", "aeeopcyxiijshdlqwkmhtbbaoepikvutxbncj")
GRANT_ITEM = re.compile(r"^grant:([1-9])$")
TICKET = re.compile(r"^T\d{8}T\d{6}-[0-9a-f]{1,8}$")
MIN_QUOTE = 20
# words that carry no intent, so a quote that shares only these with the ask is no evidence for it
STOPWORDS = set("""about above after again against also because been before being below between both could does doing
down during each from further have having here into itself just more most must need only other over please same should
some such than that their them then there these they this those through under until very want were what when where which
while will with would your yours make sure keep thing things want wants like going""".split())


def squash(s):
    return re.sub(r"\s+", " ", str(s or "")).strip()


def fold(s):
    """NFKC, drop zero-width and bidi marks, map look-alike letters to Latin, strip accents, casefold: what the hard
    lines are matched on, so a full-width, accented or Cyrillic spelling reads as the word it imitates."""
    s = ZERO_WIDTH.sub("", unicodedata.normalize("NFKC", str(s or ""))).casefold().translate(CONFUSABLE)
    s = "".join(c for c in unicodedata.normalize("NFKD", s) if not unicodedata.combining(c))
    return squash(s)


def foreign_letters(s):
    """Letters that are still not Latin after fold(): text the rules can't read, so nothing is granted on it."""
    return any(ord(c) > 127 and unicodedata.category(c).startswith("L") for c in s)


def text_ports(t):
    return {int(p) for p in PORTS.findall(t)}


def hard_lines(a, t):
    """Every hard line the ask crosses, by its folded text or its kind, each with the word that matched it, so whoever
    reads the reason sees why (lane review of #1089: the lists stay wide because the decider fails closed, but the
    reason names the word). The stricter reading wins."""
    kind, hits = a.get("kind") or "", {}
    for n, rx in HARD_RE:
        m = rx.search(t)
        if m and n not in hits:
            hits[n] = m.group(0).strip()
    nt = never_touch_rx()
    if "the never-touch list" not in hits:
        m = nt.search(t) if nt else None
        if m or nt is False:
            hits["the never-touch list"] = m.group(0) if m else "the box's never-touch file, which can't be read"
    m = PORTS.search(t)
    if m and "opening the host" not in hits:
        hits["opening the host"] = m.group(0).strip()
    for n, on, word in ((KIND_HARD.get(kind), kind in KIND_HARD, f"kind {kind}"),
                        ("real money", a.get("money") is True, "money true"),
                        ("secrets and credentials", a.get("data") == "secret", "data secret")):
        if on and n not in hits:
            hits[n] = word
    return list(hits.items())


def config_env():
    """cc-config's environment, pinned: the account's home and its own ~/.cc/config, nothing denied, so the caller
    can't choose the owner-repo list (security read, 10-11)."""
    return {"HOME": HOME, "CC_CONFIG": f"{HOME}/.cc/config", "CC_CONFIG_DENY": "", "PATH": "/usr/bin:/bin",
            "LC_ALL": "C.UTF-8"}


def owner_repos():
    """The owner's own repos: the names in CC_JANITOR_REPOS in his ~/.cc/config (read through cc-config with its
    environment pinned), less any name that is a member workspace (~/.cc/members/<name> without the host-side
    owner-workspace marker). A member's ~/.cc/state/<handle>/goals.md is writable from inside its sandbox, so it never
    counts as his (security read, 10-11), and a name not on the list counts as nothing."""
    if "repos" in _TEST:
        names = _TEST["repos"]
    else:
        try:
            p = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-config"), "get",
                                "CC_JANITOR_REPOS"], capture_output=True, text=True, timeout=20, env=config_env(),
                               stdin=subprocess.DEVNULL)
            names = p.stdout.split() if p.returncode == 0 else []
        except (OSError, subprocess.SubprocessError):
            names = []
    members = place("members", f"{HOME}/.cc/members")
    return {n for n in names if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", n)
            and (not os.path.isdir(f"{members}/{n}") or os.path.isfile(f"{members}/{n}/owner-workspace"))}


def goals_file_ok(path, repos):
    """Goals come only from ~/.cc/state/<repo>/goals.md for one of the owner's own repos, never from a member
    workspace's state dir, anywhere under ~/dev/ or a scratch dir."""
    real = os.path.realpath(path)
    root = os.path.realpath(place("state", f"{HOME}/.cc/state"))
    dev = os.path.realpath(f"{HOME}/dev")
    return (os.path.basename(real) == "goals.md" and os.path.dirname(os.path.dirname(real)) == root
            and not (real + "/").startswith(dev + "/") and os.path.basename(os.path.dirname(real)) in repos)


def evidence_lines(text):
    """The lines a quote may come from: no heading, no line under MIN_QUOTE characters once its bullet is gone."""
    out = []
    for ln in str(text or "").split("\n"):
        s = re.sub(r"^\s*(?:[-*+>]|\d+[.)])\s+", "", ln).strip()
        if s and not s.startswith("#") and len(s) >= MIN_QUOTE:
            out.append(fold(s))
    return out


def content_words(s, drop):
    return {w for w in re.findall(r"[a-z][a-z0-9]*", fold(s)) if len(w) >= 4 and w not in STOPWORDS and w not in drop}


def related(quote, ask, repos):
    """The quote and the ask share a content word: not a stopword, a shape's own word or a repo name. A word counts
    when one is the other or begins it (slack, slackd)."""
    drop = SHAPE_WORDS | {r.lower() for r in repos}
    qw, aw = content_words(quote, drop), content_words(ask, drop)
    return any(x == y or x.startswith(y) or y.startswith(x) for x in qw for y in aw)


def grant_item(n):
    """Item n of the owner's one-time grant (2026-09-21), from the host rules next to this tool."""
    p = place("grants", os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "docs", "host-rules.md"))
    try:
        lines = open(p, encoding="utf-8").read().split("\n")
    except OSError:
        return ""
    on = False
    for ln in lines:
        if "one-time grant**" in ln:
            on = True; continue
        m = re.match(r"^\s+(\d+)\.\s+(.*)", ln)
        if on and m and int(m.group(1)) == n:
            return m.group(2)
        if on and ln.startswith("- "):
            break
    return ""


def check_evidence(evs, ask, cited_ok=False):
    """The evidence that holds: a quote of MIN_QUOTE characters or more that shares a content word with the ask and is
    in one counted line of the owner's state-dir goals.md, or of item N of his one-time grant. `cited_ok` (the
    backtest) takes any sourced quote in place of the file lookup, since the files of the day are gone; the length and
    the shared word still hold."""
    good, bad, repos = [], [], None
    for e in evs if isinstance(evs, list) else []:
        e = e if isinstance(e, dict) else {}
        q, src = squash(e.get("quote")), str(e.get("source") or "").strip()

        def verdict(ok, why):
            (good if ok else bad).append({"quote": q, "source": src} if ok else {"source": src, "why": why})
        if not q or not src:
            verdict(False, "no quote or no source"); continue
        if len(q) < MIN_QUOTE:
            verdict(False, f"a quote under {MIN_QUOTE} characters proves nothing"); continue
        if repos is None:
            repos = owner_repos() if not cited_ok else set()
        if not related(q, ask, repos):
            verdict(False, "the quote shares no content word with the ask"); continue
        if cited_ok:
            verdict(True, ""); continue
        g = GRANT_ITEM.match(src)
        if g:
            verdict(any(fold(q) in ln for ln in evidence_lines(grant_item(int(g.group(1))))),
                    "the quote is not in that item of the one-time grant")
        elif TICKET.match(src):
            # Architect, 10-11: "tickets.log carries no message, so a ticket only counts if the quote comes from the
            # message the ticket answers. If you can't resolve that, the ticket doesn't count as evidence."
            verdict(False, "a ticket can't be tied to the message it answered (tickets.log records none)")
        elif os.path.basename(src) == "goals.md":
            path = os.path.expanduser(src.replace("~", HOME, 1) if src.startswith("~") else src)
            if not goals_file_ok(path, repos):
                verdict(False, "goals count only from ~/.cc/state/<repo>/goals.md of the owner's own repos"); continue
            try:
                lines = evidence_lines(open(path, encoding="utf-8", errors="replace").read())
            except OSError:
                lines = []
            verdict(any(fold(q) in ln for ln in lines), "the quote is not in one counted line of that goals.md")
        else:
            verdict(False, "not a goals.md or grant:N")
    return good, bad


def decide(a, cited_ok=False):
    a = dict(a or {})
    t = fold(a.get("ask"))
    out = {"verdict": "", "reasons": [], "evidence": [], "evidence_refused": [], "ask": squash(a.get("ask"))}

    def done(v, *why):
        out["verdict"] = v; out["reasons"] += list(why); return out
    if not out["ask"]:
        return done("REFUSE", "no ask text")
    if a.get("owner_refused"):
        return done("REFUSE", f"the owner already refused this: {a['owner_refused']}")
    if 22 in text_ports(unread(t)) or str(a.get("port") or "").strip() == "22":
        return done("REFUSE", "port 22 is SSH into the host, never a site's app port")
    if foreign_letters(t):
        return done("ASK-OWNER", "the ask has letters the rules can't read, so nothing is granted on it")
    hard = hard_lines(a, unread(t))
    if hard:
        return done("ASK-OWNER", *[f"hard line: {h}, on {w!r}; perms or the owner decides" for h, w in hard])
    shape = parse_shape(a.get("ask"))
    if not shape:
        return done("ASK-OWNER", "not one of the command shapes the box may grant itself; perms decides")
    out["shape"] = shape[0]
    good, bad = check_evidence(a.get("evidence"), a.get("ask"), cited_ok)
    out["evidence"], out["evidence_refused"] = good, bad
    if not good:
        return done("ASK-OWNER", "no resolved evidence of his intent for this ask, so perms decides")
    if shape[0] == "service":
        state = unit_state(shape[1])
        if state != "active":
            return done("ASK-OWNER", f"{shape[1]} is {state} now, so a restart would start it and its undo would be a "
                        "stop, a hard line; perms decides" if state else
                        f"{shape[1]}'s state can't be read, so a restart might start it; perms decides")
    out["revert"], out["revert_note"] = shape_undo(shape, a.get("revert"))   # after evidence: cc-config may take 20 s
    # a shape stays in the box and undoes in minutes; a claim can only make it stricter
    reach = a.get("reaches") if REACH_RANK.get(a.get("reaches"), 0) > 0 else "box"
    rev = a.get("reversible") if UNDO_RANK.get(a.get("reversible"), 0) > 0 else "minutes"
    out["reaches"], out["reversible"] = reach, rev
    if REACH_RANK[reach] > REACH_RANK["owner"]:
        return done("ASK-OWNER", f"it is said to reach {reach}, further than the box grants itself")
    if rev == "no":
        return done("ASK-OWNER", "it is said to be impossible to undo")
    if rev == "minutes":
        return done("GRANT", f"a {shape[0]} shape with evidenced intent, in the box and undone in minutes")
    out["watch"] = {"check": squash(a.get("check")) or "probe that it still matches the goal", "revert": out["revert"],
                    "revert_note": out["revert_note"]}
    return done("GRANT+WATCH", f"a {shape[0]} shape with evidenced intent, said to take hours to undo, so it is watched")


def record(a, d):
    """The ledger line and, for GRANT+WATCH, the watcher registration in the spool."""
    if d["verdict"] not in GRANTS:
        return None
    sd, now = state_dir(), time.time()
    gid = "g" + time.strftime("%Y%m%dT%H%M%S", time.gmtime(now)) + f"-{os.getpid()}"
    os.makedirs(sd, exist_ok=True)
    line = {"id": gid, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)), "verdict": d["verdict"],
            "what": d["ask"], "evidence": d["evidence"], "watcher": None, "revert": d.get("revert") or "",
            "revert_note": d.get("revert_note") or "",
            "from": str(a.get("from") or "")}
    if d["verdict"] == "GRANT+WATCH":
        os.makedirs(f"{sd}/watch-spool", exist_ok=True)
        reg = {"id": gid, "created": line["at"], "what": d["ask"], "check": d["watch"]["check"],
               "revert": d["watch"]["revert"], "revert_note": d["watch"]["revert_note"], "evidence": d["evidence"],
               "source": "cc-infer",
               "expires": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now + WATCH_DAYS * 86400))}
        p = f"{sd}/watch-spool/{gid}.json"
        with open(p + ".tmp", "w") as f:
            json.dump(reg, f, ensure_ascii=False)
        os.replace(p + ".tmp", p)
        line["watcher"] = p
    with open(f"{sd}/inferred.jsonl", "a") as f:
        f.write(json.dumps(line, ensure_ascii=False) + "\n")
    return line


def slack_safe(s):
    """Slack reads <...> as a mention or link (<!channel> pings everyone) and & as an entity: escape all three."""
    return str(s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def digest(hours=24):
    cut = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - hours * 3600))
    rows = []
    try:
        for ln in open(f"{state_dir()}/inferred.jsonl", encoding="utf-8"):
            try:
                r = json.loads(ln)
            except ValueError:
                continue
            if str(r.get("at") or "") > cut:   # both are whole-second stamps; the cut second itself is out
                rows.append(r)
    except OSError:
        return ""
    if not rows:
        return ""
    out = ["*Granted from your goals* (told after; nothing to tap)"]
    for r in rows[-6:]:
        src = ", ".join(e.get("source", "") for e in r.get("evidence") or []) or "?"
        out.append(f"• {slack_safe(str(r.get('what', ''))[:140])} (from {slack_safe(src[:60])}"
                   + (f"; undo: {slack_safe(r['revert'][:80])}" if r.get("revert")
                      else f"; {slack_safe(r['revert_note'][:100])}" if r.get("revert_note") else "") + ("; watched" if r.get("watcher") else "") + ")")
    if len(rows) > 6:
        out.append(f"• and {len(rows) - 6} more in {state_dir()}/inferred.jsonl.")
    return "\n".join(out)


# Rows the gate must keep with the owner. Perms ruling, 10-11: "Add negative rows from the record, one for each
# always-the-owner class ... Each of these rows must come back ASK-OWNER or REFUSE." owner-only marks such a row;
# perms-refused is a perms REFUSED entry.
BLOCKING = ("refused", "would-object", "perms-refused", "owner-only")


def backtest(path):
    """Replay past asks. The gate: no ask the owner refused or objected to may come out a GRANT."""
    rows, counts, bad, inferred = [], {}, [], 0
    for ln in open(path, encoding="utf-8"):
        if ln.strip():
            rows.append(json.loads(ln))
    for r in rows:
        a = {"ask": r.get("ask"), "kind": r.get("kind"), "reaches": r.get("reaches"), "reversible": r.get("reversible"),
             "money": r.get("money"), "data": r.get("data"), "via": r.get("via"), "port": r.get("port"),
             "evidence": [{"quote": r["goal_evidence"], "source": r.get("source") or "record"}] if r.get("goal_evidence") else []}
        d = decide(a, cited_ok=True)
        counts[d["verdict"]] = counts.get(d["verdict"], 0) + 1
        if d["verdict"] in GRANTS:
            inferred += 1
            if r.get("owner_outcome") in BLOCKING:
                bad.append((r.get("id"), r.get("owner_outcome"), d["verdict"], a["ask"]))
        print(f"{r.get('id', '?'):<14} {r.get('owner_outcome', '?'):<14} {d['verdict']:<12} {squash(a['ask'])[:90]}")
    print(f"\n{len(rows)} asks: " + ", ".join(f"{v} {counts[v]}" for v in ("GRANT", "GRANT+WATCH", "ASK-OWNER", "REFUSE") if v in counts)
          + f". {inferred} would have been inferred without him.")
    blocked = sum(1 for r in rows if r.get("owner_outcome") in BLOCKING)
    print(f"{blocked} he refused or objected to; {len(bad)} of them came out a grant.")
    for b in bad:
        print(f"  FALSE GRANT {b[0]} ({b[1]} -> {b[2]}): {b[3]}")
    return 1 if bad else 0


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    if argv[:1] == ["digest"]:
        h = int(argv[2]) if argv[1:2] == ["--hours"] and len(argv) > 2 and argv[2].isdigit() else 24
        t = digest(h)
        if t:
            print(t)
        return 0
    if argv[:1] == ["backtest"] and len(argv) == 2:
        return backtest(argv[1])
    if argv[:1] != ["decide"]:
        print(USAGE, file=sys.stderr); return 2
    rest, rec = [x for x in argv[1:] if x != "--record"], "--record" in argv[1:]
    if len(rest) != 2 or rest[0] not in ("--json", "--ask"):
        print(USAGE, file=sys.stderr); return 2
    try:
        a = {"ask": rest[1]} if rest[0] == "--ask" else json.load(sys.stdin if rest[1] == "-" else open(rest[1]))
    except (OSError, ValueError) as e:
        print(f"cc-infer: can't read the ask: {e}", file=sys.stderr); return 2
    if not isinstance(a, dict):
        print("cc-infer: the ask must be one JSON object", file=sys.stderr); return 2
    d = decide(a)
    if rec:
        line = record(a, d)
        if line:
            d["ledger"] = line["id"]; d["watcher"] = line["watcher"]
    print(json.dumps(d, ensure_ascii=False))
    return 0 if d["verdict"] in GRANTS else 1


def selfcheck():
    import contextlib, io, shutil, tempfile
    passed, failed = 0, []

    def check(name, ok):
        nonlocal passed
        if ok:
            passed += 1
        else:
            failed.append(name)
    with tempfile.TemporaryDirectory() as td:
        _TEST.update(dir=f"{td}/perms", state=f"{td}/state", grants=f"{td}/host-rules.md", members=f"{td}/members",
                     repos=["proj"], config={}, systemctl=f"{td}/systemctl", never_touch=f"{td}/no-overlay/never-touch.txt")
        # a stand-in systemctl, so no real unit is ever read or touched: it logs its words and answers is-active from
        # units/<unit>, as the real one does (active exits 0, inactive 3, no bus 1 with nothing on stdout)
        os.makedirs(f"{td}/units")
        open(f"{td}/systemctl", "w").write(
            f'#!/bin/sh\nprintf "%s\\n" "$*" >> {td}/systemctl.log\n[ "$1 $2" = "--user is-active" ] || exit 64\n'
            f'read s < "{td}/units/$3" 2>/dev/null || s=inactive\n'
            'case "$s" in active) echo active; exit 0 ;; nobus) echo "Failed to connect to bus" >&2; exit 1 ;;\n'
            '  *) echo "$s"; exit 3 ;; esac\n')
        os.chmod(f"{td}/systemctl", 0o755)
        open(f"{td}/units/cc-slackd.service", "w").write("active\n")

        def unit(state):
            open(f"{td}/units/cc-slackd.service", "w").write(state + "\n")
        goals =f"{td}/state/proj/goals.md"
        os.makedirs(os.path.dirname(goals))
        open(goals, "w").write("# Turns and daemons: proj standing goals (owner, 2026-08-31)\n"
                               "- Give cc-ask more turns when a question needs them.\n"
                               "- Keep the slack daemon on live code after a landing.\n"
                               "- The proj repository is the one I care about most.\n- more turns\n")
        ev = [{"quote": "Give cc-ask more turns when a question needs them.", "source": goals}]
        sev = [{"quote": "Keep the slack daemon on live code", "source": goals}]
        cfg = {"ask": "cc-config set CC_ASK_TURNS 16", "evidence": ev}
        svc = {"ask": "systemctl --user restart cc-slackd", "evidence": sev}
        # the closed set of shapes: each one, evidenced, is a GRANT; claimed hours to undo makes it watched
        for name, a in (("config", cfg), ("service", svc)):
            d = decide(a)
            check(f"the {name} shape with evidence is GRANT", d["verdict"] == "GRANT" and d["shape"] == name
                  and d["evidence"] and d["evidence"][0]["source"] == goals)
            d = decide(dict(a, reversible="hours"))
            check(f"... and GRANT+WATCH with the shape's own undo when it claims hours", d["verdict"] == "GRANT+WATCH"
                  and d["watch"]["revert"] == d["revert"])
            for claim in ({"reversible": "no"}, {"reaches": "member"}, {"reaches": "public"}):
                check(f"... and ASK-OWNER when it claims {claim}", decide(dict(a, **claim))["verdict"] == "ASK-OWNER")
            check(f"... and ASK-OWNER with no evidence", decide(dict(a, evidence=[]))["verdict"] == "ASK-OWNER")
            check(f"... and REFUSE once the owner refused it", decide(dict(a, owner_refused="T1"))["verdict"] == "REFUSE")
            check(f"... and ASK-OWNER under a hard kind", decide(dict(a, kind="controls"))["verdict"] == "ASK-OWNER")
        for k, (lo, hi) in CONFIG_KEYS.items():
            check(f"{k} parses at both ends of its range and not past them",
                  all(parse_shape(f"cc-config set {k} {v}") for v in (lo, hi))
                  and not any(parse_shape(f"cc-config set {k} {v}") for v in (lo - 1, hi + 1) if v >= 0))
        # anything that is not exactly a shape goes to perms, whatever the evidence
        for text in ("cc-config set CC_ASK_TURNS 99", "cc-config set CC_ASK_TURNS 0", "cc-config set CC_TIER 1",
                     "cc-config set CC_LAND_REVIEW 0", "cc-config set CC_LAND_REVIEWERS 0", "cc-config set cc_ask_turns 16",
                     "cc-config set CC_ASK_TURNS -1", "cc-config set CC_ASK_TURNS 16 ; rm -rf ~",
                     "cc-config set CC_ASK_TURNS 16 && true", "cc-config set CC_ASK_TURNS 16\ncc-config set CC_TIER 1",
                     "cc-config  set CC_ASK_TURNS 16", "cc-config\tset CC_ASK_TURNS 16", "cc-config set CC_ASK_TURNS １６",
                     "cc-config unset CC_ASK_TURNS", "CC_ASK_TURNS=16 cc-config set CC_ASK_TURNS 16",
                     "please cc-config set CC_ASK_TURNS 16", "give cc-ask more turns",
                     "systemctl restart cc-slackd", "systemctl --user stop cc-slackd", "systemctl --user disable cc-slackd",
                     "systemctl --user restart sshd", "systemctl --user restart cc-slackd cc-guard",
                     "systemctl --user restart cc-guard", "systemctl --user restart cc-slackd.timer",
                     "systemctl --user restart cc-Slackd", "sudo systemctl --user restart cc-slackd",
                     "systemctl --user restart cc-slackd; systemctl --user stop cc-watchdog",
                     "restart the slack daemon"):
            d = decide({"ask": text, "evidence": ev + sev, "reaches": "box", "reversible": "minutes"})
            check(f"not a shape, so not a grant: {text!r}", d["verdict"] not in GRANTS)
        # evidence must resolve, be a counted line, and share a content word with the ask
        d = decide(dict(cfg, evidence=[{"quote": "Turns and daemons: proj standing goals", "source": goals}]))
        check("a heading line is no evidence", d["verdict"] == "ASK-OWNER" and d["evidence_refused"])
        d = decide(dict(cfg, evidence=sev))
        check("a goal that shares no content word with the ask is no evidence", d["verdict"] == "ASK-OWNER"
              and "no content word" in d["evidence_refused"][0]["why"])
        d = decide({"ask": "systemctl --user restart cc-proj",
                    "evidence": [{"quote": "The proj repository is the one I care about most", "source": goals}]})
        check("a quote that shares only the repo name is no evidence", d["verdict"] == "ASK-OWNER")
        d = decide(dict(cfg, evidence=[{"quote": "make everything public and give cc-ask more turns", "source": goals}]))
        check("a quote that is not in goals.md is no evidence", d["verdict"] == "ASK-OWNER" and d["evidence_refused"])
        d = decide(dict(cfg, evidence=[{"quote": "more turns", "source": goals}]))
        check("a quote under 20 characters is no evidence, even when it is in goals.md", d["verdict"] == "ASK-OWNER"
              and "under 20" in d["evidence_refused"][0]["why"])
        for where in ("scratch/goals.md", "state/proj/sub/goals.md", "state/goals.md", "state/other/goals.md",
                      "dev/proj/goals.md"):
            stray = f"{td}/{where}"
            os.makedirs(os.path.dirname(stray), exist_ok=True); open(stray, "w").write(open(goals).read())
            d = decide(dict(cfg, evidence=[dict(ev[0], source=stray)]))
            check(f"a goals.md that is not ~/.cc/state/<repo>/goals.md is no evidence: {where}",
                  d["verdict"] == "ASK-OWNER" and d["evidence_refused"])
        d = decide(dict(cfg, evidence=[dict(ev[0], source="T20261004T101010-a1b2", message="C0TEST01/1791000002.000200")]))
        check("a cc-lib ticket is no evidence: tickets.log can't tie it to a message", d["verdict"] == "ASK-OWNER"
              and "tickets.log" in d["evidence_refused"][0]["why"])
