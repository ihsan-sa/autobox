        w(".cc/state/land/queue.log", "2026-09-07T20:00:00Z\tqueued r1#320 who=- by=x\n2026-09-07T20:09:00Z\tdone r1#320 rc=1 NOT merged — gate red\n"
          "2026-09-08T10:07:00Z\tdone r1#390 rc=0 landed\nnot an event line\n")
        # cc-failures' ledger (the failure-noticing design, phase 3: the ledger readable through the library): a record,
        # its correction, a claim and the claim's report
        w(".cc/failures/r1.jsonl", json.dumps({"id": "f-0a1b2c3d4e", "ts": "2026-09-07T20:50:00Z", "filed": "2026-09-07T21:10:00Z", "scope": "r1",
                                               "kind": "answer-evidence/wrong-object-or-proxy", "fingerprint": "v1|r1|answer-evidence/wrong-object-or-proxy",
                                               "cluster": "c-9545168e", "expected": "", "observed": "PR #320 reported landed; it had stopped at gates",
                                               "evidence": ["queue.log"], "detector": {"who": "person", "evidence": "caught by someone looking"},
                                               "writer": "session", "cost": ["turns=1"], "links": {"row": "r1/t2"}, "status": "confirmed", "critical": ""}) + "\n"
          + json.dumps({"id": "f-ffffffffff", "ts": "2026-09-08T09:00:00Z", "filed": "2026-09-08T09:00:00Z", "scope": "r1", "kind": "answer-evidence/wrong-object-or-proxy",
                        "fingerprint": "v1|r1|answer-evidence/wrong-object-or-proxy", "cluster": "c-9545168e", "expected": "", "observed": "was a correct report after all",
                        "evidence": [], "detector": {"who": "unknown", "evidence": ""}, "writer": "session", "cost": [], "links": {}, "status": "refuted", "critical": "",
                        "corrects": "f-0a1b2c3d4e"}) + "\n")
        w(".cc/failures/claims.jsonl", json.dumps({"id": "i-11223344", "ts": "2026-09-08T03:40:00Z", "cluster": "c-9545168e", "scope": "r1",
                                                   "kind": "answer-evidence/wrong-object-or-proxy", "why": "3 episodes in 14d", "slot": "routine", "critical": False}) + "\n")
        w(".cc/failures/reports/i-11223344.md", "# finding i-11223344\n\n## Decision: review how answers select their source\nthree episodes used a proxy.\n")
        w(".cc/failures/_cctest77.jsonl", json.dumps({"id": "f-eeeeeeeeee", "ts": "2026-09-08T09:00:00Z", "scope": "_cctest77", "kind": "x/y", "cluster": "c-eeeeeeee",
                                                     "observed": "a fixture ledger a selfcheck left in the live dir", "status": "confirmed", "detector": {}, "links": {}}) + "\n")

        # ---- the index
        rc, out = run("index")
        ok("index builds and reports its measurements", rc == 0 and "sources" in out and "index/text" in out)
        c = db()
        ok("the secret-named file under state/ is excluded, never opened",
           not c.execute("SELECT 1 FROM sources WHERE path LIKE '%secrets.md'").fetchone() and "excluded 1" in out
           and c.execute("SELECT 1 FROM sources WHERE path LIKE '%token-scope.md'").fetchone())
        ok("a record carrying a token shape is refused, not stored, and the refusal is counted",
           not c.execute("SELECT 1 FROM records WHERE text LIKE '%ghp_%'").fetchone() and "refused 1" in out)
        ok("a board named _cctest is not a registry entry",
           not c.execute("SELECT 1 FROM records WHERE track='ghost'").fetchone())
        nsp = c.execute("SELECT COUNT(*) FROM records WHERE title LIKE '%newest' AND part>0").fetchone()[0]
        first = c.execute("SELECT next, prev FROM records WHERE title LIKE '%newest' AND part=0").fetchone()
        ok("a long entry is split at paragraphs into linked spans under 6 KiB",
           nsp >= 2 and first and first[0] and not first[1]
           and all(len(t.encode()) <= SPAN for (t,) in c.execute("SELECT text FROM records")))
        ok("kinds are derived from the store: journal → checkpoint, feedback memory → decision, heading 'Decisions' → decision, "
           "board row → event, note → note, landing tally → finding",
           set(k for (k,) in c.execute("SELECT DISTINCT kind FROM records")) >= {"checkpoint", "decision", "event", "note", "finding", "document"}
           and c.execute("SELECT kind FROM records WHERE title LIKE '%Decisions%'").fetchone()[0] == "decision")
        # ---- the failure ledger through the library
        fr = c.execute("SELECT kind, repo, span, text FROM records WHERE title LIKE 'failure answer-evidence%'").fetchone()
        ok("a failure record is indexed from the ledger as kind finding, under its scope, its cluster as the span, its words as the text",
           fr and fr[0] == "finding" and fr[1] == "r1" and fr[2] == "cluster c-9545168e" and "stopped at gates" in fr[3] and "detector person" in fr[3])
        ok("…a fixture scope (_cctest…) left in the live dir is never a source", not c.execute("SELECT 1 FROM sources WHERE path LIKE '%_cctest77.jsonl'").fetchone())
        ok("…its correction is a note on the record it names, the claim an event, the report a doc",
           c.execute("SELECT kind FROM records WHERE title LIKE 'correction of f-0a1b2c3d4e%'").fetchone()[0] == "note"
           and c.execute("SELECT kind FROM records WHERE title LIKE 'failure claim i-11223344%'").fetchone()[0] == "event"
           and c.execute("SELECT 1 FROM sources WHERE path LIKE '%reports/i-11223344.md' AND skind='doc'").fetchone())
        rc, o = run("ask", "--object", "c-9545168e", "--need", "history")
        ok("the ledger answers a query by cluster id: the record, its correction and the claim all name it",
           rc == 0 and "records naming it" in o and "stopped at gates" in o and "correction of f-0a1b2c3d4e" in o and "failure claim i-11223344" in o and outcome(o) == "answered")
        rc, o = run("ask", "--repo", "r1", "--need", "history", "proxy answer stopped at gates")
        ok("…and by words: the failure's own observed text is a search hit", rc == 0 and "failure answer-evidence/wrong-object-or-proxy" in o)
        rc, o = run("ask", "--object", "#320", "--need", "history")
        ok("…and a PR named in a failure record is found through the record too", "failure answer-evidence" in o)
        ok("exact ids live in their own column: a SHA prefix and repo#pr find the landing record",
           by_ids(c, {"09dd584"}, skind="land-root") and by_ids(c, {"r1#390"}, skind="land-root"))
        c.close()

        # ---- the three worked misses, inside their caps, each with a citation
        rc, o1 = run("ask", "--object", "site", "--need", "current", "--cap", "4096", "is the site still waiting for approval")
        ok("miss 1 (site waiting?): board row + newest note + resolved journal, in 4 KiB, cited, and it says live state was not probed",
           rc == 0 and len(o1.encode()) <= 4096 and "status=parked" in o1 and "owner has used the site" in o1
           and "site-handover.md (exists; absent: ~/.cc/state/r1/site/progress.md, ~/.cc/state/r1/site-handoff.md)" in o1
           and "↳" in o1 and "CURRENT:" in o1 and outcome(o1) == "answered")
        ok("…and every record shown keeps its citation: the cap cuts text, never the ↳ line, and the tail is whole",
           len(re.findall(r"^  \[", o1, re.M)) == len(re.findall(r"^    ↳ ", o1, re.M)) and o1.rstrip().split("\n")[-1].startswith("OUTCOME ")
           and o1.rstrip().split("\n")[-3].startswith("COVERAGE "))
        rc, o7 = run("ask", "--object", "#390", "--need", "current", "--cap", "2048", "buy another review")
        ok("miss 7 (buy another review for #390?): the landing tally answers in 2 KiB — reviews=1, its head and time, cited",
           rc == 0 and len(o7.encode()) <= 2048 and "reviews=1" in o7 and "head=09dd584c561e" in o7 and "land/root/r1-390.json" in o7
           and outcome(o7) == "answered")
        rc, o15 = run("ask", "--object", "r1/site", "--need", "history", "--cap", "8192")
        ok("miss 15 (which journal does the successor read?): the legacy -handover.md is resolved and its newest entry returned, "
           "the absent names listed, in 8 KiB",
           rc == 0 and len(o15.encode()) <= 8192 and "site-handover.md (exists" in o15 and "nothing is left of the row" in o15
           and "cc-lib get" in o15 and outcome(o15) == "answered")
        rc, o15b = run("ask", "--object", "r1/nobody", "--need", "history")
        ok("…and a row with no journal and no board row is an explicit state naming every path tried, never 'none' as fact",
           "journal: none at ~/.cc/state/r1/nobody/progress.md, ~/.cc/state/r1/nobody-handoff.md, ~/.cc/state/r1/nobody-handover.md" in o15b
           and "board row: none named nobody" in o15b and outcome(o15b) == "not-recorded")

        # ---- the other twelve, as the library sees them
        rc, o = run("ask", "--need", "current", "does the token reach every private repo")
        ok("miss 2 (token reach): the rule is found (a decision), and the current caveat says the token itself was not probed",
           "public-repo read proves nothing" in o and "CURRENT:" in o and outcome(o) in ("answered", "partial"))
        rc, o = run("ask", "--need", "current", "--repo", "r1", "which scopes does the token have")
        ok("miss 3 (token scopes): what exists is a journal line that says the list was typed and not verified — returned as a "
           "checkpoint with its stamp, not as the object", "[checkpoint 2026-09-10T23:30Z]" in o and "Not verified" in o)
        rc, o = run("ask", "--object", "r1#36", "--need", "history", "when was it reviewed")
        ok("miss 4 (#36 incident): the review's own time comes off the landing record", "at=2026-09-08T01:14:00Z" in o and "DO-NOT-LAND" in o)
        rc, o = run("ask", "--need", "decision", "dashboard tile number and label source")
        ok("miss 5 (tile sources): the owner's rule outranks prose — the decision is the first hit",
           re.search(r"HITS.*\n  \[decision", o) is not None)
        rc, o = run("ask", "--object", "t1", "--need", "current", "--cap", "4096")
        ok("miss 6 (stale 'waiting until 17:10Z'): the newest journal entry and `now` are both in the packet",
           "worker restarted" in o and "· now 20" in o and "waiting until 17:10Z" in o)
        rc, o = run("ask", "--need", "decision", "git fetch shared checkout FETCH_HEAD")
        ok("miss 8 (FETCH_HEAD): the rule is found and its copy collapses into one hit with provenance",
           "FETCH_HEAD is per-worktree" in o and "also:" in o)
        rc, o = run("ask", "--need", "aggregate", "per-attempt timing of the suite, 9630 seconds")
        ok("miss 9 (2.7 h gate): no source holds per-attempt timing — not recorded, never a number",
           outcome(o) == "not-recorded" and "not recorded" in o and "9630" not in o.split("OUTCOME")[0].split("\n", 1)[1])
        rc, o = run("ask", "--need", "history", "gate red unicorn")
        ok("a query only the any-word phase matches is labelled a lead, not an answer, and the outcome is partial",
           "any word" in o and outcome(o) == "partial")
        rc, o = run("ask", "--need", "decision", "which log does cc-green write")
        ok("miss 10 (green log): the rule is found", "cc-green status" in o)
        rc, o = run("ask", "--need", "history", "selfcheck red CC_SLACK_ALIAS")
        ok("miss 11 (red selfcheck): the journal entry that settled it is found", "not a main regression" in o)
        rc, o = run("ask", "--object", "orch-x", "--need", "current", "context percent")
        ok("miss 12 (orch at 72%?): a live figure is not a record — the row is returned and the caveat says probe, nothing invents a percent",
           "row orch-x" in o and "CURRENT:" in o and not re.search(r"72\s*%", o))   # the percent, not the ask's own ms/bytes figures
        rc, o = run("ask", "--object", "#323", "--need", "history")
        ok("miss 13 (#323 stale ref): the journal entry naming the PR is found by id", "refs/pull/323/head" in o)
        rc, o = run("ask", "--object", "#320", "--need", "current", "--cap", "4096")
        ok("miss 14 (#320 landed?): the landing job says stage=gates rc=1 and the queue says NOT merged; nothing says landed",
           "stage=gates" in o and "NOT merged" in o and "rc=0 landed" not in o)
        rc, o = run("ask", "unicorn migration to the moon")
        ok("an unanswerable question is 'not recorded in the covered scope' with coverage, outcome not-recorded",
           outcome(o) == "not-recorded" and "COVERAGE sources" in o and "not recorded" in o)
        rc, o = run("ask", "--cap", "1200", "--need", "history", "--repo", "r1", "site handover journal")
        ok("the byte cap is the rule: a 1200-byte packet is at most 1200 bytes and says how to get the rest",
           len(o.encode()) <= 1200 and ("cc-lib get" in o or "cap reached" in o))

        # ---- the ticket: one line per call, scope/bytes/turns/time/outcome, no query text; a spent ticket refuses
        T = re.search(r"ticket (T\d{8}T\d{6}-[0-9a-f]{4})", o1).group(1)
        lines = [l.split("\t") for l in open(ticketlog()).read().splitlines()]
        mine = [l for l in lines if l[1] == T]
        ok("a ticket line per question: ts, ticket, turn, cmd, scope, need, object, bytes, ms, outcome — and the bytes are the packet's",
           len(mine) == 1 and mine[0][3] == "ask" and mine[0][5] == "current" and mine[0][6] == "site"
           and int(mine[0][7]) == len(o1.encode()) and mine[0][9] == "answered" and len(mine[0]) == 10)
        ok("the query text stays out of the ticket log", "approval" not in open(ticketlog()).read())
        rid = re.search(r"↳ (\S+)", o15).group(1)
        rc, g = run("get", rid, "--ticket", T)
        ok("get returns one page by id, cited, charged to the ticket as turn 2",
           rc == 0 and "cc-lib get " + rid in g and "↳" in g and ticket_used(T)[1] == 2)
        for _ in range(3):
            ticket_write(T, 9, "get", "r1", None, rid, 8192, 1, "answered")
        rc, g = run("get", rid, "--ticket", T)
        ok("a spent ticket refuses further output (rc 3) and logs the refusal", rc == 3 and ticket_used(T)[1] == 6
           and lines_with(T, "refused"))
        rc, g = run("get", "nope:0")
        ok("a record id the index does not hold is rc 1 and says so", rc == 1)

        # ---- staleness: a source that changed is re-read on the next ask; one that vanished is dropped
        c = db()
        rid0 = c.execute("SELECT rid FROM records WHERE text LIKE '%iter 1%started.'").fetchone()[0]
        c.close()
        time.sleep(0.02)
        p = w(".cc/state/r1/t1/progress.md", "## 2026-09-08T08:00Z iter 1\nstarted.\n\n## 2026-09-08T09:30Z iter 2\nworker restarted after "
              "the rate-limit stall; the earlier 'waiting until 17:10Z' line is stale.\n\n## 2026-09-08T11:00Z iter 3\nDONE: gates green.\n")
        os.utime(p, (time.time() + 2, time.time() + 2))
        rc, o = run("ask", "--object", "r1/t1", "--need", "current")
        ok("a changed journal is re-read inside ask's reconcile budget: the newest entry is the new one", "DONE: gates green" in o)
        c = db()
        ok("…at record grain: the unchanged entries kept their ids (a `get` after the re-index still works); only the new one was inserted",
           c.execute("SELECT COUNT(*) FROM records r JOIN sources s ON s.id=r.source_id WHERE s.path=?", (p,)).fetchone()[0] == 3
           and c.execute("SELECT rid FROM records WHERE text LIKE '%iter 1%started.'").fetchone()[0] == rid0)
        c.close()
        # a kept record whose TITLE changed (a memory's description edited, its body untouched — so its text hash, the
        # record's identity, is the same): the FTS row must follow the title, or the new words are "not recorded"
        c = db()
        mid = c.execute("SELECT id FROM records WHERE title LIKE 'a figure whose number and label%'").fetchone()[0]
        c.close()
        p = w(".claude/projects/-x-dev-r1/memory/verify-figures.md", "---\nname: verify-figures\ndescription: a figure whose number and "
              "caption come from two tools is a bug; check at the hour the bases differ (the zebrafish rule)\nmetadata:\n  type: feedback\n"
              "---\n\nverify figures at the boundary (owner 09-08).\n")
        os.utime(p, (time.time() + 2, time.time() + 2))
        rc, o = run("ask", "zebrafish rule")
        c = db()
        row = c.execute("SELECT id, title FROM records WHERE title LIKE '%zebrafish%'").fetchone()
        ok("a memory whose description changed under an unchanged body is found by its new words, on the same record id",
           "zebrafish" in o and row is not None and row[0] == mid)
        ok("…and the FTS row followed the title: the new word is indexed on that rowid, the word that left it is not",
           c.execute("SELECT COUNT(*) FROM fts WHERE fts MATCH 'zebrafish' AND rowid=?", (mid,)).fetchone()[0] == 1
           and c.execute("SELECT COUNT(*) FROM fts WHERE fts MATCH 'label' AND rowid=?", (mid,)).fetchone()[0] == 0)
        c.close()
        os.remove(os.path.join(th, ".cc/state/land/r1-320.json"))
        rc, o = run("ask", "--object", "#320", "--need", "current")
        ok("a source that vanished is dropped from the index, not answered from", "stage=gates" not in o and "NOT merged" in o)
        # unreadable: a board that does not parse is named, not skipped in silence
        w(".cc/boards/r2.json", "{not json")
        rc, o = run("index")
        ok("a source that cannot be read is named in the report and in coverage", "unreadable 1" in o and "r2.json" in o)
        rc, o = run("ask", "anything at all r2")
        ok("…and every ask carries it in COVERAGE", "unreadable 1" in o)

        # ---- index-at-write: `index --touch` is what the writing tools call the moment they wrote. The proof that the
        # HOOK indexed the line (and not ask's own reconcile, which the staleness cases above already show) is that
        # the record is in the index before any ask, and the ask then reports no `re-read`.
        jp = os.path.join(th, ".cc/state/r1/t1/progress.md")
        with open(jp, "a") as f:
            f.write("\n## 2026-09-08T12:00Z iter 4\nhook-indexed: the lantern line, r1#391 landed.\n")
        os.utime(jp, (time.time() + 3, time.time() + 3))
        rc, o = run("index", "--touch", jp)
        c = db()
        row = c.execute("SELECT id, kind, track FROM records WHERE text LIKE '%lantern line%'").fetchone()
        ok("touch a journal a tool just appended to: exit 0, one source re-read, and the new record is in the index BEFORE any ask, with its kind and ids",
           rc == 0 and "1 source(s) re-read" in o and row is not None and row[1] == "checkpoint" and row[2] == "t1"
           and {"t1", "r1#391", "#391"} <= set(i for (i,) in c.execute("SELECT id FROM rids WHERE record_id=?", (row[0],))))
        c.close()
        rc, o = run("ask", "--object", "r1/t1", "--need", "current", "lantern line")
        ok("…so a question a minute later finds it, and COVERAGE carries no `re-read`: ask had nothing to bring in itself",
           "lantern line" in o and "re-read" not in o and "hook-misses" not in o)
        # RED-FIRST CONTROL: the same append with no hook. ask still finds it (its own reconcile), but now says so —
        # `re-read 1` is the hooks' misses, measured, which is the line the hook cases in cc-board/cc-handoff go red on.
        with open(jp, "a") as f:
            f.write("\n## 2026-09-08T12:30Z iter 5\nno hook: the candle line.\n")
        os.utime(jp, (time.time() + 4, time.time() + 4))
        c = db()
        gone = not c.execute("SELECT 1 FROM records WHERE text LIKE '%candle line%'").fetchone()
        c.close()
        rc, o = run("ask", "--object", "r1/t1", "--need", "current", "candle line")
        ok("control: the same append with no touch is not in the index until an ask reconciles it, and that ask says `re-read 1`",
           gone and "candle line" in o and "re-read 1" in o)
        # the directory form: every registered source under it whose cursor moved, nothing else re-read
        j2 = os.path.join(th, ".cc/state/r1/site-handover.md")
        with open(j2, "a") as f:
            f.write("\n## 2026-09-11T17:00Z after\nthe director line.\n")
        os.utime(j2, (time.time() + 5, time.time() + 5))
        with open(jp, "a") as f:
            f.write("\n## 2026-09-08T13:00Z iter 6\nthe director line too.\n")
        os.utime(jp, (time.time() + 6, time.time() + 6))
        rc, o = run("index", "--touch", os.path.join(th, ".cc/state"))
        ok("touch a DIRECTORY (cc-checkpoint's form): the two registered sources under it whose cursor moved are re-read, the rest are not",
           rc == 0 and "2 source(s) re-read" in o)

        # ---- a hook that cannot index: the write it followed stands (the callers discard this exit — their own cases
        # prove that), the failure is one line in misses.log, exit 1, and every ask says `hook-misses N` until a full
        # index has reconciled everything. Two failure kinds: a path the registry does not know, and an index that
        # cannot be opened (here: a directory sitting where the sqlite file is, the shape a locked or torn index takes).
        stray = w(".cc/state/r1/t1/notes.txt", "a file no registry lists\n")
        rc, o = run("index", "--touch", stray)
        ml = misseslog()
        ok("touch a path that is no registered source: exit 1, one miss line naming it and why, nothing read",
           rc == 1 and "misses logged" in o and os.path.exists(ml) and sum(1 for l in open(ml) if stray in l and "not a registered source" in l) == 1)
        os.rename(dbpath(), dbpath() + ".held")
        os.mkdir(dbpath())
        with open(jp, "a") as f:
            f.write("\n## 2026-09-08T14:00Z iter 7\nthe beacon line, written while the index was unopenable.\n")
        os.utime(jp, (time.time() + 7, time.time() + 7))
        rc, o = run("index", "--touch", jp)
        ok("touch while the index cannot be opened: exit 1, the miss logged with the reason, and the journal line it followed is still on disk",
           rc == 1 and sum(1 for l in open(ml) if jp in l and "index:" in l) == 1 and "beacon line" in open(jp).read())
        os.rmdir(dbpath())
        os.rename(dbpath() + ".held", dbpath())
        rc, o = run("ask", "--object", "r1/t1", "--need", "current", "beacon line")
        ok("…and the next ask says so — `hook-misses 2` in COVERAGE — while still finding the line by its own reconcile (`re-read 1`)",
           rc == 0 and "hook-misses 2" in o and "re-read 1" in o and "beacon line" in o)

        # ---- an edit that bypassed every hook is picked up by the sweep (cc-checkpoint --sweep runs `cc-lib index`):
        # the record appears, the misses log is cleared because every source is current, and the ask after it is clean.
        with open(j2, "a") as f:
            f.write("\n## 2026-09-11T18:00Z bypass\nthe sextant line, edited by hand.\n")
        os.utime(j2, (time.time() + 8, time.time() + 8))
        rc, o = run("index")
        c = db()
        found = c.execute("SELECT 1 FROM records WHERE text LIKE '%sextant line%'").fetchone()
        c.close()
        ok("the sweep (a full `index`) picks up a hand edit no hook saw, reports `re-read 1`, and clears the hook-misses log (`hook-misses 2 cleared`)",
           rc == 0 and found and "re-read 1" in o and "hook-misses 2 cleared" in o and not os.path.exists(ml))
        rc, o = run("ask", "--object", "site", "--need", "history", "sextant line")
        ok("…after which an ask is clean: the line is found, no `hook-misses`, no `re-read`",
           "sextant line" in o and "hook-misses" not in o and "re-read" not in o)
        # control: a sweep that did NOT reach every source keeps the log — a miss is only repaired by a pass that covered it
        miss(jp, "control")
        w(".cc/boards/r3.json", "{still not json")
        rc, o = run("index")
        ok("control: the log is cleared only by a pass that reached every source; an unreadable one is not pending, so this one clears too "
           "(unreadable is named in coverage on its own)", "hook-misses 1 cleared" in o and not os.path.exists(ml))
        os.remove(os.path.join(th, ".cc", "boards", "r3.json"))
        selfcheck_workspaces(th, ok, run, w)
    finally:
        H = H0
        shutil.rmtree(th, ignore_errors=True)
    print(f"cc-lib selfcheck: {n[0]} passed, {n[1]} failed")
    return 1 if n[1] else 0


def selfcheck_workspaces(th, ok, run, w):
    """WORKSPACE SCOPING (P2), each case built the way production launches a member: two member workspaces and the
    box's own repo under the fixture HOME, the REAL cc-sandbox beside this file launching bwrap with HOME=<fixture>,
    and inside it the cc-lib the launcher binds as ~/bin — this one. The acceptance test is confidentiality: what a
    member's shell, SQL and grep can reach in there, not what its `ask` chooses to show."""
    import shutil
    import subprocess
    import stat
    binroot = os.environ.get("CC_LIB_SELFCHECK_BIN") or os.path.dirname(os.path.realpath(__file__))
    K = "K" + os.urandom(4).hex()   # the secret's shape, minted per run: this file is bound as ~/bin inside, so no literal of it may match
    sandbox = os.path.join(binroot, "cc-sandbox")
    env = {k: v for k, v in os.environ.items() if k not in ("CC_MEMBER_SANDBOX", "CC_ROLE")}
    env["HOME"] = th

    def member(h, script, **kw):
        """A member session of <h>, the production way: bwrap, cleared environment, cc-lib from ~/bin."""
        return subprocess.run([sandbox, "member", h, "--", "sh", "-c", script], env=env, capture_output=True, text=True, timeout=60, **kw)

    def mk(h):
        os.makedirs(os.path.join(th, "dev", h, ".cc"), exist_ok=True)
        os.makedirs(os.path.join(th, ".cc", "members", h), exist_ok=True)
        w(f"dev/{h}/.cc/member-workspace", "")
        w(f"dev/{h}/.cc/member-facing", "")
        subprocess.run(["git", "-C", os.path.join(th, "dev", h), "init", "-q", "-b", "main"], check=True)
        subprocess.run(["git", "-C", os.path.join(th, "dev", h), "-c", "user.name=t", "-c", "user.email=t@t", "commit", "-q", "--allow-empty", "-m", "i"], check=True)
        w(f".cc/members/{h}/credentials.json", json.dumps({"claudeAiOauth": {"accessToken": "a", "refreshToken": "r", "expiresAt": 99999999999999}}))
        os.chmod(os.path.join(th, ".cc", "members", h, "credentials.json"), 0o600)
        w(f".cc/boards/{h}.json", json.dumps({"repo": h, "path": os.path.join(th, "dev", h), "tracks": {
            "t1": {"title": f"{h} row", "kind": "track", "status": "running", "notes": [{"ts": "2026-09-11T00:00:00Z", "msg": f"{K}-{h}-note"}]}}, "log": []}))
        w(f".cc/state/{h}/t1/progress.md", f"## 2026-09-11T01:00Z first\n{K}-{h}-journal line.\n")
        w(f"dev/{h}/docs/d.md", f"# doc\n\n## sec\n{K}-{h}-doc.\n")
    for h in ("wsa", "wsb"):
        mk(h)
    w("dev/r1/docs/owner-only.md", f"# owner\n\n## sec\n{K}-own-doc.\n")
    w(".local/bin/claude", "")
    os.chmod(os.path.join(th, ".local", "bin", "claude"), 0o755)
    w(".claude.json", "{}")
    w(".claude/settings.json", "{}")
    probe = ("echo LIB=$(ls -A ~/.cc/library | tr '\\n' ' '); echo WSDIR=$(ls -A ~/.cc/library/workspace | tr '\\n' ' '); "
             f"echo GREP=$(grep -rl '{K}-wsb\\|{K}-own' \"$HOME\" /tmp 2>/dev/null | wc -l); "
             "echo OWNER=$(python3 -c \"import sqlite3; sqlite3.connect('file://$HOME/.cc/library/owner/index.sqlite?mode=ro', uri=True).execute('select 1')\" 2>&1 | grep -c 'unable to open'); "
             "echo SQL=$(python3 -c \"import sqlite3, os\n"
             "fs = [os.path.join(d, f) for d, _, fs in os.walk(os.environ['HOME']) for f in fs if f.endswith('.sqlite')]\n"
             "leak = mine = 0\n"
             "for f in fs:\n"
             "    c = sqlite3.connect('file:' + f + '?mode=ro&immutable=1', uri=True)\n"
             f"    leak += c.execute(\\\"select count(*) from records where text like '%{K}-wsb%' or text like '%{K}-own%'\\\").fetchone()[0]\n"
             f"    mine += c.execute(\\\"select count(*) from records where text like '%{K}-wsa%'\\\").fetchone()[0]\n"
             "print(len(fs), leak, mine)\"); "
             "echo WRITE=$(touch ~/.cc/library/workspace/x 2>&1 | grep -c 'Read-only'); "
             "echo INDEX=$(cc-lib index --touch ~/.cc/state >/dev/null 2>&1; echo $?); "
             f"cc-lib ask --need history {K}")
    # ── the host indexes: one file per workspace under the protected parent, the owner's aggregate names each record's workspace ──
    rc, o = run("index")
    ida, idb = ws_id("wsa"), ws_id("wsb")
    ok("the host's index mints an immutable id per member workspace (~/.cc/members/<h>/workspace-id, 16 hex) and builds one file per "
       "workspace under ~/.cc/library/ws/<id>/, naming each: `workspaces 2: wsa=… wsb=…`",
       rc == 0 and bool(ida) and bool(idb) and ida != idb and "workspaces 2: wsa=" in o and "wsb=" in o
       and os.path.isfile(os.path.join(th, ".cc", "library", "ws", ida, "index.sqlite")) and os.path.isfile(os.path.join(th, ".cc", "library", "ws", idb, "index.sqlite")))
    ok("the protected parent and every workspace directory are the host's alone (0700), and the registry names id → handle",
       stat.S_IMODE(os.stat(os.path.join(th, ".cc", "library", "ws")).st_mode) == 0o700
       and json.load(open(os.path.join(th, ".cc", "library", "registry.json")))[ida]["handle"] == "wsa")
    rc, o = run("ask", "--need", "history", K)
    ok("the owner's ask returns the UNION, each record's workspace named on its citation: ws=wsa, ws=wsb and ws=owner in one packet",
       f"{K}-wsa-journal" in o and f"{K}-wsb-journal" in o and f"{K}-own-doc" in o
       and " ws=wsa" in o and " ws=wsb" in o and " ws=owner" in o)
    wsa_file = os.path.join(th, ".cc", "library", "ws", ida, "index.sqlite")
    cw = sqlite3.connect(f"file:{wsa_file}?mode=ro&immutable=1", uri=True)
    n_leak = cw.execute(f"SELECT COUNT(*) FROM records WHERE text LIKE '%{K}-wsb%' OR text LIKE '%{K}-own%'").fetchone()[0]
    n_mine = cw.execute(f"SELECT COUNT(*) FROM records WHERE text LIKE '%{K}-wsa%'").fetchone()[0]
    meta = dict(cw.execute("SELECT k, v FROM meta"))
    cw.close()
    ok("a workspace's file holds its own board note, journal entry and doc (3) and NOT ONE record of another workspace or of the owner's, "
       "and names the workspace it is", n_mine == 3 and n_leak == 0 and meta.get("workspace") == "wsa" and meta.get("workspace_id") == ida)
    ok("…and it is left in rollback-journal mode with nothing beside it (the read-only side needs no -wal or -shm)",
       not glob.glob(wsa_file + "-*") and not glob.glob(os.path.join(os.path.dirname(wsa_file), ".index.*")))
    # ── inside a member's boundary, the production launch: shell, SQL and grep reach one file, its own ──
    r = member("wsa", probe)
    g = lambda k: re.search(rf"^{k}=(.*)$", r.stdout, re.M).group(1).strip() if re.search(rf"^{k}=(.*)$", r.stdout, re.M) else "?"
    ok("a member session launches with ~/.cc/library holding `workspace` alone (the directory bound, ro) and in it one index.sqlite",
       r.returncode == 0 and g("LIB") == "workspace" and g("WSDIR") == "index.sqlite")
    ok("inside, a raw grep over the whole HOME and /tmp finds no byte of another workspace's records or the owner's (0 files)", g("GREP") == "0")
    ok("inside, the owner aggregate's path does not open (absent, not filtered), and SQL over every .sqlite in reach reads 1 file, "
       "0 records of another workspace or the owner's, 3 of its own", g("OWNER") == "1" and g("SQL") == "1 0 3")
    ok("inside, the file cannot be written (read-only bind) and `cc-lib index --touch` writes nothing and exits 0 (the hooks discard it)",
       g("WRITE") == "1" and g("INDEX") == "0")
    ok("inside, `cc-lib ask` is scoped `workspace wsa`, says the scope is host-indexed, finds its own three records and no other workspace's, "
       "each citation naming ws=wsa", "scope workspace wsa" in r.stdout and "host-indexed, this workspace only" in r.stdout
       and f"{K}-wsa-journal" in r.stdout and f"{K}-wsa-note" in r.stdout and f"{K}-wsa-doc" in r.stdout
       and f"{K}-wsb" not in r.stdout and f"{K}-own" not in r.stdout and " ws=wsa" in r.stdout and " ws=wsb" not in r.stdout)
    # ── a forged scope at write time is refused: nothing a session writes moves a record across workspaces ──
    bj = os.path.join(th, ".cc", "boards", "wsa.json")   # a link into the member's board dir since the launch above; the member writes it
    b = json.load(open(bj))
    b["path"] = os.path.join(th, "dev", "r1")            # the board claims the box's own repo as its project
    b["repo"] = "wsb"                                     # …and another handle as its name
    with open(bj, "w") as f:
        json.dump(b, f)
    w("dev/wsa/.cc/workspace-id", idb + "\n")            # …and plants another workspace's id in the tree it owns
    w(".cc/state/wsa/t1/progress.md", f"## 2026-09-11T01:00Z first\n{K}-wsa-journal line.\n\n## 2026-09-11T02:00Z forged\n{K}-wsa-forged line.\n")
    rc, o = run("index")
    cw = sqlite3.connect(f"file:{wsa_file}?mode=ro&immutable=1", uri=True)
    n_own = cw.execute(f"SELECT COUNT(*) FROM records WHERE text LIKE '%{K}-own%'").fetchone()[0]
    n_forged = cw.execute(f"SELECT COUNT(*) FROM records WHERE text LIKE '%{K}-wsa-forged%'").fetchone()[0]
    cw.close()
    cb_ = sqlite3.connect(f"file:{os.path.join(th, '.cc', 'library', 'ws', idb, 'index.sqlite')}?mode=ro&immutable=1", uri=True)
    n_cross = cb_.execute(f"SELECT COUNT(*) FROM records WHERE text LIKE '%{K}-wsa%'").fetchone()[0]
    cb_.close()
    ok("a member's board claiming the box's repo as its `path` and another handle as its `repo`, and an id planted in its own tree: "
       "the scope comes from WHERE (the launch's handle, ~/dev/<h>), so its file still gets its own new record (1), no owner doc (0), "
       "and the other workspace's file gets nothing of it (0)", rc == 0 and n_forged == 1 and n_own == 0 and n_cross == 0 and ws_id("wsa") == ida)
    b["path"], b["repo"] = os.path.join(th, "dev", "wsa"), "wsa"
    with open(bj, "w") as f:
        json.dump(b, f)
    os.remove(os.path.join(th, "dev", "wsa", ".cc", "workspace-id"))
    mk("wsc")
    idf = os.path.join(th, ".cc", "members", "wsc", "workspace-id")
    os.symlink(os.path.join(th, ".cc", "members", "wsa", "workspace-id"), idf)
    rc, o = run("index")
    r = member("wsc", "echo LIB=$(ls -A ~/.cc/library 2>/dev/null | tr '\\n' ' ')x")
    ok("a workspace-id that is a link (to another workspace's) is refused at write time — no file built, `refused` names it — "
       "and its launch binds no library at all rather than the wrong one", ws_id("wsc") is None and "refused: wsc:" in o
       and not os.path.isdir(os.path.join(th, ".cc", "library", "ws", ida, "wsc")) and r.returncode == 0 and "LIB=x" in r.stdout
       and "is not a workspace id" in r.stderr)
    os.remove(idf)
    w(".cc/members/wsc/workspace-id", "../owner\n")
    rc, o = run("index")
    ok("…and so is one holding anything but 16 hex (`../owner`): refused, nothing written under that name",
       ws_id("wsc") is None and "refused: wsc:" in o and not os.path.lexists(os.path.join(th, ".cc", "library", "owner", "index.sqlite.tmp"))
       and sorted(os.listdir(os.path.join(th, ".cc", "library", "ws"))) == sorted([ida, idb]))
    shutil.rmtree(os.path.join(th, "dev", "wsc"))
    shutil.rmtree(os.path.join(th, ".cc", "members", "wsc"))
    os.remove(os.path.join(th, ".cc", "boards", "wsc.json"))
    # ── a symlink planted in the protected parent is not followed: not by the host's write, not by the launch ──
    own_db = os.path.join(th, ".cc", "library", "owner", "index.sqlite")

    def own_meta():   # the aggregate is still the aggregate: a workspace build would have stamped it `workspace`
        return dict(sqlite3.connect(f"file:{own_db}?mode=ro", uri=True).execute("SELECT k, v FROM meta"))
    before = os.stat(own_db)
    wsb_dir = os.path.join(th, ".cc", "library", "ws", idb)
    shutil.rmtree(wsb_dir)
    os.symlink(os.path.join(th, ".cc", "library", "owner"), wsb_dir)
    w(".cc/state/wsb/t1/progress.md", f"## 2026-09-11T01:00Z first\n{K}-wsb-journal line.\n\n## 2026-09-11T03:00Z more\n{K}-wsb-more.\n")
    rc, o = run("index")
    after = os.stat(own_db)
    r = member("wsb", "echo STARTED")
    ok("ws/<id> replaced by a link to the owner's directory: the host's index refuses that workspace (`refused: wsb: … symlink`), writes "
       "nothing through it (the owner aggregate's inode, size and mtime are untouched; no .tmp beside it), and the launch of that "
       "workspace REFUSES (exit 2, nothing bound, nothing started)",
       "refused: wsb:" in o and "symlink" in o and before.st_ino == after.st_ino and "workspace" not in own_meta()
       and not glob.glob(os.path.join(th, ".cc", "library", "owner", ".index.*")) and r.returncode == 2 and "STARTED" not in r.stdout
       and "nothing was bound" in r.stderr.lower())
    os.remove(wsb_dir)
    os.mkdir(wsb_dir, 0o700)
    os.symlink(own_db, os.path.join(wsb_dir, "index.sqlite"))
    rc, o = run("index")
    ok("…and a link at ws/<id>/index.sqlite itself: refused too, the owner aggregate still untouched",
       "refused: wsb:" in o and "link" in o and os.path.islink(os.path.join(wsb_dir, "index.sqlite"))
       and before.st_ino == os.stat(own_db).st_ino and "workspace" not in own_meta())
    os.remove(os.path.join(wsb_dir, "index.sqlite"))
    rc, o = run("index")
    ok("control: the real directory back, the workspace's file is rebuilt and holds its new entry", "refused:" not in o
       and f"{K}-wsb-more" in sqlite3.connect(f"file:{wsb_dir}/index.sqlite?mode=ro&immutable=1", uri=True)
       .execute("SELECT group_concat(text) FROM records").fetchone()[0])
    # ── a RUNNING member: sees an atomic replacement of its file, and stays on its own workspace across a rename ──
    st_dir = os.path.join(th, ".cc", "state", "wsa")
    for f in ("out1", "out2", "out3", "go1", "go2"):
        try:
            os.remove(os.path.join(st_dir, f))
        except OSError:
            pass
    script = (f"S=~/.cc/state/wsa; cc-lib ask --need history {K} > $S/out1 2>&1; "
              f"while [ ! -f $S/go1 ]; do sleep 0.1; done; cc-lib ask --need history {K} > $S/out2 2>&1; "
              f"while [ ! -f $S/go2 ]; do sleep 0.1; done; cc-lib ask --need history {K} > $S/out3 2>&1; echo scope=$(ls -A ~/.cc/library/workspace)")
    proc = subprocess.Popen([sandbox, "member", "wsa", "--", "sh", "-c", script], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)

    def wait_for(path, secs=15):
        t0 = time.monotonic()
        while time.monotonic() - t0 < secs:
            if os.path.exists(path) and os.path.getsize(path) > 0:
                return True
            time.sleep(0.1)
        return False
    got1 = wait_for(os.path.join(st_dir, "out1"))
    ino0 = os.stat(wsa_file).st_ino
    with open(os.path.join(st_dir, "t1", "progress.md"), "a") as f:
        f.write(f"\n## 2026-09-11T04:00Z replaced\n{K}-wsa-replaced line.\n")
    rc, o = run("index", "--touch", os.path.join(st_dir, "t1", "progress.md"))   # the hook's form, as cc-checkpoint calls it
    ino1 = os.stat(wsa_file).st_ino
    w(".cc/state/wsa/go1", "go")
    got2 = wait_for(os.path.join(st_dir, "out2"))
    out1 = open(os.path.join(st_dir, "out1")).read() if got1 else ""
    out2 = open(os.path.join(st_dir, "out2")).read() if got2 else ""
    ok("a write hook on the member's journal (`index --touch <file>`) rebuilds its workspace file BY RENAME (a new inode, `1 workspace file(s) "
       "rebuilt`), and the session already running sees the new entry on its next ask and not before — the directory is bound, not the inode",
       got1 and got2 and rc == 0 and "1 workspace file(s) rebuilt" in o and ino1 != ino0
       and f"{K}-wsa-replaced" not in out1 and f"{K}-wsa-replaced" in out2 and f"{K}-wsb" not in out2)
    # the rename: ~/dev/wsa → ~/dev/wsz, its host-side member dir, state and board with it; the id file moves along, the id stays
    os.rename(os.path.join(th, "dev", "wsa"), os.path.join(th, "dev", "wsz"))
    os.rename(os.path.join(th, ".cc", "members", "wsa"), os.path.join(th, ".cc", "members", "wsz"))
    os.rename(st_dir, os.path.join(th, ".cc", "state", "wsz"))
    bsrc = os.path.join(th, ".cc", "members", "wsz", "board")
    os.rename(os.path.join(bsrc, "wsa.json"), os.path.join(bsrc, "wsz.json"))
    b = json.load(open(os.path.join(bsrc, "wsz.json")))
    b["repo"], b["path"] = "wsz", os.path.join(th, "dev", "wsz")
    with open(os.path.join(bsrc, "wsz.json"), "w") as f:
        json.dump(b, f)
    for f in ("wsa.json", "wsa.lock"):
        try:
            os.remove(os.path.join(th, ".cc", "boards", f))
        except OSError:
            pass
    os.symlink(os.path.join(bsrc, "wsz.json"), os.path.join(th, ".cc", "boards", "wsz.json"))
    rc, o = run("index")
    w(".cc/state/wsz/go2", "go")
    try:
        so, se = proc.communicate(timeout=20)
    except subprocess.TimeoutExpired:
        proc.kill()
        so, se = proc.communicate()
    out3p = os.path.join(th, ".cc", "state", "wsz", "out3")
    out3 = open(out3p).read() if os.path.exists(out3p) else ""
    ok("the handle renamed under a RUNNING session (wsa → wsz: dev, member dir, state, board): the host re-indexes under the new name into the "
       "SAME directory (the id moved with the member dir), and the session launched before the rename still reads its own workspace — "
       "`scope workspace wsz`, its records under their new paths, nothing of another workspace's",
       proc.returncode == 0 and ws_id("wsz") == ida and "workspaces 2: wsb=" in o and "wsz=" in o and "scope workspace wsz" in out3
       and f"{K}-wsa-journal" in out3 and "~/.cc/state/wsz/t1/progress.md" in out3 and " ws=wsz" in out3 and f"{K}-wsb" not in out3
       and "scope=index.sqlite" in so)
    rc, o = run("ask", "--need", "history", f"{K}-wsa-journal")
    ok("…and the owner's aggregate now names it ws=wsz, with no record left under the old handle", " ws=wsz" in o and " ws=wsa" not in o)


def lines_with(T, outcome):
    try:
        return any(l.split("\t")[1] == T and l.rstrip("\n").split("\t")[-1] == outcome for l in open(ticketlog()))
    except OSError:
        return False


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd, rest = argv[0], argv[1:]
    if cmd == "selfcheck":
        return selfcheck()
    if not fts5_available():
        print("cc-lib: this Python's sqlite3 has no FTS5 — nothing here can run", file=sys.stderr)
        return 2
    if cmd == "ask":
        return ask(rest)
    if cmd == "get":
        return get(rest)
    if cmd == "index":
        return index(rest)
    if cmd == "bench":
        return bench(rest)
    print("usage: cc-lib ask|get|index [--touch <path>...]|bench|selfcheck (cc-lib --help for the contract)", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        os._exit(0)
    except KeyboardInterrupt:
        sys.exit(130)
