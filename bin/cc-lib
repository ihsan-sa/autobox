        w(".cc/state/land/root/r1-390.json", json.dumps({"first": "2026-09-08T10:00:00Z", "repo": "r1", "pr": 390, "at": "2026-09-08T10:07:00Z",
                                                          "reviews": 1, "wall": {"head": "09dd584c561e9e18d3025a8db244809f9d5b776a", "cap": "$3/40t", "cost": "$2.10", "turns": 9, "hit": "-"}, "asked": 1}))
        w(".cc/state/land/root/r1-36.json", json.dumps({"first": "2026-09-08T01:10:00Z", "repo": "r1", "pr": 36, "at": "2026-09-08T01:14:00Z", "reviews": 1,
