#!/usr/bin/env bash
# cc-bin-at — a throwaway copy of bin/ at a ref, holding no symlink into any checkout. The ONE supported way to
# get a baseline bin/ to run an old selfcheck against.
#
#   cc-bin-at <ref> [DIR]        bin/ as <ref> has it, into DIR (default: a fresh dir under TMPDIR); prints the path
#   cc-bin-at worktree [DIR]     …as the checkout has it on disk right now, symlinks resolved to real files
#   cc-bin-at -C <bindir> …      which bin/ to take (default: the directory this file lives in)
#   cc-bin-at selfcheck
#
# WHY. A selfcheck here runs its BIN siblings out of its own directory, so judging a tool against main means
# having main's bin/ somewhere on disk. Twice that was built by hand as a directory of symlinks into a live
# checkout and a later `cp` over one of them followed the link and overwrote the real file: a subagent's shared
# scratchpad (2026-09-01) and a worker's /tmp/janbin (2026-09-11), the second costing most of an iteration to find
# and restore, with ~130 lines of edits gone from the tree in between. A rule in memory did not stop the repeat.
#
# SO THE COPY IS REGULAR FILES ONLY. A tracked symlink comes out as its target's bytes at that ref (bin/cc-mail is
# one), and a copy with a symlink left in it is refused rather than handed back. Nothing written into the copy can
# reach a checkout — that is the whole promise, and the selfcheck below proves it by overwriting every file in a
# copy and reading the source tree back byte for byte, with a hand-made symlink farm beside it as the control that
# the same cp does clobber.
#
# NEVER BUILD ONE BY HAND. `ln -s` into a checkout is not a faster version of this; it is the bug.
#
# DIR must not exist (this makes it) and must not be inside a git checkout — a scratch bin/ inside the tree you are
# protecting is the same accident one step removed. The source is only read: no ref is fetched (fetch it yourself,
# from a worktree of your own), nothing outside DIR is written.
set -uo pipefail
SELF=$(readlink -f "$0")
USAGE="usage: cc-bin-at [-C <bindir>] <ref>|worktree [DIR]   |   cc-bin-at selfcheck"
die(){ echo "cc-bin-at: $*" >&2; exit 2; }
# Every git call, with the environment a hook leaves behind taken off it: GIT_DIR set by a caller would point this
# at that repository instead of the one the path names, and the in_checkout probe below would then call every
# directory on the box part of a checkout and refuse to write anywhere.
g(){ env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE git "$@"; }
in_checkout(){   # $1 a path that need not exist yet → 0 and the work tree's root when it is inside one
  local d=$1 top
  while [ ! -e "$d" ] && [ "$d" != / ] && [ -n "$d" ]; do d=$(dirname "$d"); done
  top=$(g -C "$d" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -n "$top" ] || return 1; echo "$top"; }

materialise(){   # $1 the bin dir, $2 <ref>|worktree, $3 DIR or "" → makes it, prints its path
  local src=$1 ref=$2 dest=$3 root rel depth top dangling link p target resolved mode obj
  bad(){ rm -rf "${dest:?}"; die "$@"; }   # a half-made copy is never handed back, and never left behind either
  [ -d "$src" ] || die "no bin directory at $src"
  src=$(readlink -f "$src")
  if [ -n "$dest" ]; then
    [ -e "$dest" ] && die "$dest already exists — cc-bin-at makes the directory, so nothing of yours is written into"
    dest=$(readlink -m "$dest")
  else
    dest=$(mktemp -d "${TMPDIR:-/tmp}/cc-bin-at.XXXXXX") || die "could not make a scratch directory"
  fi
  top=$(in_checkout "$dest") && bad "$dest is inside the checkout $top — a scratch bin/ goes outside every checkout, or a cp into it lands in the tree you were protecting"
  case "$dest/" in "$src"/*) bad "$dest is inside the bin/ it would be copied from";; esac
  mkdir -p "$dest" || die "could not make $dest"
  if [ "$ref" = worktree ]; then
    # Named first and refused whole: `cp -L` over a dangling link dies halfway and leaves a partial copy that
    # looks finished.
    dangling=$(find "$src" -type l ! -exec test -e {} \; -print)
    [ -z "$dangling" ] || bad "$src holds a symlink pointing at nothing, so no copy of it can be complete:$(printf ' %s' $dangling)"
    cp -R -L --preserve=mode,timestamps -- "$src/." "$dest/" || bad "could not copy $src"
  else
    root=$(g -C "$src" rev-parse --show-toplevel 2>/dev/null) || bad "$src is not inside a git checkout, so it has no <ref> to read — 'worktree' copies it as it is on disk"
    rel=${src#"$root/"}
    [ "$rel" != "$src" ] || bad "$src is the root of the checkout, not a bin/ inside one"
    g -C "$root" rev-parse --verify --quiet "$ref^{tree}" >/dev/null || bad "$root has no ref called '$ref' — it is never fetched here, so fetch it first from a worktree of your own"
    depth=$(awk -F/ '{print NF}' <<<"$rel")
    g -C "$root" archive --format=tar "$ref" -- "$rel" | tar -x -C "$dest" --strip-components="$depth" -f - \
      || bad "nothing under $rel at $ref, or it would not extract"
    # THE ENTRY EVERY HAND-MADE COPY GETS WRONG: a symlink tracked in the tree (bin/cc-mail -> ../mail/receiver.py)
    # comes out of `git archive` as a symlink again, now pointing at a path that is not in the copy — and a write
    # through it lands wherever it happens to resolve. Each one is replaced by its target's bytes at that same ref.
    while IFS= read -r -d '' link; do
      p=${link#"$dest/"}; target=$(readlink "$link"); rm -f "$link"
      case $target in /*) echo "cc-bin-at: dropped $p — it points at the absolute path $target, which no copy can carry" >&2; continue;; esac
      resolved=$(realpath -ms --relative-to="$root" "$root/$rel/$(dirname "$p")/$target")
      # awk, not `read mode type obj`: ls-tree separates the path from the object with a TAB, so a plain read
      # takes the path into the object id and every lookup below fails on a name that looks almost right.
      read -r mode obj <<<"$(g -C "$root" ls-tree "$ref" -- "$resolved" | awk '{print $1, $3}')"
      case $mode in
        100644|100755) g -C "$root" cat-file blob "$obj" > "$link" || bad "could not read $resolved at $ref"
                       if [ "$mode" = 100755 ]; then chmod 755 "$link"; else chmod 644 "$link"; fi;;
        *) echo "cc-bin-at: dropped $p — its target $target is not a plain file at $ref" >&2;;
      esac
    done < <(find "$dest" -type l -print0)
  fi
  [ -n "$(ls -A "$dest")" ] || bad "$src at $ref is empty"
  # THE PROMISE, ENFORCED AND NOT ONLY TESTED. Anything still a symlink here can be written through, so the copy
  # goes rather than the caller finding out with a cp.
  [ -z "$(find "$dest" -type l -print -quit)" ] || bad "a symlink survived into the copy — refusing to hand back one that can be written through"
  echo "$dest"; }

selfcheck(){
  local n=0 f=0 rc out d w sha before named
  k(){ n=$((n+1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else echo "  FAIL $2"; f=$((f+1)); fi; }
  T=$(mktemp -d); trap 'rm -rf "$T"' EXIT   # T is not local: the EXIT trap fires outside this function
  # A CHECKOUT OF ITS OWN, under a temp dir: this box's core/bin is never read, and the only tree any case here can
  # damage is this one. Its bin/ carries a tracked symlink because the real one does, and that is the entry a copy
  # gets wrong. cc-alpha is then edited in the worktree so "at main" and "on disk" are different bytes.
  R=$T/repo; mkdir -p "$R/core/bin" "$R/core/mail"
  printf '#!/usr/bin/env bash\necho alpha-at-main\n' > "$R/core/bin/cc-alpha"; chmod 755 "$R/core/bin/cc-alpha"
  printf 'beta-at-main\n' > "$R/core/bin/cc-beta"; chmod 644 "$R/core/bin/cc-beta"
  printf 'receiver-at-main\n' > "$R/core/mail/receiver.py"
  ln -s ../mail/receiver.py "$R/core/bin/cc-post"
  g -C "$R" init -q -b main >/dev/null 2>&1
  g -C "$R" add -A >/dev/null 2>&1
  g -C "$R" -c user.email=selfcheck@invalid -c user.name=selfcheck -c commit.gpgsign=false commit -qm main >/dev/null 2>&1
  sha=$(g -C "$R" rev-parse HEAD)
  printf 'edited-in-worktree\n' >> "$R/core/bin/cc-alpha"
  B(){ TMPDIR=$T "$SELF" -C "$R/core/bin" "$@"; }
  # The fixture checkout's every regular file, by content: what a clobber through a copy would change.
  fp(){ find "$R" -path "$R/.git" -prune -o -type f -print0 | sort -z | xargs -0 md5sum 2>/dev/null | md5sum; }
  printf 'CLOBBERED\n' > "$T/clob"

  d=$(B main); rc=$?
  k "$([ $rc = 0 ] && [ -d "$d" ] && echo 0 || echo 1)" "<ref> makes the directory and prints its path"
  # …and if it printed nothing, every case below still has a path that goes nowhere to work with. An empty $d
  # would make `"$d"/*` glob the ROOT of this box, and the cp cases below would then walk it.
  [ -n "$d" ] || d=$T/no-copy-was-made
  k "$(grep -qx 'echo alpha-at-main' "$d/cc-alpha" && ! grep -q edited-in-worktree "$d/cc-alpha" && echo 0 || echo 1)" "…holding the REF's bytes, not the edited worktree's"
  k "$([ -x "$d/cc-alpha" ] && [ ! -x "$d/cc-beta" ] && echo 0 || echo 1)" "…with the exec bit each file has at that ref"
  k "$([ -z "$(find "$d" -type l -print -quit)" ] && echo 0 || echo 1)" "NO SYMLINK ANYWHERE IN THE COPY — the one thing this tool promises"
  k "$([ -f "$d/cc-post" ] && [ "$(cat "$d/cc-post")" = receiver-at-main ] && echo 0 || echo 1)" "…and the tracked symlink is a real file holding its target's bytes at that ref"
  k "$([ "$(cd "$T" && "$d/cc-alpha")" = alpha-at-main ] && echo 0 || echo 1)" "the copy is a usable BIN dir: a sibling runs out of it, which is what a baseline selfcheck needs"
  k "$([ "$(B "$sha" | wc -l)" = 1 ] && echo 0 || echo 1)" "any ref, a bare sha included, and the path is the only thing printed"

  # THE INCIDENT, both halves. Every file in the copy overwritten with `cp`, the verb both incidents used, and the
  # source checkout must come back byte for byte — its bin/ and the mail/ file the tracked symlink pointed at.
  before=$(fp)
  for p in "$d"/*; do cp "$T/clob" "$p"; done
  k "$([ "$before" = "$(fp)" ] && echo 0 || echo 1)" "cp over every file in the copy and the source checkout is byte-identical — the incident cannot happen through this copy"
  # CONTROL — THE OLD WAY, so the case above is known to be able to fail. A symlink into the fixture checkout (never
  # a real one: this whole tree is under the temp dir), the same cp, and the checkout MUST change. Without it, an
  # fp() that had stopped seeing anything would pass the case above in silence.
  mkdir "$T/farm"; ln -s "$R/core/bin/cc-alpha" "$T/farm/cc-alpha"; cp "$T/clob" "$T/farm/cc-alpha"
  k "$([ "$before" != "$(fp)" ] && grep -q CLOBBERED "$R/core/bin/cc-alpha" && echo 0 || echo 1)" "control: the same cp through a hand-made symlink farm DOES overwrite the checkout, so the case above can fail"
  g -C "$R" checkout -q -- core/bin/cc-alpha; printf 'edited-in-worktree\n' >> "$R/core/bin/cc-alpha"

  w=$(B worktree); [ -n "$w" ] || w=$T/no-copy-was-made
  k "$(grep -q edited-in-worktree "$w/cc-alpha" && echo 0 || echo 1)" "'worktree' copies what is on disk right now, uncommitted edits and all"
  k "$([ -z "$(find "$w" -type l -print -quit)" ] && [ "$(cat "$w/cc-post")" = receiver-at-main ] && echo 0 || echo 1)" "…with no symlink in it either, the tracked one resolved to its bytes"
  before=$(fp); for p in "$w"/*; do cp "$T/clob" "$p"; done
  k "$([ "$before" = "$(fp)" ] && echo 0 || echo 1)" "…and a cp over every file in THAT copy leaves the checkout byte-identical too"

  named=$T/named; out=$(B main "$named"); rc=$?
  k "$([ $rc = 0 ] && [ "$out" = "$named" ] && [ -f "$named/cc-alpha" ] && echo 0 || echo 1)" "a named DIR is made and used"
  out=$(B main "$named" 2>&1); rc=$?
  k "$([ $rc != 0 ] && grep -q 'already exists' <<<"$out" && [ -f "$named/cc-alpha" ] && echo 0 || echo 1)" "…and a DIR that already exists is refused, never written into"
  out=$(B main "$R/scratchbin" 2>&1); rc=$?
  k "$([ $rc != 0 ] && [ ! -e "$R/scratchbin" ] && grep -q 'inside the checkout' <<<"$out" && echo 0 || echo 1)" "a DIR inside a checkout is refused — the same accident one step removed"
  before=$(ls -d "$T"/cc-bin-at.* 2>/dev/null | wc -l)
  out=$(B no-such-ref 2>&1); rc=$?
  k "$([ $rc != 0 ] && grep -q 'no ref called' <<<"$out" && [ "$before" = "$(ls -d "$T"/cc-bin-at.* 2>/dev/null | wc -l)" ] && echo 0 || echo 1)" "an unknown ref fails, says so, and leaves no half-made directory behind"
  out=$("$SELF" -C "$T/farm" main 2>&1); rc=$?
  k "$([ $rc != 0 ] && grep -q 'not inside a git checkout' <<<"$out" && echo 0 || echo 1)" "a bin/ outside any checkout has no ref to read, and is told so rather than half-copied"

  k "$([ "$(g -C "$R" status --porcelain)" = " M core/bin/cc-alpha" ] && echo 0 || echo 1)" "after every case above, the source checkout holds only the edit this selfcheck made: the tool reads it and writes nothing"
  echo "cc-bin-at selfcheck: $((n - f)) passed, $f failed"
  [ "$f" -eq 0 ]; }

SRC=$(dirname "$SELF")
if [ "${1:-}" = -C ]; then [ $# -ge 3 ] || die "$USAGE"; SRC=$2; shift 2; fi
case "${1:-}" in
  selfcheck) selfcheck; exit $?;;
  ""|-h|--help|help) die "$USAGE";;
esac
[ $# -le 2 ] || die "$USAGE"
materialise "$SRC" "$1" "${2:-}"
