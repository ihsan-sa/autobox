#!/usr/bin/env python3
"""cc-native — opt-in native runtime hook; no service, queue or delivery authority.
  cc-native < payload.json    PreToolUse: Agent|Task dispatch, Bash bootstrap; SubagentStop: checkpoint/end
  cc-native selfcheck         payload fixtures in their own HOME, state, board and Git remotes
  cc-config get CC_NATIVE_ADAPTER 0   only 1 enables the hook and cc-task begin

Verified against Claude Code 2.1.263: Agent (formerly Task), base session_id/transcript_path/cwd and
subagent-only agent_id; PreToolUse consumes updatedInput alongside allow. SubagentStart has no prompt.
The dispatch's tool_use_id identifies a replay; the bootstrap's own agent_id identifies the child.
SubagentStop carries agent_id and agent_transcript_path. There is no CLAUDE_CODE_AGENT_ID environment key.
Dispatch has a 15 s runtime budget: lock waiting and Git preparation share an 11 s deadline.
CC_NATIVE_DEADLINE (finite seconds, > 0) replaces that 11 s; unset, the hook keeps 11 s. The selfcheck widens it:
a claim is about a dozen serial cc-board, cc-task and git processes, CPU-bound, so on a saturated box (load 15-130
on 6 cores) one takes 3-10 s, and N2 serialises two of them under one deadline. That red is load, not the change.
JSON decisions use exit 0, including deny: exit 2 would make the runtime use stderr instead of the JSON.
An unrelated or unreadable input decides nothing. No header leaves the legacy Agent input byte-identical.
"""
import json, os, re, runpy, shlex, shutil, signal, subprocess, sys, tempfile, time
from pathlib import Path
from types import SimpleNamespace

BIN = Path(__file__).resolve().parent
sys.dont_write_bytecode = True
task = None
ROW = re.compile(r"CC-Row: ([A-Za-z0-9_][A-Za-z0-9._-]{0,63})/([A-Za-z0-9_][A-Za-z0-9._-]{0,63})")

def enabled():
    """The flag, and it is read before cc-task is loaded. Registered, this hook runs on every Bash and Agent
    call of every session on the box, and with the adapter off that config read is the whole of the work it
    should do — loading cc-task first cost more than the answer. cc-task holds the same rule for `begin`."""
    return shutil.which("jq") is not None and subprocess.run(
        [str(BIN / "cc-config"), "get", "CC_NATIVE_ADAPTER", "0"], capture_output=True,
        text=True, timeout=1).stdout.strip() == "1"

def load():
    global task
    if task is None: task = SimpleNamespace(**runpy.run_path(str(BIN / "cc-task")))

def call(argv, cwd=None, timeout=10):
    # A timeout kills the claim's whole process group, including a stalled fetch. No child may later claim
    # after its hook has returned a refusal. All output stays private until the hook chooses its JSON.
    p = subprocess.Popen([str(a) for a in argv], cwd=cwd, stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try: out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL); p.communicate()
        raise ValueError("cc-native: claim/checkpoint deadline expired")
    if p.returncode: raise ValueError((out + err).strip() or "cc-native: command failed")
    return out

def decision(kind, reason=None, updated=None):
    answer = {"hookEventName": "PreToolUse", "permissionDecision": kind}
    if reason: answer["permissionDecisionReason"] = reason
    if updated is not None: answer["updatedInput"] = updated
    print(json.dumps({"hookSpecificOutput": answer}))

def handoff(d, tool_input, state):
    _, wt = task.paths(state.parent.name, state.name)
    updated = dict(tool_input); updated.pop("isolation", None)
    updated["prompt"] += (f"\n\nManaged track: {wt}\nTask id: {d['task_id']}\n"
                          f"First tool action: cc-task begin {task.native_token(state, d['claim'])}\n"
                          "Use the returned task.md and progress.md. Work only in that canonical worktree; "
                          "use absolute paths or cd there for shell commands. The worktree is already prepared. "
                          "The end hook commits. Do not commit, push, open a PR or queue delivery.\n")
    return updated

def budget():
    try: seconds = float(os.environ.get("CC_NATIVE_DEADLINE", ""))
    except ValueError: return 11.0
    return seconds if 0 < seconds < float("inf") else 11.0

def dispatch(payload, tool_input, match):
    repo, row = match.groups(); state, _ = task.paths(repo, row)
    seconds = budget(); deadline = time.monotonic() + seconds
    # An unreadable record is outside this hook's remit, including before taking the native lock.
    task.read(state)
    with task.Lock(Path.home() / ".cc/native", timeout=max(.01, seconds - 1)):
        for other, d in task.native_records():
            c = d["claim"]; native = c.get("native", {})
            if native.get("session_id") == payload["session_id"] and native.get("dispatch_event") == payload["tool_use_id"]:
                if other != state: raise ValueError("cc-native: dispatch event already names another row")
                task.native_live(d); task.native_parent(c, payload)
                return handoff(d, tool_input, state)
        d = task.read(state); c = (d or {}).get("claim") or {}
        if c.get("native") and not c.get("ended_at") and task.alive(c.get("owner")):
            raise ValueError("cc-native: row is already reserved by another dispatch")
        d = json.loads(call([BIN / "cc", "claim", repo, row, "--executor", "subagent"],
                            timeout=max(.01, min(seconds - 1, deadline - time.monotonic()))))
        with task.Lock(state, timeout=1):
            current = task.read(state); c = current["claim"]
            if c["claim_id"] != d["claim"]["claim_id"] or c.get("ended_at"):
                raise ValueError("cc-native: claim changed during dispatch")
            c["native"] = {"session_id": payload["session_id"], "dispatch_event": payload["tool_use_id"]}
            c["owner"].update(session=payload["session_id"], transcript=payload["transcript_path"])
            task.save(state, current)
        return handoff(current, tool_input, state)

def checkpoint(wt):
    call([BIN / "cc-checkpoint", "--commit"], cwd=wt, timeout=40)
    return call(["git", "-C", wt, "rev-parse", "HEAD"]).strip()

def hook(payload):
    if not isinstance(payload, dict): return
    if not all(isinstance(payload.get(k), str) and payload[k] for k in ("session_id", "transcript_path", "cwd")): return
    event = payload.get("hook_event_name"); tool_input = payload.get("tool_input") or {}
    if event == "SubagentStop":
        if not payload.get("agent_id"): return
        state, d = task.native_find(payload=payload)
        if d["claim"].get("ended_at"): return
        task.native_end(state, payload, checkpoint); return
    if event != "PreToolUse" or not isinstance(tool_input, dict) or not payload.get("tool_use_id"): return
    tool = payload.get("tool_name")
    if tool in ("Agent", "Task"):
        prompt = tool_input.get("prompt")
        if not isinstance(prompt, str): return
        match = ROW.fullmatch(prompt.split("\n", 1)[0])
        if not match: return
        # cc's refusal is passed through verbatim. An unreadable record yields no decision.
        state, _ = task.paths(*match.groups())
        try: task.read(state)
        except (OSError, ValueError, TypeError): return
        try: updated = dispatch(payload, tool_input, match)
        except json.JSONDecodeError: return
        except ValueError as e: decision("deny", str(e)); return
        decision("allow", updated=updated)
    elif tool == "Bash":
        # Exactly the bootstrap command. Shell wrappers, substitutions and compound commands are not parsed
        # into a new authority; the injected first action needs none of them. All other Bash stays untouched.
        words = shlex.split(tool_input.get("command", ""))
        if len(words) != 3 or words[:2] != ["cc-task", "begin"]: return
        try:
            state, _ = task.native_find(token=words[2])
            with task.Lock(Path.home() / ".cc/native", timeout=1): task.native_bind(state, words[2], payload)
        except ValueError as e: decision("deny", str(e)); return
        # Leave permission to cc-guard and the runtime. Binding alone does not allow a Bash command.

def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-native.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-native.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)

def main():
    if sys.argv[1:] == ["selfcheck"]: load(); return selfcheck()
    try:
        if not enabled(): return 0
        load(); hook(json.load(sys.stdin))
    except (OSError, ValueError, KeyError, TypeError, AttributeError, subprocess.SubprocessError): pass
    return 0

if __name__ == "__main__": sys.exit(main())
