  rm -f "$OV" "$UNAV" "$MOVED" "$RETURNED" "$d/model-skipped" "$d/keys"; : > "$d/typed"; : > "$LOG"; : > "$d/calls"; : > "$d/handoffs"; : > "$d/cards"
  tmux(){ case "${1:-}" in display-message) echo 1;; capture-pane) cat "$d/screen.${*: -1}" 2>/dev/null;;
            send-keys) printf '%s\n' "${*:3}" >> "$d/keys";; esac; return 0; }
  keys(){ awk -v p="$1" '$1==p{sub(/^[^ ]+ /, ""); print}' "$d/keys" 2>/dev/null | paste -sd'|' -; }   # what was pressed into a pane, in order
  cards(){ sed -n 's/^[^\t]*\t\[return\] \([^:]*\):.*/\1/p' "$d/cards" 2>/dev/null | paste -sd'|' -; }
  typed(){ awk -F'\t' -v w="$1" '$1==w{print $2}' "$d/typed" | paste -sd'|' -; }
  CC_MODEL_ANSWER_WAIT=0; CC_MODEL_MAJOR=none; CC_CLAUDE_SETTINGS="$d/settings.json"; printf '{"theme":"dark"}\n' > "$d/settings.json"
