  t '(e) …no override, nothing recorded unavailable: the primary is not out' "$([ -e "$OV" ] && echo ov)$([ -e "$UNAV" ] && echo unav)" ""
  printf '%s\n' "$fline2" "  ⎿  Set model to Opus 5 and saved as your default for new sessions" '' '❯ ' > "$d/screen.%7"; : > "$d/typed"; : > "$LOG"; tick
  t '(e) …the line above a later "Set model to" is history: not retuned again' "$(typed w/after-sonnet)" ""
  # ── (f) THE AUTO-MODE CONFIRM DIALOG NEVER PARKS A SEAT (owner, 2026-09-21) ─────────────────────────────────────
  # One fixture pane per branch, the call behind each in its own fixture transcript: a read-only sed is answered Yes by
  # the box; a push is never pressed but carded to the owner, once; his yes presses Yes; his no presses No and the seat
  # is told not to try another route. cc-slack is a stub that records the card it was asked for.
  local obin="$BIN"; mkdir -p "$d/binf" "$d/tr"; cp -p "$BIN"/* "$d/binf/" 2>/dev/null; BIN="$d/binf"; : > "$d/slack"; : > "$d/keys"; : > "$d/typed"; : > "$LOG"
  printf '#!/usr/bin/env bash\nprintf "%%s\\n" "$*" >> "%s/slack"; printf "card %%s is in #lane-threads\\n" "$(sed -n "$(wc -l < "%s/slack")p" <<<"bcdef\ncdefg\ndefgh")"\n' "$d" "$d" > "$BIN/cc-slack"; chmod +x "$BIN/cc-slack"
  cdlg(){ printf '%s\n' '╭──────────────────────────────╮' '│ Bash command                 │' '│                              │' "│   $1" '│   Read part of a file        │' '│                              │' \
    '│ Auto mode classifier requires confirmation for this command.' '│ 3 consecutive actions were blocked. Please review the transcript before continuing.' '│' \
    '│ Do you want to proceed?      │' '│ ❯ 1. Yes                     │' '│   2. No                      │' '╰──────────────────────────────╯' '  Esc to cancel'; }
  tcall(){ { printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t0","name":"Bash","input":{"command":"rm -rf /tmp/x"}}]}}\n'
             printf '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t0","content":"blocked"}]}}\n'
             jq -cn --arg c "$2" '{type:"assistant",message:{content:[{type:"tool_use",id:"t1",name:"Bash",input:{command:$c}}]}}'; } > "$d/tr/$1.jsonl"; }
  CC_MODEL_TRANSCRIPTS="$d/tr"
  printf '%s\n' '%21 seat-read' '%22 seat-write' '%23 seat-no' > "$d/sess"
  tcall %21 "sed -n '1,80p' ~/bin/cc-model"; cdlg "sed -n '1,80p' ~/bin/cc-model" > "$d/screen.%21"
  tcall %22 'git push origin HEAD';           cdlg 'git push origin HEAD' > "$d/screen.%22"
  tcall %23 'rm -r build';                    cdlg 'rm -r build' > "$d/screen.%23"
  t '(f) fixture: the dialog is read, its Yes is 1 and its No is 2; a resolved earlier call is not the pending one' \
    "$(confirm_opt "$(cat "$d/screen.%21")" Yes):$(confirm_opt "$(cat "$d/screen.%21")" No):$(pending_call %22)" "1:2:Bash"$'\t'"git push origin HEAD"
  t '(f) …the wording quoted in prose, with no numbered choices under it, is not the dialog' \
    "$(confirm_opt "$(printf '%s\n' 'the owner saw: Auto mode classifier requires confirmation for this command.' 'Do you want to proceed? it asked' '❯ ')" Yes)" ""
  t '(f) …and a "Yes, and don'"'"'t ask again" line is never the Yes the box presses' \
    "$(confirm_opt "$(sed 's/1\. Yes  /1. Yes, and don'"'"'t ask again for sed/' "$d/screen.%21")" Yes)" ""
  local ro=""
  for c in "sed -n '1,80p' f" 'grep -n x f | head -5' 'git log --oneline -3' 'cat a 2>/dev/null' 'git grep --or -e a -e b x' 'find . -name "*.py"' "grep -n 'a;b|c' f" 'ls 2>&1' 'cat f >/dev/null'; do confirm_readonly Bash "$c" && ro="${ro}r" || ro="${ro}w"; done
  for c in "sed -i 's/a/b/' f" 'cat a > b' 'find . -delete' 'git branch -D x' 'ls; rm x' 'echo $(rm x)' 'grep x f | tee y' 'uniq a b' 'sort -o f f' 'python3 -c 1' "sed -n '1,5p' f -i" "sed -n '1p' f --in-place" "sed -n '1p' -e '1w /tmp/x' f" "sed -n '1p' f '-i'" 'git grep -Orm x' 'git grep --open-files-in-pager=rm x' 'git grep --open=rm x' 'sort --out=f f' 'sort --compress-program=sh f' "printf -v x '%s(touch p)' '\$'; cat \${x@P}" 'echo $HOME' 'printf -v x abc' \
          "find . '-delete'" "sort '-o' f f" "git log '--output=/tmp/x'" "git grep '-Orm' x" "rg '--pre=sh' x" 'find . -dele"t"e' 'rg --hostname-bin=sh x' 'find . -dele{t}e' 'find . -delet[e]' 'find . *delete' 'X=1 find . -delete' 'env find . -delete' 'xargs -a f rm' 'cat a <> b' 'cat f >/dev/null/../x' \
          "sed -n '1p;wc' f" "sed -n '1p;which' f" "sed -n '1w /tmp/x' f" "cat 'a" 'ls & rm x' '(cat f)' "grep ';' f" \
          $'find . "a\'" {-delete,-name} "\'b"' $'git log "a\'" {--output=/tmp/x,-1} "\'b"' $'sort "a\'" * "\'b"' \
          'cat a >&1.txt' 'echo x >&2024-report.csv' 'echo x >&2x' 'echo x &> f' 'cat f >>/tmp/x' 'cat f <<<x' 'uniq a 1 >/dev/null'; do confirm_readonly Bash "$c" && ro="${ro}r" || ro="${ro}w"; done
  confirm_readonly Edit 'f' && ro="${ro}r" || ro="${ro}w"; confirm_readonly Read 'f' && ro="${ro}r" || ro="${ro}w"
  # the second row is the class the fourth review of #586 found: shell text the checks read as one thing and the shell
  # runs as another — a quoted option, one glued out of quotes, a brace or a glob, a prefix or a wrapper in front.
  # The last row is the fifth review's: the SEGMENT SPLIT itself cut inside quotes, so `sed -n '1p;wc' f` read as
  # `sed -n '1p` plus `wc' f` while sed ran `w c` and wrote ./c. The words come off a quote-aware tokeniser now, so
  # a quoted `;` stays inside its word (`grep -n 'a;b|c' f` reads) and a sed script has to match `N[,M]p` in full.
  # The three at the end are the sixth review's: the metacharacter check STRIPPED the quotes, all '…' with one sed and
  # all "…" with another, so a ' in one double-quoted word paired with a ' in a later one and everything between them
  # went — `find . "a'" {-delete,-name} "'b"` left `find . ""`, no brace was seen, and the shell ran the -delete.
  # The seven at the end are the seventh review's: the REDIRECTIONS were stripped by a regex before anything was read,
  # and `s#[0-9]?>&[0-9]##g` left `cat a >&1.txt` as the text `cat a .txt` — a read, while bash writes both streams to
  # ./1.txt. They are parsed with the words now, and only a bare fd duplication and a write to /dev/null read.
  t '(f) read-only: sed -n, a grep pipe, git log, a 2>/dev/null read, git grep --or, a QUOTED glob in find -name and a QUOTED ;| inside a grep pattern, an ls 2>&1 and a >/dev/null; sed -i, a redirection, find -delete, git branch -D, a ; rm, a $(…), tee, uniq IN OUT, sort -o, python, sed with an option after its script, git grep -O, an ABBREVIATED --open/--out, sort --compress-program, a printf -v built ${x@P} substitution, a bare $HOME, printf -v on its own are not — and neither are the QUOTED find/sort/git/rg options, an option glued out of quotes, rg --hostname-bin, a brace-built or globbed option, an X=1 prefix, an env or xargs wrapper, a <> open, a >/dev/null/../x redirection, a sed script hiding a w behind a quoted ; (1p;wc, 1p;which), a bare 1w script, an unbalanced quote, a & job, a subshell, a quoted-punctuation word, a brace or glob hidden between two double-quoted words that each hold a lone quote, a >&word that is a FILE (>&1.txt, >&2024-report.csv, >&2x), an &> f, a >>/tmp/x, a here-string, an fd digit the shell hands the command as an argument (uniq a 1 >/dev/null), and Edit; Read is' "$ro" "rrrrrrrrrwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwwr"
  confirm_panes
  t '(f) READ-ONLY: the box answers Yes itself (1, then Enter while the same call is still asked), logged, and no card' \
