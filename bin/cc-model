#!/usr/bin/env bash
# cc-model — automatic model fallback. When the box's primary model hits its usage limit every live session
# moves to the fallback model, and back when the limit lifts. LLM-free except one tiny probe.
#   cc-model status                   "fable" (normal) | "opus until 11:40Z" | "opus until probe". An until that
#                                     is not today is dated ("opus until 2026-09-03T12:51Z"): the clock alone made
#                                     a 24-hour override read as one that lapsed hours ago.
#   cc-model current                  the override model, or nothing — cc / cc-loop / cc-rc pass it as --model
#   cc-model switch <model> [reason]  write (or, for the primary model, clear) the override + retune live sessions
#   cc-model limited <model> [reason] cc-limit calls this after a limited run: switch only if that WAS the primary
#   cc-model classify <json> [<err>] [<asked>]  what stopped a headless run, as "<class>\t<why>": ok | limit |
#                                     refusal | error — the caller's reason to WAIT, to MOVE, or to retry
#   cc-model chain                    the worker fallback chain, one model per line
#   cc-model next [<model>]           the model after <model> on that chain (nothing, exit 1, at its end)
#   cc-model tick                     what cc-model.timer runs every 60 s (see below)
#   cc-model selfcheck                the classifier and the chain, on fixtures
# tick: (1) normal — switch when cc-limit's stamp says the primary model is limited, or when a live session's pane
#   shows a fresh "usage limit" line (each matched line fires once, and a probe has to agree — docs and questions
#   mention limits too); (1b) THE CLI'S OWN LIMIT PROMPT NEEDS NO PROBE: "You've reached your Fable 5 limit … ❯ Switch
#   to Opus 5 (1M context) and continue" (a dialog) or "● Fable 5 limit reached · continuing on Fable 5 uses usage
#   credits …" (its notice) IS a limit of the model it names — the dialog is answered (Enter when the highlighted line
#   is "Switch to <another model> … and continue", Esc on anything else), the box moves to the fallback until the reset
#   the text names, else 24 h, and NOTHING PROBES while that wording is on any session pane: a probe that answers there
#   is paying with usage credits, not proof the limit lifted (2026-09-01: one such "lifted" retuned 12 panes straight
#   back into the prompt, and a pulse tick and two secretary findings were dropped on it); (2) overridden — once `until`
#   has passed, probe the primary model at most every 15 min and restore on the first answer — unless a pane still
#   shows the prompt or cc-limit's stamp still names the primary: then it cannot tell, and does not restore;
#   (2b) NO OVERRIDE, SO THE BOX WANTS ITS PRIMARY: a session the CLI last put on ANOTHER ID OF THAT SAME FAMILY —
#   `claude-fable-5` while the box is on `claude-fable-5-1`, whose cache reads bill at 4x — is retuned to the primary.
#   Same family only (another family is the chain's, an override's or the owner's), read from the CLI's own "Set model
#   to …" line and never from the pane at large, and at most once per pane per CC_MODEL_RETUNE_GAP;
#   (3) never two switches within 10 min — and the override's `since` counts as a switch, not only the log line: that
#   line is written after the retune, and on 2026-09-01 a restore slipped into the gap and undid the switch mid-typing.
# Retuning a session = typing "/model <model>" into its pane THROUGH cc-msg (the one pane deliverer, with the dialog
#   guard); the answers to the CLI's own prompts (Enter/Esc, "1" to "Switch model?") are single keys. Effort is not touched.
# THE WORKER FALLBACK CHAIN LIVES HERE AND NOWHERE ELSE: fable -> opus -> sonnet. cc-loop asks `cc-model next`
# instead of carrying a second copy of the order, so one edit here moves every caller (CC_MODEL_CHAIN overrides).
# A REFUSAL OR A REROUTE IS NOT AN ERROR AND NOT A LIMIT. The classifier can stop a turn outright, and a model that
# is withdrawn, suspended or not ours to call answers as a different one (the Fable suspension ran 19 days). Both
# read as "the run failed" today, so the caller retries the same model and spends for a result that cannot change.
# `classify` names both `refusal`, and the caller MOVES ALONG THE CHAIN. A limit still wins over everything — it is
# a wait, not a move. IT ALL COMES FROM JSON FIELDS: see the doctrine above classify_run. Wording is read only from
# `.result`, and only on a run the API itself ended, because a worker writing "I can't help with that" — or
# "refused", or "usage limit" — in its own result is talking about its task, not about being refused.
# Override: ~/.cc/state/model-override = "<model>\t<since>\t<until-epoch|0>\t<reason>\t<last-probe-epoch>"
# Log: ~/.cc/state/model.log = "<iso>\t<epoch>\t<event>\t<model>\t<detail>". No secrets in either.
# Env: CC_MODEL_PRIMARY · CC_MODEL_FALLBACK · CC_MODEL_PROBE (the id the probe asks for) · CC_CLAUDE
#   · CC_MODEL_PROBE_EVERY (900) · CC_MODEL_MIN_GAP (600) · CC_MODEL_RETUNE_GAP (600) · CC_MODEL_CHAIN · test hooks: CC_TMUX_SESSION, CC_MODEL_PROC.
set -uo pipefail
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
ST="$HOME/.cc/state"; OV="$ST/model-override"; LOG="$ST/model.log"; SEEN="$ST/model-seen"
PRIMARY="${CC_MODEL_PRIMARY:-claude-fable-5-1[1m]}"; FALLBACK="${CC_MODEL_FALLBACK:-claude-opus-5[1m]}"   # Fable 5.1 (owner, 2026-09-01)
PROBEM="${CC_MODEL_PROBE:-claude-fable-5-1}"; CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"
SESSION="${CC_TMUX_SESSION:-main}"; PROC="${CC_MODEL_PROC:-claude}"
now=$(date -u +%s); mkdir -p "$ST"
fam(){ local f; f=$(grep -oiE 'fable|opus|sonnet|haiku' <<<"${1:-}" | head -1 | tr 'A-Z' 'a-z'); echo "${f:-${1:-}}"; }
idname(){   # a model id → the name the CLI prints for it: claude-fable-5-1 → "Fable 5.1", claude-opus-5 → "Opus 5".
            # fam() answers a DIFFERENT question — which rung of the chain a model is — and `claude-fable-5` and
            # `claude-fable-5-1` are one rung, one family, and two very different bills: cc-spend prices the old id's
            # cache reads at 4x, and the box spent about $140 on it on 2026-09-02 because a session parked there
            # looked, to every family test in this file, exactly like a session on the primary. The [1m] suffix is a
            # context knob, not a model, and the CLI spells it out as "(1M context)" anyway.
  local f v; f=$(fam "${1:-}"); v=$(sed -e 's/\[.*$//' -e "s/^claude-$f-*//" <<<"${1:-}" | tr '-' '.')
  { [ -n "$f" ] && [ -n "$v" ] && [ "$v" != "${1:-}" ]; } || return 1
  printf '%s %s\n' "$(tr 'a-z' 'A-Z' <<<"${f:0:1}")${f:1}" "$v"; }
pane_model(){   # $1 = a pane's live screen → the model the CLI ITSELF last said that session is on, or nothing. Off a
                # live pane on this box (2026-09-02):  ❯ /model claude-fable-5[1m]
                #                                        ⎿  Set model to Fable 5 and saved as your default for new sessions
                # THE CLI'S OWN ANSWER, never the pane at large: a session with this file open in a pager, or a doc
                # that names an id, has that id on its screen and is not running it — the trap the classifier below
                # was rebuilt around (#155). A session whose answer line has scrolled off says nothing, and nothing
                # is typed into it: a miss is cheap here, a stray /model into somebody's session is not.
  grep -oE 'Set model to [A-Za-z]+ [0-9][0-9.]*' <<<"${1:-}" | tail -1 | sed 's/^Set model to //'; }
retune_to(){    # $1 = a pane's live screen → the model to type into it, or nothing (exit 1) when it is where the box
                # wants it. SAME FAMILY only: another family is the chain's business — an override, a limit, or the
                # owner's own choice — and this pass must not undo one.
  local said want; said=$(pane_model "${1:-}"); [ -n "$said" ] || return 1
  want=$(idname "$PRIMARY") || return 1
  [ "$said" = "$want" ] && return 1
  [ "$(fam "$said")" = "$(fam "$PRIMARY")" ] || return 1
  printf '%s\n' "$PRIMARY"; }
retuned_recently(){   # $1 = pane id → 0 when this pane was retuned inside the last CC_MODEL_RETUNE_GAP (600 s). A pane
                      # takes a moment to apply /model, and a pass that retyped on every tick would be typing into
                      # somebody's session every minute.
  local id="${1:-}" t
  t=$(awk -F'\t' -v i="($id)" '$3=="retune" && index($5, i){t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)
  [ "$((now - t))" -lt "${CC_MODEL_RETUNE_GAP:-600}" ]; }
untilw(){   # $1 = an epoch → the way a person reads it. HH:MMZ alone lies the moment the until is not today: a 24-hour
            # override read at 16:04Z as "until 12:51Z" looks like it lapsed three hours ago, and a handoff journal
            # recorded exactly that (2026-09-02). Past today, the date comes with it.
  local t="${1:-0}"
  [ "$(date -u -d "@$t" +%F)" = "$(date -u -d "@$now" +%F)" ] && { date -u -d "@$t" +%H:%MZ; return 0; }
  date -u -d "@$t" +%FT%H:%MZ; }
label(){ case "$(fam "${1:-}")" in fable) echo "Fable 5.1";; opus) echo "Opus 5";; sonnet) echo "Sonnet 5";; haiku) echo "Haiku";; *) echo "${1:-}";; esac; }
CHAIN="${CC_MODEL_CHAIN:-claude-fable-5-1 claude-opus-5 claude-sonnet-5}"   # the one copy of the order (see above)
chain(){   # the canonical chain: ONE RUNG PER FAMILY, first mention wins. A CC_MODEL_CHAIN that names a family twice
           # would otherwise walk in a circle, and a caller that reruns on each rung would never stop (F7).
  local m f; local -a ms; local -A seen=(); read -r -a ms <<<"$CHAIN"
  for m in "${ms[@]}"; do f=$(fam "$m"); [ -n "$f" ] || continue
    [ -n "${seen[$f]:-}" ] && continue; seen[$f]=1; printf '%s\n' "$m"; done; }
chain_next(){   # the model AFTER $1 on the chain, by family: "opus", "claude-opus-5" and "claude-opus-5[1m]" are one rung.
                # A trailing [suffix] rides along: falling from fable[1m] to a bare opus silently drops the 1M context
                # the caller was running with, and the rerun then fails for a reason nobody asked for (F7).
  local src="${1:-}" w sfx m hit=0
  [ -n "$(fam "$src")" ] || src="$PRIMARY"   # named nothing: start from where the box actually is
  w=$(fam "$src"); sfx=$(grep -oE '\[[^][]*\]$' <<<"$src")
  while read -r m; do
    if [ "$hit" = 1 ]; then case "$m" in *']') printf '%s\n' "$m";; *) printf '%s%s\n' "$m" "$sfx";; esac; return 0; fi
    [ "$(fam "$m")" = "$w" ] && hit=1
  done < <(chain); return 1; }   # off the end of the chain (or a model that was never on it): nothing left to fall back to
ov(){ model=""; since=0; till=0; reason=""; probed=0   # loads the override; exit 1 = none (the box is on its primary model)
  [ -f "$OV" ] && IFS=$'\t' read -r model since till reason probed < "$OV"
  [[ "${till:-}" =~ ^[0-9]+$ ]] || till=0; [[ "${probed:-}" =~ ^[0-9]+$ ]] || probed=0; [ -n "$model" ]; }
limstamp(){ lim_till=0; lim_model=""   # cc-limit's shared stamp: "<until>\t<how>\t<first-seen>\t<model>"
  [ -f "$ST/claude-limit" ] && IFS=$'\t' read -r lim_till _ _ lim_model < "$ST/claude-limit"
  [[ "${lim_till:-}" =~ ^[0-9]+$ ]] || lim_till=0; }
rate_ok(){ local l s; l=$(awk -F'\t' '$3=="switch"{t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)   # one switch per 10 min, never a flap
  # The override's own `since` counts as a switch, not only the log line: that line is written AFTER every pane has
  # been retyped, and on 2026-09-01 a restore slipped into that gap and sent 12 sessions straight back into the prompt.
  s=$(cut -f2 "$OV" 2>/dev/null); { [[ "${s:-}" =~ ^[0-9]+$ ]] && [ "$s" -gt "$l" ]; } && l="$s"
  [ $((now - l)) -ge "${CC_MODEL_MIN_GAP:-600}" ]; }
sessions(){   # "<pane-id> <window-name>" per live INTERACTIVE session: a pane whose DIRECT child is claude (pane id, so a split
              # window's non-claude active pane is never typed into)
              # (a headless --go worker runs cc-loop in its pane and its claude is a grandchild — never a session)
  local id pp name
  while read -r id pp name; do
    [ -n "${pp:-}" ] || continue
    pgrep -P "$pp" -x "$PROC" >/dev/null 2>&1 || continue
    pgrep -P "$pp" -f cc-loop >/dev/null 2>&1 && continue
    printf '%s %s\n' "$id" "$name"
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id} #{pane_pid} #{window_name}' 2>/dev/null)
}
type_into(){   # $1 pane id · $2 window name · $3 text. cc-msg IS the box's typist — it refuses a headless pane and its
               # dialog guard keeps keystrokes off an open prompt (dialog-never-drops owns that), so this does not
               # reimplement either. It types by WINDOW name, so a split window is typed at its active pane; a claude
               # pane that is NOT its window's active pane is refused here, lands in model-skipped and is retried on a
               # later tick — cc-msg would type the /model line into whatever pane IS active and run it as a command.
               # So does a line cc-msg only QUEUED: spooled is not typed, and a retune nobody typed is not done.
               # The direct tmux path below is for the test session only, where cc-msg's contract (session main, a real
               # interactive claude) cannot hold — the selfcheck and selftest run against `cat` in a scratch server.
  local id="$1" name="$2" text="$3" out
  if [ "$SESSION" = main ] && [ "$PROC" = claude ] && [ -x "$BIN/cc-msg" ]; then
    [ "$(tmux display-message -p -t "$id" '#{pane_active}' 2>/dev/null)" = 1 ] || return 1
    # QUEUED IS NOT TYPED. cc-msg answers rc 0 both when it typed the line and when it only SPOOLED it behind a
    # dialog or a busy pane — that is its contract, and cc-slack, cc-pulse and cc-handoff read it. But a /model
    # line sitting in a spool has retuned nothing: the "Switch model?" answer below would press at a dialog that
    # is not there, and the drain types the line a minute later with nobody to confirm it, leaving the session on
    # the exhausted model while the log says it switched. Queued = not done: skipped, and retried on a later tick.
    out=$("$BIN/cc-msg" "$name" "$text" 2>/dev/null) || return 1
    [ "$(printf '%s' "$out" | tr -d '\r' | tail -1)" = queued ] && return 1
  else
    tmux capture-pane -p -t "$id" 2>/dev/null | grep -q 'Enter to confirm' && return 1
    tmux send-keys -t "$id" -l -- "$text" 2>/dev/null || return 1
    sleep 0.3; tmux send-keys -t "$id" Enter 2>/dev/null
  fi
  # a /model inside a live conversation asks "Switch model? … 1. Yes" — answer it, or the session sits on that dialog and
  # stays on the model that will not answer (2026-08-28: every session did exactly that after the fallback fired)
  sleep "${CC_MODEL_DIALOG_WAIT:-1.5}"
  if tmux capture-pane -p -S -20 -t "$id" 2>/dev/null | grep -q 'Switch model?'; then
    tmux send-keys -t "$id" -l -- "1" 2>/dev/null; sleep 0.3; tmux send-keys -t "$id" Enter 2>/dev/null; fi
  return 0; }
# ── THE CLI'S OWN LIMIT PROMPT ────────────────────────────────────────────────────────────────────────────────────
# It is not a log line to be confirmed by a probe: it is the CLI saying, in the pane, that the model the session is on
# is out and offering to spend usage credits. Reading it is worth care in both directions — miss it and every session
# sits there delivering nothing (2026-09-01: a pulse tick and two secretary findings), fire on prose and the box moves
# to the fallback for a day it did not need.
# THE WORDING IS READ AS A SHAPE, NOT AS A SENTENCE (2026-09-01, the review of #155). This file's own header quotes
# every trigger phrase; so do the fixtures below, the track brief and half of docs/. A bare sentence anywhere in a pane
# would mean that a session which cats, greps or diffs any of them moves the whole box to the fallback for a day — and
# then never comes back, because the same text is what tells the probe it cannot tell. So a match needs an ANCHOR: the
# dialog's footer ON ITS OWN LINE, or the notice's ● at the START of one, with the wording inside that anchor's own few
# lines, and the anchor itself in the LIVE screen tail. Prose that quotes the prompt has the words but never the shape.
# The footer is a LINE OF ITS OWN — decoration ("·", "↵") may follow it, letters may not: that is what tells the
# dialog apart from any prose, doc bullet or diff hunk that merely quotes it.
PROMPT_FOOT='^[[:space:]]*([Ee]nter to confirm([^A-Za-z]+[Ee]sc to cancel)?|[Ee]sc to cancel)[^A-Za-z]*$'
#   "You've reached your Fable 5 limit"                            the dialog's first line
#   "Fable 5 limit reached · continuing on Fable 5 uses …"         the notice it leaves when nobody answered
#   "Continuing on Fable 5 uses usage credits — you have CA$0.00"  the line under either
# The digits-only gap before "limit reached" is what keeps every worker pane out: "Opus 5 … step limit reached" is a
# turn cap, not a limit, and it is on screen all day.
PROMPT_RE='reached your (claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* ?limit|(fable|opus|sonnet|haiku) ?[0-9.]* ?limit reached|continuing on (claude-)?(fable|opus|sonnet|haiku)[a-z0-9. ()-]{0,20}uses usage credits'
pane_text(){   # THE LIVE SCREEN of a pane — never -S scrollback. What the session is sitting on now is the prompt;
               # what has scrolled off is history, or somebody reading this file in their pane.
  tmux capture-pane -p -t "${1:-}" 2>/dev/null; }
prompt_norm(){   # a pane's text → plain ASCII lines, the CLI's two marks spelled out, the blank rest of the screen
                 # dropped — so that a LINE can be matched as a line (a box border is decoration, not content).
  sed -e 's/●/@DOT@ /g' -e 's/❯/@SEL@ /g' <<<"${1:-}" | tr -cd '\11\12\40-\176' |
    awk '{ sub(/[[:space:]]+$/, ""); l[NR]=$0; if ($0 != "") last=NR } END{ for (i = 1; i <= last; i++) print l[i] }'; }
prompt_fam(){   # $1 = a pane's live screen → the family the CLI says is out, or nothing (exit 1). THE MODEL COMES FROM
                # THE WORDING, never from the pane at large: the option line names the model being OFFERED ("Switch to
                # Opus 5 (1M context) and continue"), and taking the last model on screen read the Fable limit as Opus's.
  local t n a kind lo hi win hit
  t=$(prompt_norm "${1:-}"); n=$(grep -c '' <<<"$t")
  while IFS=: read -r a kind; do   # the lowest anchor first: the live one is the one at the bottom of the screen
    [ -n "${a:-}" ] || continue
    [ $((n - a)) -le "${CC_MODEL_PROMPT_TAIL:-12}" ] || continue   # scrolled well past: history, or someone's `cat`
    case "$kind" in
      foot) lo=$((a - 10)); hi=$a;;   # the box that footer closes: "You've reached your Fable 5 limit … Enter to confirm"
      *)    lo=$a; hi=$((a + 2));;    # the notice line and its wrap: "● Fable 5 limit reached · continuing on Fable 5 …"
    esac
    [ "$lo" -ge 1 ] || lo=1
    win=$(sed -n "${lo},${hi}p" <<<"$t" | tr -s '[:space:]' ' ')   # the dialog is drawn in a box and wraps: flatten it
    # THE BAIL IS THIS ANCHOR'S OWN WINDOW, NOT THE WHOLE SCREEN (2026-09-02, the second review of #155): another
    # dialog owns the pane only if the box THIS footer closes is that dialog. Grepping the screen threw away a real
    # limit dialog drawn under an assistant line ending "Do you want to run the tests first?" — the 2026-09-01
    # failure this exists to catch, not a false positive. The marker is option 3 of a tool dialog, which sits inside
    # the box above its footer and is the one cc-msg's guard keeps when the box outgrows the pane: it is in a
    # permission dialog's own window and in no prose that merely quotes the limit wording.
    grep -qiF 'no, and tell claude what to do differently' <<<"$win" && continue   # that box is a permission prompt
    hit=$(grep -oiE "$PROMPT_RE" <<<"$win" | head -1)
    [ -n "$hit" ] && { fam "$hit"; return 0; }
    # the dialog is open and offers to spend credits but named no model: it is about the model this box runs.
    # ("out of usage credits" is deliberately NOT here — that older wording still goes through the probe below.)
    { [ "$kind" = foot ] && grep -qi 'uses usage credits' <<<"$win"; } && { fam "$PRIMARY"; return 0; }
  done < <( { grep -nE "$PROMPT_FOOT" <<<"$t" | sed 's/:.*/:foot/'
              grep -niE '^[[:space:]]*@DOT@[[:space:]]*(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* ?limit reached' <<<"$t" | sed 's/:.*/:note/'; } | sort -t: -k1,1nr )
  return 1; }
reset_at(){   # $1 = the pane's text → the reset it names, as an epoch. Nothing (exit 1) when it names none — the weekly
              # prompt usually does not — or when it is not a plausible wait (already past, or more than 8 days out).
  local t="${1:-}" raw c e
  raw=$(grep -oiE 'resets?( on| at)?[[:space:]]+[A-Za-z0-9:.,+ -]{2,24}' <<<"$t" | head -1)
  [ -n "$raw" ] || return 1
  raw=$(sed -E 's/^[Rr][Ee][Ss][Ee][Tt][Ss]?( [Oo][Nn]| [Aa][Tt])?[[:space:]]*//; s/[[:space:],.]+$//' <<<"$raw")
  for c in "$raw" "$(cut -d' ' -f1-3 <<<"$raw")" "$(cut -d' ' -f1-2 <<<"$raw")" "$(cut -d' ' -f1 <<<"$raw")"; do
    [ -n "$c" ] || continue
    e=$(date -u -d "$c" +%s 2>/dev/null) || continue
    { [ "$e" -gt "$now" ] && [ $((e - now)) -le 691200 ]; } && { printf '%s\n' "$e"; return 0; }
  done; return 1; }
answer_key(){   # $1 = a pane's live screen → the ONE key that answers the prompt, or nothing (exit 1) when no dialog of
                # OURS is open (its notice is left behind long after). Enter ONLY when the highlighted line is the
                # switch-and-continue option: the other lines are "Manage usage credits on claude.ai" (a browser, not a
                # model) and staying on the limited model, which is the one that spends the credits. Anything else, Esc.
                # THE FOOTER AND THE OPTION LINE HAVE TO BE THE SAME DIALOG (2026-09-01, the review of #155). A tool
                # permission prompt carries the very same footer, and an Enter into one picks its highlighted "1. Yes" —
                # the unattended approval cc-msg's dialog guard exists to prevent. So a permission prompt's own words
                # end this outright, and the footer must sit within a few lines UNDER the option it belongs to: an
                # option line left in the scrollback is not made ours by a footer further down the screen.
  local t o rest opt=""
  t=$(prompt_norm "${1:-}")
  grep -qiE 'do you want to|no, and tell claude what to do differently|would you like to proceed' <<<"$t" && return 1
  while IFS=: read -r o rest; do
    [ -n "${o:-}" ] || continue
    sed -n "$((o + 1)),$((o + ${CC_MODEL_DIALOG_SPAN:-4}))p" <<<"$t" | grep -qE "$PROMPT_FOOT" || continue
    [[ "$rest" =~ ^[[:space:]]*(@SEL@|[>])[[:space:]] ]] && { printf 'Enter\n'; return 0; }
    opt=1
  done < <(grep -niE 'switch to .*continue' <<<"$t")
  [ -n "$opt" ] && { printf 'Escape\n'; return 0; }
  return 1; }
answer_prompt(){   # $1 = pane id → answer that pane's limit prompt, printing the key sent. THE ONE PLACE THIS COMMAND
                   # TOUCHES A PANE DIRECTLY: cc-msg types text and refuses a pane with a dialog open — rightly, a stray
                   # keystroke there is an unattended approval — and it has no key API. One key, and only into a pane
                   # whose own live screen is the CLI's limit prompt, in the shape answer_key insists on.
  local k
  k=$(answer_key "$(pane_text "$1")") || return 1
  tmux send-keys -t "$1" "$k" 2>/dev/null || return 1
  sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"   # let the TUI repaint before anything types into the pane again
  printf '%s\n' "$k"; }
prompt_panes(){   # every live session showing it: "<pane-id>\t<window>\t<family>\t<reset-epoch|0>"
  local id name cap f e
  while read -r id name; do [ -n "${id:-}" ] || continue
    cap=$(pane_text "$id")
    f=$(prompt_fam "$cap") || continue
    e=$(reset_at "$cap") || e=0
    printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$f" "$e"
  done < <(sessions); }
restore_blocked(){   # $1 = prompt_panes output → why a probe that answered still cannot be read as "the limit lifted",
                     # or nothing at all (exit 1) when it can. A `claude -p` turn answers just as readily on usage credits
                     # as on the plan and the result JSON does not say which paid, so the evidence has to come from
                     # elsewhere: while the prompt is on a pane, or cc-limit's stamp still has the primary model limited,
                     # this cannot tell — and a restore it cannot tell is the 12-pane retune of 2026-09-01.
  local pp="${1:-}" p w
  p=$(fam "$PRIMARY"); w=$(awk -F'\t' -v p="$p" '$3==p{print $2; exit}' <<<"$pp")
  [ -n "$w" ] && { printf 'the %s limit prompt is still on %s:%s\n' "$(label "$PRIMARY")" "$SESSION" "$w"; return 0; }
  limstamp
  { [ "$lim_till" -gt "$now" ] && [ "$(fam "${lim_model:-}")" = "$p" ]; } &&
    { printf "cc-limit's stamp still has %s limited until %sZ\n" "$p" "$(date -u -d "@$lim_till" +%H:%M)"; return 0; }
  return 1; }
SWITCH_TILL=0   # set by a caller that knows the deadline the limit itself named (the prompt's reset); do_switch banks it
do_switch(){   # $1 model (a family word like "opus" or a full id) $2 reason
  local want="$1" why="${2:-}" m wf n=0 id name msg to=0
  wf=$(fam "$want")
  if [ "$wf" = "$(fam "$PRIMARY")" ]; then m="$PRIMARY"; elif [ "$wf" = "$(fam "$FALLBACK")" ]; then m="$FALLBACK"; else m="$want"; fi
  if ov; then [ "$model" = "$m" ] && return 0; else [ "$m" = "$PRIMARY" ] && return 0; fi   # idempotent: callers may fire on every limited run
  if [ "$m" = "$PRIMARY" ]; then rm -f "$OV" "$ST/model-skipped"
  else limstamp; [ "$lim_till" -gt "$now" ] && to="$lim_till"
    [ "${SWITCH_TILL:-0}" -gt "$to" ] && to="$SWITCH_TILL"
    printf '%s\t%s\t%s\t%s\t0\n' "$m" "$now" "$to" "$(tr -d '\t\n' <<<"$why")" > "$OV"; fi
  while read -r id name; do [ -n "${id:-}" ] || continue
    if type_into "$id" "$name" "/model $m"; then n=$((n+1))
    else printf '%s\t%s\tskip\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$SESSION:$name busy or unreachable" >> "$LOG"
      printf '%s\n' "$id" >> "$ST/model-skipped"; fi   # a pane behind a dialog: retried on later ticks (F3)
  done < <(sessions)
  printf '%s\t%s\tswitch\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$n session(s); $why" >> "$LOG"
  if [ "$m" = "$PRIMARY" ]; then msg="$(label "$PRIMARY") is back — every session is on it again."
  elif [ "$to" -gt 0 ]; then msg="$(label "$PRIMARY") limit → all sessions on $(label "$m") until $(date -u -d "@$to" +%H:%M)Z."
  else msg="$(label "$PRIMARY") limit → all sessions on $(label "$m") until it answers again."; fi
  "$BIN/cc-notify" -t "$(hostname -s) model" "$msg" >/dev/null 2>&1 || true; }
# ── CLASSIFICATION READS FIELDS, NEVER THE DOCUMENT ──────────────────────────────────────────────────────────────
# A result JSON is kilobytes of numbers, uuids and the worker's own prose. Grepping it whole is how this classifier
# came to be wrong on 41 of 48 real runs (2026-09-01 review): "429" sits inside uuids, token counts and dollar costs;
# the literal `"refused":{…}` sits in `subagent_stats` of EVERY run; and a worker's result text says "refused" or
# "usage limit" whenever it is describing its own work. So: jq the FIELDS, and read prose only from `.result`, only
# when the API itself ended the run — never from a capped run, whose `.result` is the worker's last paragraph.
# The CLI's own wording for a model that will not answer: a usage limit, a rate limit, or an exhausted credit balance
# ("You're out of usage credits…" — 2026-08-28: this one was read as "could not run" and never switched).
LIMIT_RE='usage limit|rate limit|rate_limit|too many requests|usage credits|out of credits|insufficient credits'
# every wording that means the id we asked for is not ours to call: unknown, withdrawn, suspended, not permitted.
# API SHAPES ONLY — never the bare words refused/declined/unavailable, which a worker writes about its own task.
REFUSE_RE='model_not_found|invalid_model|unknown model|not a valid model|does not have access|no access to|permission_error|model[^"]{0,60}(not available|unavailable|deprecated|suspended|withdrawn|retired)|(unavailable|deprecated|suspended|withdrawn|retired|not available)[^"]{0,30}(to|for) this account'
SIDECALL='haiku'   # the CLI's own small side-calls (titles, summaries) run on it in 36/36 real runs: never a reroute
asked_fam(){   # the family the run WAS asked for. cc-loop passes nothing when there is no override — that is the
               # NORMAL state, and the reroute check has to work in it (F3), so resolve it the way the run itself
               # did: the model the caller named, else the box override, else the primary.
  local w; w=$(fam "${1:-}"); [ -n "$w" ] && { printf '%s\n' "$w"; return 0; }
  ov && w=$(fam "$model"); [ -n "$w" ] || w=$(fam "$PRIMARY"); printf '%s\n' "$w"; }
served_fams(){   # $1 run json · $2 failed=yes|no → the families that actually did the work, the side-call model
                 # excluded (F5: without that exclusion the answer was always "answered as haiku, not fable", 36/36 real runs)
  local m f; local -a all=() main=()
  while read -r m; do f=$(fam "$m"); [ -n "$f" ] || continue
    all+=("$f"); [ "$f" = "$SIDECALL" ] || main+=("$f")
  done < <(jq -r '[(.modelUsage? // {} | keys[]?), (.model? // empty)] | unique | .[]' "$1" 2>/dev/null)
  [ ${#main[@]} -gt 0 ] && { printf '%s\n' "${main[@]}"; return 0; }
  # only the side-call model ran. On a run that SUCCEEDED, that is what answered. On a run that FAILED, the primary
  # never answered at all (a 529, a 500, an execution error) and the title call is the only usage there is — calling
  # that "answered as haiku" walked cc-loop down the chain and off its end (exit 10) for one retryable error (re-review).
  [ "${2:-no}" = yes ] && return 0
  [ ${#all[@]} -gt 0 ] && printf '%s\n' "${all[@]}"; return 0; }
classify_run(){   # $1 run json · $2 its stderr · $3 the model that was ASKED for → "<class>\t<why>", always exit 0
  local j="${1:-}" e="${2:-}" want="${3:-}" err sub stop term astat res w sf served failed apisays
  err=$(tail -c 4000 "${e:-/dev/null}" 2>/dev/null)   # the CLI's own channel — the worker's prose never lands here
  if [ ! -s "$j" ] || ! jq -e 'type == "object"' "$j" >/dev/null 2>&1; then   # network, bad binary, timeout, an HTML 502
    { grep -qiE "$LIMIT_RE" <<<"$err" || grep -qiE "$LIMIT_RE" "$j" 2>/dev/null; } && { printf 'limit\tsaid so in words\n'; return 0; }
    [ -s "$j" ] && { printf 'error\tno json\n'; return 0; }
    printf 'error\tno output\n'; return 0; fi
  IFS=$'\t' read -r sub stop term astat < <(jq -r '[(.subtype // ""), (.stop_reason // ""), (.terminal_reason // ""), (.api_error_status // "" | tostring)] | @tsv' "$j" 2>/dev/null)
  res=$(jq -r '.result // "" | tostring' "$j" 2>/dev/null)
  failed=no; { [ "$(jq -r '.is_error // false' "$j" 2>/dev/null)" = true ] || [[ "$sub" == error_* ]]; } && failed=yes
  # `.result` is the CLI's own message on a run the API ended, and the worker's last paragraph on a capped one.
  # Only the first is evidence about the model; 9 of 10 real error_max_turns runs read as a refusal without this line.
  apisays=no; { [ "$failed" = yes ] && [[ "$sub" != error_max_* ]]; } && apisays=yes
  # ── a WAIT: cc-limit owns the clock, this only has to name it ──
  [ "$astat" = 429 ] && { printf 'limit\tthe API answered 429\n'; return 0; }
  { [ "$apisays" = yes ] && grep -qiE "$LIMIT_RE" <<<"$res"; } && { printf 'limit\tsaid so in words\n'; return 0; }
  grep -qiE "$LIMIT_RE" <<<"$err" && { printf 'limit\tsaid so in words\n'; return 0; }
  # ── a MOVE: the model would not answer AS ITSELF ──
  [ "$stop" = refusal ] && { printf 'refusal\tthe classifier stopped the turn\n'; return 0; }
  w=$(asked_fam "$want"); sf=$(served_fams "$j" "$failed"); served=$(paste -sd/ - <<<"$sf")
  # A run that took NO turns says nothing about the model it asked for: the only usage in the file is the CLI's own
  # side-call. served_fams excluded that call on a run that FAILED but not on one that simply did nothing, so an empty
  # success read as "answered as haiku, not fable" and walked cc-loop down the chain for a run with no work in it.
  { [ "$failed" = no ] && [ "$sf" = "$SIDECALL" ] && [ "$(jq -r '.num_turns // -1' "$j" 2>/dev/null)" = 0 ]; } &&
    { printf "ok\tan empty run: no turns, only the CLI's side-call\n"; return 0; }
  if [ -n "$w" ] && [ -n "$sf" ] && ! grep -qxF "$w" <<<"$sf"; then
    printf 'refusal\tanswered as %s, not %s\n' "$served" "$w"; return 0; fi
  { [ "$apisays" = yes ] && grep -qiE "$REFUSE_RE" <<<"$res"; } && { printf 'refusal\tthe model would not answer as itself\n'; return 0; }
  # ── a RETRY, or nothing wrong at all ──
  case "$sub" in error_*) printf 'error\t%s\n' "$sub"; return 0;; esac   # the RUN failed (cap, execution), not the model
  { [ -n "$astat" ] && [ "$astat" != 429 ]; } && { printf 'error\tthe API answered %s\n' "$astat"; return 0; }   # a 529/500: retry, not wait
  [ "$failed" = yes ] && { printf 'limit\tin-band error (%s) naming nothing — treated as a limit, as it has been since 2026-08-28\n' "${term:-no terminal_reason}"; return 0; }
  printf 'ok\t\n'; return 0; }
probe(){   # is the primary model answering again? one cheap turn, no tools.
           # 0 = answers · 1 = limited · 2 = could not run (unknown) · 3 = refused or rerouted (moving beats retrying)
  local o="$ST/model-probe.json" rc cl
  [ -x "$CLAUDE" ] || return 2
  # --setting-sources '' keeps the probe off this box's settings/MCP servers: a plain turn, cents not dollars
  timeout 60 "$CLAUDE" -p "reply ok" --model "$PROBEM" --max-turns 1 --setting-sources '' \
      --max-budget-usd "${CC_MODEL_PROBE_BUDGET:-0.50}" --output-format json >"$o" 2>"$o.err"; rc=$?
  cl=$(classify_run "$o" "$o.err" "$PROBEM"); probe_why="${cl#*$'\t'}"; cl="${cl%%$'\t'*}"   # the JSON before the exit code
  case "$cl" in limit) return 1;; refusal) return 3;; error) return 2;; esac
  [ "$rc" = 0 ] || { probe_why="exit $rc"; return 2; }
  return 0; }
lastprobe(){ cat "$ST/model-probed" 2>/dev/null || echo 0; }   # F2: the pane-detection probe is throttled like the restore probe
tick(){
  local id name cap line h m rc nx pp pf pe pw ptill why k
  # ---- (1)+(2) THE CLI'S OWN LIMIT PROMPT: answered first, and in EVERY state. A session sitting on it delivers
  # nothing at all — on 2026-09-01 a pulse tick and two secretary findings went nowhere for exactly this — and the
  # answer is the same whether or not the box has already moved off the primary model.
  pp=$(prompt_panes); ptill=0
  while IFS=$'\t' read -r id name pf pe; do [ -n "${id:-}" ] || continue
    { [[ "${pe:-}" =~ ^[0-9]+$ ]] && [ "$pe" -gt "$ptill" ]; } && ptill="$pe"
    k=$(answer_prompt "$id") &&
      printf '%s\t%s\tanswered\t%s\t%s: %s limit prompt — %s\n' "$(date -u +%FT%TZ)" "$now" "$pf" "$SESSION:$name" "$(label "$pf")" "$k" >> "$LOG"
  done <<<"$pp"
  if ov; then   # ---- the fallback is on: restore once the limit has passed AND the primary model answers again
    if [ -s "$ST/model-skipped" ]; then   # F3: panes that were behind a dialog at switch time get another try
      : > "$ST/model-skipped.n"
      while read -r id; do [ -n "${id:-}" ] || continue
        name=$(sessions | awk -v i="$id" '$1==i{print $2; exit}'); [ -n "$name" ] || continue   # gone: nothing to do
        type_into "$id" "$name" "/model $model" && printf '%s\t%s\tretyped\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$model" "$id" >> "$LOG" || printf '%s\n' "$id" >> "$ST/model-skipped.n"
      done < "$ST/model-skipped"; mv "$ST/model-skipped.n" "$ST/model-skipped"; fi
    { [ "$till" -gt 0 ] && [ "$now" -lt "$till" ]; } && return 0
    [ $((now - probed)) -ge "${CC_MODEL_PROBE_EVERY:-900}" ] || return 0
    # (3) A PROBE CANNOT SEE WHO PAID FOR IT. Before spending anything: if the box cannot tell a lifted limit from one
    # answered out of usage credits, it neither probes nor restores.
    if why=$(restore_blocked "$pp"); then
      printf '%s\t%s\tprobe\t%s\tnot probing — %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$why" >> "$LOG"; return 0; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$model" "$since" "$till" "$reason" "$now" > "$OV"   # bank the attempt first: a hung probe must not rerun every minute
    probe_why=""; probe; case $? in 1) printf '%s\t%s\tprobe\t%s\tstill limited\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" >> "$LOG"; return 0;;
                      2) printf '%s\t%s\tprobe\t%s\tcould not run — unknown (%s)\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-no json}" >> "$LOG"; return 0;;
                      3) printf '%s\t%s\trefusal\t%s\t%s — staying on %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-refused}" "$(fam "$model")" >> "$LOG"; return 0;; esac
    # …and after: the prompt can appear on a pane while the probe is running, and that answer is not proof either.
    if why=$(restore_blocked "$(prompt_panes)"); then
      printf '%s\t%s\tprobe\t%s\tanswered, but %s — not restoring\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$why" >> "$LOG"; return 0; fi
    rate_ok && do_switch "$PRIMARY" "limit lifted (probe)"; return 0
  fi
  # ---- (2) the prompt names the primary model: move, with no probe (answering one costs usage credits) and no rate
  # gate (do_switch is idempotent, and the wording is gone from the pane the moment it is answered).
  pw=$(awk -F'\t' -v p="$(fam "$PRIMARY")" '$3==p{print $2; exit}' <<<"$pp")
  if [ -n "$pw" ]; then
    [ "$ptill" -gt 0 ] || ptill=$((now + ${CC_MODEL_PROMPT_TILL:-86400}))   # it named no reset: a day, not a probe
    SWITCH_TILL="$ptill"; do_switch "$FALLBACK" "$(label "$PRIMARY") limit prompt in $SESSION:$pw"; SWITCH_TILL=0
    return 0; fi
  limstamp   # ---- normal: did the primary model just hit a limit?
  if [ "$lim_till" -gt "$now" ] && [ -n "$lim_model" ] && [ "$(fam "$lim_model")" = "$(fam "$PRIMARY")" ]; then
    rate_ok && do_switch "$FALLBACK" "$(fam "$PRIMARY") limit (cc-limit stamp)"; return 0; fi
  # ---- no override is in force, so the box wants PRIMARY: a session on another ID of that same family — the pane on
  # `claude-fable-5` while the box is on `claude-fable-5-1` — is retuned. Nothing here could see that before: to fam()
  # the two are one rung, and the sessions cc-model itself typed the old id into on 2026-09-01 were never moved back.
  while read -r id name; do [ -n "${id:-}" ] || continue
    cap=$(pane_text "$id"); m=$(retune_to "$cap") || continue
    retuned_recently "$id" && continue
    type_into "$id" "$name" "/model $m" &&
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) was on %s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$SESSION" "$name" \
             "$id" "$(pane_model "$cap")" >> "$LOG"
  done < <(sessions)
  while read -r id name; do [ -n "${id:-}" ] || continue   # a live session says it in its pane before any stamp exists
    cap=$(tmux capture-pane -p -S -30 -t "$id" 2>/dev/null)
    line=$(grep -iE 'usage limit|resets? at [0-9]|out of usage credits|usage-credits' <<<"$cap" | tail -1); [ -n "$line" ] || continue
    h=$(printf '%s' "$name$line" | md5sum | cut -c1-16)   # per-window hash: one hit fires once, however long the line stays on screen
    grep -qxF "$h" "$SEEN" 2>/dev/null && continue
    m=$(fam "$(grep -oiE 'claude-(fable|opus|sonnet|haiku)[a-z0-9._-]*|\b(fable|opus|sonnet|haiku) [0-9]' <<<"$cap" | tail -1)")
    [ -n "$m" ] || m=$(fam "$PRIMARY")   # the pane names no model: it runs the box default
    [ "$m" = "$(fam "$PRIMARY")" ] || continue
    rate_ok || return 0
    [ $((now - $(lastprobe))) -ge "${CC_MODEL_PROBE_EVERY:-900}" ] || return 0   # F2: at most one confirming probe per 15 min
    printf '%s\n' "$now" > "$ST/model-probed"
    probe_why=""; probe; rc=$?
    # the line is only "used up" once the probe DECIDED (answers / limited). After an inconclusive probe it must fire
    # again on a later tick — 2026-08-27 a single unrunnable probe swallowed the only limit line of the day.
    [ "$rc" = 2 ] || { printf '%s\n' "$h" >> "$SEEN"; tail -n 1000 "$SEEN" > "$SEEN.t" 2>/dev/null && mv "$SEEN.t" "$SEEN"; }
    case "$rc" in
      0) printf '%s\t%s\tprobe\t%s\tpane line in %s was not a live limit\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$name" >> "$LOG"; return 0;;
      2) printf '%s\t%s\tprobe\t%s\tcould not run — not switching on a pane line alone (%s)\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-no json}" >> "$LOG"; return 0;;
      3) nx=$(chain_next "$PRIMARY") || nx="$FALLBACK"   # not a limit, but the primary still will not do the work
         printf '%s\t%s\trefusal\t%s\t%s — moving to %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-refused}" "$(fam "$nx")" >> "$LOG"
         do_switch "$nx" "$(fam "$PRIMARY") refused or rerouted (probe): ${probe_why:-refused}"; return 0;;
    esac
    do_switch "$FALLBACK" "$m limit seen in $SESSION:$name"; return 0
  done < <(sessions); return 0; }
selfcheck(){   # fixtures only: no network, no tmux, and none of this box's state is read or written.
               # EVERY fixture is a REAL `claude -p --output-format json` result — sanitized (no session id, no prose)
               # and bent by one jq expression. Hand-written stubs are exactly why the 2026-09-01 review found this
               # classifier wrong on 41 of 48 real runs while its own selfcheck was green: the stubs carried none of
               # the traps a real result carries. The three that matter are asserted below, so nobody simplifies
               # them away: `subagent_stats.refused`, a "429" inside the uuid, and the haiku side-call.
  local d n=0 bad=0 got real c1 c2 c3 exp other oldov="$OV" oldchain="$CHAIN" oldst="$ST"
  local dlg dlg2 dlgwrap notice credits worker quoted perm askfirst pe0 pn pf0
  d=$(mktemp -d) || return 1
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  cl(){ classify_run "$1" "" "${2:-}" | cut -f1; }
  real="$d/real.json"; cat > "$real" <<'JSON'
{"type":"result","subtype":"success","is_error":false,"duration_ms":489371,"duration_api_ms":410311,"num_turns":68,"result":"ok","session_id":"00000000-0000-4000-8000-000000000000","total_cost_usd":3.6408924999999983,"usage":{"input_tokens":112,"cache_creation_input_tokens":92541,"cache_read_input_tokens":3953051,"output_tokens":29423,"service_tier":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":2737,"outputTokens":17,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.002822,"contextWindow":200000,"maxOutputTokens":32000,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"},"claude-fable-5":{"inputTokens":112,"outputTokens":29423,"cacheReadInputTokens":3953051,"cacheCreationInputTokens":92541,"webSearchRequests":0,"costUSD":3.6380704999999987,"contextWindow":1000000,"maxOutputTokens":64000,"canonicalModel":"claude-fable-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"stop_reason":"end_turn","terminal_reason":"completed","queued_turn_count":0,"errors":null,"subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"uuid":"14144299-9e48-4299-8f0c-0000000429ab"}
JSON
  jq -e . "$real" >/dev/null 2>&1 || { echo "cc-model selfcheck: the real-result fixture is not json" >&2; rm -rf "$d"; return 1; }
  b(){ jq -c "$2" "$real" > "$d/$1.json"; }   # a fixture is the real result plus one bend
  t 'the fixture is a real result: subagent_stats.refused is in it' "$(jq -r '.subagent_stats.refused|keys|length' "$real")" 3
  t 'the fixture is a real result: 429 sits inside its uuid'        "$(jq -r '.uuid' "$real" | grep -c 429)" 1
  t 'the fixture is a real result: the haiku side-call is in it'    "$(jq -r '[.modelUsage|keys[]|select(test("haiku"))]|length' "$real")" 1

  # type_into: QUEUED IS NOT TYPED (review of #157). cc-msg answers rc 0 for a line it typed AND for one it only
  # spooled behind a dialog; counting the second as a retune leaves the session on the exhausted model and never
  # retries it. Its own tmux and cc-msg are stubs here — this asserts the verdict, not the keyboard.
  local ti_bin="$BIN" ti_sess="$SESSION" ti_proc="$PROC"
  mkdir -p "$d/bin"
  cat > "$d/bin/cc-msg" <<'STUB'
#!/usr/bin/env bash
[ -n "${CC_FAKE_MSG_OUT:-}" ] && printf '%s\n' "$CC_FAKE_MSG_OUT"
exit "${CC_FAKE_MSG_RC:-0}"
STUB
  chmod +x "$d/bin/cc-msg"
  tmux(){ case "${1:-}" in display-message) echo 1;; capture-pane) printf '> \n';; esac; return 0; }
  BIN="$d/bin"; SESSION=main; PROC=claude; CC_MODEL_DIALOG_WAIT=0
  CC_FAKE_MSG_OUT=queued type_into '%1' demo/t1 '/model opus'
  t 'a /model line cc-msg only spooled is NOT a retune: the pane is skipped, and F3 retries it' "$?" 1
  CC_FAKE_MSG_OUT='' type_into '%1' demo/t1 '/model opus'
  t '...while a line it typed counts, silent and rc 0 as cc-msg reports a delivery' "$?" 0
  CC_FAKE_MSG_RC=1 type_into '%1' demo/t1 '/model opus'
  t '...and a pane cc-msg refuses outright is skipped as it always was' "$?" 1
  unset -f tmux; BIN="$ti_bin"; SESSION="$ti_sess"; PROC="$ti_proc"; unset CC_MODEL_DIALOG_WAIT

  b ok      '.'
  b capped  '.subtype="error_max_turns" | .is_error=true | .stop_reason="tool_use" | .terminal_reason="max_turns" | .errors=["Reached maximum number of turns (80)"] | .result="Wrote the gate. The `.env.local` write was refused, and the old model id is deprecated, so I stopped there."'
  b limit429 '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=429 | .result="You'"'"'re out of usage credits. Switch to another model, or manage usage credits at the settings page, to continue."'
  b credits '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .result="You'"'"'re out of usage credits. Switch to another model to continue."'
  # the shape of every API-ended run on this box (2026-08-28): the primary never answered, so the haiku title call is the ONLY usage
  b overloaded '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=529 | .result="API Error: 529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}" | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  b stopped '.is_error=true | .subtype="error_during_execution" | .stop_reason="refusal" | .result=""'
  b reroute '.modelUsage = {"claude-haiku-4-5-20251001":{"inputTokens":2737},"claude-opus-5":{"inputTokens":112}}'
  b gone    '.is_error=true | .subtype="error_during_execution" | .result="model_not_found: claude-fable-5 is not available to this account"'
  b both    '.is_error=true | .terminal_reason="api_error" | .result="refused: Claude usage limit reached"'
  b budget  '.is_error=true | .subtype="error_max_budget_usd" | .result="I was still working when the budget ran out."'
  b vague   '.is_error=true | .result="the API said no and named nothing"'
  b innocent '.result="Done. The 2026-08-28 fix is why a bare stop_reason: refusal still reads as a limit, and I cannot assist with the part that needs the owner."'
  printf '%s' '<html>502 Bad Gateway</html>' > "$d/html.json"
  t 'a good run is ok'                    "$(cl "$d/ok.json" claude-fable-5)"        ok
  t 'a capped run is an error, not a refusal' "$(cl "$d/capped.json" claude-fable-5)" error
  t 'a 429 from the API is a limit'       "$(cl "$d/limit429.json" claude-fable-5)"  limit
  t 'out of usage credits is a limit'     "$(cl "$d/credits.json" claude-fable-5)"   limit
  t 'a 529 the primary never answered is an error, not a reroute' "$(cl "$d/overloaded.json" claude-fable-5)" error
  t 'and it names the status'             "$(classify_run "$d/overloaded.json" "" claude-fable-5 | cut -f2)" "the API answered 529"
  t 'stop_reason refusal is a refusal'    "$(cl "$d/stopped.json" claude-fable-5)"   refusal
  t 'answering as opus is a refusal'      "$(cl "$d/reroute.json" claude-fable-5)"   refusal
  t 'a withdrawn model is a refusal'      "$(cl "$d/gone.json" claude-fable-5)"      refusal
  t 'limit wording beats refusal wording' "$(cl "$d/both.json" claude-fable-5)"      limit
  t 'a budget cap is an error'            "$(cl "$d/budget.json" claude-fable-5)"    error
  t 'no json at all is an error'          "$(cl "$d/html.json" claude-fable-5)"      error
  t 'no output at all is an error'        "$(cl "$d/none.json" claude-fable-5)"      error
  t 'an in-band error still reads limit'  "$(cl "$d/vague.json" claude-fable-5)"     limit
  t 'refusal wording in a GOOD run is the worker talking' "$(cl "$d/innocent.json" claude-fable-5)" ok
  t 'a haiku side-call is not a reroute'  "$(classify_run "$d/ok.json" "" claude-fable-5 | cut -f2)" ""
  t 'the reroute says what answered'      "$(classify_run "$d/reroute.json" "" claude-fable-5 | cut -f2)" "answered as opus, not fable"
  # a run that did NOTHING: no turns, so the CLI's own side-call is the only usage there is. That read as
  # "answered as haiku, not fable" — a refusal — and moved the chain for a run with no work in it.
  b nothing  '.num_turns=0 | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  b sidecall '.num_turns=6 | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  t 'an empty run that succeeded is not a reroute'  "$(cl "$d/nothing.json" claude-fable-5)"  ok
  t '...and it says the run was empty'              "$(classify_run "$d/nothing.json" "" claude-fable-5 | cut -f2)" \
    "an empty run: no turns, only the CLI's side-call"
  t '...while a run that TOOK turns and only the side-call answered is still a reroute' \
    "$(cl "$d/sidecall.json" claude-fable-5)" refusal
  t 'the cap says which cap'              "$(classify_run "$d/capped.json" "" claude-fable-5 | cut -f2)" "error_max_turns"
  : > "$d/empty.json"; printf 'Claude usage limit reached. Resets at 11:40Z\n' > "$d/empty.json.err"
  t 'a limit that produced no json is still a limit' "$(classify_run "$d/empty.json" "$d/empty.json.err" claude-fable-5 | cut -f1)" limit
  # F3: the normal state is NO --model at all. Bend the fixture to a family the box is not on, then ask with "".
  OV="$d/no-override-here"   # hermetic: no override file, so the asked family falls to $PRIMARY, as a real run would
  other=$(fam "$(chain_next "$PRIMARY")"); [ -n "$other" ] && [ "$other" != "$(fam "$PRIMARY")" ] || other=sonnet
  jq -c --arg k "claude-$other-5" '.modelUsage = {"claude-haiku-4-5-20251001":{"inputTokens":9}} | .modelUsage[$k] = {"inputTokens":112}' "$real" > "$d/elsewhere.json"
  t 'no --model given: the reroute is still seen' "$(classify_run "$d/elsewhere.json" "" "" | cut -f1)" refusal
  t 'no --model given: it names both families'    "$(classify_run "$d/elsewhere.json" "" "" | cut -f2)" "answered as $other, not $(fam "$PRIMARY")"
  t 'no --model given: a run on the primary is ok' "$(cl "$d/ok.json" "")" "$([ "$(fam "$PRIMARY")" = fable ] && echo ok || echo refusal)"
  OV="$oldov"
  # ── the CLI's own limit prompt, in the pane's own words (2026-09-01) ──────────────────────────────────────────
  # Captured off the real TUI and off the owner's screenshot, borders and all: the flattening, the anchors and the
  # gap before "limit reached" are what these cases are for. THE NEGATIVES ARE THE POINT — every trigger phrase is
  # quoted in this file's own header and in this block, so a session reading it must not move the box (review of #155).
  self=$(readlink -f "$0")
  # The leading "|" is stripped back off below, so $dlg is the real dialog byte for byte — but THE FILE never holds a
  # renderable one. Without it, printing just this block (sed -n, a scrolled pager) puts a live-looking dialog at the
  # bottom of somebody's pane, and no rule that reads text could tell it from the CLI's own.
  dlg=$(sed 's/^|//' <<'TXT'
|╭──────────────────────────────────────────────────╮
|│ You've reached your Fable 5 limit                │
|│ for this week. Continuing on Fable 5 uses usage  │
|│ credits — you have CA$0.00 in credits.           │
|│                                                  │
|│ ❯ Switch to Opus 5 (1M context) and continue     │
|│   Manage usage credits on claude.ai              │
|│                                                  │
|│ Enter to confirm · Esc to cancel                 │
|╰──────────────────────────────────────────────────╯
TXT
)
  dlg2=$(sed 's/❯ Switch/  Switch/; s/│   Manage/│ ❯ Manage/' <<<"$dlg")   # the highlight one line down
  dlgwrap=$(printf '%s\n' '│ You have reached your Fable 5      │' '│ limit for this week.               │' '│ Enter to confirm · Esc to cancel   │')
  notice='● Fable 5 limit reached · continuing on Fable 5 uses usage credits, and the prompt to confirm went unanswered — nothing was sent · /model to switch'
  credits='  Continuing on Fable 5 uses usage credits — you have CA$0.00 in credits.'
  worker=$(printf '%s\n' '✓ step limit reached (80 steps) — the worker stopped there' '  Switch to Opus 5 (1M context) and continue   ← quoted from the runbook' '● Opus 5 · 43% context left')
  quoted=$(printf '%s\n' '❯ Switch to Opus 5 (1M context) and continue' '  Enter to confirm · Esc to cancel')
  perm=$(printf '%s\n' 'Do you want to make this edit to cc-model?' '❯ 1. Yes' '  2. No, and tell Claude what to do differently (esc)' 'Enter to confirm · Esc to cancel')
  t 'the dialog is a Fable limit, though it names Opus 5 lower down' "$(prompt_fam "$dlg")"     fable
  t 'the notice it leaves when nobody answered is one too'           "$(prompt_fam "$notice")"  fable
  t 'so is "continuing on Fable 5 uses usage credits" under the footer' \
    "$(prompt_fam "$(printf '%s\n%s\n' "$credits" 'Enter to confirm · Esc to cancel')")"        fable
  t 'and so is the same dialog wrapped across its box'               "$(prompt_fam "$dlgwrap")" fable
  t 'a worker pane saying "step limit reached" is NOT a limit'       "$(prompt_fam "$worker")"  ""
  t 'nor is a pane merely showing the option line'                   "$(prompt_fam "$quoted")"  ""
  t 'nor is the sentence on its own: no dialog, no notice, no move'  "$(prompt_fam "$credits")" ""
  t 'nor is the prompt as this file documents it'  "$(prompt_fam "$(sed -n '/^# tick:/,/^# Retuning/p' "$self")")" ""
  t 'nor is the fixture block itself, printed on its own' "$(prompt_fam "$(sed -n '/^  dlg=\$(sed/,/^  perm=/p' "$self")")" ""
  t 'nor are the fixtures read to the end of the file' "$(prompt_fam "$(sed -n '/^  dlg=\$(sed/,$p' "$self")")" ""
  t 'nor is the whole of this file, catted into a pane'            "$(prompt_fam "$(cat "$self")")" ""
  t 'a permission prompt quoting the wording is not a limit' "$(prompt_fam "$(printf '%s\n%s\n' "$credits" "$perm")")" ""
  askfirst=$(printf '%s\n%s\n' 'I can run the suite first. Do you want to run the tests first?' "$dlg")
  t 'but a live dialog under an assistant "Do you want to …" line still is' "$(prompt_fam "$askfirst")" fable
  t 'and a permission box below ours hides only its own anchor' \
    "$(prompt_fam "$(printf '%s\n%s\n' "$dlg" "$perm")")"                                     fable
  t 'that pane is still left for a human, though: no key goes into it'      "$(answer_key "$askfirst")" ""
  t 'an assistant bullet quoting the notice is not one either' \
    "$(prompt_fam '● The notice reads "Fable 5 limit reached · continuing on Fable 5 uses usage credits" — see #155')" ""
  t 'the dialog one screen up is history, not a live prompt' \
    "$(prompt_fam "$(printf '%s\n' "$dlg" 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok')")" ""
  t 'the highlighted switch-and-continue option is answered with Enter' "$(answer_key "$dlg")"  Enter
  t 'any other highlighted line is answered with Esc'                "$(answer_key "$dlg2")"    Escape
  t 'with no dialog open there is no key to send'                    "$(answer_key "$notice")"  ""
  t 'and another dialog is not answered either, in either direction' "$(answer_key "$perm")"    ""
  t 'nor is a permission prompt under our own dialog — that Enter would approve it' \
    "$(answer_key "$(printf '%s\n%s\n' "$dlg" "$perm")")"                                       ""
  t 'nor an option line a screenful above the footer that is not its own' \
    "$(answer_key "$(printf '%s\n' '❯ Switch to Opus 5 (1M context) and continue' '' '' '' '' '' 'Enter to confirm · Esc to cancel')")" ""
  pe0=$(date -u -d '+3 days' +%s); pn=$(date -u -d "@$pe0" +'%Y-%m-%d %H:%M:%S UTC')
  t 'a reset the prompt names becomes the until'  "$(reset_at "Your limit resets at $pn.")"     "$pe0"
  t 'a prompt that names none gets none (24 h)'   "$(reset_at "$dlg")"                          ""
  ST="$d"   # hermetic: this box's cc-limit stamp is never read
  pf0=$(printf '%%9\tsess\t%s\t0\n' "$(fam "$PRIMARY")")
  t 'no restore while the prompt is on a pane'    "$(restore_blocked "$pf0" | grep -c 'limit prompt is still on')" 1
  t 'nothing on any pane: the probe may decide'   "$(restore_blocked '' >/dev/null; echo $?)"   1
  printf '%s\tapi\t%s\t%s\n' "$((now + 3600))" "$now" "$(fam "$PRIMARY")" > "$ST/claude-limit"
  t "a live cc-limit stamp cannot tell either"    "$(restore_blocked '' | grep -c 'still has')" 1
  ST="$oldst"
  # ── the model a session is ON is asked by ID, not by family ──────────────────────────────────────────────────
  # fam() is right for the CHAIN (one rung per family) and wrong for "is this session where the box wants it":
  # a session left on `claude-fable-5` while the box is on `claude-fable-5-1` was invisible to every family test
  # here, and its cache reads bill at 4x (about $140 on 2026-09-02).
  local pid oldid
  pid="${PRIMARY%%\[*}"; case "$pid" in *-1) oldid="${pid%-1}";; *) oldid="$pid-1";; esac
  said(){   # a pane the CLI has just answered /model in, in the shape it really draws (captured 2026-09-02)
    printf '%s\n' "❯ /model $1" \
      "  ⎿  Set model to $(idname "$1")$([ "${1#*[}" != "$1" ] && printf ' (1M context)') and saved as your default for new sessions" "> "; }
  t 'fam() cannot tell the primary from the id it replaced' "$(fam "$pid"):$(fam "$oldid")" "$(fam "$pid"):$(fam "$pid")"
  t '...while the NAME the CLI prints does'                 \
    "$([ "$(idname "$pid")" != "$(idname "$oldid")" ] && echo differ || echo same)" differ
  t 'a pane the CLI last put on the OLD id of the primary family is retuned to the primary' \
    "$(retune_to "$(said "$oldid")")" "$PRIMARY"
  t '...and one already on the primary is left alone' \
    "$(retune_to "$(said "$PRIMARY")" >/dev/null; echo $?)" 1
  t '...and another FAMILY is not this pass to undo: an override or the owner put it there' \
    "$(retune_to "$(said "$(chain_next "$PRIMARY")")" >/dev/null; echo $?)" 1
  t '...and a pane that merely NAMES a model — this file in a pager, a doc — is never retuned on the word alone' \
    "$(retune_to "  fam(){ ...; }   # $oldid and $pid are one family, and that is the bug" >/dev/null; echo $?)" 1
  unset -f said
  # …and an until is rendered as a person reads it: HH:MMZ alone made a 24-hour override look three hours expired
  t 'an until later today is the clock alone' "$(untilw "$now")" "$(date -u -d "@$now" +%H:%MZ)"
  t 'an until on another day carries its date' "$(untilw "$((now + 86400))")" "$(date -u -d "@$((now + 86400))" +%FT%H:%MZ)"
  c1=$(chain | sed -n 1p); c2=$(chain | sed -n 2p); c3=$(chain | tail -1)
  [ -n "${CC_MODEL_CHAIN:-}" ] || t 'the shipped chain is fable, then opus, then sonnet' "$(chain | tr '\n' ' ')" 'claude-fable-5-1 claude-opus-5 claude-sonnet-5 '
  t 'the chain walks to its next rung'    "$(chain_next "$c1")"          "$c2"
  t 'a bare family word is the same rung' "$(chain_next "$(fam "$c1")")" "$c2"
  case "$c2" in *']') exp="$c2";; *) exp="${c2}[1m]";; esac
  t 'and a [1m] suffix rides along'       "$(chain_next "${c1}[1m]")"      "$exp"
  t 'naming no model starts where the box is' "$(chain_next '')"         "$(chain_next "$PRIMARY")"
  got=$(chain_next "$c3"); t 'the end of the chain is empty' "$got:$?" ":1"
  CHAIN="$c1 $c2 $c1"   # F7: a chain that names a family twice must not walk in a circle for ever
  t 'a repeated family is one rung'       "$(chain | wc -l)"             2
  got=$(chain_next "$c2"); t 'so the walk still ends' "$got:$?" ":1"
  CHAIN="$oldchain"
  rm -rf "$d"
  printf 'cc-model selfcheck: %s passed, %s failed\n' "$((n - bad))" "$bad"
  [ "$bad" = 0 ]; }
case "${1:-}" in
  status)  if ov; then [ "$till" -gt 0 ] && printf '%s until %s\n' "$(fam "$model")" "$(untilw "$till")" || printf '%s until probe\n' "$(fam "$model")"
           else fam "$PRIMARY"; fi ;;
  current) ov && printf '%s\n' "$model" ;;
  switch)  do_switch "${2:?usage: cc-model switch <model> [reason]}" "${3:-}" ;;
  limited) [ "$(fam "${2:?usage: cc-model limited <model> [reason]}")" = "$(fam "$PRIMARY")" ] || exit 0
           rate_ok && do_switch "$FALLBACK" "${3:-$(fam "$2") limit}" ;;
  classify) shift; classify_run "${1:?usage: cc-model classify <json> [<err>] [<asked-model>]}" "${2:-}" "${3:-}" ;;
  chain)   chain ;;
  next)    chain_next "${2:-}" || exit 1 ;;
  tick)    tick ;;
  selfcheck) selfcheck || exit 1 ;;
  *) sed -n '2,14p' "$0" >&2; exit 2 ;;
esac
exit 0
