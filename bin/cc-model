  rm -f "$d/model-confirms" "$d/tr/%27.jsonl" "$d/tr/%28.jsonl"; rm -rf "$d/confirm-answers"; : > "$d/slack"; : > "$d/keys"; : > "$d/typed"; : > "$LOG"
  printf '%s\n' '%27 seat-blind' '%28 seat-blind2' > "$d/sess"
  cdlg 'a wrapped call the box cannot read' > "$d/screen.%27"; cdlg 'another one' > "$d/screen.%28"
  confirm_panes
  t '(f) NO TRANSCRIPT: nothing is pressed, and each pane is carded once as a call the box could not read' \
    "$(keys %27)$(keys %28):$(grep -c 'could not read off the transcript' "$d/slack")" ":2"
  confirm_panes
  t '(f) …and the tick after raises no second card' "$(grep -c '' "$d/slack")" 2
  mkdir -p "$d/confirm-answers"; printf 'yes\tThe Owner\n' > "$d/confirm-answers/bcdef"; printf 'no\tThe Owner\n' > "$d/confirm-answers/cdefg"
  confirm_panes
  t '(f) …HIS YES and HIS NO each land ONCE on the unreadable call: the digit AND Enter, the answer consumed, the row gone' \
    "$(keys %27):$(keys %28):$(ls "$d/confirm-answers"):$(cat "$d/model-confirms" 2>/dev/null):$(typed seat-blind2 | grep -c 'did not approve this from Slack')" \
    "1|Enter:2|Enter:::1"
  t '(f) …the dialogs gone, nothing is pressed a second time and no card follows' \
    "$(printf '> \n' > "$d/screen.%27"; printf '> \n' > "$d/screen.%28"; confirm_panes; keys %27):$(keys %28):$(grep -c '' "$d/slack")" "1|Enter:2|Enter:2"
  # …and when the pane no longer looks like the screen he answered about, nothing goes in: his answer is kept for a
  # tick that can verify it, and the row stays, so he is not asked a second time either.
  rm -f "$d/model-confirms"; rm -rf "$d/confirm-answers"; : > "$d/slack"; : > "$d/keys"
  printf '%s\n' '%27 seat-blind' > "$d/sess"; cdlg 'a wrapped call the box cannot read' > "$d/screen.%27"
  confirm_panes; mkdir -p "$d/confirm-answers"; printf 'yes\tThe Owner\n' > "$d/confirm-answers/bcdef"
  cdlg 'a different call behind a new dialog' > "$d/screen.%27"; confirm_panes
  t '(f) …a pane that changed since the card: no key, his answer kept, the row kept, no second card' \
    "$(keys %27):$([ -e "$d/confirm-answers/bcdef" ] && echo kept):$(cut -f3 "$d/model-confirms"):$(grep -c '' "$d/slack")" ":kept:bcdef:1"
  rm -rf "$d/confirm-answers"; rm -f "$d/model-confirms"
  BIN="$obin"; unset CC_MODEL_TRANSCRIPTS; unset -f cdlg tcall tcall2 tcallp
  unset -f keys cards; unset CC_MODEL_ANSWER_WAIT CC_MODEL_MAJOR CC_CLAUDE_SETTINGS CC_MODEL_MEMBERS
  rm -f "$d/keys"
  # ── A PLANNING SESSION NEVER RUNS BELOW THE FLOOR (owner, 2026-09-21: "planning sessions must be at least on opus") ──
  # One fixture per question. Each session kind on the floor rung (Opus) when it goes out: a repo's seat, an orch and a
  # course seat (on CC_MODEL_PLANNING) are parked, a track moves down the chain, a member window is left alone. Then
  # the floor answers again: parked seats hand back by handoff, the track is typed back up.
  local fl lo; fl=$(floor_rung); lo=$(chain_next "$fl")   # the floor and the rung under it
  typed(){ awk -F'\t' -v w="$1" '$1==w{print $2}' "$d/typed" | paste -sd'|' -; }
  mkdir -p "$d/members/mem-a"; CC_MODEL_MEMBERS="$d/members"; CC_MODEL_PLANNING='lessons/*'; export CC_MODEL_PRIMARY_WINDOWS=''
  pl(){ rm -f "$OV" "$UNAV" "$MOVED" "$RETURNED" "$ST/model-probed" "$ST/model-credits-seen"; : > "$d/typed"; : > "$LOG"; : > "$d/calls"; : > "$d/handoffs"
    printf '%s\n' '%1 repo' '%2 repo@orch' '%3 lessons/ece1' '%4 repo/track' '%5 mem-a' > "$d/sess"
    printf '%s\t%s\n' '%1' "$fl" '%2' "$fl" '%3' "$fl" '%4' "$fl" '%5' "$fl" > "$d/live"
    for pn in 1 2 3 4 5; do printf '> \n' > "$d/screen.%$pn"; done
    printf '%s\t%s\t0\t%s\t%s\n' "$fl" "$((now - 7200))" 'the primary out' "$now" > "$OV"
    printf '%s\n' "$now" > "$ST/model-probed"; }   # a tick's own re-probe is not due: each case calls it when it means to   # the box already a rung down, on the floor
  pl; mark_unavailable "$fl" "You've hit your monthly spend limit"
  t '(p) the floor goes out: repo seat, orch and course seat have nothing typed; the track moves down; a member window is not on the chain' \
    "$(typed repo):$(typed repo@orch):$(typed lessons/ece1):$(typed repo/track):$(typed mem-a)" ":::/model $lo:"
  t '(p) …the three planning seats are banked parked, the track moved' \
    "$(cut -f1,5 "$MOVED" | tr '\t' ':' | sort | paste -sd' ' -)" "%1:parked %2:parked %3:parked %4:moved"
  t '(p) …a dispatch still names the rung under: workers and tracks keep the chain' "$(fam "$(current)")" "$(fam "$lo")"
  t '(p) …and the owner gets ONE plain line naming what is parked and why' \
    "$(grep -c '^notify .*Planning parked: repo, repo@orch, lessons/ece1 — .* is out (' "$d/calls")" 1
  : > "$d/typed"; probe(){ return 1; }; tick; unset -f probe   # the primary still limited
  t '(p) a tick later nothing is retyped at a parked seat' "$(typed repo)$(typed repo@orch)$(typed lessons/ece1)" ""
  printf '%s\t%s\n' '%1' "$fl" '%2' "$fl" '%3' "$fl" '%4' "$lo" '%5' "$fl" > "$d/live"   # the track landed on the rung under
  probe(){ [ "$(fam "${1:-}")" = "$(fam "$fl")" ]; }; : > "$d/typed"; rm -f "$ST/model-probed"; probe_unavailable others; unset -f probe
  t '(p) the floor answers again (its own re-probe, under the override): each parked seat hands back by handoff, the track is typed back up' \
    "$(paste -sd'|' "$d/handoffs"):$(typed repo):$(typed repo/track):$(typed mem-a)" "repo|repo@orch|lessons/ece1::/model $fl:"
  t '(p) …the override moves up to the floor, the record goes, and a handoff successor comes up on it' \
    "$(fam "$(cut -f1 "$OV")"):$(unavail "$(fam "$fl")" && echo rec):$(fam "$(current)")" "$(fam "$fl")::$(fam "$fl")"
  # parked OFF THE PRIMARY while the floor was already out (field 6 names the primary): the floor answering still hands it back
  pl; rm -f "$OV"; note_unavailable "$(fam "$fl")" "You've hit your monthly spend limit"
  printf '%s\n' '%1 repo' '%4 repo/track' > "$d/sess"; printf '%s\t%s\n' '%1' "$PRIMARY" '%4' "$PRIMARY" > "$d/live"
  mark_unavailable "$PRIMARY" 'Fable 5.1 requires usage credits'
  t '(p) the primary out with the floor already out: the seat is parked on the primary, the track goes to the rung under' \
    "$(typed repo):$(typed repo/track | cut -d'|' -f1):$(awk -F'\t' '$1=="%1"{print $5 ":" $6}' "$MOVED")" ":/model $lo:parked:$(fam "$PRIMARY")"
  printf '%s\t%s\n' '%1' "$PRIMARY" '%4' "$lo" > "$d/live"
  probe(){ [ "$(fam "${1:-}")" = "$(fam "$fl")" ]; }; : > "$d/handoffs"; rm -f "$ST/model-probed"; probe_unavailable others; unset -f probe
  t '(p) …only the floor answers: the seat parked off the primary still hands back, and its park ends' \
    "$(paste -sd'|' "$d/handoffs"):$(awk -F'\t' '$1=="%1"{print $5}' "$MOVED"):$(fam "$(current)")" "repo:kept:$(fam "$fl")"
  # a planning seat FOUND below the floor (launched on a low `current`, or the CLI moved it) is typed back up to it
  pl; printf '%s\t%s\n' '%1' "$lo" '%4' "$lo" > "$d/live"; reconcile
  t '(p) a planning seat found on the rung under the floor is typed up to it; a track there is left' "$(typed repo):$(typed repo/track)" "/model $fl:"
  # …and while the floor stays out the pass does not park it again: a parked seat is idle, its record keeps saying the
  # low model, and the owner heard about the park once (the gap only held the second line back for ten minutes)
  pl; rm -f "$OV"; note_unavailable "$(fam "$fl")" "You've hit your monthly spend limit"; note_unavailable "$(fam "$PRIMARY")" 'the cap'
  printf '%s\t%s\n' '%1' "$lo" > "$d/live"; reconcile
  awk -F'\t' 'BEGIN{OFS="\t"} NF{$2=$2-7200; print}' "$LOG" > "$LOG.t" && mv "$LOG.t" "$LOG"   # two hours later: the park row is outside CC_MODEL_RETUNE_GAP
  reconcile
  t '(p) …the floor still out and the seat still on the low rung: the owner is told once, not every retune gap' \
    "$(grep -c '^notify .*Planning parked' "$d/calls")" 1
  forget_unavailable "$(fam "$fl")"
  # the dialog offering the rung under the floor is not taken for a planning seat: Esc, and it stays parked
  t '(p) a limit dialog offering the rung under the floor: no offer is taken for planning' \
    "$(answer_key "$(printf ' ❯ 1. Switch to %s and continue\n   2. Stop and wait\n Enter to confirm · Esc to cancel\n' "$(label "$lo")")" "$(fam "$fl")" floor)" Escape

  # ── ONE RECONCILE, NO EVENT NEEDED (owner, 2026-09-21): after the account change five seats sat on the fallback with
  # no $MOVED row, so no lift ever returned them. Each case builds its own state and asserts the kept and the moved.
  pl; rm -f "$OV"; printf '%s\n' '%1 repo' '%4 repo/track' > "$d/sess"; printf '%s\t%s\n' '%1' "$FALLBACK" '%4' "$FALLBACK" > "$d/live"
  note_unavailable "$(fam "$PRIMARY")" 'Fable 5.1 requires usage credits'; reconcile
  t '(s) born on the fallback while the primary is out: nothing moves, it is where it belongs' "$(paste -sd'|' "$d/handoffs"):$(typed repo)" ":"
  rm -f "$UNAV"   # the record gone with no lift run (cleared, or a new login): no row, no event
  probe(){ return 0; }; tick; unset -f probe
  t '(s) …the primary answers: the next tick hands the seat back, a rowless track is left where it was put' \
    "$(paste -sd'|' "$d/handoffs"):$(typed repo/track)" "repo:"
  : > "$d/handoffs"; reconcile
  t '(s) …and the tick after does not hand it back twice' "$(paste -sd'|' "$d/handoffs")" ""
  pl; rm -f "$OV"; printf '%s\n' '%1 repo' > "$d/sess"; printf '%s\t%s\n' '%1' "$lo" > "$d/live"
  note_unavailable "$(fam "$PRIMARY")" 'the cap'; note_unavailable "$(fam "$fl")" "You've hit your monthly spend limit"; reconcile
  t '(s) a seat below its floor with the floor out: typed up to the floor and parked there, the owner told once' \
    "$(typed repo):$(awk -F'\t' '$1=="%1"{print $5}' "$MOVED"):$(grep -c '^notify .*Planning parked: repo ' "$d/calls")" "/model $fl:parked:1"
  pl; rm -f "$OV"; printf '%s\n' '%1 repo' > "$d/sess"; printf '%s\t%s\n' '%1' "$PRIMARY" > "$d/live"
  note_unavailable "$(fam "$PRIMARY")" 'the cap'; reconcile
  t '(s) DOWN with no event: a seat on a model on record as out is typed to the rung that runs, and banked to come back' \
    "$(typed repo):$(awk -F'\t' '$1=="%1"{print $5 ":" $6}' "$MOVED")" "/model $fl:moved:$(fam "$PRIMARY")"

  # ── ONLY LISTED WINDOWS BELONG ON THE PRIMARY (the owner names the seats that stay on the primary, 2026-09-22,
  # and asks for every other one on the floor model). With CC_MODEL_PRIMARY_WINDOWS set, a listed window's
  # band is the primary and every other planning or major window's is the floor. Each case builds its own state and
  # asserts both the window that is left alone and the one that is moved.
  pl; rm -f "$OV"; CC_MODEL_PRIMARY_WINDOWS='rep* desk'   # one glob that matches, one literal that matches nothing
  printf '%s\n' '%1 repo' '%2 other@orch' '%3 lessons/ece1' '%4 repo/track' > "$d/sess"
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$PRIMARY" '%3' "$fl" '%4' "$fl" > "$d/live"
  t '(w) a listed window wants the primary; an unlisted orch and an unlisted course seat want the floor; a track still has no band' \
    "$(want_of '%1' repo):$(want_of '%2' other@orch):$(want_of '%3' lessons/ece1):$(want_of '%4' repo/track || echo none)" \
    "$PRIMARY:$fl:$fl:none"
  reconcile
  t '(w) …reconcile leaves the listed one alone and types the unlisted one found on the primary DOWN to the floor' \
    "$(typed repo):$(typed other@orch):$(typed lessons/ece1):$(typed repo/track)" ":/model $fl::"
  t '(w) …and banks NO moved row for that policy move, so nothing owes it a way back up' \
    "$(cat "$MOVED" 2>/dev/null):$(paste -sd'|' "$d/handoffs")" ":"
  : > "$d/typed"; : > "$LOG"; : > "$d/cards"   # the retune gap cleared: the next tick is free to type, and does not
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$fl" '%3' "$fl" '%4' "$fl" > "$d/live"; reconcile
  t '(w) …a window on its own band is never returned, carded or retuned: the tick after types nothing and sends nothing' \
    "$(typed repo)$(typed other@orch):$(paste -sd'|' "$d/handoffs"):$(wc -l < "$d/cards")" "::0"
  # the outage path is untouched: a row says the box moved this window off the primary, and the lift still owes it back
  pl; rm -f "$OV"; CC_MODEL_PRIMARY_WINDOWS='repo'
  printf '%s\n' '%2 other@orch' > "$d/sess"; printf '%s\t%s\n' '%2' "$fl" > "$d/live"
  note_moved '%2' other@orch "$PRIMARY" moved "$(fam "$PRIMARY")"; reconcile
  t '(w) an unlisted window an outage moved off the primary still returns by handoff: its row is its band, not the policy' \
    "$(paste -sd'|' "$d/handoffs"):$(typed other@orch)" "other@orch:"
  # …and a ROWLESS window on the fallback at the lift goes to its band: an unlisted major one is home already
  pl; rm -f "$OV"; CC_MODEL_PRIMARY_WINDOWS='repo'; : > "$d/cards"
  printf '%s\n' '%1 repo' '%2 other@orch' > "$d/sess"; printf '%s\t%s\n' '%1' "$FALLBACK" '%2' "$FALLBACK" > "$d/live"
  note_moved '%9' gone "$PRIMARY" moved "$(fam "$PRIMARY")"   # another pane's row: the episode is open, so the lift runs
  do_switch "$PRIMARY" 'limit lifted (probe)'
  t '(w) at the lift an unlisted rowless major window on the fallback is neither handed off nor carded; a listed one still is' \
    "$(paste -sd'|' "$d/handoffs"):$(wc -l < "$d/cards"):$(typed other@orch)" "repo:0:"
  # …and with the floor out, an unlisted planning window still on the primary (a fresh seat comes up there) is not
  # parked: its band is out, but where it runs is above the floor, so no row, no owner line, nothing typed
  pl; rm -f "$OV"; CC_MODEL_PRIMARY_WINDOWS='repo'
  printf '%s\n' '%2 other@orch' > "$d/sess"; printf '%s\t%s\n' '%2' "$PRIMARY" > "$d/live"
  note_unavailable "$(fam "$fl")" "You've hit your monthly spend limit"; reconcile
  t '(w) the floor out: an unlisted window on the primary is left there, banked nothing, the owner told nothing' \
    "$(cat "$MOVED" 2>/dev/null):$(grep -c 'Planning parked' "$d/calls"):$(typed other@orch)" ":0:"
  export CC_MODEL_PRIMARY_WINDOWS=''
  # ── THE SHIPPED CHAIN, IN PROCESS (2026-09-23): Opus 5.5 the primary, Sonnet 5 under it, Opus the planning floor ──
  local fxp="$PRIMARY" fxf="$FALLBACK" fxc="$CHAIN"
  PRIMARY=$(shipped current); FALLBACK=$(shipped next "$PRIMARY"); CHAIN=$(shipped chain | paste -sd' ' -); PROBEM="$PRIMARY"
  t '(o) shipped: the fallback is Sonnet, but the planning floor is Opus 5.5 itself, [1m] kept, and it reads as Opus 5.5' \
    "$FALLBACK:$(floor_fam):$(floor_rung):$(label "$PRIMARY")" 'claude-sonnet-5[1m]:opus:claude-opus-5-5[1m]:Opus 5.5'
  rm -f "$UNAV"; note_unavailable fable 'Fable 5.1 requires usage credits'
  t '(o) shipped: a worker asking for Fable, off the chain and out, runs on the primary, not refused as fable[1m]' \
    "$(resolve 'fable[1m]'):$(resolve claude-fable-5-1)" "$PRIMARY:$(sed 's/\[1m\]$//' <<<"$PRIMARY")"
  forget_unavailable fable
  pl; rm -f "$OV"; printf '%s\n' '%1 repo' '%2 repo@orch' '%4 repo/track' > "$d/sess"
  printf '%s\t%s\n' '%1' 'claude-opus-5[1m]' '%2' "$PRIMARY" '%4' 'claude-opus-5[1m]' > "$d/live"; reconcile
  t '(w) a seat on the OLD Opus id under an Opus 5.5 band is typed to the band'"'"'s id; one on it already and a rowless track are left' \
    "$(typed repo):$(typed repo@orch):$(typed repo/track)" "/model $PRIMARY::"
  t '(w) …a policy move: no moved row, no handoff, no card' "$(cat "$MOVED" 2>/dev/null):$(paste -sd'|' "$d/handoffs"):$(wc -l < "$d/cards")" "::0"
  : > "$d/typed"; : > "$LOG"; printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$PRIMARY" '%4' 'claude-opus-5[1m]' > "$d/live"; reconcile
  t '(w) …and once it is there the next tick types nothing' "$(typed repo)$(typed repo@orch)$(typed repo/track)" ""
  pl; rm -f "$OV"; printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$PRIMARY" '%3' "$PRIMARY" '%4' "$PRIMARY" '%5' "$PRIMARY" > "$d/live"
  do_switch "$FALLBACK" 'opus limit'
  t '(o) Opus out: the track falls to Sonnet, the three planning seats park on Opus, a launch names Sonnet' \
    "$(typed repo):$(typed repo@orch):$(typed lessons/ece1):$(typed repo/track):$(awk -F'\t' '{print $1 ":" $5}' "$MOVED" | sort | paste -sd' ' -):$(current)" \
    ":::/model $FALLBACK:%1:parked %2:parked %3:parked %4:moved:$FALLBACK"
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$PRIMARY" '%3' "$PRIMARY" '%4' "$FALLBACK" > "$d/live"; : > "$d/typed"
  do_switch "$PRIMARY" 'limit lifted (probe)'
  t '(o) …Opus answers: every seat and the track hand back to Opus 5.5 by handoff, nothing typed' \
    "$(LC_ALL=C sort "$d/handoffs" | paste -sd'|' -):$(cat "$d/typed")" "lessons/ece1|repo|repo/track|repo@orch:"
  PRIMARY="$fxp"; FALLBACK="$fxf"; CHAIN="$fxc"; PROBEM="$PRIMARY"
  # A PROBE THAT ANSWERS WHILE A REAL RUN IS REFUSED IS NOT AVAILABILITY (model.log 2026-09-21 17:17-17:48Z)
  pl; rm -f "$OV" "$REFUSED"; local oldclaude="$CLAUDE"; CLAUDE="$d/bin/fakeclaude"; eval "$probe_src"
  printf '#!/bin/sh\ncat "%s/ok.json"\n' "$d" > "$CLAUDE"; chmod +x "$CLAUDE"
  printf '%s\t%s\n' "$(fam "$PRIMARY")" "$((now - 7200))" > "$REFUSED"; probe "$PRIMARY"
  t '(s) the probe answers and the last real refusal is two hours old: available' "$?" 0
  mark_unavailable "$PRIMARY" 'Fable 5.1 requires usage credits'; rm -f "$ST/model-probed"; probe_unavailable
  t '(s) …a real run refused just now: the same answer counts as unavailable, and the record stays' \
    "$(unavail "$(fam "$PRIMARY")" && echo rec):$(grep -c $'\trefusal\t.*a real run on it was refused' "$LOG")" "rec:1"
  CLAUDE="$oldclaude"; rm -f "$REFUSED"

  # ── A LINE IS READ ONCE (2026-09-21 17:17–17:48Z): the record forgotten, the same idle line is history ──────────
  pl; printf '%s\n' '%6 w/idle' > "$d/sess"; printf '%s\t%s\n' '%6' "$fl" > "$d/live"; rm -f "$OV"
  printf '%s\n' '● the first turn' "  ⎿  You've hit your monthly spend limit · raise it at claude.ai/settings/usage" '' '❯ ' > "$d/screen.%6"
  credits_panes; t '(q) a spend-cap line on a pane on the floor puts it out' "$(unavail "$(fam "$fl")" && echo rec)" rec
  forget_unavailable "$(fam "$fl")"; rm -f "$MOVED" "$OV"; : > "$d/typed"; credits_panes
  t '(q) the record forgotten (a probe answered), the same line on an idle pane is not a new refusal' "$(unavail "$(fam "$fl")" && echo rec):$(typed w/idle)" ":"
  printf '%s\n' '● a later turn' "  ⎿  You've hit your monthly spend limit · raise it at claude.ai/settings/usage" '' '❯ ' > "$d/screen.%6"; credits_panes
  t '(q) …a new turn refused is: the line is new' "$(unavail "$(fam "$fl")" && echo rec)" rec
  # …BUT A LINE THE PANE COULD NOT BE TYPED FOR IS NOT READ YET. cc-msg refuses a split window's inactive pane and only
  # spools behind a dialog, and model-skipped is retried under an override alone — so a record written before the typing
  # left that pane on the exhausted model for good. It waits for the move, and the next tick that can type finishes it.
  pl; printf '%s\n' '%6 w/busy' > "$d/sess"; printf '%s\t%s\n' '%6' "$fl" > "$d/live"; rm -f "$OV"
  printf '%s\n' '● a turn' "  ⎿  You've hit your monthly spend limit · raise it at claude.ai/settings/usage" '' '❯ ' > "$d/screen.%6"
  printf '#!/usr/bin/env bash\necho queued\n' > "$d/bin/cc-msg"; chmod +x "$d/bin/cc-msg"   # spooled, not typed
  credits_panes
  t '(q) the typist could not reach the pane: the model is on record, nothing was typed, and the line is not marked read' \
    "$(unavail "$(fam "$fl")" && echo rec):$(typed w/busy):$([ -s "$ST/model-credits-seen" ] && echo seen)" "rec::"
  printf '#!/usr/bin/env bash\nprintf "%%s\\t%%s\\n" "$1" "$2" >> "%s/typed"\n' "$d" > "$d/bin/cc-msg"; chmod +x "$d/bin/cc-msg"
  credits_panes
  t '(q) …the next tick, once typing works, moves that pane down a rung and nudges it — the same line, not skipped as seen' \
    "$(typed w/busy)" "/model $lo|$(label "$fl") refused this session for usage credits; it is on $(label "$lo") now — carry on with what you were doing."
  t '(q) …and nothing goes to the owner, re-read or not (comms review, 2026-09-22) — $LOG holds one row per model out' \
    "$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\t'"$(fam "$fl")"$'\t' "$LOG")" 01

  # ── AVAILABILITY IS PER LOGIN: a member workspace's refusal is its own record, never the box's ──────────────────
  pl; rm -f "$OV"; CRED=member; UNAV="$d/model-unavailable.member"; mark_unavailable "$lo" 'Sonnet 5 requires usage credits'
  t '(r) another login'"'"'s refusal: recorded under its name, nothing moved, the owner not told' \
    "$([ -s "$d/model-unavailable.member" ] && echo own):$([ -e "$d/model-unavailable" ] && echo box):$([ -e "$OV" ] && echo ov):$(wc -l < "$d/typed"):$(grep -c '^notify' "$d/calls")" "own:::0:0"
  CRED=""; UNAV="$d/model-unavailable"
  t '(r) …and the box'"'"'s own record does not have it: its chain is whole' "$(chain | grep -c .)" "$(chain_all | grep -c .)"
  rm -f "$d/model-unavailable.member"; unset CC_MODEL_PLANNING CC_MODEL_PRIMARY_WINDOWS; unset -f pl
  forget_unavailable "$(fam "$PRIMARY")"; rm -f "$MOVED" "$OV" "$UNAV" "$d/typed"; unset -f typed
  if [ -n "$oldsess" ]; then CC_MODEL_SESSIONS="$oldsess"; else unset CC_MODEL_SESSIONS; fi
  if [ -n "$oldlive" ]; then CC_MODEL_LIVE="$oldlive"; else unset CC_MODEL_LIVE; fi
  PROC=nonesuch; tmux(){ return 1; }

  # ── A DISAGREEMENT BETWEEN WHAT IS CONFIGURED AND WHAT IS RUNNING IS SAID, NEVER ACTED ON ────────────────────
  # retune_to above is same-family by design, so a session on ANOTHER family was invisible to everything here: on
  # 2026-09-07 about 31 windows were on the harness default and the box reported none of them. Each case below
  # builds its own record and asserts both the session that is reported and the one that must not be.
  rm -f "$OV" "$UNAV" "$CC_STATUSLINE_DIR"/*.json; : > "$LOG"   # the plain state: the box is on its primary
  slrec(){ printf '{"ts":"x","session_id":"%s","model":"%s","raw":{}}' "$1" "$2" > "$CC_STATUSLINE_DIR/$1.json"
           touch -d "@$((now - $3))" "$CC_STATUSLINE_DIR/$1.json"; }   # $1 id · $2 model · $3 age in seconds
  local slold; slold="${PRIMARY%%\[*}"; case "$slold" in *-1) slold="${slold%-1}";; *) slold="$slold-1";; esac
  slrec agrees "$PRIMARY" 10
  slrec at-200k "${PRIMARY%%\[*}" 10
  slrec old-id "$slold" 10
  slrec elsewhere "$(chain_next "$PRIMARY")" 10
  slrec quiet "$(chain_next "$PRIMARY")" 900
  t 'the sessions NOT on the model the box dispatches, and only those' \
    "$(mismatches | cut -f1 | sort | tr '\n' ' ')" "elsewhere old-id "
  t '...a record too old to be a live turn is not reported: nobody may be running it any more' \
    "$(mismatches | grep -c '^quiet')" 0
  t '...the [1m] suffix is a context knob, not a model (idname), so it is no disagreement' \
    "$(mismatches | grep -c '^at-200k')" 0
  t '...but the OLD ID of the primary'"'"'s own family is one, and it is the $140 kind' \
    "$(mismatches | grep -c "^old-id	$slold\$")" 1
  t 'status says how many, beside the model the box dispatches'  "$(status_line)" "$(fam "$PRIMARY") — 2 sessions on another model"
  report_mismatches
  t 'the log row names the model it is REALLY on, and the one it should have had' \
    "$(awk -F'\t' '$3=="mismatch" && $5 ~ /^elsewhere/{print $4, $5}' "$LOG")" "$(chain_next "$PRIMARY") elsewhere — this box dispatches $PRIMARY"
  report_mismatches
  t '...a disagreement that persists is not re-reported every tick' "$(grep -c $'\tmismatch\t' "$LOG")" 2
  t '...and it is REPORTED, not acted on: no switch, no override, nothing but the rows' \
    "$(awk -F'\t' '$3!="mismatch"' "$LOG" | wc -l)$([ -e "$OV" ] && echo ov)" 0
  slrec elsewhere "$PRIMARY" 10; slrec old-id "$PRIMARY" 10   # back on the primary by themselves, or the owner moved them
  t 'and when they agree again, status is quiet about it' "$(status_line)" "$(fam "$PRIMARY")"
  unset -f slrec
  rm -f "$CC_STATUSLINE_DIR"/*.json
  PRIMARY="$shp"; FALLBACK="$shf"; CHAIN="$shc"; PROBEM="$shpr"; unset -f shipped
  unset -f tmux; OV="$oldov"; LOG="$oldlog"; ST="$oldst"; BIN="$oldbin"; PROC="$oldproc"; UNAV="$oldunav"; MOVED="$oldmoved"; RETURNED="$oldreturned"; REFUSED="$oldrefused"
  if [ -n "$oldsl" ]; then CC_STATUSLINE_DIR="$oldsl"; else unset CC_STATUSLINE_DIR; fi
  rm -rf "$d"
  printf 'cc-model selfcheck: %s passed, %s failed\n' "$((n - bad))" "$bad"
  [ "$bad" = 0 ]; }
case "${1:-}" in
  status)  status_line ;;
  current) current ;;
  forced)  forced ;;
  switch)  do_switch "${2:?usage: cc-model switch <model> [reason]}" "${3:-}" ;;
  limited) [ "$(fam "${2:?usage: cc-model limited <model> [reason]}")" = "$(fam "$PRIMARY")" ] || exit 0
           rate_ok && do_switch "$FALLBACK" "${3:-$(fam "$2") limit}" ;;
  unavailable) mark_unavailable "${2:?usage: cc-model unavailable <model> [reason]}" "${3:-}" ;;
  out)     out_why "${2:?usage: cc-model out <model>}" || exit 1 ;;
  resolve) resolve "${2:?usage: cc-model resolve <model>}" ;;
  classify) shift; classify_run "${1:?usage: cc-model classify <json> [<err>] [<asked-model>]}" "${2:-}" "${3:-}" ;;
  chain)   chain ;;
  next)    chain_next "${2:-}" || exit 1 ;;
  tick)    [ -z "$CRED" ] || exit 0; tick ;;   # the timer's pass moves the box's own sessions: never on another login's record
  return)  return_cmd "${2:?usage: cc-model return <window>}" || exit 1 ;;
  selfcheck) selfcheck || exit 1 ;;
  *) sed -n '2,25p' "$0" >&2; exit 2 ;;
esac
exit 0
