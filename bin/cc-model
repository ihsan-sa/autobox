  t '(e) an Opus limit dialog offering Sonnet is taken too: Sonnet is the last rung only when Opus is out' \
    "$(answer_key "$(sed 's/Fable 5 limit/Opus 5 limit/; s/on Fable 5 uses/on Opus 5 uses/' <<<"$sdlg")")" Enter
  printf '%s\n' '%1 dlg-sonnet' '%2 dlg-opus' '%3 quiet' '%9 member-a' > "$d/sess"
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "$PRIMARY" '%3' "$PRIMARY" '%9' "$PRIMARY" > "$d/live"
  printf '%s\n' "$sdlg" > "$d/screen.%1"; printf '%s\n' "$dlg" > "$d/screen.%2"; printf '> \n' > "$d/screen.%3"; printf '%s\n' "$sdlg" > "$d/screen.%9"
  CC_MODEL_MEMBERS="$d/members"; tick
  t '(e) tick: the Sonnet offer gets Esc, the Opus offer gets Enter, the quiet pane gets no key' "$(keys %1):$(keys %2):$(keys %3)" "Escape:Enter:"
  t '(e) …after Esc the pane is retuned to Opus by the tick itself, and the resume line follows — the dialog ate that turn' \
