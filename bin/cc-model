  t '(e) …and the box moved to the fallback, taking the quiet Fable session with it' "$(typed quiet):$(ov && fam "$model")" "/model $exp:$(fam "$exp")"
  t '(e) …both dialog panes are banked MOVED off Fable, so the lift knows they belong on it (before: `kept` on Opus, never returned)' \
    "$(awk -F'\t' '{print $2"="$5"/"$6}' "$MOVED" | sort | paste -sd, -)" "dlg-opus=moved/fable,dlg-sonnet=moved/fable,quiet=moved/fable"
  t '(e) …the log has the answer, the retune and the nudge (the member'"'"'s answer among them)' "$(awk -F'\t' '$3=="answered"||$3=="retune"||$3=="nudged"{print $3}' "$LOG" | sort | uniq -c | awk '{print $2"="$1}' | paste -sd, -)" "answered=3,nudged=1,retune=2"
  t '(e) …and each answer names what the dialog offered' "$(awk -F'\t' '$3=="answered"{print $5}' "$LOG" | grep -oE 'offering [a-z]+ — [A-Za-z]+' | sort | paste -sd, -)" "offering opus — Enter,offering sonnet — Enter,offering sonnet — Escape"
  t '(e) a MEMBER window (review of #557): its Sonnet offer IS answered — Enter, the highlighted offer, it has no rung — but nothing is typed into it and it has no row' \
    "$(keys %9):$(typed member-a):$(grep -c member-a "$MOVED"):$(grep -c 'member-a: .*a member window' "$LOG")" "Enter::0:1"
  settings_guard   # a second pass inside the hour: nothing more is said
  t '(e) the two harness settings are absent: settings.json is NOT written (review of #557 — nothing automatic does), same bytes, same inode' \
    "$(cat "$d/settings.json"):$(stat -c %i "$d/settings.json")" "{\"theme\":\"dark\"}:$sino"
  t '(e) …each key is one `setting` row and one line to the owner naming the key and the value, once' \
    "$(grep -c $'\tsetting\t.*reported, never written' "$LOG"):$(grep -c '^notify .*Set "switchModelsOnFlag": true in .*settings.json — it is unset there' "$d/calls"):$(grep -c '^notify .*Set "autoContinueAtUsageLimit": false in .*settings.json — it is unset there' "$d/calls")" "2:1:1"
  printf '{"switchModelsOnFlag":false,"autoContinueAtUsageLimit":false}\n' > "$d/settings.json"; : > "$LOG"; : > "$d/calls"; settings_guard; settings_guard
  t '(e) …a value a person set is left and said once in the log; the owner is not nagged for a choice' \
