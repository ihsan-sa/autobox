    "#demo--t1 #demo #demo-site-ab12 #demo #box"
  unset CC_MODEL_MEMBERS CC_MODEL_RETURN_CHANNEL; unset -f handoffs cards; rm -f "$RETURNED" "$d/handoffs" "$d/cards" "$d/chans"
  # (c) what a relaunch and a loop iteration resolve to: cc passes `current`; cc-loop asks `resolve` every iteration
  rm -f "$OV" "$UNAV" "$MOVED"; : > "$d/typed"
  t '(c) on its primary, a caller asking for the primary runs it' "$(resolve "$PRIMARY")" "$PRIMARY"
  do_switch "$FALLBACK" 'a limit moved the box'
  t '(c) during a limit the same ask resolves to the next rung, [1m] riding along — what the next iteration runs' "$(resolve "$PRIMARY")" "$exp"
  t '(c) …and `out` says why' "$(out_why "$PRIMARY" | cut -d: -f1)" "$(fam "$PRIMARY") is limited"
  t '(c) a caller asking for the rung the box is ON is not out' "$(out_why "$exp" >/dev/null; echo $?):$(resolve "$exp")" "1:$exp"
  do_switch "$PRIMARY" 'lifted'
  t '(c) after the lift the ask resolves to the primary again: the loop is back on Fable next iteration, unpinned' "$(resolve "$PRIMARY")" "$PRIMARY"
  note_unavailable "$(fam "$PRIMARY")" 'Fable 5.1 requires usage credits'
  t '(c) a Fable-only outage resolves the same way, override or none' "$(resolve "$PRIMARY"):$(out_why "$PRIMARY")" "$exp:$(fam "$PRIMARY") is not available to this account: Fable 5.1 requires usage credits (last checked $(untilw "$now"))"
  t '(c) a model with no family is handed back as asked' "$(resolve nonesuch)" nonesuch
  # (b) the record alone — the override cleared by hand — with a session the box had moved: the primary answering
  #     (a probe, or the owner's switch) still puts it back
  rm -f "$OV"; : > "$d/typed"; printf '%%1\tseat\t%s\t%s\tmoved\n' "$PRIMARY" "$now" > "$MOVED"
  printf '%s\n' '%1 seat' > "$d/sess"; printf '%s\t%s\n' '%1' "$exp" > "$d/live"; printf '> \n' > "$d/screen.%1"
  : > "$d/handoffs"; CC_MODEL_MEMBERS="$d/members"; do_switch "$PRIMARY" 'answered as itself again (probe)'; unset CC_MODEL_MEMBERS
  t '(b) with no override but a moved session on record, the primary answering still returns it and forgets the record' \
    "$(cat "$d/handoffs"):$(unavail "$(fam "$PRIMARY")" && echo rec):$([ -e "$MOVED" ] && echo rows)" "seat::"
  rm -f "$d/handoffs" "$RETURNED"
  # (d) EVERY MODEL ON RECORD IS PROBED BACK, NOT ONLY THE PRIMARY'S (fifth review of #503). The cap lands on the
  #     model a run ASKED for, and the commonest dispatch asks for the fallback: the row cc-limit writes with
  #     `cc-model unavailable claude-opus-5` had nothing that could ever clear it — tick probed the primary alone —
  #     so every worker stayed a rung down after the owner raised the cap, until someone edited the file by hand.
  rm -f "$OV" "$MOVED" "$UNAV" "$ST/model-probed"; : > "$LOG"; : > "$d/typed"; : > "$d/calls"
  local asked=""   # the ids the probe was asked for, in order; this one answers as opus and nothing else
  probe(){ asked="${asked:+$asked }${1:-}"; [ "$(fam "${1:-}")" = "$(fam "$c2")" ]; }
  note_unavailable "$(fam "$c2")" "You've hit your monthly spend limit"
  t '(d) a model that is not the primary recorded out by the cap: the ask is walked past it' "$(resolve "$c2")" "$c3"
  probe_unavailable
  local pc2; pc2="$c2"; [ "$(fam "$c2")" = "$(fam "$FALLBACK")" ] && pc2="$FALLBACK"   # the fallback: the id its sessions run
  t '(d) …it is probed on ITS own rung, not the primary'"'"'s, by the id its sessions run' "$asked" "$pc2"
  t '(d) …and its answer forgets the row: the ask resolves to it again, with no override to clear and no switch' \
    "$(unavail "$(fam "$c2")" && echo rec)$(resolve "$c2"):$(grep -c $'\tswitch\t' "$LOG")" "$c2:0"
