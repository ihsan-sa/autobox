  sdlg=$(sed 's/Switch to Opus 5 (1M context) and continue    /Switch to Sonnet 5 and continue               /' <<<"$dlg")   # the dialog the owner sees "often": Sonnet offered
  t '(e) fixture: the dialog offers Sonnet 5' "$(offered_fam "$sdlg"):$(offered_fam "$dlg")" "sonnet:opus"
  t '(e) a Fable dialog offering Sonnet is NOT taken: Esc — the next rung is Opus' "$(answer_key "$sdlg")" Escape
  t '(e) …the same dialog offering Opus is: Enter' "$(answer_key "$dlg")" Enter
