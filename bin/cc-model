  mkdir -p "$d/confirm-answers"; printf 'yes\tThe Owner\n' > "$d/confirm-answers/bcdef"; printf 'no\tThe Owner\n' > "$d/confirm-answers/cdefg"
  confirm_panes
  t '(f) HIS YES presses Yes into the dialog it was asked for, once' "$(keys %22):$([ -e "$d/confirm-answers/bcdef" ] && echo left)" "1|Enter:"
  t '(f) HIS NO presses No, and the seat is told not to try another route to the same change' \
    "$(keys %23):$(typed seat-no | grep -c 'did not approve this from Slack: Bash: rm -r build. Do not try another route to the same change')" "2|Enter:1"
  t '(f) …and the dialogs gone, the rows go with them: nothing left to press on a later tick' \
    "$(printf '> \n' > "$d/screen.%22"; printf '> \n' > "$d/screen.%23"; confirm_panes; cat "$d/model-confirms" 2>/dev/null)" ""
  # SEVERAL CALLS IN ONE MESSAGE (the review of #586): the CLI runs them in order, so the dialog is the FIRST one's, and
  # a Yes on it releases the rest — both fixtures show the first call on the pane, as the dialog does.
  # THE SHAPE THE CLI WRITES: one record per content block, all of them under the one .message.id (the review of #586 —
  # a record-by-record "last message" saw the `ls` alone and pressed Yes on the rm in front of it). tcallp keeps the
  # other shape, both blocks packed into one record, so the fallback to the record still holds.
  tcall2(){ { jq -cn --arg a "$2" '{type:"assistant",message:{id:"msg_1",content:[{type:"tool_use",id:"t1",name:"Bash",input:{command:$a}}]}}'
              jq -cn --arg b "$3" '{type:"assistant",message:{id:"msg_1",content:[{type:"tool_use",id:"t2",name:"Bash",input:{command:$b}}]}}'; } > "$d/tr/$1.jsonl"; }
  tcallp(){ jq -cn --arg a "$2" --arg b "$3" '{type:"assistant",message:{content:[{type:"tool_use",id:"t1",name:"Bash",input:{command:$a}},{type:"tool_use",id:"t2",name:"Bash",input:{command:$b}}]}}' > "$d/tr/$1.jsonl"; }
  rm -f "$d/model-confirms"; : > "$d/slack"; : > "$d/keys"; : > "$LOG"
  printf '%s\n' '%24 seat-two-w' '%25 seat-two-r' > "$d/sess"
  tcall2 %24 'rm -rf build' 'ls';       cdlg 'rm -rf build' > "$d/screen.%24"
  tcall2 %25 'ls -l /tmp' 'cat /tmp/f'; cdlg 'ls -l /tmp' > "$d/screen.%25"
  tcallp %26 'rm -rf build' 'ls'
  t '(f) two unresolved calls: pending_call is the FIRST of them, not the last, and pending_calls has both in order' \
    "$(pending_call %24):$(pending_calls %25 | paste -sd'|' -)" \
    "Bash"$'\t'"rm -rf build:Bash"$'\t'"ls -l /tmp|Bash"$'\t'"cat /tmp/f"
  t '(f) …one record per block under one message id, and both blocks in one record, read the same: both calls, in order' \
    "$(pending_calls %24 | paste -sd'|' -):$(pending_calls %26 | paste -sd'|' -)" \
    "Bash"$'\t'"rm -rf build|Bash"$'\t'"ls:Bash"$'\t'"rm -rf build|Bash"$'\t'"ls"
  confirm_panes
  t '(f) …a WRITING first call is never answered Yes off the read-only one behind it: nothing pressed, one card naming both' \
    "$(keys %24):$(grep -c '' "$d/slack"):$(sed -n 1p "$d/slack")" ":1:grant confirm Bash: rm -rf build · Bash: ls -w seat-two-w"
  t '(f) …TWO READ-ONLY calls in one message: the box answers Yes itself, and the log names both' \
