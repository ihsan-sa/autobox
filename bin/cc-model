#!/usr/bin/env bash
# cc-model — automatic model fallback. When a model goes out — its usage limit, or it "requires usage credits" /
# the monthly spend cap — every live session ON THAT MODEL moves to the next rung of the chain, and back to the
# model it was on when the outage lifts: a session that belongs on the primary comes back by an overlapping HANDOFF —
# launched unasked for a major session, on the owner's 👍 on one card for any other (see THE FABLE BAND COMES BACK BY
# HANDOFF below) — and a session moved between the lower rungs gets `/model` typed at its next turn boundary. EVERY
# TICK, WITH NO EVENT, `reconcile` compares each live session with the model it belongs on (want_of: a planning or
# major window's band is the primary — or, with CC_MODEL_PRIMARY_WINDOWS set, only a LISTED one's is and every other
# planning or major window's is the floor; a moved one's is what it was on; a rowless minor one is not touched) and makes
# the same move up or down, so a session born on the fallback with no record comes back too. LLM-free except the
# probe, which runs the id sessions run ([1m] and all) and is not believed while real runs on it are refused. A PLANNING SESSION (a repo's seat, an orch, a window
# on CC_MODEL_PLANNING) never goes below the floor, Opus — the primary itself since 2026-09-23, so with Opus out it is
# parked, never on Sonnet, and comes back by handoff.
# TWO KINDS OF OUTAGE, told apart (owner, 2026-09-15): a LIMIT names a reset and every model of the account can be
# behind it — the box waits it out on the next rung; "requires usage credits" and "You've hit your monthly spend
# limit" are one model this account cannot run right now, no reset lifts them (credits, the cap, or a re-login do),
# the other models answer, and cc-limit's stamp stays empty — so only work BOUND to that model moves.
#   cc-model status                   "opus" (normal) | "sonnet until 11:40Z" | "sonnet until probe". An until that
#                                     is not today is dated ("opus until 2026-09-03T12:51Z"): the clock alone made
#                                     a 24-hour override read as one that lapsed hours ago. A trailing "— 2 sessions
#                                     on another model" counts the live sessions NOT on the model `current` names,
#                                     read the same way tick (4) reads them.
#   cc-model current                  the model to dispatch on, ALWAYS: the override, else the next rung when the
#                                     primary is one this account cannot run, else the primary itself — cc and cc-rc
#                                     pass it as --model, so a session starts on the model the box names instead of
#                                     inheriting the harness default. Until 2026-09-07 it answered only while the box
#                                     was OFF its primary, so in the normal state nothing named a model and every
#                                     session silently inherited that default (31 live windows had).
#   cc-model forced                   only the model the box was MOVED to — the override, else the next rung when the
#                                     primary is not this account's to run — and nothing while it is on its primary.
#                                     This is what `current` used to answer. cc-loop asks THIS one: a worker given no
#                                     --model must land on CC_WORKER_MODEL, not on the interactive primary.
#   cc-model switch <model> [reason]  write (or, for the primary model, clear) the override + retune live sessions
#   cc-model limited <model> [reason] cc-limit calls this after a limited run: switch only if that WAS the primary
#   cc-model unavailable <model> [reason]  cc-limit calls this on a run refused for usage credits or the spend cap:
#                                     that model cannot be run on this account, so it is recorded as such and the
#                                     box moves off it; the owner is told once per episode, and what lifts it
#   cc-model out <model>              exit 0 + why when <model>'s family is out right now — recorded unavailable, or
#                                     the override has moved the box off the primary and <model> is the primary's
#   cc-model resolve <model>          the model to run NOW for a caller that asked for <model>: itself, or the next
#                                     rung while it is out. cc-loop asks this every iteration, so a worker dispatched
#                                     on Fable runs on Opus through the outage and is back on Fable the iteration
#                                     after it lifts — until 2026-09-15 a refusal pinned the loop to Opus for good
#   cc-model classify <json> [<err>] [<asked>]  what stopped a headless run, as "<class>\t<why>": ok | limit |
#                                     refusal | error — the caller's reason to WAIT, to MOVE, or to retry
#   cc-model chain                    the worker fallback chain, one model per line
#   cc-model next [<model>]           the model after <model> on that chain (nothing, exit 1, at its end)
#   cc-model return <target>          the owner's 👍 on a return card (cc-slack runs it): `cc-handoff --overlap` for that
#                                     window, unless it is on the primary already or has an overlap open
#   cc-model tick                     what cc-model.timer runs every 60 s (see below)
#   cc-model selfcheck                the classifier and the chain, on fixtures
# tick: (1) normal — switch when cc-limit's stamp says the primary model is limited AND a second run has hit that
#   same limit (one run's limit is not the box's — see cc-limit; a session cc-limit recorded as INDEPENDENTLY
#   interrupted — `indep`, its limit line first seen inside this episode — counts as that second run, and a stamp
#   naming no model is read as the primary's — see stamp_says_switch), or
#   when a live session's pane shows a fresh "usage limit" line (each matched line fires once, and a probe has to agree — docs and questions
#   mention limits too); (1b) THE CLI'S OWN LIMIT PROMPT NEEDS NO PROBE: "You've reached your Fable 5 limit … ❯ Switch
#   to Opus 5 (1M context) and continue" (a dialog) or "● Fable 5 limit reached · continuing on Fable 5 uses usage
#   credits …" (its notice) IS a limit of the model it names — the dialog is answered, the box moves to the fallback
#   until the reset the text names, else 24 h, and NOTHING PROBES while that wording is on any session pane: a probe
#   that answers there is paying with usage credits, not proof the limit lifted (2026-09-01: one such "lifted" retuned
#   12 panes straight back into the prompt, and a pulse tick and two secretary findings were dropped on it).
#   THE ANSWER IS THE NEXT RUNG, NEVER A LOWER ONE (owner, 2026-09-20: "gracefully goes to opus when fable is gone
#   (often the dialog suggest sonnet 5 after fable dies)"): Enter only when the highlighted line is "Switch to <the
#   rung after the model the dialog names> … and continue" — Opus for a Fable limit, Sonnet only when Opus is on record
#   as out too. Any other offer, or another line highlighted, is Esc, and then THIS pass retunes that pane itself
#   (`/model <next rung>`, banked as moved off the family the dialog named) and types the resume line — the dialog ate
#   that turn, and a session left at an empty prompt after Esc has paused. A pane whose Enter took the switch is banked
#   `moved` too: the CLI put it on the fallback, and the lift has to know it belongs on the primary (until 2026-09-20
#   move_off found it on Opus and banked it `kept`, so it never came back);
#   (1d) THE SAFEGUARDS DIALOG: "Model switch — <M>'s safeguards flagged this message … Switch to <F> and keep going
#   whenever this happens?" with "Switch automatically" / "Stay on <M>" (the CLI's refusal_fallback_preference_prompt,
#   drawn only while `switchModelsOnFlag` is unset in ~/.claude/settings.json). Answered "Switch automatically" (the
#   owner's YES, 2026-09-20, after a headless course seat sat on it for 10+ min on 09-19): the CLI moves the session to
#   its own fallback and never asks again. The line it leaves after such a switch — "<M>'s safeguards flagged this
#   message … Switched to <F>." — is read like (1c): a pane the CLI put BELOW the next rung (Sonnet, with Opus
#   runnable) is retuned up to it, nothing is recorded unavailable; one on the next rung is left there and reported by
#   (4) — the flagged content stays in its transcript and the primary would flag it again every turn;
#   (1e) THE AUTO-MODE CONFIRM DIALOG ("Auto mode classifier requires confirmation for this command … Do you want to
#   proceed? 1. Yes 2. No"), in every state: the call behind it is read from the seat's transcript; a read-only one is
#   answered Yes, any other is put to the owner as a 🔐 card (`cc-slack grant confirm`) and his yes/no pressed on a later
#   tick, with a No followed by a line telling the seat not to try another route. Never a member window. See confirm_panes;
#   (0) THE TWO SETTINGS THAT DECIDE WHETHER THE HARNESS PAUSES: every tick reads ~/.claude/settings.json
#   (CC_CLAUDE_SETTINGS) for `switchModelsOnFlag: true` and `autoContinueAtUsageLimit: false` — the first is what
#   stops the safeguards dialog, the second stops the CLI waiting a limit out in silence ("wait for the limit to reset
#   and continue", a pause with no dialog for anything to answer; off, the limit dialog offers the wait as a choice,
#   and (1b) answers it). IT NEVER WRITES THAT FILE (the review of #557): it holds `permissions` and the hook
#   commands, and only `cc-settings apply` at the owner's terminal may replace it. A key absent is one `setting` row
#   and one line to the owner naming the key and value, once an hour (CC_MODEL_MISMATCH_GAP); one a person set another
#   way is the row alone, never a nag; (1b)
#   and (1d) answer both dialogs within a tick meanwhile, and a fresh install has both keys from
#   config/claude-settings.json. Member HOMEs are not read — a member session runs CC_MEMBER_MODEL;
#   (1c) THE CLI'S OWN
#   "REQUIRES USAGE CREDITS" LINE, in every state: "│ Fable 5.1 requires usage credits. Switch to another model…",
#   "● Switched to Sonnet 5 for this session · Fable 5.1 requires usage credits" or "⎿ You've hit your monthly spend
#   limit" on a live pane IS that model being out for THAT session — no probe, no stamp: the model is recorded
#   unavailable, every session on it is moved to the next rung, and the pane that showed it is nudged back to work.
#   Two orchs stood at an empty prompt on exactly this line for hours on 2026-09-15 00:5xZ while the box, already on
#   the Opus override, read them as a `mismatch` (report only) and cc-limit read the account as clear.
#   A MEMBER WINDOW IS NEVER ON THE CHAIN: one whose window name is a workspace under ~/.cc/members runs
#   CC_MEMBER_MODEL (the brief, 2026-09-20), so no pass moves, retunes, banks or returns it — until 2026-09-20 one on
#   the fallback drew a return card at every lift. Its DIALOGS are still answered here, within a tick (the review of
#   #557: nothing else answers them, and a session sitting on one delivers nothing): the safeguards dialog as (1d),
#   the limit dialog by taking whatever "Switch to … and continue" the CLI highlights — the next-rung rule is the
#   chain's, and a member session has no rung; nothing is typed into it afterwards, and no row is written;
#   (2) overridden — once `until`
#   has passed, probe the primary model at most every 15 min and restore on the first answer — unless a pane still
#   shows the prompt or cc-limit's stamp still names the primary: then it cannot tell, and does not restore;
#   (2b) NO OVERRIDE, SO THE BOX WANTS ITS PRIMARY: a session the CLI last put on ANOTHER ID OF THAT SAME FAMILY —
#   `claude-fable-5` while the box is on `claude-fable-5-1`, whose cache reads bill at 4x — is retuned to the primary.
#   Same family only (another family is the chain's, an override's or the owner's), read from the CLI's own "Set model
#   to …" line and never from the pane at large, and at most once per pane per CC_MODEL_RETUNE_GAP;
#   (3) never two switches within 10 min — and the override's `since` counts as a switch, not only the log line: that
#   line is written after the retune, and on 2026-09-01 a restore slipped into the gap and undid the switch mid-typing;
#   (4) IN EVERY STATE, SAID OUT LOUD AND NEVER ACTED ON: a live session running a model `current` does not name —
#   another family, or the old id of the primary's — gets one `mismatch` row in the log (at most one per session per
#   CC_MODEL_MISMATCH_GAP) and is counted in `status`. The passes that MOVE a session are a switch (the sessions on
#   the model that went out, see Moved below), (1c), same-family (2b) and reconcile (see its comment); before (4) every session on another family
#   was invisible: 31 windows sat on the harness default on 2026-09-07 and nothing anywhere said so. This one types
#   nothing — a session on another family is an override's, the chain's or the owner's doing, and reporting it is
#   the whole job; (5) NO OVERRIDE BUT A MODEL IS RECORDED UNAVAILABLE (cleared by hand, or a fresh boot with the
#   record): EVERY recorded family is probed, each on its own rung, at most every 15 min. The first answer as the
#   primary forgets its record and restores the sessions the box moved — without this the record alone parked them
#   for good; an answer as any other family just drops that row, so a dispatch aims at it again. Only the primary
#   was probed until 2026-09-18, and a cap the owner then raised left every worker a rung down for good.
# Retuning a session = typing "/model <model>" into its pane THROUGH cc-msg (the one pane deliverer, with the dialog
#   guard); the answers to the CLI's own prompts (Enter/Esc, "1" to "Switch model?") are single keys. Effort is not touched.
# THE WORKER FALLBACK CHAIN LIVES HERE AND NOWHERE ELSE: opus 5.5 -> sonnet (owner, 2026-09-23; Fable, the primary
# until then, is no rung: above the primary, reconcile would type a Fable seat down and bank it). cc-loop asks `cc-model next`
# instead of carrying a second copy of the order, so one edit here moves every caller (CC_MODEL_CHAIN overrides).
# A REFUSAL OR A REROUTE IS NOT AN ERROR AND NOT A LIMIT. The classifier can stop a turn outright, and a model that
# is withdrawn, suspended or not ours to call answers as a different one (the Fable suspension ran 19 days). Both
# read as "the run failed" today, so the caller retries the same model and spends for a result that cannot change.
# `classify` names both `refusal`, and the caller MOVES ALONG THE CHAIN. A limit still wins over everything — it is
# a wait, not a move. IT ALL COMES FROM JSON FIELDS: see the doctrine above classify_run. Wording is read only from
# `.result`, and only on a run the API itself ended, because a worker writing "I can't help with that" — or
# "refused", or "usage limit" — in its own result is talking about its task, not about being refused.
# Override: ~/.cc/state/model-override = "<model>\t<since>\t<until-epoch|0>\t<reason>\t<last-probe-epoch>"
# Moved: ~/.cc/state/model-moved = "<pane-id>\t<window>\t<model it was on>\t<epoch>\t<moved|kept>\t<families moved
#   off>" — one row per live pane at the moment the box moved off a model, and the MODEL is first write wins: `moved`
#   for a pane typed at, `kept` for one left where it was. One episode can hold more than one move (Fable out, then
#   Opus on the rung it landed on), so the last field collects the families this pane has been typed off and every
#   "have we moved it already" guard names the one it is asking about — asked of the row alone, the second outage's
#   panes were skipped as already moved and left at an empty prompt (third review of #503). So a lift returns each
#   session to what IT was on (a Sonnet steward is not sent to Fable, a session
#   the owner had put on Opus stays there), and a pane with no row was launched during the outage on the fallback and
#   goes to the primary. A pane with no record and no --model (a hand launch, the selftest's bare cat) is taken to be
#   on the model the pass is asking about — the one going out, or the one the box was moved to — never `current` read
#   after the override is written. The file goes when the box restores, and a move that starts from a clean box (no
#   override, nothing on record) starts from none: rows an episode left when its state was cleared by hand would
#   otherwise hold the next one's panes back. Until 2026-09-15 a switch typed into EVERY pane and the
#   restore typed the primary into every pane, and nothing remembered what a pane had been on.
# Returned: ~/.cc/state/model-returned = "<window>\t<epoch>\t<handoff|card>\t<detail>" — the return the lift launched or
#   asked for, one row per window; a row younger than CC_MODEL_RETURN_GAP suppresses a second, and move_off drops it
#   when a new outage types that window off the primary again.
# Log: ~/.cc/state/model.log = "<iso>\t<epoch>\t<event>\t<model>\t<detail>". No secrets in either.
# Unavailable: ~/.cc/state/model-unavailable = "<family>\t<since>\t<last-seen>\t<reason>" — a model this account cannot
#   run (usage credits, not a limit — see A MODEL THIS ACCOUNT CANNOT RUN below); a row goes the moment the box is put
#   back on that model, by a probe that answered as it or by `switch`. Every row is re-probed on its own each
#   CC_MODEL_PROBE_EVERY, the middle rung too, and `out` says when it was last checked. PER LOGIN: a member workspace
#   (CC_MEMBER_SANDBOX=1) or CC_MODEL_CRED=<name> writes model-unavailable.<name>, which never moves the box's
#   sessions or tells the owner; `tick` does nothing under another login.
# Credits seen: ~/.cc/state/model-credits-seen = "<pane>\t<key>\t<epoch>" — the refusal line each pane was last acted
#   on for, so an idle pane's old line is not read as a new refusal once the record is forgotten.
# Refused: ~/.cc/state/model-refused = "<family>\t<epoch>" — the last REAL run refused on it (mark_unavailable: a pane's
#   line, cc-limit), never the probe's own. A probe that answers inside CC_MODEL_REFUSED_HOLD of it counts as refused
#   (2026-09-21 17:17Z: the probe answered, the sessions moved back up were refused within a minute). Per login as above.
# Env: CC_MODEL_PRIMARY · CC_MODEL_FALLBACK · CC_MODEL_PROBE (the id the primary's probe asks for; the primary) · CC_MODEL_REFUSED_HOLD (3600) · CC_CLAUDE
#   · CC_MODEL_PROBE_EVERY (900) · CC_MODEL_MIN_GAP (600) · CC_MODEL_RETUNE_GAP (600) · CC_MODEL_CHAIN
#   · CC_MODEL_MISMATCH_GAP (3600) · CC_CLAUDE_SETTINGS (~/.claude/settings.json) · CC_MODEL_STATUSLINE_FRESH (120) · CC_STATUSLINE_DIR (cc-statusline's per-session
#   records, the same ones cc-context reads) · CC_MODEL_MAJOR (~/.cc/config: the windows handed back unasked, space- or
#   comma-separated; unset = the default rule) · CC_MODEL_PRIMARY_WINDOWS (~/.cc/config: the windows whose band is the
#   primary, windows or globs, space- or comma-separated; set, every OTHER planning or major window's band is the floor
#   rung and a move down to it banks no moved row; unset, every planning and major window is the primary's — see ONLY
#   LISTED WINDOWS BELONG ON THE PRIMARY) · CC_MODEL_RETURN_GAP (7200) · CC_MODEL_RETURN_CHANNEL (the card's
#   channel when the session's repo has none: `#<box>`) · CC_MODEL_PLANNING (~/.cc/config: windows or globs such as
#   `lessons/*` that are planning on top of the default rule) · CC_MODEL_FLOOR (the lowest a planning session runs;
#   default Opus while it is on the chain, else the fallback) · CC_MODEL_CRED (whose login, see Unavailable) · test hooks: CC_TMUX_SESSION, CC_MODEL_PROC, CC_MODEL_SESSIONS
#   (a file of "<pane-id> <window>" standing in for the live session list), CC_MODEL_LIVE (a file of
#   "<pane-id>\t<model>" standing in for what each pane's session is running), CC_MODEL_MEMBERS (~/.cc/members),
#   CC_MODEL_TRANSCRIPTS (a dir of "<pane-id>.jsonl" standing in for each pane's transcript).
set -uo pipefail
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
ST="$HOME/.cc/state"; OV="$ST/model-override"; LOG="$ST/model.log"; SEEN="$ST/model-seen"
CRED="${CC_MODEL_CRED:-$([ "${CC_MEMBER_SANDBOX:-}" = 1 ] && echo member)}"   # whose login: empty = the box's own (see A MODEL THIS ACCOUNT CANNOT RUN)
CRED=$(tr -cd 'A-Za-z0-9_-' <<<"$CRED"); UNAV="$ST/model-unavailable${CRED:+.$CRED}"; REFUSED="$ST/model-refused${CRED:+.$CRED}"
MOVED="$ST/model-moved"   # what each pane was on before the box moved it (see the header)
RETURNED="$ST/model-returned"   # the return each window was given at the lift: a handoff launched, or a card posted
PRIMARY="${CC_MODEL_PRIMARY:-claude-opus-5-5[1m]}"; FALLBACK="${CC_MODEL_FALLBACK:-claude-sonnet-5[1m]}"   # Opus 5.5 (owner, 2026-09-23; Fable 5.1 before)
PROBEM="${CC_MODEL_PROBE:-$PRIMARY}"; CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"
SESSION="${CC_TMUX_SESSION:-main}"; PROC="${CC_MODEL_PROC:-claude}"
now=$(date -u +%s); mkdir -p "$ST"
fam(){ local f; f=$(grep -oiE 'fable|opus|sonnet|haiku' <<<"${1:-}" | head -1 | tr 'A-Z' 'a-z'); echo "${f:-${1:-}}"; }
idname(){   # a model id → the name the CLI prints for it: claude-fable-5-1 → "Fable 5.1", claude-opus-5 → "Opus 5".
            # fam() answers a DIFFERENT question — which rung of the chain a model is — and `claude-fable-5` and
            # `claude-fable-5-1` are one rung, one family, and two very different bills: cc-spend prices the old id's
            # cache reads at 4x, and the box spent about $140 on it on 2026-09-02 because a session parked there
            # looked, to every family test in this file, exactly like a session on the primary. The [1m] suffix is a
            # context knob, not a model, and the CLI spells it out as "(1M context)" anyway.
  local f v; f=$(fam "${1:-}"); v=$(sed -e 's/\[.*$//' -e "s/^claude-$f-*//" <<<"${1:-}" | tr '-' '.')
  { [ -n "$f" ] && [ -n "$v" ] && [ "$v" != "${1:-}" ]; } || return 1
  printf '%s %s\n' "$(tr 'a-z' 'A-Z' <<<"${f:0:1}")${f:1}" "$v"; }
pane_model(){   # $1 = a pane's live screen → the model the CLI ITSELF last said that session is on, or nothing. Off a
                # live pane on this box (2026-09-02):  ❯ /model claude-fable-5[1m]
                #                                        ⎿  Set model to Fable 5 and saved as your default for new sessions
                # THE CLI'S OWN ANSWER, never the pane at large: a session with this file open in a pager, or a doc
                # that names an id, has that id on its screen and is not running it — the trap the classifier below
                # was rebuilt around (#155). A session whose answer line has scrolled off says nothing, and nothing
                # is typed into it: a miss is cheap here, a stray /model into somebody's session is not.
  grep -oE 'Set model to [A-Za-z]+ [0-9][0-9.]*' <<<"${1:-}" | tail -1 | sed 's/^Set model to //'; }
retune_to(){    # $1 = a pane's live screen → the model to type into it, or nothing (exit 1) when it is where the box
                # wants it. SAME FAMILY only: another family is the chain's business — an override, a limit, or the
                # owner's own choice — and this pass must not undo one.
  local said want; said=$(pane_model "${1:-}"); [ -n "$said" ] || return 1
  want=$(idname "$PRIMARY") || return 1
  [ "$said" = "$want" ] && return 1
  [ "$(fam "$said")" = "$(fam "$PRIMARY")" ] || return 1
  printf '%s\n' "$PRIMARY"; }
retuned_recently(){   # $1 = pane id → 0 when this pane was retuned inside the last CC_MODEL_RETUNE_GAP (600 s). A pane
                      # takes a moment to apply /model, and a pass that retyped on every tick would be typing into
                      # somebody's session every minute.
  local id="${1:-}" t
  t=$(awk -F'\t' -v i="($id)" '($3=="retune" || $3=="park") && index($5, i){t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)
  [ "$((now - t))" -lt "${CC_MODEL_RETUNE_GAP:-600}" ]; }
sldir(){ printf '%s\n' "${CC_STATUSLINE_DIR:-$ST/statusline}"; }   # cc-statusline's per-session records — cc-context's env name
mismatches(){   # every LIVE session running a model `current` does not name: "<session-id>\t<the model it is on>".
                # REPORT ONLY. Nothing here types into a pane: a switch moves the sessions on the model that went out,
                # retune_to is same-family, so "what is configured" and "what is running" could disagree in silence — 31
                # windows on the harness default on 2026-09-07, and the box said nothing until the owner asked.
                # EVIDENCE IS cc-statusline's OWN RECORD, which is the harness's word for what that session is running.
                # A pane's text is not: a doc, or this file in a pager, has a model id on its screen and is not running it.
                # FRESH ONLY. The record is rewritten every turn, so one no older than CC_MODEL_STATUSLINE_FRESH
                # (120 s — cc-context's STATUSLINE_MAX_AGE, and two ticks, so no turn falls between passes) belongs to a
                # session that answered just now. An older one has gone quiet or gone away, and reporting a model nobody
                # is running is worse than saying nothing. A headless worker is never here: `claude -p` draws no status
                # line and writes no record, and it is meant to be on CC_WORKER_MODEL, not on what the sessions run.
  local want sid m cut ts f
  want=$(current); [ -n "$want" ] || return 0   # nothing is named, so nothing can disagree with it
  want="${want%%\[*}"; cut=$((now - ${CC_MODEL_STATUSLINE_FRESH:-120}))
  while read -r ts f; do   # one stat for the whole directory: nothing prunes it, and most of it is months of stale ids
    { [[ "${ts:-}" =~ ^[0-9]+$ ]] && [ "$ts" -ge "$cut" ]; } || continue
    m=$(jq -r '.model // empty' "$f" 2>/dev/null); [ -n "$m" ] || continue
    [ "${m%%\[*}" = "$want" ] && continue   # the [1m] suffix is a context knob, not a model (idname) — not a disagreement
    sid=$(basename "$f" .json)
    printf '%s\t%s\n' "$(tr -d '\t\n' <<<"$sid")" "$(tr -d '\t\n' <<<"$m")"
  done < <(stat -c '%Y %n' "$(sldir)"/*.json 2>/dev/null); }
reported_recently(){   # $1 = session id → 0 when a mismatch row for it was written inside CC_MODEL_MISMATCH_GAP (1 h).
                       # A disagreement lasts as long as the session does; a row a minute would bury every other verb
                       # in a log a person reads.
  local sid="${1:-}" t
  t=$(awk -F'\t' -v s="$sid" '$3=="mismatch" && index($5, s){t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)
  [ "$((now - t))" -lt "${CC_MODEL_MISMATCH_GAP:-3600}" ]; }
report_mismatches(){   # one log row per disagreeing session. The <model> field is the one it is REALLY on — the news —
                       # and the detail names the one a dispatch would have given it.
  local sid m want; want=$(current)
  while IFS=$'\t' read -r sid m; do [ -n "${sid:-}" ] || continue
    reported_recently "$sid" && continue
    printf '%s\t%s\tmismatch\t%s\t%s — this box dispatches %s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$sid" "$want" >> "$LOG"
  done < <(mismatches); }
untilw(){   # $1 = an epoch → the way a person reads it. HH:MMZ alone lies the moment the until is not today: a 24-hour
            # override read at 16:04Z as "until 12:51Z" looks like it lapsed three hours ago, and a handoff journal
            # recorded exactly that (2026-09-02). Past today, the date comes with it.
  local t="${1:-0}"
  [ "$(date -u -d "@$t" +%F)" = "$(date -u -d "@$now" +%F)" ] && { date -u -d "@$t" +%H:%MZ; return 0; }
  date -u -d "@$t" +%FT%H:%MZ; }
label(){ idname "$(rung_id "$(fam "${1:-}")")" 2>/dev/null && return 0   # the rung's own id: "Opus 5.5" while that is the primary
  case "$(fam "${1:-}")" in fable) echo "Fable 5.1";; opus) echo "Opus 5";; sonnet) echo "Sonnet 5";; haiku) echo "Haiku";; *) echo "${1:-}";; esac; }
CHAIN="${CC_MODEL_CHAIN:-claude-opus-5-5 claude-sonnet-5}"   # the one copy of the order (see above). NO FABLE RUNG: a rung above the
                                                              # primary would have reconcile type a Fable seat down and bank it as an outage move
chain_all(){   # the canonical order: ONE RUNG PER FAMILY, first mention wins. A CC_MODEL_CHAIN that names a family twice
               # would otherwise walk in a circle, and a caller that reruns on each rung would never stop (F7).
  local m f; local -a ms; local -A seen=(); read -r -a ms <<<"$CHAIN"
  for m in "${ms[@]}"; do f=$(fam "$m"); [ -n "$f" ] || continue
    [ -n "${seen[$f]:-}" ] && continue; seen[$f]=1; printf '%s\n' "$m"; done; }
chain(){   # …minus the rungs this account cannot run: a caller walking it must never be handed one of those
  local m; while read -r m; do unavail "$(fam "$m")" || printf '%s\n' "$m"; done < <(chain_all); }
chain_next(){   # the model AFTER $1 on the chain, by family: "opus", "claude-opus-5" and "claude-opus-5[1m]" are one rung.
                # A trailing [suffix] rides along: falling from fable[1m] to a bare opus silently drops the 1M context
                # the caller was running with, and the rerun then fails for a reason nobody asked for (F7).
                # A rung the account cannot run is stepped over — and $1 itself may be one (the primary, most days).
  local src="${1:-}" w sfx m hit=0
  [ -n "$(fam "$src")" ] || src="$PRIMARY"   # named nothing: start from where the box actually is
  w=$(fam "$src"); sfx=$(grep -oE '\[[^][]*\]$' <<<"$src")
  while read -r m; do
    if [ "$hit" = 1 ]; then unavail "$(fam "$m")" && continue
      case "$m" in *']') printf '%s\n' "$m";; *) printf '%s%s\n' "$m" "$sfx";; esac; return 0; fi
    [ "$(fam "$m")" = "$w" ] && hit=1
  done < <(chain_all); return 1; }   # off the end of the chain (or a model that was never on it): nothing left to fall back to
forced(){   # the model the box was MOVED to: the override, else the next rung when the primary is not this account's to
            # run, else NOTHING — the box is on its primary and nothing is forcing it off. `current` was this until
            # 2026-09-07; cc-loop still wants this question, because a worker dispatched with no --model runs on
            # CC_WORKER_MODEL and not on whatever the interactive sessions run on.
  if ov; then printf '%s\n' "$model"; elif unavail "$(fam "$PRIMARY")"; then chain_next "$PRIMARY" || true; fi; }
current(){   # what a dispatch passes as --model, in EVERY state: what forced() says, else the primary itself. A launcher
             # asks one question — "which model do I start this session on" — and it must always get an answer, or the
             # session comes up on the harness default and what the box says it is running is not what it is running.
             # The one empty answer left is the primary being unavailable with nothing after it on the chain: there is
             # no model to name then, and naming the one the account cannot run would be worse than saying nothing.
  local m; m=$(forced); [ -n "$m" ] && { printf '%s\n' "$m"; return 0; }
  unavail "$(fam "$PRIMARY")" && return 0   # …and the chain has nothing after it: no model to name, so name none
  printf '%s\n' "$PRIMARY"; }
out_why(){   # $1 model → exit 0 + why when its family is OUT right now: recorded as one the account cannot run, or the
             # override has moved the box off the primary and $1 is the primary's family. Exit 1 and nothing otherwise.
             # The two facts this file already holds; a live cc-limit stamp is the caller's own `cc-limit status` wait.
  local f; f=$(fam "${1:-}"); [ -n "$f" ] || return 1
  if unavail "$f"; then   # …with the last time something re-checked it: a probe refreshes it every CC_MODEL_PROBE_EVERY, in every state
    printf '%s is not available to this account: %s (last checked %s)\n' "$f" "$(awk -F'\t' -v f="$f" '$1==f{print $4; exit}' "$UNAV")" \
      "$(untilw "$(awk -F'\t' -v f="$f" '$1==f{print $3+0; exit}' "$UNAV")")"; return 0; fi
  if ov && [ "$f" = "$(fam "$PRIMARY")" ] && [ "$(fam "$model")" != "$f" ]; then
    printf '%s is limited: the box is on %s until %s\n' "$f" "$(fam "$model")" "$([ "$till" -gt 0 ] && untilw "$till" || echo 'it answers again')"; return 0; fi
  return 1; }
resolve(){   # $1 model → the model to run NOW for a caller that asked for $1: itself, or the next rung while it is out
             # (the [1m] suffix riding along). Asked every iteration by cc-loop, so the lift brings a loop back by
             # itself; a model with nothing after it on the chain is handed back as asked — running and being refused
             # says more than an empty answer would. A family NOT ON the chain (fable[1m], since Fable left it) has no
             # rung after it, so it falls to the chain's first runnable rung: handing it back refused a worker every
             # iteration of a Fable outage.
  local m="${1:-}" f r; f=$(fam "$m"); [ -n "$f" ] || { printf '%s\n' "$m"; return 0; }
  out_why "$m" >/dev/null || { printf '%s\n' "$m"; return 0; }
  chain_next "$m" && return 0
  if ! chain_all | while read -r r; do [ "$(fam "$r")" = "$f" ] && exit 0; done; then r=$(chain | head -n1)
    if [ -n "$r" ]; then case "$r" in *']') printf '%s\n' "$r";; *) printf '%s%s\n' "$r" "$(grep -oE '\[[^][]*\]$' <<<"$m")";; esac; return 0; fi; fi
  printf '%s\n' "$m"; }
status_line(){   # "fable" | "opus until 11:40Z" | "opus until probe", and " — fable is not available to this account" when it is
  local s mm
  if ov; then s="$(fam "$model") until $([ "$till" -gt 0 ] && untilw "$till" || echo probe)"
  elif unavail "$(fam "$PRIMARY")"; then s=$(fam "$(chain_next "$PRIMARY" || echo -)")
  else s=$(fam "$PRIMARY"); fi
  unavail "$(fam "$PRIMARY")" && s="$s — $(fam "$PRIMARY") is not available to this account"
  mm=$(mismatches | wc -l)   # …and what is RUNNING, when it is not what the line above says the box dispatches
  [ "$mm" -gt 0 ] && s="$s — $mm session$([ "$mm" = 1 ] || echo s) on another model"
  printf '%s\n' "$s"; }
ov(){ model=""; since=0; till=0; reason=""; probed=0   # loads the override; exit 1 = none (the box is on its primary model)
  [ -f "$OV" ] && IFS=$'\t' read -r model since till reason probed < "$OV"
  [[ "${till:-}" =~ ^[0-9]+$ ]] || till=0; [[ "${probed:-}" =~ ^[0-9]+$ ]] || probed=0; [ -n "$model" ]; }
# ── A MODEL THIS ACCOUNT CANNOT RUN ──────────────────────────────────────────────────────────────────────────────
# "Fable 5.1 requires usage credits" (2026-09-03, the account went Pro) and "You're out of usage credits" (2026-08-28)
# are not limits: no reset lifts them, and the other models answer. Read as a limit, the first parked the whole box
# for 14 h. So such a model is RECORDED as unavailable, here, and four things read the record: `chain` and `next`
# leave that rung out, `current` hands a dispatch the next rung when the primary is the one, `status` says so, and
# `unavailable` moves the box off it. The record outlives the override: clear the override, or boot fresh, and a
# dispatch with no --model still aims past it. A probe that answers AS that model, or `switch` back onto it, forgets it.
unavail(){ [ -n "${1:-}" ] && [ -f "$UNAV" ] && awk -F'\t' -v f="$1" '$1==f{y=1} END{exit !y}' "$UNAV"; }   # $1 family → 0 = recorded
note_unavailable(){   # $1 family · $2 reason → one row per family: since stays across sightings, last-seen and reason move
  local f="$1" why since; why=$(tr -d '\t\n' <<<"${2:-}" | head -c 160)
  since=$(awk -F'\t' -v f="$f" '$1==f{print $2+0; exit}' "$UNAV" 2>/dev/null); [ "${since:-0}" -gt 0 ] || since=""
  { [ -f "$UNAV" ] && awk -F'\t' -v f="$f" '$1!=f' "$UNAV"; printf '%s\t%s\t%s\t%s\n' "$f" "${since:-$now}" "$now" "$why"; } > "$UNAV.t"
  mv "$UNAV.t" "$UNAV"
  [ -n "$since" ] && return 0   # once per MODEL out, not per probe: the log row below. A second model going out
                                # in the same episode is its own row.
  printf '%s\t%s\tunavailable\t%s\t%s%s\n' "$(date -u +%FT%TZ)" "$now" "$f" "$why" "${CRED:+ (login: $CRED)}" >> "$LOG"; }
forget_unavailable(){   # $1 family → its row is dropped (nothing to do when it has none)
  unavail "${1:-}" || return 0
  awk -F'\t' -v f="$1" '$1!=f' "$UNAV" > "$UNAV.t"; mv "$UNAV.t" "$UNAV"; [ -s "$UNAV" ] || rm -f "$UNAV"
  printf '%s\t%s\tavailable\t%s\tanswered as itself again\n' "$(date -u +%FT%TZ)" "$now" "$1" >> "$LOG"; }
unavailable_why(){   # $1 = a classify `why` → 0 when it says the MODEL is not the account's to run (not a reroute, not a
                     # stopped turn): the wording that wants usage credits, or the API's own not-ours-to-call shapes
  case "${1:-}" in 'needs usage credits'*|'the model would not answer as itself') return 0;; esac; return 1; }
mark_unavailable(){   # $1 model · $2 reason → record it, and move the box off it if that is what the box is on
  local f nx cur; f=$(fam "${1:-}"); [ -n "$f" ] || return 0
  [ -z "$CRED" ] || { note_unavailable "$f" "${2:-}"; note_refused "$f"; return 0; }   # another login's refusal: its record, never the box's sessions
  drop_stale_rows   # before the record is written: it is what says an episode is open
  note_unavailable "$f" "${2:-}"; note_refused "$f"
  cur="$PRIMARY"; ov && cur="$model"; [ "$(fam "$cur")" = "$f" ] || return 0
  nx=$(chain_next "$cur") || return 0   # nothing left to move to: recorded, and every caller reads the chain's end
  do_switch "$nx" "$f not available to this account: ${2:-usage credits}"; }
note_refused(){ { awk -F'\t' -v f="$1" '$1!=f' "$REFUSED" 2>/dev/null; printf '%s\t%s\n' "$1" "$now"; } > "$REFUSED.t" && mv "$REFUSED.t" "$REFUSED"; }   # $1 family: a REAL run refused now
refused_recently(){   # $1 family → 0 when a real run (a pane, a loop — never the probe) was refused inside CC_MODEL_REFUSED_HOLD (1 h)
  local t; t=$(awk -F'\t' -v f="${1:-}" '$1==f{print $2+0; exit}' "$REFUSED" 2>/dev/null); [ $((now - ${t:-0})) -lt "${CC_MODEL_REFUSED_HOLD:-3600}" ]; }
limstamp(){ lim_till=0; lim_model=""; lim_seen=0   # cc-limit's stamp: "<until>\t<how>\t<first-seen>\t<model>\t<observers>"
  local o=""
  # Split by awk, not by `IFS=$'\t' read`: tab is IFS whitespace and bash folds "\t\t" into one delimiter, so a
  # stamp that names no model hands its observers to $lim_model (cc-limit, 2026-09-04).
  [ -f "$ST/claude-limit" ] && { IFS= read -r lim_till; IFS= read -r lim_model; IFS= read -r o; } \
    < <(awk -F'\t' 'NR==1{print $1; print $4; print $5}' "$ST/claude-limit")
  [[ "${lim_till:-}" =~ ^[0-9]+$ ]] || lim_till=0
  # ONE RUN'S LIMIT IS NOT THE BOX'S (cc-limit, 2026-09-04): the observers are the distinct runs that have hit it,
  # and cc-limit calls it account-wide at two. Below that this file must not move every session on it — on 09-04
  # one worker's 09:13Z stamp did, for six hours, while opus went on answering.
  lim_seen=$(tr ',' '\n' <<<"${o:-}" | grep -cx '[0-9a-f]\{8\}' || true); }
lim_interrupted(){   # is a live INTERACTIVE session on file as INDEPENDENTLY stopped by a limit that has not reset yet?
                     # ~/.cc/state/limit-interrupted is cc-limit's "<pane>\t<window>\t<reset>\t<started>\t<tags>", and a
                     # row goes in only for a pane whose limit line was CORROBORATED and named a reset — and cc-limit's
                     # scan leaves out headless panes (they park and rerun themselves), so a row is a run of its own.
  # …BUT ONLY A ROW TAGGED `indep`. record() corroborates a pane's line with the very stamp this function is about to
  # believe, so without that tag a one-observer stamp plus any pane still showing the MORNING's limit wording would be
  # two witnesses that are really one, and every session would move to the fallback for six hours with no probe — the
  # 2026-09-04 regression the two-observer rule exists to stop (review of #264). cc-limit tags `indep` only when that
  # pane's own limit LINE was first seen inside the current episode, which is a sighting the stamp did not supply.
  awk -F'\t' -v n="$now" '($3+0) > n && $5 ~ /(^|,)indep(,|$)/ {f=1} END{exit !f}' \
    "$ST/limit-interrupted" 2>/dev/null; }
stamp_says_switch(){   # exit 0 = cc-limit's stamp is reason enough to move every session to the fallback NOW.
  # "the switch follows the recorded limit within a minute, not a pane scan" (2026-09-05). That morning the stamp was
  # written at 09:08Z naming a reset of 11:10Z, and the box did not move until 10:55Z — 1h47m late, off the pane scan
  # below and a probe it paid for, on evidence the stamp already held. Two gates kept it waiting:
  #   A SECOND RUN. The two-observer rule stands — one worker's word moved every session for six hours on 09-04 —
  #   but a session cc-limit has recorded as INDEPENDENTLY interrupted (`indep`: its limit line was first seen inside
  #   this episode, not left over from the morning — see lim_interrupted) IS a second run that hit the same limit, and
  #   a better witness than the pane loop below, which reads that same screen an hour later and buys a probe to agree.
  #   A STAMP THAT NAMES NO MODEL. Field 4 is empty when neither the message nor the run's json named one (cc-limit
  #   keeps its own case for exactly that stamp), and `-n "$lim_model"` then refused it for ever. The box dispatches on
  #   the primary, so a limit with no model on it is the primary's — which is how the pane loop reads a pane that
  #   names none, one screen further down this file.
  limstamp
  [ "$lim_till" -gt "$now" ] || return 1
  { [ "$lim_seen" -ge 2 ] || lim_interrupted; } || return 1
  [ "$(fam "${lim_model:-$PRIMARY}")" = "$(fam "$PRIMARY")" ]; }
rate_ok(){ local l s; l=$(awk -F'\t' '$3=="switch"{t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)   # one switch per 10 min, never a flap
  # The override's own `since` counts as a switch, not only the log line: that line is written AFTER every pane has
  # been retyped, and on 2026-09-01 a restore slipped into that gap and sent 12 sessions straight back into the prompt.
  s=$(cut -f2 "$OV" 2>/dev/null); { [[ "${s:-}" =~ ^[0-9]+$ ]] && [ "$s" -gt "$l" ]; } && l="$s"
  [ $((now - l)) -ge "${CC_MODEL_MIN_GAP:-600}" ]; }
sessions(){   # "<pane-id> <window-name>" per live INTERACTIVE session: a pane whose DIRECT child is claude (pane id, so a split
              # window's non-claude active pane is never typed into)
              # (a headless --go worker runs cc-loop in its pane and its claude is a grandchild — never a session)
  local id pp name
  [ -n "${CC_MODEL_SESSIONS:-}" ] && { cat "$CC_MODEL_SESSIONS" 2>/dev/null; return 0; }   # test hook: a fixture's list
  while read -r id pp name; do
    [ -n "${pp:-}" ] || continue
    pgrep -P "$pp" -x "$PROC" >/dev/null 2>&1 || continue
    pgrep -P "$pp" -f cc-loop >/dev/null 2>&1 && continue
    printf '%s %s\n' "$id" "$name"
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id} #{pane_pid} #{window_name}' 2>/dev/null)
}
member_win(){ [ -n "${1:-}" ] && [ -d "${CC_MODEL_MEMBERS:-$HOME/.cc/members}/$1" ]; }   # $1 window → 0 = a member workspace's session:
              # its dialogs are answered, and every chain pass (move, retune, bank, return) skips it — the brief (2026-09-20):
              # "member-facing sessions run CC_MEMBER_MODEL, never the chain"
live_model(){   # $1 pane id → the model the session in that pane is RUNNING, as an id a dispatch would name (the [1m]
                # suffix restored from the record's window, so what goes back in is what came out). The claude process
                # is the pane's direct child and its argv carries `--session-id` (cc passes it), which names the
                # cc-statusline record — the harness's own word, the same evidence mismatches() reads. A session with
                # no record yet (its first turn is still open) is on what its argv asked for, and one launched by hand
                # with neither — or the selftest's bare `cat` — is on $2, THE MODEL THE CALLING PASS IS ASKING ABOUT
                # (the family going out when moving down, the one the box was moved to when coming back), else what
                # the box dispatches. Never `current` from inside a switch: do_switch writes the override before it
                # moves a pane, so on 2026-09-16 every evidence-less pane read as already on the fallback and was
                # kept, and the restore typed that kept row back into it. A pane's TEXT is never read for this: a doc
                # on screen names a model and is not running it.
  local id="${1:-}" pp c sid m w
  if [ -n "${CC_MODEL_LIVE:-}" ]; then   # test hook: the file is the whole truth — a pane not in it has no record and no --model
    m=$(awk -F'\t' -v p="$id" '$1==p{print $2; exit}' "$CC_MODEL_LIVE" 2>/dev/null)
  else
    pp=$(tmux display-message -p -t "$id" '#{pane_pid}' 2>/dev/null); c=$(pgrep -P "${pp:-0}" -x "$PROC" 2>/dev/null | head -1)
    if [ -n "$c" ] && [ -r "/proc/$c/cmdline" ]; then
      sid=$(tr '\0' '\n' < "/proc/$c/cmdline" | grep -A1 -x -- '--session-id' | tail -1)
      [ -n "$sid" ] && IFS=$'\t' read -r m w < <(jq -r '[(.model // ""), ((.window // 0) | tostring)] | @tsv' "$(sldir)/$sid.json" 2>/dev/null)
      { [ -n "${m:-}" ] && [ "${w:-0}" -ge 1000000 ] 2>/dev/null; } && m="${m}[1m]"
      [ -n "${m:-}" ] || m=$(tr '\0' '\n' < "/proc/$c/cmdline" | grep -A1 -x -- '--model' | tail -1)
    fi
  fi
  [ -n "${m:-}" ] || m="${2:-$(current)}"
  printf '%s\n' "$m"; }
moved_row(){ awk -F'\t' -v p="${1:-}" '$1==p{print $3; exit}' "$MOVED" 2>/dev/null; }   # what a pane was on when the box moved off a model, or nothing
moved_by_box(){   # $1 pane · $2 the family a move is off → 0 = the box has TYPED at this pane for THAT move.
                  # A ROW IS THE PANE'S FOR THE WHOLE EPISODE; A GUARD BELONGS TO ONE MOVE (third review of #503).
                  # Asked of the row alone, this skipped a pane the box had moved at 10:00 for Fable when Opus hit the
                  # spend cap on it at 12:00: nothing recorded Opus out, nothing typed, and the session stood at an
                  # empty prompt — the 00:5xZ stall, one rung down. Field 6 collects the families this pane has been
                  # moved off, so each move asks its own question. An empty $2 asks the old one: moved at all?
  awk -F'\t' -v p="${1:-}" -v f="${2:-}" '$1==p && ($5=="moved" || $5=="parked") && (f=="" || index("," $6 ",", "," f ",")){y=1} END{exit !y}' "$MOVED" 2>/dev/null; }
note_moved(){   # $1 pane · $2 window · $3 the model it was on · $4 moved|kept|parked · $5 the family THIS move is off.
                # `parked` is a planning pane the move left where it was rather than take it below the floor: a move
                # for every guard here, and the lift hands it back by handoff (see A PLANNING SESSION … FLOOR).
                # THE MODEL IS FIRST-WRITE-WINS: a chained move (Fable out, then Opus) still restores the pane to what
                # it was on before the first one. The rest of the row belongs to the LATEST move — field 6 collects the
                # families the box has typed this pane off, and a pane banked `kept` that a later move does type at
                # becomes `moved` for that family. Without that upgrade a pane a person had left on the fallback was
                # outside every guard when the fallback went out, and was retyped on every tick past the retune gap.
  local p="$1" w="$2" m="$3" k="${4:-moved}" f="${5:-}"
  case "$k" in moved|parked) ;; *) f="";; esac   # kept: nothing was done to it, so the row names no move
  awk -F'\t' -v p="$p" '$1==p{y=1} END{exit !y}' "$MOVED" 2>/dev/null ||
    { printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$p" "$w" "$m" "$now" "$k" "$f" >> "$MOVED"; return 0; }
  [ -n "$f" ] || return 0   # a pass that only OBSERVED the pane never rewrites the row a move wrote
  { awk -F'\t' -v p="$p" '$1!=p' "$MOVED"
    awk -F'\t' -v p="$p" -v f="$f" -v k="$k" 'BEGIN{OFS="\t"} $1==p{$5=k
      if (f != "" && !index("," $6 ",", "," f ",")) $6 = ($6 == "" ? f : $6 "," f)
      print; exit}' "$MOVED"; } > "$MOVED.t" && mv "$MOVED.t" "$MOVED"; }
episode_over(){ ! ov && [ ! -s "$UNAV" ]; }   # the box on its primary with nothing out: no episode is open
drop_stale_rows(){   # $MOVED belongs to ONE episode. Rows left when a person cleared the override and the record by
                     # hand (the selftest does; an owner may) read as "typed at this episode already" and held the next
                     # episode's panes back (2026-09-16): a move that starts from a clean box starts from no rows.
                     # Called where an episode can begin — and ONCE PER RUN: a row written after the first drop is this
                     # run's own (2026-09-20: the dialog pass banked a pane `moved`, then do_switch's drop, seeing no
                     # override yet, threw the row away, and the lift never brought that pane back).
  [ -n "${ROWS_DROPPED:-}" ] && return 0; ROWS_DROPPED=1
  episode_over && rm -f "$MOVED"; return 0; }
move_off(){   # $1 family · $2 target model · $3 why → "/model $2" typed into every live session ON $1, and ONLY those
              # (the brief: "moves only Fable-bound work"). Each pane's old model is banked in $MOVED so the lift can
              # put it back; a pane the box has already typed off THIS family, or one retuned inside
              # CC_MODEL_RETUNE_GAP, is not typed at again — the statusline record says the old model until the
              # session's next turn. Prints the count.
  local f="$1" m="$2" why="${3:-}" id name lm n=0
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue   # never on the chain
    lm=$(live_model "$id" "$(rung_id "$f")")   # no record, no --model: taken to be on the family going out
    [ "$(fam "$lm")" = "$f" ] || { note_moved "$id" "$name" "$lm" kept "$f"; continue; }   # not on it: banked as where a person left it
    moved_by_box "$id" "$f" && continue   # …for THIS move: a pane the box moved off another family is still to be moved off this one
    retuned_recently "$id" && continue
    planning "$name" && below_floor "$m" && { park "$id" "$name" "$lm" "$f" "$why"; continue; }   # the owner: "planning sessions must be at least on opus"
    if type_into "$id" "$name" "/model $m"; then note_moved "$id" "$name" "$lm" moved "$f"; n=$((n+1)); drop_returned "$name"
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) was on %s — %s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$SESSION" "$name" "$id" "$lm" "$why" >> "$LOG"
    else printf '%s\t%s\tskip\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$SESSION:$name busy or unreachable" >> "$LOG"
      printf '%s\n' "$id" >> "$ST/model-skipped"; fi   # a pane behind a dialog: retried on later ticks (F3)
  done < <(sessions); tell_parked "$why"; printf '%s\n' "$n"; }   # the line goes here: callers read the count in a subshell
restore_all(){   # $1 = the family the box was moved TO → every live session back to what it was on: its $MOVED row,
                 # or — launched during the outage, so on the fallback with no row — the primary. A session on another
                 # family with no row was put there by a person and is left there (a Sonnet steward is not sent to
                 # Fable; until 2026-09-15 it was). Prints the count and forgets the rows: the episode is over.
  local to_f="${1:-}" id name lm was to n=0
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue   # never on the chain: no row, no return
    lm=$(live_model "$id" "$(rung_id "$to_f")"); was=$(moved_row "$id")   # no record: taken to be where the box put things
    # a parked planning seat is on a model that was out: it hands over to the primary whatever it was on before
    awk -F'\t' -v p="$id" '$1==p && $5=="parked"{y=1} END{exit !y}' "$MOVED" 2>/dev/null &&
      { return_session "$id" "$name" "$lm" row && n=$((n+1)); continue; }
    # rowless on the fallback: back to its band — the primary, or the floor for a planning/major window the
    # CC_MODEL_PRIMARY_WINDOWS list leaves out, which is then already home and skipped just below
    if [ -n "$was" ]; then to="$was"; elif [ "$(fam "$lm")" = "$to_f" ]; then
      if planning "$name" || major "$name"; then to=$(band_of "$name"); else to="$PRIMARY"; fi; else continue; fi
    [ "${to%%\[*}" = "${lm%%\[*}" ] && continue   # already there: the session moved back by itself, or was never moved
    # the brief (owner, 2026-09-18): "major sessions like [the planning seats] automatically go back on fable via
    # automatic handoff. the other sessions that should technically be on fable … get an automatic message asking me"
    # — so a session that belongs on the PRIMARY is not retyped: return_session hands it off or posts its card. One
    # already on the primary's family (its old id, say) is never handed off; tick's same-family pass retunes that.
    # …and since 2026-09-20 a session WITH A ROW — the box typed it off the primary, or it took the dialog — is handed
    # off whether or not it is major: "when fable is back, session goes onto fable as needed". The card is for a
    # rowless one: launched on the fallback during the outage, and nothing on record says it belongs on the primary.
    if [ "$(fam "$to")" = "$(fam "$PRIMARY")" ]; then
      [ "$(fam "$lm")" = "$(fam "$to")" ] || { return_session "$id" "$name" "$lm" "${was:+row}" && n=$((n+1)); }; continue; fi
    if type_into "$id" "$name" "/model $to"; then n=$((n+1))
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) back from %s\n' "$(date -u +%FT%TZ)" "$now" "$to" "$SESSION" "$name" "$id" "$lm" >> "$LOG"
    else printf '%s\t%s\tskip\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$to" "$SESSION:$name busy or unreachable" >> "$LOG"
      printf '%s\n' "$id" >> "$ST/model-skipped"; fi
  done < <(sessions); rm -f "$MOVED"; printf '%s\n' "$n"; }
lift_rung(){   # $1 a family below the primary that answers again (its record just forgotten) → the box back up to it.
               # An override sitting on a LOWER rung moves up to it (09-21: Opus was on record out from 02:15Z, only the
               # primary was ever probed, and the box stayed on Sonnet 14 h after Opus came back); every pane the box
               # moved off it is typed back, a pane launched on the old rung during the outage goes up with them, and a
               # parked planning seat comes back by `cc-handoff --overlap`. Rows then forget the family. Prints the count.
  local f="$1" to old="" id name lm st fs n=0
  if [ "$(fam "$FALLBACK")" = "$f" ]; then to="$FALLBACK"; else to=$(rung_id "$f"); fi
  if ov && [ "$(rung_of "$model")" -gt "$(rung_of "$f")" ] 2>/dev/null; then old=$(fam "$model")
    printf '%s\t%s\t%s\t%s\t%s\n' "$to" "$since" "$till" "$reason" "$probed" > "$OV"; model="$to"; fi
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue
    IFS=$'\t' read -r st fs < <(awk -F'\t' -v p="$id" '$1==p{print $5 "\t" $6; exit}' "$MOVED" 2>/dev/null)
    case ",${fs:-}," in *",$f,"*) ;; *) { [ "${st:-}" = parked ] && [ "$f" = "$(floor_fam)" ]; } || st="";; esac   # a row about
      # another move is no reason to touch this pane — except a parked seat when the FLOOR answers: it waits for the floor
      # whatever it was parked off (parked on Fable while Opus was already out: field 6 says fable, and Fable may never return)
    lm=$(live_model "$id" "$([ -n "$old" ] && rung_id "$old" || echo "$to")")
    if [ "${st:-}" = parked ]; then
      returned_recently "$name" || { launch_return "$name" "$lm" "$(label "$f") answers again (planning was parked)" && n=$((n+1)); }
    elif [ "${st:-}" = moved ] || { [ -n "$old" ] && [ -z "$(moved_row "$id")" ] && [ "$(fam "$lm")" = "$old" ]; }; then
      [ "$(fam "$lm")" = "$f" ] && continue
      [ "$(rung_of "$lm")" -gt "$(rung_of "$f")" ] 2>/dev/null || continue   # only ever UP: one a person put higher stays
      type_into "$id" "$name" "/model $to" && { n=$((n+1))
        printf '%s\t%s\tretune\t%s\t%s:%s (%s) back from %s — %s answers again\n' "$(date -u +%FT%TZ)" "$now" "$to" "$SESSION" "$name" "$id" "$lm" "$f" >> "$LOG"; }
    fi
  done < <(sessions)
  [ -f "$MOVED" ] && { awk -F'\t' -v f="$f" -v fl="$(floor_fam)" 'BEGIN{OFS="\t"} { k = split($6, a, ","); o = ""
      for (i = 1; i <= k; i++) if (a[i] != f && a[i] != "") o = (o == "" ? a[i] : o "," a[i])
      if ($5 == "parked" && f == fl) o = ""   # handed back above: the floor answering ends every park
      if ($6 != o) { $6 = o; if (o == "") $5 = "kept" } print }' "$MOVED" > "$MOVED.t" && mv "$MOVED.t" "$MOVED"; }
  printf '%s\t%s\tlift\t%s\t%s session(s)%s\n' "$(date -u +%FT%TZ)" "$now" "$to" "$n" "${old:+; override up from $old}" >> "$LOG"
  "$BIN/cc-notify" -t "$(hostname -s) model" "$(label "$f") answers again${old:+ — the box is back on it from $(label "$old")}; what moved off it returns, parked planning hands back." >/dev/null 2>&1 || true
  printf '%s\n' "$n"; }
want_of(){   # $1 pane · $2 window → the model this session belongs on NOW, "park", or nothing (exit 1): no band here.
             # ITS BAND: the model the box moved it off ($MOVED row), else band_of for a planning or major window — the
             # primary, or the floor rung when CC_MODEL_PRIMARY_WINDOWS names windows and not this one; a
             # rowless minor window is where its dispatcher or a person put it, and is left there. FROM THE BAND DOWN, the
             # first rung that is not out (out_why: on record as not the account's, or the primary under an override).
             # A planning window never lands below the floor: "park" when everything down to it is out.
  local b m; if moved_by_box "$1" ""; then b=$(moved_row "$1"); elif planning "$2" || major "$2"; then b=$(band_of "$2"); else return 1; fi
  m="$b"; while out_why "$m" >/dev/null; do m=$(chain_next "$m") || { planning "$2" && echo park; return 0; }; done
  { planning "$2" && below_floor "$m"; } && { echo park; return 0; }
  printf '%s\n' "$m"; }
reconcile(){   # EVERY TICK, NO EVENT NEEDED (owner, 2026-09-21): each live session's model against want_of, and the move
               # when they disagree — up as well as down. Until then the return fired only on a recorded lift, so a seat
               # born on the fallback (no $MOVED row, no lift) stayed there: five planning seats sat on Sonnet an hour
               # after the 09-21 account change. UP to the primary is a handoff, or a card for a rowless minor window
               # (return_session; one card per window until a new outage drops it); up to a lower rung is `/model`; DOWN is
               # `/model`; a parked seat whose rung answers hands back by handoff. A planning window with its floor out is parked (a
               # pane below the floor typed back to it first). A pane with no record is taken to be where it belongs,
               # and each pane is typed at once per CC_MODEL_RETUNE_GAP, as every other pass.
  local id name w lm fr; fr=$(floor_rung)
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue; case "$name" in *~*) continue;; esac   # never on the chain · mid-handoff
    w=$(want_of "$id" "$name") || continue
    if [ "$w" = park ]; then
      parked_row "$id" && continue   # parked already: the owner heard once, and the seat is idle
      lm=$(live_model "$id" "$fr")
      { policy_band "$id" "$name" && ! below_floor "$lm"; } && continue   # its band is out, and it sits at the floor or above: leave it
      retuned_recently "$id" && continue
      if below_floor "$lm"; then type_into "$id" "$name" "/model $fr" || continue; fi   # busy: next tick
      park "$id" "$name" "$(below_floor "$lm" && echo "$fr" || echo "$lm")" "$(fam "$lm")" "found on $lm"; continue; fi
    lm=$(live_model "$id" "$w")
    if parked_row "$id"; then returned_recently "$name" || launch_return "$name" "$lm" "$(label "$w") answers (planning was parked)"; continue; fi
    if [ "$(fam "$lm")" = "$(fam "$w")" ]; then   # one rung — but a seat on the rung's OLD id (claude-opus-5 under a
      # claude-opus-5-5 band, 2026-09-23) is typed to the band's id: a policy move, no row banked. Only when the band IS
      # the rung's canonical id, so a moved row naming an old id is never "corrected" away from what it was on.
      { [ "${lm%%\[*}" != "${w%%\[*}" ] && [ "${w%%\[*}" = "$(rung_id "$(fam "$w")" | sed 's/\[.*$//')" ]; } || continue
      retuned_recently "$id" && continue
      type_into "$id" "$name" "/model $w" &&
        printf '%s\t%s\tretune\t%s\t%s:%s (%s) found on %s, the old id of its band — reconcile\n' "$(date -u +%FT%TZ)" "$now" "$w" "$SESSION" "$name" "$id" "$lm" >> "$LOG"
      continue; fi
    retuned_recently "$id" && continue
    if [ "$(rung_of "$lm")" -gt "$(rung_of "$w")" ] 2>/dev/null; then   # below where it belongs: UP
      if [ "$(fam "$w")" = "$(fam "$PRIMARY")" ]; then
        moved_by_box "$id" "" || major "$name" ||
          ! awk -F'\t' -v w="$name" '$1==w && $3=="card"{y=1} END{exit !y}' "$RETURNED" 2>/dev/null || continue   # carded: the owner's 👍 decides
        return_session "$id" "$name" "$lm" "$(moved_by_box "$id" "" && echo row)"; continue; fi
    fi
    if type_into "$id" "$name" "/model $w"; then
      # DOWN: banked, so it comes back — UNLESS the band is the policy's. The brief: "reconcile moves a window DOWN
      # to its own band by /model as it does now, but banks NO moved row for that move (a policy move is not an outage
      # move: today's note_moved would make want_of ask for the primary again next tick and loop a handoff)."
      { [ "$(rung_of "$lm")" -lt "$(rung_of "$w")" ] 2>/dev/null && ! policy_band "$id" "$name"; } &&
        note_moved "$id" "$name" "$lm" moved "$(fam "$lm")"
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) found on %s — reconcile\n' "$(date -u +%FT%TZ)" "$now" "$w" "$SESSION" "$name" "$id" "$lm" >> "$LOG"; fi
  done < <(sessions); tell_parked ""; }
# ── THE FABLE BAND COMES BACK BY HANDOFF, NOT BY /model (owner, 2026-09-18) ────────────────────────────────────
# "When fable 5.1 is available again … major sessions like [the planning seats] automatically go back on fable via
# automatic handoff. the other sessions that should technically be on fable but are not as important get an automatic
# message asking me if i want to handoff … thumbs up means trigger handoff." Until then the owner saw Fable return,
# then asked for each handoff by hand, and sessions ran a rung down for hours after the outage ended. So at the lift
# a session that belongs on the primary is not retyped: a MAJOR one — its window on CC_MODEL_MAJOR, or by default
# an orch (`<repo>@<alias>`) or a repo's planning seat (`<repo>` with no workspace under ~/.cc/members) — gets
# `cc-handoff --overlap` with no message. SO DOES EVERY SESSION THE BOX MOVED OFF THE PRIMARY, major or not (owner,
# 2026-09-20: "fable when fable is back for the required sessions … when fable is back, session goes onto fable as
# needed"): its $MOVED row says it was on the primary, and that row is the owner's standing word for it. What STILL
# asks with a card is a session with NO row found on the fallback — launched during the outage on the fallback by its
# dispatcher, never on the primary: nothing on record says it belongs there, and a handoff re-reads its whole context.
# The card goes to its own channel — the repo's when it has none of its own, the box's when the repo has none — and
# the owner's 👍 on it runs `cc-model return <window>`. Sessions on the lower rungs keep the /model retune above.
# ONCE PER OUTAGE: $RETURNED holds a row per window; a row younger than CC_MODEL_RETURN_GAP (2 h — a probe that
# answers, then is refused again minutes later, is one outage) suppresses a second handoff or card, and move_off
# drops the row the moment a NEW outage types that window off the primary, so the next real outage gets its own
# return. A session mid-turn is not a case here: cc-handoff's kick and retire wait it out, where a /model line typed
# at a busy pane was the old way's failure (the 18:05Z skip row, 2026-09-18). A session already on the primary is
# never handed off: restore_all skips it above, and `return` reads the live model first.
major(){   # $1 window → 0 = handed back unasked. CC_MODEL_MAJOR (env, else ~/.cc/config; windows, space- or comma-
           # separated) is the whole list when set; else the default rule above. `~next`/`~old` is mid-handoff: never.
  local w="${1:-}" list; case "$w" in ''|*~*) return 1;; esac
  list="${CC_MODEL_MAJOR:-$("$BIN/cc-config" get CC_MODEL_MAJOR 2>/dev/null)}"
  if [ -n "$list" ]; then tr ' ,' '\n\n' <<<"$list" | grep -qxF -- "$w"; return; fi
  case "$w" in */*) return 1;; *@*) return 0;; esac
  [ ! -d "${CC_MODEL_MEMBERS:-$HOME/.cc/members}/$w" ]; }
# ── A PLANNING SESSION NEVER RUNS BELOW THE FLOOR (owner, 2026-09-21: "planning sessions must be at least on opus") ──
# Planning judgement on Sonnet steered wrongly and the owner found it by looking: at 02:15Z on 09-21 the spend cap
# took Opus and the chain moved every lessons planning seat to Sonnet for 14 h. So a planning session — an orch, a
# repo's planning seat, or a window on CC_MODEL_PLANNING — is never moved below the floor, the Opus rung
# (CC_MODEL_FLOOR overrides; the primary itself since 2026-09-23). When the floor itself is out it is PARKED: banked `parked` in $MOVED, nothing typed, no
# resume line, and the owner told once. The CLI may still put a parked seat on a lower rung by itself; reconcile
# in tick types it back to the floor, and parks a seat it finds below it while the floor is out. When the floor answers again (lift_rung, or the primary's restore) a parked seat
# comes back by `cc-handoff --overlap`, the way a major session returns to the primary. Workers, tracks and member
# windows keep the chain as it is.
planning(){   # $1 window → 0 = a planning session. CC_MODEL_PLANNING (env, else ~/.cc/config; windows or globs such as
              # `lessons/*`, space- or comma-separated) ADDS to the default rule: an orch (`<repo>@<alias>`), or a repo's
              # seat (`<repo>` with no workspace under ~/.cc/members). `~next`/`~old` is mid-handoff: the successor's own.
  local w="${1:-}" g gs=(); case "$w" in ''|*~*) return 1;; esac
  member_win "$w" && return 1
  IFS=', ' read -ra gs <<<"${CC_MODEL_PLANNING:-$("$BIN/cc-config" get CC_MODEL_PLANNING 2>/dev/null)}"   # read, not $(…): no pathname expansion
  # shellcheck disable=SC2254   # $g unquoted on purpose: a glob
  for g in "${gs[@]}"; do case "$w" in $g) return 0;; esac; done
  case "$w" in */*) return 1;; *@*) return 0;; esac; return 0; }
floor_fam(){ local f="${CC_MODEL_FLOOR:-}"   # unset: Opus when it is on the chain (the owner's word), else the fallback
  [ -n "$f" ] || { [ -n "$(chain_all | grep -i opus)" ] && f=opus || f="$FALLBACK"; }; fam "$f"; }   # no -q: pipefail + SIGPIPE
rung_of(){ chain_all | awk -v f="$(fam "${1:-}")" '{m=tolower($0)} index(m, f){print NR; exit}'; }   # $1 model → its place on the chain (1 = the primary), or nothing
below_floor(){ local r fl; r=$(rung_of "${1:-}"); fl=$(rung_of "$(floor_fam)"); [ -n "$r" ] && [ -n "$fl" ] && [ "$r" -gt "$fl" ]; }   # $1 model → 0 = a lower rung than the floor
floor_rung(){ if [ "$(fam "$FALLBACK")" = "$(floor_fam)" ]; then printf '%s\n' "$FALLBACK"; else rung_id "$(floor_fam)"; fi; }
# ── ONLY LISTED WINDOWS BELONG ON THE PRIMARY (the owner names the seats that stay on the primary, 2026-09-22, and
# asks for every other one on the floor model) ────────────────────────────────────────────────────────────────────
# want_of bound EVERY planning and major window to the primary, so a seat a person had moved down was handed straight
# back — a handoff for a major window, a card in its channel for the rest — and the planning seat moved each one by
# hand and stopped the cards. With CC_MODEL_PRIMARY_WINDOWS set (~/.cc/config; windows or globs, space- or
# comma-separated) only the windows on it have the primary as their band, and every OTHER planning or major window's
# band is the floor rung. Unset, nothing changes: every planning and major window is the primary's.
# reconcile moves such a window DOWN to its band with /model as it does any other, but banks NO $MOVED row for that
# move (policy_band): an outage move is a debt the lift owes back, a policy move is where the window now lives, and a
# row would have want_of ask for the primary again on the next tick and loop a handoff. THE OUTAGE PATH IS UNTOUCHED —
# a pane with a row belongs on what that row says, listed or not, and still returns by handoff at the lift. Workers,
# tracks and member windows have no band here at all and stay where their dispatcher put them.
primary_windows(){ printf '%s\n' "${CC_MODEL_PRIMARY_WINDOWS:-$("$BIN/cc-config" get CC_MODEL_PRIMARY_WINDOWS 2>/dev/null)}"; }
listed_primary(){   # $1 window → 0 = named on CC_MODEL_PRIMARY_WINDOWS. An empty list names nobody; `~next`/`~old` is
                    # mid-handoff and is nobody's here, as it is for planning() and major().
  local w="${1:-}" g gs=(); case "$w" in ''|*~*) return 1;; esac
  IFS=', ' read -ra gs <<<"$(primary_windows)"   # read, not $(…): no pathname expansion
  # shellcheck disable=SC2254   # $g unquoted on purpose: a glob
  for g in "${gs[@]}"; do case "$w" in $g) return 0;; esac; done; return 1; }
band_of(){   # $1 window (a planning or major one) → the model it belongs on before any outage: the primary, or the
             # floor rung when the list is set and this window is not on it.
  { [ -z "$(primary_windows)" ] || listed_primary "$1"; } && { printf '%s\n' "$PRIMARY"; return 0; }
  floor_rung; }
policy_band(){   # $1 pane · $2 window → 0 = this window's band is the floor BY POLICY, so a move down to it is not an
                 # outage move and banks no row. A pane the box has already moved is the outage path's, not this one's:
                 # its row is its band, and dropping the bank would strand it a rung down after the lift.
  [ -n "$(primary_windows)" ] || return 1
  moved_by_box "$1" "" && return 1
  { planning "$2" || major "$2"; } && ! listed_primary "$2"; }
parked_row(){   # $1 pane → 0 = banked `parked`, off whatever family: a parked seat waits for the FLOOR either way
  awk -F'\t' -v p="${1:-}" '$1==p && $5=="parked"{y=1} END{exit !y}' "$MOVED" 2>/dev/null; }
park(){   # $1 pane · $2 window · $3 the model it is on · $4 the family going out · $5 why → banked `parked`, one log row
  note_moved "$1" "$2" "$3" parked "$4"; drop_returned "$2"
  printf '%s\t%s\tpark\t%s\t%s:%s (%s) planning, not moved below %s — %s\n' "$(date -u +%FT%TZ)" "$now" "$3" "$SESSION" "$2" "$1" "$(label "$(floor_fam)")" "${5:-}" >> "$LOG"
  PARKED="${PARKED:+$PARKED, }$2"; }
tell_parked(){   # $1 why → the owner's one line for the windows this run parked (PARKED), then forgotten
  [ -n "${PARKED:-}" ] || return 0
  "$BIN/cc-notify" -t "$(hostname -s) model" "Planning parked: $PARKED — $(label "$(floor_fam)") is out (${1:-its cap}) and planning never runs on a lower model. It hands back on $(label "$(floor_fam)") by itself when that answers." >/dev/null 2>&1 || true
  PARKED=""; }
returned_recently(){ awk -F'\t' -v w="${1:-}" -v t="$((now - ${CC_MODEL_RETURN_GAP:-7200}))" '$1==w && $2>=t{y=1} END{exit !y}' "$RETURNED" 2>/dev/null; }
note_returned(){ { awk -F'\t' -v w="$1" '$1!=w' "$RETURNED" 2>/dev/null; printf '%s\t%s\t%s\t%s\n' "$1" "$now" "$2" "${3:-}"; } > "$RETURNED.t" && mv "$RETURNED.t" "$RETURNED"; }
drop_returned(){ [ -f "$RETURNED" ] && { awk -F'\t' -v w="${1:-}" '$1!=w' "$RETURNED" > "$RETURNED.t" && mv "$RETURNED.t" "$RETURNED"; }; return 0; }
return_chan(){   # $1 window → where its card goes: `#<repo>--<track>`, the orch's own `#<repo>-<alias>-xxxx`, `#<repo>` —
                 # the first the box has, read off cc-slack's own list — else CC_MODEL_RETURN_CHANNEL (`#<box>`)
  local w="$1" repo rest have; repo="${w%%[@/]*}"; rest="${w#"$repo"}"
  have=$("$BIN/cc-slack" channels --for "$repo" 2>/dev/null | awk '{print $2}')
  case "$rest" in
    /*) grep -qxF -- "#$repo--${rest#/}" <<<"$have" && { echo "#$repo--${rest#/}"; return 0; };;
    @*) grep -m1 -E -- "^#$repo-${rest#@}-[a-z0-9]{4}\$" <<<"$have" && return 0;;
  esac
  grep -qxF -- "#$repo" <<<"$have" && { echo "#$repo"; return 0; }
  echo "${CC_MODEL_RETURN_CHANNEL:-#${CC_BOX:-$(hostname -s)}}"; }
card_text(){ printf '[return] %s: %s is back and this session is on %s — :+1: hands it back (a successor alongside, then cutover)' "$1" "$(label "$PRIMARY")" "$(label "$2")"; }
card(){   # $1 window · $2 the model it is on → ONE card in its channel; 0 when it went. THE HEAD `[return] <window>:` IS
          # WHAT cc-slack MATCHES a 👍 against (its RETURN_RE) — change one, change both. From the timer the caller is
          # no session, so cc-slack hands the card to nobody (wake_channel: not-a-session): the owner is its reader.
  local w="$1" lm="$2" chan ts
  chan=$(return_chan "$w")
  ts=$("$BIN/cc-slack" post -c "$chan" --major "$(card_text "$w" "$lm")" 2>/dev/null </dev/null | head -1) || ts=""
  [ -n "$ts" ] || { printf '%s\t%s\tcard-failed\t%s\t%s:%s → %s\n' "$(date -u +%FT%TZ)" "$now" "$PRIMARY" "$SESSION" "$w" "$chan" >> "$LOG"; return 1; }
  note_returned "$w" card "$chan $ts"
  printf '%s\t%s\tcard\t%s\t%s:%s (%s) → %s %s\n' "$(date -u +%FT%TZ)" "$now" "$PRIMARY" "$SESSION" "$w" "$lm" "$chan" "$ts" >> "$LOG"; }
launch_return(){   # $1 window · $2 the model it is on · $3 why → `cc-handoff --overlap`: the successor comes up on
                   # `current` (the primary, the override being gone), reads the journal, cuts over. cc-handoff refuses
                   # an open overlap, a missing window and a worker's pane, and its line is the log row's.
  local w="$1" lm="$2" why="$3" out rc
  out=$("$BIN/cc-handoff" --overlap "$w" 2>&1 </dev/null); rc=$?
  printf '%s\t%s\thandoff\t%s\t%s:%s (%s) — %s: %s\n' "$(date -u +%FT%TZ)" "$now" "$PRIMARY" "$SESSION" "$w" "$lm" "$why" "$(head -1 <<<"$out" | head -c 200)" >> "$LOG"
  [ "$rc" = 0 ] && note_returned "$w" handoff "$why"; return "$rc"; }
return_session(){   # $1 pane · $2 window · $3 the model it is on · $4 "row" when $MOVED says the box moved it off the
                    # primary → the lift's way back for a session that belongs on the primary: 0 when a handoff was
                    # launched or a card went, 1 when nothing was to be done. A row, or a major window, is a handoff
                    # unasked; a rowless minor one asks with a card (see THE FABLE BAND COMES BACK BY HANDOFF).
  local w="$2" lm="$3" row="${4:-}"
  case "$w" in *~*) return 1;; esac   # mid-handoff already: its successor comes up on `current`
  returned_recently "$w" && return 1  # once per outage: a second flip inside the gap sends nothing twice
  if [ -n "$row" ] || major "$w"; then launch_return "$w" "$lm" "$(label "$PRIMARY") is back$([ -n "$row" ] && echo ' (it was moved off it)')"; else card "$w" "$lm"; fi; }
return_cmd(){   # `cc-model return <window>`: the owner's 👍 on a card (cc-slack runs it), or a person by hand. A session
                # already on the primary is never handed off; one with no live pane has nothing to hand off.
  local w="${1:-}" id lm
  id=$(sessions | awk -v w="$w" '$2==w{print $1; exit}')
  [ -n "$id" ] || { echo "cc-model: no live session in $SESSION:$w"; return 1; }
  lm=$(live_model "$id" "$FALLBACK")   # no record, no --model: the card went because the lift saw it off the primary
  [ "$(fam "$lm")" = "$(fam "$PRIMARY")" ] && { echo "cc-model: $w is on $(label "$PRIMARY") already — nothing to hand off"; return 0; }
  launch_return "$w" "$lm" "thumbs-up" && { echo "cc-model: $w — handoff to $(label "$PRIMARY") started"; return 0; }
  echo "cc-model: $w — handoff not started ($(awk -F'\t' '$3=="handoff"{l=$5} END{print l}' "$LOG" | sed 's/.*: //'))"; return 1; }
type_into(){   # $1 pane id · $2 window name · $3 text. cc-msg IS the box's typist — it refuses a headless pane and its
               # dialog guard keeps keystrokes off an open prompt (dialog-never-drops owns that), so this does not
               # reimplement either. It types by WINDOW name, so a split window is typed at its active pane; a claude
               # pane that is NOT its window's active pane is refused here, lands in model-skipped and is retried on a
               # later tick — cc-msg would type the /model line into whatever pane IS active and run it as a command.
               # So does a line cc-msg only QUEUED: spooled is not typed, and a retune nobody typed is not done.
               # The direct tmux path below is for the test session only, where cc-msg's contract (session main, a real
               # interactive claude) cannot hold — the selfcheck and selftest run against `cat` in a scratch server.
  local id="$1" name="$2" text="$3" out
  if [ "$SESSION" = main ] && [ "$PROC" = claude ] && [ -x "$BIN/cc-msg" ]; then
    [ "$(tmux display-message -p -t "$id" '#{pane_active}' 2>/dev/null)" = 1 ] || return 1
    # QUEUED IS NOT TYPED. cc-msg answers rc 0 both when it typed the line and when it only SPOOLED it behind a
    # dialog or a busy pane — that is its contract, and cc-slack, cc-reconcile and cc-handoff read it. But a /model
    # line sitting in a spool has retuned nothing: the "Switch model?" answer below would press at a dialog that
    # is not there, and the drain types the line a minute later with nobody to confirm it, leaving the session on
    # the exhausted model while the log says it switched. Queued = not done: skipped, and retried on a later tick.
    out=$("$BIN/cc-msg" "$name" "$text" 2>/dev/null) || return 1
    [ "$(printf '%s' "$out" | tr -d '\r' | tail -1)" = queued ] && return 1
  else
    tmux capture-pane -p -t "$id" 2>/dev/null | grep -q 'Enter to confirm' && return 1
    tmux send-keys -t "$id" -l -- "$text" 2>/dev/null || return 1
    sleep 0.3; tmux send-keys -t "$id" Enter 2>/dev/null
  fi
  # a /model inside a live conversation asks "Switch model? … 1. Yes" — answer it, or the session sits on that dialog and
  # stays on the model that will not answer (2026-08-28: every session did exactly that after the fallback fired)
  sleep "${CC_MODEL_DIALOG_WAIT:-1.5}"
  if tmux capture-pane -p -S -20 -t "$id" 2>/dev/null | grep -q 'Switch model?'; then
    tmux send-keys -t "$id" -l -- "1" 2>/dev/null; sleep 0.3; tmux send-keys -t "$id" Enter 2>/dev/null; fi
  return 0; }
# ── THE CLI'S OWN LIMIT PROMPT ────────────────────────────────────────────────────────────────────────────────────
# It is not a log line to be confirmed by a probe: it is the CLI saying, in the pane, that the model the session is on
# is out and offering to spend usage credits. Reading it is worth care in both directions — miss it and every session
# sits there delivering nothing (2026-09-01: a pulse tick and two secretary findings), fire on prose and the box moves
# to the fallback for a day it did not need.
# THE WORDING IS READ AS A SHAPE, NOT AS A SENTENCE (2026-09-01, the review of #155). This file's own header quotes
# every trigger phrase; so do the fixtures below, the track brief and half of docs/. A bare sentence anywhere in a pane
# would mean that a session which cats, greps or diffs any of them moves the whole box to the fallback for a day — and
# then never comes back, because the same text is what tells the probe it cannot tell. So a match needs an ANCHOR: the
# dialog's footer ON ITS OWN LINE, or the notice's ● at the START of one, with the wording inside that anchor's own few
# lines, and the anchor itself in the LIVE screen tail. Prose that quotes the prompt has the words but never the shape.
# The footer is a LINE OF ITS OWN — decoration ("·", "↵") may follow it, letters may not: that is what tells the
# dialog apart from any prose, doc bullet or diff hunk that merely quotes it.
PROMPT_FOOT='^[[:space:]]*([Ee]nter to confirm([^A-Za-z]+[Ee]sc to cancel)?|[Ee]sc to cancel)[^A-Za-z]*$'
#   "You've reached your Fable 5 limit"                            the dialog's first line
#   "Fable 5 limit reached · continuing on Fable 5 uses …"         the notice it leaves when nobody answered
#   "Continuing on Fable 5 uses usage credits — you have CA$0.00"  the line under either
# The digits-only gap before "limit reached" is what keeps every worker pane out: "Opus 5 … step limit reached" is a
# turn cap, not a limit, and it is on screen all day.
PROMPT_RE='reached your (claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* ?limit|(fable|opus|sonnet|haiku) ?[0-9.]* ?limit reached|continuing on (claude-)?(fable|opus|sonnet|haiku)[a-z0-9. ()-]{0,20}uses usage credits'
pane_text(){   # THE LIVE SCREEN of a pane — never -S scrollback. What the session is sitting on now is the prompt;
               # what has scrolled off is history, or somebody reading this file in their pane.
  tmux capture-pane -p -t "${1:-}" 2>/dev/null; }
prompt_norm(){   # a pane's text → plain ASCII lines, the CLI's two marks spelled out, the blank rest of the screen
                 # dropped — so that a LINE can be matched as a line (a box border is decoration, not content).
  sed -e 's/●/@DOT@ /g' -e 's/❯/@SEL@ /g' <<<"${1:-}" | tr -cd '\11\12\40-\176' |
    awk '{ sub(/[[:space:]]+$/, ""); l[NR]=$0; if ($0 != "") last=NR } END{ for (i = 1; i <= last; i++) print l[i] }'; }
prompt_fam(){   # $1 = a pane's live screen → the family the CLI says is out, or nothing (exit 1). THE MODEL COMES FROM
                # THE WORDING, never from the pane at large: the option line names the model being OFFERED ("Switch to
                # Opus 5 (1M context) and continue"), and taking the last model on screen read the Fable limit as Opus's.
  local t n a kind lo hi win hit
  t=$(prompt_norm "${1:-}"); n=$(grep -c '' <<<"$t")
  while IFS=: read -r a kind; do   # the lowest anchor first: the live one is the one at the bottom of the screen
    [ -n "${a:-}" ] || continue
    [ $((n - a)) -le "${CC_MODEL_PROMPT_TAIL:-12}" ] || continue   # scrolled well past: history, or someone's `cat`
    case "$kind" in
      foot) lo=$((a - 10)); hi=$a;;   # the box that footer closes: "You've reached your Fable 5 limit … Enter to confirm"
      *)    lo=$a; hi=$((a + 2));;    # the notice line and its wrap: "● Fable 5 limit reached · continuing on Fable 5 …"
    esac
    [ "$lo" -ge 1 ] || lo=1
    win=$(sed -n "${lo},${hi}p" <<<"$t" | tr -s '[:space:]' ' ')   # the dialog is drawn in a box and wraps: flatten it
    # THE BAIL IS THIS ANCHOR'S OWN WINDOW, NOT THE WHOLE SCREEN (2026-09-02, the second review of #155): another
    # dialog owns the pane only if the box THIS footer closes is that dialog. Grepping the screen threw away a real
    # limit dialog drawn under an assistant line ending "Do you want to run the tests first?" — the 2026-09-01
    # failure this exists to catch, not a false positive. The marker is option 3 of a tool dialog, which sits inside
    # the box above its footer and is the one cc-msg's guard keeps when the box outgrows the pane: it is in a
    # permission dialog's own window and in no prose that merely quotes the limit wording.
    grep -qiF 'no, and tell claude what to do differently' <<<"$win" && continue   # that box is a permission prompt
    hit=$(grep -oiE "$PROMPT_RE" <<<"$win" | head -1)
    [ -n "$hit" ] && { fam "$hit"; return 0; }
    # the dialog is open and offers to spend credits but named no model: it is about the model this box runs.
    # ("out of usage credits" is deliberately NOT here — that older wording still goes through the probe below.)
    { [ "$kind" = foot ] && grep -qi 'uses usage credits' <<<"$win"; } && { fam "$PRIMARY"; return 0; }
  done < <( { grep -nE "$PROMPT_FOOT" <<<"$t" | sed 's/:.*/:foot/'
              grep -niE '^[[:space:]]*@DOT@[[:space:]]*(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* ?limit reached' <<<"$t" | sed 's/:.*/:note/'; } | sort -t: -k1,1nr )
  return 1; }
reset_at(){   # $1 = the pane's text → the reset it names, as an epoch. Nothing (exit 1) when it names none — the weekly
              # prompt usually does not — or when it is not a plausible wait (already past, or more than 8 days out).
  local t="${1:-}" raw c e
  raw=$(grep -oiE 'resets?( on| at)?[[:space:]]+[A-Za-z0-9:.,+ -]{2,24}' <<<"$t" | head -1)
  [ -n "$raw" ] || return 1
  raw=$(sed -E 's/^[Rr][Ee][Ss][Ee][Tt][Ss]?( [Oo][Nn]| [Aa][Tt])?[[:space:]]*//; s/[[:space:],.]+$//' <<<"$raw")
  for c in "$raw" "$(cut -d' ' -f1-3 <<<"$raw")" "$(cut -d' ' -f1-2 <<<"$raw")" "$(cut -d' ' -f1 <<<"$raw")"; do
    [ -n "$c" ] || continue
    e=$(date -u -d "$c" +%s 2>/dev/null) || continue
    { [ "$e" -gt "$now" ] && [ $((e - now)) -le 691200 ]; } && { printf '%s\n' "$e"; return 0; }
  done; return 1; }
answer_key(){   # $1 = a pane's live screen → the ONE key that answers the prompt, or nothing (exit 1) when no dialog of
                # OURS is open (its notice is left behind long after). Enter ONLY when the highlighted line is the
                # switch-and-continue option: the other lines are "Manage usage credits on claude.ai" (a browser, not a
                # model) and staying on the limited model, which is the one that spends the credits. Anything else, Esc.
                # THE FOOTER AND THE OPTION LINE HAVE TO BE THE SAME DIALOG (2026-09-01, the review of #155). A tool
                # permission prompt carries the very same footer, and an Enter into one picks its highlighted "1. Yes" —
                # the unattended approval cc-msg's dialog guard exists to prevent. So a permission prompt's own words
                # end this outright, and the footer must sit within a few lines UNDER the option it belongs to: an
                # option line left in the scrollback is not made ours by a footer further down the screen.
                # THE OFFER HAS TO BE THE NEXT RUNG (owner, 2026-09-20: "a dialog that offers Sonnet is answered with
                # Opus, never Sonnet"). $2 is the family the dialog says is out (prompt_fam's answer, read off $1 when
                # the caller has none); the rung after it — chain_next, which steps over a model on record as out —
                # is the one offer Enter may take. "Switch to Sonnet 5 and continue" under a Fable limit is Esc, and
                # the tick then retunes the pane to Opus itself (dialog_retune); under an Opus limit, or with Opus on
                # record as out, Sonnet IS the next rung and Enter is right. $3 = "any": the highlighted offer is taken
                # whatever it is — a member window, which has no rung (see the header). $3 = "floor": none is taken — a
                # planning window whose next rung is below the floor, which Esc leaves parked.
  local t o rest opt="" pf want offered
  t=$(prompt_norm "${1:-}")
  grep -qiE 'do you want to|no, and tell claude what to do differently|would you like to proceed' <<<"$t" && return 1
  pf="${2:-$(prompt_fam "${1:-}")}"; [ -n "$pf" ] || pf=$(fam "$PRIMARY")
  want=$(fam "$(chain_next "$(rung_id "$pf")" 2>/dev/null)")
  [ "${3:-}" = floor ] && want=""   # a planning pane whose next rung is below the floor: no offer is taken, Esc parks it
  while IFS=: read -r o rest; do
    [ -n "${o:-}" ] || continue
    sed -n "$((o + 1)),$((o + ${CC_MODEL_DIALOG_SPAN:-4}))p" <<<"$t" | grep -qE "$PROMPT_FOOT" || continue
    opt=1
    [[ "$rest" =~ ^[[:space:]]*(@SEL@|[>])[[:space:]] ]] || continue
    offered=$(fam "$(grep -oiE 'switch to (claude-)?(fable|opus|sonnet|haiku)' <<<"$rest")")
    { [ "${3:-}" = any ] || { [ -n "$want" ] && [ "$offered" = "$want" ]; }; } && { printf 'Enter\n'; return 0; }
  done < <(grep -niE 'switch to .*continue' <<<"$t")
  [ -n "$opt" ] && { printf 'Escape\n'; return 0; }
  return 1; }
offered_fam(){   # $1 = a pane's live screen → the family its limit dialog offers to switch to, or nothing
  fam "$(prompt_norm "${1:-}" | grep -iE 'switch to .*continue' | grep -oiE 'switch to (claude-)?(fable|opus|sonnet|haiku)' | head -1)"; }
answer_prompt(){   # $1 = pane id → answer that pane's limit prompt, printing the key sent. THE ONE PLACE THIS COMMAND
                   # TOUCHES A PANE DIRECTLY: cc-msg types text and refuses a pane with a dialog open — rightly, a stray
                   # keystroke there is an unattended approval — and it has no key API. One key, and only into a pane
                   # whose own live screen is the CLI's limit prompt, in the shape answer_key insists on.
  local k
  k=$(answer_key "$(pane_text "$1")" "${2:-}" "${3:-}") || return 1
  tmux send-keys -t "$1" "$k" 2>/dev/null || return 1
  sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"   # let the TUI repaint before anything types into the pane again
  printf '%s\n' "$k"; }
nudge(){   # $1 pane · $2 window · $3 the family that refused · $4 the model it is on now · $5 what happened · $6 log detail
           # → the resume line (owner, 2026-09-20: "make sure this switch doesnt make the session pause (a resume
           # message may be needed)"): the pane is at an empty prompt with its turn lost, and one line puts it back to work
  type_into "$1" "$2" "$(label "$3") $5; it is on $(label "$4") now — carry on with what you were doing." >/dev/null &&
    printf '%s\t%s\tnudged\t%s\t%s:%s %s\n' "$(date -u +%FT%TZ)" "$now" "$4" "$SESSION" "$2" "$6" >> "$LOG"; }
dialog_retune(){   # $1 pane · $2 window · $3 the family its limit dialog named → after Esc: the pane is retuned to the
                   # next rung HERE, in every state (the box may already be on the override, and branch (2) does not
                   # run then), banked `moved` off $3 so the lift returns it, and nudged — Esc ate its turn. Busy or
                   # refused: model-skipped, and the notice the CLI leaves is read again next tick.
  local id="$1" name="$2" pf="$3" lm nx
  moved_by_box "$id" "$pf" && return 0
  lm=$(live_model "$id" "$(rung_id "$pf")"); [ "$(fam "$lm")" = "$pf" ] || lm=$(rung_id "$pf")
  nx=$(chain_next "$(rung_id "$pf")") &&
    planning "$name" && below_floor "$nx" && { park "$id" "$name" "$lm" "$pf" "its limit dialog offered $(label "$nx")"; tell_parked "$(label "$pf") limit"; return 0; }
  nx=$(chain_next "$(rung_id "$pf")") || { printf '%s\t%s\trefusal\t%s\t%s:%s — nothing after %s on the chain\n' "$(date -u +%FT%TZ)" "$now" "$lm" "$SESSION" "$name" "$pf" >> "$LOG"; return 1; }
  if ! type_into "$id" "$name" "/model $nx"; then
    printf '%s\t%s\tskip\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$nx" "$SESSION:$name busy or unreachable after its dialog" >> "$LOG"
    printf '%s\n' "$id" >> "$ST/model-skipped"; return 1; fi
  note_moved "$id" "$name" "$lm" moved "$pf"; drop_returned "$name"
  printf '%s\t%s\tretune\t%s\t%s:%s (%s) was on %s — its limit dialog offered another rung, Esc\n' "$(date -u +%FT%TZ)" "$now" "$nx" "$SESSION" "$name" "$id" "$lm" >> "$LOG"
  nudge "$id" "$name" "$pf" "$nx" "hit its limit and the dialog offered the wrong model" "after its $(label "$pf") dialog"; }
prompt_panes(){   # every live session showing it: "<pane-id>\t<window>\t<family>\t<reset-epoch|0>"
  local id name cap f e
  while read -r id name; do [ -n "${id:-}" ] || continue
    cap=$(pane_text "$id")
    f=$(prompt_fam "$cap") || continue
    e=$(reset_at "$cap") || e=0
    printf '%s\t%s\t%s\t%s\n' "$id" "$name" "$f" "$e"
  done < <(sessions); }
# THE CLI'S OWN "REQUIRES USAGE CREDITS" LINE — the three shapes it draws, off live panes on this box (2026-09-15):
#   "  │ Fable 5.1 requires usage credits. Switch to another model, or manage usage credits at claude.ai/…"  (a box)
#   "● Switched to Sonnet 5 for this session · Fable 5.1 requires usage credits · /model to change"  (it moved itself)
#   "  ⎿  You've hit your monthly spend limit · your weekly limit resets 10pm (America/Los_Angeles)"  (the cap)
# Read as a SHAPE like the limit prompt above: the sentence STARTS the line (after the CLI's mark, or its own
# "Switched to … ·" preface), inside the live tail, and BELOW the last "Set model to" — a retune typed after it
# makes it history. A doc, a journal or this file in a pager quotes the words mid-line and never starts one with them.
CREDITS_LINE_RE='^[[:space:]]*(@DOT@[[:space:]]*(switched to [a-z0-9. ]+ for this session[^a-z]+)?)?((claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* requires usage credits|you.?ve hit your monthly spend limit)'
live_line(){   # $1 = a pane's live screen · $2 = a line RE · $3 = wrap lines to take with it → the last such line, when
               # it is live (exit 1: none, or history — scrolled past CC_MODEL_CREDITS_TAIL, or above the last "Set model to")
  local t n a s
  t=$(prompt_norm "${1:-}"); n=$(grep -c '' <<<"$t")
  a=$(grep -niE "$2" <<<"$t" | tail -1 | cut -d: -f1); [ -n "$a" ] || return 1
  [ $((n - a)) -le "${CC_MODEL_CREDITS_TAIL:-20}" ] || return 1
  s=$(grep -n 'Set model to ' <<<"$t" | tail -1 | cut -d: -f1); { [ -n "$s" ] && [ "$s" -gt "$a" ]; } && return 1
  sed -n "${a},$((a + ${3:-0}))p" <<<"$t" | tr -s '[:space:]' ' '; }
credits_line(){ live_line "${1:-}" "$CREDITS_LINE_RE" 0; }   # $1 = a pane's live screen → that line, when it is live
# A LINE IS READ ONCE (2026-09-21): an idle pane keeps its refusal line on screen for hours. Each time the record was
# forgotten (the probe answered at 17:17, 17:32, 17:48Z) the next tick read main:lessons' old spend-cap line as a new
# refusal and put Opus out again, so every session flipped down and up every 15 min on a probe that was right. The line
# a tick acts on is remembered per pane, by itself and the lines above it; only a new line (a new turn refused) counts.
credits_key(){ grep -iE -B6 "$CREDITS_LINE_RE" <<<"$(prompt_norm "${1:-}")" | tail -7 | md5sum | cut -c1-16; }   # $1 = screen
credits_seen(){ awk -F'\t' -v p="$1" -v k="$2" '$1==p && $2==k{y=1} END{exit !y}' "$ST/model-credits-seen" 2>/dev/null; }   # $1 pane · $2 key
note_credits_seen(){ { awk -F'\t' -v p="$1" '$1!=p' "$ST/model-credits-seen" 2>/dev/null; printf '%s\t%s\t%s\n' "$1" "$2" "$now"; } > "$ST/model-credits-seen.t" &&
  mv "$ST/model-credits-seen.t" "$ST/model-credits-seen"; }
# THE SAFEGUARDS DIALOG AND THE LINE IT LEAVES (1d) — the shipped CLI's own strings (2.1.278, refusal_fallback_preference_prompt;
# nothing on this box has a capture of the screen, the ece231 seat's was gone by the time anyone looked):
#   header   "Model switch"
#   question "Fable 5.1's safeguards flagged this message. Our intentionally broad safeguards … Switch to Opus 5 and keep going
#             whenever this happens? You can change this later in /config."
#   choices  "1. Switch automatically — Continue on Opus 5 now, and switch without asking from now on" · "2. Stay on Fable 5.1"
#   after    "● Fable 5.1's safeguards flagged this message. … Switched to Opus 5. Send feedback with /feedback …"
#            or "… This response was generated by Opus 5 instead. Your session model is unchanged. …" (nothing to do)
# The dialog is known by its SHAPE: the question line, then the "Switch automatically" choice within a few lines under it,
# then "Stay on …" under that, all in the live tail — the after-line quotes the question and has neither choice.
FLAG_Q_RE='safeguards flagged this message'
FLAG_OPT_RE='^[[:space:]]*(@SEL@|[>])?[[:space:]]*[0-9]*\.?[[:space:]]*'
FLAG_LINE_RE='^[[:space:]]*(@DOT@[[:space:]]*)?(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]*.?s safeguards flagged this message'
flag_key(){   # $1 = a pane's live screen → the key that answers the safeguards dialog: Enter when "Switch automatically" is
              # the highlighted line, "1" when it is not (a digit picks it; the caller adds Enter only while the dialog
              # still stands), nothing (exit 1) when no such dialog is live. A permission prompt's words end it outright.
  local t n o lo
  t=$(prompt_norm "${1:-}"); n=$(grep -c '' <<<"$t")
  grep -qiE 'do you want to|no, and tell claude what to do differently|would you like to proceed' <<<"$t" && return 1
  o=$(grep -niE "${FLAG_OPT_RE}switch automatically([[:space:]]|\$)" <<<"$t" | tail -1 | cut -d: -f1); [ -n "$o" ] || return 1   # the label alone, or with its description on the same line
  [ $((n - o)) -le "${CC_MODEL_PROMPT_TAIL:-12}" ] || return 1
  lo=$((o - 8)); [ "$lo" -ge 1 ] || lo=1
  sed -n "${lo},$((o - 1))p" <<<"$t" | grep -qiE "$FLAG_Q_RE" || return 1
  sed -n "$((o + 1)),$((o + 4))p" <<<"$t" | grep -qiE "${FLAG_OPT_RE}stay on " || return 1
  if sed -n "${o}p" <<<"$t" | grep -qE '^[[:space:]]*(@SEL@|[>])[[:space:]]'; then printf 'Enter\n'; else printf '1\n'; fi; }
flag_panes(){   # (1d) every live session on the safeguards dialog is answered "Switch automatically" — the owner's YES
                # (2026-09-20): the CLI moves it to its own fallback and stores the answer, so it never asks again.
  local id name k
  while read -r id name; do [ -n "${id:-}" ] || continue
    k=$(flag_key "$(pane_text "$id")") || continue
    tmux send-keys -t "$id" "$k" 2>/dev/null || continue
    sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"
    if [ "$k" = 1 ] && flag_key "$(pane_text "$id")" >/dev/null; then   # the digit picked the line; Enter takes it only while the dialog still stands
      tmux send-keys -t "$id" Enter 2>/dev/null; sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"; fi
    printf '%s\t%s\tanswered\t%s\t%s: safeguards dialog — Switch automatically (%s)\n' "$(date -u +%FT%TZ)" "$now" "$(fam "$PRIMARY")" "$SESSION:$name" "$k" >> "$LOG"
  done < <(sessions); }
# THE AUTO-MODE CONFIRM DIALOG (1e) — owner, 2026-09-21: "in autonomous modes we need ways to automatically overcome
# dialogs like this". After a run of blocked actions the classifier stops deciding and puts the call to a person:
#   "Auto mode classifier requires confirmation for this command." · "Do you want to proceed?" · "1. Yes" · "2. No"
# (his screenshot; nothing on this box has a capture). A seat sitting on it delivers nothing until someone answers.
# THE COMMAND COMES FROM THE SEAT'S OWN TRANSCRIPT — its last tool call with no result yet — never from the screen,
# which wraps and cuts it; the screen must still show that command's start, or the box does not know what is asked.
# The box answers Yes ONLY for a read-only call (confirm_readonly: a short list, anything else is not). Every other
# call — and one it could not read — goes to the owner as a 🔐 card in the -threads lane (`cc-slack grant confirm`,
# #556's card): the daemon writes his yes/no to $ST/confirm-answers/<id>, and a later tick presses that answer while
# the same dialog, for the same call, still stands — or, when the box could not read the call, while the pane still
# looks exactly as it did on the card. His answer is dropped only once it has gone in, so a dialog the box could not
# submit to is not carded again on the next tick. After his No the seat is told not to try another route to it.
# Nothing here widens what the classifier allows: one call, answered once, and a write only on his word.
CONFIRM_Q_RE='classifier requires confirmation'
confirm_opt(){   # $1 = a pane's live screen · $2 Yes|No → the digit of that choice on the confirm dialog, or nothing (exit 1)
                 # when no such dialog is live: the classifier line, "Do you want to proceed?", then "N. Yes" and "N. No"
                 # in the live tail — prose that quotes the wording has no numbered choices under it.
  local t n y o lo
  t=$(prompt_norm "${1:-}"); n=$(grep -c '' <<<"$t")
  o=$(grep -niE "^[[:space:]]*(@SEL@|[>])?[[:space:]]*[0-9]\.[[:space:]]*no([,[:space:]].*)?\$" <<<"$t" | tail -1 | cut -d: -f1); [ -n "$o" ] || return 1
  [ $((n - o)) -le "${CC_MODEL_PROMPT_TAIL:-12}" ] || return 1
  lo=$((o - 12)); [ "$lo" -ge 1 ] || lo=1
  sed -n "${lo},${o}p" <<<"$t" | grep -qiE "$CONFIRM_Q_RE" || return 1
  sed -n "${lo},${o}p" <<<"$t" | grep -qiE 'do you want to proceed' || return 1
  # Yes is the bare "Yes" line and nothing longer: "Yes, and don't ask again" would widen what the classifier allows
  if [ "${2:-Yes}" = No ]; then y=$(sed -n "${o}p" <<<"$t" | sed -nE 's/^[^0-9]*([0-9])\..*/\1/p')
  else y=$(sed -n "${lo},${o}p" <<<"$t" | sed -nE "s/^[[:space:]]*(@SEL@|[>])?[[:space:]]*([0-9])\.[[:space:]]*yes\$/\2/Ip" | tail -1); fi
  [ -n "$y" ] && printf '%s\n' "$y"; }
transcript_of(){   # $1 pane id → the seat's transcript file, as its cc-statusline record names it (the --session-id in
                   # the claude child's argv names the record, as live_model reads it), or nothing
  [ -n "${CC_MODEL_TRANSCRIPTS:-}" ] && { printf '%s\n' "$CC_MODEL_TRANSCRIPTS/$1.jsonl"; return 0; }   # test hook: <dir>/<pane>.jsonl
  local pp c sid
  pp=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null); c=$(pgrep -P "${pp:-0}" -x "$PROC" 2>/dev/null | head -1)
  [ -n "$c" ] && [ -r "/proc/$c/cmdline" ] || return 1
  sid=$(tr '\0' '\n' < "/proc/$c/cmdline" | grep -A1 -x -- '--session-id' | tail -1); [ -n "$sid" ] || return 1
  jq -r '.raw.transcript_path // empty' "$(sldir)/$sid.json" 2>/dev/null; }
pending_calls(){   # $1 pane id → every call of the seat's LAST message that still has one unresolved, one "<tool>\t<command>"
                   # per line IN THE ORDER THE CLI RUNS THEM — so the dialog is about the FIRST of them (the review of #586:
                   # a message [Bash `rm -rf build`, Bash `ls`] is asking about the rm, and `ls` is queued behind it).
                   # @tsv spells a newline \n, and confirm_readonly refuses any backslash: a multi-line call is never read-only
                   # THE MESSAGE IS ITS .message.id, NOT ITS RECORD (the review of #586): the CLI writes every content
                   # block of one message as its own JSONL line under the one id, so a record-by-record "last message"
                   # holds the last block alone — [Bash `rm -rf build`, Bash `ls`] would come back as `ls` and read as
                   # read-only. The blocks are grouped by that id, the record standing in where a line carries none.
  local f; f=$(transcript_of "$1") || return 1; [ -r "$f" ] || return 1
  tail -n 200 "$f" | jq -rs '[to_entries[] | select((.value.message? | type) == "object")
      | {k: (.value.message.id // ("#" + (.key | tostring))), c: .value.message.content}
      | select((.c | type) == "array")] as $m
    | [$m[] | .c[] | select(.type == "tool_result") | .tool_use_id] as $done
    | [$m[] | {k: .k, u: [.c[] | select(.type == "tool_use") | select(.id as $i | $done | index($i) | not)]}
      | select(.u | length > 0)] as $p
    | ($p | last | .k) as $last
    | $p[] | select(.k == $last) | .u[] | [.name, (.input.command // .input.file_path // .input.pattern // "")] | @tsv' 2>/dev/null; }
pending_call(){ pending_calls "$1" | head -1; }   # the one the dialog names: the screen check and press_confirm's re-check are its
calls_readonly(){   # stdin: pending calls, one per line → 0 only when there is at least one and EVERY one of them reads.
                    # The seat runs a message's calls in order behind the one dialog, so a Yes on the first releases the
                    # rest unasked: one write among them makes the whole message the owner's (the review of #586).
  local l n=0
  while IFS= read -r l; do [ -n "$l" ] || continue; n=$((n + 1))
    confirm_readonly "${l%%$'\t'*}" "${l#*$'\t'}" || return 1
  done
  [ "$n" -gt 0 ]; }
confirm_words(){   # $1 a command line → the words THE SHELL WOULD HAND THE COMMANDS, one "W<word>" per line, with an
                   # "S" where a `;`, `|`, `||` or `&&` outside quotes ends a segment. Exit 1 — so, not read-only —
                   # when the text cannot be read as words at all (an unbalanced quote, a backslash), carries a
                   # REDIRECTION that is not a bare fd duplication or a write to /dev/null (see the pass below), holds
                   # a punctuation run this list does not handle (`&`, `(`, `)`, `;;`, `|&`), or carries a
                   # `{}[]*?()` METACHARACTER OUTSIDE QUOTES — the quote state for that last one is tracked in the
                   # same left-to-right pass, and not by cutting the quoted spans out (the sixth review of #586).
                   # THE SEGMENT SPLIT HAS TO BE QUOTE-AWARE (the fifth review of #586). A `tr ';' '\n'` over the
                   # raw text cut `sed -n '1p;wc' f` into `sed -n '1p` and `wc' f`, and each half reads on its own —
                   # while the shell hands sed the ONE script `1p;wc`, which GNU sed runs as `w c`: every line of f
                   # written to ./c. `'1p;which'` writes ./hich the same way. shlex cuts on those separators only
                   # outside quotes, so what is judged below is the argv each command actually gets.
                   # A word that is nothing BUT punctuation is read as a separator even when it was quoted, because
                   # the token looks identical either way: `grep ';' f` becomes an owner card, never a Yes.
  python3 - "$1" <<'PY'
import shlex, sys
s = sys.argv[1]
# THE QUOTE STATE IS TRACKED A CHARACTER AT A TIME (the sixth review of #586). Cutting the quoted spans out with a sed
# apiece — every '…' first, then every "…" — pairs a ' in one double-quoted word with a ' in a later one and swallows
# everything between: `find . "a'" {-delete,-name} "'b"` came out of the two seds as `find . ""` with no brace left to
# see, so the word list below showed `{-delete,-name}`, which starts with no dash and matched no check, and the shell
# ran `find . a' -delete -name 'b`. So: a ' inside "…" and a " inside '…' are ordinary characters, and a metacharacter
# OUTSIDE quotes — {a,b} brace expansion, a * ? [ ] glob that can expand to an option, a ( subshell ) — rewrites a word
# before any command sees it and is refused here, where the state is already known.
# A REDIRECTION IS READ IN THIS SAME PASS (the seventh review of #586), never stripped out by a regex first. The strip
# was `s#[0-9]?>&[0-9]##g`, which takes `>&` and ONE digit even when the word runs on: `cat a >&1.txt` came out as the
# text `cat a .txt` and read as two files to read, while bash sends stdout and stderr to the FILE ./1.txt whenever the
# word after `>&` is not all digits. So the operator, the fd glued in front of it and its target are parsed here, where
# the quote state and what is glued to what are both already known, and only two shapes live: a bare fd duplication
# (`2>&1`, `>&2`, `1>&2`) and a write to /dev/null (`2>/dev/null`, `>>/dev/null`, `&>/dev/null`). EVERY OTHER ONE EXITS
# 1 — another target, `>`, `>>`, `<`, `<>`, `>|`, `&>`, `>&word`, a here-doc, a here-string — and the owner gets a card.
DIG = '0123456789'
q = ''; keep = []; word = []; i = 0; n = len(s)
while i < n:
    ch = s[i]
    if ch == '\\': sys.exit(1)          # an escape hides the next character from this pass (and from every check below)
    if q:
        if ch == q: q = ''
        keep.append(ch); word.append(('q', ch)); i += 1; continue
    if ch in ('"', "'"):
        q = ch; keep.append(ch); word.append(('q', ch)); i += 1; continue
    if ch in '{}[]*?()': sys.exit(1)
    if ch in '<>' or (ch == '&' and s[i+1:i+2] == '>'):
        # `2>f` gives the 2 to the operator, `uniq a 1 >f` does not — bash reads an fd only off digits glued to the
        # operator, and a word dropped that the command was in fact given would hide a write (uniq IN OUT writes OUT)
        if word and all(k == 'p' and c in DIG for k, c in word): del keep[len(keep) - len(word):]
        word = []; op = ''
        if ch == '&': op = '&'; i += 1
        while i < n and s[i] in '<>&|': op += s[i]; i += 1
        while i < n and s[i] in ' \t': i += 1
        tq = ''; tgt = []
        while i < n:                    # the target word, quotes off, up to the whitespace or separator that ends it
            c = s[i]
            if c == '\\': sys.exit(1)
            if tq:
                if c == tq: tq = ''
                else: tgt.append(c)
            elif c in ('"', "'"): tq = c
            elif c.isspace() or c in ';|&<>()': break
            elif c in '{}[]*?': sys.exit(1)
            else: tgt.append(c)
            i += 1
        if tq: sys.exit(1)
        t = ''.join(tgt)
        if not ((op == '>&' and t and all(c in DIG for c in t))
                or (op in ('>', '>>', '&>', '&>>') and t == '/dev/null')): sys.exit(1)
        keep.append(' ')                # the redirection stood between words, and it ends the word before it
        continue
    if ch.isspace() or ch in ';|&': word = []
    else: word.append(('p', ch))
    keep.append(ch); i += 1
if q: sys.exit(1)                       # an unbalanced quote: not text to guess at
lx = shlex.shlex(''.join(keep), posix=True, punctuation_chars=True)
lx.whitespace_split = True
lx.commenters = ''      # `#` is not a comment mid-word, and dropping the rest of a line would hide a write
try: words = list(lx)
except ValueError: sys.exit(1)      # unbalanced quote, trailing backslash: not text to guess at
out = []
for w in words:
    if w in (';', '|', '||', '&&'): out.append('S')
    elif w and not set(w) - set('();<>|&'): sys.exit(1)
    elif '\n' in w or '\r' in w: sys.exit(1)     # one line per call, or the owner reads it
    else: out.append('W' + w)
out.append('S')
sys.stdout.write('\n'.join(out) + '\n')
PY
}
confirm_seg(){   # the words of ONE segment, as the shell hands them to the command → 0 when that command only reads.
                 # EVERY CHECK HERE READS THOSE WORDS, never the raw text (the review of #586: `find . '-delete'`,
                 # `sort '-o' f f` and `git log '--output=/tmp/x'` all came back read-only, because a regex only saw
                 # a dash after a space while the shell took the quotes off and ran the write).
  [ "$#" -gt 0 ] || return 0   # `ls;` ends on an empty segment, which runs nothing
  local -a a=("$@"); local w=${a[0]} x o t i n=0 nf=0 sc=0
  # an option we cannot read as a plain -x / --long=value token is not on this list either: `--include=*.py` is a card
  for x in "${a[@]}"; do case "$x" in -*) [[ $x =~ ^-[-A-Za-z0-9=_,.:/@+%]*$ ]] || return 1;; esac; done
  case "$w" in
    cat|head|tail|grep|egrep|fgrep|wc|ls|stat|cut|tr|nl|jq|echo|pwd|which|readlink|realpath|basename|dirname|diff|cmp|md5sum|sha256sum|du|df|column|true|cd) ;;
    # printf -v assigns into a shell variable a later command could expand into code; read, mapfile and readarray
    # assign the same way and are not on this list at all (the review of #586)
    printf) for x in "${a[@]:1}"; do case "$x" in -v*) return 1;; esac; done;;
    # rg --pre and --hostname-bin run a program of the caller's choosing, and -z/--search-zip spawns a decompressor
    rg) for x in "${a[@]:1}"; do case "$x" in
          --pre|--pre=*|--hostname-bin|--hostname-bin=*|--search-zip) return 1;;
          --*) ;; -*z*) return 1;; esac; done;;
    # sort takes ANY unambiguous shortening of a long option, so --out=f is --output=f and
    # --compress-program runs a program (the review of #586): no long option is read-only here
    sort) for x in "${a[@]:1}"; do case "$x" in --*) return 1;; -*o*) return 1;; esac; done;;
    uniq) for x in "${a[@]:1}"; do case "$x" in -*) ;; *) n=$((n + 1));; esac; done; [ "$n" -le 1 ] || return 1;;   # uniq IN OUT writes OUT
    find) for x in "${a[@]:1}"; do case "$x" in -exec*|-ok*|-delete*|-fprint*|-fls*) return 1;; esac; done;;
    # A SED SCRIPT IS ONE WORD once the shell has split it, so it matches IN FULL or it is a card (the fifth review
    # of #586): `N[,M]p` and nothing beside it. A `;` in the script, a w/W/r/R/e/s command, anything else, is refused
    # here rather than picked apart — `1p;wc` is sed's `w c`, and `1p;which` is `w hich`.
    sed) for x in "${a[@]:1}"; do
           if [ "$sc" = 0 ]; then
             case "$x" in
               -*) [[ $x =~ ^-[nE]+$ ]] || return 1; case "$x" in *n*) nf=1;; esac;;
               *) [[ $x =~ ^[0-9]+(,[0-9]+)?p$ ]] || return 1; sc=1;;
             esac
           # …and no option AFTER the script: GNU sed reads `f -i`, `f --in-place` and `f -e '1w x'` too
           else case "$x" in -*) return 1;; esac; fi
         done
         [ "$sc" = 1 ] && [ "$nf" = 1 ] || return 1;;
    git) case "${a[1]:-}" in -C) i=3;; *) i=1;; esac
         case "${a[$i]:-}" in log|show|diff|status|blame|rev-parse|ls-files|grep|cat-file) ;; *) return 1;; esac
         for x in "${a[@]:1}"; do
           case "$x" in
             --) ;;   # `git log -- path` names paths, it is not an option
             # git takes any UNAMBIGUOUS PREFIX of a long option, so --open=rm is --open-files-in-pager=rm (the
             # review of #586): every long option whose name prefixes one of these four is refused, the full
             # spellings among them. Tested on the name, not as a bare --o/--ex/--te: `git grep --or` reads.
             --*) o=${x%%=*}; o=${o#--}
                  for t in output ext-diff textconv open-files-in-pager; do case "$t" in "$o"*) return 1;; esac; done;;
             -*O*) return 1;;   # git grep -O<cmd> runs <cmd>
           esac
         done;;
    *) return 1;;
  esac
  return 0; }
confirm_readonly(){   # $1 tool · $2 command → 0 when the call only reads. A SHORT LIST ON PURPOSE: what it does not know is
                      # not read-only, and the owner is asked — a false card costs him a tap, a false Yes is a write.
  case "${1:-}" in Read|Grep|Glob|LS|NotebookRead) return 0;; Bash) ;; *) return 1;; esac
  local c words line; local -a toks=()
  c=${2:-}   # THE TEXT AS IT IS: a redirection is judged by confirm_words, in the pass that knows the quoting (below)
  [ -n "${c//[[:space:]]/}" ] || return 1
  # ANY $ IS REFUSED (the review of #586): `printf -v x '%s(touch p)' '$'; cat ${x@P}` builds a substitution out of
  # expansions with no `$(` in its text, and prompt expansion then runs it. A read-only command that needs an expansion
  # — `echo $HOME`, `sed -n '1,$p' f` — becomes an owner card instead, which costs him a tap; a Yes on code built by
  # expansion is not something this list can take back.
  grep -qE '[$`\\]' <<<"$c" && return 1   # a $ of any kind, a command substitution, an escape: not this list's
  # A METACHARACTER OUTSIDE QUOTES REWRITES A WORD before any command sees it, and the word list below shows only the
  # result. confirm_words refuses one, in the ONE quote-tracking pass that also finds the words — this was two seds
  # cutting the quoted spans out, and a quote in one word paired with a quote in a later one and hid the brace between
  # them (the sixth review of #586). A REDIRECTION IS THAT SAME PASS'S TOO (the seventh review): it was stripped out
  # here by a regex that took `>&1` out of `cat a >&1.txt` and left a read of two files. $, ` and \ went above, and
  # there is no second reading of the text left here.
  words=$(confirm_words "$c") || return 1   # the shell's own words, the segments cut only outside quotes, no bare metacharacter, no write
  while IFS= read -r line; do
    case "$line" in
      W*) toks+=("${line#W}");;
      S) confirm_seg "${toks[@]}" || return 1; toks=();;
      *) return 1;;
    esac
  done <<<"$words"
  return 0; }
confirm_row(){ awk -F'\t' -v p="$1" -v k="$2" '$1==p && $2==k{print $3 "\t" $5; exit}' "$ST/model-confirms" 2>/dev/null; }   # $1 pane · $2 call key → "<its open card's id>\t<the screen he was shown>"
drop_confirm(){ [ -f "$ST/model-confirms" ] && { awk -F'\t' -v p="$1" '$1!=p' "$ST/model-confirms" > "$ST/model-confirms.t" && mv "$ST/model-confirms.t" "$ST/model-confirms"; }; return 0; }
scr_hash(){ printf '%s' "${1:-}" | md5sum | cut -c1-16; }   # a pane's screen → the short hash the confirm row keeps of it
press_confirm(){   # $1 pane · $2 Yes|No · $3 the call it answers · $4 the screen's hash when the card was raised → the
                   # digit, then Enter only while the dialog still stands FOR THAT SAME CALL: a new dialog behind it
                   # highlights Yes, and a blind Enter would approve it. 0 when the answer went in, 1 when it did not —
                   # the caller keeps the owner's answer and the card's row for a later tick on a 1, so nothing is
                   # logged as answered that was not (the sixth review of #586).
                   # A CALL THE BOX COULD NOT READ ($3 empty) HAS NO SECOND WITNESS, so the SCREEN is one: the pane must
                   # still look exactly as it did when the owner was asked ($4). Without that the digit went in with no
                   # Enter behind it, the dialog stood, and the answer was deleted and the card raised again every tick.
  local k scr; scr=$(pane_text "$1")
  k=$(confirm_opt "$scr" "$2") || return 1
  [ -n "$3" ] || { [ -n "${4:-}" ] && [ "$(scr_hash "$scr")" = "$4" ]; } || return 1
  tmux send-keys -t "$1" "$k" 2>/dev/null || return 1
  sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"
  if confirm_opt "$(pane_text "$1")" "$2" >/dev/null; then   # the digit alone did not take it
    { [ -z "$3" ] || [ "$(pending_call "$1")" = "$3" ]; } || return 1   # another call behind it now: not this answer's dialog
    tmux send-keys -t "$1" Enter 2>/dev/null; sleep "${CC_MODEL_ANSWER_WAIT:-0.5}"; fi
  printf '%s\n' "$k"; }
confirm_panes(){   # (1e) every live seat on the confirm dialog: a read-only call answered Yes, any other put to the owner
                   # once, and his answer pressed. A member window is left to its own route (its prompts go to -threads).
  local id name scr calls call cmd what key row rid shot ans out dir="$ST/confirm-answers"
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue
    scr=$(pane_text "$id")
    confirm_opt "$scr" Yes >/dev/null || { drop_confirm "$id"; continue; }   # answered, by anyone: its card's row goes
    calls=$(pending_calls "$id"); call=$(head -1 <<<"$calls"); cmd=${call#*$'\t'}
    { [ -n "$call" ] && [ -n "$cmd" ] && grep -qF -- "$(printf '%s' "${cmd%%\\n*}" | tr -s '[:space:]' ' ' | cut -c1-40)" <<<"$(tr -s '[:space:]' ' ' <<<"$scr")"; } || call=""
    # every call of that message, the one the dialog names first: a Yes on it releases the ones queued behind it too
    if [ -n "$call" ]; then what=$(awk -F'\t' '{printf "%s%s: %s", (NR > 1 ? " · " : ""), $1, $2} END{print ""}' <<<"$calls")
    else what='a command the box could not read off the transcript — look at the pane'; fi
    # the brief: "the box may answer Yes on its own only when the command behind the dialog is read-only" — which now
    # means every call that Yes releases, not the first alone (the review of #586)
    if [ -n "$call" ] && calls_readonly <<<"$calls"; then
      press_confirm "$id" Yes "$call" >/dev/null &&
        printf '%s\t%s\tconfirm\t%s\t%s: confirm dialog — read-only, Yes: %s\n' "$(date -u +%FT%TZ)" "$now" "$(fam "$PRIMARY")" "$SESSION:$name" "${what:0:200}" >> "$LOG"
      continue; fi
    key=$(printf '%s' "$what" | md5sum | cut -c1-16); row=$(confirm_row "$id" "$key"); rid=${row%%$'\t'*}; shot=${row#*$'\t'}
    if [ -z "$rid" ]; then   # not read-only: the owner's word, asked once per dialog
      out=$("$BIN/cc-slack" grant confirm "$what" -w "$name" 2>&1 </dev/null)
      rid=$(grep -oE '^card [a-km-z]{5}' <<<"$out" | cut -c6-)
      if [ -z "$rid" ]; then printf '%s\t%s\tcard-failed\t%s\t%s: confirm card not raised — %s\n' "$(date -u +%FT%TZ)" "$now" "$(fam "$PRIMARY")" "$SESSION:$name" "${out:0:200}" >> "$LOG"; continue; fi
      drop_confirm "$id"   # the screen rides along: for a call the box could not read it is all press_confirm has to go on
      printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$key" "$rid" "$now" "$(scr_hash "$scr")" >> "$ST/model-confirms"
      printf '%s\t%s\tconfirm\t%s\t%s: confirm dialog — not read-only, carded %s: %s\n' "$(date -u +%FT%TZ)" "$now" "$(fam "$PRIMARY")" "$SESSION:$name" "$rid" "${what:0:200}" >> "$LOG"
      continue; fi
    ans=$(cut -f1 "$dir/$rid" 2>/dev/null); [ -n "$ans" ] || continue   # still the owner's to answer
    if [ "$ans" = yes ]; then press_confirm "$id" Yes "$call" "$shot" >/dev/null || continue
    else press_confirm "$id" No "$call" "$shot" >/dev/null || continue
      type_into "$id" "$name" "The owner did not approve this from Slack: ${what:0:300}. Do not try another route to the same change. Carry on with what does not need it, and say what is blocked." || true; fi
    printf '%s\t%s\tconfirm\t%s\t%s: confirm dialog — the owner answered %s on %s\n' "$(date -u +%FT%TZ)" "$now" "$(fam "$PRIMARY")" "$SESSION:$name" "$ans" "$rid" >> "$LOG"
    rm -f "$dir/$rid"; drop_confirm "$id"
  done < <(sessions); }
flagged_panes(){   # (1d) the line the CLI leaves after ITS switch: a session it put BELOW the next rung — "Switched to
                   # Sonnet 5" with Opus runnable — is retuned up to that rung; nothing is recorded unavailable (the
                   # primary is not out, one message was flagged). One on the next rung is left there: (4) reports it.
  local id name hit pf to nx
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue   # never on the chain: whatever the CLI moved it to is CC_MEMBER_MODEL's business
    hit=$(live_line "$(pane_text "$id")" "$FLAG_LINE_RE" 2) || continue
    to=$(fam "$(grep -oiE 'switched to (claude-)?(fable|opus|sonnet|haiku)' <<<"$hit")"); [ -n "$to" ] || continue   # "Your session model is unchanged"
    pf=$(fam "$(grep -oiE '(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]*.?s safeguards' <<<"$hit")")
    nx=$(chain_next "$(rung_id "$pf")") || continue
    [ "$to" = "$(fam "$nx")" ] && continue
    retuned_recently "$id" && continue
    type_into "$id" "$name" "/model $nx" || continue   # busy: the line is still live next tick
    printf '%s\t%s\tretune\t%s\t%s:%s (%s) — the CLI had moved it to %s after a %s safeguards flag\n' "$(date -u +%FT%TZ)" "$now" "$nx" "$SESSION" "$name" "$id" "$to" "$pf" >> "$LOG"
  done < <(sessions); }
# (0) THE HARNESS SETTINGS THAT DECIDE WHETHER A SESSION PAUSES (see the header). REPORT ONLY, NEVER A WRITE: that
# file holds `permissions` and the hook commands, so nothing automatic replaces it (cc-settings' header, cc-guard's
# secret_path) — until the review of #557 this pass did, with a jq + mv every tick. A key absent or set another way is
# one `setting` row and one line to the owner naming the key and value, once an hour (CC_MODEL_MISMATCH_GAP); (1b)
# and (1d) answer the dialogs meanwhile.
setting_reported(){ local k="${1:-}" t
  t=$(awk -F'\t' -v k="$k=" '$3=="setting" && index($5, k){t=$2} END{print t+0}' "$LOG" 2>/dev/null || echo 0)
  [ "$((now - t))" -lt "${CC_MODEL_MISMATCH_GAP:-3600}" ]; }
settings_guard(){
  local f="${CC_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}" kv k want have msg   # read HERE, not at load: the selfcheck points it elsewhere
  [ -f "$f" ] || return 0   # no harness settings here: not this pass's to create
  for kv in switchModelsOnFlag=true autoContinueAtUsageLimit=false; do
    k="${kv%%=*}"; want="${kv#*=}"
    have=$(jq -r --arg k "$k" 'if has($k) then (.[$k] | tostring) else "" end' "$f" 2>/dev/null) || return 0   # not JSON: left alone
    [ "$have" = "$want" ] && continue
    setting_reported "$k" && continue
    if [ -z "$have" ]; then
      printf '%s\t%s\tsetting\t-\t%s=%s — unset (%s); reported, never written\n' "$(date -u +%FT%TZ)" "$now" "$k" "$want" "$f" >> "$LOG"
      msg="Set \"$k\": $want in ${f/#$HOME/\~} — it is unset there. The box never writes that file; until then each tick answers the dialog the key would suppress."
      "$BIN/cc-notify" -t "$(hostname -s) model" "$msg" >/dev/null 2>&1 || true
    else   # a person's choice: the log says so once an hour, the owner is not nagged for it
      printf '%s\t%s\tsetting\t-\t%s=%s — set by a person, left; the box would want %s\n' "$(date -u +%FT%TZ)" "$now" "$k" "$have" "$want" >> "$LOG"
    fi
  done; }
rung_id(){   # $1 family → the id the chain (or the primary) spells it as: what a restore types back
  local f="${1:-}" m; [ "$f" = "$(fam "$PRIMARY")" ] && { printf '%s\n' "$PRIMARY"; return 0; }
  while read -r m; do [ "$(fam "$m")" = "$f" ] && { printf '%s\n' "$m"; return 0; }; done < <(chain_all); printf '%s\n' "$f"; }
credits_panes(){   # (1c): every live session showing the line is moved off the model it names, in EVERY state — the
                   # box may already be off it (the 2026-09-15 00:5xZ stall: the override on Opus, two orchs launched
                   # on Fable by their dispatcher, refused on their next turn, and read as `mismatch` for hours).
  local id name cap hit lm pf src nx why ck
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue   # never on the chain
    cap=$(pane_text "$id"); hit=$(credits_line "$cap") || continue
    ck=$(credits_key "$cap"); credits_seen "$id" "$ck" && continue   # acted on already: history, whatever the record says now
    pf=$(fam "$(grep -oiE '(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* requires usage credits' <<<"$hit")")
    lm=$(live_model "$id" "$([ -n "$pf" ] && rung_id "$pf")")   # no record: on the model the line names
    [ -n "$pf" ] || pf=$(fam "$lm")   # the cap names no model: it is the one this session is on
    moved_by_box "$id" "$pf" && continue   # typed at for THIS model already — which the line has to be read first to know
    why=$(grep -oiE "(claude-)?(fable|opus|sonnet|haiku) ?[0-9.]* requires usage credits|you.?ve hit your monthly spend limit" <<<"$hit" | head -1)
    src="$lm"
    if [ "$(fam "$lm")" != "$pf" ]; then   # the CLI moved the session itself ("Switched to Sonnet 5 for this session"):
      grep -qi 'switched to' <<<"$hit" || continue   # …else the line is about a model this session is no longer on
      src=$(rung_id "$pf"); fi                        # what it WAS on, for the restore; its own pick is not the chain's rung
    nx=$(chain_next "$src") || { printf '%s\t%s\trefusal\t%s\t%s:%s — nothing after %s on the chain\n' "$(date -u +%FT%TZ)" "$now" "$src" "$SESSION" "$name" "$pf" >> "$LOG"
      note_credits_seen "$id" "$ck"; continue; }   # logged once per line, not once a minute
    if [ "$src" != "$lm" ] && planning "$name" && below_floor "$nx"; then   # the CLI took a planning seat below the floor: typed back and parked there
      type_into "$id" "$name" "/model $src" || continue
      park "$id" "$name" "$src" "$pf" "the CLI had moved it to $lm"
    elif [ "$src" != "$lm" ]; then   # the CLI's own pick: moved to the chain's rung and banked as what it WAS on, before any pass banks it as kept
      type_into "$id" "$name" "/model $nx" || continue   # busy: next tick
      note_moved "$id" "$name" "$src" moved "$pf"
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) was on %s — the CLI had moved it to %s\n' "$(date -u +%FT%TZ)" "$now" "$nx" "$SESSION" "$name" "$id" "$src" "$lm" >> "$LOG"; fi
    mark_unavailable "$src" "$why"   # the record, the owner's line once per model out, and the box off it when it was on it
    move_off "$pf" "$nx" "the CLI said so in $SESSION:$name" >/dev/null   # …and every session on it, whatever the box was on
    # THE LINE IS RECORDED ONLY ONCE THE PANE HAS BEEN HANDLED (review of #567). Recorded above this check, a pane
    # cc-msg could not type into — a split window's inactive pane, or one behind a dialog — read as acted on and was
    # skipped for good: model-skipped is retried only under an override, so with none that pane never got its rung or
    # its resume line. Reading the line again costs nothing twice over: the record is once per model out
    # (note_unavailable's `since`), do_switch is idempotent on the override, and move_off skips a pane its own $MOVED
    # row says it has typed at — so only the `skip` row and the model-skipped retry entry repeat, which is their job.
    moved_by_box "$id" "$pf" || continue   # busy or behind a dialog: not moved off THIS model, so not nudged — next tick
    note_credits_seen "$id" "$ck"
    planning "$name" && below_floor "$nx" && { tell_parked "$why"; continue; }   # parked: a resume line would only be refused again
    # the pane that showed the line is at an empty prompt with its turn lost: one line puts it back to work
    nudge "$id" "$name" "$pf" "$nx" "refused this session for usage credits" "after its $(label "$pf") line"
  done < <(sessions); }
restore_blocked(){   # $1 = prompt_panes output → why a probe that answered still cannot be read as "the limit lifted",
                     # or nothing at all (exit 1) when it can. A `claude -p` turn answers just as readily on usage credits
                     # as on the plan and the result JSON does not say which paid, so the evidence has to come from
                     # elsewhere: while the prompt is on a pane, or cc-limit's stamp still has the primary model limited,
                     # this cannot tell — and a restore it cannot tell is the 12-pane retune of 2026-09-01.
  local pp="${1:-}" p w
  p=$(fam "$PRIMARY"); w=$(awk -F'\t' -v p="$p" '$3==p{print $2; exit}' <<<"$pp")
  [ -n "$w" ] && { printf 'the %s limit prompt is still on %s:%s\n' "$(label "$PRIMARY")" "$SESSION" "$w"; return 0; }
  # ANY live stamp, whatever its observer count. One run's limit does not move the box (see limstamp), but this is
  # not "is the box limited" — it is "can a probe that answered prove the limit lifted", and one run's word is
  # still a reason it cannot tell. Staying on the fallback costs nothing; restoring early is the 12-pane retune.
  limstamp
  { [ "$lim_till" -gt "$now" ] && [ "$(fam "${lim_model:-}")" = "$p" ]; } &&
    { printf "cc-limit's stamp still has %s limited until %sZ\n" "$p" "$(date -u -d "@$lim_till" +%H:%M)"; return 0; }
  return 1; }
SWITCH_TILL=0   # set by a caller that knows the deadline the limit itself named (the prompt's reset); do_switch banks it
do_switch(){   # $1 model (a family word like "opus" or a full id) $2 reason
  local want="$1" why="${2:-}" m wf n=0 msg to=0 off
  drop_stale_rows   # before the override is written, for the same reason
  wf=$(fam "$want")
  if [ "$wf" = "$(fam "$PRIMARY")" ]; then m="$PRIMARY"; elif [ "$wf" = "$(fam "$FALLBACK")" ]; then m="$FALLBACK"; else m="$want"; fi
  [ "$m" = "$PRIMARY" ] && forget_unavailable "$(fam "$PRIMARY")"   # back onto the primary = it answered as itself, or the owner says so
  off=$(fam "$PRIMARY"); ov && off=$(fam "$model")   # the family the box is leaving: what a switch moves sessions OFF
  if ov; then [ "$model" = "$m" ] && return 0
  elif [ "$m" = "$PRIMARY" ]; then   # idempotent: callers may fire on every limited run — but sessions moved under the record alone still come back
    [ -s "$MOVED" ] && { n=$(restore_all "$(fam "$FALLBACK")"); printf '%s\t%s\tswitch\t%s\t%s session(s); %s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$n" "$why" >> "$LOG"; }
    return 0; fi
  if [ "$m" = "$PRIMARY" ]; then rm -f "$OV" "$ST/model-skipped"
  else limstamp; [ "$lim_till" -gt "$now" ] && to="$lim_till"
    [ "${SWITCH_TILL:-0}" -gt "$to" ] && to="$SWITCH_TILL"
    printf '%s\t%s\t%s\t%s\t0\n' "$m" "$now" "$to" "$(tr -d '\t\n' <<<"$why")" > "$OV"; fi
  # ONLY THE SESSIONS ON THE MODEL THAT WENT OUT MOVE, and each goes back to what it was on (the brief, 2026-09-15:
  # "returns to the model it was on"). Down: the panes on the family the box is leaving. Up: each banked pane to its
  # row, a rowless pane on the fallback to the primary, anything else left where a person put it.
  if [ "$m" = "$PRIMARY" ]; then n=$(restore_all "$off"); else n=$(move_off "$off" "$m" "$why"); fi
  printf '%s\t%s\tswitch\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$n session(s); $why" >> "$LOG"; }
# ── CLASSIFICATION READS FIELDS, NEVER THE DOCUMENT ──────────────────────────────────────────────────────────────
# A result JSON is kilobytes of numbers, uuids and the worker's own prose. Grepping it whole is how this classifier
# came to be wrong on 41 of 48 real runs (2026-09-01 review): "429" sits inside uuids, token counts and dollar costs;
# the literal `"refused":{…}` sits in `subagent_stats` of EVERY run; and a worker's result text says "refused" or
# "usage limit" whenever it is describing its own work. So: jq the FIELDS, and read prose only from `.result`, only
# when the API itself ended the run — never from a capped run, whose `.result` is the worker's last paragraph.
# The CLI's own wording for a limit: a usage limit or a rate limit — a WAIT.
LIMIT_RE='usage limit|rate limit|rate_limit|too many requests'
# …and for a model this ACCOUNT cannot run: it wants usage credits the account has not got ("You're out of usage
# credits…", 2026-08-28, read then as "could not run" and never switched; "Fable 5.1 requires usage credits",
# 2026-09-03, read as a limit and it parked the box for 14 h). Not a limit — no reset lifts it, and the other models
# answer — so it is a MOVE, and it is read before the status code: the 2026-08-28 message came with a 429 on it.
# Real limit wording beside it still wins: a limit hit with no credits left to continue on is a limit.
# …and the MONTHLY SPEND CAP (owner, 2026-09-15): "You've hit your monthly spend limit" names a weekly reset that is
# not its lift — the cap lifts when the owner raises it — and the other models answer. Same kind, same record.
CREDITS_RE='usage credits|out of credits|insufficient credits|monthly spend limit|spend cap'
credits_said(){ grep -iE "$CREDITS_RE" <<<"${1:-}" | head -1 | sed -E 's/(\. | · ).*//' | tr -d '\t' | head -c 120; }   # the sentence, for the journal
# every wording that means the id we asked for is not ours to call: unknown, withdrawn, suspended, not permitted.
# API SHAPES ONLY — never the bare words refused/declined/unavailable, which a worker writes about its own task.
REFUSE_RE='model_not_found|invalid_model|unknown model|not a valid model|does not have access|no access to|permission_error|model[^"]{0,60}(not available|unavailable|deprecated|suspended|withdrawn|retired)|(unavailable|deprecated|suspended|withdrawn|retired|not available)[^"]{0,30}(to|for) this account'
SIDECALL='haiku'   # the CLI's own small side-calls (titles, summaries) run on it in 36/36 real runs: never a reroute
asked_fam(){   # the family the run WAS asked for. cc-loop passes nothing when there is no override — that is the
               # NORMAL state, and the reroute check has to work in it (F3), so resolve it the way the run itself
               # did: the model the caller named, else the box override, else the primary.
  local w; w=$(fam "${1:-}"); [ -n "$w" ] && { printf '%s\n' "$w"; return 0; }
  ov && w=$(fam "$model"); [ -n "$w" ] || w=$(fam "$PRIMARY"); printf '%s\n' "$w"; }
served_fams(){   # $1 run json · $2 failed=yes|no → the families that actually did the work, the side-call model
                 # excluded (F5: without that exclusion the answer was always "answered as haiku, not fable", 36/36 real runs)
  local m f; local -a all=() main=()
  while read -r m; do f=$(fam "$m"); [ -n "$f" ] || continue
    all+=("$f"); [ "$f" = "$SIDECALL" ] || main+=("$f")
  done < <(jq -r '[(.modelUsage? // {} | keys[]?), (.model? // empty)] | unique | .[]' "$1" 2>/dev/null)
  [ ${#main[@]} -gt 0 ] && { printf '%s\n' "${main[@]}"; return 0; }
  # only the side-call model ran. On a run that SUCCEEDED, that is what answered. On a run that FAILED, the primary
  # never answered at all (a 529, a 500, an execution error) and the title call is the only usage there is — calling
  # that "answered as haiku" walked cc-loop down the chain and off its end (exit 10) for one retryable error (re-review).
  [ "${2:-no}" = yes ] && return 0
  [ ${#all[@]} -gt 0 ] && printf '%s\n' "${all[@]}"; return 0; }
classify_run(){   # $1 run json · $2 its stderr · $3 the model that was ASKED for → "<class>\t<why>", always exit 0
  local j="${1:-}" e="${2:-}" want="${3:-}" err sub stop term astat res w sf served failed apisays
  err=$(tail -c 4000 "${e:-/dev/null}" 2>/dev/null)   # the CLI's own channel — the worker's prose never lands here
  if [ ! -s "$j" ] || ! jq -e 'type == "object"' "$j" >/dev/null 2>&1; then   # network, bad binary, timeout, an HTML 502
    { grep -qiE "$LIMIT_RE" <<<"$err" || grep -qiE "$LIMIT_RE" "$j" 2>/dev/null; } && { printf 'limit\tsaid so in words\n'; return 0; }
    grep -qiE "$CREDITS_RE" <<<"$err" && { printf 'refusal\tneeds usage credits: %s\n' "$(credits_said "$err")"; return 0; }
    [ -s "$j" ] && { printf 'error\tno json\n'; return 0; }
    printf 'error\tno output\n'; return 0; fi
  IFS=$'\t' read -r sub stop term astat < <(jq -r '[(.subtype // ""), (.stop_reason // ""), (.terminal_reason // ""), (.api_error_status // "" | tostring)] | @tsv' "$j" 2>/dev/null)
  res=$(jq -r '.result // "" | tostring' "$j" 2>/dev/null)
  failed=no; { [ "$(jq -r '.is_error // false' "$j" 2>/dev/null)" = true ] || [[ "$sub" == error_* ]]; } && failed=yes
  # `.result` is the CLI's own message on a run the API ended, and the worker's last paragraph on a capped one.
  # Only the first is evidence about the model; 9 of 10 real error_max_turns runs read as a refusal without this line.
  apisays=no; { [ "$failed" = yes ] && [[ "$sub" != error_max_* ]]; } && apisays=yes
  # ── a WAIT: cc-limit owns the clock, this only has to name it ──
  { [ "$apisays" = yes ] && grep -qiE "$LIMIT_RE" <<<"$res"; } && { printf 'limit\tsaid so in words\n'; return 0; }
  grep -qiE "$LIMIT_RE" <<<"$err" && { printf 'limit\tsaid so in words\n'; return 0; }
  # ── a MOVE, read before the status code: the model wants usage credits this account has not got (see CREDITS_RE) ──
  { [ "$apisays" = yes ] && grep -qiE "$CREDITS_RE" <<<"$res"; } && { printf 'refusal\tneeds usage credits: %s\n' "$(credits_said "$res")"; return 0; }
  grep -qiE "$CREDITS_RE" <<<"$err" && { printf 'refusal\tneeds usage credits: %s\n' "$(credits_said "$err")"; return 0; }
  [ "$astat" = 429 ] && { printf 'limit\tthe API answered 429\n'; return 0; }
  # ── a MOVE: the model would not answer AS ITSELF ──
  [ "$stop" = refusal ] && { printf 'refusal\tthe classifier stopped the turn\n'; return 0; }
  w=$(asked_fam "$want"); sf=$(served_fams "$j" "$failed"); served=$(paste -sd/ - <<<"$sf")
  # A run that took NO turns says nothing about the model it asked for: the only usage in the file is the CLI's own
  # side-call. served_fams excluded that call on a run that FAILED but not on one that simply did nothing, so an empty
  # success read as "answered as haiku, not fable" and walked cc-loop down the chain for a run with no work in it.
  { [ "$failed" = no ] && [ "$sf" = "$SIDECALL" ] && [ "$(jq -r '.num_turns // -1' "$j" 2>/dev/null)" = 0 ]; } &&
    { printf "ok\tan empty run: no turns, only the CLI's side-call\n"; return 0; }
  if [ -n "$w" ] && [ -n "$sf" ] && ! grep -qxF "$w" <<<"$sf"; then
    printf 'refusal\tanswered as %s, not %s\n' "$served" "$w"; return 0; fi
  { [ "$apisays" = yes ] && grep -qiE "$REFUSE_RE" <<<"$res"; } && { printf 'refusal\tthe model would not answer as itself\n'; return 0; }
  # ── a RETRY, or nothing wrong at all ──
  case "$sub" in error_*) printf 'error\t%s\n' "$sub"; return 0;; esac   # the RUN failed (cap, execution), not the model
  { [ -n "$astat" ] && [ "$astat" != 429 ]; } && { printf 'error\tthe API answered %s\n' "$astat"; return 0; }   # a 529/500: retry, not wait
  [ "$failed" = yes ] && { printf 'limit\tin-band error (%s) naming nothing — treated as a limit, as it has been since 2026-08-28\n' "${term:-no terminal_reason}"; return 0; }
  printf 'ok\t\n'; return 0; }
probe(){   # $1 = the model id to ask for (the primary's probe id by default): is it answering again? one cheap turn,
           # no tools. 0 = answers · 1 = limited · 2 = could not run (unknown) · 3 = refused or rerouted (moving beats retrying)
  local o="$ST/model-probe.json" rc cl pm="${1:-$PROBEM}"
  [ -x "$CLAUDE" ] || return 2
  # --setting-sources '' keeps the probe off this box's settings/MCP servers: a plain turn, cents not dollars
  timeout 60 "$CLAUDE" -p "reply ok" --model "$pm" --max-turns 1 --setting-sources '' \
      --max-budget-usd "${CC_MODEL_PROBE_BUDGET:-0.50}" --output-format json >"$o" 2>"$o.err"; rc=$?
  cl=$(classify_run "$o" "$o.err" "$pm"); probe_why="${cl#*$'\t'}"; cl="${cl%%$'\t'*}"   # the JSON before the exit code
  case "$cl" in limit) return 1;; error) return 2;;
    refusal) unavailable_why "$probe_why" && note_unavailable "$(fam "$pm")" "$probe_why"; return 3;; esac   # the record, refreshed each probe
  [ "$rc" = 0 ] || { probe_why="exit $rc"; return 2; }
  # AN ANSWER WHILE REAL RUNS ARE REFUSED IS NOT AVAILABILITY (model.log 2026-09-21 17:17-17:48Z: the probe answered,
  # every session moved back up was refused within a minute, and the next probe said the same). Counted as a refusal.
  refused_recently "$(fam "$pm")" && { probe_why="answered, but a real run on it was refused inside ${CC_MODEL_REFUSED_HOLD:-3600} s"; return 3; }
  return 0; }
lastprobe(){ cat "$ST/model-probed" 2>/dev/null || echo 0; }   # F2: the pane-detection probe is throttled like the restore probe
probe_unavailable(){   # EVERY family on record as one the account cannot run is probed back, not only the primary's.
                       # The cap lands on the model a run ASKED for, and with the commonest dispatch that is the
                       # fallback, not the primary: an opus row written by cc-limit had nothing that could ever clear
                       # it, so every worker stayed a rung down after the owner raised the cap until someone edited
                       # ~/.cc/state/model-unavailable by hand. The primary's row restores the box (do_switch);
                       # another family's is forgotten and lift_rung brings the box and its sessions back up to it.
                       # $1 = "others": every family but the primary's — the override branch of tick, which probes the
                       # primary itself. Until 2026-09-21 this ran only with no override in force, so under a Sonnet
                       # override the Opus row was never re-checked and the box sat on Sonnet 14 h after Opus returned.
  local f pm rc p fs; p=$(fam "$PRIMARY")
  fs=$(cut -f1 "$UNAV" 2>/dev/null | awk -v p="$p" -v o="${1:-}" 'NF && !(o=="others" && $1==p)')
  [ -n "$fs" ] || return 0
  [ $((now - $(lastprobe))) -ge "${CC_MODEL_PROBE_EVERY:-900}" ] || return 0   # one pass per 15 min, as the restore probe
  printf '%s\n' "$now" > "$ST/model-probed"
  while read -r f; do [ -n "${f:-}" ] || continue
    if [ "$f" = "$p" ]; then pm="$PROBEM"; elif [ "$f" = "$(fam "$FALLBACK")" ]; then pm="$FALLBACK"   # the id its sessions run, [1m] and all
    else pm=$(rung_id "$f"); case "$pm" in *']') ;; *) pm="$pm$(grep -oE '\[[^][]*\]$' <<<"$PRIMARY")";; esac; fi   # its own rung, as a session runs it: [1m] too
    probe_why=""; probe "$pm"; rc=$?
    case "$rc" in
      0) if [ "$f" = "$p" ]; then rate_ok && do_switch "$PRIMARY" "answered as itself again (probe)"
         else forget_unavailable "$f"; lift_rung "$f" >/dev/null; fi;;
      3) printf '%s\t%s\trefusal\t%s\t%s — still not this account'"'"'s to run\n' "$(date -u +%FT%TZ)" "$now" "$pm" "${probe_why:-refused}" >> "$LOG";;
      *) printf '%s\t%s\tprobe\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$pm" "$([ "$rc" = 1 ] && echo 'still limited' || echo "could not run — unknown (${probe_why:-no json})")" >> "$LOG";;
    esac
  done <<<"$fs"
  return 0; }
tick(){
  local id name cap line h m rc nx pp pf pe pw ptill why k pout lm
  drop_stale_rows   # rows from an episode cleared by hand are gone before (1c) reads them
  settings_guard    # (0) the two harness keys that stop a pause: reported to the owner when off, never written
  flag_panes        # (1d) the safeguards dialog, in every state
  confirm_panes     # (1e) the auto-mode confirm dialog: read-only answered, a write carded to the owner
  # ---- (1)+(2) THE CLI'S OWN LIMIT PROMPT: answered first, and in EVERY state. A session sitting on it delivers
  # nothing at all — on 2026-09-01 a pulse tick and two secretary findings went nowhere for exactly this — and the
  # answer is the same whether or not the box has already moved off the primary model.
  pp=$(prompt_panes); ptill=0
  while IFS=$'\t' read -r id name pf pe; do [ -n "${id:-}" ] || continue
    { [[ "${pe:-}" =~ ^[0-9]+$ ]] && [ "$pe" -gt "$ptill" ]; } && ptill="$pe"
    m=$(offered_fam "$(pane_text "$id")")   # read before the key: the dialog is gone the moment it is answered
    if member_win "$name"; then   # a member session: the highlighted offer is taken, and that is all — no row, no retune, no line typed
      k=$(answer_prompt "$id" "$pf" any) || continue
      printf '%s\t%s\tanswered\t%s\t%s: %s limit prompt offering %s — %s (a member window: not on the chain)\n' "$(date -u +%FT%TZ)" "$now" "$pf" "$SESSION:$name" "$(label "$pf")" "${m:-nothing}" "$k" >> "$LOG"
      continue; fi
    k=$(answer_prompt "$id" "$pf" "$(planning "$name" && below_floor "$(chain_next "$(rung_id "$pf")" 2>/dev/null)" && echo floor)") || continue
    printf '%s\t%s\tanswered\t%s\t%s: %s limit prompt offering %s — %s\n' "$(date -u +%FT%TZ)" "$now" "$pf" "$SESSION:$name" "$(label "$pf")" "${m:-nothing}" "$k" >> "$LOG"
    case "$k" in
      Enter)   # the CLI has this session on the next rung now: banked as moved off $pf, so the lift brings it back
        lm=$(live_model "$id" "$(rung_id "$pf")"); [ "$(fam "$lm")" = "$pf" ] || lm=$(rung_id "$pf")
        note_moved "$id" "$name" "$lm" moved "$pf"; drop_returned "$name";;
      Escape) dialog_retune "$id" "$name" "$pf";;   # the offer was the wrong rung: /model the right one, and the resume line
    esac
  done <<<"$pp"
  # ---- (1c) IN EVERY STATE: the CLI's own "requires usage credits" / spend-cap line on a live pane moves that
  # session — and every session on the model it names — to the next rung, whatever the box itself is on.
  credits_panes
  flagged_panes   # (1d) …and the line the CLI leaves after a safeguards switch, when it picked a rung too low
  reconcile       # every session to the model it belongs on, up or down, event or none (see reconcile)
  # ---- (4) IN EVERY STATE, AND BEFORE ANY BRANCH BELOW CAN RETURN: say which live sessions are not on the model a
  # dispatch would name. Report only — the moves above and the retune pass further down are the ones that type.
  report_mismatches
  if ov; then   # ---- the fallback is on: restore once the limit has passed AND the primary model answers again
    if [ -s "$ST/model-skipped" ]; then   # F3: panes that were behind a dialog at switch time get another try
      : > "$ST/model-skipped.n"
      while read -r id; do [ -n "${id:-}" ] || continue
        name=$(sessions | awk -v i="$id" '$1==i{print $2; exit}'); [ -n "$name" ] || continue   # gone: nothing to do
        type_into "$id" "$name" "/model $model" && printf '%s\t%s\tretyped\t%s\t%s\n' "$(date -u +%FT%TZ)" "$now" "$model" "$id" >> "$LOG" || printf '%s\n' "$id" >> "$ST/model-skipped.n"
      done < "$ST/model-skipped"; mv "$ST/model-skipped.n" "$ST/model-skipped"; fi
    probe_unavailable others; ov || return 0   # EVERY rung on record as out is re-checked, the middle one too (it may move the override up)
    { [ "$till" -gt 0 ] && [ "$now" -lt "$till" ]; } && return 0
    [ $((now - probed)) -ge "${CC_MODEL_PROBE_EVERY:-900}" ] || return 0
    # (3) A PROBE CANNOT SEE WHO PAID FOR IT. Before spending anything: if the box cannot tell a lifted limit from one
    # answered out of usage credits, it neither probes nor restores.
    if why=$(restore_blocked "$pp"); then
      printf '%s\t%s\tprobe\t%s\tnot probing — %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$why" >> "$LOG"; return 0; fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$model" "$since" "$till" "$reason" "$now" > "$OV"   # bank the attempt first: a hung probe must not rerun every minute
    probe_why=""; probe; case $? in 1) printf '%s\t%s\tprobe\t%s\tstill limited\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" >> "$LOG"; return 0;;
                      2) printf '%s\t%s\tprobe\t%s\tcould not run — unknown (%s)\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-no json}" >> "$LOG"; return 0;;
                      3) printf '%s\t%s\trefusal\t%s\t%s — staying on %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-refused}" "$(fam "$model")" >> "$LOG"; return 0;; esac
    # …and after: the prompt can appear on a pane while the probe is running, and that answer is not proof either.
    if why=$(restore_blocked "$(prompt_panes)"); then
      printf '%s\t%s\tprobe\t%s\tanswered, but %s — not restoring\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$why" >> "$LOG"; return 0; fi
    rate_ok && do_switch "$PRIMARY" "limit lifted (probe)"; return 0
  fi
  # ---- (2) the prompt names the primary model: move, with no probe (answering one costs usage credits) and no rate
  # gate (do_switch is idempotent, and the wording is gone from the pane the moment it is answered).
  pw=$(awk -F'\t' -v p="$(fam "$PRIMARY")" '$3==p{print $2; exit}' <<<"$pp")
  if [ -n "$pw" ]; then
    [ "$ptill" -gt 0 ] || ptill=$((now + ${CC_MODEL_PROMPT_TILL:-86400}))   # it named no reset: a day, not a probe
    SWITCH_TILL="$ptill"; do_switch "$FALLBACK" "$(label "$PRIMARY") limit prompt in $SESSION:$pw"; SWITCH_TILL=0
    return 0; fi
  # ---- normal: did the primary model just hit a limit, on evidence the box is already holding? The pane scan below
  # is the slow path and the paid one; this one costs nothing and fires in the tick after the stamp (stamp_says_switch).
  if stamp_says_switch; then
    rate_ok && do_switch "$FALLBACK" "$(fam "$PRIMARY") limit (cc-limit stamp)"; return 0; fi
  # ---- (5) no override, but some model is on record as one the account cannot run: probe each one back, like an
  # override above. Only the primary's row ends the tick here — the passes below are the primary's own.
  if [ -s "$UNAV" ]; then
    pout=""; unavail "$(fam "$PRIMARY")" && pout=1
    probe_unavailable
    [ -n "$pout" ] && return 0; fi
  # ---- no override is in force, so the box wants PRIMARY: a session on another ID of that same family — the pane on
  # `claude-fable-5` while the box is on `claude-fable-5-1` — is retuned. Nothing here could see that before: to fam()
  # the two are one rung, and the sessions cc-model itself typed the old id into on 2026-09-01 were never moved back.
  while read -r id name; do [ -n "${id:-}" ] || continue
    member_win "$name" && continue   # never on the chain
    cap=$(pane_text "$id"); m=$(retune_to "$cap") || continue
    retuned_recently "$id" && continue
    type_into "$id" "$name" "/model $m" &&
      printf '%s\t%s\tretune\t%s\t%s:%s (%s) was on %s\n' "$(date -u +%FT%TZ)" "$now" "$m" "$SESSION" "$name" \
             "$id" "$(pane_model "$cap")" >> "$LOG"
  done < <(sessions)
  while read -r id name; do [ -n "${id:-}" ] || continue   # a live session says it in its pane before any stamp exists
    cap=$(tmux capture-pane -p -S -30 -t "$id" 2>/dev/null)
    line=$(grep -iE 'usage limit|resets? at [0-9]|out of usage credits|usage-credits' <<<"$cap" | tail -1); [ -n "$line" ] || continue
    h=$(printf '%s' "$name$line" | md5sum | cut -c1-16)   # per-window hash: one hit fires once, however long the line stays on screen
    grep -qxF "$h" "$SEEN" 2>/dev/null && continue
    m=$(fam "$(grep -oiE 'claude-(fable|opus|sonnet|haiku)[a-z0-9._-]*|\b(fable|opus|sonnet|haiku) [0-9]' <<<"$cap" | tail -1)")
    [ -n "$m" ] || m=$(fam "$PRIMARY")   # the pane names no model: it runs the box default
    [ "$m" = "$(fam "$PRIMARY")" ] || continue
    rate_ok || return 0
    [ $((now - $(lastprobe))) -ge "${CC_MODEL_PROBE_EVERY:-900}" ] || return 0   # F2: at most one confirming probe per 15 min
    printf '%s\n' "$now" > "$ST/model-probed"
    probe_why=""; probe; rc=$?
    # the line is only "used up" once the probe DECIDED (answers / limited). After an inconclusive probe it must fire
    # again on a later tick — 2026-08-27 a single unrunnable probe swallowed the only limit line of the day.
    [ "$rc" = 2 ] || { printf '%s\n' "$h" >> "$SEEN"; tail -n 1000 "$SEEN" > "$SEEN.t" 2>/dev/null && mv "$SEEN.t" "$SEEN"; }
    case "$rc" in
      0) printf '%s\t%s\tprobe\t%s\tpane line in %s was not a live limit\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "$name" >> "$LOG"; return 0;;
      2) printf '%s\t%s\tprobe\t%s\tcould not run — not switching on a pane line alone (%s)\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-no json}" >> "$LOG"; return 0;;
      3) nx=$(chain_next "$PRIMARY") || nx="$FALLBACK"   # not a limit, but the primary still will not do the work
         printf '%s\t%s\trefusal\t%s\t%s — moving to %s\n' "$(date -u +%FT%TZ)" "$now" "$PROBEM" "${probe_why:-refused}" "$(fam "$nx")" >> "$LOG"
         do_switch "$nx" "$(fam "$PRIMARY") refused or rerouted (probe): ${probe_why:-refused}"; return 0;;
    esac
    do_switch "$FALLBACK" "$m limit seen in $SESSION:$name"; return 0
  done < <(sessions); return 0; }
selfcheck(){   # fixtures only: no network, no tmux, and none of this box's state is read or written.
               # EVERY fixture is a REAL `claude -p --output-format json` result — sanitized (no session id, no prose)
               # and bent by one jq expression. Hand-written stubs are exactly why the 2026-09-01 review found this
               # classifier wrong on 41 of 48 real runs while its own selfcheck was green: the stubs carried none of
               # the traps a real result carries. The three that matter are asserted below, so nobody simplifies
               # them away: `subagent_stats.refused`, a "429" inside the uuid, and the haiku side-call.
  # THE FIXTURES RUN ON A THREE-RUNG CHAIN whatever ships: the CLI's own strings below are Fable's, and the chained
  # outages need a rung under the fallback. The shipped defaults (two rungs, Opus 5.5 first) have cases of their own.
  local shp="$PRIMARY" shf="$FALLBACK" shc="$CHAIN" shpr="$PROBEM"
  PRIMARY='claude-fable-5-1[1m]'; FALLBACK='claude-opus-5[1m]'; CHAIN='claude-fable-5-1 claude-opus-5 claude-sonnet-5'; PROBEM="$PRIMARY"
  local d n=0 bad=0 got real c1 c2 c3 exp other oldov="$OV" oldchain="$CHAIN" oldst="$ST" oldunav="$UNAV"
  local dlg dlg2 dlgwrap notice credits worker quoted perm askfirst pe0 pn pf0
  d=$(mktemp -d) || return 1
  UNAV="$d/model-unavailable"   # hermetic from the first case: a model this box has recorded must not bend the chain here
  local probe_src; probe_src=$(declare -f probe)   # cases below stub probe and `unset -f` it: (s) runs the real one
  local oldmoved="$MOVED"; MOVED="$d/model-moved"; local oldrefused="$REFUSED"; REFUSED="$d/model-refused"
  local oldreturned="$RETURNED"; RETURNED="$d/model-returned"
  local oldsl="${CC_STATUSLINE_DIR:-}"
  CC_STATUSLINE_DIR="$d/statusline"; mkdir -p "$CC_STATUSLINE_DIR"   # …and this box's LIVE sessions are not this test's
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  cl(){ classify_run "$1" "" "${2:-}" | cut -f1; }
  real="$d/real.json"; cat > "$real" <<'JSON'
{"type":"result","subtype":"success","is_error":false,"duration_ms":489371,"duration_api_ms":410311,"num_turns":68,"result":"ok","session_id":"00000000-0000-4000-8000-000000000000","total_cost_usd":3.6408924999999983,"usage":{"input_tokens":112,"cache_creation_input_tokens":92541,"cache_read_input_tokens":3953051,"output_tokens":29423,"service_tier":"standard"},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":2737,"outputTokens":17,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.002822,"contextWindow":200000,"maxOutputTokens":32000,"canonicalModel":"claude-haiku-4-5","provider":"firstParty","costBasis":"list"},"claude-fable-5":{"inputTokens":112,"outputTokens":29423,"cacheReadInputTokens":3953051,"cacheCreationInputTokens":92541,"webSearchRequests":0,"costUSD":3.6380704999999987,"contextWindow":1000000,"maxOutputTokens":64000,"canonicalModel":"claude-fable-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"stop_reason":"end_turn","terminal_reason":"completed","queued_turn_count":0,"errors":null,"subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"uuid":"14144299-9e48-4299-8f0c-0000000429ab"}
JSON
  jq -e . "$real" >/dev/null 2>&1 || { echo "cc-model selfcheck: the real-result fixture is not json" >&2; rm -rf "$d"; return 1; }
  b(){ jq -c "$2" "$real" > "$d/$1.json"; }   # a fixture is the real result plus one bend
  t 'the fixture is a real result: subagent_stats.refused is in it' "$(jq -r '.subagent_stats.refused|keys|length' "$real")" 3
  t 'the fixture is a real result: 429 sits inside its uuid'        "$(jq -r '.uuid' "$real" | grep -c 429)" 1
  t 'the fixture is a real result: the haiku side-call is in it'    "$(jq -r '[.modelUsage|keys[]|select(test("haiku"))]|length' "$real")" 1

  # type_into: QUEUED IS NOT TYPED (review of #157). cc-msg answers rc 0 for a line it typed AND for one it only
  # spooled behind a dialog; counting the second as a retune leaves the session on the exhausted model and never
  # retries it. Its own tmux and cc-msg are stubs here — this asserts the verdict, not the keyboard.
  local ti_bin="$BIN" ti_sess="$SESSION" ti_proc="$PROC"
  mkdir -p "$d/bin"
  cat > "$d/bin/cc-msg" <<'STUB'
#!/usr/bin/env bash
[ -n "${CC_FAKE_MSG_OUT:-}" ] && printf '%s\n' "$CC_FAKE_MSG_OUT"
exit "${CC_FAKE_MSG_RC:-0}"
STUB
  chmod +x "$d/bin/cc-msg"
  tmux(){ case "${1:-}" in display-message) echo 1;; capture-pane) printf '> \n';; esac; return 0; }
  BIN="$d/bin"; SESSION=main; PROC=claude; CC_MODEL_DIALOG_WAIT=0
  CC_FAKE_MSG_OUT=queued type_into '%1' demo/t1 '/model opus'
  t 'a /model line cc-msg only spooled is NOT a retune: the pane is skipped, and F3 retries it' "$?" 1
  CC_FAKE_MSG_OUT='' type_into '%1' demo/t1 '/model opus'
  t '...while a line it typed counts, silent and rc 0 as cc-msg reports a delivery' "$?" 0
  CC_FAKE_MSG_RC=1 type_into '%1' demo/t1 '/model opus'
  t '...and a pane cc-msg refuses outright is skipped as it always was' "$?" 1
  unset -f tmux; BIN="$ti_bin"; SESSION="$ti_sess"; PROC="$ti_proc"; unset CC_MODEL_DIALOG_WAIT

  b ok      '.'
  b capped  '.subtype="error_max_turns" | .is_error=true | .stop_reason="tool_use" | .terminal_reason="max_turns" | .errors=["Reached maximum number of turns (80)"] | .result="Wrote the gate. The `.env.local` write was refused, and the old model id is deprecated, so I stopped there."'
  b limit429 '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=429 | .result="You'"'"'ve hit your weekly limit · resets Sep 7, 10am (America/Los_Angeles)"'
  b credits '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .result="You'"'"'re out of usage credits. Switch to another model to continue."'
  # the 2026-08-28 message as the API sent it, 429 and all; and the 2026-09-03 one verbatim, from a Pro account
  b credits429 '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=429 | .result="You'"'"'re out of usage credits. Switch to another model, or manage usage credits at claude.ai/settings/usage?from=cc_cli_limit_message, to continue."'
  b entitled '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .result="Fable 5.1 requires usage credits"'
  b nocredits '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=429 | .result="Claude usage limit reached · continuing on Fable 5 uses usage credits · resets at 2026-09-07T17:00:00Z"'
  # the shape of every API-ended run on this box (2026-08-28): the primary never answered, so the haiku title call is the ONLY usage
  b overloaded '.is_error=true | .stop_reason="stop_sequence" | .terminal_reason="api_error" | .api_error_status=529 | .result="API Error: 529 {\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}" | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  b stopped '.is_error=true | .subtype="error_during_execution" | .stop_reason="refusal" | .result=""'
  b reroute '.modelUsage = {"claude-haiku-4-5-20251001":{"inputTokens":2737},"claude-opus-5":{"inputTokens":112}}'
  b gone    '.is_error=true | .subtype="error_during_execution" | .result="model_not_found: claude-fable-5 is not available to this account"'
  b both    '.is_error=true | .terminal_reason="api_error" | .result="refused: Claude usage limit reached"'
  b budget  '.is_error=true | .subtype="error_max_budget_usd" | .result="I was still working when the budget ran out."'
  b vague   '.is_error=true | .result="the API said no and named nothing"'
  b innocent '.result="Done. The 2026-08-28 fix is why a bare stop_reason: refusal still reads as a limit, and I cannot assist with the part that needs the owner."'
  printf '%s' '<html>502 Bad Gateway</html>' > "$d/html.json"
  t 'a good run is ok'                    "$(cl "$d/ok.json" claude-fable-5)"        ok
  t 'a capped run is an error, not a refusal' "$(cl "$d/capped.json" claude-fable-5)" error
  t 'a 429 from the API is a limit'       "$(cl "$d/limit429.json" claude-fable-5)"  limit
  # USAGE CREDITS ARE NOT A LIMIT: one model this account cannot run, and no reset lifts it — a move, not a wait
  t 'out of usage credits is not a wait: the box moves'  "$(cl "$d/credits.json" claude-fable-5)"   refusal
  t '"Fable 5.1 requires usage credits" (2026-09-03) is the same' "$(cl "$d/entitled.json" claude-fable-5-1)" refusal
  t '...and the why says so, in the API'"'"'s words, for the journal' \
    "$(classify_run "$d/entitled.json" "" claude-fable-5-1 | cut -f2)" "needs usage credits: Fable 5.1 requires usage credits"
  t '...and a 429 on the credits message (2026-08-28) does not make it a wait: the words come before the status' \
    "$(cl "$d/credits429.json" claude-fable-5)" refusal
  t '...while a limit hit with no credits left to continue on is still a limit' "$(cl "$d/nocredits.json" claude-fable-5)" limit
  : > "$d/nojson.json"; printf 'Fable 5.1 requires usage credits\n' > "$d/nojson.json.err"
  t '...and the wording on stderr with no json at all is the same move' "$(classify_run "$d/nojson.json" "$d/nojson.json.err" claude-fable-5-1 | cut -f1)" refusal
  t 'a why that wants credits is the model being unavailable; a reroute is not' \
    "$(unavailable_why 'needs usage credits: x' && echo y)$(unavailable_why 'the model would not answer as itself' && echo y)$(unavailable_why 'answered as opus, not fable' && echo y)$(unavailable_why 'the classifier stopped the turn' && echo y)" yy
  t 'a 529 the primary never answered is an error, not a reroute' "$(cl "$d/overloaded.json" claude-fable-5)" error
  t 'and it names the status'             "$(classify_run "$d/overloaded.json" "" claude-fable-5 | cut -f2)" "the API answered 529"
  t 'stop_reason refusal is a refusal'    "$(cl "$d/stopped.json" claude-fable-5)"   refusal
  t 'answering as opus is a refusal'      "$(cl "$d/reroute.json" claude-fable-5)"   refusal
  t 'a withdrawn model is a refusal'      "$(cl "$d/gone.json" claude-fable-5)"      refusal
  t 'limit wording beats refusal wording' "$(cl "$d/both.json" claude-fable-5)"      limit
  t 'a budget cap is an error'            "$(cl "$d/budget.json" claude-fable-5)"    error
  t 'no json at all is an error'          "$(cl "$d/html.json" claude-fable-5)"      error
  t 'no output at all is an error'        "$(cl "$d/none.json" claude-fable-5)"      error
  t 'an in-band error still reads limit'  "$(cl "$d/vague.json" claude-fable-5)"     limit
  t 'refusal wording in a GOOD run is the worker talking' "$(cl "$d/innocent.json" claude-fable-5)" ok
  t 'a haiku side-call is not a reroute'  "$(classify_run "$d/ok.json" "" claude-fable-5 | cut -f2)" ""
  t 'the reroute says what answered'      "$(classify_run "$d/reroute.json" "" claude-fable-5 | cut -f2)" "answered as opus, not fable"
  # a run that did NOTHING: no turns, so the CLI's own side-call is the only usage there is. That read as
  # "answered as haiku, not fable" — a refusal — and moved the chain for a run with no work in it.
  b nothing  '.num_turns=0 | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  b sidecall '.num_turns=6 | .modelUsage={"claude-haiku-4-5-20251001":{"inputTokens":9}}'
  t 'an empty run that succeeded is not a reroute'  "$(cl "$d/nothing.json" claude-fable-5)"  ok
  t '...and it says the run was empty'              "$(classify_run "$d/nothing.json" "" claude-fable-5 | cut -f2)" \
    "an empty run: no turns, only the CLI's side-call"
  t '...while a run that TOOK turns and only the side-call answered is still a reroute' \
    "$(cl "$d/sidecall.json" claude-fable-5)" refusal
  t 'the cap says which cap'              "$(classify_run "$d/capped.json" "" claude-fable-5 | cut -f2)" "error_max_turns"
  : > "$d/empty.json"; printf 'Claude usage limit reached. Resets at 11:40Z\n' > "$d/empty.json.err"
  t 'a limit that produced no json is still a limit' "$(classify_run "$d/empty.json" "$d/empty.json.err" claude-fable-5 | cut -f1)" limit
  # F3: the normal state is NO --model at all. Bend the fixture to a family the box is not on, then ask with "".
  OV="$d/no-override-here"   # hermetic: no override file, so the asked family falls to $PRIMARY, as a real run would
  other=$(fam "$(chain_next "$PRIMARY")"); [ -n "$other" ] && [ "$other" != "$(fam "$PRIMARY")" ] || other=sonnet
  jq -c --arg k "claude-$other-5" '.modelUsage = {"claude-haiku-4-5-20251001":{"inputTokens":9}} | .modelUsage[$k] = {"inputTokens":112}' "$real" > "$d/elsewhere.json"
  t 'no --model given: the reroute is still seen' "$(classify_run "$d/elsewhere.json" "" "" | cut -f1)" refusal
  t 'no --model given: it names both families'    "$(classify_run "$d/elsewhere.json" "" "" | cut -f2)" "answered as $other, not $(fam "$PRIMARY")"
  t 'no --model given: a run on the primary is ok' "$(cl "$d/ok.json" "")" "$([ "$(fam "$PRIMARY")" = fable ] && echo ok || echo refusal)"
  OV="$oldov"
  # ── the CLI's own limit prompt, in the pane's own words (2026-09-01) ──────────────────────────────────────────
  # Captured off the real TUI and off the owner's screenshot, borders and all: the flattening, the anchors and the
  # gap before "limit reached" are what these cases are for. THE NEGATIVES ARE THE POINT — every trigger phrase is
  # quoted in this file's own header and in this block, so a session reading it must not move the box (review of #155).
  self=$(readlink -f "$0")
  # The leading "|" is stripped back off below, so $dlg is the real dialog byte for byte — but THE FILE never holds a
  # renderable one. Without it, printing just this block (sed -n, a scrolled pager) puts a live-looking dialog at the
  # bottom of somebody's pane, and no rule that reads text could tell it from the CLI's own.
  dlg=$(sed 's/^|//' <<'TXT'
|╭──────────────────────────────────────────────────╮
|│ You've reached your Fable 5 limit                │
|│ for this week. Continuing on Fable 5 uses usage  │
|│ credits — you have CA$0.00 in credits.           │
|│                                                  │
|│ ❯ Switch to Opus 5 (1M context) and continue     │
|│   Manage usage credits on claude.ai              │
|│                                                  │
|│ Enter to confirm · Esc to cancel                 │
|╰──────────────────────────────────────────────────╯
TXT
)
  dlg2=$(sed 's/❯ Switch/  Switch/; s/│   Manage/│ ❯ Manage/' <<<"$dlg")   # the highlight one line down
  dlgwrap=$(printf '%s\n' '│ You have reached your Fable 5      │' '│ limit for this week.               │' '│ Enter to confirm · Esc to cancel   │')
  notice='● Fable 5 limit reached · continuing on Fable 5 uses usage credits, and the prompt to confirm went unanswered — nothing was sent · /model to switch'
  credits='  Continuing on Fable 5 uses usage credits — you have CA$0.00 in credits.'
  worker=$(printf '%s\n' '✓ step limit reached (80 steps) — the worker stopped there' '  Switch to Opus 5 (1M context) and continue   ← quoted from the runbook' '● Opus 5 · 43% context left')
  quoted=$(printf '%s\n' '❯ Switch to Opus 5 (1M context) and continue' '  Enter to confirm · Esc to cancel')
  perm=$(printf '%s\n' 'Do you want to make this edit to cc-model?' '❯ 1. Yes' '  2. No, and tell Claude what to do differently (esc)' 'Enter to confirm · Esc to cancel')
  t 'the dialog is a Fable limit, though it names Opus 5 lower down' "$(prompt_fam "$dlg")"     fable
  t 'the notice it leaves when nobody answered is one too'           "$(prompt_fam "$notice")"  fable
  t 'so is "continuing on Fable 5 uses usage credits" under the footer' \
    "$(prompt_fam "$(printf '%s\n%s\n' "$credits" 'Enter to confirm · Esc to cancel')")"        fable
  t 'and so is the same dialog wrapped across its box'               "$(prompt_fam "$dlgwrap")" fable
  t 'a worker pane saying "step limit reached" is NOT a limit'       "$(prompt_fam "$worker")"  ""
  t 'nor is a pane merely showing the option line'                   "$(prompt_fam "$quoted")"  ""
  t 'nor is the sentence on its own: no dialog, no notice, no move'  "$(prompt_fam "$credits")" ""
  t 'nor is the prompt as this file documents it'  "$(prompt_fam "$(sed -n '/^# tick:/,/^# Retuning/p' "$self")")" ""
  t 'nor is the fixture block itself, printed on its own' "$(prompt_fam "$(sed -n '/^  dlg=\$(sed/,/^  perm=/p' "$self")")" ""
  t 'nor are the fixtures read to the end of the file' "$(prompt_fam "$(sed -n '/^  dlg=\$(sed/,$p' "$self")")" ""
  t 'nor is the whole of this file, catted into a pane'            "$(prompt_fam "$(cat "$self")")" ""
  t 'a permission prompt quoting the wording is not a limit' "$(prompt_fam "$(printf '%s\n%s\n' "$credits" "$perm")")" ""
  askfirst=$(printf '%s\n%s\n' 'I can run the suite first. Do you want to run the tests first?' "$dlg")
  t 'but a live dialog under an assistant "Do you want to …" line still is' "$(prompt_fam "$askfirst")" fable
  t 'and a permission box below ours hides only its own anchor' \
    "$(prompt_fam "$(printf '%s\n%s\n' "$dlg" "$perm")")"                                     fable
  t 'that pane is still left for a human, though: no key goes into it'      "$(answer_key "$askfirst")" ""
  t 'an assistant bullet quoting the notice is not one either' \
    "$(prompt_fam '● The notice reads "Fable 5 limit reached · continuing on Fable 5 uses usage credits" — see #155')" ""
  t 'the dialog one screen up is history, not a live prompt' \
    "$(prompt_fam "$(printf '%s\n' "$dlg" 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok' 'ok')")" ""
  t 'the highlighted switch-and-continue option is answered with Enter' "$(answer_key "$dlg")"  Enter
  t 'any other highlighted line is answered with Esc'                "$(answer_key "$dlg2")"    Escape
  t 'with no dialog open there is no key to send'                    "$(answer_key "$notice")"  ""
  t 'and another dialog is not answered either, in either direction' "$(answer_key "$perm")"    ""
  t 'nor is a permission prompt under our own dialog — that Enter would approve it' \
    "$(answer_key "$(printf '%s\n%s\n' "$dlg" "$perm")")"                                       ""
  t 'nor an option line a screenful above the footer that is not its own' \
    "$(answer_key "$(printf '%s\n' '❯ Switch to Opus 5 (1M context) and continue' '' '' '' '' '' 'Enter to confirm · Esc to cancel')")" ""
  pe0=$(date -u -d '+3 days' +%s); pn=$(date -u -d "@$pe0" +'%Y-%m-%d %H:%M:%S UTC')
  t 'a reset the prompt names becomes the until'  "$(reset_at "Your limit resets at $pn.")"     "$pe0"
  t 'a prompt that names none gets none (24 h)'   "$(reset_at "$dlg")"                          ""
  ST="$d"   # hermetic: this box's cc-limit stamp is never read
  pf0=$(printf '%%9\tsess\t%s\t0\n' "$(fam "$PRIMARY")")
  t 'no restore while the prompt is on a pane'    "$(restore_blocked "$pf0" | grep -c 'limit prompt is still on')" 1
  t 'nothing on any pane: the probe may decide'   "$(restore_blocked '' >/dev/null; echo $?)"   1
  # The stamp's 5th field is the distinct runs that hit it (cc-limit). A restore is blocked by either count: one
  # run's word does not limit the box, but it is still a reason a probe cannot prove the limit lifted.
  printf '%s\tapi\t%s\t%s\t%s\n' "$((now + 3600))" "$now" "$(fam "$PRIMARY")" aaaaaaaa > "$ST/claude-limit"
  t "a live cc-limit stamp cannot tell either"      "$(restore_blocked '' | grep -c 'still has')" 1
  printf '%s\tapi\t%s\t%s\t%s\n' "$((now + 3600))" "$now" "$(fam "$PRIMARY")" aaaaaaaa,bbbbbbbb > "$ST/claude-limit"
  t "…and a stamp two runs hit tells no differently" "$(restore_blocked '' | grep -c 'still has')" 1

  # ── THE SWITCH FOLLOWS THE RECORDED LIMIT, NOT A PANE SCAN (2026-09-05) ──────────────────────────────────────
  # Stamped 09:08Z for a reset of 11:10Z; the box moved at 10:55Z off a pane line and a paid probe. Each case
  # writes its own stamp and its own record — the case that switches and the case that must not, both asserted.
  sw(){ stamp_says_switch; echo $?; }
  rm -f "$ST/limit-interrupted"
  printf '%s\tapi\t%s\t%s\t%s\n' "$((now + 3600))" "$now" "$(fam "$PRIMARY")" aaaaaaaa > "$ST/claude-limit"
  t 'one run on the stamp and nothing else is still not the box'"'"'s limit — 09-04 stands' "$(sw)" 1
  printf '%%9\tplanner\t%s\t%s\tindep\n' "$((now + 3600))" "$now" > "$ST/limit-interrupted"
  t 'a session cc-limit recorded as INDEPENDENTLY interrupted is that second run: the switch fires on the stamp, unpaid' "$(sw)" 0
  # Review of #264: without the tag, record() corroborating a pane off this very stamp made one witness look like
  # two — a worker's one-observer stamp plus any pane still showing the morning's wording, and every session moved
  # to the fallback for six hours with no probe. That is the 09-04 regression, so the untagged record is asserted too.
  printf '%%9\tplanner\t%s\t%s\tworking\n' "$((now + 3600))" "$now" > "$ST/limit-interrupted"
  t 'a record that is NOT an independent sighting is no witness at all: it is the stamp agreeing with itself' "$(sw)" 1
  printf '%%9\tplanner\t%s\n' "$((now + 3600))" > "$ST/limit-interrupted"
  t '…nor is a three-field record written before that tag existed' "$(sw)" 1
  printf '%%9\tplanner\t%s\t%s\tindep\n' "$((now - 60))" "$((now - 7200))" > "$ST/limit-interrupted"
  t 'a record whose reset has already passed is no witness — that session is going again' "$(sw)" 1
  rm -f "$ST/limit-interrupted"
  printf '%s\tapi\t%s\t\t%s\n' "$((now + 3600))" "$now" aaaaaaaa,bbbbbbbb > "$ST/claude-limit"
  t 'a stamp naming NO model is the primary'"'"'s: the box dispatches on the primary' "$(sw)" 0
  printf '%s\tapi\t%s\t%s\t%s\n' "$((now + 3600))" "$now" sonnet aaaaaaaa,bbbbbbbb > "$ST/claude-limit"
  t 'a stamp naming another family moves nothing: it is not what the box is running' "$(sw)" 1
  printf '%s\tapi\t%s\t%s\t%s\n' "$((now - 60))" "$now" "$(fam "$PRIMARY")" aaaaaaaa,bbbbbbbb > "$ST/claude-limit"
  t 'and a stamp whose own reset has passed moves nothing either' "$(sw)" 1
  rm -f "$ST/claude-limit" "$ST/limit-interrupted"
  ST="$oldst"
  # ── the model a session is ON is asked by ID, not by family ──────────────────────────────────────────────────
  # fam() is right for the CHAIN (one rung per family) and wrong for "is this session where the box wants it":
  # a session left on `claude-fable-5` while the box is on `claude-fable-5-1` was invisible to every family test
  # here, and its cache reads bill at 4x (about $140 on 2026-09-02).
  local pid oldid
  pid="${PRIMARY%%\[*}"; case "$pid" in *-1) oldid="${pid%-1}";; *) oldid="$pid-1";; esac
  said(){   # a pane the CLI has just answered /model in, in the shape it really draws (captured 2026-09-02)
    printf '%s\n' "❯ /model $1" \
      "  ⎿  Set model to $(idname "$1")$([ "${1#*[}" != "$1" ] && printf ' (1M context)') and saved as your default for new sessions" "> "; }
  t 'fam() cannot tell the primary from the id it replaced' "$(fam "$pid"):$(fam "$oldid")" "$(fam "$pid"):$(fam "$pid")"
  t '...while the NAME the CLI prints does'                 \
    "$([ "$(idname "$pid")" != "$(idname "$oldid")" ] && echo differ || echo same)" differ
  t 'a pane the CLI last put on the OLD id of the primary family is retuned to the primary' \
    "$(retune_to "$(said "$oldid")")" "$PRIMARY"
  t '...and one already on the primary is left alone' \
    "$(retune_to "$(said "$PRIMARY")" >/dev/null; echo $?)" 1
  t '...and another FAMILY is not this pass to undo: an override or the owner put it there' \
    "$(retune_to "$(said "$(chain_next "$PRIMARY")")" >/dev/null; echo $?)" 1
  t '...and a pane that merely NAMES a model — this file in a pager, a doc — is never retuned on the word alone' \
    "$(retune_to "  fam(){ ...; }   # $oldid and $pid are one family, and that is the bug" >/dev/null; echo $?)" 1
  unset -f said
  # …and an until is rendered as a person reads it: HH:MMZ alone made a 24-hour override look three hours expired
  t 'an until later today is the clock alone' "$(untilw "$now")" "$(date -u -d "@$now" +%H:%MZ)"
  t 'an until on another day carries its date' "$(untilw "$((now + 86400))")" "$(date -u -d "@$((now + 86400))" +%FT%H:%MZ)"
  c1=$(chain | sed -n 1p); c2=$(chain | sed -n 2p); c3=$(chain | tail -1)
  # WHAT SHIPS (owner, 2026-09-23: "switch all planning sessions to opus 5.5 … This should be the default"): read off
  # a fresh process with none of the model env and a HOME of its own, since the timer's tick has no env file either
  mkdir -p "$d/home"
  shipped(){ env -u CC_MODEL_PRIMARY -u CC_MODEL_FALLBACK -u CC_MODEL_CHAIN -u CC_MODEL_PROBE -u CC_MODEL_FLOOR HOME="$d/home" "$0" "$@"; }
  t 'the shipped chain is Opus 5.5, then Sonnet 5 — no Fable rung' "$(shipped chain | tr '\n' ' ')" 'claude-opus-5-5 claude-sonnet-5 '
  t '…and with no env a launch names claude-opus-5-5[1m]' "$(shipped current)" 'claude-opus-5-5[1m]'
  t 'the chain walks to its next rung'    "$(chain_next "$c1")"          "$c2"
  t 'a bare family word is the same rung' "$(chain_next "$(fam "$c1")")" "$c2"
  case "$c2" in *']') exp="$c2";; *) exp="${c2}[1m]";; esac
  t 'and a [1m] suffix rides along'       "$(chain_next "${c1}[1m]")"      "$exp"
  t 'naming no model starts where the box is' "$(chain_next '')"         "$(chain_next "$PRIMARY")"
  got=$(chain_next "$c3"); t 'the end of the chain is empty' "$got:$?" ":1"
  CHAIN="$c1 $c2 $c1"   # F7: a chain that names a family twice must not walk in a circle for ever
  t 'a repeated family is one rung'       "$(chain | wc -l)"             2
  got=$(chain_next "$c2"); t 'so the walk still ends' "$got:$?" ":1"
  CHAIN="$oldchain"
  # ── A MODEL THIS ACCOUNT CANNOT RUN (2026-09-03): recorded, left out of the chain, and the box moved off it ──────
  # Own state under $d, no tmux at all (no live session is listed here, let alone typed into), a stub cc-notify.
  local oldlog="$LOG" oldbin="$BIN" oldproc="$PROC" oldchain2=""
  OV="$d/model-override"; LOG="$d/model.log"; ST="$d"; BIN="$d/bin"; PROC=nonesuch
  rm -f "$UNAV" "$OV" "$d/claude-limit"; : > "$d/calls"; tmux(){ return 1; }
  printf '#!/bin/sh\necho "notify $*" >> "%s/calls"\n' "$d" > "$d/bin/cc-notify"; chmod +x "$d/bin/cc-notify"
  exp=$(chain_next "$PRIMARY"); [ "$(fam "$exp")" = "$(fam "$FALLBACK")" ] && exp="$FALLBACK"   # what do_switch lands on
  # ── WHAT A LAUNCH RESOLVES TO (2026-09-07) ──────────────────────────────────────────────────────────────────────
  # cc and cc-rc build the same one thing out of this file: `m=$(cc-model current); [ -n "$m" ] && --model "$m"`.
  # So `current` answering nothing is a session launched naming no model at all, which leaves the harness to pick
  # one — and that was the NORMAL state, not the exceptional one. Both states are asserted here on purpose: the
  # bug lived in the first, so a case that only covered the fallback state passed all along and proved nothing.
  launch_args(){ local m; m=$(current); [ -n "$m" ] && printf -- '--model %s' "$m"; return 0; }
  rm -f "$OV"
  t 'on its primary, a launch names that primary'          "$(launch_args)" "--model $PRIMARY"
  t '…and nothing is forcing the box off it, so a worker keeps its own default' "$(forced)" ""
  do_switch "$FALLBACK" 'a limit moved the box'
  t 'moved off it, a launch names what it was moved to'    "$(launch_args)" "--model $FALLBACK"
  t '…and that is what is forcing it, so a worker moves too' "$(forced)"    "$FALLBACK"
  do_switch "$PRIMARY" 'the limit lifted'
  t 'and back: the launch names the primary again, not nothing' "$(launch_args)" "--model $PRIMARY"
  oldchain2="$CHAIN"; CHAIN="$PRIMARY"; note_unavailable "$(fam "$PRIMARY")" 'test'
  t 'the one answer that is still empty: the account cannot run the primary and the chain ends there' \
    "$(launch_args)" ""
  forget_unavailable "$(fam "$PRIMARY")"; CHAIN="$oldchain2"; unset -f launch_args
  rm -f "$OV"; : > "$LOG"; : > "$d/calls"
  t 'nothing recorded: nothing is forcing the box off its primary' "$(forced)" ""
  mark_unavailable "$c3" 'Sonnet 5 requires usage credits'
  t 'a model the box is not on is recorded, nothing is switched, and nothing goes to the owner — the kind is in $LOG for cc-model status/a debugging engineer' \
    "$(unavail "$(fam "$c3")" && echo rec)$([ -e "$OV" ] && echo ov)$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\t'"$(fam "$c3")"$'\tSonnet 5 requires usage credits' "$LOG")" rec01
  t 'the chain a caller walks leaves it out'      "$(chain | tr '\n' ' ')"      "$c1 $c2 "
  t 'and next steps over it to the chain'"'"'s end' "$(chain_next "$c2"; echo ":$?")" ":1"
  forget_unavailable "$(fam "$c3")"
  t 'forgotten, it is a rung again'               "$(chain | wc -l)"            3
  : > "$d/calls"; mark_unavailable "$c1" 'Fable 5.1 requires usage credits'
  t 'the PRIMARY the account cannot run: the box moves to the next rung, its [1m] context riding along' "$(cut -f1 "$OV")" "$exp"
  t 'nothing goes to the owner for it — the record is $LOG'"'"'s alone (comms review, 2026-09-22)' \
    "$(grep -c "^notify" "$d/calls"):$(grep -c $'\tunavailable\t'"$(fam "$PRIMARY")"$'\tFable 5.1 requires usage credits' "$LOG")" 0:1
  t 'the override carries the reason'             "$(cut -f4 "$OV")" "$(fam "$c1") not available to this account: Fable 5.1 requires usage credits"
  t 'current hands a dispatch that rung'          "$(current)"      "$exp"
  t 'status says which model, and why'            "$(status_line)" "$(fam "$exp") until probe — $(fam "$c1") is not available to this account"
  t 'the chain starts past it'                    "$(chain | sed -n 1p)" "$c2"
  t 'and naming no model starts where the box can run' "$(chain_next '')" "$exp"
  : > "$d/calls"; mark_unavailable "$c1" 'Fable 5.1 requires usage credits'   # the probe sees it again, every 15 min
  t 'a second sighting is one row, no second switch, no second line' \
    "$(wc -l < "$UNAV")$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\tfable\t' "$LOG")" 101
  rm -f "$OV"   # the override cleared by hand, or a fresh box that inherited the record
  t 'the record alone still steers a dispatch off the primary: an override is a patch, this is the fact' "$(current)" "$exp"
  t 'and status still says so'                    "$(status_line)" "$(fam "$exp") — $(fam "$c1") is not available to this account"
  do_switch "$PRIMARY" 'limit lifted (probe)'   # a probe answered AS the primary, or the owner switched back by hand
  t 'back on the primary, the record goes and a dispatch aims at it again' "$(unavail "$(fam "$c1")" && echo rec)$(current)" "$PRIMARY"
  t 'and the log says it came back'               "$(grep -c $'\tavailable\tfable\tanswered as itself again' "$LOG")" 1
  do_switch "$c2" 'test'; : > "$d/calls"; mark_unavailable "$c2" 'Opus 5 requires usage credits'
  t 'the override model the box is on can be the one: it moves on down the chain' "$(fam "$(cut -f1 "$OV")")" "$(fam "$c3")"
  t 'nothing is sent to the owner, and the $LOG row names the model it left' \
    "$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\t'"$(fam "$c2")"$'\tOpus 5 requires usage credits' "$LOG")" 01

  # ── AN OUTAGE MOVES ONLY THE SESSIONS ON THAT MODEL, AND ITS LIFT PUTS EACH BACK WHERE IT WAS (2026-09-15) ──────
  # The brief's three DONE lines, each on its own fixture: (a) a Fable-only refusal, read off the CLI's own line,
  # moves Fable-bound work and nothing else; (b) a full limit moves the sessions on the limited model down and its
  # lift moves them back with no handoff; (c) what a relaunch and a loop resolve to, during and after. The live
  # sessions and what they run come from the two test hooks; cc-msg is a stub that records what it typed where.
  local oldsess="${CC_MODEL_SESSIONS:-}" oldlive="${CC_MODEL_LIVE:-}" pn
  rm -f "$OV" "$UNAV" "$MOVED" "$d/model-skipped"; : > "$LOG"; : > "$d/calls"; : > "$d/typed"
  SESSION=main; PROC=claude; CC_MODEL_DIALOG_WAIT=0; CC_MODEL_SESSIONS="$d/sess"; CC_MODEL_LIVE="$d/live"
  printf '#!/usr/bin/env bash\nprintf "%%s\\t%%s\\n" "$1" "$2" >> "%s/typed"\n' "$d" > "$d/bin/cc-msg"; chmod +x "$d/bin/cc-msg"
  tmux(){ case "${1:-}" in display-message) echo 1;; capture-pane) cat "$d/screen.${*: -1}" 2>/dev/null;; esac; return 0; }
  typed(){ awk -F'\t' -v w="$1" '$1==w{print $2}' "$d/typed" | paste -sd'|' -; }   # what was typed into a window, in order
  # (a) the box on its primary; one orch shows the CLI's boxed line at an empty prompt, one orch is quietly on Fable,
  #     a steward is on Sonnet, and a person put one session on Opus
  printf '%s\n' '%1 w/orch-a' '%2 w/orch-b' '%3 w/steward' '%4 w/by-hand' > "$d/sess"
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "${PRIMARY%%\[*}" '%3' "$c3" '%4' "$exp" > "$d/live"
  printf '%s\n' '● I will read the journal first.' \
    '  │ Fable 5.1 requires usage credits. Switch to another model, or manage usage credits at claude.ai/settings/usage?from=cc_cli_limit_message, to continue.' \
    '' '❯ ' > "$d/screen.%1"
  for pn in 2 3 4; do printf '> \n' > "$d/screen.%$pn"; done
  credits_panes
  t '(a) the CLI'"'"'s own line: the model it names is recorded as one the account cannot run — the kind, not a limit' \
    "$(unavail fable && echo rec):$(cut -f4 "$UNAV")" "rec:Fable 5.1 requires usage credits"
  t '(a) …and the box, which was on it, moves off it: a launch now names the next rung' "$(current)" "$exp"
  t '(a) the pane that showed it is moved to the next rung and nudged back to work' \
    "$(typed w/orch-a)" "/model $exp|Fable 5.1 refused this session for usage credits; it is on Opus 5 now — carry on with what you were doing."
  t '(a) every other session ON that model moves too, with no nudge: it is mid-work or idle by choice' "$(typed w/orch-b)" "/model $exp"
  t '(a) a session on another family is not Fable-bound: nothing is typed at the steward, nor at the one a person put on Opus' \
    "$(typed w/steward)$(typed w/by-hand)" ""
  t '(a) nothing goes to the owner (comms review, 2026-09-22) — $LOG has the row once' \
    "$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\tfable\tFable 5.1 requires usage credits' "$LOG")" 01
  t '(a) what each pane was on is banked, moved or kept' \
    "$(cut -f1,3,5 "$MOVED" | tr '\t' ':' | sort | paste -sd' ' -)" "%1:$PRIMARY:moved %2:${PRIMARY%%\[*}:moved %3:$c3:kept %4:$exp:kept"
  : > "$d/typed"; credits_panes
  t '(a) the line is still on screen a tick later: nothing is typed twice, nobody is told twice' "$(wc -l < "$d/typed")$(grep -c '^notify' "$d/calls")" 00
  # …AND A SECOND OUTAGE INSIDE THE SAME EPISODE IS A MOVE OF ITS OWN (third review of #503). The guard above was the
  # pane's ROW and the row belonged to the EPISODE: a pane typed at during the Fable move carried `moved` for the rest
  # of it, so when the account hit its monthly cap on Opus two hours later — the same panes, one rung down — both
  # credits_panes and move_off skipped it, Opus was never recorded out, and the session stood at an empty prompt for
  # good. That is the 00:5xZ stall again. The row now names the family each move was OFF, so the second move is
  # guarded by its own and not by the first's.
  local c3x; c3x=$(chain_next "$exp")   # the rung under the one the Fable move landed on
  : > "$d/typed"
  awk -F'\t' 'BEGIN{OFS="\t"} NF{$2=$2-7200; print}' "$LOG" > "$LOG.t" && mv "$LOG.t" "$LOG"   # two hours later: the first move's retune rows are outside CC_MODEL_RETUNE_GAP
  printf '%s\t%s\n' '%1' "$exp" '%2' "$exp" '%3' "$c3" '%4' "$exp" > "$d/live"   # the Fable move landed: both orchs are on Opus now
  printf '%s\n' "  ⎿  You've hit your monthly spend limit · your weekly limit resets 10pm (America/Los_Angeles)" '' '❯ ' > "$d/screen.%1"
  credits_panes
  t '(a) a SECOND outage in the same episode is its own move: the pane goes down a rung and is nudged, not skipped as typed at already' \
    "$(typed w/orch-a)" "/model $c3x|$(label "$exp") refused this session for usage credits; it is on $(label "$c3") now — carry on with what you were doing."
  t '(a) …and every session on THAT model moves too — the one a person had put on Opus is Opus-bound now; the steward on Sonnet is not' \
    "$(typed w/orch-b):$(typed w/by-hand):$(typed w/steward)" "/model $c3x:/model $c3x:"
  t '(a) …while the chained move still restores each pane to what it was on before the FIRST one' \
    "$(moved_row %1):$(moved_row %4)" "$PRIMARY:$exp"
  t '(a) …nothing to the owner for this model either, and $LOG gets its own row: once per model out, not once per episode' \
    "$(grep -c '^notify' "$d/calls")$(grep -c $'\tunavailable\t'"$(fam "$exp")"$'\tYou'"'"'ve hit your monthly spend limit' "$LOG")" 01
  : > "$d/typed"; credits_panes
  t '(a) …and the cap line a tick later types nothing: the second move has a guard of its own now' "$(wc -l < "$d/typed")" 0
  forget_unavailable "$(fam "$exp")"; printf '%s\t%s\t0\t%s\t0\n' "$exp" "$now" 'the Fable move' > "$OV"   # the rest of (a) picks up where that move left off
  # …the other two shapes, with the box ALREADY on the override (the 00:5xZ stall): the CLI moved one session to
  #    Sonnet by itself, and a late-launched orch on Fable hit the monthly cap
  rm -f "$MOVED"; : > "$d/typed"; : > "$LOG"
  printf '%s\n' '%5 moved-itself' > "$d/sess"; printf '%s\t%s\n' '%5' "$c3" > "$d/live"
  printf '%s\n' '● Switched to Sonnet 5 for this session · Fable 5.1 requires usage credits · /model to change' '' '❯ ' > "$d/screen.%5"
  credits_panes
  t '(a) "Switched to Sonnet 5 for this session · Fable 5.1 requires usage credits": the CLI'"'"'s own pick is not the chain'"'"'s rung — moved to it, banked as Fable' \
    "$(typed moved-itself | cut -d'|' -f1):$(moved_row %5)" "/model $exp:$PRIMARY"
  rm -f "$MOVED"; : > "$d/typed"
  printf '%s\n' '%6 orch-late' > "$d/sess"; printf '%s\t%s\n' '%6' "$PRIMARY" > "$d/live"
  printf '%s\n' "  ⎿  You've hit your monthly spend limit · your weekly limit resets 10pm (America/Los_Angeles)" \
    '     /usage-credits to adjust your monthly spend limit.' '' '❯ ' > "$d/screen.%6"
  credits_panes
  t '(a) the monthly spend cap names no model: it is the one that session is on, and it is the same kind' \
    "$(typed orch-late | cut -d'|' -f1):$(cut -f4 "$UNAV")" "/model $exp:You've hit your monthly spend limit"
  t '(a) the box was already off Fable: no second switch, the sessions moved all the same' "$(grep -c $'\tswitch\t' "$LOG")" 0
  # …and the shapes that must NOT fire: history (a retune typed after the line), and prose that quotes it
  rm -f "$MOVED"; : > "$d/typed"
  printf '%s\n' '%8 restored' '%9 reader' > "$d/sess"; printf '%s\t%s\n' '%8' "$PRIMARY" '%9' "$PRIMARY" > "$d/live"
  printf '%s\n' '  │ Fable 5.1 requires usage credits. Switch to another model, or manage usage credits, to continue.' \
    "❯ /model $PRIMARY" '  ⎿  Set model to Fable 5.1 and saved as your default for new sessions' '❯ ' > "$d/screen.%8"
  printf '%s\n' '# "Fable 5.1 requires usage credits" (2026-09-03, the account went Pro) and "You'"'"'re out of usage' \
    '- cc-loop: iteration 1 was refused or rerouted on claude-fable-5-1[1m] (needs usage credits: Fable 5.1 requires usage credits)' \
    '   16:  ⎿  You'"'"'ve hit your monthly spend limit · raise it at claude.ai/settings/usage' '❯ ' > "$d/screen.%9"
  credits_panes
  t '(a) a line the box has since retuned past is history, and prose quoting the words is prose: nothing moves' "$(wc -l < "$d/typed")" 0
  # (b) a full limit on the primary, then its lift — the sessions on it down, and back to what each was on
  rm -f "$OV" "$UNAV" "$MOVED"; : > "$d/typed"; : > "$LOG"; : > "$d/calls"
  printf '%s\n' '%1 seat' '%2 orch' '%3 steward' '%4 by-hand' '%8 no-record' > "$d/sess"   # %8: no statusline record, no --model — a hand launch, or the selftest's bare cat
  printf '%s\t%s\n' '%1' "$PRIMARY" '%2' "${PRIMARY%%\[*}" '%3' "$c3" '%4' "$exp" > "$d/live"
  for pn in 1 2 3 4 7 8; do printf '> \n' > "$d/screen.%$pn"; done
  printf '%s\tseat\t%s\t%s\tmoved\n' '%1' "$PRIMARY" "$((now - 7200))" > "$MOVED"   # a row an earlier episode left when its state was cleared by hand
  ROWS_DROPPED=   # a new run: its first drop_stale_rows is the one that reads a clean box
  SWITCH_TILL=$((now + 3600)); do_switch "$FALLBACK" "$(fam "$PRIMARY") limit"; SWITCH_TILL=0
  t '(b) a full limit moves the sessions ON the limited model down the chain, and only those' \
    "$(typed seat):$(typed orch):$(typed steward)$(typed by-hand)" "/model $FALLBACK:/model $FALLBACK:"
  t '(b) a session with no record and no --model is taken to be on the model going out — not on what `current` says once the override is written — and moves' \
    "$(typed no-record):$(moved_row %8)" "/model $FALLBACK:$PRIMARY"
  t '(b) the row an earlier episode left behind held nobody back: the box was on its primary, so this episode started from none' \
    "$(grep -c "$((now - 7200))" "$MOVED")" 0
  t '(b) nothing goes to the owner (comms review, 2026-09-22) — the switch is a $LOG row, not a Slack post' \
    "$(grep -c '^notify' "$d/calls")$(grep -cF $'\tswitch\t'"$FALLBACK"$'\t' "$LOG")" 01
  printf '%s\n' '%1 seat' '%2 orch' '%3 steward' '%4 by-hand' '%7 successor' '%8 no-record' > "$d/sess"   # a handoff during the outage came up on `current`
  printf '%s\t%s\n' '%1' "$FALLBACK" '%2' "$FALLBACK" '%3' "$c3" '%4' "$exp" '%7' "$FALLBACK" > "$d/live"
  # THE LIFT (owner, 2026-09-18): "major sessions like [the planning seats] automatically go back on fable via
  # automatic handoff. the other sessions that should technically be on fable … get an automatic message asking me if
  # i want to handoff … thumbs up means trigger handoff." — and 2026-09-20: "when fable is back, session goes onto
  # fable as needed": a session WITH A ROW (the box moved it) is handed off unasked, major or not; the card is for a
  # rowless one launched on the fallback meanwhile. cc-handoff and cc-slack are stubs that record what they were
  # asked; the major list is set by hand here, the default rule has its own cases below.
  printf '#!/bin/sh\necho "$2" >> "%s/handoffs"\n' "$d" > "$d/bin/cc-handoff"; chmod +x "$d/bin/cc-handoff"
  printf '#!/bin/sh\ncase "$1" in channels) cat "%s/chans" 2>/dev/null;; post) printf "%%s\\t%%s\\n" "$3" "$5" >> "%s/cards"; echo 1700000000.000100;; esac\n' "$d" "$d" > "$d/bin/cc-slack"; chmod +x "$d/bin/cc-slack"
  printf '#!/bin/sh\nexit 1\n' > "$d/bin/cc-config"; chmod +x "$d/bin/cc-config"
  handoffs(){ paste -sd'|' "$d/handoffs" 2>/dev/null; }; cards(){ sed -n 's/^[^\t]*\t\[return\] \([^:]*\):.*/\1/p' "$d/cards" 2>/dev/null | paste -sd'|' -; }
  : > "$d/handoffs"; : > "$d/cards"; : > "$d/chans"; rm -f "$RETURNED"
  CC_MODEL_MAJOR="seat orch"; CC_MODEL_RETURN_CHANNEL='#box'
  : > "$d/typed"; do_switch "$PRIMARY" 'limit lifted (probe)'
  t '(b) its lift: a MAJOR session that was on the primary gets an overlapping handoff launched, and no message — and so does a minor one the box MOVED off it (its row is the owner'"'"'s word)' \
    "$(handoffs):$(typed seat)$(typed orch)$(typed no-record):$(cards)" "seat|orch|no-record::successor"
  t '(b) …the rowless one launched on the fallback during the outage gets ONE card in its channel, nothing typed: nothing on record says it belongs on the primary' \
    "$(cut -f1,2 "$d/cards" | tr '\t' ' ' | paste -sd'|' -)" "#box [return] successor: Fable 5.1 is back and this session is on Opus 5 — :+1: hands it back (a successor alongside, then cutover)"
  t '(b) …nothing is typed into any of them: no /model line, no restart' "$(wc -l < "$d/typed")" 0
  t '(b) …the steward stays on Sonnet, and the one a person put on Opus stays on Opus' "$(typed steward)$(typed by-hand)" ""
  t '(b) the episode is over: the rows go, the override goes' "$([ -e "$MOVED" ] && echo rows)$([ -e "$OV" ] && echo ov)" ""
  t '(b) the log says which window got which, and the ledger holds one row per window' \
    "$(awk -F'\t' '$3=="handoff"||$3=="card"{print $3}' "$LOG" | paste -sd, -):$(cut -f1,3 "$RETURNED" | tr '\t' = | paste -sd, -)" \
    "handoff,handoff,card,handoff:seat=handoff,orch=handoff,successor=card,no-record=handoff"
  t '(b) nothing goes to the owner for the restore either — the $LOG row is the record' \
    "$(grep -c '^notify' "$d/calls")$(grep -cF $'\tswitch\t'"$PRIMARY"$'\t' "$LOG")" 01
  # a second flip inside the same outage — the probe answered, Fable refused again minutes later, the probe answers
  # again — sends nothing twice: the ledger rows are younger than the gap
  local pold; pold="${PRIMARY%%\[*}"; pold="${pold%-1}"   # the primary family's OLD id: same family, a different id
  printf '%s\t%s\n' '%1' "$FALLBACK" '%2' "$FALLBACK" '%3' "$c3" '%4' "$exp" '%5' "$pold" '%7' "$FALLBACK" '%8' "$FALLBACK" > "$d/live"
  printf '%s\n' '%1 seat' '%2 orch' '%3 steward' '%4 by-hand' '%5 self-back' '%7 successor' '%8 no-record' > "$d/sess"   # %5: back on the primary's family by itself, on its old id
  printf '%s\tseat\t%s\t%s\tmoved\tfable\n%s\tsuccessor\t%s\t%s\tmoved\tfable\n%s\tself-back\t%s\t%s\tmoved\tfable\n%s\tby-hand\t%s\t%s\tkept\t\n' '%1' "$PRIMARY" "$now" '%7' "$PRIMARY" "$now" '%5' "$PRIMARY" "$now" '%4' "$exp" "$now" > "$MOVED"
  # (the rows stand: the override is open, so the episode is not over and nothing drops them)
  do_switch "$PRIMARY" 'limit lifted (probe)'
  t '(b) a second flip within the same outage: no second handoff, no second card — and a session already on the primary'"'"'s family gets neither' \
    "$(handoffs):$(cards)" "seat|orch|no-record:successor"
  # …but a NEW outage that moves the window off the primary again clears its row, so the next lift returns it again
  printf '%s\t%s\n' '%1' "$PRIMARY" '%7' "$PRIMARY" > "$d/live"; printf '%s\n' '%1 seat' '%7 successor' > "$d/sess"
  : > "$d/typed"; : > "$LOG"   # retuned_recently reads the log, and `now` is one instant for the whole selfcheck
  SWITCH_TILL=$((now + 3600)); do_switch "$FALLBACK" "$(fam "$PRIMARY") limit"; SWITCH_TILL=0
  t '(b) a new outage moves the returned sessions down again, and forgets their returns' \
    "$(typed seat):$(typed successor):$([ -s "$RETURNED" ] && cut -f1 "$RETURNED" | paste -sd, -)" "/model $FALLBACK:/model $FALLBACK:orch,no-record"
  printf '%s\t%s\n' '%1' "$FALLBACK" '%7' "$FALLBACK" > "$d/live"; do_switch "$PRIMARY" 'limit lifted (probe)'
  t '(b) …so its lift hands them back once more' "$(handoffs):$(cards)" "seat|orch|no-record|seat|successor:successor"
  # THE THUMBS-UP: cc-slack runs `cc-model return <window>` on a 👍 on the card
  : > "$d/handoffs"; printf '%s\n' '%7 successor' '%9 on-fable' > "$d/sess"; printf '%s\t%s\n' '%7' "$FALLBACK" '%9' "$PRIMARY" > "$d/live"
  t '(b) a thumbs-up launches the handoff for that window, and says so' "$(return_cmd successor):$(handoffs)" "cc-model: successor — handoff to Fable 5.1 started:successor"
  t '(b) …a session already on the primary is never handed off' "$({ return_cmd on-fable; printf ' rc=%s' $?; } | tr -d '\n'):$(handoffs)" "cc-model: on-fable is on Fable 5.1 already — nothing to hand off rc=0:successor"
  t '(b) …and one with no live session has nothing to hand off' "$({ return_cmd gone; printf ' rc=%s' $?; } | tr -d '\n')" "cc-model: no live session in main:gone rc=1"
  printf '#!/bin/sh\necho "cc-handoff: $2 already has an overlap open (phase overlap, live predecessor) — one successor at a time"; exit 1\n' > "$d/bin/cc-handoff"
  t '(b) …cc-handoff'"'"'s refusal is the answer, and the ledger keeps no row for a handoff that did not start' \
    "$(rm -f "$RETURNED"; { return_cmd successor; printf ' rc=%s' $?; } | tr -d '\n'):$([ -e "$RETURNED" ] && echo row)" "cc-model: successor — handoff not started (successor already has an overlap open (phase overlap, live predecessor) — one successor at a time) rc=1:"
  printf '#!/bin/sh\necho "$2" >> "%s/handoffs"\n' "$d" > "$d/bin/cc-handoff"
  # THE DEFAULT MAJOR LIST: a repo's planning seat and its orchs; not a track, a member workspace, or a window mid-handoff
  unset CC_MODEL_MAJOR; CC_MODEL_MEMBERS="$d/members"; mkdir -p "$d/members/member-a"
  t '(b) by default a planning seat and an orch are major; a track, a member workspace and a ~next window are not' \
    "$(major demo && echo 1)$(major demo@orch && echo 1)$(major demo/track && echo 1)$(major member-a && echo 1)$(major demo~next && echo 1)" 11
  t '(b) CC_MODEL_MAJOR, when set, is the whole list' "$(CC_MODEL_MAJOR='demo/track,other' major demo/track && echo 1)$(CC_MODEL_MAJOR='demo/track,other' major demo && echo 1)" 1
  # THE CARD'S CHANNEL: the track's own, else the orch's own, else the repo's, else the box's
  printf '%s\n' 'C1 #demo' 'C2 #demo--t1' 'C3 #demo-site-ab12' 'C4 #demo-updates' > "$d/chans"
  t '(b) a card goes to the track'"'"'s own channel when it has one, the orch'"'"'s own, else the repo'"'"'s, else the box'"'"'s' \
