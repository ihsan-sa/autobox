  t '(d) …the 15-minute throttle covers the whole pass: nothing is asked twice inside one window' "$asked" ""
  rm -f "$ST/model-probed"; note_unavailable "$(fam "$c2")" 'the cap again'; note_unavailable "$(fam "$PRIMARY")" 'the cap'
  asked=""; probe_unavailable
  t '(d) two models out: each is asked for once, the primary on its own probe id' "$asked" "$pc2 $PROBEM"
  t '(d) …the one that answered is forgotten, the one still limited is kept, and the log says which' \
    "$(cut -f1 "$UNAV" | paste -sd, -):$(grep -cF "$(printf '\tprobe\t%s\tstill limited' "$PROBEM")" "$LOG")" "$(fam "$PRIMARY"):1"
  unset -f probe
  # ── (e) NO SESSION SITS ON A MODEL DIALOG OR LANDS BELOW ITS BAND (owner, 2026-09-20) ────────────────────────────
  # One fixture per dialog wording, each through the real tick with a tmux stub that records every key: the limit
  # dialog offering Sonnet (Esc, /model Opus, the resume line), the same offering Opus (Enter, banked as moved), the
  # safeguards dialog (Switch automatically), the line the CLI leaves after its own switch, and the two harness
