#!/usr/bin/env bash
# cc-boot — ensure the tmux server exists, owned by tmux-main.service (never by the caller's cgroup; 2026-08-26 incident).
# Idempotent: no-op while session "main" is up; otherwise (re)start the unit, which runs tmux new-session itself.
tmux has-session -t main 2>/dev/null && exit 0
if systemctl --user is-active --quiet tmux-main.service; then
  # Server alive, session "main" gone: ask the RUNNING server for it. Never `systemctl restart` here —
  # ExecStop=tmux kill-server would kill every other session too (that restart is owner-only).
  exec tmux new-session -d -s main -n box -c "$HOME/dev" "$HOME/bin/cc-rc"
fi
exec systemctl --user start tmux-main.service
