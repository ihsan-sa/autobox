#!/usr/bin/env python3
"""cc-tmp-reap — remove the temp dirs the box's own tools leave behind in /tmp and ~/.cc/tmp, and nothing else.

WHY. /tmp is a tmpfs with a per-user quota here, and a landing's gates need a few GB of it. Selfchecks, gates and
sessions each leave a directory behind when they end badly (and many when they end well), thousands a week; twice
the pile reached the quota mid-landing and killed it. Teaching each tool to clean up is its own work; this is the
floor under all of them. cc-reconcile.service runs `cc-tmp-reap --apply` on its tick.

WHERE. Each temp root in roots(), once: /tmp, the box's scratch on disk ~/.cc/tmp (TMPDIR for every unit since
config/environment.d/cc-tmp.conf, and cc-land's own), and whatever TMPDIR names. /tmp stays on the list after TMPDIR
moves, because a tool started with the old environment still writes there.

WHAT IT MAY REMOVE — every rule, all of them at once:
  · an entry directly under the temp root (or one session dir, below), owned by this user, not a symlink;
  · whose name is one of FAMILIES: a known prefix plus mktemp's random tail. A name nothing here made is never
    touched, however old — `tmp.XXXX`, a bare mkdtemp and a person's `/tmp/notes` included;
  · whose newest mtime/ctime anywhere inside is older than --hours (24);
  · that no process of this user holds: no cwd, open file or mapped file under it;
  · `cc-land.run.<pid>.*`: and the pid is not a live cc-land. One carrying cc-land's `.kept` marker (a red gate's
    log kept for a person) is left for 72 h;
  · `claude-<uid>/<cwd-slug>/<session-id>`: a Claude session's scratch, and no process of this user names that
    session id in its argv or environment, and no live claude process has it in ~/.claude/sessions/<pid>.json.
    A live claude process whose id neither says (some resumed and remote sessions) keeps every session dir under
    its own cwd's slug, since which one is its own cannot be told. A session's scratch is never taken under 24 h
    old, whatever --hours says;
  · and all of that still holds right before its own remove: an --apply over thousands of entries takes minutes,
    and a `claude --continue` started meanwhile names no id in its argv. So each entry is judged again against a
    process list that has every process started since the plan in it (and is read whole again every RECHECK_S),
    and its newest mtime must be the one it was judged by; an entry that fails either is left for the next tick.

  cc-tmp-reap [--hours N]            dry run: every entry it would remove, its size, and the totals. Removes nothing
  cc-tmp-reap --apply [--hours N]    remove them; one summary line per family
  cc-tmp-reap selfcheck              fixtures in a temp root and processes of its own, never this box's /tmp
"""
import os
import json
import re
import shutil
import subprocess
import sys
import tempfile
import time

TAIL = r"[A-Za-z0-9_]{6,}"
# (family, regex over the entry's name). Each is a prefix one of the box's tools hands mktemp/mkdtemp.
FAMILIES = [
    ("dashboard selfcheck", r"dash-(nodeps|deps|web|src|all|runs|work|tutor|deep|home|sec|life)-" + TAIL),
    ("cc-brief", r"cc-brief(-sc)?\." + TAIL),
    ("empty HOMEs", r"(claude|ccspend)-empty-" + TAIL),
    ("cc-green gate logs", r"cc-green\.gate\." + TAIL),
    ("cc-slack selfcheck", r"cc-slack-[A-Za-z-]+-_?" + TAIL),
    ("cc-land selfcheck", r"cc-land-selfcheck-[a-z]+-" + TAIL),
    ("lessons selfcheck", r"lessons-(resolv|creds|creds-real|creds-rescope)-" + TAIL),
    ("slack outbox fixtures", r"_selfcheck_outbox_" + TAIL),
    ("other selfchecks", r"(cc-wakes\.|cc-check(-extra(-id)?)?\.|cc-bin-at\.|ccboard-sc(-lib)?-|cc-bundle-sc\.|"
                         r"cc-failures-(sc|replay)\.|cc-fence-|cc-improve(-[a-z]+)?-|cc-member-import-|"
                         r"cc-replay(-[a-z]+)?-|cc-stall-sc[.-]|cc-settings-sc\.|cc-evals-h\.|cc-audit(-sc)?\.|"
                         r"ccskills-|ccsbx[a-z]+-|cc-mint-)" + TAIL),
]
LAND_RUN = re.compile(r"cc-land\.run\.(\d+)\..+")
KEPT, KEPT_HOURS = ".kept", 72
SESSION = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
HOURS, SESSION_HOURS = 24.0, 24   # the default line, and the floor under a session's scratch (a resumed one reads it)
SESS_FAM, LAND_FAM = "dead sessions' scratch", "dead cc-land runs"
RECHECK_S = 5   # a full /proc read costs seconds on a busy box, so between two, only new pids are read


def family(name):
    for fam, rx in FAMILIES:
        if re.fullmatch(rx, name):
            return fam
    return None


def pids():
    return {int(d) for d in _ls("/proc") if d.isdigit()}


def procs(uid, only=None):
    """This user's processes (or those of them in `only`): (pid, argv-as-bytes, environ-as-bytes, the paths each
    holds — cwd, fds, mapped files)."""
    out = []
    for d in (map(str, only) if only is not None else os.listdir("/proc")):
        if not d.isdigit():
            continue
        p = f"/proc/{d}"
        try:
            if os.stat(p).st_uid != uid:
                continue
            argv = open(f"{p}/cmdline", "rb").read()
        except OSError:
            continue
        try:
            env = open(f"{p}/environ", "rb").read()
        except OSError:
            env = b""
        held = set()
        for link in ["cwd", "root"] + [f"fd/{f}" for f in _ls(f"{p}/fd")]:
            try:
                held.add(os.readlink(f"{p}/{link}"))
            except OSError:
                pass
        try:
            for ln in open(f"{p}/maps"):
                i = ln.find("/")
                if i > 0:
                    held.add(ln[i:].rstrip("\n").removesuffix(" (deleted)"))
        except OSError:
            pass
        out.append((int(d), argv, env, held))
    return out


def _ls(d):
    try:
        return os.listdir(d)
    except OSError:
        return []


def newest(path):
    """The newest mtime or ctime of `path` and everything under it (a fresh extract of old files counts as fresh)."""
    try:
        st = os.lstat(path)
    except OSError:
        return time.time()
    t = max(st.st_mtime, st.st_ctime)
    if os.path.isdir(path) and not os.path.islink(path):
        for r, ds, fs in os.walk(path, onerror=lambda e: None):
            for n in ds + fs:
                try:
                    s = os.lstat(os.path.join(r, n))
                    t = max(t, s.st_mtime, s.st_ctime)
                except OSError:
                    pass
    return t


def size(path):
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    n = st.st_blocks * 512
    if os.path.isdir(path) and not os.path.islink(path):
        for r, ds, fs in os.walk(path, onerror=lambda e: None):
            for x in ds + fs:
                try:
                    n += os.lstat(os.path.join(r, x)).st_blocks * 512
                except OSError:
                    pass
    return n


def live_sessions(ps, sessions_dir):
    """(session ids a live claude process names in argv, env or its ~/.claude/sessions/<pid>.json;
    cwd slugs of the live claude processes whose id none of those gives)."""
    rx = SESSION.pattern.encode()
    named, blind = set(), set()
    for pid, argv, env, _ in ps:
        named.update(m.decode() for m in re.findall(rx, argv + b"\0" + env))
        if os.path.basename(argv.split(b"\0")[0]) != b"claude":
            continue
        ids = set(re.findall(rx, argv + b"\0" + env))
        cwds = set()
        try:
            j = json.load(open(f"{sessions_dir}/{pid}.json"))
            if SESSION.fullmatch(str(j.get("sessionId", ""))):
                ids.add(j["sessionId"].encode())
                named.add(j["sessionId"])
            if j.get("cwd"):
                cwds.add(j["cwd"])
        except (OSError, ValueError, AttributeError):
            pass
        if not ids:
            try:
                cwds.add(os.readlink(f"/proc/{pid}/cwd"))
            except OSError:
                pass
            blind.update(re.sub(r"[^A-Za-z0-9]", "-", c) for c in cwds)
    return named, blind


def live(ps, root, sessions_dir):
    """What the processes `ps` keep alive under `root`: (held names — top entries and claude-<uid>/<slug>/<sid> —,
    session ids named, blind cwd slugs, live cc-land pids)."""
    held = set()
    for _, _, _, paths in ps:
        for h in paths:
            if h.startswith(root + "/"):
                parts = h[len(root) + 1:].split("/")
                held.add(parts[0])
                held.add("/".join(parts[:3]))
    named, blind = live_sessions(ps, sessions_dir)
    landers = {pid for pid, argv, _, _ in ps if any(b"cc-land" in a for a in argv.split(b"\0")[:3])}
    return held, named, blind, landers


def plan(root, uid, now, hours, ps, sessions_dir):
    """[(path, family, newest mtime)] under `root` that every rule in the docstring lets go. Reads, never writes."""
    cutoff, kept_cutoff = now - hours * 3600, now - KEPT_HOURS * 3600
    sess_cutoff = min(cutoff, now - SESSION_HOURS * 3600)
    held, named, blind, live_landers = live(ps, root, sessions_dir)

    def ours(p):
        try:
            st = os.lstat(p)
        except OSError:
            return False
        return st.st_uid == uid and not os.path.islink(p)

    out = []
    for name in sorted(_ls(root)):
        p = f"{root}/{name}"
        if not ours(p):
            continue
        if name == f"claude-{uid}" and os.path.isdir(p):   # every live session holds this dir; judged per session
            for slug in sorted(_ls(p)):
                sp = f"{p}/{slug}"
                if not ours(sp) or not os.path.isdir(sp) or slug in blind:
                    continue
                for sid in sorted(_ls(sp)):
                    q = f"{sp}/{sid}"
                    rel = f"{name}/{slug}/{sid}"
                    if (SESSION.fullmatch(sid) and sid not in named and rel not in held and ours(q)
                            and os.path.isdir(q)):
                        t = newest(q)
                        if t < sess_cutoff:
                            out.append((q, SESS_FAM, t))
            continue
        if name in held:
            continue
        m = LAND_RUN.fullmatch(name)
        if m:
            if int(m.group(1)) in live_landers or not os.path.isdir(p):
                continue
            t = newest(p)
            if t < (kept_cutoff if os.path.exists(f"{p}/{KEPT}") else cutoff):
                out.append((p, LAND_FAM, t))
            continue
        fam = family(name)
        if fam:
            t = newest(p)
            if t < cutoff:
                out.append((p, fam, t))
    return out


def still_dead(root, p, fam, t, state):
    """The plan's verdict on `p`, taken again right before its remove: nothing in `state` (live()) keeps it, and its
    newest mtime is still `t`."""
    held, named, blind, landers = state
    rel = p[len(root) + 1:]
    parts = rel.split("/")
    if fam == SESS_FAM:   # every live session holds claude-<uid> itself, so the session dir is what counts
        if rel in held or parts[2] in named or parts[1] in blind:
            return False
    elif parts[0] in held:
        return False
    if fam == LAND_FAM and int(LAND_RUN.fullmatch(parts[0]).group(1)) in landers:
        return False
    return newest(p) == t


def remove(p):
    if os.path.isdir(p) and not os.path.islink(p):
        shutil.rmtree(p, ignore_errors=True)
    else:
        try:
            os.unlink(p)
        except OSError:
            pass
    return not os.path.lexists(p)


def mb(n):
    return f"{n / 1e6:.1f} MB"


def run(root, apply_, hours, now=None, uid=None, out=sys.stdout, sessions=None):
    root = os.path.realpath(root)   # the kernel names held paths canonically
    uid = os.getuid() if uid is None else uid
    now = time.time() if now is None else now
    sessions = os.path.expanduser("~/.claude/sessions") if sessions is None else sessions
    seen = pids()   # read before the processes, so one started during the read counts as new below
    ps, taken = procs(os.getuid()), time.monotonic()
    todo = plan(root, uid, now, hours, ps, sessions)
    state = None
    fams, total, gone = {}, 0, 0
    for p, fam, t in todo:
        n = size(p)
        if apply_:
            now_pids = pids()
            if time.monotonic() - taken > RECHECK_S:
                ps, seen, taken, state = procs(os.getuid()), now_pids, time.monotonic(), None
            elif now_pids - seen:   # a process gone stays in `ps`: it can only keep more, never less
                ps, seen, state = ps + procs(os.getuid(), now_pids - seen), seen | now_pids, None
            state = state or live(ps, root, sessions)
            if not still_dead(root, p, fam, t, state):
                print(f"cc-tmp-reap: left {p}: in use or written to since it was judged", file=out)
                continue
            if not remove(p):
                print(f"cc-tmp-reap: could not remove {p}", file=out)
                continue
            gone += 1
        else:
            print(f"would remove {mb(n):>10}  {p}", file=out)
        c = fams.setdefault(fam, [0, 0])
        c[0] += 1
        c[1] += n
        total += n
    for fam, (c, n) in sorted(fams.items(), key=lambda x: -x[1][1]):
        print(f"  {fam}: {c}, {mb(n)}", file=out)
    verb = "removed" if apply_ else "would remove"
    print(f"cc-tmp-reap: {verb} {sum(c for c, _ in fams.values())} entries, {mb(total)} "
          f"(older than {hours:g} h, no process holding them) in {root}", file=out)
    return todo


# ── selfcheck ───────────────────────────────────────────────────────────────────────────────────────────────
SCRATCH = os.path.expanduser("~/.cc/tmp")   # the box's scratch on disk: config/environment.d/cc-tmp.conf


def roots():
    """The temp roots to reap, each once by its real path, leaving out one that does not exist."""
    return [r for r in dict.fromkeys(os.path.realpath(p) for p in ("/tmp", SCRATCH, tempfile.gettempdir()))
            if os.path.isdir(r)]


def selfcheck():
    import contextlib
    import io
    cases = []

    def ok(what, cond):
        cases.append((what, bool(cond)))
        print(f"  {'ok ' if cond else 'FAIL'} {what}")

    base = tempfile.mkdtemp(prefix="cc-tmp-reap-sc.")
    root = f"{base}/tmp"
    os.makedirs(root)
    kids = []
    try:
        uid = os.getuid()
        sid_dead, sid_argv, sid_env = ("11111111-2222-3333-4444-555555555555", "22222222-3333-4444-5555-666666666666",
                                       "33333333-4444-5555-6666-777777777777")

        def mk(rel, files=("f",)):
            d = f"{root}/{rel}"
            os.makedirs(d, exist_ok=True)
            for f in files:
                with open(f"{d}/{f}", "w") as fh:
                    fh.write("x" * 5000)
            return d

        # the clock is run two days ahead, so every fixture is "old" unless it is dated into that future on purpose
        now = time.time() + 2 * 86400
        old_dash = mk("dash-src-abc12345")
        mk("cc-brief.q1w2e3r4")
        open(f"{root}/cc-green.gate.Ab12Cd", "w").write("log")
        young = mk("dash-web-young123")
        fresh_inside = mk("cc-slack-selfcheck-in5ide77", ("a", "b"))
        for p in (young, f"{young}/f", f"{fresh_inside}/b"):
            os.utime(p, (now, now))
        unnamed = [mk("tmp.AbCdEf1234"), mk("abcdefgh12"), mk("notes"), mk("dash-src-")]
        target = mk("real-dir-elsewhere")
        os.symlink(target, f"{root}/cc-brief.l1nk3d99")
        cwd_held = mk("cc-land-selfcheck-h-cwdheld1")
        fd_held = mk("claude-empty-fdheld12")
        map_held = mk("ccspend-empty-maphld12")
        run_dead = mk("cc-land.run.999999999.dead1234", ("cc-land.gates.r.1.x",))
        run_live = mk("cc-land.run.PID.live1234")
        run_kept = mk("cc-land.run.999999998.kept1234", (KEPT, "cc-land-gate-x.log"))
        s_dead = mk(f"claude-{uid}/-home-u-dev-r/{sid_dead}/scratchpad")
        s_argv = mk(f"claude-{uid}/-home-u-dev-r/{sid_argv}/scratchpad")
        s_env = mk(f"claude-{uid}/-home-u-dev-r/{sid_env}/tasks")
        s_notsid = mk(f"claude-{uid}/-home-u-dev-r/not-a-session")
        s_cwd = mk(f"claude-{uid}/-home-u-dev-r/44444444-5555-6666-7777-888888888888")
        sid_json = "55555555-6666-7777-8888-999999999999"
        s_json = mk(f"claude-{uid}/-home-u-dev-r/{sid_json}/tasks")
        blind_cwd = mk("blind-proj.x")   # a live claude process in here names no id anywhere
        blind_slug = re.sub(r"[^A-Za-z0-9]", "-", blind_cwd)
        s_blind = mk(f"claude-{uid}/{blind_slug}/66666666-7777-8888-9999-aaaaaaaaaaaa/scratchpad")
        sessions = f"{base}/sessions"
        os.makedirs(sessions)

        sleep = shutil.which("sleep")

        # Every fixture process in a group of its own, so killpg ends it whole, and with no session id inherited from
        # the caller: run from inside a Claude session, CLAUDE_CODE_SESSION_ID made the "blind" claude a named one.
        quiet = {k: v for k, v in os.environ.items() if not SESSION.search(v)}

        def spawn(*a, **k):
            return subprocess.Popen(*a, start_new_session=True, **{"env": quiet, **k})
        kids.append(spawn([sleep, "60"], cwd=cwd_held))
        kids.append(spawn([sys.executable, "-c", "import sys,time; f=open(sys.argv[1]); time.sleep(60)",
                                      f"{fd_held}/f"]))
        kids.append(spawn([sys.executable, "-c", "import mmap,sys,time; f=open(sys.argv[1],'rb'); "
                                      "m=mmap.mmap(f.fileno(),0,access=mmap.ACCESS_READ); f.close(); time.sleep(60)",
                                      f"{map_held}/f"]))
        lander = spawn(["bash", "-c", "exec -a cc-land sleep 60"])
        kids.append(lander)
        live_name = f"cc-land.run.{lander.pid}.live1234"
        os.rename(run_live, f"{root}/{live_name}")
        run_live = f"{root}/{live_name}"
        kids.append(spawn(["bash", "-c", "sleep 60; :", sid_argv]))
        kids.append(spawn([sleep, "60"], env={**os.environ, "SOME_SESSION": sid_env}))
        kids.append(spawn([sleep, "60"], cwd=s_cwd))
        by_json = spawn(["bash", "-c", "exec -a claude sleep 60"])
        kids.append(by_json)
        json.dump({"sessionId": sid_json, "cwd": "/home/u/dev/r"}, open(f"{sessions}/{by_json.pid}.json", "w"))
        kids.append(spawn(["bash", "-c", "exec -a claude sleep 60"], cwd=blind_cwd))
        time.sleep(0.5)   # let each child reach its cwd, its open() and its mmap

        def reap(apply_, when=now, as_uid=None, hours=HOURS):
            buf = io.StringIO()
            todo = run(root, apply_, hours, now=when, uid=as_uid, out=buf, sessions=sessions)
            return {p for p, *_ in todo}, buf.getvalue()

        dry, text = reap(False)
        ok("a dry run removes nothing", all(os.path.lexists(p) for p in dry) and dry)
        ok("…and prints each entry it would remove with its size, and a total",
           "would remove" in text and old_dash in text and " MB" in text and "cc-tmp-reap: would remove" in text)
        ok("an old dir of a named family goes", old_dash in dry and f"{root}/cc-brief.q1w2e3r4" in dry)
        ok("an old file of a named family goes (a gate log)", f"{root}/cc-green.gate.Ab12Cd" in dry)
        ok("a young one stays", young not in dry)
        ok("an old dir with one fresh file inside stays", fresh_inside not in dry)
        ok("names no tool here made stay, however old (tmp.*, a bare mkdtemp, a person's dir, a prefix alone)",
           not dry.intersection(unnamed))
        ok("a symlink named like a family stays, and so does what it points at",
           f"{root}/cc-brief.l1nk3d99" not in dry and target not in dry)
        ok("a dir some process has as its cwd stays", cwd_held not in dry)
        ok("a dir holding a file some process has open stays", fd_held not in dry)
        ok("a dir holding a file some process has mapped stays", map_held not in dry)
        ok("a cc-land run root whose pid is dead goes", run_dead in dry)
        ok("…and one whose pid is a live cc-land stays", run_live not in dry)
        ok("…and one with the .kept marker stays for 72 h", run_kept not in dry)
        ok("…and goes after them", run_kept in reap(False, when=now + 3 * 86400)[0])
        ok("a session's scratch whose id no process names goes", os.path.dirname(s_dead) in dry)
        ok("…and one whose id is in a live process's argv stays", os.path.dirname(s_argv) not in dry)
        ok("…and one whose id is in a live process's environment stays", os.path.dirname(s_env) not in dry)
        ok("…and one a live process has its cwd in stays", s_cwd not in dry)
        ok("…and one a live claude's ~/.claude/sessions/<pid>.json names stays", os.path.dirname(s_json) not in dry)
        ok("…and every one under the cwd slug of a live claude that names no id stays",
           os.path.dirname(s_blind) not in dry)
        ok("…and a dir under claude-<uid> that is not a session id stays, and so do the slug dir and the root",
           s_notsid not in dry and f"{root}/claude-{uid}" not in dry and f"{root}/claude-{uid}/-home-u-dev-r" not in dry)
        ok("another user's entries are never taken", not reap(False, as_uid=uid + 12345)[0])
        ok("--hours moves the line: at 100 h the two-day-old fixtures stay", not reap(False, hours=100)[0])
        at13 = reap(False, when=time.time() + 13 * 3600, hours=12)[0]
        ok("…but a session's scratch stays under 24 h whatever --hours says, while a 13 h old family dir goes",
           old_dash in at13 and os.path.dirname(s_dead) not in at13)
        err, read, real_roots = io.StringIO(), [], roots
        try:   # roots() stands in for the box's: a refusal that regressed would reach no real root, and is seen here
            globals()["roots"] = lambda: read.append(1) or []
            with contextlib.redirect_stderr(err):
                rc = main(["--apply", "--hours", "0.5"])
        finally:
            globals()["roots"] = real_roots
        ok("--hours below 1 is refused before any root is read", rc == 2 and "below 1" in err.getvalue() and not read)
        gone, text = reap(True)
        ok("--apply removes exactly what the dry run listed", gone == dry and not any(os.path.lexists(p) for p in gone))
        ok("…and leaves every other fixture in place",
           all(os.path.lexists(p) for p in [young, fresh_inside, cwd_held, fd_held, map_held, run_live, run_kept,
                                             target, s_argv, s_env, s_cwd, s_json, s_blind, *unnamed]))
        ok("…and says what it removed per family", "cc-tmp-reap: removed" in text and "dashboard selfcheck: 1" in text)
        ok("a second run finds nothing more to do", not reap(True)[0])
        # An entry rmtree cannot empty (a dir inside it with no write bit) is named, and not counted as removed.
        stuck = mk("dash-deps-stuck123/sub")
        os.chmod(stuck, 0o500)
        try:
            _, text = reap(True)
            ok("an entry that cannot be removed is said so, stays, and is not counted",
               f"could not remove {os.path.dirname(stuck)}" in text and "removed 0 entries" in text
               and os.path.lexists(f"{stuck}/f"))
        finally:
            os.chmod(stuck, 0o700)
            shutil.rmtree(os.path.dirname(stuck), ignore_errors=True)

        # Between the plan and each remove: a file written, a process that takes a dir as its cwd, and a claude that
        # names no session id started in a project whose session scratch was judged dead. Once with only the new pids
        # read (a RECHECK_S far off), once with /proc read whole again (a RECHECK_S already passed).
        def race(tag, recheck):
            written, held = mk(f"dash-home-{tag}wr1"), mk(f"dash-deps-{tag}hld1")
            gone_ok = mk(f"dash-all-{tag}go1")
            proj = mk(f"late-{tag}.x")
            sdir = os.path.dirname(mk(f"claude-{uid}/{re.sub(r'[^A-Za-z0-9]', '-', proj)}/"
                                      f"77777777-8888-9999-aaaa-bbbbbbbbbbbb/scratchpad"))
            real_plan, real_recheck = plan, RECHECK_S

            def racing(*a, **k):
                todo = real_plan(*a, **k)
                os.utime(f"{written}/f")
                kids.append(spawn([sleep, "60"], cwd=held))
                kids.append(spawn(["bash", "-c", "exec -a claude sleep 60"], cwd=proj))
                time.sleep(0.5)
                return todo
            try:
                globals()["plan"], globals()["RECHECK_S"] = racing, recheck
                todo, text = reap(True)
            finally:
                globals()["plan"], globals()["RECHECK_S"] = real_plan, real_recheck
            judged = {written, held, gone_ok, sdir} <= todo
            ok(f"[{tag}] all four were judged dead, and the one nothing touched since goes",
               judged and not os.path.lexists(gone_ok))
            ok(f"[{tag}] one written to after the plan is left, and says so",
               os.path.lexists(f"{written}/f") and f"left {written}:" in text)
            ok(f"[{tag}] one a process started after the plan holds is left",
               os.path.lexists(f"{held}/f") and f"left {held}:" in text)
            ok(f"[{tag}] a session's scratch under the cwd of a claude started after the plan is left",
               os.path.lexists(f"{sdir}/scratchpad/f") and f"left {sdir}:" in text)
        race("newpid", 3600)
        race("reread", 0)
        # WHERE: the scratch on disk and TMPDIR are reaped beside /tmp, each once; a root that is missing is skipped.
        real_scratch, real_tempdir = SCRATCH, tempfile.tempdir
        try:
            globals()["SCRATCH"], tempfile.tempdir = f"{base}/scratch", root
            missing = roots()
            os.makedirs(SCRATCH)
            both = roots()
            tempfile.tempdir = SCRATCH
            same = roots()
        finally:
            globals()["SCRATCH"], tempfile.tempdir = real_scratch, real_tempdir
        ok("roots: /tmp, the scratch on disk and TMPDIR are each reaped — and TMPDIR naming the scratch lists it once",
           both == ["/tmp", os.path.realpath(f"{base}/scratch"), os.path.realpath(root)]
           and same == ["/tmp", os.path.realpath(f"{base}/scratch")])
        ok("…and a scratch root that does not exist yet is left out, not an error",
           missing == ["/tmp", os.path.realpath(root)])
    finally:
        for k in kids:   # the whole group: a `bash -c` fixture's sleep would outlive its shell
            try:
                os.killpg(k.pid, 9)
            except OSError:
                k.kill()
            k.wait()
        shutil.rmtree(base, ignore_errors=True)
    bad = [w for w, c in cases if not c]
    print(f"cc-tmp-reap selfcheck: {len(cases) - len(bad)} passed, {len(bad)} failed")
    return 1 if bad else 0


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    apply_, hours = False, HOURS
    it = iter(argv)
    for a in it:
        if a == "--apply":
            apply_ = True
        elif a == "--hours":
            try:
                hours = float(next(it))
            except (StopIteration, ValueError):
                print("cc-tmp-reap: --hours takes a number", file=sys.stderr)
                return 2
            if hours < 1:
                print("cc-tmp-reap: --hours below 1 would take what a running gate uses", file=sys.stderr)
                return 2
        else:
            print(__doc__, file=sys.stderr)
            return 2
    for r in roots():
        run(r, apply_, hours)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
