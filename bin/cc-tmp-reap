#!/usr/bin/env python3
"""cc-tmp-reap — remove the temp dirs the box's own tools leave behind in /tmp and ~/.cc/tmp, and nothing else.

WHY. /tmp is a tmpfs with a per-user quota here, and a landing's gates need a few GB of it. Selfchecks, gates and
sessions each leave a directory behind when they end badly (and many when they end well), thousands a week; twice
the pile reached the quota mid-landing and killed it. Teaching each tool to clean up is its own work; this is the
floor under all of them. cc-reconcile.service runs `cc-tmp-reap --apply` on its tick.

WHERE. Each temp root in roots(), once: /tmp, the box's scratch on disk ~/.cc/tmp (TMPDIR for every unit since
config/environment.d/cc-tmp.conf, and cc-land's own), and whatever TMPDIR names. /tmp stays on the list after TMPDIR
moves, because a tool started with the old environment still writes there.

WHAT IT MAY REMOVE — every rule, all of them at once:
  · an entry directly under the temp root (or one session dir, below), owned by this user, not a symlink;
  · whose name is one of FAMILIES: a known prefix plus mktemp's random tail. Any other name — `tmp.XXXX`, a bare
    mkdtemp, a session's own `/tmp/<task>`, a person's `/tmp/notes` — is left STALE_HOURS (72) since its last write,
    then goes too: those are what filled the /tmp quota on 2026-09-27 and killed an Xvfb. Never a dot name (a lock,
    .X11-unix) unless a family names it (headless Chrome's). That rule is for /tmp and ~/.cc/tmp only
    (stale_roots()): a TMPDIR naming some other dir gets the families and nothing else;
  · never `systemd-private-*` or `snap-private-tmp*` (NEVER), whatever else holds: a running service's PrivateTmp=yes
    /tmp lives there, owned by this user for a user unit, and nothing in /proc shows its path;
  · with no live socket at or under it (tmux's door, an agent's, a headless Chrome's), whatever its name or age: one
    bound now, as /proc/<pid>/net/unix lists it in any network namespace of this user's processes. A socket file
    whose server is gone pins nothing, and nor does a fifo: one a process has open is held (below), one nobody has
    open goes by age like any file;
  · whose newest mtime/ctime anywhere inside is older than --hours (24);
  · that no process of this user holds: no cwd, open file or mapped file under it, and no argv or environment
    naming it (a session that writes `/tmp/x/out` between commands holds nothing open there);
  · `cc-land.run.<pid>.*` (the lander's run root, which kept the old tool's name): and the pid is not a live lander,
    that is a process whose first three argv words name cc-land, bin/lander, lander-self or core/lander/cli.py (the
    shim execs the lander, so a running landing's argv is `python3 -P …/core/lander/cli.py <cmd> …`). One carrying
    the `.kept` marker (a red gate's log kept for a person) is left for 72 h;
  · `lander-job.*` (a spilled check's tree and HOME, left by job-serve before it handed jobs to cc-suites) and `lander-self.check.*` /
    `lander-self.shadow.*` (lander-self's scratch) are ordinary families: their tools remove them, this is the floor;
  · `claude-<uid>/<cwd-slug>/<session-id>`: a Claude session's scratch, and no process of this user names that
    session id in its argv or environment, and no live claude process has it in ~/.claude/sessions/<pid>.json.
    A live claude process whose id neither says (some resumed and remote sessions) keeps every session dir under
    its own cwd's slug, since which one is its own cannot be told. A session's scratch is never taken under 24 h
    old, whatever --hours says;
  · and all of that still holds right before its own remove: an --apply over thousands of entries takes minutes,
    and a `claude --continue` started meanwhile names no id in its argv. So each entry is judged again against a
    process list that has every process started since the plan in it (and is read whole again every RECHECK_S),
    and its newest mtime must be the one it was judged by; an entry that fails either is left for the next tick.

  cc-tmp-reap [--hours N]            dry run: every entry it would remove, its size, and the totals. Removes nothing
  cc-tmp-reap --apply [--hours N]    remove them; one summary line per family
  cc-tmp-reap selfcheck              fixtures in a temp root and processes of its own, never this box's /tmp
"""
import os
import json
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time

TAIL = r"[A-Za-z0-9_]{6,}"
# (family, regex over the entry's name). Each is a prefix one of the box's tools hands mktemp/mkdtemp.
FAMILIES = [
    ("dashboard selfcheck", r"dash-(nodeps|deps|web|src|all|runs|work|tutor|deep|home|sec|life)-" + TAIL),
    ("cc-brief", r"cc-brief(-sc)?\." + TAIL),
    ("empty HOMEs", r"(claude|ccspend)-empty-" + TAIL),
    ("cc-green gate logs", r"cc-green\.gate\." + TAIL),
    ("cc-slack selfcheck", r"cc-slack-[A-Za-z-]+-_?" + TAIL),
    ("cc-land selfcheck", r"cc-land-selfcheck-[a-z]+-" + TAIL),
    ("lander scratch", r"lander-(job|self\.check|self\.shadow)\." + TAIL),
    ("cc-suites render scratch", r"cc-(render|suites-err)\." + TAIL),
    ("lessons selfcheck", r"lessons-(resolv|creds|creds-real|creds-rescope)-" + TAIL),
    ("slack outbox fixtures", r"_selfcheck_outbox_" + TAIL),
    ("other selfchecks", r"(cc-wakes\.|cc-check(-extra(-id)?)?\.|cc-bin-at\.|ccboard-sc(-lib)?-|cc-bundle-sc\.|"
                         r"cc-failures-(sc|replay)\.|cc-fence-|cc-improve(-[a-z]+)?-|cc-member-import-|"
                         r"cc-replay(-[a-z]+)?-|cc-stall-sc[.-]|cc-settings-sc\.|cc-evals-h\.|cc-audit(-sc)?\.|"
                         r"ccskills-|ccsbx[a-z]+-|cc-mint-)" + TAIL),
    ("library selfcheck", r"library-pages-sc-(next-?|src-?)?" + TAIL),
    ("render bundles", r"remotion-webpack-bundle-" + TAIL),
    ("headless Chrome", r"\.com\.google\.Chrome\." + TAIL),
]
LAND_RUN = re.compile(r"cc-land\.run\.(\d+)\..+")
# A live lander's argv word: the old tool, the shim's target, lander-self, or the package's entry run by python3 -P.
LANDER_WORD = re.compile(rb"(?:cc-land|(?:^|/)lander(?:-self)?$|(?:^|/)lander/cli\.py$)")
KEPT, KEPT_HOURS = ".kept", 72
SESSION = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
HOURS, SESSION_HOURS = 24.0, 24   # the default line, and the floor under a session's scratch (a resumed one reads it)
SESS_FAM, LAND_FAM, STALE_FAM = "dead sessions' scratch", "dead lander runs", "stale scratch, no family"
STALE_HOURS = 72  # an entry no family names: left alone this long after its last write, and while anything names it
# A service's private /tmp (PrivateTmp=yes) and snap's: no process names the path, so no other rule would keep them.
NEVER = re.compile(r"systemd-private-.*|snap-private-tmp.*")
RECHECK_S = 5   # a full /proc read costs seconds on a busy box, so between two, only new pids are read


def family(name):
    for fam, rx in FAMILIES:
        if re.fullmatch(rx, name):
            return fam
    return None


def pids():
    return {int(d) for d in _ls("/proc") if d.isdigit()}


def procs(uid, only=None):
    """This user's processes (or those of them in `only`): (pid, argv-as-bytes, environ-as-bytes, the paths each
    holds — cwd, fds, mapped files)."""
    out = []
    for d in (map(str, only) if only is not None else os.listdir("/proc")):
        if not d.isdigit():
            continue
        p = f"/proc/{d}"
        try:
            if os.stat(p).st_uid != uid:
                continue
            argv = open(f"{p}/cmdline", "rb").read()
        except OSError:
            continue
        try:
            env = open(f"{p}/environ", "rb").read()
        except OSError:
            env = b""
        held = set()
        for link in ["cwd", "root"] + [f"fd/{f}" for f in _ls(f"{p}/fd")]:
            try:
                held.add(os.readlink(f"{p}/{link}"))
            except OSError:
                pass
        try:   # bytes: a path that is not UTF-8 must not raise out of the whole run. maps writes a newline as \012
            for ln in open(f"{p}/maps", "rb"):
                i = ln.find(b"/")
                if i > 0:
                    m = ln[i:].rstrip(b"\n").removesuffix(b" (deleted)")
                    held.update({os.fsdecode(m), os.fsdecode(m.replace(b"\\012", b"\n"))})
        except OSError:
            pass
        out.append((int(d), argv, env, held))
    return out


def _ls(d):
    try:
        return os.listdir(d)
    except OSError:
        return []


def newest(path):
    """The newest mtime or ctime of `path` and everything under it (a fresh extract of old files counts as fresh)."""
    try:
        st = os.lstat(path)
    except OSError:
        return time.time()
    t = max(st.st_mtime, st.st_ctime)
    if os.path.isdir(path) and not os.path.islink(path):
        for r, ds, fs in os.walk(path, onerror=lambda e: None):
            for n in ds + fs:
                try:
                    s = os.lstat(os.path.join(r, n))
                    t = max(t, s.st_mtime, s.st_ctime)
                except OSError:
                    pass
    return t


def bound_sockets(ps):
    """The AF_UNIX socket paths bound now: (full paths, last components). Read from /proc/<pid>/net/unix once per
    network namespace among `ps` and this process's own (a sandboxed session binds in its own namespace). A socket
    bound by a relative name is listed by that name alone, so its last component is all there is to match."""
    full, seen = set(), set()
    for pid in ["self"] + [str(p) for p, *_ in ps]:
        try:
            ns = os.readlink(f"/proc/{pid}/ns/net")
            if ns in seen:
                continue
            seen.add(ns)
            lines = open(f"/proc/{pid}/net/unix", "rb").read().split(b"\n")[1:]
        except OSError:
            continue
        for ln in lines:
            f = ln.split(None, 7)
            if len(f) == 8 and not f[7].startswith(b"@"):   # @: an abstract socket, no file
                full.add(os.fsdecode(f[7]))
    return full, {os.path.basename(x) for x in full}


def has_socket(path, bound):
    """A live socket at or under `path`: a server's door (tmux's, an agent's), whose mtime says nothing. `bound` is
    bound_sockets(); a socket file it does not list is a dead server's and pins nothing."""
    full, last = bound

    def live(q, m):
        return stat.S_ISSOCK(m) and (q in full or os.path.basename(q) in last)
    try:
        m = os.lstat(path).st_mode
    except OSError:
        return True
    if live(path, m):
        return True
    if stat.S_ISDIR(m):
        for r, ds, fs in os.walk(path, onerror=lambda e: None):
            for n in ds + fs:
                q = os.path.join(r, n)
                try:
                    m = os.lstat(q).st_mode
                except OSError:
                    continue
                if live(q, m):
                    return True
    return False


def size(path):
    try:
        st = os.lstat(path)
    except OSError:
        return 0
    n = st.st_blocks * 512
    if os.path.isdir(path) and not os.path.islink(path):
        for r, ds, fs in os.walk(path, onerror=lambda e: None):
            for x in ds + fs:
                try:
                    n += os.lstat(os.path.join(r, x)).st_blocks * 512
                except OSError:
                    pass
    return n


def live_sessions(ps, sessions_dir):
    """(session ids a live claude process names in argv, env or its ~/.claude/sessions/<pid>.json;
    cwd slugs of the live claude processes whose id none of those gives)."""
    rx = SESSION.pattern.encode()
    named, blind = set(), set()
    for pid, argv, env, _ in ps:
        named.update(m.decode() for m in re.findall(rx, argv + b"\0" + env))
        if os.path.basename(argv.split(b"\0")[0]) != b"claude":
            continue
        ids = set(re.findall(rx, argv + b"\0" + env))
        cwds = set()
        try:
            j = json.load(open(f"{sessions_dir}/{pid}.json"))
            if SESSION.fullmatch(str(j.get("sessionId", ""))):
                ids.add(j["sessionId"].encode())
                named.add(j["sessionId"])
            if j.get("cwd"):
                cwds.add(j["cwd"])
        except (OSError, ValueError, AttributeError):
            pass
        if not ids:
            try:
                cwds.add(os.readlink(f"/proc/{pid}/cwd"))
            except OSError:
                pass
            blind.update(re.sub(r"[^A-Za-z0-9]", "-", c) for c in cwds)
    return named, blind


NAME_BYTE = frozenset(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-")


def named_entries(blob, root):
    """Every name directly under `root` that NUL-separated argv/environ `blob` may be naming. An entry's name can hold
    any byte but / and NUL, so a mention runs from `root/` to the next / or NUL, and every prefix of it that ends
    before a byte no mktemp tail has (a space, a quote, `:`, a newline) is a name it may mean as well: `/tmp/my task/x`
    keeps both `my task` and `my`, and `/tmp/a:/tmp/b` keeps `a`. Each entry is read once more with \\ ' and " taken
    out, for a shell-quoted `/tmp/my\\ task` or `/tmp/'my task'`. Keeping one name too many costs a tick; one too few
    deletes a live session's files."""
    pre, out = root.encode() + b"/", set()
    for ent in blob.split(b"\0"):
        for e in {ent, ent.replace(b"\\", b"").replace(b"'", b"").replace(b'"', b"")}:
            i = e.find(pre)
            while i >= 0:
                s = i + len(pre)
                j = e.find(b"/", s)
                r = e[s:min(len(e) if j < 0 else j, s + 255)]   # 255: NAME_MAX
                out.update(r[:k] for k in range(1, len(r)) if r[k] not in NAME_BYTE)
                if r:
                    out.add(r)
                i = e.find(pre, s)
    return {os.fsdecode(n) for n in out}


def live(ps, root, sessions_dir):
    """What the processes `ps` keep alive under `root`: (held names — top entries and claude-<uid>/<slug>/<sid> —,
    session ids named, blind cwd slugs, live lander pids, bound_sockets())."""
    held = set()
    for _, argv, env, paths in ps:
        for h in paths:
            if h.startswith(root + "/"):
                parts = h[len(root) + 1:].split("/")
                held.add(parts[0])
                held.add("/".join(parts[:3]))
        # a live process that names an entry (a session's `--add-dir /tmp/x`, TMPDIR=…) keeps it, held open or not
        held.update(named_entries(argv + b"\0" + env, root))
    named, blind = live_sessions(ps, sessions_dir)
    landers = {pid for pid, argv, _, _ in ps if any(LANDER_WORD.search(a) for a in argv.split(b"\0")[:3])}
    return held, named, blind, landers, bound_sockets(ps)


def plan(root, uid, now, hours, ps, sessions_dir, any_name=True):
    """[(path, family, newest mtime)] under `root` that every rule in the docstring lets go. Reads, never writes."""
    cutoff, kept_cutoff = now - hours * 3600, now - KEPT_HOURS * 3600
    sess_cutoff = min(cutoff, now - SESSION_HOURS * 3600)
    stale_cutoff = min(cutoff, now - STALE_HOURS * 3600)
    held, named, blind, live_landers, bound = live(ps, root, sessions_dir)

    def ours(p):
        try:
            st = os.lstat(p)
        except OSError:
            return False
        return st.st_uid == uid and not os.path.islink(p)

    out = []
    for name in sorted(_ls(root)):
        p = f"{root}/{name}"
        if NEVER.fullmatch(name) or not ours(p):
            continue
        if name == f"claude-{uid}" and os.path.isdir(p):   # every live session holds this dir; judged per session
            for slug in sorted(_ls(p)):
                sp = f"{p}/{slug}"
                if not ours(sp) or not os.path.isdir(sp) or slug in blind:
                    continue
                for sid in sorted(_ls(sp)):
                    q = f"{sp}/{sid}"
                    rel = f"{name}/{slug}/{sid}"
                    if (SESSION.fullmatch(sid) and sid not in named and rel not in held and ours(q)
                            and os.path.isdir(q) and not has_socket(q, bound)):
                        t = newest(q)
                        if t < sess_cutoff:
                            out.append((q, SESS_FAM, t))
            continue
        # A bound socket inside is a live server's door whatever the name says: its fd reads socket:[inode] in
        # /proc, so `held` never sees it, and its mtime stops when the server goes quiet. Every family, before any
        # match is taken (the 922 review: a listening /tmp/.com.google.Chrome.* once went on its name alone).
        # A fifo a process has open is in `held`; a dead server's socket file or an unopened fifo keeps nothing.
        if name in held or has_socket(p, bound):
            continue
        m = LAND_RUN.fullmatch(name)
        if m:
            if int(m.group(1)) in live_landers or not os.path.isdir(p):
                continue
            t = newest(p)
            if t < (kept_cutoff if os.path.exists(f"{p}/{KEPT}") else cutoff):
                out.append((p, LAND_FAM, t))
            continue
        fam = family(name)
        if fam:
            t = newest(p)
            if t < cutoff:
                out.append((p, fam, t))
        elif any_name and not name.startswith("."):   # a dot name is a lock or a door (.X0-lock, .X11-unix)
            t = newest(p)
            if t < stale_cutoff:
                out.append((p, STALE_FAM, t))
    return out


def still_dead(root, p, fam, t, state):
    """The plan's verdict on `p`, taken again right before its remove: nothing in `state` (live()) keeps it, and its
    newest mtime is still `t`."""
    held, named, blind, landers, _ = state
    rel = p[len(root) + 1:]
    parts = rel.split("/")
    if fam == SESS_FAM:   # every live session holds claude-<uid> itself, so the session dir is what counts
        if rel in held or parts[2] in named or parts[1] in blind:
            return False
    elif parts[0] in held:
        return False
    if fam == LAND_FAM and int(LAND_RUN.fullmatch(parts[0]).group(1)) in landers:
        return False
    return newest(p) == t


def remove(p):
    if os.path.isdir(p) and not os.path.islink(p):
        shutil.rmtree(p, ignore_errors=True)
    else:
        try:
            os.unlink(p)
        except OSError:
            pass
    return not os.path.lexists(p)


def mb(n):
    return f"{n / 1e6:.1f} MB"


def run(root, apply_, hours, now=None, uid=None, out=sys.stdout, sessions=None, any_name=None):
    root = os.path.realpath(root)   # the kernel names held paths canonically
    any_name = root in stale_roots() if any_name is None else any_name
    uid = os.getuid() if uid is None else uid
    now = time.time() if now is None else now
    sessions = os.path.expanduser("~/.claude/sessions") if sessions is None else sessions
    seen = pids()   # read before the processes, so one started during the read counts as new below
    ps, taken = procs(os.getuid()), time.monotonic()
    todo = plan(root, uid, now, hours, ps, sessions, any_name)
    state = None
    fams, total, gone = {}, 0, 0
    for p, fam, t in todo:
        n = size(p)
        if apply_:
            now_pids = pids()
            if time.monotonic() - taken > RECHECK_S:
                ps, seen, taken, state = procs(os.getuid()), now_pids, time.monotonic(), None
            elif now_pids - seen:   # a process gone stays in `ps`: it can only keep more, never less
                ps, seen, state = ps + procs(os.getuid(), now_pids - seen), seen | now_pids, None
            state = state or live(ps, root, sessions)
            if not still_dead(root, p, fam, t, state):
                print(f"cc-tmp-reap: left {p}: in use or written to since it was judged", file=out)
                continue
            if not remove(p):
                print(f"cc-tmp-reap: could not remove {p}", file=out)
                continue
            gone += 1
        else:
            print(f"would remove {mb(n):>10}  {p}", file=out)
        c = fams.setdefault(fam, [0, 0])
        c[0] += 1
        c[1] += n
        total += n
    for fam, (c, n) in sorted(fams.items(), key=lambda x: -x[1][1]):
        print(f"  {fam}: {c}, {mb(n)}", file=out)
    verb = "removed" if apply_ else "would remove"
    stale = f", {max(hours, STALE_HOURS):g} h for a name no family has" if any_name else ", named families only"
    print(f"cc-tmp-reap: {verb} {sum(c for c, _ in fams.values())} entries, {mb(total)} "
          f"(older than {hours:g} h{stale}; no process holding or naming them) in {root}", file=out)
    return todo


# ── selfcheck ───────────────────────────────────────────────────────────────────────────────────────────────
SCRATCH = os.path.expanduser("~/.cc/tmp")   # the box's scratch on disk: config/environment.d/cc-tmp.conf


def roots():
    """The temp roots to reap, each once by its real path, leaving out one that does not exist."""
    return [r for r in dict.fromkeys(os.path.realpath(p) for p in ("/tmp", SCRATCH, tempfile.gettempdir()))
            if os.path.isdir(r)]


def stale_roots():
    """The roots where a name no family has may go after STALE_HOURS: /tmp and the scratch on disk, never TMPDIR's."""
    return {os.path.realpath("/tmp"), os.path.realpath(SCRATCH)}


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-tmp-reap.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-tmp-reap.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    apply_, hours = False, HOURS
    it = iter(argv)
    for a in it:
        if a == "--apply":
            apply_ = True
        elif a == "--hours":
            try:
                hours = float(next(it))
            except (StopIteration, ValueError):
                print("cc-tmp-reap: --hours takes a number", file=sys.stderr)
                return 2
            if hours < 1:
                print("cc-tmp-reap: --hours below 1 would take what a running gate uses", file=sys.stderr)
                return 2
        else:
            print(__doc__, file=sys.stderr)
            return 2
    for r in roots():
        run(r, apply_, hours)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
