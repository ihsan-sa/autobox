#!/usr/bin/python3 -IS
# cc-egress — a worker's only way off the box: an allow-list HTTPS proxy on a unix socket, run by the user, no root.
#   cc-egress serve --socket <path> [--allow <list>] [--log <file>] [--parent <pid>]
#       HOST SIDE. Listens on <path> (mode 600; the path appears only once it listens) for HTTP CONNECT and opens the tunnel only to a host on <list>, else
#       answers 403 and logs one line "refused <host>:<port> <why>" to <file> (stderr when none; past 1 MiB the file
#       moves to <file>.1, so a worker hammering refused hosts cannot fill the disk). --parent: exit with
#       that process (PR_SET_PDEATHSIG), and refuse to start once it is gone — cc-sandbox passes its own pid and then
#       execs bwrap in it, so the proxy lives exactly as long as the sandbox does.
#   cc-egress inside --socket <path> [--port <n>] -- <command...>
#       IN THE SANDBOX, which has no network of its own (bwrap --unshare-net: loopback only). Forks a forwarder from
#       127.0.0.1:<n> (default 3128; 0 takes a free port) to <path>, waits until it listens, sets HTTPS_PROXY/HTTP_PROXY/ALL_PROXY (both
#       cases) to it and NO_PROXY to loopback, and execs <command>. The forwarder decides nothing: killing it or
#       talking to <path> directly reaches the same host-side list.
#   cc-egress selfcheck     a scratch proxy and a local upstream: each kept and each refused case, driven
# THE LIST: comma- or space-separated. `host` is that name on port 443; `.suffix` is every name under it, not the
# bare suffix (so `.example.com` does not admit `evilexample.com`); `host:port` or `.suffix:port` names another port;
# `*` is every name and every global IP literal on every port, which is what a planning seat reaches.
# An IP literal is refused unless the list names that literal (or has `*` and the literal is global), and a NAME that
# resolves to a loopback, private, link-local or otherwise non-global address is refused whatever the list says, and
# so is any address on the host's own interfaces or on-link with them, the rest of the home's IPv6 prefix (a /48
# around each own global address), the home's own public IPv4 (asked of an echo service at start and every few
# minutes, and every answer kept box-wide in ~/.cc/state/egress-public-v4), and any IPv6 form carrying an IPv4
# address — no listed name reaches the host's own services or the LAN. With no --allow, DEFAULT below: `*`, because
# a worker holds no login and the owner's rule (2026-10-20) is a seat's access with a net, not a wall; the host's own services stay
# walled, since nothing undoes a worker driving them. A narrower list is `cc-config set CC_EGRESS_ALLOW "<list>"`
# (cc-sandbox reads it and passes it here), e.g. the old default: the model APIs, GitHub, npm and PyPI.
# ONLY CONNECT: a plain-HTTP request (`GET http://…`) is refused. What CONNECT opens is a TCP tunnel to the named
# host and port, and nothing more: the proxy does not check that TLS runs inside it, so it restricts the DESTINATION,
# not the protocol (a client may speak clear text to an allowed host:port). Nor does it inspect what goes through an
# allowed tunnel. A worker can still post to anything an allowed host accepts (a gist on github.com, say); the list
# bounds WHERE, not WHAT. DNS is resolved here, on the host, so the sandbox needs no resolver and gets none.
import ctypes
import ipaddress
import os
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request

DEFAULT = "*"
USAGE = ("usage: cc-egress serve --socket <path> [--allow <list>] [--log <file>] [--parent <pid>]"
         " | inside --socket <path> [--port <n>] -- <command...> | selfcheck")
HEAD_MAX = 8192


def parse_list(text):
    """→ list of (name, is_suffix, port)."""
    rules = []
    for item in text.replace(",", " ").split():
        item = item.strip().lower()
        if item == "*":
            rules.append(("*", False, None))
            continue
        host, port = item, 443
        if item.startswith("[") or item.count(":") > 1:           # an IPv6 literal, [addr]:port or bare
            if item.startswith("[") and "]:" in item:
                host, port = item[1:item.index("]")], int(item.rsplit(":", 1)[1])
            else:
                host = item.strip("[]")
        elif ":" in item:
            host, p = item.rsplit(":", 1)
            port = int(p)
        rules.append((host.lstrip("."), host.startswith("."), port))
    return rules


def is_ip(host):
    try:
        ipaddress.ip_address(host)
        return True
    except ValueError:
        return False


def allowed(rules, host, port):
    """→ None when the list admits host:port, else the reason."""
    host = host.lower().rstrip(".")
    for name, suffix, p in rules:
        if name == "*":
            return None
        if p != port:
            continue
        if (suffix and host.endswith("." + name)) or (not suffix and host == name):
            return None
    return "not on the list"


# Where the host's own interfaces are, read fresh per connection so a new or rotated address counts at once. A global
# address of the tower (its IPv6 above all) is still the tower: sshd and anything bound to [::] or published by Docker
# answer on it, and its neighbours in the same prefix are the LAN. The selfcheck points these at fake tables.
IF_INET6, FIB_TRIE, ROUTE = "/proc/net/if_inet6", "/proc/net/fib_trie", "/proc/net/route"
# The router's WAN IPv6 is on no interface here and no echo service can name it (IPv6 has no NAT, so they answer with
# the tower's own). A router numbers it from the prefix the ISP delegated to the home, /48 at the widest, so the /48
# around each own global address is walled: the router, the home's other subnets and nothing a worker needs. A router
# numbered from a separate ISP link prefix is out of reach of this.
HOME_V6 = 48
# IPv6 forms that carry an IPv4 address (v4-compatible, v4-mapped, NAT64): refused whole, so none reaches a walled one.
EMBEDS_V4 = [ipaddress.ip_network(n) for n in ("::/96", "::ffff:0:0/96", "64:ff9b::/96")]
# The home's own public IPv4 is on no interface (the router holds it), yet the router may hairpin a connection to it back
# onto the LAN, so it is walled too. Only an outside service can say what it is, so it is asked at start and every
# PUBLIC_EVERY seconds after (IPv4-only endpoints, so the answer is never the IPv6 one), and a new lease is walled
# within that. Every address seen stays walled: a past home address is nobody's server a worker needs. Each answer is
# kept in PUBLIC_FILE, shared by every worker's proxy and read at each lookup, so a proxy whose echo services all fail
# still walls every address any proxy has seen.
PUBLIC_V4 = ("https://api.ipify.org", "https://ipv4.icanhazip.com")
PUBLIC_FILE = os.path.expanduser("~/.cc/state/egress-public-v4")
PUBLIC_EVERY = 300
public = frozenset()     # replaced whole, never changed in place, so a connection's thread never sees it half-built


def lookup_public():
    """→ the public IPv4 address the first echo service that answers sees this host come from, else None."""
    for url in PUBLIC_V4:
        try:
            with urllib.request.urlopen(url, timeout=3) as r:
                return ipaddress.IPv4Address(r.read(64).decode().strip())
        except (OSError, ValueError):
            continue
    return None


def refresh_public(log):
    global public
    kept = set()
    try:
        with open(PUBLIC_FILE) as fh:
            lines = [ln.strip() for ln in fh if ln.strip()]
    except OSError:
        lines = []
    for ln in lines:     # a bad line is skipped, not the whole kept set
        try:
            kept.add(ipaddress.IPv4Address(ln))
        except ValueError:
            log(f"skipping a line of {PUBLIC_FILE} that is no IPv4 address: {ln!r}")
    a = lookup_public()
    if a is not None and a not in kept:
        os.makedirs(os.path.dirname(PUBLIC_FILE), exist_ok=True)
        with open(PUBLIC_FILE, "a") as fh:
            fh.write(f"{a}\n")
    public = public | kept | ({a} if a else set())
    if a is None:
        log("public IPv4 lookup failed: no echo service answered; walling the kept "
            + " ".join(map(str, sorted(public))) if public else "public IPv4 unknown: no echo service answered and none is kept")


def watch_public(log):
    while True:
        time.sleep(PUBLIC_EVERY)
        refresh_public(log)


def host_nets():
    """→ the networks the host sits on: each own address with its prefix, and each on-link IPv4 route."""
    nets = []
    try:
        with open(IF_INET6) as fh:
            for ln in fh:
                f = ln.split()
                if len(f) >= 3 and int(f[2], 16):
                    own = ipaddress.IPv6Address(int(f[0], 16))
                    nets.append(ipaddress.ip_network((own, int(f[2], 16)), strict=False))
                    if own.is_global:
                        nets.append(ipaddress.ip_network((own, HOME_V6), strict=False))
    except (OSError, ValueError):
        pass
    try:
        with open(FIB_TRIE) as fh:      # an own IPv4 address is a "|-- <addr>" line followed by "/32 host LOCAL"
            last = None
            for ln in fh:
                ln = ln.strip()
                if ln.startswith("|-- "):
                    last = ln[4:]
                elif ln == "/32 host LOCAL" and last:
                    nets.append(ipaddress.ip_network(last))
    except (OSError, ValueError):
        pass
    try:
        with open(ROUTE) as fh:         # a route with no gateway is on-link; the table is hex, little-endian
            for ln in list(fh)[1:]:
                f = ln.split()
                if len(f) >= 8 and int(f[2], 16) == 0 and int(f[7], 16):
                    dst, mask = (socket.inet_ntoa(bytes.fromhex(x)[::-1]) for x in (f[1], f[7]))
                    nets.append(ipaddress.ip_network(f"{dst}/{mask}", strict=False))
    except (OSError, ValueError):
        pass
    return nets


def walled(addr, nets):
    """→ why no list but a verbatim literal may reach addr, else None."""
    a = ipaddress.ip_address(addr)
    if not a.is_global:
        return "is not a global address"
    if a.version == 6 and any(a in n for n in EMBEDS_V4):
        return "carries an IPv4 address inside it"
    if any(a in n for n in nets):
        return "is on the host's own interfaces or on-link with them"
    if a in public:
        return "is the home's own public address, which the router may turn back onto the LAN"
    return None


def resolve(host, port, rules):
    """→ (address list, None) or (None, reason). A literal listed verbatim passes; no other address may be walled."""
    if is_ip(host):
        why = None if any(name == host for name, _, _ in rules) else walled(host, host_nets())
        return (None, f"{host} {why}") if why else ([(host, port)], None)
    try:
        infos = socket.getaddrinfo(host, port, type=socket.SOCK_STREAM)
    except OSError as exc:
        return None, f"does not resolve ({exc.strerror or exc})"
    out, nets = [], host_nets()
    for fam, _, _, _, sa in infos:
        why = walled(sa[0], nets)
        if why:
            return None, f"resolves to {sa[0]}, which {why}"
        out.append(sa[:2])
    return out, None


def pump(a, b):
    try:
        while True:
            data = a.recv(65536)
            if not data:
                break
            b.sendall(data)
    except OSError:
        pass
    for s, how in ((b, socket.SHUT_WR), (a, socket.SHUT_RD)):
        try:
            s.shutdown(how)
        except OSError:
            pass


def splice(a, b):
    t = threading.Thread(target=pump, args=(b, a), daemon=True)
    t.start()
    pump(a, b)
    t.join()
    a.close()
    b.close()


def read_head(conn):
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = conn.recv(1024)
        if not chunk:
            return None, b""
        buf += chunk
        if len(buf) > HEAD_MAX:
            return None, b""
    head, rest = buf.split(b"\r\n\r\n", 1)
    return head.decode("latin-1"), rest


def handle(conn, rules, log):
    conn.settimeout(15)
    target = "?"
    try:
        head, rest = read_head(conn)
        if head is None:
            return
        parts = head.split("\r\n", 1)[0].split()
        if len(parts) != 3 or parts[0] != "CONNECT":
            target = parts[1] if len(parts) > 1 else "?"
            why = "only CONNECT (TLS) is proxied"
        else:
            target = parts[1]
            host, _, p = target.rpartition(":")
            host = host.strip("[]")
            try:
                port = int(p)
            except ValueError:
                port, host = -1, target
            why = allowed(rules, host, port) if port > 0 else "no port"
            addrs = None
            if why is None:
                addrs, why = resolve(host, port, rules)
            if why is None:
                up, err = None, None
                for sa in addrs:
                    try:
                        up = socket.create_connection(sa, timeout=15)
                        break
                    except OSError as exc:
                        err = exc
                if up is None:
                    conn.sendall(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
                    log(f"failed {target} {err}")
                    return
                conn.settimeout(None)
                up.settimeout(None)
                conn.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
                if rest:
                    up.sendall(rest)
                splice(conn, up)
                return
        log(f"refused {target} {why}")
        conn.sendall(f"HTTP/1.1 403 Forbidden\r\ncontent-type: text/plain\r\nconnection: close\r\n\r\n"
                     f"cc-egress: {target} refused: {why}\n".encode())
    except OSError:
        pass
    finally:
        try:
            conn.close()
        except OSError:
            pass


def die_with(pid):
    libc = ctypes.CDLL(None, use_errno=True)
    libc.prctl(1, signal.SIGTERM, 0, 0, 0)     # PR_SET_PDEATHSIG
    if os.getppid() != pid:                    # the parent went before the signal was armed
        sys.exit(0)


LOG_CAP = 1 << 20   # a worker hammering unlisted hosts fills this, not the disk: past it the log moves to <file>.1


def append_capped(path, line, cap=LOG_CAP):
    """Append one line; a file already at `cap` bytes is first moved to <path>.1 (the one before it is dropped)."""
    try:
        if os.path.getsize(path) >= cap:
            os.replace(path, path + ".1")
    except OSError:
        pass
    with open(path, "a") as fh:
        fh.write(line + "\n")


def serve(sock, allow_text, logfile, parent):
    if parent:
        die_with(parent)
    rules = parse_list(allow_text if allow_text is not None else DEFAULT)
    lock = threading.Lock()

    def log(line):
        with lock:
            if logfile:
                append_capped(logfile, line)
            else:
                print("cc-egress: " + line, file=sys.stderr, flush=True)
    # Before the socket appears, so no worker connects while the home's address is still unknown (when a service answers).
    refresh_public(log)
    threading.Thread(target=watch_public, args=(log,), daemon=True).start()
    # Bound on a side path and renamed onto <sock> once it listens, so a waiter that sees <sock> (the selfcheck,
    # cc-sandbox's [ -S ]) can connect: bound but not yet listening, a connect is refused.
    side = sock + ".new"
    try:
        os.unlink(side)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old = os.umask(0o177)
    srv.bind(side)
    os.umask(old)
    srv.listen(64)
    os.replace(side, sock)
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle, args=(conn, rules, log), daemon=True).start()


def forward(sock, port, ready_fd):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", port))
    srv.listen(64)
    os.write(ready_fd, b"%d\n" % srv.getsockname()[1])   # the port it got: --port 0 asks the kernel for a free one
    os.close(ready_fd)

    def one(c):
        u = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            u.connect(sock)
        except OSError:
            c.close()
            return
        splice(c, u)
    while True:
        c, _ = srv.accept()
        threading.Thread(target=one, args=(c,), daemon=True).start()


def inside(sock, port, cmd):
    r, w = os.pipe()
    pid = os.fork()
    if pid == 0:
        os.close(r)
        ctypes.CDLL(None).prctl(1, signal.SIGTERM, 0, 0, 0)
        try:
            forward(sock, port, w)
        finally:
            os._exit(1)
    os.close(w)
    got = b""
    while not got.endswith(b"\n"):
        chunk = os.read(r, 16)
        if not chunk:
            break
        got += chunk
    if not got.strip().isdigit():
        print(f"cc-egress: the forwarder to {sock} did not start — nothing was run", file=sys.stderr)
        sys.exit(2)
    os.close(r)
    port = int(got)
    url = f"http://127.0.0.1:{port}"
    for k in ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY"):
        os.environ[k] = os.environ[k.lower()] = url
    os.environ["NO_PROXY"] = os.environ["no_proxy"] = "localhost,127.0.0.1,::1"
    try:
        os.execvp(cmd[0], cmd)
    except OSError as exc:
        print(f"cc-egress: cannot run {cmd[0]}: {exc.strerror}", file=sys.stderr)
        sys.exit(127)


def selfcheck():
    n = bad = 0

    def t(name, got, want):
        nonlocal n, bad
        n += 1
        if got != want:
            bad += 1
            print(f"  FAIL {name}: got {got!r} want {want!r}")
        else:
            print(f"  ok   {name}")
    global PUBLIC_V4, PUBLIC_FILE, public
    PUBLIC_V4 = ()      # no echo service is asked from here; the public-address case below feeds answers in
    d = tempfile.mkdtemp(prefix="cc-egress.")
    PUBLIC_FILE = os.path.join(d, "state", "egress-public-v4")
    # A waiter polls for the path, then connects; a path that exists before listen() is a refused connect under load.
    early, seen = os.path.join(d, "early"), []

    class Watched(socket.socket):
        def listen(self, *a):
            seen.append(os.path.exists(early))
            return super().listen(*a)
    plain, socket.socket = socket.socket, Watched
    try:
        threading.Thread(target=serve, args=(early, "", os.path.join(d, "early.log"), 0), daemon=True).start()
        for _ in range(250):
            if os.path.exists(early):
                break
            threading.Event().wait(0.02)
    finally:
        socket.socket = plain
    c = socket.socket(socket.AF_UNIX)
    try:
        c.connect(early)
        seen.append("connected")
    except OSError as exc:
        seen.append(type(exc).__name__)
    c.close()
    t("serve: the socket path is absent at listen() and connectable once it appears", seen, [False, "connected"])
    up = socket.socket()
    up.bind(("127.0.0.1", 0))
    up.listen(8)
    uport = up.getsockname()[1]

    def echo():
        while True:
            c, _ = up.accept()
            c.sendall(b"upstream:" + c.recv(64))
            c.close()
    threading.Thread(target=echo, daemon=True).start()
    sock, logf = os.path.join(d, "s"), os.path.join(d, "log")
    lst = f"127.0.0.1:{uport} .example.com localhost:{uport}"
    threading.Thread(target=serve, args=(sock, lst, logf, 0), daemon=True).start()
    for _ in range(100):
        if os.path.exists(sock):
            break
        threading.Event().wait(0.02)

    def ask(line):
        c = socket.socket(socket.AF_UNIX)
        c.connect(sock)
        c.sendall(line.encode() + b"\r\n\r\n")
        first = c.recv(4096).split(b"\r\n", 1)[0].decode()
        body = b""
        if " 200 " in first + " ":
            c.sendall(b"ping")
            body = c.recv(64)
        c.close()
        return first.split(" ")[1] if " " in first else first, body
    t("a listed literal and port opens the tunnel", ask(f"CONNECT 127.0.0.1:{uport} HTTP/1.1"), ("200", b"upstream:ping"))
    t("the listed literal on another port is refused", ask("CONNECT 127.0.0.1:443 HTTP/1.1")[0], "403")
    t("an unlisted literal is refused", ask(f"CONNECT 127.0.0.2:{uport} HTTP/1.1")[0], "403")
    t("a listed NAME resolving to loopback is refused", ask(f"CONNECT localhost:{uport} HTTP/1.1")[0], "403")
    t("plain HTTP is refused", ask(f"GET http://127.0.0.1:{uport}/ HTTP/1.1")[0], "403")
    t("garbage is refused", ask("HELLO")[0], "403")
    r = parse_list(".example.com api.x.org:8443")
    t(".suffix admits a name under it", allowed(r, "a.example.com", 443), None)
    t(".suffix does not admit a name that merely ends in it", allowed(r, "evilexample.com", 443), "not on the list")
    t(".suffix does not admit the bare suffix", allowed(r, "example.com", 443), "not on the list")
    t("host:port admits that port", allowed(r, "api.x.org", 8443), None)
    t("host:port refuses 443", allowed(r, "api.x.org", 443), "not on the list")
    w = parse_list(DEFAULT)
    t("the default is a seat's reach: any name on any port", (allowed(w, "example.org", 443), allowed(w, "a.b.io", 8080)),
      (None, None))
    t("`*` admits a global literal", resolve("1.1.1.1", 443, w), ([("1.1.1.1", 443)], None))
    t("`*` does not reach the host or the LAN: loopback and private literals are refused",
      (resolve("127.0.0.1", 22, w)[1] is None, resolve("10.0.0.1", 443, w)[1] is None,
       resolve("::1", 443, w)[1] is None, resolve("localhost", 22, w)[1] is None), (False, False, False, False))
    with open(logf) as fh:
        t("every refusal is logged with its reason", sum(1 for ln in fh if ln.startswith("refused ")), 5)
    capf = os.path.join(d, "capped")
    for i in range(50):
        append_capped(capf, "refused x%02d:443 not on the list" % i, cap=200)
    t("the refusal log is capped: it and its one rotation stay near the cap, and the newest line is kept",
      (os.path.getsize(capf) < 240, os.path.getsize(capf + ".1") < 240, open(capf).read().splitlines()[-1].split()[1]),
      (True, True, "x49:443"))
    # inside: a real forwarder in front of the same socket, in a process of its own
    probe = ("import os,socket;u=os.environ['HTTPS_PROXY'];h,p=u[7:].split(':');c=socket.create_connection((h,int(p)));"
             f"c.sendall(b'CONNECT 127.0.0.1:{uport} HTTP/1.1\\r\\n\\r\\n');r=c.recv(64);c.sendall(b'x');"
             "print(r.split(b' ')[1].decode(), c.recv(64).decode(), os.environ['no_proxy'])")
    out = subprocess.run([sys.executable, "-IS", os.path.realpath(__file__), "inside", "--socket", sock, "--port", "0",
                          "--", sys.executable, "-IS", "-c", probe], capture_output=True, text=True, timeout=30)
    t("inside: the command ran behind the forwarder, through the proxy, with loopback exempt",
      out.stdout.strip(), "200 upstream:x localhost,127.0.0.1,::1")
    held = socket.socket()
    held.bind(("127.0.0.1", 0))
    held.listen(1)
    out = subprocess.run([sys.executable, "-IS", os.path.realpath(__file__), "inside", "--socket", sock, "--port",
                          str(held.getsockname()[1]), "--", "true"], capture_output=True, text=True, timeout=30)
    held.close()
    t("inside: a port already taken stops the launch, and nothing runs", (out.returncode, "did not start" in out.stderr), (2, True))
    # The tower's own global addresses: its real IPv6 when it has one, then fake tables so this runs with none.
    mine = [ipaddress.ip_address(n.network_address) for n in host_nets() if n.version == 6]
    mine = [str(m) for m in mine if m.is_global]
    star = os.path.join(d, "star")
    threading.Thread(target=serve, args=(star, "*", logf, 0), daemon=True).start()
    for _ in range(100):
        if os.path.exists(star):
            break
        threading.Event().wait(0.02)
    sock = star                     # ask() dials whatever `sock` names
    # The home's public IPv4, as an echo service answers it, then the same after the lease changes.
    answers, look = ["5.5.5.5", "5.5.5.6"], lookup_public
    globals()["lookup_public"] = lambda: ipaddress.IPv4Address(answers.pop(0))
    gai = socket.getaddrinfo
    socket.getaddrinfo = lambda h, *a, **kw: gai("5.5.5.5" if h == "home.example" else h, *a, **kw)
    try:
        before = resolve("5.5.5.5", 443, w)[1] is None
        refresh_public(print)
        first = [ask(f"CONNECT {h} HTTP/1.1")[0] for h in ("5.5.5.5:22", "home.example:443")]
        refresh_public(print)
        t("`*` refuses the home's public IPv4 by literal and by name, and its new one after it changes",
          (before, first, resolve("5.5.5.6", 443, w)[1] is None, resolve("5.5.5.5", 443, w)[1] is None,
           resolve("1.1.1.1", 443, w)[1]), (True, ["403", "403"], False, False, None))
        with open(PUBLIC_FILE) as fh:
            t("each address an echo service answers is kept box-wide", fh.read(), "5.5.5.5\n5.5.5.6\n")
        # A new proxy whose echo services all fail: what earlier proxies kept is still walled, and it says so.
        with open(PUBLIC_FILE, "w") as fh:
            fh.write("5.5.5.7\n")
        public, said = frozenset(), []
        globals()["lookup_public"] = lambda: None
        refresh_public(said.append)
        t("both echo services failing: a new proxy walls the address kept box-wide, and logs no 'unknown'",
          (ask("CONNECT 5.5.5.7:443 HTTP/1.1")[0], said),
          ("403", ["public IPv4 lookup failed: no echo service answered; walling the kept 5.5.5.7"]))
        # One bad line among good ones: it is skipped and logged, and the good addresses are still walled.
        with open(PUBLIC_FILE, "w") as fh:
            fh.write("5.5.5.8\nnot-an-ip\n5.5.5.9\n")
        public, said = frozenset(), []
        refresh_public(said.append)
        t("a bad line in the kept file is skipped and logged; the good addresses on either side are still walled",
          ([ask(f"CONNECT {h}:443 HTTP/1.1")[0] for h in ("5.5.5.8", "5.5.5.9")], said),
          (["403", "403"], [f"skipping a line of {PUBLIC_FILE} that is no IPv4 address: 'not-an-ip'",
                            "public IPv4 lookup failed: no echo service answered; walling the kept 5.5.5.8 5.5.5.9"]))
        os.remove(PUBLIC_FILE)
        public, said = frozenset(), []
        refresh_public(said.append)
        t("both echo services failing and nothing kept: it logs the address unknown",
          said, ["public IPv4 unknown: no echo service answered and none is kept"])
    finally:
        socket.getaddrinfo = gai
        globals()["lookup_public"], public = look, frozenset()
    if mine:
        t("`*`: this host's own global IPv6 prefix is refused", ask(f"CONNECT [{mine[0]}]:22 HTTP/1.1")[0], "403")
    tables = {"IF_INET6": "26064700abcd00000000000000000005 02 40 00 80 eth0\n"
                          "fe800000000000000000000000000005 02 40 20 80 eth0\n",
              "FIB_TRIE": "Local:\n  +-- 0.0.0.0/0 3 0 5\n     |-- 8.8.4.4\n        /32 host LOCAL\n",
              "ROUTE": "Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\n"
                       "eth0\t00000000\t01090909\t0003\t0\t0\t0\t00000000\n"
                       "eth0\t00090909\t00000000\t0001\t0\t0\t0\t00FFFFFF\n"}
    real = {k: globals()[k] for k in tables}
    for k, text in tables.items():
        globals()[k] = os.path.join(d, k)
        with open(globals()[k], "w") as fh:
            fh.write(text)
    gai = socket.getaddrinfo
    socket.getaddrinfo = lambda h, *a, **kw: gai("2606:4700:abcd::5" if h == "tower.example" else h, *a, **kw)
    try:
        t("`*` refuses the host's own global addresses and their prefixes, by literal and by name",
          [ask(f"CONNECT {h} HTTP/1.1")[0] for h in ("[2606:4700:abcd::5]:22", "[2606:4700:abcd::77]:443",
                                                     "tower.example:22", "8.8.4.4:22", "9.9.9.9:443")],
          ["403"] * 5)
        t("`*` refuses the router's WAN IPv6 in the home's /48, outside the tower's own /64",
          ask("CONNECT [2606:4700:abcd:ff00::1]:443 HTTP/1.1")[0], "403")
        t("`*` refuses IPv4 inside IPv6 (v4-compatible, v4-mapped, NAT64)",
          [resolve(h, 443, w)[1] is None for h in ("::a00:1", "::ffff:10.0.0.1", "64:ff9b::808:404", "64:ff9b::101:101")],
          [False] * 4)
        t("`*` still admits a global address off the host's prefixes",
          (resolve("2606:4700:abce::5", 443, w), resolve("1.1.1.1", 443, w)[1]), (([("2606:4700:abce::5", 443)], None), None))
    finally:
        socket.getaddrinfo = gai
        globals().update(real)
    print(f"cc-egress selfcheck: {n - bad} passed, {bad} failed")
    return 1 if bad else 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        with open(os.path.realpath(__file__)) as fh:
            for line in fh.readlines()[1:]:
                if not line.startswith("#"):
                    break
                print(line[2:].rstrip())
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "selfcheck":
        return selfcheck()
    opts, tail = {}, []
    while rest:
        a = rest.pop(0)
        if a == "--":
            tail = rest
            break
        if a in ("--socket", "--allow", "--log", "--parent", "--port") and rest:
            opts[a] = rest.pop(0)
        else:
            print(USAGE, file=sys.stderr)
            return 2
    if "--socket" not in opts:
        print(USAGE, file=sys.stderr)
        return 2
    if cmd == "serve" and not tail:
        serve(opts["--socket"], opts.get("--allow"), opts.get("--log"), int(opts.get("--parent", 0)))
    elif cmd == "inside" and tail:
        inside(opts["--socket"], int(opts.get("--port", 3128)), tail)
    else:
        print(USAGE, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
