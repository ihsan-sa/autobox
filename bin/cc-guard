    [ "$s1$se" = "00" ] || { r=1; echo "      the seat's own write to its own state was refused: $s1 $se"; }
  else r=1; echo "      no detached fixture claude to test the seat's own write against"; fi
  # …AND THE FENCE IS ALL THE UNGATED TIER MEETS (pfonly): it passed the rest of this file untouched before the fence,
