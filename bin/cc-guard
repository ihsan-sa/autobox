  # …a glob past deglob's cap, from a session with no role, is still a read: the universal gates read the floor's names
  : > "$GERR"; got=$(g Bash "{\"command\":\"ls /usr/bin/[a-z]*\"}" "$T")
  [ "$got" = 0 ] || { r=1; echo "      a wide glob from a session with no role: rc $got, refused for: $(head -c 60 "$GERR")"; }
  : > "$GERR"; got=$(g Bash "{\"command\":\"echo a\${x}b\${x}c\${x}d\${x}e\${x}f\${x}g\${x}h\"}" "$T")
  [ "$got" = 0 ] || { r=1; echo "      a word of many split points from a session with no role: rc $got, refused for: $(head -c 60 "$GERR")"; }
  # …and the same option behind a pipe, which the table above cannot carry: `|` is its field separator.
  : > "$GERR"; got=$(g Bash "{\"command\":\"echo x | split --filter='tmux kill-server' -\"}" "$T")
  { [ "$got" = 2 ] && grep -qF 'shared tmux server' "$GERR"; } \
    || { r=1; echo "      an --opt=VALUE after a pipe: rc $got, refused for: $(head -c 60 "$GERR")"; }
  # …AND THE OTHER HALF, which is what the walk costs: it stops at a head that cannot run a later token, so a
  # command that merely NAMES one of the words above is still allowed. `echo` and `grep` are the two that
  # matter — quoting a forbidden command is how a brief, a board note and this file's own cases get written.
  # NOT here, though it was: a regex alternation naming two gated commands (`grep -E 'cc-land|gh pr merge' …`)
  # is REFUSED, escaped or quoted, because the as-typed line still carries a raw `|` for $AT to anchor on.
  # That is true on main as well — measured both ways — so it is not this change's to assert either way.
  while IFS='|' read -r fam tier what; do
    [ -n "$fam" ] || continue
    got=$(g Bash "{\"command\":\"$what\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
    [ "$got" = 0 ] || { r=1; echo "      refused but should not be ($fam): $what"; }
  done <<W11B
