            "python3 -c \"open('$H6/.cc/state/hs/other/n.txt','w')\""
            "python3 tool.py $H6/.claude/projects/-p/s.jsonl" "awk '{print}' ~/.profile" "source ~/.bashrc && python3 tool.py"
            "awk '\$1>3' $H6/.claude/projects/-p/s.jsonl" "cat $H6/.cc/state//hs/launch/run.sh" "echo x > $H6/.cc/state/hs/x/../other/n.txt")
      # the over-blocks are the ungated tier's: a worker meets the relative-path and outside-its-tree rules for its own reasons
      [ "$tier" = worker ] || kept+=("cd \"\$(git rev-parse --show-toplevel)\" && echo x > tests/fixtures/.profile")   # `cp CLAUDE.md ~/.claude/` is #940's (pboot) to refuse
      for x in "${kept[@]}"; do
        : > "$GERR"; got=$(GH=$H6 g Bash "$(J "$x")" "$c" "${e[@]}"); [ "$got" = 0 ] || { r=1; echo "      $tier: refused what is kept (rc $got): $x — $(head -c 80 "$GERR")"; }
      done
    done
    # …and the seat writes its own memory from a SUBDIR of its dir: the memory is keyed on the seat process's cwd
    (cd "$SD6" && setsid -f "$T/claude" --dangerously-skip-permissions >/dev/null 2>&1 </dev/null & disown)
    sleep 0.3; seat68f=""
    for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
      [ "$(readlink "/proc/$cand/cwd")" = "$SD6" ] && { seat68f=$cand; break; }
    done
    if [ -n "$seat68f" ]; then
      got=$(GH=$H6 g Write "$(jq -n --arg f "$PM6/MEMORY.md" '{file_path:$f,content:"x"}')" "$SD6/sub" CC_GUARD_ROOT_PID=$seat68f)
      [ "$got" = 0 ] || { r=1; echo "      the seat's Write into its own memory from a subdir was refused: rc $got"; }
      got=$(GH=$H6 g Bash "$(J "setsid -f claude")" "$SD6" CC_GUARD_ROOT_PID=$seat68f)   # the seat itself may start one
      [ "$got" = 0 ] || { r=1; echo "      the seat's own claude launch was refused: rc $got"; }
      kill "$seat68f" 2>/dev/null
    else r=1; echo "      no detached fixture claude to test the seat's own write against"; fi
    [ "$(cat "$H6/.bashrc")" = "#" ] || { r=1; echo "      the fixture's .bashrc changed — a refusal above did not actually hold"; }
  fi
  unset GERR
  ok "the perms handback's holes are closed at every tier — a brace over startup files, a literal launch-input path in a python, perl or node one-liner, truncate and rm of one, and a claude started in the seat's dir — while its over-blocks pass, the rest of ~/.cc/state/hs is writable, and the seat writes its memory from a subdir" $r

  # 68g. A | OR ; INSIDE QUOTES IS NOT A SECOND STATEMENT (row raised-guard-refuses-a-plain-read-of-perms-journal).
  #      A grep of the seat's journal for 'release|tunnel' was refused as a write, and so was a journal append with an
  #      unquoted <<EOF that only named the path. Both pass; a real pipe, ; or && after the quotes, a quote the shell
  #      ends elsewhere (\', \" , $'…', an open one) and an unquoted heredoc that expands anything stay refused. A
  #      quote inside a # comment opens nothing: the statement on the line after it is judged (handback on #1456), and a
  #      # after a carriage return is inside the word, so the quote after it opens a span the shell really reads.
  r=0; P68=$H/.cc/state/demo68g/perms; S68=$H/.cc/state/demo68g/trk; mkdir -p "$P68" "$S68" "$H/plain68g"; printf 'b' > "$P68/brief.md"
  for x in "grep -n -E 'release|tunnel' $P68/progress.md" "grep -n 'release\|tunnel' $P68/progress.md | tail -20" \
           "grep -c \"a;b\" $P68/progress.md" "grep -n 'a&&b' $P68/progress.md; date -u" "grep 'a>b' $P68/progress.md" \
           "grep \"a\\\" | touch $P68/made \\\"\" $P68/progress.md" "grep -c x#y $P68/progress.md # it's | a note" \
           "cat >> $S68/progress.md <<EOF
- perms' journal $P68/progress.md has no line on the tunnel
EOF"; do
    [ "$(g Bash "$(J "$x")" "$H/plain68g" CC_ROLE=worker)" = 0 ] || { r=1; echo "      a read or a journal line was refused: $x"; }
  done
  for x in "grep 'a|b' $P68/progress.md | tee $P68/brief.md" "grep \"a|b\" $P68/progress.md; touch $P68/made" \
           "grep 'a;b' $P68/progress.md && rm $P68/brief.md" "grep \\' $P68/progress.md | tee $P68/brief.md \\'" \
           "grep \"a\\\\\" | touch $P68/made ; echo \"\" $P68/progress.md" "grep \$'a\\'' | rm $P68/brief.md ; echo ''" \
           "grep 'open $P68/progress.md" "grep x $P68/progress.md # '
python3 -c \"open('$P68/brief.md','w').write('x')\"
# '" "grep x $P68/progress.md #\"
touch $P68/made #\"" "grep x $P68/progress.md;# '
rm $P68/brief.md" "grep x $P68/progress.md"$'\r'"# '
echo ' ; python3 -c \"open(\\\"$P68/brief.md\\\",\\\"w\\\").write(\\\"x\\\")\" # '" "cat >> $S68/n <<EOF
\$HOME $P68/brief.md
EOF" "cat >> $S68/n <<EOF
\\\`touch $P68/made\\\`
EOF" "cat >> $S68/n <<'EOF
$P68/brief.md
EOF" "cat >> $P68/brief.md <<EOF
x
EOF"; do
    [ "$(g Bash "$(J "$x")" "$H/plain68g" CC_ROLE=worker)" = 2 ] || { r=1; echo "      a write into the seat's state was let through: $x"; }
  done
  [ "$(cat "$P68/brief.md")" = b ] && [ ! -e "$P68/made" ] || { r=1; echo "      the fixture's seat dir changed — a refusal above did not hold"; }
  ok "a | ; && or > inside quotes is one word, so a grep of the seat's journal for 'release|tunnel' and an unquoted <<EOF journal line naming it pass, while a real pipe or second statement after the quotes, an escaped or ANSI-C quote, an open one, a statement after a # comment holding a quote or hidden by a quote after a \\r#, and an unquoted heredoc that expands \$ or a backtick are refused" $r

  # 69. A BUILDER THE NON-LIVE SEAT STARTED BEFORE THE CUTOVER STILL PUSHES (row raised-a-nonlive-seats-builder-
  #     strands-its-fix). 2026-09-30: during a planning handoff the old seat's builder finished a gated fix, and its
  #     commit-and-push was refused because its calls carry the parent's session id; the live successor's retry
  #     was then denied as a bypass, and the fix sat uncommitted. The record's `scoped` (cc-handoff --ready) names
  #     the subagents still out at cutover; a call whose agent_id is in it may push, and nothing more.
  #     Its own fixture: a record dir per shape, nothing read that an earlier case left behind.
  GERR=$T/err69; r=0; mkdir -p "$T/hd69" "$T/hd69b" "$T/hd69c" "$T/hd69d"
  rec69(){ jq -n --arg id "$1" --arg live "$2" --argjson sc "$3" '{id:$id, target:"demo/t1", phase:"cutover", live:$live,
    predecessor:{session_id:"sid69", tmux:"@69", window:"demo/t1"}, successor:{session_id:"suc69", tmux:"@70", window:"demo/t1~next"},
    scoped:$sc, held:[]}'; }
  rec69 h69 successor '["abuild69"]' > "$T/hd69/demo-t1.json"
  push69="cd $WT && git add f && git commit -q -m 'the fixture fix' && git push -q origin HEAD:track/t1"
  hg69(){ local d=$1 a=$2; shift 2; : > "$GERR"; GSID=sid69 GAID=$a g Bash "$(J "$1")" "$WT" CC_HANDOFF_DIR="$T/$d" "${@:2}"; }
  p1=$(hg69 hd69 abuild69 "$push69")
  p2=$(hg69 hd69 "" "$push69"); grep -qF "pushing while the other session is the live one" "$GERR" || p2="$p2(wrong rule)"
  p3=$(hg69 hd69 anew69 "$push69")                                           # started after the cutover: not in scoped
  p4=$(hg69 hd69 abuild69 "cc demo t2 --go 'x'")   # recurring-defect-ok: pause-hold-missing — a fixture payload the guard must refuse, never run
  p5=$(hg69 hd69 abuild69 "cc done")
  p6=$(hg69 hd69 abuild69 "cc-loop demo t2")
  [ "$p1" = 0 ] && [ "$p2$p3$p4$p5$p6" = 22222 ] || { r=1; echo "      scoped builder: push rc $p1 (want 0); the seat itself $p2, a later agent $p3, --go $p4, cc done $p5, cc-loop $p6 (want 2s)"; }
  # every record that gates the call must scope it: a second handoff that does not keeps the push refused
  cp "$T/hd69/demo-t1.json" "$T/hd69b/"; rec69 h69b successor '[]' > "$T/hd69b/demo-t1b.json"
  q1=$(hg69 hd69b abuild69 "$push69")
  # a list that is not a list scopes nobody, and never lifts the gate itself (a jq error would empty the verdict)
  rec69 h69c successor '"abuild69"' > "$T/hd69c/demo-t1.json"
  q2=$(hg69 hd69c abuild69 "$push69"); q3=$(hg69 hd69c abuild69 "cc done")
  # the successor before its cutover is not a predecessor with scoped work, whatever its agent id
  rec69 h69d predecessor '["abuild69"]' > "$T/hd69d/demo-t1.json"
  q4=$(GSID=suc69 GAID=abuild69 g Bash "$(J "$push69")" "$WT" CC_HANDOFF=h69d CC_HANDOFF_DIR="$T/hd69d")
  [ "$q1$q2$q3$q4" = 2222 ] || { r=1; echo "      a second unscoped record $q1, a string for a list $q2 / cc done $q3, the successor before cutover $q4 (want 2s)"; }
  unset GERR
  ok "a builder the non-live seat started before the cutover still commits and pushes; the seat itself, a later subagent, a second record that does not scope it, a corrupt list and the pre-cutover successor are refused, and the builder still may not dispatch, open a PR or run a loop" $r

  # 70. A LONG QUOTED STRING IS READ IN TIME, OR REFUSED (row raised-guard-slow-on-long-quoted-input). A hook that
  #     times out lets its call through, and main took 160 s on a 40 KB single-quoted string of short lines because
  #     the join rescanned the whole quote for every line. 40 KB is now read, both ways, well inside the budget; past
  #     128 KB is refused unread; and a read that outlives CC_GUARD_BUDGET is refused, never let through. Each
  #     payload is built here and goes in on stdin (jq -Rs), because 320 KB is past what one argv word may carry.
  GERR=$T/err70; r=0
  body70(){ awk -v n="$1" 'BEGIN { for (i = 0; i < n; i++) printf "l%d %s\n", i, "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }'; }
  J70(){ printf '%s' "$1" | jq -Rs '{command:.}'; }
  t70(){ local a=${EPOCHREALTIME/./} rc; : > "$GERR"; rc=$(g Bash "$1" "$WT" CC_ROLE=worker "${@:2}"); echo "$rc $(( (${EPOCHREALTIME/./} - a) / 1000 ))"; }
  b40=$(body70 1000); b320=$(body70 8000)                                             # ~40 KB and ~320 KB
  read -r k1 m1 < <(t70 "$(J70 "echo '$b40' > $T/o70")")                               # kept: data, read and passed
  read -r k2 m2 < <(t70 "$(J70 "echo '$b40' > $T/o70; tmux kill-server")")             # the gate past it still holds
  grep -qF 'shared tmux server' "$GERR" || k2="$k2(wrong rule)"
  read -r k3 m3 < <(t70 "$(J70 "echo '$b320' > $T/o70")")                              # past the cap: refused unread
  grep -qF 'past the 131072' "$GERR" || k3="$k3(wrong rule)"
  read -r k4 m4 < <(t70 "$(J70 "echo '$b40' > $T/o70")" CC_GUARD_BUDGET=0.05)          # out of time: refused, not passed
  grep -qF 'did not finish reading this call' "$GERR" || k4="$k4(wrong rule)"
  # the budget a call is given, read off a stub timeout first on the PATH that keeps its duration argument (-k 2 <s>
  # …): one above 30 s, 0 (no timeout at all) and junk are all held to 30, and a lower one is taken as it is
  mkdir -p "$T/to70"; printf '#!/bin/sh\necho "$3" >> "%s"\n' "$T/args70" > "$T/to70/timeout"; chmod +x "$T/to70/timeout"
  for b in 900 0 junk 5; do g Bash "$(J70 true)" "$WT" CC_ROLE=worker CC_GUARD_BUDGET="$b" PATH="$T/to70:$PATH" >/dev/null; done
  k5=$(tr '\n' ' ' < "$T/args70" 2>/dev/null)
  k6=$(g Bash "$(J70 "echo '$b40' > $T/o70")" "$WT" CC_ROLE=worker CC_GUARD_BUDGET=0.05 _CC_GUARD_TIMED=1)  # the mark alone skips no budget
  # the scan RESUMES after a quote join and after a backslash continuation: a gate on the line it resumed into holds
  c1=$(g Bash "$(J70 "echo 'a
b' && \
tmux kill-server")" "$WT" CC_ROLE=worker)
  c2=$(g Bash "$(J70 "echo 'a
b' && \
true")" "$WT" CC_ROLE=worker)
  [ "$c1$c2" = 20 ] || { r=1; echo "      a continuation after a joined quote: tmux kill-server $c1 (want 2), true $c2 (want 0)"; }
  [ "$k1" = 0 ] && [ "$k2$k3$k4" = 222 ] && [ "$k5" = "30 30 30 5 " ] && [ "$k6" = 2 ] || { r=1; echo "      40 KB data rc $k1 (want 0), with tmux kill-server after it $k2, 320 KB $k3, a 0.05 s budget $k4 (want 2s); budgets 900, 0, junk, 5 gave timeout '$k5' (want '30 30 30 5 '); the mark from the env $k6 (want 2)"; }
  for m in "$m1" "$m2" "$m3"; do [ "$m" -lt 15000 ] || { r=1; echo "      a read took ${m} ms (want under 15000 — main took 160 s; the hook gives up at 60 s and lets the call through)"; }; done
  [ "$m4" -lt 5000 ] || { r=1; echo "      the 0.05 s budget took ${m4} ms to refuse (want under 5000)"; }
  unset GERR
  ok "a 40 KB quoted string is read in time both ways (data passes, a tmux kill-server after it is refused); 320 KB is refused unread; a read past its budget is refused, not let through; a budget above 30 s, 0 or junk is held to 30; and a mark in the env skips no budget" "$r"

  # 70b. NO timeout ON THE PATH: a gated role is refused outright, and any other session is still read, only without a
  #      budget — a plain command passes and a tmux kill-server is refused. The PATH is the caller's, with each dir that
  #      holds a timeout swapped for a dir of links to everything in it but that. Nothing here writes through a link.
  GERR=$T/err70b; r=0; ntp=""; nd=0
  IFS=: read -ra pd70 <<<"$PATH"
  for d in "${pd70[@]}"; do
    if [ -x "$d/timeout" ]; then nd=$((nd + 1)); mkdir -p "$T/nt70.$nd"; ln -s "$d"/* "$T/nt70.$nd/" 2>/dev/null
      rm -f "$T/nt70.$nd/timeout"; d=$T/nt70.$nd; fi
    ntp=${ntp:+$ntp:}$d; done
  PATH=$ntp command -v timeout >/dev/null 2>&1 && { r=1; echo "      the fixture PATH still finds a timeout: this case tests nothing"; }
  : > "$GERR"; n1=$(g Bash "$(J70 true)" "$WT" CC_ROLE=worker PATH="$ntp")
  grep -qF 'timeout is missing' "$GERR" || n1="$n1(wrong rule)"
  n2=$(g Bash "$(J70 true)" "$T" PATH="$ntp")
  : > "$GERR"; n3=$(g Bash "$(J70 "tmux kill-server")" "$T" PATH="$ntp")
  grep -qF 'shared tmux server' "$GERR" || n3="$n3(wrong rule)"
  [ "$n1$n2$n3" = 202 ] || { r=1; echo "      no timeout: a worker's true $n1 (want 2), a plain session's true $n2 (want 0), its tmux kill-server $n3 (want 2)"; }
  unset GERR
  ok "with no timeout on the PATH a worker is refused, and a plain session is still read without a budget (true passes, tmux kill-server is refused)" "$r"

  # 70c. WHERE THE SCAN RESUMES AND WHERE IT STARTS OVER. A `<` before a line-ending backslash makes `<\` + `<'EOF'`
  #      a `<<` that a resumed scan would never see, so that line is scanned again from its start: the heredoc in
  #      the `"$(` is found and its body is the argument it is, as it is with `<<` on one line. And a backslash at
  #      the end of a comment joins nothing (70d), so a quote opened on the next line is read as the shell reads
  #      it, and the gate after it holds.
  r=0
  s1=$(g Bash "$(J70 "echo \"\$(cat <\\
<'EOF'
tmux kill-server
EOF
)\"")" "$WT" CC_ROLE=worker)
  s2=$(g Bash "$(J70 "echo \"\$(cat <<'EOF'
tmux kill-server
EOF
)\"")" "$WT" CC_ROLE=worker)
  s3=$(g Bash "$(J70 "true # note \\
echo 'a
b'; tmux kill-server")" "$WT" CC_ROLE=worker)
  [ "$s1$s2$s3" = 002 ] || { r=1; echo "      a heredoc opener split at <\\ $s1 (want 0, as on one line: $s2); a quote after a continued comment hid tmux kill-server: $s3 (want 2)"; }
  ok "a heredoc opener split by a backslash after its first < is rescanned and read as on one line, and a quote on the line a comment's backslash pulls in hides no gate after it" "$r"

  # 70d. A BACKSLASH AT THE END OF A COMMENT IS PART OF THE COMMENT. bash ends the comment at the newline and runs
  #      the next line, so a gated command there is refused — after a bare comment, one behind a command, one behind
  #      a quote, an odd run of backslashes, and a comment inside a `"$(` or a backtick. A real continuation is
  #      still a continuation, and an ungated line after a continued comment still runs (security read of #966).
  r=0; d1=""; d2=""
  for p in 'true # note \
tmux kill-server' '# just a note \
cc-land 7' 'echo hi # x \\\
gh pr merge 1' "echo 'a' # q \\
docker run -v /:/host alpine" 'echo "$(true # x \
tmux kill-server)"' 'x=`true # x \
tmux kill-server`' "echo 'a
b' # c \\
tmux kill-server"; do d1="$d1$(g Bash "$(J70 "$p")" "$WT" CC_ROLE=worker)"; done
  for p in 'true # note \
true' 'echo "$(true # x \
true)"' 'echo a \
b' 'echo \
tmux kill-server' 'echo "#" \
tmux kill-server'; do d2="$d2$(g Bash "$(J70 "$p")" "$WT" CC_ROLE=worker)"; done
  [ "$d1$d2" = 222222200000 ] || { r=1; echo "      gated line after a continued comment: $d1 (want 2222222); kept: $d2 (want 00000)"; }
  ok "a backslash ending a comment joins nothing: the gated line after it is refused (bare, behind a command, a quote, an odd run, in a \"\$( and a backtick), while a real continuation and an ungated next line still run" "$r"

  # 70e. A `#` RIGHT AFTER `)`, `<` OR `>` IS REFUSED WHEN IT DECIDES WHAT RUNS. After a subshell or a redirection
  #      bash reads it as a comment, so `(true)#x \` runs the next line (security read of #975); after the `)` of a
  #      `$( )`, `<( )`, `$(( ))` or `@( )`, or inside a `${ }`, it is part of the word, so `echo $(true)#'` opens a
  #      quote and the line it closes on runs (delta read of #975). Either reading the guard picked let a gated line
  #      through the other, so a join or a heredoc behind one is refused. The same goes for a heredoc behind a
  #      comment inside a `"$(`, which dropped the gated line as its body. Round 3 widens it: a `#` after a blank or
  #      an operator inside a `${ }`, a `[[ ]]` or a backtick, or after an escaped character, is a word or a
  #      comment depending on what is open, so a quote or join behind it is refused too. With nothing joined on,
  #      with the `#` quoted, in a heredoc body, or a plain comment that holds an apostrophe, it still passes.
  e70(){ local all p out=""; all=$(cat)$'\n@@'
    while [ -n "$all" ]; do p=${all%%$'\n@@'*}; all=${all#*$'\n@@'}; all=${all#$'\n'}
      out="$out$(g Bash "$(J70 "$p")" "$WT" CC_ROLE=worker)"; done; echo "$out"; }
  r=0
  e1=$(e70 <<'P70'
echo "$( (true)#x \
tmux kill-server)"
@@
(true)#"x
tmux kill-server #"
@@
echo "$(echo a <#x \
tmux kill-server)"
@@
echo a <#x \
tmux kill-server
@@
echo "$(echo a >#x \
tmux kill-server)"
@@
echo a >#x \
tmux kill-server
@@
(true)#x \
true
@@
echo $(true)#'
echo '; tmux kill-server; echo \
@@
cat <(true)#'
echo '; tmux kill-server; echo \
@@
echo $((1))#'
echo '; tmux kill-server; echo \
@@
echo ${x:-(a)#'
echo '}; tmux kill-server; echo \
@@
echo ${x:-<#'
echo '}; tmux kill-server; echo \
@@
echo ${x:->#'
echo '}; tmux kill-server; echo \
@@
shopt -s extglob
echo @(a)#'
echo '; tmux kill-server; echo \
@@
echo $(true)#'
echo '; tmux kill-server; echo '
'
@@
cat <(true)#'
echo '; tmux kill-server; echo '
'
@@
echo ${x:->#'
echo '}; tmux kill-server; echo '
'
@@
echo $(true)#x; gh api repos/o/r \
-X DELETE
@@
(true)#<<EOF
tmux kill-server
EOF
@@
echo "$( (true)#<<EOF
tmux kill-server
EOF
)"
@@
echo "$(true #<<EOF
tmux kill-server
EOF
)"
@@
echo ${x:- #'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:--#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-;#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-|#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-&#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-	#'
echo '}; tmux kill-server; echo '
'
@@
echo ${x:-$(true) #'
echo '}; tmux kill-server; echo '
'
@@
echo \ #'
echo '; tmux kill-server; echo '
'
@@
echo \(#'
echo '; tmux kill-server; echo '
'
@@
echo \;#'
echo '; tmux kill-server; echo '
'
@@
echo \|#'
echo '; tmux kill-server; echo '
'
@@
echo \&#'
echo '; tmux kill-server; echo '
'
@@
echo \	#'
echo '; tmux kill-server; echo '
'
@@
[[ x =~ a|#'
' ]]; tmux kill-server; echo '
'
@@
echo ${x:- #'
echo ' \
}; tmux kill-server
@@
echo ${x:- #a} \
tmux kill-server
@@
echo ${x:- #a} <<EOF
tmux kill-server
EOF
P70
)
  e2=$(e70 <<'P70'
x=$(date)#tag
@@
echo "$(date)#tag" \
done
@@
git commit -m "fix (a)#1 and
(b)#2"
@@
cat <<EOF
see (a)#1 and a>#b
EOF
@@
echo "$(cat <<'EOF'
(a)#b
EOF
)"
@@
echo $((16#ff)) ${#a} \
true
@@
echo hi # it's fine
echo two
@@
x=${y:-a} # don't
echo two
P70
)
  [ "$e1$e2" = 22222222222222222222222222222222222222200000000 ] || { r=1; echo "      a join or heredoc behind ) < > then #: $e1 (want 222222222222222222222222222222222222222); kept: $e2 (want 00000000)"; }
  ok "a # right after ) < or > that decides whether the next line is joined or a heredoc opens is refused, both readings of it (a subshell, a redirection, a \$( ), <( ), \$(( )), \${ }, @( )), and a heredoc behind a comment in a \"\$( keeps its gated body; with nothing joined on, quoted or in a body it still passes" "$r"

  # 71. A TMUX COMMAND SSH RUNS ON ANOTHER HOST IS NOT THIS BOX'S SERVER (row raised-guard-reads-remote-tmux-kill-as-
  #     local). `ssh <host> 'tmux kill-session -t x'` runs over there and passes; a tmux kill this box runs — bare, by
  #     bash -c or sh -c, after the ssh, inside a "$( )" ssh's own shell expands here, in an option ssh runs here, or
  #     an ssh whose host is this box — is still refused. Its own fixture: ssh, hostname and getent are stand-ins on the
  #     PATH, so what "this box" is does not depend on the box the suite runs on: this box is box71 at 10.71.0.1, the
  #     ssh config maps selfalias to 127.0.0.1 and gives proxied a jump host, and only literal addresses resolve.
  #     Each stand-in notes its call in $S71/calls, and the case fails unless all three were the ones the gate ran
  #     (review of #1104: g passes PATH=… into the hook's env, and this shows the real ones were not reached).
  #     A \n in a row is a newline.
  GERR=$T/err71; r=0; S71=$T/bin71; mkdir -p "$S71"
  cat > "$S71/ssh" <<'S71'
#!/bin/sh
echo ssh >> "${0%/*}/calls"; h=""; o=""; pj=""
while [ $# -gt 0 ]; do case $1 in -G|--) ;; -o) shift; case $1 in [Hh]ost[Nn]ame=*) o=${1#*=};; [Pp]roxy[Jj]ump=*) pj=${1#*=};; esac;; *) h=$1;; esac; shift; done
