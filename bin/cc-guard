  # …and the shapes a one-line row cannot hold. A BACKSLASH AT THE END OF A LINE joins the next one for the
  # shell, and read as two lines the write flag stood in a statement of its own: `gh api repos/o/r \` over
  # `-X DELETE` passed as a GET. And a sed that FAILS left the --help blanking with an empty line to match, so
  # the landing rule matched nothing at all (security read of #574). Landing is argv's rule now, which reads no
  # sed, so with a broken sed `cc-land 7` is still refused and `cc-land --help` still runs.
  mkdir -p "$T/nosed"; printf '#!/bin/sh\nexit 1\n' > "$T/nosed/sed"; chmod +x "$T/nosed/sed"
  p1=$(g Bash "$(J "gh api repos/acme-ok/x/pulls \\
  -X DELETE")" "$WT" CC_ROLE=worker)
  p2=$(g Bash "$(J "gh api repos/acme-ok/x/pulls \\
  --paginate")" "$WT" CC_ROLE=worker)
  : > "$GERR"; p3=$(g Bash "$(J "cc-land 7")" "$WT" CC_ROLE=worker PATH="$T/nosed:$PATH")
  grep -qF 'landing a change' "$GERR" || p3=$p3-wrong-reason
  p4=$(g Bash "$(J "cc-land --help")" "$WT" CC_ROLE=worker PATH="$T/nosed:$PATH")
  [ "$p1$p2$p3$p4" = "2020" ] || { r=1; echo "      continuation: refused $p1, read $p2 | broken sed: land $p3, --help $p4"; }
  ok "a sed that only prints, cc-land --help and a gh api GET read and run — beside a system reader, a sort, a spaced 2>/dev/null — while the same read piped into a shell or a substitution, sourced, fed to xargs, teed and run, piped into a reader named by path or into awk or a sort that writes, copied and run in the same command, a sed script that runs or writes or that an expansion could inject into, arguments after --help, a gh api whose write flag stands behind a tab, a continuation, a variable or an xargs, and every rule read through a broken sed, are all refused" $r

  # 66. A PATTERN KILL NEVER REACHES A SESSION, FROM ANY SESSION (row raised-a-test-pkill-killed-every-session). On
  #     2026-09-26 a review subagent of an UNGATED seat ran `pkill -KILL -f 'print "| "'` — a regex that every claude
  #     argv matches — and SIGKILLed about 26 seats. No role here and a cwd no marker names: the universal gate alone.
  #     A stand-in session (a `claude -p` whose argv carries ` "` and a minted mark) makes each refusal this case's own,   recurring-defect-ok: pause-hold-missing — a sleep script named claude, no worker is launched
  #     not the box's; its own sleeper, the thing a fixture legitimately ends, is the kept side.
  r=0; mk66=zq66$$; GERR=$T/gerr66
  "$T/claude" -p "say \"hi\" $mk66" >/dev/null 2>&1 & s66=$!; pids="$pids $s66"
  sh -c 'sleep 600' >/dev/null 2>&1 & o66=$!; pids="$pids $o66"
  sleep 0.3
  u66(){ : > "$GERR"; g Bash "$(J "$1")" "$T"; }
  [ "$(u66 "pkill -KILL -f 'print \"| \"'")" = 2 ] && grep -qF "(pkill print \"| \")" "$GERR" \
    || { r=1; echo "      the 09-26 command was not refused as a pattern kill: $(head -c 120 "$GERR")"; }
  for x in "pkill -f '$mk66|nothing-else'" "pgrep -f $mk66 | xargs kill -9" "kill \$(pgrep -f '$mk66')" "timeout 5 pkill -f $mk66" \
           "bash -c \"pkill -9 -f '$mk66'\"" "killall claude" "kill \$(pidof claude)" \
           "pkill -f '$mk66\$'" "pkill -f ' \"|zz\$'" "pkill -f '$mk66\$|\$x'" "/usr/bin/pkil[l] -f $mk66" "/usr/bin/pki?l -f $mk66" \
           "/usr/bin/p[^a]ill -f $mk66" "/usr/bin/p[[:alpha:]]ill -f $mk66" "{pkill,}\$x -f $mk66" "/usr/bin/pkil[l]\$x -f $mk66" \
           "/usr/bin/s* pkill -f $mk66" "pkill\${IFS}-f\${IFS}$mk66" "/usr/bin/pkil[l]\${IFS}-f\${IFS}$mk66" "pkill -f {$mk66,qq66}"; do
    [ "$(u66 "$x")" = 2 ] || { r=1; echo "      not refused: $x"; }
    case "$x" in *claude*|*zz*) ;; *) grep -qF " $s66" "$GERR" || { r=1; echo "      refused, but not for the stand-in: $x"; };; esac   # a real claude may outnumber the pids a refusal names
  done
  for x in "kill $o66" "kill -0 $s66" "pkill -P $o66" "pkill -0 -f $mk66" "pgrep -f $mk66 | xargs kill -0" "pkill -f $T/no-such-fixture" \
           "pgrep -f $mk66; echo looked" "pkill -f \"\$NOPE66\"" "pkill\${IFS}-f\${IFS}$T/no-such-fixture" "$(printf 'cat > %s <<%s\npkill -f %s\nEOF' "$T/note66" "'EOF'" "$mk66")"; do
    [ "$(u66 "$x")" = 0 ] || { r=1; echo "      a scoped kill or a read was refused: $x — $(head -c 100 "$GERR")"; }
  done
  kill -0 "$s66" 2>/dev/null && kill -0 "$o66" 2>/dev/null || { r=1; echo "      a fixture process is gone: something signalled it"; }
  unset GERR
  ok "from a session with no role, a pattern kill that matches a session is refused — the 09-26 pkill, a hunt through xargs or \$(…), a wrapper, sh -c, killall and pidof — while a named pid, kill -0, pkill -P of its own, signal 0 and a pattern that takes nothing pass" $r

  # 67. THE PATTERN-KILL GATE LEAVES THE CD WALK ITS HAYSTACK. Case 66's loop once read each kill into \$uk, the
  #     marked haystack the gated tiers' cd walk reads later, so a line that passed the gate reached the walk holding
  #     only the kill: `cd ~/bin && pkill -0 -f x; cp /dev/null cc-guard` truncated a live binary (review of #700).
  #     The write after a passing kill is still refused; the kill alone still passes the gate.
  r=0; GERR=$T/err67; mk67=zq67nothing$$
  : > "$GERR"; got=$(g Bash "$(J "cd $H/bin && pkill -0 -f $mk67; cp /dev/null cc-guard")" "$H/dev/ws1" CC_ROLE=member CC_GUARD_ROOT_PID=$$)   # a root the kill fence finds, detached or not
  { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
    || { r=1; echo "      a write after a passing pattern kill: rc $got, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; got=$(g Bash "$(J "cd $H/bin && pkill -0 -f $mk67")" "$T")   # no role: the gate alone, since a member's kill also needs its own session found, which a detached gate run has not got
  [ "$got" = 0 ] || { r=1; echo "      the kill alone was refused by the pattern-kill gate: rc $got — $(head -c 70 "$GERR")"; }
  unset GERR
  ok "a write after a pattern kill that passes the gate still reaches the write fence, so \`cd ~/bin && pkill -0 -f x; cp /dev/null cc-guard\` is refused while the kill alone passes the gate" $r

  # 68. THE PERMISSION SEAT'S STATE IS FENCED LIKE ~/.cc/state/arch, WITH ONE EXCEPTION: the live bypass seat
  #     itself may still write it. Everybody else — a plain shell with no role, a worker, a member — is refused
  #     through the Bash write scan (a redirect, cp, rm of the file, rm -rf of the directory ABOVE it, and the
  #     glob form) and through the Write tool. The seat is recognised by CC_GUARD_ROOT_PID pointing at a detached
  #     process named claude that carries --dangerously-skip-permissions and has no live claude of its own above
  #     it — a setsid orphan reparented off this fixture's own ancestry, the same shape the owner's
  #     launch from a tmux pane leaves, so the check that refuses a claude spawned FROM another claude (forging the flag)
  #     is exercised honestly rather than skipped.
  mkdir -p "$H/.cc/state/demo68/perms"; printf 'brief' > "$H/.cc/state/demo68/perms/brief.md"
  # setsid -f (always fork): plain `setsid cmd` execs cmd IN PLACE only when it can, and when it cannot (this
  # shell is already a process group leader) it forks and its own wrapper process sits waiting on the child for
  # as long as the child lives — a second match for the pgrep below, still parented to this very shell, which
  # is exactly the false "second claude above it" pseat is right to refuse. -f always forks and the wrapper
  # exits at once, so only the exec'd, now-orphaned claude remains.
  # …started IN the seat's directory, because pseat also requires the claude's cwd to be ~/.cc/state/<repo>/perms
  (cd "$H/.cc/state/demo68/perms" && setsid -f "$T/claude" --dangerously-skip-permissions >/dev/null 2>&1 </dev/null & disown)
  sleep 0.3; seat68=""
  for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
    [ "$(cat "/proc/$cand/comm" 2>/dev/null)" = claude ] && [ "$(readlink "/proc/$cand/cwd")" = "$H/.cc/state/demo68/perms" ] && { seat68=$cand; break; }
  done
  r=0; GERR=$T/gerr68
  w1=$(g Bash "$(J "echo x > $H/.cc/state/demo68/perms/brief.md")" "$T")
