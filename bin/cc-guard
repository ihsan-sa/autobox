#!/usr/bin/env bash
# cc-guard — PreToolUse hook: deterministic human gates for AUTONOMOUS and MEMBER-FACING sessions.
# Applies when CC_ROLE=worker|member|steward is set, or the session cwd is under a dir marked .cc/track (a cc track
# worktree, role=worker) or .cc/member-facing (a session anybody in a Slack channel can talk to, role=member) —
# so interactive TRACK sessions are gated too (intended); plain operator/planning sessions are not.
# The MARKER is the truth: CC_ROLE is only a convenience, the walk works with no env at all.
# Denies (exit 2 + reason) the four owner gates:
#   1. merge to default branch / deploy      2. external comms in owner's name
#   3. destructive / infra ops               4. (spend is enforced by --max-budget-usd on headless workers)
# EVERY rule reads ONE anchor, so a word in front of a command turned all of them off at once (`timeout 5 tmux
# kill-server` walked past the universal gate). The haystack now carries each statement AND every suffix of it,
# plus what an option attaches after an `=` (`--filter=CMD` is run by a shell and is never its own word), so a
# rule sees the command wherever a wrapper put it — cmdpos(), which is also where that fix's ceiling is.
# The walk stops only at a head with no option that runs a word ($NOEXEC), and the kill fence reads which
# options carry a value PER VERB, because `-o` is a flag to pkill and `--older-than TIME` to killall.
# A deny is one of TWO kinds. `deny` = the owner could say yes (merging, pushing, a comment in his name, an email,
# a post to his Slack); `never` = no yes exists for this tier (landing, dispatching a worker, host changes, the
# box's secrets). From a MEMBER-FACING session either RECORDS A QUERY the box's queries session drains and answers
# (record_query below, class page for a deny and nopage for a never) — nothing in the member's own channel, no page
# to the owner (owner, 2026-09-04). Writing outside the session's own tree is `never` too, but QUIET: the session
# aimed that write itself and reads the reason on stderr; not even a query is recorded for it.
# Either gated tier also kills only its own descendants — never a session, a loop runner, or anything it
# did not start (a member workspace's own workers run at role=member, so `worker` alone would miss them).
# EVERY gated role, worker included: no container runtime (this user is in group `docker`, which is root-equivalent)
# and no reading the two files that ARE the box's credentials (~/.claude/.credentials.json, ~/ccbox/env).
# role=member = every worker gate PLUS: no dispatching workers, no reading the box's other secrets, no re-wiring Slack.
# role=steward (CC_ROLE only — cc-steward's run dir carries no marker) = every worker gate PLUS that same set, minus
# the member workspace's carve-outs and without recording a query: a steward's refusal is its own exit code and log.
# A MEMBER WORKSPACE (~/dev/<handle>/.cc/member-workspace, and any track of it) is the one exception: it dispatches
# workers and makes tracks INSIDE itself and nowhere else — docs/design-member-workspaces.md.
# It also gates whichever session is NOT live during an overlapping handoff (cc-handoff), by session id and
# by $CC_HANDOFF rather than by a marker: the two sessions share one cwd, so the walk below cannot tell them apart.
#   cc-guard selfcheck     the gates, against fixtures in a HOME of their own — never this box's state or sessions
# Env: CC_GUARD_ASKS, CC_GUARD_ASK_TTL (where a member-facing query is de-duplicated, and for how long) ·
# CC_GUARD_ROOT_PID (test hook: the session process the worker kill fence measures its subtree from).
set -uo pipefail
# No jq = no cwd, so no marker walk either: fail CLOSED on every role we can know from the env alone — `cc` sets it
# for a worker and a member, cc-steward for a steward. A gated role missing from this list is a role whose gates are
# silently OFF on a broken PATH, which for the steward would be the widest tier of all: it is the one session that
# runs unattended, so "refused by cc-guard and not merely discouraged" has to hold on the day jq is not there either.
command -v jq >/dev/null 2>&1 || { case "${CC_ROLE:-}${CC_HANDOFF:+ handoff}" in *worker*|*member*|*steward*|*handoff*) echo "cc-guard: jq is missing (broken PATH?) — the gates cannot be evaluated, so the call is refused" >&2; exit 2;; esac; exit 0; }
# ---- selfcheck -------------------------------------------------------------------------------------------
# It sits ABOVE the read of stdin because that read is where every other path here begins, and a hook has no
# other door. Each case builds its own fixture — its own HOME, its own asks dir, its own stub binaries — and
# asserts BOTH sides: what is refused AND what is still allowed, what pages AND what must not.
if [ "${1:-}" = selfcheck ]; then
  # The RUNNER's env decides nothing here: a worker running the gates exports CC_ROLE, and a member session its
  # CC_GUARD_ASKS — each case sets what it needs and reaches the child through `env` below.
  unset CC_NOTIFY_LOG_ONLY CC_NOTIFY_LOG CC_ROLE CC_HANDOFF CC_HANDOFF_DIR CC_GUARD_ASKS CC_GUARD_ASK_TTL CC_GUARD_ROOT_PID
  T=$(mktemp -d); H=$T/home; WT=$H/.cc/worktrees/demo/t1; n=0; f=0; pids=""
  # A SECOND FIXTURE HOME, AND THE POINT OF IT IS THAT IT IS NOT UNDER /tmp: the write-path rules wave /tmp
  # through as scratch, so a fixture there cannot test them at all — every path in $T is already allowed.
  # $HOME, because it is the one dir outside /tmp that exists in every place this runs; it goes with $T below.
  # Empty = case 12 FAILS rather than testing nothing: a fixture under /tmp would go green having gated nothing.
  T2=$(mktemp -d "$HOME/.cc-guard-selfcheck.XXXXXX" 2>/dev/null) || T2=""
  trap '[ -n "$pids" ] && { kill $pids 2>/dev/null; sleep 0.2; kill -9 $pids 2>/dev/null; }; rm -rf "$T" ${T2:+"$T2"}' EXIT
  mkdir -p "$H/bin" "$H/.cc" "$H/dev/alice/.cc" "$H/dev/_cctest1/.cc" "$WT/.cc"
  : > "$H/dev/alice/.cc/member-facing"; : > "$H/dev/_cctest1/.cc/member-facing"; : > "$WT/.cc/track"
  # The owner's two real doors, stubbed: a case can then say "this was sent" and "nothing was".
  printf '#!/bin/sh\necho "notify $*" >> "$CALLS"\n' > "$H/bin/cc-notify"
  printf '#!/bin/sh\necho "slack $*" >> "$CALLS"\n' > "$H/bin/cc-slack"
  chmod +x "$H/bin/cc-notify" "$H/bin/cc-slack"
  # ...and a stand-in for a session process: `claude -p` is what the kill fence must never let go, and the
  # cases below need one they started themselves rather than a real session of this box's to point at.
  printf '#!/bin/sh\nsleep 45\n' > "$T/claude"; chmod +x "$T/claude"
  ok(){ n=$((n+1)); if [ "$2" = 0 ]; then echo "  ✓ $1"; else f=$((f+1)); echo "  ✗ $1"; fi; }
  g(){ local t=$1 i=$2 c=$3 pl; shift 3   # a payload through the gate, in a HOME of its own; rc is the answer
    #  …and the REASON too, for a case that sets $GERR: rc 2 alone cannot say WHICH rule refused (case 11).
    pl=$(printf '{"tool_name":"%s","tool_input":%s,"cwd":"%s"}' "$t" "$i" "$c")
    # A PAYLOAD THAT IS NOT JSON IS NOT A TEST. jq fails, the guard sees no tool at all and exits 0, so a row
    # asserting "still allowed" goes GREEN having gated nothing — one did, for a whole review round (#193).
    # rc 99 is neither 0 nor 2, so it fails whichever side the case is asserting.
    jq -e . >/dev/null 2>&1 <<<"$pl" || { echo 99; return; }
    printf '%s' "$pl" \
      | env HOME="${GH:-$H}" CALLS="$CALLS" CC_GUARD_ASKS="$ASKS" "$@" "$0" >/dev/null 2>"${GERR:-/dev/null}"; echo $?; }

  # 1. A MEMBER REFUSAL IS A QUERY, NOT A LINE IN THE MEMBER'S CHANNEL. The landing tool from a member-facing
  #    session: refused, a query RECORDED for the box's queries session, and NOTHING in the member's own channel
  #    and NOTHING paged to the owner (owner, 2026-09-04). cc-land has no yes for a member, so class=nopage.
  ASKS=$T/asks1; CALLS=$T/calls1; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  rc=$(g Bash '{"command":"cc-land 7"}' "$H/dev/alice")
  if [ "$rc" = 2 ] && [ ! -s "$CALLS" ] && [ "$(wc -l < "$QS" 2>/dev/null)" = 1 ] \
     && jq -e 'select(.class=="nopage" and .workspace=="alice" and (.command|test("cc-land")))' "$QS" >/dev/null 2>&1; then r=0; else r=1; fi
  ok "a member refusal records a query for the box and says nothing in the member's channel or to the owner" $r

  # 2. …AND AN APPROVABLE ONE IS RECORDED ONCE. gh pr merge could be yes, so class=page — but a member retrying the
  #    same blocked command must not fill the spool: one query per workspace+reason inside the TTL.
  ASKS=$T/asks2; CALLS=$T/calls2; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  rc=$(g Bash '{"command":"gh pr merge 1"}' "$H/dev/alice")
  rc2=$(g Bash '{"command":"gh pr merge 1"}' "$H/dev/alice")
  if [ "$rc" = 2 ] && [ "$rc2" = 2 ] && [ ! -s "$CALLS" ] && [ "$(wc -l < "$QS")" = 1 ] \
     && jq -e 'select(.class=="page")' "$QS" >/dev/null 2>&1; then r=0; else r=1; fi
  ok "an approvable member refusal is recorded as one page-class query, and a retry inside the TTL does not record it again" $r

  # 3. THE QUERY NAMES THE WORKSPACE, THE COMMAND AND THE REASON — the three things the queries session reads to
  #    approve or answer it, since a member sandbox cannot reach the owner itself and the host drains this spool.
  ASKS=$T/asks3; CALLS=$T/calls3; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  rc=$(g Bash '{"command":"gh pr merge 42"}' "$H/dev/alice")
  named=$(jq -er 'select(.workspace=="alice" and (.reason|test("merging")) and (.command|test("gh pr merge 42")))|"y"' "$QS" 2>/dev/null)
  if [ "$rc" = 2 ] && [ "$named" = y ] && [ ! -s "$CALLS" ]; then r=0; else r=1; fi
  ok "the recorded query names the workspace, the command and the reason the queries session needs to act on it" $r

  # 4. A WORKER KILLS ONLY ITS OWN. Its child goes; the pid of something it did not start does not (11:15Z:
  #    a worker pgrep'd the suite's filename, matched its own session and ended its own iteration).
  ASKS=$T/asks4; CALLS=$T/calls4; : > "$CALLS"
  sleep 45 >/dev/null 2>&1 & child=$!; pids="$pids $child"
  own=$(g Bash "{\"command\":\"kill $child\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  out=$(g Bash '{"command":"kill -9 1"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  if [ "$own" = 0 ] && [ "$out" = 2 ] && [ ! -s "$CALLS" ]; then r=0; else r=1; fi
  ok "a worker kills its own child, is refused a pid outside its subtree, and pages nobody either way" $r

  # 4b. A NEGATIVE PID IS A PROCESS GROUP. `kill -9 -1` parsed as two signals and was waved through, which is
  #     every process this user owns; a named group is fenced pid by pid like any other target.
  ASKS=$T/asks4b; CALLS=$T/calls4b; : > "$CALLS"
  sleep 45 >/dev/null 2>&1 & c2=$!; pids="$pids $c2"
  all=$(g Bash '{"command":"kill -9 -1"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  grp=$(g Bash "{\"command\":\"kill -TERM -$(ps -o pgid= -p $c2 | tr -d ' ')\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  sig=$(g Bash "{\"command\":\"kill -9 $c2\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  if [ "$all" = 2 ] && [ "$sig" = 0 ] && [ ! -s "$CALLS" ]; then r=0; else r=1; fi
  ok "a worker is refused \`kill -9 -1\`, keeps its leading signal, and a named group is fenced pid by pid (rc $grp)" $r

  # 5. …and a session process is off limits even INSIDE the subtree: the incident was a worker killing the
  #    `claude -p` it was running in, which is its own ancestor, but a child one would end the run just as dead.
  "$T/claude" -p x >/dev/null 2>&1 & held=$!; pids="$pids $held"
  sleep 0.3
  rc=$(g Bash "{\"command\":\"kill $held\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  if [ "$rc" = 2 ]; then r=0; else r=1; fi
  ok "a worker is refused a kill of a claude -p, subtree or not" $r

  # 5b. …and the fence is the MEMBER tier's too, which is where it is needed most: a worker dispatched inside
  #     a member workspace runs at role=member (track_dir: the repo decides the tier, not the worktree), and
  #     that is the session running `claude -p` in a loop — the one the 11:15Z incident happened to. Its own
  #     pair of processes and its own call log, and the refusal must not page either: a kill is not a thing
  #     the owner could say yes to.
  ASKS=$T/asks5b; CALLS=$T/calls5b; : > "$CALLS"
  "$T/claude" -p x >/dev/null 2>&1 & mheld=$!; pids="$pids $mheld"
  sleep 45 >/dev/null 2>&1 & mchild=$!; pids="$pids $mchild"
  sleep 0.3
  rc=$(g Bash "{\"command\":\"kill $mheld\"}" "$H/dev/alice" CC_ROLE=member CC_GUARD_ROOT_PID=$$)
  out=$(g Bash '{"command":"kill -9 1"}' "$H/dev/alice" CC_ROLE=member CC_GUARD_ROOT_PID=$$)
  own=$(g Bash "{\"command\":\"kill $mchild\"}" "$H/dev/alice" CC_ROLE=member CC_GUARD_ROOT_PID=$$)
  if [ "$rc" = 2 ] && [ "$out" = 2 ] && [ "$own" = 0 ] && ! grep -q '^notify' "$CALLS"; then r=0; else r=1; fi
  ok "the same fence holds at the member tier, where a member workspace's own workers run — and refusing a kill pages nobody" $r

  # 6. A PATTERN IS RESOLVED, NOT GUESSED. One marked process, asked about twice: from a root that did not
  #    start it the pkill is refused, from the root that did it is allowed. The root is a pid this case picks,
  #    so the answer comes from the fixture and not from whatever else on the box happens to match.
  gk=marked$$                                   # minted per run, for the reason case 7 spells out
  printf '#!/bin/sh\nsleep 45\n' > "$T/$gk"; chmod +x "$T/$gk"
  sleep 45 >/dev/null 2>&1 & bare=$!; pids="$pids $bare"   # a root that started nothing: the marked process is outside it
  "$T/$gk" >/dev/null 2>&1 & mark=$!; pids="$pids $mark"  # ...and inside this shell's, the other root below
  sleep 0.3
  hit=$(g Bash "{\"command\":\"pkill -f $gk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$bare)
  mine=$(g Bash "{\"command\":\"pkill -f $gk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  miss=$(g Bash "{\"command\":\"pkill -f $gk-no-such-process-here\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$bare)
  if [ "$hit" = 2 ] && [ "$mine" = 0 ] && [ "$miss" = 0 ] && kill -0 "$mark" 2>/dev/null; then r=0; else r=1; fi
  ok "a worker's pkill -f is refused when it resolves outside its subtree, allowed when it resolves inside it, and allowed when it resolves to nothing" $r

  # 7. HUNT, THEN KILL. `pgrep -f <name> | xargs kill -9` is what the worker actually typed on 11:15Z, and
  #    it is the shape the target loop cannot see: the kill carries no pid of its own. Its own marked
  #    process, asked about from both roots, plus a feed that is no pgrep at all. The mark is minted per run
  #    ($$) because a fixed word here matched the shell that invoked this file — a command line carrying the
  #    word is exactly how the incident happened, and a case must not be decided by one.
  hk=hunted$$                                              # a name minted for this run: see below
  printf '#!/bin/sh\nsleep 45\n' > "$T/$hk"; chmod +x "$T/$hk"
  sleep 45 >/dev/null 2>&1 & hbare=$!; pids="$pids $hbare"   # a root that started nothing
  "$T/$hk" >/dev/null 2>&1 & hm=$!; pids="$pids $hm"
  sleep 0.3
  ASKS=$T/asks7; CALLS=$T/calls7; : > "$CALLS"
  hit=$(g Bash "{\"command\":\"pgrep -f $hk | xargs kill -9\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$hbare)
  mine=$(g Bash "{\"command\":\"pgrep -f $hk | xargs kill -9\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  opt=$(g Bash "{\"command\":\"pgrep -f $hk | xargs -n 1 kill -9\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$hbare)
  blind=$(g Bash '{"command":"cat pidfile | xargs kill -9"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  sub=$(g Bash "{\"command\":\"kill -9 \$(pgrep -f $hk)\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$hbare)
  if [ "$hit" = 2 ] && [ "$mine" = 0 ] && [ "$opt" = 2 ] && [ "$blind" = 2 ] && [ "$sub" = 2 ] \
     && kill -0 "$hm" 2>/dev/null; then r=0; else r=1; fi
  ok "a worker hunting with pgrep and killing through xargs is fenced on what the pgrep finds — with an option between the two, refused outside its subtree, allowed inside it, and refused when the feed is not a pgrep at all" $r

  # 8. AN OPTION'S VALUE IS NOT THE PATTERN. `pkill --signal TERM <name>` read TERM as the pattern, matched
  #    nothing and went through — and TERMs every match of the real name, this session included.
  ASKS=$T/asks8; CALLS=$T/calls8; : > "$CALLS"
  sk=signalled$$                                           # its own mark and its own pair, as above
  printf '#!/bin/sh\nsleep 45\n' > "$T/$sk"; chmod +x "$T/$sk"
  sleep 45 >/dev/null 2>&1 & sbare=$!; pids="$pids $sbare"
  "$T/$sk" >/dev/null 2>&1 & sm=$!; pids="$pids $sm"
  sleep 0.3
  sig=$(g Bash "{\"command\":\"pkill --signal TERM -f $sk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$sbare)
  usr=$(g Bash "{\"command\":\"pkill -u $(id -u) -f $sk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$sbare)
  own=$(g Bash "{\"command\":\"pkill --signal TERM -f $sk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  none=$(g Bash "{\"command\":\"pkill --signal TERM -f $sk-no-such-process-here\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$sbare)
  if [ "$sig" = 2 ] && [ "$usr" = 2 ] && [ "$own" = 0 ] && [ "$none" = 0 ] && kill -0 "$sm" 2>/dev/null; then r=0; else r=1; fi
  ok "an option's value is never mistaken for the pattern: --signal and -u are consumed, so the name after them is what gets resolved" $r

  # 9. A SELECTOR WITH NO PATTERN IS STILL EVERY PROCESS. `pkill -u $(id -u)` parses to no pattern at all, so
  #    the branch that resolves patterns found nothing to fence and waved it through — every process this user
  #    owns, this session's own claude -p and loop runner included, which is `kill -9 -1` spelled a second way
  #    (review of #181). Now refused, and refused for the attached and long spellings too, which is why this
  #    fails closed rather than resolving: the matcher cannot be taught every one. Both sides, as ever — the
  #    same selector carrying a pattern still resolves the pattern, and its own marked process is still there
  #    afterwards. The root here is the one that DID start the mark, so what refuses is the missing pattern
  #    and not the subtree test. Mark minted per run ($$) for the reason case 7 spells out.
  ASKS=$T/asks9; CALLS=$T/calls9; : > "$CALLS"
  nk=selected$$
  printf '#!/bin/sh\nsleep 45\n' > "$T/$nk"; chmod +x "$T/$nk"
  "$T/$nk" >/dev/null 2>&1 & nm=$!; pids="$pids $nm"
  sleep 0.3
  uid=$(g Bash "{\"command\":\"pkill -u $(id -u)\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  pgr=$(g Bash '{"command":"pkill -g 1"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)   # group 1: nothing this shell started
  att=$(g Bash "{\"command\":\"pkill -u$(id -u)\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  kal=$(g Bash "{\"command\":\"killall -u $(id -un)\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  own=$(g Bash "{\"command\":\"pkill -u $(id -u) -f $nk\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  if [ "$uid" = 2 ] && [ "$pgr" = 2 ] && [ "$att" = 2 ] && [ "$kal" = 2 ] && [ "$own" = 0 ] \
     && kill -0 "$nm" 2>/dev/null; then r=0; else r=1; fi
  ok "a pkill that selects a set but names no pattern is refused rather than resolved — -u, -g, an attached -u<uid> and killall -u alike — while the same selector carrying a pattern still resolves that pattern" $r

  # 10. …and the selectors that were still resolvable TO GARBAGE. `--older 3600` and `-F <pidfile>` take a
  #     value, so an argument list that skipped it read the value as the pattern, `pgrep -- 3600` matched
  #     nothing, and the fence found nothing to refuse — the same hole as `--signal TERM`, one round later.
  #     Its own mark and its own root, and the third line is the half that must NOT change: a selector
  #     carrying a real pattern still resolves that pattern.
  ASKS=$T/asks10; CALLS=$T/calls10; : > "$CALLS"
  ok10=selectors$$
  printf '#!/bin/sh\nsleep 45\n' > "$T/$ok10"; chmod +x "$T/$ok10"
  "$T/$ok10" >/dev/null 2>&1 & om=$!; pids="$pids $om"
  : > "$T/pidfile10"
  sleep 0.3
  old=$(g Bash '{"command":"pkill --older 3600"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  pf=$(g Bash "{\"command\":\"pkill -F $T/pidfile10\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  qv=$(g Bash '{"command":"pkill -q 7"}' "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  # …and `-O`, --older's short spelling, which was the one still open: with 3600 read as the pattern the -u
  # behind it never reached the fence, so this selected every process of that uid and matched none of them.
  sho=$(g Bash "{\"command\":\"pkill -O 3600 -u $(id -u)\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  keep=$(g Bash "{\"command\":\"pkill --older 3600 -f $ok10\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  shk=$(g Bash "{\"command\":\"pkill -O 3600 -f $ok10\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  if [ "$old" = 2 ] && [ "$pf" = 2 ] && [ "$qv" = 2 ] && [ "$sho" = 2 ] && [ "$keep" = 0 ] && [ "$shk" = 0 ] \
     && kill -0 "$om" 2>/dev/null; then r=0; else r=1; fi
  ok "an option's value is not a pattern however it is spelled: --older, its short -O, -F and -q consume theirs and are refused for naming no process, while the same option carrying a pattern still resolves it" $r

  # 10b. …AND WHAT A LETTER MEANS DEPENDS ON THE VERB. One parser serves pgrep, pkill and killall, and they
  #      disagree about the same short option: `-o` is --oldest (a FLAG) to pkill and --older-than TIME (a
  #      VALUE) to killall, `-n` is --newest against --ns PID. Read as pkill's, killall's value became the
  #      pattern — `killall --older-than 1h claude` reduced to pat=1h, `pgrep -x -- 1h` found nothing, the
  #      fence had nothing to refuse and it went through, killing every claude over an hour old: this
  #      worker's own claude -p and its loop runner (review of #193). Its own claude stand-in, started here
  #      rather than borrowed from case 9, so this row cannot pass on a process another case left running.
  ASKS=$T/asks10b; CALLS=$T/calls10b; : > "$CALLS"; GERR=$T/err10b
  # …and it carries a mark that is in its COMMAND LINE and not in its name, which is what tells a walk that
  # kept `-f` from one that ate it: `pgrep -f -- <mark>` finds this process, plain `pgrep -- <mark>` does not.
  mk=mark10b$$
  "$T/claude" -p "$mk" >/dev/null 2>&1 & kc=$!; pids="$pids $kc"
  # …and a second stand-in that is nothing but its own name, for the rows that must stay ALLOWED: it has to
  # resolve to a process this case started, so "allowed" means the fence ran and judged it, not that the
  # pattern matched nothing. Its own, not case 10's — a row that reads another case's fixture passes on
  # whatever that case happened to leave running.
  own=own10b$$
  printf '#!/bin/sh\nsleep 45\n' > "$T/$own"; chmod +x "$T/$own"
  "$T/$own" >/dev/null 2>&1 & ko=$!; pids="$pids $ko"
  sleep 0.3
  k(){ : > "$GERR"; g Bash "{\"command\":\"$1\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$; }
  r=0
  # The incident itself: the value is consumed, so the NAME behind it is what reaches the fence. What is
  # asserted is the pattern the refusal NAMES — `(killall claude)`, not `(killall 1h)` — because WHICH pid
  # it stops at, and so whether the reason reads "session or a loop runner" or "outside this worker's own
  # process subtree", depends on what else is running on the box; the resolved pattern does not.
  [ "$(k "killall --older-than 1h claude")" = 2 ] && grep -qF '(killall claude)' "$GERR" \
    || { r=1; echo "      killall --older-than 1h claude: refused for: $(head -c 60 "$GERR")"; }
  # …and the same command with nothing left to name: no pattern at all, which is the other refusal.
  while read -r sel; do
    [ "$(k "killall $sel")" = 2 ] && grep -qF 'selector but no pattern' "$GERR" \
      || { r=1; echo "      killall $sel: refused for: $(head -c 60 "$GERR")"; }
  done <<'K10B'
--older-than 1h
-o 1h
-y 1h
-n 1234
-Z ctx
K10B
  # THE HALF THAT MUST NOT MOVE, and the reason the verb is passed in rather than the options merged: to
  # pkill those same letters are flags, so merging would eat the word after them. `pkill -o <pattern>` would
  # reduce to no pattern and be refused, and worse, `pgrep -o -f <x>` would lose its -f and resolve without
  # --full — fewer processes found, nothing fenced, a refusal turned into a pass.
  for flag in -o -n; do
    { [ "$(k "pkill $flag $own")" = 0 ] && kill -0 "$ko" 2>/dev/null; } \
      || { r=1; echo "      pkill $flag <own child> was refused: $(head -c 60 "$GERR")"; }
  done
  # …and this is that harm, made to show: the mark is findable only with --full, so a walk that ate the `-f`
  # resolves nothing, fences nothing and lets the kill through. It must stay REFUSED.
  [ "$(k "pgrep -o -f $mk | xargs kill -9")" = 2 ] \
    || { r=1; echo "      pgrep -o -f <a claude -p> | xargs kill was allowed through"; }
  { kill -0 "$kc" 2>/dev/null && kill -0 "$ko" 2>/dev/null; } || { r=1; echo "      a stand-in did not survive the case"; }
  ok "a short option means what its own verb says: killall's -o/-y/-n/-Z take a value, so the name behind them still reaches the fence, while pkill's -o/-n stay flags and the pattern after them is still resolved" $r

  # 11. A WRAPPER WORD IS NOT A WAY PAST A GATE, AND THE ANCHOR IS ONE VARIABLE. `$AT` knew a fixed set of
  #     wrappers, so any word outside it hid the command behind it — and $AT is interpolated into every rule
  #     this file has, so that was ONE hole in all of them and not a hole in two. Measured 2026-09-02:
  #     `pkill -f claude` refused and `timeout 5 pkill -f claude` allowed; `tmux kill-server` refused and
  #     `setsid tmux kill-server` allowed — the shared tmux server every session on this box runs inside,
  #     from any session, by prefixing one word. So the table below is one row per rule FAMILY, each in a
  #     wrapper $AT never knew, and each must be REFUSED. Its own fixture: its own asks dir, its own call log,
  #     and the handoff row its own empty record dir. The tiers: un = no role and no marker at all, which is
  #     what makes the tmux rows the universal gate rather than a worker one.
  ASKS=$T/asks11; CALLS=$T/calls11; : > "$CALLS"; mkdir -p "$T/hd11"; GERR=$T/err11
  r=0
  # Each row asserts the REASON as well as rc 2, because rc 2 alone would stay green if some neighbouring rule
  # happened to refuse the row — and the claim here is that the wrapped command reached ITS OWN rule.
  while IFS='|' read -r fam tier why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"                                        # …and no row may pass on the reason a previous one left
    case "$tier" in
      un) got=$(g Bash "{\"command\":\"$what\"}" "$T");;
      hg) got=$(g Bash "{\"command\":\"$what\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$ CC_HANDOFF=h11 CC_HANDOFF_DIR="$T/hd11");;
      mb) got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/_cctest1" CC_ROLE=member CC_GUARD_ROOT_PID=$$);;
      *)  got=$(g Bash "{\"command\":\"$what\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$);;
    esac
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 60 "$GERR")"; }
  done <<W11
tmux, the universal gate|un|shared tmux server|timeout 5 tmux kill-server
tmux, a pathed wrapper|un|shared tmux server|/usr/bin/setsid tmux kill-server
tmux, a shell keyword|un|shared tmux server|! nice -n 5 tmux kill-server
tmux, systemd-run|un|shared tmux server|systemd-run --user tmux kill-session
tmux, an interpreter running its quoted string|un|shared tmux server|bash -c 'timeout 5 tmux kill-server'
an option that runs its value, spelled as two tokens|un|shared tmux server|man -P 'tmux kill-server' ls
…and the same option spelled --opt=VALUE|un|shared tmux server|sort --compress-program='tmux kill-server'
a search tool with an option that runs a word|un|shared tmux server|rg --pre 'tmux kill-server' x
…the same one, attached|un|shared tmux server|rg --pre='tmux kill-server' x
…and its two neighbours, one option shape each|wt|landing a change|ag --pager cc-land x
…attached|wt|landing a change|ack --pager=cc-land x
a downloader that runs an option's value|wt|landing a change|wget --use-askpass=cc-land http://x
--opt=VALUE whose value is one bare word|wt|landing a change|sort --compress-program=cc-land
a key=value carried in an option's own token|un|shared tmux server|git -c core.pager='tmux kill-server' log
merge|wt|merging a PR|nice -n 5 gh pr merge 3
land|wt|landing a change|stdbuf -o0 cc-land 7
deploy|wt|deploying.|ionice vercel deploy --prod
public github comms|wt|public GitHub comms|chrt -f 1 gh issue create -t x
raw gh api|wt|raw gh api call|taskset -c 0 gh api /user
email|wt|sending email|flock /tmp/l11 mail -s x owner@example.com
the owner's slack link|wt|cc slack off|watch cc slack off
posting as the owner|wt|posting to the owner's Slack|torify cc-slack post -c #x hi
a wrapper onto the same inject door|wt|posting to the owner's Slack|torify cc-broker inject planner hi
the ledger door onto that same path|mb|posting to the owner's Slack|cc-broker ledger planner hi
the document upload onto that same door|wt|posting to the owner's Slack|nohup cc-arch landed myrepo
the publish that gives it its turn|wt|publishing the box's code outward|nice -n 5 cc-publish
…and with a message of its own|mb|publishing the box's code outward|cc-publish -m 'x'
a TAB where the rule spelled a space|wt|posting to the owner's Slack|cc-slack\tpost -c #x hi
…and a tab in front of the command too|wt|posting to the owner's Slack|\tcc-broker\tinject planner hi
write path, over the ledger of what was sent outward|wt|writing into the box's live tree|cp /tmp/x11 $H/.cc/state/arch/myrepo.posted
…and a redirect into the same directory|wt|writing into the box's live tree|echo x > $H/.cc/state/arch/myrepo.cursor
…and DELETING it, which suppresses a revision instead of repeating one|wt|removing the record of what has already been sent outward|rm $H/.cc/state/arch/myrepo.cursor
…the whole directory at once|wt|removing the record of what has already been sent outward|rm -rf $H/.cc/state/arch
…or moving it out of the way|wt|removing the record of what has already been sent outward|mv $H/.cc/state/arch/myrepo.posted /tmp/x11
…or emptying it in place|wt|removing the record of what has already been sent outward|truncate -s 0 $H/.cc/state/arch/myrepo.posted
…or unlinking it by name|mb|removing the record of what has already been sent outward|unlink $H/.cc/state/arch/myrepo.posted
…or sweeping it with find|wt|removing the record of what has already been sent outward|find $H/.cc/state/arch -name '*.posted' -delete
a glob ABOVE the fenced name still reaches it|wt|removing the record of what has already been sent outward|rm $H/.cc/state/ar*/myrepo.cursor
…over the directory's own name|wt|removing the record of what has already been sent outward|rm -rf $H/.cc/state/ar*
…and a level above it|wt|removing the record of what has already been sent outward|rm -rf $H/.cc/state/*
the same glob, on the write fence|wt|writing into the box's live tree|cp /tmp/x11 $H/b*/cc-guard
sudo|wt|sudo / host changes|unbuffer sudo id
host/network/service|wt|host/network/service changes|doas systemctl restart nginx
container runtime|wt|running a container|runuser -u nobody docker run -v /:/host alpine
container runtime, compose|wt|running a container|timeout 5 docker-compose up -d
the kill fence|wt|outside this worker's own process subtree|timeout 5 kill -9 1
the kill fence, a wrapped pkill|wt|selector but no pattern|ionice pkill -u 1000
the kill fence, stdbuf|wt|outside this worker's own process subtree|stdbuf -o0 kill -9 1
the box's credentials|wt|reading the box's credentials|timeout 5 cat $H/ccbox/env
write path, a copy into ~/bin|wt|writing into the box's live tree|nice -n 5 cp /tmp/x11 $H/bin/cc-guard
write path, git -C the live tree|wt|writing into the box's live tree|setsid git -C $H/dev/myrepo checkout .
a non-live handoff|hg|NON-LIVE side of an overlapping handoff|timeout 5 cc done
member dispatch|mb|does not dispatch workers (cc --go)|nice -n 5 cc myrepo t11 --go
member dispatch, cc-loop|mb|does not dispatch workers (cc-loop)|stdbuf -o0 cc-loop myrepo t11
member, a headless claude|mb|a headless claude spends the owner's budget|timeout 5 claude -p hello
member, the box's config|mb|the box's config is not a member's to read|ionice cc-config get slack
member, the box's secrets|mb|reading the box's secrets|watch cat /home/demo/.cc/config
a quoted message whose FIRST word is gated|wt|landing a change|git commit -m 'cc-land runs twice'
…and through the universal gate as well|un|shared tmux server|git commit -m 'tmux kill-server is banned'
su -c, where the quoted interior IS the command|un|shared tmux server|su -c 'tmux kill-server'
su -c, with a wrapper inside the quotes too|un|shared tmux server|su -c 'timeout 5 tmux kill-server'
W11
  # …and the same option behind a pipe, which the table above cannot carry: `|` is its field separator.
  : > "$GERR"; got=$(g Bash "{\"command\":\"echo x | split --filter='tmux kill-server' -\"}" "$T")
  { [ "$got" = 2 ] && grep -qF 'shared tmux server' "$GERR"; } \
    || { r=1; echo "      an --opt=VALUE after a pipe: rc $got, refused for: $(head -c 60 "$GERR")"; }
  # …AND THE OTHER HALF, which is what the walk costs: it stops at a head that cannot run a later token, so a
  # command that merely NAMES one of the words above is still allowed. `echo` and `grep` are the two that
  # matter — quoting a forbidden command is how a brief, a board note and this file's own cases get written.
  # NOT here, though it was: a regex alternation naming two gated commands (`grep -E 'cc-land|gh pr merge' …`)
  # is REFUSED, escaped or quoted, because the as-typed line still carries a raw `|` for $AT to anchor on.
  # That is true on main as well — measured both ways — so it is not this change's to assert either way.
  while IFS='|' read -r fam tier what; do
    [ -n "$fam" ] || continue
    got=$(g Bash "{\"command\":\"$what\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
    [ "$got" = 0 ] || { r=1; echo "      refused but should not be ($fam): $what"; }
  done <<W11B
naming a command is not running it|wt|echo timeout 5 sudo systemctl restart nginx
grepping for one is not either|wt|grep -rn sudo core/bin
an ordinary wrapped command|wt|timeout 5 ls -la /tmp
an ordinary read|wt|nice -n 5 cat /tmp/x11
a directory named docker is not the runtime|wt|for f in docker/Dockerfile docker/entrypoint; do echo x; done
the same cc done, with no handoff to gate it|wt|timeout 5 cc done
a commit message naming a command MID-SENTENCE|wt|git commit -m 'no cp into ~/bin'
a board note naming one mid-sentence|wt|cc board note myrepo t11 'do not cc-land this yourself'
the broker named without its subcommand|wt|cc board note myrepo t11 'cc-broker holds the nags for 12 min'
reading the overview's own state is not sending it|wt|cc-arch marked myrepo 7
asking the publisher a question is not publishing|wt|cc-publish status
…nor is rehearsing one|wt|cc-publish --dry-run
the rest of a track's own state dir is still its own|wt|cp /tmp/x11 $H/.cc/state/scratch11
…and it may still DELETE its own state, and read the fenced dir|wt|rm $H/.cc/state/scratch11 && ls $H/.cc/state/arch
a bare find over the fenced dir reads and removes nothing|wt|find $H/.cc/state/arch -name '*.cursor'
a glob inside the track's own state dir names nothing fenced|wt|rm $H/.cc/state/scratch11/x*
…nor does one beside it, or one in the temp root|wt|rm $H/.cc/state/s* /tmp/x11*
an attached value that is a path and not a command|wt|./configure --prefix=/usr/local --with-x=no
a make variable|wt|make CC=gcc PREFIX=/tmp/x11 -j4
an attached value that is a dull command|wt|git -c core.pager=cat log --oneline
W11B
  # …and the box's OWN use of that ledger door still works. cc-pulse writes a held tick there from a systemd
  # timer, which carries no role, so the rule that refuses it to a worker and a member must not cost the timer
  # anything. Ungated tier, the real call shape.
  : > "$GERR"
  got=$(g Bash "{\"command\":\"cc-broker ledger --once beta 'pulse: 1 row in flight'\"}" "$T")
  [ "$got" = 0 ] || { r=1; echo "      the pulse's own ledger write was refused at the ungated tier: rc $got"; }
  # …and the two bounds the walk carries, which fail OPEN on purpose. Before them one statement of 3000 words
  # — `for f in <3000 paths>` — cost 27 seconds inside a PreToolUse hook; the answer must arrive, and a long
  # argument list must not be refused for being long. 10s against a measured 0.6s: this catches a hang, not a
  # slow box.
  big=$(printf myprog; i=0; while [ $i -lt 3000 ]; do printf ' arg%d' $i; i=$((i+1)); done)
  t0=$SECONDS
  got=$(g Bash "{\"command\":\"$big\"}" "$WT" CC_ROLE=worker CC_GUARD_ROOT_PID=$$)
  { [ "$got" = 0 ] && [ $((SECONDS - t0)) -lt 10 ]; } \
    || { r=1; echo "      a 3000-word statement was refused or took $((SECONDS - t0))s (rc $got)"; }
  # …and the bounds are PER STATEMENT, which is the difference between a bound and a bypass. Spent across the
  # whole command, that same long statement in FRONT of a wrapped stop used up the budget and the stop was
  # never walked — rc 0 through the universal gate, measured (review of #193). Same statement, same wrapper,
  # ungated tier: it must still be refused, and by the tmux gate itself.
  : > "$GERR"
  got=$(g Bash "{\"command\":\"$big; do :; done; timeout 5 tmux kill-server\"}" "$T")
  { [ "$got" = 2 ] && grep -qF 'shared tmux server' "$GERR"; } \
    || { r=1; echo "      a long statement in front of a wrapped stop: rc $got, refused for: $(head -c 60 "$GERR")"; }
  ok "a wrapper word in front of a command reaches the same rule the bare command does — every rule family, in wrappers \$AT never knew — while naming one of those commands still does not run it, and the box's own ungated callers still run what a gated role is refused" $r

  # 11. THE SEALED-SESSION SETTINGS COPY IS THE SAME SECRET AS THE FILE IT COPIES. cc-sandbox writes
  #     ~/.cc/sandbox/<repo|handle>/<track|_workspace>/settings.json — his ~/.claude/settings.json plus a permission
  #     baseline, so it carries the same hook registrations and deny rules — and the sandbox is opt-in, so a gated
  #     session on the HOST could read the copy while the original was refused. Both doors, because gating one is
  #     theatre: `cat` and the file-reading tools alike.
  #     THE OTHER SIDE, and it is deliberate: role=worker is NOT refused, because a worker is not refused the
  #     ORIGINAL either (~/.claude/settings.json is on the member-only list, secret_path, not on secret_all). The
  #     copy gets the tier of what it copies. Making it stricter than its own source would be a new asymmetry, not
  #     a fix — and that pair is the last two assertions here.
  #     The Bash half is spelled `~/…` because that rule is a TEXT rule and `~`, `$HOME` and /home/<user> are the
  #     spellings it reads — the same honest ceiling as every other line here, and the reason the file-tool half
  #     (which realpaths) is asserted beside it rather than instead of it.
  ASKS=$T/asks11; CALLS=$T/calls11; : > "$CALLS"
  cp11=$H/.cc/sandbox/alice/_workspace/settings.json
  mkdir -p "$(dirname "$cp11")" "$H/.claude"; printf '{"hooks":{}}\n' > "$cp11"; printf '{"hooks":{}}\n' > "$H/.claude/settings.json"
  mbash=$(g Bash '{"command":"cat ~/.cc/sandbox/alice/_workspace/settings.json"}' "$H/dev/alice")
  obash=$(g Bash '{"command":"cat ~/.claude/settings.json"}' "$H/dev/alice")
  mread=$(g Read "{\"file_path\":\"$cp11\"}" "$H/dev/alice")
  morig=$(g Read "{\"file_path\":\"$H/.claude/settings.json\"}" "$H/dev/alice")
  wcopy=$(g Read "{\"file_path\":\"$cp11\"}" "$WT" CC_ROLE=worker)
  worig=$(g Read "{\"file_path\":\"$H/.claude/settings.json\"}" "$WT" CC_ROLE=worker)
  if [ "$mbash" = 2 ] && [ "$obash" = 2 ] && [ "$mread" = 2 ] && [ "$morig" = 2 ] && [ "$wcopy" = 0 ] && [ "$worig" = 0 ]; then r=0; else r=1; fi
  ok "the sealed-session settings copy under ~/.cc/sandbox is the same secret as ~/.claude/settings.json — refused to a member through Bash and the file tools alike, and left at the tier of its own source for a worker, which is not refused either one" $r

  # 12. A SESSION'S OWN NOTES ARE NOT SOMEBODY ELSE'S TREE. Claude saves them under ~/.claude/projects/<slug of
  #     the project root>/memory and both sandboxes bind that dir rw, but the write-path rule refused every one
  #     of them — and from a member-facing session each refusal went out as a 🔐 line: three files in one call,
  #     six posts in a member's channel (2026-09-04). Own notes are written, another project's are still refused,
  #     and a write outside the tree records NO query (it is the session's own to fix). What the member DID ask for
  #     still records one — the last assertions, which are the half of this that must not move.
  ASKS=$T/asks12; CALLS=$T/calls12; : > "$CALLS"
  if [ -z "$T2" ]; then r=1; echo "      no fixture home outside /tmp: these rules wave /tmp through, so nothing here would be gated"
  else
    H2=$T2/home; WT2=$H2/.cc/worktrees/demo/t1   # $GH hands g this home; $H is under /tmp and every path in it is scratch
    mkdir -p "$H2/bin" "$H2/dev/alice/.cc" "$WT2/.cc"; : > "$H2/dev/alice/.cc/member-facing"; : > "$WT2/.cc/track"
    cp "$H/bin/cc-notify" "$H/bin/cc-slack" "$H2/bin/"; QS2=$H2/.cc/state/alice/queries.spool; rm -f "$QS2"
    amem=$H2/.claude/projects/$(printf '%s' "$H2/dev/alice" | tr '/.' '--')/memory
    wmem=$H2/.claude/projects/$(printf '%s' "$H2/dev/demo" | tr '/.' '--')/memory
    mown=$(GH=$H2 g Write "{\"file_path\":\"$amem/MEMORY.md\"}" "$H2/dev/alice")
    mother=$(GH=$H2 g Write "{\"file_path\":\"$H2/.claude/projects/-home-someone-else/memory/MEMORY.md\"}" "$H2/dev/alice")
    mout=$(GH=$H2 g Edit "{\"file_path\":\"$H2/dev/alice-other/x.md\"}" "$H2/dev/alice")
    wown=$(GH=$H2 g Write "{\"file_path\":\"$wmem/MEMORY.md\"}" "$WT2" CC_ROLE=worker)
    quietq=$([ -s "$QS2" ] && echo dirty || echo clean)   # the two refused writes above must record NO query
    rc=$(GH=$H2 g Bash '{"command":"cc-land 7"}' "$H2/dev/alice")
    if [ "$mown" = 0 ] && [ "$mother" = 2 ] && [ "$mout" = 2 ] && [ "$wown" = 0 ] \
       && [ ! -s "$CALLS" ] && [ "$quietq" = clean ] && [ "$rc" = 2 ] && [ "$(wc -l < "$QS2")" = 1 ]; then r=0; else r=1; fi
  fi
  ok "a member and a worker write their own auto-memory notes, are still refused another project's notes and anything else outside their tree, none of those refusals records a query — while what the member asked for still does" $r

  # 13. THE SAME REFUSAL ABOUT A DIFFERENT PATH IS ONE QUERY. Every reason names what it refused, so keying on the
  #     whole reason made a session working through a list record a query per file; the path is dropped from the key.
  ASKS=$T/asks13; CALLS=$T/calls13; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  s1=$(g Read "{\"file_path\":\"$H/.cc/config\"}" "$H/dev/alice")
  s2=$(g Read "{\"file_path\":\"$H/.ssh/id_ed25519\"}" "$H/dev/alice")
  if [ "$s1" = 2 ] && [ "$s2" = 2 ] && [ "$(wc -l < "$QS")" = 1 ]; then r=0; else r=1; fi
  ok "two paths refused by the same rule record one query, not one each" $r

  # 14. DIFFERENT REFUSALS ARE DIFFERENT QUERIES, parentheses or not: only a PATH in parentheses leaves the key.
  #     Landing and dispatching both carry a parenthetical, and neither is a path.
  ASKS=$T/asks14; CALLS=$T/calls14; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  s1=$(g Bash '{"command":"cc-land 7"}' "$H/dev/alice")
  s2=$(g Bash '{"command":"cc alice t9 --go"}' "$H/dev/alice")
  if [ "$s1" = 2 ] && [ "$s2" = 2 ] && [ "$(wc -l < "$QS")" = 2 ]; then r=0; else r=1; fi
  ok "two different refusals, each with a parenthetical, are two queries — only a path in parentheses leaves the key" $r

  # 15. A REPO NAMED IN PROSE IS NOT A REPO CREATED. 2026-09-04 a member workspace session was refused "creating
  #     outside <its workspace>" for a heredoc/echo whose body only DESCRIBED a new repo — two blocked calls before
  #     it gave up and switched tools. A note or a plan may name another repo, a ';' or a substitution in it and all:
  #     inert inside quotes, exactly as a real shell reads them. What is still refused is a REAL dispatch or create
  #     of another repo, and the workspace's own dispatch still runs — the fence itself does not move.
  ASKS=$T/asks15; CALLS=$T/calls15; : > "$CALLS"
  mkdir -p "$H/dev/ws1/.cc" "$H/.cc/state/ws1"; : > "$H/dev/ws1/.cc/member-facing"; : > "$H/dev/ws1/.cc/member-workspace"
  p1=$(g Bash '{"command":"cat > plan.md <<EOF\nnew repo other; run cc other t1 --go and cc board add other x\nEOF"}' "$H/dev/ws1" CC_ROLE=member)
  p2=$(g Bash "{\"command\":\"echo 'step one; then cc other t1 --go' >> plan.md\"}" "$H/dev/ws1" CC_ROLE=member)
  d1=$(g Bash '{"command":"cc other t1 --go"}' "$H/dev/ws1" CC_ROLE=member)
  d2=$(g Bash '{"command":"cc board add other t1"}' "$H/dev/ws1" CC_ROLE=member)
  own=$(g Bash '{"command":"cc ws1 t1 --go"}' "$H/dev/ws1" CC_ROLE=member)
  if [ "$p1" = 0 ] && [ "$p2" = 0 ] && [ "$d1" = 2 ] && [ "$d2" = 2 ] && [ "$own" = 0 ]; then r=0; else r=1; fi
  ok "a member workspace passes a heredoc or echo that only NAMES another repo (a ';' inside quotes is prose), still refuses a real dispatch or create of one, and still runs its own" $r

  # 15b. A REDIRECTION AFTER `cc done`/`cc handoff` IS NOT A REPO NAME. 2026-09-10 a workspace session's own
  #      `cc done --help 2>&1 | head` was refused as "creating outside" its workspace: the repo scan stops at the
  #      `&` of `2>&1` and read the leftover `2>` as a repo. A redirection is skipped; a real other-repo name
  #      after the same verb, redirection or not, is still refused; the workspace's own still runs.
  ASKS=$T/asks15b; CALLS=$T/calls15b; : > "$CALLS"
  h1=$(g Bash '{"command":"cd ~/.cc/worktrees/ws1/t1; cc done --help 2>&1 | head -30; cc-context 2>&1 | tail -3"}' "$H/dev/ws1" CC_ROLE=member)
  h2=$(g Bash '{"command":"cc handoff 2>/dev/null | head"}' "$H/dev/ws1" CC_ROLE=member)
  o1=$(g Bash '{"command":"cc done other 2>&1 | head"}' "$H/dev/ws1" CC_ROLE=member)
  o2=$(g Bash '{"command":"cc done 2>&1 other | head"}' "$H/dev/ws1" CC_ROLE=member)
  own=$(g Bash '{"command":"cc done ws1 2>&1 | head"}' "$H/dev/ws1" CC_ROLE=member)
  if [ "$h1" = 0 ] && [ "$h2" = 0 ] && [ "$o1" = 2 ] && [ "$o2" = 2 ] && [ "$own" = 0 ]; then r=0; else r=1; fi
  ok "a member workspace's \`cc done --help 2>&1 | head\` runs (a redirection is not a repo name), another repo after the same verb is still refused, and its own still runs" $r

  # 16. A PATH NAMED IN PROSE IS NOT A PATH WRITTEN. The same fix, for the write fence: a worker's note may DESCRIBE
  #     a copy or a redirect into the box's live tree — the ';' and the '>' inside the quotes cannot split or
  #     redirect anything — while a REAL copy or redirect into ~/bin is still refused.
  ASKS=$T/asks16; CALLS=$T/calls16; : > "$CALLS"
  q1=$(g Bash "{\"command\":\"echo 'plan: cp a ~/bin/b; then echo x > ~/bin/c' >> notes.md\"}" "$WT" CC_ROLE=worker)
  q2=$(g Bash '{"command":"cat > notes.md <<EOF\ndo not cp into ~/bin or redirect > ~/bin\nEOF"}' "$WT" CC_ROLE=worker)
  w1=$(g Bash '{"command":"cp /tmp/x ~/bin/b"}' "$WT" CC_ROLE=worker)
  w2=$(g Bash '{"command":"echo x > ~/bin/c"}' "$WT" CC_ROLE=worker)
  if [ "$q1" = 0 ] && [ "$q2" = 0 ] && [ "$w1" = 2 ] && [ "$w2" = 2 ]; then r=0; else r=1; fi
  ok "a worker passes a note that only NAMES a write into the live tree (a ';' or '>' inside quotes is prose), and still refuses a real copy or redirect into ~/bin" $r

  # 17. …AND PROSE-BLANKING NEVER HIDES A REAL COMMAND (reviews of #243). Every way early cuts of flatln
  #     let one through, each REFUSED again and by its own rule: an interpreter string whose second statement is the
  #     command (only the raw line puts it in command position — the quote-blind rescan emits suffixes alone); an
  #     escaped or shell-spliced apostrophe, which opened a quote the shell never opened and blanked the real
  #     separator or redirect behind it; and an unbalanced ) — a case pattern is the ordinary one — which ended the
  #     substitution early and dropped the real command behind it back into blanked prose (landing review of #243).
  #     Each row is JSON-escaped: \\' reaches the guard as \' and \" as ".
  ASKS=$T/asks17; CALLS=$T/calls17; : > "$CALLS"; GERR=$T/err17
  mkdir -p "$H/dev/ws1/.cc" "$H/.cc/state/ws1"; : > "$H/dev/ws1/.cc/member-facing"; : > "$H/dev/ws1/.cc/member-workspace"
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W17'
an interpreter string with a second statement|dispatching outside|bash -c \"x; cc other t1 --go\"
an escaped quote before a real separator|dispatching outside|echo \\' ; cc other t1 --go
a shell-spliced apostrophe before a real separator|dispatching outside|echo 'don'\\''t'; cc other t1 --go
an escaped quote before a real redirect|writing into the box's live tree|echo \\' > ~/bin/pwn
a substitution inside double quotes, with a second statement|dispatching outside|echo \"$(true; cc other t1 --go)\"
a substitution inside double quotes, with a redirect|writing into the box's live tree|echo \"$(date > ~/bin/pwn)\"
an escaped double quote that must not close the string|dispatching outside|git commit -m \"a\\\"b\" ; cc other t1 --go \\\"
a case pattern's ) does not end the substitution|dispatching outside|echo \"$(case a in a) cc other t1 --go;; esac)\"
…nor does it put the rest of the substitution back in prose|dispatching outside|echo \"$(case a in a) x;; esac; cc other t1 --go)\"
…and the same shape does not hide a write either|writing into the box's live tree|echo \"$(case a in a) cp x ~/bin/y;; esac)\"
a nested substitution and $(( )) arithmetic are inside that same tail|dispatching outside|echo \"$(echo $(( 1 )) ; cc other t1 --go)\"
W17
  ok "blanking metacharacters inside quotes never hides a real command: an interpreter's second statement, a separator or redirect behind an escaped or spliced apostrophe, and a command behind a case pattern's unbalanced ) are each still refused by their own rule" $r

  # 18. A HUGE REFUSED COMMAND LEAVES A BOUNDED RECORD. cc-msg discards a whole queries.spool over 1 MB as a plant
  #     and pages the owner about it, so one refused command carrying a big heredoc body used to take every query
  #     queued in that file down with it, unread (landing review of #243). The record is cut, and says it was cut.
  ASKS=$T/asks18; CALLS=$T/calls18; : > "$CALLS"; QS=$H/.cc/state/alice/queries.spool; rm -f "$QS"
  # built INSIDE jq: a body this big as one argv word is near MAX_ARG_STRLEN, a limit of exec and not of this rule
  bigin=$(jq -cn '{command: ("cat > plan.md <<EOF\n" + ("x" * 100000) + "\nEOF\ngh pr merge 1")}')
  rc=$(g Bash "$bigin" "$H/dev/alice")
  if [ "$rc" = 2 ] && [ "$(wc -l < "$QS" 2>/dev/null)" = 1 ] && [ "$(wc -c < "$QS")" -lt 6000 ] \
     && jq -e 'select((.command|startswith("cat > plan.md")) and (.command|endswith("…(cut)")))' "$QS" >/dev/null 2>&1; then r=0; else r=1; fi
  ok "a refusal carrying a 100 KB heredoc body records ONE bounded query that says it was cut, so the spool never grows past what cc-msg will read" $r

  # 19. A SESSION GATED BY $CC_ROLE ALONE STILL PRODUCES A QUERY. With no marker there is no workspace to name, and
  #     record_query returned before writing anything: the refusal reached nobody but the session's own stderr, which
  #     is the one thing this file says must not happen (landing review of #243). It spools under the reserved
  #     "_nomarker" key instead — an ordinary query to the host, so it is said in the queries channel and delivered
  #     like any other (cc-msg's selfcheck asserts that half). Still nothing from the guard itself: no post, no page.
  ASKS=$T/asks19; CALLS=$T/calls19; : > "$CALLS"; QSN=$H/.cc/state/_nomarker/queries.spool; rm -f "$QSN"
  rc=$(g Bash '{"command":"gh pr merge 1"}' "$H" CC_ROLE=member)
  if [ "$rc" = 2 ] && [ ! -s "$CALLS" ] && [ "$(wc -l < "$QSN" 2>/dev/null)" = 1 ] \
     && jq -e 'select(.workspace=="_nomarker" and .class=="page" and (.command|test("gh pr merge")))' "$QSN" >/dev/null 2>&1; then r=0; else r=1; fi
  ok "a member gated by \$CC_ROLE alone, with no marker to name a workspace, still records its refusal — under the reserved key the host drains" $r

  # 20. A BACKSLASH IN FRONT OF A NAME IS NOT A DIFFERENT COMMAND. `\cc other t1 --go` runs cc — the shell drops
  #     the backslash and only skips alias lookup — but every rule reads a NAME at ^, so one character in front of
  #     it (or inside it: `c\c`) turned the whole gate list off, cc-land, gh pr merge and docker included
  #     (adversarial review of #243). The same escape hid an interpreter's argument: `awk "BEGIN{system(\"…\")}"`
  #     passed where the single-quoted spelling was refused. Rows are JSON-escaped: \\ reaches the guard as \.
  ASKS=$T/asks20; CALLS=$T/calls20; : > "$CALLS"; GERR=$T/err20
  mkdir -p "$H/dev/ws1/.cc" "$H/.cc/state/ws1"; : > "$H/dev/ws1/.cc/member-facing"; : > "$H/dev/ws1/.cc/member-workspace"
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W20'
a dispatch behind a backslash|dispatching outside|\\cc other t1 --go
landing behind a backslash|landing a change|\\cc-land 7
the loop runner behind a backslash|dispatching with cc-loop|\\cc-loop ws1 t1
a merge behind a backslash|merging a PR|\\gh pr merge 1
a container behind a backslash|running a container|\\docker run -v /:/host alpine
a backslash INSIDE the name|dispatching outside|c\\c other t1 --go
an interpreter's DOUBLE-quoted argument|dispatching outside|awk \"BEGIN{system(\\\"cc other t1 --go\\\")}\"
…and its single-quoted spelling, which already was|dispatching outside|awk 'BEGIN{system(\"cc other t1 --go\")}'
W20
  ok "a backslash-escaped command name reaches the same rule the bare one does — in front of it or inside it — and an interpreter's double-quoted argument is read like its single-quoted spelling" $r

  # 21. A RELATIVE TARGET LANDS WHERE THE LINE HAS GOT TO. Every write target was resolved against the payload's
  #     cwd, so a `cd` earlier on the same line moved the write and the fence never saw it: `cd ~/dev/other &&
  #     echo pwn > f` and `cd ~/bin && cp /dev/null pwn` both passed (adversarial review of #243). The cd is
  #     tracked along the line; one that cannot be resolved makes a later relative target a refusal, not a guess.
  #     The half that must not move is the last row: inside its own tree a member still writes what it likes.
  ASKS=$T/asks21; CALLS=$T/calls21; : > "$CALLS"; GERR=$T/err21
  r=0
  : > "$GERR"; c1=$(g Bash "{\"command\":\"cd $H/dev/other && echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$c1" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
    || { r=1; echo "      a redirect after a cd into another repo: rc $c1, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; c2=$(g Bash "{\"command\":\"cd $H/bin && cp /dev/null pwn\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$c2" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
    || { r=1; echo "      a cp after a cd into ~/bin: rc $c2, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; c3=$(g Bash '{"command":"cd $D && echo x > f"}' "$H/dev/ws1" CC_ROLE=member)
  { [ "$c3" = 2 ] && grep -qF "cannot resolve" "$GERR"; } \
    || { r=1; echo "      a redirect after a cd this cannot resolve: rc $c3, refused for: $(head -c 70 "$GERR")"; }
  c4=$(g Bash '{"command":"cd sub && echo x > f"}' "$H/dev/ws1" CC_ROLE=member)
  [ "$c4" = 0 ] || { r=1; echo "      a cd and a write INSIDE its own tree was refused (rc $c4)"; }
  #     A DESTINATION THAT IS A SUBSTITUTION IS c3 ALL OVER AGAIN, and it was the one spelling that passed: the
  #     piece `cd $(` emptied the base correctly and then opened a subshell entry on the SAME piece, so the `)`
  #     closing the substitution handed the pre-cd base back and the write was judged in the session's own tree
  #     (8th adversarial review of #243). The `$( )` and backtick spellings must land where `cd $D` does.
  : > "$GERR"; c5=$(g Bash "{\"command\":\"cd \$(echo $H/dev/other) && echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$c5" = 2 ] && grep -qF "cannot resolve" "$GERR"; } \
    || { r=1; echo "      a redirect after a cd into a substitution: rc $c5, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; c6=$(g Bash "{\"command\":\"cd \`echo $H/dev/other\` && echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$c6" = 2 ] && grep -qF "cannot resolve" "$GERR"; } \
    || { r=1; echo "      the backtick spelling of that cd: rc $c6, refused for: $(head -c 70 "$GERR")"; }
  ok "a write is judged where a \`cd\` on the same line puts it — into another repo or ~/bin it is refused, after a cd this cannot resolve it is refused too (a variable and a substitution alike), and inside the session's own tree it still runs" $r

  # 21b. A STATEMENT IS WALKED ONCE. cmdpos marked BOTH whole-line prints, so a line that ends inside a quote or
  #      carries a string-runner word (sed, env, sh, the everyday ones) was walked as a statement twice and the
  #      same RELATIVE cd moved the base twice — to a dir the shell never stands in. From a subdir of its own
  #      tree, an sh -c string holding `cd ../.. && sed -i s/x/y/ f` really writes ~/dev/f and PASSED, while
  #      `cd .. && sed -i s/x/y/ f` writes inside the tree and was refused (paid review of #243). Cases 21, 24
  #      and 28 all use ABSOLUTE cd targets, which a double application leaves where they were, so none of them
  #      could see it. The cwd is a subdir here, which is what makes `cd ..` an ordinary move inside the tree.
  #      THE TWO `bash -c` ROWS ARE WHY THE MARK CANNOT SIMPLY COME OFF THE RAW PRINT, the shorter fix the
  #      review proposed: `bash -c "echo x; cd ..; …"` neuters its own `;` under the quote-aware reading and the
  #      `echo` in front of the cd is no wrapper, so WCDRE never matches there — the RAW reading is the only one
  #      that sees this cd at all, and unmarked it moves nothing, which let the `cd ../..` spelling write ~/dev/f.
  #      THE LAST TWO ROWS ARE THE REWIND'S OWN FOOTGUN: `''` and `""` flatten to nothing, so a ONE-character
  #      rewind marker is a line cmdpos already prints for them — read as a rewind it undid the cd on the line
  #      BEFORE and the write went into the other repo, which HEAD refused. The marker is two marks for this.
  ASKS=$T/asks21b; CALLS=$T/calls21b; : > "$CALLS"; GERR=$T/err21b
  r=0
  while IFS='%' read -r want fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/alice/sub" CC_ROLE=member)
    [ "$got" = "$want" ] || { r=1; echo "      $fam: rc $got, wanted $want ($(head -c 70 "$GERR"))"; }
    { [ "$want" = 0 ] || grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: refused for the wrong reason: $(head -c 70 "$GERR")"; }
  done <<'W21B'
0%a relative cd back up into the tree, with a sed after it%cd .. && sed -i s/x/y/ f
2%…and one level further, which lands in ~/dev%cd ../.. && sed -i s/x/y/ f
0%an interpreter string that cds back up into the tree%sh -c 'cd .. && sed -i s/x/y/ f'
2%…and one that cds out of it%sh -c 'cd ../.. && sed -i s/x/y/ f'
2%…and the redirect spelling of that escape%sh -c 'cd ../.. && echo pwn > f'
0%a line that ends inside a quote, cd back up into the tree%cd .. && echo \"note\nspanning\" > f
2%…and the same shape one level further%cd ../.. && echo \"note\nspanning\" > f
0%a cd only the RAW reading sees, back up into the tree%bash -c \"echo x; cd ..; sed -i s/x/y/ f\"
2%…and the same one level further%bash -c \"echo x; cd ../..; sed -i s/x/y/ f\"
2%a line that flattens to nothing between a cd and the write%cd ~/dev/_cctest1\n''\necho pwn > f
2%…and its double-quoted spelling%cd ~/dev/_cctest1\n\"\"\necho pwn > f
W21B
  ok "a relative \`cd\` moves the base once, however the line is spelled: inside the tree the write after it still runs, and the level that leaves the tree is refused — in an interpreter string and across a quote that spans two lines alike" $r

  # 22. …AND THE VERBATIM TAIL ENDS WHERE THE SUBSTITUTION DOES. Everything after the first $( ) was emitted
  #     verbatim to the end of the LINE (the fix for case 17), so quoted prose behind any substitution was read as
  #     shell again and refused — case 16's own note with a `$(date)` in front of it (adversarial review of #243).
  #     The tail now ends at the substitution's close, and a `)` that closes a `case` PATTERN is not that close;
  #     one that never closes stays verbatim to the end of the line, which is the fail-closed half.
  ASKS=$T/asks22; CALLS=$T/calls22; : > "$CALLS"; GERR=$T/err22
  r=0
  while IFS='%' read -r want fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    [ "$got" = "$want" ] || { r=1; echo "      $fam: rc $got, wanted $want ($(head -c 70 "$GERR"))"; }
  done <<'W22'
0%a commit message behind a closed substitution is prose%echo \"$(date)\" && git commit -m \"step; cc other t1 --go was blocked\"
0%…and case 16's own note, with a $( ) in front of it%echo \"$(date)\" >> n.md; echo 'writes to > ~/bin/x'
2%a case pattern's ) does not close the substitution%echo \"$(case a in a) cc other t1 --go;; esac)\"
2%…nor does an unbalanced ( after the substitution reopen it%echo \"$(case a in a) cc other t1 --go;; esac) (\"
2%…and the rest of the substitution is not prose either%echo \"$(case a in a) x;; esac; cc other t1 --go)\"
0%an ordinary substitution%echo \"$(date)\"
0%…and one with a pipe and a glob in it%cat \"$(ls *.md | head -1)\"
W22
  ok "the verbatim tail ends where the substitution closes: prose behind a closed one is prose again, while a case pattern's ) leaves it open and everything still inside is read as shell" $r

  # 22b. …AND A COMMAND NAME QUOTED INSIDE ONE STILL REACHES ^. flatln emitted the substitution body verbatim, the
  #      quote chars and backslashes included, so a name quoted inside a $( ) or `` that sits in double quotes never
  #      landed at ^: `echo "$( "docker" run …)"` flattened with the quotes on and $AT could not cross them — the
  #      whole gate list was off for a payload anyone can type (paid review of #243). The quotes drop and \ reduces
  #      the way they do outside a substitution, so the container, landing, merge, sudo, dispatch and tmux gates fire.
  ASKS=$T/asks22b; CALLS=$T/calls22b; : > "$CALLS"; GERR=$T/err22b
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W22B'
a container quoted in a substitution|running a container|echo \"$( \"docker\" run -v /:/host alpine)\"
…its single-quoted spelling|running a container|echo \"$( 'docker' run -v /:/host alpine)\"
…and the backtick substitution's|running a container|echo \"`\"docker\" run -v /:/host alpine`\"
landing quoted in a substitution|landing a change|echo \"$( \"cc-land\" 7)\"
a merge quoted in a substitution|merging a PR|echo \"$( \"gh\" pr merge 7)\"
sudo quoted in a substitution|sudo / host changes|echo \"$( \"sudo\" id)\"
a dispatch quoted in a substitution|dispatching outside|echo \"$( \"cc\" other t1 --go)\"
…and behind a doubled backslash inside it|dispatching outside|echo \"$( \\\\cc other t1 --go)\"
…and in ANSI-C hex inside a substitution|dispatching outside|echo \"$( $'\\x63c' other t1 --go)\"
…its backtick spelling|dispatching outside|echo \"`$'\\x63c' other t1 --go`\"
a container in ANSI-C hex inside a substitution|running a container|echo \"$( $'\\x64ocker' run -v /:/host alpine)\"
the tmux gate quoted in a substitution|shared tmux server|echo \"$( \"tmux\" kill-server)\"
W22B
  ok "a command name quoted inside a substitution reaches ^ like a bare one: the container, landing, merge, sudo, dispatch and tmux gates each fire on the \$( ) and backtick shapes, single- and double-quoted, behind a doubled backslash and in ANSI-C (\$'…') quoting" $r

  # 23. `cd -` IS A DESTINATION, NOT AN OPTION. It goes to $OLDPWD, `~-` names the same dir, and pushd's `+N`/`-N`
  #     name a slot of the stack — all four were skipped as options, so `cd -` read as a bare `cd`, moved the base
  #     to $HOME and let the write through while the real shell was back in the repo it came from (2nd adversarial
  #     review of #243). None can be resolved here, so the base is emptied and a relative write after one is refused.
  ASKS=$T/asks23; CALLS=$T/calls23; : > "$CALLS"; GERR=$T/err23
  r=0
  for wsp in "cd -" "cd ~-" "pushd +1" "pushd -1"; do
    : > "$GERR"; got=$(g Bash "{\"command\":\"cd $H/dev/other; cd /tmp; $wsp; echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "cannot resolve" "$GERR"; } \
      || { r=1; echo "      \`$wsp\` was not read as a destination: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  ok "\`cd -\`, \`cd ~-\` and pushd's \`+N\`/\`-N\` are destinations this cannot resolve, not options to skip past — a relative write after one is refused rather than resolved against \$HOME" $r

  # 24. A NEWLINE IS NOT A `cd` BACK. The base was reset on every line while the shell's cwd is not, so a cd on
  #     line 1 and a relative write on line 2 resolved against the payload's own cwd and passed — in all three
  #     spellings (2nd adversarial review of #243). The base is per PAYLOAD: a cd on line 1 governs line 2.
  ASKS=$T/asks24; CALLS=$T/calls24; : > "$CALLS"; GERR=$T/err24
  r=0; i=0
  for wpl in "cd $H/dev/other &&"'\n'"echo pwn > f" \
             "cd $H/dev/other;"'\n'"echo pwn > f" \
             "cd $H/dev/other "'\\\n'"&& echo pwn > f"; do
    i=$((i+1)); : > "$GERR"
    got=$(g Bash "{\"command\":\"$wpl\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      a cd on line 1 and a write on line 2, form $i: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  ok "a \`cd\` on one line still governs the next: the &&, ; and backslash-continuation spellings of a write into another repo are all refused" $r

  # 25. popd GOES BACK WHERE pushd CAME FROM. It was not tracked at all, so it left the base at the dir the last
  #     pushd moved to and `pushd ~/dev/other; pushd /tmp; popd; echo pwn > f` passed (2nd adversarial review of
  #     #243). The stack is tracked; popped off an empty one it is unresolvable, and inside its own tree it still runs.
  ASKS=$T/asks25; CALLS=$T/calls25; : > "$CALLS"; GERR=$T/err25
  r=0
  : > "$GERR"; p1=$(g Bash "{\"command\":\"pushd $H/dev/other; pushd /tmp; popd; echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$p1" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
    || { r=1; echo "      a write after a popd back into another repo: rc $p1, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; p2=$(g Bash '{"command":"pushd /tmp; popd; popd; echo pwn > f"}' "$H/dev/ws1" CC_ROLE=member)
  { [ "$p2" = 2 ] && grep -qF "cannot resolve" "$GERR"; } \
    || { r=1; echo "      a write after a popd off an empty stack: rc $p2, refused for: $(head -c 70 "$GERR")"; }
  p3=$(g Bash '{"command":"pushd sub >/dev/null; make; popd >/dev/null; echo x > f"}' "$H/dev/ws1" CC_ROLE=member)
  [ "$p3" = 0 ] || { r=1; echo "      a pushd/popd pair and a write INSIDE its own tree was refused (rc $p3)"; }
  ok "popd is tracked against pushd's own stack — a write after it is judged where it lands, off an empty stack it is refused, and a pushd/popd pair inside the session's own tree still runs" $r

  # 26. A DOUBLED BACKSLASH IN "" IS ONE BACKSLASH, AND ONE BACKSLASH IS NOT PART OF A NAME. `bash -c "\\cc …"`
  #     hands bash the string \cc, which it runs as cc — but both characters were kept, so unesc left `\cc` at ^
  #     and every rule reads a NAME there: the whole gate list was off again (2nd adversarial review of #243).
  #     Rows are JSON-escaped: \\\\ reaches the guard as \\ and \" as ".
  ASKS=$T/asks26; CALLS=$T/calls26; : > "$CALLS"; GERR=$T/err26
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W26'
a dispatch in an interpreter string|dispatching outside|bash -c \"\\\\cc other t1 --go\"
…with a statement of its own in front of it|dispatching outside|bash -c \"\\\\echo hi; \\\\cc other t1 --go\"
…and the same string through eval|dispatching outside|eval \"\\\\cc other t1 --go\"
a merge behind a doubled backslash|merging a PR|\\\\gh pr merge 1
landing behind a doubled backslash|landing a change|\\\\cc-land 7
a container behind a doubled backslash|running a container|\\\\docker run -v /:/host alpine
W26
  ok "a doubled backslash is reduced the way a shell reduces it, so \`bash -c \"\\\\cc …\"\`, \`eval\`, \`\\\\gh pr merge\`, \`\\\\cc-land\` and \`\\\\docker\` each reach their own rule" $r

  # 27. …AND NONE OF THAT REFUSES ORDINARY WORK. The controls for cases 23-26: a cd into a subdir, a cd into a
  #     substitution, a top-level `case`, two substitutions in one echo, a heredoc that only NAMES a dispatch,
  #     and find's escaped `;` — every one of them a shape the fixes above could have caught by accident.
  ASKS=$T/asks27; CALLS=$T/calls27; : > "$CALLS"; GERR=$T/err27
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    [ "$got" = 0 ] || { r=1; echo "      $fam: rc $got ($(head -c 70 "$GERR"))"; }
  done <<'W27'
a cd into a subdir and a build%cd sub && make
a cd into a substitution%cd \"$(git rev-parse --show-toplevel)\" && ls
a top-level case statement%case \"$x\" in a) echo ok;; esac
two substitutions in one echo%echo \"$(date) $(whoami)\"
a heredoc whose body only names a dispatch%cat <<EOF\nplan: cc other t1 --go\nEOF
find's escaped semicolon%find . -name x -exec rm {} \\;
an -exec that copies inside the session's own tree%find . -name x -exec cp {} sub/ \\;
a commit message that names popd, and a write after it%git commit -m 'popd broke the build'\necho x > notes.md
a dollar-quoted string in an argument%echo $'hi' > notes.md
a printf whose argument only spells a dispatch%printf '\\x63c other t1 --go' > notes.md
prose carrying the character the walk marks with%echo 'the \u0001 mark' > notes.md
a commit message carrying a substitution%git commit -m 'ran $(date) before the cd'
a cp with two sources into a subdir of its own tree%cp a b sub/
a cp whose destination is built by a substitution%cp a $(pwd)/b
a loop copying inside its own tree%for f in a b; do cp $f sub/$f; done
a cd through a braced parameter%cd ${HOME}/dev/ws1/sub && echo x > f
a quoted heredoc delimiter, body naming a dispatch%cat > note.md <<'EOF'\n$(cc other t1 --go)\nEOF
a bare heredoc whose body is only prose%cat > note.md <<EOF\nplan: cc other t1 --go, then cd ~/dev/other\nEOF
an awk program in braces, with a redirect%awk '{ print $1 }' in.txt > b.txt
find -exec with a + terminator%find . -name '*.md' -exec sed -i s/a/b/ {} +
a loop with a braced body copying inside the tree%for f in a b; do { cp $f sub/$f; }; done
a commit message that only spells a heredoc%git commit -m 'the << EOF form'
a glob inside the session's own tree%cp /dev/null sub/x?
a benign interpreter cd, then a write inside the tree%sh -c 'cd /tmp' && echo x > notes.md
a cp whose source is a substitution, inside the tree%cd sub && cp $(echo a) b
a harmless echo with a substitution in it, redirected inside the tree%cd sub && echo $(date) > notes.md
a cd whose redirection substitution writes inside the tree%cd sub > $(cp /dev/null note.md)
…and the cd it belongs to still governs the write after it%cd sub > $(echo /tmp/log) && echo x > f
a substitution that is not a cd destination, then a write inside the tree%echo $(pwd) && echo x > notes.md
W27
  ok "the cd, popd and backslash fixes leave ordinary work alone: a cd into a subdir or a substitution, a top-level case, two substitutions in one echo, a heredoc naming a dispatch, find's escaped ; and its -exec inside the tree, a message naming popd, a dollar-quoted argument, a printf that only spells a dispatch, prose carrying the mark character and a two-source cp inside the tree, a substitution building a cp destination, a loop copying inside the tree, a braced parameter in a cd both heredoc delimiters, a braced awk program, find's + terminator, a braced loop body, a message spelling a heredoc and a glob inside the tree all still run" $r

  # 28. A WRAPPER WORD IN FRONT OF A `cd` STILL MOVES THE SHELL. The prefix took `(`, `{` and VAR= and nothing
  #     else, so `command cd ~/dev/other && echo pwn > f` and the `builtin` spelling were never tracked and the
  #     write after them resolved against the session's own cwd (3rd adversarial review of #243). The prefix is
  #     $AT's wrapper list plus `builtin`; `sh -c "cd …; write"` moves the shell that does the writing.
  ASKS=$T/asks28; CALLS=$T/calls28; : > "$CALLS"; GERR=$T/err28
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W28
command%command cd $H/dev/other && echo pwn > f
builtin%builtin cd $H/dev/other && echo pwn > f
an interpreter that is handed the cd and the write%sh -c 'cd $H/dev/other && echo pwn > f'
W28
  ok "a \`cd\` behind \`command\`, \`builtin\` or an interpreter string moves the base like a bare one: the write after it is judged where the shell really is" $r

  # 29. A SUFFIX IS ARGUMENT TEXT, NOT A STATEMENT. The walk emits every suffix of a statement on a line of its
  #     own, and the cd walk read those as statements: `git commit -m "cd /tmp"` cancelled a real cd into another
  #     repo and let the write through, and `git commit -m "popd broke the build"` emptied the base and refused an
  #     ordinary write (3rd adversarial review of #243). Only the marked statement lines move the base now.
  ASKS=$T/asks29; CALLS=$T/calls29; : > "$CALLS"; GERR=$T/err29
  r=0
  : > "$GERR"; q1=$(g Bash "{\"command\":\"cd $H/dev/other"'\n'"git commit -m 'cd /tmp'"'\n'"echo pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
  { [ "$q1" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
    || { r=1; echo "      a quoted cd did not cancel the real one: rc $q1, refused for: $(head -c 70 "$GERR")"; }
  : > "$GERR"; q2=$(g Bash "{\"command\":\"git commit -m 'popd broke the build'"'\n'"echo x > notes.md\"}" "$H/dev/ws1" CC_ROLE=member)
  [ "$q2" = 0 ] || { r=1; echo "      a message naming popd refused the write after it: rc $q2 ($(head -c 70 "$GERR"))"; }
  ok "a cd or a popd inside an argument is prose the shell never runs: it neither cancels a real cd on the line before nor empties the base under an ordinary write" $r

  # 30. `popd -n` TAKES A DIRECTORY OFF THE STACK AND LEAVES THE SHELL WHERE IT IS. bash suppresses the cd, so
  #     `pushd ~/dev/other; popd -n; echo pwn > f` writes in the other repo — read as a popd back, it passed
  #     (3rd adversarial review of #243). The header note said -n was unresolvable; now the code agrees with it.
  ASKS=$T/asks30; CALLS=$T/calls30; : > "$CALLS"; GERR=$T/err30
  r=0
  for wpn in "pushd $H/dev/other; popd -n; echo pwn > f" "pushd $H/dev/other"'\n'"popd -n"'\n'"echo pwn > f"; do
    : > "$GERR"; got=$(g Bash "{\"command\":\"$wpn\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      a write after \`popd -n\`: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  ok "\`popd -n\` pops the stack without moving the shell, so a write after it is still judged in the dir the pushd went to" $r

  # 31. `{}` GLUED IS THE PLACEHOLDER find PASSES, NOT A COMMAND GROUP. Splitting the statement on it truncated
  #     it before the target, so `find . -name x -exec cp {} ~/bin/cc-guard \;` put a bare `cp` at ^ with nothing
  #     to judge and overwrote a live binary (3rd adversarial review of #243). -exec is an $AT wrapper as well.
  ASKS=$T/asks31; CALLS=$T/calls31; : > "$CALLS"; GERR=$T/err31
  r=0
  for wex in "-exec cp {} $H/bin/cc-guard \\\\;" "-execdir cp {} $H/dev/other/f \\\\;"; do
    : > "$GERR"; got=$(g Bash "{\"command\":\"find . -name x $wex\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      a cp through find's $wex: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  ok "find's \`{}\` no longer ends the statement, so a cp through \`-exec\` or \`-execdir\` is judged on where it lands — ~/bin or another repo" $r

  # 32. A DOLLAR-QUOTE IS RESOLVED BEFORE A NAME IS READ. ANSI-C quoting ($ + a single-quoted body) hides a
  #     command name from every rule, all of which read a NAME at ^: the hex and octal spellings of cc, gh,
  #     cc-land and docker each ran (3rd adversarial review of #243). Rows are JSON-escaped: \\\\x is \\x.
  ASKS=$T/asks32; CALLS=$T/calls32; : > "$CALLS"; GERR=$T/err32
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W32'
a dispatch spelled in hex|dispatching outside|$'\\x63c' other t1 --go
…in \u, which is the same escape four digits wide|dispatching outside|$'\\u0063c' other t1 --go
…and in \U, eight digits wide|dispatching outside|$'\\U00000063c' other t1 --go
…and in octal, through an interpreter|dispatching outside|bash -c $'\\143c other t1 --go'
a merge behind a dollar-quote|merging a PR|$'\\x67h' pr merge 1
landing behind a dollar-quote|landing a change|$'\\x63c-land' 7
a container behind a dollar-quote|running a container|$'\\x64ocker' run -v /:/host alpine
W32
  ok "ANSI-C quoting is resolved the way the shell resolves it, so the \\x, \\u, \\U and octal spellings of a dispatch, a merge, a land and a container each reach their own rule" $r

  # 33. THE MARK IS THE WALK'S, NEVER THE COMMAND'S. cmdpos marks a statement line with a \001 so the cd walk can
  #     tell a statement from an argument (case 29) — and the command text is the member's to write, so a mark
  #     inside a commit message put a marked line in the haystack and a quoted cd cancelled a real one again.
  #     Three spellings reach the same character: raw, \x01 and \cA (4th adversarial review of #243). It comes
  #     off the text at the head of hay, before any walk sees it, and ansic never emits one.
  ASKS=$T/asks33; CALLS=$T/calls33; : > "$CALLS"; GERR=$T/err33
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W33
a raw mark in an argument%cd $H/dev/other\ngit commit -m '\u0001cd $H/dev/ws1'\necho pwn > f
the mark spelled in ANSI-C hex%cd $H/dev/other\ngit commit -m \$'\\\\x01cd $H/dev/ws1'\necho pwn > f
…and as a control character%cd $H/dev/other\ngit commit -m \$'\\\\cAcd $H/dev/ws1'\necho pwn > f
W33
  ok "the character the walk marks statement lines with is stripped from the command text first, in every spelling that reaches it, so a member cannot mark an argument as a statement" $r

  # 34. AN OPTION WORD AND A COMPOUND KEYWORD ARE WRAPPERS TOO. `command -p cd ~/dev/other`, `time -p cd …`, and
  #     the `if`, `while`, `until` and `!` spellings all move the shell, and the prefix knew none of them, so the
  #     write after each resolved against the session's own tree (4th adversarial review of #243).
  ASKS=$T/asks34; CALLS=$T/calls34; : > "$CALLS"; GERR=$T/err34
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W34
an option between the wrapper and the cd%command -p cd $H/dev/other && echo pwn > f
…and after time%time -p cd $H/dev/other && echo pwn > f
if%if cd $H/dev/other; then echo pwn > f; fi
while%while cd $H/dev/other; do echo pwn > f; done
until%until cd $H/dev/other; do echo pwn > f; done
a negated cd%! cd $H/dev/other; echo pwn > f
W34
  ok "an option word between a wrapper and a \`cd\`, and the if/while/until/! spellings of one, each move the base like a bare cd does" $r

  # 35. A SUBSTITUTION IS A SHELL OF ITS OWN. `echo \$(cd ~/dev/other && echo pwn > f)`, the backtick spelling and
  #     `cat <(cd …; echo pwn > f)` were read as one statement whose first word is `echo`, so the cd inside was
  #     never tracked (4th adversarial review of #243). The interior opens a statement, the way `(` already did.
  #     THE LAST THREE ROWS ARE THE OTHER HALF: WHERE THAT INTERIOR STANDS. A redirection is expanded before the
  #     command it belongs to runs, so `cd sub > $(cp /dev/null ../other/f)` runs the cp in the dir the line
  #     started in — the walk judged it in `sub` and the write into another repo passed (8th adversarial review
  #     of #243). The interior gets the base the piece started with; the `)` still hands back the cd's own base,
  #     which the third row holds by writing ~/bin only after the substitution has closed.
  ASKS=$T/asks35; CALLS=$T/calls35; : > "$CALLS"; GERR=$T/err35
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W35
a command substitution%echo \$(cd $H/dev/other && echo pwn > f)
the backtick spelling%echo \`cd $H/dev/other && echo pwn > f\`
a process substitution%cat <(cd $H/dev/other; echo pwn > f)
a substitution in a cd's own redirection, expanded before it moves%cd sub > \$(cp /dev/null ../other/f)
the backtick spelling of that redirection%cd sub > \`cp /dev/null ../other/f\`
…and after the ) the cd's own base governs again%cd $H/bin > \$(echo /tmp/log) && cp /dev/null cc-guard
W35
  ok "a cd inside a substitution moves the writes inside it: the \$( ), backtick and <( ) spellings are each walked as a statement of their own" $r

  # 36. THE DESTINATION IS NOT ALWAYS THE LAST WORD. Only the last bare word was judged, so any trailing word
  #     moved the target out of sight: a redirection after it, or an interpreter that takes the real arguments
  #     after the script (`sh -c 'cp \$1 ~/bin/cc-guard' _ a`) — both overwrote a live binary (4th adversarial
  #     review of #243). Every bare word after the first is a destination now.
  ASKS=$T/asks36; CALLS=$T/calls36; : > "$CALLS"; GERR=$T/err36
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W36
a redirection after the destination%cp a $H/bin/cc-guard 2>/dev/null
…and after an mv into another repo%mv a $H/dev/other/f 2>&1
an interpreter whose arguments follow the script%sh -c 'cp \$1 $H/bin/cc-guard' _ a
…the same, through find -exec%find . -name x -exec sh -c 'cp \$1 $H/bin/cc-guard' _ {} \\\\;
W36
  ok "every bare word after the first is judged as a destination, so a trailing redirection or an interpreter that takes its arguments after the script cannot move a cp or mv out of sight" $r

  # 37. AN UNQUOTED HEREDOC DELIMITER EXPANDS THE BODY, AND AN EXPANSION IS A COMMAND. Bodies are dropped so that
  #     a brief or a note that only NAMES a command is not refused (case 16) — but `cat > note.md <<EOF` over
  #     `$(cc other t1 --go)` really dispatches, and the same body could read the credentials, merge a PR or copy
  #     over a live binary (5th adversarial review of #243). The delimiter decides: quoted, the whole body is
  #     literal and still goes; bare, the lines carrying a substitution or a parameter stay.
  ASKS=$T/asks37; CALLS=$T/calls37; : > "$CALLS"; GERR=$T/err37
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W37'
a dispatch in the body|dispatching outside|cat > note.md <<EOF\n$(cc other t1 --go)\nEOF
the box's credentials|reading the box's credentials|cat > note.md <<EOF\n$(cat ~/ccbox/env)\nEOF
a merge|merging a PR|cat > note.md <<EOF\n$(gh pr merge 1)\nEOF
a copy over a live binary, through a backtick|writing into the box's live tree|cat > note.md <<EOF\n`cp /dev/null ~/bin/cc-guard`\nEOF
W37
  ok "a heredoc body whose delimiter is bare keeps the lines the shell would EXPAND — a dispatch, the credentials, a merge and a backtick copy each reach their own rule — while a quoted delimiter drops the lot (case 27)" $r

  # 38. sprintf("%c") TRUNCATES WHAT IT CANNOT HOLD, so the surrogate range re-spelled the two characters ansic
  #     must never emit: \ud801 came back as the statement mark and \ud80a as a newline, which put case 33 back
  #     (5th adversarial review of #243). A NEWLINE OR CR SPELLED DIRECTLY did the same: `$'\n'` / `$'\x0a'` /
  #     `$'\012'` / `$'\cJ'` (all v=10) split a marked statement line so the `; cd …` half landed UNMARKED and
  #     its cd was never walked, and the write past it passed (7th adversarial review of #243). Only printable
  #     ASCII that is not a newline or CR comes out now; anything else is a placeholder.
  ASKS=$T/asks38; CALLS=$T/calls38; : > "$CALLS"; GERR=$T/err38
  r=0
  for wsg in ud801 ud80a; do
    : > "$GERR"
    got=$(g Bash "{\"command\":\"cd $H/dev/other\ngit commit -m \$'\\\\$wsg cd $H/dev/ws1'\necho pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      \\$wsg was emitted as a character of its own: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  for wsn in '\\n' '\\x0a' '\\012' '\\cJ'; do   # a newline spelled four ways: ansic must place a `?`, not split the line
    : > "$GERR"
    got=$(g Bash "{\"command\":\"echo \$'$wsn'; cd $H/dev/other\necho pwn > f\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      \$'$wsn' split the statement: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done
  ok "a value ansic cannot hold in one ASCII character becomes a placeholder, and a newline or CR spelled directly (\\n, \\x0a, \\012, \\cJ) is a placeholder too, so neither the surrogate range nor a direct spelling can re-spell the statement mark or split a marked statement line" $r

  # 39. ANY TOKEN IN FRONT OF A `cd` HID IT, because a piece was cut only at `;&|` and a substitution opener, and
  #     a leading `(`/`{` was allowed only at the very start of one. A case pattern, a function body in either
  #     spelling, a braced group after `time` or inside a loop, and a leading redirection all move the real shell
  #     and none was tracked (5th adversarial review of #243). A brace with a space beside it, a closing paren
  #     and a redirection are read for what they are.
  ASKS=$T/asks39; CALLS=$T/calls39; : > "$CALLS"; GERR=$T/err39
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W39
a case pattern%case \$x in *) cd $H/bin;; esac; cp /dev/null cc-guard
a function body%f() { cd $H/bin; }; f; cp /dev/null cc-guard
…in the function keyword spelling%function f { cd $H/bin; }; f; cp /dev/null cc-guard
a braced group after time%time { cd $H/dev/other; }; echo pwn > f
a leading redirection%>/dev/null cd $H/dev/other; echo pwn > f
a braced group inside a loop%while :; do { cd $H/dev/other; break; }; done; echo pwn > f
W39
  ok "a case pattern, a function body in either spelling, a braced group after time or inside a loop and a leading redirection each leave the cd where the walk can see it" $r

  # 40. A `<<` INSIDE QUOTES OR BEHIND A `#` OPENS NOTHING. The heredoc pre-pass was quote- and comment-blind, so
  #     `echo '<< EOF'` opened a body bash never opens and every line down to the next EOF left the haystack —
  #     the tmux fence, the gate list and the write fence with it, for a payload anybody can type (6th
  #     adversarial review of #243). The opener is now the first `<<` the shell itself would read.
  ASKS=$T/asks40; CALLS=$T/calls40; : > "$CALLS"; GERR=$T/err40
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W40'
a quoted << in front of a dispatch|dispatching outside|echo '<< EOF'\ncc other t1 --go\nEOF
a << behind a comment, in front of a merge|merging a PR|echo hi  # << EOF\ngh pr merge 1\nEOF
a quoted << in a commit message, in front of a copy|writing into the box's live tree|git commit -m \"see << EOF\"\ncp /dev/null ~/bin/cc-guard\nEOF
W40
  ok "a \`<<\` inside quotes or behind a comment opens no heredoc, so the lines after it are still the commands they are — a dispatch, a merge and a copy over a live binary are each still refused" $r

  # 41. A BACKSLASH AT THE END OF A BODY LINE JOINS THE NEXT ONE. A substitution spread over two lines was
  #     tested a line at a time and neither half carried the whole of it, so `$(cp /dev/null \` over
  #     `~/bin/cc-guard)` in a bare heredoc truncated a live binary (6th adversarial review of #243). And a
  #     backslash on the LAST body line joins the delimiter line, so the delimiter branch threw the pending
  #     substitution away untested — a live binary again (7th adversarial review of #243); it is flushed first.
  ASKS=$T/asks41; CALLS=$T/calls41; : > "$CALLS"; GERR=$T/err41
  r=0
  while IFS='|' read -r fam why what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<'W41'
a copy over a live binary, split across two lines|writing into the box's live tree|cat > n.md <<EOF\n$(cp /dev/null \\\n~/bin/cc-guard)\nEOF
a dispatch split the same way|dispatching outside|cat > n.md <<EOF\n$(cc other \\\nt1 --go)\nEOF
a copy whose continuation is the last body line before the delimiter|writing into the box's live tree|cat > n.md <<EOF\n$(cp /dev/null ~/bin/cc-guard) \\\nEOF
W41
  ok "a body line continued with a backslash is joined the way the shell joins it, so a substitution spread over two lines is still read as the one command it is" $r

  # 42. TWO REDIRECTIONS THE PREFIX DID NOT KNOW. `2>&1 cd ~/dev/other` is cut in half by the `&` the pieces are
  #     split on, leaving `1 cd …`, and `{fd}>/dev/null cd …` is a named descriptor the redirection alternative
  #     never covered — both moved the shell untracked (6th adversarial review of #243).
  ASKS=$T/asks42; CALLS=$T/calls42; : > "$CALLS"; GERR=$T/err42
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W42
a descriptor duplication%2>&1 cd $H/dev/other; echo pwn > f
a descriptor closed%2>&- cd $H/dev/other; echo pwn > f
a named descriptor%{fd}>/dev/null cd $H/dev/other; echo pwn > f
W42
  ok "\`2>&1\`, \`2>&-\` and \`{fd}>file\` in front of a cd are read as the redirections they are, so the write after each is judged where the shell really is" $r

  # 43. A GLOB IS NOT AN UNRESOLVABLE NAME — it is a name with a tail this cannot see, and its literal PREFIX
  #     says where the write lands. Waved through for carrying a `?`, `cp /dev/null ~/bin/cc-guar?` truncated a
  #     live binary (6th adversarial review of #243). The prefix is judged; a glob inside the tree still runs.
  ASKS=$T/asks43; CALLS=$T/calls43; : > "$CALLS"; GERR=$T/err43
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W43
a cp onto a one-character glob%cp /dev/null $H/bin/cc-guar?
a cp onto a star%cp /dev/null $H/bin/cc-guard*
a redirect onto a glob%echo x > $H/bin/cc-guar?
a glob after a cd into another repo%cd $H/dev/other && echo x > f?
W43
  ok "a write target carrying a glob is judged on its literal prefix, so a glob that lands in ~/bin or another repo is refused while one inside the session's own tree still runs (case 27)" $r

  # 44. A SUBSHELL'S cd DOES NOT LEAVE THE SUBSHELL. A benign `(cd /tmp)` — and its `sh -c 'cd /tmp'` spelling —
  #     between a real cd into another repo and a relative write carried /tmp out of the subshell and MASKED the
  #     real cd, so the write resolved against /tmp and passed while the shell wrote the other repo (7th
  #     adversarial review of #243). The base is given back at the subshell's close; case 28's write, inside the
  #     same subshell, still refuses. Controls: a real cd AFTER the subshell still governs the write.
  #     THE LAST TWO ROWS ARE THE SAME MASKING ON ONE LINE, which the give-back missed for a whole round because
  #     it was deferred to the end of the source LINE: `cd ~/bin && sh -c 'cd /tmp' && cp /dev/null cc-guard`
  #     left the base at /tmp when the cp was scanned and passed, truncating a live binary (8th adversarial
  #     review of #243). The child shell ends with its own PIECE, so the base goes back there.
  ASKS=$T/asks44; CALLS=$T/calls44; : > "$CALLS"; GERR=$T/err44
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W44
a bare subshell cd masking a real one%cd $H/dev/other\n(cd /tmp)\necho pwn > f
an interpreter-string cd masking a real one%cd $H/dev/other\nsh -c 'cd /tmp'\necho pwn > f
a real cd after the subshell still governs the write%(cd /tmp)\ncd $H/dev/other\necho pwn > f
a real cd after an interpreter cd still governs the write%sh -c 'cd /tmp' && cd $H/dev/other\necho pwn > f
an interpreter cd masking a real one on ONE line%cd $H/dev/other && sh -c 'cd /tmp' && echo pwn > f
…and the ~/bin spelling, which truncates a live binary%cd $H/bin && sh -c 'cd /tmp' && cp /dev/null cc-guard
W44
  ok "a benign \`(cd /tmp)\` or \`sh -c 'cd /tmp'\` gives its base back at the subshell's close, so a relative write is judged where the real shell stands — before it (masked) and after it (a real cd) alike, on one line as on three" $r

  # 45. A STATEMENT IS ONE STRING FOR THE WRITE FENCE. The cd walk cuts a line at every `$(`, backtick and `)` so
  #     it can track a subshell's base, and the fence read those pieces — so a destination sitting after a
  #     substitution was orphaned from its verb: `cd sub && cp $(echo /dev/null) ~/bin/cc-guard` left
  #     ` ~/bin/cc-guard` as a piece with no cp and no redirection in it, nothing was judged, and the shell
  #     truncated a live binary (9th adversarial review of #243). Without the `cd` the same line took the
  #     whole-command path and was refused, so the word `cd` anywhere turned the fence off for this shape. The
  #     statement is now put back together with each substitution reduced to a `$`, and the interior is still
  #     walked as the statement it is — the fourth row is the write INSIDE the substitution, the fifth is a
  #     redirection after one, and the last is a substitution nested in a substitution. Controls are in case 27.
  #     THE LAST TWO ROWS ARE THE SAME ORPHANING BY THE OTHER SPLIT: the `|` of a `>|` is not a pipe, but the
  #     pieces are cut at `;&|`, so `cp /dev/null >| ~/bin/cc-guard` left its target on a piece with no verb.
  ASKS=$T/asks45; CALLS=$T/calls45; : > "$CALLS"; GERR=$T/err45
  r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"
    got=$(g Bash "{\"command\":\"$what\"}" "$H/dev/ws1" CC_ROLE=member)
    { [ "$got" = 2 ] && grep -qF "writing into the box's live tree" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W45
a destination after a substitution%cd sub && cp \$(echo /dev/null) $H/bin/cc-guard
the backtick spelling of it%cd sub && cp \`echo /dev/null\` $H/bin/cc-guard
a substitution in the middle of the arguments%cd sub && cp /dev/null \$(echo x) $H/bin/cc-guard
the destination inside the substitution%cd sub && echo \$(cp /dev/null $H/bin/cc-guard)
a redirection whose target follows a substitution%cd sub && echo \$(date) > $H/bin/cc-guard
a tee whose file follows a substitution%cd sub && tee \$(echo -a) $H/bin/cc-guard
a substitution nested in a substitution%cd sub && cp \$(echo \$(echo /dev/null)) $H/bin/cc-guard
a noclobber-override redirection, whose | the split read as a pipe%cd sub && cp /dev/null >| $H/bin/cc-guard
…and its glued spelling%cd sub && cp /dev/null >|$H/bin/cc-guard
W45
  ok "a write is judged over the whole statement, not the pieces the cd walk cuts it into: a destination after a substitution — in the middle, nested, redirected or inside the substitution itself — reaches the fence like a bare one" $r

  # 46. THE STEWARD RUNS AT ITS OWN TIER. cc-steward is one headless `claude -p` per routine event, unattended and
  #     on the cheap model, so what keeps it from dispatching, spending or reading the box's secrets has to be a
  #     rule and not a sentence in its prompt. CC_ROLE=steward is the whole tell — its run dir is ~/.cc/steward/<repo>
  #     and carries no marker — and the refusal is the steward's own: no query recorded, nothing sent to the owner.
  ASKS=$T/asks46; CALLS=$T/calls46; : > "$CALLS"; GERR=$T/err46; SD=$H/.cc/steward/demo
  QS=$H/.cc/state/_nomarker/queries.spool; rm -f "$QS"; r=0
  while IFS='%' read -r fam what why; do
    [ -n "$fam" ] || continue
    : > "$GERR"; got=$(g Bash "{\"command\":\"$what\"}" "$SD" CC_ROLE=steward)
    # the REASON too, not just rc 2: several rules can refuse one line, and a case that reads only the code
    # cannot tell the rule it means to test from a neighbour that happened to fire first.
    { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } \
      || { r=1; echo "      $fam: rc $got, refused for: $(head -c 70 "$GERR")"; }
  done <<W46
dispatching a worker%cc demo t2 --go fix it%does not dispatch workers (cc --go)
starting an orch%cc demo --orch dash a project%does not start an orch
the runner underneath a worker%cc-loop demo t2%does not dispatch workers (cc-loop)
a second headless model call%claude -p do the thing --model sonnet%a second model call
another steward, recursing%cc-steward run demo%does not run another steward
reading the box's config%cat ~/.cc/config%reading the box's secrets
re-wiring the box's Slack%cc-slack mkchannel new%re-wiring the box's Slack
rewriting the box's config%cc-config set CC_STEWARD_MODEL opus%not a steward's to read or rewrite
landing, inherited from the worker tier%cc-land 7%landing a change
posting in the owner's name, likewise%cc-slack post --to demo hi%posting to the owner's Slack
sudo, likewise%sudo systemctl restart cc-broker%sudo / host changes
W46
  # …and the work it exists to do is untouched, or the tier is just an off switch.
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"; got=$(g Bash "{\"command\":\"$what\"}" "$SD" CC_ROLE=steward)
    [ "$got" = 0 ] || { r=1; echo "      steward refused its own work — $fam: rc $got, $(head -c 70 "$GERR")"; }
  done <<A46
reading the reconciler's snapshot%cat ~/.cc/state/sense.json
escalating to the owner%cc-notify a steward needs a person
asking whether a repo holds the landing grant%cc lands demo
appending its own run log%echo ran >> ~/.cc/state/steward/runs.jsonl
A46
  [ -s "$CALLS" ] && { r=1; echo "      a steward refusal reached the owner"; }
  [ -s "$QS" ] && { r=1; echo "      a steward refusal recorded a member query"; }
  ok "a steward is refused dispatch, a second model call, the box's secrets and its Slack wiring — inherits the worker gates, still runs its own work, and asks nobody" $r

  # 47. …AND NO OTHER TIER MOVED. The steward rules are keyed on $CC_ROLE alone, so the same lines must still pass
  #     for a WORKER (which dispatches subagents and workers, and reads the config) and for a PLANNING session
  #     (ungated: no role, no marker). If this goes red the tier leaked onto sessions that already had the grant.
  ASKS=$T/asks47; CALLS=$T/calls47; : > "$CALLS"; GERR=$T/err47; r=0
  while IFS='%' read -r fam what; do
    [ -n "$fam" ] || continue
    : > "$GERR"; w=$(g Bash "{\"command\":\"$what\"}" "$WT" CC_ROLE=worker); p=$(g Bash "{\"command\":\"$what\"}" "$H")
    { [ "$w" = 0 ] && [ "$p" = 0 ]; } \
      || { r=1; echo "      $fam: worker rc $w, planning rc $p — $(head -c 70 "$GERR")"; }
  done <<W47
dispatching a worker%cc demo t2 --go fix it
the runner underneath one%cc-loop demo t2
a headless model call%claude -p do the thing --model sonnet
reading the box's config%cat ~/.cc/config
rewriting the box's config%cc-config set CC_STEWARD_MODEL opus
making a Slack channel%cc-slack mkchannel new
W47
  ok "the steward tier is the steward's alone: a worker and a planning session still dispatch, read the config and wire Slack" $r

  # 48. GATING ~/.cc/config IN BASH ALONE WOULD BE THEATRE FOR THIS TIER — Read/Grep/Glob is the tool set the
  #     steward actually holds today (cc-steward: THE MODEL GETS NO SHELL), so the file tools carry the member's
  #     secret list for it too. The worker's list is unchanged: it reads the config and not the credentials.
  ASKS=$T/asks48; CALLS=$T/calls48; : > "$CALLS"; GERR=$T/err48; SD=$H/.cc/steward/demo; r=0
  s1=$(g Read "{\"file_path\":\"$H/.cc/config\"}" "$SD" CC_ROLE=steward)
  s2=$(g Read "{\"file_path\":\"$H/.claude/.credentials.json\"}" "$SD" CC_ROLE=steward)
  s3=$(g Read "{\"file_path\":\"$H/.cc/state/sense.json\"}" "$SD" CC_ROLE=steward)
  w1=$(g Read "{\"file_path\":\"$H/.cc/config\"}" "$WT" CC_ROLE=worker)
  w2=$(g Read "{\"file_path\":\"$H/.claude/.credentials.json\"}" "$WT" CC_ROLE=worker)
  p1=$(g Read "{\"file_path\":\"$H/.cc/config\"}" "$H")
  [ "$s1$s2$s3" = "220" ] || { r=1; echo "      steward: config $s1, credentials $s2, snapshot $s3"; }
  [ "$w1$w2$p1" = "020" ] || { r=1; echo "      worker: config $w1, credentials $w2; planning: config $p1"; }
  ok "a steward may not READ the box's secrets either, still reads the state it must not guess, and the worker and planning tiers read what they always did" $r

  echo "cc-guard selfcheck: $((n - f)) passed, $f failed"
  [ "$f" = 0 ] || exit 1
  exit 0
fi

inp=$(cat); tool=$(jq -r '.tool_name // ""' <<<"$inp"); cwd=$(jq -r '.cwd // ""' <<<"$inp"); cwd=$(realpath -m -- "${cwd:-/}" 2>/dev/null || echo "$cwd")
qcmd=$(jq -r '.tool_input.command // .tool_input.file_path // .tool_input.notebook_path // ""' <<<"$inp")   # what a member refusal records as "the command"
# A command position: start, after a separator/substitution, or after wrapper words that hide the real command
# (then/xargs/env/nohup/bash -c/VAR=…). Quotes are stripped from the haystack first, so "gh pr merge" is seen too.
# THIS LIST IS NO LONGER WHAT CLOSES THE RULES — cmdpos() below is. Every word it does not know used to hide
# what followed it, in all 24 rules that interpolate $AT: `timeout 5 pkill -f claude` and `setsid tmux
# kill-server` went straight through, the universal tmux gate included. It stays because it is what matches the
# line AS TYPED, and every rule below still expects it; cmdpos() puts the real command at ^ as well.
# find's `-exec`, `-execdir`, `-ok` and `-okdir` ARE wrapper words — the words after one are a command find runs,
# and `find . -name x -exec cp {} ~/bin/cc-guard \;` overwrote a live binary with none of them here (3rd
# adversarial review of #243). The longer spelling comes first: the match is the longest one that fits.
AT='(^|[;&|(){}`]|\$\() *(((then|else|elif|do|time|env|nohup|xargs|command|eval|exec|sudo|bash|sh|-c|-execdir|-exec|-okdir|-ok)|[A-Za-z_][A-Za-z0-9_]*=[^ ]*) +)*'
# A HEREDOC BODY IS DATA, NOT A COMMAND. The rules grep raw text, so a brief, a journal entry or a commit
# message that merely NAMES a forbidden command was refused for containing it — writing the brief for this fix
# was itself blocked that way. So heredoc bodies are dropped before matching. Quoted strings are NOT dropped:
# `bash -c "…"` is a real command and must still be seen. Two fences keep the drop honest: a body goes only if
# its terminator really appears later (an unterminated `<<` swallows nothing), and never when anything on the
# same line could EXECUTE it — an interpreter, eval, xargs, ssh, sudo fed a heredoc really does run its body,
# and that is the one case where the body IS the command. Both fail CLOSED, back to matching the raw text.
X='(^|[;&|(){}`]|[$][(])[ \t]*(((then|else|do|time|env|nohup|xargs|command|sudo)|[A-Za-z_][A-Za-z0-9_]*=[^ \t]+)[ \t]+)*([^ \t]*/)?(bash|sh|zsh|ksh|dash|python[0-9.]*|perl|ruby|node|php|awk|sed|eval|exec|source|[.]|xargs|env|ssh|sudo|systemd-run)([ \t]|$)'
# A WRAPPER WORD IS NOT A WAY PAST A GATE. $AT recognises a fixed set of wrappers, so ANY word it does not
# know hid the command behind it — measured 2026-09-02: `pkill -f claude` refused, `timeout 5 pkill -f claude`
# allowed; `tmux kill-server` refused, `setsid tmux kill-server` allowed. That is one hole in all 24 rules, not
# two holes: merging, landing, deploying, containers, host changes, sudo, dispatch and the write-path rules
# share the anchor. Seven holes in four rounds of the kill fence say a wrapper list cannot be completed, so
# THE LIST CHANGES SIDES. cmdpos() walks each statement token by token and adds every SUFFIX to the haystack as
# its own line, so a rule anchored at ^ sees the real command wherever a wrapper put it — and it splits a token
# at its first `=` as well, because an option that hands its value to a shell can attach that value rather than
# spell it as a second word: `split --filter=CMD`, `sort --compress-program=CMD`, `git -c core.pager=CMD` were
# all still allowed when the two-token forms were refused (review-193b). The walk stops only at
# a head that cannot execute a later token — $NOEXEC, things that read, print, match, move or delete an
# argument and never run one. A head this does not know is walked THROUGH: an unlisted spelling costs a FALSE POSITIVE, never a
# bypass, which is the kill fence's own shape (refuse what you cannot reduce) applied to the anchor.
# NOEXEC is deliberately short and dull. Anything that can run an argument — a shell, an interpreter, awk, sed
# (GNU `e`), find (-exec), xargs, ssh, env, systemd-run, tmux, gh, git, cc — is NOT on it and never should be.
# SEVEN THAT LOOK DULL AND ARE NOT, and they came off in two rounds because the test was stated before it was
# applied. After review-193b: `split --filter=CMD` and `sort --compress-program=CMD` both hand their argument to
# sh, and `man -P PAGER` runs the pager. After the round behind that: `rg --pre CMD` and `--hostname-bin CMD`,
# `ag --pager CMD`, `ack --pager=CMD` and `wget --use-askpass=CMD`. All seven read files, so all seven read as
# text tools — but each has one option that executes, and flush() returns at the first NOEXEC head, so listing
# them stopped the walk and left everything after them unanchored. The test for this list is not "does it read?"
# but "is there any option that runs a word?"; when in doubt leave a head OFF, which costs a false positive and
# never a bypass. `grep` and `curl` are the near neighbours that stay: neither has an option that runs a word.
# The log readers on it earn their place: `last -x reboot shutdown` names two gated words and runs neither,
# and refusing that is the complaint already on the backlog about a worker blocked for grepping "reboot".
# IT IS ONE SHELL STRING AND IT HAS NO COMMENTS IN IT. A `#` inside single quotes is a word, not a comment,
# so a note written here would put its own words — `reboot`, `shutdown` — on the list of heads the walk stops at.
NOEXEC=': [ [[ true false test echo printf cd pwd export unset set local declare readonly read shift return
  break continue wait jobs sleep seq date basename dirname realpath readlink mktemp
  cat tac head tail nl wc uniq cut tr rev fold column comm join paste csplit tee
  grep egrep fgrep diff cmp jq yq
  ls stat file du df tree touch mkdir rmdir rm cp mv ln install chmod chown chgrp truncate dd
  md5sum sha1sum sha256sum cksum base64 xxd od strings hexdump
  ps pgrep pkill kill killall top free uptime uname hostname whoami id groups tty which type
  last lastb lastlog journalctl dmesg w who users
  curl ping dig host nslookup less more'
# TWO BOUNDS, AND BOTH ARE PER STATEMENT, WHICH IS THE WHOLE POINT OF THEM. The walk is quadratic in the
# length of a STATEMENT, and a single statement of 3000 words (`for f in <3000 paths>`) cost 27 seconds in a
# PreToolUse hook — so at most 64 positions and 262144 bytes of expansion FOR EACH STATEMENT, reset in flush().
# A budget spent across the whole command was a bypass and not a bound: `for f in <3000 args>; do :; done;
# timeout 5 tmux kill-server` exhausted it in the first statement and the second was never walked, so the
# universal gate never saw the stop (review of #193). What the bounds cost is one statement, never the command:
# a wrapper prefix longer than 64 words, or a single statement whose suffixes exceed 256 KB — `nice -n 5`
# eleven times over. That is the same honest ceiling as a pid held in a variable: this stops accidents and
# casual prompt-injection, not somebody who has read the file. Neither binds on real work — on the ten longest
# commands this box has ever run the walk is not measurable, because a long command line is many short
# statements or a heredoc, and heredoc bodies are dropped above.
# A QUOTED STRING IS AN ARGUMENT, NOT A COMMAND POSITION — the same rule as a heredoc body above, and for the
# same reason: `git commit -m "no cp into ~/bin"` is a message ABOUT a command, and the suite has asserted since
# the write fence landed that it must not be refused. So a quoted run is ONE token to the walk: a command
# position may START at the quote — something could run the whole string — and never in the MIDDLE of it.
# WHAT THAT COSTS, PLAINLY: a quoted string whose FIRST word is a gated command IS refused — `git commit -m
# '<a gated command> did x'` is denied where `git commit -m 'no <gated command> here'` is not, and the leading
# word is the whole difference. It is kept that way deliberately, because the position that reads the message
# is the position that reads `su -c '<a gated command>'`; both sides are asserted below (review of #193).
# THE SAME FENCE AS THE HEREDOC KEEPS IT HONEST: when anything on the line could EXECUTE a string ($Q — a shell,
# an interpreter, eval, xargs, ssh, sudo, systemd-run), the quotes are ignored and the line is walked as raw
# text as well, so `bash -c "timeout 5 pkill x"` still puts `pkill x` in command position. A line that ENDS
# inside a quote is walked raw too. Both fences fail CLOSED, and both only ever ADD positions.
# $Q IS THE ONE LIST IN HERE WHOSE GAP IS A BYPASS RATHER THAN A FALSE POSITIVE, so it carries everything
# that runs a STRING, not just the shells: `su -c '<wrapper> <command>'` was allowed while `su -c '<command>'`
# was refused, because a quoted run is one token and only its FIRST word is a command position — the interior
# is walked only when this says something on the line could execute it. Anything that takes a command as an
# argument as a STRING belongs here — `su -c`, `runuser -c`, `script -c`, `flock … -c`, `watch` (which runs
# its argument through sh). Wrappers that take an ARGV rather than a string (chroot, nsenter, setsid, nice)
# do not: the walk already steps past those. Each entry costs a false refusal when its word appears in quoted
# prose beside a gated command, which is why this list is the string-runners and not every wrapper.
Q='(^|[^A-Za-z0-9_.-])(bash|sh|zsh|ksh|dash|python[0-9.]*|perl|ruby|node|php|awk|sed|eval|exec|source|[.]|xargs|env|ssh|sudo|su|runuser|script|watch|flock|systemd-run)([^A-Za-z0-9_.-]|$)'
cmdpos(){   # every position in $1 a command could START at, one per line, original text first
  awk -v NE="$NOEXEC" -v Q="$Q" '
    BEGIN { m = split(NE, a, /[ \t\n]+/); for (i = 1; i <= m; i++) if (a[i] != "") noexec[a[i]] = 1
            SQ = sprintf("%c", 39); MK = sprintf("%c", 1)     # the two bounds are per statement: see flush()
            for (i = 1; i < 128; i++) ORD[sprintf("%c", i)] = i }   # …and ansic needs a code back from a char
    # A BACKSLASH IS NOT PART OF A COMMAND NAME. `\cc other --go` runs cc — the shell drops the backslash and
    # only skips alias lookup — and `awk "BEGIN{system(\"cmd\")}"` hands awk the same string the single-quoted
    # spelling does. Neither matched a rule, because every rule reads a NAME at ^ (adversarial review of #243).
    # So the escape comes off before matching, here and in flatln. (No literal apostrophe in here: see below.)
    # A DOUBLED backslash is ONE backslash, which by the line above is still not part of a name: `bash -c
    # "\\echo hi; \\cc other t1 --go"` left `\cc` behind the real separator here (2nd adversarial review), so
    # `\\` reduces the whole way. flatln does the same, in double quotes and bare alike.
    # A DOLLAR-QUOTE IS ANSI-C QUOTING, AND THE SHELL RESOLVES IT BEFORE IT READS A NAME. Spelled $ + SQ + body
    # + SQ, `\x63c other t1 --go` dispatches, `\x67h pr merge 1` merges, `\x63c-land 7` lands and `\x64ocker
    # run -v /:/host alpine` opens the host — none of them reached a rule, because every rule reads a NAME at ^
    # and what stood there was $ backslash x63c (3rd adversarial review of #243). So the escapes are resolved
    # here and in flatln, the same way a doubled backslash is: \xHH, \NNN, \n, \t, \r, and a doubled backslash
    # (reduced the whole way — a backslash is not part of a name); anything else is the character itself, the
    # escaped quotes included. A dollar-quote that never closes on the line is left exactly as it was typed.
    # (No literal apostrophe in any of this: the whole awk is one bash single-quoted string, and SQ is the char.)
    function ansend(s, i,   n, c) {   # the SQ that closes a dollar-quote whose body starts at i; 0 = never closes
      n = length(s)
      for (; i <= n; i++) { c = substr(s, i, 1)
        if (c == "\\") { i++; continue }
        if (c == SQ) return i }
      return 0
    }
    function ansnum(h, base,   i, v) { v = 0
      for (i = 1; i <= length(h); i++) v = v * base + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
      return v }
    # \u AND \U ARE THE SAME ESCAPE IN LONGER HEX, AND \cX IS A CONTROL CHARACTER: `\u0063c other t1 --go`
    # dispatched with none of them read (4th adversarial review of #243). \cX also SPELLS the statement mark,
    # which is why nothing here may emit one — the mark is the walk, never the command (see hay).
    function ansic(s,   i, n, c, d, h, v, out) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (c != "\\") { out = out c; continue }
        d = substr(s, ++i, 1); h = ""; v = -1
        if (d == "x" || d == "u" || d == "U") { v = (d == "x" ? 2 : (d == "u" ? 4 : 8))
                        while (length(h) < v && substr(s, i + 1, 1) ~ /^[0-9A-Fa-f]$/) h = h substr(s, ++i, 1)
                        if (h == "") { out = out d; continue }
                        v = ansnum(h, 16) }
        else if (d ~ /^[0-7]$/) { h = d
                        while (length(h) < 3 && substr(s, i + 1, 1) ~ /^[0-7]$/) h = h substr(s, ++i, 1)
                        v = ansnum(h, 8) }
        else if (d == "c") { d = substr(s, ++i, 1)           # ctrl-X: the letter with bit 7 cleared
                        if (d == "") continue
                        v = ORD[toupper(d)] % 32 }
        else if (d == "n") v = 10
        else if (d == "t") v = 9
        else if (d == "r") v = 13
        else if (d == "\\") continue
        else { out = out d; continue }
        # ONLY A PRINTABLE ASCII CHARACTER COMES BACK OUT. sprintf("%c") TRUNCATES a value it cannot hold, so the
        # surrogate range re-spelled the two characters this must never emit: \ud801 came back as byte 0x01, the
        # statement mark, and \ud80a as a newline (5th adversarial review of #243). A NEWLINE OR CR SPELLED
        # DIRECTLY does the same: \n, \x0a, \012 and \cJ (all v=10) split a marked statement line, so the half
        # after it lands UNMARKED and its cd is never walked — a write past it passed (7th adversarial review of
        # #243). So 10 and 13 are excluded like the mark: anything outside 2..127, or a newline/CR, is a
        # placeholder — a `?`, which is no part of a name and makes a path carrying it unresolvable. (No literal
        # apostrophe in this note: the whole awk is one bash single-quoted string, and one would close it.)
        if (v > 1 && v < 128 && v != 10 && v != 13) out = out sprintf("%c", v)
        else if (v >= 0) out = out "?" }                     # \0 names nothing; \1 is the mark, \n/\r split a statement; the rest is a ?
      return out
    }
    function unesc(s,   i, n, c, j, out) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (c == "$" && substr(s, i + 1, 1) == SQ) {         # a dollar-quote: resolved before a rule reads it
          j = ansend(s, i + 2)
          if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
        if (c == "\\") {
          if (substr(s, i + 1, 1) == "\\") { i++; continue }
          out = out substr(s, i + 1, 1); i++; continue }
        out = out c }
      return out
    }
    function strip(s) { s = unesc(s); gsub("[\"" SQ "]", "", s); return s }
    # A METACHARACTER INSIDE QUOTES IS PROSE, NOT A SEPARATOR — it is inert in a real shell too, so a note or a
    # commit message that reads `step one; cc foo --go` or `writes to > ~/bin/x` must not read as a second command
    # or a redirect (2026-09-04: an odoo session was refused for a repo its heredoc/echo only DESCRIBED). flatln
    # drops the quote chars like strip, but blanks the metacharacters between them first. The one thing it must NOT
    # blank is a substitution that still RUNS: `"$(cmd)"` and a backtick in DOUBLE quotes execute, so those are kept
    # and still reach the rules — only single quotes, where every one of them is literal, blank the lot. `(){}` are
    # kept in "" as well, because telling a literal `(` from the `(` of `$(` needs lookback this does not do, and a
    # false refusal is the safe way to be wrong. Used only where the quotes are BALANCED (the raw line and the
    # quote-aware flush); the quote-blind interpreter walk keeps strip, so a quoted string an interpreter runs is
    # still read as a command. (No literal apostrophe here: this whole awk is one bash single-quoted string — SQ is.)
    # TWO THINGS A DOUBLE-QUOTED STRING STILL RUNS (landing review of #243): a substitution — from $( or an unescaped
    # backtick the shell EXECUTES the interior, so a separator or redirect there is real — and a backslash, which
    # escapes the next character, so \" does not close the string. scan() reads both the same way.
    # A SUBSTITUTION IS VERBATIM UNTIL IT CLOSES. Blanking must not resume inside $( ) — the shell EXECUTES that
    # text, so a separator or a redirect in there is real — but running the verbatim tail to the end of the LINE
    # refused every quoted prose behind a substitution: `echo "$(date)" && git commit -m "step; <a gated command>
    # was blocked"` (adversarial review of #243). So the tail ends where the substitution itself closes, and
    # finding that close is why plain paren counting is not enough: a `)` inside $( ) need not be a close — a
    # `case` pattern is the ordinary one — so while a `case … in` is open and no `esac` has closed it, a `)`
    # closes that pattern and not the substitution. Quotes in there hold their parens too, and one that never
    # closes on the line stays verbatim to the end: fail closed, which is what the whole-line tail did for every
    # line. $(( )) arithmetic and a nested $( ) need no case of their own: their parens count like any other.
    function flatln(s,   i, n, c, q, j, out, insub, dep, co, cw, cq) {
      q = ""; out = ""; n = length(s); insub = 0; dep = 0; co = 0; cw = ""; cq = ""
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (insub) {                                              # inside a substitution: a separator or redirect in
          # …AND THE SHELL STILL PARSES THE INTERIOR. It once emitted every char verbatim, so a command name quoted
          # inside $( ) or `` never landed at ^: `echo "$( "docker" run …)"` flattened with the quotes still on and
          # $AT could not cross them, reopening the whole gate list (paid review of #243). The quote chars drop and
          # \ reduces the way they do outside a substitution; only the metacharacters, which RUN here, stay verbatim.
          if (insub == 2) {                                        # here IS real and kept — the tail runs to ITS close
            if (c == "$" && substr(s, i+1, 1) == SQ) {             # a dollar-quote (ANSI-C) inside a backtick substitution: resolve it so a name spelled that way still anchors
              j = ansend(s, i + 2)
              if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
            if (c == "\\") { out = out substr(s, i+1, 1); i++; continue }
            if (c == "`") { out = out c; insub = 0; continue }     # a backtick closes on the next backtick
            if (c == "\"" || c == SQ) continue                     # a quote drops the way strip drops it
            out = out c; continue }
          if (cq != "") { if (cq == "\"" && c == "\\") { out = out substr(s, i+1, 1); i++; continue }
                          if (c == cq) { cq = ""; continue }        # the closing quote drops; a paren in there is no close
                          out = out c; continue }
          if (c == "$" && substr(s, i+1, 1) == SQ) {                # a dollar-quote (ANSI-C) inside the substitution: resolve it so a name spelled that way still anchors
            j = ansend(s, i + 2)
            if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
          if (c == "\\" && substr(s, i+1, 1) == "\\") { i++; continue }   # \\ is one backslash, and no part of a name
          if (c == "\\") { out = out substr(s, i+1, 1); i++; continue }   # \X is X
          if (c == "\"" || c == SQ) { cq = c; continue }            # the opening quote drops
          if (c ~ /[A-Za-z]/) { out = out c; cw = cw c; continue }   # …the word just ended: was it case or esac?
          if (cw == "case") co++; else if (cw == "esac" && co > 0) co--
          cw = ""
          if (c == "(") dep++
          else if (c == ")" && co == 0) { dep--; if (dep <= 0) { insub = 0; dep = 0 } }
          out = out c; continue }
        if (q != "") {
          if (q == "\"" && c == "\\" && substr(s, i+1, 1) == "\\") { i++; continue }   # see the \\ note below
          if (q == "\"" && c == "\\") { out = out substr(s, i, 2); i++; continue }   # an escape: \" does not close
          if (c == q) { q = ""; continue }                          # the closing quote: dropped, as strip drops it
          if (q == "\"" && c == "`") { insub = 2; out = out c; continue }
          if (q == "\"" && c == "$" && substr(s, i+1, 1) == "(") {   # a substitution: it RUNS, so it is verbatim
            insub = 1; dep = 1; co = 0; cw = ""; cq = ""; out = out "$("; i++; continue }
          if (index(";&|<>", c) > 0) c = " "                        # a separator/redirect: literal in either quote
          else if (q == SQ && index("(){}`$", c) > 0) c = " "       # single quotes make these literal too; double may run them
          out = out c; continue }
        # A DOUBLED BACKSLASH IS ONE BACKSLASH, AND A BACKSLASH IS NOT PART OF A NAME. `"\\cc"` is the string
        # \cc, which is what `bash -c` then RUNS as cc — keeping both characters left `\cc` at ^ and every rule
        # reads a NAME there, so `bash -c "\\cc other t1 --go"`, `eval "\\cc-land 7"` and `\\docker run …` all
        # walked past the gate list (2nd adversarial review of #243). Both characters go, in "" and bare alike.
        if (c == "$" && substr(s, i+1, 1) == SQ) {                  # a dollar-quote: ANSI-C, see ansic above
          j = ansend(s, i + 2)
          if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
        if (c == "\\" && substr(s, i+1, 1) == "\\") { i++; continue }
        if (c == "\\") { out = out substr(s, i+1, 1); i++; continue }   # \cc IS cc — and an escaped quote still opens nothing
        if (c == "\"" || c == SQ) { q = c; continue }               # the opening quote: dropped
        out = out c }
      return out
    }
    function flush(t, nt, qa,   i, j, h, v, out, tail, budget) {   # every suffix of one statement, quotes off on the way out
      budget = 262144                                   # PER STATEMENT. As a per-command budget, one long
      for (i = 1; i <= nt && i <= 64 && budget > 0; i++) {  # statement switched the walk off for every later one
        h = strip(t[i]); sub(/^.*\//, "", h)            # /usr/bin/timeout is timeout
        if (h in noexec) return                         # it cannot run t[i+1]: nothing after this is a command
        tail = ""; for (j = i + 1; j <= nt; j++) tail = tail " " t[j]
        if (i < nt) { out = substr(tail, 2); budget -= length(out) + 1
          print (qa ? flatln(out) : strip(out)) }       # …but a word this does not know might, so walk past it
        v = strip(t[i])                                 # "an --opt=VALUE whose value is a command has to reach
        if (match(v, /=/) && RSTART < length(v)) {      #  command position the same way an --opt VALUE one does"
          out = substr(v, RSTART + 1) tail; budget -= length(out) + 1
          print strip(out) }                            # strip, NOT flatln: `--filter=CMD` hands CMD to a shell, so
      }                                                 # loop above never reaches it: split it off at the first =
    }
    function scan(line, qa,   i, n, c, q, cur, nt, t) {   # returns non-empty if the line ended inside a quote
      q = ""; cur = ""; nt = 0; n = length(line)
      for (i = 1; i <= n; i++) { c = substr(line, i, 1)
        if (q != "") { if (q == "\"" && c == "\\") { cur = cur substr(line, i, 2); i++; continue }   # \" does not close
                       cur = cur c; if (c == q) q = ""; continue }
        if (c == "\\") { cur = cur substr(line, i, 2); i++; continue }   # \| is an escaped char, not a pipe
        if (qa && (c == "\"" || c == SQ)) { q = c; cur = cur c; continue }
        if (c == " " || c == "\t") { if (cur != "") { t[++nt] = cur; cur = "" }; continue }
        if (c == "$" && substr(line, i+1, 1) == "(") { if (cur != "") t[++nt] = cur
          flush(t, nt, qa); delete t; nt = 0; cur = ""; i++; continue }
        # `{}` GLUED IS THE PLACEHOLDER find PASSES, NEVER A COMMAND GROUP — a group needs a space after the
        # brace, and splitting on it truncated the statement before its target: `find -exec cp {} ~/bin/cc-guard`
        # put a bare `cp` at ^ with nothing after it, so the write fence had no target to judge and it overwrote a
        # live binary (3rd adversarial review of #243). Only the adjacent pair is a word; `{ cd x; …` still splits.
        if (c == "{" && substr(line, i+1, 1) == "}") { cur = cur "{}"; i++; continue }
        if (index(";&|(){}`", c) > 0) { if (cur != "") t[++nt] = cur
          flush(t, nt, qa); delete t; nt = 0; cur = ""; continue }
        cur = cur c }
      if (cur != "") t[++nt] = cur
      flush(t, nt, qa)
      return q
    }
    # A STATEMENT LINE IS MARKED, A SUFFIX IS NOT. The first whole-line print below is the command AS THE SHELL
    # RUNS IT; every other line the walk emits is a SUFFIX, which is argument text — `git commit -m "cd /tmp"`
    # emits `cd /tmp` on a line of its own. Read as a statement that moved the shell, so a real `cd ~/dev/other`
    # on the line before could be cancelled by a quoted one and the write after it went through, and a message
    # naming `popd` emptied the base and refused an ordinary write (3rd adversarial review of #243). Only the
    # cd/pushd/popd walk cares which is which, so the mark is a \001 the caller strips off for every other rule.
    { print MK flatln($0)                               # the line as typed, but a metachar inside quotes is inert
      # …AND THE RAW LINE TOO whenever the quote-blind rescan runs. The rescan only emits SUFFIXES, so the raw
      # print is the one line that puts the SECOND statement of an interpreter string in command position:
      # `bash -c "x; cc other t1 --go"` was refused by strip($0) and passed flatln($0) alone (security review).
      # …SO ONE SOURCE LINE IS WALKED AS A STATEMENT TWICE, AND A RELATIVE cd MOVED THE BASE TWICE — to a dir the
      # shell never stands in. From ~/dev/<h>/sub, an sh -c string holding `cd ../.. && sed -i s/x/y/ f` really
      # writes ~/dev/f and PASSED on a base gone a level too far, while `cd .. && sed -i s/x/y/ f` writes the dir
      # the member owns and was refused (paid review of #243). An absolute cd is idempotent under a double
      # application, which is why every case so far missed it. Neither print can just drop the mark: the quote-
      # aware one is what keeps a quoted `cd` in a commit message from cancelling a real one (case 29), and the
      # raw one is the only reading that sees the cd in `bash -c "echo x; cd ~/dev/other; write"`, where the
      # quote-blind statement is the one the shell really runs. So the RAW line is announced as a re-reading of
      # the SAME source line — a line that is the mark and nothing else — and the walk rewinds the base to where
      # the line started before it walks it again, keeping whichever reading moved. THE REWIND IS TWO MARKS
      # because ONE is a line cmdpos already prints: an empty pair of quotes flattens to nothing, so the mark
      # in front of it stands alone, and read as a rewind it undid the cd on the line BEFORE — a source line of
      # a cd into another repo, then that empty pair, then a write, went through (first cut of this same fix).
      # A statement line is a mark and its text, so it can never spell two. NOTE no apostrophe survives in here:
      # this comment sits inside the single-quoted awk program, and one closed it (this fix, again).
      if (scan($0, 1) != "" || $0 ~ Q) { print MK MK; print MK strip($0); scan($0, 0) } }' <<<"$1"
}
hay(){   # the text the rules match: heredoc bodies out, quotes stripped, every command position at ^
  local c=$1
  # THE MARK IS THE WALK'S, NEVER THE COMMAND'S. cmdpos marks a statement line with a \001, and the command text
  # is a member's to write: `git commit -m "<0x01>cd ~/dev/ws1"` put a marked line in the haystack, so a quoted cd
  # was read as a statement again and cancelled a real one (4th adversarial review of #243). It comes off the text
  # before the walk ever sees it — here, once, so no path into cmdpos can carry one; ansic never emits one either.
  c=${c//$'\001'/}
  case "$c" in *'<<'*) c=$(awk -v X="$X" '
      BEGIN { SQ = sprintf("%c", 39) }
      { L[NR] = $0 }
      # A `<<` INSIDE QUOTES OR BEHIND A `#` OPENS NOTHING. This pre-pass was quote- and comment-blind, so
      # `echo \047<< EOF\047` opened a heredoc bash never opens and every line down to the next EOF left the
      # haystack — with it the tmux fence, the gate list and the write fence, all of them, for a payload
      # anybody can write (6th adversarial review of #243). A quoted `<<` is text and a `#` at the start of a
      # word ends the line, so the walk below finds the first `<<` the SHELL would read, or none at all.
      function hdpos(s,   i, n, c, q) {
        n = length(s)
        for (i = 1; i <= n; i++) { c = substr(s, i, 1)
          if (q != "") { if (q == "\"" && c == "\\") i++; else if (c == q) q = ""; continue }
          if (c == "\\") { i++; continue }
          if (c == "\"" || c == SQ) { q = c; continue }
          if (c == "#" && (i == 1 || substr(s, i - 1, 1) ~ /[ \t;&|(]/)) return 0   # a comment: nothing after it runs
          if (c == "<" && substr(s, i + 1, 1) == "<") return i }
        return 0
      }
      # AN UNQUOTED DELIMITER EXPANDS THE BODY, AND AN EXPANSION IS A COMMAND. `cat > note.md <<EOF` over
      # `$(cc other t1 --go)` really dispatches, and the same body could read the credentials, merge a PR or
      # copy over a live binary through a backtick — every one of them was dropped as prose (5th adversarial
      # review of #243). `<<QUOTED` and `<<-\047EOF\047` are literal and still go. So the delimiter says which:
      # bare, the body lines carrying a substitution or a parameter stay in the haystack, and the rest of the
      # body — the prose this whole drop exists for — still goes.
      # …AND A BACKSLASH AT THE END OF A BODY LINE JOINS THE NEXT ONE, so a substitution spread over two lines
      # was tested one line at a time and neither half carried the whole of it: `$(cp /dev/null \\` over
      # `~/bin/cc-guard)` truncated a live binary (6th adversarial review of #243). The lines are joined the
      # way the shell joins them, and the join is what gets tested.
      END { b = 0; bq = 0; hb = ""
        for (i = 1; i <= NR; i++) {
          if (b) { if (L[i] ~ t) { if (hb ~ /[$][({]|`/) print hb; b = 0; hb = ""; continue }   # a body line held open by a trailing backslash JOINS this delimiter line: its pending substitution stays in the haystack, untested it truncated a live binary (7th adversarial review of #243)
                   if (bq) continue
                   hb = hb L[i]
                   if (hb ~ /\\$/) { sub(/\\$/, "", hb); continue }   # continued: the next line is the same line
                   if (hb ~ /[$][({]|`/) print hb
                   hb = ""; continue }
          print L[i]                                        # the line that OPENS a heredoc is still a command
          n = hdpos(L[i]); if (n == 0) continue
          head = substr(L[i], 1, n - 1); rest = substr(L[i], n + 2)
          if (index(rest, "<<") > 0) continue               # two on one line: too clever to reason about
          if (!match(rest, "^-?[ \t]*[\"\047]?[A-Za-z_][A-Za-z0-9_]*")) continue   # `<<<` and shifts are not heredocs
          w = substr(rest, RSTART, RLENGTH)
          bq = (w ~ "^-?[ \t]*[\"\047]")                    # a quoted delimiter: the body is literal, all of it
          sub("^-?[ \t]*[\"\047]?", "", w)
          if (head ~ X) continue                            # the body would be RUN: it stays in the haystack
          t = "^[ \t]*" w "[ \t]*$"
          for (j = i + 1; j <= NR; j++) if (L[j] ~ t) { b = 1; hb = ""; break }
        } }' <<<"$c");; esac
  cmdpos "$c"          # …which strips the quotes itself: it needs them to tell an argument from a command
}
if [ "$tool" = Bash ]; then   # universal gate, ALL sessions (interactive ones and their subagents included): nothing may kill the shared tmux server
  uk=$(hay "$(jq -r '.tool_input.command // ""' <<<"$inp")")   # …with the statement lines marked: see cmdpos
  u=${uk//$'\001'/}   # every rule but the cd walk reads a NAME at ^, so the mark comes off here, not in a second pass
  { grep -qE "$AT"'(tmux +kill-se[rs]|(pkill|killall)( +-[^ ]+)* +tmux|systemctl +--user +(restart|stop|kill) +tmux-main)' <<<"$u" \
    || grep -qE 'send-keys[^;&|]*tmux +kill-se[rs]' <<<"$u"; } && { echo "cc-guard: blocked — that takes the shared tmux server (every session on the box) down (\$TMUX beats TMUX_TMPDIR; use tmux -S <path> for scratch servers)" >&2; exit 2; }   # `tmux -S <path> kill-server` still passes: the pattern wants kill-se* right after tmux
fi
role="${CC_ROLE:-}"; steward=""; mdir=""; mws=""; root=""; trepo=""; ttrack=""   # $root: the ONE tree this session writes (rule 5 below)
# THE STEWARD IS A WORKER THAT MAY NOT SPEND. cc-steward runs one headless `claude -p` per routine event, on the
# cheap model and unattended — which is the worst thing to leave at the widest tier. There is no marker to walk
# to: its cwd is ~/.cc/steward/<repo>, deliberately not a worktree (cc-steward, RUNS), so $CC_ROLE is the whole
# tell. It maps onto the worker tier — every rule below applies to it unchanged — plus the steward block in the
# Bash case, which is the member tier's "no spend, no leak" set. Strictly narrower than worker, so nothing here
# widens a non-owner tier; a marker walk can still promote it to member, which is stricter again.
case "$role" in steward) steward=1; role=worker;; esac
track_dir(){   # $1 holds a .cc/track marker: rc 0 = a real track worktree, and role/root/repo/track are set from its PATH
  # A TRACK WORKTREE LIVES UNDER ~/.cc/worktrees/<repo>/<track> — `cc` makes them nowhere else — and ONLY THERE does
  # .cc/track mean anything. Anywhere else it is a file somebody wrote, and the walk goes on past it to whatever
  # marker sits above: honouring one in ~/dev/<h>/sub set role=worker there and handed that member the worker
  # tier — the box's config and another repo's dispatch (review 2, C).
  # A TRACK OF A MEMBER WORKSPACE IS STILL THAT MEMBER'S WORLD. The worktree lives under ~/.cc/worktrees, so its
  # own marker says "worker" and would PROMOTE a member's worker out of the member tier — the one thing the
  # workspace rule below must not allow. The rule follows the repo, not the worktree.
  # WHICH repo comes from the worktree's PATH ($HOME/.cc/worktrees/<repo>/<track>), not from .cc/track: that
  # file is inside the tree the worker may edit, so its first line is a claim, not an identity.
  local r t
  case "$1" in "$HOME"/.cc/worktrees/*/*) r=${1#"$HOME"/.cc/worktrees/}; t=${r#*/}; t=${t%%/*}; r=${r%%/*};; *) return 1;; esac
  case "$r$t" in *[!A-Za-z0-9._-]*) r=""; t="";; esac
  root=$1; trepo=$r; ttrack=$t
  if [ -n "$r" ] && [ -f "$HOME/dev/$r/.cc/member-workspace" ]; then role=member; mdir="$HOME/dev/$r"; mws="$r"
  else [ "$role" = member ] || role=worker; fi
}
d="$cwd"                         # walk up for a marker — one stat per level, no config to parse. A marker only makes the
while [ -n "$d" ] && [ "$d" != / ]; do   # gates STRICTER (member wins over an inherited CC_ROLE=worker) and never clears the env role.
  if [ -f "$d/.cc/member-facing" ]; then role=member; mdir="$d"; root="$d"
    # A MEMBER WORKSPACE root: see below. Its handle is the DIRECTORY NAME — ~/dev/<handle>, nothing else — and
    # never the marker's contents: every file under this dir is the member's own to edit, so a handle read out of
    # one is a handle the session can rewrite (one line naming the box's repo would hand it that repo's authority).
    [ -f "$d/.cc/member-workspace" ] && [ "$d" = "$HOME/dev/${d##*/}" ] && mws=${d##*/}
    break; fi   # a session anybody in Slack can talk to
  if [ -f "$d/.cc/track" ] && track_dir "$d"; then break; fi
  d=$(dirname "$d"); done
# A WORKER THAT `cd`s OUT OF ITS WORKTREE walks past no marker at all, and was fenced by its cwd — by wherever it had
# just gone. The transcript path names the dir the session STARTED in (Claude Code slugs it: / and . become -), and
# that is the worktree whatever the cwd says now. Env-only role and no marker: match the slug against the worktrees.
if [ -z "$root" ] && [ "$role" = worker ]; then
  slug=$(jq -r '.transcript_path // ""' <<<"$inp"); slug=${slug%/*}; slug=${slug##*/}
  if [ -n "$slug" ]; then for w in "$HOME"/.cc/worktrees/*/*; do s=${w//\//-}; s=${s//./-}
    [ "$s" = "$slug" ] || continue; [ -f "$w/.cc/track" ] && track_dir "$w"; break; done; fi
fi
case "$mws" in *[!a-z0-9-]*) mws="";; esac   # the handle goes into a regex below: [a-z0-9-] or nothing at all
# $mdir is the member-facing session dir, and its basename is its Slack channel: the refusal below is posted there.
# An OVERLAPPING HANDOFF (cc-handoff): two sessions share this cwd, and exactly one of them is LIVE. The other
# may read, search, think and ask its peer — it may not act on the world. A marker file could not do this: the
# walk above is keyed on the cwd, which both sessions share, so it would gate the live one too. The keys here
# are per-session instead — the payload's session_id for the predecessor (already running when the overlap
# opened, so nothing could be put in its env) and $CC_HANDOFF for the successor (`cc __runnext` exports it;
# the hook is a child of the claude process, not of the Bash tool, so the model cannot unset it).
# SYMMETRIC ON PURPOSE: after cutover the PREDECESSOR is the non-live one, and a retired session that lingers
# must not push a stale branch. Every unreadable case falls the same way — the successor is gated, the
# predecessor is not — so a broken record can never leave the channel ownerless.
handoff_gated=""
if [ -n "${CC_HANDOFF:-}" ] || [ -d "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}" ]; then
  sid=$(jq -r '.session_id // ""' <<<"$inp"); seen=""; wid=""
  for rec in "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}"/*.json; do
    [ -f "$rec" ] || continue
    # the pane's window too: a planning predecessor's session_id is EMPTY on the record (unknown at --overlap time)
    [ -n "$wid" ] || [ -z "${TMUX_PANE:-}" ] || wid=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)
    v=$(jq -r --arg sid "$sid" --arg wid "$wid" --arg hid "${CC_HANDOFF:-}" '
      if ((.id // "") == "" or (.target // "") == "") then "" else
        (if .live == "successor" then "successor" else "predecessor" end) as $l |
        (if $l == "successor" then "predecessor" else "successor" end) as $o |
        if ($hid != "" and .id == $hid) then (if $l == "successor" then "mine" else "mine gate" end)
        elif ($sid != "" and ((.[$o].session_id // "") == $sid)) then "gate"
        elif ($wid != "" and ((.[$o].tmux // "") == $wid)) then "gate"
        else "" end
      end' "$rec" 2>/dev/null) || v=""
    case " $v " in *" mine "*) seen=1;; esac
    case " $v " in *" gate "*) handoff_gated=1;; esac
  done
  # $CC_HANDOFF with no record to justify it (missing, corrupt, unreadable) = the successor stays gated —
  # UNLESS the handoff FINISHED. `cc-handoff --retire` ends with clear(), so a record that is gone because
  # everything went RIGHT looks exactly like one lost because something went WRONG; retirement therefore
  # leaves a <id>.done marker first, and that marker is the whole difference. Without it the last step of a
  # handoff bricks the session that won it — 2026-08-31, the survivor lost dispatch, PRs and pushes for the
  # rest of its life, and could not even dispatch the fix for its own gate. Only ever WITHHOLDS the gate,
  # never lifts one: a session gated by the record of a LATER handoff stays gated by it.
  if [ -n "${CC_HANDOFF:-}" ] && [ -z "$seen" ]; then
    retired=""
    case "$CC_HANDOFF" in
      ""|*[!A-Za-z0-9_-]*) ;;   # not a record id, so never a path we build: a corrupt env gates like a corrupt record
      *) [ -f "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}/$CC_HANDOFF.done" ] && retired=1;;
    esac
    [ -n "$retired" ] || handoff_gated=1
  fi
fi
[ -n "$handoff_gated" ] && [ "$role" != member ] && role=worker   # the four owner gates below, at least
case "$role" in worker|member) ;; *) exit 0;; esac
[ -n "$root" ] || root=$cwd   # nothing to anchor on (an env-only role, a handoff-gated session): the cwd, as before
in_root(){ case "$1" in "$root"|"$root"/*) return 0;; esac; [ -n "$mdir" ] && case "$1" in "$mdir"|"$mdir"/*) return 0;; esac; return 1; }
# A MEMBER REFUSAL IS A QUERY TO THE BOX, NOT A LINE IN THE MEMBER'S CHANNEL. Until now a member-facing deny put a
# 🔐 line in the member's own channel (which the members read) and DM'd the owner. The owner's call (2026-09-04): a
# member session "should have enough permissions to do stuff. These errors should just be routed to you instead" —
# to the box's queries session, in a queries channel (owner + box only), which approves it, answers it, or turns it
# into a board row / message for the planning session; the owner hears only what that session cannot settle.
# So a member refusal RECORDS a query and does nothing else here: nothing in the member's channel, no page to the
# owner. The record is a line in ~/.cc/state/<workspace>/queries.spool — a member sandbox has no tmux and no owner
# socket, but it CAN write its own state dir (the sandbox binds it rw), and the host drains that spool (cc-msg
# --drain): one line into the queries channel, and the query delivered to the queries session — the planning
# session when no queries session is up. core/ never names the channel or the session: those are cc-config keys the
# box sets, so nothing here is this box's identity. WORKER AND HANDOFF DENIALS ARE UNTOUCHED — they have a board, a
# journal and a STATUS: BLOCKED line — and so are the owner's own channels. The member session still gets its stderr.
# TWO CLASSES, KEPT IN THE RECORD. `deny` = the owner could say yes (merging, pushing, a comment in his name): class
# "page". `never` = no yes exists for this tier (landing, dispatching, host changes): class "nopage" — the queries
# session still sees it (a guard rule that should have allowed it is a patch for the planning session, not an
# approval) but knows not to ask for a yes that cannot exist. `never` with a SECOND arg records NOTHING: a write the
# session aimed outside its own tree is its own to fix from the stderr line, not a question for anyone (2026-09-04).
# Bounded: nothing runs unless role=member, and one query per workspace+reason per ASK_TTL, so a session retrying a
# blocked command does not fill the spool. A path in the reason is dropped from that key (a list of files refused by
# one rule is one query); the record keeps the reason and the command, each cut to 2 KB.
ASKS="${CC_GUARD_ASKS:-$HOME/.cc/guard-asks}"; ASK_TTL="${CC_GUARD_ASK_TTL:-1800}"
record_query(){   # $1 = reason (why); $2 nonempty = class "page" (owner could approve), empty = "nopage"
  local why=$1 page=${2-1} qkey key was now sp lock rec class qc wr   # ${2-1}, never ${2:-1}: `never` passes an EMPTY page
  # A SESSION GATED BY $CC_ROLE ALONE HAS NO WORKSPACE TO NAME, AND ITS REFUSAL IS STILL A QUERY. Returning here
  # left it with no record, no channel line and no page — the refusal reached nobody but the session's own stderr,
  # which is the one thing this file says must not happen (landing review of #243). So it spools under a RESERVED
  # workspace name instead: the host drains "_nomarker" like any other, the queries session sees it said in the
  # channel (or the owner is paged, on a box with no channel set), and the name itself says why it has no handle.
  qkey=${mws:-${mdir##*/}}; [ -n "$qkey" ] || qkey=_nomarker
  class=$([ -n "$page" ] && echo page || echo nopage)
  # ONE QUERY PER WORKSPACE+REASON PER TTL. The key drops a path in parentheses only — "(/…)"/"(~/…)" — so a rule
  # refusing a list of files is one query; "(cc --go)" and "(cc-loop)" stay two. The record itself keeps the path.
  now=$(date +%s); key=$(printf '%s\n%s' "$qkey" "$(sed -E 's# \([~/][^)]*\)##g' <<<"$why")" | cksum | tr -cd '0-9')
  mkdir -p "$ASKS" 2>/dev/null || return 0
  if [ -f "$ASKS/$key" ]; then was=$(cat "$ASKS/$key" 2>/dev/null) || was=0; case "$was" in ''|*[!0-9]*) was=0;; esac
    [ $((now - was)) -lt "$ASK_TTL" ] && return 0; fi   # already recorded, and the box has not had time to answer
  printf '%s\n' "$now" > "$ASKS/$key"
  sp="$HOME/.cc/state/$qkey/queries.spool"; mkdir -p "$(dirname "$sp")" 2>/dev/null || return 0
  # CUT BEFORE THE LINE IS BUILT. cc-msg discards a whole queries.spool over 1 MB as a plant and pages the owner
  # about it, so one refused command with a big heredoc body would take every query queued in that file down with
  # it (landing review of #243). cc-msg already cuts to 200/300 when it reads, so nothing downstream changes; the
  # marker is there so the queries session knows it is not looking at the whole command.
  qc=$qcmd; wr=$why
  [ "${#qc}" -gt 2000 ] && qc="${qc:0:2000} …(cut)"
  [ "${#wr}" -gt 2000 ] && wr="${wr:0:2000} …(cut)"
  rec=$(jq -cn --arg at "$(date -u +%FT%TZ)" --arg ws "$qkey" --arg class "$class" --arg reason "$wr" --arg cmd "$qc" \
        '{at:$at,workspace:$ws,class:$class,reason:$reason,command:$cmd}' 2>/dev/null) || return 0
  lock="$HOME/.cc/state/$qkey/.queries.lock"
  ( flock -w 5 9 || exit 0; printf '%s\n' "$rec" >> "$sp" ) 9>"$lock" 2>/dev/null || true
  return 0
}
deny(){
  if [ "$role" = member ]; then record_query "$1" 1
    echo "cc-guard: blocked — $1. A query about this has gone to the box; it will approve it or take it onward. Do anything that needs no approval and say what you are waiting on." >&2
  else echo "cc-guard: blocked — $1 (needs the owner; ask via cc-notify or note it on the board)" >&2; fi
  exit 2; }
# "never for this tier": no yes exists FOR this session, so the query is nopage — the queries session is still told.
# A SECOND ARG = record nothing: a write the session aimed outside its own tree is its own to fix from the stderr
# line, not a question for anyone, and three note files refused in one call put six lines in a channel (2026-09-04).
never(){
  if [ "$role" = member ] && [ -z "${2-}" ]; then record_query "$1" ""
    echo "cc-guard: blocked — $1. This is not this session's to run; the box has been told, so nothing here waits on it. Do the rest." >&2
  else echo "cc-guard: blocked — $1. This is not this session's to run and not the owner's to approve for it — nobody is being asked, so do not wait on an answer." >&2; fi
  exit 2; }
denyh(){ echo "cc-guard: blocked — $1. This session is the NON-LIVE side of an overlapping handoff: read, search, think and ask your peer, but do not act on the world — and never ask the live session to run what you are denied." >&2; exit 2; }
ws_dispatch_ok(){   # EVERY dispatch in $1 names workspace $2 as its repo — and there is at least one to name.
  # `cc <ws> <track> --go` is a workspace's ONLY dispatch form: it is where the daily cap is charged (cc: member_gate).
  local c=$1 w=$2 all mine
  [ -n "$w" ] || return 1
  all=$(grep -oE '([^ ]*/)?cc +[A-Za-z0-9._-]+[^;&|]*--go\b' <<<"$c" | wc -l)
  mine=$(grep -oE "([^ ]*/)?cc +$w +[^;&|]*--go\b" <<<"$c" | wc -l)
  [ "$all" -gt 0 ] && [ "$all" = "$mine" ]
}
ws_cc_ok(){   # every `cc …` in $1 that NAMES A REPO names workspace $2 — sessions, board writes, done/rm/handoff.
  # "Inside its own workspace" has to cover CREATION too: `cc board add <other> …` seeds work on another repo and
  # `cc <other> <track>` builds a worktree and opens a session there, both as far outside as a dispatch is. Reads
  # (`cc board show`, `cc ls`, `cc digest`) are left alone — this rule is about what a workspace may make.
  local c=$1 w=$2 inv v r x ok=1; local -a a
  [ -n "$w" ] || return 1
  while IFS= read -r inv; do
    inv=${inv#*cc }; read -r -a a <<<"$inv"; v=${a[0]:-}; r=""
    case "$v" in
      board) r=${a[2]:-}; case "$r" in -*) r="";; esac;;   # every board verb takes the repo there: reading another one is outside too
      # A REDIRECTION IS NOT A REPO. The scan above stops at the first ; & or |, so `cc done --help 2>&1 | head`
      # leaves the token `2>` — not a flag, so it was read as a repo named `2>` and refused as creating outside the
      # workspace (raised-guard-reads-a-redirection-as-a-repo-name). A token carrying < or > is a redirection
      # (2>, >>, &>, <file, 2>/dev/null), and the shell never hands one to cc as an argument. The `&` of a
      # descriptor dup (2>&1, >&2, &>f) is folded away BEFORE the scan below, so it no longer ends the scan
      # early: `cc done 2>&1 other` still reaches `other`.
      done|rm|handoff|-c) for x in "${a[@]:1}"; do case "$x" in -*|*[\<\>]*) ;; *) r=$x; break;; esac; done;;
      ""|-*|slack|rc|digest|quick|ls|resume) ;;
      *) r=$v;;
    esac
    r=${r%%/*}                                       # `cc handoff --overlap <repo>/<track>`
    [ -n "$r" ] && [ "$r" != "$w" ] && ok=""
  done < <(grep -oE "$AT"'([^ ]*/)?cc +[^;&|]*' <<<"$(sed -E 's/([0-9]*[<>]{1,2})&([0-9]+|-)/\1\2/g; s/(^|[[:space:]])&>/\1>/g' <<<"$c")")
  [ -n "$ok" ]
}
# TWO lists. secret_all() is the credentials NO gated role reads: ~/.claude/.credentials.json is the box's Claude
# account and its spend, ~/ccbox/env is a GitHub PAT plus a deploy token — a worker holding either can spend or
# push as the box, and a worker is exactly the session nobody is watching. secret_path() adds the box's OTHER
# secrets, which stay member-only, unchanged.
# ~/ccbox is a SYMLINK into the repo (core/ccbox) and $fp arrives here already realpath'd, so matching the literal
# path alone missed every real read of it — the Read tool still served the file with the rule in place. The case is
# the cheap path (no fork for an ordinary file); only a name that could BE one of them is worth resolving.
secret_all(){
  case "$1" in
    "$HOME"/.claude/.credentials.json|"$HOME"/ccbox/env) return 0;;
    */.credentials.json|*/ccbox/env) ;;
    *) return 1;;
  esac
  local f
  for f in "$HOME/.claude/.credentials.json" "$HOME/ccbox/env"; do
    [ "$1" = "$(realpath -m -- "$f" 2>/dev/null)" ] && return 0
  done
  return 1
}
# ~/.cc/sandbox is judged as WHAT IT IS A COPY OF. cc-sandbox writes the sealed-session settings there
# (<repo|handle>/<track|_workspace>/settings.json) and that file is ~/.claude/settings.json plus a permission
# baseline — the same hook registrations and the same deny rules — so a session that may not read the original may
# not read the copy either. Same tier as the original, not a stricter one: the whole subtree, because a copy that
# is a secret under one name is a secret under any name a future launch gives it.
secret_path(){ secret_all "$1" && return 0; case "$1" in "$HOME"/.cc/config|"$HOME"/.ssh|"$HOME"/.ssh/*|"$HOME"/.claude/settings.json|"$HOME"/.cc/sandbox|"$HOME"/.cc/sandbox/*) return 0;; esac; return 1; }
case "$tool" in
  Bash)
    cmd=$u   # the universal block above already built it: one jq and at most one awk per call, not two
    if [ -n "$handoff_gated" ]; then   # on top of the four gates below: what only the LIVE session may do
      grep -qE 'git +push\b' <<<"$cmd" && denyh "pushing while the other session is the live one (a retired session must not push a stale branch)"
      grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' <<<"$cmd" && denyh "dispatching a worker (cc --go)"
      grep -qE "$AT"'([^ ]*/)?cc-loop\b' <<<"$cmd" && denyh "dispatching a worker (cc-loop)"
      grep -qE "$AT"'([^ ]*/)?cc +done\b' <<<"$cmd" && denyh "opening a PR (cc done)"
    fi
    # 1. merge/deploy
    grep -qE "$AT"'gh +pr +merge' <<<"$cmd" && deny "merging a PR"
    grep -qE "$AT"'([^ ]*/)?cc-land\b' <<<"$cmd" && never "landing a change (cc-land merges, installs, switches units on and restarts services in one go)"   # one command for all of it is exactly why it stays the owner's
    grep -qE 'git +push[^;&|]*( -f|--force|--force-with-lease)' <<<"$cmd" && deny "force push"
    grep -qE 'git +push[^;&|]*\b(main|master)\b' <<<"$cmd" && deny "pushing to the default branch"
    grep -qE 'git +(checkout|switch) +(main|master)\b' <<<"$cmd" && deny "switching to the default branch inside a track"
    grep -qE 'git +(symbolic-ref|update-ref|checkout +-B|switch +-C)' <<<"$cmd" && deny "repointing a ref/HEAD (the checkpoint hook would then commit+push that branch)"
    grep -qE "$AT"'(vercel|netlify|fly|heroku|kubectl|terraform|ansible|aws|gcloud|az) +(deploy|apply|--prod|up\b)' <<<"$cmd" && never "deploying"
    # 2. external comms
    grep -qE "$AT"'gh +(issue +(create|comment)|pr +(comment|review|close|reopen)|release +create)' <<<"$cmd" && deny "public GitHub comms"
    grep -qE "$AT"'gh +(repo +(delete|archive)|api)\b' <<<"$cmd" && deny "gh repo delete/archive or a raw gh api call"
    grep -qE "$AT"'(mail|sendmail|msmtp|mutt)\b' <<<"$cmd" && deny "sending email"
    # 3. destructive / infra
    grep -qE "$AT"'cc +slack +off' <<<"$cmd" && never "cc slack off (drops the owner's live Slack link)"
    # …and `cc-broker inject`, which is "an argv-compatible wrapper onto the same daemon door" (review of #190,
    # F6): it takes the same arguments and calls `cc-slack inject` itself, so a rule naming only the wrapped
    # command would hand a worker back the door this one closed — typing into any session's prompt. The class,
    # not the word: a later front door onto that daemon belongs in this alternation on the day it is written.
    # `cc-broker ledger` is that later door (review of #246). It skips the WAKE, not the DELIVERY: the text is
    # appended to ~/.cc/state/<target>/events.md — which the write-path rule far below refuses as a direct write
    # — and the broker then carries the unread lines verbatim into the next message that session's prompt gets.
    # Its one caller is cc-pulse, from a systemd timer, and a timer is ungated, so nothing legitimate loses it.
    # `cc-arch landed` is a third door onto the same place: it uploads a document into #<repo> as the bot. It is
    # a timer's command (cc-publish gives it its turn) and it posts only for a landing that declared itself an
    # architecture revision — but "only under a condition" is not a gate, and a worker that can run it can put a
    # file in the owner's channel. `build` and `marked` are not named: neither sends anything.
    # A TAB IS A SPACE TO THE SHELL AND WAS NOT TO THIS RULE: `cc-slack<TAB>post` ran every alternation above past
    # it, because each one spells the gap ` +` (security review of #361, and true before this file named cc-arch).
    # $cmdn is the same line with tabs and runs of blanks squeezed to one space, and it is what the two doors
    # below match on — the shell reads them the same way, so this rule has to as well.
    cmdn=$(tr '\t' ' ' <<<"$cmd" | tr -s ' ')
    grep -qE '(^|[;&|(){}`]|\$\() *[^ ]*(cc-slack +(inject|post|post-approval)|cc-broker +(inject|ledger)|cc-arch +landed)\b' <<<"$cmdn" && deny "posting to the owner's Slack (cc-slack inject/post, cc-broker inject/ledger and cc-arch landed onto the same door)"   # any path to the binary
    # …AND `cc-publish` IS THE SECOND ROUTE TO THAT UPLOAD, because it gives cc-arch its turn after every push. It
    # also pushes this box's code to a public repository, which is outward comms in its own right. Its READS are
    # left alone — `status` answers a question, `--dry-run` rehearses and `selfcheck` runs on fixtures — so the
    # rule refuses the publish itself and nothing else.
    grep -qE '(^|[;&|(){}`]|\$\() *[^ ]*cc-publish([^A-Za-z0-9_.-]|$)' <<<"$cmdn" \
      && ! grep -qE 'cc-publish +(status|selfcheck|setup|--dry-run|-n)([^A-Za-z0-9_.-]|$)' <<<"$cmdn" \
      && deny "publishing the box's code outward, which posts the architecture overview as a side effect (cc-publish; its status, --dry-run and selfcheck are reads and still run)"
    grep -qE "$AT"'sudo\b' <<<"$cmd" && never "sudo / host changes"
    grep -qE 'rm +(-[a-zA-Z-]+ +)*-[a-zA-Z]*r[a-zA-Z]* +(-[a-zA-Z-]+ +)*(~|[$]HOME|\.\.|/home|/etc|/var|/usr|/)([*/ ]|$)' <<<"$cmd" && never "recursive delete outside the worktree"
    # The container runtime is a way AROUND every other line here, for a WORKER as much as for a member: this user
    # is in group `docker`, so one `docker run -v /:/host` reads and writes the whole filesystem as root — the
    # credentials below included — with no escalation at all. So it is denied for every gated role, which subsumes
    # the narrower "destroying docker resources" rule this replaces. The sanctioned sandbox (ccbox) is the owner's.
    # `…([^/A-Za-z0-9_.]|$)`, not `…\b`: with every command position now at ^ (cmdpos above), `\b` made the
    # DIRECTORY `docker/Dockerfile` a container run — one `for f in docker/…` refused. A path INTO a dir named
    # docker is not the runtime; a path TO the binary still is, and that is what the prefix ahead of it is for.
    # `-` stays OUT of the exclusion on purpose: `docker-compose up` is the runtime and `\b` was what caught it.
    grep -qE "$AT"'([^ ]*/)?(docker|podman|nerdctl)([^/A-Za-z0-9_.]|$)' <<<"$cmd" && never "running a container (this user is in group docker, so a bind-mounted container reads and writes everything as root)"
    grep -qE "$AT"'(systemctl|netplan|ip +link|ip +addr|iptables|nft|ufw|shutdown|reboot|poweroff)\b' <<<"$cmd" && never "host/network/service changes"
    grep -qE 'git +(branch +-D|reset +--hard +origin|clean +-[a-z]*f)' <<<"$cmd" && never "destructive git"
    # 3b. A WORKER KILLS ONLY WHAT IT STARTED. 2026-09-02 11:15Z a worker went hunting a "stray" suite with
    #     `pgrep -f <the suite's filename>`, matched its OWN `claude -p` — its task prompt names that file — and
    #     killed its own iteration mid-run (rc=143, $0 recorded, nothing journalled). A prompt line telling it not
    #     to did not hold, so the rule is here: at the worker tier a kill lands only on a DESCENDANT of this
    #     session, and never on a session process or a loop runner whatever the tree says. Its own children — a
    #     detached suite, a poller — stay killable, which is the whole point of the subtree test rather than a ban.
    #     A pattern (pkill/killall) is resolved with ONE pgrep and every match must pass the same test; a pattern
    #     matching nothing is nothing to refuse. Same honest ceiling as rule 5: a pid or pattern held in a shell
    #     variable cannot be resolved here and passes.
    #     WORKER *and* MEMBER, because those are not two populations here: a worker dispatched inside a member
    #     workspace is given role=member by track_dir() (the repo decides the tier, not the worktree), and it is
    #     the one running `claude -p` in a loop — exactly the session the incident happened to. `role=member` is
    #     every worker gate PLUS its own, as the header says, so a fence only the worker tier gets is a hole.
    if { [ "$role" = worker ] || [ "$role" = member ]; } \
       && { grep -qE "$AT"'([^ ]*/)?(kill|pkill|killall)([[:space:]]|$)' <<<"$cmd" \
            || grep -qE 'xargs[^;&|]+([^ ]*/)?(kill|pkill|killall)([[:space:]]|$)' <<<"$cmd"; }; then
      kppid(){ awk '/^PPid:/{print $2; exit}' "/proc/$1/status" 2>/dev/null; }
      kroot(){   # this session's own process: the nearest `claude` above the hook. $CC_GUARD_ROOT_PID is a test
        # hook and safe as one — the hook is a child of the claude process, not of the Bash tool, so a command
        # cannot put it there (the same reason $CC_HANDOFF is trusted above).
        local p=${CC_GUARD_ROOT_PID:-} n=0
        if [ -n "$p" ]; then printf '%s' "$p"; return 0; fi
        p=$PPID
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          [ "$(cat "/proc/$p/comm" 2>/dev/null)" = claude ] && { printf '%s' "$p"; return 0; }
          p=$(kppid "$p"); n=$((n+1))
        done
        return 1
      }
      kdesc(){   # rc 0 = pid $1 is a DESCENDANT of $2 — never $2 itself, never one of $2's ancestors
        local p=$1 n=0
        [ "$p" = "$2" ] && return 1
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          p=$(kppid "$p"); [ "$p" = "$2" ] && return 0; n=$((n+1))
        done
        return 1
      }
      kheld(){   # rc 0 = pid $1 is a session or the loop runner: off limits inside the subtree as much as outside
        local c
        c=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
        case "$c" in *cc-loop*) return 0;; esac
        case " $c " in *' -p '*|*' --print '*) case "$c" in *claude*) return 0;; esac;; esac
        return 1
      }
      kfence(){   # $1 = a pid the command would signal, $2 = how it was named
        kheld "$1" && never "killing pid $1 ($2) — that is a session or a loop runner, and a worker that ends one ends itself"
        kdesc "$1" "$me" || never "killing pid $1 ($2) — it is outside this worker's own process subtree, so it is somebody else's; a worker ends only what it started"
      }
      me=$(kroot) || me=""
      [ -n "$me" ] || never "killing a process — this worker cannot find its own session process, so it cannot tell its children from anybody else's"
      # WHICH ARGUMENT IS THE PATTERN. pgrep/pkill/killall take a VALUE for -u/-U/-g/-G/-P/-t/-s/-d and
      # --signal, so "the first bare word" is not it: `pkill --signal TERM claude` read TERM as the pattern,
      # `pgrep -- TERM` matched nothing, and the command went through — then TERMed every `claude` this user
      # owns, this worker's own session included (review of #181). The value is consumed; what is left names
      # the pattern. Only options that genuinely take one are listed: consuming a word that is really the
      # pattern would turn a refusal into a pass, which is the failure this is fixing.
      # THE VERB DECIDES WHAT A LETTER MEANS, and reading it wrong is a hole in whichever direction it falls.
      # This is one parser for pgrep, pkill and killall, and they disagree: `-o` is --oldest (a FLAG) to pkill
      # and --older-than TIME (a VALUE) to killall, `-n` is --newest to one and --ns PID to the other. Read as
      # pkill's, killall's value became the pattern — `killall --older-than 1h claude` reduced to pat=1h,
      # `pgrep -x -- 1h` found nothing, the fence had nothing to refuse, and it killed every claude over an
      # hour old: this worker's own claude -p and its loop runner, the 11:15Z incident again (review of #193).
      # Read as killall's it is WORSE than a false positive: `pgrep -o -f <suite> | xargs kill` would eat the
      # `-f`, resolve the pattern without --full, find fewer processes and let the kill through — a refusal
      # turned into a pass, which is exactly what the note above warns of. So the verb is passed in.
      kpat(){   # $1 = the verb, $@ = the argv after it. Prints "<-f seen>\t<pattern>"; rc 1 = nothing nameable
        local v=$1 y sk="" full="" pat=""; shift
        for y in "$@"; do
          if [ -n "$sk" ]; then sk=""; continue; fi
          case "$y" in
            -s|--signal|--session|-u|--uid|-U|--euid|-g|--pgroup|-G|--group|-P|--parent|-t|--terminal|-d|--delimiter|--ns|--nslist) sk=1;;
            # …and the rest of the ones that take a value. `pkill --older 3600` — a worker's own "clean up
            # strays" idiom — read 3600 as the pattern, matched nothing, and ran: every process this user
            # owns over an hour old, which is its own claude -p and its loop runner. Consumed here, those
            # commands reduce to NO pattern and land in the refusal below, which is where a selector that
            # names no process belongs (review of #181).
            # `-O` is --older's short spelling and was the one left: `pkill -O 3600 -u 1000` read 3600 as the
            # pattern, so the -u never reached the fence at all — every process of that uid, unfenced.
            -O|--older|-r|--runstates|-F|--pidfile|-q|--queue|--env|--cgroup|-Z|--context) sk=1;;
            # …and the ones only killall gives a value to. `-o` and `-n` are FLAGS to pkill (--oldest,
            # --newest), so they are consumed for that verb alone; `--older-than`/`--younger-than` are
            # killall's own spellings and `--ns` is a value to both, so it sits in the shared line above.
            -o|--older-than|-y|--younger-than|-n) case "$v" in killall) sk=1;; esac;;
            -f|--full) full=1;;
            -*) ;;                                     # a flag, a signal, or --opt=value: none of them a pattern
            *) [ -n "$pat" ] || pat=$y;;
          esac
        done
        [ -n "$pat" ] || return 1
        printf '%s\t%s' "$full" "$pat"
      }
      kresolve(){   # $1 = a `pgrep …` invocation, $2 = how to name it. Fences everything it would find.
        local seg=$1 why=$2 spec full pat hits x
        [[ $seg =~ (^|[^A-Za-z0-9_.-])pgrep[[:space:]]+(.*)$ ]] || return 1
        local args=${BASH_REMATCH[2]}
        args=${args%%[\`)]*}                            # a substitution ends at its own paren: `$(pgrep -f x)`
        local xa; read -r -a xa <<<"$args"
        spec=$(kpat pgrep "${xa[@]}") || return 1
        full=${spec%%$'\t'*}; pat=${spec#*$'\t'}
        case "$pat" in *'$'*|*'`'*) return 1;; esac    # named by a variable: unresolvable
        if [ -n "$full" ]; then hits=$(pgrep -f -- "$pat" 2>/dev/null) || hits=""
        else hits=$(pgrep -- "$pat" 2>/dev/null) || hits=""; fi
        for x in $hits; do kfence "$x" "$why"; done     # no match = nothing to refuse
        return 0
      }
      # HUNT, THEN KILL — the incident's own shape, and the one the target loop below cannot see. In
      # `pgrep -f <suite> | xargs kill -9` the kill carries no target of its own: the pids arrive on its
      # stdin, so the loop reads `-9` as a signal, finds nothing to fence and lets it through. What it would
      # kill is whatever the pgrep on the other side of the pipe finds, so THAT is what is resolved and
      # fenced. A feed this cannot read is refused rather than guessed: a worker that cannot say whose pids
      # those are has no business signalling them.
      prev=""
      while IFS= read -r seg; do
        if [[ $seg =~ (^|[^A-Za-z0-9_.-])xargs([[:space:]]+-[^[:space:]]+([[:space:]]+[^-][^[:space:]]*)?)*[[:space:]]+([^ ]*/)?(kill|pkill|killall)([[:space:]]|$) ]]; then
          kresolve "$prev" "the pids a pipeline fed to xargs kill" \
            || never "killing whatever a pipeline finds (… | xargs kill) — the pids arrive on stdin, so this worker cannot tell its own from anybody else's; the one time it guessed, it ended its own iteration"
        fi
        prev=$seg
      done < <(tr '|' '\n' <<<"$cmd")
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(kill|pkill|killall)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; skip=""; pat=""
        if [ "$v" = kill ]; then
          first=1                                      # only the FIRST dash-argument can be the signal
          for x in "${a[@]}"; do
            if [ -n "$skip" ]; then skip=""; first=""; continue; fi
            case "$x" in
              -s|-n|--signal) skip=1; first="";;
              --) first="";;                             # end of options: what follows is a target, never a signal
              -[0-9]*|-[A-Za-z]*)
                # A LATER `-N` IS A PROCESS GROUP, NOT A SIGNAL, and fencing no pid fences nothing: `kill -9 -1`
                # walked straight through this branch and signals every process this user owns — the worker's own
                # claude, its loop runner and the shared tmux server (review of #181, a worse 11:15Z).
                if [ -n "$first" ]; then first=""; continue; fi
                case "$x" in
                  -1) never "killing process group -1 — that is every process this user owns, this worker included";;
                  -[0-9]*) for gp in $(pgrep -g "${x#-}" 2>/dev/null); do kfence "$gp" "kill $x (process group ${x#-})"; done;;
                esac;;
              %*) ;;                                     # a job of the tool's own shell
              '$('*|'`'*)                                # `kill $(pgrep -f <suite>)`: the same hunt, spelled
                first=""                                 # as a substitution rather than a pipe
                kresolve "$inv" "the pids a pgrep found for kill" \
                  || never "killing what a command substitution returns — this worker cannot see whose pids those are";;
              *[!0-9]*) first="";;                       # a variable or a glob: unresolvable, same ceiling as rule 5
              *) first=""; kfence "$x" "kill $x";;
            esac
          done
        else
          # NO PATTERN IS NOT "NOTHING TO REFUSE". A selector says WHICH processes without naming one:
          # `pkill -u $(id -u)` parses to no pattern at all, so this line used to fall through and let it
          # signal every process this user owns — the worker's own claude -p, its loop runner and the shared
          # tmux server. That is `kill -9 -1` spelled a second way, and that one IS refused a branch up
          # (review of #181). Resolving it instead would mean teaching kpat every spelling procps takes
          # (-u1000, --uid=1000, --older, whatever lands next); seven holes in four rounds say it cannot be
          # taught. So a pkill/killall this cannot reduce to a pattern is refused, the way an unreadable
          # xargs feed is. `killall -l` and `pkill -V` are refused with it: informational, and no rule here
          # needs them. A selector WITH a pattern is unaffected — the pattern is still what gets resolved.
          spec=$(kpat "$v" "${a[@]}") \
            || never "$v with a selector but no pattern — -u/-U/-g/-G/-P/-t/-s/--older/-F and the rest name a whole SET of processes and this worker cannot tell whose they are, so it is refused rather than guessed: pkill -u \$(id -u) is every process this user owns, its own claude -p and loop runner included, and pkill --older 3600 is the same set an hour old"
          fflag=${spec%%$'\t'*}; pat=${spec#*$'\t'}
          case "$pat" in *'$'*|*'`'*) continue;; esac     # named by a variable: unresolvable
          if [ "$v" = killall ]; then hits=$(pgrep -x -- "$pat" 2>/dev/null) || hits=""
          elif [ -n "$fflag" ]; then hits=$(pgrep -f -- "$pat" 2>/dev/null) || hits=""
          else hits=$(pgrep -- "$pat" 2>/dev/null) || hits=""; fi
          for x in $hits; do kfence "$x" "$v $pat"; done   # no match = nothing to refuse
        fi
      done < <(grep -oE "$AT"'([^ ]*/)?(kill|pkill|killall)[[:space:]]+[^;&|]*' <<<"$cmd")
    fi
    # The two files that ARE the box's credentials — no role reads them, and the member-only list below adds to this
    # one rather than replacing it. Same honest ceiling as every line here: a blocklist stops accidents and casual
    # prompt-injection, not a redirection or a script written first.
    RD='(cat|tac|less|more|head|tail|nl|cut|grep|egrep|fgrep|rg|sed|awk|xxd|od|base64|strings|sort|uniq|jq|python[0-9.]* +-c|source|\.)'
    grep -qE "$AT$RD"' +[^;&|]*(ccbox/env|\.credentials\.json)($|[^A-Za-z0-9_.-])' <<<"$cmd" \
      && never "reading the box's credentials (~/.claude/.credentials.json is the Claude account and its spend, ~/ccbox/env is a GitHub PAT and a deploy token)"
    # 5. THE WORKTREE IS THE ONLY TREE A TRACK WRITES. ~/dev/<repo> is the checkout the box RUNS and ~/bin symlinks into
    #    it, so a write there is an unreviewed change to a live binary. 2026-09-01: a review agent's `cp x $S/bin/y` landed
    #    in the live checkout's core/bin because $S/bin was a symlink farm into it — so every target is REALPATH'd and judged by
    #    where it LANDS, never by how it was spelled. Verbs with a destination: redirections; cp/mv/ln/install/rsync (the
    #    last arg, or -t); tee and sed -i (every file); dd of=; and git -C <there> with a verb that writes. A variable or
    #    a glob in the target cannot be resolved and passes: the same honest ceiling as every other line here.
    #    A RELATIVE TARGET LANDS WHERE THE LINE HAS GOT TO, NOT WHERE THE PAYLOAD STARTED: `cd ~/dev/other && echo
    #    pwn > f` resolved f against the cwd, found it inside this session's own tree and passed (adversarial
    #    review of #243). So $wbase carries the cd along the line, and a cd this cannot resolve (a variable) makes
    #    every relative target after it a refusal — the same "refuse what you cannot reduce" as the kill fence.
    hit=""; wbase=$cwd
    # A GLOB CUT ABOVE A FENCED NAME STILL REACHES IT. Both fences below cut a target at its first glob character
    # and judge the literal prefix, which is right when the prefix is already inside the fence (`~/bin/cc-guar?`).
    # The prefix can also be SHORTER than the fenced path — `~/b*/cc-guard`, `~/.cc/state/ar*`, `~/.cc/state/*` —
    # and then asking only "is the prefix inside the fence" is the wrong question: the answer is no, the command
    # runs, and the shell expands the glob onto the very file the fence exists for (security re-read of #361, which
    # removed cc-arch's cursor that way). So a CUT prefix is judged in both directions, and this is the second
    # one: does a fenced path begin with it. An exact path is unchanged — it means itself and nothing else.
    wspan(){ local t=$1 p; shift          # rc 0 = the cut prefix $t spans one of the fenced roots $@; $hit says which
      for p; do case "$p" in "$t"*) hit=$p; return 0;; esac; done; return 1; }
    wtgt(){ local t=${1%\`} g=""   # rc 0 = $1 lands in ~/dev/* or ~/bin, outside this session's own tree; $hit says where
      # A GLOB IS NOT AN UNRESOLVABLE NAME. It is a name with a tail this cannot see, and the head of it says
      # where the write LANDS: `cp /dev/null ~/bin/cc-guar?` truncated a live binary while this waved it
      # through for carrying a `?` (6th adversarial review of #243). The literal prefix is judged; `~/bin/x?`
      # is refused and `sub/x?` still runs. A `$` or a backtick stays unresolvable — a variable names anywhere.
      # The backtick that CLOSED a substitution is the last character of the last word in it, so `cp /dev/null
      # ~/bin/cc-guard` inside one handed this a target with a backtick on the end, and a name carrying one is
      # called unresolvable and waved through (5th adversarial review of #243). It is a boundary, not a name.
      # shellcheck disable=SC2088  # a literal ~ in a case pattern is the point: it is being expanded by hand
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      case "$t" in *['*?[']*) g=1; t=${t%%[*?[]*};; esac   # …so the glob is cut off and its prefix judged, both ways (wspan)
      case "$t" in ''|-*|*['$`']*) return 1;; /*) ;;
        *) [ -n "$wbase" ] || never "writing to a relative path after a \`cd\` this cannot resolve — where it would land is unknown, so it is refused rather than guessed"
           t=$wbase/$t;; esac
      t=$(realpath -m -- "$t" 2>/dev/null) || return 1
      # ~/.cc/state is a track's own scratch and stays writable — with ONE carve-out. ~/.cc/state/arch is where
      # cc-arch keeps the record of which architecture revisions it has already put in the owner's channel; a
      # shell that can delete a line of it can make the box upload the same document again, or a document about a
      # commit it already answered for (security review of #361). It is the ledger for an outward door, so it is
      # fenced like ~/bin and not like scratch.
      case "$t" in "$HOME"/dev/*|"$HOME"/bin|"$HOME"/bin/*|"$HOME"/.cc/state/arch|"$HOME"/.cc/state/arch/*) in_root "$t" && return 1; hit=$t; return 0;; esac
      [ -n "$g" ] && wspan "$t" "$HOME/dev/" "$HOME/bin" "$HOME/.cc/state/arch" && return 0
      return 1; }
    wdeny(){ never "writing into the box's live tree ($hit): ~/dev/<repo> is the checkout the box runs, ~/bin symlinks into it and ~/.cc/state/arch is the ledger for what has already been sent outward — a track writes its worktree, /tmp and the rest of its own ~/.cc/state dir, and the rest arrives as a PR"; }
    # DELETING THE RECORD IS THE OTHER HALF OF WRITING IT, and the fence above only covered writing. cc-arch reads
    # ~/.cc/state/arch to know which architecture revisions it has already sent; a shell that cannot overwrite the
    # cursor but CAN unlink it drops the tool onto its first-run branch, which re-pins to the head of the branch
    # and posts NOTHING — a declared revision suppressed in silence, which is worse than a duplicate because
    # nobody is looking for it (security re-read of #361; `rm -rf` on that directory was rc 0).
    rmtgt(){ local t=${1%\`} g=""   # rc 0 = $1 names or spans ~/.cc/state/arch; $hit says what
      # ITS OWN COPY of wtgt's hand-expansion, deliberately. wtgt refuses outright a relative path after a `cd` it
      # cannot resolve; that is right for a write into ~/bin and far too broad for an `rm`, which every build runs.
      # Here an argument this cannot reduce is LEFT ALONE: the set being fenced is one directory, not a tree.
      # shellcheck disable=SC2088  # a literal ~ in a case pattern is the point: it is being expanded by hand
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      case "$t" in *['*?[']*) g=1; t=${t%%[*?[]*};; esac  # a glob is a name with a tail this cannot see; wspan judges it both ways
      case "$t" in ''|-*|*['$`']*) return 1;; /*) ;; *) [ -n "$wbase" ] || return 1; t=$wbase/$t;; esac
      t=$(realpath -m -- "$t" 2>/dev/null) || return 1
      case "$t" in "$HOME"/.cc/state/arch|"$HOME"/.cc/state/arch/*) hit=$t; return 0;; esac
      [ -n "$g" ] && wspan "$t" "$HOME/.cc/state/arch" && return 0
      return 1; }
    rmdeny(){ never "removing the record of what has already been sent outward ($hit): ~/.cc/state/arch holds cc-arch's cursor and its ledger, and a shell that deletes either one makes the box re-pin to the branch head and drop a declared architecture revision without saying so. The rest of ~/.cc/state is a track's own, to write and to delete"; }
    wcd(){   # where a `cd`/`pushd` leaves the rest of the line; rc 1 = it cannot be resolved, so $wbase is emptied
      local t=$1
      # shellcheck disable=SC2088  # the same hand-expansion as wtgt: a literal ~ is what a command line carries
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      case "$t" in '') t=$HOME;; '~-'|+[0-9]*|-*|*['$`*?[']*) return 1;; /*) ;; *) [ -n "$wbase" ] || return 1; t=$wbase/$t;; esac
      realpath -m -- "$t" 2>/dev/null || return 1; }
    wscan(){   # the three write shapes over one piece of the haystack, every relative target against $wbase
      local txt=$1 t inv v x dst skip ef n verb; local -a a files dirs
      while IFS= read -r t; do wtgt "$t" && wdeny; done < <(grep -oE '(&>>?|[0-9]*>>?[|]?)[[:space:]]*[^[:space:];&|<>()]+' <<<"$txt" | sed -E 's/^[^[:space:]]*>[|]?[[:space:]]*//')
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(cp|mv|ln|install|rsync|tee|sed|dd)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; dst=""; skip=""; files=(); n=0; ef=""
        case "$v" in
          # THE DESTINATION IS NOT ALWAYS THE LAST WORD. Reading only the last one, any trailing word moved the
          # target out of sight: `cp a ~/bin/cc-guard 2>/dev/null` judged `2>/dev/null`, and `sh -c 'cp $1
          # ~/bin/cc-guard' _ a` judged `a` — both overwrote a live binary (4th adversarial review of #243). So
          # EVERY bare word after the first is judged. Only the first is a source and safe to skip; a `-t` names
          # the destination outright and the bare words are then all sources. The cost is a false refusal on
          # `cp a ~/dev/other/b sub/`, where a middle SOURCE is judged as a target: over-strict, the safe way.
          cp|mv|ln|install|rsync) for x in "${a[@]}"; do
              if [ -n "$skip" ]; then dst=$x; skip=""; continue; fi
              case "$x" in -t|--target-directory) skip=1;; --target-directory=*) dst=${x#*=};;
                -*) ;; *) n=$((n+1)); [ "$n" -gt 1 ] && files+=("$x");; esac; done
            [ -z "$dst" ] || files=("$dst");;
          tee) for x in "${a[@]}"; do case "$x" in -*) ;; *) files+=("$x");; esac; done;;
          sed) case " ${a[*]} " in *" -i"*|*" --in-place"*) ;; *) continue;; esac   # without -i sed writes nothing
            for x in "${a[@]}"; do case "$x" in -e|-f|--expression|--file) ef=1;; esac; done
            for x in "${a[@]}"; do   # the script is the first bare arg unless -e/-f carried it; the rest are files
              if [ -n "$skip" ]; then skip=""; continue; fi
              case "$x" in -e|-f|--expression|--file) skip=1;; -*) ;; *) n=$((n+1)); { [ -n "$ef" ] || [ "$n" -gt 1 ]; } && files+=("$x");; esac; done;;
          dd) for x in "${a[@]}"; do case "$x" in of=*) files+=("${x#of=}");; esac; done;;
        esac
        for x in "${files[@]}"; do wtgt "$x" && wdeny; done
      done < <(grep -oE "$AT"'([^ ]*/)?(cp|mv|ln|install|rsync|tee|sed|dd)[[:space:]]+[^;&|]*' <<<"$txt")
      while IFS= read -r inv; do   # git -C ~/dev/<repo> checkout|apply|stash|… rewrites that tree as surely as cp does
        [[ $inv =~ (^|[^A-Za-z0-9_.-])git[[:space:]]+(.*)$ ]] || continue; read -r -a a <<<"${BASH_REMATCH[2]}"; skip=""; dirs=(); verb=""
        for x in "${a[@]}"; do
          if [ -n "$skip" ]; then [ "$skip" = d ] && dirs+=("$x"); skip=""; continue; fi
          case "$x" in -C) skip=d;; -c|--git-dir|--work-tree) skip=x;; -*) ;; *) verb=$x; break;; esac; done
        case "$verb" in add|am|apply|checkout|cherry-pick|clean|commit|merge|mv|pull|rebase|reset|restore|revert|rm|stash|switch|worktree|submodule|update-ref|symbolic-ref)
          for x in "${dirs[@]}"; do wtgt "$x" && wdeny; done;; esac
      done < <(grep -oE "$AT"'([^ ]*/)?git[[:space:]]+-C[[:space:]]+[^;&|]*' <<<"$txt")
      # …and the removal verbs over the one directory rmtgt fences. `mv` is in both lists on purpose: the write
      # scan above judges where it puts a file, this one judges what it takes away. `find` counts only when the
      # invocation carries an action that deletes or runs something — a bare `find` reads.
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(rm|rmdir|unlink|shred|truncate|mv|find)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; files=(); skip=""
        [ "$v" != find ] || case " ${a[*]} " in *" -delete "*|*" -exec "*|*" -execdir "*|*" -ok "*) ;; *) continue;; esac
        for x in "${a[@]}"; do
          if [ -n "$skip" ]; then skip=""; continue; fi
          case "$x" in -s|--size|-n|--iterations|-t|--target-directory) skip=1;;
            -*) [ "$v" != find ] || break;;                 # find's paths come first; past the first predicate there are none
            *) files+=("$x");; esac; done
        for x in "${files[@]}"; do rmtgt "$x" && rmdeny; done
      done < <(grep -oE "$AT"'([^ ]*/)?(rm|rmdir|unlink|shred|truncate|mv|find)[[:space:]]+[^;&|]*' <<<"$txt")
    }
    # No cd anywhere in the command = the haystack is one pass, exactly as before. With one, each LINE is walked
    # statement by statement instead, so a target is judged against the dir the cd before it moved to. A cd inside
    # a subshell moves $wbase for the rest of the line as well: over-strict, and never the other way round.
    # $wbase IS PER PAYLOAD, NOT PER LINE. A newline is not a cd back: `cd ~/dev/other &&` + newline + `echo pwn > f`
    # (and the `;` and backslash-continuation spellings) resolved f against the payload's own cwd and passed, because
    # the walk reset the base on every line (2nd adversarial review of #243). A cd on line 1 governs line 2.
    # $wstack IS pushd's DIRECTORY STACK, so popd goes back where pushd came from — untracked, popd left the base
    # at the pushd'd dir and `pushd ~/dev/other; pushd /tmp; popd; echo pwn > f` passed. An empty stack and a slot
    # (`popd +1`) are unresolvable: the base is emptied and a later relative write is refused.
    # ONLY A STATEMENT LINE MOVES THE SHELL. The haystack carries the walk's SUFFIXES too, and a suffix is argument
    # text: `git commit -m "cd /tmp"` puts `cd /tmp` on a line of its own, which cancelled a real cd into another
    # repo and let the write after it through, while `git commit -m "popd broke the build"` emptied the base and
    # refused an ordinary write (3rd adversarial review of #243). cmdpos marks the statement lines with a \001;
    # everything else is walked for WRITES, which is what a wrapper's suffix is there for, and never for a cd.
    # THE PREFIX IS $AT's WRAPPER LIST, plus `builtin`: `command cd ~/dev/other && echo pwn > f` and the `builtin`
    # spelling both move the shell and neither was tracked, because the prefix took only `(`, `{` and VAR= (same
    # review). `bash -c "cd ~/dev/other; …"` moves the shell it starts, which is the one that does the writing.
    # TWO KNOWN COSTS, DOCUMENTED RATHER THAN FIXED: `cd "$VAR" && <relative write>` is refused by design — the cd
    # cannot be resolved, so where the write lands is unknown, and with the base per payload that now holds for a
    # write on a LATER line too — and `git commit -m x\;\ cc-land\ 7` is refused because unesc splits on the escaped
    # space. Both are over-strict, which is the safe way to be wrong.
    # …AND SO ARE THE COMPOUND KEYWORDS AND AN OPTION WORD. `if cd ~/dev/other; then <write>; fi`, the `while`,
    # `until` and `!` spellings, and an option between a wrapper and the cd (`command -p cd`, `time -p cd`) all
    # moved the shell with none of them tracked (4th adversarial review of #243). An option is any -word here:
    # a fixed list of them is the wrapper list again, one round later.
    # …AND A REDIRECTION IS ONE TOO. `>/dev/null cd ~/dev/other; echo pwn > f` moves the shell and the prefix
    # stopped at the `>` (5th adversarial review of #243). The alternative carries its target, spelled glued or
    # spaced, and is written with character classes alone so the group numbers below do not shift.
    # `{fd}>file` IS A REDIRECTION TOO, and `2>&1` is one the `&` split cuts in half — `{fd}>/dev/null cd
    # ~/dev/other` and `2>&1 cd ~/dev/other` both moved the shell untracked, the second leaving the piece
    # `1 cd …` behind (6th adversarial review of #243). The named-descriptor form is spelled out, and a piece
    # that starts with what the split left of a `N>&M` — bare digits, or the `-` of `2>&-` — is stepped over.
    WCDW='(then|else|elif|do|if|while|until|!|time|env|nohup|xargs|command|builtin|eval|exec|sudo|bash|sh|[0-9]*[<>][<>]?[|&]?[[:space:]]*[^[:space:]]*|\{[A-Za-z_][A-Za-z0-9_]*\}[<>][<>]?[|&]?[[:space:]]*[^[:space:]]*|[0-9-]+|-[A-Za-z][A-Za-z-]*|[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*)'
    WCDRE="^[[:space:]]*[({]?[[:space:]]*(${WCDW}[[:space:]]+)*(cd|pushd|popd)([[:space:]]+(.*))?\$"
    WISH='(^|[[:space:]])(bash|sh)([[:space:]]|$)'   # a cd behind one of these runs in a CHILD shell, not this one
    wspush(){ wsB+=("$wbase"); wsN+=("${#wstack[@]}"); wsS+=("$(printf '%s\n' ${wstack[@]+"${wstack[@]}"})"); }
    wspop(){ local k=$(( ${#wsB[@]} - 1 )); [ "$k" -ge 0 ] || return   # give the base back to the enclosing shell
             wbase=${wsB[k]}; if [ "${wsN[k]}" -eq 0 ]; then wstack=(); else mapfile -t wstack <<<"${wsS[k]}"; fi
             unset "wsB[$k]" "wsN[$k]" "wsS[$k]"; }
    wigive(){ [ -n "$wihave" ] || return   # the interpreter's child shell has ended: the real shell never moved
              wbase=$wisave; if [ "${wisN:-0}" -eq 0 ]; then wstack=(); else mapfile -t wstack <<<"$wisS"; fi; wihave=""; }
    # A STATEMENT IS ONE STRING FOR THE WRITE FENCE, WHATEVER IT HAS A SUBSTITUTION IN THE MIDDLE OF. $wacc builds
    # it back up across the pieces the split made; $wsb is the base it STARTED with, which is where its
    # redirections and arguments are expanded (see the cd/redirection note below). The pair is stacked the way
    # $wbase is: a substitution's interior is a statement of its own, and the enclosing one resumes after the `)`.
    wapush(){ waccS+=("$wacc"); wsbS+=("$wsb"); wacc=""; }
    wapop(){ local k=$(( ${#waccS[@]} - 1 )); [ "$k" -ge 0 ] || return
             wacc=${waccS[k]}; wsb=${wsbS[k]}; unset "waccS[$k]" "wsbS[$k]"; }
    wsflush(){ [ -n "$wacc" ] || return   # the statement is complete: judge it whole, where it began
               local sv=$wbase; wbase=$wsb; wscan "$wacc"; wbase=$sv; wacc=""; }
    if grep -qE '(^|[^A-Za-z0-9_.-])(cd|pushd|popd)([[:space:]]|$)' <<<"$cmd"; then
      wstack=(); wpre=$cwd; wsnap=(); wfstack=(); wflat=$cwd; wraw=""
      while IFS= read -r wln; do
        # A DOUBLED MARK IS A REWIND, NOT A STATEMENT: cmdpos prints one in front of the RAW reading of a line it
        # has already emitted quote-aware, so the two readings are not two statements the shell ran one after
        # the other. Without it the same RELATIVE cd moved the base twice (see cmdpos, and case 21b). The base
        # and the pushd stack go back to where the line started; whichever reading MOVES them is the one kept.
        wsl=""
        case "$wln" in
          $'\001\001') wraw=1; wflat=$wbase; wfstack=("${wstack[@]}"); wbase=$wpre; wstack=("${wsnap[@]}"); continue;;
          $'\001'*) wsl=1; wln=${wln#$'\001'}                     # a statement, not a suffix: see above
            [ -n "$wraw" ] || { wpre=$wbase; wsnap=("${wstack[@]}"); };;
        esac
        # A SUBSTITUTION IS A SHELL OF ITS OWN, AND ITS cd MOVES THE WRITES INSIDE IT. `echo $(cd ~/dev/other &&
        # echo pwn > f)`, the backtick spelling and `cat <(cd …; echo pwn > f)` were one statement whose first
        # word was `echo`, so the cd was never tracked and the write resolved against the session's own tree
        # (4th adversarial review of #243). The opener stays on the OUTER statement — `cd $(…)` must still read
        # as a destination this cannot resolve — and the interior starts a statement, the way `(` already does.
        # A BRACE, A CLOSING PAREN AND A FUNCTION BODY END A STATEMENT AS SURELY AS A `;` DOES, and any token in
        # front of the cd that is not a wrapper hid it: `case $x in *) cd ~/bin;; esac`, `f() { cd ~/bin; }`, its
        # `function f { … }` spelling, `time { cd …; }` and `while :; do { cd …; break; }; done` each moved the
        # real shell untracked (5th adversarial review of #243). A `{` counts only when a space follows it and a
        # `}` only when one precedes it — that is what makes a command GROUP, and it leaves `${VAR}`, `{}` and a
        # brace expansion alone, which the cd walk must still read whole.
        wsub=${wln//'$('/$'$\n'}; wsub=${wsub//'<('/$'<\n'}; wsub=${wsub//'>('/$'>\n'}; wsub=${wsub//'`'/$'`\n'}
        wsub=${wsub//')'/$')\n'}; wsub=${wsub//'{ '/$'{\n'}; wsub=${wsub//' }'/$' }\n'}
        # THE `|` IN `>|` IS NOT A PIPE, and the split cut the redirection in half so its target landed on a
        # piece with no verb: `cd sub && cp /dev/null >| ~/bin/cc-guard` truncated a live binary while the same
        # line without the cd was refused — the `>|` half of the same orphaning as the substitutions above
        # (9th adversarial review of #243, found probing it). noclobber-override is a `>`, so it is spelled one.
        wsub=${wsub//'>|'/'>'}
        # A SUBSHELL'S cd MOVES THE WRITES INSIDE IT AND NOTHING AFTER. `( … )`, `$( … )`, `<( )`, `>( )`, a
        # backtick and an interpreter string (`sh -c '…'`) each start a shell of their own, so `cd ~/dev/other`
        # then `(cd /tmp)` then `echo pwn > f` wrote the real repo while a benign subshell's /tmp carried out of
        # it and masked the real cd — the write passed (7th adversarial review of #243). The base is saved at
        # each opener and given back at the close, so the moved base applies only inside: case 28 still refuses,
        # its write is inside the same subshell. The paren/backtick stack is per pass (an unclosed opener leaks
        # over-strict, as before); the interpreter give-back is per PIECE below.
        # A SUBSTITUTION OPENER AND A SUBSHELL OPENER ARE NOT ONE ENTRY. The split leaves `$(`, `<(`, `>(` and a
        # backtick at the END of their piece, so the text in front of them is the OUTER shell's, while a bare `(`
        # comes FIRST and the text after it is the inner shell's. Sharing one flag pushed both before the piece
        # was read, so `cd $(echo ~/dev/other) && echo pwn > f` emptied the base on the piece `cd $` — correctly,
        # a destination this cannot resolve — and the `)` that closed the substitution then handed the PRE-cd
        # base back, and the write passed (8th adversarial review of #243). A `(` still pushes first; a
        # substitution opener pushes after the cd, so what its `)` pops is the base the cd left.
        # …AND ITS INTERIOR RUNS BEFORE THAT cd. A REDIRECTION IS EXPANDED FIRST: `cd sub > $(cp /dev/null
        # ../other/f)` runs the cp in the dir the line started in, not in `sub`, so judging the interior against
        # the moved base let a write into another repo through (8th adversarial review of #243, same round). The
        # interior is handed the base the PIECE started with; only what the `)` pops is the base the cd left.
        # THE SPLIT IS THE cd WALK'S, AND THE WRITE FENCE MUST NOT SEE IT. Scanning each piece on its own orphaned
        # a destination from its verb whenever a substitution stood between them: `cd sub && cp $(echo /dev/null)
        # ~/bin/cc-guard` left ` ~/bin/cc-guard` as a piece with no cp and no redirection in it, so the fence had
        # nothing to judge and a live binary was truncated — while the same line WITHOUT a cd took the whole-line
        # path below and was refused, so any command carrying the word `cd` turned the fence off for this shape
        # (9th adversarial review of #243). The statement is put back together in $wacc with each substitution
        # reduced to a bare `$`, which is a placeholder no path can be resolved through (`cp a $(pwd)/b` stays
        # the unresolvable target it always was), and the interior is walked as the statement it is, as before.
        # A piece ENDS ITS STATEMENT unless it ends at a substitution boundary — that is what $wsubo and $wclose
        # already say, so no new marker is needed and none can be forged into the command text.
        wsB=(); wsN=(); wsS=(); wbt=0; wihave=""; wacc=""; wsb=$wbase; waccS=(); wsbS=()
        while IFS= read -r wst; do
          [ -n "$wst" ] || continue
          wopen=""; wclose=""; wsubo=""
          case "$wst" in *'`') if [ "$wbt" = 0 ]; then wsubo=1; wbt=1; else wclose=1; wbt=0; fi;; esac
          case "$wst" in *'$'|*'<'|*'>') wsubo=1;; esac        # the split left $( , <( or >( — the interior is its own shell
          [[ $wst =~ ^[[:space:]]*\( ]] && wopen=1             # a bare ( subshell: this piece's text is INSIDE it
          case "$wst" in *')') wclose=1;; esac                # …closed by the ) the split left on the piece
          [ -n "$wopen" ] && { wspush; wapush; }             # a `(` opens before the piece's text: that text is inside it
          wbpre=$wbase; wspre=("${wstack[@]}")               # where this piece STARTED: what a substitution in it inherits
          # The backtick that CLOSED the substitution is the last character of the statement, and it rode along
          # into the target: `> f` + backtick read as a write to a name with a backtick in it, which wtgt calls
          # unresolvable and waves through. It is a boundary, not part of a name, so it comes off the text the
          # write fence reads — and stays on the text WCDRE reads, where `cd` + backtick must stay unresolvable.
          # The `)` that closed one is the same kind of boundary, and now that the statement is read whole it
          # would land in the MIDDLE of it, so it comes off too.
          wtx=${wst%\`}; wtx=${wtx%)}
          [ -n "$wsubo" ] && { case "$wtx" in *['$<>']) wtx=${wtx%?};; esac; wtx=$wtx'$'; }
          [ -n "$wacc" ] || wsb=$wbase                       # …the base the statement is expanded in
          wacc=$wacc$wtx
          if [ -n "$wsl" ] && [[ $wst =~ $WCDRE ]]; then
            wv=${BASH_REMATCH[3]}; wargs=${BASH_REMATCH[5]:-}; wpfx=${wst%"${BASH_REMATCH[3]}${BASH_REMATCH[4]}"}   # the wrappers in front of the verb
            if [[ $wpfx =~ $WISH ]]; then [ -n "$wihave" ] || { wisave=$wbase; wisN=${#wstack[@]}; wisS=$(printf '%s\n' ${wstack[@]+"${wstack[@]}"}); wihave=1; }   # a child-shell cd: remember the base to give back
            else wihave=""; fi                                # a real cd is where the shell now stands: it cancels the give-back
            read -r -a wa <<<"$wargs"; wt=""; wun=""; wn=""
            for x in "${wa[@]}"; do case "$x" in
                # `-` is $OLDPWD and `~-` is the same dir; `+N`/`-N` are slots of a stack this only half sees.
                # All were skipped as OPTIONS, so `cd -` read as `cd` and moved the base to $HOME while the real
                # shell went back to the repo it came from: the write after it passed (2nd adversarial review).
                -|'~-'|+[0-9]*|-[0-9]*) wun=1; break;;
                -n) wn=1;;                    # popd's "stack only": the one option that is not just noise here
                -*|'>'*|'<'*|[0-9]*'>'*) ;;   # an option or a redirection (`popd >/dev/null`): not a destination
                *) wt=$x; break;; esac; done
            case "$wv" in
              # `popd -n` TAKES A DIRECTORY OFF THE STACK AND LEAVES THE SHELL WHERE IT IS — bash suppresses the
              # cd — so `pushd ~/dev/other; popd -n; echo pwn > f` was read as a popd BACK and the write went
              # through while the shell stood in the other repo (3rd adversarial review of #243).
              popd) if [ -n "$wn" ]; then [ ${#wstack[@]} -eq 0 ] || unset 'wstack[-1]'
                    elif [ -n "$wun" ] || [ -n "$wt" ] || [ ${#wstack[@]} -eq 0 ]; then wbase=""
                    else wbase=${wstack[-1]}; unset 'wstack[-1]'; fi;;
              pushd) wstack+=("$wbase")   # …even when the new dir is unresolvable: the STACK still grew
                    if [ -n "$wun" ] || [ -z "$wt" ]; then wbase=""   # `pushd` alone swaps a top this cannot see
                    else wbase=$(wcd "$wt") || wbase=""; fi;;
              *) if [ -n "$wun" ]; then wbase=""; else wbase=$(wcd "$wt") || wbase=""; fi;;
            esac
          fi
          # THE GIVE-BACK IS THE PIECE'S, NOT THE LINE'S. Deferred to the end of the source line, a benign
          # interpreter cd masked a real one for every statement after it on that line: `cd ~/bin && sh -c 'cd
          # /tmp' && cp /dev/null cc-guard` left the base at /tmp when the cp was scanned, so the target resolved
          # to /tmp/cc-guard and passed while the shell truncated the live binary (8th adversarial review of
          # #243). The child shell ends with its own piece, so the base goes back there. The RAW re-reading keeps
          # the end-of-pass give-back: strip() takes the interpreter string's quotes off, so the statements
          # inside it become pieces of the same line and the child shell has not ended — case 28 refuses there.
          [ -z "$wraw" ] && wigive
          if [ -n "$wsubo" ]; then wapush   # …after the cd (the opener is at the END of the piece), and the interior runs before it
            wspush; wbase=$wbpre; wstack=("${wspre[@]}")
          elif [ -n "$wclose" ]; then wsflush; wapop; wspop   # the interior statement ends at its `)`; the enclosing one resumes
          else wsflush; fi                                   # a ; & | { } or the end of the line ends the statement
        done <<<"${wsub//[;&|]/$'\n'}"
        wsflush; while [ ${#waccS[@]} -gt 0 ]; do wapop; wsflush; done   # …and so does the line, however unbalanced it was
        wigive   # the raw re-reading's pieces have ended: give the interpreter's base back
        if [ -n "$wraw" ]; then   # the re-reading is done: it moved nothing, so the quote-aware reading stands
          [ "$wbase" = "$wpre" ] && [ "${wstack[*]}" = "${wsnap[*]}" ] && { wbase=$wflat; wstack=("${wfstack[@]}"); }
          wraw=""
        fi
      done <<<"$uk"
      wbase=$cwd
    else wscan "$cmd"; fi
    # 4. member-facing only: a member must not be able to make the box SPEND or LEAK. Be honest about the ceiling —
    #    a Bash blocklist is not a sandbox: it stops accidents and casual prompt-injection, not a determined attacker
    #    (a redirection, a copied binary, a script it writes first). Real containment is ccbox. cc-notify stays
    #    allowed on purpose: it is how this session escalates to the owner.
    # One list, read by rule 4 and rule 6: a secret added here has to reach every tier that may not see it, and a
    # second copy in the steward block below is a copy that would be updated once. $RD is set above; these ADD to
    # the credentials no role reads at all.
    SEC='(~|\$HOME|/home/[^ /]*)/(\.cc/config|\.cc/sandbox\b|\.ssh\b|\.claude/settings\.json)'
    if [ "$role" = member ]; then
      # A MEMBER WORKSPACE DISPATCHES INSIDE ITSELF, AND ONLY THERE. ~/dev/<handle> is one member's whole world:
      # tracks, workers and channels under `<handle>` are theirs to make. Keyed on the .cc/member-workspace marker
      # at the root, never on a new role — a plain member-facing channel session still dispatches nothing at all.
      # This is DEPTH, not containment: what keeps a workspace to itself is the boundary the session runs inside
      # (docs/design-member-workspaces.md, "the boundary"), and this grep is what is left if that ever slips.
      # THE BOUNDARY'S DOOR OPENS FROM OUTSIDE. cc and cc-loop start a workspace session only under CC_MEMBER_SANDBOX=1,
      # which the sandbox sets — never a member-facing session: `CC_MEMBER_SANDBOX=1 cc alice todo` from a plain member
      # dir passed every rule here and started a member workspace session ON THE HOST, the one thing the hard rule
      # forbids (review 2, A). The ASSIGNMENT is refused (prefix, env, export); naming the variable in a grep is not.
      grep -qE '(^|[^A-Za-z0-9_])CC_MEMBER_SANDBOX[+:]?=' <<<"$cmd" && never "setting CC_MEMBER_SANDBOX — the boundary opens a workspace session from outside; a member-facing session never opens one on the host"
      if ! ws_dispatch_ok "$cmd" "$mws"; then
        grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' <<<"$cmd" && never "${mws:+dispatching outside this workspace — }a member-facing session does not dispatch workers (cc --go)${mws:+; inside \`$mws\` it may}"
      fi
      # cc-loop is the runner UNDERNEATH `cc … --go`, and the day's budget is charged in `cc`, not here: calling it
      # directly spends a workspace's money without ever touching the ledger. So a member never calls it at all.
      if grep -qE "$AT"'([^ ]*/)?cc-loop\b' <<<"$cmd"; then
        if [ -n "$mws" ]; then never "dispatching with cc-loop — inside \`$mws\` a worker starts with \`cc $mws <track> --go\`, the one form that charges the daily budget"
        else never "a member-facing session does not dispatch workers (cc-loop)"; fi
      fi
      if [ -n "$mws" ] && ! ws_cc_ok "$cmd" "$mws"; then
        never "creating outside \`$mws\` — this workspace makes tracks, boards and sessions under ~/dev/$mws and nowhere else"
      fi
      grep -qE "$AT"'([^ ]*/)?claude\b[^;&|]* (-p|--print)\b' <<<"$cmd" && never "a member-facing session does not dispatch workers (a headless claude spends the owner's budget)"
      grep -qE "$AT$RD"' +[^;&|]*'"$SEC" <<<"$cmd" && never "reading the box's secrets (~/.cc/config, ~/.ssh, ~/.claude/settings.json and the sealed-session copies of it under ~/.cc/sandbox)"
      grep -qE "$AT"'(cc +slack|([^ ]*/)?cc-slack) +(off|setup|mkchannel|updates-sweep|archive)\b' <<<"$cmd" && never "re-wiring the box's Slack (cc slack: off, setup, mkchannel, updates-sweep, archive)"
      # cc-config is the one sanctioned reader of ~/.cc/config — which makes it the one clean way AROUND the
      # secrets line above for a session that may not see them. Members get neither the read nor the write.
      grep -qE "$AT"'([^ ]*/)?cc-config\b' <<<"$cmd" && never "the box's config is not a member's to read or rewrite (cc-config)"
    fi
    # 6. steward only: everything above at the worker tier, plus the member tier's "no spend, no leak" — minus the
    #    workspace carve-outs, because a steward has no workspace to dispatch inside. Merging, landing, deploying,
    #    force pushes and posting in the owner's name are already refused by the worker rules above, so what a
    #    steward tier ADDS is dispatch and the box's other secrets. Same honest ceiling as rule 4: a Bash blocklist
    #    stops accidents and casual prompt-injection, not a redirection or a script written first — cc-steward's
    #    real wall is still that the model has no Bash at all (--disallowedTools), and this is what is left if that
    #    day ever comes. cc-notify stays allowed: escalating to the owner is the steward's own job.
    if [ -n "$steward" ]; then
      grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' <<<"$cmd" && never "a steward does not dispatch workers (cc --go) — it runs one named chain and escalates everything else"
      grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--orch\b' <<<"$cmd" && never "a steward does not start an orch (cc --orch) — a project a person steers is not a routine event"
      grep -qE "$AT"'([^ ]*/)?cc-loop\b' <<<"$cmd" && never "a steward does not dispatch workers (cc-loop)"
      # A steward IS a headless model call: another one is unbudgeted spend nobody is watching, and cc-steward
      # recursing on itself is that with a loop around it.
      grep -qE "$AT"'([^ ]*/)?claude\b[^;&|]* (-p|--print)\b' <<<"$cmd" && never "a steward does not spend the owner's budget on a second model call (a headless claude)"
      grep -qE "$AT"'([^ ]*/)?cc-steward +run\b' <<<"$cmd" && never "a steward does not run another steward (cc-steward run) — one event, one run"
      grep -qE "$AT$RD"' +[^;&|]*'"$SEC" <<<"$cmd" && never "reading the box's secrets (~/.cc/config, ~/.ssh, ~/.claude/settings.json and the sealed-session copies of it under ~/.cc/sandbox)"
      grep -qE "$AT"'(cc +slack|([^ ]*/)?cc-slack) +(off|setup|mkchannel|updates-sweep|archive)\b' <<<"$cmd" && never "re-wiring the box's Slack (cc slack: off, setup, mkchannel, updates-sweep, archive)"
      grep -qE "$AT"'([^ ]*/)?cc-config\b' <<<"$cmd" && never "the box's config is not a steward's to read or rewrite (cc-config)"
    fi
    ;;
  Read|NotebookRead|Grep|Glob)   # gating these files in Bash alone would be theatre if a file-reading TOOL served them
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // .tool_input.path // ""' <<<"$inp")
    [ -n "$fp" ] && fp=$(realpath -m -- "$fp" 2>/dev/null || echo "$fp")
    # …and the steward reads with the member's list, not the worker's: Read/Grep/Glob is the one tool set it
    # actually holds today, so gating ~/.cc/config in Bash alone would gate nothing it can reach.
    if [ "$role" = member ] || [ -n "$steward" ]; then secret_path "$fp" && never "reading the box's secrets ($fp)"
    else secret_all "$fp" && never "reading the box's credentials ($fp)"; fi ;;
  Edit|Write|MultiEdit|NotebookEdit)
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$inp")
    fp=$(realpath -m -- "${fp:-/}" 2>/dev/null || echo "$fp")   # ../ AND a symlink resolve before the match: ~/bin/x IS ~/dev/<repo>/core/bin/x, and so is a symlink farm in /tmp
    if ! in_root "$fp"; then case "$fp" in    # inside the worktree (rule 5: the marker root, not the cwd) / the member's own dir: fine
      /tmp/*) ;;                                   # scratch: fine
      "$HOME"/.claude/projects/*/memory/*)   # its own notes: claude saves them there, and both sandboxes bind that dir rw
        # So the write was always meant to land and only this rule said no — a member-facing session was refused
        # every note it tried to save (2026-09-04). The dir is named for the project ROOT, not the cwd, so it is
        # matched against this session's own roots: another project's notes are still somebody else's.
        m=${fp#"$HOME"/.claude/projects/}; m=${m%%/*}; mine=""
        for d in "$root" "$mdir" "${trepo:+$HOME/dev/$trepo}"; do
          [ -n "$d" ] && [ "$m" = "$(printf '%s' "$d" | tr '/.' '--')" ] && mine=1
        done
        [ -n "$mine" ] || never "writing another project's notes ($fp) — this session's are under ~/.claude/projects/<its own project dir>/memory" quiet;;
      "$HOME"/.cc/state/*)   # track state: this track's own; a member workspace's for the tracks that are its own
        if [ "$role" = member ]; then
          own=""; [ -n "$mws" ] && case "$fp" in "$HOME/.cc/state/$mws"|"$HOME/.cc/state/$mws"/*) own=1;; esac
          [ -n "$own" ] || never "writing another session's state ($fp) — a task.md there is work the box would run" quiet
        elif [ -n "$trepo" ]; then case "$fp" in "$HOME/.cc/state/$trepo/$ttrack"|"$HOME/.cc/state/$trepo/$ttrack"/*) ;;
          *) never "writing another track's state ($fp) — this track's is ~/.cc/state/$trepo/$ttrack" quiet;; esac
        fi;;
      *) never "editing outside this session's worktree ($fp) — a track writes its worktree, /tmp and its own ~/.cc/state dir" quiet;;
    esac; fi ;;
esac
exit 0
