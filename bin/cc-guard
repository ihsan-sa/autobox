  [ "$w1$w2$w3$w4$w5$we" = "222222" ] || { r=1; echo "      a non-seat write to perms state was not all refused: $w1 $w2 $w3 $w4 $w5 $we"; }
  [ -e "$H/.cc/state/demo68/perms/brief.md" ] || { r=1; echo "      the fixture's brief.md is gone — a refusal above did not actually hold"; }
