  printf '#!/bin/sh\necho hostname >> "${0%%/*}/calls"\ncase $1 in -I) echo 10.71.0.1;; *) echo box71;; esac\n' > "$S71/hostname"
  printf '#!/bin/sh\necho getent >> "${0%%/*}/calls"\ncase $2 in localhost) echo "127.0.0.1 STREAM localhost";; *[!0-9.]*) exit 2;; *) echo "$2 STREAM";; esac\n' > "$S71/getent"
