    || { r=1; echo "      #940 round 3, the files every claude starts from: refused $b68 (want 47 2s) / kept $k68 (want 9 0s)"; }
  # #940 round 4: A COMPUTED NAME IS JUDGED AT EVERY TIER. The planning tier (no role) rewrote the seat's pins through
  # `${d}rms/pins` and planted ~/.claude/CLAUDE.md through `~/.claude/${d}.md`; a worker passed the short tail too. Each
  # is refused, by a redirect, tee, cp and mv, and the pins one names `cc-perms pin`; a computed name in a scratch dir,
  # ~/dev or a track's own state dir still passes, and the live seat still writes its own pins that way.
  r4=""; kr4=""; : > "$T/x68"
  : > "$GERR"; r4="$r4$(g Bash "$(J "d=$H/.cc/state/demo68/pe; echo x >\${d}rms/pins")" "$H/plain68")"
  grep -q 'cc-perms pin' "$GERR" || { r=1; echo "      the computed-pins refusal does not name cc-perms pin as the seat's"; }
  r4="$r4$(g Bash "$(J "d=CLAUDE; echo x >~/.claude/\${d}.md")" "$H/plain68")"
  r4="$r4$(g Bash "$(J "d=CLAUDE; echo x > ~/.claude/\${d}.md")" "$H/plain68" CC_ROLE=worker)"
  r4="$r4$(g Bash "$(J "d=CLAUDE; echo x | tee ~/.claude/\${d}.md")" "$H/plain68")"
  r4="$r4$(g Bash "$(J "f=settings.json; cp /dev/null ~/.claude/\$f")" "$H/plain68" CC_ROLE=member)"
  r4="$r4$(g Bash "$(J "d=CLAUDE; mv $T/x68 \"\$HOME\"/.claude/\${d}.md")" "$H/plain68")"
  r4="$r4$(g Bash "$(J "d=.claude/CLAUDE; echo x > ~/\${d}.md")" "$H/plain68")"            # a head ~/.claude begins with
  r4="$r4$(g Bash "$(J "d=.json; echo {} > ~/.claude\$d")" "$H/plain68")"                    # ~/.claude.json
  r4="$r4$(g Bash "$(J "f=rms/pins; cp /dev/null $H/.cc/state/demo68/pe\$f")" "$H/plain68")"  # a head into the seat's dir name
  r4="$r4$(g Bash "$(J "f=pins; echo x > $H/.cc/state/demo68/perms/\$f")" "$H/plain68")"     # a head inside it
  r4="$r4$(g Bash "$(J "f=pins; echo x > $H/.cc/state/demo68/\$f")" "$H/plain68")"           # a name that could be perms/pins
  kr4="$kr4$(g Bash "$(J "S=$T/s68; echo x >\$S/out.txt")" "$H/plain68")"
  kr4="$kr4$(g Bash "$(J "d=$H/dev/demo68; echo x >\${d}/x")" "$H/plain68")"
  kr4="$kr4$(g Bash "$(J "echo x > ~/dev/\$r/notes.md")" "$H/plain68")"
  kr4="$kr4$(g Bash "$(J "echo x > $H/.cc/state/demo68/\$r/goals.md")" "$H/plain68")"
  kr4="$kr4$(g Bash "$(J "echo x | tee \$OUT/settings.json")" "$H/plain68" CC_ROLE=worker)"
  kr4="$kr4$(g Bash "$(J "echo x > $H/plain68/\${f}.md")" "$H/plain68" CC_ROLE=worker)"
  if [ -n "$seat68" ]; then kr4="$kr4$(g Bash "$(J "d=$H/.cc/state/demo68/pe; echo x >\${d}rms/pins")" "$T" CC_GUARD_ROOT_PID=$seat68)"
  else kr4="${kr4}2"; fi
  [ "$r4" = "22222222222" ] && [ "$kr4" = "0000000" ] \
    || { r=1; echo "      #940 round 4, computed names at every tier: refused $r4 (want 11 2s) / kept $kr4 (want 7 0s)"; }
  # #940 item 7: CC_WORKER_SANDBOX IS THE PERMS SEAT'S OR THE OWNER'S TO SET. The planning tier (CC_X68=1) is refused
  # each of these by the fence's own reason (an X instead of a 2 = refused by some other rule): cc-config set or unset
  # of it, a computed key or command word, the raw spelling under bash -c, a renamed copy of cc-config, a write to
  # ~/.cc/config that names it, builds it from an expansion, splits, recases or escapes it, or copies in a file that
  # holds it, a computed target that could be the config, a python one-liner, cc-perms relaunch with it or CC_CONFIG,
  # and the Write and Edit tools (an Edit judged by what it does to the key's line). A worker meets the ones that are
  # not plain writes to the file with the same reason; a plain write that does not spell the key is #855's live-tree
  # fence (its own rows in W11), and is checked here only for the reason it gives. Reading it, other keys, other
  # writes to the config and the live seat setting it pass.
  [ -e "$H/.cc/config" ] && cp -p "$H/.cc/config" "$T/cfg68.bak"
  printf 'CC_WORKER_SANDBOX=0\nCC_FOO=1\nCC_MEMBER_SANDBOX=0\n' > "$H/.cc/config"; printf 'CC_WORKER_SANDBOX=1\n' > "$T/dirty68"; printf 'CC_FOO=2\n' > "$T/clean68"
  sb68(){ local rc; rc=$(g "$@"); [ "$rc" = 2 ] && ! grep -qF 'set only by the perms seat or the owner' "$GERR" && rc=X; printf %s "$rc"; }
  s7=""; ks7=""
  for e68 in CC_X68=1 CC_ROLE=worker; do
    for q68 in "cc-config set CC_WORKER_SANDBOX 1" "cc-config unset CC_WORKER_SAND''BOX" 'k=CC_WORKER_SANDB; cc-config set "${k}OX" 1' \
      'c=cc-config; $c set CC_WORKER_SANDBOX 1' 'bash -c "cc-config set CC_WORKER_SANDBOX 1"' "./y68 set CC_WORKER_SANDBOX 1" \
      "if true; then $T/y68 unset 'CC_WORKER_SANDBOX'; fi" "echo CC_WORKER_SANDBOX=1 >> ~/.cc/config" \
      'k=CC_WORKER_SANDB; d=~/.cc; echo ${k}OX=1 >> $d/config' \
      "python3 -c 'import os; open(os.path.expanduser(\"~/.cc/config\"),\"a\").write(\"CC_WORKER_SANDBOX=1\")'" \
      "CC_WORKER_SANDBOX=1 cc-perms relaunch" "CC_CONFIG=$T/dirty68 cc-perms relaunch"; do
      s7="$s7$(sb68 Bash "$(J "$q68")" "$H/plain68" "$e68")"; done
    s7="$s7$(sb68 Write "$(jq -n --arg f "$H/.cc/config" '{file_path:$f,content:"CC_WORKER_SANDBOX=1\n"}')" "$H/plain68" "$e68")"
  done
  # the writes only the planning tier has judged by what they do to the key (G2 read of #940: a value flip that never
  # spells it, a printf-composed name, an escape)
  for q68 in 'k=CC_WORKER_SANDB; echo ${k}OX=1 >> ~/.cc/config' "cp $T/dirty68 ~/.cc/config" \
    "sed -i '/SANDBOX/s/0/1/' ~/.cc/config" "sed -i '/worker_sand/Is/0/1/' ~/.cc/config" \
    "printf 'CC_WORKER_%s=1\n' SANDBOX >> ~/.cc/config" "printf 'CC_W%sX=1\n' ORKER_SANDBO >> ~/.cc/config" \
    'printf "CC_\x57ORKER_\x53\x41\x4e\x44\x42\x4f\x58=1\n" >> ~/.cc/config' \
    'printf "CC_\127ORKER_\123\101\116\104\102\117\130=1\n" >> ~/.cc/config' \
    'echo cc_worker_sandbox=1 | tr a-z A-Z >> ~/.cc/config'; do
    s7="$s7$(sb68 Bash "$(J "$q68")" "$H/plain68" CC_X68=1)"; done
  s7="$s7$(sb68 Edit "$(jq -n --arg f "$H/.cc/config" '{file_path:$f,old_string:"X=0",new_string:"X=1"}')" "$H/plain68" CC_X68=1)"
  # …and at a gated tier those same writes are #855's: the live-tree fence gives its own reason. The Edit is left to
  # the worktree fence, which this fixture cannot show (its HOME is under /tmp, scratch to that fence), so the row
  # asserts what it can: the replay stays off at a gated tier and the key's fence does not answer for it (rc 0 here).
  w7=""; for q68 in "cp $T/dirty68 ~/.cc/config" "sed -i '/SANDBOX/s/0/1/' ~/.cc/config"; do
    w7="$w7$(g Bash "$(J "$q68")" "$H/plain68" CC_ROLE=worker)"; grep -qF "writing into the box's live tree" "$GERR" || w7="${w7}X"; done
  w7="$w7$(g Edit "$(jq -n --arg f "$H/.cc/config" '{file_path:$f,old_string:"X=0",new_string:"X=1"}')" "$H/plain68" CC_ROLE=worker)"
  ks7="$ks7$(g Bash "$(J "cc-config set CC_ORCH_EFFORT high")" "$H/plain68")"
  ks7="$ks7$(g Bash "$(J "cc-config set CC_WORKER_PACE_MARGIN 5")" "$H/plain68" CC_ROLE=worker)"
  ks7="$ks7$(g Bash "$(J "cc-config get CC_WORKER_SANDBOX")" "$H/plain68" CC_ROLE=worker)"
  ks7="$ks7$(g Bash "$(J "echo CC_FOO=2 >> ~/.cc/config")" "$H/plain68")"
  ks7="$ks7$(g Bash "$(J "cp $T/clean68 ~/.cc/config")" "$H/plain68")"
  ks7="$ks7$(g Edit "$(jq -n --arg f "$H/.cc/config" '{file_path:$f,old_string:"CC_FOO=1",new_string:"CC_FOO=2"}')" "$H/plain68")"
  ks7="$ks7$(g Bash "$(J "echo CC_MEMBER_SANDBOX=1 >> ~/.cc/config")" "$H/plain68")"            # the other sandbox key
  ks7="$ks7$(g Bash "$(J "sed -i '/MEMBER_SANDBOX/s/0/1/' ~/.cc/config")" "$H/plain68")"
  ks7="$ks7$(g Bash "$(J "sed -i 's/^\\(CC_FOO=\\).*/\\15/' ~/.cc/config")" "$H/plain68")"      # a backreference is no escape
  ks7="$ks7$(g Bash "$(J "if true; then unset CC_WORKER_SANDBOX; fi")" "$H/plain68")"           # the shell's own unset
  ks7="$ks7$(g Bash "$(J "./y68 get CC_WORKER_SANDBOX")" "$H/plain68")"
  if [ -n "$seat68" ]; then
    ks7="$ks7$(g Bash "$(J "cc-config set CC_WORKER_SANDBOX 1")" "$T" CC_GUARD_ROOT_PID=$seat68)"
    ks7="$ks7$(g Bash "$(J "echo CC_WORKER_SANDBOX=1 >> ~/.cc/config")" "$T" CC_GUARD_ROOT_PID=$seat68)"
    ks7="$ks7$(g Write "$(jq -n --arg f "$H/.cc/config" '{file_path:$f,content:"CC_WORKER_SANDBOX=1\n"}')" "$T" CC_GUARD_ROOT_PID=$seat68)"
  else ks7="${ks7}222"; fi
  rm -f "$H/.cc/config" "$T/dirty68" "$T/clean68"; [ -e "$T/cfg68.bak" ] && mv "$T/cfg68.bak" "$H/.cc/config"
  [ "$s7" = "$(printf '2%.0s' $(seq 36))" ] && [ "$w7" = 220 ] && [ "$ks7" = "00000000000000" ] \
    || { r=1; echo "      #940 item 7, CC_WORKER_SANDBOX: refused $s7 (want 36 2s; X = another rule) / #855's reason $w7 (want 220) / kept $ks7 (want 14 0s)"; }
  # a flagged claude with no claude above it, but started OUTSIDE the seat's directory, is not the seat
  (cd "$T" && setsid -f "$T/claude" --dangerously-skip-permissions >/dev/null 2>&1 </dev/null & disown)
  sleep 0.3; away68=""
  for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
    [ "$cand" != "$seat68" ] && [ "$(readlink "/proc/$cand/cwd")" = "$T" ] && { away68=$cand; break; }
  done
  if [ -n "$away68" ]; then a1=$(g Bash "$(J "echo x > $H/.cc/state/demo68/perms/brief.md")" "$T" CC_GUARD_ROOT_PID=$away68)
    [ "$a1" = 2 ] || { r=1; echo "      a flagged claude outside the seat's directory was taken for the seat: rc $a1"; }
    kill "$away68" 2>/dev/null
  else r=1; echo "      no away-from-home fixture claude to test the seat's directory against"; fi
  mkdir -p "$T/nest68"; printf '#!/bin/sh\n"%s" --dangerously-skip-permissions\n:\n' "$T/claude" > "$T/nest68/claude"   # ':' after: no exec-in-place
  chmod +x "$T/nest68/claude"; (cd "$H/.cc/state/demo68/perms" && setsid -f "$T/nest68/claude" >/dev/null 2>&1 </dev/null & disown)
  sleep 0.3; kid68=""
  for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
    [ "$cand" != "$seat68" ] && [ "$(cat "/proc/$(awk '{print $4}' "/proc/$cand/stat" 2>/dev/null)/comm" 2>/dev/null)" = claude ] && { kid68=$cand; break; }
  done
  if [ -n "$kid68" ]; then n1=$(g Bash "$(J "echo x > $H/.cc/state/demo68/perms/brief.md")" "$T" CC_GUARD_ROOT_PID=$kid68)
    [ "$n1" = 2 ] || { r=1; echo "      a flagged claude under another claude was taken for the seat: rc $n1"; }
  else r=1; echo "      no nested fixture claude to test the forged-flag refusal against"; fi
  pkill -f -- "$T/nest68/claude" 2>/dev/null; [ -n "$kid68" ] && kill "$kid68" 2>/dev/null
  # …and the landing review keys' setter is the seat's alone: a worker, a planning seat and a member are refused it,
  # the seat runs it, and anyone may run its selfcheck or read it
  rk="cc-review-keys CC_LAND_REVIEWERS claude-opus-5-5"
  rk1=$(g Bash "$(J "$rk")" "$WT" CC_ROLE=worker); rk2=$(g Bash "$(J "$rk")" "$T"); rk3=$(g Bash "$(J "$rk")" "$H/dev/_cctest1" CC_ROLE=member)
  rk4=$(g Bash "$(J "env $H/bin/cc-review-keys CC_LAND_REVIEW_EFFORT low")" "$T")
  rk5=2; [ -n "$seat68" ] && rk5=$(g Bash "$(J "$rk")" "$T" CC_GUARD_ROOT_PID=$seat68)
  rk6=$(g Bash "$(J "cc-review-keys selfcheck")" "$WT" CC_ROLE=worker); rk7=$(g Bash "$(J "grep -n MODELS $H/bin/cc-review-keys")" "$T")
  [ "$rk1$rk2$rk3$rk4$rk5$rk6$rk7" = 2222000 ] || { r=1; echo "      cc-review-keys: worker $rk1, planning seat $rk2, member $rk3, by path $rk4 (want 2s); seat $rk5, selfcheck $rk6, read $rk7 (want 0s)"; }
  # a selfcheck after a real call, on one line or the next, exempts nothing
  for rkc in "$rk; cc-review-keys selfcheck" "$rk"$'\n'"cc-review-keys selfcheck"; do
    rk8=$(g Bash "$(J "$rkc")" "$WT" CC_ROLE=worker); rk9=$(g Bash "$(J "$rkc")" "$T"); rk10=$(g Bash "$(J "$rkc")" "$H/dev/_cctest1" CC_ROLE=member)
    [ "$rk8$rk9$rk10" = 222 ] || { r=1; echo "      cc-review-keys then its selfcheck ($(printf %q "$rkc")): worker $rk8, planning seat $rk9, member $rk10 (want 2s)"; }
  done
  unset GERR; kill "$seat68" 2>/dev/null
  ok "the permission seat's state is fenced like ~/.cc/state/arch — a redirect, cp, rm, a glob, an rm of the directory above it and the Write tool are all refused from anywhere but the live seat, which may still write its own" $r

  # 68c. TEXT THAT ONLY NAMES THE SEAT'S STATE IS NOT A WRITE TO IT (row raised-guard-refuses-text-naming-perms-dir).
  #      A journal append, a printf and a quoted heredoc into the track's own state dir that name the seat's path,
  #      and an ls of it beside date/tail/cut, all pass; the same shapes aimed at the seat, a second statement after
  #      them, an unquoted heredoc tag, a `$( )` in the text and a heredoc that closes early stay refused.
  r=0; P68=$H/.cc/state/demo68c/perms; S68=$H/.cc/state/demo68c/trk; mkdir -p "$P68" "$S68" "$H/plain68c"; printf 'b' > "$P68/brief.md"
  c1=$(g Bash "$(J "echo \"- refused: an ls of $P68 was read as a write\" >> $S68/progress.md")" "$H/plain68c" CC_ROLE=worker)
  c2=$(g Bash "$(J "printf '%s\n' \"named $P68/brief.md\" >> $S68/progress.md")" "$H/plain68c" CC_ROLE=worker)
  c3=$(g Bash "$(J "cat > $S68/notes.md <<'EOF'
the seat's brief is $P68/brief.md
EOF")" "$H/plain68c" CC_ROLE=worker)
  c4=$(g Bash "$(J "ls $P68; date -u; tail -3 $S68/progress.md; ls -la $S68 | cut -c1-40")" "$H/plain68c" CC_ROLE=worker)
  d1=$(g Bash "$(J "echo x >> $P68/brief.md")" "$H/plain68c" CC_ROLE=worker)
  d2=$(g Bash "$(J "echo $P68 >> $S68/progress.md; touch $P68/brief.md")" "$H/plain68c" CC_ROLE=worker)
  d3=$(g Bash "$(J "cat > $S68/n <<EOF
\$(touch $P68/brief.md)
EOF")" "$H/plain68c" CC_ROLE=worker)
  d4=$(g Bash "$(J "cat > $S68/n <<'EOF'
EOF
touch $P68/brief.md
EOF")" "$H/plain68c" CC_ROLE=worker)
  d5=$(g Bash "$(J "echo \"\$(touch $P68/brief.md)\" >> $S68/progress.md")" "$H/plain68c" CC_ROLE=worker)
  d6=$(g Bash "$(J "cat > $P68/brief.md <<'EOF'
x
EOF")" "$H/plain68c" CC_ROLE=worker)
  d7=$(g Bash "$(J "D=$P68; echo x > \$D/brief.md")" "$H/plain68c" CC_ROLE=worker)
  d8=$(g Bash "$(J "echo \"\$\`touch $P68/made\$\`\" >> $S68/progress.md")" "$H/plain68c" CC_ROLE=worker)   # the #1184 handback
  d9=$(g Bash "$(J "echo \"\$\\\\\`touch $P68/made\$\\\\\`\" >> $S68/progress.md")" "$H/plain68c" CC_ROLE=worker)
  [ "$c1$c2$c3$c4" = "0000" ] || { r=1; echo "      text naming the seat's state as data was refused: $c1 $c2 $c3 $c4 (want 0s)"; }
  [ "$d1$d2$d3$d4$d5$d6$d7$d8$d9" = "222222222" ] || { r=1; echo "      a write into the seat's state was let through: $d1 $d2 $d3 $d4 $d5 $d6 $d7 $d8 $d9 (want 2s)"; }
  [ "$(cat "$P68/brief.md")" = b ] || { r=1; echo "      the fixture's brief.md changed — a refusal above did not hold"; }
  ok "text that only names the seat's state passes — an echo, a printf and a quoted heredoc into the track's own file, an ls beside date/tail/cut — while the same shapes aimed at the seat, or carrying a second statement, a \$( ), a backtick after a \$ or an early-closing heredoc, are refused" $r

  # 68d. A `|` OR `;` INSIDE QUOTES IS NO SECOND STATEMENT (row raised-guard-blocks-perms-store-read). The dispatch
  #      seat's `grep -E '1615|1616' …/security-reads.json` was refused as a write, and so was a jq filter with a pipe
  #      in it. Each read below passes at both tiers; every write stays refused, and so does an escaped quote, a $'…'
  #      or an open quote that would hide a second statement. A python read is refused too: python can write as well
  #      as read, and the guard does not read python, so jq is the way to read the ledger.
  r=0; L68=$H/.cc/state/demo68d/perms/security-reads.json; mkdir -p "${L68%/*}"; printf '{"1615":"ok"}' > "$L68"
  for tier in CC_ROLE= CC_ROLE=worker; do
    e1=$(g Bash "$(J "grep 1615 $L68")" "$H/plain68" $tier)
    e2=$(g Bash "$(J "grep -E '1615|1616|1620' $L68")" "$H/plain68" $tier)
    e3=$(g Bash "$(J "cat $L68; head -c 80 $L68 | wc -c")" "$H/plain68" $tier)
    e4=$(g Bash "$(J "jq -r 'to_entries | map(select(.key == \"1615\")) | length' $L68")" "$H/plain68" $tier)
    f1=$(g Bash "$(J "echo x > $L68")" "$H/plain68" $tier)
    f2=$(g Bash "$(J "sed -i 's/ok/no/' $L68")" "$H/plain68" $tier)
    f3=$(g Bash "$(J "python3 -c \"open('$L68','w').write('{}')\"")" "$H/plain68" $tier)
    f4=$(g Bash "$(J "grep 'a|b' $L68; echo \\' ; rm $L68 ; echo \\'")" "$H/plain68" $tier)
    f5=$(g Bash "$(J "cat \$'\\'' ; rm $L68 ; echo \$'\\''")" "$H/plain68" $tier)
    f6=$(g Bash "$(J "grep 'a|b' $L68 ' ; rm $L68")" "$H/plain68" $tier)
    f7=$(g Bash "$(J "python3 -c \"import json; print(json.load(open('$L68')).get('1615'))\"")" "$H/plain68" $tier)
    [ "$e1$e2$e3$e4" = "0000" ] || { r=1; echo "      [$tier] a read of the seat's ledger was refused: $e1 $e2 $e3 $e4 (want 0s)"; }
    [ "$f1$f2$f3$f4$f5$f6$f7" = "2222222" ] || { r=1; echo "      [$tier] a write, a hidden statement or python was let through: $f1 $f2 $f3 $f4 $f5 $f6 $f7 (want 2s)"; }
  done
  [ "$(cat "$L68")" = '{"1615":"ok"}' ] || { r=1; echo "      the fixture's ledger changed — a refusal above did not hold"; }
  ok "a read of the seat's ledger with a | or ; inside quotes (grep -E 'a|b', a jq pipe) passes at both tiers, while a redirect, sed -i, a python open(…,'w'), a python read and a quote that hides a second statement stay refused" $r

  # 68e. ONLY A BARE READ-TOOL NAME IS A READ (perms-38's read of #1660). pread kept the basename and passed an
  #      assignment, so `/tmp/x/cat` and `PATH=/tmp/x; cat` ran whatever binary sat there. Both are refused now.
  r=0; L68e=$H/.cc/state/demo68e/perms/brief.md; mkdir -p "${L68e%/*}"; echo b > "$L68e"
  e1=$(g Bash "$(J "cat $L68e")" "$H/plain68" CC_ROLE=worker)
  f1=$(g Bash "$(J "/tmp/x/cat $L68e")" "$H/plain68" CC_ROLE=worker)
  f2=$(g Bash "$(J "PATH=/tmp/x; cat $L68e")" "$H/plain68" CC_ROLE=worker)
  f3=$(g Bash "$(J "PATH=/tmp/x cat $L68e")" "$H/plain68" CC_ROLE=worker)
  [ "$e1$f1$f2$f3" = 0222 ] || { r=1; echo "      a bare cat, a cat by path, an assignment then cat, PATH=… cat: $e1 $f1 $f2 $f3 (want 0 2 2 2)"; }
  ok "a bare cat of the seat's state passes, while a cat by path or after an assignment to PATH is refused" $r

  # 68b. EVERY SEAT'S LAUNCH SCRIPT IS IN THE SAME FENCE (perms, 2026-10-13). The live perms seat was started from
  #     ~/.cc/state/hs/launch/perms.sh, which reads perms.argv and perms.env beside it, and every seat has its
  #     <target>.sh/.argv/.env/.cwd/.pass there. Before the fence a planning seat and an orch passed every shape
  #     below, and a worker passed every Bash one; a rewritten perms.sh is what the next unsandboxed seat runs.
  #     Its own fixture: a launch dir of its own, a seat of its own, and three tiers each refused and each kept.
  r=0; GERR=$T/gerr68b; L68=$H/.cc/state/hs/launch; mkdir -p "$L68" "$H/dev/ctl" "$H/.cc/state/hsx"
  printf 'exec claude\n' > "$L68/perms.sh"; printf 'x\n' > "$L68/perms.argv"
  for tier in planning orch worker; do
    case $tier in   # an orch is the ungated tier too, in the repo's checkout; what tells it apart is its alias
      planning) c=$H/dev/ctl; e=(); c2=${T2:+$T2/home/dev/ctl};;
      orch) c=$H/dev/ctl; e=(CC_SLACK_ALIAS=ctl@architect); c2=${T2:+$T2/home/dev/ctl};;
      worker) c=$WT; e=(CC_ROLE=worker); c2=${T2:+$T2/home/.cc/worktrees/demo/t1};;
    esac
    for x in "echo x > $L68/perms.sh" "echo x >> $L68/perms.sh" "echo x | tee $L68/perms.sh" "cp /dev/null $L68/perms.sh" \
             "mv $T/x68b $L68/perms.sh" "sed -i s/claude/sh/ $L68/perms.sh" "ln -sf $T/x68b $L68/perms.sh" "echo x > $L68/perms.argv" \
             "ln -sfn $T/evil68b $H/.cc/state/hs" "rm -rf $H/.cc/state/hs" "cd $H/.cc/state && echo x > hs/launch/perms.sh" "D=$H/.cc/state; echo x > \$D/hs/launch/perms.sh"; do
      : > "$GERR"; got=$(g Bash "$(J "$x")" "$c" "${e[@]}")
      { [ "$got" = 2 ] && grep -qF "writing a seat's launch script" "$GERR"; } || { r=1; echo "      $tier: not refused as a launch-script write (rc $got): $x — $(head -c 80 "$GERR")"; }
    done
    # …and RUNNING the dir's writer passes: hs-clone (~/dev/handoff/bin) writes it with open() inside its own process,
    # and the hs session runs it as a program, so a fence that refused these would break every seat's recovery
    for x in "cat $L68/perms.sh" "ls -la $L68" "echo x > $H/.cc/state/hsx/f" "hs-clone capture ctl@architect" \
             "$H/dev/handoff/bin/hs-clone launch perms" "cd $H/dev/handoff && bin/hs-clone capture perms"; do   # a read, a sibling name and hs-clone pass
      got=$(g Bash "$(J "$x")" "$c" "${e[@]}"); [ "$got" = 0 ] || { r=1; echo "      $tier: refused what is no launch-script write (rc $got): $x"; }
    done
    if [ -n "$T2" ]; then   # the Write tool waves /tmp through as scratch, so its fixture home sits outside /tmp
      L2=$T2/home/.cc/state/hs/launch; mkdir -p "$L2" "$c2/.cc"; [ "$tier" = worker ] && : > "$c2/.cc/track"; : > "$L2/perms.sh"
      for tl in Write Edit; do
        : > "$GERR"; got=$(GH=$T2/home g "$tl" "$(jq -n --arg f "$L2/perms.sh" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c2" "${e[@]}")
        { [ "$got" = 2 ] && grep -qF "writing a seat's launch script" "$GERR"; } || { r=1; echo "      $tier: the $tl tool into the launch dir was not refused as one (rc $got) — $(head -c 80 "$GERR")"; }
      done
    else r=1; echo "      no fixture home outside /tmp to test the Write tool against"; fi
  done
  [ "$(cat "$L68/perms.sh")" = "exec claude" ] || { r=1; echo "      the fixture's perms.sh changed — a refusal above did not actually hold"; }
  # …and the permission seat itself still writes there: a flagged claude, detached, in its own state directory
  mkdir -p "$H/.cc/state/demo68b/perms"
  (cd "$H/.cc/state/demo68b/perms" && setsid -f "$T/claude" --dangerously-skip-permissions >/dev/null 2>&1 </dev/null & disown)
  sleep 0.3; seat68b2=""
  for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
    [ "$(readlink "/proc/$cand/cwd")" = "$H/.cc/state/demo68b/perms" ] && { seat68b2=$cand; break; }
  done
  if [ -n "$seat68b2" ]; then got=$(g Bash "$(J "echo x > $L68/perms.argv")" "$T" CC_GUARD_ROOT_PID=$seat68b2)
    [ "$got" = 0 ] || { r=1; echo "      the permission seat's own write to the launch dir was refused: rc $got"; }
    kill "$seat68b2" 2>/dev/null
  else r=1; echo "      no detached fixture claude to test the seat's own write against"; fi
  unset GERR
  ok "every seat's launch script (~/.cc/state/hs) is fenced from a planning seat, an orch and a worker — a redirect, append, tee, cp, mv, sed -i, a symlink over the script or the dir, rm and the Write and Edit tools — while a read and a sibling dir pass and the permission seat may still write it" $r

  # 68c. A SEAT'S TRANSCRIPT IS A LAUNCH INPUT, AND NO TIER WRITES IT (perms, 2026-10-13). hs-clone relaunches each
  #     seat with --resume <sid>, so a line planted in ~/.claude/projects/<proj>/<sid>.jsonl is that seat's own turn
  #     on relaunch. Before the fence a planning seat and an orch passed every shape below, and a worker every Bash
  #     one. A session's notes in <proj>/memory are still its own to write, and a read passes.
  #     Its own fixture: a home of its own outside /tmp (the write rules wave /tmp through), with its own transcripts.
  r=0; GERR=$T/gerr68c
  if [ -z "$T2" ]; then r=1; echo "      no fixture home outside /tmp: these rules wave /tmp through, so nothing here would be gated"
  else
    H3=$T2/h68c; mkdir -p "$H3/bin" "$H3/dev/ctl" "$H3/dev/demo" "$H3/.cc/worktrees/demo/t1/.cc"; : > "$H3/.cc/worktrees/demo/t1/.cc/track"
    cp "$H/bin/cc-notify" "$H/bin/cc-slack" "$H/bin/cc-failures" "$H3/bin/"
    pj=$(printf '%s' "$H3/dev/ctl" | tr '/.' '--'); P68=$H3/.claude/projects/$pj; mkdir -p "$P68/s1/subagents"
    printf '{}\n' > "$P68/s1.jsonl"; printf '{}\n' > "$P68/s1/subagents/a1.jsonl"
    for tier in planning orch worker; do
      case $tier in
        planning) c=$H3/dev/ctl; e=(); mem=$P68/memory;;
        orch) c=$H3/dev/ctl; e=(CC_SLACK_ALIAS=ctl@architect); mem=$P68/memory;;
        worker) c=$H3/.cc/worktrees/demo/t1; e=(CC_ROLE=worker); mem=$H3/.claude/projects/$(printf '%s' "$H3/dev/demo" | tr '/.' '--')/memory;;
      esac
      for tf in "$P68/s1.jsonl" "$P68/s1/subagents/a1.jsonl"; do
        for x in "echo {} > $tf" "echo {} >> $tf" "echo {} | tee -a $tf" "cp /dev/null $tf" "mv $T/x68c $tf" "sed -i s/a/b/ $tf" "ln -sf $T/x68c $tf"; do
          : > "$GERR"; got=$(GH=$H3 g Bash "$(J "$x")" "$c" "${e[@]}")
          { [ "$got" = 2 ] && grep -qF "writing a session transcript" "$GERR"; } || { r=1; echo "      $tier: not refused as a transcript write (rc $got): $x — $(head -c 80 "$GERR")"; }
        done
        for tl in Write Edit; do
          : > "$GERR"; got=$(GH=$H3 g "$tl" "$(jq -n --arg f "$tf" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c" "${e[@]}")
          { [ "$got" = 2 ] && grep -qF "writing a session transcript" "$GERR"; } || { r=1; echo "      $tier: the $tl tool into a transcript was not refused as one (rc $got) — $(head -c 80 "$GERR")"; }
        done
      done
      # the dir over them, a glob, and a relative name after a cd: the transcript dirs are all named -home-…
      for x in "ln -sfn $T/evil68c $P68" "echo {} >> $H3/.claude/projects/*/s1.jsonl" "cd $H3/.claude/projects && echo {} >> $pj/s1.jsonl" \
               "cd $H3/.claude/projects && echo {} | tee -a -- $pj/s1.jsonl"; do
        : > "$GERR"; got=$(GH=$H3 g Bash "$(J "$x")" "$c" "${e[@]}")
        { [ "$got" = 2 ] && grep -qF "writing a session transcript" "$GERR"; } || { r=1; echo "      $tier: not refused as a transcript write (rc $got): $x — $(head -c 80 "$GERR")"; }
      done
      # kept: a read of a transcript, and the session's own notes through the Write and Edit tools
      got=$(GH=$H3 g Bash "$(J "tail -1 $P68/s1.jsonl")" "$c" "${e[@]}"); [ "$got" = 0 ] || { r=1; echo "      $tier: reading a transcript was refused (rc $got)"; }
      for tl in Write Edit; do
        got=$(GH=$H3 g "$tl" "$(jq -n --arg f "$mem/MEMORY.md" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c" "${e[@]}")
        [ "$got" = 0 ] || { r=1; echo "      $tier: the $tl tool into its own memory was refused (rc $got)"; }
      done
    done
    [ "$(cat "$P68/s1.jsonl")" = "{}" ] || { r=1; echo "      the fixture's transcript changed — a refusal above did not actually hold"; }
  fi
  unset GERR
  ok "a session transcript (~/.claude/projects/<proj>/*.jsonl, subagents included) is fenced from a planning seat, an orch and a worker — a redirect, append, tee, cp, mv, sed -i, a symlink, a glob, a -home-… name after a cd and the Write and Edit tools — while a read passes and each session still writes its own memory" $r

  # 68d. THE PERMISSION SEAT'S MEMORY AND EVERY SHELL STARTUP FILE ARE LAUNCH INPUTS, AND NO OTHER CALLER WRITES THEM
  #     (perms, 2026-10-13). Perms' MEMORY.md loads into every perms start, and a session sources its shell snapshot
  #     before every Bash call (a login shell reads ~/.bashrc and the rest). Before the fence a planning seat and an
  #     orch passed every shape below on each of them, and a worker every Bash one, even with its cwd in the seat's dir.
  #     Kept: the seat writing its own memory from its own state dir, a planning seat's own memory, a read, and
  #     core/install.sh (it appends to ~/.bashrc) run as a program. Its own fixture: a home outside /tmp and a seat.
  r=0; GERR=$T/gerr68d
  if [ -z "$T2" ]; then r=1; echo "      no fixture home outside /tmp: these rules wave /tmp through, so nothing here would be gated"
  else
    H4=$T2/h68d; SD4=$H4/.cc/state/demo/perms; mkdir -p "$H4/bin" "$H4/dev/ctl" "$H4/dev/demo" "$H4/.cc/worktrees/demo/t1/.cc" "$SD4" "$H4/.claude/shell-snapshots"
    : > "$H4/.cc/worktrees/demo/t1/.cc/track"; cp "$H/bin/cc-notify" "$H/bin/cc-slack" "$H/bin/cc-failures" "$H4/bin/"
    PM4=$H4/.claude/projects/$(printf '%s' "$SD4" | tr '/.' '--')/memory; mkdir -p "$PM4"; printf 'seat\n' > "$PM4/MEMORY.md"
    for lf in .bashrc .profile .bash_profile .bash_login .claude/shell-snapshots/snapshot-bash-1.sh; do printf '#\n' > "$H4/$lf"; done
    for tier in planning orch worker; do
      case $tier in
        planning) c=$H4/dev/ctl; e=(); own=$H4/.claude/projects/$(printf '%s' "$H4/dev/ctl" | tr '/.' '--')/memory;;
        orch) c=$H4/dev/ctl; e=(CC_SLACK_ALIAS=ctl@architect); own=$H4/.claude/projects/$(printf '%s' "$H4/dev/ctl" | tr '/.' '--')/memory;;
        worker) c=$H4/.cc/worktrees/demo/t1; e=(CC_ROLE=worker); own=$H4/.claude/projects/$(printf '%s' "$H4/dev/demo" | tr '/.' '--')/memory;;
      esac
      for lf in "$PM4/MEMORY.md" "$H4/.bashrc" "$H4/.profile" "$H4/.bash_profile" "$H4/.bash_login" "$H4/.claude/shell-snapshots/snapshot-bash-1.sh"; do
        case "$lf" in "$PM4"/*) why="writing the permission seat's project dir";; *) why="writing a shell startup file";; esac
        for x in "echo x > $lf" "echo x >> $lf" "echo x | tee -a $lf" "cp /dev/null $lf" "mv $T/x68d $lf" "sed -i s/a/b/ $lf" "ln -sf $T/x68d $lf"; do
          : > "$GERR"; got=$(GH=$H4 g Bash "$(J "$x")" "$c" "${e[@]}")
          { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } || { r=1; echo "      $tier: not refused as $why (rc $got): $x — $(head -c 80 "$GERR")"; }
        done
        for tl in Write Edit; do
          : > "$GERR"; got=$(GH=$H4 g "$tl" "$(jq -n --arg f "$lf" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c" "${e[@]}")
          { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } || { r=1; echo "      $tier: the $tl tool was not refused as $why (rc $got): $lf — $(head -c 80 "$GERR")"; }
        done
      done
      # a cwd is no pass: any session can `cd` into the seat's dir, and the next call carries that cwd
      : > "$GERR"; got=$(GH=$H4 g Write "$(jq -n --arg f "$PM4/MEMORY.md" '{file_path:$f,content:"x"}')" "$SD4" "${e[@]}")
      { [ "$got" = 2 ] && grep -qF "writing the permission seat's project dir" "$GERR"; } || { r=1; echo "      $tier: a Write into the seat's memory from the seat's cwd, by a non-seat, passed (rc $got)"; }
      # …and `cp /tmp/d/.bashrc ~/` writes ~/.bashrc as surely as naming it
      : > "$GERR"; got=$(GH=$H4 g Bash "$(J "cp $T/d68d/.bashrc $H4/")" "$c" "${e[@]}")
      { [ "$got" = 2 ] && grep -qF "writing a shell startup file" "$GERR"; } || { r=1; echo "      $tier: cp of a .bashrc into the home was not refused (rc $got)"; }
      # kept: its own memory, a read, and the one tool that writes ~/.bashrc, run as a program
      for tl in Write Edit; do
        got=$(GH=$H4 g "$tl" "$(jq -n --arg f "$own/MEMORY.md" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c" "${e[@]}")
        [ "$got" = 0 ] || { r=1; echo "      $tier: the $tl tool into its own memory was refused (rc $got)"; }
      done
      for x in "cat $H4/.bashrc $PM4/MEMORY.md" "bash $H4/dev/ctl/core/install.sh" "core/install.sh"; do
        got=$(GH=$H4 g Bash "$(J "$x")" "$c" "${e[@]}"); [ "$got" = 0 ] || { r=1; echo "      $tier: refused what writes no launch input (rc $got): $x"; }
      done
    done
    # …and the seat itself still writes its own memory: a flagged claude, detached, with its state dir as its cwd
    (cd "$SD4" && setsid -f "$T/claude" --dangerously-skip-permissions >/dev/null 2>&1 </dev/null & disown)
    sleep 0.3; seat68d=""
    for cand in $(pgrep -f -- "$T/claude --dangerously-skip-permissions"); do
      [ "$(readlink "/proc/$cand/cwd")" = "$SD4" ] && { seat68d=$cand; break; }
    done
    if [ -n "$seat68d" ]; then
      got=$(GH=$H4 g Write "$(jq -n --arg f "$PM4/MEMORY.md" '{file_path:$f,content:"x"}')" "$SD4" CC_GUARD_ROOT_PID=$seat68d)
      [ "$got" = 0 ] || { r=1; echo "      the permission seat's Write into its own memory was refused: rc $got"; }
      got=$(GH=$H4 g Bash "$(J "echo x >> $H4/.bashrc")" "$SD4" CC_GUARD_ROOT_PID=$seat68d)   # …but not a startup file
      [ "$got" = 2 ] || { r=1; echo "      the permission seat's append to ~/.bashrc passed: rc $got"; }
      kill "$seat68d" 2>/dev/null
    else r=1; echo "      no detached fixture claude to test the seat's own write against"; fi
    [ "$(cat "$H4/.bashrc")" = "#" ] || { r=1; echo "      the fixture's .bashrc changed — a refusal above did not actually hold"; }
  fi
  unset GERR
  ok "the permission seat's project memory and every shell startup file (~/.bashrc, ~/.profile, ~/.bash_profile, ~/.bash_login, ~/.claude/shell-snapshots) are fenced from a planning seat, an orch and a worker, from the seat's own cwd too, while the seat writes its own memory, each session its own, and core/install.sh still runs" $r

  # 68e. A SESSION'S HOOK ENV FILES ARE SOURCED INTO ITS BASH CALLS, AND NO TIER WRITES THEM (perms item 5,
  #     2026-10-13). Claude Code writes ~/.claude/session-env/<session-id>/ (CLAUDE_ENV_FILE) from hook processes and
  #     sources it into that session's Bash commands, as it does the shell snapshot. Before the fence a planning seat
  #     and an orch passed every shape below, removal included, and a worker every write. A read still passes.
  #     Its own fixture: a home outside /tmp with one session's env dir.
  r=0; GERR=$T/gerr68e
  if [ -z "$T2" ]; then r=1; echo "      no fixture home outside /tmp: these rules wave /tmp through, so nothing here would be gated"
  else
    H5=$T2/h68e; SE5=$H5/.claude/session-env/0b6e-sid; mkdir -p "$H5/bin" "$H5/dev/ctl" "$H5/.cc/worktrees/demo/t1/.cc" "$SE5"
    : > "$H5/.cc/worktrees/demo/t1/.cc/track"; cp "$H/bin/cc-notify" "$H/bin/cc-slack" "$H/bin/cc-failures" "$H5/bin/"; printf '#\n' > "$SE5/hook-1.sh"
    for tier in planning orch worker; do
      case $tier in
        planning) c=$H5/dev/ctl; e=();;
        orch) c=$H5/dev/ctl; e=(CC_SLACK_ALIAS=ctl@architect);;
        worker) c=$H5/.cc/worktrees/demo/t1; e=(CC_ROLE=worker);;
      esac
      ef=$SE5/hook-1.sh
      for x in "echo x > $ef" "echo x >> $ef" "echo x | tee -a $ef" "cp /dev/null $ef" "mv $T/x68e $ef" "sed -i s/a/b/ $ef" "ln -sf $T/x68e $ef" \
               "cp $T/x68e.sh -t $SE5" "echo x > $H5/.claude/session-env/*/hook-1.sh" "rm -f $ef" "rm -rf $SE5" "rm -rf $H5/.claude/session-env"; do
        : > "$GERR"; got=$(GH=$H5 g Bash "$(J "$x")" "$c" "${e[@]}")
        # a worker's rm -rf outside its tree meets the recursive-delete rule first, on main as here: rc 2 is the answer
        case "$tier:$x" in worker:rm\ -rf*) [ "$got" = 2 ] || { r=1; echo "      worker: not refused (rc $got): $x"; }; continue;; esac
        { [ "$got" = 2 ] && grep -qF "writing a shell startup file" "$GERR"; } || { r=1; echo "      $tier: not refused as a session env write (rc $got): $x — $(head -c 80 "$GERR")"; }
      done
      for tl in Write Edit; do
        : > "$GERR"; got=$(GH=$H5 g "$tl" "$(jq -n --arg f "$ef" '{file_path:$f,old_string:"a",new_string:"x",content:"x"}')" "$c" "${e[@]}")
        { [ "$got" = 2 ] && grep -qF "writing a shell startup file" "$GERR"; } || { r=1; echo "      $tier: the $tl tool into session-env was not refused as one (rc $got) — $(head -c 80 "$GERR")"; }
      done
      got=$(GH=$H5 g Bash "$(J "cat $ef; ls $SE5")" "$c" "${e[@]}"); [ "$got" = 0 ] || { r=1; echo "      $tier: reading session-env was refused (rc $got)"; }
    done
    [ "$(cat "$SE5/hook-1.sh")" = "#" ] || { r=1; echo "      the fixture's env file changed — a refusal above did not actually hold"; }
  fi
  unset GERR
  ok "a session's hook env files (~/.claude/session-env/<id>/) are fenced from a planning seat, an orch and a worker — a redirect, append, tee, cp, cp -t, mv, sed -i, a symlink, a glob, rm and the Write and Edit tools — while a read passes" $r

  # 68f. THE PERMS HANDBACK AT 29572d21, AND A CLAUDE STARTED IN THE SEAT'S DIRECTORY (perms, 2026-10-13). Each row
  #     below passed on that head: a brace naming two startup files, a literal launch-input path in a python, perl or
  #     node one-liner, truncate and rm of one, and a claude started with the call's cwd in the seat's dir or by a
  #     …/perms path a variable splits. Kept: the over-blocks it found (a repo's own tests/fixtures/.profile after an
  #     unresolvable cd; `cp CLAUDE.md ~/.claude/` is now pboot's to refuse), a file in ~/.cc/state/hs outside launch/, `source ~/.bashrc`, a
  #     plain interpreter, a commit message that says claude, and the seat writing its memory from a subdir.
  #     The planning read of 955e52c8 adds a flag with no space after it (python3 -c"…"), node -p, awk and gawk
  #     writing, and launch-dir spellings the fold must open (state//hs, state/./hs, state/x/../hs, hs/., hs/x/..);
  #     those rows name run.sh, because a name with "perms" in it trips the older gate and proves nothing.
  #     Its own fixture: a home outside /tmp, a seat dir and a flagged fixture claude of its own.
  r=0; GERR=$T/gerr68f
  if [ -z "$T2" ]; then r=1; echo "      no fixture home outside /tmp: these rules wave /tmp through, so nothing here would be gated"
  else
    H6=$T2/h68f; SD6=$H6/.cc/state/demo/perms; mkdir -p "$H6/bin" "$H6/dev/ctl/tests/fixtures" "$H6/.cc/worktrees/demo/t1/.cc" "$SD6/sub" "$H6/.cc/state/hs/launch"
    : > "$H6/.cc/worktrees/demo/t1/.cc/track"; cp "$H/bin/cc-notify" "$H/bin/cc-slack" "$H/bin/cc-failures" "$H6/bin/"
    PM6=$H6/.claude/projects/$(printf '%s' "$SD6" | tr '/.' '--')/memory; mkdir -p "$PM6" "$H6/.claude/projects/-p"
    for lf in .bashrc .profile .bash_profile; do printf '#\n' > "$H6/$lf"; done
    for tier in planning orch worker; do
      case $tier in
        planning) c=$H6/dev/ctl; e=();;
        orch) c=$H6/dev/ctl; e=(CC_SLACK_ALIAS=ctl@architect);;
        worker) c=$H6/.cc/worktrees/demo/t1; e=(CC_ROLE=worker);;
      esac
      # recurring-defect-ok: pause-hold-missing — selfcheck refusal fixtures name claude launches; nothing here launches
      while IFS='|' read -r why cw x; do
        [ -n "$x" ] || continue; [ "$cw" = seat ] && cw=$SD6 || cw=$c
        : > "$GERR"; got=$(GH=$H6 g Bash "$(J "$x")" "$cw" "${e[@]}")
        { [ "$got" = 2 ] && grep -qF "$why" "$GERR"; } || { r=1; echo "      $tier: not refused as $why (rc $got): $x — $(head -c 80 "$GERR")"; }
      done <<ROWS
