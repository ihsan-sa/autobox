  for w in ssh hostname getent; do grep -qx "$w" "$S71/calls" 2>/dev/null || { r=1; echo "      the stand-in $w never ran: the rows read the real one"; }; done
  ok "a tmux kill ssh runs on another host passes, quoted or not, a -- before or after the host or a line joined on included; a tmux kill on this box is still refused — bare, by bash -c or sh -c, after the ssh (by its path or a glob too), in a \$( ) or a ProxyCommand ssh's caller runs here, through a function named ssh, an -F file or a control socket, behind a comment, a \$' ' string or a \${ } whose quotes the walk would misread, by an ssh with any other statement on the line or an env word before it (one could make ssh something else), through a LocalCommand, or by ssh to loopback, an alias of it, this box's own name or address, or any host reached through a proxy or a -J jump, or by an ssh whose remote command hops on (another ssh, plain, nested in quotes or spelled by a glob, a quote the far shell reads, a \$' ' escape, an \$IFS or a line joined on) or that forwards a port, a socket, an agent or a tunnel (a flag, an -o or its config), or whose config sets a ControlPath, or whose first word after the host is option-shaped, the tmux -S form included" "$r"
  # 72. NAMING THE WORKERS' LOGIN IS NOT READING IT (row raised-guard-reads-a-config-path-as-a-credential-read).
  #     `cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json` stores a path and opens no file,
  #     so a session with no role passes it, spelled with ~ or $HOME, and so does an --approval card whose --run is
  #     that command alone. Another key, another file, a glob, a substitution, a read of the file, anything chained
  #     to it (a function of cc-config's name included), a VAR= prefix or a ./cc-config are still refused as a
  #     credentials read, and so is a worker's same set. Its own fixture: a cwd under the
  #     fixture HOME with no marker, which is where a quoted --run text reads as a path and the card was refused.
  GERR=$T/err72; ASKS=$T/asks72; CALLS=$T/calls72; r=0; mkdir -p "$H/dev/x72"
  while IFS='|' read -r want tier what; do
    [ -n "$want" ] || continue
    if [ "$tier" = wt ]; then d=$WT; e72=(CC_ROLE=worker CC_GUARD_ROOT_PID=$$); else d=$H/dev/x72; e72=(); fi
    : > "$GERR"; got=$(g Bash "$(jq -nc --arg c "$what" '{command:$c}')" "$d" "${e72[@]}")
    if [ "$want" = 0 ]; then [ "$got" = 0 ] || { r=1; echo "      refused, want it run: $what ($(head -c 60 "$GERR"))"; }
    else { [ "$got" = 2 ] && grep -qF "reading the box's credentials" "$GERR"; } || { r=1; echo "      rc $got, want refused as a credentials read: $what"; }; fi
  done <<'W72'
0|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json
0|un|cc-config set WORKER_CLAUDE_CREDENTIALS $HOME/.claude-workers/.credentials.json
0|un|cc-config set WORKER_CLAUDE_CREDENTIALS "$HOME/.claude-workers/.credentials.json"
0|un|cc-notify --approval --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json' 'Point the workers at their own login'
2|un|cc-config set CC_OTHER_LOGIN ~/.claude-workers/.credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/old/.credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude/.credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude*/.credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS $(cat ~/.claude-workers/.credentials.json)
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json; cat ~/.claude-workers/.credentials.json
2|un|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json && jq . ~/.claude-workers/.credentials.json
2|un|cat ~/.claude-workers/.credentials.json
2|un|jq . ~/.claude-workers/.credentials.json
2|un|cc-notify --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json' 'no --approval'
2|un|cc-notify --approval --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json; cat ~/.claude-workers/.credentials.json' x
2|un|cc-config(){ cat "$3"; }; cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json
2|un|PATH=/tmp/x cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json
2|un|./cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json
2|un|cc-notify --approval --run 'PATH=/tmp/x cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json' x
2|wt|cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json
W72
  ok "72 naming the workers' login in cc-config set, or in an --approval card that runs only that, is not a credentials read; another key or file, a glob, a substitution, a read and a chained read still are, and a worker's set too" $r

  # 72. A MEMBER'S CODE DOES NOT RUN ON THE HOST, FROM ANY TIER (row raised-member-gate-reruns-ran-unsandboxed).
  #     On 10-05 and 10-07 planning seats reran ece298a's PLL gates by hand with `setsid nice -n 19 python3 gate.py`
  #     in its worktree and `bash log/scratch/run_sim_tt.sh`, as the box's user; the planning seat is the ungated
  #     tier, so only the argv layer's every-role rule can see it. Its own HOME, where bob is a member by the
  #     host-side record (~/.cc/members/bob). The same run through cc-sandbox member, and a read there, still pass.
  H72=$T/h72; P72=$H72/.cc/worktrees/bob/pll; mkdir -p "$H72/.cc/members/bob" "$P72/log/scratch" "$H72/plain72" "$H72/bin"; r=0
  for row in "2|cd $P72 && setsid nice -n 19 python3 gate.py" "2|cd $P72; bash log/scratch/run_sim_tt.sh" \
             "0|cd $P72 && cat gate.py && git log -3" "0|systemd-run --user --wait cc-sandbox member bob pll -- python3 $P72/gate.py"; do
    : > "$T/err72"; got=$(GH=$H72 GERR=$T/err72 g Bash "$(jq -cn --arg c "${row#*|}" '{command:$c}')" "$H72/plain72")
    [ "$got" = "${row%%|*}" ] || { r=1; echo "      rc $got (want ${row%%|*}) for: ${row#*|}"; }
    [ "${row%%|*}" = 0 ] || grep -qF "cc-sandbox member bob pll" "$T/err72" || { r=1; echo "      refused for another reason: $(head -c 120 "$T/err72")"; }
  done
  ok "a planning seat's host run of a member's gate (python3 gate.py after a cd into its worktree, bash on its script) is refused and names cc-sandbox member, while the same run through cc-sandbox member and a read of the files still pass" $r

  echo "cc-guard selfcheck: $((n - f)) passed, $f failed"
  [ "$f" = 0 ] || exit 1
  exit 0
fi

inp=$(cat); tool=$(jq -r '.tool_name // ""' <<<"$inp"); cwd=$(jq -r '.cwd // ""' <<<"$inp"); cwd=$(realpath -m -- "${cwd:-/}" 2>/dev/null || echo "$cwd")
qcmd=$(jq -r '.tool_input.command // .tool_input.file_path // .tool_input.notebook_path // ""' <<<"$inp")   # what a member refusal records as "the command"
# THE SIZE CAP: the other half of the bound. The reading below is linear now, but its slope is not small and it
# depends on the shape: 128 KB of short quoted lines took 3 s here, 260 KB of two-byte lines took 19 s on an idle
# box, and a loaded box is slower. So a Bash command past 131072 characters (128 KB) is refused before any rule
# reads it, rather than left to race the budget. Nothing a session types is that long; a file it wrote is.
if [ "$tool" = Bash ] && [ "${#qcmd}" -gt 131072 ]; then
  echo "cc-guard: this command is ${#qcmd} characters, past the 131072 the gates will read, so it is refused. Write the long text to a file (Write tool) and pass the file instead." >&2; exit 2; fi
# A command position: start, after a separator/substitution, or after wrapper words that hide the real command
# (then/xargs/env/nohup/bash -c/VAR=…). Quotes are stripped from the haystack first, so "gh pr merge" is seen too.
# THIS LIST IS NO LONGER WHAT CLOSES THE RULES — cmdpos() below is. Every word it does not know used to hide
# what followed it, in all 24 rules that interpolate $AT: `timeout 5 pkill -f claude` and `setsid tmux
# kill-server` went straight through, the universal tmux gate included. It stays because it is what matches the
# line AS TYPED, and every rule below still expects it; cmdpos() puts the real command at ^ as well.
# find's `-exec`, `-execdir`, `-ok` and `-okdir` ARE wrapper words — the words after one are a command find runs,
# and `find . -name x -exec cp {} ~/bin/cc-guard \;` overwrote a live binary with none of them here (3rd
# adversarial review of #243). The longer spelling comes first: the match is the longest one that fits.
AT='(^|[;&|(){}`]|\$\() *(((then|else|elif|do|time|env|nohup|xargs|command|eval|exec|sudo|bash|sh|-c|-execdir|-exec|-okdir|-ok)|[A-Za-z_][A-Za-z0-9_]*=[^ ]*) +)*'
# A HEREDOC BODY IS DATA, NOT A COMMAND. The rules grep raw text, so a brief, a journal entry or a commit
# message that merely NAMES a forbidden command was refused for containing it — writing the brief for this fix
# was itself blocked that way. So heredoc bodies are dropped before matching. Quoted strings are NOT dropped:
# `bash -c "…"` is a real command and must still be seen. Two fences keep the drop honest: a body goes only if
# its terminator really appears later (an unterminated `<<` swallows nothing), and never when anything on the
# same line could EXECUTE it — an interpreter, eval, xargs, ssh, sudo fed a heredoc really does run its body,
# and that is the one case where the body IS the command. Both fail CLOSED, back to matching the raw text.
# A body a NON-SHELL interpreter runs (python, perl, …: $XI below) is read in that language — quote-aware, never
# raw — and a body line kept for its substitution keeps the substitution's interior alone (hay: keep, subs).
X='(^|[;&|(){}`]|[$][(])[ \t]*(((then|else|do|time|env|nohup|xargs|command|sudo)|[A-Za-z_][A-Za-z0-9_]*=[^ \t]+)[ \t]+)*([^ \t]*/)?(bash|sh|zsh|ksh|dash|python[0-9.]*|perl|ruby|node|php|awk|sed|eval|exec|source|[.]|xargs|env|ssh|sudo|systemd-run)([ \t]|$)'
# …AND WHICH OF THOSE ARE NOT A SHELL. A body fed to one of these is read in that language (hay: keep), because a
# Python patch script or a docstring naming the outbound door is data, not a command line; the shells and the
# wrappers that hand a body to one stay in $X alone and their bodies are still walked as shell.
XI='(^|[;&|(){}`]|[$][(])[ \t]*(((then|else|do|time|env|nohup|xargs|command|sudo)|[A-Za-z_][A-Za-z0-9_]*=[^ \t]+)[ \t]+)*([^ \t]*/)?(python[0-9.]*|perl|ruby|node|php|awk|sed)([ \t]|$)'
# A WRAPPER WORD IS NOT A WAY PAST A GATE. $AT recognises a fixed set of wrappers, so ANY word it does not
# know hid the command behind it — measured 2026-09-02: `pkill -f claude` refused, `timeout 5 pkill -f claude`
# allowed; `tmux kill-server` refused, `setsid tmux kill-server` allowed. That is one hole in all 24 rules, not
# two holes: merging, landing, deploying, containers, host changes, sudo, dispatch and the write-path rules
# share the anchor. Seven holes in four rounds of the kill fence say a wrapper list cannot be completed, so
# THE LIST CHANGES SIDES. cmdpos() walks each statement token by token and adds every SUFFIX to the haystack as
# its own line, so a rule anchored at ^ sees the real command wherever a wrapper put it — and it splits a token
# at its first `=` as well, because an option that hands its value to a shell can attach that value rather than
# spell it as a second word: `split --filter=CMD`, `sort --compress-program=CMD`, `git -c core.pager=CMD` were
# all still allowed when the two-token forms were refused (review-193b). The walk stops only at
# a head that cannot execute a later token — $NOEXEC, things that read, print, match, move or delete an
# argument and never run one. A head this does not know is walked THROUGH: an unlisted spelling costs a FALSE POSITIVE, never a
# bypass, which is the kill fence's own shape (refuse what you cannot reduce) applied to the anchor.
# NOEXEC is deliberately short and dull. Anything that can run an argument — a shell, an interpreter, awk, sed
# (GNU `e`), find (-exec), xargs, ssh, env, systemd-run, tmux, gh, git, cc — is NOT on it and never should be.
# SEVEN THAT LOOK DULL AND ARE NOT, and they came off in two rounds because the test was stated before it was
# applied. After review-193b: `split --filter=CMD` and `sort --compress-program=CMD` both hand their argument to
# sh, and `man -P PAGER` runs the pager. After the round behind that: `rg --pre CMD` and `--hostname-bin CMD`,
# `ag --pager CMD`, `ack --pager=CMD` and `wget --use-askpass=CMD`. All seven read files, so all seven read as
# text tools — but each has one option that executes, and flush() returns at the first NOEXEC head, so listing
# them stopped the walk and left everything after them unanchored. The test for this list is not "does it read?"
# but "is there any option that runs a word?"; when in doubt leave a head OFF, which costs a false positive and
# never a bypass. `grep` and `curl` are the near neighbours that stay: neither has an option that runs a word.
# `shellcheck` PASSES that test and belongs here: it parses a script and has no option that runs a word.
# It was missing, so the walk went past it and the SCRIPT NAME stood in command position — `shellcheck
# core/bin/cc-publish` was refused as publishing the box's code outward (row raised-guard-blocks-read-only-
# cc-publish-lint, 2026-09-16). Linting a file is reading it. The shells are the other half of that row and
# they cannot come here, because a shell DOES run its argument: `-n` is what makes one read-only (flush).
# The log readers on it earn their place: `last -x reboot shutdown` names two gated words and runs neither,
# and refusing that is the complaint already on the backlog about a worker blocked for grepping "reboot".
# IT IS ONE SHELL STRING AND IT HAS NO COMMENTS IN IT. A `#` inside single quotes is a word, not a comment,
# so a note written here would put its own words — `reboot`, `shutdown` — on the list of heads the walk stops at.
NOEXEC=': [ [[ true false test echo printf cd pwd export unset set local declare readonly read shift return
  break continue wait jobs sleep seq date basename dirname realpath readlink mktemp
  cat tac head tail nl wc uniq cut tr rev fold column comm join paste csplit tee
  grep egrep fgrep diff cmp jq yq shellcheck
  ls stat file du df tree touch mkdir rmdir rm cp mv ln install chmod chown chgrp truncate dd
  md5sum sha1sum sha256sum cksum base64 xxd od strings hexdump
  ps pgrep pkill kill killall top free uptime uname hostname whoami id groups tty which type
  last lastb lastlog journalctl dmesg w who users
  curl ping dig host nslookup less more'
# THE HEADS A HELD READ MAY STAND BESIDE — shorter than $NOEXEC. The test is stricter by one: no option that
# runs a word (that is $NOEXEC) AND no option that WRITES a file, so tee, cp, dd, truncate and curl are all off
# it. `sort` is on it with its two exceptions named per head (wopt: -o writes, --compress-program runs), which
# is why it is the one name here that $NOEXEC does not carry; `yq -i` and `tree -o` came OFF rather than earn
# a line each. cmdpos reader() is the only reader of this list.
READONLY=': [ [[ true false test echo printf cd pwd basename dirname realpath readlink
  cat tac head tail nl wc uniq cut tr rev fold column comm join paste sort
  grep egrep fgrep diff cmp jq shellcheck
  ls stat file du df which type
  md5sum sha1sum sha256sum cksum base64 xxd od strings hexdump less more'
# TWO BOUNDS, AND BOTH ARE PER STATEMENT, WHICH IS THE WHOLE POINT OF THEM. The walk is quadratic in the
# length of a STATEMENT, and a single statement of 3000 words (`for f in <3000 paths>`) cost 27 seconds in a
# PreToolUse hook — so at most 64 positions and 262144 bytes of expansion FOR EACH STATEMENT, reset in flush().
# A budget spent across the whole command was a bypass and not a bound: `for f in <3000 args>; do :; done;
# timeout 5 tmux kill-server` exhausted it in the first statement and the second was never walked, so the
# universal gate never saw the stop (review of #193). What the bounds cost is one statement, never the command:
# a wrapper prefix longer than 64 words, or a single statement whose suffixes exceed 256 KB — `nice -n 5`
# eleven times over. That is the same honest ceiling as a pid held in a variable: this stops accidents and
# casual prompt-injection, not somebody who has read the file. Neither binds on real work — on the ten longest
# commands this box has ever run the walk is not measurable, because a long command line is many short
# statements or a heredoc, and heredoc bodies are dropped above.
# A QUOTED STRING IS AN ARGUMENT, NOT A COMMAND POSITION — the same rule as a heredoc body above, and for the
# same reason: `git commit -m "no cp into ~/bin"` is a message ABOUT a command, and the suite has asserted since
# the write fence landed that it must not be refused. So a quoted run is ONE token to the walk: a command
# position may START at the quote — something could run the whole string — and never in the MIDDLE of it.
# WHAT THAT COSTS, PLAINLY: a quoted string whose FIRST word is a gated command IS refused — `git tag -m
# '<a gated command> did x'` is denied where `git tag -m 'no <gated command> here'` is not, and the leading
# word is the whole difference. (A statement dataonly() reads as data only — a plain `git commit -m '…'`, an echo,
# cc-notify, cc slack ask, a grep — has its quoted strings blanked for the gated text rules instead.) It is kept that way deliberately, because the position that reads the message
# is the position that reads `su -c '<a gated command>'`; both sides are asserted below (review of #193).
# THE SAME FENCE AS THE HEREDOC KEEPS IT HONEST: when a BARE word of a statement could EXECUTE a string ($Q — a
# shell, an interpreter, eval, xargs, ssh, sudo, systemd-run), the quotes of THAT statement are ignored and it is
# walked as raw text as well, so `bash -c "timeout 5 pkill x"` still puts `pkill x` in command position, while
# the `sed` at the other end of a pipe, or a `watch` inside a note, no longer turns its neighbours raw (scan).
# A line that ENDS inside a quote is walked raw whole. Both fences fail CLOSED, and both only ever ADD positions.
# A line is first made whole: a quote that runs on to the next line joins it (hay), and a `#` comment ends it.
# $Q IS THE ONE LIST IN HERE WHOSE GAP IS A BYPASS RATHER THAN A FALSE POSITIVE, so it carries everything
# that runs a STRING, not just the shells: `su -c '<wrapper> <command>'` was allowed while `su -c '<command>'`
# was refused, because a quoted run is one token and only its FIRST word is a command position — the interior
# is walked only when this says something on the line could execute it. Anything that takes a command as an
# argument as a STRING belongs here — `su -c`, `runuser -c`, `script -c`, `flock … -c`, `watch` (which runs
# its argument through sh), and tmux, at, batch and parallel, which hand theirs to a shell as well (security read
# of #589: a tmux new-window or send-keys string was read as prose). Wrappers that take an ARGV rather than a string (chroot, nsenter, setsid, nice)
# do not: the walk already steps past those. Each entry costs a false refusal when its word appears in quoted
# prose beside a gated command, which is why this list is the string-runners and not every wrapper.
Q='(^|[^A-Za-z0-9_.-])(bash|sh|zsh|ksh|dash|python[0-9.]*|perl|ruby|node|php|awk|sed|eval|exec|source|[.]|xargs|env|ssh|sudo|su|runuser|script|watch|flock|systemd-run|tmux|at|batch|parallel)([^A-Za-z0-9_.-]|$)'
# $DOOR — THE WAY A NON-SHELL LANGUAGE REACHES A SHELL, and the one thing that makes a string in such a body a
# command rather than data. `os.system("x; <gated>")` and `subprocess.run("...", shell=True)` hand their string
# to a shell; `s.replace("<gated>", "y")` and `open(f).write("""<a stub script>""")` hand it to nothing. Both
# readers below ask this same question — cmdpos of a body LINE, hay of the line that OPENS a multi-line string —
# so it is written once here. NO BACKSLASH IN IT: it reaches both awks through `-v`, which turns a backslash-b
# into a backspace and would silently stop matching qx, so the word bounds are spelled as character classes.
# THE EXEC/SPAWN/POPEN FAMILY IS TAKEN WHOLE, because a door the list half-knows is worse than one it does not
# know at all: `exec` wanted an immediate `(` so it matched exec() and MISSED os.execl(), `spawn[a-z]*` missed
# spawnSync, `popen` missed popen2 — and each of those hands a string to a shell exactly as os.system does, so
# nostr() was deleting the gated words out from under the rules (review of #516). node reaches a shell through
# child_process, so that module name is a door wherever on the line it appears.
# A PERL `open` IS A DOOR ONLY WITH A PIPE IN IT, AND PYTHON'S open() IS NOT ONE AT ALL. `open(my $fh, "<cmd> |")`
# runs the command; `open(p).read()` and `open(p, "w").write("""<a stub script>""")` run nothing, and that second
# spelling is how the patch scripts and fixture stubs in this repo are written — it is what rows raised-cc-guard-
# refuses-a-fixture-heredoc and -reads-a-heredoc-body-as-an-outward-call are. Taking a bare `open(` as the door
# would put both rows straight back (selfcheck 63 b1/b2/b4 are exactly that spelling), so the rule asks for the
# pipe that makes it a command, and 62 asserts both halves.
# THE SAME-FAMILY NAMES GO IN WITH THEM: php's passthru and proc_open, perl's IPC::Open2/Open3, and ruby's
# Open3 — whose capture2/capture3 carry no paren of their own, so that module name is a door like child_process.
DOOR='(system|popen[0-9]*|exec[A-Za-z_]*|spawn[A-Za-z_]*|run|call|check_output|check_call|Popen|passthru|proc_open|open2|open3)[[:space:]]*[(]|open[[:space:]]*[(][^)]*[|]|child_process|Open3|shell[[:space:]]*=[[:space:]]*True|`|(^|[^A-Za-z0-9_])qx([^A-Za-z0-9_]|$)|subprocess'
# $PIPE — IN awk, perl, ruby AND php THE PIPE IS THE CALL, so a door can carry no name at all: `print "x" |
# "gh pr merge 1"` and `"gh pr merge 1" | getline` run the command with nothing on the line the list above
# knows, so the body got xd=0, nostr() blanked the quoted command and it exited 0 (review of #516, case 62 d9).
# THIS ONE ANSWERS THE BODY QUESTION ONLY — whether anything in the body can run a string (xd, and so whether
# the literals are data) — and NOT cmdpos's per-line one, which is why it is a list of its own. A body line
# gets the quote-blind reading on a $DOOR name, as it always has; a pipe needs no such reading, because the
# quote-aware walk already starts a command position at a quote the pipe put there and that is exactly how
# these spellings were caught before this branch. Pipes in PROSE are why the split matters: a body line like
# `rows = ["| cc-land | lands it |"]` holds a pipe beside a quote, and read quote-blind it is a table refused
# as a landing — the permitted-text class this whole reading exists to fix.
PIPE='["'"'"'][[:space:]]*[|]|[|][[:space:]]*["'"'"']|getline'
cmdpos(){   # every position in $1 a command could START at, one per line, original text first
  awk -v NE="$NOEXEC" -v RO="$READONLY" -v Q="$Q" -v DOOR="$DOOR" '
    BEGIN { m = split(NE, a, /[ \t\n]+/); for (i = 1; i <= m; i++) if (a[i] != "") noexec[a[i]] = 1
            m = split(RO, a, /[ \t\n]+/); for (i = 1; i <= m; i++) if (a[i] != "") ronly[a[i]] = 1   # reader()
            SQ = sprintf("%c", 39); MK = sprintf("%c", 1); M2 = sprintf("%c", 2)   # the two bounds are per statement: see flush()
            for (i = 1; i < 128; i++) ORD[sprintf("%c", i)] = i   # …and ansic needs a code back from a char
            SA = "([0-9]+(~[0-9]+)?|[$]|/[^/\\\\;{}()`]*/)"; SC = "(" SA "(," SA ")?)?!?[pdq=]"   # sedscript: see sedread
            SEDRE = "^" SC "(;" SC ")*$" }
    # A BACKSLASH IS NOT PART OF A COMMAND NAME. `\cc other --go` runs cc — the shell drops the backslash and
    # only skips alias lookup — and `awk "BEGIN{system(\"cmd\")}"` hands awk the same string the single-quoted
    # spelling does. Neither matched a rule, because every rule reads a NAME at ^ (adversarial review of #243).
    # So the escape comes off before matching, here and in flatln. (No literal apostrophe in here: see below.)
    # A DOUBLED backslash is ONE backslash, which by the line above is still not part of a name: `bash -c
    # "\\echo hi; \\cc other t1 --go"` left `\cc` behind the real separator here (2nd adversarial review), so
    # `\\` reduces the whole way. flatln does the same, in double quotes and bare alike.
    # A DOLLAR-QUOTE IS ANSI-C QUOTING, AND THE SHELL RESOLVES IT BEFORE IT READS A NAME. Spelled $ + SQ + body
    # + SQ, `\x63c other t1 --go` dispatches, `\x67h pr merge 1` merges, `\x63c-land 7` lands and `\x64ocker
    # run -v /:/host alpine` opens the host — none of them reached a rule, because every rule reads a NAME at ^
    # and what stood there was $ backslash x63c (3rd adversarial review of #243). So the escapes are resolved
    # here and in flatln, the same way a doubled backslash is: \xHH, \NNN, \n, \t, \r, and a doubled backslash
    # (reduced the whole way — a backslash is not part of a name); anything else is the character itself, the
    # escaped quotes included. A dollar-quote that never closes on the line is left exactly as it was typed.
    # (No literal apostrophe in any of this: the whole awk is one bash single-quoted string, and SQ is the char.)
    function ansend(s, i,   n, c) {   # the SQ that closes a dollar-quote whose body starts at i; 0 = never closes
      n = length(s)
      for (; i <= n; i++) { c = substr(s, i, 1)
        if (c == "\\") { i++; continue }
        if (c == SQ) return i }
      return 0
    }
    function ansnum(h, base,   i, v) { v = 0
      for (i = 1; i <= length(h); i++) v = v * base + index("0123456789abcdef", tolower(substr(h, i, 1))) - 1
      return v }
    # \u AND \U ARE THE SAME ESCAPE IN LONGER HEX, AND \cX IS A CONTROL CHARACTER: `\u0063c other t1 --go`
    # dispatched with none of them read (4th adversarial review of #243). \cX also SPELLS the statement mark,
    # which is why nothing here may emit one — the mark is the walk, never the command (see hay).
    function ansic(s,   i, n, c, d, h, v, out) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (c != "\\") { out = out c; continue }
        d = substr(s, ++i, 1); h = ""; v = -1
        if (d == "x" || d == "u" || d == "U") { v = (d == "x" ? 2 : (d == "u" ? 4 : 8))
                        while (length(h) < v && substr(s, i + 1, 1) ~ /^[0-9A-Fa-f]$/) h = h substr(s, ++i, 1)
                        if (h == "") { out = out d; continue }
                        v = ansnum(h, 16) }
        else if (d ~ /^[0-7]$/) { h = d
                        while (length(h) < 3 && substr(s, i + 1, 1) ~ /^[0-7]$/) h = h substr(s, ++i, 1)
                        v = ansnum(h, 8) }
        else if (d == "c") { d = substr(s, ++i, 1)           # ctrl-X: the letter with bit 7 cleared
                        if (d == "") continue
                        v = ORD[toupper(d)] % 32 }
        else if (d == "n") v = 10
        else if (d == "t") v = 9
        else if (d == "r") v = 13
        else if (d == "\\") continue
        else { out = out d; continue }
        # ONLY A PRINTABLE ASCII CHARACTER COMES BACK OUT. sprintf("%c") TRUNCATES a value it cannot hold, so the
        # surrogate range re-spelled the two characters this must never emit: \ud801 came back as byte 0x01, the
        # statement mark, and \ud80a as a newline (5th adversarial review of #243). A NEWLINE OR CR SPELLED
        # DIRECTLY does the same: \n, \x0a, \012 and \cJ (all v=10) split a marked statement line, so the half
        # after it lands UNMARKED and its cd is never walked — a write past it passed (7th adversarial review of
        # #243). So 10 and 13 are excluded like the mark: anything outside 2..127, or a newline/CR, is a
        # placeholder — a `?`, which is no part of a name and makes a path carrying it unresolvable. (No literal
        # apostrophe in this note: the whole awk is one bash single-quoted string, and one would close it.)
        if (v > 1 && v < 128 && v != 10 && v != 13) out = out sprintf("%c", v)
        else if (v >= 0) out = out "?" }                     # \0 names nothing; \1 is the mark, \n/\r split a statement; the rest is a ?
      return out
    }
    function unesc(s,   i, n, c, j, out) {
      out = ""; n = length(s)
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (c == "$" && substr(s, i + 1, 1) == SQ) {         # a dollar-quote: resolved before a rule reads it
          j = ansend(s, i + 2)
          if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
        if (c == "\\") {
          if (substr(s, i + 1, 1) == "\\") { i++; continue }
          out = out substr(s, i + 1, 1); i++; continue }
        out = out c }
      return out
    }
    function strip(s) { s = unesc(s); gsub("[\"" SQ "]", "", s); return s }
    # A METACHARACTER INSIDE QUOTES IS PROSE, NOT A SEPARATOR — it is inert in a real shell too, so a note or a
    # commit message that reads `step one; cc foo --go` or `writes to > ~/bin/x` must not read as a second command
    # or a redirect (2026-09-04: an odoo session was refused for a repo its heredoc/echo only DESCRIBED). flatln
    # drops the quote chars like strip, but blanks the metacharacters between them first. The one thing it must NOT
    # blank is a substitution that still RUNS: `"$(cmd)"` and a backtick in DOUBLE quotes execute, so those are kept
    # and still reach the rules. `(){}` blank in "" too (row raised-guard-blocks-a-dispatch-for-naming-a-tool-in-its-
    # brief: a brief reading "the review (<gated tool> merges…)" was refused as running it): the `(` of `$(` never
    # reaches that test — the `$(` branch before it takes the paren and walks the substitution — so a `(` that does
    # is prose, and so is a brace: `${…}` runs nothing but a `$(` inside it, which that same branch catches. Used
    # only where the quotes are BALANCED (the raw line and the quote-aware flush); the quote-blind interpreter walk keeps strip, so a quoted string an interpreter runs is
    # still read as a command. (No literal apostrophe here: this whole awk is one bash single-quoted string — SQ is.)
    # TWO THINGS A DOUBLE-QUOTED STRING STILL RUNS (landing review of #243): a substitution — from $( or an unescaped
    # backtick the shell EXECUTES the interior, so a separator or redirect there is real — and a backslash, which
    # escapes the next character, so \" does not close the string. scan() reads both the same way.
    # A SUBSTITUTION IS VERBATIM UNTIL IT CLOSES. Blanking must not resume inside $( ) — the shell EXECUTES that
    # text, so a separator or a redirect in there is real — but running the verbatim tail to the end of the LINE
    # refused every quoted prose behind a substitution: `echo "$(date)" && git commit -m "step; <a gated command>
    # was blocked"` (adversarial review of #243). So the tail ends where the substitution itself closes, and
    # finding that close is why plain paren counting is not enough: a `)` inside $( ) need not be a close — a
    # `case` pattern is the ordinary one — so while a `case … in` is open and no `esac` has closed it, a `)`
    # closes that pattern and not the substitution. Quotes in there hold their parens too, and one that never
    # closes on the line stays verbatim to the end: fail closed, which is what the whole-line tail did for every
    # line. $(( )) arithmetic and a nested $( ) need no case of their own: their parens count like any other.
    # A `#` IS A COMMENT ONLY AT THE START OF A WORD, and the character before it says nothing about that on its
    # own: in `echo a\ #b; <gated>` the blank before the `#` was CONSUMED by the backslash, so the `#` is inside
    # the word `a #b` and the shell runs what follows the `;`. Reading the previous character cut the line there
    # and the gated command never reached ^ (landing review of #404). So `we` tracks whether the current word is
    # empty — reset only by an UNESCAPED blank or operator, set by anything else emitted — the way scan() does.
    function flatln(s,   i, n, c, q, j, out, insub, dep, co, cw, cq, we, av) {
      q = ""; out = ""; n = length(s); insub = 0; dep = 0; co = 0; cw = ""; cq = ""; we = 1
      for (i = 1; i <= n; i++) { c = substr(s, i, 1)
        if (insub) {                                              # inside a substitution: a separator or redirect in
          # …AND THE SHELL STILL PARSES THE INTERIOR. It once emitted every char verbatim, so a command name quoted
          # inside $( ) or `` never landed at ^: `echo "$( "docker" run …)"` flattened with the quotes still on and
          # $AT could not cross them, reopening the whole gate list (paid review of #243). The quote chars drop and
          # \ reduces the way they do outside a substitution; only the metacharacters, which RUN here, stay verbatim.
          if (insub == 2) {                                        # here IS real and kept — the tail runs to ITS close
            if (c == "$" && substr(s, i+1, 1) == SQ) {             # a dollar-quote (ANSI-C) inside a backtick substitution: resolve it so a name spelled that way still anchors
              j = ansend(s, i + 2)
              if (j) { out = out ansic(substr(s, i + 2, j - i - 2)); i = j; continue } }
            if (c == "\\") { out = out substr(s, i+1, 1); i++; continue }
            if (c == "`") { out = out c; insub = 0; continue }     # a backtick closes on the next backtick
            if (c == "\"" || c == SQ) continue                     # a quote drops the way strip drops it
            out = out c; continue }
          if (cq != "") { if (cq == "\"" && c == "\\") { out = out substr(s, i+1, 1); i++; continue }
                          if (c == cq) { cq = ""; continue }        # the closing quote drops; a paren in there is no close
                          out = out c; continue }
          if (c == "$" && substr(s, i+1, 1) == SQ) {                # a dollar-quote (ANSI-C) inside the substitution: resolve it so a name spelled that way still anchors
            j = ansend(s, i + 2)
            if (j) { av = ansic(substr(s, i + 2, j - i - 2)); gsub(/[<>]/, " ", av); out = out av; i = j; continue } }   # a quoted > or < is no redirect: see below
          if (c == "\\" && substr(s, i+1, 1) == "\\") { i++; continue }   # \\ is one backslash, and no part of a name
          if (c == "\\") { out = out (substr(s, i+1, 1) ~ /[<>]/ ? " " : substr(s, i+1, 1)); i++; continue }   # \X is X, but \> and \< are no redirect: see below
          if (c == "\"" || c == SQ) { cq = c; continue }            # the opening quote drops
          if (c ~ /[A-Za-z]/) { out = out c; cw = cw c; continue }   # …the word just ended: was it case or esac?
          if (cw == "case") co++; else if (cw == "esac" && co > 0) co--
          cw = ""
          if (c == "(") dep++
          else if (c == ")" && co == 0) { dep--; if (dep <= 0) { insub = 0; dep = 0 } }
          out = out c; continue }
        if (q != "") {
          if (q == "\"" && c == "\\" && substr(s, i+1, 1) == "\\") { i++; continue }   # see the \\ note below
          if (q == "\"" && c == "\\") { out = out substr(s, i, 2); i++; continue }   # an escape: \" does not close
          if (c == q) { q = ""; continue }                          # the closing quote: dropped, as strip drops it
          if (q == "\"" && c == "`") { insub = 2; out = out c; continue }
          if (q == "\"" && c == "$" && substr(s, i+1, 1) == "(") {   # a substitution: it RUNS, so it is verbatim
            insub = 1; dep = 1; co = 0; cw = ""; cq = ""; out = out "$("; i++; continue }
          if (index(";&|<>", c) > 0) c = " "                        # a separator/redirect: literal in either quote
          else if (q == SQ && index("(){}`$", c) > 0) c = " "       # single quotes make these literal too
          else if (index("(){}", c) > 0) c = " "                    # …and in double quotes a paren or brace is prose: `$(` and a backtick were taken above
          out = out c; continue }
        # A DOUBLED BACKSLASH IS ONE BACKSLASH, AND A BACKSLASH IS NOT PART OF A NAME. `"\\cc"` is the string
        # \cc, which is what `bash -c` then RUNS as cc — keeping both characters left `\cc` at ^ and every rule
        # reads a NAME there, so `bash -c "\\cc other t1 --go"`, `eval "\\cc-land 7"` and `\\docker run …` all
        # walked past the gate list (2nd adversarial review of #243). Both characters go, in "" and bare alike.
        # A DOLLAR-QUOTED `>` OR `<` IS NO OPERATOR EITHER, so it is a blank like the escaped one below (security read
        # of 27e56941): a dollar-quoted > before a pipe into cp resolved to `echo >|cp …` and the pipe was gone.
        if (c == "$" && substr(s, i+1, 1) == SQ) {                  # a dollar-quote: ANSI-C, see ansic above
          j = ansend(s, i + 2)
          if (j) { av = ansic(substr(s, i + 2, j - i - 2)); gsub(/[<>]/, " ", av); out = out av; i = j; we = 0; continue } }
        if (c == "\\" && substr(s, i+1, 1) == "\\") { i++; we = 0; continue }
        # …BUT AN ESCAPED `>` OR `<` IS NO OPERATOR, so it is a blank here as it is inside quotes (security read of
        # c3d5ce6c). Kept as `>`, `echo \>|cp /dev/null ~/bin/x` came out `echo >|cp …`, the write scan folded the
        # noclobber override and the pipe into cp was gone — while bash runs echo piping a literal > into cp.
        if (c == "\\") { out = out (substr(s, i+1, 1) ~ /[<>]/ ? " " : substr(s, i+1, 1)); i++; we = 0; continue }   # \cc IS cc — and an escaped quote still opens nothing; an escaped blank is part of the word
        if (c == "\"" || c == SQ) { q = c; we = 0; continue }       # the opening quote: dropped, but the word is not empty
        if (c == "#" && we) break                                   # a comment: see scan(), and the note above
        we = (index(" \t;&|(", c) > 0)                             # an unescaped blank or operator starts a new word
        out = out c }
      return out
    }
    # A SHELL ASKED TO PARSE AND NOT RUN EXECUTES NOTHING, SO ITS ARGUMENT IS NOT A COMMAND POSITION.
    # `bash -n core/bin/cc-publish` was refused as publishing the code of this box outward (row raised-
    # guard-blocks-read-only-cc-publish-lint, 2026-09-16): a shell DOES run its argument, so the walk goes
    # past it, and the
    # FILENAME landed at ^. With -n it parses the file and runs no part of it — the same test the NOEXEC list
    # above is built on, asked of a head plus an option instead of a head alone.
    # THE FLAG HAS TO COME BEFORE THE FIRST OPERAND, because that is the only place the SHELL reads it: in
    # `bash script -n` the -n is an argument to the script and the script really runs, so the walk must go on
    # past it. `--` ends the options the same way. Bundled spellings are one flag to the shell (`bash -nx`),
    # and `bash -n -c <string>` still parses without running, so both answer yes here.
    # ONLY THE SHELLS ARE ASKED. `sed -n` is not this — there -n means do not auto-print, and sed runs its
    # script either way — which is why this reads the head first and the option second, never the option alone.
    function noexecsh(t, i, nt,   j, w) {
      for (j = i + 1; j <= nt; j++) { w = strip(t[j])
        if (w == "--") return 0
        if (substr(w, 1, 1) != "-" || w == "-") return 0       # the first operand: every option is behind us
        if (w ~ /^-[a-zA-Z]*n/) return 1 }
      return 0 }
    # A sed THAT CAN ONLY PRINT IS READING ITS FILES (row reading-a-tool-is-not-running-it). sed is off $NOEXEC
    # because GNU sed runs a word (`e`, `s///e`) and writes one (`w`, `-i`), so the walk went past it and
    # `sed -n 1,60p core/bin/cc-land` stood the file name at ^ and was refused as a landing — about half of
    # 804 refusals in 14 days were reads like it. So a sed is judged by its SCRIPT: addresses (a line number,
    # `$`, first~step, a /regex/ with no slash, backslash, brace, paren or backtick in it) and only p, d, q or =,
    # `;` between them, `!` allowed. Any other option (-i, -f, -l, --in-place…), a script that fails that test,
    # or an output redirect other than to /dev/null, and it is walked past exactly as before. A `$` is kept only
    # inside a single-quoted script: anywhere else the shell expands it, and `sed -n "/$X/p"` with X holding
    # `/e <cmd>;#` is a sed that runs a command. Only a sed at the HEAD of its statement counts, and what it
    # reads is HELD, not dropped: unless every other statement of the command is a plain read too (reader), the
    # held text goes back in the haystack at END (see there), so the read is a read only in a command of reads.
    function sedscript(raw,   s) {   # 1 = a sed script that only prints, deletes, quits or counts by address
      if (raw ~ "^" SQ "[^" SQ "]*" SQ "$") s = substr(raw, 2, length(raw) - 2)
      else { s = strip(raw); if (s ~ /[$`]/) return 0 }
      return s ~ SEDRE }
    function sedread(t, nt,   j, w, sc, opt, v) {
      sc = 0; opt = 1
      for (j = 2; j <= nt; j++) { w = strip(t[j])
        if (w ~ /[<>]/) { j = redirok(t, j, nt); if (!j) return 0; continue }   # …to /dev/null, spaced or not
        if (opt && w == "--") { opt = 0; continue }
        if (opt && w ~ /^-[nErsuz]+$/) continue
        if (opt && w ~ /^--(quiet|silent|regexp-extended|posix|separate|unbuffered|null-data|debug|sandbox)$/) continue
        if (opt && w ~ /^-[nErsuz]*e$/) { if (++j > nt || !sedscript(t[j])) return 0; sc = 1; continue }
        if (opt && w ~ /^-[nErsuz]*e./) { v = t[j]; sub(/^[^e]*e/, "", v); if (!sedscript(v)) return 0; sc = 1; continue }
        if (opt && w ~ /^--expression=/) { v = t[j]; sub(/^[^=]*=/, "", v); if (!sedscript(v)) return 0; sc = 1; continue }
        if (opt && w ~ /^-/) return 0                   # -i, -f, -l, --in-place, --file…: not a plain read
        if (!sc) { if (!sedscript(t[j])) return 0; sc = 1; continue }
      }
      return sc }
    function hold(t, nt,   j, tail) {   # what a read held back, one suffix a line: printed at END if the command is not all reads
      tail = ""
      for (j = nt; j >= 2 && length(HELD) < 262144; j--) { tail = " " t[j] tail; HELD = HELD strip(substr(tail, 2)) "\n" } }
    # A REDIRECT THAT OPENS NO FILE: `2>/dev/null`, the same spelled with a blank (the walk makes that TWO
    # tokens, and a read was refused for the spacing alone), and a dup of one fd onto another (`2>&1`), which
    # names no file at all. Returns the last token it consumed, or 0 for a redirect that MAKES a file — that is
    # a write, and the statement holding it is not a read.
    function redirok(t, j, nt,   w) {
      w = strip(t[j])
      if (w ~ /^[0-9]*>&[0-9-]+$/) return j
      if (w ~ /^[0-9]?>>?\/dev\/null$/) return j
      if (w ~ /^[0-9]?>>?$/ && j < nt && strip(t[j+1]) == "/dev/null") return j + 1
      return 0 }
    # THE ONE OPTION A LISTED READER WRITES OR RUNS WITH, asked per HEAD because the letter means different
    # things: `sort -o F` and `less -o F` make a file and `sort --compress-program=CMD` hands a word to sh,
    # while `grep -o`, `column -o` and `od -o` do none of those. A head whose dangerous option cannot be named
    # this cheaply belongs off $READONLY instead — that is where `yq -i` and `tree -o` went.
    function wopt(h, w) {
      if (h == "sort") return (w ~ /^(-o|--output|--compress-program)(=|$)/)
      if (h == "less" || h == "more") return (w ~ /^(-o|-O|--log-file)(=|$)/)
      return 0 }
    # A STATEMENT THAT CAN ONLY READ (see END). An ALLOW-LIST — $READONLY, plus a sed that is itself a read and
    # an empty statement, which runs nothing. Asking instead which head RUNS a word missed three ways to execute
    # what a read had just printed, because each one stops the walk before the question: `| tee /tmp/w; chmod +x
    # /tmp/w; /tmp/w 7` (w is a $NOEXEC name), `| $(echo bash)` and the backtick spelling, whose statement is
    # empty (security read of #574). A redirect that makes a file takes the statement off the list, and so does
    # an option that writes (wopt); a head this does not know is not a reader, which costs the refusal the
    # session had before the row.
    # A PATH IS NOT A NAME. The basename alone made every file named after a listed word a reader, so
    # `sed -n p <gated tool> | /tmp/cat` and `| ./cat 7` ran whatever had been put there (2nd security read of
    # #574). A bare name is looked up on PATH and is the system tool; a path is one only under the system bin
    # directories.
    function reader(t, nt,   j, h, w) {   # 1 = this statement can only read
      if (nt == 0) return 1
      w = strip(t[1])
      if (w ~ /\// && w !~ /^\/(bin|usr\/bin|usr\/local\/bin)\/[^\/]+$/) return 0
      h = w; sub(/^.*\//, "", h)
      if (h == "sed") return (w ~ /^((\/usr)?\/bin\/)?sed$/) && sedread(t, nt)
      if (!(h in ronly)) return 0
      for (j = 2; j <= nt; j++) { w = strip(t[j])
        if (wopt(h, w)) return 0
        if (w ~ /[<>]/) { j = redirok(t, j, nt); if (!j) return 0 } }
      return 1 }
    function flush(t, nt, qa,   i, j, h, v, out, tail, budget) {   # every suffix of one statement, quotes off on the way out
      budget = 262144                                   # PER STATEMENT. As a per-command budget, one long
      FSAFE = 0
      if (!reader(t, nt)) UNSAFE = 1                    # …and it is asked BEFORE any return below: see reader()
      for (i = 1; i <= nt && i <= 64 && budget > 0; i++) {  # statement switched the walk off for every later one
        h = strip(t[i]); sub(/^.*\//, "", h)            # /usr/bin/timeout is timeout
        if (h in noexec) return                         # it cannot run t[i+1]: nothing after this is a command
        if (i == 1 && strip(t[1]) ~ /^((\/usr)?\/bin\/)?sed$/ && sedread(t, nt)) { hold(t, nt); FSAFE = 1; return }   # a sed that only prints: see sedread (the system one: `./sed` is whatever was copied there)
        if (h ~ /^(bash|sh|zsh|ksh|dash)$/ && noexecsh(t, i, nt)) return   # …and `bash -n <file>` runs nothing either
        tail = ""; for (j = i + 1; j <= nt; j++) tail = tail " " t[j]
        if (i < nt) { out = substr(tail, 2); budget -= length(out) + 1
          print (qa ? flatln(out) : strip(out)) }       # …but a word this does not know might, so walk past it
        v = strip(t[i])                                 # "an --opt=VALUE whose value is a command has to reach
        if (match(v, /=/) && RSTART < length(v)) {      #  command position the same way an --opt VALUE one does"
          out = substr(v, RSTART + 1) tail; budget -= length(out) + 1
          print strip(out) }                            # strip, NOT flatln: `--filter=CMD` hands CMD to a shell, so
      }                                                 # loop above never reaches it: split it off at the first =
    }
    # A STRING-RUNNER IS READ PER STATEMENT, NOT PER LINE. The quote-blind reading used to be switched on by a $Q
    # word ANYWHERE on the line, prose included: `cc board note … "…; watch the journal"` and `grep x f | sed …`
    # both put every quoted word in command position, and eight board rows in ten days were that one mechanism
    # (a-guard-reads-the-command-not-the-text). Now the quote-aware scan records each statement it walked — its
    # source text and whether one of its BARE tokens (never a quoted one) names a string-runner — and only those
    # statements are re-read raw, while the rest of the same line keeps its quotes. `su -c "…"`, `bash -c "…"`
    # and `watch "…"` still turn their own statement raw; a `sed` in a pipe no longer turns its neighbours raw.
    # …AND A QUOTED NAME IS STILL THE NAME. The shell runs `"bash"`, `SQ sh SQ` and `""bash` exactly as bash, so a
    # token is judged by its STRIPPED form: one word (no blank) that matches $Q is a string-runner, quoted or not
    # — the first cut called any token that opened with a quote prose, and `"bash" -c "x; <gated>"` walked past
    # every gate at both tiers (landing review of #404, security read). A quoted string WITH a blank is prose.
    function tokq(tok,   h) {   # a token that names a string-runner: its statement is walked raw as well
      if (tok == "") return 0
      h = strip(tok); if (h ~ /[ \t]/) return 0
      return (h ~ Q) }
    function stmt(line, st, i, sep, hq) {   # one statement of the quote-aware scan: kept for the raw re-read
      NST++; SPN[NST] = substr(line, st, i - st); SEP[NST] = sep; HQ[NST] = hq }
    function scan(line, qa,   i, n, c, q, cur, nt, t, st, hq) {   # returns non-empty if the line ended inside a quote
      q = ""; cur = ""; nt = 0; n = length(line); st = 1; hq = 0
      for (i = 1; i <= n; i++) { c = substr(line, i, 1)
        if (q != "") { if (q == "\"" && c == "\\") { cur = cur substr(line, i, 2); i++; continue }   # \" does not close
                       cur = cur c; if (c == q) q = ""; continue }
        if (c == "\\") { cur = cur substr(line, i, 2); i++; continue }   # \| is an escaped char, not a pipe
        if (qa && (c == "\"" || c == SQ)) { q = c; cur = cur c; continue }
        # A COMMENT RUNS NOTHING. A `#` that starts a word — after blank, `;`, `&`, `|` or `(`, or at ^ — ends
        # the line for the shell, and for every shell an interpreter string reaches; `${#x}` and `a#b` are words.
        # ONLY THE QUOTE-AWARE PASS CAN SAY SO: the raw re-read has dropped the quotes, so a `#` that was quoted
        # for the inner shell looks exactly like a comment there — `bash -c "echo \" #\"; timeout 5 <gated>"`
        # cut the raw walk at the `#` and the gated command never reached ^ (review of #404). The raw pass is
        # comment-blind, as it was before the per-statement re-read: a false refusal is the safe way to be wrong.
        if (qa && c == "#" && cur == "" && (i == 1 || index(" \t;&|(", substr(line, i - 1, 1)) > 0)) break
        if (c == " " || c == "\t") { if (cur != "") { hq += tokq(cur); t[++nt] = cur; cur = "" }; continue }
        if (c == "$" && substr(line, i+1, 1) == "(") { if (cur != "") { hq += tokq(cur); t[++nt] = cur }
          flush(t, nt, qa); if (qa) stmt(line, st, i, "$(", FSAFE ? 0 : hq); delete t; nt = 0; cur = ""; i++; st = i + 1; hq = 0; continue }
        # `{}` GLUED IS THE PLACEHOLDER find PASSES, NEVER A COMMAND GROUP — a group needs a space after the
        # brace, and splitting on it truncated the statement before its target: `find -exec cp {} ~/bin/cc-guard`
        # put a bare `cp` at ^ with nothing after it, so the write fence had no target to judge and it overwrote a
        # live binary (3rd adversarial review of #243). Only the adjacent pair is a word; `{ cd x; …` still splits.
        if (c == "{" && substr(line, i+1, 1) == "}") { cur = cur "{}"; i++; continue }
        if (index(";&|(){}`", c) > 0) { if (cur != "") { hq += tokq(cur); t[++nt] = cur }
          flush(t, nt, qa); if (qa) stmt(line, st, i, c, FSAFE ? 0 : hq); delete t; nt = 0; cur = ""; st = i + 1; hq = 0; continue }
        cur = cur c }
      if (cur != "") { hq += tokq(cur); t[++nt] = cur }
      flush(t, nt, qa); if (qa) stmt(line, st, i, "", FSAFE ? 0 : hq)
      return q
    }
    # A STATEMENT LINE IS MARKED, A SUFFIX IS NOT. The first whole-line print below is the command AS THE SHELL
    # RUNS IT; every other line the walk emits is a SUFFIX, which is argument text — `git commit -m "cd /tmp"`
    # emits `cd /tmp` on a line of its own. Read as a statement that moved the shell, so a real `cd ~/dev/other`
    # on the line before could be cancelled by a quoted one and the write after it went through, and a message
    # naming `popd` emptied the base and refused an ordinary write (3rd adversarial review of #243). Only the
    # cd/pushd/popd walk cares which is which, so the mark is a \001 the caller strips off for every other rule.
    { if ($0 ~ /[$][(]|`/) SUB = 1                      # a substitution ANYWHERE in the command, quoted or not: see END
      print MK flatln($0)                               # the line as typed, but a metachar inside quotes is inert
      # …AND THE RAW LINE TOO whenever the quote-blind rescan runs. The rescan only emits SUFFIXES, so the raw
      # print is the one line that puts the SECOND statement of an interpreter string in command position:
      # `bash -c "x; cc other t1 --go"` was refused by strip($0) and passed flatln($0) alone (security review).
      # …SO ONE SOURCE LINE IS WALKED AS A STATEMENT TWICE, AND A RELATIVE cd MOVED THE BASE TWICE — to a dir the
      # shell never stands in. From ~/dev/<h>/sub, an sh -c string holding `cd ../.. && sed -i s/x/y/ f` really
      # writes ~/dev/f and PASSED on a base gone a level too far, while `cd .. && sed -i s/x/y/ f` writes the dir
      # the member owns and was refused (paid review of #243). An absolute cd is idempotent under a double
      # application, which is why every case so far missed it. Neither print can just drop the mark: the quote-
      # aware one is what keeps a quoted `cd` in a commit message from cancelling a real one (case 29), and the
      # raw one is the only reading that sees the cd in `bash -c "echo x; cd ~/dev/other; write"`, where the
      # quote-blind statement is the one the shell really runs. So the RAW line is announced as a re-reading of
      # the SAME source line — a line that is the mark and nothing else — and the walk rewinds the base to where
      # the line started before it walks it again, keeping whichever reading moved. THE REWIND IS TWO MARKS
      # because ONE is a line cmdpos already prints: an empty pair of quotes flattens to nothing, so the mark
      # in front of it stands alone, and read as a rewind it undid the cd on the line BEFORE — a source line of
      # a cd into another repo, then that empty pair, then a write, went through (first cut of this same fix).
      # A statement line is a mark and its text, so it can never spell two. NOTE no apostrophe survives in here:
      # this comment sits inside the single-quoted awk program, and one closed it (this fix, again).
      # …AND ONLY THE STATEMENT WITH A BARE STRING-RUNNER IS RE-READ RAW (see scan). The second marked line is
      # the same line with just those statements quote-blind, so the cd walk still sees one line read twice;
      # a line that ends inside a quote is what it always was: unreadable, so the whole of it goes raw.
      # A LINE OF A NON-SHELL INTERPRETER BODY (M2 in front: see hay) is Python or Perl, not shell: it gets the
      # quote-aware reading and its suffixes, never the raw one — a docstring or a string literal there is data…
      # …UNLESS SOMETHING ON THE LINE CAN RUN A STRING. `subprocess.run("bash -c ...; <gated>", shell=True)` and
      # `os.system("x; <gated>")` hand the string to a shell, and the quote-aware reading left the gated command
      # inside one opaque token (review of #404; the base refused the first by its $Q word). So a body line that
      # holds the door that language has to a shell — system, popen, exec, spawn, run/call (subprocess, Popen, check_*), shell=True, a
      # backtick or qx — is walked raw as well, the fail-closed rule the shell lines keep. Not a $Q word: that
      # is the trigger the row above took out, and `# the patch script` would turn a comment line raw again. A
      # docstring or a comment that only NAMES a tool matches none of these and stays data.
      # …AND THE `(` OF A CALL IN SUCH A BODY IS NOT A STATEMENT SEPARATOR. $AT anchors a rule at a `(` — that is
      # how a gated command inside a `$( )` is caught — and in Python every call has one, so the ARGUMENT of any
      # call stood in command position with its quotes already flattened off: a `.replace()` of the four words
      # `gh pr merge` was refused as merging a PR, and writing the row that reported it was refused the same
      # way and had to be re-worded (row raised-cc-guard-reads-a-heredoc-body-as-an-outward-call, 2026-09-16;
      # the ledger holds five of these in one day, kind guard-policy/permitted-text-refused). So on a body line
      # with NO door ($DOOR) the parens come off before either print, above and here. A line WITH one is
      # untouched and still gets the raw reading below — that pass, not this one, is what keeps an
      # `os.system()` of the same four words refused.
      if (substr($0, 1, 1) == M2) { body = substr($0, 2); print flatln(body); NST = 0; scan(body, 1)
        if (body ~ DOOR) { print strip(body); scan(body, 0) }
        next }
      NST = 0; eq = scan($0, 1); anyq = 0
      for (k = 1; k <= NST; k++) anyq += HQ[k]
      if (eq != "") { print MK MK; print MK strip($0); scan($0, 0) }
      else if (anyq) { print MK MK; hyb = ""
        for (k = 1; k <= NST; k++) hyb = hyb (HQ[k] ? strip(SPN[k]) : flatln(SPN[k])) SEP[k]
        print MK hyb
        for (k = 1; k <= NST; k++) if (HQ[k]) scan(SPN[k], 0) } }
    # WHAT A READ HELD BACK GOES IN UNLESS THE WHOLE COMMAND IS READS. `sed -n p <gated tool> | bash`,
    # `bash -c "$(sed -n p <gated tool>)"`, `source <(sed …)`, `… | xargs sh` and `… | tee /tmp/w; chmod +x
    # /tmp/w; /tmp/w 7` all read the file in one statement and run it in another, so the read is a read only in
    # a command where EVERY statement is a plain read (reader()) and nothing in it is a substitution (SUB — a
    # `$( )` or a backtick can run anything, and the statement that holds one is often empty). Otherwise the held
    # suffixes are printed as the walk printed them before sedread, and the rules refuse what they always refused.
    # The brief: "Nothing that runs, sources, pipes into a shell, copies-then-runs or otherwise executes a gated
    # tool becomes allowed" — so the allowance is the narrow case, and anything unrecognised prints HELD.
    END { if (HELD != "" && (UNSAFE || SUB)) printf "%s", HELD }' <<<"$1"
}
hay(){   # the text the rules match: heredoc bodies out, quotes stripped, every command position at ^
  local c=$1
  # THE MARK IS THE WALK'S, NEVER THE COMMAND'S. cmdpos marks a statement line with a \001, and the command text
  # is a member's to write: `git commit -m "<0x01>cd ~/dev/ws1"` put a marked line in the haystack, so a quoted cd
  # was read as a statement again and cancelled a real one (4th adversarial review of #243). It comes off the text
  # before the walk ever sees it — here, once, so no path into cmdpos can carry one; ansic never emits one either.
  c=${c//$'\001'/}; c=${c//$'\002'/}; c=${c//$'\003'/}; c=${c//$'\006'/}   # \003 \006: the pre-pass's "cannot tell" (AMB), the walk's alone too
  # THIS PRE-PASS NOW RUNS ON EVERY COMMAND, heredoc or not, because it is also where a line is made whole: a
  # quoted string that runs on to the next line (a board note, a commit message) was cut at the newline and the
  # second half walked as a fresh statement, so `cc board note … "line one<newline>systemctl --user restart x is
  # needed"` was refused as a restart. Lines are joined while a quote is open — with a `;`, which is inert inside
  # the quote and a separator in the raw reading, exactly what a newline is to `bash -c "…"`. A heredoc body is
  # never joined: it is data, and its terminator must stay a line of its own.
  # CP: a word in command position that is an expansion (`$x`, `"$(…)"`, `${x}`) — whatever it holds is run.
  local CP='(^|[;&|(){}`]|[$][(])[ \t]*((then|else|elif|do|if|while|until|time|nohup|command|builtin|exec|eval|!)[ \t]+)*["'"'"']?[$]'
  c=$(awk -v X="$X" -v XI="$XI" -v Q="$Q" -v DOOR="$DOOR" -v PIPE="$PIPE" -v CP="$CP" '
      BEGIN { SQ = sprintf("%c", 39); M2 = sprintf("%c", 2) }
      { L[NR] = $0 }
      # A HEREDOC OPENED INSIDE `"$( )"` IS STILL A HEREDOC. `cc <repo> <t> --go "$(cat <<\047EOF\047` over a
      # brief ends inside the double quote, so the brief was joined on to it as one quoted line, the substitution
      # walk read every line of it as shell, and a `(c) <gated tool> review…` in the prose was refused as running
      # the tool (row raised-guard-blocks-a-dispatch-for-naming-a-tool-in-its-brief). The shell reads the interior
      # of the `$(` as shell, so a `<<` there opens a body on the next line: such a line is NOT joined (qend says
      # "" and leaves in HQS the `"$(` levels still open), hdpos finds the `<<`, and the line after the terminator
      # is read with HQS put back in front of it — so the `)"` that closes it, and anything after, is read where
      # the shell reads it: `)"; <cmd>` still runs <cmd>, and `<cmd>)"` still runs it inside the substitution.
      # Only the plain case takes this: ONE `<<` on the line, no string-runner before it (a body some shell RUNS
      # is walked as statements, as it always was), and its terminator really below. Anything else joins as before.
      # …AND NO STRING-RUNNER ($Q) ON THE OPENER OR ANYWHERE AFTER THE TERMINATOR. The substitution is a string,
      # and `echo "$(cat <<EOF` … `EOF` / `)" | bash` hands that string to a shell: dropped as data, the body
      # of it merged a PR (review of #589). With a runner in reach the lines join and are read as before.
      # …AND ONLY WHERE THE STRING IS AN ARGUMENT (second review of #589). `"$(cat <<EOF` on a line of its own
      # puts the body in command position, and `x="$(cat <<EOF` … `)"; $x` runs it a statement later: both went
      # through as prose. Every `"$(` open around the `<<` must now be a word of its own after a plain command
      # word (argq: not an assignment, not a keyword or a wrapper that runs its argument or stores it), and no
      # expansion may stand in command position ($CP) on the opener or after the terminator. Else: join, as before.
      function argq(t,   f) {
        if (t !~ /^[ \t]*[A-Za-z0-9_.\/-]+([ \t]+[^ \t]+)*[ \t]+$/) return 0
        f = t; sub(/^[ \t]+/, "", f); sub(/[ \t].*/, "", f); sub(/.*\//, "", f)
        if (f ~ /^(if|then|else|elif|do|while|until|for|case|select|function|coproc|time|nohup|command|builtin|timeout|nice|ionice|setsid|stdbuf|chrt|taskset|unbuffer|doas|export|declare|typeset|local|readonly|alias|set|let|printf|read|mapfile|readarray|trap)$/) return 0
        return t !~ /(^|[ \t])-(exec|execdir|ok|okdir)([ \t]|$)/ }
      # THE SCAN RESUMES, IT IS NEVER REDONE. A quote that stays open is joined on to the next line and asked
      # again, and asking meant scanning the joined line from its first byte: a 40 KB single-quoted string of
      # short lines took minutes, past the timeout of the hook, and a hook that times out lets the call through
      # (raised-guard-slow-on-long-quoted-input). qend starts a scan, qmore carries its state (qq_*) on from
      # where it stopped over what was appended since — the same answer, character for character, in one pass.
      # qq_tl is the one qq_* array qend leaves alone: it is keyed by line numbers of L[] (a tail rebuilt once per command), not per scan.
      function qend(s) { qq_q = ""; qq_ds = 0; qq_hd = 0; qq_nh = 0; qq_bad = 0; qq_hb = 0; qq_cm = 0; qq_r = 0; qq_qs = 0; qq_amb = 0; qq_hp = ""; qq_lr = 0; qq_nr = 0
        qq_sn = 0; qq_tx = 0; qq_unk = 0; qq_skp = 0; qq_esc = 0; delete qq_sk; delete qq_cmk; delete qq_un
        delete qq_dp; delete qq_sst; delete qq_ab; qq_sst[0] = 1; delete qq_ss; delete qq_oz; qq_ss[0] = 1; return qmore(s, 1) }
      # WHERE A `#` STANDS, AS FAR AS THIS WALK CAN SAY. bash reads `#` as a comment only where a word starts in plain
      # shell, and as text inside a `${ }`, a `[[ ]]`, an arithmetic `(( ))` or after an escape. Every round of
      # #975 found one more of those the walk took for a comment, and a comment stops it following a quote, so the
      # line the quote closed on ran ungated. cx keeps a stack of what is open: S a `(` or `$(` (plain shell), D a
      # `"$(` (the same), and the text ones B `${` (and a `{` inside one: bash counts them), K `[[`, A `((`/`$((`, T a
      # backtick. qq_tx counts the text ones open; qq_unk says the walk lost track (a close it cannot match). A
      # stack entry comes off only on its own close, so a misread leaves the walk thinking it is INSIDE a text
      # construct, never outside one: the wrong guess costs a refusal, not a gate.
      # qq_ss[n] is where the statement at depth n began (its last `;` `&` `|`, or the opener of depth n) and qq_oz[n]
      # where the opener of depth n ends: with them tailpre rebuilds the statement a heredoc tail closes (below).
      function cxpush(t, z) { qq_sk[++qq_sn] = t; if (t ~ /^[BKAT]$/) qq_tx++; qq_oz[qq_sn] = z; qq_ss[qq_sn] = z }
      function cxpop(   t) { if (qq_sn < 1) return ""; t = qq_sk[qq_sn--]; if (t ~ /^[BKAT]$/) qq_tx--; return t }
      function cx(s, p, c,   d, e, b, t) {
        if (p <= qq_skp) return
        d = substr(s, p + 1, 1); e = substr(s, p + 2, 1); b = (p == 1) ? "" : substr(s, p - 1, 1); t = qq_sn ? qq_sk[qq_sn] : ""
        if (c == "$" && d == "{") { cxpush("B", p + 2); qq_skp = p + 1; return }
        if (c == "$" && d == "(") { if (e == "(") { cxpush("A", p + 3); qq_skp = p + 2 } else { cxpush("S", p + 2); qq_skp = p + 1 }; return }
        if (c == "`") { if (t == "T") cxpop(); else cxpush("T", p + 1); return }
        if (t == "B") { if (c == "{") cxpush("B", p + 1); else if (c == "}") cxpop(); return }
        if (c == "(") { if (d == "(") { cxpush("A", p + 2); qq_skp = p + 1 } else cxpush("S", p + 1); return }
        if (c == ")") { if (t == "S") cxpop(); else if (t == "A") { if (d == ")") { cxpop(); qq_skp = p + 1 } else qq_unk = 1 }; return }
        if (c == "[" && d == "[" && (b == "" || index(" \t;&|(", b) > 0) && (e == " " || e == "\t")) { cxpush("K", p + 2); qq_skp = p + 1; return }
        if (c == "]" && d == "]" && t == "K" && (b == " " || b == "\t") && (e == "" || index(" \t;&|)", e) > 0)) { cxpop(); qq_skp = p + 1 } }
      # THE DELIMITER IS A SHELL WORD, READ THE WAY bash READS IT (review of #1141). Each reader here took
      # [A-Za-z_][A-Za-z0-9_]* after the `<<`, so `<<\047E-1\047` and `<<E.1` were read as `E`: no terminator was found
      # and the tail stood alone, and a body holding a line `E` below the real terminator would have hidden the
      # tail inside it. hdword reads the whole word, quotes and escapes off (HW), and says whether any part was
      # quoted (HWQ: the body is literal) and whether it was `<<-` (HWD); hdend is the test bash makes for a terminator,
      # the line exactly the word, leading tabs off for `<<-`. A word that does not start like one (`<<<`, a
      # shift, a `$`) is not read at all and 0 comes back, as before; one whose quote never closes, the same.
      # …AND ITS QUOTES COME OFF THE WAY bash TAKES THEM OFF (review of #1141). Inside double quotes a backslash goes
      # only before $ ` " or \, so `<<"E\\OF"` ends at a line `E\OF`: kept whole, the walk read on to a later `E\\OF`
      # and a copy into ~/bin between the two was taken for body. A `$\047…\047` or `$"…"` in the word is translated by
      # bash and not by this, so it is not read at all (0): a body the walk cannot bound is walked as statements.
      function hdword(s, p,   n, c, q, d) {   # the position after the delimiter whose `<<` ends at p - 1, or 0
        n = length(s); HW = ""; HWQ = 0; HWD = 0
        if (substr(s, p, 1) == "-") { HWD = 1; p++ }
        while (p <= n && index(" \t", substr(s, p, 1)) > 0) p++
        if (substr(s, p, 1) !~ /^[A-Za-z_\\"\047]$/) return 0
        for (; p <= n; p++) { c = substr(s, p, 1)
          if (c == "\\") { if (p == n) return 0; HW = HW substr(s, ++p, 1); HWQ = 1; continue }
          if (c == SQ) { q = index(substr(s, p + 1), c); if (!q) return 0
                         HW = HW substr(s, p + 1, q - 1); p += q; HWQ = 1; continue }
          if (c == "\"") { HWQ = 1
            for (p++; p <= n; p++) { d = substr(s, p, 1); if (d == "\"") break
              if (d == "\\" && p < n && index("$`\"\\", substr(s, p + 1, 1)) > 0) d = substr(s, ++p, 1)
              HW = HW d }
            if (p > n) return 0; continue }
          if (c == "$" && index("\"" SQ, substr(s, p + 1, 1)) > 0) return 0
          if (index(" \t;&|()<>`", c) > 0) break
          HW = HW c }
        return HW == "" ? 0 : p }
      function hdend(l, w, d) { if (d) sub(/^\t+/, "", l); return l == w }
      # THE STATEMENT A HEREDOC TAIL CLOSES, REBUILT (review of #1141). The tail `) <target>` closes the innermost
      # open construct and goes on with the statement around it, so what goes in front of it is, at each depth, the
      # statement that depth is in from its start (qq_ss) to the opener of the next (qq_oz), and at the last depth
      # its statement up to where the scan stopped (z: a comment, or the end) — the `<<word` (qq_lr to e) taken
      # out. Taken from the start of the line instead, `sed -n 1p f; cp $(…` read as one sed; taken whole from the
      # opener, `cp $(true; cat <<EOF`, `$(cat <<EOF | tr a b` and `(cd x; cp $(…` split the cp from its target.
      # A `#` the scan could not place (qq_un: one in a backtick) ends the last part as if it were a comment, and is
      # a blank anywhere else, so it can never swallow the tail it is put in front of.
      function tailpre(s, e, z,   l, t) {
        t = ""; for (l = 0; l < qq_sn; l++) t = t tailcp(s, qq_ss[l], qq_oz[l + 1], e, 0)
        return t tailcp(s, qq_ss[qq_sn], z, e, 1) }
      function tailcp(s, a, b, e, last,   u, o) {
        o = ""
        for (u = a; u < b; u++) {
          if (u >= qq_lr && u < e) { if (u == qq_lr) o = o " "; continue }
          if (u in qq_un) { if (last) break; o = o " "; continue }
          o = o substr(s, u, 1) }
        return o }
      # A `|` OR `&` THAT IS PART OF A REDIRECTION ENDS NO STATEMENT (review of #1141). The `|` of `>|` and the `&` of
      # `>&`, `<&`, `&>` and `&>>` are spelling, not a pipe or a background: taken for one, `cp >|log $(cat <<EOF`
      # began its statement after the `>|` and the tail was rebuilt without the cp. `|&` is a real pipe.
      # …BUT ONLY AN UNESCAPED `>` OR `<` IS AN OPERATOR (security read of c3d5ce6c): `echo \>|cp /dev/null ~/bin/x` is
      # echo piping a literal > into cp, so the `|` after an odd run of backslashes and a `>` is a pipe and the cp a statement.
      function besc(s, q,   k) { for (k = 0; q - k - 1 >= 1 && substr(s, q - k - 1, 1) == "\\"; k++); return k % 2 }   # the char at q is escaped
      function rsep(s, p, c) { if (c == "|") return substr(s, p - 1, 1) != ">" || besc(s, p - 1)
        if (c == "&") return (substr(s, p - 1, 1) !~ /[<>]/ || besc(s, p - 1)) && substr(s, p + 1, 1) != ">"
        return 1 }
      function qmore(s, from,   p, n, c, k, j, w) {   # the quote a line ends inside, or nothing; a comment ends the line
        HQS = ""; qq_cs = 0; if (qq_cm) return ""     # a comment runs to the end of all that is appended to it
        n = length(s)
        for (p = from; p <= n; p++) { c = substr(s, p, 1)
          if (qq_q != "") { if (qq_q == "\"" && c == "\\") p++
                         else if (qq_q == "\"" && c == "$" && substr(s, p + 1, 1) == "(") {
                           qq_ab[qq_ds + 1] = !argq(substr(s, qq_sst[qq_ds], qq_qs - qq_sst[qq_ds])); if (!qq_ds) qq_hp = substr(s, qq_sst[0], qq_qs - qq_sst[0]); qq_ds++; qq_bad += qq_ab[qq_ds]
                           qq_dp[qq_ds] = 1; qq_sst[qq_ds] = p + 2; qq_q = ""
                           cxpush("D", p + 2); if (substr(s, p + 2, 1) == "(") { cxpush("A", p + 3); qq_skp = p + 2 }   # "$(( is arithmetic
                           p++ }
                         else if (c == qq_q) qq_q = ""; continue }
          if (c == "\\") { qq_esc = p + 1; p++; continue }
          cx(s, p, c)
          if (qq_ds && c == "(") qq_dp[qq_ds]++
          if (qq_ds && c == ")" && --qq_dp[qq_ds] == 0) { qq_bad -= qq_ab[qq_ds]; qq_ds--; qq_q = "\""; if (qq_hd > qq_ds) qq_hd = 0
                                                          while (qq_sn > 0 && qq_sk[qq_sn] != "D") if (cxpop() != "S") qq_unk = 1
                                                          if (cxpop() != "D") qq_unk = 1; continue }   # the "$( closed where the stack says it cannot
          if (c == "(" || (index(";&|", c) > 0 && rsep(s, p, c))) qq_sst[qq_ds] = p + 1   # a new statement starts after it
          if (index(";&|", c) > 0 && rsep(s, p, c)) qq_ss[qq_sn] = p + 1   # …at this depth
          if (c == "\"" || c == SQ) { qq_q = c; qq_qs = p; continue }
          if (c == "<" && substr(s, p + 1, 1) == "<") { qq_nh++
                                                      if (!(qq_sn && qq_sk[qq_sn] == "A") && substr(s, p - 1, 1) != "<" && substr(s, p + 2, 1) != "<") { qq_nr++; qq_lr = p }   # a real `<<`: not `<<<`, not a shift
                                                      if (qq_ds) { qq_hd = qq_ds; qq_r = p; qq_hb = qq_bad } }
          # A `#` IS A COMMENT HERE ONLY WHERE IT SURELY IS: unescaped, at the start of a word (line start, a blank,
          # ; & | or `(` before it), and with no text construct open (cx). Anything else that might be one, a `#`
          # after `)` `<` `>` or a backtick, after an escaped character, or inside a `${ }`, `[[ ]]` or `(( ))`, is
          # a comment or is not and this walk cannot say: after a subshell `)` it is, after a `$( )` it is text, and
          # whichever the walk picked, the other hid a gated line (security reads of #975). It picks neither: qq_amb
          # notes it and the scan reads on as if it were text, and a line joined on behind it, or a heredoc opened
          # behind it, is refused below (AMB). qq_cmk and qq_un keep where each was, for hdpos.
          if (c == "#") { k = (p == 1) ? "" : substr(s, p - 1, 1); j = (p > 1 && qq_esc == p - 1)
            if (!j && (k == "" || index(" \t;&|(", k) > 0) && !qq_tx && !qq_unk) {
              qq_cmk[p] = 1; if (qq_ds) { qq_cs = 1; break }   # a comment inside a "$( ): the rest of the line is its text
              qq_cm = 1; break }   # …and outside one it ends the line, but a heredoc tail below still wants its words (see below)
            if (j || k == "" || index(" \t;&|()<>`", k) > 0) { qq_amb = 1; qq_un[p] = 1 } } }
        qq_p = p                                       # where the next qmore picks up: past an escape that ran off the end
        if (qq_hd && !qq_cm && !qq_hb && qq_q == "" && qq_nh == 1 && substr(s, 1, qq_r - 1) !~ X && s !~ CP && hdword(s, qq_r + 2)) {
          for (k = i + 1; k <= NR; k++) if (hdend(L[k], HW, HWD)) break   # i is the END loop line
          for (j = k + 1; j <= NR; j++) if (L[j] ~ Q || L[j] ~ CP) k = NR + 1   # the text may yet be handed to a runner, or run as a word: see above
          # …AND THE WORDS BEFORE THE `"$(` GO BACK IN FRONT WITH IT (security read of #589). `cp "$(cat <<EOF` …
          # `)" <live binary>` read its tail as `"$()" <live binary>`, a statement with no cp in it, so the write
          # fence never saw the copy it guards: the tail is read as the statement it closes, `cp "$()" <target>`.
          if (k <= NR && s !~ Q) { HQS = qq_hp; for (k = 1; k <= qq_ds; k++) { HQS = HQS "\"$("; for (j = 1; j < qq_dp[k]; j++) HQS = HQS "(" }
                         return "" } }
        # …AND THE TAIL GETS THEM WHATEVER BECOMES OF THE BODY (row guard-read-prefix-skips-live-tree-fence). The
        # words went back only on the path above, so a string-runner anywhere on the opener (`sed -n 1p f; cp
        # "$(cat <<EOF`, an `env` or an `awk` there, a quoted `sed` even), one after the terminator, or an UNQUOTED
        # `$(` left `) <live binary>` a line with no cp in it, and the write fence passed the copy. Here the line
        # after the terminator of a heredoc opened inside any open construct is read as the statement it closes
        # (tailpre) — once per tail.
        # …AND A TAIL IT CANNOT FIND IS REFUSED, NOT PASSED (review of #1141): a delimiter hdword cannot read, or
        # one with no terminator below, leaves no line to put the words on, and the line that closes the construct
        # would stand alone. HNF says so, and the caller of hay refuses the command. A `<<` inside `$(( ))` is a shift and `<<<` a string, so neither counts (qq_nr).
        # Two heredocs on one opener inside an open construct are the same: the tail follows the last body, and
        # neither path here reads past the first, so `cp $(cat <<A <<B` passed its tail alone too.
        if (qq_sn && qq_q == "" && qq_nr > 1) HNF = 1
        if (qq_sn && qq_q == "" && qq_nr == 1) {
          w = hdword(s, qq_lr + 2); j = NR + 1
          if (w) for (j = i + 1; j <= NR; j++) if (hdend(L[j], HW, HWD)) break
          if (j > NR) HNF = 1
          # …AND A COMMENT ON THE OPENER IS NOT CARRIED DOWN (review of #1141). `cp $(cat <<EOF # src` stopped the
          # scan at the `#` and returned before this block, so the tail stood alone again; now the scan stops there
          # (p) and the words go down without it, or the `#` would swallow `) <target>` on the line they land on.
          if (j < NR && !(j in qq_tl)) { qq_tl[j] = 1; L[j + 1] = tailpre(s, w, p) " " L[j + 1] } }
        return qq_q
      }
      function oddbs(s,   n) { n = length(s); while (n > 0 && substr(s, n, 1) == "\\") n--; return (length(s) - n) % 2 }
      # A KEPT BODY LINE IS ITS SUBSTITUTIONS, NOT THE PROSE AROUND THEM. `$(date -u) cc-land refused the merge`
      # in a journal heredoc stayed in the haystack whole, and the `)` put the landing tool in command position;
      # what the shell RUNS there is the interior of the $( ), the backtick and the ${ }, so that is what stays.
      # One that never closes, or holds a `case` (whose `)` is a pattern, not a close), keeps the whole line.
      function subs(s,   i, n, c, out, j, d, q, st) {
        out = ""; n = length(s)
        for (i = 1; i <= n; i++) { c = substr(s, i, 1)
          if (c == "\\") { i++; continue }
          if (c == "`") { j = index(substr(s, i + 1), "`"); if (j == 0) return s
            out = out substr(s, i + 1, j - 1) "\n"; i += j; continue }
          if (c == "$" && (substr(s, i + 1, 1) == "(" || substr(s, i + 1, 1) == "{")) {
            st = i + 2; d = 1; q = ""
            for (j = st; j <= n; j++) { c = substr(s, j, 1)
              if (q != "") { if (c == "\\") j++; else if (c == q) q = ""; continue }
              if (c == "\\") { j++; continue }
              if (c == "\"" || c == SQ) { q = c; continue }
              if (c == "(" || c == "{") d++
              else if (c == ")" || c == "}") { d--; if (d == 0) break } }
            if (d != 0 || substr(s, st, j - st) ~ /(^|[^A-Za-z0-9_])case([^A-Za-z0-9_]|$)/) return s
            out = out substr(s, st, j - st) "\n"; i = j; continue } }
        sub(/\n$/, "", out); return out
      }
      # WHAT A KEPT BODY LINE IS TO THE HAYSTACK. Fed to a NON-SHELL interpreter (xi: python, perl, ruby, node,
      # php, awk, sed) the body is that language, not shell, and it goes out marked M2 so cmdpos gives it the
      # quote-aware reading only — a string literal or a docstring naming a gated command is data, while
      # `os.system("<gated command>")` still lands at a `(` (a-guard-reads-the-command-not-the-text). Anything
      # else keeps only what the shell expands in it (subs). A shell fed a heredoc is not here: its body stays
      # whole, as statements, the way it always has (head ~ X, and not xi).
      # A MULTI-LINE STRING LITERAL IN A NON-SHELL BODY IS ONE TOKEN, AND THE LINES INSIDE IT ARE DATA. A shell
      # line that ends inside a quote is joined to the next one (qend above) and a heredoc body was not, so a
      # python heredoc writing a stub check.sh handed every line of the STUB to the walk as a bare statement of
      # this shell: the stub cd, which is a `$( )` and so unresolvable, emptied the base and the stub own
      # relative write was then refused as a write this shell could not place (row raised-cc-guard-refuses-a-
      # fixture-heredoc, 2026-09-16). Every path the COMMAND used was absolute. Inline heredocs are how most of
      # the gate fixtures in this repo are written, which is why it recurs.
      # THE LINE THAT OPENS THE STRING DECIDES, the same way `head ~ X` decides for the heredoc itself: with a
      # door on it ($DOOR) the interior is a payload some shell is about to run, so it stays in the haystack
      # whole and the reading does not change — `os.system(trio <shell lines> trio)` is still refused. Without
      # one, nothing in that string runs and the interior goes. What follows the CLOSING trio is code again and
      # is kept, so a door on the closing line is read. tqd stays set for the rest of the body once a door has
      # opened a string: fail closed, the rule every other list in this file is built on.
      function tqcut(s,   j) {   # the part of a body line that is not inside a multi-line string literal
        if (tq != "") { j = index(s, tq)
          if (j == 0) return ""                        # the whole of this line is inside the string: data
          s = substr(s, j + 3); tq = "" }              # …and what comes after the closer is code again
        tq = tqopen(s)
        return s }
      # …AND A LITERAL THAT OPENS AND CLOSES ON ONE LINE IS DATA THE SAME WAY. The quote-aware walk lets a
      # command position START at a quote, deliberately, because `su -c <string>` is real — but that is a
      # DOOR, and a body with none of them cannot run a string at all. Left in, the walk stood the interior
      # of any literal but the first at ^: a dict of tool names, and the SECOND argument of the replace the
      # row reported, were both refused while the first argument passed. The quotes stay so the token keeps
      # its shape; only what is between them goes.
      function nostr(s,   i, n, c, q, out) {
        n = length(s); q = ""; out = ""
        for (i = 1; i <= n; i++) { c = substr(s, i, 1)
          if (q != "") { if (q == "\"" && c == "\\") { i++; continue }
                         if (c == q) { q = ""; out = out c }; continue }
          if (c == "\\") { out = out c substr(s, i + 1, 1); i++; continue }
          if (c == "\"" || c == SQ) { q = c; out = out c; continue }
          out = out c }
        return out }
      function tqopen(s,   i, n, c3, st) {   # the trio this line leaves open, or nothing
        n = length(s); st = ""
        for (i = 1; i <= n; i++) { c3 = substr(s, i, 3)
          if (st != "") { if (c3 == st) { st = ""; i += 2 }; continue }
          if (c3 == "\"\"\"" || c3 == SQ SQ SQ) { st = c3; i += 2; continue }
          if (substr(s, i, 1) == "\\") i++ }
        return st }
      function keep(s) {
        if (xi) { u = s; if (nb) gsub(/`/, " ", u)                  # nb: see xd below
                  print M2 (xd ? u : nostr(u)); if (!bq && s ~ /[$][({]|`/) print subs(s) }
        else if (s ~ /[$][({]|`/) print subs(s) }
      # A `<<` INSIDE QUOTES OR BEHIND A `#` OPENS NOTHING. This pre-pass was quote- and comment-blind, so
      # `echo \047<< EOF\047` opened a heredoc bash never opens and every line down to the next EOF left the
      # haystack — with it the tmux fence, the gate list and the write fence, all of them, for a payload
      # anybody can write (6th adversarial review of #243). A quoted `<<` is text and a `#` at the start of a
      # word ends the line, so the walk below finds the first `<<` the SHELL would read, or none at all.
      function hdpos(s,   i, n, c, q, ds, ha, he) {   # …and with HQS set (qend), a `<<` inside `"$(` is the shell reading too
        n = length(s); ds = 0; ha = 0; he = 0
        for (i = 1; i <= n; i++) { c = substr(s, i, 1)
          if (q != "") { if (q == "\"" && c == "\\") i++
                         else if (HQS != "" && q == "\"" && c == "$" && substr(s, i + 1, 1) == "(") { ds = 1; q = ""; i++ }
                         else if (c == q) q = ""; continue }
          if (c == "\\") { i++; he = i; continue }
          if (c == "\"" || c == SQ) { q = c; continue }
          # A `#` qmore found to be a comment ends the line, inside a `"$(` too: `echo "$(true #<<EOF` over a gated
          # line runs that line, and the body was dropped. One it could not place, or one it never reached, that
          # might be a comment makes a `<<` after it a heredoc nobody can vouch for: `(true)#<<EOF` (AMB).
          if (c == "#") { if (i in qq_cmk) return 0
                          if ((i in qq_un) || i == 1 || he == i - 1 || substr(s, i - 1, 1) ~ /[ \t;&|()<>`]/) ha = 1 }
          if (c == "<" && substr(s, i + 1, 1) == "<") { if (ha) AMB = 1; return i } }
        return 0
      }
      # AN UNQUOTED DELIMITER EXPANDS THE BODY, AND AN EXPANSION IS A COMMAND. `cat > note.md <<EOF` over
      # `$(cc other t1 --go)` really dispatches, and the same body could read the credentials, merge a PR or
      # copy over a live binary through a backtick — every one of them was dropped as prose (5th adversarial
      # review of #243). `<<QUOTED` and `<<-\047EOF\047` are literal and still go. So the delimiter says which:
      # bare, the INTERIOR of each substitution or parameter on a body line stays in the haystack (subs above:
      # the prose around it was refused for a `)` putting the next word in command position), and the rest of
      # the body — the prose this whole drop exists for — still goes.
      # …AND A BACKSLASH AT THE END OF A BODY LINE JOINS THE NEXT ONE, so a substitution spread over two lines
      # was tested one line at a time and neither half carried the whole of it: `$(cp /dev/null \\` over
      # `~/bin/cc-guard)` truncated a live binary (6th adversarial review of #243). The lines are joined the
      # way the shell joins them, and the join is what gets tested.
      END { b = 0; bq = 0; hb = ""; xi = 0; tq = ""; xd = 0
        for (i = 1; i <= NR; i++) {
          if (b) { if (hdend(L[i], w, wd)) { if (hb != "") keep(hb); b = 0; hb = ""; xi = 0; tq = ""; xd = 0; if (hq != "" && i < NR) L[i + 1] = hq L[i + 1]; hq = ""; continue }   # a body line held open by a trailing backslash JOINS this delimiter line: its pending substitution stays in the haystack, untested it truncated a live binary (7th adversarial review of #243)
                   if (bq && !xi) continue
                   hb = hb L[i]
                   if (!xi && hb ~ /\\$/) { sub(/\\$/, "", hb); continue }   # continued: the next line is the same line
                   # A TRIO HIDES THESE LINES FROM PYTHON, NOT FROM THE SHELL. Under an unquoted delimiter the
                   # body is expanded BEFORE the interpreter is handed it, so `$(gh pr merge 1)` between two
                   # trios really merges the PR — and dropping the line here took its substitutions with it,
                   # which keep() would have printed one branch up (review of #516). The interiors go out from
                   # the ORIGINAL line, before the cut: what the cut decides is what python reads, never what
                   # bash already ran. A quoted delimiter expands nothing and is left alone, as everywhere else.
                   if (xi && !xd) { if (!bq && hb ~ /[$][({]|`/) print subs(hb)
                                    hb = tqcut(hb); if (hb == "") continue }   # inside a multi-line literal: data
                   keep(hb); hb = ""; continue }
          cur = L[i]
          # A BACKSLASH AT THE END OF A LINE JOINS THE NEXT ONE HERE TOO, the way the shell joins it: `gh api
          # repos/o/r \` over `-X DELETE` is ONE command, and read as two lines the flag stood in a statement of
          # its own and the call passed as a GET (security read of #574). Outside a quote only, and only an ODD
          # run of backslashes — a doubled one is a literal backslash, and the line ends there. The backslash
          # goes with no space in its place, which is what the shell does to a word split across two lines.
          qf = 0                                            # 0: scan cur from its start; else where qmore resumes
          if (i == NR) qend(cur)                            # the last line too: hdpos reads where its comments are
          while (i < NR) {
            if ((qf ? qmore(cur, qf) : qend(cur)) != "") { if (qq_amb) AMB = 1; qf = qq_p; i++; cur = cur ";" L[i]; continue }   # an open quote runs on: one logical line
            # A BACKSLASH INSIDE A COMMENT JOINS NOTHING: bash ends the comment at the newline and runs the next line,
            # so `true # note \` over a gated command joined the two, the `#` swallowed the second, and it passed every
            # gate (security read of #966). The line ends here, and the next one is read as a line of its own.
            # …and the same inside a `"$(`, where the walk reads on past the `#` but bash still ends it at the newline.
            if (qq_cm || qq_cs || !oddbs(cur)) break
            if (qq_amb) AMB = 1                             # a `)#`, `<#` or `>#` before it: joined or not, nobody can say
            # the escape that ran off the end is the backslash going now: resume ON it, which is where the next line lands
            # …unless a `<` stands before it: `<\` + `<EOF` is a `<<` the resumed scan would never see, so rescan
            qf = (qq_p == length(cur) + 2 && substr(cur, length(cur) - 1, 1) != "<") ? length(cur) : 0
            sub(/\\$/, "", cur); i++; cur = cur L[i] }
          print cur                                         # the line that OPENS a heredoc is still a command
          n = hdpos(cur); if (n == 0) continue
          head = substr(cur, 1, n - 1); rest = substr(cur, n + 2)
          if (index(rest, "<<") > 0) continue               # two on one line: too clever to reason about
          if (!hdword(rest, 1)) continue                    # `<<<` and shifts are not heredocs
          w = HW; wd = HWD; bq = HWQ                        # a quoted delimiter: the body is literal, all of it
          xi = 0
          # AN EXPANSION IN COMMAND POSITION RUNS THE BODY TOO (security read of #589). `$(cat <<EOF` unquoted on a
          # line of its own hands the body to the shell as the command, exactly as the quoted `"$(` does (the $CP
          # test), and the body went out as prose: it stays in the haystack as statements, as the body a shell is fed does.
          if (cur ~ CP) continue
          if (head ~ X) {                                   # the body would be RUN: it stays in the haystack…
            # …as shell, unless the ONLY string-runner on the line is a non-shell interpreter (keep above). With
            # a second one there (`sudo python3`, `python3 … | bash`) the body is walked as shell, as it was.
            t2 = cur; sub(/(^|[^A-Za-z0-9_.\/-])([^ \t]*\/)?(python[0-9.]*|perl|ruby|node|php|awk|sed)([ \t]|$)/, " ", t2)
            if (head ~ XI && t2 !~ Q) xi = 1; else continue }
          for (j = i + 1; j <= NR; j++) if (hdend(L[j], w, wd)) { b = 1; hb = ""; hq = HQS; break }   # hq: the `"$(` a body inside one leaves open (qend)
          # ONE DOOR ANYWHERE IN THE BODY DECIDES FOR ALL OF IT ($DOOR or $PIPE, and xd below). A script that
          # builds a command in a variable and runs it two lines later has a door in it, so nothing is lost by
          # asking once per body rather than once per line — and a body with none of them cannot run a string at
          # all, which is what makes its literals data. Read over the SAME lines the terminator was just found in.
          # $PIPE IS ASKED HERE AND NOWHERE ELSE: in awk, perl and ruby the pipe is the call, so a body whose
          # only door is `print "x" | "<cmd>"` or a `| getline` keeps its literals — and the quote-aware walk
          # then reads the command the pipe put in command position, which is how it was caught before this
          # branch. A pipe in PROSE must not also buy the quote-blind reading (see $PIPE).
          # A BACKTICK IS A DOOR IN perl, ruby AND php ONLY. In python it is not code at all, in awk and sed it is a
          # character, and in node it opens a template literal, which runs nothing without a door of its own
          # (child_process is one). Counted as a door everywhere, one backtick in a docstring gave the whole body
          # the quote-blind reading, so prose saying "`<verb>` stores the ..." was refused as that verb (rows
          # raised-guard-refuses-prose-with-the-word-mail and raised-guard-refuses-doc-text). nb says the body is
          # one of those, and the backticks come off what python reads here and in keep(); what bash expands in an
          # unquoted body (subs) is still read from the line as typed.
          xd = 0; nb = (cur !~ /(^|[^A-Za-z0-9_.\/-])([^ \t]*\/)?(perl|ruby|php)([ \t]|$)/)
          if (b) for (k = i + 1; k <= NR; k++) { if (hdend(L[k], w, wd)) break
                                                 lk = L[k]; if (nb) gsub(/`/, " ", lk)
                                                 if (lk ~ DOOR || lk ~ PIPE) { xd = 1; break } }
          if (!b) xi = 0
        }
        if (AMB) print "\003"; if (HNF) print "\006" }' <<<"$c")              # a line nobody can read one way: see qq_amb, and the refusal at hay's caller
  local amb="" hnf=""; case $c in *$'\003'*) amb=1; c=${c//$'\003'/};; esac
  case $c in *$'\006'*) hnf=1; c=${c//$'\006'/};; esac   # a heredoc tail the walk cannot find (HNF)
  c+=$(hands "$c")   # read from what the shell runs: the bodies above are gone, the quotes are not
  cmdpos "$c"          # …which strips the quotes itself: it needs them to tell an argument from a command
  [ -z "$amb" ] || printf '\n\003\n'
  [ -z "$hnf" ] || printf '\n\006\n'
}
# WHAT A COMMAND HANDS TO A SHELL UNDER ANOTHER NAME (security read of #589). Two ways the text that runs is not
# where the walk looks for a command: a git alias whose value starts with `!` is a shell command git runs when the
# alias is called (`git config alias.z '!<cmd>'; git z`, or `git -c alias.z='!<cmd>' z`), and a file this command
# writes with a redirect and then runs by its own path (`echo '<cmd>' > f; chmod +x f; f`, or `sh f`, `. f`) runs
# what was written. Each such value goes to the haystack as a statement line of its own, after the rest; the
# written text is the writing statement's words after its first. A redirect whose file is never run, and an alias
# that is not a `!` one, add nothing.
# …AND ONLY WHAT THE SHELL RUNS IS READ FOR THEM (review of #815). Read from the line as typed, a commit message in a
# quoted heredoc that QUOTED either shape, and `echo "git config alias.z '!<cmd>'"`, were refused where main ran
# them. So it reads the pre-pass's output (prose heredoc bodies already gone, quotes still on) and splits it the
# way the shell does: a quoted string is one word, a comment ends the line, `$( )`, backticks and `<( )` are
# statements of their own, an M2 line is another language's. An alias counts only as an argument of a `git`
# that stands in command position, a write only as a redirect outside quotes, and a run only as a command word
# (bare, or the script of bash/sh/source/.); a `bash -c` string and an `eval`'s words are split the same way.
hands(){   # $1 = the pre-pass's output → extra statement lines, each starting with a newline; nothing when none
  awk '
    BEGIN { SQ = sprintf("%c", 39); M2 = sprintf("%c", 2); NS = 0; NRD = 0 }
    index($0, M2) == 1 { next }                     # a non-shell body line (keep in hay): nothing in it is shell.
                                                    # Safe only because hay() strips \001/\002 from the typed text first.
    { src = src (src == "" ? "" : "\n") $0 }
    function add(d, x) { CW[d] = CW[d] x; HW[d] = 1 }
    function sid(d) { if (!SID[d]) { SID[d] = ++NS; N[NS] = 0 }; return SID[d] }
    function endw(d,   t) {                         # the word at depth d is whole
      if (HW[d]) { t = sid(d)
        if (RD[d] == 1) { WF[++NRD] = CW[d]; WS[NRD] = t }   # the file a `>` writes
        else if (!RD[d]) W[t, ++N[t]] = CW[d]                # a redirect read or an fd is no word
        RD[d] = 0 }
      CW[d] = ""; HW[d] = 0 }
    function endst(d) { endw(d); SID[d] = 0; RD[d] = 0 }
    function push(d, cl) { d++; MD[d] = "sh"; CL[d] = cl; CW[d] = ""; HW[d] = 0; SID[d] = 0; RD[d] = 0; PD[d] = 0; return d }
    function pop(d) { endst(d); d--; HW[d] = 1; return d }
    function tok(s,   n, i, c, x, d, j, m, fd) {
      n = length(s); d = 0; MD[0] = "sh"; CL[0] = ""; CW[0] = ""; HW[0] = 0; SID[0] = 0; RD[0] = 0; PD[0] = 0
      for (i = 1; i <= n; i++) { c = substr(s, i, 1); x = substr(s, i + 1, 1)
        if (MD[d] == "dq") {
          if (c == "\\") { if (x == "\n") {} else if (index("$`\"\\", x)) add(d, x); else add(d, c x); i++ }
          else if (c == "\"") MD[d] = "sh"
          else if (c == "$" && x == "(") { i++; d = push(d, ")") }
          else if (c == "`") d = push(d, "`")
          else add(d, c)
          continue }
        if (c == "`" && CL[d] == "`") { d = pop(d); continue }
        if (c == ")" && CL[d] == ")" && !PD[d]) { d = pop(d); continue }
        if (c == SQ) { j = index(substr(s, i + 1), SQ); if (!j) j = n - i + 1
                       add(d, substr(s, i + 1, j - 1)); i += j; continue }
        if (c == "$" && x == SQ) { for (j = i + 2; j <= n; j++) { if (substr(s, j, 1) == "\\") j++; else if (substr(s, j, 1) == SQ) break }
                                   add(d, substr(s, i + 2, j - i - 2)); i = j; continue }
        if (c == "$" && x == "{") { j = index(substr(s, i), "}"); if (!j) j = n - i + 1
                                    add(d, substr(s, i, j)); i += j - 1; continue }
        if (c == "\"") { MD[d] = "dq"; HW[d] = 1; continue }
        if (c == "\\") { if (x != "\n") add(d, x); i++; continue }
        if (c == "$" && x == "(") { i++; d = push(d, ")"); continue }
        if (c == "`") { d = push(d, "`"); continue }
        if ((c == "<" || c == ">") && x == "(") { i++; d = push(d, ")"); continue }   # a process substitution
        if (c == "#" && !HW[d]) { j = index(substr(s, i), "\n"); if (!j) break; i += j - 2; continue }   # a comment
        if (c == "&" && x == ">") { endw(d); continue }
        if (c == ">" || c == "<") {
          fd = ""; if (HW[d] && CW[d] ~ /^[0-9]+$/) { fd = CW[d]; CW[d] = ""; HW[d] = 0 } else endw(d)   # 2> : the fd is no word
          m = (c == ">" && (fd == "" || fd == "1")) ? 1 : 2                          # only stdout carries the words
          while (substr(s, i + 1, 1) ~ /[<>|]/) i++                                  # >> >| << <<< <>
          if (substr(s, i + 1, 1) == "&" && substr(s, i + 2, 1) ~ /[0-9-]/) { i++; m = 2 }   # >&2: a dup
          RD[d] = m; continue }
        if (c == " " || c == "\t") { endw(d); continue }
        if (c == "(") { endst(d); PD[d]++; continue }
        if (c == ")") { endst(d); if (PD[d]) PD[d]--; continue }
        if (index(";&|\n", c)) { endst(d); continue }
        add(d, c) }
      while (d > 0) d = pop(d)
      endst(0) }
    function skip(w) { return w ~ /^[A-Za-z_][A-Za-z0-9_]*[+]?=/ || w ~ /^-/ || w ~ /^[0-9]+([.][0-9]+)?[smhd]?$/ \
        || w ~ /^(sudo|doas|env|command|builtin|exec|nohup|time|nice|setsid|stdbuf|timeout|then|do|else|elif|if|while|until|[!{}])$/ }
    function first(t,   k) { for (k = 1; k <= N[t] && skip(W[t, k]); k++); return k }   # the command word
    function base(w) { sub(/.*\//, "", w); return w }
    # THE OPTIONS OF A SHELL ARE WALKED AS THE SHELL READS THEM, up to its first operand. -n (or -o noexec) parses
    # without running, but a later +n or +o noexec turns it off again, and the word after --rcfile, --init-file,
    # -o or -O is the argument of that option, not an option: `bash --rcfile -n f` and `bash -n +n f` both run f.
    # opts() returns the index of the first operand and sets NX (a syntax check only) and OC (a -c was given).
    function opts(t, f,   k, w, sg, j, l, c1) {
      NX = 0; OC = 0
      for (k = f + 1; k <= N[t]; k++) { w = W[t, k]
        if (w == "--" || w == "-") return k + 1
        if (w !~ /^[-+]./) return k
        if (w ~ /^--(rcfile|init-file)$/) { k++; continue }
        if (w ~ /^--/) continue
        sg = substr(w, 1, 1); l = ""
        for (j = 2; j <= length(w); j++) { c1 = substr(w, j, 1)
          if (c1 == "n") NX = (sg == "-")
          else if (c1 == "c" && sg == "-") OC = 1
          else if (c1 == "o" || c1 == "O") l = l c1 }
        for (j = 1; j <= length(l); j++) { k++
          if (substr(l, j, 1) == "o" && W[t, k] ~ /^(noexec|no_exec|NO_EXEC)$/) NX = (sg == "-") } }
      return k }
    function ran(p,   t, k, f) {                    # 1 = p stands as a command word, bare or as a shell script
      for (t = 1; t <= NS; t++) { f = first(t); if (f > N[t]) continue
        if (W[t, f] == p) return 1
        if (base(W[t, f]) ~ /^(bash|sh|zsh|dash|ksh)$/) { k = opts(t, f); if (!NX && !OC && W[t, k] == p) return 1 }
        else if (base(W[t, f]) ~ /^(source|[.])$/)
          for (k = f + 1; k <= N[t]; k++) if (W[t, k] !~ /^-/) { if (W[t, k] == p) return 1; break } }
      return 0 }
    END {
      tok(src); done = 0
      # A STRING A SHELL IS HANDED IS READ AS SHELL TOO: `bash -c "<alias>; git z"` and `eval` run their words.
      for (round = 0; round < 8 && done < NS; round++) { lim = NS
        for (t = done + 1; t <= lim; t++) { f = first(t); if (f > N[t]) continue; b = base(W[t, f])
          if (b ~ /^(bash|sh|zsh|dash|ksh)$/) { k = opts(t, f); if (OC && !NX && k <= N[t]) tok(W[t, k]) }   # the string is the first operand
          else if (b == "eval") { e = ""; for (k = f + 1; k <= N[t]; k++) e = e " " W[t, k]; tok(e) } }
        done = lim }
      for (t = 1; t <= NS; t++) { f = first(t); if (f > N[t] || base(W[t, f]) != "git") continue
        cfg = 0
        for (k = f + 1; k <= N[t]; k++) { w = W[t, k]
          if (w == "config") cfg = 1
          if (W[t, k - 1] == "-c" && w ~ /^alias[.][^=]+=!/) { sub(/^[^=]*=!/, "", w); printf "\n%s", w }
          else if (cfg && w ~ /^alias[.][^=]+$/ && k < N[t] && W[t, k + 1] ~ /^!/) printf "\n%s", substr(W[t, k + 1], 2) } }
      for (r = 1; r <= NRD; r++) { p = WF[r]
        if (p == "" || p ~ /^\/dev\//) continue
        if (!ran(p) && (p ~ /\// || !ran("./" p))) continue
        t = WS[r]; e = ""; for (k = 2; k <= N[t]; k++) e = e (k > 2 ? " " : "") W[t, k]
        printf "\n%s", e } }' <<<"$1"
}
# A GLOB IN A NAME IS EVERY NAME IT CAN MATCH (review of #1086 at 10c93bbb). Every rule reads a NAME at a command
# position, and the shell expands `cc-tr[y]`, `core/bin/cc-t?y`, `cc-la*d` and `cc-l{a,b}nd` before it looks the name
# up, so each of them ran what its rule refuses. deglob() hands the rules one more copy of a haystack line for every
# command name a globbed word in it can match, the word swapped for the name, and the rules then read the copy exactly
# as they read the name typed out. It runs where the universal block builds $u, so the gates every session meets (the
# tmux server, pattern kills, the GitHub deny list) read the copies too: `/usr/bin/tmu[x] kill-server` is refused in
# any session (review of #1101). A word's pieces are split at ; & | ( ) ` = < and >, so a redirect glued on
# (`cc-tr[y]</dev/null`) ends the piece; a digit before the redirect stays in the piece, because bash reads `x2>f`
# as the word x2. dgalts() turns a piece into what bash could make of it: `${…}` and a bare `$x` are expansions that
# may be empty, so they come off (`cc-la[n]d$x` is cc-la[n]d, and `{cc-land,}$x` is cc-land: review of #1101), and a
# {…} group of at most 16 comma alternatives is each alternative, while a `..` range or a bigger group reads as `*`, a
# superset (`{}` and `{x}` are literal to bash, which is why xargs's and find's `{}` are left alone). Each result's last
# path segment is the pattern; one with no [, ? or * left is the name itself when the group or the expansion made it,
# and nothing to read when the piece was typed that way. A pattern made of nothing but * and ? (`*`, `??`) is skipped:
# it matches every name, so it would refuse `for f in *` and `ls core/bin/*`, and naming no part of a gated tool it is
# no likelier a slip toward one than a renamed copy, which no name rule catches. A bracket class is NOT skipped, even
# alone: `[c][c][-][l][a][n][d]` is exactly one name (review of #1101). The names are what the shell could reach —
# each PATH dir's files matching the pattern, ~/bin, cc-try's overlay, the root's bin dirs, the cwd and the word's own
# directory (~/, $HOME/ and ${HOME}/ mapped to the home dir), or that directory alone when it is absolute, since no cd
# changes what it names — and GLOBNAMES below as a floor, so a gated tool missing from this PATH, or behind a
# directory the guard cannot resolve (`$D/cc-la[n]d`), still counts. The globbing is
# bash's own, under nullglob, with no fork, and each distinct word is worked out once per call however many haystack
# lines carry it. A PIECE THAT CAN NAME MORE THAN $DGMAX COMMANDS (`ls /usr/bin/[a-z]*` names thousands) gets the
# floor's names alone and leaves itself in $dgcap: the universal gates read nothing but floor names, so they lose
# nothing by it, and a gated tier, whose rules name more, refuses the line and says why (review of #1101). The cap
# sits well above the tools `cc-*` names, so a read of them still passes; the cost is a bare one-letter glob such
# as `ls s*`, which is read against every PATH dir and so is refused in a gated tier. hay() has already
# stripped the quotes, so a quoted glob reads as a bare one: that costs the odd refusal of a name the shell would
# have left alone, and never a gate. A word bash makes into several words — a lone brace word, or an expansion that
# may be blanks — is also a copy of the line with the piece swapped for all its words (dgalts' DGR), read for names
# in turn (review of #1101 at 2927b3f3). Ceiling: `shopt -s extglob` changes what bash matches and this reads the
# default (nocaseglob anywhere in the command is read as on); a group of more than 16 alternatives that is the whole
# name is skipped as `*`; and an expansion glued to a quote (`x$IFS'y'`) is lost with the quotes hay() strips.
GLOBNAMES='cc cc-land lander lander-self cc-try cc-loop cc-bench-grade cc-config cc-slack cc-handoff cc-broker cc-arch cc-publish
  cc-settings cc-failures cc-notify cc-lib cc-guard claude codex git gh docker docker-compose podman nerdctl tmux
  systemctl kill pkill killall pgrep pidof reboot shutdown poweroff iptables nft ufw netplan ip ssh rsync dd shred
  mail sendmail msmtp mutt bash sh zsh dash ksh python3 python perl ruby node sudo doas runuser su env timeout
  nohup setsid xargs kubectl terraform ansible aws az gcloud fly heroku vercel netlify'
DGMAX=256 dgcap="" DGSPMAX=6 dgsplit=""
dgbr(){   # $1 = a word → DGB, the words bash's brace expansion makes of it; DGX set when a group changed it
  local a q rest c=1; local -a next parts
  DGB=("$1")
  # One group off every word a pass, the innermost first, until a pass changes nothing. Each word is asked on its
  # own: asking the words joined let the `{` ending one and the `}` starting the next look like a group no word
  # holds, so `,}{a,b}{` went round until the budget refused the call (security read of #1101 at 2927b3f3).
  while [ -n "$c" ]; do
    c=""; next=()
    for a in "${DGB[@]}"; do
      if [[ $a =~ ^(.*)\{([^{}]*(,|\.\.)[^{}]*)\}(.*)$ ]]; then
        c=1; DGX=1; parts=(); rest=${BASH_REMATCH[2]}
        case $rest in *,*) rest+=,; while [ -n "$rest" ]; do parts+=("${rest%%,*}"); rest=${rest#*,}; done;; esac
        if [ ${#parts[@]} -gt 0 ] && [ ${#parts[@]} -le 16 ] && [ $(( ${#next[@]} + ${#parts[@]} )) -le 64 ]; then
          for q in "${parts[@]}"; do next+=("${BASH_REMATCH[1]}$q${BASH_REMATCH[4]}"); done
        else next+=("${BASH_REMATCH[1]}*${BASH_REMATCH[4]}"); fi
      else next+=("$a"); fi
    done
    DGB=("${next[@]}")
  done
}
dgalts(){   # $1 = a piece → DGA, the words bash could make of it; DGX set when an expansion or a group changed it;
  # DGR, the piece respelled as SEVERAL words, each entry one blank-joined spelling; DGS set when it has too many
  # split points to spell every way. Also run by the pattern-kill parser below (dgask, through python3), so both
  # read a globbed name one way.
  local s=$1 pre="" q m v i k bits IFS=' '; local -a dgsg
  DGX=""; DGA=(); DGR=(); DGS=""
  s=${s//'${HOME}'/'$HOME'}
  case $s in '$HOME/'*) pre='$HOME'; s=${s#'$HOME'};; esac   # the one expansion the directory is read through
  # Every other expansion leaves a \002 where it stood: read as empty it comes off, read as blanks it splits there.
  while [[ $s == *'${'*'}'* ]]; do q=${s#*'${'}; s=${s%%'${'*}$'\002'${q#*\}}; DGX=1; done
  case $s in *'${'*) s=${s%%'${'*}$'\002'; DGX=1;; esac   # a `${` the word does not close: its default held a blank (`${x:- }`)
  while [[ $s =~ ^(.*)\$([A-Za-z_][A-Za-z0-9_]*|[0-9@*#?!$-])(.*)$ ]]; do s=${BASH_REMATCH[1]}$'\002'${BASH_REMATCH[3]}; DGX=1; done
  dgbr "$pre${s//$'\002'/}"; DGA=("${DGB[@]}")
  # A LONE BRACE WORD IS SEVERAL WORDS. bash makes `{tmux,kill-server}` into two words, and the first one runs
  # with the rest as its arguments, so each alternative read alone was the bare name (security read of #1101 at
  # 2927b3f3): DGR carries them all, blank-joined, as one spelling.
  [ ${#DGA[@]} -gt 1 ] && DGR+=("${DGA[*]}")
  # …AND AN EXPANSION MAY BE BLANKS. `${IFS}`, `$IFS` and a `${x:- }` default split the word where they stand, so
  # `cc-la[n]d${IFS}7` runs cc-land with the argument 7, where reading the expansion as empty gave the name
  # cc-land7 (same read). A split point is a mark with text on both sides: marks side by side are one, and a mark
  # at either end, or right after a /, splits off nothing that runs (a word that ends in / is a directory). Every
  # way of splitting at up to $DGSPMAX points is spelled; past that, the all-blanks one and each point alone, and
  # DGS says so, which a gated tier refuses.
  m=$s; while [[ $m == *$'\002\002'* ]]; do m=${m//$'\002\002'/$'\002'}; done
  m=${m#$'\002'}; m=${m%$'\002'}; q=/$'\002'; m=${m//"$q"//}
  [[ $m == *$'\002'* ]] || return 0
  IFS=$'\002' read -r -a dgsg <<<"$m"; k=$(( ${#dgsg[@]} - 1 ))
  if [ "$k" -gt "${DGSPMAX:-6}" ]; then   # (dgask runs this in a bash of its own, which has the functions and not the variables)
    DGS=1; v=""; for i in "${dgsg[@]}"; do v+=${v:+ }$i; done; dgbr "$pre$v"; DGR+=("${DGB[*]}")
    for (( bits = 0; bits < k; bits++ )); do
      v=${dgsg[0]}; for (( i = 1; i <= k; i++ )); do [ "$i" = $(( bits + 1 )) ] && v+=" "; v+=${dgsg[i]}; done
      dgbr "$pre$v"; DGR+=("${DGB[*]}")
    done
    return 0
  fi
  for (( bits = 1; bits < (1 << k); bits++ )); do
    v=${dgsg[0]}; for (( i = 1; i <= k; i++ )); do (( bits >> (i - 1) & 1 )) && v+=" "; v+=${dgsg[i]}; done
    dgbr "$pre$v"; DGR+=("${DGB[*]}")
  done
}
dgwhole(){   # $1 = a whole word → DGW, the words its brace groups make of it, blank-joined; empty when they make one
  # deglob cuts a word at ; & | ( ) ` = < > before it reads a group, and bash expands the group first, so
  # `{env,X=1,cc-land,7}` is env X=1 cc-land 7 to bash and two halves with no group in either here (security read of
  # #1101 at d6de9d56). This reads the word whole. Each `${…}` stands aside as a numbered token while it does, since
  # bash never reads a brace group inside one, and comes back after.
  local v=$1 q i a IFS=' '; local -a tk=() out=()
  DGW=""
  while [[ $v == *'${'*'}'* ]]; do q=${v#*'${'}; tk+=("\${${q%%\}*}}"); v=${v%%'${'*}$'\004'$(( ${#tk[@]} - 1 ))$'\005'${q#*\}}; done
  dgbr "$v"; [ ${#DGB[@]} -gt 1 ] || return 0
  for a in "${DGB[@]}"; do for i in "${!tk[@]}"; do a=${a//$'\004'$i$'\005'/${tk[i]}}; done; out+=("$a"); done
  DGW="${out[*]}"
}
deglob(){   # $1 = the haystack → extra lines, each starting with a newline; nothing when no word holds a glob
  case $1 in *[\[?*\{]*) ;; *) return 0;; esac
  local l w p a pat d dl n x e er fl ng="" ncg="" ncm="" src=$1 pass d2 nl=$'\n' sep='[;&|()`=<>]'
  local -a ws dirs pcs hits sd
  local -A dgc=() dgr=() dgseen=() dgfl=()   # keys carry a leading k, so no word is ever read as the subscript @ or *
  IFS=: read -r -a dirs <<<"${PATH:-}"
  shopt -q nullglob && ng=1; shopt -s nullglob
  # `shopt -s nocaseglob` anywhere in the command, and a pattern may match a name in any case: `CC-LA[N]D` is
  # cc-land to bash then (security read of #1101), so the names are matched that way too, the floor's as well.
  case $1 in *nocaseglob*) shopt -q nocaseglob && ncg=1; shopt -q nocasematch && ncm=1; shopt -s nocaseglob nocasematch;; esac
  # THREE PASSES AT MOST. A word bash makes into several (dgalts' DGR, dgwhole's DGW) is a new line, the piece
  # swapped for its words, and a word in it may still be a glob (`{tmu[x],kill-server}`), so the next pass reads
  # those lines for names. A word dgwhole made may still hold an expansion that splits it, so the second pass may
  # respell once more; the third pass's words hold no group and no expansion, so it respells nothing.
  for pass in 1 2 3; do
  [ -n "$src" ] || break
  d2=""
  while IFS= read -r l; do
    read -r -a ws <<<"$l"
    for w in "${ws[@]}"; do
      case $w in *[\[?*\{]*) ;; *) continue;; esac
      if [ -z "${dgc[k$w]+x}" ]; then   # each distinct word once per call: "piece<TAB>piece as the name" per name
        e=""; er=""
        IFS=$'\n' read -r -d '' -a pcs <<<"${w//$sep/$nl}"
        for p in "${pcs[@]}"; do
          dgalts "$p"; dgseen=(); dgfl=()
          for x in "${DGR[@]}"; do er+=$p$'\t'$x$'\n'; done   # …and "piece<TAB>its words" per respelling
          [ -n "$DGS" ] && [ -z "$dgsplit" ] && dgsplit=$p
          for a in "${DGA[@]}"; do
            pat=${a##*/}
            case $pat in ''|'['|'[['|']'|']]') continue;; esac
            d=${a%"$pat"}
            case $pat in
              *[\[?*]*) ;;
              *) [ -n "$DGX" ] && dgseen[k$d$pat]=1 && dgfl[k$d$pat]=1; continue;;   # a group or an expansion made the name itself
            esac
            [[ $pat == *[!?*]* ]] || continue   # nothing but * and ?: every name, and no part of any
            # shellcheck disable=SC2088  # the ~ and $HOME here are the text typed, matched, and mapped by hand
            case $d in '') dl=$cwd/;; '~/'*) dl=$HOME/${d#'~/'};; '$HOME/'*) dl=$HOME/${d#'$HOME/'};; /*) dl=$d;; *) dl=$cwd/$d;; esac
            sd=("$dl")   # an absolute directory names the one place the word expands in, whatever a cd before it did
            # shellcheck disable=SC2088  # the same typed text as above
            case $d in /*|'~/'*|'$HOME/'*) ;; *) sd+=("${dirs[@]/%//}" "$HOME/bin/" "$HOME/.cc/try/bin/" "${root:-$cwd}/bin/" "${root:-$cwd}/core/bin/" "$cwd/");; esac
            # shellcheck disable=SC2053  # $pat is the glob, matched as one on purpose
            for n in $GLOBNAMES; do [[ $n == $pat ]] && dgseen[k$d$n]=1 && dgfl[k$d$n]=1; done
            for n in "${sd[@]}"; do
              [ -d "$n" ] || continue
              # shellcheck disable=SC2206  # the unquoted $pat is the glob bash expands, as the shell would
              hits=( "$n"$pat )
              for x in "${hits[@]##*/}"; do dgseen[k$d$x]=1; done
            done
          done
          if [ ${#dgseen[@]} -gt "$DGMAX" ]; then   # past the cap: the floor's names, and the piece is named for the gated tiers
            [ -n "$dgcap" ] || dgcap=$p
            for x in "${!dgfl[@]}"; do e+=$p$'\t'${x#k}$'\n'; done
          else
            for x in "${!dgseen[@]}"; do e+=$p$'\t'${x#k}$'\n'; done
          fi
        done
        if [[ $w =~ $sep ]] && [[ $w == *'{'* ]]; then dgwhole "$w"; [ -z "$DGW" ] || er+=$w$'\t'$DGW$'\n'; fi
        dgc[k$w]=$e; dgr[k$w]=$er
      fi
      if [ "$pass" != 3 ] && [ -n "${dgr[k$w]}" ]; then
        while IFS=$'\t' read -r p n; do [ -n "$p" ] && { x=${l/"$p"/"$n"}; dg+=$'\n'$x; d2+=$x$'\n'; }; done <<<"${dgr[k$w]}"
      fi
      [ -n "${dgc[k$w]}" ] || continue
      while IFS=$'\t' read -r p n; do [ -n "$p" ] && dg+=$'\n'${l/"$p"/"$n"}; done <<<"${dgc[k$w]}"
    done
  done <<<"$src"
  src=${d2%$'\n'}
  done
  [ -n "$ng" ] || shopt -u nullglob
  case $1 in *nocaseglob*) [ -n "$ncg" ] || shopt -u nocaseglob; [ -n "$ncm" ] || shopt -u nocasematch;; esac
}
dgask(){   # the pattern-kill parser's question: a word per NUL on stdin → the names in "$@" bash could run it as, each
  # ending in US, the answer ending in NUL. Bash decides, as it does when it runs the word: [^…], [!…] and [[:alpha:]]
  # match here as they do there, which python's fnmatch never did (review of #1101).
  local w a p n o
  while IFS= read -r -d '' w; do
    o=""; dgalts "$w"
    for a in "${DGA[@]}"; do
      p=${a##*/}
      case $p in
        '') ;;
        *[\[?*]*) [[ $p == *[!?*]* ]] || continue
                  # shellcheck disable=SC2053  # $p is the glob, matched as one on purpose
                  for n in "$@"; do [[ $n == $p ]] && o+=$n$'\037'; done;;
        *) [ -n "$DGX" ] && o+=$p$'\037';;
      esac
    done
    printf '%s\0' "$o"
  done
}
# THE KILL FENCE'S READERS, shared by the universal pattern-kill gate below and the gated tiers' fence (3b):
# what a pid's parent is, whether a pid is a session, whether a kill delivers anything, and which word is the pattern.
kppid(){ awk '/^PPid:/{print $2; exit}' "/proc/$1/status" 2>/dev/null; }
kheld(){   # rc 0 = pid $1 is a session or the loop runner: off limits inside the subtree as much as outside
  local c
  [ -r "/proc/$1/cmdline" ] || return 1            # …and a pid that is gone is not held (the redirect below printed the shell's own error for it)
  # ANY claude IS A SESSION, `-p` OR NOT. The planning session, an orch and a handoff peer stand INTERACTIVE
  # in the same tree a member or a worker does, and a fence that held only `claude -p` left them to kcwd
  # (review of #404). comm is the kernel's name for the binary, which the cmdline is not.
  [ "$(cat "/proc/$1/comm" 2>/dev/null)" = claude ] && return 0
  c=$(tr '\0' ' ' < "/proc/$1/cmdline" 2>/dev/null) || return 1
  case "$c" in *cc-loop*) return 0;; esac
  case " $c " in *' -p '*|*' --print '*) case "$c" in *claude*) return 0;; esac;; esac
  return 1
}
# SIGNAL ZERO DELIVERS NOTHING: `kill -0 <pid>` asks whether the process is there, which is how a worker
# waits out the gate run it detached, and the fence read it as a kill (row raised-guard-blocks-liveness-
# probe-signal-zero). An invocation whose signal is 0 ends no process, so it fences none; the same command
# with any other signal, or none, is fenced exactly as before. Spelled -0, -s 0, -n 0 or --signal 0 —
# except that pkill's -s is a SESSION id, not a signal: `pkill -s 0 -f x` kills, in this shell's session.
# …AND THE EFFECTIVE SIGNAL IS WHAT IS DELIVERED, NOT ANY ZERO ON THE LINE. The first cut called it a probe
# at the first zero spelling anywhere in the argv: `kill -9 <pid> -0` (bash: the FIRST dash-argument is the
# signal, a later -0 is process group 0), `kill -s 0 -s 9 <pid>` and `pkill -0 --signal 9 -f x` (the LAST
# spec wins in both) all signalled and passed (landing review and security read of #404; each shape run
# against a fixture). So it is a probe only when every signal spec on the line says 0 and there is at least
# one: for kill, only the dash-arguments in front of the first target are specs at all; for pkill and
# killall a spec anywhere counts, since getopt permutes. A spelling this cannot read is not a probe.
kprobe(){   # rc 0 = nothing is delivered. $1 = the verb: -n is a signal to kill alone, -s to kill and killall
  local v=$1 y sk="" seen="" lead=1; shift
  for y in "$@"; do
    if [ -n "$sk" ]; then [ "$sk" = sig ] && { seen=1; [ "$y" = 0 ] || return 1; }; sk=""; continue; fi
    if [ "$v" = kill ] && [ -z "$lead" ]; then continue; fi   # past the first target: pids and groups, never a signal
    case "$y" in
      --) lead="";;
      --signal=*) seen=1; [ "${y#--signal=}" = 0 ] || return 1;;
      --signal) sk=sig;;
      -s) if [ "$v" = pkill ]; then sk="val"; else sk="sig"; fi;;   # pkill -s <session id>: a value, no signal
      -n) if [ "$v" = kill ]; then sk="sig"; elif [ "$v" = killall ]; then sk="val"; fi;;   # pkill -n is --newest, a flag
      -0|-SIG0) seen=1;;
      -[0-9]*|-[A-Z]*) return 1;;                  # a real signal, spelled bare
      -*) ;;                                       # some other flag
      *) [ "$v" = kill ] && lead="";;              # kill: the first target ends the options
    esac
  done
  [ -n "$seen" ]
}
# WHICH ARGUMENT IS THE PATTERN. pgrep/pkill/killall take a VALUE for -u/-U/-g/-G/-P/-t/-s/-d and
# --signal, so "the first bare word" is not it: `pkill --signal TERM claude` read TERM as the pattern,
# `pgrep -- TERM` matched nothing, and the command went through — then TERMed every `claude` this user
# owns, this worker's own session included (review of #181). The value is consumed; what is left names
# the pattern. Only options that genuinely take one are listed: consuming a word that is really the
# pattern would turn a refusal into a pass, which is the failure this is fixing.
# THE VERB DECIDES WHAT A LETTER MEANS, and reading it wrong is a hole in whichever direction it falls.
# This is one parser for pgrep, pkill and killall, and they disagree: `-o` is --oldest (a FLAG) to pkill
# and --older-than TIME (a VALUE) to killall, `-n` is --newest to one and --ns PID to the other. Read as
# pkill's, killall's value became the pattern — `killall --older-than 1h claude` reduced to pat=1h,
# `pgrep -x -- 1h` found nothing, the fence had nothing to refuse, and it killed every claude over an
# hour old: this worker's own claude -p and its loop runner, the 11:15Z incident again (review of #193).
# Read as killall's it is WORSE than a false positive: `pgrep -o -f <suite> | xargs kill` would eat the
# `-f`, resolve the pattern without --full, find fewer processes and let the kill through — a refusal
# turned into a pass, which is exactly what the note above warns of. So the verb is passed in.
kpat(){   # $1 = the verb, $@ = the argv after it. Prints "<-f seen>\t<pattern>"; rc 1 = nothing nameable
  local v=$1 y sk="" full="" pat=""; shift
  for y in "$@"; do
    if [ -n "$sk" ]; then sk=""; continue; fi
    case "$y" in
      -s|--signal|--session|-u|--uid|-U|--euid|-g|--pgroup|-G|--group|-P|--parent|-t|--terminal|-d|--delimiter|--ns|--nslist) sk=1;;
      # …and the rest of the ones that take a value. `pkill --older 3600` — a worker's own "clean up
      # strays" idiom — read 3600 as the pattern, matched nothing, and ran: every process this user
      # owns over an hour old, which is its own claude -p and its loop runner. Consumed here, those
      # commands reduce to NO pattern and land in the refusal below, which is where a selector that
      # names no process belongs (review of #181).
      # `-O` is --older's short spelling and was the one left: `pkill -O 3600 -u 1000` read 3600 as the
      # pattern, so the -u never reached the fence at all — every process of that uid, unfenced.
      -O|--older|-r|--runstates|-F|--pidfile|-q|--queue|--env|--cgroup|-Z|--context) sk=1;;
      # …and the ones only killall gives a value to. `-o` and `-n` are FLAGS to pkill (--oldest,
      # --newest), so they are consumed for that verb alone; `--older-than`/`--younger-than` are
      # killall's own spellings and `--ns` is a value to both, so it sits in the shared line above.
      -o|--older-than|-y|--younger-than|-n) case "$v" in killall) sk=1;; esac;;
      -f|--full) full=1;;
      -*) ;;                                     # a flag, a signal, or --opt=value: none of them a pattern
      *) [ -n "$pat" ] || pat=$y;;
    esac
  done
  [ -n "$pat" ] || return 1
  printf '%s\t%s' "$full" "$pat"
}
# A TMUX COMMAND SSH CARRIES TO ANOTHER HOST IS THAT HOST'S SERVER, NOT THIS BOX'S. `ssh <host> 'tmux kill-session
# -t x'` runs the tmux over there, and the gate below refused it as this box's server (row raised-guard-reads-
# remote-tmux-kill-as-local: closing a leftover session on the peer box). sshrc prints the command with the REMOTE
# COMMAND of each plain `ssh … <host> <words>` statement blanked to '', and the gate refuses only if the tmux kill
# is still there once those are gone; every other rule reads the command as it was. It blanks nothing at all when
# the text holds what this walk does not follow (a heredoc, a backtick, a `$(`, a `${` or a `$'` whose quotes bash
# reads its own way, a `#` that starts a comment, an open quote, a function or alias named ssh; review of #1104: a
# quote inside a comment or a `${x/'"'/}` hid a local kill as ssh's), and nothing unless the WHOLE command is that one
# ssh statement: a statement before it can make `ssh` something else here (an eval'd or sourced function, a PATH, a
# `hash -p`, a command_not_found_handle; security read of #1104 at 3587a496), so one after a `;`, a pipe, a newline
# or a redirection is never blanked, and an env word before ssh is not ssh. In that statement it it stops at the first word that is not a plain word, a whole single-quoted string,
# or a double-quoted one with no `$`, backtick or backslash: `ssh h "$(tmux kill-server)"` expands HERE and stays
# refused. Only a statement whose first word is ssh itself counts, so `bash -c 'tmux kill-server'` and
# `ssh h x; tmux kill-server` are untouched. Option values are never blanked, because ssh runs ProxyCommand and
# LocalCommand on THIS box, and a statement with -F, -S or a ControlPath (a socket can lead anywhere) is left alone.
# A -- after the host ends the options, and what follows is the command, but a first word there that looks like an
# option (`ssh -- peer -o ProxyCommand=…`) keeps the command unblanked whichever way this ssh reads it. The host must
# be shown to be elsewhere: `ssh -G` resolves it with the statement's own -o options and its -J as ProxyJump, and a
# host that resolves to this box (loopback, or a name or address of its own), that ssh -G cannot read, that is
# reached through any proxy or jump (the far end resolves it, and may land here) or whose config sets a ControlPath
# (a mux master at that path may lead back here, as -S may) keeps the whole command unblanked. Every way out keeps the
# refusal; this only ever takes one off. Only the first hop is resolved, so the remote command is blanked only when
# the far shell reads it as plain words (no quote, $, ; or the like left once ssh's own quotes come off) and none of
# them is an ssh, mosh, rsh or telnet that could hop on, back to this box; and never when the statement, or the config
# ssh -G reads for it, forwards a port, a socket, an agent, X11 or a tunnel (-R, -L, -D, -W, -w, -A, -X, -Y, any
# *Forward*/Tunnel/RemoteCommand option): a -R to this box's sshd or tmux socket is a way back (security read of
# #1104 at e6747487).
sshrc(){   # $1 = the raw command; prints it with remote ssh commands blanked, or unchanged
  local c=${1//$'\001'/} out hosts hl host hn g g2 px ips ip me o; local -a oa ox
  case $c in *'<<'*|*'`'*|*'$('*|*'${'*|*"\$'"*) printf '%s' "$c"; return;; esac
  grep -qE '(^|[^A-Za-z0-9_.-])ssh[ \t]*\(|function[ \t]+ssh|alias[^;&|]*ssh=' <<<"$c" && { printf '%s' "$c"; return; }
  out=$(awk -v SQ="'" '
    function plain(w) { return w ~ /^[A-Za-z0-9_.\/=:,@%+~-]+$/ }
    function sq(w) { return length(w) >= 2 && substr(w, 1, 1) == SQ && substr(w, length(w), 1) == SQ && index(substr(w, 2, length(w) - 2), SQ) == 0 }
    function dq(w) { return w ~ /^"[^"$`\\!]*"$/ }
    function unq(w) { return sq(w) ? substr(w, 2, length(w) - 2) : w }
    function stmt(   i, j, L, v, host, opts, nb, k, ot) {   # W[1..nw] one statement: blank its remote command, note its host
      if (W[1] != "ssh" && W[1] !~ /^\/(usr\/)?bin\/ssh$/) return
      host = ""; opts = ""; nb = 0; ot = 0; split("", B)
      for (i = 2; i <= nw; i++) {
        if (!ot && (host == "" || !nb)) {   # ssh reads options before the host and again after it, up to the command
          if (W[i] == "--") { ot = 1; continue }   # …and none after a --: the next word is the host, or the command
          if (W[i] ~ /^-./) {
            if (!plain(W[i])) return
            for (j = 2; j <= length(W[i]); j++) { L = substr(W[i], j, 1)
              if (index("ADLRWwXY", L)) return   # a forward or tunnel (-R back to this box, a forwarded agent or socket)
              if (!index("BbcDEeFIiJLlmOoPpQRSWw", L)) continue
              v = substr(W[i], j + 1); if (v == "") { if (++i > nw) return; v = W[i] }
              if (L == "F" || L == "S") return
              if (L == "o" || L == "J") { if (!plain(v) && !sq(v)) return; v = unq(v)
                if (L == "J") v = "ProxyJump=" v; else if (tolower(v) ~ /^[ \t]*[a-z0-9]*(control|forward|tunnel|localcommand|remotecommand|streamlocal|sessiontype|permitremoteopen|gatewayports)[a-z0-9]*([ \t=]|$)/) return
                opts = opts "\037" v }
              break }
            continue } }
        if (host == "") { if (!plain(W[i])) return; host = W[i]; continue }
        v = W[i]; if (sq(v) || dq(v)) v = substr(v, 2, length(v) - 2)
        if (!nb && v ~ /^-/) return   # an option-shaped first word after the host (`ssh -- peer -o ProxyCommand=…`) is never blanked, whichever way this ssh reads it
        if (plain(W[i]) || sq(W[i]) || dq(W[i])) { B[i] = 1; nb++ } else return }   # a word it cannot read (a \ escape): none of it
      if (!nb) return
      for (k in B) { v = W[k]; if (sq(v) || dq(v)) v = substr(v, 2, length(v) - 2)   # the remote shell reads it once more:
        if (v !~ /^[A-Za-z0-9_.\/=:,@%+~ \t-]*$/) return   # a quote, $, ; or anything it would read its own way keeps it
        if (tolower(v) ~ /ssh|mosh|rsh|rlogin|telnet|dbclient/) return }   # …and so does a hop on from there, perhaps back here
      for (k in B) W[k] = SQ SQ
      H = H host opts "\n" }
    function emit(   i) { if (nw) { ns++; stmt() } for (i = 1; i <= nw; i++) T = T G[i] W[i]; T = T G[nw + 1]; nw = 0; split("", W); split("", G) }
    BEGIN { RS = "\001" }
    { s = $0; n = length(s); q = ""; cur = ""; inw = 0
      for (p = 1; p <= n; p++) { ch = substr(s, p, 1)
        if (q != "") { cur = cur ch; if (ch == q) q = ""; else if (q == "\"" && ch == "\\") cur = cur substr(s, ++p, 1); continue }
        if (ch == SQ || ch == "\"") { q = ch; cur = cur ch; inw = 1; continue }
        if (ch == "\\" && substr(s, p + 1, 1) == "\n") { p++; if (!inw) G[nw + 1] = G[nw + 1] "\\\n"; continue }   # a line joined on
        if (ch == "\\") { cur = cur ch substr(s, ++p, 1); inw = 1; continue }
        if (ch == "#" && !inw) { printf "%s", s; exit }   # a comment: the shell reads no quote or separator in it
        if (index(" \t;&|(){}\n<>", ch)) {
          if (inw) { W[++nw] = cur; cur = ""; inw = 0 }
          if (ch == " " || ch == "\t") { G[nw + 1] = G[nw + 1] ch; continue }
          emit(); T = T ch; continue }   # a separator or a redirection ends the statement here
        cur = cur ch; inw = 1 }
      if (q != "") { printf "%s", s; exit }
      if (inw) W[++nw] = cur
      emit(); if (ns != 1) { printf "%s", s; exit }   # the whole command is that one ssh statement, or nothing is blanked
      printf "%s\001%s", T, H }' <<<"$c")
  case $out in *$'\001'*) ;; *) printf '%s' "$c"; return;; esac
  hosts=${out#*$'\001'}
  [ -n "$hosts" ] || { printf '%s' "$c"; return; }
  me=" $(hostname -I 2>/dev/null) "; g=" $(hostname 2>/dev/null) $(hostname -s 2>/dev/null) $(hostname -f 2>/dev/null) "; g=${g,,}
  while IFS= read -r hl; do
    [ -n "$hl" ] || continue
    IFS=$'\037' read -r -a oa <<<"$hl"; host=${oa[0]}; oa=("${oa[@]:1}")
    ox=(); for o in "${oa[@]}"; do ox+=(-o "$o"); done
    g2=$(timeout 3 ssh -G "${ox[@]}" -- "$host" 2>/dev/null) || { printf '%s' "$c"; return; }
    hn=$(awk '$1 == "hostname" { print tolower($2); exit }' <<<"$g2"); [ -n "$hn" ] || { printf '%s' "$c"; return; }
    # …and a ControlPath the config file sets is a socket like -S: a mux master opened to localhost at the path
    # the peer's ssh would use carries the command back here (#1104's advisory), so it keeps the refusal too
    px=$(awk '($1 == "proxycommand" || $1 == "proxyjump" || $1 == "controlpath") && $2 != "none" { print 1; exit }' <<<"$g2")
    [ -z "$px" ] || { printf '%s' "$c"; return; }   # the far end of a proxy picks the host, and it may be this box
    # …and a forward, a tunnel or a command the config file adds is a way back here (a -R to this box's sshd or its
    # tmux socket, a forwarded agent the far end can ssh back with), so one set there keeps the command unblanked too
    px=$(awk '$1 ~ /^(remoteforward|localforward|dynamicforward|remotecommand|localcommand)$/ || ($1 ~ /^(forwardagent|forwardx11|permitlocalcommand)$/ && $2 != "no") || ($1 == "tunnel" && $2 != "false" && $2 != "no") || ($1 == "sessiontype" && $2 != "default") { print 1; exit }' <<<"$g2")
    [ -z "$px" ] || { printf '%s' "$c"; return; }
    case $hn in localhost|localhost.*|ip6-localhost|ip6-loopback|0.0.0.0|::|::1|127.*|::ffff:127.*) printf '%s' "$c"; return;; esac
    case $g in *" $hn "*) printf '%s' "$c"; return;; esac
    ips=$(timeout 3 getent ahosts "$hn" 2>/dev/null | awk '{ print $1 }' | sort -u)
    for ip in $ips; do
      case $ip in 0.0.0.0|::|::1|127.*|::ffff:127.*) printf '%s' "$c"; return;; esac
      case $me in *" $ip "*) printf '%s' "$c"; return;; esac
    done
  done <<<"$hosts"
  out=${out%%$'\001'*}; printf '%s' "${out%$'\n'}"   # less the newline the <<< put on
}
if [ "$tool" = Bash ]; then   # universal gate, ALL sessions (interactive ones and their subagents included): nothing may kill the shared tmux server
  uk=$(hay "$(jq -r '.tool_input.command // ""' <<<"$inp")")   # …with the statement lines marked: see cmdpos
  u=${uk//$'\001'/}   # every rule but the cd walk reads a NAME at ^, so the mark comes off here, not in a second pass
  dg=""; deglob "$u"
  # …and those copies read the way the typed lines were: through hay(), so a wrapper in front of the name (`timeout
  # 5`, setsid, `sudo -u x`) comes off and the name stands at a command position. A copy that respells a word
  # carries its wrapper inside the word (`{timeout,5,tmux,kill-server}`, `timeout${IFS}5${IFS}tmux…`), where the
  # typed line's own pass through hay() never saw it (security read of #1101 at d6de9d56). Added, never in place.
  [ -z "$dg" ] || { dh=$(hay "${dg#$'\n'}"); dh=${dh//[$'\001\002\003\006']/}; [ -z "$dh" ] || dg+=$'\n'$dh; }
  ug=$dg; u0=$u; u+=$ug   # …and a copy of each line for every name a globbed word in it can match (deglob), read by every gate below, the universal ones first; the ungated write walk alone keeps the lines as typed (u0)
  # A LINE THE WALK CANNOT READ ONE WAY IS REFUSED, NOT GUESSED AT (hay's AMB): a `#` right after `)`, `<` or `>`
  # is a comment after a subshell or a redirection and part of the word after a `$( )`, and the next line was
  # joined on to it, or a heredoc opened behind it. Whichever reading the guard picked, the other ran a line it
  # never gated (security reads of #975), so it picks neither. A space before the `#`, or quotes round it, decides.
  # …AND A HEREDOC INSIDE A `$( )`, `"$( )"`, BACKTICK OR SUBSHELL WHOSE TERMINATOR THE WALK CANNOT FIND (hay's HNF):
  # the line that closes the construct is the statement the opener began, and with no terminator there is no
  # telling which line that is, so the copy it may finish is never read whole (review of #1141).
  case $uk in *$'\006'*) echo "cc-guard: blocked — a heredoc opened inside \$( ), a backtick or ( ) has no terminator line the gates can find, so they cannot tell which line closes it or what that line runs. Use a plain delimiter word such as EOF, alone on its own line. A shift spelled \`let x=1<<2\` reads as a heredoc here: write it \$((1<<2))." >&2; exit 2;; esac
  case $uk in *$'\003'*) echo "cc-guard: blocked — a # right after ) < or > may or may not start a comment, and here that decides whether the next line is joined on or a heredoc opens, so the gates cannot tell what runs. Put a space before the # if it is a comment, or quote it if it is text." >&2; exit 2;; esac
  # …the name by its path as well (`/usr/bin/tmux kill-server` passed, and so did the glob deglob turns into it: review of #1101)
  tmuxkill(){ grep -qE "$AT"'([^ ]*/)?(tmux +kill-se[rs]|(pkill|killall)( +-[^ ]+)* +([^ ]*/)?tmux|systemctl +--user +(restart|stop|kill) +tmux-main)' <<<"$1" \
    || grep -qE 'send-keys[^;&|]*tmux +kill-se[rs]' <<<"$1"; }
  # …and read again with what ssh carries to another host taken out (sshrc): only a kill still there reaches this box.
  # That copy gets deglob's lines as $u did (`ssh peer x; tm[u]x kill-server`), worked out in a subshell so the
  # dg, dgcap and dgsplit the gates below read stay the ones from the command as typed
  # The first look takes an ssh at a command position with a tmux kill anywhere in its text once this shell's quotes
  # and backslashes are gone: `ssh peer ssh\ box71\ tmux\ kill-server` is one word here and `ssh box71 tmux kill-server`
  # over there, which hay never puts at a command position (security read of #1104 at e431595e). sshrc reads no
  # such word, so the command stays refused.
  # …and so is a hop spelled so the far shell builds the words (guard-ssh-hop-escapes-dequote): a `$'\x74mux'` is
  # read the way bash reads it, `\`+newline joins, and an expansion (`$IFS`, `${x}`) counts as a blank, so
  # `ssh peer $'ssh box71 \x74mux kill-server'` and `ssh peer 'ssh box71 tmux$IFS''kill-server'` reach sshrc too
  # The typed text gets the same blanking as the @E one: there `\t` became a tab, so `ssh peer ssh\ box71\ \tmux\
  # $IFS\ kill-server` read as `<tab>mux`, and the typed text kept `$IFS` between tmux and kill (perms' read of #1396)
  sshtmux(){ local t=${2@E} s   # …the expansions first: with the quotes gone `$IFS''kill` would read as one name
    t=$(sed -E 's/\$(\{[^}]*\}|[A-Za-z_][A-Za-z0-9_]*|[0-9@*#?!$-])/ /g' <<<"$t"); t=${t//[\\\'\"$'\n']/}
    s=$(sed -E 's/\$(\{[^}]*\}|[A-Za-z_][A-Za-z0-9_]*|[0-9@*#?!$-])/ /g' <<<"$2"); s=${s//[\\\'\"]/}
    grep -qE "$AT"'([^ ]*/)?ssh([[:blank:]]|$)' <<<"$1" && printf '%s\n' "$t" "${2//[\\\'\"]/}" "$s" | grep -qE 'tmux[[:blank:]]+kill-se[rs]'; }   # any text: @E reads `\t` as a tab
  uc=$(jq -r '.tool_input.command // ""' <<<"$inp")
  { { tmuxkill "$u" || sshtmux "$u" "$uc"; } && { us=$(sshrc "$uc")
      [ "$us" = "$uc" ] || { us=$(hay "$us"); us=${us//$'\001'/}
        us+=$(dg=""; deglob "$us"; [ -z "$dg" ] || { dh=$(hay "${dg#$'\n'}"); dh=${dh//[$'\001\002\003']/}; [ -z "$dh" ] || dg+=$'\n'$dh; }; printf '%s' "$dg")
        tmuxkill "$us"; }; }; } && { echo "cc-guard: blocked — that takes the shared tmux server (every session on the box) down (\$TMUX beats TMUX_TMPDIR; use tmux -S <path> for scratch servers)" >&2; exit 2; }   # `tmux -S <path> kill-server` still passes: the pattern wants kill-se* right after tmux
  # …and an ssh that forwards a port, a socket, an agent or a tunnel, next to any tmux …kill-server or …kill-session:
  # `ssh -R /tmp/x:/tmp/tmux-1000/default peer 'tmux -S /tmp/x kill-server'` reaches this box's server through the
  # socket it forwards, though the -S form passes everywhere else (security read of #1104). Read loosely on purpose.
  { grep -qE '(^|[^A-Za-z0-9_.-])ssh[[:blank:]]([^;&|]*[[:blank:]])?-[A-Za-z]*[ADLRWwXY]' <<<"$u" || grep -qiE '(^|[^A-Za-z0-9_.-])ssh([[:blank:]]|$)[^;&|]*(forward|tunnel)' <<<"$u"; } \
    && grep -qE 'tmux[^;&|]*kill-se[rs]' <<<"$u" \
    && { echo "cc-guard: blocked — an ssh that forwards a port, socket or agent next to a tmux kill can reach the shared tmux server (every session on the box) through the forward; run the forward and the kill as separate commands, without the forward if the kill is for the other host" >&2; exit 2; }
  # THE PERMISSION SEAT'S LAUNCH IS NOBODY'S TO TYPE — universal, every tier, the seat itself included. `cc
  # __runperms <id> <sid>` starts a claude with --dangerously-skip-permissions on the seat's brief.md, and `cc-handoff
  # --perms-dir` is the question it asks first; the only caller of either is the tmux window cc-handoff --overlap perms
  # opens, and that window's command is not a tool call. Read from the haystack, so a grep for the words, a quoted
  # mention and a heredoc body that is only text all pass; a statement that RUNS one is refused.
  grep -qE "$AT"'([^ ]*/)?cc[[:space:]]+__runperms([^A-Za-z0-9_.-]|$)|'"$AT"'([^ ]*/)?cc-handoff[[:space:]]+([^;&|]*[[:space:]])?--perms-dir([^A-Za-z0-9_.-]|$)' <<<"$u" \
    && { echo "cc-guard: blocked — cc __runperms and cc-handoff --perms-dir start the permission-skipping seat, and only the tmux window cc-handoff --overlap perms opens runs them; hand the seat off with cc-handoff --overlap perms instead" >&2; exit 2; }
  # A PATTERN KILL NEVER REACHES A SESSION — universal too, every role, a subagent of an ungated seat included.
  # 2026-09-26 02:34Z a review subagent of a planning seat cleaned up after a selfcheck with `pkill -KILL -f 'print
  # "| "'`: pkill reads that as a regex, `print "` OR ` "`, which every claude argv carries, and it SIGKILLed about
  # 26 seats box-wide mid-merge. The fence below (3b) held only workers and members, and it reads the haystack,
  # which has already dropped the quotes and blanked the quoted `|` — to it the pattern was `print`. So this reads
  # the RAW command with its quotes (upat: python3's shlex, the haystack's words when there is none), finds every
  # pkill and killall, and every pgrep or pidof whose pids feed a kill (`| xargs kill`, `kill $(…)`), through
  # wrappers and `sh -c`, and asks pgrep what each would take NOW — the pkill with its own selectors, so `pkill -u
  # <uid>` and `pkill -P <pid>` resolve too. One session process among them (kheld: any claude, a `claude -p`, a
  # loop runner; or a codex or the tmux server) and the command is refused. A kill of a named pid, `kill -0`, a
  # probe with signal 0, a pattern that takes only what the caller started (`pkill -f $T/fixture`, `pkill -P
  # <own pid>`) and a pattern that matches nothing all pass. Ceiling: a word held in a variable cannot be resolved
  # here and passes, and a kill loop over a pid list (`while read p; do kill $p`) is not seen at all.
  # The brief's line: "A pkill/killall/pgrep -f|xargs kill whose pattern could match another session's argv is refused".
  if grep -qE '(^|[^A-Za-z0-9_.-])(pkill|killall)([^A-Za-z0-9_.-]|$)' <<<"$u" \
     || { grep -qE '(^|[^A-Za-z0-9_.-])(pgrep|pidof)([^A-Za-z0-9_.-]|$)' <<<"$u" && grep -qE '(^|[^A-Za-z0-9_.-])kill([^A-Za-z0-9_.-]|$)' <<<"$u"; }; then
    usess(){ kheld "$1" && return 0; case "$(cat "/proc/$1/comm" 2>/dev/null)" in codex|tmux*) return 0;; esac; return 1; }
    ukill(){ echo "cc-guard: blocked — $1. A pattern kill reaches every process on the box whose argv carries it, other sessions included: kill the pid you started (kill <pid>, pkill -P <your own pid>), or anchor the pattern on a path only your fixture has." >&2; exit 2; }
    uhay(){ grep -oE "$AT"'([^ ]*/)?(pkill|killall)[[:space:]]+[^;&|]*' <<<"$1" | sed -E 's/^.*(pkill|killall)[[:space:]]+/\1 /' | tr ' ' '\037'; }
    upat(){   # the raw command → one line per pattern kill: <verb> US <args…> [RS <the kill it feeds> US <args…>]
      local raw; raw=$(jq -r '.tool_input.command // ""' <<<"$inp")
      # …AND THE KILLS IN DEGLOB'S COPIES TOO, whichever reader ran. shlex reads `pkill${IFS}-f${IFS}<pat>` and
      # `{pkill,-f,<pat>}` as one word, while bash runs them as pkill -f <pat>: the copy that spells it so is the
      # only place the kill shows (security read of #1101 at 2927b3f3). A line more can only refuse more.
      if command -v python3 >/dev/null 2>&1; then
        DGBASH=$BASH DGSRC="$(declare -f dgbr dgalts dgask); dgask \"\$@\"" python3 - "$raw" <<'PY' && { [ -z "$ug" ] || uhay "$ug"; return 0; }
import os, re, shlex, subprocess, sys
US, RS = '\x1f', '\x1e'
OPS = set('();<>|&\n')
OPRE = re.compile(r'\|\||&&|;;|<<<|<<-?|>>|>&|<&|&>>?|\|&|[();<>|&\n]')
REDIR = {'>', '<', '>>', '<>', '>&', '<&', '&>', '&>>', '<<<', '<<', '<<-'}
SUBRE = re.compile(r'\$\(([^()]*)\)|`([^`]*)`')
def heredocs(t):   # a heredoc body is data unless a shell reads it; an fd number is not a word
    L = t.split('\n'); out = []; i = 0
    while i < len(L):
        out.append(L[i]); m = re.search(r'(?<!<)<<(?!<)(-?)\s*([\'"]?)([A-Za-z_][A-Za-z0-9_]*)\2', L[i])
        i += 1
        if not m: continue
        sh = re.search(r'(^|[\s;&|(/])(bash|sh|zsh|dash|ksh)(\s|$)', L[i-1][:m.start()])
        while i < len(L) and (L[i].lstrip('\t') if m.group(1) else L[i]) != m.group(3):
            if sh: out.append(L[i])
            i += 1
        i += 1
    return re.sub(r'(?<![\w$])\d+(?=[<>])', ' ', '\n'.join(out))
def toks(t):
    lx = shlex.shlex(heredocs(t), posix=True, punctuation_chars='();<>|&\n'); lx.whitespace_split = True; lx.whitespace = ' \t\r'
    r = []
    for w in lx:
        if set(w) <= OPS: r += OPRE.findall(w); continue
        if SUBRE.search(w): r.append(w); continue          # a whole substitution in one word: parse() opens it
        if w.startswith('`'): r += ['$', '(']; w = w[1:]    # an unquoted `…` split at its spaces
        c = w.endswith('`')
        if c: w = w[:-1]
        if w: r.append(w)
        if c: r.append(')')
    return r
def parse(t, cmds):   # appends each simple command of t to cmds as [words, piped-from index, substitution indices]
    fr = [[[], None, [], False, 0]]
    def end(op):
        f = fr[-1]
        if f[0]: cmds.append([f[0], f[1], f[2]]); f[1] = len(cmds) - 1 if op == '|' else None
        elif op != '|': f[1] = None
        f[0] = []; f[2] = []
    T = toks(t); i = 0
    while i < len(T):
        w = T[i]; f = fr[-1]; i += 1
        if w in REDIR: i += 1; continue
        if w == '(':
            sub = bool(f[0]) and f[0][-1].endswith('$')
            if sub: f[0][-1] = f[0][-1][:-1] + '$SUB'
            fr.append([[], None, [], sub, len(cmds)]); continue
        if w == ')' and len(fr) > 1:
            end(';'); g = fr.pop()
            if g[3]: fr[-1][2].extend(range(g[4], len(cmds)))
            continue
        if set(w) <= OPS: end('|' if w in ('|', '|&') else ';'); continue
        for m in SUBRE.finditer(w):
            k = len(cmds); parse(m.group(1) if m.group(1) is not None else m.group(2), cmds)
            f[2].extend(range(k, len(cmds)))
        f[0].append(w)
    while len(fr) > 1:
        end(';'); g = fr.pop()
        if g[3]: fr[-1][2].extend(range(g[4], len(cmds)))
    end(';')
WRAP = {'sudo': {'-u', '-g', '-C', '-D', '-h', '-p', '-r', '-t', '-U'}, 'env': {'-u', '-C', '-S'},
        'timeout': {'-s', '-k', '--signal', '--kill-after'}, 'nice': {'-n'}, 'ionice': {'-c', '-n', '-p', '-t'},
        'stdbuf': set(), 'nohup': set(), 'setsid': set(), 'command': set(), 'exec': set(), 'time': set(),
        'xargs': {'-a', '-d', '-E', '-I', '-L', '-n', '-P', '-s', '--arg-file', '--delimiter', '--max-args', '--max-procs'}}
GV = ('pkill', 'killall', 'kill', 'pgrep', 'pidof', 'bash', 'sh', 'zsh', 'dash', 'ksh') + tuple(WRAP)
DG, DGC = None, {}
def deg(b):   # a globbed verb is EVERY one of these it can match, and bash says which (dgask): `/usr/bin/p[^a]ill` is pkill
    global DG
    if not re.search(r'[\[?*{]', b): return [b]
    if b not in DGC:
        if DG is None:   # one bash for the whole command, started at the first globbed verb; no bash and python3 fails, so the caller reads the haystack
            env = {k: v for k, v in os.environ.items() if k not in ('BASH_ENV', 'ENV', 'SHELLOPTS', 'BASHOPTS', 'DGSRC') and not k.startswith('BASH_FUNC_')}
            DG = subprocess.Popen([os.environ['DGBASH'], '--norc', '--noprofile', '-c', os.environ['DGSRC'], 'dgask'] + list(GV),
                                  stdin=subprocess.PIPE, stdout=subprocess.PIPE, env=env)
        DG.stdin.write(b.encode('utf-8', 'surrogateescape') + b'\0'); DG.stdin.flush()
        o = b''
        while True:
            c = DG.stdout.read(1)
            if not c: raise OSError('dgask ended')
            if c == b'\0': break
            o += c
        DGC[b] = list(dict.fromkeys(n for n in o.decode('utf-8', 'surrogateescape').split('\x1f') if n)) or [b]
    return DGC[b]
def verbs(ws):   # past assignments and wrappers: (the verb, its args, whether xargs feeds it), once per name a glob in each can be
    out, seen, todo = [], set(), [(0, False)]
    while todo:
        i, fed = todo.pop()
        if (i, fed) in seen: continue                           # a position is read once, so `n* n* n*` costs no more than its words
        seen.add((i, fed))
        while i < len(ws) and re.match(r'^[A-Za-z_][A-Za-z0-9_]*=', ws[i]): i += 1
        if i >= len(ws): out.append(('', [], fed)); continue
        for b in deg(ws[i].rsplit('/', 1)[-1]):
            if b not in WRAP: out.append((b, ws[i+1:], fed)); continue
            j, f = i + 1, fed or b == 'xargs'
            while j < len(ws) and ws[j].startswith('-'): j += 2 if ws[j] in WRAP[b] else 1
            if b == 'timeout' and j < len(ws): j += 1          # its duration
            while b == 'env' and j < len(ws) and '=' in ws[j]: j += 1
            todo.append((j, f))
    return out
def emit(v, a, sink=None):
    s = US.join([v] + a) + (RS + US.join(sink) if sink else '')
    print(s.replace('\n', ' '))
cmds = []
try: parse(sys.argv[1], cmds)
except ValueError: sys.exit(1)       # an unclosed quote: the caller falls back to the haystack's words
j = 0
try:
  while j < len(cmds):
    ws, fedby, subs = cmds[j]; j += 1
    for v, a, fed in verbs(ws):
        if v in ('bash', 'sh', 'zsh', 'dash', 'ksh') and '-c' in a[:3]:
            k = a.index('-c')
            if k + 1 < len(a):
                try: parse(a[k+1], cmds)
                except ValueError: pass
            continue
        if v in ('pkill', 'killall'): emit(v, a)
        if v in ('kill', 'pkill', 'killall'):
            for s in list(subs) + ([fedby] if fed and fedby is not None else []):
                for fv, fa, _ in verbs(cmds[s][0]):
                    if fv in ('pgrep', 'pidof'): emit(fv, fa, [v] + a)
except (OSError, KeyError): sys.exit(1)   # dgask could not answer: the caller reads the haystack, which carries deglob's copies
PY
      fi
      uhay "$u"
    }
    uhits(){   # $1 = verb, $@ = its argv → the pids it would take now (pgrep with the same selectors)
      local v=$1 y first=1 spec pat; local -a q=(); shift
      # no skip for `$`: after shlex a quoted regex anchor looks like a variable, and an unset $X as a regex matches nothing anyway
      case "$v" in
        pkill|pgrep)
          while [ $# -gt 0 ]; do y=$1; shift
            if [ "$v" = pkill ] && [ -n "$first" ]; then first=""   # pkill's signal is its first word only
              case "$y" in -F|-G|-O|-P|-U) ;; -[0-9]*|-[A-Z]*) continue;; esac; fi
            case "$y" in
              --signal|-q|--queue) shift; continue;;
              --signal=*|--queue=*|-e|--echo|-c|--count|-l|--list-name|-a|--list-full|-q[0-9]*) continue;;
              -[aclfinovwx]*) [[ $y =~ ^-[aclfinovwx]+$ ]] && { y=${y//[acl]/}; [ "$y" = - ] && continue; };;
            esac
            q+=("$y")
          done
          [ ${#q[@]} -gt 0 ] || ukill "$v with nothing to match — that is every process this user owns"
          pgrep "${q[@]}" 2>/dev/null | tr -c '0-9\n' '\n';;
        killall|pidof)
          if [ "$v" = pidof ]; then for y in "$@"; do case "$y" in -*) ;; *) pgrep -x -- "$y" 2>/dev/null;; esac; done; return 0; fi
          spec=$(kpat killall "$@") || ukill "killall with a selector but no pattern — -u and the rest name a whole SET of processes, every session of this user's among them"
          pat=${spec#*$'\t'}
          case " $* " in *' -r '*|*' --regexp '*) pgrep -- "$pat" 2>/dev/null;; *) pgrep -x -- "$pat" 2>/dev/null;; esac;;
      esac
      return 0   # no match is rc 1 from pgrep, and rc 2 is ukill's alone
    }
    while IFS= read -r ul; do
      [ -n "$ul" ] || continue
      ukl=${ul%%$'\036'*}; usink=""; [ "$ukl" = "$ul" ] || usink=${ul#*$'\036'}
      IFS=$'\037' read -r -a uw <<<"$ukl"; uv=${uw[0]}; ua=("${uw[@]:1}")
      if [ -n "$usink" ]; then IFS=$'\037' read -r -a us <<<"$usink"; kprobe "${us[0]}" "${us[@]:1}" && continue
      else kprobe "$uv" "${ua[@]}" && continue; fi                 # signal 0 delivers nothing
      uname="$uv with a selector but no pattern: ${ua[*]}"; spec=$(kpat "$uv" "${ua[@]}" 2>/dev/null) && uname="$uv ${spec#*$'\t'}"
      uheld=""
      uh=$(uhits "$uv" "${ua[@]}") || exit 2   # a refusal inside the substitution has printed its line; it ends the hook here
      for x in $uh; do [ "$x" != $$ ] && usess "$x" && uheld="$uheld $x"; done
      read -r -a uhl <<<"$uheld"
      [ ${#uhl[@]} -gt 0 ] && ukill "a pattern kill that takes a session ($uname) — it matches ${#uhl[@]} session process(es) (pid ${uhl[*]:0:6}$([ ${#uhl[@]} -gt 6 ] && echo ' …')): a session, a loop runner or the tmux server"
    done < <(upat)
  fi
  # THE GITHUB ORGS THIS BOX MAY NOT TOUCH — the second universal gate, every session. The list is ~/.cc/github-deny
  # (one org per line, # comments; cc-github-deny has the shape and the git and gh layers that read the same file), and
  # the brief's line is "a session Bash line naming a denied org in a git, gh or GitHub-API command is refused by
  # cc-guard". Refused: a listed org in OWNER position — `github.com/<org>/`, `git@github.com:<org>/`, `orgs/<org>`,
  # `<org>/<repo>` — on a line that runs git, gh or reaches github (curl, python, anything); case-insensitive, because
  # GitHub is. `x/<org>` (a repo of that name under somebody else) and the word in prose on a line with no such
  # command pass. No list, or one this session cannot read, refuses nothing: the list is the whole of the rule.
  gdl=${CC_GITHUB_DENY:-$HOME/.cc/github-deny}
  if [ -r "$gdl" ] && grep -qiE '(^|[^A-Za-z0-9_.-])(gh|git)([^A-Za-z0-9_.-]|$)|github' <<<"$u"; then
    while IFS= read -r gdo; do
      gdo=${gdo%%#*}; gdo=${gdo//[[:space:]]/}; [ -n "$gdo" ] || continue; case $gdo in *[!A-Za-z0-9-]*) continue;; esac
      grep -qiE "(^|[^A-Za-z0-9_./-]|(^|[^A-Za-z0-9_.-])(orgs|users|repos)/|github(usercontent)?\.com[/:])$gdo(/|[^A-Za-z0-9_.-]|$)" <<<"$u" \
        && { echo "cc-guard: blocked — this touches '$gdo', a GitHub org this box may not ($gdl). Nothing on the box may reach it; ask nobody, do the rest." >&2; exit 2; }
    done < "$gdl"
  fi
fi
role="${CC_ROLE:-}"; mdir=""; mws=""; root=""; trepo=""; ttrack=""; kroot=""   # $root: the ONE tree this session writes (rule 5 below); $kroot: it came from a track marker (kill fence)
track_dir(){   # $1 holds a .cc/track marker: rc 0 = a real track worktree, and role/root/repo/track are set from its PATH
  # A TRACK WORKTREE LIVES UNDER ~/.cc/worktrees/<repo>/<track> — `cc` makes them nowhere else — and ONLY THERE does
  # .cc/track mean anything. Anywhere else it is a file somebody wrote, and the walk goes on past it to whatever
  # marker sits above: honouring one in ~/dev/<h>/sub set role=worker there and handed that member the worker
  # tier — the box's config and another repo's dispatch (review 2, C).
  # A TRACK OF A MEMBER WORKSPACE IS STILL THAT MEMBER'S WORLD. The worktree lives under ~/.cc/worktrees, so its
  # own marker says "worker" and would PROMOTE a member's worker out of the member tier — the one thing the
  # workspace rule below must not allow. The rule follows the repo, not the worktree.
  # WHICH repo comes from the worktree's PATH ($HOME/.cc/worktrees/<repo>/<track>), not from .cc/track: that
  # file is inside the tree the worker may edit, so its first line is a claim, not an identity.
  local r t
  case "$1" in "$HOME"/.cc/worktrees/*/*) r=${1#"$HOME"/.cc/worktrees/}; t=${r#*/}; t=${t%%/*}; r=${r%%/*};; *) return 1;; esac
  case "$r$t" in *[!A-Za-z0-9._-]*) r=""; t="";; esac
  root=$1; trepo=$r; ttrack=$t; kroot=1   # a track worktree is the one tree nobody else stands in: see kcwd
  if [ -n "$r" ] && [ -f "$HOME/dev/$r/.cc/member-workspace" ]; then role=member; mdir="$HOME/dev/$r"; mws="$r"
  else [ "$role" = member ] || role=worker; fi
}
mfroot(){ local f; for f in /var/lib/cc/member-facing ${CC_MF_ROOT:+"$CC_MF_ROOT"}; do   # root's record (cc-mf-record), which no session running as the owner can change; a test's CC_MF_ROOT only adds to it
  [ -e "$f/$1" ] || { { [ -e "$f" ] || [ -L "$f" ]; } && { [ -L "$f" ] || ! [ -d "$f" ] || ! [ -x "$f" ] || [ -w "$f" ]; }; } && return 0; done; return 1; }   # A link, a file, an unsearchable dir or one we can write is a replaced record: every repo reads as recorded
mfrec(){   # $1 is ~/dev/<repo> or a worktree ~/.cc/worktrees/<repo>/<track> the host records member-facing
  # (~/.cc/member-facing/<repo>, which a commit deleting the checkout's marker leaves standing); mfr=<repo>
  case "$1" in "$HOME"/dev/?*) mfr=${1#"$HOME"/dev/};; "$HOME"/.cc/worktrees/?*/?*) mfr=${1#"$HOME"/.cc/worktrees/}
    case "$mfr" in */*/*) return 1;; esac; mfr=${mfr%/*};; *) return 1;; esac
  case "$mfr" in */*|.|..) return 1;; esac   # a record dir it can't search reads as recorded (a chmod fails closed)
  [ -e "$HOME/.cc/member-facing/$mfr" ] || { [ -d "$HOME/.cc/member-facing" ] && ! [ -x "$HOME/.cc/member-facing" ]; } || mfroot "$mfr"; }
d="$cwd"                         # walk up for a marker — one stat per level, no config to parse. A marker only makes the
while [ -n "$d" ] && [ "$d" != / ]; do   # gates STRICTER (member wins over an inherited CC_ROLE=worker) and never clears the env role.
  if [ -f "$d/.cc/member-facing" ] || mfrec "$d"; then role=member; mdir="$d"; root="$d"   # or the host's record (mfrec)
    # A MEMBER WORKSPACE root: see below. Its handle is the DIRECTORY NAME — ~/dev/<handle>, nothing else — and
    # never the marker's contents: every file under this dir is the member's own to edit, so a handle read out of
    # one is a handle the session can rewrite (one line naming the box's repo would hand it that repo's authority).
    [ -f "$d/.cc/member-workspace" ] && [ "$d" = "$HOME/dev/${d##*/}" ] && mws=${d##*/}
    break; fi   # a session anybody in Slack can talk to
  if [ -f "$d/.cc/track" ] && track_dir "$d"; then break; fi
  d=$(dirname "$d"); done
# A WORKER THAT `cd`s OUT OF ITS WORKTREE walks past no marker at all, and was fenced by its cwd — by wherever it had
# just gone. The transcript path names the dir the session STARTED in (Claude Code slugs it: / and . become -), and
# that is the worktree whatever the cwd says now. Env-only role and no marker: match the slug against the worktrees.
if [ -z "$root" ] && [ "$role" = worker ]; then
  slug=$(jq -r '.transcript_path // ""' <<<"$inp"); slug=${slug%/*}; slug=${slug##*/}
  if [ -n "$slug" ]; then for w in "$HOME"/.cc/worktrees/*/*; do s=${w//\//-}; s=${s//./-}
    [ "$s" = "$slug" ] || continue; [ -f "$w/.cc/track" ] && track_dir "$w"; break; done; fi
fi
# A SUBAGENT SPAWNED WITH `isolation: worktree` STANDS IN A TREE OF ITS OWN, AND RULE 5 FOLLOWS IT THERE.
# The harness puts it in <checkout>/.claude/worktrees/agent-<id> and will accept no other cwd. That dir holds no
# marker, so the walk above fell through to the transcript slug — which names the dir the SESSION started in, the
# PARENT's worktree — and rule 5 then fenced the subagent to a tree the harness would not let it into: on
# 2026-09-15 two builders spawned that way came back read-only after a full pass each (~6 min, ~140k tokens) and
# the work was re-dispatched without isolation (row raised-isolation-worktree-writes-refused). The fence is not
# the parent's tree, it is the tree this call is STANDING in: $awt is added to $root rather than replacing it, so
# the subagent writes its own worktree and the parent still writes its own when it steps into one to collect the
# files. Nothing else moves — the rest of ~/dev/<repo>, ~/bin and ANOTHER agent's worktree keep their refusals,
# and a member session is untouched (its marker sets $root and $mdir above, and in_root already spans $mdir).
# AND THE DIRECTORY MUST REALLY BE A LINKED WORKTREE, not a path that looks like one. On a bare glob, anyone who
# could MAKE the path took the fence with it: `mkdir -p ~/dev/<repo>/.claude/worktrees/x` (mkdir is no verb of
# wscan's) and a `cd` there made in_root true for a plain subdir of the checkout, so `git -C .` reset, checkout
# or clean from that cwd rewrote ~/dev/<repo> itself — which wtgt had refused before this rule existed (review
# of #507). So git is asked, and only a linked worktree answers: its git dir is <common dir>/worktrees/<name>,
# while a mkdir'd subdir resolves to the checkout's own .git and a `git init` or a hand-written `.git` gives a
# git dir that is not under the common one at all. Anything else — including no git and no such dir — leaves
# $awt empty and rule 5 stands exactly where it did. A gated session cannot manufacture the yes either: `git
# worktree add` hands ~/dev/<repo> to wtgt, and writing the `.git` file by hand is the very write being decided.
# GIT_DIR and its two siblings are unset for the question — they are the caller's to set, and an exported one
# would otherwise answer it.
awt=""
case "$cwd" in */.claude/worktrees/*) awp=${cwd%%/.claude/worktrees/*}/.claude/worktrees/; awr=${cwd#"$awp"}; awt=$awp${awr%%/*};; esac
if [ -n "$awt" ]; then
  awg=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR git -C "$awt" rev-parse --path-format=absolute --git-dir --git-common-dir 2>/dev/null)
  awd=${awg%%$'\n'*}; awc=${awg##*$'\n'}   # line 1: this dir's own git dir; line 2: the common one it shares
  [ "$awd" != "$awc" ] && [ "${awd%/*}" = "$awc/worktrees" ] || awt=""
fi
case "$mws" in *[!a-z0-9-]*) mws="";; esac   # the handle goes into a regex below: [a-z0-9-] or nothing at all
# INSIDE A MEMBER BOUNDARY ($inb) — decided from what the boundary makes and the session cannot, as cc-sandbox's
# in_member does: CC_MEMBER_SANDBOX=1 in THIS hook's environment (inherited from the claude process the boundary
# launched, which no Bash call of the session reaches) AND a user namespace that is not the host's. Never from $mws:
# that comes from .cc/member-workspace, a file in the session's own tree (perms, #937: "Key both the guard deny and
# facing_fence on something the session cannot set").
inb=""; if [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; then read -r ua ub uc < /proc/self/uid_map 2>/dev/null \
  && [ "$ua $ub $uc" != "0 0 4294967295" ] && inb=1; fi
# $mdir is the member-facing session dir, and its basename is its Slack channel: the refusal below is posted there.
# An OVERLAPPING HANDOFF (cc-handoff): two sessions share this cwd, and exactly one of them is LIVE. The other
# may read, search, think and ask its peer — it may not act on the world. A marker file could not do this: the
# walk above is keyed on the cwd, which both sessions share, so it would gate the live one too. The keys here
# are per-session instead — the payload's session_id for the predecessor (already running when the overlap
# opened, so nothing could be put in its env) and $CC_HANDOFF for the successor (`cc __runnext` exports it;
# the hook is a child of the claude process, not of the Bash tool, so the model cannot unset it).
# SYMMETRIC ON PURPOSE: after cutover the PREDECESSOR is the non-live one, and a retired session that lingers
# must not push a stale branch. Every unreadable case falls the same way — the successor is gated, the
# predecessor is not — so a broken record can never leave the channel ownerless.
# WORK SCOPED BEFORE THE CUTOVER STILL PUSHES. A subagent's tool calls carry its parent's session_id and pane, so
# the predecessor's builders are gated with it — and on 2026-09-30 a builder that had finished and gated its fix
# was refused its push, the live successor's retry was denied as a bypass, and the fix sat uncommitted. The
# harness puts agent_id on a subagent's own calls (the model cannot set it), and `cc-handoff --ready` records in
# `scoped` every subagent of the predecessor's still out then (not yet reported, however quiet). A call whose
# agent_id is in `scoped` (or `held`) of EVERY record that gates it is $handoff_scoped: its `git push` passes;
# dispatch, cc done and cc-loop do not, and the worker gates below still apply. A subagent started after the cutover, a record with no list, or any
# other reason to gate (the successor's own $CC_HANDOFF) leaves the push refused as before.
handoff_gated=""; handoff_scoped=""; hplain=""
if [ -n "${CC_HANDOFF:-}" ] || [ -d "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}" ]; then
  sid=$(jq -r '.session_id // ""' <<<"$inp"); seen=""; wid=""
  aid=$(jq -r '.agent_id // ""' <<<"$inp"); case "$aid" in *[!A-Za-z0-9_-]*) aid="";; esac
  for rec in "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}"/*.json; do
    [ -f "$rec" ] || continue
    # the pane's window too: a planning predecessor's session_id is EMPTY on the record (unknown at --overlap time)
    [ -n "$wid" ] || [ -z "${TMUX_PANE:-}" ] || wid=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null || true)
    v=$(jq -r --arg sid "$sid" --arg wid "$wid" --arg hid "${CC_HANDOFF:-}" --arg aid "$aid" '
      if ((.id // "") == "" or (.target // "") == "") then "" else
        (if .live == "successor" then "successor" else "predecessor" end) as $l |
        (if $l == "successor" then "predecessor" else "successor" end) as $o |
        # scoped only on the PREDECESSOR side after cutover: the successor before it has no pre-cutover work. A list
        # that is not an array counts as absent, never as an error: an error here empties $v and lifts the whole gate
        ($aid != "" and $o == "predecessor" and ([.scoped, .held] | map(arrays) | add // [] | any(.[]; . == $aid))) as $sc |
        if ($hid != "" and .id == $hid) then (if $l == "successor" then "mine" else "mine gate" end)
        elif ($sid != "" and ((.[$o].session_id // "") == $sid)) then (if $sc then "gate-scoped" else "gate" end)
        elif ($wid != "" and ((.[$o].tmux // "") == $wid)) then (if $sc then "gate-scoped" else "gate" end)
        else "" end
      end' "$rec" 2>/dev/null) || v=""
    case " $v " in *" mine "*) seen=1;; esac
    case " $v " in *" gate "*) handoff_gated=1; hplain=1;; *" gate-scoped "*) handoff_gated=1;; esac
  done
  # $CC_HANDOFF with no record to justify it (missing, corrupt, unreadable) = the successor stays gated —
  # UNLESS the handoff FINISHED. `cc-handoff --retire` ends with clear(), so a record that is gone because
  # everything went RIGHT looks exactly like one lost because something went WRONG; retirement therefore
  # leaves a <id>.done marker first, and that marker is the whole difference. Without it the last step of a
  # handoff bricks the session that won it — 2026-08-31, the survivor lost dispatch, PRs and pushes for the
  # rest of its life, and could not even dispatch the fix for its own gate. Only ever WITHHOLDS the gate,
  # never lifts one: a session gated by the record of a LATER handoff stays gated by it.
  if [ -n "${CC_HANDOFF:-}" ] && [ -z "$seen" ]; then
    retired=""
    case "$CC_HANDOFF" in
      ""|*[!A-Za-z0-9_-]*) ;;   # not a record id, so never a path we build: a corrupt env gates like a corrupt record
      *) [ -f "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}/$CC_HANDOFF.done" ] && retired=1;;
    esac
    [ -n "$retired" ] || { handoff_gated=1; hplain=1; }
  fi
  [ -n "$handoff_gated" ] && [ -z "$hplain" ] && handoff_scoped=1
fi
[ -n "$handoff_gated" ] && [ "$role" != member ] && role=worker   # the four owner gates below, at least
# THE UNGATED TIER STILL MEETS ONE FENCE: the permission seat's state (pfence below). A planning session, an orch and
# every other session with no role go on past this line with $pfonly set, and every rule after it that is not that
# fence is skipped for them — Bash reaches the write walk alone, Edit/Write the one path check, and nothing else.
pfonly=""
case "$role" in worker|member) ;; *) pfonly=1;; esac
[ -n "$root" ] || root=$cwd   # nothing to anchor on (an env-only role, a handoff-gated session): the cwd, as before
# WHO IS ASKING cc-lib IS THE GUARD'S TO SAY (perms, #937, round 3). cc-lib shows the Slack copy only to a caller
# shown to be the owner, and it cannot tell that from its own process tree: a member-facing session can start a
# process named claude, with whatever env and cwd it likes, and cc-lib would read that one. This hook can: it is
# started by the session's real claude, so the nearest claude above IT is the session's, and nothing a Bash call
# does puts a process between the two. So before every Bash call the guard writes that claude's record,
# ~/.cc/library/owner/callers/<pid> = "<start time> owner" or "<start time> member <handle>", and cc-lib reads it
# for the claude it finds above itself: a stand-in claude with no hook of its own has no record, and a pid reused
# after its session ended has another start time, so either one sees no Slack. A claude that does run this hook is
# member if anything above it is (ccrec reads the whole chain, below), so one a member-facing session starts is
# recorded member however it was launched. Member is sticky: a member record is never rewritten as owner, so a
# session that `cd`s out of its marked dir does not become the owner on its next call. It runs before every Bash
# call, so it reads /proc with builtins and forks nothing per ancestor (it forked about six each, some 30 a call):
# one read of stat gives the start time and the parent, and the cwd is a `cd -P` (in the subshell it runs in), with
# readlink only where that cannot name the dir. A record is written once per claude, and each write removes the
# records of claudes that are gone or whose pid is now another process's: cc-lib reads neither, so nothing it
# answers changes, and the dir no longer grows by a file per pid for good. No
# session writes the record: ~/.cc/library/owner is on a member's secret list for Bash and the file tools (outside
# a boundary), and a worker's fence is its own tree. Inside a boundary nothing is written: cc-lib there reads the
# member's own workspace file and never the copy.
ccrec(){
  [ "$tool" = Bash ] && [ -z "$inb" ] || return 0
  local p="" n=0 home="" st="" w="" h="" d="$HOME/.cc/library/owner/callers" f="" lq="" e="" up="" ups="" c="" x=""
  local sx="" px="" ev=()
  # sx = pid $1's start time, px = its parent, from one read of its stat; both empty when it is gone
  pst(){ local y=""; sx="" px=""; read -r y 2>/dev/null < "/proc/$1/stat" || [ -n "$y" ] || return 0; y=${y##*") "}
    read -r _ px _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ sx _ <<<"$y"
    case "$sx" in ''|*[!0-9]*) sx="";; esac; case "$px" in ''|*[!0-9]*) px="";; esac; }
  # $HOME is the hook's, inherited from the session's claude at launch, which no Bash call reaches. cc-lib reads the
  # passwd home's (callers_dir), so a claude launched with another HOME (the selfcheck's) is recorded where cc-lib
  # never looks, and fails closed.
  if [ -n "${CC_GUARD_ROOT_PID:-}" ]; then
    home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
    [ -n "$home" ] && [ "$home" != "$HOME" ] && p=$CC_GUARD_ROOT_PID
  fi
  if [ -z "$p" ]; then p=$PPID
    while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
      c=""; read -r c 2>/dev/null < "/proc/$p/comm"; [ "$c" = claude ] && break
      pst "$p"; p=$px; n=$((n+1)); done
    c=""; read -r c 2>/dev/null < "/proc/${p:-0}/comm"; [ "$c" = claude ] || return 0
  fi
  pst "$p"; st=$sx; [ -n "$st" ] || return 0
  [ "$role" = member ] && h=${mdir##*/} && w=member
  # THE WHOLE CHAIN, NOT THE NEAREST CLAUDE (perms at d54b4814). A member-facing session picks the cwd and env of any
  # process it starts, a claude included, so that claude's own cwd and environ say nothing. What it cannot change is
  # what is ABOVE it: so every process from this claude up to init is read, and any one of them that is member-facing
  # (the guard's member record for it, its launch cwd under a member marker, CC_ROLE=member or CC_MEMBER_SANDBOX=1 in
  # its environ) makes this record member, with that one's channel.
  up=$p; n=0
  while [ -z "$w" ] && [ -n "$up" ] && [ "$up" != 0 ] && [ "$n" -lt 64 ]; do
    pst "$up"; ups=$sx; e=""; read -r e 2>/dev/null < "$d/$up"
    if [ -n "$ups" ] && [ "$up" != "$p" ]; then
      case "$e" in "$ups member"*) w=member; h=${e#"$ups member"}; h=${h# };; esac; fi
    # a cwd that is gone (or one cd cannot enter) leaves PWD on the /proc link itself: readlink still names it
    lq=""; if cd -P "/proc/$up/cwd" 2>/dev/null && case "$PWD" in /proc/*) false;; esac; then lq=$PWD
    else lq=$(readlink "/proc/$up/cwd" 2>/dev/null); fi
    while [ -z "$w" ] && [ -n "$lq" ] && [ "$lq" != / ]; do
      if [ -f "$lq/.cc/member-facing" ]; then w=member; h=${lq##*/}; elif mfrec "$lq"; then w=member; h=$mfr; fi
      case "$lq" in "$HOME"/.cc/worktrees/*/*) e=${lq#"$HOME"/.cc/worktrees/}; e=${e%%/*}
        [ -f "$HOME/dev/$e/.cc/member-workspace" ] && { w=member; h=$e; };; esac
      lq=${lq%/*}; done
    if [ -z "$w" ]; then ev=(); mapfile -d '' -t ev 2>/dev/null < "/proc/$up/environ"
      for x in "${ev[@]}"; do   # a whole line of it, as grep -x read it once tr had split the values on newlines too
        case $'\n'"$x"$'\n' in *$'\n'CC_ROLE=member$'\n'*|*$'\n'CC_MEMBER_SANDBOX=1$'\n'*) w=member; break;; esac; done; fi
    [ "$up" = 1 ] && break
    up=$px; n=$((n+1)); done
  f=$d/$p; e=$(cat "$f" 2>/dev/null)
  case "$e" in "$st member"*) return 0;; esac   # sticky: this claude was member-facing once, and stays so
  case "$h" in *[!A-Za-z0-9._-]*) h="";; esac
  if [ "$w" = member ]; then w="$st member${h:+ $h}"; else w="$st owner"; fi
  [ "$e" = "$w" ] && return 0
  ( umask 077; mkdir -p "$d" && printf '%s\n' "$w" > "$f.$$" && mv -f "$f.$$" "$f" ) 2>/dev/null || rm -f "$f.$$" 2>/dev/null
  for x in "$d"/*; do   # the records of claudes that are gone; a name that is not a bare pid (a write's temp) stays
    c=${x##*/}; case "$c" in ''|*[!0-9]*) continue;; esac
    e=""; read -r e 2>/dev/null < "$x"; pst "$c"
    [ -n "$sx" ] && [ "${e%% *}" = "$sx" ] || rm -f "$x" 2>/dev/null
  done
  return 0
}
( ccrec ) 2>/dev/null || :   # a subshell: whatever goes wrong in it, the record is missing (cc-lib fails closed) and no gate is lost
in_root(){ case "$1" in "$root"|"$root"/*) return 0;; esac; [ -n "$mdir" ] && case "$1" in "$mdir"|"$mdir"/*) return 0;; esac
  [ -n "$awt" ] && case "$1" in "$awt"|"$awt"/*) return 0;; esac; return 1; }   # $awt: the agent worktree this call stands in — see above
# THE TWO FENCES USED TO BE IMPOSSIBLE TOGETHER, AND THE ANSWER WAS TO REFUSE THE SPAWN. It is now to move the
# fence: $awt above makes rule 5 follow the subagent into <checkout>/.claude/worktrees/agent-<id>, so `isolation:
# worktree` spawns, writes and is still fenced — to ITS OWN tree, not to the whole checkout around it. The earlier
# reading (that allowing the write "opens the one fence rule 5 exists for") was wrong about the SIZE of the
# opening: what opens is one ephemeral worktree the harness just made for this session's own subagent, not
# ~/dev/<repo>. Its branch is still cut from the checkout's HEAD rather than the session's, and nothing in `cc`
# lands a tree under ~/dev/<repo>/.claude — so the PARENT collects the files and commits them in its own
# worktree, which is what a subagent's work has always needed (WORKING.md: "you commit and land what it wrote").
# A MEMBER REFUSAL IS A QUERY TO THE BOX, NOT A LINE IN THE MEMBER'S CHANNEL. Until now a member-facing deny put a
# 🔐 line in the member's own channel (which the members read) and DM'd the owner. The owner's call (2026-09-04): a
# member session "should have enough permissions to do stuff. These errors should just be routed to you instead" —
# to the box's queries session, in a queries channel (owner + box only), which approves it, answers it, or turns it
# into a board row / message for the planning session; the owner hears only what that session cannot settle.
# So a member refusal RECORDS a query and does nothing else here: nothing in the member's channel, no page to the
# owner. The record is a line in ~/.cc/state/<workspace>/queries.spool — a member sandbox has no tmux and no owner
# socket, but it CAN write its own state dir (the sandbox binds it rw), and the host drains that spool (cc-msg
# --drain): one line into the queries channel, and the query delivered to the queries session — the planning
# session when no queries session is up. core/ never names the channel or the session: those are cc-config keys the
# box sets, so nothing here is this box's identity. WORKER AND HANDOFF DENIALS ARE UNTOUCHED — they have a board, a
# journal and a STATUS: BLOCKED line — and so are the owner's own channels. The member session still gets its stderr.
# TWO CLASSES, KEPT IN THE RECORD. `deny` = the owner could say yes (merging, pushing, a comment in his name): class
# "page". `never` = no yes exists for this tier (landing, dispatching, host changes): class "nopage" — the queries
# session still sees it (a guard rule that should have allowed it is a patch for the planning session, not an
# approval) but knows not to ask for a yes that cannot exist. `never` with a SECOND arg records NOTHING: a write the
# session aimed outside its own tree is its own to fix from the stderr line, not a question for anyone (2026-09-04).
# Bounded: nothing runs unless role=member, and one query per workspace+reason per ASK_TTL, so a session retrying a
# blocked command does not fill the spool. A path in the reason is dropped from that key (a list of files refused by
# one rule is one query); the record keeps the reason and the command, each cut to 2 KB.
ASKS="${CC_GUARD_ASKS:-$HOME/.cc/guard-asks}"; ASK_TTL="${CC_GUARD_ASK_TTL:-1800}"
record_query(){   # $1 = reason (why); $2 nonempty = class "page" (owner could approve), empty = "nopage"
  local why=$1 page=${2-1} qkey key was now sp lock rec class qc wr   # ${2-1}, never ${2:-1}: `never` passes an EMPTY page
  # A SESSION GATED BY $CC_ROLE ALONE HAS NO WORKSPACE TO NAME, AND ITS REFUSAL IS STILL A QUERY. Returning here
  # left it with no record, no channel line and no page — the refusal reached nobody but the session's own stderr,
  # which is the one thing this file says must not happen (landing review of #243). So it spools under a RESERVED
  # workspace name instead: the host drains "_nomarker" like any other, the queries session sees it said in the
  # channel (or the owner is paged, on a box with no channel set), and the name itself says why it has no handle.
  qkey=${mws:-${mdir##*/}}; [ -n "$qkey" ] || qkey=_nomarker
  class=$([ -n "$page" ] && echo page || echo nopage)
  # ONE QUERY PER WORKSPACE+REASON PER TTL. The key drops a path in parentheses only — "(/…)"/"(~/…)" — so a rule
  # refusing a list of files is one query; "(cc --go)" and "(cc-loop)" stay two. The record itself keeps the path.
  now=$(date +%s); key=$(printf '%s\n%s' "$qkey" "$(sed -E 's# \([~/][^)]*\)##g' <<<"$why")" | cksum | tr -cd '0-9')
  mkdir -p "$ASKS" 2>/dev/null || return 0
  if [ -f "$ASKS/$key" ]; then was=$(cat "$ASKS/$key" 2>/dev/null) || was=0; case "$was" in ''|*[!0-9]*) was=0;; esac
    [ $((now - was)) -lt "$ASK_TTL" ] && return 0; fi   # already recorded, and the box has not had time to answer
  printf '%s\n' "$now" > "$ASKS/$key"
  sp="$HOME/.cc/state/$qkey/queries.spool"; mkdir -p "$(dirname "$sp")" 2>/dev/null || return 0
  # CUT BEFORE THE LINE IS BUILT. cc-msg discards a whole queries.spool over 1 MB as a plant and pages the owner
  # about it, so one refused command with a big heredoc body would take every query queued in that file down with
  # it (landing review of #243). cc-msg already cuts to 200/300 when it reads, so nothing downstream changes; the
  # marker is there so the queries session knows it is not looking at the whole command.
  qc=$qcmd; wr=$why
  [ "${#qc}" -gt 2000 ] && qc="${qc:0:2000} …(cut)"
  [ "${#wr}" -gt 2000 ] && wr="${wr:0:2000} …(cut)"
  rec=$(jq -cn --arg at "$(date -u +%FT%TZ)" --arg ws "$qkey" --arg class "$class" --arg reason "$wr" --arg cmd "$qc" \
        '{at:$at,workspace:$ws,class:$class,reason:$reason,command:$cmd}' 2>/dev/null) || return 0
  lock="$HOME/.cc/state/$qkey/.queries.lock"
  ( flock -w 5 9 || exit 0; printf '%s\n' "$rec" >> "$sp" ) 9>"$lock" 2>/dev/null || true
  return 0
}
# ---- the failure ledger: a refusal that fell on WORDS is recorded where it happened -----------------------
# docs/design-failure-noticing-2026-09-11.md, The writers: "cc-guard (a refusal that cost a turn)" — and the brief's
# own line, "a correct refusal is not a failure, one that cost a turn on permitted text is". The rules read the
# haystack, which keeps whatever the shell COULD still run: the first word of a quoted run, a bare heredoc's
# expanding lines, every suffix past a head this does not know — each a false positive chosen over a bypass. So a
# rule that refused is read ONCE MORE against a BARE view of the same command (bare below): heredoc bodies out
# entirely, comments out, every quoted run blanked — unless a string-runner ($Q) or an executor ($X) stands on that
# line, when the quoted text is what runs and it stays — and then through cmdpos, so a wrapper hides nothing here
# either. A rule that still matches refused a COMMAND, which is the gate doing its job, and nothing is written. One
# that no longer matches refused WORDS: that is the family the catalogue calls guard-policy/permitted-text-refused,
# and the record carries the rule's reason and the command's SHAPE — its first words off the bare view, so no
# message, no pattern and no body ever reaches the ledger. Only a rule that reads text sets $RX (rx/rxn); the kill
# fence and the write-path rules judge a pid or a path, never words, so they leave it empty and record nothing.
# ONE record per scope+reason+shape per ASK_TTL, keyed beside the queries: a session retrying the same refused line
# lost one turn, not five. THE VERDICT IS DECIDED BEFORE THIS RUNS AND NOTHING HERE CAN TOUCH IT: the writer is
# bounded (timeout $CC_GUARD_RECORD_TIMEOUT, 5 s live), its exit and output are dropped, and a ledger that cannot be written changes not one byte of
# the refusal — case 50b runs the same refusal with a writer that fails and asserts the rc and the stderr line.
RX=""
rx(){ grep -qE -- "$1" <<<"$cmd" && RX=$1; }      # a text rule: the pattern that matched is kept for note_refusal
rxn(){ grep -qE -- "$1" <<<"$cmdn" && RX=$1; }    # …the same, on the blank-squeezed line the two Slack doors read
bare(){   # $1 = the command as typed → its bare view (above). One awk, quote-aware across lines; no apostrophe in it.
  awk -v X="$X" -v Q="$Q" '
    BEGIN { SQ = sprintf("%c", 39) }
    { L[NR] = $0 }
    END {
      q = ""; body = ""; bq = 0
      for (i = 1; i <= NR; i++) { s = L[i]
        if (body != "") {   # a dropped heredoc body — but a BARE delimiter expands, and what the shell runs in such
          if (s ~ ("^[ \t]*" body "[ \t]*$")) body = ""     # a line is the interior of its $( ) and backticks (hay: subs)
          else if (!bq) { o = ""; while (match(s, /\$\([^)]*\)|`[^`]*`/)) { o = o " " substr(s, RSTART + 2 - (substr(s, RSTART, 1) == "`"), RLENGTH - 3 + (substr(s, RSTART, 1) == "`")); s = substr(s, RSTART + RLENGTH) }; print o }
          continue }
        keep = (s ~ Q); o = ""; n = length(s); hd = 0
        for (j = 1; j <= n; j++) { c = substr(s, j, 1)
          if (q != "") { if (q == "\"" && c == "\\") { j++; if (keep) o = o c substr(s, j, 1); continue }
                         if (c == q) { q = ""; o = o " "; continue }
                         if (keep) o = o c; continue }
          if (c == "\\") { j++; o = o c substr(s, j, 1); continue }
          if (c == "\"" || c == SQ) { q = c; o = o " "; continue }
          if (c == "#" && (j == 1 || index(" \t;&|(", substr(s, j - 1, 1)) > 0)) break
          if (!hd && c == "<" && substr(s, j + 1, 1) == "<" && substr(s, j + 2, 1) != "<" && substr(s, j - 1, 1) != "<") hd = j
          o = o c }
        if (hd && s !~ X) {   # a heredoc opened outside quotes and nothing on the line runs its body: drop it, if it closes
          w = substr(s, hd + 2); sub(/^-?[ \t]*/, "", w); bq = 0
          if (substr(w, 1, 1) == "\"" || substr(w, 1, 1) == SQ) { w = substr(w, 2); bq = 1 }
          match(w, /^[A-Za-z_][A-Za-z0-9_]*/); w = (RLENGTH > 0) ? substr(w, RSTART, RLENGTH) : ""
          for (k = i + 1; w != "" && k <= NR; k++) if (L[k] ~ ("^[ \t]*" w "[ \t]*$")) { body = w; break } }
        print o } }' <<<"$1"
}
note_refusal(){   # $1 = the reason; writes guard-policy/permitted-text-refused when the rule that refused fell on words
  local why=$1 rxp=$RX bv shape scope key now was fl
  RX=""
  [ -n "$rxp" ] && [ "$tool" = Bash ] || return 0            # a judgement rule, or not a command: nothing to re-read
  bv=$(cmdpos "$(bare "$qcmd")"); bv=${bv//$'\001'/}
  grep -qE -- "$rxp" <<<"$bv" && return 0                    # the rule matches the command itself: a correct refusal
  shape=$(bare "$qcmd" | awk 'NF { for (i = 1; i <= NF && i <= 4; i++) printf "%s%s", (i > 1 ? " " : ""), $i; if (NF > 4) printf " …"; exit }')
  scope=${trepo:-${mws:-${mdir##*/}}}; [ -n "$scope" ] || scope=_nomarker   # the same name the queries spool under
  now=$(date +%s); key=f$(printf '%s\n%s\n%s' "$scope" "$shape" "$(sed -E 's# \([~/][^)]*\)##g' <<<"$why")" | cksum | tr -cd '0-9')
  mkdir -p "$ASKS" 2>/dev/null || return 0
  if [ -f "$ASKS/$key" ]; then was=$(cat "$ASKS/$key" 2>/dev/null) || was=0; case "$was" in ''|*[!0-9]*) was=0;; esac
    [ $((now - was)) -lt "$ASK_TTL" ] && return 0; fi       # the same line, retried: one turn lost, recorded once
  printf '%s\n' "$now" > "$ASKS/$key"
  fl=$HOME/bin/cc-failures; [ -x "$fl" ] || fl=$(command -v cc-failures 2>/dev/null) || return 0
  timeout "${CC_GUARD_RECORD_TIMEOUT:-5}" "$fl" record --scope "$scope" --kind guard-policy/permitted-text-refused --writer cc-guard \
    --detector box --detector-evidence "the rule matched the haystack and not the bare view of the command" \
    --expected "the guard judges the command, and permits what the policy permits" \
    --observed "refused \`$shape\` as $why: the rule matched only words in quoted text or a heredoc body, and the turn was lost" \
    --evidence "shape=$shape" --evidence "rule=$why" --evidence "role=${role:-}" --cost turns=1 \
    --link "source=cc-guard:$key" </dev/null >/dev/null 2>&1 || true
  return 0
}
# THE LINE SAYS WHICH WORDS FIRED. A refusal named only its rule, so a session refused for prose had to guess which
# word of a long command the rule had read, and five rows in one week were each a turn or three of guessing. A text
# rule (rx, rxn) leaves its pattern in RX, read here before note_refusal clears it; fired() prints the first stretch
# of the command that pattern matched, cut to 80 characters, at the END of the line so no reason a reader or a test
# greps for moves, and nothing when the rule was not a text one (a path rule names its path in the reason itself).
fired(){
  [ -n "$RX" ] || return 0
  local m; m=$( { grep -oE -m1 -- "$RX" <<<"${cmd-}"; grep -oE -m1 -- "$RX" <<<"${cmdn-}"; } 2>/dev/null | head -1)
  m=$(tr -d '\001' <<<"$m" | tr -s ' \t' '  ' | sed -E 's/^[][;&|(){}`$ ]+//; s/ +$//'); m=${m:0:80}   # the separator that put it at ^ is not a word
  [ -n "$m" ] && printf ' It fired on: %s' "$m"; return 0; }
deny(){
  local f; f=$(fired); note_refusal "$1"   # fired first: note_refusal clears RX
  if [ "$role" = member ]; then record_query "$1" 1
    echo "cc-guard: blocked — $1. A query about this has gone to the box; it will approve it or take it onward. Do anything that needs no approval and say what you are waiting on.$f" >&2
  else echo "cc-guard: blocked — $1 (needs the owner; ask via cc-notify or note it on the board)$f" >&2; fi
  exit 2; }
# "never for this tier": no yes exists FOR this session, so the query is nopage — the queries session is still told.
# A SECOND ARG = record nothing: a write the session aimed outside its own tree is its own to fix from the stderr
# line, not a question for anyone, and three note files refused in one call put six lines in a channel (2026-09-04).
never(){
  local f; f=$(fired); note_refusal "$1"
  if [ "$role" = member ] && [ -z "${2-}" ]; then record_query "$1" ""
    echo "cc-guard: blocked — $1. This is not this session's to run; the box has been told, so nothing here waits on it. Do the rest.$f" >&2
  else echo "cc-guard: blocked — $1. This is not this session's to run and not the owner's to approve for it — nobody is being asked, so do not wait on an answer.$f" >&2; fi
  exit 2; }
denyh(){ local f; f=$(fired); note_refusal "$1"; echo "cc-guard: blocked — $1. This session is the NON-LIVE side of an overlapping handoff: read, search, think and ask your peer, but do not act on the world — and never ask the live session to run what you are denied.$f" >&2; exit 2; }
# A --go IN A BOARD ROW'S TEXT IS NOT A DISPATCH (raised-the-guard-reads-go-inside-a-quoted-brief). The dispatch rules
# read `cc +[^;&|]*--go` with the quotes off, so `cc board add <ws> <row> "t" "… it tried cc --go"` was refused: the
# match ran from the head `cc` into the brief. `cc board` and `cc quick` never dispatch and never run an argument, so a
# command made only of those statements (and a head or tail on a pipe) passes those rules. Anything read here in a way
# the shell might not falls back to the refusal: a backslash, a substitution or expansion, ANSI-C or locale quoting, a
# heredoc, an unquoted #, an unclosed quote, and any other statement head — a wrapper, an assignment, a function.
board_only(){   # $1 = the command as typed. No apostrophe inside the awk: it is one single-quoted bash string.
  awk '
    BEGIN { SQ = sprintf("%c", 39) }
    { s = s (NR > 1 ? "\n" : "") $0 }
    function word() { if (cur != "") w[++nw] = cur; cur = "" }
    function stmt() {   # a statement ended: its first two words, as typed, decide it
      if (nw == 0) return
      if (w[1] == "cc" && (w[2] == "board" || w[2] == "quick")) ok = 1
      else if (w[1] != "head" && w[1] != "tail") exit 1
      nw = 0; delete w }
    END {
      n = length(s); q = ""; cur = ""; nw = 0; ok = 0
      for (i = 1; i <= n; i++) { c = substr(s, i, 1); d = substr(s, i + 1, 1)
        if (q == SQ) { if (c == SQ) q = ""; cur = cur c; continue }
        if (c == "\\" || c == "`") exit 1
        if (c == "$" && d != "" && index("({[\"" SQ, d)) exit 1
        if (q != "") { if (c == q) q = ""; cur = cur c; continue }
        if (c == "#" || (c == "<" && d == "<")) exit 1
        if (c == "\"" || c == SQ) { q = c; cur = cur c; continue }
        if (c == "&" && (d == ">" || (i > 1 && index("<>", substr(s, i - 1, 1))))) { cur = cur c; continue }   # 2>&1, &>f
        if (c == " " || c == "\t") { word(); continue }
        if (index(";&|(){}\n", c)) { word(); stmt(); continue }
        cur = cur c }
      if (q != "") exit 1
      word(); stmt()
      exit !ok }' <<<"$1"
}
# QUOTED TEXT THAT IS ONLY DATA IS NOT A COMMAND (guard-false-refusal-exemptions; replay rows "hard limit: data, not
# words", "ordinary work", "port C near-miss", raised-guard-reads-go-in-ask-text-as-dispatch). The haystack flattens a
# quoted string to its words, which is right for `bash -c '…'` and wrong for a commit message that says "never git push
# --force": the text rules read the message as the push. dataonly() says the command AS TYPED ($1, the raw line) is one
# statement of a shape whose quoted strings nothing runs, and only then are those strings blanked for the gated text
# rules (cc-guard-argv judged the real argv already). One line, nothing else in it, no `$`, backtick, `\` or `!` inside
# a double-quoted string, and:
#   echo|printf [-n|-e|-E] <words and quoted strings> [> or >> a relative path with no `..`]
#   git commit [-a|-s|-q|-v|-n|--no-verify|--allow-empty|--all|--signoff|--quiet]… -m <one quoted string> [the same]
#   cc-notify <one quoted string>              (no option: --run would make the text a command)
#   cc slack ask <one quoted string>
#   grep [-cHhilLnoqrRsvwxEFI]… <one quoted pattern> <plain relative paths>… [| head [-n] N]
#      (no -f/-e, which take a file or a pattern; a quoted or ~ or / path stays judged, so `grep x 'ccbox/env'` refuses)
dataonly(){
  local q1="'[^']*'" q2='"[^"$`\\!]*"' w='[A-Za-z0-9_.,:=%+@^-]+' p='[A-Za-z0-9_][A-Za-z0-9_./-]*'
  local qs="($q1|$q2)"
  [[ $1 != *$'\n'* ]] || return 1
  if [[ $1 =~ ^\ *(echo|printf)(\ +-[neE]+)?(\ +($q1|$q2|$w))+(\ *\>\>?\ *($p))?\ *$ ]]; then [[ ${BASH_REMATCH[6]} != *..* ]]; return; fi
  local go='(\ +(-[asqvn]+|--no-verify|--allow-empty|--all|--signoff|--quiet))*'
  [[ $1 =~ ^\ *git\ +commit${go}\ +-m\ *$qs${go}\ *$ ]] && return 0
  [[ $1 =~ ^\ *cc-notify\ +$qs\ *$ ]] && return 0
  [[ $1 =~ ^\ *cc\ +slack\ +ask\ +$qs\ *$ ]] && return 0
  [[ $1 =~ ^\ *grep(\ +-[cHhilLnoqrRsvwxEFI]+)*\ +$qs(\ +$p)+(\ *\|\ *head(\ +-n)?(\ +-?[0-9]+)?)?\ *$ ]] && [[ $1 != *\ ..* && $1 != */..* ]] && return 0
  return 1; }
# TWO lists. secret_all() is the credentials NO gated role reads: ~/.claude/.credentials.json is the box's Claude
# account and its spend, ~/ccbox/env is a GitHub PAT plus a deploy token — a worker holding either can spend or
# push as the box, and a worker is exactly the session nobody is watching. secret_path() adds the box's OTHER
# secrets, which stay member-only, unchanged.
# ~/ccbox is a SYMLINK into the repo (core/ccbox) and $fp arrives here already realpath'd, so matching the literal
# path alone missed every real read of it — the Read tool still served the file with the rule in place. The case is
# the cheap path (no fork for an ordinary file); only a name that could BE one of them is worth resolving.
# ONE LOGIN PER HARNESS (docs any-harness, phase 0): whichever harness a worker runs on, the other harnesses' logins are
# the box's accounts too — Claude Code's .credentials.json, Codex's auth.json, the Cursor CLI's auth.json. The worker
# fence leaves all of them out of its world; this is the same list for a session the fence does not wrap.
secret_all(){
  case "$1" in
    "$HOME"/.claude/.credentials.json|"$HOME"/ccbox/env|"$HOME"/.codex/auth.json|"$HOME"/.config/cursor/auth.json) return 0;;
    */.credentials.json|*/ccbox/env|*/auth.json) ;;
    *) return 1;;
  esac
  local f
  for f in "$HOME/.claude/.credentials.json" "$HOME/ccbox/env" "$HOME/.codex/auth.json" "$HOME/.config/cursor/auth.json"; do
    [ "$1" = "$(realpath -m -- "$f" 2>/dev/null)" ] && return 0
  done
  return 1
}
# ~/.cc/sandbox is judged as WHAT IT IS A COPY OF. cc-sandbox writes the sealed-session settings there
# (<repo|handle>/<track|_workspace>/settings.json) and that file is ~/.claude/settings.json plus a permission
# baseline — the same hook registrations and the same deny rules — so a session that may not read the original may
# not read the copy either. Same tier as the original, not a stricter one: the whole subtree, because a copy that
# is a secret under one name is a secret under any name a future launch gives it.
# THE SLACK COPY AND THE OWNER'S INDEX ARE NOT A MEMBER-FACING SESSION'S. ~/.cc/slack holds both sides of every
# chat (the owner's DMs with the box, every member's channels) and ~/.cc/library/owner indexes them, and a
# member-facing session on the host has no boundary in front of either, workspace marker or not. So outside a
# boundary ($inb) both are on its list. Inside one ~/.cc/slack IS its own member/<h> tree (its attachments under
# files/) and the owner's index is not there at all (cc-sandbox), so nothing is refused there.
secret_path(){ secret_all "$1" && return 0; case "$1" in "$HOME"/.cc/config|"$HOME"/.ssh|"$HOME"/.ssh/*|"$HOME"/.claude/settings.json|"$HOME"/.cc/sandbox|"$HOME"/.cc/sandbox/*) return 0;; esac
  [ -z "$inb" ] && case "$1" in "$HOME"/.cc/slack|"$HOME"/.cc/slack/*|"$HOME"/.cc/library/owner|"$HOME"/.cc/library/owner/*) return 0;; esac; return 1; }
# A SEARCH WALKS EVERYTHING UNDER ITS PATH, so a member's Grep or Glob on ~/.cc or ~ read the Slack copy while
# secret_path saw only a dir that is no secret itself (perms' read of #1642). This says whether any path on
# secret_path's list sits under $1; the list is realpath'd as secret_all's is, since ~/ccbox is a symlink.
secret_below(){ local d l=("$HOME"/.claude/.credentials.json "$HOME"/ccbox/env "$HOME"/.codex/auth.json
    "$HOME"/.config/cursor/auth.json "$HOME"/.cc/config "$HOME"/.ssh "$HOME"/.claude/settings.json "$HOME"/.cc/sandbox)
  [ -z "$inb" ] && l+=("$HOME"/.cc/slack "$HOME"/.cc/library/owner)
  while IFS= read -r d; do case "$d" in "${1%/}"/*) return 0;; esac   # ${1%/}: a search of / is above everything
  done < <(realpath -m -- "${l[@]}" 2>/dev/null)
  return 1; }
# THE PERMISSION SEAT'S STATE IS WRITTEN BY THAT SEAT ALONE, AT EVERY TIER — the planning session included. The seat
# is the one session the box runs with --dangerously-skip-permissions, in ~/.cc/state/<repo>/perms (brief.md,
# ledger.md, session-id, handoff.md — the journal `cc-perms handoff` starts its successor from — and .claude/), and
# the owner relaunches it on that same brief.md (cc-handoff refuses to hand it off; the
# handoff dir's perms.json and perms.brief stay fenced too, so none can be planted for a later reader). So whoever
# writes one of those files chooses what the next permission-skipping session does. Reading them is anybody's.
# WHO THE SEAT IS COMES FROM THE PROCESS, never from anything a model can type: the nearest `claude` above this hook,
# its own argv carrying --dangerously-skip-permissions, and no second `claude` above it — a session that launches a
# child claude with the flag (the one way a gated tier could forge the yes) has its own claude over the child.
# EVERY SEAT'S LAUNCH SCRIPT SITS IN THE SAME FENCE: ~/.cc/state/hs/launch holds <target>.sh/.argv/.env/.cwd/.pass,
# and the next perms seat (or any seat) is started from that script, unsandboxed, so whoever rewrites it chooses
# what that session runs. ~/.cc/state/hs/launch[/…] and hs/clone.json are fenced, and so is ~/.cc/state/hs itself
# as a target (a symlink planted there would redirect the launch dir); the rest of hs is not (perms, over-blocking). Its writer is hs-clone (~/dev/handoff/bin, outside this repo), which the hs session
# RUNS: `hs-clone capture|launch <target>` names no path here, so it passes, and its Python open() calls are inside
# that process, where no hook sees them. A redirect, cp or Write into the dir is refused; the seat's own, as above.
# $CC_GUARD_ROOT_PID is the test hook, as for the kill fence, and here it is honoured only in a HOME that is not the
# account's own: the selfcheck runs in a fixture HOME, and a session that starts a child with a fake HOME has already
# left every path fence in this file (they are all spelled from $HOME) and holds no credentials to run it with.
psk=""; psd=""
pseat(){   # rc 0 = this call comes from the permission seat
  [ -n "$psk" ] && { [ "$psk" = 1 ]; return; }
  local p="" n=0 home
  psk=0
  if [ -n "${CC_GUARD_ROOT_PID:-}" ]; then
    home=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
    [ -n "$home" ] && [ "$home" != "$HOME" ] && p=$CC_GUARD_ROOT_PID
  fi
  if [ -z "$p" ]; then p=$PPID
    while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
      [ "$(cat "/proc/$p/comm" 2>/dev/null)" = claude ] && break
      p=$(kppid "$p"); n=$((n+1)); done
    [ "$(cat "/proc/${p:-0}/comm" 2>/dev/null)" = claude ] || return 1
  fi
  tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | grep -qxF -- --dangerously-skip-permissions || return 1
  # …and it runs IN the seat's directory: a flagged claude started anywhere
  # else is not the seat, however it was launched (security re-review: `setsid -f claude --dangerously-…` passed).
  local d; d=$(readlink "/proc/$p/cwd" 2>/dev/null)
  case "$d" in "$HOME"/.cc/state/?*/perms) case "${d#"$HOME"/.cc/state/}" in */*/*) return 1;; esac;; *) return 1;; esac
  psd=$d   # the seat's own dir, from its process: linput keys its memory on this, which a `cd` in a call cannot move
  n=0; local q; q=$(kppid "$p")
  while [ -n "$q" ] && [ "$q" != 0 ] && [ "$q" != 1 ] && [ "$n" -lt 64 ]; do
    [ "$(cat "/proc/$q/comm" 2>/dev/null)" = claude ] && return 1
    q=$(kppid "$q"); n=$((n+1)); done
  psk=1; return 0; }
# THE FILES A FRESH SEAT LOADS FROM ABOVE ITS DIRECTORY ARE ITS STATE TOO (security reads of PR #940). Claude Code
# reads CLAUDE.md and CLAUDE.local.md (and .claude/) in every directory above the one it starts in, and the seat
# starts in ~/.cc/state/<repo>/perms, so ~/.cc/state/<repo>, ~/.cc/state and ~/.cc (0775, any unsandboxed worker's
# to write) would hand that worker the next permission-skipping session's instructions. Those names, and
# ~/CLAUDE.local.md, are fenced with the seat's own files at every tier, and `cc-perms` refuses to start a seat while
# any such file sits above it (the one it allows is ~/CLAUDE.md as a link into ~/dev/<repo>).
# THE SEAT'S TRANSCRIPTS AND MEMORY (~/.claude/projects/<its directory, dashed>) ARE ITS STATE as well: a fresh seat
# loads that MEMORY.md, and a relaunch resumes a transcript there. pseatslug matches the slug of any ~/.cc/state/*/perms.
pseatslug(){ local h; h=$(sed 's/[^A-Za-z0-9]/-/g' <<<"$HOME"); case "$1" in "$h"--cc-state-?*-perms) return 0;; esac; return 1; }
# THE FILES EVERY CLAUDE STARTS FROM ARE THE SEAT'S STATE AS WELL (security reads of PR #940, round 3). The seat runs
# with permissions skipped, and a relaunch loads ~/.claude's CLAUDE.md, CLAUDE.local.md, rules, agents, skills, commands,
# output-styles, plugins and settings, ~/.claude.json (group-writable) and the claude binary that ~/.local/bin/claude
# points into ~/.local/share/claude. A worker or member that wrote any of them wrote the next bypass session's
# instructions or code, so they are fenced at every tier with the seat's own files, and only the live seat writes them.
# ~/.claude itself and ~/.local/bin are fenced as a TARGET (`cp x ~/.claude/`); ~/.claude/projects is not, so every
# other seat's notes stay its own to write.
pboot(){   # rc 0 = the absolute, resolved path $1 is one of the files every claude starts from (above)
  case "$1" in "$HOME"/.claude|"$HOME"/.claude.json|"$HOME"/.local/bin|"$HOME"/.local/bin/claude|"$HOME"/.local/share/claude|"$HOME"/.local/share/claude/*) return 0;; esac
  case "$1" in "$HOME"/.claude/?*) local r=${1#"$HOME"/.claude/}
    case "${r%%/*}" in CLAUDE.md|CLAUDE.local.md|rules|agents|skills|commands|output-styles|plugins|settings.json|settings.local.json) return 0;; esac;; esac
  return 1; }
pboots=("$HOME"/.claude/CLAUDE.md "$HOME"/.claude/CLAUDE.local.md "$HOME"/.claude/rules "$HOME"/.claude/agents "$HOME"/.claude/skills
  "$HOME"/.claude/commands "$HOME"/.claude/output-styles "$HOME"/.claude/plugins "$HOME"/.claude/settings.json "$HOME"/.claude/settings.local.json
  "$HOME"/.claude.json "$HOME"/.local/bin/claude "$HOME"/.local/share/claude)   # what a glob or an rm of a directory above can reach
pstate(){   # rc 0 = the absolute, resolved path $1 is the seat's state: ~/.cc/state/<one name>/perms[/…], its handoff files, the startup files above it, its transcripts, or the seats' launch scripts (~/.cc/state/hs, hs/launch[/…], hs/clone.json)
  local r
  case "$1" in "$HOME"/.cc/state/hs|"$HOME"/.cc/state/hs/launch|"$HOME"/.cc/state/hs/launch/*|"$HOME"/.cc/state/hs/clone.json) return 0;; esac
  case "$1" in "$HOME"/.cc/state/handoff/perms.json|"$HOME"/.cc/state/handoff/perms.json.tmp|"$HOME"/.cc/state/handoff/perms.brief) return 0;; esac
  case "$1" in "$HOME"/.cc/state/?*/perms|"$HOME"/.cc/state/?*/perms/*) r=${1#"$HOME"/.cc/state/}; r=${r#*/}
    case "$r" in perms|perms/*) return 0;; esac;; esac
  case "$1" in "$HOME"/CLAUDE.local.md|"$HOME"/.cc/CLAUDE.md|"$HOME"/.cc/CLAUDE.local.md|"$HOME"/.cc/.claude|"$HOME"/.cc/.claude/*) return 0;; esac
  case "$1" in "$HOME"/.cc/state/CLAUDE.md|"$HOME"/.cc/state/CLAUDE.local.md|"$HOME"/.cc/state/.claude|"$HOME"/.cc/state/.claude/*) return 0;; esac
  case "$1" in "$HOME"/.cc/state/?*/*) r=${1#"$HOME"/.cc/state/}; r=${r#*/}
    case "$r" in CLAUDE.md|CLAUDE.local.md|.claude|.claude/*) return 0;; esac;; esac
  case "$1" in "$HOME"/.claude/projects/?*) r=${1#"$HOME"/.claude/projects/}; pseatslug "${r%%/*}" && return 0;; esac
  pboot "$1"; }
pabove(){   # rc 0 = $1 is a directory with the seat's state INSIDE it: removing or moving it takes the state with it
  local s
  for s in "$HOME"/.cc/state/*/perms "$HOME"/.cc/state/handoff/perms.json "$HOME"/.cc/state/handoff/perms.brief "$HOME"/.cc/state/hs/launch "$HOME"/.cc/state/hs/clone.json "$HOME"/.claude/projects/*--cc-state-*-perms "${pboots[@]}"; do
    [ -e "$s" ] || continue; case "$s" in "$1"/*) return 0;; esac; done
  return 1; }
# pstate/pseat/pabove above are the primitives; wtgt and rmtgt below fold them into the same write/remove scan
# that already fences ~/dev, ~/bin and ~/.cc/state/arch, so every shape those two already catch (a redirect, a
# cp/mv/tee/sed/dd/git target, an rm/rmdir/unlink/find -delete, and the glob form of each) reaches the perms fence
# too, rather than a third parallel scanner a future edit to wtgt/rmtgt could silently stop matching.
pdeny(){ case "$phit" in "$HOME"/.cc/state/hs|"$HOME"/.cc/state/hs/*|*'~/.cc/state/hs '*) never "writing a seat's launch script ($phit) — ~/.cc/state/hs/launch holds the script, argv and env every seat (the permission seat included) is started from, so whoever writes it chooses what the next unsandboxed session runs; only the permission seat writes there, and reading it is fine";; esac
  pboot "${phit##* }" && never "writing a file every Claude Code session starts from ($phit) — ~/.claude's CLAUDE.md, rules, agents, skills, commands, output-styles, plugins and settings, ~/.claude.json and the claude under ~/.local are what the next permission-skipping seat loads, so only that seat writes them; reading them is fine"
  never "writing the permission seat's state ($phit) — only that seat writes ~/.cc/state/<repo>/perms and its handoff record, and only the seat pins what a new seat starts from (cc-perms pin), because whoever writes its brief.md or its pins controls the next permission-skipping session; reading it is fine"; }
# A COMMAND THAT NAMES THE SEAT'S STATE AND IS NOT A PLAIN READ IS REFUSED, whatever writes it. The scan in wtgt
# judges targets it can resolve, and a `$D/brief.md`, a python open(), os.link, touch or link names the file in a way
# it cannot (security re-review: each passed). pmention reads the command as typed; pread passes only statements
# whose first word is a bare name on a read-only list (not rg: its --pre runs a command; no / and no assignment, so
# /tmp/x/cat and PATH=/tmp/x; cat cannot run a planted binary), with no redirect into a file and no substitution to run something else.
# the last alternative is the seat's transcripts (~/.claude/projects/<its dir, dashed>), named by the slug alone so a
# cd into ~/.claude/projects and a relative path is caught too: cc-perms relaunch resumes one
# …and the startup files above the seat: CLAUDE.md, CLAUDE.local.md or .claude directly in ~/.cc, ~/.cc/state or
# ~/.cc/state/<one name> (a track's own dir below that, and a worktree's CLAUDE.md, are not above any seat).
pmention(){ grep -qE '\.cc/state/[^/[:space:]]+/perms([/'\''"[:space:];&|)]|$)|\.cc/state/handoff/perms\.(json|brief)|\.cc/state.*[^[:alnum:]_.-]perms/(brief\.md|ledger\.md|handoff\.md|session-id|\.claude)|-cc-state-[^/[:space:]]+-perms([/'\''"[:space:];&|)]|$)|\.cc/(state/([^/[:space:]]+/)?)?(CLAUDE(\.local)?\.md|\.claude([/'\''"[:space:];&|)]|$))' <<<"$1" || hsmention "$1"; }
# pmention over the command with every quote and backslash taken out as well: `per''ms`, `per"m"s` and `per\ms` are
# the name the shell hands on, and only the text as typed was read (security read of #940: a cd into ~/.claude/projects
# and `…-per''ms/memory` reached the seat's MEMORY.md)
pmentions(){ pmention "$1" || pmention "$(tr -d '\\'\''"' <<<"$1")"; }
# Every match below reads pfold's text: the command as typed and, under it, a copy with //, /./ and x/../ folded,
# and a /. or /x/.. ending a word too, so .cc/state//hs, hs/./launch and `tar -C hs/.` name the dir they open
# (planning reads of 3e5dfc54 and 955e52c8). The typed line stays in, so nothing the fold changes gets through.
pfold(){ printf '%s\n' "$1"; sed -E ':a; s#//+#/#g; s#/\./#/#g; s#/[^/[:space:]'\''"]+/\.\./#/#g; s#/\.(['\''"[:space:];&|)]|$)#\1#g; s#/[^/[:space:]'\''"]+/\.\.(['\''"[:space:];&|)]|$)#\1#g; ta' <<<"$1"; }
hsmention(){   # …the seats' launch scripts, named as typed or split by a variable ($1 is pfold's text)
  grep -qE '\.cc/state/hs/?(['\''"[:space:];&|)]|$)|\.cc/state/hs/(launch|clone\.json)|\.cc/state.*[^[:alnum:]_.-]hs/(launch|clone\.json)' <<<"$1"; }
# WHAT A SEAT READS AS ITS OWN WHEN IT STARTS OR RUNS A COMMAND IS A LAUNCH INPUT TOO (perms, 2026-10-13), and
# linput fences three kinds of it ($lkind says which, for ldeny):
#  t  A TRANSCRIPT. hs-clone relaunches every seat with --resume <sid>, so the turns in ~/.claude/projects/<proj>/
#     <sid>.jsonl (and its subagents/*.jsonl) become that seat's own. Claude Code writes them outside any tool call
#     and hs-clone only reads them, so every *.jsonl under ~/.claude/projects is fenced from EVERY tier, the
#     permission seat included, and so are ~/.claude/projects and each <proj> dir as a target (a symlink or mv
#     there swaps the whole set). ~/.claude itself is not one of these; it is #940's pboot that fences it as a target (every
#     claude starts from what is in it), and a source named projects, session-env or shell-snapshots copied into it is
#     judged under it (the cp rule). Composes with #940's perms-transcript rows: this one refuses first.
#  m  THE PERMISSION SEAT'S PROJECT DIR, memory included: its MEMORY.md and the files it links load into every perms
#     start. Brief: "Keep memory open only for the caller's OWN project … Fence the perms project directory (glob
#     *-cc-state-*-perms, memory included) from every caller whose cwd isn't that seat's directory." A call's cwd
#     moves with any typed `cd`, so the one caller let through is the seat itself (pseat), and the dir is matched
#     against the slug of the seat PROCESS's cwd ($psd), which a `cd` into a subdir does not move.
#     Every other <proj>/memory stays open: sessions save their notes there with Write (case 12).
#  s  A SHELL STARTUP FILE. Every Bash call first sources the session's ~/.claude/shell-snapshots/snapshot-bash-*.sh,
#     and a login shell reads ~/.bashrc, ~/.profile, ~/.bash_profile and ~/.bash_login, so a line appended to one
#     runs inside the next session that starts, the seat's included. Claude Code writes the snapshots itself; the
#     one writer of ~/.bashrc here is core/install.sh, which is RUN, names no such path, and so passes.
#     ~/.claude/session-env/<session-id>/ is the same kind (perms item 5): Claude Code writes hook env files there
#     (CLAUDE_ENV_FILE) and sources them into that session's Bash commands. Hooks write it as processes, never as
#     tool calls, so it is fenced from every tier, and removing it or the ~/.claude above it is refused too (rmtgt).
# Reading any of them passes. A python open() into one is not caught: the scan reads shell shapes, like the rest.
linput(){   # rc 0 = the absolute, resolved path $1 is one of those, not the caller's own; sets lkind and lhit
  lhit=$1; lkind=s
  case "$1" in "$HOME"/.bashrc|"$HOME"/.profile|"$HOME"/.bash_profile|"$HOME"/.bash_login|"$HOME"/.claude/shell-snapshots|"$HOME"/.claude/shell-snapshots/*|"$HOME"/.claude/session-env|"$HOME"/.claude/session-env/*) return 0;; esac
  lkind=t
  case "$1" in "$HOME"/.claude/projects|"$HOME"/.claude/projects/*.jsonl) return 0;; esac
  case "$1" in "$HOME"/.claude/projects/*) ;; *) return 1;; esac
  local m=${1#"$HOME"/.claude/projects/}; m=${m%%/*}
  case "$m" in *-cc-state-*-perms) lkind=m; pseat && [ "$(printf '%s' "$psd" | tr '/.' '--')" = "$m" ] && return 1; return 0;; esac
  [ "$1" = "$HOME/.claude/projects/$m" ]; }
ldeny(){ case "$lkind" in
    s) never "writing a shell startup file ($lhit) — ~/.claude/shell-snapshots/*.sh and ~/.claude/session-env/<session-id>/* are sourced into every Bash call a session makes, and ~/.bashrc, ~/.profile, ~/.bash_profile and ~/.bash_login run in every shell a seat starts, so a line written there runs as that seat; Claude Code and core/install.sh (run as a program) write them. Reading is fine";;
    m) never "writing the permission seat's project dir ($lhit) — its memory loads into every permission-seat start, so a line written there is text that seat reads as its own; only that seat, from its own state dir, writes it. Reading is fine, and your own project's memory is yours to write";;
    *) never "writing a session transcript ($lhit) — ~/.claude/projects/<proj>/*.jsonl is what a seat resumes from on relaunch, so a line written there becomes that seat's own turn; only Claude Code writes them. Reading is fine, and a session's notes under <proj>/memory are its own to write";; esac; }
# A TEXT RULE BELOW THAT NAMES A LAUNCH INPUT GIVES LINPUT'S REASON, the narrower one: a .jsonl under ~/.claude is a
# transcript, and the seat's -cc-state-…-perms project dir is its memory. Either way the command is still refused.
lname(){ grep -qF .claude <<<"$1" && grep -qE '\.jsonl([^[:alnum:]_.-]|$)' <<<"$1" && { lhit=$2; lkind=t; ldeny; }
  grep -qE -- '-cc-state-[^/[:space:]]*-perms' <<<"$1" && { lhit=$2; lkind=m; ldeny; }; return 0; }
# A QUOTED STRING IS ONE WORD, NOT A STATEMENT (row raised-guard-refuses-a-plain-read-of-perms-journal): pread split
# `grep -E 'release|tunnel' …/perms/progress.md` at the | inside the quotes and took `tunnel'` for a command. pblank
# prints $1 with each quoted span as Q and each backslash-escaped character as E, so the split and the > check below
# see only what the shell would; it fails on an open quote and on any $'…', whose \' it would end early. An unquoted
# # that starts a word opens a comment to the end of its line and is dropped, newline kept, before any quote is read:
# a ' in `grep x …/perms/progress.md # '` opens nothing, and the statement on the next line is still judged (security
# handback on #1456). A # inside a word is a plain character, and only a space, tab, newline or operator ends a word
# before it: bash keeps a carriage return inside the word, so `…\r# '` opens a quote there, not a comment.
pblank(){
  local s=$1 o="" rp='^[^'\''"\\#]+' rq="^'[^']*'" rd='^"([^"\\]|\\.)*"' rc='^#[^'$'\n'']*' rb='[ '$'\t\n'';&|()<>]$'
  case "$s" in *"\$'"*) return 1;; esac
  while [ -n "$s" ]; do
    if [[ $s =~ $rp ]]; then o+=${BASH_REMATCH[0]}
    elif [[ $s == \#* ]]; then
      if [[ -z $o || $o =~ $rb ]]; then [[ $s =~ $rc ]]; else o+='#'; s=${s:1}; continue; fi
    elif [[ $s == \\* ]]; then o+=E; s=${s:2}; continue
    elif [[ $s =~ $rq || $s =~ $rd ]]; then o+=Q
    else return 1; fi
    s=${s:${#BASH_REMATCH[0]}}
  done
  printf '%s\n' "$o"; }
pread(){
  local s w
  case "$1" in *'$('*|*'`'*|*'<('*|*'>('*) return 1;; esac
  s=$(pblank "$1") || return 1
  s=$(sed -E 's/[0-9]*>&[0-9-]//g; s/[0-9&]*>>? *\/dev\/null//g' <<<"$s")
  case "$s" in *'>'*) return 1;; esac
  while IFS= read -r w; do
    w=${w#"${w%%[![:space:]]*}"}; [ -n "$w" ] || continue
    w=${w%%[[:space:]]*}   # a bare name: /tmp/x/cat or PATH=/tmp/x; cat runs a planted binary
    case "$w" in cat|head|tail|grep|egrep|ls|stat|wc|jq|diff|cmp|realpath|readlink|test|'['|cd|pwd|md5sum|sha256sum|file|du|echo|true|cc-lib|date|basename|dirname|cut|tr|nl) ;; *) return 1;; esac
  done < <(sed -E 's/\|\||&&|[;|&]/\n/g' <<<"$s")
  return 0; }
# TEXT THAT ONLY NAMES THE SEAT'S STATE AS DATA IS NOT A WRITE TO IT (row raised-guard-refuses-text-naming-perms-dir:
# "a heredoc writing a file in my own state dir whose TEXT mentioned that path, and a journal append to my own
# progress.md that named it. None wrote there."). pdata passes a command that is ONE statement and nothing else:
# `echo`/`printf` of words and quoted strings, or `cat`/`tee [-a]` fed a heredoc whose tag is quoted (so its body
# expands nothing) or whose unquoted tag opens a body with no $, backtick or backslash (nothing to expand), writing
# to one literal file that is not the seat's state. No `$( )` or backtick anywhere in the words, no second statement,
# no pipe, and a body line equal to the tag only as its last line; the write scan below still judges that literal
# target as it judges any other. `S=…; echo … >> $S/x` names no literal target, so it
# stays refused. A `$` in a double-quoted string never takes a backtick or a backslash with it (security handback
# on #1184): `"$`touch …$`"` runs the touch, and `"$\\`touch …$\\`"` does too once `\\` has paired off.
pdata(){
  local c=$1 h b t f p w q d fr
  w='[^][[:space:]'\''"$`\\;&|<>(){}]+'; q="'[^']*'"; d='"([^"\\`$]|\\.|\$[^("`\\])*"'
  fr='>>? *([A-Za-z0-9_./~+-]+)'
  if [[ $c == *$'\n'* ]]; then   # a heredoc: the first line opens it, the last closes it, nothing between ends it
    h=${c%%$'\n'*}; b=${c#*$'\n'}; b=${b%$'\n'}
    if [[ $h =~ ^[[:space:]]*cat[[:space:]]+${fr}[[:space:]]*\<\<-?[[:space:]]*[\'\"]?([A-Za-z_][A-Za-z0-9_]*)[\'\"]?[[:space:]]*$ ]]; then f=${BASH_REMATCH[1]}; t=${BASH_REMATCH[2]}
    elif [[ $h =~ ^[[:space:]]*cat[[:space:]]+\<\<-?[[:space:]]*[\'\"]?([A-Za-z_][A-Za-z0-9_]*)[\'\"]?[[:space:]]*${fr}[[:space:]]*$ ]]; then t=${BASH_REMATCH[1]}; f=${BASH_REMATCH[2]}
    elif [[ $h =~ ^[[:space:]]*tee[[:space:]]+(-a[[:space:]]+)?([A-Za-z0-9_./~+-]+)[[:space:]]*\<\<-?[[:space:]]*[\'\"]?([A-Za-z_][A-Za-z0-9_]*)[\'\"]?([[:space:]]*\>[[:space:]]*/dev/null)?[[:space:]]*$ ]]; then f=${BASH_REMATCH[2]}; t=${BASH_REMATCH[3]}
    else return 1; fi
    # the tag has a quote on each side (a mismatched pair is a shell syntax error, so it runs nothing), or the tag and
    # the line it opens are unquoted and the body holds no $, backtick or backslash, so the shell expands nothing in it
    # either (a journal's <<EOF)
    if [[ $h =~ [\'\"]${t}[\'\"] ]]; then :; elif [[ $h != *[\'\"]* && $b != *[\$\`\\]* ]]; then :; else return 1; fi
    [ "$(sed 's/^\t*//' <<<"${b##*$'\n'}")" = "$t" ] || return 1   # tabs off as <<- takes them; a << it would not close only reads more as body
    b=${b%"${b##*$'\n'}"}   # the body without its closing line: no line of it may close the heredoc early
    [ -z "$b" ] || ! sed 's/^\t*//' <<<"${b%$'\n'}" | grep -qxF -- "$t" || return 1
    pmentions "$h" && return 1
  else
    [[ $c =~ ^[[:space:]]*(echo|printf)(([[:space:]]+($w|$q|$d)+)*)[[:space:]]*${fr}[[:space:]]*$ ]] || return 1
    f=${BASH_REMATCH[6]}
  fi
  pmentions "$f" && return 1
  # shellcheck disable=SC2088  # the literal text ~/ a command names, expanded by hand just below; ~user is refused
  case "$f" in '~/'*) f=$HOME/${f#'~/'};; '~'*) return 1;; esac
  p=$(realpath -m -- "$f" 2>/dev/null) || return 1
  pstate "$p" && return 1
  return 0; }
if [ "$tool" = Bash ]; then
  praw=$(jq -r '.tool_input.command // ""' <<<"$inp"); pfd=$(pfold "$praw")
  pmentions "$pfd" && ! pread "$praw" && ! pdata "$praw" && ! pseat && { phit="a command naming it that is not a plain read: each statement cat, grep, jq or another read-only tool, and python is not one, so read the ledger with jq"; lname "$pfd" "$phit"
    hsmention "$pfd" && phit="a command naming ~/.cc/state/hs that is not a plain read"; pdeny; }
fi
# A PATTERN UNDER ~/.claude/projects NAMES THE SEAT'S TRANSCRIPTS TOO. pmention reads the slug as typed, so a worker's
# `echo x >> ~/.claude/projects/*-perms/z.jsonl`, or `…-perm?/…`, passed and appended a turn cc-perms relaunch then
# resumes (security read, PR #914). For a gated shell, a non-read that puts a glob, a brace, a $, a backslash or a
# mid-word quote in a path under ~/.claude/projects is refused — or any of those beside a cd to ~/.claude[/projects],
# or from a cwd there. Paths elsewhere, plain reads and the ungated tier are untouched.
pglob(){
  grep -qE '\.claude/projects/[^[:space:];&|<>()]*([][*?{$\\`]|['\''"][^[:space:];&|<>()])' <<<"$1" && return 0
  # a quote counts as much as a glob: `cd ~/.claude/projects; cd …-per''ms/memory; echo x >> MEMORY.md` named the
  # seat's memory with nothing here to see (security read of #940)
  local m=0; grep -qE '[][*?{$\\`'\''"]' <<<"$1" && m=1
  [ "$m" = 1 ] && grep -qE '\.claude(/projects)?/?([[:space:];&|)'\''"]|$)' <<<"$1" && return 0
  [ "$m" = 1 ] && case "$cwd" in "$HOME"/.claude|"$HOME"/.claude/*) return 0;; esac
  return 1; }
if [ "$tool" = Bash ] && [ -z "$pfonly" ] && grep -qF '.claude' <<<"$inp"; then
  praw=$(jq -r '.tool_input.command // ""' <<<"$inp")
  pglob "$praw" && ! pread "$praw" && { phit="a pattern under ~/.claude/projects, which can name the seat's transcripts"; lname "$praw" "$phit"; pdeny; }
fi
# CC_WORKER_SANDBOX IS THE PERMS SEAT'S OR THE OWNER'S TO SET, AND NOBODY ELSE'S (#940, item 7). cc-perms handoff and
# relaunch refuse until it reads 1 through cc-config, because an unsandboxed worker can plant what the next
# permission-skipping seat loads. So the key is that gate's switch, and a session that sets it opens unattended seat
# hand-offs while workers may still run outside bwrap. At every tier, the planning seat included, and from anywhere but
# the live seat (pseat, the same check that guards its state): `cc-config set|unset` of it (quoted, split by quotes, a
# path to cc-config, flags between, keys fed by xargs, a renamed copy as `./y set CC_WORKER_SANDBOX 1`), a computed
# key there or a computed command word with it; a command that names the key and ~/.cc/config and is not a plain read
# (a python or perl one-liner too); cc-perms run with the key or CC_CONFIG in reach; and the Write and Edit tools when
# they name it.
# HOW THIS SITS WITH #855's FENCE ON THE SAME FILE. A gated tier (worker, member) may not write ~/.cc/config at all:
# wtgt's live-tree fence and the Write tool's worktree fence refuse every write, whatever the key. So the judging of
# what a WRITE does to this key — content built from an expansion, a split, recased or escaped name, a file copied or
# linked over it, an Edit replayed on the file — runs only where those fences let the write through: the planning
# tier, and the live seat is exempt everywhere. Spelling the key decides the reason at every tier (a gated shell that
# names it gets this refusal, not the live-tree one), and a computed target that could be the config is judged here at
# every tier, because the live-tree fence cannot resolve it. #855's cc-config rules (the hold, the landing reviewer)
# name other keys and stand beside this one. Reading the key and every other key stay as they were.
# The honest ceiling, at the planning tier: content a program writes at run time and a later statement copies in
# (`gen > f; cat f >> ~/.cc/config`), a sed -i whose address or pattern reaches the key without naming a piece of it
# (`3s/0/1/`, `s/=0$/=1/`), a name composed some other way (base64, rev, a key computed under a renamed cc-config),
# and an environment the session was started with.
sbxcfg=$(realpath -m -- "$HOME/.cc/config" 2>/dev/null); sbxs=""; sbxhit=""
sbxdeny(){ never "setting CC_WORKER_SANDBOX ($sbxhit) — CC_WORKER_SANDBOX is set only by the perms seat or the owner, because cc and cc-sandbox read it to decide whether workers run sandboxed, so whoever sets it vouches that the worker-sandbox rollout is ready. Reading it (cc-config get) and every other key stay yours"; }
sbxraw(){ [ -n "$sbxs" ] || sbxs=$(jq -r '.tool_input.command // ""' <<<"$inp" | tr -d '\\'\''"'); }   # the command as typed, quotes and backslashes off
sbxisc(){ [ "$1" = "$HOME/.cc/config" ] || [ "$1" = "$sbxcfg" ]; }
sbxres(){ local x=$1   # a word of the command as the path it names, ~ and $HOME expanded, a relative one against the line's base
  # shellcheck disable=SC2088,SC2016  # a literal ~ and $HOME are the command text, expanded by hand as wtgt does
  case "$x" in '~/'*) x=$HOME/${x#\~/};; '$HOME/'*) x=$HOME/${x#\$HOME/};; '${HOME}/'*) x=$HOME/${x#\$\{HOME\}/};; /*) ;; *) x=${wbase:-$cwd}/$x;; esac
  realpath -m -- "$x" 2>/dev/null; }
sbxtouch(){   # rc 0 = this write to ~/.cc/config (target as typed: $1) cannot be shown to leave CC_WORKER_SANDBOX alone
  local r w x; local -a ws; sbxraw
  grep -qF CC_WORKER_SANDBOX <<<"$sbxs" && return 0
  # a key split, recased or escaped (G2 read of #940): `sed -i '/SANDBOX/s/0/1/'`, `printf 'CC_WORKER_%s=1' SANDBOX`,
  # `tr a-z A-Z`, `\x53ANDBOX`: a piece of the name once CC_MEMBER_SANDBOX is taken out, a \x or \u escape, or an
  # octal one beside printf or echo (sed's `\1` backreference, as in `s/\(CC_FOO=\).*/\15/`, is not one of those).
  grep -qiE 'sandb|ndbox|worker_s' <<<"$(sed -E 's/member_sandbox//gI' <<<"$sbxs")" && return 0
  r=$(jq -r '.tool_input.command // ""' <<<"$inp")
  grep -qE '\\[xuU][0-9A-Fa-f]' <<<"$r" && return 0
  grep -qE '(^|[^A-Za-z0-9_.-])(printf|echo)([^A-Za-z0-9_.-]|$)' <<<"$r" && grep -qE '\\[0-7]{2}' <<<"$r" && return 0
  r=${sbxs//"$1"/}; r=$(sed -E 's/\$\{HOME\}|\$HOME([^A-Za-z0-9_]|$)/\1/g' <<<"$r")
  grep -qE '\$[][A-Za-z_{(0-9@*#?!$'\''"-]|`|[<>]\(' <<<"$r" && return 0   # content (or a key) built from an expansion
  case "${v:-}" in ln|dd) return 0;; esac   # a link makes the config another file; dd's input is not judged
  read -r -a ws <<<"$(tr ';&|<>()=\n\t' ' ' <<<"$sbxs")"   # read -a, not $( ): a word is a name here, never a glob
  for w in "${ws[@]}"; do x=$(sbxres "$w") || continue   # a file the command reads that holds the key
    sbxisc "$x" && continue; [ -f "$x" ] && grep -qsF CC_WORKER_SANDBOX -- "$x" && return 0; done
  case "${v:-}" in cp|mv|install|rsync)   # a file copied over it: every source must be one that is there to read
    for w in "${a[@]}"; do case "$w" in -*|*['<>']*|"$1") continue;; esac; x=$(sbxres "$w") || return 0
      sbxisc "$x" && continue; [ "$x" = "${sbxcfg%/*}" ] && continue; [ "$x" = "$HOME/.cc" ] && continue
      [ -f "$x" ] && [ -r "$x" ] || return 0; done;; esac
  return 1; }
sbxmaybe(){   # rc 0 = the computed write target $1 (~ and $HOME already expanded) could be ~/.cc/config, and the write is not cleared
  local p d h; p=$(sed -E 's/['\''"\\]//g' <<<"$1")
  # shellcheck disable=SC2016  # the expansions are matched as text, as in pcomputed
  p=$(sed -E 's/\$\{[^}]*\}|\$\([^)]*\)|`[^`]*`|\$[A-Za-z_][A-Za-z0-9_]*|\$[0-9@*#?$!-]|\{[^}]*\}/*/g' <<<"$p")
  case "$p" in *'*'*) ;; *) return 1;; esac
  case "$p" in /*) d=${p%%\**}; d=${d%/*}; [ -n "$d" ] && h=$(realpath -m -- "$d" 2>/dev/null) && p=$h${p#"$d"};; '*'*) ;; *) p=${wbase:-*}/$p;; esac
  # shellcheck disable=SC2053  # $p unquoted on purpose: the wildcarded name is matched as a pattern
  [[ $HOME/.cc/config == $p ]] || [[ $sbxcfg == $p ]] || return 1
  case "$p" in *[!*]*) sbxtouch "$1";; *) sbxraw; grep -qF CC_WORKER_SANDBOX <<<"$sbxs";; esac; }   # all expansion: only a command naming the key
sbxedit(){   # rc 0 = this Edit of ~/.cc/config ($fp), replayed on the file as it stands, changes a line that sets CC_WORKER_SANDBOX
  local c o n b
  case "$tool" in Edit|MultiEdit) [ -r "$fp" ] || return 1;; *) return 1;; esac
  c=$(cat -- "$fp"; printf x); c=${c%x}; b=$(grep -E '^[[:space:]]*CC_WORKER_SANDBOX[[:space:]]*=' <<<"$c")
  while IFS= read -r -d '' o && IFS= read -r -d '' n; do [ -n "$o" ] && c=${c//"$o"/"$n"}; done \
    < <(jq -j '(.tool_input.edits // [.tool_input]) | .[] | (.old_string // ""), "\u0000", (.new_string // ""), "\u0000"' <<<"$inp")
  [ "$b" != "$(grep -E '^[[:space:]]*CC_WORKER_SANDBOX[[:space:]]*=' <<<"$c")" ]; }
if [ "$tool" = Bash ] && grep -qE 'SAND|cc-config|cc-perms|['\''"\\]' <<<"$inp"; then
  sbxraw; praw=$(jq -r '.tool_input.command // ""' <<<"$inp"); sbxw='[^[:space:];&|()]'
  { grep -qE "$AT"'([^[:space:]]*/)?cc-config[[:space:]]+(set|unset|'"$sbxw"'*[$`*?{[]'"$sbxw"'*)([[:space:]]+-'"$sbxw"'*)*([[:space:]]+(CC_WORKER_SANDBOX([^A-Za-z0-9_]|$)|'"$sbxw"'*[$`*?{[])|[[:space:]]*([;&|)]|$))' <<<"$u" \
    || grep -qE "$AT$sbxw"'*[$`]'"$sbxw"'*[[:space:]]+(set|unset)([[:space:]]+-'"$sbxw"'*)*[[:space:]]+(CC_WORKER_SANDBOX([^A-Za-z0-9_]|$)|'"$sbxw"'*[$`])' <<<"$u" \
    || { grep -qE 'cc-config.*(set|unset).*CC_WORKER_SANDBOX' <<<"$sbxs" && ! pread "$praw"; } \
    || { grep -oE '(^|[;&|(){}`[:space:]])[^[:space:];&|(){}`]+[[:space:]]+(set|unset)([[:space:]]+-[^[:space:]]*)*[[:space:]]+CC_WORKER_SANDBOX([^A-Za-z0-9_]|$)' <<<"$sbxs" \
         | sed -E 's/^[;&|(){}`[:space:]]//; s/[[:space:]].*//' | grep -qvxE 'then|else|elif|do|if|while|until|builtin|command|time|eval|exec|!' \
         && ! pread "$praw"; }; } \
    && ! pseat && { sbxhit="cc-config set or unset of it, under any name, or of a key this cannot read"; sbxdeny; }
  grep -qF CC_WORKER_SANDBOX <<<"$sbxs" && grep -qE '(^|[^A-Za-z0-9_-])config|\.cc([^A-Za-z0-9_-]|$)|CC_CONFIG' <<<"$sbxs" && ! pread "$praw" && ! pseat \
    && { sbxhit="a command that names it and ~/.cc/config"; sbxdeny; }
  grep -qE "$AT"'([^[:space:]]*/)?cc-perms[[:space:]]+(relaunch|handoff|'"$sbxw"'*[$`])' <<<"$u" \
    && grep -qE 'CC_WORKER_SANDBOX|CC_CONFIG|(^|[^A-Za-z0-9_.-])(eval|source|\.)[[:space:]]|(export|declare|typeset|readonly|env)([[:space:]]+-[^[:space:]]*)*[[:space:]]+[^[:space:]=]*[$`]' <<<"$sbxs" \
    && ! pseat && { sbxhit="cc-perms run with it, CC_CONFIG or a computed environment"; sbxdeny; }
fi
# A LAUNCH INPUT NAMED IN AN INTERPRETER ONE-LINER is the same text door as pmention's (perms handback, MEDIUM):
# `python3 -c "open('/home/u/.bashrc','a')"` names the file in a way wtgt never parses. Only a command that runs an
# interpreter on an inline program (-c, -e, --eval, a heredoc) is read, so `source ~/.bashrc`, a grep piped to awk
# and `python3 tool.py x.jsonl` still read; a one-liner that only READS a transcript by its literal path is refused
# too, and runs as a script instead.
lmention(){ grep -qE '(~|\$HOME|\$\{HOME\}|/home/[^/[:space:]]+)/\.(bashrc|profile|bash_profile|bash_login)([^[:alnum:]_.-]|$)|\.claude/(shell-snapshots|session-env)|\.claude/projects/[^[:space:]'\''"]*\.jsonl|\.claude/projects/[^/[:space:]'\''"]*-cc-state-[^/[:space:]'\''"]*-perms' <<<"$1" \
  || grep -qF -e "$HOME/.bashrc" -e "$HOME/.profile" -e "$HOME/.bash_profile" -e "$HOME/.bash_login" <<<"$1"; }   # …and this HOME, spelled out
linterp(){   # rc 0 = an interpreter runs a program given inline (-c, -e, -p, --eval, php -r, or a heredoc), the flag spaced
  # from it or not (python3 -c"…", perl -e'…'); a script it runs is not read here. awk's program is always inline, so
  # awk and gawk count when that program can write: print into a file, a pipe to or from a quoted command, system(),
  # or gawk's -i inplace. `awk '{print}' ~/.profile` reads, and passes. pread never counts an awk stage as a read (perms,
  # 10-13: an interpreter's exemption on a denylist is weaker than main), so grep piped to awk over a transcript glob is refused.
  grep -qE '(^|[;&|(`[:space:]/])((python[0-9.]*|perl|node|ruby|deno|bun|lua|tclsh)([[:space:]][^;&|]*)?[[:space:]]-[A-Za-z]*[ceEp]([[:space:]'\''"]|$)|(python[0-9.]*|perl|node|ruby|deno|bun|lua|tclsh)([[:space:]][^;&|]*)?[[:space:]]--(eval|print)|php([[:space:]][^;&|]*)?[[:space:]]-r([[:space:]'\''"]|$)|(python[0-9.]*|perl|node|ruby|php|lua|tclsh)[[:space:]]*(-[[:space:]]*)?<<)' <<<"$1" && return 0
  sed -E 's/[0-9]*>&[0-9-]//g; s/[0-9&]*>>? *\/dev\/null//g' <<<"$1" \
    | grep -qE '(^|[;&|(`[:space:]/])[gmn]?awk([[:space:]].*)?[[:space:]](.*printf?.*>|.*\|[[:space:]]*"|.*"[[:space:]]*\||.*system[[:space:]]*\(|-i[[:space:]]*inplace|.*--include[=[:space:]]*inplace)'; }
# A CLAUDE STARTED IN THE PERMISSION SEAT'S DIRECTORY passes pseat's cwd test (perms, next round, (a)): from a call
# whose cwd is that dir, `setsid -f claude`, `nohup claude`, a path to it or its cli.js all passed, and so did
# `D=~/.cc/state/<r>; cd $D/perms && claude` and `tmux new-window -c $D/perms claude`. So from every tier but the
# seat itself, a command that starts a claude is refused when the call's cwd is a seat dir or it names a …/perms path.
# A launcher word (setsid, nohup, tmux, node, env, …) leads the statement, or claude does; a commit message saying
# "claude" leads with git and is not a launch.
claunch(){
  local s w
  while IFS= read -r s; do
    s=${s#"${s%%[![:space:]]*}"}
    while [[ "$s" =~ ^[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*[[:space:]]+(.*)$ ]]; do s=${BASH_REMATCH[1]}; done
    w=${s%%[[:space:]]*}; w=${w//[\"\']/}; w=${w##*/}
    case "$w" in claude|cli.js) return 0;;
      setsid|nohup|exec|env|timeout|stdbuf|nice|tmux|screen|node|npx|sudo|script|systemd-run|bash|sh|daemonize)
        grep -qE '(^|[[:space:]/"'\''])(claude|cli\.js|claude-code)([[:space:]"'\'']|$)' <<<"$s" && return 0;; esac
  done < <(sed -E 's/\|\||&&|[;|&(]|\$\(/\n/g' <<<"$1")
  return 1; }
if [ "$tool" = Bash ]; then
  lraw=$(jq -r '.tool_input.command // ""' <<<"$inp"); lfd=$(pfold "$lraw")
  linterp "$lraw" && lmention "$lfd" && ! pread "$lraw" && { lhit="a literal path in an interpreter one-liner"; lkind=s
    grep -qE '\.jsonl' <<<"$lfd" && lkind=t; grep -qE -- '-cc-state-[^/[:space:]]*-perms' <<<"$lfd" && lkind=m; ldeny; }
  if claunch "$lraw" && ! pread "$lraw"; then
    lsd=""; case "$cwd" in "$HOME"/.cc/state/?*/perms|"$HOME"/.cc/state/?*/perms/*) lsd=1;; esac
    grep -qE '/perms/?([[:space:]'\''";&|)]|$)' <<<"$lfd" && lsd=1
    [ -n "$lsd" ] && ! pseat && never "starting a claude in the permission seat's directory (the call's cwd, or a …/perms path it names) — a claude there passes the seat check and writes the seat's state, so only the owner starts one, through the seat's own launcher"
  fi
fi
# THE ARGV LAYER ONLY REFUSES. cc-guard-argv (next to this file; its docstring has the rules) judges a Bash call on the
# argv bash would run, once every judge in the Bash branch below has let it through, so those judges run whole and keep
# their own reasons: a call is refused when either refuses, and nothing it answers lets through what they refuse.
# A gated role is asked as itself; every other session as role pf, which holds the hard limits no role is without (a
# reboot through sudo, ssh or a computed verb, a read of the box's credentials, an ssh whose remote words carry one).
# The permission seat is the one session past pf. A crash refuses a gated role, and lets the ungated tier through: a
# broken helper never locks the planning seat out.
argv_layer(){
  { [ -z "$pfonly" ] || ! pseat; } || return 0
  RX=""   # no text rule fired this refusal: an earlier rx match that refused nothing is not named in it
  GA=$(dirname "$(realpath "$0")")/cc-guard-argv   # ~/bin/cc-guard is a symlink into core/bin
  ac=$(jq -r '.tool_input.command // ""' <<<"$inp"); ar=$role; [ -n "$pfonly" ] && ar=pf
  gr=$root${mdir:+:$mdir}${awt:+:$awt}               # GUARD_ROOT: the trees this session writes, ':'-separated
  gp=""; [ -z "$pfonly" ] && grep -qF perms <<<"$ac" && pseat && gp=1   # GUARD_PSEAT: the /proc walk only when perms is named
  av=$(env -u GUARD_NEVER_TOUCH HOME="$HOME" GUARD_HOME="$HOME" GUARD_ROLE="$ar" GUARD_CWD="$cwd" \
         GUARD_ROOT="$gr" GUARD_MWS="$mws" GUARD_INB="$inb" GUARD_PSEAT="$gp" "$GA" judge <<<"$ac" 2>&1); arc=$?
  if [ "$arc" != 0 ]; then [ -z "$pfonly" ] && never "the guard could not parse this command (cc-guard-argv rc $arc: ${av:0:200})"
  else case "$av" in
    '') ;;
    deny$'\t'*)  deny "${av#*$'\t'}";;
    never$'\t'*) never "${av#*$'\t'}";;
    *) [ -z "$pfonly" ] && never "the guard could not parse this command (cc-guard-argv answered: ${av:0:120})";;
  esac; fi; return 0; }
[ -n "$pfonly" ] && case "$tool" in Bash|Edit|Write|MultiEdit|NotebookEdit) ;; *) exit 0;; esac   # nothing else reaches the seat's state
case "$tool" in
  Bash)
    cmd=$u0   # the universal block above already built it: one jq and at most one awk per call, not two
    [ -z "$pfonly" ] && cmd+=$ug   # …and deglob's copies, for a gated tier (the universal gates have read them already)
    # …unless the whole command is one data-only statement (dataonly): then the gated text rules read it as typed with
    # its quoted strings blanked, so a word inside one is not a verb and a `*` inside one is not a glob
    if [ -z "$pfonly" ] && dataonly "$praw"; then
      cmd=$(sed -E "s/'[^']*'/''/g; s/\"[^\"]*\"/\"\"/g" <<<"$praw") || cmd=$u0; dgcap=""; dgsplit=""
    fi
    # …and a glob too wide for those copies is refused here, not read as the floor's names alone, since a gated tier's rules name more (deglob)
    [ -z "$pfonly" ] && [ -n "$dgcap" ] && { echo "cc-guard: blocked — \`$dgcap\` is a glob that can name more than $DGMAX commands, too many for the gates to read each one it could run. Narrow it (more of the name typed out), or list the directory and filter the names (ls /usr/bin | grep '^a')." >&2; exit 2; }
    # …and so is a word with more places an expansion could split it than deglob spells every way (dgalts' DGS)
    [ -z "$pfonly" ] && [ -n "$dgsplit" ] && { echo "cc-guard: blocked — \`$dgsplit\` has more than $DGSPMAX places where an expansion could split it into words, too many for the gates to read each way it could run. Spell the word out, or build it in a variable first." >&2; exit 2; }
    cmdn=$(tr '\t' ' ' <<<"$cmd" | tr -s ' ')   # …and the same line blank-squeezed, which is what rxn, the gh api door and the Slack ones below read (see the note there)
    # A VERDICT IN THE PERMISSION SEAT'S NAME IS THAT SEAT'S TO RECORD. Perms' note on guard-false-refusal-exemptions:
    # "refuse `lander record --by perms-*` outside the perms seat" — every tier, the ungated one too, since a planning
    # seat runs `lander record` and a perms-* reviewer is what the landing reads as perms having read the head. A
    # --by computed by a `$` or a backtick could be anything, so it is refused the same way; any other --by passes here.
    grep -qE -- '(^|[^A-Za-z0-9_.-])(cc-land|lander)([[:space:]][^;&|]*)?[[:space:]]record[[:space:]][^;&|]*--by([[:space:]]|=)+["'"'"']?(perms|[$`])' <<<"$cmdn" \
      && ! pseat && never "recording a verdict in the permission seat's name (lander record --by perms-*, or a --by this cannot read) — only the perms seat records its own reads"
    # WHICH MODELS REVIEW A CHANGE IS THE PERMISSION SEAT'S CALL (owner, 2026-10-23): cc-review-keys sets them and
    # checks its caller itself; this refuses it to every other session, at every tier, before it runs. A plain read
    # of it passes, and so does a command whose every call of it, statement by statement, is its selfcheck or help.
    grep -qE -- '(^|[^A-Za-z0-9_.-])cc-review-keys([^A-Za-z0-9_.-]|$)' <<<"$cmdn" \
      && grep -oE -- 'cc-review-keys[^;&|]*' <<<"$cmdn" | grep -vqE -- '^cc-review-keys([[:space:]]+(selfcheck|-h|--help))?[[:space:]]*$' \
      && ! pread "$praw" \
      && ! pseat && never "setting the landing review keys (cc-review-keys) — which models review a change is the permission seat's call; ask perms"
    if [ -z "$pfonly" ]; then   # every rule up to the write walk is a gated tier's; the ungated one meets the walk alone
    # A GATED SHELL MAY NOT EVEN TRY cc-perms relaunch, revive OR handoff. cc-perms checks who calls it (relaunch:
    # the nearest claude above stands, unmarked, in a repo's own planning seat; revive: the call runs in the cgroup of
    # cc-recover.service or cc-recover-restore.service; handoff: it is the seat itself, in window perms), so a worker or member typing this gets refused twice over — here as text, and there when the
    # script walks its own process tree. This rule is the one that holds when the command is wrapped (env, xargs, a
    # function) in a way that still reaches a real shell; see $AT. Naming the verb some other way passed this as text
    # (security read, PR #940: `v=handoff; cc-perms $v`, and xargs feeding it from stdin), so the rule is an allow
    # list: a gated shell runs cc-perms only as `cc-perms selfcheck`, `-h` or `--help`, and every other call is refused.
    # The allow list reads the STATEMENT lines alone (the \001-marked ones in $uk: the command as typed, quotes off),
    # where a separator or a wrapper really puts cc-perms at the start of a command. hay's other lines put every word
    # after a wrapper or a subcommand at ^ too, so `git add core/bin/cc-perms` and `bash -n core/bin/cc-perms` left a
    # bare path there and were refused for naming the file. Those lines still meet the two shapes that can only be a
    # call: a named verb, and a verb from an expansion (`timeout 5 cc-perms $v`).
    pcall='([^ ]*/)?cc-perms([[:space:]]+[^[:space:];&|)]*|[;&|)]|$)'
    { grep -a $'^\001.' <<<"$uk" | tr -d '\001' | grep -oE "$AT$pcall" | sed -E 's/[;&|)]$//; s/[[:space:]]+$//' \
        | grep -qvE '(^|[^A-Za-z0-9_.-])cc-perms[[:space:]]+(selfcheck|-h|--help)$' \
      || grep -qE "$AT"'([^ ]*/)?cc-perms[[:space:]]+((relaunch|revive|handoff)([^A-Za-z0-9_.-]|$)|["'\'']?[$`])' <<<"$cmd"; } \
      && never "starting a permission seat — only a repo's own planning seat brings it back (cc-perms relaunch), or the box's recover units (cc-perms revive), and only the seat hands itself off (cc-perms handoff) or pins what a new seat starts from (cc-perms pin); a worker or member runs cc-perms selfcheck or --help, and nothing else"
    if [ -n "$handoff_gated" ]; then   # on top of the four gates below: what only the LIVE session may do
      # "their commit and push either still go through (the work was scoped before the handoff)" — the brief;
      # $handoff_scoped is a subagent of the predecessor's still out at cutover, so its push is NOT refused here
      [ -z "$handoff_scoped" ] && rx 'git +push\b' && denyh "pushing while the other session is the live one (a retired session must not push a stale branch)"
      rx "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' && { board_only "$qcmd" && RX="" || denyh "dispatching a worker (cc --go)"; }
      rx "$AT"'([^ ]*/)?cc-loop\b' && denyh "dispatching a worker (cc-loop)"
      rx "$AT"'([^ ]*/)?cc +done\b' && denyh "opening a PR (cc done)"
    fi
    rx 'git +(checkout|switch) +(main|master)\b' && deny "switching to the default branch inside a track"
    # A REF NAMED LIKE ORIGIN'S IS A WAY TO BE MAIN (re-read of #771). Worktrees share refs, and `origin/main` was read
    # as refs/heads/origin/main before refs/remotes/origin/main, so a worker's `git branch -f origin/main HEAD` made
    # its own commit the main the lander pinned, promoted and deployed. The lander now names refs/remotes/… in full;
    # this is the second wall: no gated session makes a branch or tag called origin/…, or writes refs/remotes/….
    ORIGW="writing a ref named like origin's (refs/remotes/… and a branch or tag called origin/… are what the lander reads as main)"
    rxn 'git +[^;&|]*:\+?(refs/(remotes|heads/origin|tags/origin)/|origin/)' && never "$ORIGW"   # a refspec's destination
    rxn 'git +branch( +(-[ft]+|--(force|track(=[a-z]+)?|no-track)))* +(refs/heads/)?origin/' && never "$ORIGW"   # branch <name>
    rxn 'git +branch( +-[A-Za-z]+| +--[a-z-]+)* +(-[fcCmM]*[cCmM][fcCmM]*|--(copy|move))( +-[A-Za-z]+| +--[a-z-]+)*( +[^ ;&|-][^ ;&|]*)? +(refs/heads/)?origin/' && never "$ORIGW"   # -m/-c [<old>] <new>
    rxn 'git +(tag( +-[A-Za-z]+)*|(checkout|switch) +(-[bBcC]|--orphan)|worktree +add( +-f)? +-[bB]) +(refs/(heads|tags)/)?origin/' && never "$ORIGW"
    # …AND THE THIRD READ OF #771 FOUND THE WAYS ROUND IT: `git -c x=y update-ref` (options between git and its verb),
    # a destination built from a variable (`d=refs/remotes; git fetch . HEAD:$d/origin/main`), and for a box worker
    # the remote itself — `git remote set-url origin <its own bare repo>`, `git config --unset-all
    # remote.origin.fetch`, a url.<x>.insteadOf. The lander now fetches a URL it pins itself and refuses a rewrite of
    # it, so these are the second wall. A member in its own workspace still adds and sets its own remotes.
    GO='git( +(-[cC] *[^ ;&|]+|--[A-Za-z-]+(=[^ ;&|]*)?|-[A-Za-z]))*'
    rxn 'git( [^;&|]*)? (fetch|push)( [^;&|]*)?:\+?["'"'"']?\$' && never "$ORIGW — here a refspec destination built from a variable"
    rx "$GO"' +(symbolic-ref|update-ref|checkout +-B|switch +-C)' && deny "repointing a ref/HEAD (the checkpoint hook would then commit+push that branch)"
    if [ "$role" != member ]; then
      RMT="changing a remote or the git config the box's checkouts share (remote.*, core.*, url.*, include.*, includeIf.*): the lander fetches only the URL it pins, and a rewrite here is a way to make a commit pass for main"
      rxn "$GO"' +remote +(add|set-url|remove|rm|rename|set-head|set-branches)([^A-Za-z0-9_-]|$)' && never "$RMT"
      # AN INCLUDE IS A WHOLE CONFIG FILE OF THE WORKER'S (re-read 3 of #771). `git config include.path /tmp/x.cfg`
      # pulls in a file the guard never sees the keys of, a url.<x>.insteadOf among them, so include.* and
      # includeIf.* are refused as writes like url.*, in `git config` (the loop below), `--file` included, and as
      # `git -c include.path=…` or `--config-env=include.path=…` for one call. Keys are case-insensitive.
      INCX='git( +[^ ;&|]+)*? +(-c *|--config-env[= ] *)["'"'"']?include(if)?\.'
      grep -qiE -- "$INCX" <<<"$cmdn" && { RX=$INCX; never "$RMT"; }
      while IFS= read -r gc; do   # each `git … config …` statement: a read (--get*, --list, -l, one bare key) passes
        [ -n "$gc" ] || continue
        grep -qiE -- ' (-e|--edit)( |$)' <<<"$gc" && { RX="$GO"' +config'; never "$RMT"; }
        grep -qiE -- '[ =]["'"'"']?(remote|core|url|include|includeif)\.' <<<"$gc" || continue
        grep -qE -- ' (--get(-all|-regexp|-urlmatch|-color|colorbool)?|--list|-l|get|list)( |$)' <<<"$gc" && continue
        grep -qE -- ' config( +--(local|global|system|worktree|show-origin|show-scope|null|name-only|includes|no-includes|type=[a-z]+)| +-z)* +[^ -][^ ]*$' <<<"$gc" && continue
        RX="$GO"' +config'; never "$RMT"
      done < <(grep -oE -- "$GO"' +config([^A-Za-z0-9_-][^;&|]*)?' <<<"$cmdn")
    fi
    # 3. destructive / infra
    rx "$AT"'cc +slack +off' && never "cc slack off (drops the owner's live Slack link)"
    # …AND THE ONE WAY THROUGH IS cc-bench-grade, for grading benchmarks (owner, 2026-09-27: "Yes fo
    # whatever you want", on containers for benchmarking). It never hands a harness the real socket; it serves one
    # that checks every request (its docstring says what passes). That is only worth what the COPY RUNNING is
    # worth, and a worktree copy is the session's own to edit. So the installed one, by its bare name, is the only
    # spelling: by a path or through an interpreter it is refused (selfcheck and --help run on fixtures and stay
    # open, blanked the way cc-land's are), and so is any command that also changes PATH, hash's table or defines
    # a function by that name. The harnesses it wraps start containers themselves and are refused on their own.
    # Its name is in GLOBNAMES, so a glob of the path (`core/bin/cc-bench-gr[a]de`) reaches this rule as the path.
    cmdb=$(sed -E 's#([^ ;&|(){}`]*/)?cc-bench-grade +(-h|--help|selfcheck)( +[0-9]?>(&[0-9]|/dev/null)?)* *($|[;&|)`])#:\5#g' <<<"$cmd") || cmdb=$cmd
    [ -n "$cmdb" ] || cmdb=$cmd
    grep -qE -- "$AT"'(([^ ]*/)?python[0-9.]*( +-[^ ]+)* +)?[^ ]*/cc-bench-grade([^A-Za-z0-9_.-]|$)' <<<"$cmdb" \
      && RX='[^ ]*/cc-bench-grade' && never "running cc-bench-grade by a path (only the installed copy, named bare, is the reviewed one; a worktree copy is not)"
    rx 'cc-bench-grade' && rx '(^|[^A-Za-z0-9_])(PATH=|hash +-|enable +-f|function +cc-bench-grade|cc-bench-grade *\( *\))' \
      && never "running cc-bench-grade with PATH, hash or a function of that name changed in the same command"
    rx "$AT"'(([^ ]*/)?harbor([^/A-Za-z0-9_.-]|$)|([^ ]*/)?python[0-9.]*( +-[^ ]+)* +(-m +swebench\.harness|[^ ]*swe_bench_pro_eval)|([^ ]*/)?swe_bench_pro_eval)' \
      && never "running a benchmark harness that starts containers itself (cc-bench-grade runs it against a filtered socket)"
    rx 'git +(branch +-D|reset +--hard +origin|clean +-[a-z]*f)' && never "destructive git"
    # 3b. A WORKER KILLS ONLY WHAT IT STARTED. 2026-09-02 11:15Z a worker went hunting a "stray" suite with
    #     `pgrep -f <the suite's filename>`, matched its OWN `claude -p` — its task prompt names that file — and
    #     killed its own iteration mid-run (rc=143, $0 recorded, nothing journalled). A prompt line telling it not
    #     to did not hold, so the rule is here: at the worker tier a kill lands only on a DESCENDANT of this
    #     session, and never on a session process or a loop runner whatever the tree says. Its own children — a
    #     detached suite, a poller — stay killable, which is the whole point of the subtree test rather than a ban.
    #     A pattern (pkill/killall) is resolved with ONE pgrep and every match must pass the same test; a pattern
    #     matching nothing is nothing to refuse. Same honest ceiling as rule 5: a pid or pattern held in a shell
    #     variable cannot be resolved here and passes, unless a pgrep in the same command fills it: then that
    #     pgrep is resolved and fenced.
    #     WORKER *and* MEMBER, because those are not two populations here: a worker dispatched inside a member
    #     workspace is given role=member by track_dir() (the repo decides the tier, not the worktree), and it is
    #     the one running `claude -p` in a loop — exactly the session the incident happened to. `role=member` is
    #     every worker gate PLUS its own, as the header says, so a fence only the worker tier gets is a hole.
    if { [ "$role" = worker ] || [ "$role" = member ]; } \
       && { grep -qE "$AT"'([^ ]*/)?(kill|pkill|killall)([[:space:]]|$)' <<<"$cmd" \
            || grep -qE 'xargs[^;&|]+([^ ]*/)?(kill|pkill|killall)([[:space:]]|$)' <<<"$cmd"; }; then
      kroot(){   # this session's own process: the nearest `claude` above the hook. $CC_GUARD_ROOT_PID is a test
        # hook and safe as one — the hook is a child of the claude process, not of the Bash tool, so a command
        # cannot put it there (the same reason $CC_HANDOFF is trusted above).
        local p=${CC_GUARD_ROOT_PID:-} n=0
        if [ -n "$p" ]; then printf '%s' "$p"; return 0; fi
        p=$PPID
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          [ "$(cat "/proc/$p/comm" 2>/dev/null)" = claude ] && { printf '%s' "$p"; return 0; }
          p=$(kppid "$p"); n=$((n+1))
        done
        return 1
      }
      kdesc(){   # rc 0 = pid $1 is a DESCENDANT of $2 — never $2 itself, never one of $2's ancestors
        local p=$1 n=0
        [ "$p" = "$2" ] && return 1
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          p=$(kppid "$p"); [ "$p" = "$2" ] && return 0; n=$((n+1))
        done
        return 1
      }
      # A RUN THIS WORKER DETACHED IS STILL ITS OWN. The templates tell a worker to `setsid nohup` a long gate so
      # it outlives the iteration; that reparents the run to init, the subtree test then read it as somebody
      # else's, and the worker could neither poll nor stand down the run it had armed (rows raised-guard-blocks-
      # stopping-your-own-detached-run, -liveness-check-on-exited-pid). What a detached run keeps is where it
      # STANDS: it was started from this worker's tree and its cwd is still there, and nothing another session
      # started stands in this worker's worktree — a session or a loop runner that does is kheld's, checked first.
      # So a pid is the worker's own if it is a descendant of its session OR it, or one of its ancestors, has its
      # cwd inside $root. An ancestor, because the run's own children (a suite cd'd into its gate dir) are its.
      # …AND ONLY WHERE "NOTHING ELSE STANDS THERE" IS TRUE, WHICH IS A TRACK WORKTREE. A member-facing dir is
      # shared ground — the planning session, an orch, a lander and a handoff peer all stand in ~/dev/<h> — and the
      # cwd fallback (an env-only role after a `cd ~`) is every process on the box; a cwd there proves nothing,
      # so $kroot (set by track_dir alone) gates this. And a chain that passes a claude, a tmux pane or the loop
      # runner on its way to init is a SESSION's, not a detached run's: the run this fence exists for was
      # reparented to init and passes none of them (landing review of #404: the first cut handed a host-owned
      # process standing in a member's dir, and every interactive session in the tree, over to the member).
      kcwd(){   # rc 0 = pid $1 is a detached run standing in this worker's own worktree, or a child of one
        [ -n "$kroot" ] || return 1
        local p=$1 n=0 d r hit=""
        r=$(realpath -m -- "$root" 2>/dev/null) || r=$root
        [ -n "$r" ] && [ "$r" != / ] || return 1
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          case "$(cat "/proc/$p/comm" 2>/dev/null)" in claude|tmux*|cc-loop) return 1;; esac
          d=$(readlink "/proc/$p/cwd" 2>/dev/null) && case "$d" in "$r"|"$r"/*) hit=1;; esac
          p=$(kppid "$p"); n=$((n+1))
        done
        [ -n "$hit" ]
      }
      kabove(){   # rc 0 = pid $1 is this session's own process, or one above it (kdesc excludes both; kcwd must too)
        local p=$me n=0
        while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
          [ "$p" = "$1" ] && return 0; p=$(kppid "$p"); n=$((n+1))
        done
        return 1
      }
      kfence(){   # $1 = a pid the command would signal, $2 = how it was named
        # A PID THAT IS NOT THERE IS REFUSED, NOT WAVED THROUGH: by the time the signal is sent that number can be
        # anybody's, and this cannot see whose. The poll of a finished run is `kill -0`, which kprobe passes before
        # this is reached (row raised-guard-blocks-liveness-check-on-exited-pid); the first cut of that fix let
        # ANY signal to a gone pid through (security read of #404). Refused here, with this line as the whole of
        # stderr — the redirects below used to print the shell's own "/proc/…: No such file" on top of the reason.
        [ -d "/proc/$1" ] || never "killing pid $1 ($2) — there is no such process now, and by the time the signal lands that pid could be anybody's; a liveness poll is kill -0"
        kheld "$1" && never "killing pid $1 ($2) — that is a session or a loop runner, and a worker that ends one ends itself"
        kabove "$1" && never "killing pid $1 ($2) — that is this session's own process or one above it, and a worker that ends one ends itself"
        kdesc "$1" "$me" || kcwd "$1" || never "killing pid $1 ($2) — it is outside this worker's own process subtree and is no detached run standing in its worktree, so it is somebody else's; a worker ends only what it started"
      }
      # A HIT THAT HAS ALREADY GONE IS NO TARGET. kfence refuses a gone pid because a NAMED pid could be anybody's by the
      # time the signal lands; a pattern is resolved again by pkill (or the feeding pgrep) when the command runs, so a pid
      # it found here and lost a moment later is never signalled. Fencing it refused `pkill -f build_site.py` on every
      # try with no build_site.py running, naming a short-lived process that matched the pattern and was gone (09-20, 10-10, 10-30).
      kgone(){ [ ! -d "/proc/$1" ]; }
      me=$(kroot) || me=""
      [ -n "$me" ] || never "killing a process — this worker cannot find its own session process, so it cannot tell its children from anybody else's"
      kresolve(){   # $1 = a `pgrep …` invocation, $2 = how to name it. Fences everything it would find.
        local seg=$1 why=$2 spec full pat hits x
        [[ $seg =~ (^|[^A-Za-z0-9_.-])pgrep[[:space:]]+(.*)$ ]] || return 1
        local args=${BASH_REMATCH[2]}
        args=${args%%[\`)]*}                            # a substitution ends at its own paren: `$(pgrep -f x)`
        local xa; read -r -a xa <<<"$args"
        spec=$(kpat pgrep "${xa[@]}") || return 1
        full=${spec%%$'\t'*}; pat=${spec#*$'\t'}
        case "$pat" in *'$'*|*'`'*) return 1;; esac    # named by a variable: unresolvable
        if [ -n "$full" ]; then hits=$(pgrep -f -- "$pat" 2>/dev/null) || hits=""
        else hits=$(pgrep -- "$pat" 2>/dev/null) || hits=""; fi
        for x in $hits; do kgone "$x" || kfence "$x" "$why"; done     # no match = nothing to refuse
        return 0
      }
      # HUNT, THEN KILL — the incident's own shape, and the one the target loop below cannot see. In
      # `pgrep -f <suite> | xargs kill -9` the kill carries no target of its own: the pids arrive on its
      # stdin, so the loop reads `-9` as a signal, finds nothing to fence and lets it through. What it would
      # kill is whatever the pgrep on the other side of the pipe finds, so THAT is what is resolved and
      # fenced. A feed this cannot read is refused rather than guessed: a worker that cannot say whose pids
      # those are has no business signalling them.
      prev=""
      while IFS= read -r seg; do
        if [[ $seg =~ (^|[^A-Za-z0-9_.-])xargs([[:space:]]+-[^[:space:]]+([[:space:]]+[^-][^[:space:]]*)?)*[[:space:]]+([^ ]*/)?(kill|pkill|killall)([[:space:]]|$) ]]; then
          [[ $seg =~ (kill|pkill|killall)[[:space:]]+(.*)$ ]] && read -r -a xk <<<"${BASH_REMATCH[2]}" && kprobe "${BASH_REMATCH[1]}" "${xk[@]}" && { prev=$seg; continue; }   # fed to a probe: nothing is signalled
          kresolve "$prev" "the pids a pipeline fed to xargs kill" \
            || never "killing whatever a pipeline finds (… | xargs kill) — the pids arrive on stdin, so this worker cannot tell its own from anybody else's; the one time it guessed, it ended its own iteration"
        fi
        prev=$seg
      done < <(tr '|' '\n' <<<"$cmd")
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(kill|pkill|killall)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; skip=""; pat=""
        kprobe "$v" "${a[@]}" && continue              # signal 0: a liveness probe, nothing to fence (kprobe)
        if [ "$v" = kill ]; then
          first=1                                      # only the FIRST dash-argument can be the signal
          for x in "${a[@]}"; do
            if [ -n "$skip" ]; then skip=""; first=""; continue; fi
            case "$x" in
              -s|-n|--signal) skip=1; first="";;
              --) first="";;                             # end of options: what follows is a target, never a signal
              -[0-9]*|-[A-Za-z]*)
                # A LATER `-N` IS A PROCESS GROUP, NOT A SIGNAL, and fencing no pid fences nothing: `kill -9 -1`
                # walked straight through this branch and signals every process this user owns — the worker's own
                # claude, its loop runner and the shared tmux server (review of #181, a worse 11:15Z).
                if [ -n "$first" ]; then first=""; continue; fi
                case "$x" in
                  -1) never "killing process group -1 — that is every process this user owns, this worker included";;
                  -[0-9]*) for gp in $(pgrep -g "${x#-}" 2>/dev/null); do kfence "$gp" "kill $x (process group ${x#-})"; done;;
                esac;;
              %*) ;;                                     # a job of the tool's own shell
              '$('*|'`'*)                                # `kill $(pgrep -f <suite>)`: the same hunt, spelled
                first=""                                 # as a substitution rather than a pipe
                kresolve "$inv" "the pids a pgrep found for kill" \
                  || never "killing what a command substitution returns — this worker cannot see whose pids those are";;
              *'$'*)                                     # `P=$(pgrep -f x); kill $P`, `for p in $(pgrep …)`:
                # A VARIABLE FILLED BY A HUNT IS THE HUNT. The variable itself cannot be read here, so it used to
                # pass, and on 10-28 a builder took the lander's check run that way (python3 -m unittest, found by
                # pgrep) and ended a 66 min gate. Every pgrep the same command runs is resolved and fenced instead;
                # a variable with no pgrep beside it (`kill $!`, the worker's own job) still passes.
                first=""
                while IFS= read -r hs; do kresolve "$hs" "kill $x, where the command fills it from a pgrep"; done \
                  < <(grep -oE '(^|[^A-Za-z0-9_.-])pgrep[[:space:]][^;&|]*' <<<"$cmd");;
              *[!0-9]*) first="";;                       # a glob: unresolvable, same ceiling as rule 5
              *) first=""; kfence "$x" "kill $x";;
            esac
          done
        else
          # NO PATTERN IS NOT "NOTHING TO REFUSE". A selector says WHICH processes without naming one:
          # `pkill -u $(id -u)` parses to no pattern at all, so this line used to fall through and let it
          # signal every process this user owns — the worker's own claude -p, its loop runner and the shared
          # tmux server. That is `kill -9 -1` spelled a second way, and that one IS refused a branch up
          # (review of #181). Resolving it instead would mean teaching kpat every spelling procps takes
          # (-u1000, --uid=1000, --older, whatever lands next); seven holes in four rounds say it cannot be
          # taught. So a pkill/killall this cannot reduce to a pattern is refused, the way an unreadable
          # xargs feed is. `killall -l` and `pkill -V` are refused with it: informational, and no rule here
          # needs them. A selector WITH a pattern is unaffected — the pattern is still what gets resolved.
          spec=$(kpat "$v" "${a[@]}") \
            || never "$v with a selector but no pattern — -u/-U/-g/-G/-P/-t/-s/--older/-F and the rest name a whole SET of processes and this worker cannot tell whose they are, so it is refused rather than guessed: pkill -u \$(id -u) is every process this user owns, its own claude -p and loop runner included, and pkill --older 3600 is the same set an hour old"
          fflag=${spec%%$'\t'*}; pat=${spec#*$'\t'}
          case "$pat" in *'$'*|*'`'*) continue;; esac     # named by a variable: unresolvable
          if [ "$v" = killall ]; then hits=$(pgrep -x -- "$pat" 2>/dev/null) || hits=""
          elif [ -n "$fflag" ]; then hits=$(pgrep -f -- "$pat" 2>/dev/null) || hits=""
          else hits=$(pgrep -- "$pat" 2>/dev/null) || hits=""; fi
          for x in $hits; do kgone "$x" || kfence "$x" "$v $pat"; done   # no match = nothing to refuse
        fi
      done < <(grep -oE "$AT"'([^ ]*/)?(kill|pkill|killall)[[:space:]]+[^;&|]*' <<<"$cmd")
    fi
    fi   # end of the rules the ungated tier skips (pfonly): the write walk below is the one it meets
    # 5. THE WORKTREE IS THE ONLY TREE A TRACK WRITES. ~/dev/<repo> is the checkout the box RUNS and ~/bin symlinks into
    #    it, so a write there is an unreviewed change to a live binary. 2026-09-01: a review agent's `cp x $S/bin/y` landed
    #    in the live checkout's core/bin because $S/bin was a symlink farm into it — so every target is REALPATH'd and judged by
    #    where it LANDS, never by how it was spelled. Verbs with a destination: redirections; cp/mv/ln/install/rsync (the
    #    last arg, or -t); tee and sed -i (every file); dd of=; and git -C <there> with a verb that writes. A variable or
    #    a glob in the target cannot be resolved and passes: the same honest ceiling as every other line here.
    #    A RELATIVE TARGET LANDS WHERE THE LINE HAS GOT TO, NOT WHERE THE PAYLOAD STARTED: `cd ~/dev/other && echo
    #    pwn > f` resolved f against the cwd, found it inside this session's own tree and passed (adversarial
    #    review of #243). So $wbase carries the cd along the line, and a cd this cannot resolve (a variable) makes
    #    every relative target after it a refusal — the same "refuse what you cannot reduce" as the kill fence.
    hit=""; wbase=$cwd
    # A GLOB CUT ABOVE A FENCED NAME STILL REACHES IT. Both fences below cut a target at its first glob character
    # and judge the literal prefix, which is right when the prefix is already inside the fence (`~/bin/cc-guar?`).
    # The prefix can also be SHORTER than the fenced path — `~/b*/cc-guard`, `~/.cc/state/ar*`, `~/.cc/state/*` —
    # and then asking only "is the prefix inside the fence" is the wrong question: the answer is no, the command
    # runs, and the shell expands the glob onto the very file the fence exists for (security re-read of #361, which
    # removed cc-arch's cursor that way). So a CUT prefix is judged in both directions, and this is the second
    # one: does a fenced path begin with it. An exact path is unchanged — it means itself and nothing else.
    wspan(){ local t=$1 p; shift          # rc 0 = the cut prefix $t spans one of the fenced roots $@; $hit says which
      for p; do case "$p" in "$t"*) hit=$p; return 0;; esac; done; return 1; }
    # A GLOB OVER A LAUNCH INPUT (linput): $1 the resolved cut prefix, $2 that prefix as typed, $3 the whole name.
    # A prefix that could still grow into a startup file or ~/.claude/projects is refused; one inside a <proj> dir
    # is judged on that dir (the seat's) and on its tail, which a .jsonl, a glob or a .. could make a transcript.
    lglob(){ local p m r tail=${3:${#2}}; lhit=$3
      for p in "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.claude/shell-snapshots" "$HOME/.claude/session-env"; do
        case "$p" in "$1"*) lkind=s; ldeny;; esac; done
      case "$1" in "$HOME"/.claude/shell-snapshots/*|"$HOME"/.claude/session-env/*) lkind=s; ldeny;; esac
      lkind=t; case "$HOME/.claude/projects" in "$1"*) ldeny;; esac
      case "$1" in "$HOME"/.claude/projects/*) ;; *) return 0;; esac
      r=${1#"$HOME"/.claude/projects/}; m=${r%%/*}
      [ "$r" = "$m" ] && case "$2" in */) ;; *) ldeny;; esac   # the <proj> name itself is cut: it could be any, the seat's too
      linput "$HOME/.claude/projects/$m/memory" && ldeny
      lkind=t; case "$tail" in *.jsonl|*..*) ldeny;; esac
      case "${3##*/}" in *['*?[']*) case "$1/" in "$HOME/.claude/projects/$m/memory/"*) ;; *) ldeny;; esac;; esac
      return 0; }
    # THE UNGATED TIER'S RELATIVE WRITE AFTER A `cd` THIS CANNOT RESOLVE: refused only when some part of the name, glob
    # and all, could be the seat's state or climb out of where it landed. That tier can edit this file in ~/dev, so
    # its fence guards against a mistake, not an adversary, and a planning seat's `cd "$(git rev-parse …)"` stays free.
    prel(){ local c n; local -a parts; IFS=/ read -ra parts <<<"$1"
      for c in "${parts[@]}"; do for n in perms brief.md ledger.md handoff.md session-id pins mcp.json .claude .claude.json perms.json perms.brief .. shell-snapshots session-env; do
        # shellcheck disable=SC2053  # $c unquoted on purpose: a glob in the name is matched as a glob
        [[ $n == $c ]] && return 0; done; done; return 1; }
    # A COMPUTED NAME CAN STILL SPELL THE SEAT'S OWN FILES (security read of #940: `d=…/<repo>/pe; echo x >> ${d}rms/handoff.md`
    # and `tee -a …/per{m,}s/handoff.md` passed). For a gated shell every expansion and brace group in a write target
    # becomes a wildcard, and a target whose literal tail is 4 characters or more and that could then be brief.md,
    # ledger.md, handoff.md or session-id in a seat's directory is refused. A target that is all expansion (`> $OUT`)
    # says nothing and passes, and so does one built in pieces (`${a}${b}`): text cannot see those, and the worker
    # sandbox, which binds only the track's own state directory, is what holds against them.
    # …AND IT IS RUN AT EVERY TIER (security read of #940, round 4). The planning tier skipped it, and a target with a
    # `$` in it was "unresolvable" there, so `d=…/<repo>/pe; >${d}rms/pins` rewrote the seat's pins and `d=CLAUDE;
    # >~/.claude/${d}.md` planted a startup file. A target with no literal head is judged as above, so `> $OUT/x` and
    # `> $S/out.txt` still pass. A literal head is judged by where it can lead: inside ~/.claude, ~/.claude.json or a
    # seat's perms directory is refused whatever follows; so is a head that ~/.claude begins with (`~/${d}.md`, `/$x`),
    # and one that runs into a seat's directory name (`…/<repo>/pe${x}`). Any other head (~/dev/, /tmp, a scratch dir)
    # is refused only when the name could be one of the files below, with no length asked of its tail. The honest
    # ceiling stays: `~/.cc/state/<repo>/${x}/y` could be perms/y and is not refused unless y is a file listed here.
    pcomputed(){ local p f pd d h; local -a fl=()
      p=$(sed -E 's/['\''"\\]//g' <<<"$1")   # quotes off first, so `"$HOME"/.claude/${d}.md` has its head expanded below
      # shellcheck disable=SC2088,SC2016  # a literal ~ and $HOME are the command text, expanded by hand as wtgt does
      case "$p" in '~/'*) p=$HOME/${p#\~/};; '$HOME/'*) p=$HOME/${p#\$HOME/};; '${HOME}/'*) p=$HOME/${p#\$\{HOME\}/};; esac
      # shellcheck disable=SC2016  # the expansions are matched as text, so the sed script is single-quoted on purpose
      p=$(sed -E 's/\$\{[^}]*\}|\$\([^)]*\)|`[^`]*`|\$[A-Za-z_][A-Za-z0-9_]*|\$[0-9@*#?$!-]|\{[^}]*\}/*/g' <<<"$p")
      case "$p" in *'*'*) ;; *) return 1;; esac
      f=${p##*\*}
      # A LITERAL HEAD IS RESOLVED LIKE ANY TARGET (security read A of #940: `ln -s ~/.claude/projects /tmp/p` and then
      # `echo x > /tmp/p/<the seat's dir>/${d}ory/MEMORY.md`). The directory part before the first wildcard is put
      # through realpath, and a name with such a head is also judged against the startup files and the seat's MEMORY.md.
      # A name with no literal head (`$OUT/settings.json`) is judged against the seat's own files alone, as before.
      case "$p" in /*) d=${p%%\**}; d=${d%/*}
          [ -n "$d" ] && h=$(realpath -m -- "$d" 2>/dev/null) && p=$h${p#"$d"}
          h=${p%%\**}
          case "$h" in "$HOME"/.claude/*|"$HOME"/.claude.json*) phit=$HOME/.claude; return 0;; esac
          case "$HOME/.claude" in "$h"*) phit=$HOME/.claude; return 0;; esac
          for pd in "$HOME"/.cc/state/*/perms; do [ -d "$pd" ] || continue
            case "$h" in "$pd"|"$pd"/*) phit=$pd; return 0;; esac
            case "$pd" in "$h"*) [ "${#h}" -gt $((${#pd} - 5)) ] && { phit=$pd; return 0; };; esac; done
          fl=("$HOME"/.claude.json "$HOME"/.claude/CLAUDE.md "$HOME"/.claude/CLAUDE.local.md "$HOME"/.claude/settings.json "$HOME"/.claude/settings.local.json "$HOME"/.local/bin/claude);;
        '*'*) [ "${#f}" -ge 4 ] || return 1;; *) [ "${#f}" -ge 4 ] || return 1; p="*/$p";; esac
      for pd in "$HOME"/.cc/state/*/perms; do [ -d "$pd" ] || continue
        [ ${#fl[@]} -gt 0 ] && fl+=("$HOME/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$pd")/memory/MEMORY.md"
          "$pd"/CLAUDE.md "$pd"/CLAUDE.local.md "$pd"/.claude/settings.json "${pd%/perms}"/CLAUDE.md "${pd%/perms}"/CLAUDE.local.md)
        for f in "$pd"/brief.md "$pd"/ledger.md "$pd"/handoff.md "$pd"/session-id "$pd"/pins "$pd"/launch/mcp.json; do
          # shellcheck disable=SC2053  # $p unquoted on purpose: the wildcarded name is matched as a pattern
          [[ $f == $p ]] && { phit=$f; return 0; }; done; done
      # shellcheck disable=SC2053  # the same: a pattern
      for f in "${fl[@]}"; do [[ $f == $p ]] && { phit=$f; return 0; }; done
      return 1; }
    wtgt(){ local t=${1%\`} g="" tf tq   # rc 0 = $1 lands in ~/dev/* or ~/bin, outside this session's own tree; $hit says where
      # A GLOB IS NOT AN UNRESOLVABLE NAME. It is a name with a tail this cannot see, and the head of it says
      # where the write LANDS: `cp /dev/null ~/bin/cc-guar?` truncated a live binary while this waved it
      # through for carrying a `?` (6th adversarial review of #243). The literal prefix is judged; `~/bin/x?`
      # is refused and `sub/x?` still runs. A `$` or a backtick stays unresolvable — a variable names anywhere.
      # The backtick that CLOSED a substitution is the last character of the last word in it, so `cp /dev/null
      # ~/bin/cc-guard` inside one handed this a target with a backtick on the end, and a name carrying one is
      # called unresolvable and waved through (5th adversarial review of #243). It is a boundary, not a name.
      # shellcheck disable=SC2088  # a literal ~ in a case pattern is the point: it is being expanded by hand
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      # a brace with no expansion beside it is judged as a glob below (lglob, wspan), so a launch input keeps its own reason
      case "$t" in *['$`']*) pcomputed "$t" && ! pseat && { phit="a computed name that could be $phit"; pdeny; }
        sbxmaybe "$t" && ! pseat && { sbxhit="a computed name that could be ~/.cc/config"; sbxdeny; };; esac
      tf=$t; case "$t" in *['*?[{']*) g=1; t=${t%%[*?[{]*};; esac   # …so the glob (a brace too) is cut off and its prefix judged, both ways (wspan)
      tq=$t   # the cut prefix as typed: a trailing / says its last name is whole (linput's glob rule)
      case "$t" in ''|-*|*['$`']*) return 1;; /*) ;;
        *) [ -n "$wbase" ] || { [ -n "$pfonly" ] && ! prel "${1%\`}" && return 1; never "writing to a relative path after a \`cd\` this cannot resolve — where it would land is unknown, so it is refused rather than guessed"; }
           t=$wbase/$t;; esac
      t=$(realpath -m -- "$t" 2>/dev/null) || return 1
      # ~/.cc/config CARRIES CC_WORKER_SANDBOX (see sbxtouch, above): a write onto it, a glob that can reach it, or a
      # cp/mv/ln into ~/.cc itself is judged by what it can do to that key, before the fence below — but only where
      # that fence lets the write through (the planning tier, or a root that covers it). At a gated tier the fence
      # refuses every write to the file, whatever the key, so judging it twice only gave one write two reasons.
      local sc=""
      if [ -n "$g" ]; then wspan "$t" "$HOME/.cc/config" "$sbxcfg" && sc=1
      elif sbxisc "$t"; then sc=1
      elif [ "$t" = "$HOME/.cc" ] || [ "$t" = "${sbxcfg%/*}" ]; then case "${v:-}" in cp|mv|ln|install|rsync) sc=1;; esac; fi
      [ -n "$sc" ] && { [ -n "$pfonly" ] || { [ -z "$g" ] && in_root "$t"; }; } \
        && sbxtouch "${1%\`}" && ! pseat && { sbxhit="a write to ~/.cc/config ($t)"; sbxdeny; }
      # ~/.cc/state is a track's own scratch and stays writable — with ONE carve-out. ~/.cc/state/arch is where
      # cc-arch keeps the record of which architecture revisions it has already put in the owner's channel; a
      # shell that can delete a line of it can make the box upload the same document again, or a document about a
      # commit it already answered for (security review of #361). It is the ledger for an outward door, so it is
      # fenced like ~/bin and not like scratch.
      # ~/.cc/lander IS THE CODE EVERY LANDING RUNS and ~/.cc/state/land IS ITS QUEUE (security read of #771): a
      # worker that appends to current/core/lander/*.py, repoints `current` or plants `legacy-on` chooses what
      # merges, and one that writes a job, an approval or an inbox request there forges a landing. Both are
      # fenced like ~/bin; the lander's own processes write them, never a gated shell.
      # ~/.cc/config HOLDS WHO REVIEWS A LANDING and the protected-path hold (security read of #849): the lander reads
      # those keys from this file alone, so a gated shell does not write it. ~/.cc itself is fenced as a TARGET, so
      # `cp /tmp/config ~/.cc/` and `cp -t ~/.cc …` are refused too; its subdirectories are not, and are judged as before.
      # ~/.cc/try/bin SITS AHEAD OF ~/bin ON EVERY PATH (cc, cc-loop, cc-rc, install.sh), so a shell refused
      # `cp x ~/bin/cc-land` could plant the same name there and shadow it for every new session; ~/.cc/try/live
      # and its ledger say what cc-try undoes and what the digest shows (security read of #1086 at 259aa5bc).
      # Only cc-try writes there; it is fenced like ~/bin.
      case "$t" in "$HOME"/dev/*|"$HOME"/bin|"$HOME"/bin/*|"$HOME"/.cc/try|"$HOME"/.cc/try/*|"$HOME"/.cc/state/arch|"$HOME"/.cc/state/arch/*|"$HOME"/.cc/lander|"$HOME"/.cc/lander/*|"$HOME"/.cc/state/land|"$HOME"/.cc/state/land/*|"$HOME"/.cc|"$HOME"/.cc/config) { [ -n "$pfonly" ] || in_root "$t"; } && return 1; hit=$t; return 0;; esac   # pfonly: not the ungated tier's fence
      # THE PERMISSION SEAT'S STATE IS THE SAME KIND OF FENCE AS ~/.cc/state/arch — writable by the one process it
      # belongs to and nobody else — except the "one process" here is the live bypass seat (pseat), not a fixed
      # in_root check, because the seat is not launched as a normal track. See pstate/pseat, defined above.
      [ -z "$g" ] && linput "$t" && ldeny   # every tier, the seat included, and before pstate: see linput
      pstate "$t" && { pseat && return 1; phit=$t; pdeny; }
      [ -n "$g" ] && lglob "$t" "$tq" "$tf"
      [ -n "$g" ] && { [ -z "$pfonly" ] && wspan "$t" "$HOME/dev/" "$HOME/bin" "$HOME/.cc/try" "$HOME/.cc/state/arch" "$HOME/.cc/lander" "$HOME/.cc/state/land" "$HOME/.cc/config" && return 0
        if ! pseat; then local pd; for pd in "$HOME"/.cc/state/*/perms "$HOME"/.cc/state/hs/launch "$HOME"/.cc/state/hs/clone.json; do [ -e "$pd" ] || continue; wspan "$t" "$pd" && { phit=$hit; pdeny; }; done
          wspan "$t" "${pboots[@]}" && { phit=$hit; pdeny; }; fi; }
      return 1; }
    wdeny(){ never "writing into the box's live tree ($hit): ~/dev/<repo> is the checkout the box runs, ~/bin symlinks into it, ~/.cc/try is cc-try's overlay ahead of ~/bin on every PATH, ~/.cc/lander is the lander release every landing runs, ~/.cc/state/land is its queue, ~/.cc/config says who reviews it, and ~/.cc/state/arch is the ledger for what has already been sent outward — a track writes its worktree, /tmp and the rest of its own ~/.cc/state dir, and the rest arrives as a PR"; }
    # DELETING THE RECORD IS THE OTHER HALF OF WRITING IT, and the fence above only covered writing. cc-arch reads
    # ~/.cc/state/arch to know which architecture revisions it has already sent; a shell that cannot overwrite the
    # cursor but CAN unlink it drops the tool onto its first-run branch, which re-pins to the head of the branch
    # and posts NOTHING — a declared revision suppressed in silence, which is worse than a duplicate because
    # nobody is looking for it (security re-read of #361; `rm -rf` on that directory was rc 0).
    rmtgt(){ local t=${1%\`} g=""   # rc 0 = $1 names or spans ~/.cc/state/arch; $hit says what
      # ITS OWN COPY of wtgt's hand-expansion, deliberately. wtgt refuses outright a relative path after a `cd` it
      # cannot resolve; that is right for a write into ~/bin and far too broad for an `rm`, which every build runs.
      # Here an argument this cannot reduce is LEFT ALONE: the set being fenced is one directory, not a tree.
      # shellcheck disable=SC2088  # a literal ~ in a case pattern is the point: it is being expanded by hand
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      case "$t" in *['*?[{']*) g=1; t=${t%%[*?[{]*};; esac  # a glob (or a brace) is a name with a tail this cannot see; wspan judges it both ways
      case "$t" in ''|-*|*['$`']*) return 1;; /*) ;; *) [ -n "$wbase" ] || return 1; t=$wbase/$t;; esac
      t=$(realpath -m -- "$t" 2>/dev/null) || return 1
      [ -z "$pfonly" ] && case "$t" in "$HOME"/.cc/state/arch|"$HOME"/.cc/state/arch/*|"$HOME"/.cc/try|"$HOME"/.cc/try/*) hit=$t; return 0;; esac
      # a session's hook env files (linput, kind s): removing them, or the ~/.claude above them, from every tier
      case "$t" in "$HOME"/.claude|"$HOME"/.claude/session-env|"$HOME"/.claude/session-env/*) lhit=$t; lkind=s; ldeny;; esac
      # …and every launch input: `truncate -s 0 ~/.bashrc` or an rm of a transcript reaches this scan, not wtgt's.
      # Both run before pstate, whose pass for the seat would otherwise skip them and whose reason is the broader one.
      [ -z "$g" ] && linput "$t" && ldeny
      pstate "$t" && { pseat && return 1; phit=$t; pdeny; }
      if ! pseat && pabove "$t"; then phit=$t; pdeny; fi
      [ -n "$g" ] && case "$HOME/.claude/session-env" in "$t"*) lhit=$1; lkind=s; ldeny;; esac
      [ -n "$g" ] && { [ -z "$pfonly" ] && wspan "$t" "$HOME/.cc/state/arch" "$HOME/.cc/try" && return 0
        if ! pseat; then local pd; for pd in "$HOME"/.cc/state/*/perms "$HOME"/.cc/state/hs/launch "$HOME"/.cc/state/hs/clone.json; do [ -e "$pd" ] || continue; wspan "$t" "$pd" && { phit=$hit; pdeny; }; done
          wspan "$t" "${pboots[@]}" && { phit=$hit; pdeny; }; fi; }
      return 1; }
    rmdeny(){ case "$hit" in "$HOME"/.cc/try|"$HOME"/.cc/try/*) never "removing cc-try's live state ($hit): its overlay, checkouts and ledger say what is live ahead of ~/bin and what the digest shows, and only cc-try itself writes or removes them; \`cc-try off\` takes a try back out";; esac
      never "removing the record of what has already been sent outward ($hit): ~/.cc/state/arch holds cc-arch's cursor and its ledger, and a shell that deletes either one makes the box re-pin to the branch head and drop a declared architecture revision without saying so. The rest of ~/.cc/state is a track's own, to write and to delete"; }
    wcd(){   # where a `cd`/`pushd` leaves the rest of the line; rc 1 = it cannot be resolved, so $wbase is emptied
      local t=$1
      # shellcheck disable=SC2088  # the same hand-expansion as wtgt: a literal ~ is what a command line carries
      case "$t" in '~') t=$HOME;; '~/'*) t=$HOME/${t#\~/};; '$HOME'|'${HOME}') t=$HOME;; '$HOME/'*) t=$HOME/${t#\$HOME/};; '${HOME}/'*) t=$HOME/${t#\$\{HOME\}/};; esac
      case "$t" in '') t=$HOME;; '~-'|+[0-9]*|-*|*['$`*?[']*) return 1;; /*) ;; *) [ -n "$wbase" ] || return 1; t=$wbase/$t;; esac
      realpath -m -- "$t" 2>/dev/null || return 1; }
    # A `|` OR `&` THAT IS PART OF A REDIRECTION CUTS NOTHING (review of #1141). Every scan below ends an invocation
    # at [;&|], so `cp >|log a ~/bin/x` and `cp 2>&1 a ~/bin/x` were read as `cp >` and `cp 2>`, and the target fell
    # off: a live binary overwritten with no heredoc anywhere. A descriptor copy (`2>&1`, `>&-`, `<&3`) writes no file
    # and goes; `>|`, `&>`, `&>>` and a `>&` onto a name are each a `>` onto it. `|&` is a pipe and is left alone.
    # …BUT ONLY AN UNESCAPED `>` OR `<` IS AN OPERATOR (security read of c3d5ce6c). cmdpos blanks a bare `\>`, but it
    # keeps the `\>` of `echo "\>"|cp /dev/null ~/bin/x`, and folded here that read `echo \>cp …` and the pipe into cp
    # was gone. A `>` or `<` behind an odd run of backslashes is masked first (\001, \002) so nothing below folds it.
    rdn(){ local re='(^|[^0-9])[0-9]*[<>]&([0-9]+-?|-)([^A-Za-z0-9_./~-]|$)' be='(^|[^\\])((\\\\)*)\\([<>])' m; rdt=$1
      while [[ $rdt =~ $be ]]; do m='\'$'\001'; [ "${BASH_REMATCH[4]}" = '<' ] && m='\'$'\002'
        rdt=${rdt/"${BASH_REMATCH[0]}"/"${BASH_REMATCH[1]}${BASH_REMATCH[2]}$m"}; done
      while [[ $rdt =~ $re ]]; do rdt=${rdt/"${BASH_REMATCH[0]}"/"${BASH_REMATCH[1]} ${BASH_REMATCH[3]}"}; done
      rdt=${rdt//'&>'/'>'}; rdt=${rdt//'>&'/'>'}; rdt=${rdt//'<&'/'<'}; rdt=${rdt//'>|'/'>'}
      rdt=${rdt//$'\001'/'>'}; rdt=${rdt//$'\002'/'<'}; }
    wscan(){   # the three write shapes over one piece of the haystack, every relative target against $wbase
      local txt=$1 t inv v x dst skip ef n verb hl rdt; local -a a files dirs
      rdn "$txt"; txt=$rdt
      # A REDIRECT TARGET IS NEVER AN OPTION: every transcript dir is named -home-…, so `cd ~/.claude/projects &&
      # echo x >> -home-…/s.jsonl` passed as a `-` word. It goes to wtgt as ./-home-…, and so does an operand after `--`.
      while IFS= read -r t; do case "$t" in -*) t=./$t;; esac; wtgt "$t" && wdeny; done < <(grep -oE '(&>>?|[0-9]*>>?[|]?)[[:space:]]*[^[:space:];&|<>()]+' <<<"$txt" | sed -E 's/^[^[:space:]]*>[|]?[[:space:]]*//')
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(cp|mv|ln|install|rsync|tee|sed|dd)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; dst=""; skip=""; files=(); n=0; ef=""; eo=""
        case "$v" in
          # THE DESTINATION IS NOT ALWAYS THE LAST WORD. Reading only the last one, any trailing word moved the
          # target out of sight: `cp a ~/bin/cc-guard 2>/dev/null` judged `2>/dev/null`, and `sh -c 'cp $1
          # ~/bin/cc-guard' _ a` judged `a` — both overwrote a live binary (4th adversarial review of #243). So
          # EVERY bare word after the first is judged. Only the first is a source and safe to skip; a `-t` names
          # the destination outright and the bare words are then all sources. The cost is a false refusal on
          # `cp a ~/dev/other/b sub/`, where a middle SOURCE is judged as a target: over-strict, the safe way.
          # A HARD LINK MAKES ITS SOURCE WRITABLE BY ANOTHER NAME: `ln ~/.cc/state/<r>/perms/brief.md ~/.cc/tmp/b`
          # then `echo x >> ~/.cc/tmp/b` rewrote the seat's brief (security review of perms-seat-hands-off-itself). So
          # for `ln` without -s and `cp -l`, the first word is judged as a target too.
          cp|mv|ln|install|rsync) hl=""
            case "$v" in ln) hl=1; for x in "${a[@]}"; do case "$x" in -s|--symbolic|-[!-]*s*) hl="";; esac; done;;
              cp) for x in "${a[@]}"; do case "$x" in -l|--link|-[!-]*l*) hl=1;; esac; done;; esac
            for x in "${a[@]}"; do
              if [ -n "$skip" ]; then dst=$x; skip=""; continue; fi
              [ -n "$eo" ] && case "$x" in -*) x=./$x;; esac
              case "$x" in --) [ -n "$eo" ] || { eo=1; continue; };; esac
              case "$x" in -t|--target-directory) skip=1;; --target-directory=*) dst=${x#*=};;
                -*) ;; *) n=$((n+1)); { [ "$n" -gt 1 ] || [ -n "$hl" ]; } && files+=("$x");; esac; done
            [ -z "$dst" ] || { [ -n "$hl" ] && files+=("$dst") || files=("$dst"); };;
          tee) for x in "${a[@]}"; do if [ -n "$eo" ]; then case "$x" in -*) x=./$x;; esac; files+=("$x"); continue; fi
              case "$x" in --) eo=1;; -*) ;; *) files+=("$x");; esac; done;;
          sed) case " ${a[*]} " in *" -i"*|*" --in-place"*) ;; *) continue;; esac   # without -i sed writes nothing
            for x in "${a[@]}"; do case "$x" in -e|-f|--expression|--file) ef=1;; esac; done
            for x in "${a[@]}"; do   # the script is the first bare arg unless -e/-f carried it; the rest are files
              if [ -n "$skip" ]; then skip=""; continue; fi
              case "$x" in -e|-f|--expression|--file) skip=1;; -*) ;; *) n=$((n+1)); { [ -n "$ef" ] || [ "$n" -gt 1 ]; } && files+=("$x");; esac; done;;
          dd) for x in "${a[@]}"; do case "$x" in of=*) files+=("${x#of=}");; esac; done;;
        esac
        for x in "${files[@]}"; do wtgt "$x" && wdeny; done
        # …and INTO A DIRECTORY the source keeps its name: `cp /tmp/d/.bashrc ~/` writes ~/.bashrc, so a source
        # named like a launch input (linput) is judged again under each target
        case "$v" in cp|mv|ln|install|rsync) for w in "${a[@]}"; do case "${w%/}" in */projects|projects|*/session-env|session-env|*/shell-snapshots|shell-snapshots) w=${w%/};; esac
          case "${w##*/}" in .bashrc|.profile|.bash_profile|.bash_login|*.jsonl|snapshot-bash-*|projects|session-env|shell-snapshots)
          for x in "${files[@]}"; do [ "$x" = "$w" ] || { wtgt "${x%/}/${w##*/}" && wdeny; }; done;; esac; done;; esac
      done < <(grep -oE "$AT"'([^ ]*/)?(cp|mv|ln|install|rsync|tee|sed|dd)[[:space:]]+[^;&|]*' <<<"$txt")
      while IFS= read -r inv; do   # git -C ~/dev/<repo> checkout|apply|stash|… rewrites that tree as surely as cp does
        [[ $inv =~ (^|[^A-Za-z0-9_.-])git[[:space:]]+(.*)$ ]] || continue; read -r -a a <<<"${BASH_REMATCH[2]}"; skip=""; dirs=(); verb=""
        for x in "${a[@]}"; do
          if [ -n "$skip" ]; then [ "$skip" = d ] && dirs+=("$x"); skip=""; continue; fi
          case "$x" in -C) skip=d;; -c|--git-dir|--work-tree) skip=x;; -*) ;; *) verb=$x; break;; esac; done
        case "$verb" in add|am|apply|checkout|cherry-pick|clean|commit|merge|mv|pull|rebase|reset|restore|revert|rm|stash|switch|worktree|submodule|update-ref|symbolic-ref)
          for x in "${dirs[@]}"; do wtgt "$x" && wdeny; done;; esac
      done < <(grep -oE "$AT"'([^ ]*/)?git[[:space:]]+-C[[:space:]]+[^;&|]*' <<<"$txt")
      # …and the removal verbs over the one directory rmtgt fences. `mv` is in both lists on purpose: the write
      # scan above judges where it puts a file, this one judges what it takes away. `find` counts only when the
      # invocation carries an action that deletes or runs something — a bare `find` reads.
      while IFS= read -r inv; do
        [[ $inv =~ (^|[^A-Za-z0-9_.-])(rm|rmdir|unlink|shred|truncate|mv|find)[[:space:]]+(.*)$ ]] || continue
        v=${BASH_REMATCH[2]}; read -r -a a <<<"${BASH_REMATCH[3]}"; files=(); skip=""
        [ "$v" != find ] || case " ${a[*]} " in *" -delete "*|*" -exec "*|*" -execdir "*|*" -ok "*) ;; *) continue;; esac
        for x in "${a[@]}"; do
          if [ -n "$skip" ]; then skip=""; continue; fi
          case "$x" in -s|--size|-n|--iterations|-t|--target-directory) skip=1;;
            -*) [ "$v" != find ] || break;;                 # find's paths come first; past the first predicate there are none
            *) files+=("$x");; esac; done
        for x in "${files[@]}"; do rmtgt "$x" && rmdeny; done
      done < <(grep -oE "$AT"'([^ ]*/)?(rm|rmdir|unlink|shred|truncate|mv|find)[[:space:]]+[^;&|]*' <<<"$txt")
    }
    # No cd anywhere in the command = the haystack is one pass, exactly as before. With one, each LINE is walked
    # statement by statement instead, so a target is judged against the dir the cd before it moved to. A cd inside
    # a subshell moves $wbase for the rest of the line as well: over-strict, and never the other way round.
    # $wbase IS PER PAYLOAD, NOT PER LINE. A newline is not a cd back: `cd ~/dev/other &&` + newline + `echo pwn > f`
    # (and the `;` and backslash-continuation spellings) resolved f against the payload's own cwd and passed, because
    # the walk reset the base on every line (2nd adversarial review of #243). A cd on line 1 governs line 2.
    # $wstack IS pushd's DIRECTORY STACK, so popd goes back where pushd came from — untracked, popd left the base
    # at the pushd'd dir and `pushd ~/dev/other; pushd /tmp; popd; echo pwn > f` passed. An empty stack and a slot
    # (`popd +1`) are unresolvable: the base is emptied and a later relative write is refused.
    # ONLY A STATEMENT LINE MOVES THE SHELL. The haystack carries the walk's SUFFIXES too, and a suffix is argument
    # text: `git commit -m "cd /tmp"` puts `cd /tmp` on a line of its own, which cancelled a real cd into another
    # repo and let the write after it through, while `git commit -m "popd broke the build"` emptied the base and
    # refused an ordinary write (3rd adversarial review of #243). cmdpos marks the statement lines with a \001;
    # everything else is walked for WRITES, which is what a wrapper's suffix is there for, and never for a cd.
    # THE PREFIX IS $AT's WRAPPER LIST, plus `builtin`: `command cd ~/dev/other && echo pwn > f` and the `builtin`
    # spelling both move the shell and neither was tracked, because the prefix took only `(`, `{` and VAR= (same
    # review). `bash -c "cd ~/dev/other; …"` moves the shell it starts, which is the one that does the writing.
    # TWO KNOWN COSTS, DOCUMENTED RATHER THAN FIXED: `cd "$VAR" && <relative write>` is refused by design — the cd
    # cannot be resolved, so where the write lands is unknown, and with the base per payload that now holds for a
    # write on a LATER line too — and `git commit -m x\;\ cc-land\ 7` is refused because unesc splits on the escaped
    # space. Both are over-strict, which is the safe way to be wrong.
    # …AND SO ARE THE COMPOUND KEYWORDS AND AN OPTION WORD. `if cd ~/dev/other; then <write>; fi`, the `while`,
    # `until` and `!` spellings, and an option between a wrapper and the cd (`command -p cd`, `time -p cd`) all
    # moved the shell with none of them tracked (4th adversarial review of #243). An option is any -word here:
    # a fixed list of them is the wrapper list again, one round later.
    # …AND A REDIRECTION IS ONE TOO. `>/dev/null cd ~/dev/other; echo pwn > f` moves the shell and the prefix
    # stopped at the `>` (5th adversarial review of #243). The alternative carries its target, spelled glued or
    # spaced, and is written with character classes alone so the group numbers below do not shift.
    # `{fd}>file` IS A REDIRECTION TOO, and `2>&1` is one the `&` split cuts in half — `{fd}>/dev/null cd
    # ~/dev/other` and `2>&1 cd ~/dev/other` both moved the shell untracked, the second leaving the piece
    # `1 cd …` behind (6th adversarial review of #243). The named-descriptor form is spelled out, and a piece
    # that starts with what the split left of a `N>&M` — bare digits, or the `-` of `2>&-` — is stepped over.
    WCDW='(then|else|elif|do|if|while|until|!|time|env|nohup|xargs|command|builtin|eval|exec|sudo|bash|sh|[0-9]*[<>][<>]?[|&]?[[:space:]]*[^[:space:]]*|\{[A-Za-z_][A-Za-z0-9_]*\}[<>][<>]?[|&]?[[:space:]]*[^[:space:]]*|[0-9-]+|-[A-Za-z][A-Za-z-]*|[A-Za-z_][A-Za-z0-9_]*=[^[:space:]]*)'
    WCDRE="^[[:space:]]*[({]?[[:space:]]*(${WCDW}[[:space:]]+)*(cd|pushd|popd)([[:space:]]+(.*))?\$"
    WISH='(^|[[:space:]])(bash|sh)([[:space:]]|$)'   # a cd behind one of these runs in a CHILD shell, not this one
    wspush(){ wsB+=("$wbase"); wsN+=("${#wstack[@]}"); wsS+=("$(printf '%s\n' ${wstack[@]+"${wstack[@]}"})"); }
    wspop(){ local k=$(( ${#wsB[@]} - 1 )); [ "$k" -ge 0 ] || return   # give the base back to the enclosing shell
             wbase=${wsB[k]}; if [ "${wsN[k]}" -eq 0 ]; then wstack=(); else mapfile -t wstack <<<"${wsS[k]}"; fi
             unset "wsB[$k]" "wsN[$k]" "wsS[$k]"; }
    wigive(){ [ -n "$wihave" ] || return   # the interpreter's child shell has ended: the real shell never moved
              wbase=$wisave; if [ "${wisN:-0}" -eq 0 ]; then wstack=(); else mapfile -t wstack <<<"$wisS"; fi; wihave=""; }
    # A STATEMENT IS ONE STRING FOR THE WRITE FENCE, WHATEVER IT HAS A SUBSTITUTION IN THE MIDDLE OF. $wacc builds
    # it back up across the pieces the split made; $wsb is the base it STARTED with, which is where its
    # redirections and arguments are expanded (see the cd/redirection note below). The pair is stacked the way
    # $wbase is: a substitution's interior is a statement of its own, and the enclosing one resumes after the `)`.
    wapush(){ waccS+=("$wacc"); wsbS+=("$wsb"); wacc=""; }
    wapop(){ local k=$(( ${#waccS[@]} - 1 )); [ "$k" -ge 0 ] || return
             wacc=${waccS[k]}; wsb=${wsbS[k]}; unset "waccS[$k]" "wsbS[$k]"; }
    wsflush(){ [ -n "$wacc" ] || return   # the statement is complete: judge it whole, where it began
               local sv=$wbase; wbase=$wsb; wscan "$wacc"; wbase=$sv; wacc=""; }
    if grep -qE '(^|[^A-Za-z0-9_.-])(cd|pushd|popd)([[:space:]]|$)' <<<"$cmd"; then
      wstack=(); wpre=$cwd; wsnap=(); wfstack=(); wflat=$cwd; wraw=""
      while IFS= read -r wln; do
        # A DOUBLED MARK IS A REWIND, NOT A STATEMENT: cmdpos prints one in front of the RAW reading of a line it
        # has already emitted quote-aware, so the two readings are not two statements the shell ran one after
        # the other. Without it the same RELATIVE cd moved the base twice (see cmdpos, and case 21b). The base
        # and the pushd stack go back to where the line started; whichever reading MOVES them is the one kept.
        wsl=""
        case "$wln" in
          $'\001\001') wraw=1; wflat=$wbase; wfstack=("${wstack[@]}"); wbase=$wpre; wstack=("${wsnap[@]}"); continue;;
          $'\001'*) wsl=1; wln=${wln#$'\001'}                     # a statement, not a suffix: see above
            [ -n "$wraw" ] || { wpre=$wbase; wsnap=("${wstack[@]}"); };;
        esac
        # A SUBSTITUTION IS A SHELL OF ITS OWN, AND ITS cd MOVES THE WRITES INSIDE IT. `echo $(cd ~/dev/other &&
        # echo pwn > f)`, the backtick spelling and `cat <(cd …; echo pwn > f)` were one statement whose first
        # word was `echo`, so the cd was never tracked and the write resolved against the session's own tree
        # (4th adversarial review of #243). The opener stays on the OUTER statement — `cd $(…)` must still read
        # as a destination this cannot resolve — and the interior starts a statement, the way `(` already does.
        # A BRACE, A CLOSING PAREN AND A FUNCTION BODY END A STATEMENT AS SURELY AS A `;` DOES, and any token in
        # front of the cd that is not a wrapper hid it: `case $x in *) cd ~/bin;; esac`, `f() { cd ~/bin; }`, its
        # `function f { … }` spelling, `time { cd …; }` and `while :; do { cd …; break; }; done` each moved the
        # real shell untracked (5th adversarial review of #243). A `{` counts only when a space follows it and a
        # `}` only when one precedes it — that is what makes a command GROUP, and it leaves `${VAR}`, `{}` and a
        # brace expansion alone, which the cd walk must still read whole.
        wsub=${wln//'$('/$'$\n'}; wsub=${wsub//'<('/$'<\n'}; wsub=${wsub//'>('/$'>\n'}; wsub=${wsub//'`'/$'`\n'}
        wsub=${wsub//')'/$')\n'}; wsub=${wsub//'{ '/$'{\n'}; wsub=${wsub//' }'/$' }\n'}
        # THE `|` IN `>|` IS NOT A PIPE, and the split cut the redirection in half so its target landed on a
        # piece with no verb: `cd sub && cp /dev/null >| ~/bin/cc-guard` truncated a live binary while the same
        # line without the cd was refused — the `>|` half of the same orphaning as the substitutions above
        # (9th adversarial review of #243, found probing it). noclobber-override is a `>`, so it is spelled one.
        rdn "$wsub"; wsub=$rdt   # …and `2>&1`, `&>` and `>&` the same way (rdn)
        # A SUBSHELL'S cd MOVES THE WRITES INSIDE IT AND NOTHING AFTER. `( … )`, `$( … )`, `<( )`, `>( )`, a
        # backtick and an interpreter string (`sh -c '…'`) each start a shell of their own, so `cd ~/dev/other`
        # then `(cd /tmp)` then `echo pwn > f` wrote the real repo while a benign subshell's /tmp carried out of
        # it and masked the real cd — the write passed (7th adversarial review of #243). The base is saved at
        # each opener and given back at the close, so the moved base applies only inside: case 28 still refuses,
        # its write is inside the same subshell. The paren/backtick stack is per pass (an unclosed opener leaks
        # over-strict, as before); the interpreter give-back is per PIECE below.
        # A SUBSTITUTION OPENER AND A SUBSHELL OPENER ARE NOT ONE ENTRY. The split leaves `$(`, `<(`, `>(` and a
        # backtick at the END of their piece, so the text in front of them is the OUTER shell's, while a bare `(`
        # comes FIRST and the text after it is the inner shell's. Sharing one flag pushed both before the piece
        # was read, so `cd $(echo ~/dev/other) && echo pwn > f` emptied the base on the piece `cd $` — correctly,
        # a destination this cannot resolve — and the `)` that closed the substitution then handed the PRE-cd
        # base back, and the write passed (8th adversarial review of #243). A `(` still pushes first; a
        # substitution opener pushes after the cd, so what its `)` pops is the base the cd left.
        # …AND ITS INTERIOR RUNS BEFORE THAT cd. A REDIRECTION IS EXPANDED FIRST: `cd sub > $(cp /dev/null
        # ../other/f)` runs the cp in the dir the line started in, not in `sub`, so judging the interior against
        # the moved base let a write into another repo through (8th adversarial review of #243, same round). The
        # interior is handed the base the PIECE started with; only what the `)` pops is the base the cd left.
        # THE SPLIT IS THE cd WALK'S, AND THE WRITE FENCE MUST NOT SEE IT. Scanning each piece on its own orphaned
        # a destination from its verb whenever a substitution stood between them: `cd sub && cp $(echo /dev/null)
        # ~/bin/cc-guard` left ` ~/bin/cc-guard` as a piece with no cp and no redirection in it, so the fence had
        # nothing to judge and a live binary was truncated — while the same line WITHOUT a cd took the whole-line
        # path below and was refused, so any command carrying the word `cd` turned the fence off for this shape
        # (9th adversarial review of #243). The statement is put back together in $wacc with each substitution
        # reduced to a bare `$`, which is a placeholder no path can be resolved through (`cp a $(pwd)/b` stays
        # the unresolvable target it always was), and the interior is walked as the statement it is, as before.
        # A piece ENDS ITS STATEMENT unless it ends at a substitution boundary — that is what $wsubo and $wclose
        # already say, so no new marker is needed and none can be forged into the command text.
        wsB=(); wsN=(); wsS=(); wbt=0; wihave=""; wacc=""; wsb=$wbase; waccS=(); wsbS=()
        while IFS= read -r wst; do
          [ -n "$wst" ] || continue
          wopen=""; wclose=""; wsubo=""
          case "$wst" in *'`') if [ "$wbt" = 0 ]; then wsubo=1; wbt=1; else wclose=1; wbt=0; fi;; esac
          case "$wst" in *'$'|*'<'|*'>') wsubo=1;; esac        # the split left $( , <( or >( — the interior is its own shell
          [[ $wst =~ ^[[:space:]]*\( ]] && wopen=1             # a bare ( subshell: this piece's text is INSIDE it
          case "$wst" in *')') wclose=1;; esac                # …closed by the ) the split left on the piece
          [ -n "$wopen" ] && { wspush; wapush; }             # a `(` opens before the piece's text: that text is inside it
          wbpre=$wbase; wspre=("${wstack[@]}")               # where this piece STARTED: what a substitution in it inherits
          # The backtick that CLOSED the substitution is the last character of the statement, and it rode along
          # into the target: `> f` + backtick read as a write to a name with a backtick in it, which wtgt calls
          # unresolvable and waves through. It is a boundary, not part of a name, so it comes off the text the
          # write fence reads — and stays on the text WCDRE reads, where `cd` + backtick must stay unresolvable.
          # The `)` that closed one is the same kind of boundary, and now that the statement is read whole it
          # would land in the MIDDLE of it, so it comes off too.
          wtx=${wst%\`}; wtx=${wtx%)}
          [ -n "$wsubo" ] && { case "$wtx" in *['$<>']) wtx=${wtx%?};; esac; wtx=$wtx'$'; }
          [ -n "$wacc" ] || wsb=$wbase                       # …the base the statement is expanded in
          wacc=$wacc$wtx
          if [ -n "$wsl" ] && [[ $wst =~ $WCDRE ]]; then
            wv=${BASH_REMATCH[3]}; wargs=${BASH_REMATCH[5]:-}; wpfx=${wst%"${BASH_REMATCH[3]}${BASH_REMATCH[4]}"}   # the wrappers in front of the verb
            if [[ $wpfx =~ $WISH ]]; then [ -n "$wihave" ] || { wisave=$wbase; wisN=${#wstack[@]}; wisS=$(printf '%s\n' ${wstack[@]+"${wstack[@]}"}); wihave=1; }   # a child-shell cd: remember the base to give back
            else wihave=""; fi                                # a real cd is where the shell now stands: it cancels the give-back
            read -r -a wa <<<"$wargs"; wt=""; wun=""; wn=""
            for x in "${wa[@]}"; do case "$x" in
                # `-` is $OLDPWD and `~-` is the same dir; `+N`/`-N` are slots of a stack this only half sees.
                # All were skipped as OPTIONS, so `cd -` read as `cd` and moved the base to $HOME while the real
                # shell went back to the repo it came from: the write after it passed (2nd adversarial review).
                -|'~-'|+[0-9]*|-[0-9]*) wun=1; break;;
                -n) wn=1;;                    # popd's "stack only": the one option that is not just noise here
                -*|'>'*|'<'*|[0-9]*'>'*) ;;   # an option or a redirection (`popd >/dev/null`): not a destination
                *) wt=$x; break;; esac; done
            case "$wv" in
              # `popd -n` TAKES A DIRECTORY OFF THE STACK AND LEAVES THE SHELL WHERE IT IS — bash suppresses the
              # cd — so `pushd ~/dev/other; popd -n; echo pwn > f` was read as a popd BACK and the write went
              # through while the shell stood in the other repo (3rd adversarial review of #243).
              popd) if [ -n "$wn" ]; then [ ${#wstack[@]} -eq 0 ] || unset 'wstack[-1]'
                    elif [ -n "$wun" ] || [ -n "$wt" ] || [ ${#wstack[@]} -eq 0 ]; then wbase=""
                    else wbase=${wstack[-1]}; unset 'wstack[-1]'; fi;;
              pushd) wstack+=("$wbase")   # …even when the new dir is unresolvable: the STACK still grew
                    if [ -n "$wun" ] || [ -z "$wt" ]; then wbase=""   # `pushd` alone swaps a top this cannot see
                    else wbase=$(wcd "$wt") || wbase=""; fi;;
              *) if [ -n "$wun" ]; then wbase=""; else wbase=$(wcd "$wt") || wbase=""; fi;;
            esac
          fi
          # THE GIVE-BACK IS THE PIECE'S, NOT THE LINE'S. Deferred to the end of the source line, a benign
          # interpreter cd masked a real one for every statement after it on that line: `cd ~/bin && sh -c 'cd
          # /tmp' && cp /dev/null cc-guard` left the base at /tmp when the cp was scanned, so the target resolved
          # to /tmp/cc-guard and passed while the shell truncated the live binary (8th adversarial review of
          # #243). The child shell ends with its own piece, so the base goes back there. The RAW re-reading keeps
          # the end-of-pass give-back: strip() takes the interpreter string's quotes off, so the statements
          # inside it become pieces of the same line and the child shell has not ended — case 28 refuses there.
          [ -z "$wraw" ] && wigive
          if [ -n "$wsubo" ]; then wapush   # …after the cd (the opener is at the END of the piece), and the interior runs before it
            wspush; wbase=$wbpre; wstack=("${wspre[@]}")
          elif [ -n "$wclose" ]; then wsflush; wapop; wspop   # the interior statement ends at its `)`; the enclosing one resumes
          else wsflush; fi                                   # a ; & | { } or the end of the line ends the statement
        done <<<"${wsub//[;&|]/$'\n'}"
        wsflush; while [ ${#waccS[@]} -gt 0 ]; do wapop; wsflush; done   # …and so does the line, however unbalanced it was
        wigive   # the raw re-reading's pieces have ended: give the interpreter's base back
        if [ -n "$wraw" ]; then   # the re-reading is done: it moved nothing, so the quote-aware reading stands
          [ "$wbase" = "$wpre" ] && [ "${wstack[*]}" = "${wsnap[*]}" ] && { wbase=$wflat; wstack=("${wfstack[@]}"); }
          wraw=""
        fi
      done <<<"$uk"
      wbase=$cwd
    else wscan "$cmd"; fi
    [ -n "$pfonly" ] && { argv_layer; exit 0; }   # the ungated tier: the write walk above, then the argv layer's pf (pfonly)
    argv_layer   # last: every judge above has let this call through (see argv_layer)
    ;;
  Read|NotebookRead|Grep|Glob)   # gating these files in Bash alone would be theatre if a file-reading TOOL served them
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // .tool_input.path // ""' <<<"$inp")
    # Claude Code expands a leading ~ and reads a relative path from the session's cwd, not the hook's, so this
    # does too: `~/.cc/slack` and `../../.cc` are the same dirs as their absolute spellings.
    # shellcheck disable=SC2088 # the quoted ~ matches a literal leading tilde in a tool path
    case "$fp" in '~'|'~/'*) fp=$HOME${fp#\~};; /*|'') ;; *) fp=$cwd/$fp;; esac
    [ -n "$fp" ] && fp=$(realpath -m -- "$fp" 2>/dev/null || echo "$fp")
    if [ "$role" = member ]; then secret_path "$fp" && never "reading the box's secrets ($fp)"
      case "$tool" in Grep|Glob) [ -n "$fp" ] && secret_below "$fp" \
        && never "searching a dir that holds the box's secrets ($fp) — search your own dir, or one that holds none of them";; esac
    else secret_all "$fp" && never "reading the box's credentials ($fp)"; fi ;;
  Edit|Write|MultiEdit|NotebookEdit)
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$inp")
    fp=$(realpath -m -- "${fp:-/}" 2>/dev/null || echo "$fp")   # ../ AND a symlink resolve before the match: ~/bin/x IS ~/dev/<repo>/core/bin/x, and so is a symlink farm in /tmp
    linput "$fp" && ldeny   # every tier: a transcript, the seat's memory and a shell startup file are launch inputs, named before pstate's broader reason
    if pstate "$fp" && ! pseat; then phit=$fp; pdeny; fi   # every tier, and before in_root: a root that covers ~/.cc/state is no exemption
    # …and ~/.cc/config's CC_WORKER_SANDBOX the same way (see sbxdeny): a Write or Edit that names it, at every tier,
    # or an Edit that, replayed on the file as it stands, changes a line that sets it — the replay only where the
    # worktree fence below lets the edit through, since at a gated tier that fence refuses every edit of the file
    sbxisc "$fp" && ! pseat && { grep -qF CC_WORKER_SANDBOX <<<"$inp" || { { [ -n "$pfonly" ] || in_root "$fp"; } && sbxedit; }; } \
      && { sbxhit="the $tool tool on ~/.cc/config"; sbxdeny; }
    [ -n "$pfonly" ] && exit 0   # the ungated tier meets this one path check and nothing else
    # A MEMBER MARKER IS WRITTEN BY NO SESSION (perms, #937: "Refuse writes to .cc/member-* from sessions"): see
    # marker() in cc-guard-argv, which refuses the Bash spellings.
    case "$role:$fp" in member:*/.cc/member-*|worker:*/.cc/member-*)
      never "writing a member marker ($fp) — .cc/member-facing and .cc/member-workspace are the host's to write";; esac
    case "$role:$fp" in member:"$HOME"/.cc/library/owner/callers|member:"$HOME"/.cc/library/owner/callers/*|worker:"$HOME"/.cc/library/owner/callers|worker:"$HOME"/.cc/library/owner/callers/*)
      never "writing cc-lib's caller records ($fp) — the guard writes them (ccrec), and they decide who sees the Slack copy";; esac
    if ! in_root "$fp"; then case "$fp" in    # inside the worktree (rule 5: the marker root, not the cwd) / the member's own dir: fine
      /tmp/*) ;;                                   # scratch: fine
      "$HOME"/.cc/tmp/*) ;;                        # scratch on disk: the TMPDIR cc and the units hand every session, Claude Code's scratchpad under it
      "$HOME"/.claude/projects/*/memory/*)   # its own notes: claude saves them there, and both sandboxes bind that dir rw
        # So the write was always meant to land and only this rule said no — a member-facing session was refused
        # every note it tried to save (2026-09-04). The dir is named for the project ROOT, not the cwd, so it is
        # matched against this session's own roots: another project's notes are still somebody else's.
        m=${fp#"$HOME"/.claude/projects/}; m=${m%%/*}; mine=""
        for d in "$root" "$mdir" "${trepo:+$HOME/dev/$trepo}"; do
          [ -n "$d" ] && [ "$m" = "$(printf '%s' "$d" | tr '/.' '--')" ] && mine=1
        done
        [ -n "$mine" ] || never "writing another project's notes ($fp) — this session's are under ~/.claude/projects/<its own project dir>/memory" quiet;;
      "$HOME"/.cc/state/*)   # track state: this track's own; a member workspace's for the tracks that are its own
        if [ "$role" = member ]; then
          own=""; [ -n "$mws" ] && case "$fp" in "$HOME/.cc/state/$mws"|"$HOME/.cc/state/$mws"/*) own=1;; esac
          [ -n "$own" ] || never "writing another session's state ($fp) — a task.md there is work the box would run" quiet
        elif [ -n "$trepo" ]; then case "$fp" in "$HOME/.cc/state/$trepo/$ttrack"|"$HOME/.cc/state/$trepo/$ttrack"/*) ;;
          # THE TWO DOORS GIVE THE SAME ANSWER. ~/.cc/state/<repo>/improve/proposals is the improve orch's shared
          # ledger — cc-improve writes it from whichever track runs a trial — and the Bash door has always let a
          # `cp` land there (wtgt fences ~/dev, ~/bin and ~/.cc/state/arch, not the rest of a track's state),
          # while this one refused the Write tool the same bytes as "another track's state": one turn, and a
          # workaround every improve trial would repeat (row raised-cc-guard-refuses-the-write-tool-into-the-
          # improve-proposals-dir, 2026-09-15). This session's OWN repo's, matching what cp already reaches;
          # another repo's, and every other track's state dir, are refused exactly as before.
          "$HOME/.cc/state/$trepo/improve/proposals"|"$HOME/.cc/state/$trepo/improve/proposals"/*) ;;
          # A WORKSPACE HANDED OVER FROM AN EARLIER TRACK IS WRITABLE THROUGH BOTH DOORS. A brief named
          # ~/.cc/state/chip-flow/ladder-small-rungs/ws as its workspaces: the gate commits and bench files went in
          # through Bash, and this door refused the layout-writer's and the fixer's Write calls in the same dir —
          # three designs stopped at P5/P6 after ~$30 (row raised-guard-blocks-inherited-ws, 2026-10-12). "The guard
          # lets some writes to the same dir through and refuses others, so a brief can't tell ahead of time
          # whether a handed-over workspace is usable." So a SUBDIRECTORY of another track's dir in this repo is
          # writable here as it is to cp. The track's own top-level files (task.md is work the box would run,
          # progress.md, pr-body.md…) and runs/ (the loop's spend records) stay refused, as does another repo.
          # runs/ is matched right under the track dir only: a case `*` crosses `/`, so `*/runs/*` also refused a
          # bench's own <track>/ws/uart/runs/sim.log, which cp lands. A top-level file has one `/` after the repo,
          # so it never reaches this arm, whose `*/*/*` needs two.
          "$HOME/.cc/state/$trepo"/*/*/*)
            wrest=${fp#"$HOME/.cc/state/$trepo"/}; wrest=${wrest#*/}   # what follows <track>/
            case "$wrest" in runs/*) never "writing another track's run records ($fp) — this track's state is ~/.cc/state/$trepo/$ttrack" quiet;; esac;;
          *) never "writing another track's state ($fp) — this track's is ~/.cc/state/$trepo/$ttrack; a workspace in a subdirectory of another track's dir is writable, its top-level files are not" quiet;; esac
        fi;;
      *) never "editing outside this session's worktree ($fp) — a track writes its worktree, /tmp, ~/.cc/tmp and its own ~/.cc/state dir" quiet;;
    esac; fi ;;
esac
exit 0
