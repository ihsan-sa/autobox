#!/usr/bin/env bash
# cc-guard — PreToolUse hook: deterministic human gates for AUTONOMOUS and MEMBER-FACING sessions.
# Applies when CC_ROLE=worker|member is set, or the session cwd is under a dir marked .cc/track (a cc track
# worktree, role=worker) or .cc/member-facing (a session anybody in a Slack channel can talk to, role=member) —
# so interactive TRACK sessions are gated too (intended); plain operator/planning sessions are not.
# The MARKER is the truth: CC_ROLE is only a convenience, the walk works with no env at all.
# Denies (exit 2 + reason) the four owner gates:
#   1. merge to default branch / deploy      2. external comms in owner's name
#   3. destructive / infra ops               4. (spend is enforced by --max-budget-usd on headless workers)
# EVERY gated role, worker included: no container runtime (this user is in group `docker`, which is root-equivalent)
# and no reading the two files that ARE the box's credentials (~/.claude/.credentials.json, ~/ccbox/env).
# role=member = every worker gate PLUS: no dispatching workers, no reading the box's other secrets, no re-wiring Slack.
# A MEMBER WORKSPACE (~/dev/<handle>/.cc/member-workspace, and any track of it) is the one exception: it dispatches
# workers and makes tracks INSIDE itself and nowhere else — docs/design-member-workspaces.md.
# It also gates whichever session is NOT live during an overlapping handoff (cc-handoff), by session id and
# by $CC_HANDOFF rather than by a marker: the two sessions share one cwd, so the walk below cannot tell them apart.
set -uo pipefail
# No jq = no cwd, so no marker walk either: fail CLOSED on the role we do know from the env (cc sets it for both).
command -v jq >/dev/null 2>&1 || { case "${CC_ROLE:-}${CC_HANDOFF:+ handoff}" in *worker*|*member*|*handoff*) echo "cc-guard: jq is missing (broken PATH?) — the gates cannot be evaluated, so the call is refused" >&2; exit 2;; esac; exit 0; }
inp=$(cat); tool=$(jq -r '.tool_name // ""' <<<"$inp"); cwd=$(jq -r '.cwd // ""' <<<"$inp"); cwd=$(realpath -m -- "${cwd:-/}" 2>/dev/null || echo "$cwd")
# A command position: start, after a separator/substitution, or after wrapper words that hide the real command
# (then/xargs/env/nohup/bash -c/VAR=…). Quotes are stripped from the haystack first, so "gh pr merge" is seen too.
AT='(^|[;&|(){}`]|\$\() *(((then|else|elif|do|time|env|nohup|xargs|command|eval|exec|sudo|bash|sh|-c)|[A-Za-z_][A-Za-z0-9_]*=[^ ]*) +)*'
# A HEREDOC BODY IS DATA, NOT A COMMAND. The rules grep raw text, so a brief, a journal entry or a commit
# message that merely NAMES a forbidden command was refused for containing it — writing the brief for this fix
# was itself blocked that way. So heredoc bodies are dropped before matching. Quoted strings are NOT dropped:
# `bash -c "…"` is a real command and must still be seen. Two fences keep the drop honest: a body goes only if
# its terminator really appears later (an unterminated `<<` swallows nothing), and never when anything on the
# same line could EXECUTE it — an interpreter, eval, xargs, ssh, sudo fed a heredoc really does run its body,
# and that is the one case where the body IS the command. Both fail CLOSED, back to matching the raw text.
X='(^|[;&|(){}`]|[$][(])[ \t]*(((then|else|do|time|env|nohup|xargs|command|sudo)|[A-Za-z_][A-Za-z0-9_]*=[^ \t]+)[ \t]+)*([^ \t]*/)?(bash|sh|zsh|ksh|dash|python[0-9.]*|perl|ruby|node|php|awk|sed|eval|exec|source|[.]|xargs|env|ssh|sudo|systemd-run)([ \t]|$)'
hay(){   # the text the rules match: heredoc bodies out, quotes stripped
  local c=$1
  case "$c" in *'<<'*) c=$(awk -v X="$X" '
      { L[NR] = $0 }
      END { b = 0
        for (i = 1; i <= NR; i++) {
          if (b) { if (L[i] ~ t) b = 0; continue }
          print L[i]                                        # the line that OPENS a heredoc is still a command
          n = index(L[i], "<<"); if (n == 0) continue
          head = substr(L[i], 1, n - 1); rest = substr(L[i], n + 2)
          if (index(rest, "<<") > 0) continue               # two on one line: too clever to reason about
          if (!match(rest, "^-?[ \t]*[\"\047]?[A-Za-z_][A-Za-z0-9_]*")) continue   # `<<<` and shifts are not heredocs
          w = substr(rest, RSTART, RLENGTH); sub("^-?[ \t]*[\"\047]?", "", w)
          if (head ~ X) continue                            # the body would be RUN: it stays in the haystack
          t = "^[ \t]*" w "[ \t]*$"
          for (j = i + 1; j <= NR; j++) if (L[j] ~ t) { b = 1; break }
        } }' <<<"$c");; esac
  c=${c//\"/}; printf '%s' "${c//\'/}"
}
if [ "$tool" = Bash ]; then   # universal gate, ALL sessions (interactive ones and their subagents included): nothing may kill the shared tmux server
  u=$(hay "$(jq -r '.tool_input.command // ""' <<<"$inp")")
  { grep -qE "$AT"'(tmux +kill-se[rs]|(pkill|killall)( +-[^ ]+)* +tmux|systemctl +--user +(restart|stop|kill) +tmux-main)' <<<"$u" \
    || grep -qE 'send-keys[^;&|]*tmux +kill-se[rs]' <<<"$u"; } && { echo "cc-guard: blocked — that takes the shared tmux server (every session on the box) down (\$TMUX beats TMUX_TMPDIR; use tmux -S <path> for scratch servers)" >&2; exit 2; }   # `tmux -S <path> kill-server` still passes: the pattern wants kill-se* right after tmux
fi
role="${CC_ROLE:-}"; mdir=""; mws=""
d="$cwd"                         # walk up for a marker — one stat per level, no config to parse. A marker only makes the
while [ -n "$d" ] && [ "$d" != / ]; do   # gates STRICTER (member wins over an inherited CC_ROLE=worker) and never clears the env role.
  if [ -f "$d/.cc/member-facing" ]; then role=member; mdir="$d"
    # A MEMBER WORKSPACE root: see below. Its handle is the DIRECTORY NAME — ~/dev/<handle>, nothing else — and
    # never the marker's contents: every file under this dir is the member's own to edit, so a handle read out of
    # one is a handle the session can rewrite (one line naming the box's repo would hand it that repo's authority).
    [ -f "$d/.cc/member-workspace" ] && [ "$d" = "$HOME/dev/${d##*/}" ] && mws=${d##*/}
    break; fi   # a session anybody in Slack can talk to
  if [ -f "$d/.cc/track" ]; then
    # A TRACK WORKTREE LIVES UNDER ~/.cc/worktrees/<repo>/<track> — `cc` makes them nowhere else — and ONLY THERE does
    # .cc/track mean anything. Anywhere else it is a file somebody wrote, and the walk goes on past it to whatever
    # marker sits above: honouring one in ~/dev/<h>/sub set role=worker there and handed that member the worker
    # tier — the box's config and another repo's dispatch (review 2, C).
    # A TRACK OF A MEMBER WORKSPACE IS STILL THAT MEMBER'S WORLD. The worktree lives under ~/.cc/worktrees, so its
    # own marker says "worker" and would PROMOTE a member's worker out of the member tier — the one thing the
    # workspace rule below must not allow. The rule follows the repo, not the worktree.
    # WHICH repo comes from the worktree's PATH ($HOME/.cc/worktrees/<repo>/<track>), not from .cc/track: that
    # file is inside the tree the worker may edit, so its first line is a claim, not an identity.
    r=""; case "$d" in "$HOME"/.cc/worktrees/*/*) r=${d#"$HOME"/.cc/worktrees/}; r=${r%%/*};; *) d=$(dirname "$d"); continue;; esac
    case "$r" in *[!A-Za-z0-9._-]*) r="";; esac
    if [ -n "$r" ] && [ -f "$HOME/dev/$r/.cc/member-workspace" ]; then
      role=member; mdir="$HOME/dev/$r"; mws="$r"
    else [ "$role" = member ] || role=worker; fi
    break; fi
  d=$(dirname "$d"); done
case "$mws" in *[!a-z0-9-]*) mws="";; esac   # the handle goes into a regex below: [a-z0-9-] or nothing at all
# $mdir is the member-facing session dir, and its basename is its Slack channel: the refusal below is posted there.
# An OVERLAPPING HANDOFF (cc-handoff): two sessions share this cwd, and exactly one of them is LIVE. The other
# may read, search, think and ask its peer — it may not act on the world. A marker file could not do this: the
# walk above is keyed on the cwd, which both sessions share, so it would gate the live one too. The keys here
# are per-session instead — the payload's session_id for the predecessor (already running when the overlap
# opened, so nothing could be put in its env) and $CC_HANDOFF for the successor (`cc __runnext` exports it;
# the hook is a child of the claude process, not of the Bash tool, so the model cannot unset it).
# SYMMETRIC ON PURPOSE: after cutover the PREDECESSOR is the non-live one, and a retired session that lingers
# must not push a stale branch. Every unreadable case falls the same way — the successor is gated, the
# predecessor is not — so a broken record can never leave the channel ownerless.
handoff_gated=""
if [ -n "${CC_HANDOFF:-}" ] || [ -d "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}" ]; then
  sid=$(jq -r '.session_id // ""' <<<"$inp"); seen=""
  for rec in "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}"/*.json; do
    [ -f "$rec" ] || continue
    v=$(jq -r --arg sid "$sid" --arg hid "${CC_HANDOFF:-}" '
      if ((.id // "") == "" or (.target // "") == "") then "" else
        (if .live == "successor" then "successor" else "predecessor" end) as $l |
        (if $l == "successor" then "predecessor" else "successor" end) as $o |
        if ($hid != "" and .id == $hid) then (if $l == "successor" then "mine" else "mine gate" end)
        elif ($sid != "" and ((.[$o].session_id // "") == $sid)) then "gate"
        else "" end
      end' "$rec" 2>/dev/null) || v=""
    case " $v " in *" mine "*) seen=1;; esac
    case " $v " in *" gate "*) handoff_gated=1;; esac
  done
  # $CC_HANDOFF with no record to justify it (missing, corrupt, unreadable) = the successor stays gated —
  # UNLESS the handoff FINISHED. `cc-handoff --retire` ends with clear(), so a record that is gone because
  # everything went RIGHT looks exactly like one lost because something went WRONG; retirement therefore
  # leaves a <id>.done marker first, and that marker is the whole difference. Without it the last step of a
  # handoff bricks the session that won it — 2026-08-31, the survivor lost dispatch, PRs and pushes for the
  # rest of its life, and could not even dispatch the fix for its own gate. Only ever WITHHOLDS the gate,
  # never lifts one: a session gated by the record of a LATER handoff stays gated by it.
  if [ -n "${CC_HANDOFF:-}" ] && [ -z "$seen" ]; then
    retired=""
    case "$CC_HANDOFF" in
      ""|*[!A-Za-z0-9_-]*) ;;   # not a record id, so never a path we build: a corrupt env gates like a corrupt record
      *) [ -f "${CC_HANDOFF_DIR:-$HOME/.cc/state/handoff}/$CC_HANDOFF.done" ] && retired=1;;
    esac
    [ -n "$retired" ] || handoff_gated=1
  fi
fi
[ -n "$handoff_gated" ] && [ "$role" != member ] && role=worker   # the four owner gates below, at least
case "$role" in worker|member) ;; *) exit 0;; esac
# A REFUSAL IN A MEMBER-FACING CHANNEL IS AN ASK, NOT A DEAD END. This is the only place that knows a member's
# request was stopped, and until now both halves ended here: the member saw nothing (one asked twice for images
# this gate refused) and the owner was never told there was anything to approve. A gate that stops work without
# producing a visible ask is indistinguishable from the box ignoring somebody. So a member-facing deny now emits
# BOTH, mechanically, instead of relying on the session to remember to: a 🔐 line in the member's own channel
# (the box's sweep marks a 🔐 message ❓ = needs you, so it also lands on the owner's tab) and a cc-notify
# escalation, which from a member-facing dir is delivered to the owner rather than routed back into that channel.
# WORKER AND HANDOFF DENIALS ARE UNTOUCHED — they have a board, a journal and a STATUS: BLOCKED line — and so are
# the owner's own channels, which are not member-facing sessions.
# Bounded three ways: nothing runs unless role=member, one ask per channel+reason per ASK_TTL (a session retrying
# a blocked command must not spray the channel), and `timeout` on both calls so a slow Slack cannot hang a hook.
ASKS="${CC_GUARD_ASKS:-$HOME/.cc/guard-asks}"; ASK_TTL="${CC_GUARD_ASK_TTL:-1800}"
ask_owner(){
  local why=$1 chan="" key f was now c bin
  [ -n "$mdir" ] && chan=${mdir##*/}
  if [ -n "$chan" ] && [ -f "$HOME/.cc/slack/provisioned.json" ]; then   # the dir's name and its channel's can differ
    c=$(jq -r --arg t "$chan" '.[$t].chan // empty' "$HOME/.cc/slack/provisioned.json" 2>/dev/null) || c=""
    [ -n "$c" ] && chan=$c
  fi
  now=$(date +%s); key=$(printf '%s\n%s' "${chan:-nochan}" "$why" | cksum | tr -cd '0-9')
  mkdir -p "$ASKS" 2>/dev/null || return 0
  f="$ASKS/$key"
  if [ -f "$f" ]; then
    was=$(cat "$f" 2>/dev/null) || was=0
    case "$was" in ''|*[!0-9]*) was=0;; esac
    [ $((now - was)) -lt "$ASK_TTL" ] && return 0    # already asked, and the owner has not had time to answer
  fi
  printf '%s\n' "$now" > "$f"
  bin="$HOME/bin"; [ -x "$bin/cc-slack" ] || bin=$(dirname -- "$0")
  # The member sees it. 🔐 is the box's own "nothing happens until the owner answers" form, and the sweep reads it.
  [ -n "$chan" ] && [ -x "$bin/cc-slack" ] && timeout 20 "$bin/cc-slack" post -c "#$chan" \
    "$(printf '🔐 I cannot do that part myself: %s.\nI have asked the owner to approve it — nothing more happens here until they do. Anything that needs no approval I am still doing.' "$why")" >/dev/null 2>&1
  bin="$HOME/bin"; [ -x "$bin/cc-notify" ] || bin=$(dirname -- "$0")
  # ...and the owner is told there is something to approve. --owner delivers it (a DM), never back into the channel.
  [ -x "$bin/cc-notify" ] && ( cd "${mdir:-/}" 2>/dev/null || cd /
    timeout 25 "$bin/cc-notify" --owner -p high \
      "$(printf 'Needs you: a member-facing session was refused — %s%s. I told them it is with you.' "$why" "${chan:+ (#$chan)}")" >/dev/null 2>&1 )
  return 0
}
deny(){ [ "$role" = member ] && ask_owner "$1"; echo "cc-guard: blocked — $1 (needs the owner; ask via cc-notify or note it on the board)" >&2; exit 2; }
denyh(){ echo "cc-guard: blocked — $1. This session is the NON-LIVE side of an overlapping handoff: read, search, think and ask your peer, but do not act on the world — and never ask the live session to run what you are denied." >&2; exit 2; }
ws_dispatch_ok(){   # EVERY dispatch in $1 names workspace $2 as its repo — and there is at least one to name.
  # `cc <ws> <track> --go` is a workspace's ONLY dispatch form: it is where the daily cap is charged (cc: member_gate).
  local c=$1 w=$2 all mine
  [ -n "$w" ] || return 1
  all=$(grep -oE '([^ ]*/)?cc +[A-Za-z0-9._-]+[^;&|]*--go\b' <<<"$c" | wc -l)
  mine=$(grep -oE "([^ ]*/)?cc +$w +[^;&|]*--go\b" <<<"$c" | wc -l)
  [ "$all" -gt 0 ] && [ "$all" = "$mine" ]
}
ws_cc_ok(){   # every `cc …` in $1 that NAMES A REPO names workspace $2 — sessions, board writes, done/rm/handoff.
  # "Inside its own workspace" has to cover CREATION too: `cc board add <other> …` seeds work on another repo and
  # `cc <other> <track>` builds a worktree and opens a session there, both as far outside as a dispatch is. Reads
  # (`cc board show`, `cc ls`, `cc digest`) are left alone — this rule is about what a workspace may make.
  local c=$1 w=$2 inv v r x ok=1; local -a a
  [ -n "$w" ] || return 1
  while IFS= read -r inv; do
    inv=${inv#*cc }; read -r -a a <<<"$inv"; v=${a[0]:-}; r=""
    case "$v" in
      board) r=${a[2]:-}; case "$r" in -*) r="";; esac;;   # every board verb takes the repo there: reading another one is outside too
      done|rm|handoff|-c) for x in "${a[@]:1}"; do case "$x" in -*) ;; *) r=$x; break;; esac; done;;
      ""|-*|slack|rc|digest|quick|ls|resume) ;;
      *) r=$v;;
    esac
    r=${r%%/*}                                       # `cc handoff --overlap <repo>/<track>`
    [ -n "$r" ] && [ "$r" != "$w" ] && ok=""
  done < <(grep -oE "$AT"'([^ ]*/)?cc +[^;&|]*' <<<"$c")
  [ -n "$ok" ]
}
# TWO lists. secret_all() is the credentials NO gated role reads: ~/.claude/.credentials.json is the box's Claude
# account and its spend, ~/ccbox/env is a GitHub PAT plus a deploy token — a worker holding either can spend or
# push as the box, and a worker is exactly the session nobody is watching. secret_path() adds the box's OTHER
# secrets, which stay member-only, unchanged.
# ~/ccbox is a SYMLINK into the repo (core/ccbox) and $fp arrives here already realpath'd, so matching the literal
# path alone missed every real read of it — the Read tool still served the file with the rule in place. The case is
# the cheap path (no fork for an ordinary file); only a name that could BE one of them is worth resolving.
secret_all(){
  case "$1" in
    "$HOME"/.claude/.credentials.json|"$HOME"/ccbox/env) return 0;;
    */.credentials.json|*/ccbox/env) ;;
    *) return 1;;
  esac
  local f
  for f in "$HOME/.claude/.credentials.json" "$HOME/ccbox/env"; do
    [ "$1" = "$(realpath -m -- "$f" 2>/dev/null)" ] && return 0
  done
  return 1
}
secret_path(){ secret_all "$1" && return 0; case "$1" in "$HOME"/.cc/config|"$HOME"/.ssh|"$HOME"/.ssh/*|"$HOME"/.claude/settings.json) return 0;; esac; return 1; }
case "$tool" in
  Bash)
    cmd=$u   # the universal block above already built it: one jq and at most one awk per call, not two
    if [ -n "$handoff_gated" ]; then   # on top of the four gates below: what only the LIVE session may do
      grep -qE 'git +push\b' <<<"$cmd" && denyh "pushing while the other session is the live one (a retired session must not push a stale branch)"
      grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' <<<"$cmd" && denyh "dispatching a worker (cc --go)"
      grep -qE "$AT"'([^ ]*/)?cc-loop\b' <<<"$cmd" && denyh "dispatching a worker (cc-loop)"
      grep -qE "$AT"'([^ ]*/)?cc +done\b' <<<"$cmd" && denyh "opening a PR (cc done)"
    fi
    # 1. merge/deploy
    grep -qE "$AT"'gh +pr +merge' <<<"$cmd" && deny "merging a PR"
    grep -qE "$AT"'([^ ]*/)?cc-land\b' <<<"$cmd" && deny "landing a change (cc-land merges, installs, switches units on and restarts services in one go)"   # one command for all of it is exactly why it stays the owner's
    grep -qE 'git +push[^;&|]*( -f|--force|--force-with-lease)' <<<"$cmd" && deny "force push"
    grep -qE 'git +push[^;&|]*\b(main|master)\b' <<<"$cmd" && deny "pushing to the default branch"
    grep -qE 'git +(checkout|switch) +(main|master)\b' <<<"$cmd" && deny "switching to the default branch inside a track"
    grep -qE 'git +(symbolic-ref|update-ref|checkout +-B|switch +-C)' <<<"$cmd" && deny "repointing a ref/HEAD (the checkpoint hook would then commit+push that branch)"
    grep -qE "$AT"'(vercel|netlify|fly|heroku|kubectl|terraform|ansible|aws|gcloud|az) +(deploy|apply|--prod|up\b)' <<<"$cmd" && deny "deploying"
    # 2. external comms
    grep -qE "$AT"'gh +(issue +(create|comment)|pr +(comment|review|close|reopen)|release +create)' <<<"$cmd" && deny "public GitHub comms"
    grep -qE "$AT"'gh +(repo +(delete|archive)|api)\b' <<<"$cmd" && deny "gh repo delete/archive or a raw gh api call"
    grep -qE "$AT"'(mail|sendmail|msmtp|mutt)\b' <<<"$cmd" && deny "sending email"
    # 3. destructive / infra
    grep -qE "$AT"'cc +slack +off' <<<"$cmd" && deny "cc slack off (drops the owner's live Slack link)"
    grep -qE '(^|[;&|(){}`]|\$\() *[^ ]*cc-slack +(inject|post|post-approval)\b' <<<"$cmd" && deny "posting to the owner's Slack (cc-slack inject/post)"   # any path to the binary
    grep -qE "$AT"'sudo\b' <<<"$cmd" && deny "sudo / host changes"
    grep -qE 'rm +(-[a-zA-Z-]+ +)*-[a-zA-Z]*r[a-zA-Z]* +(-[a-zA-Z-]+ +)*(~|[$]HOME|\.\.|/home|/etc|/var|/usr|/)([*/ ]|$)' <<<"$cmd" && deny "recursive delete outside the worktree"
    # The container runtime is a way AROUND every other line here, for a WORKER as much as for a member: this user
    # is in group `docker`, so one `docker run -v /:/host` reads and writes the whole filesystem as root — the
    # credentials below included — with no escalation at all. So it is denied for every gated role, which subsumes
    # the narrower "destroying docker resources" rule this replaces. The sanctioned sandbox (ccbox) is the owner's.
    grep -qE "$AT"'([^ ]*/)?(docker|podman|nerdctl)\b' <<<"$cmd" && deny "running a container (this user is in group docker, so a bind-mounted container reads and writes everything as root)"
    grep -qE "$AT"'(systemctl|netplan|ip +link|ip +addr|iptables|nft|ufw|shutdown|reboot|poweroff)\b' <<<"$cmd" && deny "host/network/service changes"
    grep -qE 'git +(branch +-D|reset +--hard +origin|clean +-[a-z]*f)' <<<"$cmd" && deny "destructive git"
    # The two files that ARE the box's credentials — no role reads them, and the member-only list below adds to this
    # one rather than replacing it. Same honest ceiling as every line here: a blocklist stops accidents and casual
    # prompt-injection, not a redirection or a script written first.
    RD='(cat|tac|less|more|head|tail|nl|cut|grep|egrep|fgrep|rg|sed|awk|xxd|od|base64|strings|sort|uniq|jq|python[0-9.]* +-c|source|\.)'
    grep -qE "$AT$RD"' +[^;&|]*(ccbox/env|\.credentials\.json)($|[^A-Za-z0-9_.-])' <<<"$cmd" \
      && deny "reading the box's credentials (~/.claude/.credentials.json is the Claude account and its spend, ~/ccbox/env is a GitHub PAT and a deploy token)"
    # 4. member-facing only: a member must not be able to make the box SPEND or LEAK. Be honest about the ceiling —
    #    a Bash blocklist is not a sandbox: it stops accidents and casual prompt-injection, not a determined attacker
    #    (a redirection, a copied binary, a script it writes first). Real containment is ccbox. cc-notify stays
    #    allowed on purpose: it is how this session escalates to the owner.
    if [ "$role" = member ]; then
      # A MEMBER WORKSPACE DISPATCHES INSIDE ITSELF, AND ONLY THERE. ~/dev/<handle> is one member's whole world:
      # tracks, workers and channels under `<handle>` are theirs to make. Keyed on the .cc/member-workspace marker
      # at the root, never on a new role — a plain member-facing channel session still dispatches nothing at all.
      # This is DEPTH, not containment: what keeps a workspace to itself is the boundary the session runs inside
      # (docs/design-member-workspaces.md, "the boundary"), and this grep is what is left if that ever slips.
      # THE BOUNDARY'S DOOR OPENS FROM OUTSIDE. cc and cc-loop start a workspace session only under CC_MEMBER_SANDBOX=1,
      # which the sandbox sets — never a member-facing session: `CC_MEMBER_SANDBOX=1 cc alice todo` from a plain member
      # dir passed every rule here and started a member workspace session ON THE HOST, the one thing the hard rule
      # forbids (review 2, A). The ASSIGNMENT is refused (prefix, env, export); naming the variable in a grep is not.
      grep -qE '(^|[^A-Za-z0-9_])CC_MEMBER_SANDBOX[+:]?=' <<<"$cmd" && deny "setting CC_MEMBER_SANDBOX — the boundary opens a workspace session from outside; a member-facing session never opens one on the host"
      if ! ws_dispatch_ok "$cmd" "$mws"; then
        grep -qE "$AT"'([^ ]*/)?cc +[^;&|]*--go\b' <<<"$cmd" && deny "${mws:+dispatching outside this workspace — }a member-facing session does not dispatch workers (cc --go)${mws:+; inside \`$mws\` it may}"
      fi
      # cc-loop is the runner UNDERNEATH `cc … --go`, and the day's budget is charged in `cc`, not here: calling it
      # directly spends a workspace's money without ever touching the ledger. So a member never calls it at all.
      if grep -qE "$AT"'([^ ]*/)?cc-loop\b' <<<"$cmd"; then
        if [ -n "$mws" ]; then deny "dispatching with cc-loop — inside \`$mws\` a worker starts with \`cc $mws <track> --go\`, the one form that charges the daily budget"
        else deny "a member-facing session does not dispatch workers (cc-loop)"; fi
      fi
      if [ -n "$mws" ] && ! ws_cc_ok "$cmd" "$mws"; then
        deny "creating outside \`$mws\` — this workspace makes tracks, boards and sessions under ~/dev/$mws and nowhere else"
      fi
      grep -qE "$AT"'([^ ]*/)?claude\b[^;&|]* (-p|--print)\b' <<<"$cmd" && deny "a member-facing session does not dispatch workers (a headless claude spends the owner's budget)"
      SEC='(~|\$HOME|/home/[^ /]*)/(\.cc/config|\.ssh\b|\.claude/settings\.json)'   # $RD is set above: these three ADD to the credentials no role reads
      grep -qE "$AT$RD"' +[^;&|]*'"$SEC" <<<"$cmd" && deny "reading the box's secrets (~/.cc/config, ~/.ssh, ~/.claude/settings.json)"
      grep -qE "$AT"'(cc +slack|([^ ]*/)?cc-slack) +(off|setup|mkchannel|updates-sweep|archive)\b' <<<"$cmd" && deny "re-wiring the box's Slack (cc slack: off, setup, mkchannel, updates-sweep, archive)"
      # cc-config is the one sanctioned reader of ~/.cc/config — which makes it the one clean way AROUND the
      # secrets line above for a session that may not see them. Members get neither the read nor the write.
      grep -qE "$AT"'([^ ]*/)?cc-config\b' <<<"$cmd" && deny "the box's config is not a member's to read or rewrite (cc-config)"
    fi
    ;;
  Read|NotebookRead|Grep|Glob)   # gating these files in Bash alone would be theatre if a file-reading TOOL served them
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // .tool_input.path // ""' <<<"$inp")
    [ -n "$fp" ] && fp=$(realpath -m -- "$fp" 2>/dev/null || echo "$fp")
    if [ "$role" = member ]; then secret_path "$fp" && deny "reading the box's secrets ($fp)"
    else secret_all "$fp" && deny "reading the box's credentials ($fp)"; fi ;;
  Edit|Write|MultiEdit|NotebookEdit)
    fp=$(jq -r '.tool_input.file_path // .tool_input.notebook_path // ""' <<<"$inp")
    fp=$(realpath -m -- "${fp:-/}" 2>/dev/null || echo "$fp")   # ../ traversal resolves before the match
    case "$fp" in
      "$cwd"/*|"$cwd") ;;                          # inside the worktree / the session's own dir: fine
      /tmp/*) ;;                                   # scratch: fine
      "$HOME"/.cc/state/*)   # track state: workers, and a member workspace for the tracks that are its own
        if [ "$role" = member ]; then
          own=""; [ -n "$mws" ] && case "$fp" in "$HOME/.cc/state/$mws"|"$HOME/.cc/state/$mws"/*) own=1;; esac
          [ -n "$own" ] || deny "writing another session's state ($fp) — a task.md there is work the box would run"
        fi;;
      *) deny "editing outside this session's directory ($fp)";;
    esac ;;
esac
exit 0
