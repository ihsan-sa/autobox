#!/bin/bash
# cc-nosignal-shell <command string> — Claude Code's CLAUDE_CODE_SHELL_PREFIX for a worker (cc-loop sets it): every
# Bash call, hook and MCP server the session starts runs in a signal scope of its own, nested in the session's, so a
# test can signal only what that one call started, never the session's own claude. The prefix is one word, hence this.
# Claude Code hands the command over as ONE argument. Should it ever split it into words, `bash -c "$@"` would run the
# first word alone and make the rest its $0 and $1, silently, so more than one is said on stderr and run joined.
[ $# -le 1 ] || { echo "cc-nosignal-shell: expected the command as one argument, got $#; running them joined with spaces" >&2; set -- "$*"; }
exec "$(dirname "$(readlink -f "$0")")/cc-nosignal" -- /bin/bash -c "$@"
