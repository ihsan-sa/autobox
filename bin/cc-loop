  t 'the board is written BEFORE the broker is asked and a question is posted AFTER it — so a broker that is \
down still leaves the board write, which is the half of this that must never be lost' \
    "$(sed -n '/^stop(){/,/exit "\$code"; }/p' "$0" | grep -oE 'BOARD" status|tell_planner|BIN/cc-notify' | tr '\n' ' ')" \
    'BOARD" status tell_planner BIN/cc-notify BIN/cc-notify '
  # ── the done line says WHAT finished, not how many turns it took ──
  HOME="$d/bh" "$BIN/cc-board" init titled /tmp/titled main >/dev/null
