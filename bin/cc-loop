#!/usr/bin/env bash
# cc-loop — autonomous "ralph loop": run headless Claude on a task, fresh context each iteration, rehydrating
# from a durable progress journal + git, until the task reports DONE / BLOCKED / errors / is stopped by a person.
# A BLOCKED line that only asks for a push ("cannot be pushed", "push from the host") of commits the track branch's
# remote already holds, and asks nothing else, is not a stop: the loop takes it out of the journal, says why there,
# and runs on (already_pushed).
#   cc-loop <repo> <track> [--once] [--max-iter N=10] [--budget USD/iter=8] [--turns N] [--model M=CC_WORKER_MODEL] [--effort E] [--quiet]
#                          --max-iter N     a checkpoint every N iterations (a log line and a board note), never a stop,
#                                           unless --no-extend makes it the caller's bound. --once is --max-iter 1 --no-extend.
#                          --budget USD     each iteration's own dollar checkpoint (claude --max-budget-usd): the iteration
#                                           ends there and the loop goes on, as after any other iteration
#                          --turns N        only when a caller asks: no tool-call limit is passed by default
#                          [--resume-last]  iteration 1 continues this track's last claude session instead of a cold
#                                           one — for a repair round, where the context that found the bug is the
#                                           expensive part; later iterations are fresh as always
#                          [--no-extend]    the step limit is FINAL: the loop ends at --max-iter, so a caller
#                                           that promised "one round" gets exactly that.
#                                           A bound reached with the last iteration COMMITTING is the round ending:
#                                           exit 0 and no page, board `review` where the track has a PR to review
#                                           and `blocked` where it has none. Only a bound reached with nothing
#                                           committed is exit 6 / `blocked` / "paused".
#   cc-loop worker-model [M]  the model a worker runs on, and why (worker_model below) — cc names it on its dispatch line
#   cc-loop member-stop <handle> <track> <rc>  ON THE HOST, after `cc-sandbox member … -- cc-loop` exits: for exit 4 or 12
#                                            it runs the host's `cc done` the loop inside could not finish, then the
#                                            failures-ledger record the loop inside could not write (member_stop below)
#   cc-loop context-report <session.jsonl>…  what a turn of a past iteration actually carried, and what the context
#                                            trim below would have left of it — the shadow week's one command
# NO COUNT STOPS A LOOP (owner, 2026-10-16 and 2026-10-20: no count caps on calls, runs or rounds, no give-up after
# N). The step limit is a checkpoint: at --max-iter the loop notes it and carries on, whether or not that iteration
# committed. No tool-call limit is passed, and --budget ends an iteration, not the loop. There is no spend cap (owner,
# 2026-08-31: "no spend cap as some just are expensive"). What ends a loop is DONE, a question, two failed iterations
# in a row, every model refusing, a person's stop file, a pause or the tier, or --no-extend's bound.
# RUNAWAY IS A NOTICE — three iterations in a row that show nothing for their money, judged against THIS track's own history:
#   · committed nothing and left the journal untouched · repeated the previous outcome verbatim without committing
#   · spent 5x what a committed iteration has cost this track, with no commit for two iterations.
# One of those is normal. Three consecutively tells the dispatching session, with the numbers, through the broker and
# the board note, and the loop carries on: whoever reads it decides, and a stop file ends it. The streak is told again
# on a doubling stride (its 1st, 2nd, 4th, 8th… barren iteration from the third), and a good iteration resets it.
# Until 2026-10-20 it stopped the track (exit 9).
# ERRORS — two failed iterations in a row stop the track as `errored`. One killed as hung (rc=124, below) says so in
#   its error line, and is not a failure at all if it committed. A capped iteration (--budget, or a caller's --turns)
#   is no error: it ends there and the loop goes on (until 2026-10-20 two with nothing to show stopped it, exit 7).
# HUNG, NOT LONG: an iteration is killed only when its transcript has stopped growing for CC_LOOP_HUNG_SECS (1800 s)
#   (hung_watch). Every tool call, model reply and subagent step writes the transcript, and Claude Code ends a
#   foreground Bash call by 10 minutes, so a half hour of silence is a stuck process, never a long gate. Until
#   2026-10-20 every iteration was killed at one hour of wall clock, live or not: 67 of 513 died there.
# Task text:  ~/.cc/state/<repo>/<track>/task.md      (written by `cc <repo> <track> --go "..."` or by hand)
# Journal:    ~/.cc/state/<repo>/<track>/progress.md  (worker appends; a fresh iteration reads it)
# PR body:    ~/.cc/state/<repo>/<track>/pr-body.md   (worker writes it before DONE: what changed, why, how it was tested. cc done makes it the PR's description and links the brief under it,
#             and a later cc done (a repair round) patches the open PR when the file changed;
#             'Closes <row>[, <row>][ and <row>]' in the body closes those board rows when the PR lands)
# Slack post: ~/.cc/state/<repo>/<track>/slack-post.md (`thread` or #channel on line 1, `file: <path>` optional, text below; the loop posts it once at DONE)
# Runs in the track's git worktree; every iteration ends with cc-checkpoint (commit+push to track branch); a head that
#             push could not send is left in ~/.cc/push-owed/<repo>/<track> for the host's sweep to push (push_host).
# Self-review: templates/self-review.md — the six kinds of finding the landing review keeps stopping PRs for. The worker
#             prompt carries its six headings (selfrev_block, inlined because a sandboxed worker has core/bin bound and
#             not core/templates), and the worker reads its own `git diff origin/<base>` against them before STATUS: DONE.
# A REFUSAL OR A REROUTE IS NEVER SILENTLY RETRIED. When cc-model classifies the run as `refusal` — the classifier
# stopped the turn, or a model that is withdrawn or suspended answered as a different one — the same model asked
# again gives the same answer, so the loop moves to the next model on the cc-model chain (`cc-model next`; the order
# lives there and only there) and writes one line in the journal so the next fresh context knows why its model changed.
# A run that came back with NOTHING is rerun as the same iteration — not an error, not an iteration. A run that
# committed or journalled COUNTS like any other; only the model changes (F4, refusal_step). Off the end of the chain:
# with nothing to show it stops (10); with work, the work stands and the loop carries on, on the same model.
# AN OUTAGE MOVES THE LOOP DOWN THE CHAIN, AND ITS LIFT MOVES IT BACK (owner, 2026-09-15). The model is resolved
# every iteration through `cc-model resolve`: the one the dispatcher named, or the next rung while the box has that
# one recorded as out (usage credits, the spend cap, a limit that moved the box). So a refusal the box KNOWS about
# is not pinned here — the next iteration asks again and runs on Fable the moment Fable answers — and only a refusal
# the box has no record of (the classifier stopped the turn, a reroute) pins the loop to the next rung as before.
# Until 2026-09-15 every refusal pinned MODEL for the rest of the loop, so a loop moved to Opus stayed on Opus.
# The next fresh context is TOLD which of those happened, in one journal line, and only when an outage really began
# or really lifted (model_change_note). A model that merely CHANGED says nothing: the commonest dispatch names no
# --model and follows the box override, so an outage beginning changes it too, and a reroute has its own line.
# A STOP GOES TO THE SESSION THAT DISPATCHED THE TRACK. Every stop below is a technical question — a cap, a runaway,
# a `cc done` that failed, a worker asking something — and the planning session is the one that can answer it. Until
# 2026-09-07 stop() paged the owner at high priority and told that session nothing: an install question a planner
# would have settled in a minute crossed three shifts on a phone, and was false to begin with (comms audit). So stop()
# hands cc-broker one line for `<repo>`'s session — which classifies it, waking that session NOW for a line asking it
# to choose and digesting the rest. A broker that is DOWN loses nothing either: the stop is filed as a planner request
# (cc-notify --ask), kept and retried. SLACK HEARS TWO THINGS FROM A LOOP, each once: the DONE card in the track's
# thread, and a worker's BLOCKED question that no seat took, as the owner's decision card (cc-notify --decision).
# A question the seat heard is the seat's to settle, or to take to the owner itself as a --decision card. Iteration
# totals, spend, a round that is over, a limit wait and the command to resume stay in loop.log, the board note and the journal.
# THE LOOP'S PUSH OUTRANKS A BLOCKED ON THE SANDBOX'S VIEW: a BLOCKED line that blames what the worker sandbox hides by
# design (a push, gh, the board, cc-green, the masked checkout, `cc`) on a head this loop has just pushed to origin is
# answered in the journal — a `- cc-loop:` line and `STATUS: RESUMED` — and the loop carries on, once per run; the worker
# prompt says the same up front (sandbox_block). Any other BLOCKED, or that one again, stops as below.
# Exit: 0 done, or nothing ran because the row was already done or merged when the loop started (row_closed) | 3 stopped on a question, board `waiting` (the session hears it) | 4 the worker said DONE but `cc done` failed: no PR, board `blocked` (the session hears it)
#     | 5 errors | 6 a --no-extend bound reached with nothing committed | 10 every model on the chain refused
#     (7 and 9 are retired: a capped iteration and a runaway no longer stop a loop)
#     | 11 the whole project is paused (`cc-pause on <repo>`), board `queued`, nobody notified — the owner parked it himself
#     | 12 completion has no usable receipt, board `blocked` (notified); delivery is unconfirmed
#     | 13 the spend tier (`cc-tier`) holds it at the next iteration — stop, or essential with no `critical` on the row — board `queued`, nobody notified;
#       at dispatch the same tier is exit 2 before anything runs
#     | 8 Claude usage limit that outlasts CC_LIMIT_MAX_WAIT (6 h). A limited run is not an iteration and not an error:
#       cc-limit stamps ~/.cc/state/claude-limit, the loop waits it out and reruns the same iteration.
#     | 14 stopped by hand: ~/.cc/state/<repo>/<track>/stop existed when the next iteration was about to start (see below)
# A LOOP IS STOPPED BY A FILE, NOT A KILL. `touch ~/.cc/state/<repo>/<track>/stop` (its text, if any, is the reason) ends the
# loop at the next iteration boundary: the iteration in flight finishes, nothing more is charged, board `blocked`, the
# reason in the board note and one journal line, the file consumed. Nobody is paged — whoever wrote it knows. A kill is
# the thing the classifier rightly refuses a session, and a kill mid-iteration leaves a claude re-parented to systemd,
# still editing the worktree. A stop file that predates the dispatch is stale and cleared: re-dispatching overrides it.
# AN ITERATION THAT ENDS WITH ITS OWN cc-green RUN STILL GOING WAS NOT IDLE. The worker is told to start its green
# (`cc-green start`, which runs `lander check` detached — a worker typing `setsid nohup` is refused by the classifier)
# and then to END ITS ITERATION, not wait on it: on 2026-09-30, 15 of the 16 iterations killed at the hour cap had
# started their run and then sat in `cc-green wait` in the model. A long check outlives an iteration, and until 2026-09-19 ten
# tracks whose last iteration had only started that run were stopped as "committed nothing", each costing a relaunch
# and a planning wake. So after every iteration the loop asks `cc-green wait` on the worktree (green_wait): a run
# still going is waited out HERE, with no model call, for up to 6 h (one still queued then is journaled and handed on
# as progress, not dropped), its result is one journal line for the next fresh context, the
# iteration is not the journal-untouched or repeated-outcome runaway signal (the run explains both; the spend rule
# still counts it). The next iteration reads that result; under --no-extend the bound is the caller's promise.
# A SANDBOXED WORKER'S RUN GOES ON THE HOST (green_kick). Inside cc-sandbox the run lived on the fence's private
# tmpfs and died with it at the iteration's end, so green_wait found nothing and all 12 workers stalled at their last
# step on 2026-10-16. Each iteration is told where to ask (CC_GREEN_ASK=$ST/green.ask, not inside a member boundary,
# whose own loop is in bwrap with the run); a fenced `cc-green start` writes that file and runs nothing. After the
# iteration, BEFORE the DONE branch (a worker asks in the iteration it writes STATUS: DONE), the loop consumes the
# file and runs `cc-green start` in $WT itself with CC_GREEN_FOR_WORKER=1 (the pinned lander, `check --caged-only`)
# and the main checkout's hooksPath, then waits it out as above and copies its log to $ST/green.log, where the
# fence can read it. Only the file's being there is read: the command, the tree and the lander are the loop's own.
# The kicked run is remembered in $ST's parent (gk_mark, out of the fence's reach) until green_wait collects it, so one
# still going at the 40-wait bound, or left by a loop that died, is journaled with its log copy later, and once.
# One that ends with ANY OTHER RUN OF ITS OWN STILL GOING in its worktree (own_run_live: a detached EDA run, a heavy
# slot) is not waited for, so it gets neither of those (a stray shell or dev server there must not switch the barren
# stops off), but neither kind is COUNTED: a hung kill, a capped turn or an error that ended an iteration whose gate
# was still running is not one of the two failures that stop a track (owner 10-16: no caps that stop work
# that is still going; raised-loop-hour-cap-kills-long-gates, raised-gate-wait-counts-as-loop-failure). The waits are
# checked BEFORE the counting for that reason. The barren-run and spend-multiple notices and --budget stand.
# A STOP IS ADDRESSED TO THE SESSION THAT DISPATCHED THE TRACK — an orch when one did (`<repo>@<alias>`, the broker's
# own key for it), the repo seat only when none is recorded. The record is $ST/orch, written by this loop at start from
# CC_SLACK_ALIAS, which an orch's shell exports and `cc … --go` carries into the loop's window, else from CC_DISPATCH_WIN,
# the tmux window `cc` ran in, when that is an orch's `<repo>@<alias>`. A dispatch from any other window removes it (that
# dispatcher is not an orch); one that names no window at all keeps it. Both variables are unset before the worker runs. The key is the ORCH'S
# repo, not the track's (CC_ORCH_REPO, else the one live `<x>@<alias>` window): an orch dispatching into another repo is
# still `<its repo>@<alias>` (orch_record). A DONE is told to the same key, once, by done_card (done_heard says whether
# anyone heard it). cc-broker's rc 0 means SENT, not heard: a stop or DONE sent to a key with no open seat window is
# logged as unheard (and a stop is filed as a request), never passed off as delivered.
# A STOP THAT IS A FAILURE IS WRITTEN TO THE FAILURES LEDGER BY THE LOOP, at the moment it stops (stop_record; design-failure-noticing
# phase 2, "signals kept at their producers"): exits 5 6 10 as worker-loop/barren-stop, 4 12 as worker-loop/done-undelivered, 8 as
# worker-loop/limit-outlasted-wait — one record per stop, through `cc-green red`, with a bounded excerpt of loop.log that outlives the
# state dir. Not 3 (the worker ASKED, which is the work), 11 or 13 (the owner parked it, or the tier holds it): those are not failures.
# The record never changes the exit code or the board word; a ledger that cannot be written is one log line.
# Env (tests): CC_LOOP_RUNAWAY_N how many barren iterations in a row · CC_LOOP_RUNAWAY_X the cost multiple ·
#   CC_LOOP_HUNG_SECS how long a silent transcript means hung · CC_LOOP_HUNG_POLL how often it is looked at (60 s).
# Env: CC_LOOP_TRIM=1 (cc-config key or the environment) drops OLD TOOL RESULTS from a worker's context — off by
#      default, and off is byte-for-byte the run this loop always did. What it is and what it measured: trim_body.
# Env: each iteration's claude runs in a user scope in worker.slice at CPUWeight/IOWeight 20, beside app.slice and
#   lander.slice at 100 (WORKERS YIELD TO LANDINGS, below); CC_WORKER_SCOPE=0 or no user bus runs it at nice 19, loudly.
# Env: every worker runs inside bwrap (cc-sandbox) — secrets, sockets, other tracks absent, network through an allow-list;
#   CC_WORKER_SANDBOX=0 is the owner's off switch. A box where the fence cannot start runs no worker (`cc-sandbox probe`, before iter 1).
# Env: WORKER_CLAUDE_CREDENTIALS (cc-config key) set and the fence on → the worker runs on that login when cc-sandbox takes
#   it (`cc-sandbox worker-cred`, asked every iteration), and then this loop's limit stamp is ~/.cc/state/claude-limit.workers
#   and its CC_MODEL_CRED is `workers`, so that account's limit waits and exits 8 as above while the box's sessions run
#   on. An iteration cc-sandbox puts on the box's login waits on the box's stamp, as before.
# Every iteration's claude runs under cc-nosignal: it and every Bash run it makes can signal only what they started.
# Inside the sandbox every Bash call shares bwrap's pid namespace and the session's scope with the worker's claude, so a
# test there can still signal that claude and bwrap's init, but not the user manager, the tmux server or another
# session. With CC_WORKER_SANDBOX=0 each Bash call also gets a scope of its own (CLAUDE_CODE_SHELL_PREFIX=
# cc-nosignal-shell), so not the worker's claude either.
set -uo pipefail
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.cc/try/bin:"*) ;; *) PATH="$HOME/.cc/try/bin:$PATH";; esac; export PATH   # headless workers: same PATH guarantee as cc (systemd-started clients lack ~/bin)
# SCRATCH LIVES ON DISK: /tmp is a RAM tmpfs with a per-user quota, and sessions' scratch (Claude Code's claude-<uid>,
# every mktemp) filled it until landings died on "Disk quota exceeded". A TMPDIR somebody set is theirs and is kept.
[ -n "${TMPDIR:-}" ] || { TMPDIR="$HOME/.cc/tmp"; { [ -d "$TMPDIR" ] || { mkdir -p "$HOME/.cc" && { mkdir -m 700 "$TMPDIR" || [ -d "$TMPDIR" ]; }; }; } 2>/dev/null || TMPDIR=/tmp; export TMPDIR; }
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
# The loop's SIGNALS are its own, not the launcher's. A cc-loop started `setsid nohup` out of a session shell inherits SIGHUP
# ignored; exec keeps that, and bash silently cannot trap a signal ignored at entry — so the HUP trap below did nothing and
# killing the loop left claude alive in the worktree (the relaunch-orphans incident; the trap #134 found under selftest.sh).
# Bash cannot undo it, so the script goes once through python, which puts HUP/INT/QUIT/TERM back to default — the way tmux
# and systemd start things — and PIPE/XFSZ with them, which python itself ignores and would otherwise hand down.
if [ -z "${CC_LOOP_SIGNALS:-}" ] && command -v python3 >/dev/null 2>&1; then
  CC_LOOP_SIGNALS=1 exec python3 -c 'import os, signal, sys
for s in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM, signal.SIGPIPE, signal.SIGXFSZ): signal.signal(s, signal.SIG_DFL)
os.execv(sys.argv[1], sys.argv[1:])' "$(readlink -f "$0")" "$@"
fi
unset CC_LOOP_SIGNALS   # our children start from the same defaults, and none of them needs to know how
worker_model(){   # $1 the dispatcher's --model, if any -> the model this worker runs on. THE WORKER DEFAULT LIVES HERE:
                  # --model (the dispatcher's own call for THIS task -- fable[1m] only where Opus 5.5 at xhigh visibly falls short)
                  # beats the cc-model override (a limit moves every session at once) beats CC_WORKER_MODEL. A worker is
                  # not an orch: until 2026-09-01 one dispatched without --model silently ran on the box's interactive
                  # default (Fable) while the policy said workers run on Opus, because only the override was passed on.
                  # `cc-model forced`, NOT `current`: since 2026-09-07 `current` also names the primary, and asking it
                  # here would hand every unmodelled worker the interactive primary again -- the 09-01 bug, back.
  local m="${1:-}" r
  [ -n "$m" ] || m=$("$BIN/cc-model" forced 2>/dev/null)
  [ -n "$m" ] || m=$("$BIN/cc-config" get CC_WORKER_MODEL claude-opus-5-5)
  # …and then the rung it runs on NOW: itself, or the next one while the box has it recorded as out (see the header).
  # `asked` as $2 skips that step — the model as dispatched, for the journal line that says why it is not running on it.
  [ "${2:-}" = asked ] && { printf '%s\n' "$m"; return 0; }
  r=$("$BIN/cc-model" resolve "$m" 2>/dev/null); [ -n "$r" ] && m="$r"
  printf '%s\n' "$m"; }
refusal_note(){   # $1 iteration · $2 the model that refused · $3 the one it moved to ("" = the chain ends here)
                  # $4 why · $5 kept|rerun|stopped → the journal's own line, for the next fresh context to read
  local to="${3:+only the model changed, to $3 per the cc-model chain}"; to="${to:-no model is left on the cc-model chain, so it carries on on the same one}"
  case "${5:-rerun}" in
    kept)    printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) — but it produced work, so it COUNTS and everything below it stands; %s.\n' \
               "$1" "${2:-the box default}" "$4" "$to";;
    stopped) printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) with nothing to show for it, and no model is left on the cc-model chain — the loop stopped (exit 10). The task and the journal below are unchanged.\n' \
               "$1" "${2:-the box default}" "$4";;
    *)       printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) with nothing to show for it — switched to %s per the cc-model chain and reran it. The model would not do the work; the task and the journal below are unchanged.\n' \
               "$1" "${2:-the box default}" "$4" "$3";;
  esac; }
model_outage_why(){   # $1 the model this iteration runs on · $2 the model as dispatched → the outage that moved it
                     # off $2, or nothing. ASKED EVERY ITERATION, not only on the ones that changed model: an outage
                     # already in force when the loop started changes nothing between iteration 1 and 2, and the lift
                     # at iteration 3 still has to know that 2 was moved by it. `out` is asked only when the two ids
                     # differ, because a model at the END of the chain resolves to itself and the loop runs ON it —
                     # nothing moved it, and "runs on X, not X" is not a sentence worth writing.
  [ "${1:-}" = "${2:-}" ] && return 0
  "$BIN/cc-model" out "${2:-}" 2>/dev/null; return 0; }
model_change_note(){   # $1 iteration · $2 the model it runs on · $3 the model as dispatched · $4 what the PREVIOUS
                      # iteration ran on · $5 the outage that had moved THAT one ("" = none) · $6 the outage moving
                      # THIS one ("" = none) · $7 what the PREVIOUS iteration was DISPATCHED on → the one line the
                      # next fresh context reads, or nothing at all.
                      # A CHANGE OF MODEL IS NOT A LIFT (review of #503). The commonest dispatch names no --model and
                      # follows the box override, so an outage BEGINNING changes the model too, and so does a refusal
                      # reroute pinning the next rung: calling either one "the outage that moved it to X lifted" put a
                      # false sentence into the prompt of every iteration after it, and on the refusal path it
                      # contradicted the refusal_note written beside it. So the lift is claimed only when the previous
                      # iteration was REALLY outage-moved ($5) and this one is not ($6) — and when neither is, nothing
                      # is said: a reroute has refusal_note for that, and a plain re-dispatch on another model is the
                      # dispatcher's own doing and not this line's business.
                      # AND LEAVING THE RUNG IS NOT A LIFT EITHER (second review of #503). $5 alone says the previous
                      # iteration was outage-moved, not that this one came BACK: refused on the rung the outage moved
                      # it to, the loop pins the NEXT rung down ($MODEL, below), so the rerun changes model with the
                      # outage still in force and the old test read that as a lift — a sentence contradicting the
                      # refusal_note written one line earlier. A lift means the loop is on the very model it was moved
                      # off, which is what the previous iteration ASKED for ($7).
  local i="$1" m="$2" asked="$3" lastm="$4" lastwhy="$5" why="$6" lastasked="${7:-}"
  [ -n "$lastm" ] && [ "$m" != "$lastm" ] || return 0
  if [ -n "$why" ]; then
    printf -- '- cc-loop: iteration %s runs on %s, not %s — %s. It returns to %s by itself when that lifts.\n' "$i" "$m" "$asked" "$why" "$asked"
  elif [ -n "$lastwhy" ] && [ "$m" = "$lastasked" ]; then
    printf -- '- cc-loop: iteration %s is back on %s — the outage that moved it to %s lifted; no handoff, the journal below stands.\n' "$i" "$m" "$lastm"
  fi; }
refusal_step(){   # $1 refusal_next's exit code · $2 whether the iteration produced work → what the loop does.
                  # A REROUTE THAT PRODUCED WORK IS AN ITERATION (2026-09-01 review, F4): it committed, or it wrote
                  # the journal, and rerunning it would redo work the next fresh context can already read. Only the
                  # model changes. Rerunning is for the run that came back with nothing.
  case "$1:$2" in
    0:no)  echo rerun;;   # nothing produced: the same model asked again gives the same answer
    0:yes) echo count;;   # produced work: keep it, move the model, carry on
    2:no)  echo stop;;    # the chain ends here and nothing came of it — no model left to try
    2:yes) echo count;;   # the chain ends here but the work is real: keep it and carry on, on the same model
    *)     echo none;;    # not a refusal at all
  esac; }
refusal_next(){   # $1 run json · $2 its stderr · $3 the model asked for → "<next>\t<why>"
                  # 0 = refused, move to <next> · 1 = not a refusal · 2 = refused with nothing left on the chain
                  # $3 may be empty — that is the normal state, and cc-model resolves it (the chain has one home)
  local cl why nx
  cl=$("$BIN/cc-model" classify "$1" "$2" "${3:-}" 2>/dev/null) || return 1
  case "${cl%%$'\t'*}" in refusal) ;; *) return 1;; esac
  why="${cl#*$'\t'}"; why="${why:-refused}"
  nx=$("$BIN/cc-model" next "${3:-}" 2>/dev/null) || nx=""
  [ -n "$nx" ] || { printf '\t%s\n' "$why"; return 2; }
  printf '%s\t%s\n' "$nx" "$why"; return 0; }
last_session(){   # $1 a track's runs/ directory → the session id of its most recent run that recorded one, or 1.
                  # Newest FIRST and it keeps looking: an iteration killed mid-flight leaves a json with no
                  # session_id, and the round after it would then open a cold session having been told to resume.
  local f s
  while IFS= read -r f; do
    s=$(jq -r '.session_id // empty' "$f" 2>/dev/null)
    [ -n "$s" ] && { printf %s "$s"; return 0; }
  done < <(find "$1" -maxdepth 1 -name '*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -20 | cut -d' ' -f2-)
  return 1; }

# ── THE CONTEXT TRIM, off unless CC_LOOP_TRIM says otherwise ──────────────────────────────────────────────────
# A worker replays every tool result it has ever seen on every turn: 63 turns averaging ~74k of context, most of
# it stale output. With the knob on, the API drops the OLDER TOOL RESULTS from the request (context editing,
# clear_tool_uses) before the model reads it. The tool CALL stays, so the worker still knows it ran the command
# and only stops carrying the output. NOTHING ELSE IS TOUCHED: the brief, the constraints and the journal tail
# travel in the -p prompt and in --append-system-prompt, which this edit cannot reach, and the last TRIM_KEEP
# results — the current diff and test state — stay whole.
# MEASURED ON THIS BOX (2026-09-02, A/B on one task): context per turn -30%, DOLLARS +41%. Clearing moves the
# prompt-cache boundary, so the suffix is re-written at 1.25x instead of read at 0.1x. Tokens per turn and
# dollars are not the same lever. That is why this ships OFF: a week of `cc-loop context-report` on real tracks
# decides it, judged on dollars per accepted PR (codex efficiency review, 2026-09-02) and not on tokens.
TRIM_TRIGGER=45000; TRIM_KEEP=6; TRIM_ATLEAST=8000   # ONE policy, read by the request body and by context-report
trim_body(){   # what a trimmed run adds to CLAUDE_CODE_EXTRA_BODY, or NOTHING at all when the knob is off.
               # cc-config's precedence is this knob's: the environment beats the file, so CC_LOOP_TRIM=0 in
               # front of one dispatch turns it off for that run without touching the box's config. Across a
               # `cc … --go` that rests on cc's `pre` whitelist carrying CC_LOOP_TRIM into the tmux window —
               # drop it from that list and this silently reads the file instead (selftest, the cc-loop block).
  case "$("$BIN/cc-config" get CC_LOOP_TRIM 0 2>/dev/null)" in 1|on|yes|true) ;; *) return 0;; esac
  printf '{"context_management":{"edits":[{"type":"clear_tool_uses_20250919","trigger":{"type":"input_tokens","value":%s},"keep":{"type":"tool_uses","value":%s},"clear_at_least":{"type":"input_tokens","value":%s}}]}}\n' \
    "$TRIM_TRIGGER" "$TRIM_KEEP" "$TRIM_ATLEAST"; }
trim_replay(){   # $1 a session transcript (~/.claude/projects/<project>/<session>.jsonl) → what the policy above
                 # would have done to that iteration: one KEPT|/CLEARED| line per part it carried, then
                 # SUMMARY|turns|ctx|trimmed|pct. The BEFORE is measured, not guessed — a turn's context is what
                 # the API billed for it (input + both cache counters); only the saving is modelled, from the
                 # cleared tool results' own text. Every turn of a real iteration is in the file, so the method
                 # is the same one the shadow week uses on a trimmed track.
  [ -r "$1" ] || { echo "cc-loop: cannot read transcript $1" >&2; return 1; }
  python3 - "$1" "$TRIM_TRIGGER" "$TRIM_KEEP" "$TRIM_ATLEAST" <<'PY'
import json, sys
path, trig, keep, atleast = sys.argv[1], int(sys.argv[2]), int(sys.argv[3]), int(sys.argv[4])
def ex(s, n=400): return ' '.join(str(s).split())[:n]
parts, tools, turns, seen = [], [], [], set()   # parts: [kind, text, tool_index or None]
for line in open(path, errors='replace'):
    try: r = json.loads(line)
    except Exception: continue
    m = r.get('message') or {}
    if r.get('type') == 'user':
        c = m.get('content')
        for b in (c if isinstance(c, list) else [{'type': 'text', 'text': c or ''}]):
            if not isinstance(b, dict): continue
            if b.get('type') == 'tool_result':
                s = b.get('content')
                s = s if isinstance(s, str) else json.dumps(s)
                parts.append(['tool_result', s, len(tools)]); tools.append(max(1, len(s) // 4))
            elif b.get('type') == 'text' and b.get('text', '').strip():
                parts.append(['prompt', b['text'], None])
    elif r.get('type') == 'assistant':
        for b in (m.get('content') or []):
            if isinstance(b, dict) and b.get('type') == 'text' and b.get('text', '').strip():
                parts.append(['said', b['text'], None])
        mid = m.get('id')   # a transcript repeats one assistant message per content block; it is ONE turn
        if mid is not None and mid in seen: continue
        seen.add(mid)
        u = m.get('usage') or {}
        ctx = (u.get('input_tokens') or 0) + (u.get('cache_read_input_tokens') or 0) + (u.get('cache_creation_input_tokens') or 0)
        if ctx: turns.append((ctx, len(tools)))
def cleared_at(ctx, ntools):   # the policy, turn by turn: over the trigger, keep the last N, and only if the
    if ctx <= trig or ntools <= keep: return 0   # saving is worth moving the cache boundary for
    c = sum(tools[:ntools - keep])
    return c if c >= atleast else 0
tot = sum(c for c, _ in turns); saved = sum(cleared_at(c, n) for c, n in turns)
gone = 0   # how many of the tool results the LAST turn no longer carried — what KEPT/CLEARED below report
if turns and cleared_at(*turns[-1]): gone = turns[-1][1] - keep
for kind, text, ti in parts:
    print('%s|%s|%s' % ('CLEARED' if (ti is not None and ti < gone) else 'KEPT', kind, ex(text)))
if not turns: sys.exit(0)   # nothing was billed in this file: no turn to report on, and the caller says so
print('SUMMARY|turns=%d|ctx=%d|trimmed=%d|pct=%+.1f' % (len(turns), tot / len(turns), (tot - saved) / len(turns),
      -100.0 * saved / tot if saved else 0.0))   # …and a turn that loses nothing prints +0.0, not -0.0
PY
}
context_report(){   # `cc-loop context-report <session.jsonl>…` — one line per iteration: what a turn carried, what
                    # it would have carried trimmed, and the fraction. The shadow week runs this and nothing else.
  [ $# -gt 0 ] || { echo "usage: cc-loop context-report <session.jsonl>…" >&2; return 2; }
  local f s rc=0
  for f in "$@"; do
    s=$(trim_replay "$f" | sed -n 's/^SUMMARY|//p') || { rc=1; continue; }
    [ -n "$s" ] && printf '%s: %s\n' "$(basename "$f")" "${s//|/ }" || { printf '%s: no turns recorded\n' "$(basename "$f")"; rc=1; }
  done; return $rc; }

CHECKLIST="$(dirname "$BIN")/templates/self-review.md"   # the six recurring stops live in ONE place, and this is it
DISPATCH="$(dirname "$BIN")/config/dispatch-prompt.md"   # subagent vs worker vs orch, and the model bands — written ONCE, in core/, for every session kind
dispatch_block(){   # → that shared text with a leading space, or NOTHING if the file is missing, like selfrev_block.
                    # The session a `--go` dispatch actually launches is THIS one, and its prompt is built here rather
                    # than in `cc`, so without this line the worker was the one session kind the shared text missed.
                    # Inlined for selfrev_block's reason too: a sandboxed worker has core/bin bound and not core/config.
  local d; d=$(cat "$DISPATCH" 2>/dev/null); [ -n "$d" ] || return 0; printf ' %s' "$d"; }
WRITING="$(dirname "$BIN")/config/writing-prompt.md"   # the box's one writing block — written ONCE, in core/, for every session kind and the Slack tool
WRITING_REF="$(dirname "$BIN")/config/writing-ref-prompt.md"   # the pointer to that block, for a worker that already loads ~/CLAUDE.md
worker_writing_block(){   # → the writing rule as THIS worker needs it. A worker that loads ~/CLAUDE.md, which carries the
                          # block, gets the pointer, as a seat does: on the host, in a worker sandbox and in the owner's own
                          # workspace, where cc-sandbox binds it (SHARED_DOCS). A member's boundary binds no ~/CLAUDE.md, so
                          # there it gets the block's first paragraph and its last line, the guide cc-sandbox binds as
                          # ~/WRITING.md: paragraphs of the same file, never a copy.
  local w
  if [ -f "$HOME/CLAUDE.md" ]; then w=$(cat "$WRITING_REF" 2>/dev/null)
  else w=$(awk 'BEGIN{RS=""} NR==1{print; print ""} {l=$0} END{if(NR>1)print l}' "$WRITING" 2>/dev/null); fi
  [ -n "$w" ] || return 0; printf ' %s' "$w"; }
RAISE="$(dirname "$BIN")/config/raise-prompt.md"   # how a session raises a problem with the box itself — written ONCE, in core/, for every session kind
raise_block(){   # → that shared rule with a leading space, or NOTHING if the file is missing, like the two above.
                 # A worker trips over the framework more than anyone: it runs unattended, hits a tool that lied or
                 # a stop nobody was told about, works around it and the next worker pays the same price. Its route
                 # is the board its prompt already names, so raising costs it a command and wakes nobody.
  local r; r=$(cat "$RAISE" 2>/dev/null); [ -n "$r" ] || return 0; printf ' %s' "$r"; }
onto_block(){   # → a row whose board PR is ANOTHER branch's open PR (a hive dispatch/<n>) is told where its fix goes, or
                # NOTHING. `cc done` pushes it there on the host (cc's onto_pr); before this the prompt said only
                # track/<row>, so every such worker blocked asking who would push (raised-repair-push-no-creds). The
                # branch is fetched here, on the host, from the PUSH url: onto_pr chose the PR against that repository,
                # and an origin that fetches from another one (o/upstream) has no such branch. A fetch that fails says
                # so and tells the worker to block, never to build on an origin/<branch> that is not there.
  local o br url rurl cred=()
  o=$("$BIN/cc" onto-pr "$repo" "$track" 2>/dev/null) && [ -n "$o" ] || return 0; read -r br url <<<"$o"
  rurl=$(git -C "$WT" remote get-url --push origin 2>/dev/null) && mapfile -t cred < <("$BIN/cc-gh-token" gitargs "$rurl" "$repo" 2>/dev/null)
  if [ -z "$rurl" ] || ! timeout -k 5 60 env GIT_TERMINAL_PROMPT=0 git "${cred[@]}" -C "$WT" -c core.hooksPath=/dev/null fetch --quiet "$rurl" "+refs/heads/$br:refs/remotes/origin/$br" >/dev/null 2>&1; then
    printf ' This row fixes the open PR %s, whose branch is %s, but the host could not fetch that branch this iteration, so origin/%s is not there to build on: make no edits, and append STATUS: BLOCKED: cannot fetch %s for %s.' "$url" "$br" "$br" "$br" "$url"; return 0; fi
  printf ' This row fixes the open PR %s, whose branch is %s: build your commits on origin/%s (merge origin/%s into track/%s before your first edit if it is not already in it; never reset, so track/%s stays a fast-forward). At DONE, cc done pushes them onto %s as a plain fast-forward and that PR carries the fix, so do not block on the push and do not expect a second PR.' "$url" "$br" "$br" "$br" "$track" "$track" "$br"; }
issue_block(){   # → the GitHub issues and PRs task.md names, fetched HERE on the host and saved where the worker reads
                 # them, or NOTHING. The sandbox has no GitHub login, so a brief that only said "#1261" left the worker
                 # tracing it blind until a seat pasted the body in (raised-dispatch-worker-cant-read-github,
                 # 2026-10-19). A bare #N is the origin repository's; a github.com/<o>/<r>/(issues|pull)/<n> link is its
                 # own. The board's inflight block is not the brief and is skipped. A fetch that fails keeps the copy
                 # an earlier iteration saved, and one never saved is named so the worker asks instead of guessing.
  local f="$ST/task.md" dir="$ST/github" slug refs s n o saved=() unread=()
  [ -f "$f" ] || return 0
  slug=$(git -C "$WT" remote get-url origin 2>/dev/null | sed -nE 's#^.*github\.com[:/]([^/]+/[^/]+)$#\1#p'); slug=${slug%.git}
  refs=$(awk '/<!-- cc-brief:inflight -->/{s=1} /<!-- \/cc-brief:inflight -->/{s=0; next} !s' "$f" \
    | grep -oE 'github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(issues|pull)/[0-9]+|(^|[^A-Za-z0-9_/&])#[0-9]+' \
    | sed -E 's#^github\.com/([^/]+/[^/]+)/(issues|pull)/#\1 #; s#^.*\##'"$slug"' #' | sort -u)
  [ -n "$refs" ] && mkdir -p "$dir" 2>/dev/null || return 0
  while read -r s n; do
    [ -n "$n" ] || continue   # a bare #N with no github origin to read it against
    o="$dir/${s//\//_}_$n.md"
    if ( cd / && timeout -k 5 30 gh api "repos/$s/issues/$n" --jq '"# \(.title) (\(.html_url), \(.state))\n\n\(.body // "")"' \
         && timeout -k 5 60 gh api "repos/$s/issues/$n/comments" --paginate --jq '.[] | "\n## \(.user.login), \(.created_at)\n\n\(.body)"' ) > "$o.tmp" 2>/dev/null
    then mv "$o.tmp" "$o"; else rm -f "$o.tmp"; fi
    if [ -f "$o" ]; then saved+=("$o"); else unread+=("$s#$n"); fi
  done <<<"$refs"
  [ ${#saved[@]} = 0 ] || printf ' Your sandbox has no GitHub login, so the host saved the issues and PRs task.md names (title, body and comments): %s.' "$(printf '%s\n' "${saved[@]}" | paste -sd' ' -)"
  [ ${#unread[@]} = 0 ] || printf ' The host could not fetch %s, and your sandbox cannot either: if the brief does not quote what you need from it, append STATUS: BLOCKED: paste the text of %s into task.md.' "${unread[*]}" "${unread[*]}"; }
SPEND="$(dirname "$BIN")/config/spend-prompt.md"   # what a session spends — written ONCE, in core/, for every session kind
spend_block(){   # → that shared rule with a leading space, or NOTHING if the file is missing, like the three above.
                 # The worker is the kind this bites hardest: it runs unattended in a loop, so an iteration that
                 # carries everything, wakes the planner per stage or buys a second read of its own diff does it
                 # again on the next iteration and nobody is watching. `cc selfcheck` covers the other three
                 # variants; this prompt is built here, so the cases for it are below.
  local p; p=$(cat "$SPEND" 2>/dev/null); [ -n "$p" ] || return 0; printf ' %s' "$p"; }
MAIL="$(dirname "$BIN")/config/mail-prompt.md"   # that the box sends e-mail, and how — written ONCE, in core/, for every session kind
mail_block(){   # → that shared text with a leading space, or NOTHING if the file is missing, like the four above.
                # A worker's thread in #<repo> is a place like any other: a person can ask for a mail
                # there, and a brief can call for one. `cc selfcheck` covers the other kinds; the case is below.
  local m; m=$(cat "$MAIL" 2>/dev/null); [ -n "$m" ] || return 0; printf ' %s' "$m"; }
LIBRARY="$(dirname "$BIN")/config/library-prompt.md"   # the reading rule: ask the record before you claim — written ONCE, in core/, for every session kind
library_block(){   # → that shared rule with a leading space, if the file is there, then whose records are whose.
                   # A worker claims more than anyone with nobody watching: a journal line, a board note, a BLOCKED
                   # question, a PR body — each is read by a person later. `cc selfcheck` covers the other kinds;
                   # this prompt is built here, so the case for it is below. Since #1600 a --go worker reads the owner's
                   # aggregate and the whole register, every member's records among them, so on a repo members share a
                   # row one member worded could lead it to quote another member's records where the first one reads.
  local l; l=$(cat "$LIBRARY" 2>/dev/null); [ -n "$l" ] && printf ' %s' "$l"
  printf ' A record stamped ws=<handle> belongs to that member, so never quote or summarise it into a thread, PR, file or message another member can read; the owner'"'"'s own records (ws=owner) are not limited by this.'; }
ASK="$(dirname "$BIN")/config/ask-prompt.md"   # WHOM TO ASK — the perms session among them, so the box's own workers only
ask_block(){   # → that rule with a leading space, or NOTHING if the file is missing or this worker runs inside a member
               # workspace's boundary: "a member workspace may not" ask perms (~/COMMS.md), and its seat is its route.
  [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && return 0
  local a; a=$(cat "$ASK" 2>/dev/null); [ -n "$a" ] || return 0; printf ' %s' "$a"; }
JOURNAL_CAP=6000   # bytes of journal an iteration's prompt carries — the same six thousand the byte tail carried
journal_block(){   # $1 the journal → THE CHECKPOINT VIEW of it (cc-lib view): the newest whole entries that fit the cap, latest
                   # last, under a header that says how many of how many are shown and how to reach the rest (`cc-lib ask`).
                   # `tail -c` started mid-line inside whatever entry the byte count fell in, and the iteration read the rest
                   # of a half entry it could not place; the view starts at an entry and names the entries it left out. Where
                   # cc-lib is missing or fails the tail is what it was, so an iteration never starts with no journal at all.
  [ -x "$BIN/cc-lib" ] && timeout 10 "$BIN/cc-lib" view "$1" --cap "$JOURNAL_CAP" 2>/dev/null && return 0
  tail -c "$JOURNAL_CAP" "$1"; }
selfrev_block(){   # $1 the base branch → the self-review paragraph the worker prompt carries, or NOTHING if the
                   # checklist is missing. The worker reads the diff against it before STATUS: DONE, so the review
                   # stops fewer PRs for what the worker could have seen itself. Its six headings are inlined rather
                   # than linked because a sandboxed worker (cc-sandbox) has core/bin bound and no core/templates, and
                   # a prompt that points at a path the worker cannot open is worse than one that says nothing; the
                   # prose under each heading stays in the file, and the cc-green steps are said here in one line.
  [ -r "$CHECKLIST" ] || return 0
  printf " Before you append 'STATUS: DONE', read \`git diff origin/%s\` against the LANDING SELF-REVIEW (templates/self-review.md; an entry that is wrong is fixed THERE) and fix what it finds:%s Then hand over a tree a suite has passed on: \`cc-green start\`, then end the iteration: the loop waits on the run with no model call and journals its exit and log for the next iteration (\`cc-green stop\` ends your own run; never setsid, nohup or &). It also names lines of the defect classes the review keeps stopping PRs for. Edit nothing after a green run.\n" \
    "$1" "$(sed -n 's/^\([0-9]\)\. \*\*\([^*]*\)\*\*.*/ \1. \2/p' "$CHECKLIST" | tr -d '\n')"; }
WORKER_PROMPT="$(dirname "$BIN")/config/worker-prompt.md"   # the worker prompt's own words, a file a person edits (the prompt mirror)
sp_worker(){   # $1 the base branch → the whole system prompt a headless worker is given. A function, like the
               # three in `cc`, so `cc-loop selfcheck` can read the prompt a worker really gets, not a copy of it.
               # Its words are WORKER_PROMPT, wrapped for editing and joined back into one line here: {track},
               # {repo}, {state} and {base} are filled in, the blocks below are appended. The replacements are quoted
               # because bash 5.2 reads a bare & in one as the matched text. No file, no prompt: the caller stops.
  local p; p=$(sed 's/[[:space:]]*$//' "$WORKER_PROMPT" 2>/dev/null | tr '\n' ' ') && [ -n "${p// /}" ] || return 1
  p=${p% }; p=${p//\{track\}/"$track"}; p=${p//\{repo\}/"$repo"}; p=${p//\{state\}/"$ST"}; p=${p//\{base\}/"$1"}
  printf %s "$p$(onto_block)$(issue_block)$(sandbox_block)$(dispatch_block)$(worker_writing_block)$(raise_block)$(spend_block)$(mail_block)$(library_block)$(ask_block)$(selfrev_block "$1")"; }
this_iteration(){   # the lines $2 has gained since the snapshot $1 was taken — BY POSITION, never by text.
  # A set difference (`grep -vxFf`) drops a line because an identical one is already in the snapshot, and
  # 'STATUS: DONE' is the same eleven bytes every time: a re-dispatched track whose journal already carried one
  # wrote it again, the difference came back empty, and the loop ran on past a task that was finished. Where a
  # line IS is what makes it this iteration's; what it SAYS is not. The old rule's point is kept — from the first
  # line that differs, everything is this iteration's, so a journal the worker rewrote counts from the rewrite
  # and an untouched STATUS line from a previous dispatch is still invisible.
  # …and the snapshot is matched BY NAME, not by `NR==FNR`: a track on its first iteration has an EMPTY journal,
  # awk reads no record from it, and `NR==FNR` is then true for the SECOND file — every line of it swallowed as
  # "already there", so the first STATUS line a new track ever writes was invisible (caught by selftest.sh's w11).
  awk -v f1="$1" 'FILENAME==f1{a[FNR]=$0; n=FNR; next} !f && FNR<=n && a[FNR]==$0 {next} {f=1; print}' \
      "$1" "$2" 2>/dev/null; }

already_pushed(){   # $1 a STATUS: BLOCKED line → 0 and "<shas> on <remote>/<branch> (tip <short>)" when it only asks for a push the remote already has
  # A sandboxed worker cannot push, so it sometimes stops on "merge <sha> is committed locally but cannot be pushed
  # from the sandbox; push from the host". By then this loop's own cc-checkpoint --push (above it, every iteration)
  # or the delivery path has already put that sha on the track branch, so the stop pages the seat for nothing: three
  # rows on 10-13 cost a planning turn each to fetch, compare and clear it by hand. Cleared here only when the line
  # is a push ask in that shape and asks NOTHING else: split at ';' and '.', with each commit-shaped word (hex with a
  # digit) read as SHA, EVERY clause must be one whole sentence of the shape ("merge SHA is committed locally but
  # cannot be pushed from the sandbox", "push from the host", "the sandbox has no credentials") and one of them a
  # push clause. A word-by-word allowlist let "...; please merge it to branch track/release" through, since each of
  # its words is a push-ask word; a clause in no shape, a '?' anywhere ("should I force-push SHA?"), or a tail on a
  # shaped clause ("push from the host and decide the port") stays a stop. The words are split with `read -a`, so a
  # glob character on the line is never expanded against the worktree. The line must also name at least one commit,
  # and EVERY sha-shaped word in it must be a commit already contained in the branch's remote-tracking ref, which a
  # push from any worktree of the repo updates. Anything else, an unknown sha, no tracking ref, stays the person's stop.
  local q="$1" br r tip w n=0 said="" c="" pushc=0 ws own
  br=$(git -C "$WT" symbolic-ref -q --short HEAD 2>/dev/null) || return 1
  # A push "to track/<name>" is this row's push only when <name> is this row's: "push from the host to
  # track/release" asks for a push to another branch, which no ref of this one answers.
  own=$(sed 's/[][\.*^$+?(){}|/]/\\&/g' <<<"$br" | tr 'A-Z' 'a-z')
  local subj="(SHA( (and )?SHA)*|it|this|them)"
  local A="^((the )?(merge|commit|commits|head) )?$subj( (is|are|was))?( (committed|made))?( locally| local)?( but)? (cannot|can't|can not) be pushed( (from|in) (the |this )?sandbox)?( here)?( no (push )?credentials?)?$"
  local B="^(so )?(please )?push( $subj)? from the host( to (origin|the (track )?branch|$own))?$"
  local C="^((the )?sandbox has no (push )?credentials?|no (push )?credentials? in the sandbox)$"
  case $q in *'?'*) return 1;; esac
  read -ra ws <<<"$(sed -E 's/^STATUS: BLOCKED:[[:space:]]*//; s/([;,.:()])/ \1 /g' <<<"$q" | tr 'A-Z' 'a-z')"
  for w in "${ws[@]}" ';'; do
    case $w in
      ';'|.) [ -z "$c" ] && continue
             if [[ $c =~ $A || $c =~ $B ]]; then pushc=1; elif ! [[ $c =~ $C ]]; then return 1; fi; c="";;
      ,|:|'('|')') ;;
      *) [[ $w =~ ^[0-9a-f]{7,40}$ && $w =~ [0-9] ]] && w=SHA; c="${c:+$c }$w";;
    esac; done
  [ "$pushc" = 1 ] || return 1
  r=$(git -C "$WT" config --get "branch.$br.remote" 2>/dev/null); r=${r:-origin}
  tip=$(git -C "$WT" rev-parse -q --verify "refs/remotes/$r/$br^{commit}" 2>/dev/null) || return 1
  for w in $(grep -oiE '\b[0-9a-f]{7,40}\b' <<<"$q" | grep '[0-9]' | tr 'A-F' 'a-f' | sort -u); do
    git -C "$WT" rev-parse -q --verify "$w^{commit}" >/dev/null 2>&1 || return 1
    git -C "$WT" merge-base --is-ancestor "$w" "$tip" 2>/dev/null || return 1
    n=$((n+1)); said="${said:+$said, }$w"
  done
  [ "$n" -gt 0 ] || return 1
  printf '%s on %s/%s (tip %s)' "$said" "$r" "$br" "${tip:0:8}"; }

round_end(){   # $1 did the last iteration commit? · $2 the track's PR, if it has one → "<outcome>|<board word>"
  # Under --no-extend the limit IS the end of the round — a caller may ask for exactly one — so an
  # iteration that committed is the round FINISHING. Reporting that as "the last one committed nothing" and
  # pausing the board read to the owner as a stall over a branch that had just been pushed.
  # …and `review` is a CLAIM THAT THERE IS SOMETHING TO REVIEW, which cc-reconcile reads as one: a `review` row
  # with no PR is "it is waiting on a PR that was never opened", filed to the owner every 20 minutes. --no-extend
  # is a plain `cc` flag, and a hand-run bounded round need not have opened
  # anything — so the word is `review` only where a PR exists to carry it, and otherwise `blocked`: what this line
  # said before the round-over path existed, and what cc-reconcile itself settles a stopped loop on.
  [ "${1:-no}" = yes ] || { printf 'paused|blocked\n'; return 0; }
  [ -n "${2:-}" ] && printf 'over|review\n' || printf 'over|blocked\n'; }

sandbox_block(){   # → what the worker sandbox hides, with a leading space, or NOTHING with the sandbox off (CC_WORKER_SANDBOX=0).
  # Three workers on 2026-10-12 read the masked view as the box broken and stopped BLOCKED on work this loop had
  # already pushed (raised-sandbox-hides-host-checkout). cc-sandbox's HIDDEN-BY-SANDBOX.md says the same in the tree.
  [ "${CC_WORKER_SANDBOX:-}" = 0 ] && return 0
  printf ' %s' "THE SANDBOX HIDES THINGS BY DESIGN: ~/dev/$repo shows only .git and core/bin (the host tree is intact), and push, gh and board writes fail. This loop does those on the host, so never stop BLOCKED on them."; }
blocked_by_view(){   # $1 the BLOCKED line → 0 when it blames what the sandbox hides by design (sandbox_block's list), else 1
  # A QUESTION FOR SOMEONE IS NEVER THE VIEW (review of #1229): bare words matched an owner question that merely said
  # "push" or "deleted", and the loop answered it itself. So a line that asks for a decision stands, and the rest must
  # name a failure the sandbox causes, not just a word from one.
  grep -qiE 'owner|decide|decision|approv|permission to|should (i|we)|do you want|which ' <<<"$1" && return 1
  grep -qiE 'git push|push (failed|was refused|rejected)|could ?n.?t push|cannot push|gh auth|not logged in|no (gh )?login|no (github |git )?credential|credential helper|cc-green.*(fail|missing|not found|no such|could ?n.?t)|green\.sh|EROFS|read-only file ?system|board.*(read-only|ro\b)|C compiler|/usr/bin/cc|(looks|shows|listed|are|were|is) (as )?deleted|in(side)? the sandbox|the sandbox (hides|blocks|masks)' <<<"$1"; }
head_pushed(){   # → 0 when the worktree's HEAD IS origin's track/<track>, the ref the checkpoint above pushes to. Equal, never
  # an ancestor: a branch someone else moved on origin is cc-checkpoint's own refused-lease BLOCKED, and stands.
  local h o; h=$(git -C "$WT" rev-parse -q --verify HEAD 2>/dev/null) || return 1
  o=$(git -C "$WT" rev-parse -q --verify "refs/remotes/origin/track/$track" 2>/dev/null) || return 1; [ "$h" = "$o" ]; }
inside_boundary(){ [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; }   # set by `cc-sandbox member`: this loop runs inside a workspace's boundary
complete_task(){   # → the completion receipt on stdout (the JSON delivery_end reads); the rest goes to $LOG
  # INSIDE A MEMBER WORKSPACE'S BOUNDARY there is no lander: ~/.cc/lander is not bound, so `cc-land queue --task`
  # refused with "no pinned release" and printed no receipt, and every finished member task stopped at exit 12 with
  # its PR unqueued (2026-09-28 to 10-03, ten loops). The boundary's own completion is `cc done --json` — it commits,
  # pushes on the workspace's token and opens the PR in the project's repository — and the HOST queues the landing:
  # cc-checkpoint --sweep, within five minutes, as <h>--<track> (docs/design-member-workspaces.md, Landing). So in
  # there the receipt is cc done's own, with a landing line that says who queues it; nothing in here can.
  if inside_boundary; then
    local r; r=$(env "${HG[@]}" "${CC_DONE:-$BIN/cc}" done "$repo" "$track" --json 2>>"$LOG")   # CC_DONE: test hook
    # the landing line only on a receipt that names a PR: a failed one has nothing for the sweep to pick up
    jq -ce 'if type == "object" and (.pr_url // "") != "" then .landing = {status: "host", message: "The box picks it up from here: if this workspace lands its own PRs, its sweep queues the PR within five minutes."} else . end' <<<"$r" 2>/dev/null || printf '%s\n' "$r"
  else
    env "${HG[@]}" "${CC_LAND:-$BIN/cc-land}" queue --task "$repo" "$track" 2>>"$LOG"   # CC_LAND: test hook
  fi; }
delivery_end(){   # $1 host receipt → outcome. A real PR survives a failed board/card projection.
  jq -er '
    if type != "object" or (.task_id | type) != "string" or (.errors | type) != "array" then "unknown"
    elif (.pr_url // "") != "" then
      if (.pending | length) > 0 then "pending" else "delivered" end
    elif any(.errors[]; .stage == "commit" or .stage == "push" or .stage == "pr") then "failed"
    elif (.committed_sha // "") == "" then "unknown"
    elif (.pending | length) > 0 then "pending"
    elif (.errors | length) > 0 then "unknown" else "delivered" end' <<<"${1:-}" 2>/dev/null || echo unknown; }

worker_base(){   # $1 repo → the branch a worker is told never to touch and reviews its own diff against. The BOARD's
  # base, and never a track: origin/HEAD is only what a REMOTE calls its default, and for a repository the box made
  # that is the first branch pushed into it, a track. Cut from one of those, a new track carried another project's
  # whole tree into a fresh repository (2026-09-04) — the same rule and order as cc's default_branch().
  local b; b=$("$BIN/cc-board" base "$1" 2>/dev/null)
  case "$b" in track/*|'') b=$(git -C "$HOME/dev/$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##') ;; esac
  case "$b" in track/*|'') b=main ;; esac
  printf '%s\n' "$b"; }

# A ROW CLOSED WHILE ITS LAUNCH WAITED (raised-done-row-still-launches-its-queued-worker): a seat folded a row and set it
# done while its --go sat in cc-room, the worker started anyway, ended DONE with nothing to deliver, and the row went
# back to blocked with a "retry cc done" nobody should follow. Every --go claims the row (queued or running) before
# the launch, so a row that says done or merged when the loop starts was closed after it was dispatched. Prints the
# status when it is one of those; a board that cannot be read is not closed.
row_closed(){ local s; s=$("$BOARD" get "$repo" "$track" status 2>/dev/null) || return 1
  case "$s" in done|merged) printf '%s\n' "$s" ;; *) return 1 ;; esac; }
row_title(){ "$BOARD" get "$repo" "$track" title 2>/dev/null | grep . || printf '%s\n' "${track//-/ }"; }   # what the row is ABOUT; its name in words when the board has no title for it
# THE DONE CARD. A person reads it, so it names the work by its title and prints no empty slot ("PR: ." was a real
# card): $1 the PR link or nothing, $2 a sentence on the landing or nothing. The title still routes it to the thread.
done_card(){ local s="" id; [ -n "$1" ] && s="The PR is $1."; [ -n "$2" ] && s="${s:+$s }$2"
  # THE THREAD AND THE SEAT, one line each: the title routes the card into the track's own thread, and the seat that
  # dispatched it gets the same line by the broker (a digest, not a page) — a DONE used to reach the -updates lane
  # only, and a finished track sat unseen (a-finished-worker-reaches-its-thread, 2026-09-20).
  # …and the seat's line carries the `cc-try on` command for that PR, so a green fix goes live without anyone having
  # to remember to look (cc-try hint: nothing when the PR has no tool to try or touches a file that guards the box).
  local try=""; [ -n "$1" ] && [ -x "$BIN/cc-try" ] && try=$("$BIN/cc-try" hint "$repo" "$1" "$track" 2>/dev/null | head -1)
  local told=0; tell_planner "$(planner_line done "$(row_title). ${s:-It finished without a PR.}${try:+ $try}")" || told=$?
  done_heard "$told"   # the verdict on that one line: no second inject (done_heard)
  # ONE CARD PER PR (per commit without one): a repair round that ends DONE on the same PR again posts nothing new.
  if [ -n "$1" ]; then id="pr${1##*/}"; else id=$(git -C "${WT:-.}" rev-parse --short HEAD 2>/dev/null); fi
  # The card's bold line is the row title alone; its body says in plain words that it finished, and names the PR.
  "$BIN/cc-notify" --id "done:$repo/$track:${id:-none}" -t "$repo/$track done" --heading "$(row_title)" "That's finished. ${s:-There is no PR for it.}"; }
planner_line(){ printf 'loop: %s/%s %s — %s\n' "$repo" "$track" "$1" "$(printf '%s' "$2" | tr '\n' ' ')"; }   # $1 title · $2 message -> the ONE line the session gets
# THE HEADING OF A STOP: the row's title and then what happened to it, as a sentence. Most stop titles already read
# as a verb phrase after the title ("needs you", "hit its cap", "is running away"); the few that do not are said in
# words here. The title itself is untouched — it routes the notice, names the failures-ledger record and goes to the
# planner, and only the bold line a person sees is built from it.
stop_headline(){ local said="$1" h
  case "$1" in
    waiting) said="is waiting" ;;
    paused) said="is paused" ;;
    errored) said="failed twice in a row" ;;
    'delivery unconfirmed') said="finished, but the box could not confirm what it delivered" ;;
  esac
  h="$(row_title) $said"; printf '%s\n' "${h^}"; }
# WHO THIS TRACK ANSWERS TO. `<repo>` is the session that dispatched it — the same target cc-reconcile's board
# watchdog uses, so the planner's events all arrive by one door.
seat_windows(){ tmux list-windows -t main -F '#W' 2>/dev/null | sort -u; }   # the box's live seats: cc names each window by its broker key
                                                                            # (`<repo>` a repo seat, `<repo>@<alias>` an orch); grouped sessions repeat, hence sort -u
orch_record(){   # written ONCE at start: the orch this loop was dispatched by, as its OWN broker key `<orchrepo>@<alias>`, or no file.
                 # The alias is CC_SLACK_ALIAS, which an orch's shell exports (cc __runorch); the orch's repo is CC_ORCH_REPO when the
                 # dispatcher carries it, else the one live `<x>@<alias>` window. An orch in study-coach dispatching into lesson-builder
                 # is study-coach@<alias>, not lesson-builder@<alias>, which nobody owns. No unique answer: the alias alone, the old key.
                 # NOT THE ALIAS ALONE (raised-film-stops-skip-the-video-seat): a seat unsets CC_SLACK_ALIAS to run its suites, and a
                 # dispatch made that way, or any later one with no alias, wiped the record, so two film rows' stops reached the control repo's
                 # session and not the orch that sent them. `cc` also carries CC_DISPATCH_WIN, the tmux window it ran in, which is
                 # the dispatcher's own broker key: `<repo>@<alias>` there is that orch, anything else is not an orch. A dispatch
                 # that names neither (a relaunch from no seat) keeps the record it finds and takes ORCH_KEY back from the host-side
                 # copy below, which the worker cannot write, so another repo's orch still gets its stop (review of #1238).
                 # THE HOST-SIDE COPY, ${ST%/*}/.dispatch/<track>: the full key, which the landing's merge notice reads (cards.py
                 # tell_dispatcher). A worker's sandbox binds only $ST, so it can rewrite $ST/orch but not this one.
  local a="${CC_SLACK_ALIAS:-}" r="${CC_ORCH_REPO:-}" w="${CC_DISPATCH_WIN:-}" hd="${ST%/*}/.dispatch"
  if [ -z "$a" ] && [[ "$w" =~ ^([A-Za-z0-9._-]+)@([a-z0-9-]{2,20})$ ]]; then a=${BASH_REMATCH[2]}; r=${BASH_REMATCH[1]}; fi
  if [ -z "$a" ] && [ -z "$w" ]; then ORCH_KEY=$(head -1 "$hd/${ST##*/}" 2>/dev/null | tr -d '[:space:]')
    [[ "$ORCH_KEY" =~ ^[A-Za-z0-9._-]+@[a-z0-9-]{2,20}$ ]] || ORCH_KEY=""; return 0; fi
  [ -n "$a" ] || { ORCH_KEY=""; rm -f "$ST/orch" "$hd/${ST##*/}"; return 0; }
  if [ -z "$r" ]; then r=$(seat_windows | awk -F@ -v a="$a" 'NF==2 && $2==a && $1!="" {print $1}'); [ "$(grep -c . <<<"$r")" = 1 ] || r=""; fi
  ORCH_KEY="${r:+$r@}$a"; printf '%s\n' "$ORCH_KEY" > "$ST/orch"
  mkdir -p "$hd" 2>/dev/null && printf '%s@%s\n' "${r:-$repo}" "$a" > "$hd/${ST##*/}" 2>/dev/null; return 0; }
dispatch_receipt(){   # WHO SENT THIS TRACK OFF, one line in the hop receipts (~/.cc/receipts/<UTC day>.jsonl, CC_RECEIPTS_DIR), for
                      # cc-live's who-talks-to-whom: {at, t, stage:"sent", via:"dispatch", from, to:"<repo>/<track>", loop}, written
                      # at start whether or not an alias was set. `from` is the dispatcher's window (CC_DISPATCH_WIN), else the
                      # key orch_record settled on, else none; a member's is `member` and so is its track, counted, never named.
                      # stage "sent" is a stage cc-receipts checks nothing on. Best effort: it never fails or prints. A suite
                      # fixture's repo (_cctest*, _selfcheck*) leaves none, as in cc-msg: the e2e suites run under the real HOME.
  local d="${CC_RECEIPTS_DIR:-$HOME/.cc/receipts}" from="${CC_DISPATCH_WIN:-${ORCH_KEY:-}}" to="$repo/$track"
  case "$repo" in _cctest*|_selfcheck*) return 0;; esac
  if [ "${CC_MEMBER_SANDBOX:-}" = 1 ] || [ "${CC_ROLE:-}" = member ] || [ -f "$HOME/dev/$repo/.cc/member-workspace" ]; then
    from=member; to=member; fi
  { mkdir -p "$d" && jq -cn --arg at "$(date -u +%FT%TZ)" --argjson t "$(date +%s)" --arg from "$from" --arg to "$to" \
      --argjson loop "${MAXI:-0}" '{at:$at,t:$t,stage:"sent",via:"dispatch",to:$to,loop:$loop}
                                    + (if $from != "" then {from:$from} else {} end)' >> "$d/$(date -u +%F).jsonl"; } 2>/dev/null
  return 0; }
ORCH_KEY=""   # what orch_record wrote, held by THIS process: $ST/orch is writable by the worker, so the file is trusted less
# THE RESTART LINE A STOP PRINTS (raised-a-limit-stopped-repair-cannot-restart, 2026-10-17): a row whose PR is out for
# landing refuses a plain --go as delivery-pending, so a repair round that stopped (#1104's rebase, on a usage limit)
# printed a restart line that could not restart it. Such a row is restarted through --repair; any other with a plain --go.
again(){ if "$BIN/cc-task" show "$repo" "$track" 2>/dev/null | jq -e 'select(.closed == null) | .pr.url // empty' >/dev/null 2>&1
  then printf 'cc %s %s --go "" --repair' "$repo" "$track"; else printf 'cc %s %s --go ""' "$repo" "$track"; fi; }
stop_target(){   # the broker key a stop goes to: "a track dispatched by an orch has its stop notice addressed to that orch's alias,
                 # the repo seat only when none is recorded" (the brief). A record `<orchrepo>@<alias>` is used as it is; a bare alias
                 # (an older record, or no orch repo found) is `<track repo>@<alias>`; anything else is the repo seat.
                 # ANOTHER REPO'S ORCH ONLY FROM THIS PROCESS'S OWN ORCH_KEY. Read back from the file (a host-side
                 # `member-stop`, or a record the worker rewrote) the key is pinned to this repo: `<x>@<alias>` there
                 # is `<track repo>@<alias>`, so a planted record cannot aim a stop at another repo's seat (review of #635).
  local a; a="${ORCH_KEY:-$(head -1 "${ST:-/nonexistent}/orch" 2>/dev/null | tr -d '[:space:]')}"
  if [ -n "$ORCH_KEY" ] && [[ "$a" =~ ^[A-Za-z0-9._-]+@[a-z0-9-]{2,20}$ ]]; then printf '%s\n' "$a"
  elif [[ "$a" =~ ^[A-Za-z0-9._-]+@([a-z0-9-]{2,20})$ ]]; then printf '%s@%s\n' "$repo" "${BASH_REMATCH[1]}"
  elif [[ "$a" =~ ^[a-z0-9-]{2,20}$ ]]; then printf '%s@%s\n' "$repo" "$a"; else printf '%s\n' "$repo"; fi; }
target_live(){ grep -qxF -- "$1" <<<"$(seat_windows)"; }   # $1 a broker key -> 0 a seat window of that name is open (no pipe: grep -q
                                                            # quitting early SIGPIPEs the writer, and under pipefail a live seat read as dead)
# WHAT "HEARD" MEANS. cc-broker's inject prints `delivered` and exits 0 for anything it takes, whether or not a session is
# there (it holds and retries), so rc 0 is "sent to the broker", never proof a session read it. The loop adds the one
# thing it can see: whether a window for that key is open. Sent to a key with no window is reported as unheard, never silent.
# ONE BROKER CALL PER DONE: done_card's own tell_planner is the line the seat or orch gets, and this only says whether it
# was heard. A second inject of its own made an orch hear every DONE twice (review of #635, findings 2 and 19).
done_heard(){   # $1 tell_planner's rc for the DONE line done_card just sent → the liveness verdict on it, logged; a DONE
                # sent to a recorded orch nobody could hear is a board note too. No orch recorded: the repo seat's line and the card.
  # INSIDE A MEMBER BOUNDARY the broker is never asked (tell_planner), and the card goes out by the workspace's own socket,
  # which the host relays (cc-slack escalate) — so "nobody heard it" would be false there (review of #635, finding 12).
  inside_boundary && { log "DONE: inside the member boundary the broker is not asked; the card goes out by the workspace's relay"; return 0; }
  [ -s "${ST:-/nonexistent}/orch" ] || { log "DONE: no orch recorded, so the repo seat's broker line and the card carry it"; return 0; }
  local tg w; tg=$(stop_target)
  if [ "$1" = 0 ]; then
    target_live "$tg" && { log "DONE sent to the broker for $tg, whose session is live"; return 0; }
    w="DONE sent to the broker for $tg, but no session is live there — nobody has heard it"
  else w="DONE: nobody heard it — the broker would not take it for $tg"; fi
  log "$w"; "$BOARD" note "$repo" "$track" "$w" >/dev/null 2>&1; return 0; }
# A THROWAWAY REPO (cc-throwaway: a harness benchmark's hb-N) HAS NOBODY TO TELL. It has no seat, and its stops and
# DONEs are the benchmark's to read off the board and loop.log: five hb-N runs each left a done-undelivered record
# (one false recurring cluster) and the pulse started a seat for each, live 9 h after the repos were deleted.
throwaway(){ "$BIN/cc-throwaway" is "$repo" >/dev/null 2>&1; }
tell_planner(){   # $1 the line -> 0 the broker has it and owns the escalation from here, 1 nobody does
  case "$repo" in _cc*) return 1;; esac   # a suite's scratch namespace (`_cc<suite><pid>`, cc-board `real`) has no session, and a
                                          # fixture must not reach the box's own broker state — the reason cc-notify refuses to push one
  # INSIDE A MEMBER WORKSPACE'S BOUNDARY (cc-sandbox member) none of this exists: no broker state, and the only door
  # out is the workspace's own socket, which cc-notify already takes (`cc-slack escalate`). A broker that answered
  # `delivered` on a daemon that never heard it would swallow that tier's one escalation, so it is not asked at all.
  [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && return 1
  throwaway && return 0                   # nobody is owed the line, so it is not a line nobody took either
  [ -x "$BIN/cc-broker" ] || return 1     # no broker on this copy: the owner is the fallback, exactly as before
  # 30 s is what cc-reconcile allows its own inject. Being killed past it loses nothing: cc-broker
  # writes the event down BEFORE it sends anything, so its own 60 s flush delivers what this gave up waiting for.
  # The cost of the timeout is therefore a duplicate — a page AND a late wake — and never a dropped stop.
  timeout 30 "$BIN/cc-broker" inject --no-start --source loop "$(stop_target)" "$1" >/dev/null 2>&1; }
stop_unheard(){   # a stop NO session took: "a request that reached no seat is preserved and retried, never dropped and never
                  # dumped on the owner" (core/docs/comms-contract.md). cc-notify --ask writes it under ~/.cc/requests and
                  # cc-reconcile's tick re-offers it to the seat's broker. The id is minute-floored: two stops of one track
                  # inside a minute (a relaunch that dies the same way) are one request; a stop a day later is a new one.
                  # It stays time-based although `cc-notify requests answer` now closes a request (and an answered id
                  # asked again is a new request): a seat usually answers a stop by relaunching the track, which closes
                  # nothing, so a stable id would leave the first stop open and swallow every later one as its dedup.
  "$BIN/cc-notify" --ask --id "stop:$repo/$track:$(date -u +%Y%m%dT%H%MZ)" -t "$repo/$track $1" "$2" >/dev/null 2>&1; }   # its exit: 0 filed, else nobody has it
stop_route(){   # $1 heard (sent|yes: a live seat has it · dead: the broker took it for a key with no live seat · no: nobody took it)
                # · $2 title · $3 message → the log line saying where the stop went, filing the request when no session took it.
                # Inside a member boundary the broker is never asked, so it read "session: no" while the request reached the planning
                # seat within a minute and the workspace's own seat heard nothing (a member track, 2026-09-27): the line says both now,
                # and the host's escalate relay hands that seat the line (cc-slack, raised-a-spend-limit-stop-reaches-no-one).
  case "$1" in sent|yes) printf "the stop went to %s's session: yes, whose session is live\n" "$(stop_target)"; return 0;; esac
  local r=no; stop_unheard "$2" "$3" && r=yes
  printf "the stop went to %s's session: no%s — filed as a request for the planning seat%s: %s\n" "$(stop_target)" \
    "$([ "$1" = dead ] && printf " (the broker took it, but no session is live there, so nobody has heard it)")" \
    "$([ "${CC_MEMBER_SANDBOX:-}" = 1 ] && printf ", whose relay hands %s's own seat the line" "$repo")" "$r"; }
stop_kind(){ case "$1" in 5|6|10) echo worker-loop/barren-stop;; 4|12) echo worker-loop/done-undelivered;; 8) echo worker-loop/limit-outlasted-wait;; *) :;; esac; }
stop_record(){   # $1 exit code, $2 title, $3 message → one failures-ledger record for a stop that is a failure (stop_kind), none for the rest.
                 # Prints what the ledger said; exit 0 always — "a writer that fails must never fail" the stop it is in.
  local k r; k=$(stop_kind "$1"); [ -n "$k" ] || { echo "not a failure (exit $1)"; return 0; }
  # INSIDE A MEMBER'S BOUNDARY neither the catalogue (core/config) nor the ledger (~/.cc/failures) is bound, so a
  # record made here went nowhere. The host writes it when the boundary exits (member_stop below), from the exit code.
  inside_boundary && { echo "left to the host: it records exit $1 when the boundary exits"; return 0; }
  r=$("$BIN/cc-green" red "$repo" "$k" "loop:$repo/$track:$1:$$" --observed "cc-loop exit $1 ($2): $3"         --expected "a worker loop ends in a PR, a DONE or a question" --log "${LOG:-}" --writer cc-loop         --link "track=$track" --link "exit=$1" --cost "iterations=${i:-0}" --cost "usd=${spent:-0}" 2>&1 | tail -1) || r="not recorded: cc-green red failed"
  echo "${r:-not recorded: cc-green red said nothing}"; return 0; }
member_stop(){   # $1 handle, $2 track, $3 the exit code `cc-sandbox member … -- cc-loop` returned → one failures-ledger
  # record ON THE HOST for a member loop's stop ("after cc-sandbox member exits, the host records the stop from the exit
  # code and the host-bound loop.log" — the brief). cc runs this after the boundary, in the same tmux window.
  # NOTHING THE MEMBER WROTE IS COPIED IN: the exit code picks one of stop_kind's fixed kinds and the observed text is
  # the host's own. The log is a link only, never an excerpt (cc-green red --log would copy member text into the
  # ledger the planning seat reads), and nothing is written into the member's state dir (a planted link there would
  # take a host append anywhere). Always exit 0, as stop_record: a writer that fails never fails the stop it is in.
  # THE LINK IS NAMED member-log, NOT log: that path is the member's to write, so it can be a link to anything of the
  # host's. Nothing in the box opens a record's links today (cc-failures prints them as text); whatever comes to read
  # this one opens it O_NOFOLLOW as a regular file, the way members.member_board reads a member's board (review of #965).
  # AN UNDELIVERED FINISH IS DELIVERED HERE (raised-member-worker-finish-always-needs-the-host): exit 4 or 12 inside is
  # "cc done … on the host", which a seat used to run by hand after a planning wake-up. This is the host, so it runs that
  # very command: the host's own $BIN/cc, named by nothing the member wrote, on a handle and track checked below, and
  # cc done keeps its own walls for a member's tree (member_gitdir, the main checkout's hooksPath, push-state off the
  # binds). Delivered is no failure: no record, and cc done's card is the word. Not delivered: the record, and the
  # workspace's own seat is told, since inside nobody was (stop() leaves exit 4 to the host).
  local h=${1:-} t=${2:-} rc=${3:-} k r dout drc
  inside_boundary && { echo "cc-loop member-stop: the host side of the boundary only" >&2; return 0; }
  [[ "$h" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$t" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$rc" =~ ^[0-9]+$ ]] \
    || { echo "cc-loop member-stop: usage: member-stop <handle> <track> <exit code>" >&2; return 0; }
  case "$rc" in 4|12)
    dout=$("${CC_DONE:-$BIN/cc}" done "$h" "$t" 2>&1); drc=$?   # CC_DONE: test hook, as in complete_task
    dout=$(printf '%s\n' "$dout" | grep -v '^[[:space:]]*$' | tail -1 | head -c 300)
    [ "$drc" = 7 ] && drc=0   # pushed, the ready-to-land note filed as a request: delivered (the loop's own reading of cc done)
    [ "$drc" = 0 ] && { echo "delivered by the host: cc done $h $t — ${dout:-no output}"; return 0; }
    echo "the host's cc done $h $t failed (rc $drc): ${dout:-no output}";;
  esac
  k=$(stop_kind "$rc"); [ -n "$k" ] || { echo "failures ledger ($h): not a failure (exit $rc)"; return 0; }
  # ST="": the member's own orch file is never read here, so the line goes to the workspace's seat, `<handle>` itself
  case "$rc" in 4|12) ( repo=$h track=$t ST="" BOARD="$BIN/cc-board" ORCH_KEY=""
    { tell_planner "$(planner_line "finished, but opened no PR" "the worker finished inside the boundary and the host's cc done failed (rc $drc). Fix the cause, then: cc done $h $t")" && target_live "$h"; } \
      || stop_unheard "finished, but opened no PR" "the host's cc done failed (rc $drc); then: cc done $h $t" ) >/dev/null 2>&1 || :;; esac
  r=$("$BIN/cc-green" red "$h" "$k" "loop:$h/$t:$rc:host:$(date -u +%Y%m%dT%H%MZ)" \
        --observed "a member workspace's cc-loop exited $rc inside its boundary${drc:+, and cc done on the host failed (rc $drc)}" \
        --expected "a worker loop ends in a PR, a DONE or a question" --writer cc-loop \
        --link "track=$t" --link "exit=$rc" --link "boundary=member" --link "member-log=$HOME/.cc/state/$h/$t/loop.log" 2>&1 | tail -1) \
    || r="not recorded: cc-green red failed"
  echo "failures ledger ($h, recorded by the host): ${r:-not recorded: cc-green red said nothing}"; return 0; }
tier_hold(){   # $1 start|continue · $2 repo/track -> 0 the spend tier says this must WAIT, 1 it may go. cc-tier owns the
               # table (`cc-tier allows`); this reads its exit alone: 1 is "wait", 0 is "go", and anything else — no
               # cc-tier on this box, a crash — is "go", the same leniency `cc-pause is` gets: a tier that cannot be
               # read must never be the reason a worker stops.
  "$BIN/cc-tier" allows "$1" "$2" >/dev/null 2>&1; [ $? = 1 ]; }
# A RUNNING WORKER HAS A WAY IN. A headless `claude -p` has no pane to type at, and until 2026-09-24 the one documented
# route answered "no running session" about a worker two minutes into an $8 iteration while a member's missing archive
# sat unread (raised-cannot-message-a-running-worker). Now `cc <repo> <track> --say` hands the text to `cc-loop say`,
# which spools it in $ST/say.spool; the worker's claude runs with a PostToolUse hook (`cc-loop inbox-hook $ST`, passed
# with --settings) that hands the whole spool to the model as context after its next tool call, and moves it to
# say.read with the time it was taken. A spool the iteration ended without taking opens the next iteration's prompt.
# `say` waits SAY_WAIT for the take and says which happened: 0 taken by the live turn, 3 kept for the next tool call or
# iteration (the loop is live, nobody has read it yet), 1 no live loop — nothing was spooled, and the line says so,
# 2 the loop is live but its spool would not take the message (its lock held past SAY_LOCK_WAIT, or a planted name) —
# nothing was sent, and cc must not read it as "no loop" and fall through to a pane (review of #635, finding 16).
# EACH MESSAGE CARRIES ITS OWN ID, and `say` waits for THAT id in say.read: matching the text and the second it was sent
# acked a message still in the spool off two older records (review of #635, finding 5).
# The loop is live when $ST/loop.pid names a running cc-loop for this very track (loop_live): written at start,
# removed on the way out, and a pid reused by something else is not the loop. A member workspace's loop writes a pid
# from inside its sandbox's pid namespace, so for it any host process whose argv has `cc-loop <h> <t>` is the proof: cc
# launches it as ONE `bash -c` string (its tmux window) and cc-sandbox execs bwrap, so an argv element holding spaces is
# read as its words. Matched word by word, never as a regex a `.` in a track name would widen (review of #635, finding 17).
# THE STATE DIR IS THE MEMBER'S TO WRITE. It is bound read-write into a member's boundary and a worker's sandbox, and
# `cc --say` runs on the host as the owner: a `9>` on a planted `.say.lock -> ~/.cc/config` emptied that file before
# flock ran (review of #635, findings 3 and 4). So say.spool, say.read, .say.lock and loop.pid are opened by say_io
# alone: the dir through an O_NOFOLLOW directory descriptor, each file under it O_NOFOLLOW|O_NONBLOCK, kept only if it
# is a regular file with one name, never truncated on open (the lock is O_APPEND; a write truncates only after that
# check). A planted name is refused and said, and nothing is written through it.
SAY_WAIT="${CC_SAY_WAIT:-45}"
say_io(){   # $1 op  $2 the state dir  … → see the ops below; rc 1 "no/none", 2 refused or the lock was not had
  python3 -I - "$@" <<'PY'
import errno, fcntl, json, os, random, stat, sys, time
op, st = sys.argv[1], sys.argv[2]
class Refused(Exception): pass
def say(m): sys.stderr.write("cc-loop: %s\n" % m)
try:
    dfd = os.open(st, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
except OSError as e:
    if op in ("live", "take", "acked", "pidrm"): sys.exit(1)
    say("%s is not a plain directory (%s) — refused, nothing written" % (st, e.strerror)); sys.exit(2)
def fopen(name, flags, create=False):   # st/name, never through a link: a regular file with one name, or None when absent
    try:
        fd = os.open(name, flags | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC | (os.O_CREAT if create else 0), 0o600, dir_fd=dfd)
    except FileNotFoundError:
        return None
    except OSError as e:
        if e.errno == errno.ELOOP: raise Refused("%s/%s is a symlink — refused (nothing here opens a planted name)" % (st, name))
        raise Refused("%s/%s cannot be opened (%s) — refused" % (st, name, e.strerror))
    s = os.fstat(fd)
    if not stat.S_ISREG(s.st_mode) or s.st_nlink != 1:
        os.close(fd); raise Refused("%s/%s is not a plain file — refused" % (st, name))
    return fd
def text(name):
    fd = fopen(name, os.O_RDONLY)
    if fd is None: return ""
    with os.fdopen(fd, "r", encoding="utf-8", errors="replace") as f: return f.read()
def lock():   # the spool's lock, held to exit; None when it was not had inside SAY_LOCK_WAIT
    fd = fopen(".say.lock", os.O_WRONLY | os.O_APPEND, create=True)
    end = time.time() + float(os.environ.get("CC_SAY_LOCK_WAIT", "5"))
    while True:
        try: fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB); return fd
        except BlockingIOError:
            if time.time() >= end: return None
            time.sleep(0.1)
def argv(p):
    try:
        with open("/proc/%s/cmdline" % p, "rb") as f: return [a.decode("utf-8", "replace") for a in f.read().split(b"\0")[:-1]]
    except OSError: return []
def is_(a, name): return a == name or a.endswith("/" + name)
try:
    if op == "live":   # → 0 a cc-loop for this very track runs: its loop.pid, or (a member's) the host's cc-sandbox for it
        r, t = os.path.basename(os.path.dirname(st.rstrip("/"))), os.path.basename(st.rstrip("/"))
        p = (text("loop.pid").split() or [""])[0]
        if p.isdigit():
            a = argv(p)
            if any(is_(x, "cc-loop") and a[i + 1:i + 3] == [r, t] for i, x in enumerate(a)): sys.exit(0)
        for q in os.listdir("/proc"):   # a member's loop: the host's `bash -c '… cc-loop r t …'` (cc's tmux window) or bwrap's argv
            if not q.isdigit(): continue
            w = [y for x in argv(q) for y in (x.split() if any(c.isspace() for c in x) else [x])]   # one string is words too
            if any(is_(x, "cc-loop") and w[i + 1:i + 3] == [r, t] for i, x in enumerate(w)): sys.exit(0)
        sys.exit(1)
    if op == "pidw":   # $3 the pid → loop.pid holds it
        fd = fopen("loop.pid", os.O_WRONLY, create=True); os.ftruncate(fd, 0); os.write(fd, ("%s\n" % sys.argv[3]).encode()); sys.exit(0)
    if op == "pidrm":   # $3 the pid → loop.pid is gone when it still names that pid (a link is not followed, only refused)
        if (text("loop.pid").split() or [""])[0] == sys.argv[3]: os.unlink("loop.pid", dir_fd=dfd)
        sys.exit(0)
    if op == "send":   # $3 from  $4 text → the message's id on stdout, appended to say.spool under the lock
        lk = lock()
        if lk is None: say("the spool lock of %s was held past %ss" % (st, os.environ.get("CC_SAY_LOCK_WAIT", "5"))); sys.exit(2)
        mid = "%x-%d-%06x" % (time.time_ns(), os.getpid(), random.getrandbits(24))
        line = json.dumps({"id": mid, "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "from": sys.argv[3], "text": sys.argv[4]}, ensure_ascii=False)
        fd = fopen("say.spool", os.O_WRONLY | os.O_APPEND, create=True); os.write(fd, (line + "\n").encode()); print(mid); sys.exit(0)
    if op == "take":   # → the spooled messages as one block on stdout, moved to say.read with the time taken; none: rc 1
        if not text("say.spool").strip(): sys.exit(1)
        if lock() is None: sys.exit(1)
        sp = fopen("say.spool", os.O_RDWR)
        if sp is None: sys.exit(1)
        with os.fdopen(os.dup(sp), "r", encoding="utf-8", errors="replace") as f: raw = f.read()
        msgs = []
        for l in raw.splitlines():
            try: m = json.loads(l)
            except ValueError: continue
            if isinstance(m, dict): msgs.append(m)
        if not msgs: os.ftruncate(sp, 0); sys.exit(1)
        taken = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
        rd = fopen("say.read", os.O_WRONLY | os.O_APPEND, create=True)
        os.write(rd, "".join(json.dumps(dict(m, taken=taken), ensure_ascii=False) + "\n" for m in msgs).encode())
        os.ftruncate(sp, 0)
        print("\n".join("[%s from %s] %s" % (m.get("at", ""), m.get("from", ""), m.get("text", "")) for m in msgs)); sys.exit(0)
    if op == "acked":   # $3 the id → 0 say.read holds that very message as taken
        for l in text("say.read").splitlines():
            try: m = json.loads(l)
            except ValueError: continue
            if isinstance(m, dict) and m.get("id") == sys.argv[3] and m.get("taken"): sys.exit(0)
        sys.exit(1)
    say("say_io: unknown op %s" % op); sys.exit(2)
except Refused as e:
    say(str(e)); sys.exit(2 if op in ("send", "pidw") else 1)
PY
}
loop_live(){ say_io live "$1"; }   # $1 the state dir → 0 while a cc-loop for it runs
# THE HOST'S PUSH AFTER AN ITERATION, AND WHAT A FAILED ONE LEAVES. Inside the sandbox the Stop hook commits with no
# credential, so this is the only push a worker's commit gets, and it used to end `|| true`. A rebase round is one
# iteration, so #1239's merge of main sat committed on the box for two rounds while the queue kept the old conflicting
# head (2026-10-13). A head it could not push is now logged and left in ~/.cc/push-owed/<repo>/<track>, which the
# host's 5-minute sweep (cc-checkpoint --sweep) pushes once this loop is gone; the next push that lands clears it. A
# refused lease (rc 2/3) is not owed: --push has told the board and the journal, and a retry would change nothing.
push_host(){
  inside_boundary && return 0   # a member workspace's loop has no credential for --push by design: the host's sweep pushes its heads
  local out rc head ow="$HOME/.cc/push-owed/$repo/$track"
  out=$(cd "$WT" && env "${HG[@]}" CC_ROLE=worker "$BIN/cc-checkpoint" --push 2>&1); rc=$?
  head=$(git -C "$WT" rev-parse -q --verify HEAD 2>/dev/null)
  if [ "$rc" = 0 ]; then rm -f "$ow"; return 0; fi
  log "push of ${head:0:12} failed (rc=$rc): $(tail -1 <<<"$out" | sed -E 's#([A-Za-z][A-Za-z0-9+.-]*://)[^/@[:space:]]*@#\1#g' | cut -c1-200)"   # cc-checkpoint's no_userinfo: a remote url can carry a token
  if [ "$rc" = 2 ] || [ "$rc" = 3 ]; then rm -f "$ow"; return 0; fi
  [ -n "$head" ] && [ "$(cut -d' ' -f1 "$ow" 2>/dev/null)" != "$head" ] || return 0   # already owed at this head: the sweep's line about it stands
  mkdir -p "${ow%/*}" && printf '%s\n' "$head" > "$ow"
  return 0; }
say_take(){ say_io take "$1"; }    # $1 the state dir → the spooled messages as one block on stdout (none: rc 1), moved to say.read
inbox_hook(){   # $1 the state dir. PostToolUse: stdin is the hook's JSON (unread); stdout gives the model its messages
  cat >/dev/null; [ -s "$1/say.spool" ] || exit 0   # every tool call runs this: nothing spooled starts no python
  local m; m=$(say_take "$1") || exit 0
  jq -n --arg c "MESSAGE FROM YOUR DISPATCHER, arriving while you work — read it now and let it change what you do next:
$m" '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $c}}'; exit 0; }
say_send(){   # $1 repo  $2 track  $3 text → the verdict above, and its rc
  local st="$HOME/.cc/state/$1/$2" id n=0
  loop_live "$st" || { echo "cc-loop: no live worker loop for $1/$2 — nothing was sent (its brief is $st/task.md; a new dispatch reads it)" >&2; return 1; }
  id=$(say_io send "$st" "${CC_MSG_FROM:-$(ps -o comm= -p "$PPID" 2>/dev/null)}" "$3") \
    || { echo "cc-loop: the loop for $1/$2 is live, but its spool did not take the message — nothing was sent (reason above)" >&2; return 2; }
  while [ "$n" -lt "$SAY_WAIT" ]; do
    say_io acked "$st" "$id" && { echo "taken by the running worker"; return 0; }
    loop_live "$st" || break; sleep 1; n=$((n + 1)); done
  if loop_live "$st"; then echo "cc-loop: kept for $1/$2, not yet heard — its worker made no tool call in ${SAY_WAIT}s; its next tool call or iteration takes it (do not send it again)" >&2
  else echo "cc-loop: kept for $1/$2, not yet heard — the loop ended before its worker took it; the next dispatch's first iteration takes it" >&2; fi
  return 3; }
green_wait(){   # a cc-green run on THIS worktree still going when the iteration ended → wait it out here, journal its result, return 0; none → 1
  # $1 = kicked: the loop started this run itself (green_kick), so it is live by construction and the `wait 0` probe is
  # skipped (a check with nothing to run can end inside that probe's grace, and its verdict would go unjournaled), and
  # every call carries CC_GREEN_FOR_WORKER=1, since the report takes the tree with host git and reads its defects.
  # THE LOG IS COPIED INTO $ST/green.log: the run's own is under ~/.cc/state/land/green, which the fence does not bind.
  # The copy is a fresh file renamed over the name (mv -T), never a write through what the worker left there, and the
  # fresh file is made in $ST's parent, which the fence does not bind, on the same filesystem.
  # A KICKED RUN IS REMEMBERED UNTIL IT IS COLLECTED (gk_mark, in $ST's parent, so the worker cannot plant or clear it;
  # it holds the iteration that asked). A run still going at the 40-wait bound, or one a loop that died had started,
  # is waited on and journaled the next time this runs, kicked or not, with the worker flag and the log copy, once.
  # "a live cc-green run of its own = not idle" (the brief). `cc-green wait` answers 3 while a run holds the root's lock,
  # else the tree's report (0/1) or 2 for no checkout at all. WHETHER A RUN IS LIVE is asked first, with `wait 0` (the
  # lock tried once, after cc-green's 1 s grace), and kept: a run that ends 60 s into the first `wait 540` answers 0 there,
  # the same as no run at all, and read that way its result was never journaled (review of PR #923). The wait
  # costs no model call: the planning seat used to run this same wait by hand after the loop had stopped the track for it.
  # "The wait has to outlast slot starvation, or hand the run to something that does" (the brief, 10-02): a run queued
  # for a check slot sat 2 h+ and an 8-wait bound gave up on it, so the iteration read as "committed nothing" and the
  # track paused. The bound is 40 × 540 s (6 h), and a run still live at it is journaled and handed to the next
  # iteration as progress (return 0), never as an empty one; the spend-since-commit rule still bounds a runaway.
  local o rc n=0 lg cp="" vd tmp who="iteration $i started" g="${CC_GREEN:-$BIN/cc-green}" gfw=() km="${1:-}" ki=$i mk   # CC_GREEN: test hook
  mk=$(gk_mark); [ -f "$mk" ] && { km=kicked; ki=$(head -c 12 "$mk" | tr -cd 0-9); ki=${ki:-$i}; }
  if [ "$km" = kicked ]; then who="the loop started on the host after iteration $ki"; gfw=("${HG[@]}" CC_GREEN_FOR_WORKER=1)
  else
    o=$(cd "$WT" && "$g" wait 0 2>&1); [ $? = 3 ] || return 1   # no run live as the iteration ended: nothing to wait on
    log "iter $i ended with its own cc-green run still going — waiting on it, no model call: ${o##*$'\n'}"; fi
  while :; do o=$(cd "$WT" && env "${gfw[@]}" "$g" wait 540 2>&1); rc=$?; [ "$rc" = 3 ] || break
    n=$((n+1)); [ "$n" -ge 40 ] && { log "…still going after $n waits — handing it to the next iteration"
      printf -- '- cc-loop: the cc-green run %s is still going after %s waits (%s) — do not start another; end your turn and the loop waits again\n' \
        "$who" "$n" "${o##*$'\n'}" >> "$ST/progress.md"; return 0; }; done
  lg=$(grep -oE -- '— log [^ ]+' <<<"$o" | head -1 | sed 's/^— log //')
  rm -f -- "$mk"   # collected: journaled below, never twice
  if [ "$km" = kicked ] && [ -n "$lg" ] && [ -f "$lg" ] && tmp=$(mktemp "$(dirname "$ST")/.green.log.XXXXXX" 2>/dev/null); then
    if tail -c 262144 "$lg" > "$tmp" && mv -fT "$tmp" "$ST/green.log" 2>/dev/null; then cp="$ST/green.log"; else rm -f "$tmp"; fi; fi
  vd=$(grep -m1 -E '^ +(green|RED|RUN) +lander check —' <<<"$o" | tr -s ' ' | sed 's/^ //')   # the report's own verdict line
  log "the cc-green run ended: exit $rc — ${o##*$'\n'}"
  printf -- '- cc-loop: the cc-green run %s ended while the loop waited on it (exit %s%s) — read that log before you run another%s%s\n' \
    "$who" "$rc" "${lg:+, log $lg}" "${cp:+; its last 256 KiB, readable inside your sandbox: $cp}" "${vd:+; verdict: $vd}" >> "$ST/progress.md"; return 0; }
gk_mark(){ printf '%s/.%s.green-kicked' "$(dirname "$ST")" "$(basename "$ST")"; }   # → where a kicked run is remembered
green_kick(){   # ON THE HOST, after an iteration: the worker asked ($ST/green.ask) → start its green run here; 0 when a run is going, 1 when none
  # The ask is a file the worker writes, so only its being there is read, and it is consumed (rm, which takes a link
  # away and follows none). What runs is fixed here: `cc-green start` with no argument, in $WT, with
  # CC_GREEN_FOR_WORKER=1 (the pinned lander, caged checks only, no suite, none of the tree's own code) and HG.
  # Not inside a member boundary: that loop is in bwrap itself and sets no CC_GREEN_ASK.
  local o rc ask="$ST/green.ask" g="${CC_GREEN:-$BIN/cc-green}"   # CC_GREEN: test hook
  inside_boundary && return 1
  { [ -e "$ask" ] || [ -L "$ask" ]; } || return 1
  rm -rf -- "$ask"
  o=$(cd "$WT" && env "${HG[@]}" CC_GREEN_FOR_WORKER=1 "$g" start 2>&1); rc=$?
  case "$rc" in 0|3) printf '%s\n' "$i" > "$(gk_mark)";; esac   # remembered until green_wait collects it
  case "$rc" in
    0) log "started the worker's green run on the host, as it asked: ${o%%$'\n'*}"; return 0;;
    3) log "the worker asked for its green run, and one was already going on its tree — waiting on that one"; return 0;;
  esac
  log "could not start the worker's green run on the host: exit $rc — ${o//$'\n'/ }"
  printf -- '- cc-loop: you asked for your green run and the loop could not start it on the host after iteration %s: cc-green said exit %s: %s\n' \
    "$i" "$rc" "$(tail -1 <<<"$o")" >> "$ST/progress.md"; return 1; }
docs_kick(){   # ON THE HOST, after an iteration: the worker's fenced `cc-docs file` asks ($ST/docs.ask) → filed here, each result journaled
  # A worker's sandbox holds no document register, so a fenced `cc-docs file` appends its argv to this file and files
  # nothing (cc-docs, "a fenced worker files through its loop"); the ECE206 notes stayed unfiled 11 h on 2026-10-11 when
  # it filed into the fence's tmpfs. The file is the worker's, so a link is taken away unread; what runs is fixed
  # here (`cc-docs fenced $WT`, which holds every path to the worktree), and each line it prints goes to the journal.
  # It is moved into a directory of the loop's own, made fresh outside anything the worker writes, with -T so the
  # destination is never read as a directory to move into, and only what landed there is read: a link swapped in
  # after the test above moves as a link and is refused there, never followed.
  local ask="$ST/docs.ask" held o rc d="${CC_DOCS:-$BIN/cc-docs}"   # CC_DOCS: test hook
  inside_boundary && return 0
  [ -L "$ask" ] && { rm -f -- "$ask"; log "the worker's docs.ask was a link: removed unread, nothing filed"; return 0; }
  [ -f "$ask" ] || return 0
  held=$(mktemp -d "${TMPDIR:-/tmp}/cc-loop-docs.XXXXXX") || return 0
  mv -fT -- "$ask" "$held/ask" || { rm -rf -- "$held"; return 0; }
  if [ -L "$held/ask" ] || [ ! -f "$held/ask" ]; then
    rm -rf -- "$held"; log "the worker's docs.ask was not a plain file once moved: removed unread, nothing filed"; return 0; fi
  o=$(cd "$WT" && "$d" fenced "$WT" < "$held/ask" 2>&1); rc=$?
  rm -rf -- "$held"
  log "filed the worker's documents on the host: exit $rc — ${o//$'\n'/ }"
  while IFS= read -r l; do [ -n "$l" ] && printf -- '- cc-loop: cc-docs file, asked from your sandbox and run on the host after iteration %s: %s\n' "$i" "$l"; done <<<"$o" >> "$ST/progress.md"
  return 0; }
own_run_live(){   # a process of the worker's own still running in $WT once claude has exited (a detached EDA run, a
  # `cc-room heavy` slot) → prints "pid command" and 0; none → 1. This loop's own tree (its subshells, the hook) is not
  # one, nor is anything it runs under (the window's shell, a sandbox's pid 1).
  local p a x cmd up=" 1 "
  a=$$; while [ "${a:-0}" -gt 1 ]; do up="$up$a "; x=$(cat "/proc/$a/stat" 2>/dev/null) || break; x=${x##*) }; a=$(cut -d' ' -f2 <<<"$x"); done
  # shellcheck disable=SC2044  # every path is /proc/<pid>/cwd: no spaces or globs to split on
  for p in $(find /proc/[0-9]*/cwd -maxdepth 0 \( -lname "${WT%/}" -o -lname "${WT%/}/*" \) 2>/dev/null); do
    p=${p#/proc/}; p=${p%/cwd}; case "$up" in *" $p "*) continue;; esac; a=$p; while [ "${a:-0}" -gt 1 ]; do [ "$a" = "$$" ] && continue 2
      x=$(cat "/proc/$a/stat" 2>/dev/null) || break; x=${x##*) }; a=$(cut -d' ' -f2 <<<"$x"); done
    cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null | head -c 120); [ -n "$cmd" ] || continue   # a zombie or a kernel thread
    printf '%s %s\n' "$p" "$cmd"; return 0; done
  return 1; }
deliver_post(){   # THE WORKER'S SLACK DELIVERABLE, posted by the loop and never by the worker (raised-headless-cannot-deliver-to-slack).
  # A worker is guarded from every outward post, so a track whose done-criterion is a message in a channel reached its
  # last step, was refused, and ended BLOCKED with the work done and undelivered (a test member, 2026-09-09). It
  # writes $ST/slack-post.md instead and this loop posts it ONCE at DONE. THE FILE: line 1 is `thread` — the row's own
  # thread in #<repo>, where the person who dispatched it reads (the brief's "into the thread, with the file") — or a
  # `#channel` the brief named; an optional `file: <path>` line next (relative to the worktree) goes up with the text,
  # as one message; the rest is the text. `thread` is what the worker is told to write: on 2026-09-20 one guessed
  # `#<repo>--<track>`, a channel that does not exist (a track is a thread), and the post failed channel_not_found.
  # On the host the thread is `cc-slack track-thread` + `post --file`/`post --route`; inside a member boundary it is
  # `cc-slack escalate --notice`, the member socket's door for a track's own line (no token in there). The file is
  # renamed on the way out so a second DONE cannot post it twice, and the ts goes to the journal.
  local f="$ST/slack-post.md" dest text file rest ts chat tts sl="${CC_SLACK:-$BIN/cc-slack}"   # CC_SLACK: test hook
  [ -s "$f" ] || return 0
  dest=$(head -1 "$f" | tr -d '[:space:]'); rest=$(tail -n +2 "$f"); file=""
  case "$(head -1 <<<"$rest")" in file:*) file=$(head -1 <<<"$rest" | sed 's/^file:[[:space:]]*//;s/[[:space:]]*$//'); rest=$(tail -n +2 <<<"$rest");; esac
  text=$rest
  case "$dest" in thread|'#'?*) ;; *) printf '%s slack-post.md: the first line must be `thread` or the #channel (got %s) — not posted\n' "$(date -u +%FT%TZ)" "${dest:-nothing}" >> "$LOG"; return 0;; esac
  [ -n "$text" ] || { printf '%s slack-post.md: no text under the first line — not posted\n' "$(date -u +%FT%TZ)" >> "$LOG"; return 0; }
  case "$file" in ''|/*) ;; *) file="$WT/$file";; esac
  [ -z "$file" ] || [ -f "$file" ] || { printf '%s slack-post.md: names file %s, which is not there — not posted, the file stands\n' "$(date -u +%FT%TZ)" "$file" >> "$LOG"; return 0; }
  # …and it must resolve inside the worktree: the host loop runs outside cc-guard, so `file: /etc/…` or `../../.cc/config`
  # would otherwise upload a box file with the token (the member path confines the same field in member_notice)
  if [ -n "$file" ]; then local rf; rf=$(realpath -e -- "$file" 2>/dev/null) || rf=""
    case "$rf" in "$(realpath -e -- "$WT" 2>/dev/null)"/?*) file=$rf;; *) printf '%s slack-post.md: names file %s, which is outside the worktree — not posted, the file stands\n' "$(date -u +%FT%TZ)" "$file" >> "$LOG"; return 0;; esac; fi
  if [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && { [ "$dest" = thread ] || [ -n "$file" ]; }; then
    ts=$("$sl" escalate --notice ${file:+--file "$file"} -t "$repo/$track done" -- "$text" 2>>"$LOG")
  elif [ "$dest" = thread ] && [ -n "$file" ]; then
    read -r chat tts <<<"$("$sl" track-thread "$repo/$track" 2>>"$LOG")"
    [ -n "${tts:-}" ] && ts=$("$sl" post --file "$file" --to "$chat" --thread "$tts" -m "$text" 2>>"$LOG") || ts=""
  elif [ "$dest" = thread ]; then ts=$("$sl" post --route "$repo/$track done" "$text" 2>>"$LOG")
  elif [ -n "$file" ]; then ts=$("$sl" post --file "$file" --to "$dest" -m "$text" 2>>"$LOG")
  else ts=$("$sl" post -c "$dest" --major "$text" 2>>"$LOG"); fi
  if [ -n "$ts" ]; then
    mv -f "$f" "$f.sent"; printf -- '- slack-post.md delivered to %s by cc-loop at DONE (%s)\n' "$dest" "${ts//$'\n'/ }" >> "$ST/progress.md"
  else printf '%s slack-post.md: the post to %s failed — the file stands for a retry\n' "$(date -u +%FT%TZ)" "$dest" >> "$LOG"; fi
}
selfcheck(){   # the refusal path on fixtures: the classes the loop acts on, the model it moves to, what it does with
               # an iteration that was rerouted but still worked (F4), and the line it journals.
               # The fixtures are REAL `-p` result shapes, carrying the two traps that fooled the old classifier: a
               # `subagent_stats.refused` block, and a successful worker whose own prose says "refused". The full
               # sanitized real result lives in cc-model's selfcheck — this file only has to test the loop's reaction.
  local d n=0 bad=0 out rc head nxt last wm dtext wsp gone wtext wgone wref wp1 wbx wbg e ptext pgone chain
  d=$(mktemp -d) || return 1
  # THE SHIPPED CHAIN, NOT THIS BOX'S. cc-model filters its chain through ~/.cc/state/model-unavailable, so read from
  # the real HOME this suite went red whenever the box had a family recorded out — and with two shipped rungs since
  # 2026-09-23 one outage is enough (raised-suite-reads-live-model-record). So every real cc-model call here runs
  # under a HOME of its own with none of the model env, the pattern cc-model's own selfcheck uses; refusal_next's
  # `cc-model next` and `classify` (which writes a refusal record) run under it too, so the box's state is never read
  # or written by a test.
  mkdir -p "$d/home"
  # THE SHIPPED CHAIN IS OPUS ALONE (owner, 2026-09-29: never Sonnet), so the refusal walk below runs on a two-rung
  # CC_MODEL_CHAIN of its own, exported inside the same hermetic HOME: a walk needs somewhere to walk to.
  hermetic(){ ( unset CC_MODEL_PRIMARY CC_MODEL_FALLBACK CC_MODEL_CHAIN CC_MODEL_PROBE CC_MODEL_FLOOR CC_MODEL_CRED CC_MEMBER_SANDBOX
                [ -n "${FIXCHAIN:-}" ] && export CC_MODEL_CHAIN="$FIXCHAIN"; HOME="$d/home" "$@" ); }
  local FIXCHAIN=''; chain=$(hermetic "$BIN/cc-model" chain)
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  t 'the shipped cc-model chain is Opus 5.5 alone' "$(paste -sd' ' - <<<"$chain")" claude-opus-5-5
  t '…and an Opus worker has no rung below it: `next` names nothing' "$(hermetic "$BIN/cc-model" next claude-opus-5-5; echo "rc=$?")" rc=1
  FIXCHAIN='claude-opus-5-5 claude-sonnet-5'; chain=$(hermetic "$BIN/cc-model" chain)
  head=$(sed -n 1p <<<"$chain"); nxt=$(sed -n 2p <<<"$chain"); last=$(tail -1 <<<"$chain")
  [ -n "$head" ] && [ -n "$nxt" ] || { echo "cc-loop selfcheck: the fixture cc-model chain is shorter than two models" >&2; return 1; }
  R='{"type":"result","subtype":"success","is_error":false,"result":"Done — the `.env.local` write was refused, as designed.","stop_reason":"end_turn","terminal_reason":"completed","permission_denials":[],"errors":null,"uuid":"14144299-9e48-4299-8f0c-0000000429ab","subagent_stats":{"spawned":0,"completed":0,"failed":0,"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0}},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":2737},"MAIN":{"inputTokens":112}}}'
  printf '%s' "${R/MAIN/$head}" > "$d/ok.json"
  jq -c '.is_error=true | .subtype="error_during_execution" | .stop_reason="refusal" | .result=""' "$d/ok.json" > "$d/refused.json"
  out=$(hermetic refusal_next "$d/refused.json" "" "$head"); rc=$?
  t 'a refused run moves to the next model on the chain' "$out:$rc" "$(printf '%s\tthe classifier stopped the turn:0' "$nxt")"
  hermetic refusal_next "$d/ok.json" "" "$head" >/dev/null;   t 'a good run whose prose says "refused" is not a refusal' "$?" 1
  hermetic refusal_next "$d/refused.json" "" "$last" >/dev/null; t 'the end of the chain has nowhere to move to' "$?" 2
  # F4: what the loop DOES with it. A reroute that produced work is an iteration; only one that produced nothing reruns.
  t 'refused, nothing produced: rerun it'              "$(refusal_step 0 no)"  rerun
  t 'refused but it produced work: the iteration counts' "$(refusal_step 0 yes)" count
  t 'chain exhausted with nothing produced: stop'      "$(refusal_step 2 no)"  stop
  t 'chain exhausted but the work is real: carry on'   "$(refusal_step 2 yes)" count
  t 'not a refusal at all: the loop does nothing'      "$(refusal_step 1 yes)" none
  # WHAT A WORKER RUNS ON when the dispatcher named no model. Two stub cc-models: one box with no override, one moved by a limit.
  # The config is a scratch file, not the box's: CC_WORKER_MODEL is a documented knob, and reading the real
  # ~/.cc/config would turn these cases red the moment the owner sets it — a supported setting must not fail the suite.
  mkdir -p "$d/nov" "$d/ov"; ln -sf "$BIN/cc-config" "$d/nov/cc-config"; ln -sf "$BIN/cc-config" "$d/ov/cc-config"
  : > "$d/cfg"
  # Both stubs answer the way the real cc-model does in that state, subcommand by subcommand: on its primary
  # `current` names that primary and `forced` names nothing, and a box a limit has moved names the fallback to
  # both. A stub that answered every subcommand alike could not tell the two questions apart, and this pair of
  # cases is the only thing standing between a worker and the box's interactive model (2026-09-01, and again
  # 09-07 when `current` started naming the primary).
  printf '#!/bin/sh\ncase "$1" in current) echo claude-fable-5-1;; esac\nexit 0\n' > "$d/nov/cc-model"
  printf '#!/bin/sh\ncase "$1" in resolve) case "$2" in *fable*) echo claude-sonnet-5;; *) echo "$2";; esac;; *) echo claude-sonnet-5;; esac\n' > "$d/ov/cc-model"   # moved to sonnet: `resolve` moves the model it was moved off, passes the rest through
  chmod +x "$d/nov/cc-model" "$d/ov/cc-model"
  wm=$(unset CC_WORKER_MODEL; CC_CONFIG="$d/cfg" BIN="$d/nov" worker_model "")
  t 'no --model and the box on its primary: a worker runs on Opus, not on that primary' "$wm" claude-opus-5-5
  t 'CC_WORKER_MODEL moves that default'   "$(CC_CONFIG="$d/cfg" BIN="$d/nov" CC_WORKER_MODEL=claude-haiku-4-5-20251001 worker_model '')" claude-haiku-4-5-20251001
  t 'a box override outranks it'           "$(unset CC_WORKER_MODEL; CC_CONFIG="$d/cfg" BIN="$d/ov" worker_model '')" claude-sonnet-5
  t "--model is the dispatcher's call: passed through untouched when it is not the model the box was moved off" "$(CC_CONFIG="$d/cfg" BIN="$d/ov" worker_model 'claude-opus-5-5')" 'claude-opus-5-5'
  t "…and the one the box WAS moved off runs where the box is this iteration (resolve), not pinned there" "$(CC_CONFIG="$d/cfg" BIN="$d/ov" worker_model 'fable[1m]')" 'claude-sonnet-5'
  t 'and a two-rung chain carries on from it to its last rung' "$(hermetic "$BIN/cc-model" next "$wm")" "$last"
  # (c) AN OUTAGE MOVES THE LOOP DOWN, AND ITS LIFT MOVES IT BACK: a stub cc-model whose `out`/`resolve` read one flag
  # file, the way the real one reads its unavailable record and its override. Own fixture per state.
  mkdir -p "$d/out"
  printf '#!/bin/sh\ncase "$1" in current) echo claude-fable-5-1;; forced) [ -e "%s/fable-out" ] && echo "claude-opus-5-5[1m]";; out) if [ -e "%s/fable-out" ]; then case "$2" in *fable*) echo "fable is not available to this account: test"; exit 0;; esac; fi; exit 1;; resolve) if [ -e "%s/fable-out" ]; then case "$2" in *fable*) echo "claude-opus-5-5[1m]"; exit 0;; esac; fi; echo "$2";; esac\nexit 0\n' "$d" "$d" "$d" > "$d/out/cc-model"
  chmod +x "$d/out/cc-model"
  t '(c) on its primary, a loop dispatched on Fable runs on Fable' "$(CC_CONFIG="$d/cfg" BIN="$d/out" worker_model 'claude-fable-5-1[1m]')" 'claude-fable-5-1[1m]'
  touch "$d/fable-out"
  t '(c) while the box has Fable recorded as out, the same dispatch runs on the next rung — the record, not a pin' \
    "$(CC_CONFIG="$d/cfg" BIN="$d/out" worker_model 'claude-fable-5-1[1m]')" 'claude-opus-5-5[1m]'
  t '(c) …and the model AS DISPATCHED is still known, for the journal line that says why' "$(CC_CONFIG="$d/cfg" BIN="$d/out" worker_model 'claude-fable-5-1[1m]' asked)" 'claude-fable-5-1[1m]'
  t '(c) …a worker with no --model runs on what the box was moved to, as before' "$(unset CC_WORKER_MODEL; CC_CONFIG="$d/cfg" BIN="$d/out" worker_model '')" 'claude-opus-5-5[1m]'
  rm -f "$d/fable-out"
  t '(c) the lift: the next iteration is back on Fable, with no handoff and nothing pinned' "$(CC_CONFIG="$d/cfg" BIN="$d/out" worker_model 'claude-fable-5-1[1m]')" 'claude-fable-5-1[1m]'
  t '(c) a cc-model that does not answer `resolve` (an older copy) leaves the model as it was' "$(unset CC_WORKER_MODEL; CC_CONFIG="$d/cfg" BIN="$d/nov" worker_model 'fable[1m]')" 'fable[1m]'

  # (c) THE LINE THE NEXT FRESH CONTEXT READS ABOUT ITS OWN MODEL, and the cases it must NOT read. Its own fixture:
  # seven arguments in, one line or nothing out, no state between cases. Before the review of #503 a model change alone
  # was taken for a lift, so the "no outage" cases below produced "the outage that moved it to X lifted" — a false
  # sentence fed verbatim into the next iteration's prompt. Both halves are asserted: what is written and what is not.
  outwhy='fable is not available to this account: test'   # what the $d/out stub's `out` says while its flag file is there
  t '(c) an outage BEGINS: the line names what moved it and what brings it back' \
    "$(model_change_note 4 'claude-opus-5-5[1m]' 'claude-fable-5-1[1m]' 'claude-fable-5-1[1m]' '' "$outwhy" 'claude-fable-5-1[1m]')" \
    "- cc-loop: iteration 4 runs on claude-opus-5-5[1m], not claude-fable-5-1[1m] — $outwhy. It returns to claude-fable-5-1[1m] by itself when that lifts."
  t '(c) the lift: the iteration after it says so, and says no handoff was needed' \
    "$(model_change_note 5 'claude-fable-5-1[1m]' 'claude-fable-5-1[1m]' 'claude-opus-5-5[1m]' "$outwhy" '' 'claude-fable-5-1[1m]')" \
    '- cc-loop: iteration 5 is back on claude-fable-5-1[1m] — the outage that moved it to claude-opus-5-5[1m] lifted; no handoff, the journal below stands.'
  t '(c) an outage beginning is NOT a lift: no --model, so the override changes the model with nothing out on the ASKED one' \
    "$(model_change_note 2 'claude-opus-5-5[1m]' 'claude-opus-5-5[1m]' 'claude-opus-5-5' '' '' 'claude-opus-5-5')" ''
  t '(c) …nor is a refusal reroute: the model moves down the chain, refusal_note says why, and this says nothing' \
    "$(model_change_note 3 'claude-sonnet-5' 'claude-sonnet-5' 'claude-opus-5-5' '' '' 'claude-opus-5-5')" ''
  t '(c) the model did not change: nothing to say, outage or none' \
    "$(model_change_note 6 'claude-opus-5-5[1m]' 'claude-fable-5-1[1m]' 'claude-opus-5-5[1m]' "$outwhy" "$outwhy" 'claude-fable-5-1[1m]')" ''
  t '(c) iteration 1 has no previous model, so it claims nothing' \
    "$(model_change_note 1 'claude-opus-5-5[1m]' 'claude-fable-5-1[1m]' '' '' "$outwhy" '')" ''
  t '(c) a reroute WHILE an outage is in force says nothing: the loop left the rung the outage moved it to, and the outage it was moved OFF has not lifted' \
    "$(model_change_note 7 'claude-sonnet-5' 'claude-sonnet-5' 'claude-opus-5-5[1m]' "$outwhy" '' 'claude-fable-5-1[1m]')" ''
  # …and the memory those two rely on: the outage is read EVERY iteration, so a loop that started INSIDE an outage
  # still knows it was moved when the lift comes. The $d/out stub above is the record; the flag file is the outage.
  rm -f "$d/fable-out"   # this block builds its own state: no flag = the box is on its primary, whatever ran before
  t '(c) on its primary nothing is out, so nothing is remembered' \
    "$(BIN="$d/out" model_outage_why 'claude-fable-5-1[1m]' 'claude-fable-5-1[1m]')" ''
  touch "$d/fable-out"
  t '(c) moved off the asked model: the why is read even on an iteration that changed nothing' \
    "$(BIN="$d/out" model_outage_why 'claude-opus-5-5[1m]' 'claude-fable-5-1[1m]')" "$outwhy"
  t '(c) running ON the model that is out (the chain ends there) is not being moved by it' \
    "$(BIN="$d/out" model_outage_why 'claude-fable-5-1[1m]' 'claude-fable-5-1[1m]')" ''
  rm -f "$d/fable-out"

  # WHAT A WORKER IS TOLD ITS BASE IS. Real boards read by the real cc-board, in a $HOME of its own with no
  # checkout in it, so origin/HEAD answers nothing. A stub answering `base` would only prove the stub: three
  # callers assumed the subcommand for a whole PR before cc-board had it (review of #230).
  mkdir -p "$d/bh"
  HOME="$d/bh" "$BIN/cc-board" init based   /tmp/based   trunk   >/dev/null
  HOME="$d/bh" "$BIN/cc-board" init tracked /tmp/tracked track/x >/dev/null
  t "the board's base is what a worker is told to work against" "$(HOME="$d/bh" worker_base based)" trunk
  t 'a board answering a track is not believed — cut from one, a new track carries another project into a fresh repo' \
    "$(HOME="$d/bh" worker_base tracked)" main
  t 'and a repo with no board and no origin/HEAD falls back to main, not to nothing' "$(HOME="$d/bh" worker_base noboard)" main

  # the journal fixtures: what the next fresh context reads, and what it must never be mistaken for
  refusal_note 3 "$head" "$nxt" 'the classifier stopped the turn' rerun > "$d/progress.md"
  refusal_note 4 "$head" "$nxt" 'answered as opus, not fable' kept >> "$d/progress.md"
  grep -q "iteration 3 was refused or rerouted on $head" "$d/progress.md"; t 'the journal names the iteration and the model' "$?" 0
  grep -q "switched to $nxt per the cc-model chain and reran it" "$d/progress.md"; t 'a rerun says it was rerun' "$?" 0
  grep -q "iteration 4 .*it produced work, so it COUNTS" "$d/progress.md"; t 'a kept iteration says the work stands' "$?" 0
  grep -q "iteration 4 .*and reran it" "$d/progress.md"; t 'and never claims it was rerun' "$?" 1
  # --resume-last: which session a repair round continues, and what it does when there is none to continue.
  mkdir -p "$d/runs"
  t 'nothing has run yet: there is no session to resume, and the round is told so rather than resuming a guess' \
    "$(last_session "$d/runs" || echo NONE)" NONE
  printf '{"session_id":"old-one"}' > "$d/runs/20260101T000000Z-1.json"
  printf '{"session_id":"the-one"}' > "$d/runs/20260101T000100Z-2.json"
  touch -d '2026-01-01 00:00:00' "$d/runs/20260101T000000Z-1.json"; touch -d '2026-01-01 00:01:00' "$d/runs/20260101T000100Z-2.json"
  t 'the session resumed is the track\047s MOST RECENT one, not the first it finds' "$(last_session "$d/runs")" the-one
  printf '{"is_error":true}' > "$d/runs/20260101T000200Z-3.json"; touch -d '2026-01-01 00:02:00' "$d/runs/20260101T000200Z-3.json"
  t 'a run killed before it recorded a session id is skipped, not treated as "no session" — a repair round would \
otherwise start cold having been told to resume' "$(last_session "$d/runs")" the-one
  rm -rf "$d/runs"
  refusal_note 5 "$last" "" 'answered as haiku, not fable' stopped >> "$d/progress.md"
  grep -q "iteration 5 .*the loop stopped (exit 10)" "$d/progress.md"; t 'the stop line says it stopped' "$?" 0
  grep -q "iteration 5 .*reran it" "$d/progress.md"; t 'and never claims it reran' "$?" 1
  grep -qE '^STATUS' "$d/progress.md"; t 'no journal line is a STATUS line' "$?" 1
  # the self-review block the worker prompt carries: KEPT when the checklist is there, SUPPRESSED when it is not,
  # each on a fixture of its own — a prompt that names a checklist the worker cannot read is the thing to avoid.
  local realcl="$CHECKLIST" blk
  mkdir -p "$d/present"; printf '# Landing self-review\n\n1. **The contract says what the code now does.**\n' > "$d/present/self-review.md"
  CHECKLIST="$d/present/self-review.md"; blk=$(selfrev_block trunk)
  grep -q 'templates/self-review.md' <<<"$blk";               t 'the prompt names the checklist' "$?" 0
  grep -q 'git diff origin/trunk' <<<"$blk";                  t 'and the base branch it is read against' "$?" 0
  grep -q 'The contract says what the code now does' <<<"$blk"; t 'and carries the checklist itself, not a link a sandboxed worker cannot open' "$?" 0
  CHECKLIST="$d/absent/self-review.md"   # a fresh path this selfcheck never created — not the fixture above, emptied
  t 'no checklist file: the prompt promises nothing' "$(selfrev_block trunk)" ""  # compared, not tested: a $? here reads as the condition's
  CHECKLIST="$realcl"
  t 'the shipped checklist is where the prompt says it is' "$(test -r "$CHECKLIST" && echo readable)" readable
  grep -q '^6\. ' "$CHECKLIST" 2>/dev/null;                    t 'and still carries all six entries' "$?" 0
  # AN ITERATION THAT ENDS WITH ITS OWN cc-green RUN GOING: the worker is told to end its turn there, and the loop, not
  # the model, waits the run out and journals it for the next iteration. Each case on a fixture of its own: a run still
  # going on the first ask (kept: waited, journaled), one that ends inside the first long wait (kept: journaled, not read
  # as "no run"), and none going (suppressed: nothing waited, nothing journaled).
  grep -q 'do not sit in `cc-green wait`' "$CHECKLIST";  t 'the checklist tells the worker to end its iteration after cc-green start' "$?" 0
  grep -q "end the iteration: never wait on it in your turn" <<<"$(repo=r track=t ST="$d/st"; sp_worker trunk)"; t 'and so does the prompt cc-loop builds' "$?" 0
  t 'the worker prompt never tells the worker to run cc-green wait' "$(repo=r track=t ST="$d/st"; sp_worker trunk | grep -o '[^.]*cc-green wait[^.]*' | grep -vc 'not sit in\|[Nn]ever wait\|no model call')" 0
  # the prompt's words come from WORKER_PROMPT: every placeholder filled, a wrapped file read back as one line, and
  # a missing file is no prompt at all (the caller stops) rather than a worker started on the blocks alone. HOME is a
  # fixture holding a ~/CLAUDE.md, as the box's does, so the writing rule is the one-line pointer whoever runs this
  # (worker_writing_block: without one it is the block's paragraphs, which are lines of their own)
  mkdir -p "$d/wh" && : > "$d/wh/CLAUDE.md"
  t 'the worker prompt fills every placeholder of its file' "$(repo=r track=t ST="$d/st"; sp_worker trunk | grep -c '{track}\|{repo}\|{state}\|{base}')" 0
  t 'and reads the wrapped file back as one line' "$(repo=r track=t ST="$d/st" HOME="$d/wh"; sp_worker trunk | wc -l | tr -d ' ')" 0
  printf 'Track {track} of {repo}  \nkeeps {state}, never {base}.\n' > "$d/wp.md"
  t 'its four placeholders, an & taken literally' "$(repo='r&' track=t ST=/s WORKER_PROMPT="$d/wp.md" HOME="$d/wh"; CHECKLIST="$d/absent/x" DISPATCH="$d/absent/x"; sp_worker trunk | cut -c1-36)" 'Track t of r& keeps /s, never trunk.'
  t 'no prompt file, no prompt' "$(WORKER_PROMPT="$d/absent/worker-prompt.md"; sp_worker trunk >/dev/null; echo $?)" 1
  # The fake models the run: $3 = live as the iteration ended (1/0); `wait 0` answers from that alone, and each long
  # wait is one more 540 s, still going for the first $2 of them, ended on the next. `calls` counts every ask.
  gw(){ ( mkdir -p "$d/gw/$1/wt" "$d/gw/$1/st"; : > "$d/gw/$1/st/progress.md"; : > "$d/gw/$1/calls"; : > "$d/gw/$1/longs"
          printf '#!/bin/sh\n[ "$1" = wait ] || exit 9\necho x >> "%s"\nrun="cc-green: still running (pid 1, since 00:00)"\nif [ "$2" = 0 ]; then [ %s = 1 ] && { echo "$run"; exit 3; }; echo "cc-green: no run — red"; exit 1; fi\necho x >> "%s"\nn=$(wc -l < "%s")\nif [ "$n" -le %s ]; then echo "$run"; exit 3; fi\necho "cc-green: green — log /x/green.log"; exit 0\n' \
            "$d/gw/$1/calls" "$3" "$d/gw/$1/longs" "$d/gw/$1/longs" "$2" > "$d/gw/$1/fake"; chmod +x "$d/gw/$1/fake"
          k="$1"; log(){ printf '%s\n' "$*" >> "$d/gw/$k/loop.log"; }   # $1 inside log is the line, not the case
          WT="$d/gw/$1/wt" ST="$d/gw/$1/st" CC_GREEN="$d/gw/$1/fake" i=4; green_wait; echo "rc=$? asks=$(wc -l < "$d/gw/$1/calls")" ); }
  t 'a run still going when the iteration ended is waited out by the loop, no model call' "$(gw going 1 1)" "rc=0 asks=3"
  t '…its result is journaled for the next iteration, log and all' \
    "$(grep -c '^- cc-loop: the cc-green run iteration 4 started ended while the loop waited on it (exit 0, log /x/green.log)' "$d/gw/going/st/progress.md")" 1
  t '…and loop.log says the iteration ended with it going, once' "$(grep -c '^iter 4 ended with its own cc-green run still going' "$d/gw/going/loop.log")" 1
  t 'a run that ends inside the first long wait still counts as a live run, not as none' "$(gw early 0 1)" "rc=0 asks=2"
  t '…and its result is journaled for the next iteration, log and all' \
    "$(grep -c '^- cc-loop: the cc-green run iteration 4 started ended while the loop waited on it (exit 0, log /x/green.log)' "$d/gw/early/st/progress.md")" 1
  t 'a run starved of a check slot past the bound still counts as progress, not an empty iteration' "$(gw starved 99 1)" "rc=0 asks=41"
  t '…and is handed to the next iteration in the journal, not dropped' \
    "$(grep -c '^- cc-loop: the cc-green run iteration 4 started is still going after 40 waits' "$d/gw/starved/st/progress.md")" 1
  t 'no run going: nothing waited on' "$(gw none 0 0)" "rc=1 asks=1"
  t '…and nothing journaled' "$(wc -c < "$d/gw/none/st/progress.md")" 0
  # THE LOOP RUNS A FENCED WORKER'S GREEN ON THE HOST WHEN IT ASKED (green_kick): only the file's being there is read,
  # and what runs is `cc-green start` with no argument, in $WT, with CC_GREEN_FOR_WORKER=1 and HG. Each case on a
  # fixture of its own. The fake cc-green logs each call's argv, the worker flag and the hooksPath HG gave it; `start`
  # exits GK_START (0 unless the case says); `wait` says the run ended green with a log and the report's verdict line.
  gk(){ ( k="$d/gk/$1"; mkdir -p "$k/wt" "$k/st"; : > "$k/st/progress.md"; : > "$k/calls"; echo "fixture log line" > "$k/run.log"
          cat > "$k/fake" <<EOS
#!/bin/sh
echo "\$* FW=\${CC_GREEN_FOR_WORKER:-} hp=\${GIT_CONFIG_VALUE_0:-}" >> "$k/calls"
case "\$1" in
  start) case "${GK_START:-0}" in 0) echo "cc-green: started lander check on $k/wt (pid 1) — log $k/run.log";;
           3) echo "cc-green: a run is already going on $k/wt (pid 1)";; *) echo "cc-green: not in a git checkout";; esac; exit ${GK_START:-0};;
  wait) [ "\$(grep -c '^wait' "$k/calls")" -le "\${GK_WAIT3:-0}" ] && { echo "cc-green: a run is going (pid 1)"; exit 3; }
        echo "cc-green: the run (pid 1, started 00:00) has ended (exit 0) — log $k/run.log"
        echo "cc-green: what lander check found on abc"; echo "  green   lander check — passed on this tree at T1 (caged checks only)"; exit 0;;
esac
exit 9
EOS
          chmod +x "$k/fake"
          case "$2" in ask) : > "$k/st/green.ask";; cmd) echo 'rm -rf / ; start -- tests/x.sh' > "$k/st/green.ask";;
            link) echo untouched > "$k/victim"; ln -s "$k/victim" "$k/st/green.ask";; esac
          [ "${3:-}" = loglink ] && echo untouched > "$k/victim" && ln -s "$k/victim" "$k/st/green.log"
          log(){ printf '%s\n' "$*" >> "$k/loop.log"; }
          HG=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/host/hooks) WT="$k/wt" ST="$k/st" CC_GREEN="$k/fake" i=4
          CC_MEMBER_SANDBOX=${GK_MEM:-}   # no member boundary unless the case says, whatever this selfcheck inherited
          [ -n "${GK_AGAIN:-}" ] && { i=5; : > "$k/calls"; green_wait; echo "rc=$?|$(tr '\n' '|' < "$k/calls")"; exit; }
          if green_kick; then green_wait kicked; echo "kicked|$(tr '\n' '|' < "$k/calls")"; else echo "none|$(tr '\n' '|' < "$k/calls")"; fi ); }
  gkrun="kicked|start FW=1 hp=/host/hooks|wait 540 FW=1 hp=/host/hooks|"
  t 'the worker asked (green.ask): the loop runs cc-green start on the host for it, flagged for a worker with the main hooksPath, and waits it out' \
    "$(gk ask ask)" "$gkrun"
  t '…the ask is consumed' "$([ -e "$d/gk/ask/st/green.ask" ] && echo there || echo gone)" gone
  t '…and the journal names who started it, the verdict and a copy the sandbox can read' \
    "$(grep -c "^- cc-loop: the cc-green run the loop started on the host after iteration 4 ended while the loop waited on it (exit 0, log $d/gk/ask/run.log) — read that log before you run another; its last 256 KiB, readable inside your sandbox: $d/gk/ask/st/green.log; verdict: green lander check — passed on this tree at T1 (caged checks only)$" "$d/gk/ask/st/progress.md")" 1
  t '…the copy holds the log' "$(cat "$d/gk/ask/st/green.log")" "fixture log line"
  t '…and its temp file was made outside the worker'"'"'s dir and left nowhere' "$(find "$d/gk" -name '.green.log.*' | wc -l)" 0
  t 'no ask: nothing started' "$(gk idle none)" "none|"
  t 'an ask that holds a command runs exactly the same: its content chooses nothing' "$(gk cmd cmd)" "$gkrun"
  t 'an ask planted as a link: the link is taken away, what it names is untouched, and the same run starts' \
    "$(gk link link)|$([ -e "$d/gk/link/st/green.ask" ] || [ -L "$d/gk/link/st/green.ask" ] && echo there || echo gone)|$(cat "$d/gk/link/victim")" "$gkrun|gone|untouched"
  t 'a run already going on the tree (start exit 3): the loop waits on that one' "$(GK_START=3 gk going ask)" "$gkrun"
  t 'a start that fails (exit 2): nothing waited on' "$(GK_START=2 gk failed ask)" "none|start FW=1 hp=/host/hooks|"
  t '…and the journal tells the worker' \
    "$(grep -c '^- cc-loop: you asked for your green run and the loop could not start it on the host after iteration 4: cc-green said exit 2: cc-green: not in a git checkout$' "$d/gk/failed/st/progress.md")" 1
  t 'inside a member boundary, even asked: nothing started (that loop is in bwrap itself)' "$(GK_MEM=1 gk member ask)" "none|"
  gk loglink ask loglink >/dev/null
  t 'a link the worker left at green.log is replaced, never written through' \
    "$(cat "$d/gk/loglink/victim")|$([ -L "$d/gk/loglink/st/green.log" ] && echo link || echo file)|$(cat "$d/gk/loglink/st/green.log")" "untouched|file|fixture log line"
  # THE LOOP FILES A FENCED WORKER'S DOCUMENTS ON THE HOST (docs_kick): what runs is `cc-docs fenced $WT` with the ask on
  # stdin, from $WT; each line it prints is journaled. Each case on a fixture of its own; the fake cc-docs logs its argv
  # and cwd, echoes its stdin back as one line, and exits DK_RC.
  dk(){ ( k="$d/dk/$1"; mkdir -p "$k/wt" "$k/st"; : > "$k/st/progress.md"; : > "$k/calls"
          printf '#!/bin/sh\necho "$* cwd=$(pwd)" >> "%s/calls"\necho "w.pdf: $(cat)"\nexit ${DK_RC:-0}\n' "$k" > "$k/fake"; chmod +x "$k/fake"
          case "$2" in ask) echo '{"argv":["file","w.pdf"]}' > "$k/st/docs.ask";;
            link) echo untouched > "$k/victim"; ln -s "$k/victim" "$k/st/docs.ask";; esac
          log(){ printf '%s\n' "$*" >> "$k/loop.log"; }
          WT="$k/wt" ST="$k/st" CC_DOCS="$k/fake" i=4 CC_MEMBER_SANDBOX=${DK_MEM:-}
          docs_kick; echo "rc=$?|$(tr '\n' '|' < "$k/calls")" ); }
  t 'the worker asked (docs.ask): the loop runs cc-docs fenced on its worktree, from it, with the ask on stdin' \
    "$(dk ask ask)" "rc=0|fenced $d/dk/ask/wt cwd=$d/dk/ask/wt|"
  t '…the ask and its held copy are gone, and each line it printed is in the journal' \
    "$(ls -A "$d/dk/ask/st" | tr '\n' ' ')|$(grep -c '^- cc-loop: cc-docs file, asked from your sandbox and run on the host after iteration 4: w.pdf: {"argv":\["file","w.pdf"\]}$' "$d/dk/ask/st/progress.md")" "progress.md |1"
  t 'a filing that is refused (exit 1) is journaled the same, and the loop goes on' "$(DK_RC=1 dk refused ask)|$(grep -c '^- cc-loop: cc-docs file' "$d/dk/refused/st/progress.md")" "rc=0|fenced $d/dk/refused/wt cwd=$d/dk/refused/wt||1"
  t 'no ask: cc-docs never runs and nothing is journaled' "$(dk idle none)|$(wc -c < "$d/dk/idle/st/progress.md")" "rc=0||0"
  t 'an ask planted as a link: taken away unread, what it names untouched, nothing run' \
    "$(dk link link)|$([ -e "$d/dk/link/st/docs.ask" ] || [ -L "$d/dk/link/st/docs.ask" ] && echo there || echo gone)|$(cat "$d/dk/link/victim")" "rc=0||gone|untouched"
  mkdir -p "$d/dk/heldlink/st" "$d/dk/hl/docs"; ln -s "$d/dk/hl/docs" "$d/dk/heldlink/st/.docs.ask.held"
  echo '{"argv":["file","w.pdf"]}' > "$d/dk/heldlink/st/docs.ask"
  t 'a link the worker planted at the old held name is never a destination: nothing written where it points, the ask filed' \
    "$(dk heldlink keep)|$(ls -A "$d/dk/hl/docs" | wc -l)|$([ -e "$d/dk/heldlink/st/docs.ask" ] && echo kept || echo gone)" \
    "rc=0|fenced $d/dk/heldlink/wt cwd=$d/dk/heldlink/wt||0|gone"
  mkdir -p "$d/dk/helddir/st/.docs.ask.held"
  echo '{"argv":["file","w.pdf"]}' > "$d/dk/helddir/st/docs.ask"
  t 'a directory the worker planted at the old held name: the ask is still read and filed, not moved into it' \
    "$(dk helddir keep)|$(ls -A "$d/dk/helddir/st/.docs.ask.held" | wc -l)" "rc=0|fenced $d/dk/helddir/wt cwd=$d/dk/helddir/wt||0"
  t 'inside a member boundary, even asked: nothing run (that worker files across its socket)' "$(DK_MEM=1 dk member ask)|$([ -e "$d/dk/member/st/docs.ask" ] && echo kept)" "rc=0||kept"
  # A KICKED RUN STILL GOING AT THE 40-WAIT BOUND IS COLLECTED LATER: the next green_wait, though not told "kicked",
  # waits on it with the worker flag, journals it as the loop's run for iteration 4, copies its log, and only once.
  GK_WAIT3=40 gk late ask >/dev/null
  t 'a kicked run still going at the bound is handed on, and remembered outside the worker'"'"'s dir' \
    "$(grep -c '^- cc-loop: the cc-green run the loop started on the host after iteration 4 is still going after 40 waits' "$d/gk/late/st/progress.md")|$(cat "$d/gk/late/.st.green-kicked" 2>/dev/null)" "1|4"
  t '…the next iteration'"'"'s plain green_wait collects it with the worker flag' "$(GK_AGAIN=1 gk late ask)" "rc=0|wait 540 FW=1 hp=/host/hooks|"
  t '…journaled as the loop'"'"'s run for iteration 4, with its log copy and verdict' \
    "$(grep -c "^- cc-loop: the cc-green run the loop started on the host after iteration 4 ended while the loop waited on it (exit 0, log $d/gk/late/run.log) — read that log before you run another; its last 256 KiB, readable inside your sandbox: $d/gk/late/st/green.log; verdict: green" "$d/gk/late/st/progress.md")|$(cat "$d/gk/late/st/green.log")" "1|fixture log line"
  t '…and once: the mark is gone, and the call after finds nothing to collect' \
    "$(test -e "$d/gk/late/.st.green-kicked" && echo left)|$(GK_AGAIN=1 gk late ask | cut -d'|' -f1)" "|rc=1"
  # …AND ALL SIX REACH THE WORKER. selfrev_block lifts the headings by their `N. **Heading**` shape, so a checklist
  # reformatted another way yields a prompt that says "fix what it finds:" and lists nothing. Read off the real
  # file and the real worker prompt, each heading by its own number; the fixture above is one entry, not six.
  local wrv srv n h miss=""; wrv=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; repo=r track=t ST="$d/st"; sp_worker main)
  srv=${wrv#*fix what it finds:}; srv=${srv%% Then hand over*}
  for n in 1 2 3 4 5 6; do
    h=$(awk -v n="$n" 'index($0, n ". **") == 1 { sub(/^[0-9]\. \*\*/, ""); sub(/\*\*.*/, ""); print; exit }' "$CHECKLIST")
    case "$srv" in *" $n. $h"*) [ -n "$h" ] || miss="$miss $n";; *) miss="$miss $n";; esac
  done
  t 'the worker prompt carries all six numbered self-review headings, word for word' "${miss:-none}" none
  t 'control: the list the six are read from is not empty' "$( [ "${#srv}" -gt 60 ] && echo listed || echo empty)" listed
  # …AND IT STARTS LIGHT, like the kinds `cc selfcheck` sizes (owner, 2026-09-28: "reduce bloat"): a worker's whole
  # append is at most 6000 bytes, on the host and in each sandbox, where it carries the writing block's paragraph.
  # A worker is never handed off, so no successor brief is reserved on top. Bytes, not characters: wc -c.
  local e big=""
  for e in host CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; do
    wrv=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; [ "$e" = host ] || export "$e=1"; repo=r track=t HOME="$d/wh" ST="$d/st"; sp_worker main)
    [ "$(printf %s "$wrv" | wc -c)" -le 6000 ] || big="$big $e"
  done
  t "the worker prompt is at most 6000 bytes on the host and in either sandbox" "${big:-none}" none
  # ── the context trim: what a worker's environment gets, and what a trimmed turn still carries ──
  # OFF IS THE DEFAULT, and off means nothing at all — no context edit in the request, so the API drops
  # nothing and the run is the one this loop has always done. The config is a scratch file, never the box's.
  local body over under less
  : > "$d/trimcfg"
  t 'the knob is off by default: a worker run carries no context edit at all' \
    "$(unset CC_LOOP_TRIM; CC_CONFIG="$d/trimcfg" trim_body)" ""
  printf 'CC_LOOP_TRIM=1\n' > "$d/trimcfg"
  body=$(unset CC_LOOP_TRIM; CC_CONFIG="$d/trimcfg" trim_body)
  t 'on: the request carries the tool-result edit' "$(jq -r '.context_management.edits[0].type' <<<"$body" 2>/dev/null)" clear_tool_uses_20250919
  t 'and it keeps the most recent results — the current diff and test state' "$(jq -r '.context_management.edits[0].keep.value' <<<"$body" 2>/dev/null)" "$TRIM_KEEP"
  t 'the environment beats the file, so one dispatch opts out without touching the config' \
    "$(CC_LOOP_TRIM=0 CC_CONFIG="$d/trimcfg" trim_body)" ""
  # …and what the trim would take: two fixtures of its own, one turn over the trigger and one under it.
  mktrim(){ local f="$1" ctx="$2" k pad; pad="OLD-SEARCH-HIT $(head -c 12000 /dev/zero | tr '\0' x)"   # $2 = what the API billed that turn
    { jq -nc '{type:"user",message:{role:"user",content:[{type:"text",text:"# TASK  Build the widget. CONSTRAINT: never touch main, never edit outside the worktree."}]}}'
      for k in 1 2 3 4 5 6 7 8 9; do jq -nc --arg c "tool-result-$k $pad" '{type:"user",message:{role:"user",content:[{type:"tool_result",tool_use_id:"t",content:$c}]}}'; done
      jq -nc --argjson n "$ctx" '{type:"assistant",message:{id:"m1",role:"assistant",content:[{type:"text",text:"check-extra case 3 is still red — UNRESOLVED, the next iteration has to fix it."}],usage:{input_tokens:$n,cache_read_input_tokens:0,cache_creation_input_tokens:0}}}'
    } > "$f"; }
  sumf(){ grep '^SUMMARY|' <<<"$1" | tr '|' '\n' | sed -n "s/^$2=//p"; }
  mktrim "$d/over.jsonl" $((TRIM_TRIGGER + 20000)); mktrim "$d/under.jsonl" $((TRIM_TRIGGER - 1))
  over=$(trim_replay "$d/over.jsonl"); under=$(trim_replay "$d/under.jsonl")
  grep -q '^KEPT|prompt|.*Build the widget' <<<"$over";             t 'a trimmed turn still carries the brief' "$?" 0
  grep -q '^KEPT|prompt|.*CONSTRAINT: never touch main' <<<"$over"; t 'and the constraints with it' "$?" 0
  grep -q '^KEPT|said|.*UNRESOLVED' <<<"$over";                     t 'and the failure it has not fixed yet' "$?" 0
  grep -q '^KEPT|tool_result|tool-result-9 ' <<<"$over";            t 'and the newest tool result: the diff and test state it is working on' "$?" 0
  grep -q '^CLEARED|tool_result|tool-result-1 ' <<<"$over";         t 'what goes is the stale tool output' "$?" 0
  grep -q '^CLEARED|tool_result|tool-result-9 ' <<<"$over";         t 'and never the newest' "$?" 1
  grep -q '^CLEARED' <<<"$under";                                   t 'a turn under the trigger is left whole' "$?" 1
  t 'under the trigger the report says nothing would have gone' "$(sumf "$under" trimmed)" "$(sumf "$under" ctx)"
  [ "$(sumf "$over" trimmed)" -lt "$(sumf "$over" ctx)" ] && less=yes || less=no
  t 'over it, that turn would have carried less' "$less" yes
  # ── "did this iteration do work?" — the two answers the loop got wrong, each on its own fixture ──
  # (a) WHAT THIS ITERATION WROTE. By position, so a STATUS line that reads exactly like an older one still counts.
  local snap now
  mkdir -p "$d/it"; snap="$d/it/snap"; now="$d/it/progress.md"
  printf 'iter 1: did a thing\nSTATUS: DONE\n' > "$snap"          # a previous dispatch already finished once…
  cp "$snap" "$now"; printf 'iter 2: did the appended scope\nSTATUS: DONE\n' >> "$now"   # …and this one finished again
  t 'a STATUS: DONE identical to one already in the journal is still THIS iteration'"'"'s: the loop finishes' \
    "$(this_iteration "$snap" "$now" | grep -cE '^STATUS: DONE')" 1
  cp "$snap" "$now"; printf 'iter 2: still working\n' >> "$now"   # the same snapshot, nothing declared this time
  t '...and with nothing declared this iteration the old STATUS line stays invisible, so a re-dispatched track \
does not finish on it' "$(this_iteration "$snap" "$now" | grep -cE '^STATUS: DONE')" 0
  printf 'rewritten from scratch\nSTATUS: DONE\n' > "$now"        # the worker rewrote the file wholesale
  t '...and a journal rewritten in place counts from the first line that differs, not from nothing' \
    "$(this_iteration "$snap" "$now" | grep -cE '^STATUS: DONE')" 1
  : > "$snap"; printf 'iter 1: the first thing this track ever wrote\nSTATUS: DONE\n' > "$now"
  t '...and a track on its FIRST iteration, whose journal was empty when the snapshot was taken, is not swallowed \
whole — the empty snapshot is the case that broke this (selftest w11)' \
    "$(this_iteration "$snap" "$now" | grep -cE '^STATUS: DONE')" 1
  # (b) WHAT HITTING THE STEP LIMIT MEANS. Committed = the round ending; nothing committed = paused.
  t 'a bounded round whose last iteration COMMITTED is the round ending: exit 0, board review, nobody paged' \
    "$(round_end yes 'https://x/pr/1')" 'over|review'
  t '...but `review` is a claim there is something to review: a bounded round that opened no PR gets `blocked` \
instead, or cc-reconcile files "waiting on a PR that was never opened" against it every 20 minutes' \
    "$(round_end yes '')" 'over|blocked'
  t '...and only a bound reached with nothing committed is a pause the owner hears about, PR or no PR' \
    "$(round_end no 'https://x/pr/1')" 'paused|blocked'
  grep -qF 'round_end "${committed:-no}"' "$0"
  t 'and the loop body really asks it rather than deciding the same thing twice' "$?" 0
  # D1-D4: the receipt decides. Exit status and human output carry no delivery evidence.
  rec='{"task_id":"fixture","committed_sha":"abc","pr_url":"https://x/pr/1","errors":[],"pending":{}}'
  t 'D1: a real PR is delivered' "$(delivery_end "$rec")" delivered
  for projection in board card; do
    pending=$(jq --arg p "$projection" '.pending[$p]={} | .errors=[{stage:$p,message:"offline"}]' <<<"$rec")
    t "D1 control: pending $projection over that PR is a note, never the no-PR failure" "$(delivery_end "$pending")" pending
  done
  for stage in commit push pr; do
    failed=$(jq --arg s "$stage" '.pr_url=null | .errors=[{stage:$s,message:"failed"}]' <<<"$rec")
    t "D2: no PR with a $stage error keeps exit 4" "$(delivery_end "$failed")" failed
    t "D2 control: a PR with that $stage error is still delivery" \
      "$(delivery_end "$(jq '.pr_url="https://x/pr/1"' <<<"$failed")")" delivered
  done
  t 'D3: a non-PR delivery is still allowed' "$(delivery_end "$(jq '.pr_url=null' <<<"$rec")")" delivered
  t 'D3 pending control: a non-PR delivery can also owe a board projection' \
    "$(delivery_end "$(jq '.pr_url=null | .pending.board={} | .errors=[{stage:"board"}]' <<<"$rec")")" pending
  t 'D3 control: no PR and no commit is unconfirmed, exit 12' \
    "$(delivery_end "$(jq '.pr_url=null | .committed_sha=null' <<<"$rec")")" unknown
  t 'D4: human output cannot stand in for a receipt; D1 is its control' "$(delivery_end 'PR: https://x/pr/1')" unknown
  t 'D4 control: an empty response is also unconfirmed' "$(delivery_end '')" unknown
  # ── WHO HEARS A STOP. The broker is a recorder here: what is under test is the line the loop hands it, the target
  # it hands it to, and what the loop does with the answer — the daemon behind it is cc-broker's own selfcheck's.
  local bd brec bl marks realbin="$BIN"
  marks=$(sed -n '/^DECISION_MARKS = (/,/)/p' "$BIN/cc-broker" | grep -o '"[^"]*"' | tr -d '"')
  t 'cc-broker still names the words that make an event wake a session NOW rather than ride a digest' \
    "$([ -n "$marks" ] && echo named)" named
  decides(){ local l m; l=$(tr 'A-Z' 'a-z' <<<"$1")   # cc-broker's classify(), asked the way it asks itself, against ITS list
    while IFS= read -r m; do [ -n "$m" ] && case "$l" in *"$m"*) return 0;; esac; done <<<"$marks"; return 1; }
  bd="$d/bkr"; brec="$d/bkr.rec"; mkdir -p "$bd" "$d/bkr-no"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\nexit 0\n' "$brec" > "$bd/cc-broker"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\nexit 1\n' "$brec" > "$d/bkr-no/cc-broker"
  chmod +x "$bd/cc-broker" "$d/bkr-no/cc-broker"
  local repo=demo track=t7
  bl=$(planner_line 'needs you' 'STATUS: BLOCKED: which package?
(answer: append it to task.md)')
  t 'whatever the journal did, the session gets ONE line' "$(printf '%s\n' "$bl" | wc -l)" 1
  grep -q '^loop: demo/t7 needs you — STATUS: BLOCKED: which package? (answer' <<<"$bl"
  t "…carrying the worker's own question, not a pointer to a file the session would have to open" "$?" 0
  decides "$bl"
  t 'a worker that stopped to ASK carries a word cc-broker calls a decision, so that session is woken now' "$?" 0
  decides "$(planner_line 'is running without producing' '3 iterations in a row with nothing to show for the money: committed nothing and left the journal untouched. That is 7 iterations, $4.10, last commit 3 iteration(s) ago. The loop carries on; read /x/loop.log, and to end it: touch /x/stop')"
  t '…and a notice with no question in it carries none of them, so it rides the next digest instead of buying a wake' "$?" 1
  BIN="$bd"
  tell_planner "$bl"; t 'the broker takes the stop' "$?" 0
  t "…addressed to the session that dispatched this track, and named as the loop" \
    "$(cat "$brec")" "inject --no-start --source loop demo $bl"
  : > "$brec"
  # WHICH SESSION THAT IS. "a track dispatched by an orch has its stop notice addressed to that orch's alias, the repo seat
  # only when none is recorded" (the brief). The record is $ST/orch, written from the dispatch environment; own state dir,
  # both halves — the orch that is recorded, and the one that is not — and a file a person mangled reads as none.
  local ST="$d/st7"; mkdir -p "$ST"
  seat_windows(){ cat "$d/seats" 2>/dev/null; }; : > "$d/seats"   # the box's tmux never enters a verdict: each case writes its own seats
  CC_SLACK_ALIAS=myorch orch_record; t 'dispatched from an orch shell: the alias is recorded at start' "$(cat "$ST/orch")" myorch
  t "…and a stop goes to THAT orch, by the broker's own key for it" "$(stop_target)" demo@myorch
