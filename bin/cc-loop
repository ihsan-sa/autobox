  eval "$(grep '^seat_windows(){' "$0")"   # the real one back for whatever runs after
  ORCH_KEY=""   # …and no orch recorded either
  : > "$brec"
  rm -rf "$ST"; unset ST
  grep -q '^orch_record; dispatch_receipt; unset CC_SLACK_ALIAS CC_ORCH_REPO CC_DISPATCH_WIN' "$0"; t 'and the loop writes that record and its dispatch receipt at start, and unsets the variable before the worker runs' "$?" 0
  grep -qF 'CC_DISPATCH_WIN=$([ -n "${TMUX_PANE:-}" ] && tmux display-message -p -t "$TMUX_PANE"' "$realbin/cc" && grep -q 'CC_SLACK_ALIAS CC_ORCH_REPO CC_DISPATCH_WIN; do' "$realbin/cc"; t '…having been handed it by `cc … --go`, on the list of what crosses into the loop\047s window' "$?" 0
