  # PINNED TO THIS REPO WHEN READ BACK (review of #635): the loop's own ORCH_KEY may name another repo's orch; the file,
  # which the worker can write, may not. Kept: the key this process recorded. Suppressed: the same text planted in the file.
  ORCH_KEY=""; printf 'study-coach@myorch\n' > "$ST/orch"
