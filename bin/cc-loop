  t 'the done line names the row' \
    "$(repo=titled track=t1 BOARD="$BIN/cc-board" HOME="$d/bh"; row_title)" "worker stop reaches the planner"
  # ── a row closed while its launch waited in cc-room starts nothing (row_closed) ──
  HOME="$d/bh" "$BIN/cc-board" add titled closed1 "folded while queued" >/dev/null
  rc_(){ local o r; o=$(repo=titled track="$1" BOARD="$BIN/cc-board" HOME="$d/bh"; row_closed); r=$?; printf '%s|%s' "$o" "$r"; }
  t 'a queued row is not closed' "$(rc_ closed1)" '|1'
  HOME="$d/bh" "$BIN/cc-board" status titled closed1 done >/dev/null
  t 'a row set done while queued is closed, and says so' "$(rc_ closed1)" 'done|0'
  HOME="$d/bh" "$BIN/cc-board" status titled closed1 merged >/dev/null
  t '…and so is a merged one' "$(rc_ closed1)" 'merged|0'
  HOME="$d/bh" "$BIN/cc-board" status titled closed1 blocked >/dev/null
  t '…but a blocked one is not' "$(rc_ closed1)" '|1'
  t 'a board that has no such row is not closed' "$(rc_ nosuch-closed)" '|1'
  t 'the start reads row_closed before the fence, the running status and the first iteration' \
    "$(awk '/^if closed=\$\(row_closed\)/{a=NR} /^fw=\$\("\$BIN\/cc-sandbox" probe/{b=NR} /^"\$BOARD" status "\$repo" "\$track" running/{c=NR} END{print (a && a<b && b<c) ? "before" : "after"}' "$0")" before
  t '…and a track the board has no row for says its own name rather than nothing at all' \
    "$(repo=titled track=nosuch BOARD="$BIN/cc-board" HOME="$d/bh"; row_title)" nosuch
  t 'neither done line spends the reader on an iteration count and a dollar figure' \
    "$(grep -c '^      done_card "\$(' "$0")" 2
  t '…and a track the board has no title for is named in words, not by its hyphenated name' \
    "$(repo=titled track=no-such-row BOARD="$BIN/cc-board" HOME="$d/bh"; row_title)" "no such row"
  dc(){ ( log(){ :; }; repo=titled track=t1 ST="$d/nost" BOARD="$BIN/cc-board" HOME="$d/bh" BIN="$d/dcbin" WT="$d/nowt"; done_card "$@" ) >/dev/null; cat "$d/dc.args"; }
  mkdir -p "$d/dcbin"; printf '#!/usr/bin/env bash\nprintf "%%s|" "$@" > "%s"\n' "$d/dc.args" > "$d/dcbin/cc-notify"; chmod +x "$d/dcbin/cc-notify"
  printf '#!/usr/bin/env bash\nprintf "%%s|" "$@" > "%s"\n' "$d/dc.broker" > "$d/dcbin/cc-broker"; chmod +x "$d/dcbin/cc-broker"   # the seat's door, recorded the same way
  t 'the done card is headed by the row title and still routed by repo/track' \
    "$(dc https://x/pull/7 "It's queued to land, no 👍 needed.")" \
    "--id|done:titled/t1:pr7|-t|titled/t1 done|--heading|worker stop reaches the planner|That's finished. The PR is https://x/pull/7. It's queued to land, no 👍 needed.|"
  t '…and with no PR link it prints no empty "PR: ." slot' \
    "$(dc '' 'No PR is open for it, so there is nothing to land.')" \
    "--id|done:titled/t1:none|-t|titled/t1 done|--heading|worker stop reaches the planner|That's finished. No PR is open for it, so there is nothing to land.|"
  t '…and with neither a PR nor a landing sentence the card still says it finished, and that there is no PR' \
    "$(dc '' '')" "--id|done:titled/t1:none|-t|titled/t1 done|--heading|worker stop reaches the planner|That's finished. There is no PR for it.|"
  t '…and the same line reaches the seat that dispatched it by the broker (a digest, never a page), so a finished track is not left unseen' \
    "$(dc https://x/pull/7 "It's queued to land, no 👍 needed." >/dev/null; cat "$d/dc.broker")" \
    "inject|--no-start|--source|loop|titled|loop: titled/t1 done — worker stop reaches the planner. The PR is https://x/pull/7. It's queued to land, no 👍 needed.|"
  printf '#!/bin/sh\n[ "$1 $2 $3 $4" = "hint titled https://x/pull/7 t1" ] && echo "Green at its head: cc-try on titled 7 puts it live now."\n' > "$d/dcbin/cc-try"
  chmod +x "$d/dcbin/cc-try"
  t '…and once cc-try has a line for that PR, the seat gets the cc-try on command with it; the card does not' \
    "$(dc https://x/pull/7 "It's queued to land." | grep -c cc-try; cat "$d/dc.broker")" \
    "0
inject|--no-start|--source|loop|titled|loop: titled/t1 done — worker stop reaches the planner. The PR is https://x/pull/7. It's queued to land. Green at its head: cc-try on titled 7 puts it live now.|"
  rm -f "$d/dcbin/cc-try"
  grep -qF "tell_planner \"\$(planner_line 'round over'" "$0"
  t '…and a round that ended at its bound tells the seat the same way, with no Slack post of its own' "$?" 0
  # ── WHAT A RUN POSTS ── the loop itself, run end to end: a COPY of this script (never a link) beside stubs, on a
  # scratch HOME and worktree, with a fake claude. Every post leaves by cc-notify, so its stub's argv is the whole
  # of what reached Slack; a call with --ask is the planner intake, never Slack.
  local lb="$d/lb" lh="$d/lh" c   # each copy's config/ is $d/config, as core/bin's is core/config: the worker prompt is there
  mkdir -p "$lb" "$lh" "$d/config"; cp "$0" "$lb/cc-loop"; cp "$WORKER_PROMPT" "$d/config/"
  printf '#!/bin/sh\nfor a in "$@"; do printf "%%s|" "$a"; done >> "%s"; echo >> "%s"\n' "$d/lb.n" "$d/lb.n" > "$lb/cc-notify"
  printf '#!/bin/sh\ncase "$1" in reconcile|probe) exit 0;; worker-cred) echo "$FK_CRED"; exit 0;; esac\nwhile [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done; shift; exec "$@"\n' > "$lb/cc-sandbox"
  printf '#!/bin/sh\nexit 0\n' > "$lb/cc-tier"
  printf '#!/bin/sh\nprintf "%%s\\n" "${CLAUDE_CODE_SHELL_PREFIX-UNSET}" > "%s"\nshift; exec "$@"\n' "$d/lb.ns" > "$lb/cc-nosignal"   # records the prefix it was handed, then runs what follows --
  printf '#!/bin/sh\nprintf "%%s\\n" "${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS-UNSET}" > "$FK_ST/bgceil"\n[ -n "$FK_LINE" ] && printf "%%s\\n" "$FK_LINE" >> "$FK_ST/progress.md"\n[ "$FK_COMMIT" = 1 ] && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m step\nprintf "%%s\\n" "{\\"type\\":\\"result\\",\\"subtype\\":\\"success\\",\\"is_error\\":false,\\"num_turns\\":3,\\"total_cost_usd\\":1.25,\\"result\\":\\"did a step\\"}"\n' > "$lb/claude"
  sed -i '1a printf "%s\\n" "$@" > "$FK_ST/argv"' "$lb/claude"   # what the loop handed claude, one arg a line
  sed -i '1a printf "%s\\n" "${CC_GREEN_ASK-UNSET}" > "$FK_ST/gask"' "$lb/claude"   # where a fenced cc-green start would ask
  sed -i '1a printf "%s/%s\\n" "${CC_LIMIT_STAMP-UNSET}" "${CC_MODEL_CRED-UNSET}" > "$FK_ST/acct"' "$lb/claude"   # whose limit stamp and model record it ran under
  printf '#!/bin/sh\nprintf "%%s\\n" "{\\"task_id\\":\\"x\\",\\"committed_sha\\":\\"abc\\",\\"pending\\":{},\\"errors\\":[],\\"pr_url\\":\\"https://x/pull/9\\",\\"landing\\":{\\"message\\":\\"It is queued to land.\\"}}"\n' > "$lb/cc-land"
  chmod +x "$lb"/*
  lrun(){ c=$1; mkdir -p "$lh/.cc/state/lp/$c" "$lh/.cc/worktrees/lp/$c"; echo "the task" > "$lh/.cc/state/lp/$c/task.md"
    git -C "$lh/.cc/worktrees/lp/$c" init -q; git -C "$lh/.cc/worktrees/lp/$c" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    [ "$c" = dn ] && echo '{}' > "$lh/.cc/state/lp/$c/delivery.json"
    : > "$d/lb.n"
    ( env -i PATH="${lpath:-/usr/bin:/bin}" HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" ${lgreen:+CC_GREEN=$lgreen} \
        FK_ST="$lh/.cc/state/lp/$c" FK_LINE="$2" FK_COMMIT="$3" "$lb/cc-loop" lp "$c" "${@:4}" ) >/dev/null 2>&1; }
  slackn(){ grep -v '^--ask|' "$d/lb.n" | grep -c .; }   # the calls that reach Slack: all but the planner intake
  lrun it '- did one step, more to do' 0 --max-iter 1 --no-extend
  t "the worker's own print run gets the background-wait ceiling removed, so a subagent still running at turn end does not kill the iteration at 600s (hung_watch still ends one that goes silent)" \
    "$(cat "$lh/.cc/state/lp/it/bgceil" 2>/dev/null)" 0
  t 'an iteration that ends a loop with nothing committed posts nothing to Slack: its totals and spend stay in loop.log' "$(slackn)" 0
  t '…the stop goes to the planner intake instead' "$(grep -c '^--ask|' "$d/lb.n")" 1
  # lrun starts the loop under `env -i`, so a CLAUDE_CODE_SHELL_PREFIX or CC_WORKER_SANDBOX this selfcheck inherits
  # never reaches it: what is recorded below is the loop's own choice. A caller's prefix is the next case.
  t "…and it ran under cc-nosignal, its Bash calls in the sandbox's pid namespace with no prefix of their own" "$(cat "$d/lb.ns" 2>/dev/null)" UNSET
  t '…and loop.log still has the iteration and its budget' "$(grep -c 'iter 1 end .*total=\$1.25' "$lh/.cc/state/lp/it/loop.log")" 1
  mkdir -p "$lh/.cc/state/lp/ceil" "$lh/.cc/worktrees/lp/ceil"; echo "the task" > "$lh/.cc/state/lp/ceil/task.md"
  git -C "$lh/.cc/worktrees/lp/ceil" init -q; git -C "$lh/.cc/worktrees/lp/ceil" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  : > "$d/lb.n"
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      FK_ST="$lh/.cc/state/lp/ceil" FK_LINE="" FK_COMMIT=0 CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=9999 \
      CLAUDE_CODE_SHELL_PREFIX=/caller/prefix "$lb/cc-loop" lp ceil --max-iter 1 --no-extend ) >/dev/null 2>&1
  t 'a dispatcher that already set the ceiling is not overridden' "$(cat "$lh/.cc/state/lp/ceil/bgceil" 2>/dev/null)" 9999
  t '…nor is a shell prefix the caller set: its claude still runs under cc-nosignal' "$(cat "$d/lb.ns" 2>/dev/null)" /caller/prefix
  mkdir -p "$lh/.cc/state/lp/sbx" "$lh/.cc/worktrees/lp/sbx"; echo "the task" > "$lh/.cc/state/lp/sbx/task.md"
  git -C "$lh/.cc/worktrees/lp/sbx" init -q; git -C "$lh/.cc/worktrees/lp/sbx" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      FK_ST="$lh/.cc/state/lp/sbx" FK_LINE="" FK_COMMIT=0 CC_WORKER_SANDBOX=0 "$lb/cc-loop" lp sbx --max-iter 1 --no-extend ) >/dev/null 2>&1
  t '…and with the sandbox off (CC_WORKER_SANDBOX=0), each of its Bash calls is handed a scope of its own' "$(cat "$d/lb.ns" 2>/dev/null)" "$lb/cc-nosignal-shell"
  # ── WORKERS YIELD TO LANDINGS ── each case its own track and its own claude stub, which setsids a grandchild that
  # writes its slice's cgroup and that slice's cpu.weight. Shims first (any box): the scope is asked for in worker.slice
  # and the slice set to the low weight, CPU and IO, with a fresh unit name each launch; then off by CC_WORKER_SCOPE=0;
  # then, where this box has a user bus, the real slice beside a lander.slice scope the case starts itself.
  cat > "$lb/claude-cg" <<'CG'
#!/bin/sh
setsid sh -c '(c=$(sed -n "s/^0:://p" /proc/self/cgroup); echo "${c%/*} $(cat "/sys/fs/cgroup${c%/*}/cpu.weight" 2>/dev/null)" > "$FK_ST/cg.tmp"; echo "$(nice) $(ionice)" > "$FK_ST/ni"; mv "$FK_ST/cg.tmp" "$FK_ST/cg") &'
n=0; while [ ! -s "$FK_ST/cg" ] && [ $n -lt 50 ]; do sleep 0.1; n=$((n+1)); done
echo '{"type":"result","subtype":"success","is_error":false,"num_turns":1,"total_cost_usd":0.1,"result":"did a step"}'
CG
  mkdir -p "$d/srb"; printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\nwhile [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done; shift; exec "$@"\n' "$d/sr.argv" > "$d/srb/systemd-run"
  printf '#!/bin/sh\nprintf "systemctl %%s\\n" "$*" >> "%s"\n' "$d/sr.argv" > "$d/srb/systemctl"
  chmod +x "$lb/claude-cg" "$d/srb/systemd-run" "$d/srb/systemctl"
  wsc(){ mkdir -p "$lh/.cc/state/lp/$1" "$lh/.cc/worktrees/lp/$1"; echo "the task" > "$lh/.cc/state/lp/$1/task.md"
    git -C "$lh/.cc/worktrees/lp/$1" init -q; git -C "$lh/.cc/worktrees/lp/$1" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    ( env -i PATH="$2" HOME="$lh" ${XDG_RUNTIME_DIR:+XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR"} CC_CLAUDE="$lb/claude-cg" CC_LAND="$lb/cc-land" \
        CC_FAILURES="$d/lb.fl" FK_ST="$lh/.cc/state/lp/$1" CC_WORKER_SCOPE="$3" "$lb/cc-loop" lp "$1" --max-iter 1 --no-extend ) >/dev/null 2>&1; }
  wsc ws "$d/srb:/usr/bin:/bin" 1
  t "a worker's claude is started in a scope of its own in worker.slice, the slice set to CPU and IO weight 20, and its setsid grandchild ran" \
    "$(grep -c -- "--scope --quiet --collect --slice=worker.slice --unit=cc-worker-lp-ws-[0-9]*-1-[0-9]* -- sh -c .* env CC_ROLE=worker" "$d/sr.argv")/$(grep -c "^systemctl --user set-property --runtime worker.slice CPUWeight=20 IOWeight=20$" "$d/sr.argv")/$([ -s "$lh/.cc/state/lp/ws/cg" ] && echo ran)" 1/1/ran
  : > "$d/sr.argv"; wsc wo "$d/srb:/usr/bin:/bin" 0
  t '…and with CC_WORKER_SCOPE=0 it is not, but its setsid grandchild runs at nice 19 and IO 7, and loop.log warns' \
    "$(grep -c . "$d/sr.argv")/$(cat "$lh/.cc/state/lp/wo/ni")/$(grep -c 'WARNING: worker runs unscoped (CC_WORKER_SCOPE=0)' "$lh/.cc/state/lp/wo/loop.log")" "0/19 best-effort: prio 7/1"
  printf '#!/bin/sh\nexit 1\n' > "$d/srb/systemd-run"; wsc wf "$d/srb:/usr/bin:/bin" 1
  t '…and where there is no user bus, claude still runs, at nice 19 and IO 7, and loop.log warns' \
    "$(cat "$lh/.cc/state/lp/wf/ni")/$(grep -c 'WARNING: worker runs unscoped (no user systemd bus)' "$lh/.cc/state/lp/wf/loop.log")" "19 best-effort: prio 7/1"
  printf '#!/bin/sh\ncase "$*" in *" -- echo ok") echo ok; exit 0;; esac\necho "Failed to start transient scope unit" >&2; exit 1\n' > "$d/srb/systemd-run"; wsc wr "$d/srb:/usr/bin:/bin" 1
  t '…and where the probe passes but the scoped launch fails before claude starts, the same iteration runs it at nice 19 and IO 7, and loop.log warns' \
    "$(cat "$lh/.cc/state/lp/wr/ni")/$(grep -c 'WARNING: worker runs unscoped (the scoped launch failed before claude started, rc 1: Failed to start transient scope unit)' "$lh/.cc/state/lp/wr/loop.log")" "19 best-effort: prio 7/1"
  printf '#!/bin/sh\nwhile [ "$#" -gt 0 ] && [ "$1" != -- ]; do shift; done; shift; "$@"; exit 1\n' > "$d/srb/systemd-run"; wsc wn "$d/srb:/usr/bin:/bin" 1
  t '…but a scoped launch that fails after claude started is not run again' "$(grep -c 'scoped launch failed' "$lh/.cc/state/lp/wn/loop.log")/$([ -s "$lh/.cc/state/lp/wn/cg" ] && echo ran)" 0/ran
  if timeout 10 systemd-run --user --scope --quiet --collect -- true </dev/null >/dev/null 2>&1; then
    wsc wl /usr/bin:/bin 1
    ls=$(systemd-run --user --scope --quiet --collect --slice=lander.slice -- sh -c 'c=$(sed -n "s/^0:://p" /proc/self/cgroup); echo "${c%/*} $(cat "/sys/fs/cgroup${c%/*}/cpu.weight")"' 2>/dev/null)
    read -r wp ww < "$lh/.cc/state/lp/wl/cg" 2>/dev/null; lp=${ls% *}; lw=${ls##* }
    t "live: the worker's setsid grandchild sits in worker.slice at weight 20, a sibling of lander.slice at a higher one" \
      "${wp##*/} $ww/$([ -n "$wp" ] && [ "${wp%/*}" = "${lp%/*}" ] && echo siblings)/$([ "${lw:-0}" -gt 20 ] 2>/dev/null && echo below)" "worker.slice 20/siblings/below"
  else echo "cc-loop selfcheck: no user systemd bus here, so the live worker-weight case did not run" >&2; fi
  # ── WHOSE LIMIT ── with WORKER_CLAUDE_CREDENTIALS set, the limit stamp and model record follow the login cc-sandbox
  # says the launch will use (its stub answers worker-cred from FK_CRED), not the key: the workers' file, then the
  # box's, which is what a missing, expired or refused workers' login falls back to. The key alone moves nothing.
  printf '#!/bin/sh\n[ "$1 $2" = "get WORKER_CLAUDE_CREDENTIALS" ] && { echo "$FK_KEY"; exit 0; }\nexit 1\n' > "$lb/cc-config"; chmod +x "$lb/cc-config"
  wacct(){ mkdir -p "$lh/.cc/state/lp/$1" "$lh/.cc/worktrees/lp/$1"; echo "the task" > "$lh/.cc/state/lp/$1/task.md"
    git -C "$lh/.cc/worktrees/lp/$1" init -q; git -C "$lh/.cc/worktrees/lp/$1" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" FK_ST="$lh/.cc/state/lp/$1" \
        FK_LINE="" FK_COMMIT=0 FK_KEY="$lh/.claude-workers/.credentials.json" FK_CRED="$2" "$lb/cc-loop" lp "$1" --max-iter 1 --no-extend ) >/dev/null 2>&1
    cat "$lh/.cc/state/lp/$1/acct" 2>/dev/null; }
  t "the workers' login in use → its own limit stamp and model record" "$(wacct wa "$lh/.claude-workers/.credentials.json")" "$lh/.cc/state/claude-limit.workers/workers"
  t "…and the key set but cc-sandbox falling back to the box's login → the box's stamp and record, as with no key" \
    "$(wacct wb "$lh/.claude/.credentials.json")" UNSET/UNSET
  rm -f "${lb:?}/cc-config"
  # ── NO FENCE, NO WORKER ── a cc-sandbox whose probe refuses (a box with no working bwrap): the loop stops with exit 2
  # before iteration 1, says why in loop.log, and claude never runs. Its own track and stub; the passing stub is put back.
  mv "$lb/cc-sandbox" "$lb/cc-sandbox.ok"
  printf '#!/bin/sh\n[ "$1" = probe ] && { echo "bwrap is not installed (fixture)" >&2; exit 2; }\nexit 0\n' > "$lb/cc-sandbox"; chmod +x "$lb/cc-sandbox"
  mkdir -p "$lh/.cc/state/lp/nf" "$lh/.cc/worktrees/lp/nf"; echo "the task" > "$lh/.cc/state/lp/nf/task.md"
  git -C "$lh/.cc/worktrees/lp/nf" init -q; git -C "$lh/.cc/worktrees/lp/nf" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      FK_ST="$lh/.cc/state/lp/nf" FK_LINE="" FK_COMMIT=0 "$lb/cc-loop" lp nf --max-iter 1 --no-extend ) >/dev/null 2>&1; c=$?
  t 'a box where the fence cannot start runs no worker: exit 2 before iteration 1, the reason in loop.log, claude never ran' \
    "$c/$(grep -c 'exit 2: the worker sandbox cannot start.*bwrap is not installed (fixture)' "$lh/.cc/state/lp/nf/loop.log" 2>/dev/null)/$(grep -c 'iter 1/' "$lh/.cc/state/lp/nf/loop.log" 2>/dev/null)/$([ -e "$lh/.cc/state/lp/nf/bgceil" ] && echo ran || echo none)" \
    2/1/0/none
  mv -f "$lb/cc-sandbox.ok" "$lb/cc-sandbox"
  # ── A KILLED ITERATION STILL LOGS WHAT IT SPENT ── its own fixture: a claude that writes a transcript (250k input
  # tokens of opus-5-5 = $1.0000) and is killed as hung (rc=124) with no result json. The file is a RESUMED
  # session's, so it already holds an earlier run's $12 record, which must not be priced again. Beside it, a finished
  # iteration whose json carries its own cost, which must never be re-priced from a transcript.
  cp "$BIN/cc-spend" "$lb/cc-spend"
  cat > "$lb/claudekill" <<'KILL'
#!/bin/sh
p="$HOME/.claude/projects/$(printf %s "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"; mkdir -p "$p"
printf '%s\n' '{"type":"assistant","requestId":"r0","sessionId":"s1","timestamp":"2026-01-01T10:00:00Z","cwd":"/x","message":{"model":"claude-opus-5-5","usage":{"input_tokens":3000000}}}' > "$p/s1.jsonl"
printf '{"type":"assistant","requestId":"r1","sessionId":"s1","timestamp":"%s","cwd":"/x","message":{"model":"claude-opus-5-5","usage":{"input_tokens":250000}}}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$p/s1.jsonl"
exit 124
KILL
  chmod +x "$lb/claudekill" "$lb/cc-spend"
  mkdir -p "$lh/.cc/state/lp/kl" "$lh/.cc/worktrees/lp/kl"; echo "the task" > "$lh/.cc/state/lp/kl/task.md"
  git -C "$lh/.cc/worktrees/lp/kl" init -q; git -C "$lh/.cc/worktrees/lp/kl" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudekill" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      "$lb/cc-loop" lp kl --max-iter 1 --no-extend ) >/dev/null 2>&1
  t 'an iteration killed as hung logs the spend its transcript shows since it started (not a resumed session'"'"'s older records), marked as priced from it' \
    "$(grep -c 'iter 1 end rc=124 .*cost=\$1.0000~transcript total=\$1.0000' "$lh/.cc/state/lp/kl/loop.log")" 1
  # ── A TIMED-OUT ITERATION IS NAMED, AND ONE THAT COMMITTED IS NO FAILURE ── each run its own track and fixture: a
  # claude killed as hung (rc=124), committing (FK_COMMIT=1) or not. 67 of 513 iterations died this way
  # with an empty "error (N): " line, and two in a row stopped the track even when both had committed.
  cat > "$lb/claudeto" <<'TO'
#!/bin/sh
[ "$FK_COMMIT" = 1 ] && git -c user.name=t -c user.email=t@t commit -q --allow-empty -m step
exit 124
TO
  chmod +x "$lb/claudeto"
  for tk in toc ton; do
    mkdir -p "$lh/.cc/state/lp/$tk" "$lh/.cc/worktrees/lp/$tk"; echo "the task" > "$lh/.cc/state/lp/$tk/task.md"
    git -C "$lh/.cc/worktrees/lp/$tk" init -q; git -C "$lh/.cc/worktrees/lp/$tk" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudeto" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
        FK_COMMIT="$([ "$tk" = toc ] && echo 1 || echo 0)" "$lb/cc-loop" lp "$tk" --max-iter 2 --no-extend ) >/dev/null 2>&1
  done
  t 'two timed-out iterations that each committed are not failures: no error line, no errored stop' \
    "$(grep -c 'error (\|2 consecutive failures' "$lh/.cc/state/lp/toc/loop.log")/$(grep -c 'killed as hung (rc=124, transcript silent [0-9?]* s), but it committed' "$lh/.cc/state/lp/toc/loop.log")" 0/2
  t '…while two that committed nothing count, each error line naming the timeout, and stop the track as errored' \
    "$(grep -c 'error ([12]): killed as hung (rc=124, transcript silent [0-9?]* s) with nothing committed' "$lh/.cc/state/lp/ton/loop.log")/$(grep -c '2 consecutive failures' "$lh/.cc/state/lp/ton/loop.log")" 2/1
  # ── AN ITERATION STILL RUNNING ITS OWN GATE IS NEVER COUNTED (owner 10-16) ── the same timed-out claude, nothing
  # committed: tog with a cc-green run live as it ends (CC_GREEN answers 3 to `wait 0`), toe with a detached run of its
  # own (an EDA run) left in the worktree. Neither is a failure, so neither track is stopped as errored.
  printf '#!/bin/sh\n[ "$2" = 0 ] && { echo "cc-green: still running (pid 1, since 00:00)"; exit 3; }\necho "cc-green: green — log /x/g.log"; exit 0\n' > "$lb/greenlive"
  cat > "$lb/claudeeda" <<'EDA'
#!/bin/sh
setsid sleep 60 </dev/null >/dev/null 2>&1 &
echo $! >> "$FK_EDA"
exit 124
EDA
  chmod +x "$lb/greenlive" "$lb/claudeeda"
  for tk in tog toe; do
    mkdir -p "$lh/.cc/state/lp/$tk" "$lh/.cc/worktrees/lp/$tk"; echo "the task" > "$lh/.cc/state/lp/$tk/task.md"
    git -C "$lh/.cc/worktrees/lp/$tk" init -q; git -C "$lh/.cc/worktrees/lp/$tk" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  done
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudeto" CC_GREEN="$lb/greenlive" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      FK_COMMIT=0 "$lb/cc-loop" lp tog --max-iter 2 --no-extend ) >/dev/null 2>&1
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudeeda" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
      FK_EDA="$d/eda.pids" "$lb/cc-loop" lp toe --max-iter 2 --no-extend ) >/dev/null 2>&1
  for p in $(cat "$d/eda.pids" 2>/dev/null); do kill "$p" 2>/dev/null; done
  t 'two timed-out iterations whose own cc-green run was still going are not failures: no error line, no errored stop' \
    "$(grep -c 'error (\|2 consecutive failures' "$lh/.cc/state/lp/tog/loop.log")/$(grep -c 'ended (rc=124) while its own gate run was still going — not counted' "$lh/.cc/state/lp/tog/loop.log")" 0/2
  t '…nor two whose own detached run (an EDA run) was still going in the worktree, each named in the log' \
    "$(grep -c 'error (\|2 consecutive failures' "$lh/.cc/state/lp/toe/loop.log")/$(grep -c 'a run of its own still going in its worktree ([0-9]* sleep 60' "$lh/.cc/state/lp/toe/loop.log")" 0/2
  t '…but a run of its own it never waits for does not switch the barren stops off: each of the two is a runaway signal' \
    "$(grep -c 'runaway signal [0-9]*/[0-9]*: committed nothing and left the journal untouched' "$lh/.cc/state/lp/toe/loop.log")" 2
  t '…and a finished iteration keeps the cost its own json reports, unmarked' \
    "$(grep -c 'iter 1 end .*cost=\$1.25 total=' "$lh/.cc/state/lp/it/loop.log")" 1
  # ── HUNG, NOT LONG (owner 10-20) ── three fixtures, each its own track, with a 2 s silence meaning hung and a 1 s
  # look: hg writes its transcript once and goes silent, so it is killed and counted; lv keeps writing for longer than
  # the silence allowed, so it runs to its own end; bl writes no transcript at all, so the loop cannot see one and
  # kills nothing; sl is lv with its project dir a symlink, which
  # the look follows; lk is hg with a link it planted in that dir to a tree elsewhere that keeps growing, which the look
  # never walks, so it is killed all the same. The wall clock alone ends none of them.
  cat > "$lb/claudehung" <<'HG'
#!/bin/sh
p="$HOME/.claude/projects/$(realpath "$PWD" | sed 's/[^A-Za-z0-9]/-/g')"; mkdir -p "$p"
[ -n "$FK_LINK" ] && { ln -s "$FK_LINK" "$p/out"; ( while :; do echo x >> "$FK_LINK/d/o.jsonl"; sleep 1; done ) & }
n=0; while [ "$n" -lt "${FK_LIVE:-0}" ]; do echo '{"type":"user"}' >> "$p/s.jsonl"; sleep 1; n=$((n+1)); done
[ "${FK_LIVE:-0}" = 0 ] && { [ "$FK_BLIND" = 1 ] && rmdir "$p"; [ "$FK_BLIND" = 1 ] || echo '{"type":"user"}' >> "$p/s.jsonl"; sleep "$FK_SLEEP"; }
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"num_turns":3,"total_cost_usd":1.25,"result":"did a step"}'
HG
  chmod +x "$lb/claudehung"
  hrun(){ mkdir -p "$lh/.cc/state/lp/$1" "$lh/.cc/worktrees/lp/$1"; echo "the task" > "$lh/.cc/state/lp/$1/task.md"
    git -C "$lh/.cc/worktrees/lp/$1" init -q; git -C "$lh/.cc/worktrees/lp/$1" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudehung" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" CC_LOOP_HUNG_SECS=2 CC_LOOP_HUNG_POLL=1 \
        FK_LIVE="$2" FK_SLEEP="$3" FK_BLIND="$4" FK_LINK="${5:-}" "$lb/cc-loop" lp "$1" --once ) >/dev/null 2>&1; }
  hrun hg 0 30 0; hrun lv 5 0 0; hrun bl 0 4 1
  mkdir -p "$lh/elsewhere" "$lh/.claude/projects"   # sl: lv again, its project dir a symlink to a dir elsewhere
  ln -s "$lh/elsewhere" "$lh/.claude/projects/$(realpath -m "$lh/.cc/worktrees/lp/sl" | sed 's/[^A-Za-z0-9]/-/g')"; hrun sl 5 0 0
  mkdir -p "$lh/big/d"; hrun lk 0 30 0 "$lh/big"
  t 'an iteration whose transcript stopped growing is killed as hung, and with nothing committed it is an error that names it' \
    "$(grep -c 'iter 1 end rc=124 ' "$lh/.cc/state/lp/hg/loop.log")/$(grep -c 'error (1): killed as hung (rc=124, transcript silent [0-9]* s) with nothing committed' "$lh/.cc/state/lp/hg/loop.log")" 1/1
  t '…one still writing it past that silence runs to its own end' "$(grep -c 'iter 1 end rc=0 ' "$lh/.cc/state/lp/lv/loop.log")/$(grep -c 'killed as hung' "$lh/.cc/state/lp/lv/loop.log")" 1/0
  t '…and so does one whose project dir is a symlink' "$(grep -c 'iter 1 end rc=0 ' "$lh/.cc/state/lp/sl/loop.log")/$(grep -c 'killed as hung\|cannot see' "$lh/.cc/state/lp/sl/loop.log")/$(ls "$lh/elsewhere")" 1/0/s.jsonl
  t '…and one whose transcript the loop cannot see is not killed: it is said once instead' \
    "$(grep -c 'iter 1 end rc=0 ' "$lh/.cc/state/lp/bl/loop.log")/$(grep -c 'the hung check cannot see a transcript' "$lh/.cc/state/lp/bl/loop.log")" 1/1
  t '…and a link planted under the project dir to a growing tree elsewhere is never walked: that iteration is killed as hung' \
    "$(grep -c 'iter 1 end rc=124 ' "$lh/.cc/state/lp/lk/loop.log")/$(grep -c 'killed as hung' "$lh/.cc/state/lp/lk/loop.log")/$([ -s "$lh/big/d/o.jsonl" ] && echo grew)" 1/1/grew
  # ── NO COUNT STOPS IT ── a worker that does nothing, with a checkpoint every 2 iterations and a runaway notice at 2
  # barren in a row: it passes both, is told at its 2nd, 3rd and 5th barren iteration (the doubling stride), and runs until its own fifth call writes the stop file.
  cat > "$lb/claudeidle" <<'ID'
#!/bin/sh
printf "%s\n" "$@" > "$FK_ST/argv"; echo x >> "$FK_ST/calls"; [ "$(wc -l < "$FK_ST/calls")" -ge 5 ] && echo "enough" > "$FK_ST/stop"
printf '%s\n' '{"type":"result","subtype":"success","is_error":false,"num_turns":3,"total_cost_usd":1.25,"result":"did a step"}'
ID
  chmod +x "$lb/claudeidle"; mkdir -p "$lh/.cc/state/lp/ra" "$lh/.cc/worktrees/lp/ra"; echo "the task" > "$lh/.cc/state/lp/ra/task.md"
  git -C "$lh/.cc/worktrees/lp/ra" init -q; git -C "$lh/.cc/worktrees/lp/ra" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claudeidle" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" CC_LOOP_RUNAWAY_N=2 \
      FK_ST="$lh/.cc/state/lp/ra" "$lb/cc-loop" lp ra --max-iter 2 ) >/dev/null 2>&1; c=$?
  t 'a loop that commits nothing passes its checkpoints and its runaway notice, told again on a doubling stride, and ends on the stop file a person wrote' \
    "$c/$(wc -l < "$lh/.cc/state/lp/ra/calls")/$(grep -c 'checkpoint at [0-9]* iterations' "$lh/.cc/state/lp/ra/loop.log")/$(grep -o 'runaway notice at [0-9]* barren' "$lh/.cc/state/lp/ra/loop.log" | grep -o '[0-9]*' | tr '\n' ' ')" '14/5/2/2 3 5 '
  t '…and no iteration was told it was the last of a count' "$(grep -c 'Iteration [0-9]* of' "$lh/.cc/state/lp/ra/argv")" 0
  t 'no tool-call limit is handed to a worker by default; --budget still is' \
    "$(grep -cx -- '--max-turns' "$lh/.cc/state/lp/it/argv")/$(grep -cx -- '--max-budget-usd' "$lh/.cc/state/lp/it/argv")" 0/1
  lrun ro '- committed a step' 1 --max-iter 1 --no-extend
  t 'a round that is over posts nothing at all' "$(grep -c . "$d/lb.n")" 0
  t '…and the board note and loop.log carry it' "$(grep -c 'round over at its step limit' "$lh/.cc/state/lp/ro/loop.log")" 1
  # ── A WORKER'S QUESTION GOES TO THE SEAT FIRST ── two fixtures: no broker on this copy (no session hears it) and a
  # broker that takes the line (a cc-broker stub that records its argv and exits 0, removed again after its run).
  lrun bk 'STATUS: BLOCKED: which port do I use?' 0 --max-iter 3 --no-extend
  t 'a BLOCKED question no seat took is posted once, and not also filed as a request' "$(slackn)/$(grep -c '^--ask|' "$d/lb.n")" 1/0
  t '…and loop.log says where it went: no session, a decision card' \
    "$(grep -c "the stop went to lp's session: no — its question went out as a decision card: yes" "$lh/.cc/state/lp/bk/loop.log")" 1
  t '…as the owner\047s decision card under a stable blocked: id, routed by the track, the row and the question alone — no STATUS line, no resume recipe' \
    "$(grep -v '^--ask|' "$d/lb.n" | sed -E 's/(blocked:lp\/bk:)[0-9a-f]+:[0-9]+/\1H:C/')" "--decision|--id|blocked:lp/bk:H:C|-t|lp/bk needs you|bk: which port do I use?|"
  t '…and no unmentioned --major post of it on #<repo>' "$(grep -c -- '--major' "$d/lb.n")" 0
  # ── A PUSHED HEAD OUTRANKS A BLOCKED ON THE SANDBOX'S VIEW (blocked_by_view, head_pushed) ── each its own track. The
  # fake claude writes the same line every iteration, so the overruled one runs a second iteration and stops there.
  lrunp(){ c=$1; mkdir -p "$lh/.cc/state/lp/$c" "$lh/.cc/worktrees/lp/$c"; echo "the task" > "$lh/.cc/state/lp/$c/task.md"
    git -C "$lh/.cc/worktrees/lp/$c" init -q; git -C "$lh/.cc/worktrees/lp/$c" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    git -C "$lh/.cc/worktrees/lp/$c" update-ref "refs/remotes/origin/track/$c" HEAD; : > "$d/lb.n"   # what a push the checkpoint made leaves
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
        FK_ST="$lh/.cc/state/lp/$c" FK_LINE="$2" FK_COMMIT=0 "$lb/cc-loop" lp "$c" --max-iter 3 ) >/dev/null 2>&1; }
  lrunp vp 'STATUS: BLOCKED: git push failed (no credential) and ~/dev/lp looks deleted — the box is broken?'
  t 'a BLOCKED on a push failure, with its head already on origin, is answered in the journal and the loop runs on' \
    "$(grep -c '^STATUS: RESUMED: cc-loop pushed' "$lh/.cc/state/lp/vp/progress.md")/$(grep -c 'iter 2/3 start' "$lh/.cc/state/lp/vp/loop.log")" 1/1
  t '…once: the same line again is the worker'"'"'s answer and stops as any BLOCKED does, one decision card' \
    "$(grep -c 'iter 3/3 start' "$lh/.cc/state/lp/vp/loop.log")/$(slackn)" 0/1
  lrun vn 'STATUS: BLOCKED: git push failed (no credential)' 0 --max-iter 3
  t '…and the same line on a head that is NOT on origin stops at once: the loop has nothing of its own to say' \
    "$(grep -c '^STATUS: RESUMED' "$lh/.cc/state/lp/vn/progress.md")/$(grep -c 'iter 2/3 start' "$lh/.cc/state/lp/vn/loop.log")" 0/0
  lrunp vo 'STATUS: BLOCKED: owner: should I push the deleted rows and the sandbox credential note to main?'
  t '…nor an owner question that only says push, deleted, sandbox or credential' \
    "$(grep -c '^STATUS: RESUMED' "$lh/.cc/state/lp/vo/progress.md")/$(grep -c 'iter 2/3 start' "$lh/.cc/state/lp/vo/loop.log")" 0/0
  lrunp vq 'STATUS: BLOCKED: which port do I use?'
  t '…and a pushed head does not answer a question about something else' \
    "$(grep -c '^STATUS: RESUMED' "$lh/.cc/state/lp/vq/progress.md")/$(grep -c 'iter 2/3 start' "$lh/.cc/state/lp/vq/loop.log")" 0/0
  t 'the worker prompt says what the sandbox hides and that the loop pushes, and says nothing of it with the sandbox off' \
    "$(grep -c 'THE SANDBOX HIDES THINGS BY DESIGN' "$lh/.cc/state/lp/it/argv")/$(grep -c 'THE SANDBOX HIDES THINGS BY DESIGN' "$lh/.cc/state/lp/sbx/argv")" 1/0
  # ── A PUSH ASK THE REMOTE ALREADY ANSWERED IS NOT A STOP (10-13: three rows paged the seat for one each) ── each case
  # its own worktree with a bare origin: pp names (by full sha) a commit origin's track branch already holds, pn one it
  # does not, pq a pushed commit in a question that is not about a push, pf one in a force-push question, pm one in the
  # named shape with a second ask on the line, pr one whose push-ask clauses are followed by a whole clause asking a
  # merge to another branch (every word of it a push-ask word), pd one in the deploy question an earlier review
  # handed back, pt one asking the push to its own track branch, po one asking it to another track's branch. No
  # cc-checkpoint on this copy, so nothing pushes here.
  pfx(){ local w="$lh/.cc/worktrees/lp/$1"; mkdir -p "$lh/.cc/state/lp/$1" "$w"; echo "the task" > "$lh/.cc/state/lp/$1/task.md"
    git init -q --bare "$d/$1.git"; git -C "$w" init -q -b "track/$1"; git -C "$w" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    git -C "$w" remote add origin "$d/$1.git"; git -C "$w" push -q -u origin "track/$1" 2>/dev/null
    [ "$1" = pn ] && git -C "$w" -c user.name=t -c user.email=t@t commit -q --allow-empty -m local
    if [ "$1" = pp ]; then git -C "$w" rev-parse HEAD; else git -C "$w" rev-parse --short HEAD; fi; }
  for c in pp pn pq pf pm pr pd pt po; do
    s=$(pfx "$c"); case $c in pq) l="STATUS: BLOCKED: is $s the right base, or should I rebase?";;
      pf) l="STATUS: BLOCKED: should I force-push $s over the rebased branch?";;
      pm) l="STATUS: BLOCKED: merge $s cannot be pushed from the sandbox; push from the host and decide which port the service takes";;
      pr) l="STATUS: BLOCKED: merge $s cannot be pushed from the sandbox; push from the host; please merge it to branch track/release";;
      pd) l="STATUS: BLOCKED: $s is pushed; may I deploy it to production?";;
      pt) l="STATUS: BLOCKED: merge $s cannot be pushed from the sandbox; push from the host to track/pt";;
      po) l="STATUS: BLOCKED: merge $s cannot be pushed from the sandbox; push from the host to track/other-row";;
      *) l="STATUS: BLOCKED: merge $s is committed locally but cannot be pushed from the sandbox; push from the host";; esac
    : > "$d/lb.n"
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/cc-land" CC_FAILURES="$d/lb.fl" \
        FK_ST="$lh/.cc/state/lp/$c" FK_LINE="$l" FK_COMMIT=0 "$lb/cc-loop" lp "$c" --max-iter 1 --no-extend ) >/dev/null 2>&1
  done
  t 'a BLOCKED push ask for a sha origin already holds stops nothing: no exit 3, its STATUS line gone from the journal, and the journal and loop.log say why' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pp/loop.log")/$(grep -c '^STATUS: BLOCKED' "$lh/.cc/state/lp/pp/progress.md")/$(grep -c 'cc-loop: the BLOCKED line asked for a push, but [0-9a-f]* on origin/track/pp (tip [0-9a-f]*) already' "$lh/.cc/state/lp/pp/progress.md")/$(grep -c 'BLOCKED push ask cleared' "$lh/.cc/state/lp/pp/loop.log")" 0/0/1/1
  t '…but one naming a commit origin does not have still stops as needs-you, its line kept' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pn/loop.log")/$(grep -c '^STATUS: BLOCKED' "$lh/.cc/state/lp/pn/progress.md")" 1/1
  t '…and so does a question that is not about a push, though the sha it names is on origin' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pq/loop.log")/$(grep -c '^STATUS: BLOCKED' "$lh/.cc/state/lp/pq/progress.md")" 1/1
  t '…and so does a push question in no push-ask shape (a force-push), though its sha is on origin' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pf/loop.log")/$(grep -c '^STATUS: BLOCKED' "$lh/.cc/state/lp/pf/progress.md")" 1/1
  t '…and so does a push ask in the named shape that asks something else too, its line kept whole' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pm/loop.log")/$(grep -c '^STATUS: BLOCKED: merge [0-9a-f]* cannot be pushed .* decide which port' "$lh/.cc/state/lp/pm/progress.md")" 1/1
  t '…and so does a push ask followed by a clause asking a merge to another branch, its line kept whole' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pr/loop.log")/$(grep -c '^STATUS: BLOCKED: merge [0-9a-f]* cannot be pushed .*; please merge it to branch track/release$' "$lh/.cc/state/lp/pr/progress.md")" 1/1
  t '…and so does a deploy question about a commit already pushed, its line kept whole' \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pd/loop.log")/$(grep -c '^STATUS: BLOCKED: [0-9a-f]* is pushed; may I deploy it to production?$' "$lh/.cc/state/lp/pd/progress.md")" 1/1
  t "…a push from the host to this row's own track branch is cleared like the plain ask" \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/pt/loop.log")/$(grep -c '^STATUS: BLOCKED' "$lh/.cc/state/lp/pt/progress.md")/$(grep -c 'BLOCKED push ask cleared' "$lh/.cc/state/lp/pt/loop.log")" 0/0/1
  t "…but one asking a push to another track's branch stops, its line kept whole" \
    "$(grep -c '^[^ ]* exit 3: STATUS: BLOCKED' "$lh/.cc/state/lp/po/loop.log")/$(grep -c '^STATUS: BLOCKED: merge [0-9a-f]* cannot be pushed .*push from the host to track/other-row$' "$lh/.cc/state/lp/po/progress.md")" 1/1
  # THE SEAT TAKES IT: the same run beside a broker that answers, on its own bin copy. Nothing is posted, and the
  # seat's one line carries the decision card it would raise, under the same id.
  # A seat that took it is a broker rc 0 AND an open window for its key (target_live): a tmux stub on the PATH says lp's is open.
  mkdir -p "$d/lbt"; printf '#!/bin/sh\necho lp\n' > "$d/lbt/tmux"; chmod +x "$d/lbt/tmux"
  local sb="$d/lbs"; mkdir -p "$sb"; cp -p "$lb"/* "$sb/"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\nexit 0\n' "$d/lbs.br" > "$sb/cc-broker"; chmod +x "$sb/cc-broker"; : > "$d/lbs.br"
  lb="$sb" lpath="$d/lbt:/usr/bin:/bin" lrun bks 'STATUS: BLOCKED: which port do I use?' 0 --max-iter 3 --no-extend
  t 'a BLOCKED question the seat took posts nothing and files no request' "$(grep -c . "$d/lb.n")" 0
  t '…the seat got it once, with the escalation it may run: cc-notify --decision under the blocked: id' \
    "$(grep -c '^inject --no-start --source loop lp loop: lp/bks needs you — STATUS: BLOCKED: which port do I use?.* — only the owner can settle it? cc-notify --decision --id blocked:lp/bks:[0-9a-f]*:[0-9]* -t "lp/bks needs you" "<the question>"$' "$d/lbs.br")" 1
  : > "$d/lbs.br"; lb="$sb" lpath="$d/lbt:/usr/bin:/bin" lrun its '- did one step, more to do' 0 --max-iter 1 --no-extend
  t 'a stop with no question the seat took: nothing posted, nothing filed, and its line offers no decision card' \
    "$(grep -c . "$d/lb.n")/$(grep -c 'cc-notify --decision' "$d/lbs.br")" 0/0
  lb="$d/lb"
  printf '#!/bin/sh\nprintf "%%s|" "$@" >> "%s"; echo >> "%s"\n' "$d/lb.b" "$d/lb.b" > "$lb/cc-broker"; chmod +x "$lb/cc-broker"; : > "$d/lb.b"
  lpath="$d/lbt:/usr/bin:/bin" lrun bh 'STATUS: BLOCKED: may the two checks move from host to hermetic?' 0 --max-iter 3 --no-extend
  rm -f "$lb/cc-broker"
  t 'a BLOCKED question the seat heard posts nothing to Slack and files no request — it is the seat'"'"'s to settle' "$(grep -c . "$d/lb.n")" 0
  t '…the seat gets the question, told to settle it or ask the owner itself' \
    "$(grep -c '^inject|--no-start|--source|loop|lp|loop: lp/bh needs you — STATUS: BLOCKED: may the two checks move from host to hermetic?  Settle it yourself if you can; only if it is the owner.s to decide, ask him with cc-notify --decision' "$d/lb.b")" 1
  # ── A RUNNING WORKER HAS A WAY IN (say_send, inbox_hook, loop_live). "a message to a running track … reach[es] a live
  # turn or exit[s] non-zero saying why. None exits 0 on nothing." Each case builds its own state dir.
  local sh="$d/sayh" sst sp sayp
  sy(){ ( HOME="$sh" CC_SAY_WAIT="${SW:-1}" CC_SAY_LOCK_WAIT="${SLW:-5}" CC_MSG_FROM=selfcheck "$lb/cc-loop" say lp "$1" "$2" >/dev/null 2>"$d/say.err" ); echo "rc=$?"; }
  sst="$sh/.cc/state/lp/dead"; mkdir -p "$sst"
  t 'say: no loop.pid is no live loop — rc 1, "nothing was sent", nothing spooled' \
    "$(sy dead hi)|$(grep -c 'no live worker loop for lp/dead — nothing was sent' "$d/say.err")|$(test -e "$sst/say.spool" && echo spooled)" "rc=1|1|"
  echo 4194303 > "$sst/loop.pid"
  t '…nor is a pid that is no longer running' "$(sy dead hi)|$(test -e "$sst/say.spool" && echo spooled)" "rc=1|"
  sleep 30 & sayp=$!; echo "$sayp" > "$sst/loop.pid"
  t '…nor a live pid that is not a cc-loop for this track (a reused pid)' "$(sy dead hi)|$(test -e "$sst/say.spool" && echo spooled)" "rc=1|"
  kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null
  # The scan is host-wide, so these names carry this run's pid: a sibling selfcheck's `cc-loop lp mem` is not ours.
  local mt="mem$$" ab="a.b$$" aXb="aXb$$"
  sst="$sh/.cc/state/lp/$mt"; mkdir -p "$sst"; echo 2 > "$sst/loop.pid"   # a pid from inside bwrap's own namespace
  # THE PRODUCTION SHAPE (review of #635): cc's tmux window is ONE `bash -c` string, and cc-sandbox execs bwrap, so
  # neither host process has `cc-sandbox member … -- cc-loop …` as separate arguments. Each shape alone is a live loop.
  bash -c "sleep 30; : $lb/cc-sandbox member lp $mt -- cc-loop lp $mt --max-iter 3; : $lb/cc-loop member-stop lp $mt 0" & sayp=$!
  t 'say: a member workspace loop, whose loop.pid is namespace-local, is found by the host window'"'"'s bash -c string — rc 3, kept' \
    "$(sy $mt 'the archive is in files/')|$(jq -r .text "$sst/say.spool")" "rc=3|the archive is in files/"
  kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null; : > "$sst/say.spool"
  bash -c 'sleep 30; :' bwrap --unshare-pid --die-with-parent --chdir / -- "$lb/cc-loop" lp $mt --max-iter 3 & sayp=$!
  t '…and by a bwrap-style argv with no cc-sandbox in it — rc 3, kept' \
    "$(sy $mt 'the archive is in files/')|$(jq -r .text "$sst/say.spool")" "rc=3|the archive is in files/"
  kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null; : > "$sst/say.spool"
  t '…and once that sandbox is gone it is no live loop — rc 1, nothing spooled' "$(sy $mt again)|$(wc -c < "$sst/say.spool")" "rc=1|0"
  bash -c "sleep 30; : $lb/cc-loop say lp $mt hello; : $lb/cc-loop member-stop lp $mt 0; : cc-loop lp ${mt}x" & sayp=$!
  t '…nor is a string naming cc-loop for another verb or another track — rc 1, nothing spooled' "$(sy $mt again)|$(wc -c < "$sst/say.spool")" "rc=1|0"
  kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null
  sst="$sh/.cc/state/lp/live"; mkdir -p "$sst"
  bash -c 'sleep 30; :' "$lb/cc-loop" lp live & sayp=$!; echo "$sayp" > "$sst/loop.pid"
  t 'say: a live loop whose worker takes nothing inside the wait is rc 3, "not yet heard", and the message is kept' \
    "$(sy live 'the archive has a metadata file')|$(grep -c 'kept for lp/live, not yet heard' "$d/say.err")|$(jq -r .text "$sst/say.spool")" \
    "rc=3|1|the archive has a metadata file"
  t 'inbox-hook: the next tool call hands the spool to the turn as PostToolUse context' \
    "$(echo '{}' | "$lb/cc-loop" inbox-hook "$sst" | jq -r '.hookSpecificOutput | "\(.hookEventName)|\(.additionalContext | test("the archive has a metadata file"))"')" "PostToolUse|true"
  t '…moves it to say.read with the time it was taken, and empties the spool' \
    "$(jq -r 'has("taken")' "$sst/say.read")|$(wc -c < "$sst/say.spool")" "true|0"
  t '…and with nothing spooled it says nothing and exits 0 (a hook must never fail the tool call)' \
    "$(echo '{}' | "$lb/cc-loop" inbox-hook "$sst"; echo "rc=$?")" "rc=0"
  ( sleep 1; echo '{}' | "$lb/cc-loop" inbox-hook "$sst" >/dev/null ) &
  t 'say: a live loop whose worker takes it inside the wait is rc 0, "taken by the running worker"' "$(SW=8 sy live 'second fact' 2>/dev/null)" "rc=0"
  wait; kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null
  # THE ACK IS THE MESSAGE'S OWN ID (review of #635, finding 5). Kept: the case above. Reported: older taken records with
  # the same text and the same second are not this message, so it is rc 3, kept, not "taken".
  sst="$sh/.cc/state/lp/ack"; mkdir -p "$sst"; bash -c 'sleep 30; :' "$lb/cc-loop" lp ack & sayp=$!; echo "$sayp" > "$sst/loop.pid"
  for x in stop status; do printf '{"id":"old-%s","at":"%s","from":"x","text":"%s","taken":"%s"}\n' "$x" "$(date -u +%FT%TZ)" "$x" "$(date -u +%FT%TZ)" >> "$sst/say.read"; done
  t 'say: older taken records with the same text in the same second do not ack a new message — rc 3, it stays spooled' \
    "$(sy ack stop)|$(jq -r .text "$sst/say.spool")|$(jq -r '.id | test("^old-")' "$sst/say.spool")" "rc=3|stop|false"
  # THE LOCK HELD PAST ITS WAIT IS ITS OWN CODE, 2 (review of #635, finding 16): not 1 "no live loop", which cc reads as
  # "try the pane". Nothing is spooled.
  : > "$sst/say.spool"; flock "$sst/.say.lock" sleep 3 & x=$!; sleep 0.3
  t 'say: a live loop whose spool lock is held past its wait is rc 2, "did not take the message", nothing spooled' \
    "$(SLW=0.5 sy ack 'held out')|$(grep -c 'did not take the message' "$d/say.err")|$(wc -c < "$sst/say.spool")" "rc=2|1|0"
  wait "$x" 2>/dev/null
  # A PLANTED NAME IS NEVER OPENED THROUGH (review of #635, findings 3 and 4). The state dir is the member's to write and
  # `cc --say` runs as the owner, so each of the four names is planted as a link to an owner file here and the op that
  # opens it must refuse, leave that file as it was, and say so. Kept: the plain files of the cases above.
  printf 'keep\n' > "$d/victim"
  rm -f "${sst:?}/.say.lock"; ln -s "$d/victim" "$sst/.say.lock"
  t 'say: a planted .say.lock link is refused — rc 2, the file it names is untouched, the refusal said' \
    "$(sy ack x)|$(cat "$d/victim")|$(grep -c '\.say\.lock is a symlink — refused' "$d/say.err")" "rc=2|keep|1"
  rm -f "$sst/.say.lock" "$sst/say.spool"; ln -s "$d/victim" "$sst/say.spool"
  t 'say: a planted say.spool link is refused — rc 2, the file it names is untouched' \
    "$(sy ack x)|$(cat "$d/victim")|$(grep -c 'say\.spool is a symlink — refused' "$d/say.err")" "rc=2|keep|1"
  t '…and the inbox hook takes nothing through it and still exits 0' \
    "$(echo '{}' | "$lb/cc-loop" inbox-hook "$sst" 2>/dev/null; echo "rc=$?")|$(cat "$d/victim")" "rc=0|keep"
  rm -f "$sst/say.spool"; mkfifo "$sst/say.spool"
  t 'say: a FIFO planted at say.spool is refused, not blocked on' "$(sy ack x)" "rc=2"
  rm -f "$sst/say.spool" "$sst/say.read"; printf '{"id":"m1","at":"x","from":"y","text":"waiting"}\n' > "$sst/say.spool"; ln -s "$d/victim" "$sst/say.read"
  t 'take: a planted say.read link is refused — nothing written through it, and the spool keeps the message' \
    "$(echo '{}' | "$lb/cc-loop" inbox-hook "$sst" 2>/dev/null)|$(cat "$d/victim")|$(jq -r .id "$sst/say.spool")" "|keep|m1"
  t '…and an ack read through it is no ack' "$(say_io acked "$sst" m1 2>/dev/null; echo "rc=$?")" "rc=1"
  rm -f "$sst/loop.pid"; ln -s "$d/victim" "$sst/loop.pid"
  t 'loop.pid: a planted link is never written (rc 2, the file untouched) and never read as a live loop' \
    "$(say_io pidw "$sst" 123 2>/dev/null; echo "rc=$?")|$(cat "$d/victim")|$(say_io live "$sst" 2>/dev/null; echo "rc=$?")" "rc=2|keep|rc=1"
  t '…nor removed through: the loop'"'"'s exit leaves the link and the file it names alone' \
    "$(say_io pidrm "$sst" 123 2>/dev/null; test -L "$sst/loop.pid" && echo link)|$(cat "$d/victim")" "link|keep"
  kill "$sayp" 2>/dev/null; wait "$sayp" 2>/dev/null
  # A TRACK NAME IS MATCHED AS ITSELF (review of #635, finding 17): the old regex read `.` as any character, so a loop
  # for lp/aXb counted as live for lp/a.b. Kept: the member case above. Suppressed: the near name, both ways in.
  sst="$sh/.cc/state/lp/$ab"; mkdir -p "$sst"
  bash -c "sleep 30; : $lb/cc-sandbox member lp $aXb -- cc-loop lp $aXb --max-iter 3" & sayp=$!
  bash -c 'sleep 30; :' "$lb/cc-loop" lp $aXb & x=$!; echo "$x" > "$sst/loop.pid"
  t 'say: a loop for lp/aXb, by its pid or its sandbox command line, is no live loop for lp/a.b — rc 1, nothing spooled' \
    "$(sy $ab hi)|$(test -e "$sst/say.spool" && echo spooled)" "rc=1|"
  kill "$sayp" "$x" 2>/dev/null; wait "$sayp" "$x" 2>/dev/null
  mkdir -p "$lh/.cc/state/lp/sy"; printf '%s\n' '{"at":"2026-09-24T03:00:00Z","from":"planning","text":"use the metadata file"}' > "$lh/.cc/state/lp/sy/say.spool"
  lrun sy '- did one step' 0 --max-iter 1 --no-extend
  sp=$(awk 'p{print; exit} $0=="-p"{p=1}' "$lh/.cc/state/lp/sy/argv")
  t 'a message the last iteration never took opens the next iteration prompt, first' \
    "$sp|$(grep -c 'from planning\] use the metadata file' "$lh/.cc/state/lp/sy/argv")" \
    "# MESSAGES FROM YOUR DISPATCHER (arrived after the last iteration stopped reading — they come first)|1"
  t '…the worker runs with the inbox hook, and the loop.pid it was reachable by is gone once it exits' \
    "$(grep -A1 -x -- --settings "$lh/.cc/state/lp/sy/argv" | tail -1 | jq -r '.hooks.PostToolUse[0].hooks[0].command | test("cc-loop inbox-hook .*/lp/sy$")')|$(test -e "$lh/.cc/state/lp/sy/loop.pid" && echo left)" "true|"
  # A DONE ITERATION THAT ASKED FOR ITS GREEN STILL GETS IT: the kick runs before the DONE branch exits. And the worker
  # was told where to ask.
  mkdir -p "$d/dg" "$lh/.cc/state/lp/dg"; : > "$lh/.cc/state/lp/dg/green.ask"
  printf '#!/bin/sh\necho "$1" >> "%s/dg/calls"\ncase "$1" in start) echo "cc-green: started (pid 1)"; exit 0;;\n  wait) echo "cc-green: the run (pid 1, started 00:00) has ended (exit 0) — log %s/dg/run.log"; exit 0;;\nesac\nexit 1\n' "$d" "$d" > "$d/dg/cc-green"
  chmod +x "$d/dg/cc-green"; lgreen="$d/dg/cc-green" lrun dg 'STATUS: DONE' 0 --max-iter 1 --no-extend; unset lgreen
  t 'an iteration that writes STATUS: DONE and asked for its green gets the run started and waited on before the loop finishes' \
    "$(grep -c '^start$' "$d/dg/calls" 2>/dev/null)|$(grep -c '^wait$' "$d/dg/calls" 2>/dev/null)|$(test -e "$lh/.cc/state/lp/dg/green.ask" && echo left)" "1|1|"
  t '…and the worker ran told where a fenced cc-green start asks' "$(cat "$lh/.cc/state/lp/dg/gask" 2>/dev/null)" "$lh/.cc/state/lp/dg/green.ask"
  lrun dn 'STATUS: DONE' 0 --max-iter 3 --no-extend
  t 'a DONE posts exactly one card' "$(slackn)" 1
  t 'the loop calls cc-notify in three places only — the DONE card, the BLOCKED question, the planner intake — so a \
limit wait, a model fallback or restore, or a reminder has no post of its own' \
    "$(grep -E '^[^#]*"\$BIN/cc-notify" ' "$0" | grep -oE 'done_card|--id "done:|--ask|--decision' | tr '\n' ' ')" '--id "done: --ask --decision '
  t '…into the track thread, by its title, once per PR, with no count and no dollar figure' \
    "$(cut -d'|' -f1-4 "$d/lb.n")|$(grep -c '\$' "$d/lb.n")" "--id|done:lp/dn:pr9|-t|lp/dn done|0"
  # A kind=session row: `cc done` pushes and exits 7 when its READY TO LAND note went to the planner intake — delivered.
  # 7 and nothing else: the t7 shape (guard.sh — a diverged branch and a member-written .cc/pushed) is refused with
  # "cc-checkpoint adopt" and nothing pushed, and that refusal, at 3 or at 1, must stop 4 with no DONE card and never
  # exit 0 (review of #635, findings 1 and 6). FK_DOUT is the line the stub cc done prints.
  local lr="$d/lr"; mkdir -p "$lr"; cp "$lb"/* "$lr/"
  printf '#!/bin/sh\n[ "$1" = done ] || exit 1\necho "${FK_DOUT:-cc: no live planning turn took it; filed as a request}"; exit "$FK_DRC"\n' > "$lr/cc"; chmod +x "$lr/cc"
  drun(){ mkdir -p "$lh/.cc/state/lp/$1" "$lh/.cc/worktrees/lp/$1"; echo "the task" > "$lh/.cc/state/lp/$1/task.md"
    git -C "$lh/.cc/worktrees/lp/$1" init -q; git -C "$lh/.cc/worktrees/lp/$1" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init; : > "$d/lb.n"
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lr/claude" CC_LAND="$lr/cc-land" CC_FAILURES="$d/lr.fl" FK_DRC="$2" FK_DOUT="${3:-}" \
        FK_ST="$lh/.cc/state/lp/$1" FK_LINE='STATUS: DONE' FK_COMMIT=0 "$lr/cc-loop" lp "$1" --max-iter 3 --no-extend ) >/dev/null 2>&1; echo "rc=$?"; }
  t 'a cc done that exits 7 (session row, note filed as a request) is a delivered DONE — loop rc 0, no stop, no second request' \
    "$(drun ds 7)|$(grep -c 'opened no PR' "$lh/.cc/state/lp/ds/loop.log")|$(grep -c '^--ask|' "$d/lb.n")|$(grep -c 'the ready-to-land note was filed as a request' "$lh/.cc/state/lp/ds/loop.log")" "rc=0|0|0|1"
  t '…while a cc done that fails any other way still stops 4, "opened no PR"' \
    "$(drun df 2)|$(grep -c 'cc done failed (rc 2)' "$d/lb.n")" "rc=4|1"
  lease="cc: not pushed — track/lt diverged from its remote and the host holds no lease saying what it last put there, so nothing was forced and nothing overwritten. One way on: 'cc-checkpoint adopt lp lt' says what the remote holds. No PR opened."
  for x in 3 1; do
    t "the t7 shape (diverged branch, member-written .cc/pushed): a lease refusal at rc $x is no DONE — stop 4, no DONE card, never rc 0" \
      "$(drun "lt$x" "$x" "$lease")|$(grep -c "cc done failed (rc $x)" "$d/lb.n")|$(grep -c '^--id|done:' "$d/lb.n")|$(grep -c 'the ready-to-land note was filed' "$lh/.cc/state/lp/lt$x/loop.log")" "rc=4|1|0|0"
  done
  printf '#!/bin/sh\necho "$*" >> "%s/green.n"; echo recorded\n' "$d" > "$lr/cc-green"; chmod +x "$lr/cc-green"   # the ledger write, logged
  t '…and a cc done that exits 6 (session row, the request could not be filed) stops 4 with its ledger entry and one request' \
    "$(drun du 6)|$(grep -c 'cc done failed (rc 6)' "$d/lb.n")|$(grep -c 'the ready-to-land note was filed' "$lh/.cc/state/lp/du/loop.log")|$(grep -c '^red lp worker-loop/done-undelivered loop:lp/du:4:.*rc 6' "$d/green.n")" "rc=4|1|0|1"
  # ── A MEMBER'S DONE, INSIDE ITS BOUNDARY ── no lander is bound in there, so the receipt is `cc done --json`'s own and
  # the host's sweep queues the landing. Its own fixture: a cc-land that answers as the unbound lander did (exit 3, no
  # receipt) and a cc that records its argv. Inside: exit 0, one card naming cc done's PR, the lander never asked.
  # Control, the same fixture on the host: the lander is asked, and its missing receipt is still exit 12.
  printf '#!/bin/sh\necho called >> "%s"\necho "lander: no pinned release at $HOME/.cc/lander/current" >&2\nexit 3\n' "$d/mi.land" > "$lb/landnone"
  printf '#!/bin/sh\nfor a in "$@"; do printf "%%s|" "$a"; done >> "%s"\nprintf "%%s\\n" "{\\"task_id\\":\\"x\\",\\"committed_sha\\":\\"abc\\",\\"pending\\":{},\\"errors\\":[],\\"pr_url\\":\\"https://x/pull/5\\"}"\n' "$d/mi.done" > "$lb/ccdone"
  chmod +x "$lb/landnone" "$lb/ccdone"
  mrun(){ c=$1; mkdir -p "$lh/.cc/state/lp/$c" "$lh/.cc/worktrees/lp/$c"; echo "the task" > "$lh/.cc/state/lp/$c/task.md"; echo '{}' > "$lh/.cc/state/lp/$c/delivery.json"
    git -C "$lh/.cc/worktrees/lp/$c" init -q; git -C "$lh/.cc/worktrees/lp/$c" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
    : > "$d/lb.n"; : > "$d/mi.land"; : > "$d/mi.done"
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/landnone" CC_DONE="$lb/ccdone" CC_FAILURES="$d/lb.fl" \
        FK_ST="$lh/.cc/state/lp/$c" FK_LINE='STATUS: DONE' FK_COMMIT=0 ${2:+CC_MEMBER_SANDBOX=1} "$lb/cc-loop" lp "$c" --max-iter 1 --no-extend ) >/dev/null 2>&1; echo $?; }
  t "inside a member's boundary a DONE completes through cc done --json and exits 0, never asking the lander it cannot see" \
    "$(mrun mi in)|$(cat "$d/mi.done")|$(grep -c . "$d/mi.land")" "0|done|lp|mi|--json||0"
  t '…its one card names the PR cc done opened' "$(cut -d'|' -f1-2 "$d/lb.n")" "--id|done:lp/mi:pr5"
  t '…and its receipt, which names a PR, carries the line saying the host queues the landing' \
    "$(grep '^{' "$lh/.cc/state/lp/mi/loop.log" | jq -r 'select(has("errors")) | .landing.status // "none"' 2>/dev/null | tail -1)" host
  t 'control, on the host: the lander is asked, cc done is not, and no receipt is still exit 12' \
    "$(mrun mh)|$(grep -c . "$d/mi.done")|$(grep -c . "$d/mi.land")" "12|0|1"
  # ── A DONE ON A PEER HOST (CC_PEER_SPOOL set by the hub's launch) ── no lander and no Slack here: the DONE goes to
  # `cc-peer spool land` and the loop exits 0 on its receipt; the lander is never asked and no DONE card is posted.
  printf '#!/bin/sh\nfor a in "$@"; do printf "%%s|" "$a"; done >> "%s"\necho "{\\"task_id\\":\\"lp/pd\\",\\"errors\\":[],\\"pending\\":{\\"landing\\":\\"hub\\"}}"\n' "$d/pd.peer" > "$lb/cc-peer"
  printf '#!/bin/sh\necho called >> "%s"\nexit 1\n' "$d/pd.land" > "$lb/landpd"; chmod +x "$lb/cc-peer" "$lb/landpd"
  mkdir -p "$lh/.cc/state/lp/pd" "$lh/.cc/worktrees/lp/pd"; echo "the task" > "$lh/.cc/state/lp/pd/task.md"
  git -C "$lh/.cc/worktrees/lp/pd" init -q; git -C "$lh/.cc/worktrees/lp/pd" -c user.name=t -c user.email=t@t commit -q --allow-empty -m init
  : > "$d/lb.n"; : > "$d/pd.peer"; : > "$d/pd.land"
  c=$( ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/landpd" CC_FAILURES="$d/lb.fl" CC_PEER_SPOOL="$d/pd.spool" \
        FK_ST="$lh/.cc/state/lp/pd" FK_LINE='STATUS: DONE' FK_COMMIT=0 "$lb/cc-loop" lp pd --max-iter 1 --no-extend ) >/dev/null 2>&1; echo $?)
  t 'peer: a DONE on a host the hub placed it on goes to cc-peer spool land and exits 0, the lander never asked and no DONE card' \
    "$c|$(cat "$d/pd.peer")|$(grep -c . "$d/pd.land")|$(grep -c '^--id|done:' "$d/lb.n")|$(grep -c 'the hub queues the landing' "$lh/.cc/state/lp/pd/loop.log")" \
    "0|spool|land|lp|pd||0|0|1"
  # ── THE REAL `cc done`, INSIDE A MEMBER'S BOUNDARY, WITH NOWHERE TO PUSH ── the case above stubs cc done, and that
  # hid the ending this one pins (review of #965): with no remote the real one took "no remote, no PR", marked the row
  # done, said delivered and exited 0, so the loop exited 0 and nothing reached the queue or the ledger. Its own
  # fixture: real copies of cc, cc-task, cc-checkpoint and cc-board on a scratch HOME; a member workspace with no
  # origin, its track's worktree, a claimed task. Run twice: no remote at all, then one named after the track.
  # Both must stop at exit 4 (a push-stage error), name `cc done` on the host, leave the row undone, open no PR and
  # push nothing to the track-named remote. (`queued` is the status `cc-board add` gives a row; done would be `done`.)
  local rb="$d/rb" rw="$lh/dev/mw" x
  mkdir -p "$rb"; cp "$BIN/cc" "$BIN/cc-task" "$BIN/cc-checkpoint" "$BIN/cc-board" "$rb/"
  for x in cc-config cc-scope cc-trust cc-slack cc-notify cc-room cc-lib tmux cc-gh-token; do printf '#!/bin/sh\nexit 1\n' > "$rb/$x"; done
  printf '#!/bin/sh\necho "$*" >> "%s"\nexit 1\n' "$d/rd.gh" > "$rb/gh"; chmod +x "$rb"/*; : > "$d/rd.gh"
  mkdir -p "$rw/.cc"; : > "$rw/.cc/member-workspace"; printf '/.cc/\n' > "$rw/.gitignore"
  git -C "$rw" init -q -b main; git -C "$rw" add -A; git -C "$rw" -c user.name=t -c user.email=t@t commit -q -m base
  git init -q --bare "$d/rd-track.git"
  rrun(){ c=$1; local w="$lh/.cc/worktrees/mw/$c" s="$lh/.cc/state/mw/$c"
    mkdir -p "$lh/.cc/worktrees/mw" "$s"; git -C "$rw" worktree add -q -b "track/$c" "$w"; echo "the task" > "$s/task.md"
    [ -z "${2:-}" ] || git -C "$rw" remote add "$c" "$d/rd-track.git"
    ( export HOME="$lh" PATH=/usr/bin:/bin; "$rb/cc-board" init mw "$rw" main; "$rb/cc-board" add mw "$c" "$c title" brief
      [ -n "${3:-}" ] || "$rb/cc-task" claim mw "$c" --executor worker ) >/dev/null 2>&1
    : > "$d/lb.n"
    [ -z "${3:-}" ] || { ( cd "$w" && env -i PATH=/usr/bin:/bin HOME="$lh" CC_MEMBER_SANDBOX=1 "$rb/cc" done mw "$c" ) > "$d/rd.out" 2>&1; echo $?; return; }
    ( env -i PATH=/usr/bin:/bin HOME="$lh" CC_CLAUDE="$lb/claude" CC_LAND="$lb/landnone" CC_DONE="$rb/cc" CC_FAILURES="$d/lb.fl" \
        FK_ST="$s" FK_LINE='STATUS: DONE' FK_COMMIT=0 CC_MEMBER_SANDBOX=1 "$lb/cc-loop" mw "$c" --max-iter 1 --no-extend ) >/dev/null 2>&1; echo $?; }
  rcheck(){ local s="$lh/.cc/state/mw/$1"
    printf '%s|%s|%s|%s|%s|%s' "$(grep '^{' "$s/loop.log" | jq -c 'select(type == "object" and has("errors")) | [.pr_url, ([.errors[].stage] | index("push") != null), (.landing == null)]' 2>/dev/null | tail -1)" \
      "$(HOME="$lh" "$rb/cc-board" get mw "$1" status 2>/dev/null)" "$(grep -c 'pr create' "$d/rd.gh")" \
      "$(git --git-dir="$d/rd-track.git" for-each-ref | grep -c .)" "$(grep -c "cc done mw $1 on the host" "$s/loop.log")" "$(grep -c 'no remote, so no PR' "$s/loop.log")"; }
  t "inside a member's boundary the REAL cc done with no remote is undelivered: the loop stops at exit 4, never 0" "$(rrun nr)" 4
  t '…its receipt has no PR, a push-stage error and no landing line, the row is not done, no PR is asked for, and the stop names cc done on the host' \
    "$(rcheck nr)" "[null,true,true]|queued|0|0|1|0"
  t 'the same with only a remote named after the track: exit 4, and nothing is pushed to that remote' "$(rrun tn track)" 4
  t '…the same receipt, the row not done, and the track-named remote untouched' "$(rcheck tn)" "[null,true,true]|queued|0|0|1|0"
  t 'a hand-run cc done inside (no task record) says undelivered and exits 1, and leaves the row as it was' \
    "$(rrun hd '' hand)|$(grep -c 'undelivered, needs the host' "$d/rd.out")|$(HOME="$lh" "$rb/cc-board" get mw hd status 2>/dev/null)" "1|1|queued"
  # ── A STOP'S BOLD LINE IS A SENTENCE ── the row's title and what happened to it, with no colon between two
  # fragments; the four titles that do not read as a verb phrase after a title are said in words instead.
  sh_(){ ( repo=titled track=t1 BOARD="$BIN/cc-board" HOME="$d/bh"; stop_headline "$1" ); }
  t 'a stop heading reads as a sentence rather than "<title>: <slug>"' \
    "$(sh_ 'needs you')" "Worker stop reaches the planner needs you"
  t '…and a bare word that is not a verb phrase is said in words' \
    "$(sh_ waiting)|$(sh_ paused)|$(sh_ errored)" \
    "Worker stop reaches the planner is waiting|Worker stop reaches the planner is paused|Worker stop reaches the planner failed twice in a row"
  t '…and the notice still ROUTES on the untouched title, so the ledger and the thread are unmoved (the --perms resend too)' \
    "$(sed -n '/^stop(){/,/exit "\$code"; }/p' "$0" | grep -cF -- '-t "$repo/$track $title"')/$(sed -n '/^stop(){/,/exit "\$code"; }/p' "$0" | grep -c 'BIN/cc-notify')" 2/2
  # ── THE SHARED DISPATCH TEXT REACHES THE WORKER ── `cc <repo> <track> --go` launches THIS loop's session, and its
  # prompt is built above, not in `cc`, so `cc selfcheck` (which covers the planning, orch and interactive-track
  # variants) cannot see this one. Both halves are asserted: the prompt carries the text, and with the file gone the
  # same test fails — a test that passes either way is matching on nothing.
  dtext=$(cat "$DISPATCH")
  carries(){ case "$1" in *"$dtext"*) echo yes;; *) echo no;; esac; }
  wsp=$(repo=r track=t ST="$d/st"; sp_worker main)
  t 'the worker prompt carries the shared dispatch text' "$(carries "$wsp")" yes
  gone=$(repo=r track=t ST="$d/st" DISPATCH="$d/absent/dispatch-prompt.md"; sp_worker main)
  t 'control: with the shared text gone, the worker prompt fails that same test' "$(carries "$gone")" no
  t '…and the prompt is still built, so a missing file costs the dispatch half and never a worker' \
    "$([ -n "$gone" ] && echo built || echo empty)" built
  # ONE PLACE, NOT FOUR. Four prompt variants, one file: paste it in here and every case above still passes while
  # the next edit to it updates one copy of two. No literal from the file is written below — it is its own pattern.
  t '…and it is said once: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$dtext"; echo "$dup")" no
  # ── AND THE OWNER'S WRITING RULE REACHES THE WORKER ── a worker writes the BLOCKED line he reads, the board note and
  # the journal a handoff is taken from, and `cc selfcheck` cannot see this prompt. A worker that loads ~/CLAUDE.md —
  # on the host, in a worker sandbox and in the owner's own workspace, where cc-sandbox binds it — gets the pointer and
  # never a second copy; a member's boundary binds none, so there it gets the block's first paragraph and guide line.
  # Decided by the file, never by the env: each half on a HOME of its own, a sandbox's env on both, each with its control.
  wtext=$(cat "$WRITING"); wref=$(cat "$WRITING_REF"); wp1=$(awk 'BEGIN{RS=""} NR==1' "$WRITING")
  writes(){ [ -n "$2" ] || { echo no; return; }; case "$1" in *"$2"*) echo yes;; *) echo no;; esac; }
  mkdir -p "$d/wnh"   # no ~/CLAUDE.md in it, as in a member's boundary; $d/wh above has one
  wsp=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; repo=r track=t ST="$d/st" HOME="$d/wh"; sp_worker main)
  t 'a host worker prompt carries the pointer to the writing rule' "$(writes "$wsp" "$wref")" yes
  t '…and not a second copy of the block ~/CLAUDE.md gives it' "$(writes "$wsp" "$wtext")" no
  wgone=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; repo=r track=t ST="$d/st" HOME="$d/wh" WRITING_REF="$d/absent/writing-ref-prompt.md"; sp_worker main)
  t 'control: with the pointer gone, the host worker prompt fails that same test' "$(writes "$wgone" "$wref")" no
  for e in CC_MEMBER_SANDBOX CC_WORKER_SANDBOX; do
    wbs=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; export "$e=1"; repo=r track=t ST="$d/st" HOME="$d/wh"; sp_worker main)
    t "a sandboxed worker ($e) that has ~/CLAUDE.md bound gets the same pointer a seat gets, and not a second copy" "$(writes "$wbs" "$wref"):$(writes "$wbs" "$wtext")" yes:no
    wbx=$(unset CC_WORKER_SANDBOX CC_MEMBER_SANDBOX; export "$e=1"; repo=r track=t ST="$d/st" HOME="$d/wnh"; sp_worker main)
    # shellcheck disable=SC2088  # the literal text the prompt carries, not a path
    t "a worker with no ~/CLAUDE.md ($e) carries the block's first paragraph and its guide line" "$(writes "$wbx" "$wp1"):$(writes "$wbx" '~/WRITING.md')" yes:yes
    t "…and not the pointer to a ~/CLAUDE.md it cannot see ($e)" "$(writes "$wbx" "$wref")" no
  done
  wbg=$(export CC_MEMBER_SANDBOX=1; repo=r track=t ST="$d/st" HOME="$d/wnh" WRITING="$d/absent/writing-prompt.md"; sp_worker main)
  t 'control: with the writing rule gone, the sandboxed worker prompt fails that same test' "$(writes "$wbg" "$wp1")" no
  t '…and the writing rule is said once too: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$wtext"; echo "$dup")" no
  # ── AND THE RULE FOR RAISING A FRAMEWORK PROBLEM REACHES THE WORKER ── same three halves, third time. A worker
  # absorbing what the box cost it is the expensive case: nobody is watching it, so the workaround is all anyone
  # ever sees. `cc selfcheck` covers the other three variants; this prompt is built here, so the cases are here.
  rtext=$(cat "$RAISE")
  raises(){ case "$1" in *"$rtext"*) echo yes;; *) echo no;; esac; }
  t 'the worker prompt carries the rule for raising a framework problem' "$(raises "$wsp")" yes
  rgone=$(repo=r track=t ST="$d/st" RAISE="$d/absent/raise-prompt.md"; sp_worker main)
  t 'control: with the raising rule gone, the worker prompt fails that same test' "$(raises "$rgone")" no
  t '…and the raising rule is said once too: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$rtext"; echo "$dup")" no
  # ── AND THE SPEND RULE REACHES THE WORKER ── same three halves, fourth time, and this is the kind it matters
  # most for: a worker runs unattended in a loop, so an iteration that carries everything, wakes the planner per
  # stage or re-reads its own diff repeats that every iteration with nobody watching the bill.
  ptext=$(cat "$SPEND")
  spends(){ case "$1" in *"$ptext"*) echo yes;; *) echo no;; esac; }
  t 'the worker prompt carries the spend rule' "$(spends "$wsp")" yes
  pgone=$(repo=r track=t ST="$d/st" SPEND="$d/absent/spend-prompt.md"; sp_worker main)
  t 'control: with the spend rule gone, the worker prompt fails that same test' "$(spends "$pgone")" no
  t '…and the spend rule is said once too: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$ptext"; echo "$dup")" no
  # ── AND THE MAIL CAPABILITY REACHES THE WORKER ── same three halves, fifth time. A worker that is not told the
  # box sends mail answers a person's ask in its channel with "I cannot", with the door open behind it.
  mtext=$(cat "$MAIL")
  mails(){ case "$1" in *"$mtext"*) echo yes;; *) echo no;; esac; }
  t 'the worker prompt carries the mail capability' "$(mails "$wsp")" yes
  mgone=$(repo=r track=t ST="$d/st" MAIL="$d/absent/mail-prompt.md"; sp_worker main)
  t 'control: with the mail capability gone, the worker prompt fails that same test' "$(mails "$mgone")" no
  t '…and the mail capability is said once too: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$mtext"; echo "$dup")" no
  # THE READING RULE reaches the worker too: the one session kind that claims — a journal line, a board note, a
  # BLOCKED question — with nobody watching, and the prompt built here is the only one it gets.
  ltext=$(cat "$LIBRARY")
  reads(){ [ -n "$ltext" ] || { echo no; return; }; case "$1" in *"$ltext"*) echo yes;; *) echo no;; esac; }   # an absent rule carries nothing, not everything
  t 'the worker prompt carries the reading rule' "$(reads "$wsp")" yes
  lgone=$(repo=r track=t ST="$d/st" LIBRARY="$d/absent/library-prompt.md"; sp_worker main)
  t 'control: with the reading rule gone, the worker prompt fails that same test' "$(reads "$lgone")" no
  t '…and the reading rule is said once too: no line of it is pasted into this script' \
    "$(dup=no; while IFS= read -r l; do [ ${#l} -ge 40 ] || continue; grep -qF -- "$l" "$0" && dup=yes; done <<<"$ltext"; echo "$dup")" no
  # WHOM TO ASK names the perms session, which only the box's own sessions may ask ("a member workspace may not",
  # ~/COMMS.md): a host worker carries it, a worker inside a member boundary never mentions perms at all.
  atext=$(cat "$ASK")
  case "$wsp" in *"$atext"*) t 'the worker prompt carries whom to ask' yes yes;; *) t 'the worker prompt carries whom to ask' no yes;; esac
  msp=$(repo=r track=t ST="$d/st" CC_MEMBER_SANDBOX=1; sp_worker main)
  case "$msp" in *[Pp]erms*) t 'a worker inside a member boundary is never told to ask perms' yes no;; *) t 'a worker inside a member boundary is never told to ask perms' no no;; esac
  case "$msp" in *"$(cat "$LIBRARY")"*) t '…and it still carries the reading rule' yes yes;; *) t '…and it still carries the reading rule' no yes;; esac
  # A MEMBER'S RECORDS STAY WITH THAT MEMBER: the aggregate a --go worker reads holds every workspace's records, so the
  # prompt says whose they are, on the host and inside a member's boundary, and even with the reading rule's file gone.
  own(){ case "$1" in *'stamped ws=<handle> belongs to that member'*'(ws=owner) are not limited'*) echo yes;; *) echo no;; esac; }
  t "the worker prompt says a member's records stay with that member" "$(own "$wsp")" yes
  t '…inside a member boundary too' "$(own "$msp")" yes
  t '…and with the reading rule gone' "$(own "$lgone")" yes
  # THE JOURNAL BLOCK IS THE CHECKPOINT VIEW, not a byte tail: it starts at an entry, keeps the newest whole ones inside
  # the cap, and its header names how many it left out and the ask that reaches them. The one cut it makes is named.
  # Without cc-lib the tail is what it was — an iteration never starts with no journal at all.
  mkdir -p "$d/jv"; { printf '## 2026-09-10T10:00Z iter 1\nTHE-OLD-ENTRY\n'; for k in $(seq 200); do printf 'a line of the middle entry, number %s\n' "$k"; done | sed '1s/^/## 2026-09-10T11:00Z iter 2\n/'; printf '## 2026-09-10T12:00Z iter 3\nTHE-NEWEST-ENTRY\nSTATUS: DONE\n'; } > "$d/jv/progress.md"
  jb=$(journal_block "$d/jv/progress.md")
  t 'the journal block is the checkpoint view: newest entries whole, latest last, its header naming N of M and the ask for the rest' \
    "$(case "$jb" in "checkpoint view: "*"of 3 entries"*"cc-lib ask --object"*) echo yes;; *) echo no;; esac):$(grep -c 'THE-NEWEST-ENTRY' <<<"$jb"):$(grep -c 'THE-OLD-ENTRY' <<<"$jb"):$(tail -1 <<<"$jb")" 'yes:1:0:STATUS: DONE'
  t '…inside the cap, starting at an entry heading, not mid-line' "$(printf '%s' "$jb" | wc -c | awk -v c="$JOURNAL_CAP" '{print ($1 <= c) ? "yes" : "no"}'):$(sed -n 2p <<<"$jb")" 'yes:## 2026-09-10T11:00Z iter 2'
  mkdir -p "$d/nolib"; jt=$(BIN="$d/nolib" journal_block "$d/jv/progress.md")
  t 'control: with no cc-lib beside this script the block is the byte tail it was, and never empty' \
    "$(case "$jt" in "checkpoint view"*) echo view;; "") echo empty;; *) echo tail;; esac):$(tail -1 <<<"$jt")" 'tail:STATUS: DONE'
  # THE SPEND TIER'S ANSWER IS READ OFF ITS EXIT ALONE: 1 holds, 0 goes, and a cc-tier that cannot answer (absent,
  # crashed) is "go" — the leniency `cc-pause is` has, so a tier nobody can read is never what stops a worker.
  mkdir -p "$d/tbin"; printf '#!/bin/sh\n[ "$3" = r/held ] && exit 1; [ "$3" = r/broken ] && exit 3; exit 0\n' > "$d/tbin/cc-tier"; chmod +x "$d/tbin/cc-tier"
  t 'a row the tier says must wait is held'        "$(BIN="$d/tbin"; tier_hold start r/held && echo held || echo go)"  held
  t 'a row the tier lets through goes'             "$(BIN="$d/tbin"; tier_hold start r/free && echo held || echo go)"  go
  t 'a cc-tier that cannot answer never holds'     "$(BIN="$d/tbin"; tier_hold start r/broken && echo held || echo go)" go
  t 'no cc-tier on the box at all never holds'     "$(BIN="$d/absent"; tier_hold start r/held && echo held || echo go)" go
  sed 's/^/  journal fixture | /' "$d/progress.md"
  # THE SLACK DELIVERABLE (raised-headless-cannot-deliver-to-slack): slack-post.md is posted by the loop at DONE, once,
  # to `thread` (the row's own thread) or the #channel on its first line, a `file:` line going up with the text; a file
  # with neither on line 1 posts nothing; nothing at all posts nothing. The stub cc-slack records its argv.
  mkdir -p "$d/dp"; printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s/dp/calls"; [ "$1" = track-thread ] && { echo C1 1.2; exit 0; }; echo 12.34\n' "$d" > "$d/dp/slack"; chmod +x "$d/dp/slack"
  printf '#proj--t\nthe report is in docs/report.md\nsecond line\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post; deliver_post)
  t 'a #channel on line 1: posted once, to it, as --major, with the text under it' \
    "$(cat "$d/dp/calls" 2>/dev/null)" "post -c #proj--t --major the report is in docs/report.md
second line"
  t '…the file is renamed .sent so a second DONE cannot post it again' "$(n=0; for f in "$d"/dp/slack-post.md*; do [ -e "$f" ] && n=$((n + 1)); done; echo "$n")" 1
  t '…and the journal carries the ts' "$(grep -c 'delivered to #proj--t by cc-loop at DONE (12.34)' "$d/dp/progress.md")" 1
  # `thread` on line 1 = the track's own thread, by the title that routes there (the brief: "into the thread")…
  rm -f "$d/dp/calls" "$d/dp/slack-post.md.sent"; printf 'thread\nthe report is in docs/report.md\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post)
  t '`thread` on line 1 posts by route into the track'"'"'s own thread' "$(cat "$d/dp/calls" 2>/dev/null)" "post --route proj/t done the report is in docs/report.md"
  # …with a file: the thread is looked up and the file goes up WITH the text, one message ("with the file")
  rm -f "$d/dp/calls" "$d/dp/slack-post.md.sent"; printf 'the report\n' > "$d/dp/report.md"; printf 'thread\nfile: report.md\nhere it is\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post)
  t '…and a `file:` line goes up with the text, into that thread, as one message' "$(cat "$d/dp/calls" 2>/dev/null)" "track-thread proj/t
post --file $d/dp/report.md --to C1 --thread 1.2 -m here it is"
  # …a file that is not there: nothing posted, the deliverable stands for the retry (a text without its file is not the deliverable)
  rm -f "$d/dp/calls" "$d/dp/slack-post.md.sent"; printf 'thread\nfile: missing.md\nhere it is\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post)
  t '…a named file that is missing posts nothing and keeps the deliverable' "$([ -e "$d/dp/calls" ] && echo posted || echo no)/$([ -e "$d/dp/slack-post.md" ] && echo kept)" no/kept
  # …a file outside the worktree, absolute or by ../, is refused the same way: the host loop is not behind cc-guard
  printf 'x\n' > "$d/x"
  for p in /etc/passwd ../x; do rm -f "$d/dp/calls"; printf 'thread\nfile: %s\nhere it is\n' "$p" > "$d/dp/slack-post.md"
    (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post)
    t "…a file: outside the worktree ($p) posts nothing and keeps the deliverable" "$([ -e "$d/dp/calls" ] && echo posted || echo no)/$([ -e "$d/dp/slack-post.md" ] && echo kept)" no/kept
    t "…and logs the refusal for $p" "$(tail -1 "$d/dp/log" | grep -c "names file .*$p, which is outside the worktree — not posted, the file stands")" 1; done
  # INSIDE A MEMBER BOUNDARY the same file leaves by the socket's notice door, the file named on it: no token in there
  rm -f "$d/dp/calls" "$d/dp/slack-post.md"; printf 'thread\nfile: report.md\nhere it is\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t CC_MEMBER_SANDBOX=1; deliver_post)
  t 'inside a member boundary the deliverable leaves as `escalate --notice --file`, titled with the track' "$(cat "$d/dp/calls" 2>/dev/null)" "escalate --notice --file $d/dp/report.md -t proj/t done -- here it is"
  rm -f "$d/dp/calls" "$d/dp/slack-post.md.sent"; printf 'no channel here\nsome text\n' > "$d/dp/slack-post.md"
  (ST="$d/dp" LOG="$d/dp/log" CC_SLACK="$d/dp/slack" WT="$d/dp" repo=proj track=t; deliver_post)
  t 'control: a file whose first line is neither `thread` nor a #channel posts nothing and is left where it is' \
    "$([ -e "$d/dp/calls" ] && echo posted || echo no)/$([ -e "$d/dp/slack-post.md" ] && echo kept)" no/kept
  # A STOP THAT IS A FAILURE IS WRITTEN DOWN (stop_record), by kind; a stop that is not (a question, a parked project,
  # a tier hold) writes nothing; and a ledger that cannot be written changes nothing but the line. Each in its own
  # scratch ledger (CC_FAILURES), with the loop's globals set the way stop() sees them.
  mkdir -p "$d/fl"; printf 'loop line 1\nerror (2): boom\n' > "$d/fl/loop.log"
  sr(){ ( export CC_FAILURES="$d/fl/$1"; repo=lp track=t1 LOG="$d/fl/loop.log" i=3 spent=1.5; stop_record "$2" "$3" "$4" ); }
  t 'exit 6 (a --no-extend bound with nothing committed) is recorded as worker-loop/barren-stop'   "$(sr a 6 'paused' 'nothing committed' | cut -c1-8)" recorded
  t '…one record, of that kind, written by cc-loop, keyed to this stop' \
    "$(CC_FAILURES="$d/fl/a" "$BIN/cc-failures" show --json --scope lp | jq -r '[.[] | select(.writer=="cc-loop")] | "\(length) \(.[0].kind) \(.[0].links.exit) \(.[0].links.source | sub(":[0-9]+$";""))"')" \
    "1 worker-loop/barren-stop 6 loop:lp/t1:6"
  t '…with a bounded excerpt of loop.log that outlives the state dir' \
    "$(grep -c 'error (2): boom' "$(CC_FAILURES="$d/fl/a" "$BIN/cc-failures" show --json --scope lp | jq -r '.[0].evidence[] | select(startswith("excerpt:")) | sub("^excerpt:";"")')")" 1
  t 'exit 4 (cc done failed) is worker-loop/done-undelivered'   "$(sr b 4 'finished, but opened no PR' 'x' >/dev/null; CC_FAILURES="$d/fl/b" "$BIN/cc-failures" show --json --scope lp | jq -r '.[0].kind')" worker-loop/done-undelivered
  t 'exit 8 (the limit outlasted the wait) is worker-loop/limit-outlasted-wait' "$(sr c 8 waiting 'x' >/dev/null; CC_FAILURES="$d/fl/c" "$BIN/cc-failures" show --json --scope lp | jq -r '.[0].kind')" worker-loop/limit-outlasted-wait
  t 'exit 3 (the worker asked) is not a failure and writes nothing' "$(sr e 3 waiting 'a question')|$(ls "$d/fl/e" 2>/dev/null | wc -l)" "not a failure (exit 3)|0"
  t 'exit 11 (parked) and 13 (tier) write nothing either' "$(sr f 11 parked x | cut -c1-13),$(sr f 13 tier x | cut -c1-13)|$(ls "$d/fl/f" 2>/dev/null | wc -l)" "not a failure,not a failure|0"
  # THE RESTART LINE: a row whose PR is out for landing is restarted through --repair, any other with a plain --go.
  mkdir -p "$d/ag"; printf '#!/bin/sh\nprintf "%%s" "$AG"\n' > "$d/ag/cc-task"; chmod +x "$d/ag/cc-task"
  ag(){ ( export AG="$1"; BIN="$d/ag" repo=lp track=t1; again ); }
  t 'a delivery-pending stop says --repair; a merged PR, no PR and no record say a plain --go' \
    "$(ag '{"closed":null,"pr":{"url":"u"}}')|$(ag '{"closed":{"status":"merged"},"pr":{"url":"u"}}')|$(ag '{"closed":null,"pr":null}')|$(ag '')" \
    'cc lp t1 --go "" --repair|cc lp t1 --go ""|cc lp t1 --go ""|cc lp t1 --go ""'
  # A MEMBER LOOP'S STOP: inside the boundary nothing is written (the ledger is not there); the host writes it after.
  t 'inside a member boundary stop_record leaves the stop to the host and writes nothing' \
    "$(CC_MEMBER_SANDBOX=1 sr g 12 'no receipt' x | cut -c1-13)|$(ls "$d/fl/g" 2>/dev/null | wc -l)" "left to the h|0"
  mkdir -p "$d/fl/mh/mem/t2"; printf 'MEMBERTEXT error (2): planted\n' > "$d/fl/mh/mem/t2/loop.log"
  # the host's cc done, the broker and the request door are fakes that write down what they were asked (CC_DONE, $d/fl/bin);
  # the ledger is the real cc-green, as above. FD_RC is the fake cc done's exit; $d/fl/seats the live windows.
  mkdir -p "$d/fl/bin"; for f in cc-green cc-failures; do ln -s "$BIN/$f" "$d/fl/bin/$f"; done
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\necho "done: a line"\nexit "${FD_RC:-1}"\n' "$d/fl/done.n" > "$d/fl/bin/fake-cc"
  printf '#!/bin/sh\nprintf "%%s\\n" "$*" >> "%s"\n' "$d/fl/out.n" | tee "$d/fl/bin/cc-broker" > "$d/fl/bin/cc-notify"
  printf '#!/bin/sh\nexit 1\n' | tee "$d/fl/bin/cc-throwaway" > "$d/fl/bin/cc-board"; chmod +x "$d/fl/bin"/*
  ms(){ ( export CC_FAILURES="$d/fl/$1" HOME="$d/fl/mh" CC_DONE="$d/fl/bin/fake-cc"; unset CC_MEMBER_SANDBOX; BIN="$d/fl/bin"
          seat_windows(){ cat "$d/fl/seats" 2>/dev/null; }; member_stop "${@:2}" ); }
  msr(){ : > "$d/fl/done.n"; : > "$d/fl/out.n"; ms "$@" | tail -1; }
  # A MEMBER'S FINISH, DELIVERED BY THE HOST (raised-member-worker-finish-always-needs-the-host). Kept: exit 4 runs the host's
  # cc done itself and, delivered, records nothing and wakes no seat. Reported: a cc done that fails is recorded and told to
  # the workspace's own seat — never a key read from the member's orch file — or filed as a request when no seat is live.
  # Suppressed: an exit that is no delivery (3, asked) runs no cc done.
  printf 'mem@planted\n' > "$d/fl/mh/mem/t2/orch"; printf 'mem\n' > "$d/fl/seats"
  t 'member-stop: exit 4 has the host run cc done itself, and delivered it records nothing and tells no seat' \
    "$(FD_RC=0 msr j mem t2 4 | cut -c1-29)|$(cat "$d/fl/done.n")|$(wc -c < "$d/fl/out.n")|$(ls "$d/fl/j" 2>/dev/null | wc -l)" "delivered by the host: cc don|done mem t2|0|0"
  t '…and cc done exit 7 (pushed, its ready-to-land note filed) is delivered too' "$(FD_RC=7 msr j mem t2 12 | cut -c1-21)" "delivered by the host"
  t '…a host cc done that fails is recorded and told to the workspace seat by its own key, not the member-written one' \
    "$(FD_RC=1 msr k mem t2 4 | cut -c1-53)|$(grep -c '^inject --no-start --source loop mem loop: mem/t2 finished, but opened no PR' "$d/fl/out.n")|$(grep -c planted "$d/fl/out.n")|$(grep -c '^--ask' "$d/fl/out.n")" \
    "failures ledger (mem, recorded by the host): recorded|1|0|0"
  : > "$d/fl/seats"
  t '…and with no live seat it is filed as a request too' "$(FD_RC=1 msr l mem t2 4 >/dev/null; grep -c '^--ask --id stop:mem/t2:' "$d/fl/out.n")" 1
  t '…while an exit that is no delivery runs no cc done' "$(msr m mem t2 3 >/dev/null; wc -c < "$d/fl/done.n")" 0
  # INSIDE, EXIT 4 IS LEFT TO THE HOST: no broker call, no request for the planning seat — the wake-up the host's cc done saves.
  ( ST="$d/st4" BIN="$d/stb" BOARD=true LOG=/dev/null; export CC_MEMBER_SANDBOX=1; mkdir -p "$ST"; : > "$d/st.n"; : > "$d/dt.log"
    log(){ printf '%s\n' "$*" >> "$d/dt.log"; }; eval "$(sed -n '/^stop(){/,/exit "\$code"; }/p' "$0")"
    stop 4 "finished, but opened no PR" "cc done failed: nowhere to push" ) >/dev/null 2>&1
  t 'inside a member boundary stop 4 asks nobody and files nothing: the host finishes it' \
    "$(wc -c < "$d/st.n")|$(grep -c "the stop is the host's" "$d/dt.log")" "0|1"
  # A SIGNAL NEVER ENDS THE LOOP SILENTLY (raised-a-killed-iteration-ends-its-loop-silently). Kept: TERM while an iteration
  # runs aborts that iteration and the loop goes on. Reported: HUP, or TERM between iterations, ends it through stop().
  # Suppressed: the stop() when `cc` holds the track's lock, re-dispatching over this loop.
  mkdir -p "$d/sg"; : > "$d/sg/.lock"
  sg(){ : > "$d/sg.log"; ( log(){ printf '%s\n' "$*" >> "$d/sg.log"; }; kill_child(){ echo killed >> "$d/sg.log"; }; parked(){ return 1; }
        stopped(){ return 1; }; stop(){ echo "stop $1" >> "$d/sg.log"; exit "$1"; }; BOARD=true ST="$d/sg" child="$2" i=2
        eval "$(sed -n '/^redispatching(){/p;/^signalled(){/,/  stop 130 /p' "$0")"; signalled "$1"; echo returned >> "$d/sg.log" ) >/dev/null 2>&1
        echo "rc=$? $(grep -cx killed "$d/sg.log") $(grep -c '^stop 130' "$d/sg.log") $(grep -c returned "$d/sg.log")"; }
  t 'TERM during an iteration kills its claude and the loop goes on' "$(sg TERM 123)|$(grep -c 'the loop goes on' "$d/sg.log")" "rc=0 1 0 1|1"
  t 'TERM between iterations ends the loop, and through stop(), so its dispatcher hears' "$(sg TERM '')" "rc=130 1 1 0"
  t 'HUP (the window closed) during an iteration ends the loop through stop() too' "$(sg HUP 123)" "rc=130 1 1 0"
  exec {sgl}>>"$d/sg/.lock"; flock -x "$sgl"
  t '…but not while cc holds the lock to re-dispatch over it: claude killed, quiet exit, no stop' "$(sg HUP 123)|$(grep -c 're-dispatch is replacing' "$d/sg.log")" "rc=130 1 0 0|1"
  exec {sgl}>&-
  t 'member-stop on the host records exit 12 under the handle, as done-undelivered' "$(msr h mem t2 12 | cut -c1-53)" \
    "failures ledger (mem, recorded by the host): recorded"
  t '…one record, keyed to the host, linking the log and copying none of the member text into it' \
    "$(CC_FAILURES="$d/fl/h" "$BIN/cc-failures" show --json --scope mem | jq -r '"\(length) \(.[0].kind) \(.[0].links.exit) \(.[0].links.track) \(.[0].links["member-log"] | endswith("/mem/t2/loop.log")) \(.[0].links.log == null) \([.[0].evidence[]? | select(startswith("excerpt:"))] | length)"')|$(grep -rc MEMBERTEXT "$d/fl/h" 2>/dev/null | awk -F: '{s+=$2} END {print s+0}')" \
    "1 worker-loop/done-undelivered 12 t2 true true 0|0"
  t 'member-stop: exit 3 (asked) writes nothing; a bad handle or code is refused; inside it does nothing' \
    "$(ms i mem t2 3 | sed 's/.*: //')|$(ms i '../x' t2 12 2>&1 | cut -c1-26)|$(ms i mem t2 x 2>&1 | cut -c1-26)|$(CC_MEMBER_SANDBOX=1 member_stop mem t2 12 2>&1 | cut -c1-27)|$(ls "$d/fl/i" 2>/dev/null | wc -l)" \
    "not a failure (exit 3)|cc-loop member-stop: usage|cc-loop member-stop: usage|cc-loop member-stop: the ho|0"
  mkdir -p "$d/fl/ro"; chmod 500 "$d/fl/ro"
  t 'a ledger that cannot be written is one line, exit 0, and the stop goes on' "$(o=$(sr ro/x 6 paused x); echo "${o:0:12} rc=$?")" "not recorded rc=0"
  chmod 700 "$d/fl/ro"
  # push_host: a head the host could not push is owed to the sweep; a push that lands, or a refused lease, owes nothing.
  # Its own fixture: a one-commit repo for $WT and a stub cc-checkpoint answering the rc in $d/ph/rc.
  mkdir -p "$d/ph/bin" "$d/ph/home"; git init -q "$d/ph/wt"; git -C "$d/ph/wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m one
  printf '#!/usr/bin/env bash\necho "cannot reach origin" >&2\nexit "$(cat %s)"\n' "$d/ph/rc" > "$d/ph/bin/cc-checkpoint"; chmod +x "$d/ph/bin/cc-checkpoint"
  # log() is the main body's, defined after selfcheck runs, so ph brings its own
  ph(){ echo "$1" > "$d/ph/rc"; ( HOME="$d/ph/home" BIN="$d/ph/bin" WT="$d/ph/wt" LOG="$d/ph/log" repo=r track=tk HG=(); log(){ printf '%s\n' "$*" >> "$LOG"; }; push_host 2>/dev/null ); cat "$d/ph/home/.cc/push-owed/r/tk" 2>/dev/null; }
  local phh; phh=$(git -C "$d/ph/wt" rev-parse HEAD)
  t 'push_host: a failed push leaves the head owed to the host sweep, and the log says why' "$(ph 1)|$(grep -c 'failed (rc=1): cannot reach origin' "$d/ph/log")" "$phh|1"
  t '…a push that lands owes nothing' "$(ph 0)" ""
  t '…nor does a refused lease, which --push has already said' "$(ph 1 >/dev/null; ph 2)" ""
  printf '#!/usr/bin/env bash\necho "fatal: unable to access https://x-access-token:SECRETTOK@github.com/o/r.git/" >&2\nexit 1\n' > "$d/ph/bin/cc-checkpoint"
  : > "$d/ph/log"; ph 1 >/dev/null
  t '…and a url in the line it logs loses its token' "$(grep -c SECRETTOK "$d/ph/log")|$(grep -c 'https://github.com/o/r.git' "$d/ph/log")" "0|1"
  rm -rf "$d/ph/home/.cc/push-owed"; : > "$d/ph/log"
  t '…inside a member boundary it neither pushes, logs nor owes' "$(CC_MEMBER_SANDBOX=1 ph 1)|$(wc -c < "$d/ph/log")|$(ls "$d/ph/home/.cc" 2>/dev/null | wc -l)" "|0|0"
  # onto_block: the PR's branch is fetched from the PUSH url onto_pr chose it against. Each case its own repos.
  ob(){   # $1 case dir  $2 1 when the push repo carries dispatch/1042 → the prompt's line|whether origin/dispatch/1042 landed
    local c="$d/ob/$1"; mkdir -p "$c/bin"; printf '#!/bin/sh\necho "dispatch/1042 https://github.com/o/d/pull/7"\n' > "$c/bin/cc"
    printf '#!/bin/sh\n' > "$c/bin/cc-gh-token"; chmod +x "$c/bin/cc" "$c/bin/cc-gh-token"
    git init -q --bare "$c/up.git"; git init -q --bare "$c/push.git"; git init -q "$c/wt"
    git -C "$c/wt" -c user.name=t -c user.email=t@t commit -q --allow-empty -m base
    [ "$2" = 1 ] && git -C "$c/wt" push -q "$c/push.git" HEAD:refs/heads/dispatch/1042
    printf '[remote "origin"]\n\turl = %s\n\tpushurl = %s\n' "$c/up.git" "$c/push.git" >> "$c/wt/.git/config"
    ( BIN="$c/bin"; WT="$c/wt"; repo=r; track=t; onto_block ) | grep -o 'build your commits on origin/dispatch/1042\|could not fetch that branch'
    git -C "$c/wt" rev-parse -q --verify refs/remotes/origin/dispatch/1042 >/dev/null && echo fetched || echo none; }
  t 'onto_block fetches the PR branch from the push repo, though origin fetches from another' "$(ob push 1 | paste -sd'|' -)" "build your commits on origin/dispatch/1042|fetched"
  t '…and a branch it cannot fetch tells the worker to block, never to build on a missing ref' "$(ob nofetch 0 | paste -sd'|' -)" "could not fetch that branch|none"
  # issue_block: what task.md names is fetched on the host into the state dir. Its own fake gh, repo and task.md.
  c="$d/ib"; mkdir -p "$c/bin" "$c/st"; git init -q "$c/wt"; git -C "$c/wt" remote add origin https://github.com/o/r.git
  printf '#!/bin/sh\necho "$*" >> %s/gh.log\ncase "$2" in repos/o/r/issues/12) echo "# T12";; repos/o/r/issues/12/comments) echo "## c1";; *) exit 1;; esac\n' "$c" > "$c/bin/gh"; chmod +x "$c/bin/gh"
  printf 'Fix #12, see https://github.com/x/y/pull/3 and #12 again.\n<!-- cc-brief:inflight -->\n#99\n<!-- /cc-brief:inflight -->\n' > "$c/st/task.md"
  ib=$(PATH="$c/bin:$PATH" ST="$c/st" WT="$c/wt" issue_block)
  t 'issue_block saves a named issue with its comments and names the file to the worker' \
    "$(cat "$c/st/github/o_r_12.md" | paste -sd'|' -)|$(grep -c "host saved .*$c/st/github/o_r_12.md\." <<<"$ib")" "# T12|## c1|1"
  t '…names what it could not fetch, and never reads the board'"'"'s inflight block' \
    "$(grep -o 'could not fetch x/y#3,' <<<"$ib")|$(grep -c '/99' "$c/gh.log")|$(ls "$c/st/github")" "could not fetch x/y#3,|0|o_r_12.md"
  c="$d/ib0"; mkdir -p "$c/bin" "$c/st"; git init -q "$c/wt"; printf '#!/bin/sh\necho "$*" >> %s/gh.log\n' "$c" > "$c/bin/gh"; chmod +x "$c/bin/gh"
  printf 'No issue here, only a colour &#35;12 and path a/#3.\n' > "$c/st/task.md"
  t '…and a brief naming none asks GitHub nothing and adds nothing to the prompt' \
    "$(PATH="$c/bin:$PATH" ST="$c/st" WT="$c/wt" issue_block | wc -c)|$(cat "$c/gh.log" 2>/dev/null | wc -l)|$([ -e "$c/st/github" ] && echo dir)" "0|0|"
  rm -rf "$d"
  printf 'cc-loop selfcheck: %s passed, %s failed\n' "$((n - bad))" "$bad"
  [ "$bad" = 0 ]; }
[ "${1:-}" = selfcheck ] && { selfcheck; exit $?; }
[ "${1:-}" = worker-model ] && { worker_model "${2:-}"; exit 0; }   # cc asks this to name the model on its dispatch line
[ "${1:-}" = context-report ] && { context_report "${@:2}"; exit $?; }
[ "${1:-}" = say ] && { say_send "${2:?repo}" "${3:?track}" "${4:?text}"; exit $?; }   # cc … --say, at a headless worker (see SAY_WAIT)
[ "${1:-}" = inbox-hook ] && inbox_hook "${2:?state dir}"   # the worker's PostToolUse hook: exits 0 always
[ "${1:-}" = member-stop ] && { member_stop "${@:2}"; exit 0; }   # cc runs it on the host after a member's boundary exits
repo="${1:?repo}"; track="${2:?track}"; shift 2
MAXI=10; BUDGET=8; TURNS=""; MODEL=""; EFFORT="${CC_WORKER_EFFORT:-medium}"; QUIET=0; RESUME=0   # an opus-class worker spends ~$2/iteration: a $2 cap truncated real work mid-turn
while [ $# -gt 0 ]; do case "$1" in
  --once) MAXI=1; NOEXT=1;; --max-iter) MAXI="$2"; shift;; --budget) BUDGET="$2"; shift;; --turns) TURNS="$2"; shift;;
  --model) MODEL="$2"; shift;; --effort) EFFORT="$2"; shift;; --quiet) QUIET=1;; --resume-last) RESUME=1;; --no-extend) NOEXT=1;;
  *) echo "cc-loop: unknown arg $1" >&2; exit 2;; esac; shift; done
[[ "$MAXI" =~ ^[0-9]+$ ]] && [ "$MAXI" -ge 1 ] || { echo "cc-loop: --max-iter must be a positive integer (got '$MAXI')" >&2; exit 2; }
[[ "$BUDGET" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "cc-loop: --budget must be a plain number in USD (got '$BUDGET')" >&2; exit 2; }   # `1e9` is not $8
[ -z "$TURNS" ] || [[ "$TURNS" =~ ^[1-9][0-9]*$ ]] || { echo "cc-loop: --turns must be a positive integer (got '$TURNS')" >&2; exit 2; }
BATCH="$MAXI"; RUNN="${CC_LOOP_RUNAWAY_N:-3}"; RUNX="${CC_LOOP_RUNAWAY_X:-5}"   # the checkpoint's stride; the runaway notice's two dials
HUNG="${CC_LOOP_HUNG_SECS:-1800}"; HPOLL="${CC_LOOP_HUNG_POLL:-60}"   # silence that means hung, and how often it is looked at (hung_watch)
if [ -f "$HOME/dev/$repo/.cc/member-workspace" ] && [ "${CC_MEMBER_SANDBOX:-}" != 1 ]; then   # depth behind the boundary: cc puts a member worker inside cc-sandbox member, so a bare cc-loop here is a loop that escaped it
  echo "cc-loop: $repo is a member workspace — its workers run inside the boundary (member-sandbox) or not at all" >&2; exit 2
fi
if "$BIN/cc-pause" is "$repo" 2>/dev/null; then   # the whole project is parked: a worker for it is the first thing that must not start
  echo "cc-loop: $repo is paused — \`cc-pause off $repo\` starts its workers again" >&2; exit 2
fi
if tier_hold start "$repo/$track"; then   # the box-wide spend tier (cc-tier): under stop nothing starts; under essential only a row marked critical, one at a time
  echo "cc-loop: $("$BIN/cc-tier" line) — $repo/$track waits: $("$BIN/cc-tier" allows start "$repo/$track" 2>&1 >/dev/null)" >&2; exit 2
fi
ST="$HOME/.cc/state/$repo/$track"; WT="$HOME/.cc/worktrees/$repo/$track"; BOARD="$BIN/cc-board"; CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"
# Host-side git on the worktree (the checkpoint, its push, cc done) runs the MAIN checkout's hooks, never the worktree's: with a
# relative core.hooksPath (core/.githooks) a hook is a tracked file the worker edits, and this loop would run it with the host's
# credentials, tmux and docker group — the very things the sandbox removes. Scoped to those calls, not exported: the worker's
# own environment stays exactly what it was (cc-sandbox promises that byte for byte when it is off).
hp=$(git -C "$HOME/dev/$repo" config --type=path --get core.hooksPath 2>/dev/null); case "$hp" in "") hp="$HOME/dev/$repo/.git/hooks";; /*) ;; *) hp="$HOME/dev/$repo/$hp";; esac
HG=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp")
mkdir -p "$ST/runs"; [ -s "$ST/task.md" ] || { echo "cc-loop: no task at $ST/task.md (use: cc $repo $track --go \"...\")" >&2; exit 2; }
[ -d "$WT" ] || { echo "cc-loop: no worktree $WT (run: cc $repo $track)" >&2; exit 2; }
touch "$ST/progress.md"; LOG="$ST/loop.log"; SNAP="$ST/.progress.snap"
log(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
if closed=$(row_closed); then   # read before anything is recorded, charged or posted: the row is not touched again
  "$BOARD" note "$repo" "$track" "loop exit 0: the row was already $closed when its launch started; nothing ran" >/dev/null 2>&1
  log "exit 0: $repo/$track is already $closed on the board — not starting it"; exit 0; fi
orch_record; dispatch_receipt; unset CC_SLACK_ALIAS CC_ORCH_REPO CC_DISPATCH_WIN   # who dispatched this loop, for stop(); the worker's own environment does not carry it
pw=$(say_io pidw "$ST" $$ 2>&1) || log "loop.pid not written — ${pw#cc-loop: }; \`cc $repo $track --say\` cannot find this loop"   # loop_live: --say reaches it while it runs
trap 'say_io pidrm "$ST" $$' EXIT   # only a loop.pid that is still this loop's, and never through a link (say_io)
[ -e "$ST/stop" ] && { rm -f "$ST/stop"; log "a stop file from before this dispatch was cleared — re-dispatching overrides it"; }
set -m   # each iteration runs in its own process group, so one kill takes claude AND everything it spawned
child=""
kill_child(){ [ -n "$child" ] || return 0   # only ever signal a group we own: if the child is not a group leader, kill just it
  if [ "$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')" = "$child" ]; then kill -TERM -- -"$child" 2>/dev/null; sleep 2; kill -KILL -- -"$child" 2>/dev/null
  else kill -TERM "$child" 2>/dev/null; fi; }
# A SIGNAL ENDS AN ITERATION OR THE LOOP, AND NEVER SILENTLY (raised-a-killed-iteration-ends-its-loop-silently: a kill
# aimed at a stuck claude took the loop with it, exit 130, and nobody was told). TERM while an iteration runs is a kill
# of that iteration: its claude goes, and the loop goes on, counting it as a failed iteration (two in a row is stop 5,
# with word). HUP (the window closed), INT (Ctrl-C at the window), or any signal between iterations ends the loop, and
# the dispatcher hears it through stop() — unless `cc` holds the track's lock, which it does only while it kills this
# window to start the loop that replaces it: that seat knows, and a stop now would write `blocked` over its `running`.
# The project pause and the stop file stay what they were (parked, stopped). tmux kill-window would otherwise re-parent
# claude to systemd, still editing this worktree, so the child is killed first in every case.
redispatching(){ [ -f "$ST/.lock" ] && [ ! -L "$ST/.lock" ] && ! flock -n -s 8 8<"$ST/.lock"; }   # a read-only open of a plain file: nothing is created or written through a link
signalled(){ local s="$1" had="$child"; redispatching && { kill_child; log "signalled ($s) — a re-dispatch is replacing this loop; its claude killed"; exit 130; }
  kill_child; parked
  if [ "$s" = TERM ] && [ -n "$had" ]; then
    log "signalled (TERM) — iteration ${i:-?} aborted and its claude killed; the loop goes on"
    "$BOARD" note "$repo" "$track" "iteration ${i:-?} was killed (TERM); the loop goes on" >/dev/null 2>&1; return 0; fi
  stopped || :; trap '' HUP INT TERM   # one ending: a second signal does not start a second stop()
  stop 130 "was stopped" "The loop was signalled ($s) during iteration ${i:-0} and has ended; its claude was killed. To start it again: $(again)"; }
trap 'signalled HUP' HUP; trap 'signalled INT' INT; trap 'signalled TERM' TERM
# HUNG, NOT LONG (the header): beside each iteration, look at its transcript every HPOLL seconds, and kill the
# iteration (kill_child, the same group kill a signal uses) only once nothing under its project dir has grown for
# HUNG seconds (find -H follows the dir when it is a symlink, and no link a worker plants under it). The dir
# is claude's own for the worktree (every non-alphanumeric a dash, as cc-spend reads it), which
# cc-sandbox binds from the host's, so the loop sees what the fenced claude writes. A dir that never appeared is not
# read as silence: the loop cannot see this claude's transcript, so it says so once and kills nothing.
hung_watch(){   # $1 the file that says it was killed as hung (the seconds of silence) · $2 where "cannot see" is said once
  local m="$1.mark" n="$1.new" last now pd
  pd="$HOME/.claude/projects/$(realpath "$WT" | sed 's/[^A-Za-z0-9]/-/g')"
  touch "$m"; last=$(date +%s)
  while sleep "$HPOLL"; do
    kill -0 "$child" 2>/dev/null || break
    touch "$n"; now=$(date +%s)
    if [ -n "$(find -H "$pd" -name '*.jsonl' -newer "$m" -print -quit 2>/dev/null)" ]; then mv -f "$n" "$m"; last=$now
    elif [ $((now - last)) -lt "$HUNG" ]; then :
    elif [ ! -d "$pd" ]; then [ -e "$2" ] || { : > "$2"; log "iter ${i:-?}: the hung check cannot see a transcript at $pd, so it kills nothing"; }
    else echo "$((now - last))" > "$1"; kill_child; break; fi
  done; rm -f "$m" "$n"; }
stop(){ local code="$1" title="$2" msg="$3" st="${4:-blocked}" said="${5:-}" heard=no esc="" bid="" tg=""   # every non-zero exit leaves the board honest: a track nobody is working on is not "running"
  # …and `waiting` when it stopped to ASK, which is not the same thing as stopping. The loop is the first to know, so it
  # writes the same word cc-reconcile would 20 min later — otherwise the board says `blocked` while the Home tab, reading
  # the very journal line this exit came from, already says `waiting`, and the tab prints the two of them as drift.
  "$BOARD" status "$repo" "$track" "$st" >/dev/null 2>&1; "$BOARD" note "$repo" "$track" "loop exit $code: $msg" >/dev/null 2>&1
  log "exit $code: $msg"
  if throwaway; then log "throwaway repo: no ledger record, no seat, nothing posted"; exit "$code"; fi   # see throwaway()
  log "failures ledger ($repo): $(stop_record "$code" "$title" "$msg")"   # the tool that saw it writes it down; the exit is decided already
  if [ "$code" = 4 ] && inside_boundary; then   # the host finishes it: member_stop runs cc done there, and tells this seat only if that fails
    log "the stop is the host's: when the boundary exits it runs cc done $repo $track, and tells $repo's seat only if that fails"; exit "$code"; fi
  # A WORKER'S QUESTION ($5) is asked ONCE, under an id stable for that question at that commit, so a relaunch that stops
  # on it again does not ask twice. The seat tries first: its line carries the exact card to raise if only the owner can
  # settle it. Until 2026-10 the loop posted the question itself, unmentioned on #<repo>, and most went unanswered.
  [ -z "$said" ] || { bid="blocked:$repo/$track:$(git -C "${WT:-.}" rev-parse --short HEAD 2>/dev/null):$(printf '%s' "$said" | cksum | cut -d' ' -f1)"
    esc=" — only the owner can settle it? cc-notify --decision --id $bid -t \"$repo/$track $title\" \"<the question>\""; }
  # THE BOARD IS WRITTEN FIRST, whatever the broker does after it: a stop that reached nobody is filed as a request.
  # cc-broker's rc 0 is "sent", not "heard" (done_heard): a stop sent to a key with no live seat is unheard too (`dead`).
  tg=$(stop_target)
  if tell_planner "$(planner_line "$title" "$msg$esc")"; then heard=dead; target_live "$tg" && heard=sent; fi
  # A seat that took it owns it, and nothing is posted: its line tells it to settle the question, or to ask the owner
  # itself with the --decision card it carries (comms audit 2026-10-01, change 6: demo-video-skill's "may the two
  # checks move from host to hermetic?" reached the owner as "needs you" on 09-30, a question the seat had settled
  # within minutes). Nobody took it: a question becomes the owner's decision card (cc-notify --decision: 🔒 @owner on
  # #<repo>, or a control-seat request when this caller lacks that authority); any other stop is filed as a planner
  # request, and the log line says where it went (stop_route).
  if [ "$heard" = sent ] || [ -z "$said" ]; then log "$(stop_route "$heard" "$title" "$msg")"
  # A QUESTION THAT READS LIKE A PERMISSION ONE ("the classifier refused my push") is refused by cc-notify's word gate,
  # exit 2 and nothing posted (review of #904 at ce990bc0: such a question vanished). It belongs to the permission
  # session anyway, so it is sent again with --perms, and the log says that is where it went.
  else local r=no rc=0 how="a decision card"; "$BIN/cc-notify" --decision --id "$bid" -t "$repo/$track $title" "$(row_title): $said" || rc=$?
    if [ "$rc" = 0 ]; then r=yes
    elif [ "$rc" = 2 ]; then how="a permission question (it read like one, so the owner's card was refused)"
      "$BIN/cc-notify" --perms --id "$bid" -t "$repo/$track $title" "$(row_title): $said" && r=yes; fi
    log "the stop went to $tg's session: no$([ "$heard" = dead ] && printf ' (the broker took it, but no session is live there, so nobody has heard it)') — its question went out as $how: $r"; fi
  exit "$code"; }
# THE PROJECT PAUSE. `cc-pause on <repo>` parks a whole project; what it does to a loop that is ALREADY RUNNING is
# signal it, so this is read from the TERM trap and again at the top of every iteration — the flag can appear at any
# moment. Standing down leaves the board honest (`queued`: there is work here and nobody is on it) and does NOT page:
# the owner parked this himself, and telling him what he just did is noise. Nothing is lost — the worktree, the
# journal and the board row are all where they were, and `cc-pause off` re-dispatches this very loop.
parked(){ "$BIN/cc-pause" is "$repo" 2>/dev/null || return 1
  "$BOARD" status "$repo" "$track" queued >/dev/null 2>&1
  "$BOARD" note "$repo" "$track" "loop exit 11: project paused — cc-pause off $repo restarts it" >/dev/null 2>&1
  log "exit 11: $repo is paused — standing down; nothing more spends here until cc-pause off $repo"; exit 11; }
# THE STOP FILE, read at the same boundary: "a stop file written mid-run ends the loop before its next model call, and
# its budget is not spent" (the brief). The file is the whole verb — no kill, no signal, nothing mid-iteration.
stopped(){ [ -e "$ST/stop" ] || return 1
  local why; why=$(head -c 200 "$ST/stop" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//'); rm -f "$ST/stop"
  "$BOARD" status "$repo" "$track" blocked >/dev/null 2>&1
  "$BOARD" note "$repo" "$track" "loop exit 14: stopped by $ST/stop after iteration $i${why:+ — $why}; $(again) resumes it" >/dev/null 2>&1
  printf -- '- cc-loop: stopped by %s after iteration %s%s\n' "$ST/stop" "$i" "${why:+ — $why}" >> "$ST/progress.md"
  log "exit 14: stopped by $ST/stop after iteration $i${why:+ — $why} (\$$spent); $(again) resumes it"; exit 14; }
# THE SPEND TIER, the same way but box-wide and only at the iteration boundary: `cc-tier set` signals nothing, so
# the iteration in flight finishes and the NEXT one asks `cc-tier allows continue` before anything is charged. Under
# stop no worker goes on; under essential only a row marked critical does. Standing down leaves the board honest
# (`queued`) and does not page — the owner set the tier himself. `cc <repo> <track> --go ""` re-dispatches it.
tiered(){ [ "$i" -gt 0 ] || return 1   # iteration 1 was let through by the start check above; this is the next ones
  tier_hold continue "$repo/$track" || return 1
  "$BOARD" status "$repo" "$track" queued >/dev/null 2>&1
  "$BOARD" note "$repo" "$track" "loop exit 13: $("$BIN/cc-tier" line) — a wider tier, or critical=yes on this row, re-dispatches it" >/dev/null 2>&1
  log "exit 13: $("$BIN/cc-tier" line) — standing down after iteration $i; $(again) resumes it"; exit 13; }
# THE WORKERS' LOGIN (WORKER_CLAUDE_CREDENTIALS, cc-sandbox's WORKERS' LOGIN): its usage limit is that account's, not the
# box's. So the stamp and the unavailable-model record are its own, and the wait-then-exit-8 below handles it the same way
# without making the box's sessions wait on it. But the key being set does not mean the worker runs on it: cc-sandbox
# falls back to the box's login when that file is missing, expired, signed out or refused. So every iteration asks
# cc-sandbox which login its launch will use (`worker-cred`, the same checks and refresh, its line dropped here because
# the launch prints it) and keys the stamp and the record to that answer. Asked per iteration, not once, because an hour
# is long enough for that login to sign out or come back. The box's values are what the loop started with.
LS0="${CC_LIMIT_STAMP:-}" MC0="${CC_MODEL_CRED:-}"
worker_account(){
  local c=""
  if ! inside_boundary && [ -n "$("$BIN/cc-config" get WORKER_CLAUDE_CREDENTIALS 2>/dev/null)" ]; then
    c=$("$BIN/cc-sandbox" worker-cred 2>/dev/null); fi
  if [ -n "$c" ] && [ "$c" != "$HOME/.claude/.credentials.json" ]; then
    export CC_LIMIT_STAMP="${LS0:-$HOME/.cc/state/claude-limit}.workers" CC_MODEL_CRED=workers; return; fi
  if [ -n "$LS0" ]; then export CC_LIMIT_STAMP="$LS0"; else unset CC_LIMIT_STAMP; fi
  if [ -n "$MC0" ]; then export CC_MODEL_CRED="$MC0"; else unset CC_MODEL_CRED; fi; }
base=$(worker_base "$repo")
SP=$(sp_worker "$base") || stop 2 "no worker prompt" "cc-loop cannot read the worker prompt at $WORKER_PROMPT, so no worker starts"
# NO FENCE, NO WORKER. The fence (cc-sandbox) is on for every worker and has no host fallback, so a box where it cannot
# start stops here, before iteration 1, with its reason on the board and to the dispatcher — not as an hour of failed
# iterations. `probe` also passes where the fence is off by the owner's switch or behind a member boundary.
fw=$("$BIN/cc-sandbox" probe 2>&1) || stop 2 "cannot get the fence" "the worker sandbox cannot start on this box, so no worker does: ${fw:-cc-sandbox probe gave no reason}"
"$BOARD" status "$repo" "$track" running >/dev/null 2>&1 || true
# WORKERS YIELD TO LANDINGS (2026-10-21: a worker's 16 python3 hogs ran 30 min beside every landing check as equals).
# Each iteration's claude starts in a transient user scope of its own in worker.slice, which sits beside app.slice
# (the sessions) and lander.slice (every lander check, cc-green's included) and has CPUWeight and IOWeight
# WORKER_WEIGHT. A weight only ranks siblings, so it is set on the slice: a scope at 20 inside app.slice still got
# app.slice's equal share against lander.slice (lander review of #1816). No dash in the name, since systemd reads a
# dash as nesting (cc-worker.slice would sit in cc.slice, at 100). A cgroup holds every child, setsid and double fork
# included, and none can leave it without the user bus, which the fence hides; nice would not hold, because nice ranks
# only within one cgroup, and it is inherited into the cc-green run an unfenced worker starts. A weight caps nothing:
# alone on the box a worker gets all of it. The slice's weight is a runtime drop-in (set-property --runtime), gone at
# the user manager's restart, so wscope sets it again at every launch rather than once. cc-green's ask (green_kick)
# is started by this loop, outside the scope.
# wscope probes at each launch, so a bus gone mid-run costs no iteration. Where no scope can be had (no user bus, the
# probe or the weight refused, or CC_WORKER_SCOPE=0), claude still runs, but at nice 19 and best-effort IO priority 7
# (not the idle class, which can starve it) inside the loop's own cgroup, and loop.log says why with a WARNING, so no
# path runs a worker at the landing checks' weight. That fallback is weaker than the slice: nice ranks only within one
# cgroup, so it yields to the sessions beside it but not to lander.slice. The probe must see its command run, so a
# fixture's systemd-run stub that only records a start (e2e
# step-limit) is no bus (2026-10-21: it swallowed claude). The unit name carries a per-launch nonce, since a
# usage-limit rerun keeps $i and a scope the last run left behind would refuse the name. If systemd-run still fails
# after a good probe, the scope's first act is to write $out.go, so a failure with no .go never started claude, and the
# same iteration runs it in the nice fallback; a claude that started is never run twice.
# Brief: "everything a worker loop starts ... runs at a lower CPU and IO weight than the lander's lanes and checks".
WORKER_WEIGHT=20
wscope(){ local why
  if [ "${CC_WORKER_SCOPE:-1}" != 1 ]; then why="CC_WORKER_SCOPE=0"
  elif [ "$(timeout 10 systemd-run --user --scope --quiet --collect --slice=worker.slice -- echo ok </dev/null 2>/dev/null)" != ok ]; then why="no user systemd bus"
  elif ! timeout 10 systemctl --user set-property --runtime worker.slice "CPUWeight=$WORKER_WEIGHT" "IOWeight=$WORKER_WEIGHT" </dev/null >/dev/null 2>&1; then why="worker.slice refused its weight"
  else SCOPE=(systemd-run --user --scope --quiet --collect --slice=worker.slice --unit="cc-worker-$repo-$track-$$-$i-$RANDOM$RANDOM" -- sh -c ': > "$0" && exec "$@"' "$out.go"); return; fi
  wnice "$why"; }
wnice(){ SCOPE=(nice -n 19 ionice -c 2 -n 7)
  log "WARNING: worker runs unscoped ($1), at nice 19 and best-effort IO 7 in the loop's own cgroup, which does not rank it below lander.slice"; }
i=0; errs=0; spent=0
barren=0; nocommit=0; sincecost=0; cn=0; ccost=0; prevsig=""   # the runaway notice's memory: this track measured against itself
lastm=""; lastwhy=""; lastasked=""   # what the previous iteration ran on, the outage that had moved it there
                       # ("" = none), and the model it was DISPATCHED on. ALL THREE are the memory this needs: a model
                       # change alone does not say which way it went, and an outage remembered alone does not say the
                       # loop came BACK — see model_change_note, where each in turn put a false lift line in the next
                       # prompt (reviews of #503).
overruled=0   # a BLOCKED-on-the-view line this loop already answered with its own pushed head: once per run, then it stops as usual
chainend=0   # the end of the cc-model chain is journalled once per loop, not once per iteration
while [ $i -lt "$MAXI" ]; do
  parked   # read before the limit stamp and before anything is charged: a project paused mid-run stops at this line
  stopped  # …the stop file, written by a person or a session while the last iteration ran
  tiered   # …and the spend tier the same way, for iteration 2 onwards
  worker_account   # whose login this launch runs on, before its limit stamp and its model are read (above, at worker_account)
  if p=$("$BIN/cc-limit" status 2>/dev/null); then log "$p — waiting before starting (another run hit it)"   # a stamp any run on this box set
    hm=$(sed -n 's/.*until \([0-9][0-9]:[0-9][0-9]\)Z.*/\1/p' <<<"$p")   # status speaks UTC; a person reads local time
    at=$([ -n "$hm" ] && "$BIN/cc-time" slack "$(date -u +%Y-%m-%d)T$hm:00Z" 2>/dev/null || echo "${hm:-later}${hm:+Z}")
    "$BIN/cc-limit" wait || stop 8 "waiting" "The Claude usage limit lasts until $at, which is longer than the loop waits. To start it again: $(again)"
    parked; stopped; fi   # that wait can be hours: a pause or a stop file written during it is read before anything is charged (review of #541)
  i=$((i+1)); before_head=$(git -C "$WT" rev-parse HEAD 2>/dev/null); before_prog=$(md5sum "$ST/progress.md" | cut -c1-8); cp "$ST/progress.md" "$SNAP"
  of=""; [ "${NOEXT:-0}" = 1 ] && of=" of $MAXI"   # only a caller's bound is a last iteration; a checkpoint is not
  prompt=$(printf '# TASK\n%s\n\n# PROGRESS JOURNAL (latest last)\n%s\n\n# THIS ITERATION\nContinue from the journal. Do the next step. Journal it early, not at the end. Iteration %s%s.\n' "$(cat "$ST/task.md")" "$(journal_block "$ST/progress.md")" "$i" "$of")
  if said=$(say_take "$ST"); then prompt=$(printf '# MESSAGES FROM YOUR DISPATCHER (arrived after the last iteration stopped reading — they come first)\n%s\n\n%s' "$said" "$prompt"); log "iter $i opens with the message(s) sent while the last one ran"; fi
  hook=$(jq -cn --arg c "$BIN/cc-loop inbox-hook $ST" '{hooks: {PostToolUse: [{hooks: [{type: "command", command: $c}]}]}}')   # a message sent mid-iteration reaches the turn (SAY_WAIT)
  args=(-p "$prompt" --permission-mode auto --max-budget-usd "$BUDGET" --output-format json --append-system-prompt "$SP" --settings "$hook")
  [ -n "$TURNS" ] && args+=(--max-turns "$TURNS")   # a caller's own limit only: none by default (owner 10-20, no count caps on calls)
  m=$(worker_model "$MODEL")   # resolved every iteration, not pinned at dispatch: an outage mid-loop moves this worker down, and its lift moves it back
  asked=$(worker_model "$MODEL" asked); why=$(model_outage_why "$m" "$asked")   # both read every iteration (see there)
  note=$(model_change_note "$i" "$m" "$asked" "$lastm" "$lastwhy" "$why" "$lastasked")   # $() ate its newline; printf puts it back
  if [ -n "$note" ]; then log "${note#- cc-loop: }"; printf '%s\n' "$note" >> "$ST/progress.md"; fi
  lastm="$m"; lastwhy="$why"; lastasked="$asked"
  [ -n "$m" ] && args+=(--model "$m"); [ -n "$EFFORT" ] && args+=(--effort "$EFFORT")
  # --resume-last, first iteration only: continue the session this track last ran instead of opening a cold one.
  # A repair round is the case it exists for — the worker already read this code and
  # paid for it, and a fresh context re-derives all of it before it can change one line. Iteration 2 onwards is
  # deliberately NOT resumed: this loop's own contract is a fresh context per step, and the journal is the handover.
  if [ "$RESUME" = 1 ] && [ "$i" = 1 ]; then
    if sid=$(last_session "$ST/runs"); then args+=(--resume "$sid"); log "iter 1 resumes session $sid (--resume-last)"
    else log "iter 1 was asked to resume, but no run of this track recorded a session id — starting fresh"; fi
  fi
  TRIMENV=(); tb=$(trim_body); [ -n "$tb" ] && TRIMENV=("CLAUDE_CODE_EXTRA_BODY=$tb")   # empty unless CC_LOOP_TRIM is on: the child's environment is otherwise exactly what it always was
  BGENV=(); [ -z "${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS+x}" ] && BGENV=("CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0")   # print mode's own 600s wait for background subagents killed a $10 run mid-turn; hung_watch below still ends an iteration that has gone silent, so this only removes a wall-clock one — never overridden when the caller already set it
  log "iter $i/$MAXI start (budget \$$BUDGET, turns ${TURNS:-unlimited}, model ${m:-box default}${TRIMENV:+, context trim on})"   # the trim is named in the log so a shadow week can tell trimmed runs from the rest; the model is in the log too (a survey of what workers ran on found this default wrong) — AFTER the "start (budget" prefix cc-secretary parses (review of #169)
  out="$ST/runs/$(date -u +%Y%m%dT%H%M%SZ)-$i.json"; t0=$(date +%s)
  # With the sandbox off, each Bash call, hook and MCP server gets a signal scope of its own inside the session's, so a
  # test cannot signal this worker's own claude either (cc-nosignal-shell). Not under bwrap, whose view may not hold
  # $BIN: there a test can still signal this claude, though not the user manager, tmux or another session. Never over
  # a caller's prefix.
  SPENV=(); [ "${CC_WORKER_SANDBOX:-}" = 0 ] && [ -z "${CLAUDE_CODE_SHELL_PREFIX:-}" ] && SPENV=("CLAUDE_CODE_SHELL_PREFIX=$BIN/cc-nosignal-shell")
  GAENV=(); inside_boundary || GAENV=("CC_GREEN_ASK=$ST/green.ask" "CC_DOCS_ASK=$ST/docs.ask")   # where a fenced `cc-green start` (green_kick) and `cc-docs file` (docs_kick) ask
  wscope; rm -f "$out.go"
  while :; do
  ( cd "$WT" && exec "${SCOPE[@]}" env CC_ROLE=worker "${TRIMENV[@]}" "${BGENV[@]}" "${SPENV[@]}" "${GAENV[@]}" "$BIN/cc-nosignal" -- "$BIN/cc-sandbox" "$repo" "$track" -- "$CLAUDE" "${args[@]}" > "$out" 2>"$out.err" ) &   # no wall clock: hung_watch kills it only when its transcript stops growing; cc-sandbox wraps it in bwrap, and only CC_WORKER_SANDBOX=0 execs that line untouched; cc-nosignal: claude and every Bash run it makes signal only what they started
  child=$!; rm -f "$out.hung"; hung_watch "$out.hung" "$out.blind" & hw=$!
  wait "$child"; rc=$?; kill "$hw" 2>/dev/null; wait "$hw" 2>/dev/null; child=""
  [ "$rc" != 0 ] && [ "${SCOPE[0]}" = systemd-run ] && [ ! -e "$out.go" ] || break   # .go: the scope ran its command, so claude started and is never run twice
  wnice "the scoped launch failed before claude started, rc $rc: $(tail -n 1 "$out.err" 2>/dev/null)"; done; rm -f "$out.go"
  hungs=""; [ -s "$out.hung" ] && { hungs=$(cat "$out.hung"); rc=124; }   # killed as hung: the code `timeout` gave, so every reader of rc=124 still holds
  if lim=$("$BIN/cc-limit" check "$out" "$out.err" "$m"); then   # usage/rate limit: this iteration never happened — no errs, no stall, no cap ($m: the model asked, for a cap line that names none)
    resets=$(date -u -d "@${lim#LIMIT }" +%H:%M)
    log "usage limit — waiting until ${resets}Z, then rerunning iteration $i"
    "$BIN/cc-limit" wait || stop 8 "waiting" "The Claude usage limit lasts until $("$BIN/cc-time" slack "${lim#LIMIT }" 2>/dev/null || echo "${resets}Z"), which is longer than the loop waits. To start it again: $(again)"
    i=$((i-1)); continue; fi
  "$BIN/cc-limit" clear   # the API answered: whatever else went wrong, it was not a limit
  cost=$(jq -r '.total_cost_usd // empty' "$out" 2>/dev/null); costsrc=""
  # A KILLED ITERATION (rc=124 killed as hung, or any kill) leaves no result json, so no total_cost_usd — and its
  # spend used to vanish from total=. The session's transcript is still on disk: cc-spend prices it (its one rates
  # table, no second pricer), and the line marks the figure as priced from the transcript.
  if [ -z "$cost" ]; then cost=$("$BIN/cc-spend" transcript "$WT" "$t0" 2>/dev/null); costsrc="~transcript"; fi
  cost=${cost:-0}; iserr=$(jq -r '.is_error // false' "$out" 2>/dev/null)
  turns=$(jq -r '.num_turns // 0' "$out" 2>/dev/null); subtype=$(jq -r '.subtype // ""' "$out" 2>/dev/null)
  spent=$(awk -v a="$spent" -v b="${cost:-0}" 'BEGIN{printf "%.4f", a+b}')
  # THE BRANCH THE WORKER MOVED IS ITS OWN COPY, AND THIS IS WHERE IT BECOMES THE HOST'S. Inside the sandbox
  # refs/heads/track is a per-track directory holding this branch and no sibling's (cc-sandbox, rstore), so the commit
  # the Stop hook made in there is not on the host's ref until this line folds it forward — BEFORE the checkpoint, which
  # is what pushes it. It is a no-op with the sandbox off, and cc-sandbox folds again at the next launch if this run
  # never reached this line, so an iteration killed mid-flight loses nothing.
  "$BIN/cc-sandbox" reconcile "$repo" "$track" || log "the branch $repo/$track committed on could not be folded onto the host's ref — see the line above"
  # A classifier refusal the worker's hook could not write from inside the sandbox waits in its own state dir; this
  # host-side line moves it into the permission session's ledger (cc-refusals, WHO IS RECORDED).
  "$BIN/cc-refusals" collect "$repo" "$track" >/dev/null 2>&1 || true
  ( cd "$WT" && env "${HG[@]}" CC_ROLE=worker "$BIN/cc-checkpoint" ) || true
  push_host   # …and push whatever is ahead of origin even with nothing left to commit: inside the sandbox the Stop hook commits but cannot push (no credential), and only this line can
  after_head=$(git -C "$WT" rev-parse HEAD 2>/dev/null); after_prog=$(md5sum "$ST/progress.md" | cut -c1-8)
  moved=no; { [ "$before_head" != "$after_head" ] || [ "$before_prog" != "$after_prog" ]; } && moved=yes
  log "iter $i end rc=$rc err=$iserr/$subtype turns=$turns cost=\$$cost$costsrc total=\$$spent commits=$([ "$before_head" != "$after_head" ] && echo yes || echo no) journal=$([ "$before_prog" != "$after_prog" ] && echo updated || echo unchanged)"
  [ "$QUIET" = 1 ] || jq -r '.result // ""' "$out" 2>/dev/null | tail -c 600 | sed 's/^/  │ /' >&2
  newprog=$(this_iteration "$SNAP" "$ST/progress.md")   # only THIS iteration's lines count, by position — see the function (a re-dispatched track must not "finish" on an old STATUS line, and must not MISS a new one that reads the same)
  # THE ASKED-FOR GREEN COMES BEFORE THE DONE BRANCH, which exits: a worker that asks in the iteration it writes
  # STATUS: DONE still gets the run, and its verdict in the journal.
  docs_kick   # the documents it asked filed, before the DONE branch for the same reason
  gated=no; green_kick && green_wait kicked && gated=yes
  if grep -qE '^STATUS: DONE' <<<"$newprog"; then
    "$BOARD" note "$repo" "$track" "loop: DONE after $i iteration(s), \$$spent" >/dev/null 2>&1
    if throwaway; then   # its branch is the delivery (`cc done`: no remote, no PR): no deliverable post, no card, nobody told
      log "DONE"; dout=$(env "${HG[@]}" "$BIN/cc" done "$repo" "$track" 2>&1); drc=$?; printf '%s\n' "$dout" >> "$LOG"
      [ "$drc" = 0 ] || stop 4 "finished, but cc done failed" "the worker wrote STATUS: DONE, but cc done failed (rc $drc) — see $LOG"
      log "exit 0: throwaway repo, done on track/$track"; exit 0; fi
    # A ROW WITH A TASK RECORD GOES THROUGH THE ONE HOST COMMAND (complete_task; inside a member workspace's boundary,
    # where there is no lander, it is that boundary's `cc done --json` instead). `cc-land queue --task` completes the task and,
    # where the standing grant holds, puts the PR on the same numeric queue a 👍 uses; the loop decides from the
    # RECEIPT it prints, never from an exit code — a board or card projection that could not be written used to
    # turn a real PR into "finished, but opened no PR". The branch below is the legacy one, for a row that has no
    # record; milestone 7 removes it with the rest.
    # A WORKER THE HUB PLACED ON A PEER HOST (cc-peer; CC_PEER_SPOOL is set by that launch and nothing else) has no
    # lander and no Slack here. Its DONE goes to the spool with the pushed tip and pr-body.md; the hub checks the tip
    # on origin and runs its own `cc-land queue --task` when it drains this host. A Slack deliverable is not carried.
    if [ -n "${CC_PEER_SPOOL:-}" ]; then
      log "DONE (placed here by the hub: the hub queues the landing)"
      rec=$("$BIN/cc-peer" spool land "$repo" "$track" 2>>"$LOG"); printf '%s\n' "$rec" >> "$LOG"
      "$BOARD" note "$repo" "$track" "DONE on this host; the hub queues the landing when it drains it" >/dev/null 2>&1
      exit 0; fi
    deliver_post   # the worker's Slack deliverable, if the brief asked for one: posted here, once, before the PR
    if [ -e "$ST/delivery.json" ] || [ -L "$ST/delivery.json" ]; then
      log "DONE"
      # the command that finishes it by hand. Inside a member's boundary there is no lander and nothing to push to
      # but the workspace's origin, so it is the HOST's `cc done` (review of #965), never one typed in there.
      rec=$(complete_task); retry="cc-land queue --task $repo $track"; redo="cc done $repo $track"
      inside_boundary && { retry="cc done $repo $track on the host"; redo=$retry; }
      printf '%s\n' "$rec" >> "$LOG"
      case "$(delivery_end "$rec")" in
        failed) why=$(jq -r '[.errors[] | select(.stage == "commit" or .stage == "push" or .stage == "pr") | .message] | join("; ")' <<<"$rec")
          stop 4 "finished, but opened no PR" "the worker wrote STATUS: DONE, but cc done failed: $why. Fix the cause, then: $redo";;
        unknown) stop 12 "delivery unconfirmed" "completion returned no usable receipt; inspect $LOG, then: $retry";;
        pending) note="delivery projection pending: $(jq -r '.pending | keys | join(", ")' <<<"$rec"); retry: $retry"
          log "$note"; "$BOARD" note "$repo" "$track" "$note" >/dev/null 2>&1;;   # the PR is real: a note, not a page
      esac
      # WHAT FINISHED, not how many turns it took to finish it: the iteration count and the dollar figure are the
      # loop's own bookkeeping and are in the board note and the log above. A person reading #<repo>-updates wants
      # the row (comms audit 2026-09-07).
      done_card "$(jq -r '.pr_url // ""' <<<"$rec")" "$(jq -r '.landing.message // ""' <<<"$rec")"
      exit 0
    else
      log "DONE"; dout=$(env "${HG[@]}" "$BIN/cc" done "$repo" "$track" 2>&1); drc=$?   # captured, never `| tail -1`: the pipe dropped the status
      printf '%s\n' "$dout" >> "$LOG"; dlast=$(printf '%s\n' "$dout" | grep -v '^[[:space:]]*$' | tail -1); printf '%s\n' "$dlast" >&2
      # DONE is the worker's word; done is `cc done`'s. A push a DNS blip killed, a lease refused: the loop used to notify DONE with
      # `PR: ` empty and exit 0, and the board went green over work no PR carried (monthly audit 2026-09-01 F3; 05:07Z janitor-containers).
      # rc 7 is a kind=session row: pushed, and its READY TO LAND note went to the planner intake because no live planning
      # turn took it (cc done's contract) — delivered, not failed, so it is logged and not stopped on. It is 7 and not 3
      # because no other ending of cc done uses 7; a bare 3 is a refusal elsewhere in the delivery chain (cc-checkpoint's
      # "no host lease", the guard.sh t7 shape), and read as delivered it posted DONE over a branch that never left the
      # box (review of #635, findings 1 and 6). Every other non-zero, 3 and 6 included, stops 4 below.
      [ "$drc" = 7 ] && { log "cc done: pushed; the ready-to-land note was filed as a request — ${dlast:-no output}"; drc=0; }
      [ "$drc" = 0 ] || stop 4 "finished, but opened no PR" "the worker wrote STATUS: DONE, but cc done failed (rc $drc): ${dlast:-no output}. Fix the cause, then: cc done $repo $track"
      # THE STANDING GRANT is spent by `cc done` itself, which queued the PR above where the repo holds it (`cc lands`), the row
      # is not held and the PR is not a draft (queue_pr); its `queued:` / `not queued: … — <why>` line becomes the one sentence on the landing.
      landed=""
      ql=$(printf '%s\n' "$dout" | grep -E '^(not )?queued: ' | tail -1)
      case "$ql" in
        "queued: "*) landed="It's queued to land, no 👍 needed." ;;
        "not queued: "*) landed="Not queued: ${ql#* — }." ;;   # held, a draft, or the queue refused it (a protected path's 🔐 card)
      esac
      done_card "$("$BOARD" get "$repo" "$track" pr)" "$landed"; exit 0
    fi
  fi
  if q=$(grep -E '^STATUS: BLOCKED' <<<"$newprog" | tail -1) && [ -n "$q" ] && ap=$(already_pushed "$q"); then
    # a push ask the remote already answered: the STATUS line comes out of the journal (only this iteration's, matched
    # whole and last), the journal says why for the next fresh context, and the loop goes on instead of paging the seat
    awk -v n="$(grep -nxF -- "$q" "$ST/progress.md" | tail -1 | cut -d: -f1)" 'NR!=n' "$ST/progress.md" > "$ST/progress.md.tmp" && mv -f "$ST/progress.md.tmp" "$ST/progress.md"
    printf '\n%s cc-loop: the BLOCKED line asked for a push, but %s already: pushed from the host after the iteration. The line is cleared; carry on with the task, and never stop to ask for a push (the loop pushes after every iteration).\n' "$(date -u +%FT%TZ)" "$ap" >> "$ST/progress.md"
    log "iter $i: BLOCKED push ask cleared — $ap"; "$BOARD" note "$repo" "$track" "a BLOCKED push ask was already pushed ($ap): cleared, still running" >/dev/null 2>&1
    q=""; fi
  # "cc-loop's verdict comes first: a worker whose commit cc-loop pushed isn't BLOCKED by a push 'failure' inside the
  # sandbox" (the brief). So a BLOCKED line that blames what the sandbox hides by design, on a head the checkpoint above
  # DID push, is answered here — a journal line saying so — and the loop carries on. Once per run: the same line again
  # is the worker's considered answer and stops as any BLOCKED does. The worker's line itself is left as it wrote it;
  # the STATUS: RESUMED line after it is what tells cc-reconcile the track is no longer waiting on a person.
  if [ -n "$q" ] && [ "$overruled" = 0 ] && blocked_by_view "$q" && head_pushed; then
    overruled=1; log "BLOCKED on what the sandbox hides, but its head $(git -C "$WT" rev-parse --short HEAD) is on origin — carrying on: $q"
    printf -- '- cc-loop: you stopped BLOCKED on what the sandbox hides by design (%s), but your head %s is pushed: it is on origin/track/%s. Nothing is broken. Carry on from the journal; if the task is finished, append STATUS: DONE.\nSTATUS: RESUMED: cc-loop pushed %s, so the BLOCKED line above is answered\n' \
      "$(sed 's/^STATUS: BLOCKED:[[:space:]]*//' <<<"$q" | cut -c1-160)" "$(git -C "$WT" rev-parse --short HEAD)" "$track" "$(git -C "$WT" rev-parse --short HEAD)" >> "$ST/progress.md"
    q=""; fi
  if [ -n "${q:-}" ]; then
    # The question, then how to answer it, as sentences rather than an aside in brackets. The two paths stay: whoever
    # answers has to type them, and the planning session this goes to has no other way to find the worker's files.
    stop 3 "needs you" "$q  Settle it yourself if you can; only if it is the owner's to decide, ask him with cc-notify --decision. To answer it, put the answer at the end of $ST/task.md, take the STATUS line out of $ST/progress.md, then run: $(again)" waiting \
      "$(sed 's/^STATUS: BLOCKED:[[:space:]]*//' <<<"$q")"; fi
  rn=$(refusal_next "$out" "$out.err" "$m"); rnrc=$?; rwhy=${rn#*$'\t'}; nx=""; [ "$rnrc" = 0 ] && nx=${rn%%$'\t'*}
  case "$(refusal_step "$rnrc" "$moved")" in
    rerun)   # nothing to show for it: the same model asked again gives the same answer
      log "refused or rerouted on ${m:-the box default} ($rwhy) — nothing produced, so iteration $i reruns on $nx"
      refusal_note "$i" "$m" "$nx" "$rwhy" rerun >> "$ST/progress.md"   # the next fresh context has to know why its model changed
      "$BOARD" note "$repo" "$track" "model refused or rerouted ($rwhy) — now on $nx" >/dev/null 2>&1
      "$BIN/cc-model" out "$m" >/dev/null 2>&1 || MODEL="$nx"   # pinned only when the box has no record of it: a recorded outage resolves itself, and lifts itself
      i=$((i-1)); continue;;
    count)   # F4: it committed, or it wrote the journal. Rerunning it would redo work the next context can read.
      log "refused or rerouted on ${m:-the box default} ($rwhy) — but iteration $i produced work, so it counts${nx:+ and the model moves to $nx}"
      if [ "$rnrc" = 0 ] || [ "$chainend" = 0 ]; then   # the end of the chain is said once, not once per iteration
        refusal_note "$i" "$m" "$nx" "$rwhy" kept >> "$ST/progress.md"
        "$BOARD" note "$repo" "$track" "model refused or rerouted ($rwhy) — ${nx:+now on $nx}${nx:-no model left on the chain, but the work stands}" >/dev/null 2>&1; fi
      [ "$rnrc" = 2 ] && chainend=1
      { [ -n "$nx" ] && ! "$BIN/cc-model" out "$m" >/dev/null 2>&1; } && MODEL="$nx"; :;;   # pinned only when the box has no record of it (see above); on into the normal accounting below
    stop)
      refusal_note "$i" "$m" "" "$rwhy" stopped >> "$ST/progress.md"
      stop 10 "was refused" "Every model on the cc-model chain refused or was rerouted (last: ${m:-the box default}; ${rwhy:-refused}) and the last one produced nothing. The task is not the problem — check the models, then: $(again)";;
  esac
  [ "$gated" = yes ] || { green_wait && gated=yes; }   # its own suite still running: the iteration ends on what the work did, and the loop waits, not the worker
  # a process of its own still in the worktree (own_run_live) only keeps an error or a cap from counting: it is never
  # waited for, so it must not also switch off the barren checks or buy an iteration below, which stay green_wait's
  ownrun=no; if [ "$gated" = no ] && orl=$(own_run_live); then ownrun=yes; log "iter $i ended with a run of its own still going in its worktree (${orl}) — not idle"; fi
  if { [ "$gated" = yes ] || [ "$ownrun" = yes ]; } && { [[ "$subtype" == error_max_* ]] || [ "$rc" != 0 ] || [ "$iserr" = true ]; }; then
       log "ended (rc=$rc${subtype:+, $subtype}) while its own gate run was still going — not counted as a failure or a cap"
  elif [[ "$subtype" == error_max_* ]]; then errs=0; log "capped ($subtype) — the iteration ends at its checkpoint and the loop goes on$([ "$moved" = yes ] || echo ', nothing to show for it')"
       # a cap is a checkpoint, never a failure: one with nothing to show is a runaway signal below, which tells, not stops
  elif [ "$rc" = 124 ] && [ "$before_head" != "$after_head" ]; then errs=0; log "killed as hung (rc=124, transcript silent ${hungs:-?} s), but it committed — not counted as a failure"
       # brief: "don't count a timed-out iteration that committed as a failure"; one that did not is counted below
  elif [ "$rc" = 124 ]; then errs=$((errs+1)); log "error ($errs): killed as hung (rc=124, transcript silent ${hungs:-?} s) with nothing committed"
       [ $errs -ge 2 ] && stop 5 "errored" "2 consecutive failures; see $LOG"
  elif [ "$rc" != 0 ] || [ "$iserr" = true ]; then errs=$((errs+1)); log "error ($errs): $( { head -c 300 "$out.err" 2>/dev/null; [ -s "$out.err" ] || jq -r '"\(.subtype // "")\ \(.result // "" | tostring)"' "$out" 2>/dev/null | head -c 300; } | tr '\n' ' ')"   # a run that errored in-band leaves .err empty: say why from the json
       [ $errs -ge 2 ] && stop 5 "errored" "2 consecutive failures; see $LOG"
  else errs=0; fi
  # ── the runaway rule: progress-free SPEND, and every number it uses comes from this track's own history ──
  committed=no; [ "$before_head" != "$after_head" ] && committed=yes
  sig=$(jq -r '"\(.subtype // "")|\(.is_error // false)|\((.result // "")|tostring)"' "$out" 2>/dev/null | tr -d '\n' | head -c 160)
  if [ "$committed" = yes ]; then cn=$((cn+1)); ccost=$(awk -v a="$ccost" -v b="$sincecost" -v c="${cost:-0}" 'BEGIN{printf "%.4f", a+b+c}'); sincecost=0; nocommit=0
  else sincecost=$(awk -v a="$sincecost" -v b="${cost:-0}" 'BEGIN{printf "%.4f", a+b}'); nocommit=$((nocommit+1)); fi
  yard=$(awk -v c="$ccost" -v n="$cn" -v b="$BUDGET" 'BEGIN{printf "%.4f", (n>0 ? c/n : b)}')   # what an iteration that DID commit costs this track; before the first one, its own budget
  why=""
  # A gated iteration (its own gate run, waited out above) explains away the first two signals — the journal it left
  # untouched, the outcome it repeated — and NOT the third: money spent since the last commit is spent whether or not a
  # suite was running, and a worker re-running a red suite every iteration is exactly what that rule is for.
  if [ "$moved" = no ] && [ "$gated" = no ]; then why="committed nothing and left the journal untouched"
  elif [ "$committed" = no ] && [ "$gated" = no ] && [ -n "$prevsig" ] && [ "$sig" = "$prevsig" ]; then why="repeated the previous iteration's outcome word for word, with nothing committed"
  elif [ "$nocommit" -ge 2 ] && awk -v s="$sincecost" -v y="$yard" -v x="$RUNX" 'BEGIN{exit !(y > 0 && s >= x * y)}'; then
    why="spent \$$sincecost since its last commit — ${RUNX}x what a committed iteration costs this track (\$$yard)"; fi
  prevsig="$sig"
  if [ -n "$why" ]; then barren=$((barren+1)); log "runaway signal $barren/$RUNN: $why"
    k=$((barren - RUNN + 1))   # told at the streak's 1st, 2nd, 4th, 8th… barren iteration from RUNN, and the loop carries on (owner 10-20)
    if [ "$k" -ge 1 ] && [ $((k & (k - 1))) = 0 ]; then
      rmsg="$barren iterations in a row with nothing to show for the money: $why. That is $i iterations, \$$spent, last commit $nocommit iteration(s) ago. The loop carries on; read $LOG, and to end it: touch $ST/stop"
      log "runaway notice at $barren barren (still running): $rmsg"
      "$BOARD" note "$repo" "$track" "running without producing: $barren barren iterations in a row, \$$spent; still running" >/dev/null 2>&1
      tell_planner "$(planner_line 'is running without producing' "$rmsg")" || log "the runaway notice reached no session: it is in loop.log and the board note"; fi
  else barren=0; fi
  # The step limit is a checkpoint: a line and a board note, and the loop goes on, committing or not (owner 10-20: no
  # count caps on runs). Under --no-extend it IS the verdict: a caller that bounded the round gets its bound.
  if [ $i -ge "$MAXI" ] && [ "${NOEXT:-0}" != 1 ]; then
    MAXI=$((MAXI + BATCH))
    log "checkpoint at $i iterations (\$$spent, last commit $nocommit iteration(s) ago) — carrying on"
    "$BOARD" note "$repo" "$track" "checkpoint: $i iterations, \$$spent, still running" >/dev/null 2>&1; fi
done
IFS='|' read -r ended bst <<<"$(round_end "${committed:-no}" "$("$BOARD" get "$repo" "$track" pr 2>/dev/null)")"
if [ "$ended" = over ]; then   # bounded and still committing: the round did its job, so nobody is paged and the board says review
  "$BOARD" status "$repo" "$track" "$bst" >/dev/null 2>&1
  "$BOARD" note "$repo" "$track" "loop: round over at its $MAXI-iteration bound, \$$spent, the last iteration committed" >/dev/null 2>&1
  log "exit 0: round over at its step limit with work committed"
  # THE SEAT'S TURN, as a DONE: a round that ended is an end, and the seat that dispatched it gets the line by the
  # broker (a digest, not a page). Nothing is posted to Slack for it: the board note and loop.log carry it.
  tell_planner "$(planner_line 'round over' "Ran its $MAXI iteration(s) (\$$spent) and committed on the last one — the round is over, not stalled. More with: $(again) --loop N")" || true
  exit 0; fi
stop 6 "$ended" "Hit its --no-extend bound of $MAXI iterations (\$$spent) and the last one committed nothing. Continue with: $(again)" "$bst"
