#!/usr/bin/env bash
# cc-loop — autonomous "ralph loop": run headless Claude on a task, fresh context each iteration, rehydrating
# from a durable progress journal + git, until the task reports DONE / BLOCKED / stalls / caps are hit.
#   cc-loop <repo> <track> [--once] [--max-iter N=10] [--budget USD/iter=8] [--turns N=80] [--model M] [--effort E] [--quiet]
#                          [--resume-last]  iteration 1 continues this track's last claude session instead of a cold
#                                           one — for a repair round, where the context that found the bug is the
#                                           expensive part; later iterations are fresh as always
#                          [--no-extend]    the step limit is FINAL: no carry-on batches at --max-iter, so a caller
#                                           that promised "one round" (cc-land's fix round) gets exactly that
# THE STEP LIMIT IS A CHECKPOINT, NOT A VERDICT: reaching --max-iter with work COMMITTED in that iteration buys
# another N iterations, as often as it keeps committing. There is no spend cap (owner, 2026-08-31: "no spend cap
# as some just are expensive") — what stops a loop is not being expensive, it is not producing:
# RUNAWAY — three iterations in a row that show nothing for their money, judged against THIS track's own history:
#   · committed nothing and left the journal untouched · repeated the previous outcome verbatim without committing
#   · spent 5x what a committed iteration has cost this track, with no commit for two iterations.
# One of those is normal. Three consecutively is a loop going nowhere, so it is stopped, the board says `blocked`,
# and the owner is told once with the numbers.
# WHAT A LEGITIMATE EXPENSIVE JOB LOOKS LIKE HERE, and why it survives: a $25-an-iteration opus worker on a
# 40-step refactor commits something most iterations and journals every one. Signal 1 needs BOTH to fail;
# signal 2 needs the model's own summary to repeat verbatim; signal 3 measures it against ITS OWN mean cost
# per committed iteration, so $25 is the yardstick, not the alarm — it would have to spend $125 without one
# commit. And all three are consecutive counters that a single good iteration resets. That job runs, past
# its step limit, for as long as it keeps producing; what it may never do is spend without producing.
# Task text:  ~/.cc/state/<repo>/<track>/task.md      (written by `cc <repo> <track> --go "..."` or by hand)
# Journal:    ~/.cc/state/<repo>/<track>/progress.md  (worker appends; a fresh iteration reads it)
# Runs in the track's git worktree; every iteration ends with cc-checkpoint (commit+push to track branch).
# Self-review: templates/self-review.md — the six kinds of finding the landing review keeps stopping PRs for. The worker
#             prompt carries it verbatim (selfrev_block, inlined because a sandboxed worker has core/bin bound and not
#             core/templates), and the worker reads its own `git diff origin/<base>` against it before STATUS: DONE.
# A REFUSAL OR A REROUTE IS NEVER SILENTLY RETRIED. When cc-model classifies the run as `refusal` — the classifier
# stopped the turn, or a model that is withdrawn or suspended answered as a different one — the same model asked
# again gives the same answer, so the loop moves to the next model on the cc-model chain (`cc-model next`; the order
# lives there and only there) and writes one line in the journal so the next fresh context knows why its model changed.
# A run that came back with NOTHING is rerun as the same iteration — not an error, not an iteration. A run that
# committed or journalled COUNTS like any other; only the model changes (F4, refusal_step). Off the end of the chain:
# with nothing to show it stops (10); with work, the work stands and the loop carries on, on the same model.
# AN ITERATION THAT ENDED ITSELF IS NOT CLASSIFIED AT ALL (ctx_stopped). A worker is never handed off: at its context
# threshold cc-context tells it to journal and end its turn, and marks the journal — this loop reads that mark and
# starts the next iteration on a fresh context, which IS the handoff. Nothing refused and nothing was rerouted.
# Exit: 0 done | 3 waiting on the owner, board `waiting` (notified) | 4 the worker said DONE but `cc done` failed: no PR, board `blocked` (notified)
#     | 5 errors | 6 step limit with nothing committed | 7 capped twice with no progress | 9 runaway (spending without producing — see above) | 10 every model on the chain refused
#     | 8 Claude usage limit that outlasts CC_LIMIT_MAX_WAIT (6 h). A limited run is not an iteration and not an error:
#       cc-limit stamps ~/.cc/state/claude-limit, the loop waits it out (owner told once) and reruns the same iteration.
# Env (tests): CC_LOOP_RUNAWAY_N how many barren iterations in a row · CC_LOOP_RUNAWAY_X the cost multiple.
# Env: CC_WORKER_SANDBOX=1 runs claude inside bwrap — secrets, sockets, other tracks absent (cc-sandbox; design-worker-sandbox stage 1a).
set -uo pipefail
case ":$PATH:" in *":$HOME/bin:"*) ;; *) PATH="$HOME/bin:$PATH";; esac; case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH";; esac; export PATH   # headless workers: same PATH guarantee as cc (systemd-started clients lack ~/bin)
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
# The loop's SIGNALS are its own, not the launcher's. A cc-loop started `setsid nohup` out of a session shell inherits SIGHUP
# ignored; exec keeps that, and bash silently cannot trap a signal ignored at entry — so the HUP trap below did nothing and
# killing the loop left claude alive in the worktree (the relaunch-orphans incident; the trap #134 found under selftest.sh).
# Bash cannot undo it, so the script goes once through python, which puts HUP/INT/QUIT/TERM back to default — the way tmux
# and systemd start things — and PIPE/XFSZ with them, which python itself ignores and would otherwise hand down.
if [ -z "${CC_LOOP_SIGNALS:-}" ] && command -v python3 >/dev/null 2>&1; then
  CC_LOOP_SIGNALS=1 exec python3 -c 'import os, signal, sys
for s in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM, signal.SIGPIPE, signal.SIGXFSZ): signal.signal(s, signal.SIG_DFL)
os.execv(sys.argv[1], sys.argv[1:])' "$(readlink -f "$0")" "$@"
fi
unset CC_LOOP_SIGNALS   # our children start from the same defaults, and none of them needs to know how
refusal_note(){   # $1 iteration · $2 the model that refused · $3 the one it moved to ("" = the chain ends here)
                  # $4 why · $5 kept|rerun|stopped → the journal's own line, for the next fresh context to read
  local to="${3:+only the model changed, to $3 per the cc-model chain}"; to="${to:-no model is left on the cc-model chain, so it carries on on the same one}"
  case "${5:-rerun}" in
    kept)    printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) — but it produced work, so it COUNTS and everything below it stands; %s.\n' \
               "$1" "${2:-the box default}" "$4" "$to";;
    stopped) printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) with nothing to show for it, and no model is left on the cc-model chain — the loop stopped (exit 10). The task and the journal below are unchanged.\n' \
               "$1" "${2:-the box default}" "$4";;
    *)       printf -- '- cc-loop: iteration %s was refused or rerouted on %s (%s) with nothing to show for it — switched to %s per the cc-model chain and reran it. The model would not do the work; the task and the journal below are unchanged.\n' \
               "$1" "${2:-the box default}" "$4" "$3";;
  esac; }
refusal_step(){   # $1 refusal_next's exit code · $2 whether the iteration produced work → what the loop does.
                  # A REROUTE THAT PRODUCED WORK IS AN ITERATION (2026-09-01 review, F4): it committed, or it wrote
                  # the journal, and rerunning it would redo work the next fresh context can already read. Only the
                  # model changes. Rerunning is for the run that came back with nothing.
  case "$1:$2" in
    0:no)  echo rerun;;   # nothing produced: the same model asked again gives the same answer
    0:yes) echo count;;   # produced work: keep it, move the model, carry on
    2:no)  echo stop;;    # the chain ends here and nothing came of it — no model left to try
    2:yes) echo count;;   # the chain ends here but the work is real: keep it and carry on, on the same model
    *)     echo none;;    # not a refusal at all
  esac; }
ctx_stopped(){   # $1 = the lines THIS iteration added to the journal -> did it end ITSELF at its context threshold?
                 # A worker is never handed off (cc-handoff `worker`): at the threshold cc-context tells it to journal
                 # and end its turn, and writes one fixed line into progress.md saying it did. That line is the whole
                 # contract between the two files — cc-context owns the wording, this grep owns the prefix (the
                 # selfcheck below checks the two still match). Such an iteration is ORDINARY: the model did not
                 # refuse and was not rerouted, it did exactly what it was told, so it is not classified and not
                 # rerun — the next fresh context simply continues from the journal. That IS the handoff.
  grep -q '^- cc-context: iteration stopped at ' <<<"${1:-}"; }
refusal_next(){   # $1 run json · $2 its stderr · $3 the model asked for → "<next>\t<why>"
                  # 0 = refused, move to <next> · 1 = not a refusal · 2 = refused with nothing left on the chain
                  # $3 may be empty — that is the normal state, and cc-model resolves it (the chain has one home)
  local cl why nx
  cl=$("$BIN/cc-model" classify "$1" "$2" "${3:-}" 2>/dev/null) || return 1
  case "${cl%%$'\t'*}" in refusal) ;; *) return 1;; esac
  why="${cl#*$'\t'}"; why="${why:-refused}"
  nx=$("$BIN/cc-model" next "${3:-}" 2>/dev/null) || nx=""
  [ -n "$nx" ] || { printf '\t%s\n' "$why"; return 2; }
  printf '%s\t%s\n' "$nx" "$why"; return 0; }
last_session(){   # $1 a track's runs/ directory → the session id of its most recent run that recorded one, or 1.
                  # Newest FIRST and it keeps looking: an iteration killed mid-flight leaves a json with no
                  # session_id, and the round after it would then open a cold session having been told to resume.
  local f s
  while IFS= read -r f; do
    s=$(jq -r '.session_id // empty' "$f" 2>/dev/null)
    [ -n "$s" ] && { printf %s "$s"; return 0; }
  done < <(find "$1" -maxdepth 1 -name '*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -20 | cut -d' ' -f2-)
  return 1; }

CHECKLIST="$(dirname "$BIN")/templates/self-review.md"   # the six recurring stops live in ONE place, and this is it
selfrev_block(){   # $1 the base branch → the self-review paragraph the worker prompt carries, or NOTHING if the
                   # checklist is missing. The worker reads the diff against it before STATUS: DONE, so the review
                   # stops fewer PRs for what the worker could have seen itself. It is inlined rather than linked
                   # because a sandboxed worker (cc-sandbox) has core/bin bound and no core/templates, and a prompt
                   # that points at a path the worker cannot open is worse than one that says nothing.
  [ -r "$CHECKLIST" ] || return 0
  printf " Before you append 'STATUS: DONE', re-read \`git diff origin/%s\` against the LANDING SELF-REVIEW below and fix what it finds — it is templates/self-review.md, so an entry that is wrong is fixed THERE, not in this copy.\n\n%s\n" \
    "$1" "$(cat "$CHECKLIST")"; }
selfcheck(){   # the refusal path on fixtures: the classes the loop acts on, the model it moves to, what it does with
               # an iteration that was rerouted but still worked (F4), and the line it journals.
               # The fixtures are REAL `-p` result shapes, carrying the two traps that fooled the old classifier: a
               # `subagent_stats.refused` block, and a successful worker whose own prose says "refused". The full
               # sanitized real result lives in cc-model's selfcheck — this file only has to test the loop's reaction.
  local d n=0 bad=0 out rc head nxt last
  head=$("$BIN/cc-model" chain | sed -n 1p); nxt=$("$BIN/cc-model" chain | sed -n 2p); last=$("$BIN/cc-model" chain | tail -1)
  [ -n "$head" ] && [ -n "$nxt" ] || { echo "cc-loop selfcheck: cc-model chain is shorter than two models" >&2; return 1; }
  d=$(mktemp -d) || return 1
  t(){ n=$((n+1)); [ "$2" = "$3" ] && return 0; bad=$((bad+1)); printf 'FAIL %s: got %s, want %s\n' "$1" "$2" "$3"; }
  R='{"type":"result","subtype":"success","is_error":false,"result":"Done — the `.env.local` write was refused, as designed.","stop_reason":"end_turn","terminal_reason":"completed","permission_denials":[],"errors":null,"uuid":"14144299-9e48-4299-8f0c-0000000429ab","subagent_stats":{"spawned":0,"completed":0,"failed":0,"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0}},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":2737},"MAIN":{"inputTokens":112}}}'
  printf '%s' "${R/MAIN/$head}" > "$d/ok.json"
  jq -c '.is_error=true | .subtype="error_during_execution" | .stop_reason="refusal" | .result=""' "$d/ok.json" > "$d/refused.json"
  out=$(refusal_next "$d/refused.json" "" "$head"); rc=$?
  t 'a refused run moves to the next model on the chain' "$out:$rc" "$(printf '%s\tthe classifier stopped the turn:0' "$nxt")"
  refusal_next "$d/ok.json" "" "$head" >/dev/null;   t 'a good run whose prose says "refused" is not a refusal' "$?" 1
  refusal_next "$d/refused.json" "" "$last" >/dev/null; t 'the end of the chain has nowhere to move to' "$?" 2
  # F4: what the loop DOES with it. A reroute that produced work is an iteration; only one that produced nothing reruns.
  t 'refused, nothing produced: rerun it'              "$(refusal_step 0 no)"  rerun
  t 'refused but it produced work: the iteration counts' "$(refusal_step 0 yes)" count
  t 'chain exhausted with nothing produced: stop'      "$(refusal_step 2 no)"  stop
  t 'chain exhausted but the work is real: carry on'   "$(refusal_step 2 yes)" count
  t 'not a refusal at all: the loop does nothing'      "$(refusal_step 1 yes)" none
  # the journal fixtures: what the next fresh context reads, and what it must never be mistaken for
  refusal_note 3 "$head" "$nxt" 'the classifier stopped the turn' rerun > "$d/progress.md"
  refusal_note 4 "$head" "$nxt" 'answered as opus, not fable' kept >> "$d/progress.md"
  grep -q "iteration 3 was refused or rerouted on $head" "$d/progress.md"; t 'the journal names the iteration and the model' "$?" 0
  grep -q "switched to $nxt per the cc-model chain and reran it" "$d/progress.md"; t 'a rerun says it was rerun' "$?" 0
  grep -q "iteration 4 .*it produced work, so it COUNTS" "$d/progress.md"; t 'a kept iteration says the work stands' "$?" 0
  grep -q "iteration 4 .*and reran it" "$d/progress.md"; t 'and never claims it was rerun' "$?" 1
  # --resume-last: which session a repair round continues, and what it does when there is none to continue.
  mkdir -p "$d/runs"
  t 'nothing has run yet: there is no session to resume, and the round is told so rather than resuming a guess' \
    "$(last_session "$d/runs" || echo NONE)" NONE
  printf '{"session_id":"old-one"}' > "$d/runs/20260101T000000Z-1.json"
  printf '{"session_id":"the-one"}' > "$d/runs/20260101T000100Z-2.json"
  touch -d '2026-01-01 00:00:00' "$d/runs/20260101T000000Z-1.json"; touch -d '2026-01-01 00:01:00' "$d/runs/20260101T000100Z-2.json"
  t 'the session resumed is the track\047s MOST RECENT one, not the first it finds' "$(last_session "$d/runs")" the-one
  printf '{"is_error":true}' > "$d/runs/20260101T000200Z-3.json"; touch -d '2026-01-01 00:02:00' "$d/runs/20260101T000200Z-3.json"
  t 'a run killed before it recorded a session id is skipped, not treated as "no session" — a repair round would \
otherwise start cold having been told to resume' "$(last_session "$d/runs")" the-one
  rm -rf "$d/runs"
  refusal_note 5 "$last" "" 'answered as haiku, not fable' stopped >> "$d/progress.md"
  grep -q "iteration 5 .*the loop stopped (exit 10)" "$d/progress.md"; t 'the stop line says it stopped' "$?" 0
  grep -q "iteration 5 .*reran it" "$d/progress.md"; t 'and never claims it reran' "$?" 1
  grep -qE '^STATUS' "$d/progress.md"; t 'no journal line is a STATUS line' "$?" 1
  # an iteration that ended ITSELF at its context threshold is not a refusal and not a reroute
  ctx_stopped '- cc-context: iteration stopped at 41% of its context window (handoff) — it journalled and ended its turn; the next iteration continues from this journal.'
  t 'an iteration that stopped for context is seen as that' "$?" 0
  ctx_stopped "$(cat "$d/progress.md")"; t 'a refusal note is not mistaken for one' "$?" 1
  ctx_stopped '- did the next step; cc-context: iteration stopped at 41%'; t 'only a line that STARTS with the marker counts' "$?" 1
  ctx_stopped ""; t 'an iteration that journalled nothing is classified as before' "$?" 1
  grep -qF -- "- cc-context: iteration stopped at " "$BIN/cc-context"
  t 'the marker cc-context writes is still the one this file greps' "$?" 0
  # the self-review block the worker prompt carries: KEPT when the checklist is there, SUPPRESSED when it is not,
  # each on a fixture of its own — a prompt that names a checklist the worker cannot read is the thing to avoid.
  local realcl="$CHECKLIST" blk
  mkdir -p "$d/present"; printf '# Landing self-review\n\n1. **The contract says what the code now does.**\n' > "$d/present/self-review.md"
  CHECKLIST="$d/present/self-review.md"; blk=$(selfrev_block trunk)
  grep -q 'templates/self-review.md' <<<"$blk";               t 'the prompt names the checklist' "$?" 0
  grep -q 'git diff origin/trunk' <<<"$blk";                  t 'and the base branch it is read against' "$?" 0
  grep -q 'The contract says what the code now does' <<<"$blk"; t 'and carries the checklist itself, not a link a sandboxed worker cannot open' "$?" 0
  CHECKLIST="$d/absent/self-review.md"   # a fresh path this selfcheck never created — not the fixture above, emptied
  [ -z "$(selfrev_block trunk)" ];                            t 'no checklist file: the prompt promises nothing' "$?" 0
  CHECKLIST="$realcl"
  [ -r "$CHECKLIST" ];                                        t 'the shipped checklist is where the prompt says it is' "$?" 0
  grep -q '^6\. ' "$CHECKLIST" 2>/dev/null;                    t 'and still carries all six entries' "$?" 0
  sed 's/^/  journal fixture | /' "$d/progress.md"
  rm -rf "$d"
  printf 'cc-loop selfcheck: %s passed, %s failed\n' "$((n - bad))" "$bad"
  [ "$bad" = 0 ]; }
[ "${1:-}" = selfcheck ] && { selfcheck; exit $?; }
repo="${1:?repo}"; track="${2:?track}"; shift 2
MAXI=10; BUDGET=8; TURNS=80; MODEL=""; EFFORT=""; QUIET=0; RESUME=0   # an opus-class worker spends ~$2/iteration: a $2 cap truncated real work mid-turn
while [ $# -gt 0 ]; do case "$1" in
  --once) MAXI=1;; --max-iter) MAXI="$2"; shift;; --budget) BUDGET="$2"; shift;; --turns) TURNS="$2"; shift;;
  --model) MODEL="$2"; shift;; --effort) EFFORT="$2"; shift;; --quiet) QUIET=1;; --resume-last) RESUME=1;; --no-extend) NOEXT=1;;
  *) echo "cc-loop: unknown arg $1" >&2; exit 2;; esac; shift; done
[[ "$MAXI" =~ ^[0-9]+$ ]] && [ "$MAXI" -ge 1 ] || { echo "cc-loop: --max-iter must be a positive integer (got '$MAXI')" >&2; exit 2; }
[[ "$BUDGET" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "cc-loop: --budget must be a plain number in USD (got '$BUDGET')" >&2; exit 2; }   # `1e9` is not $8
BATCH="$MAXI"; RUNN="${CC_LOOP_RUNAWAY_N:-3}"; RUNX="${CC_LOOP_RUNAWAY_X:-5}"   # one batch of steps; the runaway rule's two dials
if [ -f "$HOME/dev/$repo/.cc/member-workspace" ] && [ "${CC_MEMBER_SANDBOX:-}" != 1 ]; then   # depth behind cc's sandbox_gate
  echo "cc-loop: $repo is a member workspace — its workers run inside the boundary (member-sandbox) or not at all" >&2; exit 2
fi
ST="$HOME/.cc/state/$repo/$track"; WT="$HOME/.cc/worktrees/$repo/$track"; BOARD="$BIN/cc-board"; CLAUDE="${CC_CLAUDE:-$HOME/.local/bin/claude}"
# Host-side git on the worktree (the checkpoint, its push, cc done) runs the MAIN checkout's hooks, never the worktree's: with a
# relative core.hooksPath (core/.githooks) a hook is a tracked file the worker edits, and this loop would run it with the host's
# credentials, tmux and docker group — the very things the sandbox removes. Scoped to those calls, not exported: the worker's
# own environment stays exactly what it was (cc-sandbox promises that byte for byte when it is off).
hp=$(git -C "$HOME/dev/$repo" config --type=path --get core.hooksPath 2>/dev/null); case "$hp" in "") hp="$HOME/dev/$repo/.git/hooks";; /*) ;; *) hp="$HOME/dev/$repo/$hp";; esac
HG=(GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp")
mkdir -p "$ST/runs"; [ -s "$ST/task.md" ] || { echo "cc-loop: no task at $ST/task.md (use: cc $repo $track --go \"...\")" >&2; exit 2; }
[ -d "$WT" ] || { echo "cc-loop: no worktree $WT (run: cc $repo $track)" >&2; exit 2; }
touch "$ST/progress.md"; LOG="$ST/loop.log"; SNAP="$ST/.progress.snap"
log(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" | tee -a "$LOG" >&2; }
set -m   # each iteration runs in its own process group, so one kill takes claude AND everything it spawned
child=""
kill_child(){ [ -n "$child" ] || return 0   # only ever signal a group we own: if the child is not a group leader, kill just it
  if [ "$(ps -o pgid= -p "$child" 2>/dev/null | tr -d ' ')" = "$child" ]; then kill -TERM -- -"$child" 2>/dev/null; sleep 2; kill -KILL -- -"$child" 2>/dev/null
  else kill -TERM "$child" 2>/dev/null; fi; }
trap 'kill_child; log "signalled — iteration aborted and its claude killed"; exit 130' HUP INT TERM   # tmux kill-window would otherwise re-parent claude to systemd, still editing this worktree
stop(){ local code="$1" title="$2" msg="$3" st="${4:-blocked}"   # every non-zero exit leaves the board honest: a track nobody is working on is not "running"
  # …and `waiting` when it stopped to ASK, which is not the same thing as stopping. The loop is the first to know, so it
  # writes the same word cc-reconcile would 20 min later — otherwise the board says `blocked` while the Home tab, reading
  # the very journal line this exit came from, already says `waiting`, and the tab prints the two of them as drift.
  "$BOARD" status "$repo" "$track" "$st" >/dev/null 2>&1; "$BOARD" note "$repo" "$track" "loop exit $code: $msg" >/dev/null 2>&1
  log "exit $code: $msg"; "$BIN/cc-notify" -p high -t "$repo/$track $title" "$msg"; exit "$code"; }
base=$(git -C "$HOME/dev/$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##'); base="${base:-main}"
SP="You are an autonomous worker for track '$track' of repo '$repo', running headless in a loop: each iteration is a FRESH context. Durable state lives in files, not in your memory: the task is in $ST/task.md, your journal is $ST/progress.md (read it first; append a dated entry as you go, EARLY rather than at the end — an iteration that is cut short with nothing written leaves the next one blind: what you did, what is next, gotchas). Work on the next unfinished step only; keep changes committed-ready (a hook auto-commits and pushes to branch track/$track after you finish; do not run git commit/push yourself). Never touch branch '$base' or files outside this worktree. Board: 'cc board show $repo' and 'cc board note $repo $track \"...\"'. Before deciding the task is complete, re-read $ST/task.md in full — the owner/supervisor may have appended scope since this iteration began; if so, do that work first. When the WHOLE task (including appends) is complete, append the exact line 'STATUS: DONE' to progress.md. If you need an owner decision, append 'STATUS: BLOCKED: <one-line question>' and stop. Be concise in the journal.$(selfrev_block "$base")"
"$BOARD" status "$repo" "$track" running >/dev/null 2>&1 || true
i=0; errs=0; caps=0; spent=0; limited=0   # limited: the owner has already been told about THIS limit episode
barren=0; rounds=0; nocommit=0; sincecost=0; cn=0; ccost=0; prevsig=""   # the runaway rule's memory: this track measured against itself
chainend=0   # the end of the cc-model chain is journalled once per loop, not once per iteration
while [ $i -lt "$MAXI" ]; do
  if p=$("$BIN/cc-limit" status 2>/dev/null); then log "$p — waiting before starting (another run hit it)"   # a stamp any run on this box set
    "$BIN/cc-limit" wait || stop 8 "waiting" "Claude $p — longer than cc-loop waits (CC_LIMIT_MAX_WAIT); rerun with: cc $repo $track --go \"\""; fi
  i=$((i+1)); before_head=$(git -C "$WT" rev-parse HEAD 2>/dev/null); before_prog=$(md5sum "$ST/progress.md" | cut -c1-8); cp "$ST/progress.md" "$SNAP"
  cont=""; [ "$rounds" -gt 0 ] && cont=" This loop passed its original step limit and carried on because you are still committing work — pick up exactly where the journal stops."
  prompt=$(printf '# TASK\n%s\n\n# PROGRESS JOURNAL (latest last)\n%s\n\n# THIS ITERATION\nContinue from the journal. Do the next step. Journal it early, not at the end. Iteration %s of %s.%s\n' "$(cat "$ST/task.md")" "$(tail -c 6000 "$ST/progress.md")" "$i" "$MAXI" "$cont")
  args=(-p "$prompt" --permission-mode auto --max-turns "$TURNS" --max-budget-usd "$BUDGET" --output-format json --append-system-prompt "$SP")
  m="$MODEL"; [ -n "$m" ] || m=$("$BIN/cc-model" current 2>/dev/null)   # no explicit --model: follow the box's override (a Fable limit puts everything on Opus)
  [ -n "$m" ] && args+=(--model "$m"); [ -n "$EFFORT" ] && args+=(--effort "$EFFORT")
  # --resume-last, first iteration only: continue the session this track last ran instead of opening a cold one.
  # A fix round dispatched by the landing queue is the case it exists for — the worker already read this code and
  # paid for it, and a fresh context re-derives all of it before it can change one line. Iteration 2 onwards is
  # deliberately NOT resumed: this loop's own contract is a fresh context per step, and the journal is the handover.
  if [ "$RESUME" = 1 ] && [ "$i" = 1 ]; then
    if sid=$(last_session "$ST/runs"); then args+=(--resume "$sid"); log "iter 1 resumes session $sid (--resume-last)"
    else log "iter 1 was asked to resume, but no run of this track recorded a session id — starting fresh"; fi
  fi
  log "iter $i/$MAXI start (budget \$$BUDGET, turns $TURNS)"
  out="$ST/runs/$(date -u +%Y%m%dT%H%M%SZ)-$i.json"
  ( cd "$WT" && CC_ROLE=worker exec "$BIN/cc-sandbox" "$repo" "$track" -- timeout 3600 "$CLAUDE" "${args[@]}" > "$out" 2>"$out.err" ) &   # hard 1 h wall-clock per iteration; CC_WORKER_SANDBOX=1 wraps it in bwrap (cc-sandbox), otherwise that line is exec'd untouched
  child=$!; wait "$child"; rc=$?; child=""
  if lim=$("$BIN/cc-limit" check "$out" "$out.err"); then   # usage/rate limit: this iteration never happened — no errs, no stall, no cap
    resets=$(date -u -d "@${lim#LIMIT }" +%H:%M)
    log "usage limit — waiting until ${resets}Z, then rerunning iteration $i"
    [ "$limited" = 1 ] || { "$BIN/cc-notify" -t "$(hostname) limit" "Claude usage limit hit by $repo/$track — the loop is waiting, and resumes at ${resets}Z."; limited=1; }
    "$BIN/cc-limit" wait || stop 8 "waiting" "Claude usage limit until ${resets}Z — longer than cc-loop waits (CC_LIMIT_MAX_WAIT); rerun with: cc $repo $track --go \"\""
    i=$((i-1)); continue; fi
  limited=0; "$BIN/cc-limit" clear   # the API answered: whatever else went wrong, it was not a limit
  cost=$(jq -r '.total_cost_usd // 0' "$out" 2>/dev/null); iserr=$(jq -r '.is_error // false' "$out" 2>/dev/null)
  turns=$(jq -r '.num_turns // 0' "$out" 2>/dev/null); subtype=$(jq -r '.subtype // ""' "$out" 2>/dev/null)
  spent=$(awk -v a="$spent" -v b="${cost:-0}" 'BEGIN{printf "%.4f", a+b}')
  ( cd "$WT" && env "${HG[@]}" CC_ROLE=worker "$BIN/cc-checkpoint" ) || true
  ( cd "$WT" && env "${HG[@]}" CC_ROLE=worker "$BIN/cc-checkpoint" --push ) || true   # …and push whatever is ahead of origin even with nothing left to commit: inside the sandbox the Stop hook commits but cannot push (no credential), and only this line can
  after_head=$(git -C "$WT" rev-parse HEAD 2>/dev/null); after_prog=$(md5sum "$ST/progress.md" | cut -c1-8)
  moved=no; { [ "$before_head" != "$after_head" ] || [ "$before_prog" != "$after_prog" ]; } && moved=yes
  log "iter $i end rc=$rc err=$iserr/$subtype turns=$turns cost=\$$cost total=\$$spent commits=$([ "$before_head" != "$after_head" ] && echo yes || echo no) journal=$([ "$before_prog" != "$after_prog" ] && echo updated || echo unchanged)"
  [ "$QUIET" = 1 ] || jq -r '.result // ""' "$out" 2>/dev/null | tail -c 600 | sed 's/^/  │ /' >&2
  newprog=$(grep -vxFf "$SNAP" "$ST/progress.md" 2>/dev/null)   # only THIS iteration's lines count, even if the worker rewrote the file (a re-dispatched track must not "finish" on an old STATUS line)
  if grep -qE '^STATUS: DONE' <<<"$newprog"; then
    "$BOARD" note "$repo" "$track" "loop: DONE after $i iteration(s), \$$spent" >/dev/null 2>&1
    log "DONE"; dout=$(env "${HG[@]}" "$BIN/cc" done "$repo" "$track" 2>&1); drc=$?   # captured, never `| tail -1`: the pipe dropped the status
    printf '%s\n' "$dout" >> "$LOG"; dlast=$(printf '%s\n' "$dout" | grep -v '^[[:space:]]*$' | tail -1); printf '%s\n' "$dlast" >&2
    # DONE is the worker's word; done is `cc done`'s. A push a DNS blip killed, a lease refused: the loop used to notify DONE with
    # `PR: ` empty and exit 0, and the board went green over work no PR carried (monthly audit 2026-09-01 F3; 05:07Z janitor-containers).
    [ "$drc" = 0 ] || stop 4 "finished, but opened no PR" "the worker wrote STATUS: DONE, but cc done failed (rc $drc): ${dlast:-no output}. Fix the cause, then: cc done $repo $track"
    "$BIN/cc-notify" -t "$repo/$track done" "Track finished after $i iteration(s) (\$$spent). PR: $("$BOARD" get "$repo" "$track" pr)"; exit 0; fi
  if q=$(grep -E '^STATUS: BLOCKED' <<<"$newprog" | tail -1) && [ -n "$q" ]; then
    stop 3 "needs you" "$q  (answer: append it to $ST/task.md, drop the STATUS line from $ST/progress.md, then: cc $repo $track --go \"\")" waiting; fi
  if ctx_stopped "$newprog"; then
    log "iter $i ended itself at its context threshold — it journalled, so the next iteration continues from that"
  else
    rn=$(refusal_next "$out" "$out.err" "$m"); rnrc=$?; rwhy=${rn#*$'\t'}; nx=""; [ "$rnrc" = 0 ] && nx=${rn%%$'\t'*}
    case "$(refusal_step "$rnrc" "$moved")" in
      rerun)   # nothing to show for it: the same model asked again gives the same answer
        log "refused or rerouted on ${m:-the box default} ($rwhy) — nothing produced, so iteration $i reruns on $nx"
        refusal_note "$i" "$m" "$nx" "$rwhy" rerun >> "$ST/progress.md"   # the next fresh context has to know why its model changed
        "$BOARD" note "$repo" "$track" "model refused or rerouted ($rwhy) — now on $nx" >/dev/null 2>&1
        MODEL="$nx"; i=$((i-1)); continue;;
      count)   # F4: it committed, or it wrote the journal. Rerunning it would redo work the next context can read.
        log "refused or rerouted on ${m:-the box default} ($rwhy) — but iteration $i produced work, so it counts${nx:+ and the model moves to $nx}"
        if [ "$rnrc" = 0 ] || [ "$chainend" = 0 ]; then   # the end of the chain is said once, not once per iteration
          refusal_note "$i" "$m" "$nx" "$rwhy" kept >> "$ST/progress.md"
          "$BOARD" note "$repo" "$track" "model refused or rerouted ($rwhy) — ${nx:+now on $nx}${nx:-no model left on the chain, but the work stands}" >/dev/null 2>&1; fi
        [ "$rnrc" = 2 ] && chainend=1
        [ -n "$nx" ] && MODEL="$nx"; :;;   # …and on into the normal accounting below: this iteration is like any other
      stop)
        refusal_note "$i" "$m" "" "$rwhy" stopped >> "$ST/progress.md"
        stop 10 "was refused" "Every model on the cc-model chain refused or was rerouted (last: ${m:-the box default}; ${rwhy:-refused}) and the last one produced nothing. The task is not the problem — check the models, then: cc $repo $track --go \"\"";;
    esac
  fi
  if [[ "$subtype" == error_max_* ]] && [ "$moved" = yes ]; then errs=0; caps=0; log "capped ($subtype) but the iteration produced work — not an error, continuing"
  elif [[ "$subtype" == error_max_* ]]; then caps=$((caps+1)); log "capped ($subtype) with nothing to show ($caps)"
       [ $caps -ge 2 ] && stop 7 "hit its cap" "Two capped iterations with no commits or journal change (\$$spent). Raise --budget/--turns or split the task; log: $LOG"
  elif [ "$rc" != 0 ] || [ "$iserr" = true ]; then errs=$((errs+1)); log "error ($errs): $( { head -c 300 "$out.err" 2>/dev/null; [ -s "$out.err" ] || jq -r '"\(.subtype // "")\ \(.result // "" | tostring)"' "$out" 2>/dev/null | head -c 300; } | tr '\n' ' ')"   # a run that errored in-band leaves .err empty: say why from the json
       [ $errs -ge 2 ] && stop 5 "errored" "2 consecutive failures; see $LOG"
  else errs=0; caps=0; fi
  # ── the runaway rule: progress-free SPEND, and every number it uses comes from this track's own history ──
  committed=no; [ "$before_head" != "$after_head" ] && committed=yes
  sig=$(jq -r '"\(.subtype // "")|\(.is_error // false)|\((.result // "")|tostring)"' "$out" 2>/dev/null | tr -d '\n' | head -c 160)
  if [ "$committed" = yes ]; then cn=$((cn+1)); ccost=$(awk -v a="$ccost" -v b="$sincecost" -v c="${cost:-0}" 'BEGIN{printf "%.4f", a+b+c}'); sincecost=0; nocommit=0
  else sincecost=$(awk -v a="$sincecost" -v b="${cost:-0}" 'BEGIN{printf "%.4f", a+b}'); nocommit=$((nocommit+1)); fi
  yard=$(awk -v c="$ccost" -v n="$cn" -v b="$BUDGET" 'BEGIN{printf "%.4f", (n>0 ? c/n : b)}')   # what an iteration that DID commit costs this track; before the first one, its own budget
  why=""
  if [ "$moved" = no ]; then why="committed nothing and left the journal untouched"
  elif [ "$committed" = no ] && [ -n "$prevsig" ] && [ "$sig" = "$prevsig" ]; then why="repeated the previous iteration's outcome word for word, with nothing committed"
  elif [ "$nocommit" -ge 2 ] && awk -v s="$sincecost" -v y="$yard" -v x="$RUNX" 'BEGIN{exit !(y > 0 && s >= x * y)}'; then
    why="spent \$$sincecost since its last commit — ${RUNX}x what a committed iteration costs this track (\$$yard)"; fi
  prevsig="$sig"
  if [ -n "$why" ]; then barren=$((barren+1)); log "runaway signal $barren/$RUNN: $why"
    [ "$barren" -ge "$RUNN" ] && stop 9 "is running away" "$RUNN iterations in a row with nothing to show for the money: $why. That is $i iterations, \$$spent, last commit $nocommit iteration(s) ago. Nothing capped it — the work itself stopped moving. Read $LOG, then re-scope the task or stop the track."
  else barren=0; fi
  # The step limit is a checkpoint, not a verdict: still committing means still working, and nothing caps the spend.
  # Under --no-extend it IS the verdict: a caller that bounded the round (cc-land's fix round) gets its bound.
  if [ $i -ge "$MAXI" ] && [ "$committed" = yes ] && [ "${NOEXT:-0}" != 1 ]; then
    rounds=$((rounds+1)); MAXI=$((MAXI + BATCH))
    log "step limit reached with work committed — carrying on for $BATCH more (round $rounds, \$$spent)"
    "$BOARD" note "$repo" "$track" "picked itself up at the step limit: $i iterations, \$$spent, still committing" >/dev/null 2>&1; fi
done
stop 6 "paused" "Hit $MAXI iterations (\$$spent) and the last one committed nothing, so it did not carry itself on. Continue with: cc $repo $track --go \"\" --loop N"
