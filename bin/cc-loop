  mkdir -p "$d/dtb" "$d/dtok" "$d/dtno"; printf '#!/bin/sh\n[ "$1" = note ] && printf "%%s\\n" "$*" >> "%s"; exit 0\n' "$d/dt.board" > "$d/dtb/cc-board"
