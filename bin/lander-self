#!/usr/bin/env python3
"""lander-self — land a change to the lander itself, and move the release the lander runs.

The lander refuses a PR that touches its gate paths (the `lander` list in the base's tests/LANDING-policy.toml) and
sends it here; the rest of the lander lands through the lane on one paid read. This file imports no code from
lander/: a change to the lander cannot change how it is judged. (The reverse holds: the lane loads this file for
binaries(), so both lanes refuse the same compiled files.)
A planning seat runs it by hand; the lander never installs itself.

    lander-self pin [--repo DIR] [--rev REV]
        Copy lander-self as committed at REV (default origin/main) to ~/.cc/lander/self/<sha>/ and point
        self/current at it. Every other command, run from a checkout, re-execs that pinned copy, so a checkout
        edited in place never runs. With no pin they refuse (exit 3). Pin and promote both first pin, in
        remotes.json, the URL of the GitHub repo each checkout's origin names (this one and every board repo's),
        once: every fetch, ls-remote and push of the lander and of lander-self goes there, never to "origin".
    lander-self check <repo> <pr> [--repo-dir DIR]
        (cc-guard keeps this, like land/promote/rollback/pin, from a worker: it fetches a PR and runs its code.)
        Refuses the PR whole unless: every changed path is on the base's `lander` list or under the lander's own
        tree (LANDER_TREE: core/lander, core/tests/lander); no path it adds or changes anywhere is a __pycache__
        path, a .pyc, .pyo, .so or .pyd, none under core/ or bin-private/ (or either one itself) is a symlink or
        binary (a NUL in its first 8000 bytes), none outside config/system/ is a symlink, and no executable
        (mode 100755) anywhere is binary:
        binaries(), which the ordinary lane loads from this file and runs on every PR too; perms'
        own ledger (~/.cc/state/<repo>/perms/security-reads.json, review.py's perms_reads) records a security read
        of exactly the PR's head, never a PR marker, and a LAND record by another reader stands at that head
        (`lander record --by`, which cc-guard keeps closed to workers); the merge tree's tests/check-extra.sh (`core-identity`: no
        box identity in core/) and the candidate's own tests (`<core>/bin/lander selfcheck` and `<core>/tests/lander`)
        pass on the merge tree inside bwrap (no network, empty HOME, no ~/.cc). Then prints a
        shadow plan: every job in the live queue planned by the current release and by the candidate, side by
        side, also inside bwrap. A job the current release plans and the candidate cannot is a refusal.
        Exit 0 passed, 1 refused, 3 could not run.
    lander-self land <repo> <pr> [--repo-dir DIR]
        check, then `gh pr merge --squash --match-head-commit <head> --delete-branch`. It does not promote. Then
        it runs the current release's `lander settle-merged <repo> <pr> --by lander-self` (its own process), which
        moves the PR's query job to merged and writes the lane's merged line; a release without that command, or
        none, leaves it to the lander tick's `ended` sweep, and the land still exits 0.
    lander-self promote [REV] [--repo DIR] [--pr N] [--cap SECONDS] [--no-prove]
        Build ~/.cc/lander/releases/<sha>/ from `git archive` of REV (default origin/main) — committed code only,
        less any __pycache__, .pyc, .pyo, .so, .pyd or binary file it tracks (not_source: a tracked unchecked-hash
        .pyc or an extension module would run in place of its .py), plus the repo's
        tests/landing-repos/ (the host fallback manifests the lander reads for a repo that ships
        none) — run that release's `lander selfcheck`, then prove it on main: the release's own `lander sweep` runs
        every check in origin/main's manifest on this host as its lane runs them (each class's box runner, cc-nosignal
        unless the check is bare, an admission slot and a scope), what it does not pass runs once more under it and
        then under the current release, and any check green under the current release and red or unrunnable under the
        new one refuses the switch by name (a check red under both is main's and does not block; with nothing
        current, nothing does). Main's list of checks is read by the current release's manifest loader, and a name on
        it the candidate did not run refuses too. A check the current release has a `passed` record for on main's
        exact tree (the lane's shared results/ under ~/.cc/state/land, stamped with that release; never a job's
        own records), resolved with replace refs ignored, is taken as the candidate's pass and not swept again, but
        only when the two releases run checks with byte-identical code (every core/lander/*.py and core/*.py, the
        tools run.py execs, cc-config and the fallback manifests); otherwise every check is swept. A name on main's list is either reused or run, and the proof
        prints how many of each. Each sweep runs as a transient `systemd-run --user` service, as the
        lane does: the user manager's environment, a private TMUX_TMPDIR, and none of the caller's tmux, CC_*
        variables, sandbox or Landlock domain. The proof is one run capped at PROVE_CAP (an hour); `--cap SECONDS`
        sets another for this run only, at most PROVE_CAP_MAX (4 h; more is refused, exit 2). While it runs it HOLDS THE LANE (perms, 10-13): a ticket in the landing
        queue that sorts before every lane ticket (hold_lane), so no new check of the lane's takes a box slot while
        the ones already running finish, and the candidate's sweep, told the ticket's name, waits only behind what
        was there first. The hold goes when the proof ends, however it ends: lander-self drops it, and a crash drops
        its flock, which makes the next waiter remove it. No hold for a release whose admission does not read
        LANDER_PROVE_HOLD (its sweep would wait behind it), so the current release's comparison sweep runs unheld.
        Exit 1 refused, 3 when the proof gave no verdict (the cap, a sweep that did not finish); current is
        unchanged either way.
        Only if all of that is green point `current` at it, keeping the one before as `previous`. A releases/<sha>
        already there is rebuilt beside it and kept only when the two trees are byte-identical; otherwise the fresh build replaces it (a planted or edited release never runs).
        REV must be origin/main or an ancestor of it. THE ONE EXCEPTION is the cutover's step 5, which promotes the
        switch PR's head before it merges: `--pr N` allows a REV that is not on main only when it is exactly the
        head GitHub names for OPEN PR #N, and only for a caller that is not a worker or a member session (CC_ROLE,
        or a .cc/track or .cc/member-facing marker above the cwd). Clears a legacy rollback. Promote never kills a
        lane: before its next job each lane sees `current` moved, takes nothing new and starts a lane from the new
        release, so the job in flight ends on the old one and the next job runs the new one. It names the lanes
        running when it moves `current`. Only the perms seat promotes: the Claude session that runs it must work in
        <passwd home>/.cc/state/<repo>/perms (<repo> the checkout's directory name), the check `lander record --by
        perms-*` makes, or it is refused (exit 1) before anything is built.
        --no-prove skips the proof on main (its sweeps and its lane hold) and nothing else: the perms check, the
        build, the release's own selfcheck and `previous` all stand, and the promoted line says the proof was
        skipped (owner, 2026-10-13 17:33Z: a fix to the lander must not wait on the proof sweep). It refuses `--pr`
        (exit 2, before anything is built), so an unproven release is always built from a commit on origin/main.
        Every promote that switches appends a line to ~/.cc/lander/promote.log (time, sha, `proven` or `no-prove`,
        the calling Claude session's pid and cwd) before it moves `current`, and refuses with current unchanged if it
        cannot; `status` reads it to say whether the live release was proven. Nothing is written into the release
        directory, whose tree is compared byte for byte.
    lander-self prove [REV] [--repo DIR] [--pr N] [--cap SECONDS]
        promote without the switch: the same refusals for REV, its selfcheck and the proof on main (and its hold),
        against
        `current` (against nothing when REV is current). Run it on a host before that host takes over landing.
        Since the proof holds the lane, only the perms seat proves, by promote's caller check; any other seat is
        refused (exit 1) before anything is built or held. Exit 0 proven, 1 refused, 3 could not run.
    lander-self reads [REV] [--repo DIR]
        The commits perms reads before a promote: those from the current release to REV (default origin/main) that
        touch a path on origin/main's `lander` list in tests/LANDING-policy.toml, one `<sha12> <subject>` per line,
        then how many others there were (since #1277 those land on one paid read). Exit 0, 3 could not list them.
    lander-self sweep [REV] [--repo DIR]
        The periodic sweep (alert only, it never reverts): every path in the tree at REV (default origin/main, as
        fetched from the pinned remote and matched against ls-remote) that `check` would refuse were it new — a
        compiled name anywhere, a binary or gitlink under core/ or bin-private/, an executable binary anywhere — and
        each symlink outside config/system/ whose target names a compiled path or resolves to one of those, or out
        of the repo from under core/ or bin-private/. A plain .png under core/docs/ that opens with PNG's signature
        is let stand (PICTURES), here and in `check`. One path per line, then a summary line. Exit 0 clean, 2 found
        (a cc-watch check's BAD), 3 could not run. The shipped watcher config/watch/lander-sweep.json runs it hourly
        through `cc-watch run`, and a BAD posts to #alerts once.
    lander-self rollback [--legacy]
        Point `current` back at `previous` (and `previous` at what current was). --legacy instead sends every
        `cc-land` call to the release pinned by `lander-self legacy` (the old lander, before the switch), and first
        hands the queue back to it: it refuses while a lane of the new lander is running; moves the new lander's
        job files, its inbox and its handed-back watches to <state>/post-cutover/<stamp>/; puts back into <state>
        every job exported at the cutover (pre-cutover/*.json) that the new lander never took up, and the old
        handed-back watches; and prints — and writes to post-cutover/<stamp>/requeue.txt — one `cc-land queue`
        line for each PR the new lander still had in flight or waiting, to run once the switch is made.
    lander-self legacy REV [--repo DIR]
        Pin REV's tree as the legacy release, for `rollback --legacy`. Run it at cutover with the commit before
        the switch.
    lander-self shadow [REV] [--repo DIR]
        The cutover's first step: plan every job in the live queue with the release REV would build (default
        origin/main), and with the current release beside it when there is one, both in bwrap. A job whose file
        names no head (the old lander's files do not) takes its head from GitHub and its base from origin/main.
        Exit 1 when the candidate cannot plan a job it was given a head for, 0 otherwise, 3 when it could not run.
    lander-self status
        The links; whether `current` was proven (`yes`, `no` with when and who promoted it with --no-prove, or
        `unknown` when promote.log holds no line for it, as for a release promoted before the log); then each
        running lane: its repo, pid, the release it runs from, and `current` or `STALE` (a
        stale lane switches before its next job; one still stale after its job ended predates that switch).
    lander-self selfcheck

Layout under ~/.cc/lander: releases/<sha>/core (+ tests/landing-repos), current -> releases/<sha>,
previous -> releases/<sha>, remotes.json (realpath of a checkout -> the URL the lander fetches it from),
self/<sha>/lander-self, self/current -> self/<sha>, legacy/<sha>/<core>, legacy-on -> legacy/<sha>, repo (the
checkout releases are built from). A release is always laid out with the core tree under `core/`, whatever prefix
the repo keeps it under, because bin/lander execs `current/core/lander/cli.py`.
"""
import datetime
import fcntl
import io
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
ROOT = os.path.join(HOME, ".cc", "lander")
ME = os.path.realpath(__file__)
REPO_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9._-]{0,63}$")
SHA_RE = re.compile(r"^(?:[0-9a-f]{40}|[0-9a-f]{64})$")
MARK_RE = re.compile(r"\A\s*<!-- cc-land-review v2 change=[0-9a-f]+ [^>]*?\bhead=([0-9a-f]+) [^>]*?"
                     r"\bverdict=([A-Z-]+) by=([A-Za-z0-9._@-]+) -->")
DONE = {"done", "merged", "deployed", "deploy-pending", "handback"}
TEST_CAP = 1800
# One more claude versions root, read only from this root-owned file (never cc-config or the environment, which a seat
# writes); the owner creates it, this file never does. The lander's review.CLAUDE_VERSIONS_FILE, copied.
CLAUDE_VERSIONS_FILE = "/etc/cc/claude-versions"


def die(msg, rc=1):
    print(f"lander-self: {msg}", file=sys.stderr)
    return rc


def sh(argv, cwd=None, timeout=600, **kw):
    try:
        p = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, **kw)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout}s"
    except OSError as e:
        return 127, "", str(e)


def git(root, *a, timeout=300):
    return sh(["git", "-C", root, *a], timeout=timeout)


def git_lock(root):
    """The checkout's repo lock, `.git/cc-land.lock` of the main gitdir, the file cc-publish and the lane take
    around anything that writes FETCH_HEAD. Returns the open file; closing it releases the lock."""
    rc, out, _ = git(root, "rev-parse", "--git-common-dir")
    gd = os.path.join(root, out.strip()) if rc == 0 else os.path.join(root, ".git")
    f = open(os.path.join(os.path.realpath(gd), "cc-land.lock"), "a")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f


# --- the remotes the lander holds ------------------------------------------------------------------------------------
# The lander never fetches, ls-remotes or pushes "origin" as the checkout's shared .git/config names it: a worker can
# repoint that, unset its fetch refspec or plant refs/remotes/origin/<b>. pin and promote write ROOT/remotes.json
# (realpath of a checkout -> URL) for this checkout and every board repo's, from `gh repo view`'s URL for the
# GitHub repo origin names. An entry is never overwritten: a checkout whose origin later names another repo keeps
# the URL pinned first (to change it, a person edits remotes.json). A checkout with no entry is refused.

ALLOW_LOCAL = False   # the selfcheck's bare repos; nothing outside this process can set it
GH_URL_RE = re.compile(r"^(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)"
                       r"([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$")
GH_PIN_RE = re.compile(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+?(?:\.git)?")


def load_remotes():
    try:
        pins = json.load(open(os.path.join(ROOT, "remotes.json")))
    except (OSError, ValueError):
        return {}
    return {k: v for k, v in pins.items() if isinstance(k, str) and isinstance(v, str) and v} \
        if isinstance(pins, dict) else {}


def remote_for(root):
    """The pinned URL for root; '' when none, or when a url.<x>.insteadOf / pushInsteadOf in the config git reads
    for root would send it elsewhere (the shared .git/config is a worker's to write)."""
    url = load_remotes().get(os.path.realpath(root), "")
    if not (GH_PIN_RE.fullmatch(url) or ALLOW_LOCAL and os.path.isabs(url)):
        return ""   # remotes.json is a file a worker could reach: only a GitHub https URL is taken from it
    # -z: records are NUL-separated, key and value split at the first newline, so a subsection with a space in it
    # (url./tmp/e x.insteadof) cannot shift where the value starts
    rc, out, _ = git(root, "config", "-z", "--get-regexp", r"^url\..*\.(push)?insteadof$")
    if rc not in (0, 1) or any(v and url.startswith(v) for v in (rec.partition("\n")[2]
                                                                 for rec in out.split("\0") if rec)):
        return ""
    return url


def url_to_pin(root):
    """The URL to pin for root: the GitHub repo origin names, as `gh repo view` gives its URL; '' otherwise."""
    rc, out, _ = git(root, "remote", "get-url", "origin")
    url = out.strip() if rc == 0 else ""
    m = GH_URL_RE.match(url)
    if m:
        rc, out, _ = sh(["gh", "repo", "view", f"{m[1]}/{m[2]}", "--json", "url", "-q", ".url"], timeout=60)
        u = out.strip().rstrip("/") if rc == 0 else ""
        return u + ".git" if re.fullmatch(r"https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", u) else ""
    return url if ALLOW_LOCAL and os.path.isabs(url) else ""


def board_roots():
    """Every checkout the lander may land into: each board repo's `path` and $CC_DEV/<repo>, where they exist.
    A member workspace's repo (<h>--<t>) is cloned by the lander itself and is not pinned here."""
    d = os.environ.get("CC_BOARDS") or os.path.join(HOME, ".cc", "boards")
    dev = os.environ.get("CC_DEV") or os.path.join(HOME, "dev")
    out = []
    for f in sorted(os.listdir(d)) if os.path.isdir(d) else []:
        repo = f[:-len(".json")]
        if not f.endswith(".json") or not REPO_RE.match(repo) or "--" in repo:
            continue
        try:
            b = json.load(open(os.path.join(d, f)))
        except (OSError, ValueError):
            continue
        for r in ((b.get("path") if isinstance(b, dict) else "") or "", os.path.join(dev, repo)):
            if r and os.path.exists(os.path.join(r, ".git")) and os.path.realpath(r) not in out:
                out.append(os.path.realpath(r))
    return out


def pin_remotes(root):
    """Pin a URL for root and every board checkout that has none. -> the lines to print."""
    pins, lines, new = load_remotes(), [], 0
    for r in [os.path.realpath(root)] + [b for b in board_roots() if b != os.path.realpath(root)]:
        if r in pins:
            rc, out, _ = git(r, "remote", "get-url", "origin")
            m, p = GH_URL_RE.match(out.strip() if rc == 0 else ""), GH_URL_RE.match(pins[r])
            if m and p and (m[1].lower(), m[2].lower()) != (p[1].lower(), p[2].lower()):
                lines.append(f"{r}: origin now names {m[1]}/{m[2]}; the lander keeps {pins[r]} (edit "
                             f"{ROOT}/remotes.json by hand to change it)")
            continue
        url = url_to_pin(r)
        if url:
            pins[r], new = url, new + 1
            lines.append(f"{r}: pinned {url}")
        else:
            lines.append(f"{r}: origin is not a GitHub repo gh can view; the lander will not fetch it")
    if new:
        os.makedirs(ROOT, exist_ok=True)
        tmp = os.path.join(ROOT, f".remotes.json.{os.getpid()}")
        with open(tmp, "w") as f:
            json.dump(pins, f, indent=1, sort_keys=True)
        os.replace(tmp, os.path.join(ROOT, "remotes.json"))
    return lines


def gh_repo(root):
    """["-R", owner/name] for the GitHub repo pinned for root, so gh never takes its repo from the shared config."""
    m = GH_URL_RE.match(remote_for(root))
    return ["-R", f"{m[1]}/{m[2]}"] if m else []


def fetch(root, *refs):
    """Fetch from the URL pinned for root: a branch b into refs/remotes/origin/b (a forced refspec, so no config of
    the checkout's decides where it lands), pull/<n>/head into FETCH_HEAD only. False on no pin or a failed fetch."""
    url = remote_for(root)
    if not url:
        return False
    specs = [f"refs/{r}" if r.startswith("pull/") else f"+refs/heads/{r}:refs/remotes/origin/{r}" for r in refs]
    lk = git_lock(root)
    try:
        return git(root, "fetch", "-q", url, *specs)[0] == 0
    finally:
        lk.close()


def main_sha(root, branch="main"):
    """origin's <branch> as this box may trust it: the fetch from the pinned URL went through, and
    refs/remotes/origin/<branch> is the very sha `git ls-remote <pinned URL> refs/heads/<branch>` names. '' on any
    doubt."""
    if not fetch(root, branch):
        return ""
    local = resolve(root, f"refs/remotes/origin/{branch}")
    rc, out, _ = git(root, "ls-remote", remote_for(root), f"refs/heads/{branch}")
    remote = [ln.split("\t")[0] for ln in out.splitlines() if ln.endswith(f"\trefs/heads/{branch}")] if rc == 0 else []
    return local if local and remote == [local] else ""


# --- layout --------------------------------------------------------------------------------------------------------

def link_target(name):
    p = os.path.join(ROOT, name)
    return os.path.realpath(p) if os.path.islink(p) else ""


def swap(name, target):
    """Point ROOT/name at target atomically (a new symlink renamed over the old)."""
    os.makedirs(ROOT, exist_ok=True)
    tmp = os.path.join(ROOT, f".{name}.{os.getpid()}")
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, os.path.join(ROOT, name))


def unlink(name):
    p = os.path.join(ROOT, name)
    if os.path.islink(p):
        os.unlink(p)


def repo_of(opt=""):
    if opt:
        return os.path.realpath(opt)
    try:
        return open(os.path.join(ROOT, "repo")).read().strip()
    except OSError:
        pass
    rc, out, _ = git(os.path.dirname(ME), "rev-parse", "--show-toplevel")
    return out.strip() if rc == 0 else ""


def core_prefix(root, sha):
    """'core/' when the repo keeps the core tree under core/, '' when the core tree is the repo."""
    rc, _, _ = git(root, "cat-file", "-e", f"{sha}:core/lander/cli.py")
    return "core/" if rc == 0 else ""


def resolve(root, rev):
    """A commit sha for rev. origin/<b> is read as refs/remotes/origin/<b> in full, so a local branch someone named
    origin/<b> (refs/heads/origin/<b>) never stands in for it."""
    if rev.startswith("origin/"):
        rev = "refs/remotes/" + rev
    for r in ([rev] if rev else ["refs/remotes/origin/main", "refs/remotes/origin/HEAD", "HEAD"]):
        rc, out, _ = git(root, "rev-parse", "--verify", "-q", f"{r}^{{commit}}")
        if rc == 0:
            return out.strip()
    return ""


def tree_digest(d):
    """sha256 over every entry under d: its path, its kind (dir, link and target, file and exec bit) and a file's
    bytes. Two builds of one commit are equal; a release anyone edited, or a link planted in it, is not."""
    import hashlib
    h = hashlib.sha256()
    for top, dirs, files in os.walk(d):
        dirs.sort()
        for n in sorted(dirs + files):
            p = os.path.join(top, n)
            rel = os.path.relpath(p, d)
            if os.path.islink(p):
                h.update(f"L {rel} {os.readlink(p)}\n".encode())
            elif os.path.isdir(p):
                h.update(f"D {rel}\n".encode())
            else:
                h.update(f"F {rel} {os.stat(p).st_mode & 0o111 and 'x' or '-'}\n".encode())
                with open(p, "rb") as f:
                    h.update(hashlib.sha256(f.read()).digest())
    return h.hexdigest()


def drop_compiled(d):
    """Remove every entry under d that is not source (not_source, the rule binaries() refuses a PR by): a __pycache__
    of any kind, a .pyc, .pyo, .so or .pyd, or a file with a NUL in its first 8000 bytes (a link is judged by its name
    and target, never followed). -> the paths removed, relative to d.
    Opus read of #1296: a tracked core/lander/__pycache__/run.cpython-314.pyc compiled UNCHECKED_HASH is what
    `import lander.run` loads, never looking at run.py, while the reuse hashes only run.py (runtime pycs differ, so
    __pycache__ is not hashed); and Python takes core/lander/run.cpython-*.so before run.py (Opus read of #1298).
    With none in the build, a __pycache__ in a release is one Python wrote from its .py."""
    out = []
    for top, dirs, files in os.walk(d):
        for n in dirs + files:
            p = os.path.join(top, n)
            rel = os.path.relpath(p, d)
            if os.path.isdir(p) and not os.path.islink(p):
                if n != "__pycache__":
                    continue
                shutil.rmtree(p)
            else:
                if os.path.islink(p):
                    data = os.fsencode(os.readlink(p))
                else:
                    with open(p, "rb") as f:
                        data = f.read(8000)
                if not not_source(rel, data):
                    continue
                os.unlink(p)
            out.append(rel)
        dirs[:] = [x for x in dirs if os.path.isdir(os.path.join(top, x))]
    return sorted(out)


def build(root, sha, kind, must="lander/cli.py"):
    """ROOT/<kind>/<sha>/core/ from `git archive` of the commit's core tree, which must hold `must`, and — when the
    repo keeps core under core/ — <sha>/tests/landing-repos/ from the same commit (the host fallback manifests).
    Every file the commit tracks that is not source is left out (drop_compiled), so the release runs its source.
    Always built afresh: a <sha> dir already there is kept only when it is byte-identical to the new build
    (tree_digest), else replaced — so a release planted or edited under ROOT never runs. Returns the release dir;
    raises RuntimeError."""
    if not SHA_RE.match(sha or ""):
        raise RuntimeError(f"{sha!r} is not a commit sha")
    dest = os.path.join(ROOT, kind, sha)
    pre = core_prefix(root, sha)
    os.makedirs(os.path.join(ROOT, kind), exist_ok=True)
    tmp = tempfile.mkdtemp(prefix=f".{sha[:12]}.", dir=os.path.join(ROOT, kind))
    os.makedirs(os.path.join(tmp, "core"))
    arch = subprocess.run(["git", "-C", root, "archive", "--format=tar", f"{sha}:{pre.rstrip('/')}" if pre else sha],
                          capture_output=True)
    if arch.returncode != 0:
        shutil.rmtree(tmp, ignore_errors=True)
        raise RuntimeError(f"git archive {sha[:12]} failed: {arch.stderr.decode()[-300:]}")
    x = subprocess.run(["tar", "-x", "-C", os.path.join(tmp, "core")], input=arch.stdout, capture_output=True)
    if x.returncode != 0 or not os.path.isfile(os.path.join(tmp, "core", must)):
        shutil.rmtree(tmp, ignore_errors=True)
        raise RuntimeError(f"{sha[:12]} holds no {must} under its core tree")
    if pre and git(root, "cat-file", "-e", f"{sha}:tests/landing-repos")[0] == 0:
        fb = os.path.join(tmp, "tests", "landing-repos")
        os.makedirs(fb)
        a2 = subprocess.run(["git", "-C", root, "archive", "--format=tar", f"{sha}:tests/landing-repos"],
                            capture_output=True)
        x2 = subprocess.run(["tar", "-x", "-C", fb], input=a2.stdout, capture_output=True) if not a2.returncode else a2
        if x2.returncode != 0:
            shutil.rmtree(tmp, ignore_errors=True)
            raise RuntimeError(f"{sha[:12]}'s tests/landing-repos would not extract")
    dropped = drop_compiled(tmp)
    if dropped:
        print(f"lander-self: {sha[:12]} tracks {len(dropped)} compiled or binary path(s) ({', '.join(dropped[:4])}); the "
              "release leaves them out, so it runs its .py source", file=sys.stderr)
    if os.path.isdir(dest) and not os.path.islink(dest) and tree_digest(dest) == tree_digest(tmp):
        shutil.rmtree(tmp, ignore_errors=True)
        return dest
    if os.path.lexists(dest):
        old = os.path.join(ROOT, kind, f".{sha[:12]}.old.{os.getpid()}")
        os.rename(dest, old)
        os.rename(tmp, dest)
        if os.path.islink(old):
            os.unlink(old)
        else:
            shutil.rmtree(old, ignore_errors=True)
        print(f"lander-self: {kind}/{sha[:12]} did not match a fresh build of that commit; replaced it",
              file=sys.stderr)
        return dest
    os.rename(tmp, dest)
    return dest


# --- pin -----------------------------------------------------------------------------------------------------------

def cmd_pin(args, opts):
    root = repo_of(opts.get("repo", ""))
    if not root:
        return die("pin: no checkout to pin from (--repo DIR)", 2)
    rel = os.path.relpath(ME, root) if ME.startswith(root + "/") else ""
    rel = rel or "core/bin/lander-self"
    for ln in pin_remotes(root):
        print(f"lander-self: {ln}")
    main = main_sha(root)
    if not main:
        return die(f"pin: cannot fetch origin/main in {root}, or it differs from what origin names", 2)
    sha = resolve(root, opts.get("rev", "")) if opts.get("rev") else main
    if not sha:
        return die(f"pin: cannot resolve {opts.get('rev')} in {root}", 2)
    rc, body, err = git(root, "show", f"{sha}:{rel}")
    if rc != 0:
        rel = "bin/lander-self"
        rc, body, err = git(root, "show", f"{sha}:{rel}")
    if rc != 0:
        return die(f"pin: {sha[:12]} has no lander-self: {err.strip()[-200:]}")
    d = os.path.join(ROOT, "self", sha)
    os.makedirs(d, exist_ok=True)
    p = os.path.join(d, "lander-self")
    with open(p + ".tmp", "w") as f:
        f.write(body)
    os.chmod(p + ".tmp", 0o755)
    os.replace(p + ".tmp", p)
    _swap_self(d)
    with open(os.path.join(ROOT, "repo"), "w") as f:
        f.write(root + "\n")
    print(f"lander-self: pinned lander-self at {sha[:12]} ({p})")
    return 0


def _swap_self(d):
    os.makedirs(os.path.join(ROOT, "self"), exist_ok=True)
    tmp = os.path.join(ROOT, "self", f".current.{os.getpid()}")
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(d, tmp)
    os.replace(tmp, os.path.join(ROOT, "self", "current"))


# --- promote / rollback / legacy -----------------------------------------------------------------------------------

def release_green(rel):
    rc, out, err = sh([sys.executable, "-P", os.path.join(rel, "core", "lander", "cli.py"), "selfcheck"],
                      timeout=900, env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"})
    tail = (out + err).strip().splitlines()[-1:] or ["no output"]
    return rc == 0, tail[0]


# --- the proof on main: every check of origin/main, run by the candidate as its lane would run it ------------------
# The owner, 10-12: main went red because #1024 (host checks under cc-nosignal) went live without anyone running
# every check on main under it. Before `current` moves, the candidate release's own `lander sweep` runs every check in
# origin/main's manifest on this host, each on the box's runner for its class (bwrap for static, hermetic and timing;
# the host under cc-nosignal unless the check says bare = true), inside an admission slot and a transient scope:
# run(), the code the lane calls per check. A check whose `where` has no box is unrunnable there under both releases
# and so decides nothing. Only what the candidate does not pass is looked at again: once more under the candidate (a
# red that does not repeat is not the release's, the lane's own rerun rule), then under the current release. "Refuse
# the switch, naming the checks, if any check green under the current release is red under the candidate"; a check
# red under the current release too is main's and does not block. One bounded run: PROVE_CAP for all of it. Main's
# list of checks is the current release's reading of the manifest, and every sweep runs as a user unit (sweep_under).

PROVE_CAP = 3600
# --cap's ceiling: a proof holds the lane for as long as it runs (THE HOLD), so no run may ask for more than 4 h,
# a third of a lane ticket's 12 h TICKET_CAP (perms' read of #1302).
PROVE_CAP_MAX = 4 * PROVE_CAP
SWEEP_LINE = re.compile(r"^lander sweep: (\S+) (passed|failed|unrunnable) \d+s$", re.M)
SEAT_ENV = ("TMUX", "TMUX_PANE", "TMUX_TMPDIR", "STY", "WINDOW")


def prove_env():
    """The caller's environment less its seat: no tmux or screen of the pane it was started from and no CC_* (the
    seat's role, alias, channel), and XDG_RUNTIME_DIR at /run/user/<uid> where `systemd-run --user` finds the
    manager. Only the systemd-run client and the manifest parse get it; the sweep itself gets the manager's own."""
    env = {k: v for k, v in os.environ.items() if k not in SEAT_ENV and not k.startswith("CC_")}
    run = f"/run/user/{os.getuid()}"
    if os.path.isdir(run):
        env["XDG_RUNTIME_DIR"] = run
    return {**env, "PYTHONDONTWRITEBYTECODE": "1"}


def passwd_home():
    """The passwd home, as cards.PASSWD_HOME reads it. Read here and not imported: pin copies lander-self alone to
    self/<sha>/, with no lander/ beside it (correctness read of 2354c5f3)."""
    try:
        return pwd.getpwuid(os.getuid()).pw_dir
    except KeyError:
        return "/nonexistent"


def private_tmux():
    """A private TMUX_TMPDIR: under /run/user/<uid> when it takes a directory, else the system temp dir."""
    run = f"/run/user/{os.getuid()}"
    if os.access(run, os.W_OK | os.X_OK):
        try:
            return tempfile.mkdtemp(prefix="lander-prove-tmux-", dir=run)
        except OSError:
            pass
    return tempfile.mkdtemp(prefix="lander-prove-tmux-")


def sweep_under(rel, root, sha, only=(), cap=PROVE_CAP, grace=120, hold=""):
    """Release `rel`'s `lander sweep` of commit `sha` in checkout `root` (only: just those checks), on the host as the
    lane runs it: a transient `systemd-run --user` service like the lane's own, so it has the user manager's
    environment and none of the caller's (security read, 10-12: a pane's TMUX let a host check's send-keys type
    into the seat), a private TMUX_TMPDIR, no Landlock domain or sandbox the caller sits in (Opus read: under
    cc-nosignal the bare checks went red under both releases and passed as main's own), and RuntimeMaxSec at the
    cap. hold: the lane hold's ticket name (hold_lane), passed as LANDER_PROVE_HOLD so the sweep waits only behind
    the tickets older than it. -> ({check: passed|failed|unrunnable}, why): why is '' when the sweep ran to its end.
    PATH is the user manager's, which is what the lane's own unit gets: spawn_lane and a re-armed tick set none, and
    only a tick that `queue` starts runs with tick_path() (correctness read of 2354c5f3: use the lane unit's). HOME
    is the passwd home, as every lane has it."""
    import time
    sysrun = os.environ.get("LANDER_SYSTEMD_RUN") or "systemd-run"
    unit = f"lander-prove-{os.getpid()}-{int(time.time() * 1000)}"
    env, home = prove_env(), passwd_home()
    try:
        tmux = private_tmux()
    except OSError as e:
        return {}, f"no private TMUX_TMPDIR: {e}"
    argv = [sysrun, "--user", "--wait", "--pipe", "--collect", "--quiet", f"--unit={unit}",
            f"--property=RuntimeMaxSec={max(1, int(cap))}", "--setenv=PYTHONDONTWRITEBYTECODE=1",
            f"--setenv=TMUX_TMPDIR={tmux}", f"--setenv=HOME={home}",
            *([f"--setenv=LANDER_PROVE_HOLD={hold}"] if hold else []),
            sys.executable, "-P", os.path.join(rel, "core", "lander", "cli.py"), "sweep", "--repo", root, "--rev", sha]
    for n in only:
        argv += ["--only", n]
    t0 = time.monotonic()
    try:
        rc, out, err = sh(argv, timeout=max(1, int(cap)) + grace, env=env, stdin=subprocess.DEVNULL)
    finally:
        shutil.rmtree(tmux, ignore_errors=True)
    got = {m.group(1): m.group(2) for m in SWEEP_LINE.finditer(err)}
    if rc == 124 and not out:
        sh([sysrun.replace("systemd-run", "systemctl"), "--user", "stop", unit], timeout=60, env=prove_env())
        return got, f"stopped at the cap ({int(cap)}s)"
    if rc not in (0, 1) or not re.search(r"^lander sweep: ", out, re.M):
        if time.monotonic() - t0 >= cap:
            return got, f"stopped at the cap ({int(cap)}s)"
        return got, f"exit {rc}: {(err.strip().splitlines() or ['no output'])[-1][:200]}"
    return got, ""


NAMES = ("import sys; sys.path.insert(0, sys.argv[1]); from lander import check as K, manifest as M\n"
         "r = K.host_top(sys.argv[2]).work_tree\n"
         "print('\\n'.join(M.load(r, sys.argv[3], fallback=M.host_fallback(K.repo_name(r))).checks))\n")


def names_under(rel, root, sha):
    """Every check name in commit `sha`'s manifest, as release `rel`'s own loader reads it (the sweep's own load).
    -> (names, why). The proof takes main's list from the current release, not from the candidate it is judging."""
    rc, out, err = sh([sys.executable, "-P", "-c", NAMES, os.path.join(rel, "core"), root, sha], timeout=300,
                      env=prove_env(), stdin=subprocess.DEVNULL)
    names = [ln.strip() for ln in out.splitlines() if ln.strip()]
    if rc != 0 or not names:
        return [], f"exit {rc}: {(err.strip().splitlines() or ['it named no check'])[-1][:200]}"
    return names, ""


# REUSE (10-13): the lane's own checks starve the proof's sweep of admission slots, so promotes stopped at the cap.
# A check the current release has already passed on main's exact tree is not swept again when the candidate runs
# checks with byte-identical code: same code, same tree, same runner, so the candidate's answer is that green. The
# files below are what `lander sweep` runs a check with. Perms, 10-13: the sweep "imports every core/lander/*.py with
# core/ first on sys.path", so everything importable directly in either dir is hashed: a .py, a .pyc, a .so or a
# package dir (runner_paths, the union of both releases' names), not a hand-kept list of what cli.py happens to import today; plus the tools run.py execs,
# cc-config for LANDER_SLOTS, and the release's host fallback manifests. Any of them differing, or missing on one
# side only, sweeps everything as before. __pycache__ is not hashed, because runtime pycs differ; build() leaves out
# any the commit tracks, so the pycs a release holds are compiled from the .py hashed here.
RUNNER = ("core/bin/cc-nosignal", "core/bin/cc-sandbox", "core/bin/cc-suites", "core/bin/cc-config",
          "tests/landing-repos")
RUNNER_GLOBS = ("core/lander", "core")   # every importable entry directly in each
LAND_STATE = os.path.join(passwd_home(), ".cc", "state", "land")


def runner_paths(*rels):
    """RUNNER plus every importable entry directly under a RUNNER_GLOBS dir of any of the release dirs `rels`, sorted:
    a file ending in an import suffix (.py, .pyc, any .so), and a subdirectory holding an __init__.*, since either
    shadows a module of that name (core/ is first on sys.path, so core/json/ or core/json.pyc shadows stdlib json).
    A RUNNER_GLOBS dir inside another is listed on its own, not hashed whole. None when a dir that exists cannot be
    listed: what it holds is unknown, so nothing is reused."""
    import importlib.machinery
    sufs = tuple(importlib.machinery.all_suffixes())
    mods = set()
    for r in rels:
        for d in RUNNER_GLOBS:
            top = os.path.join(r, d)
            if not os.path.lexists(top):
                continue
            try:
                for n in os.listdir(top):
                    p = os.path.join(top, n)
                    if n.endswith(sufs) or (f"{d}/{n}" not in RUNNER_GLOBS and os.path.isdir(p)
                                            and any(m.startswith("__init__.") for m in os.listdir(p))):
                        mods.add(f"{d}/{n}")
            except OSError:
                return None
    return RUNNER + tuple(sorted(mods))


def same_runner(cand, cur):
    """True when every runner_paths path is byte-identical in the two release dirs (a directory by tree_digest), or
    absent from both. False when either side cannot be listed or read."""
    paths = runner_paths(cand, cur)
    if paths is None:
        return False
    for p in paths:
        a, b = os.path.join(cand, p), os.path.join(cur, p)
        if os.path.lexists(a) != os.path.lexists(b):
            return False
        if not os.path.lexists(a):
            continue
        if os.path.islink(a) or os.path.islink(b):
            return False
        try:
            if os.path.isdir(a) or os.path.isdir(b):
                if not (os.path.isdir(a) and os.path.isdir(b)) or tree_digest(a) != tree_digest(b):
                    return False
                continue
            with open(a, "rb") as fa, open(b, "rb") as fb:
                if fa.read() != fb.read() or (os.stat(a).st_mode & 0o111) != (os.stat(b).st_mode & 0o111):
                    return False
        except OSError:
            return False
    return True


def main_greens(cur, tree, state=LAND_STATE):
    """The checks the lane recorded `passed` on `tree` under release `cur` (its basename, as records.release() stamps
    it): the shared base records records.py writes, results/<check>/<tree>.json. Perms, 10-13: "reuse only this
    repo's shared base records, never job records" — a job's jobs/*/results/ ran on a PR's merge tree under that
    job's own scope, so it is not read. A record counts only when its own check, tree and release fields agree with
    its path and with these. Read, not imported: lander-self shares no code with lander/. Like the store itself, it
    trusts what a process of this uid wrote there (records.py's stated residual); it does not take the nonce, so a
    green an earlier lane of the same release made counts."""
    if not cur or not re.fullmatch(r"[0-9a-f]{40,64}", tree or ""):
        return set()
    rel, out, d = os.path.basename(cur.rstrip("/")), set(), os.path.join(state, "results")
    try:
        checks = os.listdir(d)
    except OSError:
        checks = []
    for c in checks:
        try:
            with open(os.path.join(d, c, f"{tree}.json")) as f:
                r = json.load(f)
        except (OSError, ValueError):
            continue
        if (isinstance(r, dict) and r.get("check") == c and r.get("tree") == tree and r.get("status") == "passed"
                and r.get("release") == rel):
            out.add(c)
    return out


def main_tree(root, main):
    """Commit `main`'s tree, or ''. Perms, 10-13: resolved "with git --no-replace-objects", so a refs/replace/ entry
    in the checkout cannot make main's tree read as another commit's and pick up that tree's greens."""
    rc, out, _ = sh(["git", "--no-replace-objects", "-C", root, "rev-parse", f"{main}^{{tree}}"])
    return out.strip() if rc == 0 else ""


def reusable(cand, cur, tree, state=LAND_STATE):
    """The checks the proof takes from the current release's records: none unless the runners are identical."""
    return main_greens(cur, tree, state) if cur and same_runner(cand, cur) else set()


def prove(cand, cur, run, names=None, cap=PROVE_CAP, clock=None, reuse=()):
    """Prove release `cand` against `cur` ('' when nothing is current) with run(rel, only, cap) -> (results, why) and
    names(rel) -> (main's check names, why). reuse: checks `cur` has passed on main's tree with the candidate's own
    runner (main_greens, when same_runner), taken as the candidate's passes; only a name on main's list is taken, and
    the sweep runs just the rest. -> (blocking checks, lines, why): why is non-empty when no verdict could be had,
    which refuses the switch too."""
    clock = clock or __import__("time").monotonic
    end = clock() + cap
    want, reused = None, set()
    if cur and names and reuse:
        want, why = names(cur)
        if why:
            return [], [], f"the current release could not list main's checks: {why}"
        reused = set(want) & set(reuse)
    rest = sorted(set(want) - reused) if reused else ()
    if reused and not rest:
        got = {}
    else:
        got, why = run(cand, rest, cap)
        if why or not got:
            return [], [], f"the candidate's sweep gave no verdict: {why or 'it named no check'}"
    lines = [f"reused {len(reused)} check(s) the current release passed on main's tree with this runner, "
             f"ran {len(got)}"]
    lines.append(f"candidate: {sum(1 for s in got.values() if s == 'passed') + len(reused)} of "
                 f"{len(got) + len(reused)} check(s) passed")
    # Opus read, 10-12: a candidate whose manifest loader drops a check (bare = true, where=) must not pass by not
    # reporting it, so main's list comes from the current release and a name the candidate did not run blocks.
    # A reused name counts as run: every name on main's list is either reused or run.
    dropped = []
    if cur and names:
        if want is None:
            want, why = names(cur)
            if why:
                return [], lines, f"the current release could not list main's checks: {why}"
        dropped = sorted(set(want) - set(got) - reused)
        for n in dropped:
            lines.append(f"{n}: in main's manifest, not run by the candidate  ← REGRESSION")
    off = sorted(n for n, s in got.items() if s != "passed")
    if off:
        again, why = run(cand, off, end - clock())
        if why:
            return [], lines, f"the candidate's rerun of {', '.join(off)} gave no verdict: {why}"
        flaky = [n for n in off if again.get(n) == "passed"]
        if flaky:
            lines.append(f"red once, green on the rerun: {', '.join(flaky)}")
        off = [n for n in off if again.get(n) != "passed"]
    if not off:
        return dropped, lines, ""
    if not cur:
        lines.append(f"no current release to compare with, so nothing blocks: {', '.join(off)}")
        return [], lines, ""
    base, why = run(cur, off, end - clock())
    if why:
        return [], lines, f"the current release's run of {', '.join(off)} gave no verdict: {why}"
    for n in off:
        lines.append(f"{n}: current {base.get(n, 'not run')} → candidate {got[n]}"
                     + ("  ← REGRESSION" if base.get(n) == "passed" else "  (main's own, does not block)"))
    return sorted(dropped + [n for n in off if base.get(n) == "passed"]), lines, ""


# THE HOLD (perms, 10-13: "the lane admits no new checks while a prove runs, and checks already running finish").
# Admission slots are flocks the whole box shares, and only the oldest live ticket in <state>/slots/queue may take
# one (admission.py, FAIR WAIT). hold_lane() writes a ticket of the lane's own form (`+` and 19 digits of
# nanoseconds), named one nanosecond before the oldest lane ticket there and never more than HOLD_BACK seconds back
# (a lane's TICKET_CAP, 12 h, takes an older one for stuck), and keeps it flocked for the proof. Every release's
# admission, the current one's included, then counts it as the oldest waiter, so the lane takes no new box slot;
# admission.free() is 0, so the lane sends what it can to the runners. The candidate's sweep gets the name in
# LANDER_PROVE_HOLD and waits only behind the tickets older than it. Release: Hold.drop() unlinks it and closes the
# flock when the proof ends; a lander-self killed in between loses the flock with its process, and the next waiter's
# _ahead() finds the ticket unlocked and removes it. Read, not imported: lander-self shares no code with lander/.
HOLD_BACK = 3600
HOLD_RE = re.compile(r"\+([0-9]{19})-[0-9]+-[0-9a-f]{8}")


def holds(rel):
    """True when release `rel`'s admission reads LANDER_PROVE_HOLD, so its sweep can run while the lane is held."""
    try:
        with open(os.path.join(rel, "core", "lander", "admission.py"), encoding="utf-8", errors="replace") as f:
            return "LANDER_PROVE_HOLD" in f.read()
    except OSError:
        return False


def hold_lane(state=LAND_STATE, now_ns=None):
    """Write and flock the hold's ticket in <state>/slots/queue -> (name, open file). Locked before it is renamed to
    its ticket's name, as admission._ticket does, so nobody sees it unlocked and takes it for a dead one."""
    import time
    import uuid
    q = os.path.join(state, "slots", "queue")
    os.makedirs(q, exist_ok=True)
    now = time.time_ns() if now_ns is None else now_ns
    born = min([now] + [int(m.group(1)) - 1 for m in map(HOLD_RE.fullmatch, os.listdir(q)) if m])
    born = max(born, now - HOLD_BACK * 10**9)
    name = f"+{born:019d}-{os.getpid()}-{uuid.uuid4().hex[:8]}"
    tmp = os.path.join(q, f".new-{name}")
    f = open(tmp, "a")
    try:
        fcntl.flock(f, fcntl.LOCK_EX)
        os.rename(tmp, os.path.join(q, name))
    except OSError:
        f.close()
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return name, f


class Hold:
    """The lane hold for one proof: take() before a sweep of a release that holds(), drop() before one that does not
    and when the proof ends. A hold that cannot be written is said and the proof goes on unheld."""

    def __init__(self, state=LAND_STATE, say=print):
        self.state, self.say, self.name, self.f = state, say, "", None

    def take(self):
        if self.f is None:
            try:
                self.name, self.f = hold_lane(self.state)
                self.say(f"lander-self: holding the lane's new checks for the proof (ticket {self.name})")
            except OSError as e:
                self.say(f"lander-self: could not hold the lane, so the proof runs beside it: {e}")
                self.name = ""
        return self.name

    def drop(self):
        if self.f is not None:
            try:
                os.unlink(os.path.join(self.state, "slots", "queue", self.name))
            except OSError:
                pass
            self.f.close()
            self.say("lander-self: the lane's checks are admitted again")
        self.name, self.f = "", None


def proven(rel, cur, root, main, cap=PROVE_CAP, state=None):
    """('', False) when release `rel` keeps every check of origin/main (`main`) that `cur` passes, else (why not,
    True when no verdict could be had: exit 3, not a refusal's 1). Prints the proof's lines. The lane is held
    (THE HOLD) while a release that holds() sweeps, and never past the proof."""
    print(f"lander-self: proving {os.path.basename(rel)[:12]} on main {main[:12]}: every check, as the lane runs it "
          f"(cap {cap}s)", flush=True)
    reuse = reusable(rel, cur, main_tree(root, main))
    if cur and not same_runner(rel, cur):
        print("  the candidate runs checks with code that differs from the current release's: sweeping every check",
              flush=True)
    hold = Hold(state or LAND_STATE, lambda ln: print(ln, flush=True))
    if not holds(rel):
        print("  the candidate's admission does not read LANDER_PROVE_HOLD, so the lane is not held", flush=True)

    def run(r, only, left):
        if not holds(r):
            hold.drop()   # this release's sweep would wait behind the hold
        return sweep_under(r, root, main, only, left, hold=hold.take() if holds(r) else "")
    try:
        bad, lines, why = prove(rel, cur, run, names=lambda r: names_under(r, root, main), cap=cap, reuse=reuse)
    finally:
        hold.drop()
    for ln in lines:
        print(f"  {ln}")
    if why:
        return why, True
    if bad:
        return (f"{len(bad)} check(s) green on main under the current release are red or not run under the "
                f"candidate: {', '.join(bad)}"), False
    return "", False


def worker_caller(cwd=None):
    """True for a worker or a member session: CC_ROLE says so, or a .cc/track / .cc/member-facing marker sits in
    the cwd or above it (the marker cc-guard trusts over the env)."""
    if os.environ.get("CC_ROLE", "") in ("worker", "member"):
        return True
    d = os.path.realpath(cwd or os.getcwd())
    while True:
        if any(os.path.exists(os.path.join(d, ".cc", m)) for m in ("track", "member-facing")):
            return True
        up = os.path.dirname(d)
        if up == d:
            return False
        d = up


def extra_versions_root(path=None, owner=0):
    """The versions root named on the first line of `path` (CLAUDE_VERSIONS_FILE unless a test passes one), or None
    unless that file is owned by `owner` (root) and not group- or world-writable, and is no symlink. The lander's
    review.extra_versions_root, copied."""
    try:
        fd = os.open(path or CLAUDE_VERSIONS_FILE, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if st.st_uid != owner or st.st_mode & 0o022:
            return None
        line = os.read(fd, 4096).decode("utf-8", "replace").strip().split("\n")[0].strip()
    except OSError:
        return None
    finally:
        os.close(fd)
    return line if os.path.isabs(line) else None


def is_claude_session(pid, proc="/proc", versions=None):
    """True when pid's comm is `claude` AND its /proc/<pid>/exe is under a versions root (the passwd home's
    ~/.local/share/claude/versions and extra_versions_root(), unless a test passes one): any same-uid process can
    rewrite its own comm. The exe is compared as the kernel printed it, less a trailing " (deleted)", never realpath'd:
    a deleted folder replaced by a symlink into versions would pass that. The lander's review.is_claude_session,
    copied."""
    with open(os.path.join(proc, str(pid), "comm")) as f:
        if f.read().strip() != "claude":
            return False
    exe = os.readlink(os.path.join(proc, str(pid), "exe"))
    if exe.endswith(" (deleted)"):
        exe = exe[:-len(" (deleted)")]
    exe = os.path.normpath(exe)   # a string operation: it reads no filesystem
    roots = [versions] if versions else [
        os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".local", "share", "claude", "versions"), extra_versions_root()]
    return any(exe.startswith(r + os.sep) for v in roots if v for r in {os.path.normpath(v), os.path.realpath(v)})


def claude_ancestor(pid=None, proc="/proc", versions=None):
    """The pid of the first Claude session (is_claude_session()) at or above `pid` (default: this one's parent),
    walking /proc/<pid>/status PPid, or None. The lander's review.claude_ancestor, copied: this file shares no code."""
    pid, seen = pid or os.getppid(), set()
    while pid and pid > 1 and pid not in seen:
        seen.add(pid)
        try:
            if is_claude_session(pid, proc, versions):
                return pid
            with open(os.path.join(proc, str(pid), "status")) as f:
                pid = next((int(ln.split()[1]) for ln in f if ln.startswith("PPid:")), 0)
        except (OSError, ValueError, IndexError):
            return None
    return None


def perms_caller(root, pid=None, proc="/proc", state=None, versions=None):
    """True when the calling Claude session works in the perms seat of root's repo: its /proc/<pid>/cwd resolves to
    <passwd home>/.cc/state/<basename of root>/perms. Perms on #1277: give promote the same caller check as
    `lander record --by perms-*`, so only perms moves the live lander to a new release."""
    seat = claude_ancestor(pid, proc, versions)
    if seat is None or not root:
        return False
    state = state or os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".cc", "state")
    try:
        cwd = os.path.realpath(os.readlink(os.path.join(proc, str(seat), "cwd")))
    except OSError:
        return False
    return cwd == os.path.realpath(os.path.join(state, os.path.basename(os.path.realpath(root)), "perms"))


def seat_of(pid=None, proc="/proc"):
    """The calling Claude session as promote.log records it: its pid and cwd, or this process's pid when no Claude
    session is above it."""
    seat = claude_ancestor(pid, proc)
    if seat is None:
        return f"pid {os.getpid()} (no Claude session above it)"
    try:
        return f"pid {seat} cwd {os.path.realpath(os.readlink(os.path.join(proc, str(seat), 'cwd')))}"
    except OSError:
        return f"pid {seat} cwd ?"


PROMOTE_LOG = "promote.log"


def log_promote(sha, proven_, caller):
    """Append `<time>\t<sha>\tproven|no-prove\t<caller>` to ROOT/promote.log. Security read of #1313: a --no-prove
    promote said so only on stdout. Outside the release directory, whose tree is compared byte for byte."""
    os.makedirs(ROOT, exist_ok=True)
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = "\t".join((stamp, sha, "proven" if proven_ else "no-prove", caller.replace("\t", " ").replace("\n", " ")))
    with open(os.path.join(ROOT, PROMOTE_LOG), "a") as f:
        f.write(line + "\n")


def promote_record(sha):
    """The last promote.log line for sha as (time, mark, caller), or None."""
    hit = None
    try:
        with open(os.path.join(ROOT, PROMOTE_LOG)) as f:
            for ln in f:
                p = ln.rstrip("\n").split("\t")
                if len(p) == 4 and p[1] == sha:
                    hit = (p[0], p[2], p[3])
    except OSError:
        return None
    return hit


def open_pr_head(root, pr):
    """(head sha, comments) GitHub names for PR #pr when it is OPEN, else ("", [])."""
    rc, out, _ = sh(["gh", "pr", "view", str(pr), *gh_repo(root), "--json", "headRefOid,state,comments"], cwd=root, timeout=60)
    try:
        j = json.loads(out) if rc == 0 else {}
    except ValueError:
        j = {}
    if not isinstance(j, dict) or j.get("state") != "OPEN":
        return "", []
    return j.get("headRefOid") or "", j.get("comments") or []


def promotable(root, sha, pr="", head_of=open_pr_head, main="", ledger=None):
    """'' when `sha` may be promoted, else why not. On origin/main (`main`, the sha main_sha verified, or an
    ancestor of it) always; otherwise only as the cutover's step 5: --pr N, N an OPEN PR whose head is exactly sha,
    both reads `land` demands standing at that head (land_readers: perms' ledger for the security read), and a
    caller that is no worker."""
    if not main:
        return "origin/main could not be fetched and checked against origin"
    if git(root, "merge-base", "--is-ancestor", sha, main)[0] == 0:
        return ""
    if not pr:
        return (f"{sha[:12]} is not on origin/main; only a merged commit is promoted (the cutover's step 5 names "
                f"its PR with --pr)")
    if not str(pr).isdigit():
        return f"--pr {pr!r} is not a PR number"
    if worker_caller():
        return "a worker or member session may not promote a commit that is not on origin/main"
    head, comments = head_of(root, pr)
    if head != sha:
        return (f"{sha[:12]} is not the head of open PR #{pr} "
                f"({'GitHub names ' + head[:12] if head else 'GitHub names no open head'})")
    miss = reads_missing(land_readers(comments, head, os.path.basename(root), pr, ledger))
    if miss:
        return f"PR #{pr} at {head[:12]} needs {' and '.join(miss)} recorded as LAND at this head"
    return ""


def cmd_promote(args, opts):
    root, cap = repo_of(opts.get("repo", "")), cap_of(opts)
    if not root:
        return die("promote: no checkout (--repo DIR)", 2)
    if not cap:
        return die(f"promote: --cap takes a whole number of seconds above 0 and at most {PROVE_CAP_MAX}", 2)
    if opts.get("no-prove") and opts.get("pr"):    # security read of #1313: no unproven release off an unmerged head
        return die("promote: refused — --no-prove takes no --pr; an unproven release is built only from a commit on "
                   "origin/main (current is unchanged)", 2)
    if not perms_caller(root):
        return die("promote: refused — only the perms seat moves the live lander to a new release "
                   f"(run it from {os.path.basename(root)}'s perms seat); current is unchanged")
    for ln in pin_remotes(root):
        print(f"lander-self: {ln}")
    main = main_sha(root)
    if not main:
        return die(f"promote: cannot fetch origin/main in {root}, or it differs from what origin names", 2)
    sha = resolve(root, args[0]) if args else main
    if not sha:
        return die(f"promote: cannot resolve {args[0]}", 2)
    why = promotable(root, sha, opts.get("pr", ""), main=main)
    if why:
        return die(f"promote: refused — {why}")
    try:
        rel = build(root, sha, "releases")
    except RuntimeError as e:
        return die(f"promote: {e}")
    ok, tail = release_green(rel)
    if not ok:
        return die(f"promote: {sha[:12]}'s own selfcheck is red, current is unchanged: {tail}")
    cur = link_target("current")
    if cur == os.path.realpath(rel):
        unlink("legacy-on")
        print(f"lander-self: {sha[:12]} is already current")
        return 0
    # brief: "It skips the proof sweep ... and nothing else" — every check above has already run
    skip = bool(opts.get("no-prove"))
    if not skip:
        why, nov = proven(rel, cur, root, main, cap)
        if why:
            return die(f"promote: refused, current is unchanged — {why}", 3 if nov else 1)
    try:
        log_promote(sha, not skip, seat_of())
    except OSError as e:
        return die(f"promote: cannot append to {os.path.join(ROOT, PROMOTE_LOG)}, current is unchanged: {e}", 3)
    if cur:
        swap("previous", cur)
    swap("current", rel)
    unlink("legacy-on")
    print(f"lander-self: promoted {sha[:12]} (was {os.path.basename(cur)[:12] or 'none'}); "
          f"`lander-self rollback` puts it back"
          + ("; proof skipped (--no-prove) on the owner's 2026-10-13 17:33Z direction" if skip else ""))
    busy = running_lanes(landq())
    if busy:
        print(f"lander-self: lanes running for {', '.join(busy)}: each finishes its job and switches to {sha[:12]} "
              f"before the next (`lander-self status` shows them)")
    return 0


def gate_commits(root, base, sha, pats):
    """The commits in base..sha that touch a path on the `lander` list `pats`, oldest first: [(sha, subject)], and how
    many others there were. None when git cannot list them. Perms, 10-13: the listing uses -z, so a path with a
    space, or one git would quote (a non-ASCII byte), is read whole and matched as it is."""
    rc, out, _ = git(root, "log", "--reverse", "--format=%H %s", f"{base}..{sha}")
    if rc != 0:
        return None
    rx, hit, other = [glob_re(p) for p in pats], [], 0
    for head in out.split("\n"):   # not splitlines(): a subject may hold U+2028
        if not head:
            continue
        c, _, subject = head.partition(" ")
        rc, names, _ = git(root, "diff-tree", "-z", "-r", "--root", "--no-commit-id", "--name-only", "--no-renames", c)
        if rc != 0:
            return None
        if any(r.match(f) for f in names.split("\x00") if f for r in rx):
            hit.append((c, subject))
        else:
            other += 1
    return hit, other


def cmd_reads(args, opts):
    """The commits perms reads before a promote: those since the current release that touch main's `lander` list.
    Since #1277 a PR off that list lands on one paid read, so it is not read again here."""
    root = repo_of(opts.get("repo", ""))
    if len(args) > 1 or not root:
        return die("usage: lander-self reads [REV] [--repo DIR]", 2)
    main = main_sha(root)
    if not main:
        return die(f"reads: cannot fetch origin/main in {root}, or it differs from what origin names", 3)
    sha = resolve(root, args[0]) if args else main
    cur = os.path.basename(link_target("current"))
    if not sha or not SHA_RE.match(cur):
        return die(f"reads: {'no current release' if sha else f'cannot resolve {args[0]}'}", 3)
    rc, pol, _ = git(root, "show", f"{main}:tests/LANDING-policy.toml")
    try:
        pats = lander_list(pol) if rc == 0 else None
    except ValueError:
        pats = None
    if not pats:
        return die(f"reads: main {main[:12]} has no lander list in tests/LANDING-policy.toml", 3)
    got = gate_commits(root, cur, sha, pats)
    if got is None:
        return die(f"reads: cannot list the commits {cur[:12]}..{sha[:12]}", 3)
    hit, other = got
    for c, subject in hit:
        print(f"{c[:12]} {subject}")
    print(f"lander-self reads: {len(hit)} commit(s) since the current release {cur[:12]} touch the lander list; "
          f"{other} other(s) landed on their own read")
    return 0


def cmd_sweep(args, opts):
    """The tree at REV (default origin/main as main_sha verifies it) through tree_binaries(): binaries() sees only a
    PR's own changes, so this is what catches a compiled file that reached main another way. It only reports."""
    root = repo_of(opts.get("repo", ""))
    if len(args) > 1 or not root:
        return die("usage: lander-self sweep [REV] [--repo DIR]", 3)
    sha = resolve(root, args[0]) if args else main_sha(root)
    if not sha:
        why = f"cannot resolve {args[0]}" if args else f"cannot fetch origin/main in {root}, or it differs from origin"
        return die(f"sweep: {why}", 3)
    hits = tree_binaries(root, sha, (core_prefix(root, sha), *BINARY_ROOTS[1:]))
    if hits is None:
        return die(f"sweep: cannot list or read the tree at {sha[:12]}", 3)
    for h in hits:
        print(h)
    if hits:
        print(f"lander-self sweep: {sha[:12]} tracks {len(hits)} path(s) that are not source ({', '.join(hits[:4])}"
              f"{', …' if len(hits) > 4 else ''}); they could run in place of the code that was read, so take them "
              "out by hand")
        return 2
    print(f"lander-self sweep: {sha[:12]} tracks no compiled or binary path under core/ or bin-private/, no executable "
          "binary, and no symlink into one")
    return 0


def cmd_prove(args, opts):
    """promote's checks and its proof on main, without the switch: what a host runs before it takes over landing."""
    root, cap = repo_of(opts.get("repo", "")), cap_of(opts)
    if len(args) > 1 or not root or not cap or opts.get("no-prove"):   # --no-prove is promote's alone
        return die("usage: lander-self prove [REV] [--repo DIR] [--pr N] [--cap SECONDS]", 2)
    if not perms_caller(root):   # the proof holds the lane's admissions (THE HOLD), up to --cap: perms' alone
        return die("prove: refused — only the perms seat proves a release, since the proof holds the lane "
                   f"(run it from {os.path.basename(root)}'s perms seat); nothing was built or held")
    for ln in pin_remotes(root):
        print(f"lander-self: {ln}")
    main = main_sha(root)
    if not main:
        return die(f"prove: cannot fetch origin/main in {root}, or it differs from what origin names", 3)
    sha = resolve(root, args[0]) if args else main
    if not sha:
        return die(f"prove: cannot resolve {args[0]}", 3)
    why = promotable(root, sha, opts.get("pr", ""), main=main)
    if why:
        return die(f"prove: refused — {why}")
    try:
        rel = build(root, sha, "releases")
    except RuntimeError as e:
        return die(f"prove: {e}", 3)
    ok, tail = release_green(rel)
    if not ok:
        return die(f"prove: {sha[:12]}'s own selfcheck is red: {tail}")
    cur = link_target("current")
    why, nov = proven(rel, "" if cur == os.path.realpath(rel) else cur, root, main, cap)
    if why:
        return die(f"prove: {sha[:12]} is not proven — {why}", 3 if nov else 1)
    print(f"lander-self prove: {sha[:12]} keeps every check green on main {main[:12]}"
          + ("" if cur and cur != os.path.realpath(rel) else " (no other release to compare with)"))
    return 0


def landq():
    return os.environ.get("CC_LANDER_STATE") or os.path.join(HOME, ".cc", "state", "land")


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (OSError, ValueError, TypeError):
        return False


def running_lanes(q):
    """The repos whose new-lander lane is running now (lanes/<repo>.running names a live pid)."""
    out = []
    for f in sorted(os.listdir(os.path.join(q, "lanes"))) if os.path.isdir(os.path.join(q, "lanes")) else []:
        if f.endswith(".running"):
            try:
                pid = json.load(open(os.path.join(q, "lanes", f))).get("pid")
            except (OSError, ValueError, AttributeError):
                continue
            if pid_alive(pid):
                out.append(f[:-len(".running")])
    return out


JOB_FILE = re.compile(r"^(?P<repo>[A-Za-z0-9_][A-Za-z0-9._-]{0,63})-(?P<pr>[0-9]+)\.json$")


def hand_back_to_legacy(q, stamp):
    """Move the new lander's queue out of the old one's way (see `rollback --legacy`). -> (requeue, lines)."""
    post = os.path.join(q, "post-cutover", stamp)
    os.makedirs(post, exist_ok=True)
    requeue, lines, taken = [], [], set()

    def read(p):
        try:
            j = json.load(open(p))
            return j if isinstance(j, dict) else None
        except (OSError, ValueError):
            return None
    for f in sorted(os.listdir(q)):
        m, p = JOB_FILE.match(f), os.path.join(q, f)
        j = read(p) if m and os.path.isfile(p) else None
        if not (j and "state" in j and "history" in j):   # the new lander's job; the old one's have neither
            continue
        os.replace(p, os.path.join(post, f))
        taken.add(f)
        if j.get("state") not in DONE:
            requeue.append((m["repo"], m["pr"]))
    inbox = os.path.join(q, "jobs", "new")
    for f in sorted(os.listdir(inbox)) if os.path.isdir(inbox) else []:
        j = read(os.path.join(inbox, f))
        os.makedirs(os.path.join(post, "inbox"), exist_ok=True)
        os.replace(os.path.join(inbox, f), os.path.join(post, "inbox", f))
        if j and REPO_RE.match(str(j.get("repo") or "")) and str(j.get("pr") or "").isdigit():
            requeue.append((j["repo"], str(j["pr"])))
    handed, pre = os.path.join(q, "handed"), os.path.join(q, "pre-cutover")
    if os.path.isdir(handed):
        os.replace(handed, os.path.join(post, "handed"))
        lines.append(f"the new lander's handed-back watches are in {post}/handed; a seat's next `cc done` re-queues "
                     "those PRs")
    if os.path.isdir(os.path.join(pre, "handed")):
        shutil.copytree(os.path.join(pre, "handed"), handed, symlinks=True)
        lines.append("the old lander's handed-back watches are back from pre-cutover/handed")
    back = 0
    for f in sorted(os.listdir(pre)) if os.path.isdir(pre) else []:
        if JOB_FILE.match(f) and f not in taken and not os.path.exists(os.path.join(q, f)):
            shutil.copy2(os.path.join(pre, f), os.path.join(q, f))
            back += 1
    if back:
        lines.append(f"{back} job(s) exported at the cutover and never taken up by the new lander are back in {q}")
    seen, uniq = set(), []
    for rp in requeue:
        if rp not in seen:
            seen.add(rp)
            uniq.append(rp)
    with open(os.path.join(post, "requeue.txt"), "w") as f:
        f.writelines(f"cc-land queue {r} {n}\n" for r, n in uniq)
    return uniq, lines


def cmd_rollback(args, opts):
    if opts.get("legacy"):
        ld = os.path.join(ROOT, "legacy")
        leg = sorted((os.path.join(ld, d) for d in os.listdir(ld) if not d.startswith(".")
                      and os.path.isdir(os.path.join(ld, d)) and not os.path.islink(os.path.join(ld, d))),
                     key=os.path.getmtime) if os.path.isdir(ld) else []
        if not leg:
            return die("rollback --legacy: no legacy release; `lander-self legacy <rev>` pins one")
        q = landq()
        busy = running_lanes(q)
        if busy:
            return die(f"rollback --legacy: the new lander's lane is running for {', '.join(busy)} — pause those "
                       f"repos (cc-pause on <repo> --only) and wait for it to stop, then run this again")
        swap("legacy-on", leg[-1])
        import time
        requeue, lines = hand_back_to_legacy(q, time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())) \
            if os.path.isdir(q) else ([], [])
        print(f"lander-self: cc-land now runs the legacy lander at {os.path.basename(leg[-1])[:12]}; "
              f"`lander-self promote` switches back")
        for ln in lines:
            print(f"  {ln}")
        if requeue:
            print(f"  {len(requeue)} PR(s) the new lander had in flight or waiting; queue each on the old lander:")
            for r, n in requeue:
                print(f"    cc-land queue {r} {n}")
        return 0
    cur, prev = link_target("current"), link_target("previous")
    under = os.path.realpath(os.path.join(ROOT, "releases")) + os.sep
    if not prev or not prev.startswith(under) or not os.path.isfile(os.path.join(prev, "core", "lander", "cli.py")):
        return die("rollback: there is no previous release to go back to")
    swap("current", prev)
    if cur:
        swap("previous", cur)
    print(f"lander-self: rolled back to {os.path.basename(prev)[:12]} (from {os.path.basename(cur)[:12]})")
    return 0


def cmd_legacy(args, opts):
    root = repo_of(opts.get("repo", ""))
    if len(args) != 1 or not root:
        return die("usage: lander-self legacy REV [--repo DIR]", 2)
    sha = resolve(root, args[0])
    if not sha:
        return die(f"legacy: cannot resolve {args[0]}", 2)
    try:
        d = build(root, sha, "legacy", must="bin/cc-land")
    except RuntimeError as e:
        return die(f"legacy: {e}")
    os.utime(d)
    print(f"lander-self: legacy lander pinned at {sha[:12]}; `lander-self rollback --legacy` switches cc-land to it")
    return 0


def lane_release(q, repo):
    """(pid, release dir) of the live lane for `repo`: the release its running marker names, else the releases/<sha>
    on its command line (a lane from before the marker carried one), else ''."""
    try:
        pid = json.load(open(os.path.join(q, "lanes", f"{repo}.running")))
    except (OSError, ValueError):
        return 0, ""
    pid, rel = (pid.get("pid"), pid.get("release") or "") if isinstance(pid, dict) else (0, "")
    if not rel:
        try:
            argv = open(f"/proc/{int(pid)}/cmdline", "rb").read().decode(errors="replace").split("\0")
        except (OSError, ValueError, TypeError):
            argv = []
        rels = os.path.join(ROOT, "releases") + "/"
        rel = next((rels + a[len(rels):].split("/")[0] for a in argv if a.startswith(rels)), "")
    return pid, rel


def cmd_status(args, opts):
    for name in ("current", "previous", "legacy-on", os.path.join("self", "current")):
        t = link_target(name)
        print(f"{name:13} {os.path.basename(t)[:12] if t else '-'}")
    q, cur = landq(), link_target("current")
    if cur:
        rec = promote_record(os.path.basename(cur))
        print(f"{'proven':13} " + ("unknown (no promote.log line for it)" if rec is None else "yes" if rec[1] == "proven"
                                   else f"no (--no-prove at {rec[0]} by {rec[2]})"))
    for repo in running_lanes(q):
        pid, rel = lane_release(q, repo)
        mark = "unknown" if not rel else "current" if os.path.realpath(rel) == cur else "STALE"
        print(f"lane {repo:18} pid {pid} on {os.path.basename(rel)[:12] or '?'} {mark}")
    return 0


# --- check / land --------------------------------------------------------------------------------------------------

def glob_re(pat):
    out, i = "", 0
    while i < len(pat):
        if pat.startswith("**", i):
            out, i = out + ".*", i + 2
        elif pat[i] == "*":
            out, i = out + "[^/]*", i + 1
        elif pat[i] == "?":
            out, i = out + "[^/]", i + 1
        else:
            out, i = out + re.escape(pat[i]), i + 1
    return re.compile(out + r"\Z")


def lander_list(policy_text):
    """The `lander` list out of LANDING-policy.toml's [paths]. Raises ValueError when it is not there."""
    import tomllib
    lst = (tomllib.loads(policy_text).get("paths") or {}).get("lander")
    if not isinstance(lst, list) or not lst or not all(isinstance(p, str) for p in lst):
        raise ValueError("no [paths] lander list")
    return lst


# The lander's own tree, which `check` takes beside the `lander` list: since that list holds only the lander's gate
# paths, a gate change and the lander files and tests it touches land as one PR, never split (#1127 vs #1126, #1269).
LANDER_TREE = ("core/lander/**", "core/tests/lander/**")


def outside(files, pats):
    rx = [glob_re(p) for p in [*pats, *LANDER_TREE]]
    return [f for f in files if not any(r.match(f) for r in rx)]


# Perms, after #1296: "make the lander's own check refuse any PR that tracks a __pycache__ path, a .pyc, a .so or
# another binary under core/" — the live lander imports from its release, so a tracked unchecked-hash .pyc runs there.
# Perms, after #1298: "EVERY lane refuses __pycache__, .pyc, .pyo, .so, .pyd and NUL-bearing blobs under core/ AND
# bin-private/" — an overlay tool imports lander.git from the LIVE checkout, and Python takes a
# git.cpython-*.so before git.py. The ordinary lane (lander/lane.py) loads this file and calls binaries() itself, so
# the two lanes refuse one set; nothing here imports lander/, so a change to the lander still cannot change this.
NOT_SOURCE = (".pyc", ".pyo", ".so", ".pyd")
BINARY_ROOTS = ("core/", "bin-private/")


def not_source(path, data):
    """True when `path` is not source: a __pycache__ segment, a NOT_SOURCE suffix, or `data` (its bytes; None when
    they cannot be read) None or holding a NUL in its first 8000 bytes (git's own binary test)."""
    return "__pycache__" in path.split("/") or path.endswith(NOT_SOURCE) or data is None or b"\0" in data[:8000]


# The Opus read of #1306: "it reports the five PNGs under core/docs/tour/ … add an explicit allowlist, or it stays red
# and hides a real hit". A picture in a docs tree is let stand when it is a plain (100644) .png whose bytes open with
# PNG's signature: Python imports no .png, and a link, an x bit or any other name still counts. docs/ is the core
# tree's docs when the core tree is the repo (core_prefix '').
PICTURES = ("core/docs/", "docs/")
PNG = b"\x89PNG\r\n\x1a\n"


def picture(path, mode, data):
    """True when binaries() and tree_binaries() let a binary blob stand: see PICTURES."""
    return (mode == b"100644" and path.startswith(PICTURES) and path.endswith(".png")
            and "__pycache__" not in path.split("/") and (data or b"").startswith(PNG))


def git_bytes(root):
    """run(*git_args) -> (rc, stdout bytes) for `git -C root`: binaries()'s default reader."""
    def run(*a):
        p = subprocess.run(["git", "-C", root, *a], capture_output=True, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout
    return run


PEEK = 8000   # the bytes not_source reads, git's own binary test


def git_peek(argv=None, **kw):
    """peek(shas) -> {sha: its first PEEK bytes, or None when it is no blob git can read}, from one
    `git cat-file --batch` (argv is the git command, default ["git"]; kw goes to Popen, as cwd and env). Each blob
    streams through and only PEEK bytes are kept (perms, after #1301: "binaries() reads each blob whole"). Asked by
    sha, never by path, so no path can break a request line. None for the whole set when git fails mid-way."""
    def peek(shas):
        got = {}
        if not shas:
            return got
        try:
            p = subprocess.Popen([*(argv or ["git"]), "cat-file", "--batch"], stdin=subprocess.PIPE,
                                 stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, **kw)
        except OSError:
            return None
        try:
            for sha in dict.fromkeys(shas):
                p.stdin.write(sha.encode() + b"\n")
                p.stdin.flush()
                head = p.stdout.readline().split()
                if len(head) != 3:            # "<sha> missing" (a submodule's commit), "ambiguous"
                    if not head:
                        return None
                    got[sha] = None
                    continue
                n, keep = int(head[2]), b""
                while n:
                    chunk = p.stdout.read(min(n, 1 << 16))
                    if not chunk:
                        return None
                    keep += chunk[:PEEK - len(keep)]
                    n -= len(chunk)
                p.stdout.read(1)              # the LF after the content
                got[sha] = keep if head[1] == b"blob" else None
            return got
        except (OSError, ValueError):
            return None
        finally:
            for fh in (p.stdin, p.stdout):
                try:
                    fh.close()
                except OSError:
                    pass
            p.kill()
            p.wait()
    return peek


def binaries(root, base, head, pres=BINARY_ROOTS, run=None, peek=None):
    """Each path `head` adds or changes from `base` that is not source. Anywhere in the repo: a compiled name
    (not_source(path, b""): __pycache__ or a NOT_SOURCE suffix). Under the trees `pres` (a prefix or a tuple of them;
    '' is the whole repo): also a symlink (mode 120000) or a blob not_source calls binary, read from the blob, so a
    .gitattributes in the PR cannot call it text; a path whose blob cannot be read (a submodule) counts too; a root
    itself ('bin-private', 'core') counts as under it. Anywhere else but under LINKS_OK: any symlink, whatever its
    target, and an executable (mode 100755) blob not_source calls binary. A picture() (a plain .png under a docs tree)
    is let stand. A symlink the PR leaves as it is (main's
    core/bin/cc-mail and bin-private's) is not in the diff, so it is not named.
    `run` reads git as git_bytes does and `peek` reads blobs as git_peek does (the lane passes its sealed repo's for
    both). None when git cannot list them or read them."""
    pres = (pres,) if isinstance(pres, str) else tuple(pres)
    run = run or git_bytes(root)
    peek = peek or git_peek(["git", "-C", root])
    rc, out = run("diff", "--raw", "-z", "--no-abbrev", "--no-renames", "--no-relative", "--ignore-submodules=none",
                  "--diff-filter=d", base, head)
    if rc != 0:
        return None
    parts = out.split(b"\0")
    if parts and parts[-1] == b"":
        parts.pop()
    if len(parts) % 2:
        return None
    hits, read = set(), []
    for meta, raw in zip(parts[0::2], parts[1::2]):
        f = meta.split()
        if len(f) < 5 or not f[0].startswith(b":"):
            return None
        p = raw.decode(errors="surrogateescape")
        if not_source(p, b""):
            hits.add(p)
        # Opus delta read of #1301 at 5889bc9a: "match p == root.rstrip('/') for each root" — a PR that replaces
        # bin-private/ (or core/) whole with a symlink lists the bare path
        elif "" in pres or p.startswith(pres) or p in {r.rstrip("/") for r in pres}:
            # Opus security read of #1301: a PR adding core/lander/git -> ../../docs/p, with
            # docs/p/__init__.cpython-314-x86_64-linux-gnu.so, makes `import lander.git` load the .so
            if f[1] == b"120000":
                hits.add(p)
                continue
            read.append((p, f[3].decode(), f[1]))
        elif f[1] == b"120000" and not p.startswith(LINKS_OK):
            # Opus delta read of #1301 at b57c0deb: "refuse EVERY added or changed mode-120000 entry anywhere in the
            # repo except under config/system/, whatever its target" — a target read lexically escapes through
            # another link (docs/up -> .., then dashboard/server.py -> ../docs/up/../../tmp/evil.py), and main's
            # overlay's dashboard launcher runs dashboard/server.py
            hits.add(p)
        elif f[1] == b"100755":
            # perms, after #1301: "a NUL-bearing executable outside core/ and bin-private/ still lands" — such as
            # dashboard/server.py, which bin-private/box-dash links to
            read.append((p, f[3].decode(), f[1]))
    data = peek([sha for _, sha, _ in read])
    if data is None:
        return None
    hits.update(p for p, sha, mode in read if not_source(p, data.get(sha)) and not picture(p, mode, data.get(sha)))
    return sorted(hits)


def tree_binaries(root, rev, pres=BINARY_ROOTS, run=None, peek=None):
    """What binaries() would refuse in the whole tree at `rev`, as if every path were new, less the symlinks it
    already holds and the picture()s it lets stand: a compiled name anywhere; under `pres`, a binary blob or a gitlink; an executable binary blob
    anywhere; and a symlink, anywhere but LINKS_OK, whose target names a compiled path or resolves (lexically, through
    the tree's other links) to a path this list names, or out of the repo from under `pres`. The brief: "a compiled
    file (.so, .pyc, __pycache__, a symlink into one) that reaches main another way is never caught". None when git
    cannot list or read the tree."""
    pres = (pres,) if isinstance(pres, str) else tuple(pres)
    run = run or git_bytes(root)
    peek = peek or git_peek(["git", "-C", root])
    rc, out = run("ls-tree", "-r", "-z", "--full-tree", rev)
    if rc != 0:
        return None
    ents = {}
    for rec in out.split(b"\0"):
        if not rec:
            continue
        meta, _, raw = rec.partition(b"\t")
        f = meta.split()
        if len(f) != 3 or not raw:
            return None
        ents[raw.decode(errors="surrogateescape")] = (f[0], f[2].decode())

    def under(p):
        return "" in pres or p.startswith(pres) or p in {r.rstrip("/") for r in pres}

    hits, read, links = set(), [], {}
    for p, (mode, sha) in ents.items():
        if not_source(p, b""):
            hits.add(p)
        elif mode == b"120000":
            links[p] = sha
        elif mode == b"160000":
            if under(p):
                hits.add(p)
        elif under(p) or mode == b"100755":
            read.append((p, sha, mode))
    data = peek([sha for _, sha, _ in read] + list(links.values()))
    if data is None:
        return None
    hits.update(p for p, sha, mode in read if not_source(p, data.get(sha)) and not picture(p, mode, data.get(sha)))

    # The Opus read of #1306: "symlink resolution is exponential … so cache resolved links". A link names others
    # once per segment, so without the cache each level doubles the work. Only an answer is kept: a None (a loop,
    # through `busy`, or past 40 hops) returns at once to the link that asked, so it is never walked twice.
    done, busy = {}, set()

    def land(p, depth=0):
        """Where link p points in the tree, through other links; '..' when it leaves the repo, None in a loop or
        past 40 hops."""
        if p in done:
            return done[p]
        if p in busy:
            return None
        busy.add(p)
        try:
            to = walk(p, depth)
        finally:
            busy.discard(p)
        if to is not None:
            done[p] = to
        return to

    def walk(p, depth):
        target = (data.get(links[p]) or b"").decode(errors="surrogateescape")
        if depth > 40 or not target or target.startswith("/"):
            return None if depth > 40 else ".."
        parts = []
        for seg in (os.path.dirname(p) + "/" + target).split("/"):
            if seg in ("", "."):
                continue
            if seg == "..":
                if not parts:
                    return ".."
                parts.pop()
                continue
            parts.append(seg)
            sofar = "/".join(parts)
            if sofar in links and sofar != p:
                hop = land(sofar, depth + 1)
                if hop in (None, ".."):
                    return hop
                parts = hop.split("/") if hop else []
        return "/".join(parts)

    for p in links:
        if p.startswith(LINKS_OK):
            continue
        to = land(p)
        target = (data.get(links[p]) or b"").decode(errors="surrogateescape")
        if (not_source(target, b"") or to is None or (to == ".." and under(p)) or to in hits
                or any(h.startswith(to + "/") for h in hits)):
            hits.add(p)
    return sorted(hits)


LINKS_OK = ("config/system/",)   # the host's /etc tree as committed: its unit links name /usr/lib and /dev/null


def readers(comments, head):
    """Who recorded LAND at this head, from markers this box's own login wrote. -> set of `by` names."""
    out = set()
    for c in comments or []:
        m = MARK_RE.match(c.get("body") or "") if c.get("viewerDidAuthor") else None
        if m and head.startswith(m.group(1)) and len(m.group(1)) >= 7 and m.group(2) == "LAND":
            out.add(m.group(3))
    return out


# review.py's PERMS_SECURITY_READER since #1285. Perms, 10-13: "Align it to the exact constant perms-security-read" —
# a name that merely contains `security` is anyone's to write.
PERMS_SECURITY_READER = "perms-security-read"


def perms_read(repo, pr, head, path=None):
    """True when perms' own ledger (<passwd home>/.cc/state/<repo>/perms/security-reads.json, the box user's plain
    0600 file reached through no symlink) records a read of exactly this repo, PR and head whose verdict is LAND or
    absent. review.py's perms_reads, copied, since pin copies lander-self alone. A PR marker by perms-security-read
    never counts: any seat can post one with `gh pr comment` (perms, 10-19)."""
    name = str(repo).rsplit("/", 1)[-1]
    path = path or os.path.join(passwd_home(), ".cc", "state", name, "perms", "security-reads.json")
    if not (head and str(pr).isdigit()) or os.path.realpath(path) != os.path.abspath(path):
        return False
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) != 0o600:
            return False
        with os.fdopen(fd, encoding="utf-8") as f:
            fd = None
            data = json.load(f)
    except (OSError, ValueError):
        return False
    finally:
        if fd is not None:
            os.close(fd)
    return isinstance(data, list) and any(
        isinstance(e, dict) and e.get("repo") == name and e.get("pr") == int(pr) and e.get("head") == head
        and e.get("verdict", "LAND") == "LAND" for e in data)


def land_readers(comments, head, repo, pr, ledger=None):
    """Who read this head: the box's own LAND markers for the other read, and perms' ledger alone for the security
    read."""
    by = readers(comments, head) - {PERMS_SECURITY_READER}
    return by | {PERMS_SECURITY_READER} if perms_read(repo, pr, head, ledger) else by


def reads_missing(by):
    sec = {b for b in by if b == PERMS_SECURITY_READER}
    miss = []
    if not sec:
        miss.append("a security read")
    if not (by - sec):
        miss.append("an Opus read")
    return miss


def bwrap(tree, argv, ro=(), cap=TEST_CAP, rw=True):
    """Run argv (a list: no shell, so nothing in it is parsed) in `tree` — bound rw at the same path when rw, else
    read-only — with no network, a tmpfs HOME and a clear env."""
    a = ["bwrap", "--die-with-parent", "--new-session", "--unshare-all", "--clearenv", "--ro-bind", "/usr", "/usr"]
    for d in ("bin", "lib", "lib32", "lib64", "sbin"):
        p = "/" + d
        if os.path.islink(p):
            a += ["--symlink", os.readlink(p), p]
        elif os.path.isdir(p):
            a += ["--ro-bind", p, p]
    a += ["--ro-bind", "/etc", "/etc", "--proc", "/proc", "--dev", "/dev", "--tmpfs", "/tmp", "--tmpfs", "/run",
          "--tmpfs", HOME]
    for p in ro:
        a += ["--ro-bind", p, p]
    a += ["--bind" if rw else "--ro-bind", tree, tree, "--chdir", tree]
    for k, v in {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": HOME, "LANG": "C.UTF-8", "TMPDIR": "/tmp",
                 "PYTHONDONTWRITEBYTECODE": "1", "USER": os.environ.get("USER", "lander")}.items():
        a += ["--setenv", k, v]
    return sh(a + ["--", *argv], timeout=cap)


def merge_tree(root, base, head):
    rc, out, err = git(root, "merge-tree", "--write-tree", base, head)
    return out.split()[0] if rc == 0 and out.split() else ""


def candidate_tests(root, base, tree, pre, run=bwrap):
    """The repo's identity gate and the candidate's own tests on its merge tree, in bwrap. -> (ok, lines).
    The identity gate is tests/check-extra.sh (`core-identity` in the lander's manifest), which keeps the box's
    identity out of the published core/. The copy that runs is the BASE's, put over the merge tree's, so a PR cannot
    weaken the gate it is judged by; when the base has one and the merge tree drops it, the merge is refused. Only a
    base with no gate leaves the merge tree's own copy, if any, and no copy at all says so and is not held. The gate
    reads a git working tree, so it runs first, in a repo made inside the sandbox with every file of the tree as
    extracted added to it: the tree's .gitignore files are deleted and the add is forced, because the gate's
    `git grep --untracked` skips ignored files and `git archive` ships them. That repo is removed before the tests run."""
    tmp = tempfile.mkdtemp(prefix="lander-self.check.")
    try:
        a = subprocess.run(["git", "-C", root, "archive", "--format=tar", tree], capture_output=True)
        subprocess.run(["tar", "-x", "-C", tmp], input=a.stdout, check=False)
        c = f"{tmp}/{pre}"
        out, ok = [], True
        gate = os.path.join(tmp, "tests", "check-extra.sh")
        rc_b, base_gate, _ = git(root, "show", f"{base}:tests/check-extra.sh")
        if rc_b == 0 and not os.path.isfile(gate):
            out.append("core-identity: FAILED — the base has tests/check-extra.sh and this merge tree drops it")
            ok = False
        elif rc_b == 0 or os.path.isfile(gate):
            if rc_b == 0:
                with open(gate, "w") as f:
                    f.write(base_gate)
            for d, _, fs in os.walk(tmp):
                if ".gitignore" in fs:
                    os.remove(os.path.join(d, ".gitignore"))
            rc, o, e = run(tmp, ["sh", "-c", "git init -q . && git add -Af . && exec bash tests/check-extra.sh"])
            shutil.rmtree(os.path.join(tmp, ".git"), ignore_errors=True)
            tail = [ln for ln in (o + e).strip().splitlines() if ln.strip()]
            # the brief: "refuse the merge if it fails" — any non-zero exit is a red, and the hits go to the output
            out.append(f"core-identity (tests/check-extra.sh): {'passed' if rc == 0 else f'FAILED (rc {rc})'} — "
                       f"{(tail[-1:] or ['no output'])[0]}")
            out += [f"  {ln}" for ln in tail[:-1][-10:]] if rc else []
            ok = rc == 0
        else:
            out.append("core-identity: this tree has no tests/check-extra.sh, so there is none to run")
        for name, argv in (("lander selfcheck", ["python3", "-P", f"{c}lander/cli.py", "selfcheck"]),
                           ("tests/lander", ["python3", "-m", "unittest", "discover", "-s", f"{c}tests/lander",
                                             "-t", f"{c}tests/lander"])):
            rc, o, e = run(tmp, argv)
            tail = [ln for ln in (o + e).strip().splitlines() if ln.strip()][-1:] or ["no output"]
            out.append(f"{name}: {'passed' if rc == 0 else f'FAILED (rc {rc})'} — {tail[0]}")
            ok = ok and rc == 0
        return ok, out
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def live_jobs():
    q = os.environ.get("CC_LANDER_STATE") or os.path.join(HOME, ".cc", "state", "land")
    jobs = []
    for f in sorted(os.listdir(q)) if os.path.isdir(q) else []:
        if not f.endswith(".json"):
            continue
        try:
            j = json.load(open(os.path.join(q, f)))
        except (OSError, ValueError):
            continue
        st = j.get("state") or j.get("stage") or ""
        if isinstance(j, dict) and j.get("repo") and j.get("pr") and st not in DONE:
            jobs.append(j)
    return jobs


def shadow(cand_core, cur_core, jobs, dev):
    """Plan each live job with the current release and the candidate, both in bwrap with the repo read-only.
    -> (regressions, lines)."""
    lines, bad = [], 0
    for j in jobs:
        repo = str(j.get("repo"))
        root = os.path.join(dev, repo)
        base, head = str(j.get("base_sha") or j.get("base") or ""), str(j.get("head") or "")
        if not (REPO_RE.match(repo) and os.path.isdir(os.path.join(root, ".git")) and SHA_RE.match(base)
                and SHA_RE.match(head)):
            lines.append(f"  {repo}#{j.get('pr')}: skipped (no checkout, or no base and head sha in its job)")
            continue
        res = []
        for core in (cur_core, cand_core):
            if not core:
                res.append(None)
                continue
            rc, o, e = bwrap(core, ["python3", "-P", f"{core}/lander/cli.py", "plan", "--repo", root, base, head],
                             ro=(root,), cap=300, rw=False)
            try:
                p = json.loads(o) if rc == 0 else None
            except ValueError:
                p = None
            res.append(p)
        show = lambda p: "cannot plan" if p is None else f"{p.get('klass')} {len(p.get('checks') or [])} checks"  # noqa
        cur, cand = res
        mark = "" if (cur or {}).get("klass") == (cand or {}).get("klass") and \
            sorted((cur or {}).get("checks") or []) == sorted((cand or {}).get("checks") or []) else "  ← differs"
        if cur is not None and cand is None:
            bad += 1
            mark = "  ← REGRESSION: the candidate cannot plan it"
        lines.append(f"  {repo}#{j.get('pr')}: current {show(cur)} → candidate {show(cand)}{mark}")
    return bad, lines


def fill_heads(jobs, dev):
    """Give each job a head (from GitHub) and a base (origin/main) when its file names none."""
    for j in jobs:
        root = os.path.join(dev, str(j.get("repo")))
        if j.get("head") or not REPO_RE.match(str(j.get("repo"))) or not str(j.get("pr")).isdigit() \
                or not os.path.isdir(os.path.join(root, ".git")):
            continue
        rc, out, _ = sh(["gh", "pr", "view", str(j.get("pr")), "--json", "headRefOid", "-q", ".headRefOid"],
                        cwd=root, timeout=60)
        head = out.strip() if rc == 0 and SHA_RE.match(out.strip()) else ""
        if head and fetch(root, "main", f"pull/{j.get('pr')}/head"):
            j["head"], j["base_sha"] = head, j.get("base_sha") or resolve(root, "refs/remotes/origin/main")
    return jobs


def cmd_shadow(args, opts):
    root = repo_of(opts.get("repo", ""))
    if len(args) > 1 or not root:
        return die("usage: lander-self shadow [REV] [--repo DIR]", 2)
    sha = resolve(root, args[0] if args else "")
    if not sha:
        return die(f"shadow: cannot resolve {args[0] if args else 'origin/main'} in {root}", 3)
    if not shutil.which("bwrap"):
        return die("shadow: bwrap is not installed, so the plans cannot run sandboxed", 3)
    dev = os.environ.get("CC_DEV") or os.path.join(HOME, "dev")
    pre = core_prefix(root, sha)
    tmp = tempfile.mkdtemp(prefix="lander-self.shadow.")
    try:
        a = subprocess.run(["git", "-C", root, "archive", "--format=tar", f"{sha}:{pre.rstrip('/')}" if pre else sha],
                           capture_output=True)
        subprocess.run(["tar", "-x", "-C", tmp], input=a.stdout, check=False)
        if not os.path.isfile(os.path.join(tmp, "lander", "cli.py")):
            return die(f"shadow: {sha[:12]} holds no lander/cli.py under its core tree", 3)
        cur = link_target("current")
        _, sl = shadow(tmp, os.path.join(cur, "core") if cur else "", fill_heads(live_jobs(), dev), dev)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    bad = [ln for ln in sl if "→ candidate cannot plan" in ln]
    print(f"lander-self shadow: {sha[:12]} over the live queue ({len(sl)} job(s)):")
    for ln in sl:
        print(ln)
    if bad:
        return die(f"shadow: the candidate cannot plan {len(bad)} job(s)")
    return 0


def cmd_check(args, opts):
    if len(args) != 2 or not REPO_RE.match(args[0]) or not args[1].isdigit():
        return die("usage: lander-self check <repo> <pr> [--repo-dir DIR]", 2), None
    repo, pr = args[0], args[1]
    dev = os.environ.get("CC_DEV") or os.path.join(HOME, "dev")
    root = os.path.realpath(opts.get("repo-dir") or os.path.join(dev, repo))
    if not os.path.isdir(os.path.join(root, ".git")) and not os.path.isfile(os.path.join(root, ".git")):
        return die(f"check: no checkout at {root}", 3), None
    rc, out, err = sh(["gh", "pr", "view", pr, *gh_repo(root), "--json", "headRefOid,baseRefName,state,files,comments"],
                      cwd=root)
    try:
        facts = json.loads(out) if rc == 0 else None
    except ValueError:
        facts = None
    if not facts:
        return die(f"check: cannot read PR #{pr} from GitHub: {err.strip()[-200:]}", 3), None
    if facts.get("state") != "OPEN":
        return die(f"check: PR #{pr} is {facts.get('state')}"), None
    head, base = facts.get("headRefOid") or "", facts.get("baseRefName") or "main"
    base_sha = main_sha(root, base) if re.fullmatch(r"[A-Za-z0-9._/-]+", base) else ""
    if not base_sha or not fetch(root, f"pull/{pr}/head") or git(root, "cat-file", "-e", f"{head}^{{commit}}")[0]:
        return die(f"check: cannot fetch {base} and PR #{pr}'s head from the pinned remote", 3), None
    rc, mb, _ = git(root, "merge-base", base_sha, head)
    rc2, names, _ = git(root, "diff", "--name-only", "--no-renames", mb.strip(), head)
    files = sorted(set(names.split()) | {f.get("path", "") for f in facts.get("files") or []} - {""})
    if rc or rc2 or not files:
        return die(f"check: cannot list PR #{pr}'s changed files", 3), None
    rc, pol, _ = git(root, "show", f"{base_sha}:tests/LANDING-policy.toml")
    try:
        pats = lander_list(pol) if rc == 0 else None
    except ValueError:
        pats = None
    if not pats:
        return die(f"check: the base {base_sha[:12]} has no lander list in tests/LANDING-policy.toml, so no path "
                   "may land this way"), None
    out_ = outside(files, pats)
    if out_:
        return die(f"check: PR #{pr} is refused whole: {len(out_)} changed path(s) are not the lander's — "
                   f"{', '.join(out_[:8])}. Split them into an ordinary PR."), None
    bins = binaries(root, mb.strip(), head, (core_prefix(root, head), *BINARY_ROOTS[1:]))
    if bins is None:
        return die(f"check: cannot list what PR #{pr} adds under core/ and bin-private/", 3), None
    if bins:
        return die(f"check: PR #{pr} is refused: it tracks {len(bins)} file(s) that are not source (__pycache__, "
                   f".pyc, .pyo, .so or .pyd anywhere; a binary under core/ or bin-private/; an executable binary "
                   f"anywhere; a symlink anywhere but "
                   f"config/system/) — "
                   f"{', '.join(bins[:8])}. The lander "
                   "imports from core/, so a compiled file there could run in place of the code that was read."), None
    by = land_readers(facts.get("comments"), head, repo, pr)
    miss = reads_missing(by)
    if miss:
        return die(f"check: PR #{pr} at {head[:12]} needs {' and '.join(miss)} recorded at this head (the "
                   f"security read in perms' security-reads.json, the other with `lander record {repo} {pr} LAND "
                   f"--by <reader> --head {head[:12]}`); found: "
                   f"{', '.join(sorted(by)) or 'none'}"), None
    tree = merge_tree(root, base_sha, head)
    if not tree:
        return die(f"check: PR #{pr} does not merge cleanly onto {base}"), None
    pre = core_prefix(root, head)
    if not shutil.which("bwrap"):
        return die("check: bwrap is not installed, so the candidate's tests cannot run sandboxed", 3), None
    ok, lines = candidate_tests(root, base_sha, tree, pre)
    for ln in lines:
        print(f"  {ln}")
    if not ok:
        return die(f"check: PR #{pr}'s merge tree is red on the identity gate or the candidate's own tests"), None
    tmp = tempfile.mkdtemp(prefix="lander-self.shadow.")
    try:
        a = subprocess.run(["git", "-C", root, "archive", "--format=tar", f"{tree}:{pre.rstrip('/')}" if pre else tree],
                           capture_output=True)
        subprocess.run(["tar", "-x", "-C", tmp], input=a.stdout, check=False)
        cur = link_target("current")
        bad, sl = shadow(tmp, os.path.join(cur, "core") if cur else "", live_jobs(), dev)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"  shadow plan over the live queue ({len(sl)} job(s)):")
    for ln in sl:
        print(ln)
    if bad:
        return die(f"check: the candidate cannot plan {bad} job(s) the current release plans"), None
    print(f"lander-self check: {repo}#{pr} at {head[:12]} passed — {len(files)} lander path(s), read by "
          f"{', '.join(sorted(by))}, identity gate and own tests green in bwrap")
    return 0, head


def cmd_land(args, opts):
    rc, head = cmd_check(args, opts)
    if rc != 0:
        return rc
    dev = os.environ.get("CC_DEV") or os.path.join(HOME, "dev")
    root = os.path.realpath(opts.get("repo-dir") or os.path.join(dev, args[0]))
    rc, out, err = sh(["gh", "pr", "merge", args[1], *gh_repo(root), "--squash", "--match-head-commit", head,
                       "--delete-branch"], cwd=root)
    if rc != 0:
        return die(f"land: the merge did not go through: {(out + err).strip()[-300:]}")
    print(f"lander-self: merged {args[0]}#{args[1]} at {head[:12]}; `lander-self promote` switches the lander to it")
    print(f"  {settle_merged(args[0], args[1])}")
    return 0


def settle_merged(repo, pr, run=sh):
    """The lane stopped this PR as a query for lander-self: the current release's `lander settle-merged` moves its job
    to merged and writes the lane's merged line. Its own process, so no lander code runs in this one. A release
    without the command, or none, leaves it to the tick's `ended` sweep, which does the same; never a failure."""
    cur = link_target("current")
    cli = os.path.join(cur, "core", "lander", "cli.py") if cur else ""
    if not cli or not os.path.isfile(cli):
        return "no current release to tell; the lander's tick moves the job once it runs"
    rc, out, err = run([sys.executable, "-P", cli, "settle-merged", repo, str(pr), "--by", "lander-self"], timeout=180)
    said = (out + err).strip().splitlines()
    if rc != 0:
        return f"the lander did not take the merge ({(said or ['exit ' + str(rc)])[-1][-200:]}); its tick moves the job"
    return said[-1] if said else "the lander took the merge"


# --- selfcheck -----------------------------------------------------------------------------------------------------

def selfcheck():
    """Every case builds its own HOME and repo. Prints `lander-self selfcheck: N passed, M failed`."""
    global HOME, ROOT, ALLOW_LOCAL, LAND_STATE
    results = []

    def case(name, cond):
        results.append((name, bool(cond)))
        if not cond:
            print(f"lander-self selfcheck: FAIL {name}")

    old = HOME, ROOT, LAND_STATE
    # the path rule: every changed path must be on the list, and ** crosses segments while * does not
    pats = ["core/lander/**", "core/bin/lander", "core/bin/lander-self", "tests/LANDING.toml"]
    case("paths on the list pass", outside(["core/lander/a/b.py", "core/bin/lander-self"], pats) == [])
    case("a path off the list is named", outside(["core/lander/x.py", "core/bin/cc-land"], pats) == ["core/bin/cc-land"])
    case("the lander's own tree goes with a gate path", outside(["core/lander/review.py", "core/lander/cards.py",
                                                                 "core/tests/lander/test_x.py", "core/bin/cc-x"],
                                                                ["core/lander/review.py"]) == ["core/bin/cc-x"])
    case("* stays in one segment", outside(["core/bin/lander/x"], ["core/bin/*"]) == ["core/bin/lander/x"])
    case("policy without a lander list refuses", _raises(lambda: lander_list("[paths]\ngate_first=['a']\n")))
    case("policy lander list parses", lander_list('[paths]\nlander = ["core/lander/**"]\n') == ["core/lander/**"])
    # records: only the box's own LAND markers at this head count, and both kinds of reader are needed
    h = "0123456789abcdef0123"
    mk = lambda hd, v, b, own=True: {"viewerDidAuthor": own, "body":  # noqa: E731
                                     f"<!-- cc-land-review v2 change=ab base=cd head={hd} verdict={v} by={b} -->\nx"}
    by = readers([mk(h[:12], "LAND", "opus-5.5"), mk(h[:12], "LAND", "perms-security-read"),
                  mk(h[:12], "LAND", "forged-security", own=False), mk("fedcba987654", "LAND", "old-security"),
                  mk(h[:12], "HANDBACK", "sec-security")], h)
    case("readers keep own LAND at head only", by == {"opus-5.5", "perms-security-read"})
    case("both reads present -> nothing missing", reads_missing(by) == [])
    case("no security read is named", reads_missing({"opus-5.5"}) == ["a security read"])
    case("a security read alone is not enough", reads_missing({"perms-security-read"}) == ["an Opus read"])
    case("only exactly perms-security-read is the security read; a name that contains security is not",
         reads_missing({"opus-5.5", "perms-security-read"}) == [] and
         all(reads_missing({"opus-5.5", n}) == ["a security read"]
             for n in ("security-reviewer", "x-security", "perms-security-read-2", "Perms-Security-Read")))
    # perms' ledger: only an entry for exactly this repo, PR and head, LAND or no verdict, in a 0600 plain file
    hd = "ab" * 20
    with tempfile.TemporaryDirectory() as t:
        def ledger(name, entries, mode=0o600):
            p = os.path.join(t, name)
            with open(os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, mode), "w") as f:
                json.dump(entries, f)
            return p
        ent = {"repo": "repo", "pr": 7, "head": hd, "change": "ab"}
        case("ledger: an entry at this head counts", perms_read("repo", "7", hd, ledger("ok.json", [ent])))
        case("ledger: another head does not", not perms_read("repo", "7", "cd" * 20, ledger("head.json", [ent])))
        case("ledger: another PR does not", not perms_read("repo", "8", hd, ledger("pr.json", [ent])))
        case("ledger: a HANDBACK entry does not",
             not perms_read("repo", "7", hd, ledger("hb.json", [{**ent, "verdict": "HANDBACK"}])))
        case("ledger: a group-readable file does not",
             not perms_read("repo", "7", hd, ledger("mode.json", [ent], 0o644)))
        real = ledger("real.json", [ent])
        os.symlink(real, os.path.join(t, "link.json"))
        case("ledger: a symlink does not", not perms_read("repo", "7", hd, os.path.join(t, "link.json")))
        case("ledger: a marker alone is not the security read",
             land_readers([mk(hd[:12], "LAND", "opus-5.5"), mk(hd[:12], "LAND", "perms-security-read")], hd, "repo",
                          "7", ledger("empty.json", [])) == {"opus-5.5"})
    # pin / promote / rollback / legacy on a throwaway repo and HOME
    with tempfile.TemporaryDirectory() as t:
        HOME, ROOT = t, os.path.join(t, ".cc", "lander")
        LAND_STATE = os.path.join(t, ".cc", "state", "land")   # a proof's hold never touches the live queue
        repo = os.path.join(t, "repo")
        os.makedirs(os.path.join(repo, "core", "lander"))
        os.makedirs(os.path.join(repo, "core", "bin"))
        cli = os.path.join(repo, "core", "lander", "cli.py")
        # the sweep's user unit, faked: record what the client was handed, then run the command with the --setenv
        # values alone, as a user manager would; the fake releases' manifest names one check, `demo`
        sysrun = os.path.join(t, "systemd-run")
        with open(sysrun, "w") as f:
            f.write(f"#!{sys.executable}\nimport json, os, sys\na = sys.argv[1:]\n"
                    f"json.dump({{'argv': a, 'env': dict(os.environ)}},\n"
                    f"          open({os.path.join(t, 'sysrun.json')!r}, 'w'))\n"
                    "env = {'PATH': '/usr/bin:/bin'}\nwhile a[0].startswith('--'):\n"
                    "    if a[0].startswith('--setenv='):\n        env.update([a[0][9:].split('=', 1)])\n"
                    "    a = a[1:]\nos.execve(a[0], a, env)\n")
        os.chmod(sysrun, 0o755)
        old_sysrun, os.environ["LANDER_SYSTEMD_RUN"] = os.environ.get("LANDER_SYSTEMD_RUN"), sysrun
        real_names = names_under
        globals()["names_under"] = lambda rel, root, sha: (["demo"], "")  # noqa: E731
        env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
               "GIT_COMMITTER_EMAIL": "t@t"}

        def commit(rc_word, msg):
            with open(cli, "w") as f:
                f.write("import sys; print('lander selfcheck: 1 passed'); print('lander sweep: 1 passed'); "
                        f"sys.stderr.write('lander sweep: demo passed 0s\\n'); sys.exit({rc_word})\n")
            with open(os.path.join(repo, "core", "bin", "lander-self"), "w") as f:
                f.write(f"# {msg}\n")
            with open(os.path.join(repo, "core", "bin", "cc-land"), "w") as f:
                f.write("# old\n")
            os.makedirs(os.path.join(repo, "tests", "landing-repos"), exist_ok=True)
            with open(os.path.join(repo, "tests", "landing-repos", "demo.toml"), "w") as f:
                f.write(f"# {msg}\n")
            subprocess.run(["git", "-C", repo, "add", "-A"], env=env, capture_output=True)
            subprocess.run(["git", "-C", repo, "commit", "-qm", msg], env=env, capture_output=True)
            return git(repo, "rev-parse", "HEAD")[1].strip()

        subprocess.run(["git", "init", "-q", repo], env=env, capture_output=True)
        a = commit(0, "a")
        b = commit(0, "b")
        red = commit(1, "red")
        bare = os.path.join(t, "origin.git")
        subprocess.run(["git", "init", "-q", "--bare", bare], env=env, capture_output=True)
        subprocess.run(["git", "-C", repo, "remote", "add", "origin", bare], capture_output=True)
        subprocess.run(["git", "-C", repo, "push", "-q", "origin", f"{red}:refs/heads/main"], capture_output=True)
        side = commit(0, "side")          # a commit that is not on origin/main: a PR head, or anything else
        # a local branch named origin/main (refs/heads/origin/main) at `side` must not pass for origin's main
        subprocess.run(["git", "-C", repo, "branch", "-f", "origin/main", side], capture_output=True)
        o = {"repo": repo}
        # the boards: a project's checkout (pinned with the tool's own), a member repo's (never pinned here)
        boards, other = os.path.join(t, "boards"), os.path.join(t, "dev", "other")
        os.makedirs(boards)
        for d in (other, os.path.join(t, "dev", "h--t")):
            subprocess.run(["git", "init", "-q", d], capture_output=True)
            subprocess.run(["git", "-C", d, "remote", "add", "origin", bare], capture_output=True)
        for n, path in (("other", other), ("h--t", os.path.join(t, "dev", "h--t"))):
            with open(os.path.join(boards, f"{n}.json"), "w") as f:
                json.dump({"path": path}, f)
        saved_env = {k: os.environ.get(k) for k in ("CC_BOARDS", "CC_DEV")}
        os.environ.update(CC_BOARDS=boards, CC_DEV=os.path.join(t, "dev"))
        quiet = open(os.devnull, "w")
        _out, _err = sys.stdout, sys.stderr
        sys.stdout = sys.stderr = quiet
        try:
            nolocal = pin_remotes(repo)          # a local path is no GitHub repo: nothing is pinned
            pins_nolocal = load_remotes()
            ALLOW_LOCAL = True
            real_caller = perms_caller
            globals()["perms_caller"] = lambda root: False      # any seat but perms: refused, nothing moved
            r_notperms = cmd_promote([a], o)
            cur_notperms = link_target("current")
            globals()["perms_caller"] = lambda root: True       # the perms seat, for the cases below
            r_pin = cmd_pin([], {**o, "rev": a})
            pins_first = load_remotes()
            pinned_a = open(os.path.join(ROOT, "self", "current", "lander-self")).read()
            r1 = cmd_promote([a], o)
            r2 = cmd_promote([b], o)
            cur_b, prev_a = link_target("current"), link_target("previous")
            r3 = cmd_promote([red], o)
            cur_after_red = link_target("current")
            r4 = cmd_rollback([], {})
            cur_rb, prev_rb = link_target("current"), link_target("previous")
            r5 = cmd_rollback([], {"legacy": True})
            r6 = cmd_legacy([a], o)
            r7 = cmd_rollback([], {"legacy": True})
            leg = link_target("legacy-on")
            r8 = cmd_promote([b], o)
            leg_after = link_target("legacy-on")
            # the proof on main: a candidate that turns a check red which the current release passes is refused
            real_sweep = sweep_under
            globals()["sweep_under"] = lambda rel, root, sha, only=(), cap=0, **_: (  # noqa: E731
                {"demo": "passed" if os.path.realpath(rel) == link_target("current") else "failed"}, "")
            try:
                r_regress = cmd_promote([a], o)
                cur_regress = link_target("current")
                globals()["sweep_under"] = lambda rel, root, sha, only=(), cap=0, **_: (  # noqa: E731
                    {}, "stopped at the cap (1s)")
                r_nov = cmd_promote([a], o)
            finally:
                globals()["sweep_under"] = real_sweep
            cur_nov = link_target("current")
            # --no-prove (owner, 10-13): no proof is started, the rest of promote still stands
            real_proven, proofs = proven, []
            globals()["proven"] = lambda *a, **_: (proofs.append(a), ("a proof would refuse", False))[1]  # noqa: E731
            np = {**o, "no-prove": True}
            try:
                globals()["perms_caller"] = lambda root: False
                r_np_notperms = cmd_promote([a], np)
                cur_np_notperms = link_target("current")
                r_prove_notperms = cmd_prove([a], o)    # prove holds the lane: perms' alone
                r_prove_notperms_cap = cmd_prove([a], {**o, "cap": "600"})
                proofs_notperms = len(proofs)
                globals()["perms_caller"] = lambda root: True
                r_prove_perms = cmd_prove([a], o)       # the perms seat reaches the (stubbed, refusing) proof
                proofs_perms = len(proofs) - proofs_notperms
                r_prove_overcap = cmd_prove([a], {**o, "cap": str(PROVE_CAP_MAX + 1)})
                proofs_overcap = len(proofs) - proofs_notperms - proofs_perms
                del proofs[:]
                r_np_red = cmd_promote([red], np)
                cur_np_red = link_target("current")
                r_np_pr = cmd_promote([side], {**np, "pr": "7"})   # an open PR's head, unproven: refused first
                cur_np_pr, proofs_np_pr = link_target("current"), len(proofs)
                r_np_proved = cmd_promote([a], o)       # without the flag the (stubbed, refusing) proof still runs
                proofs_without = len(proofs)
                del proofs[:]
                sys.stdout = said = io.StringIO()
                try:
                    r_np = cmd_promote([a], np)
                finally:
                    sys.stdout = quiet
                cur_np, prev_np = link_target("current"), link_target("previous")
                rec_np, rec_b = promote_record(a), promote_record(b)
                sys.stdout = st_np = io.StringIO()
                try:
                    cmd_status([], {})
                finally:
                    sys.stdout = quiet
                r_np_prove = cmd_prove([a], np)
            finally:
                globals()["proven"] = real_proven
            r_np_rb = cmd_rollback([], {})            # back to b current, a previous, for the cases below
            cur_np_rb = link_target("current")
            sys.stdout = st_rb = io.StringIO()
            try:
                cmd_status([], {})
            finally:
                sys.stdout = quiet
            # promote.log cannot be appended to (a directory in its place): refused before current moves
            log_path = os.path.join(ROOT, PROMOTE_LOG)
            os.rename(log_path, log_path + ".away")
            os.mkdir(log_path)
            r_np_nolog = cmd_promote([a], np)
            cur_np_nolog = link_target("current")
            os.rmdir(log_path)
            os.rename(log_path + ".away", log_path)
            r_side = cmd_promote([side], o)
            cur_side = link_target("current")
            r_pin_side = cmd_pin([], o)
            pinned_side = open(os.path.join(ROOT, "self", "current", "lander-self")).read()
            # a worker's forgery in the shared .git: origin repointed to its own bare repo whose main is `side`,
            # the fetch refspec unset, refs/remotes/origin/main planted — the pinned URL is fetched all the same
            evil = os.path.join(t, "evil.git")
            subprocess.run(["git", "clone", "-q", "--bare", bare, evil], capture_output=True)
            subprocess.run(["git", "-C", repo, "push", "-q", "-f", evil, f"{side}:refs/heads/main"],
                           capture_output=True)
            subprocess.run(["git", "-C", repo, "remote", "set-url", "origin", evil], capture_output=True)
            subprocess.run(["git", "-C", repo, "config", "--unset-all", "remote.origin.fetch"], capture_output=True)
            subprocess.run(["git", "-C", repo, "update-ref", "refs/remotes/origin/main", side], capture_output=True)
            r_forged = cmd_promote([side], o)
            cur_forged = link_target("current")
            main_forged = main_sha(repo)
            pins_forged = load_remotes()
            subprocess.run(["git", "-C", repo, "config", f"url.{evil}.insteadOf", bare], capture_output=True)
            main_rewritten = main_sha(repo)      # a config rewrite of the pinned URL: refused, not followed
            subprocess.run(["git", "-C", repo, "config", "--unset", f"url.{evil}.insteadOf"], capture_output=True)
            # the same rewrite with a space in its subsection, brought in through include.path, to a repo that exists
            subprocess.run(["git", "clone", "-q", "--bare", evil, os.path.join(t, "e x")], capture_output=True)
            with open(os.path.join(t, "x.cfg"), "w") as f:
                f.write(f'[url "{t}/e x"]\n\tinsteadOf = {bare}\n')
            subprocess.run(["git", "-C", repo, "config", "include.path", os.path.join(t, "x.cfg")], capture_output=True)
            main_spaced = main_sha(repo)
            subprocess.run(["git", "-C", repo, "config", "--unset", "include.path"], capture_output=True)
            # remotes.json: only an https://github.com/<owner>/<repo> URL is taken from it
            pins_path = os.path.join(ROOT, "remotes.json")
            pins_saved = open(pins_path).read()
            ALLOW_LOCAL = False
            gh_only = []
            for u in (bare, "https://evil.example/o/r.git", "ssh://git@github.com/o/r.git",
                      "https://github.com/o/r.git"):
                with open(pins_path, "w") as f:
                    json.dump({os.path.realpath(repo): u}, f)
                gh_only.append(remote_for(repo))
            ALLOW_LOCAL = True
            with open(pins_path, "w") as f:
                f.write(pins_saved)
            os.rename(bare, bare + ".away")      # the pinned remote cannot be reached
            r_nofetch = cmd_promote([b], o)
            r_pin_nofetch = cmd_pin([], {**o, "rev": a})
            os.rename(bare + ".away", bare)
            # a release planted (or edited) under releases/<sha> is rebuilt, never run as it stands
            with open(os.path.join(ROOT, "releases", b, "core", "lander", "cli.py"), "a") as f:
                f.write("\n# planted\n")
            r_plant = cmd_promote([b], o)
            clean = "planted" not in open(os.path.join(ROOT, "releases", b, "core", "lander", "cli.py")).read()
        finally:
            globals()["perms_caller"] = real_caller
            sys.stdout, sys.stderr = _out, _err
            quiet.close()
            ALLOW_LOCAL = False
            for k, v in saved_env.items():
                os.environ.pop(k, None) if v is None else os.environ.__setitem__(k, v)
        case("promote from a seat that is not perms is refused and moves nothing",
             r_notperms == 1 and cur_notperms == "" and r1 == 0)
        case("a checkout whose origin is not GitHub is not pinned", pins_nolocal == {} and
             any("will not fetch" in ln for ln in nolocal))
        case("pin pins the tool's checkout and each project board's, not a member repo's",
             pins_first == {os.path.realpath(repo): bare, os.path.realpath(other): bare})
        case("a forged origin in the shared .git is ignored: main is the pinned remote's, side is refused",
             main_forged == red and r_forged != 0 and cur_forged == cur_side and
             pins_forged.get(os.path.realpath(repo)) == bare)
        case("a url.<x>.insteadOf in the shared config that rewrites the pinned URL is refused", main_rewritten == "")
        case("a url.<x>.insteadOf with a space in its subsection, via include.path, is refused", main_spaced == "")
        case("only an https://github.com/<owner>/<repo> URL is taken from remotes.json",
             gh_only == ["", "", "", "https://github.com/o/r.git"])
        case("pin copies the committed tool", r_pin == 0 and pinned_a == "# a\n")
        case("promote builds and switches", r1 == 0 and r2 == 0 and cur_b.endswith(b) and prev_a.endswith(a))
        case("release laid out under core/", os.path.isfile(os.path.join(cur_b, "core", "lander", "cli.py")))
        case("release carries the host fallback manifests",
             os.path.isfile(os.path.join(cur_b, "tests", "landing-repos", "demo.toml")))
        case("a red release is refused, current kept", r3 != 0 and cur_after_red == cur_b)
        case("rollback swaps current and previous", r4 == 0 and cur_rb.endswith(a) and prev_rb.endswith(b))
        case("rollback --legacy with nothing pinned refuses", r5 != 0)
        case("legacy pins and rollback --legacy points at it", r6 == 0 and r7 == 0 and leg.endswith(a))
        case("promote clears the legacy switch", r8 == 0 and leg_after == "")
        case("promote passes the proof when the candidate's sweep is green", r2 == 0 and r8 == 0)
        case("promote refuses a candidate whose sweep turns a current green red, current kept",
             r_regress == 1 and cur_regress == cur_b)
        case("promote whose proof gives no verdict exits 3 (could not run), not 1, and keeps current",
             r_nov == 3 and cur_nov == cur_b)
        case("promote --no-prove from a seat that is not perms is refused and moves nothing",
             r_np_notperms == 1 and cur_np_notperms == cur_b)
        case("promote --no-prove still refuses a release whose own selfcheck is red",
             r_np_red != 0 and cur_np_red == cur_b)
        case("promote without --no-prove still runs the proof, and its refusal keeps current",
             r_np_proved == 1 and proofs_without == 1)
        case("promote --no-prove switches without starting a proof, keeps previous and says it skipped",
             r_np == 0 and proofs == [] and cur_np.endswith(a) and prev_np == cur_b and
             "proof skipped (--no-prove) on the owner's 2026-10-13 17:33Z direction" in said.getvalue())
        case("rollback after a --no-prove promote puts the one before back", r_np_rb == 0 and cur_np_rb == cur_b)
        case("prove refuses --no-prove (promote's alone)", r_np_prove == 2)
        case("prove from a seat that is not perms is refused before any proof or hold, with or without --cap",
             r_prove_notperms == 1 and r_prove_notperms_cap == 1 and proofs_notperms == 0)
        case("prove from the perms seat runs the proof", r_prove_perms == 1 and proofs_perms == 1)
        case("prove with --cap above PROVE_CAP_MAX is refused before any proof", r_prove_overcap == 2
             and proofs_overcap == 0)
        case("promote --no-prove --pr N is refused (exit 2) before a proof or a switch: unproven means on main",
             r_np_pr == 2 and cur_np_pr == cur_b and proofs_np_pr == 0)
        case("a --no-prove promote appends a no-prove line for its sha with the caller to promote.log",
             rec_np is not None and rec_np[1] == "no-prove" and rec_np[2].startswith("pid ") and
             re.match(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ\Z", rec_np[0]) is not None)
        case("a proven promote appends a proven line", rec_b is not None and rec_b[1] == "proven")
        case("status says current was not proven after a --no-prove promote",
             f"proven        no (--no-prove at {rec_np[0]}" in st_np.getvalue() if rec_np else False)
        case("status says yes once current is a proven release again (rollback)",
             "proven        yes\n" in st_rb.getvalue())
        case("promote refuses (exit 3) and keeps current when promote.log cannot be appended to",
             r_np_nolog == 3 and cur_np_nolog == cur_b)
        case("promote_record: no log line for a sha is None (status says unknown)", promote_record("0" * 40) is None)
        case("--no-prove: parse() takes it", parse(["promote", "--no-prove"])[1].get("no-prove") is True)
        case("a commit not on origin/main is refused", r_side != 0 and cur_side == cur_b)
        case("origin/main resolves to origin's, not to a local branch named origin/main",
             resolve(repo, "origin/main") == red and resolve(repo, "") == red)
        case("pin with no rev takes origin's main, not a local origin/main branch",
             r_pin_side == 0 and pinned_side == "# red\n")
        case("promote refuses when the pinned remote cannot be fetched", r_nofetch != 0)
        case("pin refuses when the fetch fails", r_pin_nofetch != 0)
        case("an edited release dir is rebuilt from the commit", r_plant == 0 and clean)
        role, here = os.environ.pop("CC_ROLE", None), os.getcwd()
        os.chdir(t)   # no .cc/track above: this selfcheck may itself run inside a worker's worktree
        both = [mk(side[:12], "LAND", "opus-5.5"), mk(side[:12], "LAND", "perms-security-read")]
        led = os.path.join(t, "security-reads.json")   # perms' ledger, read at the exact head
        with open(os.open(led, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump([{"repo": "repo", "pr": 5, "head": side, "change": "ab"}], f)
        none = os.path.join(t, "no-reads.json")
        with open(os.open(none, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), "w") as f:
            json.dump([], f)
        m = red
        try:
            case("--pr allows exactly the open PR's head with the Opus LAND and perms' ledger entry",
                 promotable(repo, side, "5", lambda r, n: (side, both[:1]), main=m, ledger=led) == "")
            case("--pr with a perms-security-read marker and no ledger entry still needs the security read",
                 "security" in promotable(repo, side, "5", lambda r, n: (side, both), main=m, ledger=none))
            case("--pr with another head is refused",
                 promotable(repo, side, "5", lambda r, n: (a, both), main=m, ledger=led) != "")
            case("--pr with the ledger but no Opus LAND is refused", "Opus" in promotable(
                repo, side, "5", lambda r, n: (side, both[1:]), main=m, ledger=led))
            case("--pr with LAND records at an older head is refused", promotable(
                repo, side, "5", lambda r, n: (side, [mk(a[:12], "LAND", "opus-5.5"),
                                                      mk(a[:12], "LAND", "perms-security-read")]), main=m,
                ledger=none) != "")
            case("no --pr: a non-main commit is refused", promotable(repo, side, "", main=m) != "")
            case("no verified main: everything is refused", promotable(repo, b, "") != "")
            os.environ["CC_ROLE"] = "worker"
            case("a worker may not use --pr", "worker" in promotable(repo, side, "5", lambda r, n: (side, both),
                                                                     main=m))
            case("a worker may still promote main", promotable(repo, b, "", main=m) == "")
            os.environ.pop("CC_ROLE", None)
            os.makedirs(os.path.join(t, "wt", ".cc"))
            open(os.path.join(t, "wt", ".cc", "track"), "w").close()
            os.chdir(os.path.join(t, "wt"))
            case("a .cc/track above the cwd is a worker too",
                 "worker" in promotable(repo, side, "5", lambda r, n: (side, both), main=m))
        finally:
            os.chdir(here)
            os.environ.pop("CC_ROLE", None)
            if role is not None:
                os.environ["CC_ROLE"] = role
        rollback_legacy_cases(case, t)
        prove_cases(case, t, real_names)
        status_lane_cases(case, t)
        settle_merged_cases(case)
        globals()["names_under"] = real_names
        if old_sysrun is None:
            os.environ.pop("LANDER_SYSTEMD_RUN", None)
        else:
            os.environ["LANDER_SYSTEMD_RUN"] = old_sysrun
    # shadow: a job that already names a head, or has no checkout, is left as it is (GitHub is never asked);
    # a second REV is a usage refusal before anything is read
    with tempfile.TemporaryDirectory() as dev:
        os.makedirs(os.path.join(dev, "r", ".git"))
        given = [{"repo": "r", "pr": 1, "head": "h" * 40, "base_sha": "b" * 40}, {"repo": "gone", "pr": 2}]
        case("shadow leaves a job with a head, and one with no checkout, alone",
             fill_heads([dict(j) for j in given], dev) == given)
        _, sl = shadow("", "", [{"repo": "r", "pr": 1, "head": "$(touch /tmp/x)", "base_sha": "b" * 40}], dev)
        case("shadow skips a job whose head is not a sha (nothing reaches a command line)", "skipped" in sl[0])
        _err, sys.stderr = sys.stderr, open(os.devnull, "w")
        try:
            r_use = cmd_shadow(["a", "b"], {"repo": dev})
        finally:
            sys.stderr.close()
            sys.stderr = _err
        case("shadow with two revs is a usage refusal", r_use == 2)
    perms_caller_cases(case)
    hold_cases(case)
    identity_gate_cases(case)
    pycache_cases(case)
    check_binaries_cases(case)
    sweep_cases(case)
    HOME, ROOT, LAND_STATE = old
    bad = sum(1 for _, ok in results if not ok)
    print(f"lander-self selfcheck: {len(results) - bad} passed, {bad} failed")
    return 1 if bad else 0


def pycache_cases(case):
    """A commit that force-adds core/lander/__pycache__/run.<tag>.pyc, compiled UNCHECKED_HASH from other source than
    its run.py: the release built from it imports run.py's code, not the pyc's. And `check`'s binaries(): a PR that
    adds a __pycache__ path, a .pyc, a .so or a binary under core/ is named for each; a .py it adds, a binary already
    on the base, one it deletes, and one outside core/ are not. Its own repo and ROOT."""
    global ROOT
    import importlib.util
    import py_compile
    old_root = ROOT
    with tempfile.TemporaryDirectory() as t:
        ROOT = os.path.join(t, "lander")
        repo = os.path.join(t, "repo")
        env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
               "GIT_COMMITTER_EMAIL": "t@t"}

        def put(rel, data):
            p = os.path.join(repo, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "wb") as f:
                f.write(data if isinstance(data, bytes) else data.encode())

        def commit(msg):
            subprocess.run(["git", "-C", repo, "add", "-Af", "."], check=True, env=env, capture_output=True)
            subprocess.run(["git", "-C", repo, "commit", "-qm", msg], check=True, env=env, capture_output=True)
            return git(repo, "rev-parse", "HEAD")[1].strip()

        subprocess.run(["git", "init", "-q", repo], check=True, env=env, capture_output=True)
        put("core/lander/cli.py", "")
        put("core/lander/__init__.py", "")
        put("core/docs/old.png", b"\x89PNG\0old")
        put("core/docs/gone.bin", b"\0gone")
        base = commit("base")
        put("core/lander/run.py", "X = 'source'\n")
        evil = os.path.join(t, "evil.py")
        with open(evil, "w") as f:
            f.write("X = 'pyc'\n")
        pyc = importlib.util.cache_from_source(os.path.join(repo, "core", "lander", "run.py"))
        py_compile.compile(evil, cfile=pyc, doraise=True,
                           invalidation_mode=py_compile.PycInvalidationMode.UNCHECKED_HASH)
        put("core/lander/fast.cpython-314-x86_64-linux-gnu.so", "not really")
        put("core/lander/blob.dat", b"text\0then a NUL")
        put("core/.gitattributes", "*.dat text diff\n")
        put("core/lander/ok.py", "Y = 1\n")
        put("docs/outside.bin", b"\0outside")
        os.remove(os.path.join(repo, "core", "docs", "gone.bin"))
        head = commit("adds a pyc")
        rel_pyc = os.path.relpath(pyc, repo)
        rel = build(repo, head, "releases")
        rc, out, err = sh([sys.executable, "-c", "import sys; sys.path.insert(0, sys.argv[1]); import lander.run as r; "
                           "print(r.X)", os.path.join(rel, "core")], env={**env, "PYTHONDONTWRITEBYTECODE": "1"})
        # the brief: "a force-added pyc compiled with PycInvalidationMode.UNCHECKED_HASH ... import lander.run loads
        # the pyc" — so the release must not carry it, and the import must run run.py
        case("a release built from a commit tracking an unchecked-hash pyc runs the .py, not the pyc",
             rc == 0 and out.strip() == "source" and
             not os.path.lexists(os.path.join(rel, rel_pyc)) and
             os.path.isfile(os.path.join(rel, "core", "lander", "run.py")))
        case("…and the commit does track it, so the build is what left it out",
             git(repo, "cat-file", "-e", f"{head}:{rel_pyc}")[0] == 0)
        case("check's binaries() names every non-source file the PR adds under core/, and nothing else",
             binaries(repo, base, head, "core/") == sorted([
                 rel_pyc, "core/lander/blob.dat", "core/lander/fast.cpython-314-x86_64-linux-gnu.so"]))
        case("…the whole repo is the core tree when it has no core/ prefix",
             "docs/outside.bin" in (binaries(repo, base, head, "") or []))
        case("…and an unknown base is None, not a pass", binaries(repo, "0" * 40, head, "core/") is None)
        # perms, after #1298: "build() drops .so and .pyd" — and every other file binaries() would refuse
        case("the release leaves out the .so and the NUL-bearing blob, and keeps the .py beside them",
             not os.path.lexists(os.path.join(rel, "core", "lander", "fast.cpython-314-x86_64-linux-gnu.so")) and
             not os.path.lexists(os.path.join(rel, "core", "lander", "blob.dat")) and
             os.path.isfile(os.path.join(rel, "core", "lander", "ok.py")))
        put("bin-private/door.so", "not really")
        put("bin-private/door", "#!/bin/sh\n")
        side = commit("bin-private")
        case("binaries() reads bin-private/ by default, beside core/",
             binaries(repo, head, side) == ["bin-private/door.so"])
    ROOT = old_root


def check_binaries_cases(case):
    """`check <repo> <pr>` end to end on a pinned bare origin and a fake gh: a PR that puts git.cpython-*.so beside
    the gate module core/lander/git.py, or a NUL-bearing file under bin-private/, is refused for it; the same PR with
    a .py instead passes that step and stops at the missing reads. Its own repo, ROOT, PATH and ALLOW_LOCAL."""
    global ROOT, ALLOW_LOCAL
    import contextlib
    import io
    keep = ROOT, ALLOW_LOCAL, os.environ.get("PATH", "")
    with tempfile.TemporaryDirectory() as t:
        ROOT, ALLOW_LOCAL = os.path.join(t, "lander"), True
        env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
               "GIT_COMMITTER_EMAIL": "t@t"}
        origin, repo, fake = (os.path.join(t, n) for n in ("origin.git", "repo", "bin"))

        def g(*a):
            return subprocess.run(["git", *a], check=True, env=env, capture_output=True, text=True).stdout.strip()

        def put(rel, data):
            p = os.path.join(repo, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "wb") as f:
                f.write(data if isinstance(data, bytes) else data.encode())

        g("init", "-q", "--bare", origin)
        g("init", "-q", "-b", "main", repo)
        put("core/lander/cli.py", "")
        put("core/lander/git.py", "X = 'source'\n")
        put("tests/LANDING-policy.toml", '[paths]\nlander = ["core/bin/lander-self", "bin-private/**"]\n')
        g("-C", repo, "add", "-A")
        g("-C", repo, "commit", "-qm", "base")
        g("-C", repo, "push", "-q", origin, "main")
        prs = {"7": {"core/lander/git.cpython-314-x86_64-linux-gnu.so": "not really"},
               "8": {"core/lander/fast.py": "Y = 1\n"},
               "9": {"bin-private/door": b"#!/bin/sh\n\0"}}
        os.makedirs(fake)
        for n, files in prs.items():
            g("-C", repo, "checkout", "-q", "-B", f"pr{n}", "main")
            for rel, data in files.items():
                put(rel, data)
            g("-C", repo, "add", "-A")
            g("-C", repo, "commit", "-qm", f"pr {n}")
            g("-C", repo, "push", "-q", origin, f"pr{n}:refs/pull/{n}/head")
            with open(os.path.join(fake, f"{n}.json"), "w") as f:
                json.dump({"headRefOid": g("-C", repo, "rev-parse", "HEAD"), "baseRefName": "main", "state": "OPEN",
                           "files": [{"path": p} for p in files], "comments": []}, f)
        with open(os.path.join(fake, "gh"), "w") as f:
            f.write(f"#!{sys.executable}\nimport sys\nprint(open({fake!r} + '/' + sys.argv[3] + '.json').read())\n")
        os.chmod(os.path.join(fake, "gh"), 0o755)
        os.makedirs(ROOT)
        with open(os.path.join(ROOT, "remotes.json"), "w") as f:
            json.dump({os.path.realpath(repo): origin}, f)
        os.environ["PATH"] = fake + os.pathsep + keep[2]
        said = {}
        try:
            for n in prs:
                e = io.StringIO()
                with contextlib.redirect_stderr(e):
                    rc, _ = cmd_check(["r", n], {"repo-dir": repo})
                said[n] = (rc, e.getvalue())
        finally:
            ROOT, ALLOW_LOCAL = keep[:2]
            os.environ["PATH"] = keep[2]
    # perms, after #1298: "Add an end-to-end case in which a .so beside a gate module is refused"
    case("check refuses a PR that puts git.cpython-*.so beside core/lander/git.py, naming it",
         said["7"][0] == 1 and "not source" in said["7"][1] and "git.cpython-314" in said["7"][1])
    case("…and a NUL-bearing file under bin-private/", said["9"][0] == 1 and "bin-private/door" in said["9"][1])
    case("…while the same PR with a .py passes that step and stops at the reads",
         said["8"][0] == 1 and "not source" not in said["8"][1] and "needs" in said["8"][1])


def sweep_cases(case):
    """Perms' three gaps after #1301, and `sweep`. Each block builds its own repo: (a) a symlink under mcp/ (or
    dashboard/, lessons/, vr/) is named, one under config/system/ is not; (b) an executable with a NUL outside the
    roots is named, the same bytes not executable and an executable script are not; (c) git_peek keeps PEEK bytes of
    a large blob, so a NUL past them is not seen; and tree_binaries()/`sweep` on a whole tree."""
    import contextlib
    import io
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
           "GIT_COMMITTER_EMAIL": "t@t"}

    def fixture(t):
        repo = os.path.join(t, "repo")
        subprocess.run(["git", "init", "-q", repo], check=True, env=env, capture_output=True)

        def put(rel, data, mode=0o644, link=None):
            p = os.path.join(repo, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            if link is not None:
                os.symlink(link, p)
                return
            with open(p, "wb") as f:
                f.write(data if isinstance(data, bytes) else data.encode())
            os.chmod(p, mode)

        def commit(msg):
            subprocess.run(["git", "-C", repo, "add", "-Af", "."], check=True, env=env, capture_output=True)
            subprocess.run(["git", "-C", repo, "commit", "-q", "--allow-empty", "-m", msg], check=True, env=env,
                           capture_output=True)
            return git(repo, "rev-parse", "HEAD")[1].strip()
        return repo, put, commit

    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        base = commit("base")
        for d in ("mcp", "dashboard", "lessons", "vr"):
            put(f"{d}/run", None, link="../docs/x")
        put("config/system/etc/unit.service", None, link="/dev/null")
        head = commit("links")
        got = binaries(repo, base, head)
        # perms, after #1301: "(a) symlinks under mcp/, dashboard/, lessons/ and vr/ are still allowed"
        case("binaries() names a new symlink under mcp/, dashboard/, lessons/ and vr/",
             got == ["dashboard/run", "lessons/run", "mcp/run", "vr/run"])
        case("…and not one under config/system/", "config/system/etc/unit.service" not in (got or []))
    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        base = commit("base")
        put("dashboard/server.py", b"\x7fELF\0\0", mode=0o755)
        put("dashboard/data.bin", b"\0data")
        put("dashboard/start", "#!/bin/sh\nexec true\n", mode=0o755)
        head = commit("exec")
        got = binaries(repo, base, head)
        # perms, after #1301: "(b) a NUL-bearing executable outside core/ and bin-private/ still lands"
        case("binaries() names a NUL-bearing executable outside core/ and bin-private/",
             "dashboard/server.py" in (got or []))
        case("…but not the same kind of bytes without the x bit, nor an executable script",
             got == ["dashboard/server.py"])
    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        base = commit("base")
        put("core/big.txt", b"a" * (PEEK + 5) + b"\0")
        put("core/small.txt", b"x\0")
        head = commit("big")
        shas = [git(repo, "rev-parse", f"{head}:core/{n}")[1].strip() for n in ("big.txt", "small.txt")]
        got = git_peek(["git", "-C", repo])(shas + ["0" * 40])
        # perms, after #1301: "(c) binaries() reads each blob whole"
        case("git_peek keeps PEEK bytes of a large blob, reads several in one go, and a missing one is None",
             got is not None and got[shas[0]] == b"a" * PEEK and got[shas[1]] == b"x\0" and got["0" * 40] is None)
        case("…so binaries() does not see a NUL past PEEK, and does see one inside it",
             binaries(repo, base, head) == ["core/small.txt"])
    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        put("core/bin/cc-mail", None, link="../mail/receiver.py")
        put("core/mail/receiver.py", "print(1)\n", mode=0o755)
        put("dashboard/ok.py", "print(1)\n", mode=0o755)
        put("bin-private/box-ok", None, link="../dashboard/ok.py")
        put("docs/away", None, link="../../elsewhere")
        put("config/system/etc/x.service", None, link="/usr/lib/x.service")
        clean = commit("clean")
        e = io.StringIO()
        with contextlib.redirect_stdout(e):
            rc_clean = cmd_sweep([clean], {"repo": repo})
        case("sweep passes a tree whose only links point at source, or out of the repo from outside the roots",
             tree_binaries(repo, clean) == [] and rc_clean == 0 and "tracks no compiled" in e.getvalue())
        put("core/lander/__pycache__/run.cpython-314.pyc", b"\0pyc")
        put("bin-private/door.so", "x")
        put("dashboard/server.py", b"\x7fELF\0", mode=0o755)
        put("bin-private/box-dash", None, link="../dashboard/server.py")
        put("docs/cache", None, link="../core/lander/__pycache__")
        put("docs/up", None, link="..")
        put("docs/via", None, link="up/dashboard/server.py")
        put("core/out", None, link="../../etc/passwd")
        put("docs/loop1", None, link="loop2")
        put("docs/loop2", None, link="loop1")
        dirty = commit("dirty")
        e = io.StringIO()
        with contextlib.redirect_stdout(e):
            rc_dirty = cmd_sweep([dirty], {"repo": repo})
        got = tree_binaries(repo, dirty)
        # the brief: "a compiled file (.so, .pyc, __pycache__, a symlink into one) that reaches main another way"
        case("sweep names a compiled file, an executable binary, and each symlink into one, through another link",
             got == sorted(["core/lander/__pycache__/run.cpython-314.pyc", "bin-private/door.so",
                            "dashboard/server.py", "bin-private/box-dash", "docs/cache", "docs/via", "core/out",
                            "docs/loop1", "docs/loop2"]))
        case("…and exits 2 with the summary last, for cc-watch's BAD",
             rc_dirty == 2 and e.getvalue().splitlines()[-1].startswith("lander-self sweep: ") and
             "9 path(s)" in e.getvalue())
        _err, sys.stderr = sys.stderr, open(os.devnull, "w")
        try:
            rc_bad = cmd_sweep(["no-such-rev"], {"repo": repo})
        finally:
            sys.stderr.close()
            sys.stderr = _err
        case("…while a REV it cannot resolve is 3, not a pass", rc_bad == 3)
    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        base = commit("base")
        png = PNG + b"\0\0\0\rIHDR"
        put("core/docs/tour/1-what-it-is.png", png)
        put("core/docs/tour/fake.png", b"\0not a png")
        put("core/docs/tour/run.png", png, mode=0o755)
        put("core/lander/pic.png", png)
        put("bin-private/docs/x.png", png)
        head = commit("pictures")
        want = ["bin-private/docs/x.png", "core/docs/tour/fake.png", "core/docs/tour/run.png", "core/lander/pic.png"]
        # the Opus read of #1306: "it reports the five PNGs under core/docs/tour/ … add an explicit allowlist"
        case("a plain PNG under core/docs/ stands in check and sweep; a fake, an executable or one elsewhere does not",
             binaries(repo, base, head) == want and tree_binaries(repo, head) == want)
    with tempfile.TemporaryDirectory() as t:
        repo, put, commit = fixture(t)
        put("core/lander/cli.py", "")
        put("docs/l0/ok.py", "print(1)\n")
        # each link names the one before it twice, so resolving l30 without a cache walks 2^30 links
        for i in range(1, 31):
            put(f"docs/l{i}", None, link=f"l{i - 1}/../l{i - 1}")
        put("docs/top", None, link="l30/ok.py")
        head = commit("chain")
        import time
        t0 = time.monotonic()
        got = tree_binaries(repo, head)
        # the Opus read of #1306: "symlink resolution is exponential … so cache resolved links"
        case("sweep resolves a link that names another twice per level in time linear in the links",
             got == [] and time.monotonic() - t0 < 20)


def hold_cases(case):
    """THE HOLD and --cap: each case on its own queue dir."""
    import time
    g = globals()

    def locked(p):
        with open(p, "a") as f:
            try:
                fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return False
            except OSError:
                return True
    with tempfile.TemporaryDirectory(prefix="lander-self-hold.") as t:
        now = time.time_ns()
        st = os.path.join(t, "a")
        q = os.path.join(st, "slots", "queue")
        os.makedirs(q)
        lane = f"+{now - 30 * 10**9:019d}-4646-0000b0b0"
        worker = f"0{now - 600 * 10**9:019d}-4747-0000c0c0"
        for n in (lane, worker):
            open(os.path.join(q, n), "a").close()
        name, f = hold_lane(st, now)
        case("hold: its ticket sorts before every lane and worker ticket", sorted(os.listdir(q))[0] == name
             and name < lane < worker and name.startswith(f"+{now - 30 * 10**9 - 1:019d}-"))
        case("hold: its ticket is flocked while held", locked(os.path.join(q, name)))
        f.close()
        case("hold: a closed hold leaves a ticket any waiter takes for dead", not locked(os.path.join(q, name)))

        st = os.path.join(t, "b")
        q = os.path.join(st, "slots", "queue")
        os.makedirs(q)
        open(os.path.join(q, f"+{now - 7200 * 10**9:019d}-4848-0000d0d0"), "a").close()   # a stuck lane waiter
        name, f = hold_lane(st, now)
        case("hold: never named more than HOLD_BACK back", name.startswith(f"+{now - HOLD_BACK * 10**9:019d}-"))
        f.close()

        st = os.path.join(t, "c")
        said = []
        h = Hold(st, said.append)
        n1 = h.take()
        case("hold: take() holds once, however often it is asked", n1 and h.take() == n1
             and os.listdir(os.path.join(st, "slots", "queue")) == [n1])
        h.drop()
        h.drop()
        case("hold: drop() removes the ticket, once", os.listdir(os.path.join(st, "slots", "queue")) == []
             and sum("admitted again" in ln for ln in said) == 1)
        bad = os.path.join(t, "file")
        open(bad, "w").close()
        h = Hold(bad, said.append)
        case("hold: a hold that cannot be written is said, and the proof goes on unheld",
             h.take() == "" and "could not hold the lane" in said[-1])

        # a lander-self killed mid-proof: the kernel drops its flock, so the ticket is a dead one
        st = os.path.join(t, "d")
        r, w = os.pipe()
        pid = os.fork()
        if pid == 0:
            os.close(r)
            nm, _f = hold_lane(st)
            os.write(w, nm.encode())
            time.sleep(60)
            os._exit(0)
        os.close(w)
        nm = os.read(r, 200).decode()
        os.close(r)
        p = os.path.join(st, "slots", "queue", nm)
        alive = locked(p)
        os.kill(pid, 9)
        os.waitpid(pid, 0)
        case("hold: a killed lander-self's ticket is held while it lives and dead after", alive and not locked(p))

        rel_new, rel_old = os.path.join(t, "new"), os.path.join(t, "old")
        for r_, text in ((rel_new, "x = os.environ.get('LANDER_PROVE_HOLD')\n"), (rel_old, "x = 1\n")):
            os.makedirs(os.path.join(r_, "core", "lander"))
            with open(os.path.join(r_, "core", "lander", "admission.py"), "w") as f:
                f.write(text)
        case("hold: a release whose admission reads LANDER_PROVE_HOLD holds, one without does not",
             holds(rel_new) and not holds(rel_old) and not holds(os.path.join(t, "none")))

        # proven: the candidate's sweep runs held, the current release's unheld, and the hold goes however it ends
        st = os.path.join(t, "e")
        q = os.path.join(st, "slots", "queue")
        seen = []

        def sweep(rel, root, sha, only=(), cap=0, grace=0, hold=""):
            seen.append((os.path.basename(rel), hold, cap, sorted(os.listdir(q)) if os.path.isdir(q) else []))
            if rel == rel_new:
                return ({"a": "failed"} if not only else {n: "failed" for n in only}), ""
            raise ValueError("the current release's sweep fell over")
        saved = {k: g[k] for k in ("sweep_under", "names_under")}
        g["sweep_under"], g["names_under"] = sweep, lambda r, root, sha: (["a"], "")
        try:
            out = _raises(lambda: proven(rel_new, rel_old, t, "f" * 40, 77, st))
        finally:
            g.update(saved)
        case("hold: the candidate's sweeps run held and under --cap", [s_[:3] for s_ in seen[:2]] ==
             [("new", seen[0][1], 77), ("new", seen[0][1], seen[1][2])] and seen[0][1]
             and seen[0][3] == [seen[0][1]] and seen[1][1] == seen[0][1])
        case("hold: the current release's sweep runs unheld, with no ticket in the queue",
             len(seen) == 3 and seen[2][:2] == ("old", "") and seen[2][3] == [])
        case("hold: a proof that raises leaves the lane unheld", out and os.listdir(q) == [])

    case("--cap: none is PROVE_CAP", cap_of({}) == PROVE_CAP)
    case("--cap: whole seconds are taken for this run", cap_of({"cap": "5400"}) == 5400)
    case("--cap: 0, a sign, a word or a superscript is refused",
         not any(cap_of({"cap": v}) for v in ("0", "-5", "+5", "1h", "", "\u00b2", "9" * 12)))
    case("--cap: PROVE_CAP_MAX is taken and one second more is refused",
         cap_of({"cap": str(PROVE_CAP_MAX)}) == PROVE_CAP_MAX and cap_of({"cap": str(PROVE_CAP_MAX + 1)}) == 0
         and PROVE_CAP_MAX < 43200)
    case("--cap: parse() takes its value", parse(["x", "--cap", "90"])[1].get("cap") == "90")


def identity_gate_cases(case):
    """The merge tree's identity gate: a clean tree passes; a tree that puts the box's name in core/ is refused, in
    a plain file, in a file its own .gitignore hides, or behind a gate it swapped for one that always passes; a tree
    that drops the base's gate is refused; and with no gate on either side it is not held. Each case is its own
    commit off the base it is judged against, extracted fresh. The runner is the
    sandbox's argv run plainly in the tree with a clear env, so the cases need no bwrap; the gate stand-in reads
    the working tree with git as the real one does, and git failing to read it is a red, so the repo made for it is
    proven to be there."""
    marker = "boxname" + "-x7"   # split, so this file never carries the string the fixture's gate looks for
    gate = ("set -e; cd \"$(dirname \"$(readlink -f \"$0\")\")/..\"\n"
            f"rc=0; o=$(git grep --untracked -n -i {marker} -- core) || rc=$?\n"
            "case $rc in 1) echo 'check-extra.sh: OK';; 0) echo \"private string inside core/: $o\"; exit 1;;\n"
            "  *) echo \"could not read the tree (rc $rc)\"; exit 2;; esac\n")
    with tempfile.TemporaryDirectory() as t:
        repo = os.path.join(t, "repo")
        env = {"PATH": "/usr/local/bin:/usr/bin:/bin", "HOME": t, "LANG": "C.UTF-8", "TMPDIR": t,
               "PYTHONDONTWRITEBYTECODE": "1", "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t",
               "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}

        def put(rel, text):
            p = os.path.join(repo, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            with open(p, "w") as f:
                f.write(text)

        def commit(msg, start, files=(), drop=()):
            subprocess.run(["git", "-C", repo, "checkout", "-qf", "--detach", start], env=env, capture_output=True)
            for rel, text in files:
                put(rel, text)
            for rel in drop:
                os.remove(os.path.join(repo, rel))
            subprocess.run(["git", "-C", repo, "add", "-Af", "."], env=env, capture_output=True)
            subprocess.run(["git", "-C", repo, "commit", "-qm", msg], env=env, capture_output=True)
            return git(repo, "rev-parse", "HEAD")[1].strip()

        subprocess.run(["git", "init", "-q", repo], env=env, capture_output=True)
        put("core/lander/cli.py", "print('lander selfcheck: 1 passed')\n")
        put("core/tests/lander/test_ok.py", "import unittest\nclass T(unittest.TestCase):\n"
                                            "    def test_ok(self):\n        pass\n")
        subprocess.run(["git", "-C", repo, "add", "-A"], env=env, capture_output=True)
        subprocess.run(["git", "-C", repo, "commit", "-qm", "bare"], env=env, capture_output=True)
        bare = git(repo, "rev-parse", "HEAD")[1].strip()
        boxed = ("core/lander/nightly.py", f"BOX = '{marker}'\n")
        clean = commit("clean", bare, [("tests/check-extra.sh", gate)])
        dirty = commit("box name in core", clean, [boxed])
        hidden = commit("box name in an ignored core file", clean,
                        [("core/lander/.gitignore", "secret.py\n"), ("core/lander/secret.py", f"BOX = '{marker}'\n")])
        weak = commit("gate weakened", clean, [boxed, ("tests/check-extra.sh", "echo 'check-extra.sh: OK'\n")])
        dropped = commit("gate dropped", clean, drop=["tests/check-extra.sh"])
        run = lambda tree, argv: sh(argv, cwd=tree, env=env, timeout=120)  # noqa: E731
        ok_c, l_c = candidate_tests(repo, clean, clean, "core/", run)
        ok_d, l_d = candidate_tests(repo, clean, dirty, "core/", run)
        ok_h, l_h = candidate_tests(repo, clean, hidden, "core/", run)
        ok_w, l_w = candidate_tests(repo, clean, weak, "core/", run)
        ok_x, l_x = candidate_tests(repo, clean, dropped, "core/", run)
        ok_n, l_n = candidate_tests(repo, bare, bare, "core/", run)
    case("a clean merge tree passes the identity gate and the candidate's tests",
         ok_c and l_c[0].startswith("core-identity (tests/check-extra.sh): passed") and len(l_c) == 3)
    case("a merge tree that puts box identity in core/ is refused, and the hit is named",
         not ok_d and "FAILED (rc 1)" in l_d[0] and "core/lander/nightly.py" in "\n".join(l_d))
    case("box identity in a core file the merge tree's own .gitignore hides is refused, and the hit is named",
         not ok_h and "FAILED (rc 1)" in l_h[0] and "core/lander/secret.py" in "\n".join(l_h))
    case("the base's gate runs, so a merge tree that swaps in a gate that always passes is still refused",
         not ok_w and "FAILED (rc 1)" in l_w[0] and "core/lander/nightly.py" in "\n".join(l_w))
    case("a merge tree that drops the gate the base has is refused",
         not ok_x and "drops it" in l_x[0])
    case("with no tests/check-extra.sh on the base or the merge tree, it says so and is not held",
         ok_n and "none to run" in l_n[0])


def reuse_cases(case, t, fake):
    """Reusing the current release's greens on main's tree: each case on its own releases, records and fake sweep."""
    def put(path, text, mode=0o644):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
        os.chmod(path, mode)

    def rels(tag, cand_run="RUN", extra=None):
        cur, cand = os.path.join(t, tag, "c" * 40), os.path.join(t, tag, "d" * 40)
        for d, body in ((cur, "RUN"), (cand, cand_run)):
            put(os.path.join(d, "core", "lander", "run.py"), body)
            put(os.path.join(d, "core", "bin", "cc-nosignal"), "ns", 0o755)
            put(os.path.join(d, "core", "lander", "lane.py"), "LANE")
            put(os.path.join(d, "core", "lander", "README"), d)   # not a runner file: may differ
            put(os.path.join(d, "core", "tests", "t.py"), d)      # nor is a module below core/'s own *.py
            put(os.path.join(d, "tests", "landing-repos", "r.toml"), "x")
        if extra:
            put(os.path.join(cand, extra), "new")
        return cand, cur

    tree, other = "1" * 40, "2" * 40

    def rec(state, sub, check, tr=tree, status="passed", release="c" * 40, name=None):
        put(os.path.join(state, sub, check, f"{tr}.json"),
            json.dumps({"check": name or check, "tree": tr, "status": status, "release": release}))

    state = os.path.join(t, "reuse-state")
    rec(state, "results", "a")
    rec(state, os.path.join("jobs", "r-1", "results"), "b")
    rec(state, "results", "z")
    rec(state, "results", "c", tr=other)              # a record at another tree than main's is ignored
    rec(state, "results", "d", status="failed")
    rec(state, "results", "e", release="f" * 40)      # another release's green is not this one's
    rec(state, "results", "g", name="a")              # a record whose check is not its path's
    cand, cur = rels("same")
    case("same_runner: identical runner files match although other lander files differ", same_runner(cand, cur))
    case("main_greens takes only passed shared records of the current release at main's tree, never a job's (b)",
         reusable(cand, cur, tree, state) == {"a", "z"})
    run, calls = fake({cand: [{"b": "passed", "c": "passed"}]})
    bad, lines, why = prove(cand, cur, run, names=lambda r: (["a", "b", "c"], "") if r == cur else ([], "x"),
                            reuse=reusable(cand, cur, tree, state))
    case("prove sweeps only what was not reused, and z (not on main's list) is not counted",
         bad == [] and why == "" and calls == [(cand, ("b", "c"))] and lines[0].startswith("reused 1 check(s)")
         and lines[0].endswith("ran 2"))
    # every core/lander/*.py and core/*.py is a runner file, whether or not today's cli.py imports it
    for tag, path in (("lane", "core/lander/lane.py"), ("top", "core/x.py")):
        cand, cur = rels(tag)
        put(os.path.join(cur, path), "one")
        put(os.path.join(cand, path), "two")
        case(f"a {path} that differs is a different runner", not same_runner(cand, cur))
        put(os.path.join(cand, path), "one")
        case(f"…and the same {path} on both sides is not", same_runner(cand, cur))
    cand, cur = rels("only", extra="core/lander/new.py")
    case("a core/lander module only the candidate has is a different runner",
         not same_runner(cand, cur) and not same_runner(cur, cand))
    run, calls = fake({cand: [{"c": "passed"}]})
    bad, lines, why = prove(cand, cur, run, names=lambda r: (["a", "b", "c", "q"], ""), reuse={"a", "b", "z"})
    case("…a listed name neither reused nor run by the candidate still blocks", bad == ["q"] and why == "")
    run, calls = fake({cand: [{"c": "passed"}]})
    bad, _, why = prove(cand, cur, run, names=lambda r: (["a", "b"], ""), reuse={"a", "b"})
    case("…and with every listed check reused nothing is swept", bad == [] and why == "" and calls == [])
    for tag, kw in (("diff", {"cand_run": "RUN2"}), ("more", {"extra": "core/bin/cc-config"})):
        cand, cur = rels(tag, **kw)
        run, calls = fake({cand: [{"a": "passed", "b": "passed", "c": "passed"}]})
        reuse = reusable(cand, cur, tree, state)
        bad, lines, _ = prove(cand, cur, run, names=lambda r: (["a", "b", "c"], ""), reuse=reuse)
        case(f"a runner that differs ({tag}) reuses nothing and sweeps everything",
             not same_runner(cand, cur) and reuse == set() and calls == [(cand, ())] and bad == []
             and lines[0].startswith("reused 0"))
    cand, cur = rels("fb")
    put(os.path.join(cand, "tests", "landing-repos", "r.toml"), "y")
    case("a fallback manifest that differs is a different runner", not same_runner(cand, cur))
    cand, cur = rels("exec")
    os.chmod(os.path.join(cand, "core", "bin", "cc-nosignal"), 0o644)
    case("an exec bit that differs is a different runner", not same_runner(cand, cur))
    # anything importable shadows a module: a package dir, a .pyc or a .so (core/ is first on sys.path)
    for tag, path in (("pkg", "core/lander/run/__init__.py"), ("stdpkg", "core/json/__init__.py"),
                      ("pyc", "core/json.pyc"), ("so", "core/json.cpython-314-x86_64-linux-gnu.so")):
        cand, cur = rels(tag, extra=path)
        case(f"a {path} only the candidate has is a different runner",
             not same_runner(cand, cur) and not same_runner(cur, cand))
    cand, cur = rels("nopkg", extra="core/lander/run/x.txt")
    put(os.path.join(cand, "core", "json", "x.txt"), "no __init__")
    case("…but a dir with no __init__ is not importable over a module, so it is not a runner file",
         same_runner(cand, cur))
    for tag, part in (("pkgsame", "core/json/__init__.py"), ("pkgdiff", "core/json/__init__.py")):
        cand, cur = rels(tag)
        put(os.path.join(cur, part), "one")
        put(os.path.join(cand, part), "one" if tag == "pkgsame" else "two")
        case(f"a package dir on both sides compares by its tree ({tag})",
             same_runner(cand, cur) == (tag == "pkgsame"))

    def patched(mod, attr, path, fn):
        """fn() with mod.attr raising PermissionError for `path`; 'raised' when fn raised."""
        real = getattr(mod, attr)

        def deny(p, *a, **k):
            if os.fspath(p) == path:
                raise PermissionError(13, "denied", p)
            return real(p, *a, **k)
        setattr(mod, attr, deny)
        try:
            return fn()
        except OSError:
            return "raised"
        finally:
            setattr(mod, attr, real)

    import builtins
    cand, cur = rels("ls")
    case("a runner dir that exists but cannot be listed reuses nothing",
         same_runner(cand, cur) and
         patched(os, "listdir", os.path.join(cand, "core", "lander"), lambda: same_runner(cand, cur)) is False)
    cand, cur = rels("rd")
    case("a runner file that cannot be read reuses nothing, without raising",
         patched(builtins, "open", os.path.join(cand, "core", "lander", "run.py"),
                 lambda: same_runner(cand, cur)) is False)
    case("no current release reuses nothing", reusable(cand, "", tree, state) == set())
    # the commits perms reads: only those touching main's lander list
    g = os.path.join(t, "gc")
    os.makedirs(g)
    env = {**os.environ, "GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t",
           "GIT_COMMITTER_EMAIL": "t@t"}

    def commit(path, msg):
        put(os.path.join(g, path), msg)
        subprocess.run(["git", "-C", g, "add", "-A"], check=True, env=env)
        subprocess.run(["git", "-C", g, "commit", "-qm", msg], check=True, env=env)
        return git(g, "rev-parse", "HEAD")[1].strip()

    subprocess.run(["git", "-C", g, "init", "-q"], check=True, env=env)
    base = commit("README", "base")
    on = commit("core/lander/run.py", "runner change")
    commit("core/lander/repair.py", "repair only")
    commit("core/tests/lander/test_x.py", "a test only")
    on2 = commit("core/config/lander/x/y.toml", "config deep")
    head = commit("docs/a.md", "docs")
    hit, other = gate_commits(g, base, head, ["core/lander/run.py", "core/config/lander/**"])
    case("gate_commits picks only commits touching the lander list, oldest first",
         hit == [(on, "runner change"), (on2, "config deep")] and other == 3)
    case("gate_commits is None when git cannot list", gate_commits(g, "0" * 40, head, ["x"]) is None)
    sp = commit("core/lander/a b.py", "a space")
    na = commit("core/lander/é.py", "non-ascii")
    commit("core/lander/c d/e.py", "outside, a space")
    hit, other = gate_commits(g, head, "HEAD", ["core/lander/a b.py", "core/lander/é.py"])
    case("gate_commits reads a path with a space or a quoted byte whole (-z), and not a near miss",
         hit == [(sp, "a space"), (na, "non-ascii")] and other == 1)
    ls = commit("core/lander/run.py", "line separator")
    case("gate_commits keeps a subject holding U+2028 whole",
         gate_commits(g, na, ls, ["core/lander/run.py"]) == ([(ls, "line separator")], 1))
    # main's tree is read with replace refs ignored
    subprocess.run(["git", "-C", g, "replace", head, base], check=True, env=env)
    case("main_tree ignores a refs/replace entry for main",
         main_tree(g, head) == git(g, "--no-replace-objects", "rev-parse", f"{head}^{{tree}}")[1].strip()
         != git(g, "rev-parse", f"{head}^{{tree}}")[1].strip())
    case("main_tree is '' when git cannot resolve", main_tree(g, "0" * 40) == "")


def prove_cases(case, t, real_names=names_under):
    """The proof on main: what blocks, what does not, and what gives no verdict. Each case its own fake sweep."""
    def fake(table, why=None):
        calls = []

        def run(rel, only, cap):
            calls.append((rel, tuple(only)))
            if why and rel in why:
                return {}, why[rel]
            res = table[rel][min(sum(1 for c in calls if c[0] == rel), len(table[rel])) - 1]
            return {n: s for n, s in res.items() if not only or n in only}, ""
        return run, calls

    green = {"a": "passed", "b": "passed"}
    run, calls = fake({"cand": [{"a": "passed", "b": "failed"}] * 2, "cur": [green]})
    bad, lines, why = prove("cand", "cur", run)
    case("prove names a check green under current and red under the candidate", bad == ["b"] and why == "" and
         any("b: current passed → candidate failed  ← REGRESSION" in ln for ln in lines))
    case("…and runs only the candidate's reds again, under both",
         calls == [("cand", ()), ("cand", ("b",)), ("cur", ("b",))])
    run, _ = fake({"cand": [{"a": "passed", "b": "failed"}] * 2, "cur": [{"a": "passed", "b": "failed"}]})
    bad, lines, why = prove("cand", "cur", run)
    case("a check red under the current release too is main's and does not block",
         bad == [] and why == "" and any("main's own" in ln for ln in lines))
    run, calls = fake({"cand": [{"a": "passed", "b": "failed"}, green], "cur": [green]})
    bad, _, why = prove("cand", "cur", run)
    case("a red the candidate's rerun does not repeat does not block, and current is not asked",
         bad == [] and why == "" and all(c[0] == "cand" for c in calls))
    run, _ = fake({"cand": [{"a": "unrunnable", "b": "passed"}] * 2, "cur": [green]})
    case("unrunnable under the candidate where current passes blocks too", prove("cand", "cur", run)[0] == ["a"])
    run, calls = fake({"cand": [green]})
    case("an all-green candidate is proven with one sweep", prove("cand", "cur", run)[0] == [] and len(calls) == 1)
    run, _ = fake({"cand": [{"a": "failed"}] * 2})
    bad, _, why = prove("cand", "", run)
    case("with nothing current, nothing blocks", bad == [] and why == "")
    run, _ = fake({}, why={"cand": "stopped at the cap (3600s)"})
    case("a candidate sweep with no verdict refuses", "no verdict" in prove("cand", "cur", run)[2])
    run, _ = fake({"cand": [{"a": "failed"}] * 2}, why={"cur": "exit 3: x"})
    case("a current run with no verdict refuses", "current release" in prove("cand", "cur", run)[2])
    run, _ = fake({"cand": [{}]})
    case("a sweep that names no check refuses", "named no check" in prove("cand", "cur", run)[2])
    # the replay of 10-12: #1024 put every host check under cc-nosignal; these read what its Landlock domain hides
    # and went red on main under it while the release before passed them (#1157, #1158, #1161 then marked them bare;
    # #1286 since dropped the cc-member-* checks, so the replay keeps the three that still exist)
    hidden = ["e2e-cc-context", "selfcheck-cc-fence", "selfcheck-cc-sandbox"]
    under = {n: "failed" for n in hidden}
    run, _ = fake({"cand": [{**under, "selfcheck-cc-guard": "passed"}] * 2,
                   "cur": [{n: "passed" for n in [*hidden, "selfcheck-cc-guard"]}]})
    case("the replay of #1024's promote is refused, naming every hidden check", prove("cand", "cur", run)[0] == hidden)
    # a candidate whose loader drops a check reports it nowhere; main's list is the current release's, so it blocks
    run, _ = fake({"cand": [green], "cur": [green]})
    bad, lines, why = prove("cand", "cur", run, names=lambda r: (["a", "b", "c"], "") if r == "cur" else ([], "x"))
    case("a check in main's manifest the candidate did not run blocks, by name",
         bad == ["c"] and why == "" and any("c: in main's manifest, not run" in ln for ln in lines))
    case("…and a candidate that runs every listed check passes",
         prove("cand", "cur", run, names=lambda r: (["a", "b"], ""))[0] == [])
    run, _ = fake({"cand": [green]})
    case("no list of main's checks from the current release is no verdict",
         "could not list" in prove("cand", "cur", run, names=lambda r: ([], "exit 1: x"))[2])
    reuse_cases(case, t, fake)
    # sweep_under reads a real release's stderr lines, and a cap it hits is no verdict
    rel = os.path.join(t, "fakerel")
    os.makedirs(os.path.join(rel, "core", "lander"))
    with open(os.path.join(rel, "core", "lander", "cli.py"), "w") as f:
        f.write("import sys, time\nif '--only' in sys.argv: time.sleep(5)\n"
                "sys.stderr.write('lander sweep: x passed 3s\\nlander sweep: y failed 1s\\nnoise\\n')\n"
                "print('| table |'); print('lander sweep: 1 failed, 1 passed'); sys.exit(1)\n")
    seat = {"TMUX": "/tmp/tmux-1/default,1,0", "TMUX_PANE": "%3", "CC_ROLE": "planning", "CC_SLACK_ALIAS": "x"}
    kept = {k: os.environ.get(k) for k in seat}
    os.environ.update(seat)
    try:
        got = sweep_under(rel, t, "s")
        with open(os.path.join(t, "sysrun.json")) as f:
            rec = json.load(f)
        capped = sweep_under(rel, t, "s", ("y",), cap=1, grace=0)
    finally:
        for k, v in kept.items():
            os.environ.pop(k, None) if v is None else os.environ.__setitem__(k, v)
    case("sweep_under parses each check's verdict", got == ({"x": "passed", "y": "failed"}, ""))
    tmux = next((a.split("=", 2)[2] for a in rec["argv"] if a.startswith("--setenv=TMUX_TMPDIR=")), "")
    case("the sweep runs as a capped user unit with a private TMUX_TMPDIR, gone afterwards",
         rec["argv"][:2] == ["--user", "--wait"] and "--property=RuntimeMaxSec=3600" in rec["argv"]
         and tmux.startswith(f"/run/user/{os.getuid()}/" if os.access(f"/run/user/{os.getuid()}", os.W_OK | os.X_OK)
                             else tempfile.gettempdir()) and "lander-prove-tmux-" in tmux and not os.path.exists(tmux))
    case("…and the unit gets the passwd home as HOME and the user manager's PATH, as the lane's own unit does",
         f"--setenv=HOME={pwd.getpwuid(os.getuid()).pw_dir}" in rec["argv"]
         and not any(a.startswith("--setenv=PATH=") for a in rec["argv"]))
    # a /run/user/<uid> it cannot write to gives a TMUX_TMPDIR in the temp dir, not a failed proof
    kept_access = os.access
    os.access = lambda p, m: False if p.startswith("/run/user/") else kept_access(p, m)  # noqa: E731
    try:
        d = private_tmux()
    finally:
        os.access = kept_access
    case("private_tmux falls back to the temp dir when /run/user is not writable",
         d.startswith(tempfile.gettempdir() + "/lander-prove-tmux-"))
    shutil.rmtree(d, ignore_errors=True)
    # a /run/user/<uid> that passes the access check but refuses the mkdtemp (full, or a race) falls back the same way
    kept_mk = tempfile.mkdtemp

    def run_user_refuses(**kw):
        if (kw.get("dir") or "").startswith("/run/user/"):
            raise OSError("no space left")
        return kept_mk(**kw)
    os.access = lambda p, m: True if p.startswith("/run/user/") else kept_access(p, m)  # noqa: E731
    tempfile.mkdtemp = run_user_refuses
    try:
        d = private_tmux()
    finally:
        os.access, tempfile.mkdtemp = kept_access, kept_mk
    case("private_tmux falls back to the temp dir when /run/user's mkdtemp raises OSError",
         d.startswith(tempfile.gettempdir() + "/lander-prove-tmux-"))
    shutil.rmtree(d, ignore_errors=True)
    # a uid passwd has no entry for gives the cards.PASSWD_HOME fallback, not a KeyError
    kept_pw = pwd.getpwuid
    pwd.getpwuid = lambda uid: (_ for _ in ()).throw(KeyError(uid))
    try:
        h = passwd_home()
    finally:
        pwd.getpwuid = kept_pw
    case("passwd_home gives /nonexistent when passwd has no entry for the uid", h == "/nonexistent")
    tempfile.mkdtemp = lambda **kw: (_ for _ in ()).throw(OSError("read-only"))
    try:
        nov = sweep_under(rel, t, "s")
    finally:
        tempfile.mkdtemp = kept_mk
    case("…and a TMUX_TMPDIR it cannot make is no verdict, not a crash", nov == ({}, "no private TMUX_TMPDIR: read-only"))
    case("…and its client is handed no seat: no TMUX, TMUX_PANE or CC_*",
         not any(k in rec["env"] for k in seat) and not any(k.startswith("CC_") for k in rec["env"]))
    case("sweep_under at its cap gives no verdict", "cap" in capped[1])
    # main's list of checks comes from a release's own manifest loader, read in a process of its own
    lr = os.path.join(t, "listrel")
    os.makedirs(os.path.join(lr, "core", "lander"))
    for mod, body in (("__init__", ""),
                      ("check", "import types\nhost_top = lambda p: types.SimpleNamespace(work_tree=p)\n"
                                "repo_name = lambda r: 'r'\n"),
                      ("manifest", "import types\nhost_fallback = lambda n: ''\n"
                                   "load = lambda r, rev, fallback='': types.SimpleNamespace(checks="
                                   "{'a': 1, 'b': 2} if rev == 'good' else {})\n")):
        with open(os.path.join(lr, "core", "lander", mod + ".py"), "w") as f:
            f.write(body)
    case("names_under lists main's checks as the release's loader reads them",
         real_names(lr, t, "good") == (["a", "b"], ""))
    case("names_under naming no check gives no list", real_names(lr, t, "bad")[1] != "")
    # pin copies lander-self alone to self/<sha>/: the proof runs from there with no lander/ beside it
    with open(os.path.join(lr, "core", "lander", "cli.py"), "w") as f:
        f.write("import sys\nsys.stderr.write('lander sweep: a passed 1s\\nlander sweep: b failed 1s\\n')\n"
                "print('lander sweep: 1 failed, 1 passed'); sys.exit(1)\n")
    alone = os.path.join(t, "self", "abc123", "lander-self")
    os.makedirs(os.path.dirname(alone))
    shutil.copy(os.path.realpath(__file__), alone)
    rc, out, err = sh([sys.executable, "-I", "-c",
                       "import json, runpy, sys\ng = runpy.run_path(sys.argv[1], run_name='alone')\n"
                       "print(json.dumps(g['proven'](sys.argv[2], sys.argv[2], sys.argv[3], 'good')))",
                       alone, lr, t], cwd=t, timeout=120, stdin=subprocess.DEVNULL)
    case("a lander-self copied alone proves from there: b red under both releases, a green, nothing blocks",
         rc == 0 and out.strip().splitlines()[-1:] == ['["", false]'] and "b: current failed" in out)


def rollback_legacy_cases(case, t):
    """rollback --legacy hands the queue back: the new lander's jobs, inbox and watches move aside, the exported old
    jobs it never took up come back, and every PR still in flight is named for a re-queue; a running lane refuses."""
    q = os.path.join(t, "q")
    old = os.environ.get("CC_LANDER_STATE")
    os.environ["CC_LANDER_STATE"] = q

    def w(p, j):
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p, "w") as f:
            json.dump(j, f)
    new = lambda st: {"repo": "r", "pr": 1, "state": st, "stage": st, "history": []}  # noqa: E731
    w(os.path.join(q, "r-1.json"), new("checking"))
    w(os.path.join(q, "r-2.json"), dict(new("done"), pr=2))
    w(os.path.join(q, "jobs", "new", "s-3.1.ab.json"), {"repo": "s", "pr": 3})
    w(os.path.join(q, "handed", "r-4.json"), {"repo": "r", "pr": 4, "since": "x"})
    w(os.path.join(q, "pre-cutover", "r-1.json"), {"repo": "r", "pr": 1, "stage": "gates"})
    w(os.path.join(q, "pre-cutover", "u-5.json"), {"repo": "u", "pr": 5, "stage": "queued"})
    w(os.path.join(q, "pre-cutover", "handed", "v-6.json"), {"repo": "v", "pr": 6})
    w(os.path.join(q, "lanes", "r.running"), {"pid": os.getpid()})
    quiet, keep = open(os.devnull, "w"), (sys.stdout, sys.stderr)
    sys.stdout = sys.stderr = quiet
    try:
        r_busy = cmd_rollback([], {"legacy": True})
        on_busy = link_target("legacy-on")
        os.unlink(os.path.join(q, "lanes", "r.running"))
        r_ok = cmd_rollback([], {"legacy": True})
    finally:
        sys.stdout, sys.stderr = keep
        quiet.close()
        if old is None:
            os.environ.pop("CC_LANDER_STATE", None)
        else:
            os.environ["CC_LANDER_STATE"] = old
    posts = [os.path.join(q, "post-cutover", d) for d in os.listdir(os.path.join(q, "post-cutover"))] \
        if os.path.isdir(os.path.join(q, "post-cutover")) else []
    req = open(os.path.join(posts[0], "requeue.txt")).read() if posts else ""
    case("rollback --legacy refuses while a new lane runs", r_busy != 0 and on_busy == "")
    case("rollback --legacy names every PR in flight for the old lander",
         r_ok == 0 and req == "cc-land queue r 1\ncc-land queue s 3\n")
    case("…moves the new lander's jobs, inbox and watches aside",
         not os.path.exists(os.path.join(q, "r-2.json")) and not os.listdir(os.path.join(q, "jobs", "new"))
         and os.path.isfile(os.path.join(posts[0] if posts else q, "handed", "r-4.json")))
    case("…and puts back the old jobs and watches the new lander never took up",
         os.path.isfile(os.path.join(q, "u-5.json")) and not os.path.exists(os.path.join(q, "r-1.json"))
         and os.path.isfile(os.path.join(q, "handed", "v-6.json")))


def status_lane_cases(case, t):
    """status names each running lane's release and whether it is current."""
    q, old = os.path.join(t, "sq"), os.environ.get("CC_LANDER_STATE")
    os.environ["CC_LANDER_STATE"] = q
    os.makedirs(os.path.join(q, "lanes"))
    cur = link_target("current")
    for repo, rel in (("fresh", cur), ("old", os.path.join(ROOT, "releases", "0ld"))):
        with open(os.path.join(q, "lanes", f"{repo}.running"), "w") as f:
            json.dump({"pid": os.getpid(), "release": rel}, f)
    keep, buf = sys.stdout, tempfile.TemporaryFile("w+")
    sys.stdout = buf
    try:
        cmd_status([], {})
    finally:
        sys.stdout = keep
        if old is None:
            os.environ.pop("CC_LANDER_STATE", None)
        else:
            os.environ["CC_LANDER_STATE"] = old
    buf.seek(0)
    out = buf.read()
    case("status marks a lane on current", re.search(r"^lane fresh .* current$", out, re.M) and cur)
    case("status marks a lane on an old release STALE", re.search(r"^lane old .* on 0ld STALE$", out, re.M))


def settle_merged_cases(case):
    """land tells the current release's lander of the merge, in a process of its own; no release is no failure."""
    global ROOT
    keep = ROOT
    calls = []

    def run(rc, out):
        def f(argv, timeout=600):
            calls.append(argv)
            return rc, out, ""
        return f
    with tempfile.TemporaryDirectory() as t:
        ROOT = os.path.join(t, "lander")
        try:
            os.makedirs(ROOT)
            said = settle_merged("r", "7", run(0, "x"))
            case("settle-merged: no current release is left to the tick, nothing run", "tick" in said and not calls)
            rel = os.path.join(ROOT, "releases", "abc")
            os.makedirs(os.path.join(rel, "core", "lander"))
            open(os.path.join(rel, "core", "lander", "cli.py"), "w").close()
            os.symlink(rel, os.path.join(ROOT, "current"))
            said = settle_merged("r", "7", run(0, "[r] PR #7: merged on GitHub (lander-self) — query -> merged -> done\n"))
            case("settle-merged: the current release's cli runs it for the PR, by lander-self",
                 calls and calls[-1][1:] == ["-P", os.path.join(rel, "core", "lander", "cli.py"), "settle-merged",
                                            "r", "7", "--by", "lander-self"] and "query -> merged" in said)
            said = settle_merged("r", "7", run(2, "lander: unknown command settle-merged\n"))
            case("settle-merged: a release without the command leaves it to the tick",
                 "did not take" in said and "unknown command" in said and "tick" in said)
        finally:
            ROOT = keep


def _raises(f):
    try:
        f()
    except ValueError:
        return True
    return False


# --- main ----------------------------------------------------------------------------------------------------------

def parse(argv):
    args, opts, it = [], {}, iter(argv)
    for a in it:
        if a in ("--repo", "--rev", "--repo-dir", "--pr", "--cap"):
            opts[a[2:]] = next(it, "")
        elif a == "--legacy":
            opts["legacy"] = True
        elif a == "--no-prove":
            opts["no-prove"] = True
        else:
            args.append(a)
    return args, opts


def cap_of(opts):
    """The proof's cap in seconds: --cap when given (a whole number above 0 and at most PROVE_CAP_MAX, ASCII
    digits), else PROVE_CAP; 0 when --cap is not such a number."""
    v = opts.get("cap")
    if v is None:
        return PROVE_CAP
    return int(v) if v.isascii() and v.isdigit() and len(v) < 9 and 0 < int(v) <= PROVE_CAP_MAX else 0


def perms_caller_cases(case):
    """perms_caller on a fake /proc: the claude above the caller must work in <state>/<repo>/perms."""
    with tempfile.TemporaryDirectory(prefix="lander-self-perms.") as t:
        proc, state = os.path.join(t, "proc"), os.path.join(t, "state")
        seat = lambda name: os.path.join(state, "box", name)  # noqa: E731
        for d in ("perms", "planning"):
            os.makedirs(seat(d))

        versions = os.path.join(t, "versions")

        def ps(pid, comm, ppid, cwd="", exe=os.path.join(versions, "1.0.0")):
            os.makedirs(os.path.join(proc, str(pid)))
            with open(os.path.join(proc, str(pid), "comm"), "w") as f:
                f.write(comm + "\n")
            with open(os.path.join(proc, str(pid), "status"), "w") as f:
                f.write(f"Name:\t{comm}\nPPid:\t{ppid}\n")
            os.symlink(exe, os.path.join(proc, str(pid), "exe"))
            if cwd:
                os.symlink(cwd, os.path.join(proc, str(pid), "cwd"))
        ps(10, "bash", 20)
        ps(20, "claude", 1, seat("perms"))
        ps(11, "bash", 21)
        ps(21, "claude", 1, seat("planning"))
        ps(12, "bash", 1)
        ps(13, "bash", 23)
        ps(23, "claude", 1, seat("perms"), exe=os.path.join(t, "bin", "claude"))   # a renamed shell, say
        args = (proc, state, versions)
        case("promote: a claude in the perms seat may", perms_caller("/dev/box", 10, *args))
        case("promote: a claude in another seat may not", not perms_caller("/dev/box", 11, *args))
        case("promote: another repo's perms seat may not", not perms_caller("/dev/other", 10, *args))
        case("promote: no claude above the caller may not", not perms_caller("/dev/box", 12, *args))
        # perms, 10-13: accept the seat "only when /proc/<pid>/exe resolves under ~/.local/share/claude/versions/
        # AND its comm is claude"
        case("promote: a process only named claude in the perms seat may not", not perms_caller("/dev/box", 13, *args))
        # perms, 10-13: realpath "resolves the path a second time through a filesystem the caller controls (a
        # deleted folder replaced by a symlink to versions/ passes)"
        os.symlink(versions, os.path.join(t, "gone"))
        ps(14, "bash", 24)
        ps(24, "claude", 1, seat("perms"), exe=os.path.join(t, "gone", "evil (deleted)"))
        case("promote: a deleted folder now a symlink into versions may not", not perms_caller("/dev/box", 14, *args))
        ps(15, "bash", 25)
        ps(25, "claude", 1, seat("perms"), exe=os.path.join(versions, "1.0.0 (deleted)"))
        case("promote: a claude whose binary an update deleted may", perms_caller("/dev/box", 15, *args))
        # perms, 10-13: the extra root counts "only if that file is owned by root and not group- or world-writable"
        vf = os.path.join(t, "claude-versions")
        with open(vf, "w") as f:
            f.write("/opt/claude\n")
        os.chmod(vf, 0o644)
        case("extra root: a file owned as asked names its root", extra_versions_root(vf, os.getuid()) == "/opt/claude")
        case("extra root: a file not owned by root names none",
             extra_versions_root(vf, 0 if os.getuid() else 1) is None)
        os.chmod(vf, 0o664)
        case("extra root: a group-writable file names none", extra_versions_root(vf, os.getuid()) is None)
        os.chmod(vf, 0o646)
        case("extra root: a world-writable file names none", extra_versions_root(vf, os.getuid()) is None)
        os.chmod(vf, 0o644)
        os.symlink(vf, os.path.join(t, "vf-link"))
        case("extra root: a symlink to a good file names none",
             extra_versions_root(os.path.join(t, "vf-link"), os.getuid()) is None)


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd in ("", "-h", "--help", "help"):
        print(__doc__.strip())
        return 0 if cmd else 2
    if cmd == "selfcheck":
        return selfcheck()
    pinned = os.path.realpath(os.path.join(ROOT, "self"))
    if cmd != "pin" and not ME.startswith(pinned + "/"):
        p = os.path.join(ROOT, "self", "current", "lander-self")
        if not os.path.isfile(p):
            return die("not pinned: run `lander-self pin` once (it copies the committed tool out of the checkout)", 3)
        os.execv(sys.executable, [sys.executable, "-P", p, *argv])
    args, opts = parse(argv[1:])
    table = {"pin": cmd_pin, "promote": cmd_promote, "prove": cmd_prove, "rollback": cmd_rollback, "legacy": cmd_legacy,
             "status": cmd_status, "reads": cmd_reads, "sweep": cmd_sweep, "land": cmd_land, "shadow": cmd_shadow,
             "check": lambda a, o: cmd_check(a, o)[0]}
    if cmd not in table:
        return die(f"no command {cmd!r} (lander-self --help)", 2)
    return table[cmd](args, opts)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
