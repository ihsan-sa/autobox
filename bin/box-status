#!/usr/bin/env bash
# box-status — one-screen health summary of this box. Read-only; safe anytime.
h(){ printf '\n\033[1m%s\033[0m\n' "$1"; }
h "host"; echo "$(hostname)  up $(uptime -p | sed 's/^up //')  load $(cut -d' ' -f1-3 /proc/loadavg)  kernel $(uname -r)$([ -f /run/reboot-required ] && echo '  ** REBOOT REQUIRED **')"
h "network"; ip -br addr | grep -v '^lo'; ip route | grep '^default' || echo "no default route"
h "wifi"; for w in $(iw dev 2>/dev/null | awk '$1=="Interface"{print $2}'); do   # whichever wireless interface this box has, if any
  iw dev "$w" link 2>/dev/null | grep -E 'SSID|freq|signal' | tr -s '\t ' ' ' | paste -sd' ' | sed "s|^|  $w: |"; done | grep . || echo "not connected"
h "services"; for u in ssh.socket tailscaled cloudflared chrony unattended-upgrades docker; do printf '  %-20s %s\n' "$u" "$(systemctl is-active "$u" 2>/dev/null)"; done
if command -v tailscale >/dev/null; then h "tailscale"; tailscale ip -4 2>/dev/null; tailscale status --self=true --peers=false 2>/dev/null | head -2; fi
h "tmux"; tmux list-windows -t main -F '  main:#I #W  #{pane_current_path}  [#{pane_current_command}]' 2>/dev/null || echo "  no tmux session 'main'"
h "claude processes"; pgrep -a -f '(^|/)claude( |$)' | grep -v pgrep | cut -c1-110 || echo "  none"
h "slack"; printf '  cc-slackd: %s\n' "$(systemctl --user is-active cc-slackd.service 2>/dev/null)"; "$HOME/bin/cc-slack" status 2>/dev/null | tail -n 2 | sed 's/^/  /'
h "disk / memory"; df -h / | awk 'NR==2{print "  / : "$3" used of "$2" ("$5")"}'; free -h | awk '/Mem:/{print "  mem: "$3" used of "$2", "$7" available"}'
h "time"; echo "  ntp synced: $(timedatectl show -p NTPSynchronized --value)   $(date -u)"
# the disk / lives on — the whole device behind the root partition (also through LUKS/LVM), never a name: this tree is
# published generic. CC_DISK in ~/.cc/config overrides it for a box whose root is not on the drive it wants watched.
disk=$("$HOME/bin/cc-config" get CC_DISK 2>/dev/null); [ -n "$disk" ] || disk=$(s=$(findmnt -no SOURCE / 2>/dev/null); lsblk -nlso NAME,TYPE "${s%%\[*}" 2>/dev/null | awk '$2=="disk"{print "/dev/"$1; exit}')
h "ssd"; sudo -n smartctl -H "$disk" 2>/dev/null | grep -E 'result' | sed 's/^/  /'; sudo -n smartctl -A "$disk" 2>/dev/null | awk '$1==9{h=$NF} $1==177{w=$4} $1==5{r=$NF} END{printf "  power-on hours %s | wear-leveling %s | reallocated %s\n", h, w, r}'
if command -v docker >/dev/null; then h "docker"; docker ps --format '  {{.Names}}  {{.Status}}' 2>/dev/null || echo "  (no access)"; fi
