#!/usr/bin/env python3
"""cc-peer — run a worker on the peer host when this one is full, and bring the peer's calls home.

The hub runs the box (its Slack, its boards, its lander). The peer is a second host with its own tmux, its own
clones under ~/dev and its own Claude sign-in. cc-room places a queued worker there when the hub has no room and
the peer has; nothing else starts work on it. Which host is the peer is configuration, never code:

  ~/.cc/peer (CC_PEER_DIR)  on the hub: id_ed25519 (the launch key), known_hosts (the peer's pinned host key),
                            dest (user@host, one line) and, optionally, name (the label the hub's board and
                            notices give the peer; the host part of dest without it). With any of the first three
                            missing there is no peer, and cc-room places on the hub alone.

HUB SIDE
  cc-peer room                   exit 0 the peer has room · 1 it has not (or did not answer), the one line says why
  cc-peer launch REPO/TRACK [--log FILE] -- CC-LOOP-ARGV…
                                 start the worker on the peer: task.md goes on stdin, the loop's --max-iter, --model,
                                 --budget and --effort go along, nothing else does. One launch id per call, kept
                                 across its own retries, so an answer lost on the way is never a second worker.
                                 Records placed/REPO/TRACK, which is what lets drain accept that track's calls.
  cc-peer drain                  take the peer's spooled calls, run each here, then tell the peer to drop them.
  cc-peer selfcheck

PEER SIDE
  cc-peer serve                  the launch key's forced command (a root-owned copy, /usr/local/bin/cc-peer). It
                                 reads SSH_ORIGINAL_COMMAND and takes these verbs and no others:
                                   room                        this host's own `cc-room check`
                                   launch ID REPO TRACK [--base B] [--loop N] [--model M] [--budget B] [--effort E]
                                                               task.md on stdin; ID is 32 hex digits and is refused the
                                                               second time (launched/ID is made with O_EXCL); ~/dev/REPO
                                                               must already be a clone. It makes a local board row if
                                                               none, then runs `cc REPO TRACK --go` with CC_PEER_SPOOL.
#   recurring-defect-ok: pause-hold-missing — a launch reaches here only after the hub's `cc --go` checked the pause, and it runs `cc REPO TRACK --go`, which checks this host's pause again (cc:1798)
#   recurring-defect-ok: held-files-unchecked — a peer launch checks held files exactly as a local `cc --go` does (the overlap warning is cc-board add's, run on the hub before dispatch); this verb only carries that launch out
                                   spool-take                  the spooled calls as JSON lines; each moves to taken/,
                                                               and one it cannot offer to aside/, with a line in aside.log
                                   spool-ack NAME…             drop those taken entries
  cc-peer spool TOOL ARG…        write one call to $CC_PEER_SPOOL. cc-board (note, status), cc-notify and cc-loop's
                                 DONE call it when that variable is set, which only a peer launch sets.

THE HOST COMES FROM THE CONNECTION. drain runs a call as one from the peer it connected to, the name in its own
config; whatever an entry says about a host is ignored. It runs only these, each for a track it placed on that
peer and no other:
  board note|status REPO TRACK …   `cc-board note` (prefixed with the peer's name) or `cc-board status`
  notify                           `cc-notify` as a worker (CC_ROLE=worker): -t, --heading, --id and the message,
                                   and --ask for any of --ask, --decision, --approval or --owner. No other flag
                                   goes through, so a peer can never reach the owner's door or carry a --run.
  land REPO TRACK                  fetch track/TRACK, require its tip to be the sha the peer sent, write the peer's
                                   pr-body.md beside task.md and run `cc-land queue --task REPO TRACK`. A tip that
                                   is not there yet leaves the entry with the peer for the next drain; a day on it
                                   posts one line and is asked once an hour from then on, never dropped.
Anything else is dropped with one line in ~/.cc/peer/drain.log. An entry already drained (drained/NAME) is never
run twice, so a lost spool-ack costs nothing.

The key on the peer is the owner's account's, so its authorized_keys line is
  restrict,from="<the hub's tailnet addresses>",command="/usr/local/bin/cc-peer serve" ssh-ed25519 …
and the hub pins the peer's host key in known_hosts (StrictHostKeyChecking=yes). docs/architecture/two-hosts.md
has the install.
"""
import fcntl
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time
import uuid

BIN = os.path.dirname(os.path.realpath(__file__))
NAME_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,99}")      # a repo or a track: no slash, no dot-dot start
ID_RE = re.compile(r"[0-9a-f]{32}")
ENTRY_RE = re.compile(r"[0-9]{19}-[0-9]+-[0-9a-f]{8}\.json")
FLAGS = {"--base": re.compile(r"[A-Za-z0-9][A-Za-z0-9._/-]{0,99}"), "--loop": re.compile(r"[0-9]{1,3}"),
         "--model": re.compile(r"[A-Za-z0-9.\[\]_-]{1,60}"), "--budget": re.compile(r"[0-9]{1,4}(\.[0-9]{1,2})?"),
         "--effort": re.compile(r"[a-z]{1,10}")}
BRIEF_CAP = 256 * 1024
ENTRY_CAP = 128 * 1024
TAKE_MAX = 200
RETRY_FOR = 24 * 3600   # a DONE whose commit has not reached origin in a day posts one line (late_once), and is kept
RETRY_EVERY = 3600      # …and from then on is asked again once an hour, not every drain (owner 2026-10-20: back off, never drop)
T_MAX = 2 ** 40         # an entry's t past this (year ~36800) is not a time: dropped, never compared


def home():
    return os.path.expanduser("~")   # read per call: the selfcheck gives each fake host its own


def peer_dir():
    return os.environ.get("CC_PEER_DIR") or f"{home()}/.cc/peer"


def ok_name(s):
    return bool(NAME_RE.fullmatch(s or "")) and ".." not in s


def read1(path):
    try:
        with open(path) as f:
            return f.readline().strip()
    except OSError:
        return ""


def read_regular(path, cap):
    """The bytes of the regular file at path, at most cap of them. A link, a FIFO or anything else that is not a plain
    file with one name raises OSError: these paths sit in dirs a worker writes, so it could plant any of them."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1:
            raise OSError(f"{path} is not a regular file with one name")
        return f.read(cap)


def logline(path, msg):
    line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {msg}\n"
    sys.stderr.write(line)
    if path:
        try:
            # O_NOFOLLOW: a link planted at a log path is refused, not written through
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "a") as f:
                f.write(line)
        except OSError:
            pass


# ---- the hub's end ------------------------------------------------------------------------------------------------

def dest():
    return read1(f"{peer_dir()}/dest")


def peer_name():
    """The label the hub gives the peer: its own config, never anything the peer says."""
    n = read1(f"{peer_dir()}/name") or dest().rsplit("@", 1)[-1]
    return n if ok_name(n) else "peer"


def configured():
    d = peer_dir()
    if os.environ.get("CC_PEER_SSH"):
        return bool(dest())
    return bool(dest()) and all(os.path.getsize(f"{d}/{f}") > 0 if os.path.exists(f"{d}/{f}") else False
                                for f in ("id_ed25519", "known_hosts"))


def xport(words):
    """The argv that runs `words` on the peer. CC_PEER_SSH (the selfcheck's fake host) replaces ssh. ssh joins the
    words with spaces and the peer splits them on whitespace, so a word carrying any is refused here first."""
    if any(not w or re.search(r"\s", w) for w in words):
        raise ValueError(f"a peer argv word is empty or carries whitespace: {words!r}")
    if os.environ.get("CC_PEER_SSH"):
        return shlex.split(os.environ["CC_PEER_SSH"]) + list(words)
    d = peer_dir()
    return ["ssh", "-F", "/dev/null", "-i", f"{d}/id_ed25519", "-o", "IdentitiesOnly=yes", "-o", "BatchMode=yes",
            "-o", "ConnectTimeout=8", "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4",
            "-o", "StrictHostKeyChecking=yes", "-o", f"UserKnownHostsFile={d}/known_hosts",
            "-o", "GlobalKnownHostsFile=/dev/null", "-o", "ClearAllForwardings=yes",
            "-o", "KexAlgorithms=curve25519-sha256", "-a", "-x", "-T", dest(), "--"] + list(words)


def call(words, stdin=b"", timeout=60):
    """(rc, stdout, stderr) of one verb on the peer; rc 255 for a transport that never answered."""
    try:
        p = subprocess.run(xport(words), input=stdin, capture_output=True, timeout=timeout)
        return p.returncode, p.stdout.decode(errors="replace"), p.stderr.decode(errors="replace")
    except subprocess.TimeoutExpired:
        return 255, "", "the peer did not answer in time"
    except OSError as e:
        return 255, "", f"{type(e).__name__}: {e}"


def room():
    if not configured():
        print("no peer is configured")
        return 1
    rc, out, err = call(["room"], timeout=40)
    line = (out.strip().splitlines() or [""])[0][:300]
    if rc == 0:
        return 0
    print(f"{peer_name()}: {line}" if rc == 1 and line else
          f"{peer_name()} did not answer ({(err.strip().splitlines() or ['rc %d' % rc])[-1][:200]})")
    return 1


def loop_flags(cmd):
    """cc-loop's argv tail → the `cc --go` flags the peer takes: --max-iter is cc's --loop; nothing else passes."""
    out, i = [], 0
    while i < len(cmd):
        k, v = cmd[i], (cmd[i + 1] if i + 1 < len(cmd) else "")
        k2 = "--loop" if k == "--max-iter" else k
        if k2 in FLAGS and k2 != "--base" and FLAGS[k2].fullmatch(v):
            out += [k2, v]
            i += 2
        else:
            i += 1
    return out


def board_base(repo):
    try:
        b = subprocess.run([f"{BIN}/cc-board", "base", repo], capture_output=True, text=True, timeout=20).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        b = ""
    return b if FLAGS["--base"].fullmatch(b) and ".." not in b and not b.startswith("track/") else "main"


def launch(what, cmd, log):
    """Start `what` on the peer. 0 started (or the peer already had this id: an answer lost on the way), else 1."""
    repo, _, track = what.partition("/")
    if not (ok_name(repo) and ok_name(track)):
        logline(log, f"cc-peer: {what!r} is not a repo/track the peer takes")
        return 1
    if not configured():
        logline(log, "cc-peer: no peer is configured")
        return 1
    try:
        with open(f"{home()}/.cc/state/{repo}/{track}/task.md", "rb") as f:
            brief = f.read(BRIEF_CAP + 1)
    except OSError as e:
        logline(log, f"cc-peer: no task.md for {what} ({e})")
        return 1
    if len(brief) > BRIEF_CAP:
        logline(log, f"cc-peer: the brief for {what} is over {BRIEF_CAP} bytes; it stays here")
        return 1
    lid = uuid.uuid4().hex
    words = ["launch", lid, repo, track, "--base", board_base(repo)] + loop_flags(cmd[3:])
    name = peer_name()
    for attempt in range(3):
        rc, out, err = call(words, stdin=brief, timeout=90)
        # 3: the peer has this id already — only a retry of ours can say that, so the first attempt started it
        if rc == 0 or (rc == 3 and attempt > 0):
            d = f"{peer_dir()}/placed/{repo}"
            os.makedirs(d, exist_ok=True)
            with open(f"{d}/{track}.tmp", "w") as f:
                f.write(f"{lid} {name} {int(time.time())}\n")
            os.replace(f"{d}/{track}.tmp", f"{d}/{track}")
            logline(log, f"cc-peer: {what} started on {name} (launch {lid})")
            subprocess.run([f"{BIN}/cc-board", "note", repo, track, f"placed on {name}: this host was full"],
                           capture_output=True, timeout=30)
            return 0
        if rc != 255:
            break
        time.sleep(5)
    why = ((err or out).strip().splitlines() or [f"rc {rc}"])[-1][:300]
    logline(log, f"cc-peer: {name} did not take {what}: {why}")
    return 1


def placed(repo, track, name):
    """True when this hub launched repo/track on the peer it calls `name`."""
    if not (ok_name(repo) and ok_name(track)):
        return False
    rec = read1(f"{peer_dir()}/placed/{repo}/{track}").split()
    return len(rec) >= 2 and rec[1] == name


def clean(s, cap=2000):
    return re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", " ", str(s))[:cap]


def unmarked(s):
    """s with Slack's markup brackets swapped for look-alikes, so <!channel>, <@U…> and <url|text> in a peer's text
    read as plain words and page or link nobody. For a line the hub writes itself: the peer's own notify text is its
    worker's message and goes through as it said it."""
    return str(s).replace("<", "‹").replace(">", "›")


def notify_argv(argv, name, what):
    """A peer's cc-notify argv → the one this hub runs: title, heading, id, message, and --ask for any door."""
    out, msg, ask, i = [], "", False, 0
    while i < len(argv):
        a = argv[i]
        if a == "--":   # the message, whatever it starts with
            msg = clean(" ".join(argv[i + 1:]))
            break
        if a in ("-t", "--heading", "--id") and i + 1 < len(argv):
            v = clean(argv[i + 1], 300)
            if a == "--id":   # no '@': a peer's id is never a live ask's <subject>@<stamp>, which would retire the hub's
                v = v.replace("@", "_")
            out += [a, f"{v} ({name})" if a == "-t" else v]
            i += 2
            continue
        if a in ("--ask", "--decision", "--approval", "--owner"):
            ask = True
        elif a in ("-p", "--kind", "--from", "--live", "--run"):
            i += 1   # a flag with a value that does not go through: skip the value too
        elif not a.startswith("-"):
            msg = clean(a)
        i += 1
    if "-t" not in out:
        out = ["-t", f"{what} ({name})"] + out
    return (["--ask"] if ask else []) + out + [msg or f"{what} on {name} sent an empty notice"]


def run_here(argv, env=None):
    """One call on this host. The selfcheck rebinds it."""
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=300, env=env)
        return p.returncode, (p.stdout + p.stderr).strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, f"{type(e).__name__}: {e}"


def write_pr_body(repo, track, body):
    """Put the peer's body at ~/.cc/state/REPO/TRACK/pr-body.md; '' on success, else why not. That dir is the worker's
    own (cc-sandbox binds it rw), so anything in it may be a link it planted: REPO and TRACK are each opened with
    O_NOFOLLOW from the dir above, and the temp file is made (O_EXCL|O_NOFOLLOW, a fresh name) and renamed relative
    to the TRACK dir's fd, so no link on the way and no swap after a check is ever written through."""
    fds, tmp, dfd = [], None, None
    try:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
        fds.append(os.open(f"{home()}/.cc/state", os.O_RDONLY | os.O_DIRECTORY))
        for part in (repo, track):
            fds.append(os.open(part, flags, dir_fd=fds[-1]))
        dfd = fds[-1]
        tmp = f".pr-body.{uuid.uuid4().hex}.tmp"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644, dir_fd=dfd)
        os.fchmod(fd, 0o644)   # whatever the umask: the plain write this replaced left it readable
        with os.fdopen(fd, "w") as f:
            f.write(body)
        os.replace(tmp, "pr-body.md", src_dir_fd=dfd, dst_dir_fd=dfd)
        tmp = None
        return ""
    except OSError as e:   # a link on the way (ELOOP/ENOTDIR), a dir made 0500, a directory named pr-body.md
        return f"pr-body.md not written for {repo}/{track} (a link, or not the track's own state dir): {type(e).__name__}: {e}"
    finally:
        if tmp and dfd is not None:
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
        for fd in fds:
            os.close(fd)


def land(repo, track, sha, body, name):
    """The peer's DONE: its pushed tip, checked, then the hub's own landing command."""
    if not re.fullmatch(r"[0-9a-f]{40}", sha or ""):
        return 1, "no commit sha"
    wt = f"{home()}/.cc/worktrees/{repo}/{track}"
    rc, out = run_here(["git", "-C", wt, "fetch", "--quiet", "origin", f"track/{track}"])
    if rc:
        return None, f"fetch: {out}"
    rc, tip = run_here(["git", "-C", wt, "rev-parse", "FETCH_HEAD"])
    if rc or tip != sha:   # not pushed yet, or still on its way: the next drain asks again
        return None, f"track/{track} on origin is {tip[:12]}, not the {sha[:12]} {name} finished on"
    rc, out = run_here(["git", "-C", wt, "merge", "--ff-only", "--quiet", sha])
    if rc:
        return rc, f"fast-forward: {out}"
    if body:
        why = write_pr_body(repo, track, body)
        if why:
            return 1, why
    return run_here([f"{BIN}/cc-land", "queue", "--task", repo, track])


def one(e, name):
    """Run one spooled entry from the peer `name`; -> (ran, line), ran None for an entry to offer again (a DONE whose
    commit has not reached origin yet). e's own word on a host is never read."""
    tool, argv = e.get("tool"), e.get("argv")
    if not isinstance(argv, list) or not all(isinstance(a, str) for a in argv):
        return False, "argv is not a list of strings"
    if tool == "board":
        if len(argv) < 3 or argv[0] not in ("note", "status"):
            return False, f"board {argv[:1]} is not note or status"
        verb, repo, track = argv[:3]
        if not placed(repo, track, name):
            return False, f"{repo}/{track} was not placed on {name}"
        if verb == "note":
            rc, out = run_here([f"{BIN}/cc-board", "note", repo, track, f"[{name}] " + clean(" ".join(argv[3:]))])
        else:
            rc, out = run_here([f"{BIN}/cc-board", "status", repo, track, clean(argv[3] if len(argv) > 3 else "", 40)])
        return rc == 0, out
    if tool == "notify":
        repo, track = str(e.get("repo", "")), str(e.get("track", ""))
        if not placed(repo, track, name):
            return False, f"a notice from {repo}/{track}, which was not placed on {name}"
        env = dict(os.environ, CC_ROLE="worker")
        rc, out = run_here([f"{BIN}/cc-notify"] + notify_argv(argv, name, f"{repo}/{track}"), env=env)
        return rc == 0, out
    if tool == "land":
        if len(argv) != 2 or not placed(argv[0], argv[1], name):
            return False, f"land {argv!r} is not a track placed on {name}"
        rc, out = land(argv[0], argv[1], str(e.get("sha", "")), str(e.get("pr_body", ""))[:ENTRY_CAP], name)
        return (None if rc is None else rc == 0), out
    return False, f"{tool!r} is not a call the hub takes"


def late_once(d, late, ent, e, name, why):
    """A DONE still not on origin a day on: one line the first time (its --id keeps it to one per entry), then the
    mark's mtime is the last ask, so the drain asks again RETRY_EVERY instead of every pass. `why` can carry git's
    answer, which a remote's hook writes, so the line is unmarked: a planted <!channel> would page the whole channel."""
    os.makedirs(f"{d}/late", exist_ok=True)
    if not os.path.exists(late):
        argv = e.get("argv") if isinstance(e.get("argv"), list) else []
        what = "/".join(clean(str(a), 60) for a in argv[:2]) or "a track"
        run_here([f"{BIN}/cc-notify", "-t", "peer DONE not on origin", "--id", f"peer-late:{ent}", "--",
                  unmarked(f"{what} finished on {name} a day ago and its commit is still not on origin "
                           f"({clean(why, 200)}). The hub keeps asking once an hour; nothing was dropped.")])
    open(late, "w").close()


def drain():
    if not configured():
        return 0
    d, name = peer_dir(), peer_name()
    os.makedirs(f"{d}/drained", exist_ok=True)
    log = f"{d}/drain.log"
    with open(f"{d}/.drain.lock", "w") as lk:
        try:
            fcntl.flock(lk, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return 0   # another drain has it
        rc, out, err = call(["spool-take"], timeout=120)
        if rc:
            logline(log, f"cc-peer drain: {name} did not answer spool-take ({(err.strip() or 'rc %d' % rc)[:200]})")
            return 1
        done = []
        for line in out.splitlines():
            try:
                ent, e = line.split(" ", 1)
                e = json.loads(e)
            except Exception:   # noqa: BLE001 — a ValueError, or RecursionError for nesting deeper than this stack
                logline(log, f"cc-peer drain: an unreadable line from {name}: {clean(line, 200)!r}")
                continue
            if not ENTRY_RE.fullmatch(ent) or not isinstance(e, dict):
                continue
            if not os.path.exists(f"{d}/drained/{ent}"):
                late = f"{d}/late/{ent}"   # its mtime is the last ask of a DONE past RETRY_FOR
                try:   # no one entry stops the drain: one that raises is dropped, logged and acked like a refusal
                    t = e.get("t")   # spool's int(time.time()); anything else (a 4000-digit int overflowed the float)
                    if type(t) is not int or not 0 <= t <= T_MAX:
                        ran, why = False, "its t is not a time"
                    elif os.path.exists(late) and time.time() - os.path.getmtime(late) < RETRY_EVERY:
                        continue   # backing off: neither drained nor acked, the peer offers it again
                    else:
                        ran, why = one(e, name)
                except Exception as x:   # noqa: BLE001
                    ran, why = False, f"it raised {type(x).__name__}: {x}"
                if ran is None:
                    if time.time() - t > RETRY_FOR:
                        late_once(d, late, ent, e, name, why)
                    logline(log, f"cc-peer drain: {name} {ent} {e.get('tool')!r}: later — {clean(why, 300)}")
                    continue   # neither drained nor acked: the peer offers it again
                if os.path.exists(late):
                    os.unlink(late)
                logline(log, f"cc-peer drain: {name} {ent} {e.get('tool')!r}: {'ran' if ran else 'dropped'}"
                             f"{' — ' + clean(why, 300) if why and not ran else ''}")
                open(f"{d}/drained/{ent}", "w").close()
            done.append(ent)
        for i in range(0, len(done), 50):
            call(["spool-ack"] + done[i:i + 50], timeout=60)
    return 0


# ---- the peer's end -----------------------------------------------------------------------------------------------

def spool_dir():
    return os.environ.get("CC_PEER_SPOOL") or f"{peer_dir()}/spool"


def entry_bytes(e):
    """e as spool writes it: UTF-8, not \\u-escaped (escaping took a body of U+FFFD to six bytes a char, past the cap).
    A lone surrogate (an argv byte that was not UTF-8) has no UTF-8, so backslashreplace writes its JSON escape."""
    return json.dumps(e, ensure_ascii=False).encode("utf-8", "backslashreplace")


def spool(tool, argv):
    """Write one call for the hub to drain. Never stops its caller: a peer worker's board note is not worth a stop. An
    entry is at most ENTRY_CAP bytes as written: a DONE's pr-body.md is cut to fit, and any other call that will not
    fit is refused with one line on stderr and rc 1, which its callers log and go past."""
    e = {"tool": tool, "argv": argv, "t": int(time.time())}
    if tool == "notify":
        e.update(repo=os.environ.get("CC_PEER_REPO", ""), track=os.environ.get("CC_PEER_TRACK", ""))
    if tool == "land" and len(argv) == 2:
        repo, track = argv
        wt = f"{home()}/.cc/worktrees/{repo}/{track}"
        e["sha"] = subprocess.run(["git", "-C", wt, "rev-parse", "HEAD"], capture_output=True,
                                  text=True).stdout.strip()
        # the hub lands what origin has, so the tip goes there first; one that fails waits in the drain for a day
        subprocess.run(["git", "-C", wt, "push", "--quiet", "origin", f"HEAD:refs/heads/track/{track}"],
                       capture_output=True, timeout=120)
        try:   # the worker writes this dir, so a link here could publish any file this account reads
            e["pr_body"] = read_regular(f"{home()}/.cc/state/{repo}/{track}/pr-body.md",
                                        ENTRY_CAP // 2).decode(errors="replace")
        except OSError:
            pass
    body0, raw = e.get("pr_body", ""), entry_bytes(e)
    while len(raw) > ENTRY_CAP and e.get("pr_body"):   # a char is 1..6 bytes written, so this never cuts past the need
        body = e["pr_body"]
        e["pr_body"] = body[:max(0, len(body) - max(1, (len(raw) - ENTRY_CAP + 5) // 6))]
        raw = entry_bytes(e)
    if len(raw) > ENTRY_CAP:
        print(f"cc-peer spool: refused: this {tool} call is {len(raw)} bytes as an entry, over the {ENTRY_CAP} the hub "
              "takes", file=sys.stderr)
        return 1
    if len(e.get("pr_body", "")) < len(body0):
        print(f"cc-peer spool: pr-body.md cut to {len(e['pr_body'])} of {len(body0)} chars to fit the entry",
              file=sys.stderr)
    d = spool_dir()
    os.makedirs(d, exist_ok=True)
    name = f"{time.time_ns():019d}-{os.getpid()}-{uuid.uuid4().hex[:8]}.json"
    with open(f"{d}/.{name}", "wb") as f:
        f.write(raw)
    os.replace(f"{d}/.{name}", f"{d}/{name}")
    if tool == "land":   # cc-loop's receipt: committed and pending, which it notes and finishes on
        print(json.dumps({"task_id": f"{argv[0]}/{argv[1]}", "errors": [], "committed_sha": e.get("sha", ""),
                          "pr_url": "", "pending": {"landing": "the hub queues it when it drains this host"},
                          "landing": {"message": "The hub queues the landing when it next drains this host."}}))
    return 0


def serve_launch(words, brief):
    lid, repo, track, rest = words[0], words[1], words[2], words[3:]
    if not ID_RE.fullmatch(lid) or not ok_name(repo) or not ok_name(track):
        return 2, "refused: launch needs a 32-hex id, a repo and a track"
    flags, base = [], "main"
    for i in range(0, len(rest), 2):
        k, v = rest[i], (rest[i + 1] if i + 1 < len(rest) else "")
        if k not in FLAGS or not FLAGS[k].fullmatch(v) or ".." in v:
            return 2, f"refused: {k} {v}"
        if k == "--base":
            base = v
        else:
            flags += [k, v]
    if len(brief) > BRIEF_CAP or not brief.strip():
        return 2, "refused: the brief is empty or too long"
    if not os.path.isdir(f"{home()}/dev/{repo}/.git"):
        return 2, f"refused: there is no clone at ~/dev/{repo} on this host"
    d = f"{peer_dir()}/launched"
    os.makedirs(d, exist_ok=True)
    try:
        os.close(os.open(f"{d}/{lid}", os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
    except FileExistsError:
        return 3, f"refused: launch {lid} has already run here"
    cc = os.environ.get("CC_PEER_CC") or f"{home()}/bin/cc"
    board = os.path.join(os.path.dirname(cc), "cc-board")
    env = {k: v for k, v in os.environ.items() if not k.startswith("SSH_")}
    # sshd's PATH is the bare system one; the worker needs this host's own tools and its claude
    env["PATH"] = f"{os.path.dirname(cc)}:{home()}/.local/bin:{env.get('PATH') or '/usr/bin:/bin'}"
    # the shadow row: a board here, so the worker's reads (base, title, pr) answer; its writes go home by spool
    if subprocess.run([board, "get", repo, track, "title"], capture_output=True, env=env).returncode:
        subprocess.run([board, "init", repo, f"{home()}/dev/{repo}", base], capture_output=True, env=env)
        subprocess.run([board, "add", repo, track, track.replace("-", " ")], capture_output=True, env=env)
    env.update(CC_PEER_SPOOL=spool_dir(), CC_PEER_REPO=repo, CC_PEER_TRACK=track)
    p = subprocess.run([cc, repo, track, "--go", brief.decode(errors="replace")] + flags, capture_output=True,
                       text=True, env=env, timeout=300)
    return (0 if p.returncode == 0 else 1), (p.stdout + p.stderr).strip()[-2000:]


def serve():
    words = os.environ.get("SSH_ORIGINAL_COMMAND", "").split()
    verb = words[0] if words else ""
    if verb == "room":
        cc = os.environ.get("CC_PEER_CC") or f"{home()}/bin/cc"
        try:
            p = subprocess.run([os.path.join(os.path.dirname(cc), "cc-room"), "check"], capture_output=True,
                               text=True, timeout=30)
            print(p.stdout.strip()[:300])
            return 0 if p.returncode == 0 else 1
        except (OSError, subprocess.SubprocessError) as e:
            print(f"cc-room did not answer: {type(e).__name__}")
            return 1
    if verb == "launch" and len(words) >= 4:
        rc, out = serve_launch(words[1:], sys.stdin.buffer.read(BRIEF_CAP + 1))
        print(out, file=sys.stderr if rc else sys.stdout)
        return rc
    d = spool_dir()
    if verb == "spool-take" and len(words) == 1:
        os.makedirs(f"{d}/taken", exist_ok=True)

        def aside(src, n, why):   # never offered again and never holding a take slot: kept in aside/ for a person
            try:   # aside/ is opened without following a link, so a planted one never takes an entry elsewhere
                os.makedirs(f"{d}/aside", exist_ok=True)
                fd = os.open(f"{d}/aside", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
                try:
                    os.replace(src, n, dst_dir_fd=fd)
                finally:
                    os.close(fd)
                logline(f"{d}/aside.log", f"cc-peer spool-take: {n} moved to aside/: {why}")
                return
            except OSError as x:   # aside/ is a file or a link, or aside/<n> is taken: removed, so it holds no slot
                fail = type(x).__name__
            try:
                if stat.S_ISDIR(os.lstat(src).st_mode):
                    shutil.rmtree(src)
                else:
                    os.unlink(src)
                done = "removed"
            except OSError as x:
                done = f"not removed ({type(x).__name__})"
            logline(f"{d}/aside.log", f"cc-peer spool-take: {n} {done}, as aside/ refused it ({fail}): {why}")

        for n in sorted(n for n in os.listdir(d) if ENTRY_RE.fullmatch(n))[:TAKE_MAX]:   # a temp or a dir: no slot
            try:
                os.replace(f"{d}/{n}", f"{d}/taken/{n}")
            except OSError as x:   # taken/<n> is a dir or the like: the entry cannot be taken, so it goes aside
                aside(f"{d}/{n}", n, f"taken/ refused it ({type(x).__name__})")
        # taken and never acked: offered again. Whatever cannot be offered goes aside, so it never holds a slot for good
        for n in sorted(n for n in os.listdir(f"{d}/taken") if ENTRY_RE.fullmatch(n))[:TAKE_MAX]:
            try:   # a regular file only: a FIFO with an entry's name would hang every drain at its timeout
                if not stat.S_ISREG(os.lstat(f"{d}/taken/{n}").st_mode):
                    aside(f"{d}/taken/{n}", n, "not a regular file")
                    continue
                raw = read_regular(f"{d}/taken/{n}", ENTRY_CAP + 1)
                if len(raw) > ENTRY_CAP:
                    aside(f"{d}/taken/{n}", n, f"over the {ENTRY_CAP}-byte entry cap")
                    continue
                e = json.loads(raw)
                if not isinstance(e, dict):   # the hub skips it without an ack, so it would come back every drain
                    aside(f"{d}/taken/{n}", n, "not a JSON object")
                    continue
                print(n, json.dumps(e))
            except Exception as x:   # noqa: BLE001 — json.loads raises RecursionError on deep nesting, not ValueError
                aside(f"{d}/taken/{n}", n, f"unreadable ({type(x).__name__})")
        return 0
    if verb == "spool-ack" and len(words) > 1:
        for n in words[1:]:
            if ENTRY_RE.fullmatch(n):
                try:
                    os.unlink(f"{d}/taken/{n}")
                except OSError:
                    pass
        return 0
    print(f"refused: {verb or 'nothing'} is not a verb this key runs", file=sys.stderr)
    return 2


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-peer.py, run in this namespace (as cc-room's are)."""
    path = os.path.join(os.path.dirname(BIN), "tests", "selfcheck", "cc-peer.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


def main(a):
    if a[:1] == ["room"]:
        return room()
    if a[:1] == ["drain"]:
        return drain()
    if a[:1] == ["serve"]:
        return serve()
    if a[:1] == ["spool"] and len(a) >= 2:
        return spool(a[1], a[2:])
    if a[:1] == ["selfcheck"]:
        return selfcheck()
    if a[:1] == ["launch"] and "--" in a:
        i = a.index("--")
        head, cmd = a[1:i], a[i + 1:]
        log = None
        if "--log" in head:
            j = head.index("--log")
            log = head[j + 1] if j + 1 < len(head) else None
            head = head[:j] + head[j + 2:]
        if len(head) == 1:
            return launch(head[0], cmd, log)
    print(__doc__.split("\n\n")[0], file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
