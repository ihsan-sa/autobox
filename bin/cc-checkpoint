#!/usr/bin/env bash
# cc-checkpoint — auto-commit+push a track worktree. Wired as a Claude Stop hook (runs after each turn).
#   cc-checkpoint          commit whatever changed and push it (the hook; always exits 0, never blocks a session)
#   cc-checkpoint --commit commit only; exit 1 on refusal, failed commit or remaining changes (used by cc done)
#   cc-checkpoint --push   push only, and exit non-zero saying why if it cannot — `cc done` calls this, because a
#                          PR on an un-pushed branch is worse than no PR
#   cc-checkpoint --remote where the push goes: the remote's name (making the repository if this is a member
#                          workspace project with none), or nothing and exit 1 if there is nowhere. `cc done`
#                          asks, so the PR it opens is against the repository the push went to
#   cc-checkpoint --sweep  the HOST's push for the sessions a person drives — and, once pushed, the HOST's landing for
#                          them (land_queue: a track in review with a PR, in a workspace `cc lands` says holds the grant,
#                          is queued to cc-land once per PR and head, and only at a head the host's own lease says is
#                          on the remote — never one a push skipped or failed for): every member workspace track whose HEAD is
#                          not what it last pushed — or whose project mirror has not got that HEAD (mirror_push) —
#                          gets `--push` run from its worktree, with that workspace's own credential. cc-checkpoint.timer runs it every 5 min (config/units.json): inside a workspace's
#                          boundary the Stop hook commits but cannot push — the credential is host-only by design
#                          (cc-sandbox) — and only a worker's loop (cc-loop) pushed from out here, so two commits an
#                          interactive member session made sat on the box until a person pushed by hand (2026-09-04).
#                          It pushes and NOTHING ELSE: a worktree whose .git is not the workspace's own is refused
#                          before any git runs in it, so is one whose .cc state files are symlinks the host would
#                          write through; and no repository is created from the timer, no default branch moved and
#                          no branch deleted from anywhere (review of #225). On the owner's own tracks it pushes
#                          only a head a worker's loop left in ~/.cc/push-owed/<repo>/<track> because its own push
#                          failed (cc-loop push_host), once that loop is gone
#   cc-checkpoint adopt <handle> <track> [<sha>]   the ONE way out of --push's rc=3 (no host lease). With no sha it
#                          says what the remote holds and what this worktree holds, so a PERSON can read that commit;
#                          given the sha they read, and only while the remote still answers with it, it records the
#                          host's lease and the next push reconciles the branch. It pushes nothing itself and reads
#                          nothing out of the member's tree
#   cc-checkpoint bind <handle> <track> [<remote>]   the HOST says a member workspace's track is a project of its own
#                          that delivers to <remote> (default: the remote named after the track), which must already
#                          be a remote of ~/dev/<handle>. Written to that checkout's .git/config, which the member
#                          cannot write; pick_remote then pushes and `cc done` opens the PR there, in and out of the boundary
#   cc-checkpoint bind <handle> --wired   the same for every project cc-gh-token wired into ~/dev/<handle> before it
#                          bound tracks: each remote but origin that is named after its own repository and is not
#                          origin's repository binds the track of that name. Already-bound tracks are left; it says each
#   cc-checkpoint gitdir <handle> <worktree>   0 when that worktree really hangs off ~/dev/<handle>/.git, else 1 and
#                          the reason. The wall `cc done` puts in front of its own git (core/bin/cc), asked here so
#                          both callers keep one rule and one message (review-156c)
#   cc-checkpoint selfcheck  that rule, on fixtures of its own (check.sh runs it)
# EVERY git IT RUNS carries core.fsmonitor=false and, unless the caller pinned a core.hooksPath through
# GIT_CONFIG_KEY_<n> (cc-loop and cc pin the main checkout's hooks), the hooksPath the repo's shared config names:
# no program a worker configured in config.worktree runs in the host's checkpoint (see gg, below).
# It also INDEXES what the turn wrote for the knowledge base
# (`cc-lib index --touch ~/.cc/state ~/.claude/projects`: the journal and the memory file) after `cc-lib memory` has
# kept the loaded memory index to its rule lines (a fact line a turn added moves to MEMORY-facts.md, found on demand),
# while --sweep runs the full `cc-lib index` every five minutes for whatever bypassed a hook — the knowledge base's only
# maintenance pass.
# Committing is what needs a track: no-op unless the cwd is inside one (marker: <worktree-root>/.cc/track). Never touches
# the primary worktree / default branch (no marker there), so main/planning sessions stay clean.
# IT COMMITS THIS TRACK'S OWN BRANCH AND NO OTHER (own_branch): track/<track>, or a side branch this track cut for
# itself — <kind>/<track> or <kind>/<track>-YYYY-MM-DD, the shape a seat makes when its track branch is deleted under
# it by a squash merge (study/ece203-2026-09-19, the ece203 course seat). Never a bare name, so never main; never
# track/<other>, and not even track/<track>-<suffix>, because <track>-<suffix> is a track of its own around here
# (ece231, ece231-lab1). Anything else refuses, as do staged names that look like secrets.
# AND EVERY REFUSAL IS SAID TO THE SESSION, in one Stop line, as well as logged to .cc/checkpoint.err (tell): four
# silent refusals on a side branch cost the ece203 seat every turn-end commit it made that day, and two turns of the
# session after it (raised-checkpoint-refuses-a-study-branch). `cc done` stays stricter than the hook — completion
# and the landing queue need the canonical track/<track>, and it says so on stderr. Push stderr → .cc/push.err.
# AND SO IS A TURN THAT PUSHED NOTHING while this worktree is ahead of the remote (push_gap) — the same one line, read
# from this worktree's own receipt of the last push (.cc/pushed) and costing no network. A branch a landing deleted at
# origin is put back by the next checkpoint, because that push is a CREATE and remote_gone has the lease accept a
# remote holding no tip instead of calling it "something else wrote" — and so is one deleted while nothing changed
# here, because a quiet turn whose HEAD is the last push asks the remote whether the branch is still there
# (branch_back: one bounded ls-remote) and puts it back when it is not. A quiet turn whose HEAD is AHEAD of that
# receipt — the session committed, or committed and pushed, by hand — pushes it there and then (push_catchup)
# instead of telling the seat for ever that work the remote already has is not live; and a push that genuinely cannot happen is heard
# by the session in the turn it failed, rather than sitting in push.err for a day and a half while the seat reports
# its work as live (ece206 and ece207, 2026-09-19/20: two rescues, one false statement to the owner).
# A BRANCH MOVED UNDER THE WORKTREE IS NEVER COMMITTED AS A REVERT. A second worktree on the same branch (`git checkout
# --ignore-other-worktrees`, a hand fix) commits, the branch moves, and this worktree's index still holds the old tip —
# which `git add -A` reads as a staged diff UNDOING the fix. The commit block below tells the two apart by this
# worktree's own HEAD reflog, carries the tree forward when the branch merely advanced (a local edit rides along; one
# that collides with the fix refuses and touches nothing), and refuses when the branch was rewritten. Both refusals
# leave HEAD's reflog alone, so they repeat every turn until the tree is settled by hand (a `git reset` there would
# stamp it, and the next turn would commit the stale tree — review of #544). The journal gets one line per move.
# A HAND PUSH FROM THIS WORKTREE DOES NOT STALE THE LEASE EITHER: when the remote holds a tip this branch's own
# reflog has held (the pre-rebase head), .cc/pushed moves to it before the leased push (lease_refresh).
# The push carries whatever credential `cc-gh-token gitargs` gives it for that remote — a GitHub App token for
# the org this box has an app for, nothing at all for any other remote — so a repo whose only credential is the
# app pushes unattended. The token is minted for the push and nothing about it is written here. For a MEMBER
# WORKSPACE's track it is minted FOR that workspace, so it opens that workspace's repositories and no other
# member's (cc-gh-token, docs/design-member-workspaces.md).
# NO PUSH HERE CAN WAIT FOR A PERSON. Every one of them runs unattended, and a git with no credential asks for a
# username on the terminal, where nothing will ever answer: a member track sat 6h38m inside git-remote-https on
# that prompt, held its sandbox slot and reported nothing (2026-09-07). So every command below that reaches a
# remote goes through git_unattended — prompts off, askpass off, ssh in batch mode, and a hard bound on EACH
# (CC_PUSH_TIMEOUT, 120 s), because a transport that stalls with nothing to say is the same outage. A turn
# against a dead remote therefore costs a few minutes at worst, not a night. Hitting the bound is a failed push
# like any other: non-zero, with the reason on .cc/push.err, which `cc ls` and `cc digest` already show as
# `push!`. GETTING a credential to a member worker is #225's — the rule here is only that the push ENDS.
# A PUSH THE REMOTE REJECTS IS SAID, NOT JUST MARKED. `push!` says only that a push failed, and push.err is replaced
# every run, so a remote refusing every checkpoint (a workflow file the token has no scope for) looked like any
# flaky push for 3.6 days (2026-09-08). git's `[remote rejected]` line is kept in .cc/push.rejected until a push
# succeeds, and goes to the row's board note and the track's journal once per distinct reason (push_rejected).
# WHERE IT PUSHES: `origin`. A member workspace's track that is a project of its own pushes to its OWN repository,
# the remote NAMED AFTER THE TRACK (binding one is the owner's to do, and nothing here reads the repository's own
# name again); every other track of a workspace is a task on the workspace's project and pushes to its `origin`.
# Only a workspace with no remote at all gets a repository CREATED for its track (cc-gh-token create), so work
# finished there does not sit on a local branch nobody else can see — never one per task (2026-10-05).
# A TRACK THE HOST BOUND to a remote (`cc-checkpoint bind`, or cc-gh-token wiring a project's repository) delivers there,
# inside the member's boundary and out here alike: the binding is cc-track.<track>.remote in ~/dev/<handle>/.git/config,
# which cc-sandbox holds read-only in there, so a member naming a track never picks a repository by it (review of #965).
# Unbound, inside the member's boundary it is `origin` or nothing (pick_remote says when); a track-named remote pointing anywhere but origin's repository (its url or a push url) is never taken, in there or out here. A repository that could not be
# made is nowhere to push; the reason is in .cc/create.err and the next turn tries again. After a push succeeds, the branch is REMOVED from any other repository the workspace
# remotes name but the project's mirror (below), so opening a project's repository shows that project and not its neighbours (owner,
# 2026-09-04). Only a tip that is an ancestor of what was just pushed is removed; anything else is left and
# named in .cc/evict.err — never push.err, which means the push failed (review of #217). Never removed from: the
# remote named after the track, nor the repository the track's PR is on — that delete closes the PR it lands through.
# Nothing is created, and nothing removed, for anything but a member workspace's project.
# AND THAT TRACK-NAMED REMOTE IS THE PROJECT'S MIRROR (mirror_push). On the host, once a member track's push to origin
# lands, the same branch goes to the remote named after the track too when its urls are not origin's, FAST-FORWARD
# ONLY: a plain push, never forced, so a mirror somebody else wrote to refuses and is said once per commit on the
# board (.cc/mirror.refused) and a mirror that did not answer is tried again (.cc/mirror.err). It is never the
# delivery, so it moves no lease and no PR, fails no `cc done`, and evict_elsewhere never deletes the branch from it.
# ece298a's pll project lives in origin AND its own pll repository, which the member wants carrying every revision;
# the push went to origin alone, so pll fell a commit behind and the seat pushed it by hand (2026-10-12).
# AND IT SAYS WHOSE IT IS: a project's branch is cut from the workspace's default branch, so it arrives
# carrying the WORKSPACE's README and the project's repository opens on a page about the workspace. While that
# README still opens with the workspace's own name — nobody having written a word of it for this project — the
# commit below replaces it with one naming the project. Retitled by anyone, it is never touched again.
# WHICH workspace and WHICH name that creation uses come from the worktree's own path,
# $HOME/.cc/worktrees/<repo>/<track>, and never from .cc/track: that file is bound read-WRITE into the member
# session, so what it says is the member's word, and naming a repository in the owner's org is an org-admin
# action he reserves to himself (review of #214). A worktree that is not under that path pushes to origin and
# gets nothing created, whatever .cc/track says.
# AND IT OPENS ON THE PROJECT'S BASE, NOT ON THE TRACK. GitHub takes an empty repository's default branch from the
# FIRST branch pushed into it, and a project's first push is its track — so every repository the box made opened
# on track/<project>, a clone came up on it, and `cc done` found no base branch there to open a PR against (#218).
# A repository created HERE is therefore marked (.cc/base-seed) and the next push sends the base branch first, then
# asks GitHub for it by name (cc-gh-token default) if the default is still something else. The base is the board's
# (cc-board base), never a track, whoever names it. Only a repository this file made is marked, so one the owner
# bound by hand is never pushed to or repointed behind his back; and repositories made before this are not touched —
# `cc-gh-token default <workspace> <project> <base>` fixes one, once.
# (That base-seed path is reached only with a .cc/base-seed marker: a repository this file makes is the workspace's own `origin`, which seed_head skips.)
# AND THAT BASE CARRIES THE PROJECT'S OWN README, because the retitle below runs on the track alone: without it
# the front page of a project's repository is the workspace's until the project's first PR merges. Not on the
# workspace's FIRST project, whose repository is the workspace's own `origin` — seed_head says why.
SECRETS='(^|/)(\.env[^/]*|.*\.(pem|key)|credentials[^/]*)$'
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
MODE=commit; STRICT=0
case "${1:-}" in --commit) STRICT=1;; --push) MODE=push;; --remote) MODE=remote;; --sweep) MODE=sweep;; gitdir) MODE=gitdir;; adopt) MODE=adopt;; bind) MODE=bind;; selfcheck) MODE=selfcheck;; "") ;; *) echo "cc-checkpoint: unknown argument '$1'" >&2; exit 2;; esac
# ── no git here runs a program the worker configured ──────────────────────────────────────────────────
# A worker writes its worktree and, with extensions.worktreeConfig on, its admin dir's config.worktree too, until
# cc-sandbox bound the host's empty file there: a core.fsmonitor or core.hooksPath in it made this file's plain
# `git add -A` run the worker's program as the owner. So every git below carries core.fsmonitor=false, and a
# core.hooksPath the worker cannot have written: the caller's own pin when it set one through GIT_CONFIG_KEY_<n>
# (cc-loop, cc and the sweep pin the MAIN checkout's hooks that way, and a -c here would beat their pin, being the
# stronger scope), else the one the repo's SHARED config names, read from the common dir's config file alone, else
# that dir's hooks/ — the hooks git would run anyway, minus anything config.worktree adds. A failing pre-commit there
# still stops a checkpoint (cc-native's N9 counts on it). Outside a repo it is /dev/null.
# Filter drivers are not neutralised here: their commands come from config, and the one config file a worker could
# write is that config.worktree. cc-green's tree (green_tree) carries core.fsmonitor=false and no hooks at all.
HP=/dev/null
if GCD=$(command git -c core.fsmonitor=false rev-parse --path-format=absolute --git-common-dir 2>/dev/null) && [ -n "$GCD" ]; then
  HP=$(command git config --file "$GCD/config" --get core.hooksPath 2>/dev/null) || HP="$GCD/hooks"; fi
GG=()
gg(){ local i=0 k; GG=(-c core.fsmonitor=false -c "core.hooksPath=$HP")
  while [ "$i" -lt "${GIT_CONFIG_COUNT:-0}" ] 2>/dev/null; do
    k=GIT_CONFIG_KEY_$i; [ "${!k:-}" ] && [ "${!k,,}" = core.hookspath ] && GG=(-c core.fsmonitor=false); i=$((i+1)); done; }
git(){ gg; command git "${GG[@]}" "$@"; }
# ── no push waits for a person ───────────────────────────────────────────────────────────────────
PUSH_TIMEOUT=${CC_PUSH_TIMEOUT:-120}   # seconds. A track's push is seconds of work, so this is a wall, not a budget.
# A NAME THAT DID NOT RESOLVE IS ASKED AGAIN. The box's resolver drops out for seconds at a time: on 2026-10-14 two
# tracks' pushes failed 17 s apart on 'Could not resolve host: github.com' and each needed a hand retry. A lookup that
# failed sent nothing, so asking again is safe; anything else that failed (a refusal, a rejection, the bound) is
# returned at once. CC_RESOLVE_WAITS: the seconds slept before each retry.
# …BUT NOT INSIDE A FENCE. A sandbox with no network of its own (loopback only, CC_NET_DEV) fails every lookup for
# good, and the hook pushes there after every turn: waiting a minute each time would buy nothing.
RESOLVE_WAITS=${CC_RESOLVE_WAITS:-5 15 40}
RESOLVE_RE='Could not resolve host|Could not resolve hostname|Temporary failure in name resolution|Name or service not known|No address associated with hostname'
NET_DEV=${CC_NET_DEV:-/proc/net/dev}   # this network namespace's interfaces; the selfcheck points it at a fixture
has_uplink(){ awk -F: 'NR > 2 && $1 !~ /^ *lo$/ { up = 1 } END { exit !up }' "$NET_DEV" 2>/dev/null; }
# A 'remote:' line is the server's own text, not our lookup: a hook there that quotes a resolver error is no flap.
# The pause is a waited-on background sleep, so a kill lands at once and its trap takes the scratch file with it.
git_unattended(){   # _git_bounded, asked again after each RESOLVE_WAITS pause while the only failure is the name lookup
  local e rc w waits=""; has_uplink && waits=$RESOLVE_WAITS
  e=$(mktemp) || { _git_bounded "$@"; return; }
  trap 'resolve_gone 143' TERM; trap 'resolve_gone 130' INT; trap 'resolve_gone 129' HUP
  RESOLVE_TMP=$e
  for w in $waits ""; do
    _git_bounded "$@" 2>"$e"; rc=$?
    [ "$rc" != 0 ] && [ -n "$w" ] && grep -v '^remote:' "$e" | grep -qE "$RESOLVE_RE" || break
    printf '%s %s — asking again in %ss\n' "$(date -u +%FT%TZ)" "$(grep -v '^remote:' "$e" | grep -m1 -oE "($RESOLVE_RE).*")" "$w" >&2
    sleep "$w" & RESOLVE_SLEEP=$!; wait "$RESOLVE_SLEEP"; RESOLVE_SLEEP=
  done
  trap - TERM INT HUP; RESOLVE_TMP='' RESOLVE_SLEEP=''
  cat "$e" >&2; rm -f "$e"; return "$rc"; }
resolve_gone(){   # git_unattended's trap: $1 the exit code. The pause's sleep and the scratch file go with the process.
  [ -z "${RESOLVE_SLEEP:-}" ] || kill "$RESOLVE_SLEEP" 2>/dev/null
  [ -z "${RESOLVE_TMP:-}" ] || rm -f "$RESOLVE_TMP"
  exit "$1"; }
_git_bounded(){   # git that can ask nobody anything and cannot run past the bound. Exit codes are git's, plus
  # 124/137 from `timeout`. Both locks are needed and neither is enough: the prompt locks turn "ask for a
  # username" into an error the caller can read, and the bound catches everything they do not — a credential
  # helper that blocks on its own, a connection accepted and then never answered. `timeout` runs the command in
  # a process group of its own and signals the GROUP, so the transport helper dies with it instead of outliving
  # the run (the lesson the gate runner learned on its own subprocesses, cc-steward:368).
  gg; timeout -k 5 "$PUSH_TIMEOUT" env -u GIT_ASKPASS -u SSH_ASKPASS \
    GIT_TERMINAL_PROMPT=0 SSH_ASKPASS_REQUIRE=never \
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
    git "${GG[@]}" -c core.askPass= "$@"; }
bound_hit(){   # $1 a git_unattended exit code, $2 the file its stderr went to.  0 when the bound fired.
  # `timeout` KILLS the command, so git wrote nothing at all — without this the push fails with an empty
  # push.err, which is the same silence the bound exists to end.
  case "$1" in 124|137) ;; *) return 1;; esac
  printf '%s the push to %s did not finish within %ss and was killed — nothing was pushed. A push that hangs this long has no credential it can use, or a remote that is not answering.\n' \
    "$(date -u +%FT%TZ)" "$remote" "$PUSH_TIMEOUT" >> "$2"; }
# ── the lease ────────────────────────────────────────────────────────────────────────────────────
# A track branch has exactly one writer, so a worker that rebased its own branch must still reach the remote. A
# plain push is rejected non-fast-forward there and the work never becomes a PR: on 2026-08-31 a track finished
# green with everything committed and NO PR, and only the watchdog noticed. So a DIVERGED push carries a lease:
# --force-with-lease with an EXPLICIT expected SHA, the one this worktree last pushed (.cc/pushed).
# The bare --force-with-lease is not good enough. It leases against refs/remotes/origin/<branch>, and any
# fetch (rebasing onto the default branch does one) refreshes that ref, after which it overwrites somebody
# else's commit without a murmur — measured, not assumed. Given an explicit value git compare-and-swaps against
# what is REALLY on the remote, so a refusal means exactly one thing: something this worktree did not write is on
# that branch. That is never overwritten and never swallowed — see lease_refused.
# WHERE THIS FILE KEEPS ITS STATE — $ST, and EVERY name it writes: pushed, adopted, push.err, push.err.tmp, push.rejected,
# checkpoint.err, create.err, create.err.tmp, base-seed, evict.err, evict.err.tmp, evict.same, mirrored, mirror.err, mirror.refused. All of them are written with shell
# redirections, and a redirection FOLLOWS A SYMLINK — while ~/.cc/worktrees/<h> stays bound read-WRITE in the
# member's live boundary, so a session looping `ln -sf ~/.ssh/authorized_keys .cc/push.err.tmp` wins the window
# between any check and the write on one of the 288 daily ticks and has the host truncate that file as the owner
# (security review of #225). A pre-check cannot close that, so a host-side caller hands this a directory of its own
# under ~/.cc/push-state, which is under no bind: nothing inside the member's tree is written to at all. BOTH host
# callers do it, for every mode — --sweep, and `cc done` for the plain commit (which pushes too), --remote and
# --push alike (review of #225). Unset — the member's own Stop hook — it is the worktree's own .cc, where the only
# writer is the session that owns the tree. Only .cc/track is ever READ out of the worktree, and never trusted.
# …SO THAT IS ALSO WHERE `push!` IS READ FROM. push.err on a member workspace's row is this file's write under
# ~/.cc/push-state and never the one in the member's tree: theirs has no credential by design, so it is rewritten
# every turn and cleared by nothing on the host. `commit!` (checkpoint.err) is read from EITHER place, because both
# sides refuse and each can only write where it runs — the refusal the member's own hook makes here is the only
# record that it happened, and it moves no HEAD for the sweep to notice. cc-reconcile's host_marker/commit_marker
# states the rule and `cc ls`, cc-digest, cc-reconcile and the Home tab follow it. Existence only, never content.
ST=''   # set once $root is known: ${CC_CHECKPOINT_STATE_DIR:-$root/.cc}
remote=origin   # every track on the box, until pick_remote says otherwise
workspace=''    # set only for a member workspace's track: the token is then minted for that workspace alone
WSREPO=''; WSTRACK=''   # this worktree's repo and track AS THE PATH SPELLS THEM — see the header
path_ids(){   # $1 worktree root → WSREPO/WSTRACK from $HOME/.cc/worktrees/<repo>/<track>.  1 = not one of those
  local base real rest
  base=$(readlink -f "$HOME/.cc/worktrees" 2>/dev/null) || return 1   # resolved on both sides: a symlinked HOME still matches
  real=$(readlink -f "$1" 2>/dev/null) || return 1
  rest=${real#"$base/"}; [ "$rest" != "$real" ] || return 1
  case "$rest" in */*/*) return 1 ;; */*) ;; *) return 1 ;; esac   # exactly <repo>/<track>: no deeper, no shallower
  WSREPO=${rest%%/*}; WSTRACK=${rest#*/}
  case "$WSREPO$WSTRACK" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
  case "$WSREPO/$WSTRACK" in .*|*/.*) return 1 ;; esac   # no dotted half, so no . and no ..
  [ -n "$WSREPO" ] && [ -n "$WSTRACK" ]
}
own_branch(){   # $1 the track (.cc/track line 2), $2 the branch HEAD is on.  0 when that branch is THIS track's own
  # `cc` cuts one branch for a track, track/<track>, and that is the one `cc done` completes and the landing queue
  # knows. But a seat whose track branch was deleted under it — squash-merged, then gone from the remote — cuts a
  # dated side branch by hand and works there, and this hook refusing that silently is what cost the ece203 course
  # seat its commits on 2026-09-19. So a side branch of this track is committed too, and ONLY when the name says
  # it is this track's and nobody else's: one prefix segment, then this track's name, then nothing or a date.
  # WHAT THAT LETS A SESSION COMMIT ONTO, and what it does not: not a bare name, so never main or master or whatever
  # a repo calls its default; not track/<other>, and not track/<track>-<suffix> either, because <track>-<suffix> is
  # a track of its own here (ece231 and ece231-lab1 are two seats); and under another prefix only the track's exact
  # name or that name with a date — study/ece231-lab1 is not ece231's, study/ece231-2026-09-19 is.
  local t="$1" b="$2"
  [ -n "$t" ] && [ -n "$b" ] || return 1
  [ "$b" = "track/$t" ] && return 0
  case "$b" in
    /*|*/*/*|track/*) return 1 ;;   # an empty prefix, more than one segment of it, or another track's branch
    ?*/"$t"|?*/"$t"-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) return 0 ;;
  esac
  return 1
}
spend_seed(){   # remove $ST/base-seed — but only while $ST is still the directory it was checked as
  # `rm -f "$ST/base-seed"` resolves $ST AT REMOVAL TIME. With no state dir given, $ST is the worktree's own .cc
  # and a member's session is live beside this: swap .cc for a link to any directory the owner can write and the
  # host unlinks a file called base-seed in there (security review of #225). A marker that is not spent costs a
  # repeated base push, which is cheap; unlinking somebody else's file is not.
  [ -L "$ST" ] || rm -f "$ST/base-seed"; return 0; }
member_tree(){   # $1 path → 0 when it sits inside a member workspace's checkout (~/dev/<handle>, marker and all)
  local real base h
  real=$(readlink -f "$1" 2>/dev/null) || return 1
  base=$(readlink -f "$HOME/dev" 2>/dev/null) || return 1
  case "$real" in "$base"/*) h=${real#"$base"/}; h=${h%%/*} ;; *) return 1 ;; esac
  [ -n "$h" ] && [ -f "$HOME/dev/$h/.cc/member-workspace" ]; }
member_gitdir(){   # $1 handle · $2 worktree → 0 when that track really hangs off ~/dev/<handle>/.git · 1 and the reason on stdout
  # THE ONE COPY OF THIS RULE. `cc done` asks for it too (core/bin/cc: member_gitdir → `cc-checkpoint gitdir`), so the
  # host has one wall and one message in front of every git it runs in a member's tree.
  # A workspace track's gitlink and the admin dir behind it are written from INSIDE the boundary, so `.git` can name a
  # git dir of the MEMBER's, whose config carries core.fsmonitor or an `ext::sh -c …` remote — code host-side git runs
  # as the owner, hooksPath pin or not (review-156c). Nothing but this rev-parse touches the worktree until its common
  # dir is the workspace's own; once it is, the config the remotes come from is ~/dev/<handle>/.git/config, which
  # cc-sandbox holds read-only inside the boundary, so what it says is the host's word and not the member's.
  local main gcd nh=(-c core.hooksPath=/dev/null)
  [ -f "$HOME/dev/$1/.cc/member-workspace" ] || return 0   # an ordinary repo on the box always passes
  main=$(git "${nh[@]}" -C "$HOME/dev/$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$HOME/dev/$1/.git")
  gcd=$(git "${nh[@]}" -C "$2" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
  [ "$gcd" = "$main" ] && return 0
  echo "refusing to run git in $2 — its .git resolves to ${gcd:-nothing}, not $main: a member workspace's track hangs off ~/dev/$1/.git or nothing runs in it"; return 1; }
push_keys(){   # $1 remote → the url_key of every place `git push $1` writes to, sorted: its pushurls, or its url when it has none
  local u; git remote get-url --push --all "$1" 2>/dev/null | while IFS= read -r u; do url_key "$u"; done | LC_ALL=C sort -u; }
own_remote_ok(){   # the remote named after the track may be pushed to only if it is origin's repository (url_key, so .git, a
  # trailing / or the scp form do not make it another) or there is no origin to contradict it. Its fetch url AND every
  # push destination must be origin's: a matching url with a pushurl elsewhere, or a second pushurl elsewhere, still
  # sends the branch to another repository (review of #1031). A track-named remote that differs is not taken, host or
  # sandbox: delivery goes to origin, and ONE stderr line names the remote and its destinations, once per distinct pair.
  local ou tu tp op msg; tu=$(git remote get-url "$WSTRACK" 2>/dev/null) || return 0
  ou=$(git remote get-url origin 2>/dev/null) || return 0
  tp=$(push_keys "$WSTRACK"); op=$(push_keys origin)
  [ "$(url_key "$tu")" = "$(url_key "$ou")" ] && [ "$tp" = "$op" ] && return 0
  [ "${1:-}" = quiet ] && return 1
  # Each destination by its url_key, never as written: a url can carry a token, and this line is kept and printed.
  msg="cc-checkpoint: remote $WSTRACK ($(paste -sd' ' <<<"$tp")) is not origin's repository ($(paste -sd' ' <<<"$op")): delivering to origin"
  # SAID ONCE, not every turn: this runs on the Stop hook and the five-minute sweep for as long as the remote exists,
  # so the line is kept in .cc/own-remote.said and only a different remote or url says it again (as push_rejected).
  [ -n "$ST" ] && [ "$(cat "$ST/own-remote.said" 2>/dev/null)" = "$msg" ] && return 1
  [ -n "$ST" ] && printf '%s\n' "$msg" > "$ST/own-remote.said" 2>/dev/null
  echo "$msg" >&2
  return 1; }
bound_remote(){   # → the remote the HOST bound this workspace track to, on stdout.  1 = none (or one that is not there)
  # Read from ~/dev/<handle>/.git/config BY PATH and nowhere else: that file is the host's (cc-sandbox binds it read-only
  # into the member's boundary), while the worktree's own config.worktree and .cc/track are the member's to write. Only
  # a binding names the remote, never the track's name alone, so a member cannot reach another project's repository
  # by calling a track after it (review of #965). Set by `cc-checkpoint bind` or cc-gh-token's wire().
  local cfg="$HOME/dev/$WSREPO/.git/config" r
  [ -f "$cfg" ] && [ ! -L "$cfg" ] || return 1
  r=$(git config --file "$cfg" --get "cc-track.$WSTRACK.remote" 2>/dev/null) || return 1
  case "$r" in ''|-*|*[!A-Za-z0-9._-]*) return 1 ;; esac
  git remote get-url "$r" >/dev/null 2>&1 || return 1
  printf '%s\n' "$r"; }
bind_track(){   # $1 handle · $2 track, or --wired · $3 remote (default: the track's name).  The host binds a workspace track to its project's remote
  local h="${1:-}" t="${2:-}" r="${3:-${2:-}}" d cfg ou k u o f n=0
  if [ "$t" = --wired ]; then set -- "$h"; else set -- "$h" "$t" "$r"; fi
  for f; do case "$f" in ''|-*|.*|*[!A-Za-z0-9._-]*) echo "cc-checkpoint bind: <handle>, <track> and <remote> are plain names" >&2; return 1 ;; esac; done
  [ "${CC_MEMBER_SANDBOX:-}" != 1 ] || { echo "cc-checkpoint bind: the host binds a track, never a session inside a workspace's boundary" >&2; return 1; }
  d="$HOME/dev/$h"; cfg="$d/.git/config"
  [ -f "$d/.cc/member-workspace" ] || { echo "cc-checkpoint bind: ~/dev/$h is not a member workspace" >&2; return 1; }
  [ -f "$cfg" ] && [ ! -L "$cfg" ] || { echo "cc-checkpoint bind: ~/dev/$h has no .git/config of its own" >&2; return 1; }
  # Each confirmation names the repository by its url_key, never the url as written: a url can carry a token, and
  # this line is printed (review of #1137).
  if [ "$t" != --wired ]; then
    u=$(git config --file "$cfg" --get "remote.$r.url" 2>/dev/null) || { echo "cc-checkpoint bind: ~/dev/$h has no remote '$r' — wire it first (cc-gh-token create $h <name>)" >&2; return 1; }
    git config --file "$cfg" "cc-track.$t.remote" "$r" || return 1
    echo "cc-checkpoint bind: track $t of $h delivers to $r ($(url_key "$u"))"; return 0
  fi
  # --wired: THE PROJECTS WIRED BEFORE TRACKS WERE BOUND, which still deliver to origin. cc-gh-token's wire() names a
  # project's remote after its repository, so that shape is the one taken: a remote but origin, named after its own
  # repository, and not origin's repository. A remote named otherwise (a project's mirror) or origin's repository
  # under another name (a task's alias) is no project of its own and stays unbound. Read by path, like bound_remote.
  ou=$(git config --file "$cfg" --get remote.origin.url 2>/dev/null) || ou=''
  while read -r k u; do
    o=${k#remote.}; o=${o%.url}
    [ "$o" != origin ] || continue
    case "$o" in -*|.*|*[!A-Za-z0-9._-]*) continue ;; esac
    [ -z "$ou" ] || [ "$(url_key "$u")" != "$(url_key "$ou")" ] || continue
    f=${u%/}; f=${f%.git}; f=${f##*/}; f=${f##*:}
    [ "${f,,}" = "${o,,}" ] || continue
    git config --file "$cfg" --get "cc-track.$o.remote" >/dev/null 2>&1 && continue   # the host's earlier word stands
    git config --file "$cfg" "cc-track.$o.remote" "$o" || return 1
    echo "cc-checkpoint bind: track $o of $h delivers to $o ($(url_key "$u"))"; n=$((n+1))
  done < <(git config --file "$cfg" --get-regexp '^remote\..*\.url$' 2>/dev/null)
  [ "$n" -gt 0 ] || echo "cc-checkpoint bind: nothing in $h left to bind"
  return 0; }
mirror_remote(){   # cwd = worktree root, $WSTRACK set → the project's mirror remote on stdout, or 1 when there is none.
  # It is the remote named after the track — the owner's binding, in ~/dev/<h>/.git/config, which the member cannot
  # write — when origin is there to take the delivery and the two are not one repository (own_remote_ok). Never from
  # inside the member's boundary, which has no credential and pushes to origin or nothing.
  [ "${CC_MEMBER_SANDBOX:-}" = 1 ] && return 1
  [ -n "$WSTRACK" ] && git remote get-url "$WSTRACK" >/dev/null 2>&1 && git remote get-url origin >/dev/null 2>&1 || return 1
  own_remote_ok quiet && return 1
  printf '%s\n' "$WSTRACK"; }
mirror_push(){   # $1 = the branch just delivered to $remote, cwd = worktree root, $ST set.  Always 0: the delivery already happened.
  # Brief: "also push, fast-forward only, to a worktree's project remote when one is configured for that track".
  # Only a member workspace's project delivered to origin has one; a commit already mirrored is not pushed again.
  local mr head err why
  [ -n "$workspace" ] && [ "$remote" = origin ] || return 0
  mr=$(mirror_remote) || return 0
  head=$(git rev-parse -q --verify "refs/heads/$1" 2>/dev/null) || return 0
  [ "$(cat "$ST/mirrored" 2>/dev/null)" = "$head" ] && return 0
  local -a c=(); mapfile -t c < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$mr" 2>/dev/null)" "$workspace" 2>/dev/null)
  # No `+` and no lease on the refspec: git refuses anything but a fast-forward (or a create), which is the rule.
  if err=$(git_unattended "${c[@]}" push -q "$mr" "refs/heads/$1:refs/heads/$1" 2>&1); then
    printf '%s\n' "$head" > "$ST/mirrored"; rm -f "$ST/mirror.err" "$ST/mirror.refused"; return 0; fi
  why=$(tr '\n' ' ' <<<"$err" | no_userinfo | cut -c1-200); [ -n "$why" ] || why="the push to $mr did not finish within ${PUSH_TIMEOUT}s"
  if grep -q '\[rejected\]\|\[remote rejected\]' <<<"$err"; then   # a refusal: no retry moves it until a person looks or a new commit lands
    [ "$(cut -d' ' -f1 "$ST/mirror.refused" 2>/dev/null)" = "$head" ] \
      || "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $1 not mirrored to $mr at ${head:0:7} — $mr refused it and nothing was forced (a mirror takes fast-forwards only): $why" >/dev/null 2>&1
    printf '%s %s\n' "$head" "$why" > "$ST/mirror.refused"; rm -f "$ST/mirror.err"
  else printf '%s %s\n' "$head" "$why" > "$ST/mirror.err"; fi   # no network, no credential, the bound: the next push or sweep tick tries again
  return 0; }
pick_remote(){   # cwd = worktree root ($root).  0 there is somewhere to push · 1 there is not
  local url r
  # A MEMBER WORKSPACE FIRST, and only then that workspace's own rules: the track-named remote below belongs
  # to a workspace project, not to every repo on the box, and asking for it first applied it to all of them
  # (review of #214). The path, never .cc/track — the header says why.
  if path_ids "$root" && [ -f "$HOME/dev/$WSREPO/.cc/member-workspace" ]; then
    workspace="$WSREPO"   # so the token is minted for this workspace and opens no other member's repository
    # INSIDE THE WORKSPACE'S BOUNDARY (CC_MEMBER_SANDBOX=1: the member's own `cc done`, run by its loop) nothing is
    # created and no remote named after an UNBOUND track is pushed to (a member's track name once chose another project's
    # repository, review of #965). What is left is `origin`. A remote named after the track that points anywhere
    # else (its url or any push destination, own_remote_ok) is not taken here OR on the host: the track delivers to
    # origin, the same answer both sides give. The one thing "nowhere to push" still means in here is a workspace
    # with no origin, which that `cc done` reports as undelivered for the host to finish (it may create one).
    # A TRACK IS USUALLY A TASK ON THE WORKSPACE'S ONE PROJECT, not a project of its own: the #965 cut also wanted
    # origin's URL to END in the track's name, which no task track's does, so every finished track in two workspaces
    # stopped undelivered and the host's `cc done` then made a repository for it (2026-10-05).
    # A TRACK THE HOST BOUND goes to its bound remote, in here and out there alike. Without this a project wired with
    # a remote of its own pushed to origin (another project's repository) and the eviction below then deleted its
    # branch from its own repository, closing the PR there (a member project, 2026-10-12).
    if r=$(bound_remote); then remote="$r"; return 0; fi
    own_remote_ok || true   # says (stderr, once) when a track-named remote contradicts origin; host and sandbox both then use origin
    if [ "${CC_MEMBER_SANDBOX:-}" = 1 ]; then
      git remote get-url origin >/dev/null 2>&1 || return 1
      remote=origin; return 0; fi
    git remote get-url "$WSTRACK" >/dev/null 2>&1 && own_remote_ok quiet && { remote="$WSTRACK"; return 0; }   # the project's own repository
    # A workspace's FIRST repository is wired up as its `origin` (cc-gh-token create), and ANY OTHER TRACK OF A
    # WORKSPACE THAT HAS AN ORIGIN GOES THERE too. "Each project gets its own GitHub repo"
    # (owner, 2026-09-03) once made one here for every track with no remote of its own, even where the workspace had
    # an origin — but a track is mostly a task on the workspace's project, and that rule put a finished task's whole
    # history into a new private repository named after the task, with its PR there and not on the project's
    # (2026-10-05). A track that IS a separate project is bound by a remote named after it (above), which is how
    # every such project is wired; nothing here guesses one from the name.
    git remote get-url origin >/dev/null 2>&1 && { remote=origin; return 0; }
    # A WORKSPACE WITH NO REMOTE AT ALL has nowhere else to go, so its first project gets a repository made for it.
    # A reason it could not REPLACES the last one, in a file of its own: this runs every turn until the project
    # has a repository, so appending would grow for ever on a box with no app — and push.err belongs to the push.
    # …BUT NEVER FROM A TIMER. `--sweep` sets CC_CHECKPOINT_NO_CREATE, because unattended this line would put a
    # private repository in the owner's org every five minutes, under a name the MEMBER chose — and naming a
    # repository in his org is an org-admin action he reserves to himself (review of #214, header above; review of
    # #225). A project with none is left for `cc done` or the next owner-present run, which still makes it.
    [ -z "${CC_CHECKPOINT_NO_CREATE:-}" ] || return 1
    if url=$("$BIN/cc-gh-token" create "$WSREPO" "$WSTRACK" 2>"$ST/create.err.tmp"); then
      rm -f "$ST/create.err.tmp" "$ST/create.err"
      remote="$WSTRACK"; git remote get-url "$WSTRACK" >/dev/null 2>&1 || remote=origin   # origin: the workspace had no remote at all, so this is its first
      git remote get-url "$remote" >/dev/null 2>&1 || return 1
      : > "$ST/base-seed"   # brand new and empty: the next push sends the base FIRST, so its default is the base and not this track
      "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: created $url for this project — pushing there from now on" >/dev/null 2>&1
      return 0
    fi
    mv -f "$ST/create.err.tmp" "$ST/create.err" 2>/dev/null
    # Nothing could be created (no app, a name already someone else's, no network), and with no origin there is
    # NOWHERE ELSE. Nowhere to push is the honest answer: `cc done` ends on it (the branch is the delivery), the
    # reason is in .cc/create.err, and the next turn tries the creation again.
    return 1
  fi
  # Any other track on the box: origin is where it pushed yesterday, so the work reaches GitHub rather than nowhere.
  git remote get-url origin >/dev/null 2>&1
}
readme_text(){   # the front page a project's repository opens on, for the project named in $1. ONE copy of the
  # words, because two branches carry this file: the project's track (project_readme) and the base branch pushed
  # into the repository made for it (seed_head). Different words there and the project's first PR is a conflict in
  # the one file nobody wrote.
  printf '# %s\n\nA project of the %s workspace, and the only project in this repository.\nIts work is the `track/%s` branch.\n' "$1" "$WSREPO" "$1"; }
readme_is_stub(){   # 0 = the README on stdin is one THIS FILE wrote, whoever it names.  The WHOLE file is compared
  # against the template rebuilt from its own heading, so one word changed anywhere makes it somebody's words again.
  local t h; t=$(cat); h=$(printf '%s\n' "$t" | head -1)
  case "$h" in '# '?*) h=${h#\# } ;; *) return 1 ;; esac
  [ "$t" = "$(readme_text "$h")" ]; }
project_readme(){   # cwd = worktree root.  Always 0: this is one file, and never anyone's own words.
  # "he opened [a project's repository] and found the workspace — its README ('scratch project for trying the
  # box out'), with no [project] code" (owner, 2026-09-04). A workspace is one git repo and a project is a
  # BRANCH of it, so a project's branch is cut from the workspace's default branch and carries the workspace's
  # README into the repository made for that project — whose front page then describes the workspace.
  # THE HEADING IS THE WHOLE TEST. While README.md still opens with the WORKSPACE's own name, nobody has
  # written a word of it for this project and it is replaced by one that names the project. Retitle it — the
  # member, their session, anyone, one word — and nothing here ever touches it again.
  # The path, never .cc/track, for the reason the header gives: that file is the member's word.
  path_ids "$root" || return 0
  [ -f "$HOME/dev/$WSREPO/.cc/member-workspace" ] || return 0
  # A TASK ON THE WORKSPACE'S PROJECT is not a project: it delivers to origin (pick_remote), so the README there is the
  # project's, not one to retitle. WHERE THE TRACK DELIVERS decides it, never which remotes exist: with an origin,
  # pick_remote takes the track-named remote only when it IS origin's repository, and one pointing elsewhere is
  # passed over for origin, so its inherited README rides onto origin's PR and must stay the project's (review of
  # #1031). So with an origin the track is a project only when origin is named after it; with none, it delivers to a
  # repository of its own (bound or made) and is one.
  local ou; ou=$(git remote get-url origin 2>/dev/null)
  if [ -n "$ou" ]; then case "$ou" in *"/$WSTRACK"|*"/$WSTRACK.git") ;; *) return 0 ;; esac; fi
  git ls-files --error-unmatch README.md >/dev/null 2>&1 || return 0   # inherited from the branch, not a file this turn wrote
  git diff --quiet HEAD -- README.md 2>/dev/null || return 0            # and untouched this turn: words somebody wrote are theirs (review of #217)
  # A STUB THIS FILE WROTE is nobody's words whichever project it names, so where it came from is not asked. A
  # track cut from a sibling project's repository inherits that sibling's stub — the base branch there carries one
  # now (seed_head) — and the workspace's own name is no longer in the heading for the test below to catch.
  if [ -f README.md ] && readme_is_stub < README.md; then
    [ "$(head -1 README.md)" = "# $WSTRACK" ] || readme_text "$WSTRACK" > README.md
    return 0; fi
  # STILL THE FILE THE BRANCH INHERITED: the same blob the workspace's default branch had where this branch was cut
  # from it. Words committed under the old heading on an earlier turn are theirs too, and "clean against HEAD" says
  # nothing about those (review of #217). No default branch to ask, no merge-base: leave it.
  local def mb; for def in main master "$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; do
    [ -n "$def" ] && git rev-parse -q --verify "refs/heads/${def#origin/}" >/dev/null 2>&1 && { def=${def#origin/}; break; }
    [ -n "$def" ] && git rev-parse -q --verify "refs/remotes/$def" >/dev/null 2>&1 && { def="refs/remotes/$def"; break; }; def=""; done
  [ -n "$def" ] || return 0
  mb=$(git merge-base HEAD "$def" 2>/dev/null) || return 0
  [ "$(git rev-parse -q --verify HEAD:README.md 2>/dev/null)" = "$(git rev-parse -q --verify "$mb:README.md" 2>/dev/null)" ] || return 0
  [ -f README.md ] && [ "$(head -1 README.md 2>/dev/null)" = "# $WSREPO" ] || return 0
  readme_text "$WSTRACK" > README.md
  return 0
}
url_key(){   # one repository, however its url is spelled: case, .git, a trailing /, the scheme, the user, the scp form
  local u=${1%/}; u=${u%.git}; u=${u,,}
  u=${u#ssh://}; u=${u#https://}; u=${u#http://}; u=${u#git://}; u=${u#*@}
  case "$u" in *:*/*) u=${u/:/\/} ;; esac   # git@host:org/repo → host/org/repo
  printf '%s\n' "$u"; }
no_userinfo(){   # stdin → stdout with the user and password cut out of every scheme:// url in it. A remote's url can
  # carry a token, and git's own words about a push are kept in .cc and put on the board (security read of #1118).
  sed -E 's#([A-Za-z][A-Za-z0-9+.-]*://)[^/@[:space:]]*@#\1#g'; }
same_key(){   # $1 a url → the line .cc/evict.same remembers it by: a hash of its url_key, so no token is ever kept there
  url_key "$1" | sha256sum | cut -c1-64; }
base_branch(){   # the project's base branch, cwd = worktree root. The board's, and never a track, whoever names it:
  # origin/HEAD is only what a REMOTE calls its default, and for a repository the box made that is the first branch
  # pushed into it. Same rule and same order as cc's default_branch().
  local b; b=$("$BIN/cc-board" base "$WSREPO" 2>/dev/null)
  case "$b" in track/*|'') b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##') ;; esac
  case "$b" in track/*|'') b=main ;; esac
  printf '%s\n' "$b"; }
ident_args(){   # the `git -c` arguments a commit made by this file is authored with: CC_GIT_NAME/CC_GIT_EMAIL from
  # ~/.cc/config (read, not sourced — that file holds tokens), and git's own config where they are unset.
  local n e
  n=$("$BIN/cc-config" get CC_GIT_NAME);  [ -n "$n" ] && printf -- '-c\nuser.name=%s\n' "$n"
  e=$("$BIN/cc-config" get CC_GIT_EMAIL); [ -n "$e" ] && printf -- '-c\nuser.email=%s\n' "$e"
  return 0; }
seed_head(){   # $1 = the base branch's tip → the commit the new repository's base branch is created at.
  # AND IT OPENS ON THE PROJECT'S README, NOT THE WORKSPACE'S. The base is the WORKSPACE's branch and carries the
  # workspace's README; the retitle (project_readme) only ever runs on the track. So the repository made for a
  # project opened on a page about the workspace and stayed there until the project's first PR merged — which for a
  # living project may be never. The base is therefore pushed with the project's README already on it: one commit,
  # built with plumbing, and REFS/HEADS/<BASE> NEVER MOVES — that is one branch shared by every project in the
  # workspace, and a commit on it here would follow the next project into its repository.
  # THE COMMIT IT IS SEEDED WITH IS ON THE TRACK. A commit only the base has changes README.md against the merge
  # base, so the moment the session writes its own README the project's FIRST PR conflicts in the one file nobody
  # wrote, which is what this seeding was added to prevent (review of #238). So it is merged into the track
  # before it is pushed, and the base is then an ANCESTOR of the branch whose PR merges into it. The merge keeps
  # the track's tree to the letter: both sides carry the same README blob and the seed touches nothing else, so
  # no file on the branch moves and nothing is rewritten. If it cannot be put there, the base goes unseeded.
  # ONLY A STUB THIS FILE WROTE. A README somebody wrote is theirs, and copying it onto a branch they did not write
  # is not this file's to do; their words reach the base the ordinary way, when the project's first PR merges.
  # NOT WHEN THIS REPOSITORY IS THE WORKSPACE'S OWN ORIGIN. A workspace with no remote of its own has its FIRST
  # project's repository wired up as `origin` (cc-gh-token create), and that base branch is then the one
  # ~/dev/<workspace> itself sits on, pushes and pulls. A commit there the workspace does not have turns its
  # `git push origin <base>` into a non-fast-forward rejection, and the pull that clears it retitles the WORKSPACE's
  # README with a project's — words written for the member, which nothing here would put back. So that one
  # repository opens on the workspace until the project's first PR merges. Every later project of the workspace has
  # a repository of its own and is seeded.
  local tip="$1" want tree new idx prev head branch merged; local -a ident=()
  [ "$(url_key "$(git remote get-url "$remote" 2>/dev/null)")" = "$(url_key "$(git remote get-url origin 2>/dev/null)")" ] \
    && { printf '%s\n' "$tip"; return 0; }
  # NOT WHEN THE BASE HAS MOVED ON SINCE THE TRACK WAS CUT. The seed goes onto the track as a merge carrying the
  # TRACK's tree — "take this side entire" — which is exact while the track holds everything refs/heads/<base>
  # holds, and a silent revert of everything the base gained after the cut when it does not: that branch is shared
  # by the whole workspace and moves without this track, so a later commit on it would be merged away here and
  # then leave the new repository's base the moment the project's first PR landed (review of #238). Merging it in
  # for real is this file resolving somebody's branch for them, which it does not do. So that base goes unseeded:
  # the repository opens on the workspace's README until the first PR merges — where it was before any of this.
  git merge-base --is-ancestor "$tip" HEAD 2>/dev/null || { printf '%s\n' "$tip"; return 0; }
  want=$(git rev-parse -q --verify HEAD:README.md 2>/dev/null)
  [ -n "$want" ] && [ "$want" != "$(git rev-parse -q --verify "$tip:README.md" 2>/dev/null)" ] || { printf '%s\n' "$tip"; return 0; }
  git cat-file -p "$want" 2>/dev/null | readme_is_stub || { printf '%s\n' "$tip"; return 0; }
  # A push that never reached the remote keeps the marker and comes back next turn, so the commit already merged
  # into the track is reused: rebuilt from scratch it is a new sha, and a repository unreachable for a week would
  # collect one merge a turn. Reused only while it is still that commit — on the track, on this base tip, this README.
  prev=$(cat "$ST/base-seed" 2>/dev/null)
  if [ -n "$prev" ] && [ "$(git rev-parse -q --verify "$prev^" 2>/dev/null)" = "$tip" ] \
     && [ "$(git rev-parse -q --verify "$prev:README.md" 2>/dev/null)" = "$want" ] \
     && git merge-base --is-ancestor "$prev" HEAD 2>/dev/null; then printf '%s\n' "$prev"; return 0; fi
  idx="$ST/seed.idx"; rm -f "$idx"
  GIT_INDEX_FILE="$idx" git read-tree "$tip" 2>/dev/null \
    && GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$want,README.md" 2>/dev/null \
    && tree=$(GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null)
  rm -f "$idx"
  mapfile -t ident < <(ident_args)
  # No identity anywhere, no tree: push the base as it is. A front page one turn late beats a repository with none.
  [ -n "${tree:-}" ] && new=$(git "${ident[@]}" commit-tree "$tree" -p "$tip" -m "README: this repository is the $WSTRACK project" 2>/dev/null)
  [ -n "${new:-}" ] || { printf '%s\n' "$tip"; return 0; }
  # …and onto the track, as a merge carrying the track's own tree. HEAD is the track's branch here — the push path
  # and the hook both refuse to go on when it is not — and the ref only ever moves forward: HEAD is the first parent.
  branch=$(git symbolic-ref -q --short HEAD 2>/dev/null); head=$(git rev-parse -q --verify HEAD 2>/dev/null)
  [ -n "$branch" ] && [ -n "$head" ] \
    && merged=$(git "${ident[@]}" commit-tree "$(git rev-parse -q --verify "$head^{tree}")" -p "$head" -p "$new" \
        -m "merge the base branch this project's repository was seeded with" 2>/dev/null) \
    && git update-ref -m 'cc-checkpoint: the base this repository is seeded with' "refs/heads/$branch" "$merged" "$head" 2>/dev/null \
    || { printf '%s\n' "$tip"; return 0; }   # not on the track, so not pushed as the base: a front page is not worth a conflict
  printf '%s\n' "$new" > "$ST/base-seed"   # …and it is this commit again next turn if the push does not land
  printf '%s\n' "$new"; }
seed_base(){   # cwd = worktree root, $remote and $cred from lease_push.  Always 0: seeding is not the push.
  # The header's "AND IT OPENS ON THE PROJECT'S BASE": a repository created here is empty, GitHub gives it whichever
  # branch lands first, and the track landing first is the whole bug. So the base goes first, and if that still did
  # not make it the default it is asked for by name. Once, at creation — a repository the owner bound himself has no
  # marker and is never touched. Not reaching the remote at all keeps the marker: the next turn tries again, and the
  # track push in this one is failing for the same reason anyway.
  local base def err tip send
  [ -n "$workspace" ] && [ -f "$ST/base-seed" ] || return 0
  base=$(base_branch)
  # A base this checkout does not have cannot be pushed. That used to drop the marker and say nothing at all, so
  # the repository went on opening on the track and no later turn tried again: the board hears it, once.
  tip=$(git rev-parse -q --verify "refs/heads/$base" 2>/dev/null) || {
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: this project's repository was made, but its base branch '$base' is not in this checkout — nothing was seeded, so it opens on whichever branch landed first" >/dev/null 2>&1
    spend_seed; return 0; }
  send=$(seed_head "$tip"); [ -n "$send" ] || send="$tip"   # an EMPTY source in a refspec DELETES the branch: never that
  if ! err=$(git_unattended "${cred[@]}" push -q "$remote" "$send:refs/heads/$base" 2>&1); then
    grep -qE 'rejected|non-fast-forward|already exists' <<<"$err" || return 0   # could not reach it: try again next turn
  fi
  # …BUT THE DEFAULT BRANCH IS NEVER MOVED FROM A TIMER, the same flag `--sweep` sets for pick_remote:
  # `cc-gh-token default` is an org-admin action and the sweep pushes and NOTHING ELSE (header above). The base
  # push above is a PLAIN push and happens from a timer too — a repository that was created for a project whose
  # push never reached it is still empty, and letting the track land there first is bug #218 all over again, with
  # nobody present to notice. The marker is KEPT here, so the next owner-present run still asks GitHub by name
  # (review of #225).
  [ -z "${CC_CHECKPOINT_NO_CREATE:-}" ] || return 0
  def=$(git_unattended "${cred[@]}" ls-remote --symref "$remote" HEAD 2>/dev/null | sed -n 's#^ref: refs/heads/\([^[:space:]]*\).*$#\1#p' | head -1)
  if [ "$def" != "$base" ] && ! "$BIN/cc-gh-token" default "$workspace" "$WSTRACK" "$base" >/dev/null 2>&1; then
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $base is in this project's repository but its default branch is still ${def:-whichever branch arrived first} — 'cc-gh-token default $WSREPO $WSTRACK $base' sets it" >/dev/null 2>&1
  fi
  spend_seed; return 0; }
evict_elsewhere(){   # $1 = the branch just pushed to $remote, cwd = worktree root.  Always 0: this is tidying.
  # EACH PROJECT'S REPOSITORY HOLDS THAT PROJECT AND NO OTHER. A workspace is one git repo whose projects are
  # branches, so before this every project's branch reached the workspace's first repository too and the
  # repositories differed only by branch: opening one project's repository showed a sibling project's work and
  # none of its own (owner, 2026-09-04, twice). Once a branch is safely in its own repository it is taken out of the
  # others, so a workspace heals itself with nobody present and stays healed.
  # BY URL, NEVER BY REMOTE NAME: the owner binds a project to a repository he already has by adding a remote
  # named after the project, so two remote names are often one repository — and "the other remote" would then
  # be the project's own, deleted out from under it.
  # NOTHING IS LOST AND NO HISTORY IS REWRITTEN: the other repository's tip must be an ancestor of what was
  # just pushed, so every commit it drops is present here and in the project's own repository. A tip that is
  # not, or one whose object this worktree does not have, is left alone and written to .cc/evict.err — a file of
  # its own, replaced each run: push.err means the push FAILED, and a note there after a push that succeeded lit
  # `push!` for ever (review of #217).
  local branch="$1" had_lease="${2:-}" own o url sha name mr
  # …BUT NOT FROM A TIMER. This ends in `git push --delete` against another repository, and the sweep pushes and
  # NOTHING ELSE (header above): a branch removed unattended every five minutes is the one destructive remote
  # action nobody is present for. A workspace still heals itself on the next `cc done` or owner-present turn,
  # which is when a person is there to read the board note (review of #225).
  [ -z "${CC_CHECKPOINT_NO_CREATE:-}" ] || return 0
  [ -n "$workspace" ] || return 0   # only a member workspace's project has sibling projects to contaminate
  # …AND ONLY ONCE THE HOST HAS MANAGED THIS TRACK BEFORE. With no host lease at the start of this run the track's
  # evict.same (the self-alias memory) may be orphaned in <wt>/.cc, which the host will not read — so deleting here
  # would re-run the delete+repush over a self-alias and close its open PR, the #217 hole (round 9 of #225). The
  # first push records the lease and heals nothing; the next owner-present run, holding a lease of its own, does.
  [ -n "$had_lease" ] || return 0
  # BY PUSH DESTINATION, NEVER BY FETCH URL: `git push --delete` goes to a remote's pushurl, and its url can be a
  # different repository altogether. Compared by url, a remote whose url was elsewhere let the project's own
  # repository (a pushurl of $remote) or its mirror's lose the branch, and a probe of the url asked a repository
  # the delete never reaches (lander, #1118). So every decision below — who is own, who is the mirror, what is
  # probed, where the delete goes, what evict.same remembers — is made per push url (`get-url --push --all`), and
  # the probe and the delete name that url itself, so they cannot ask one repository and delete from another.
  # …AND ONLY A URL GIT DOES NOT REWRITE AGAIN. get-url has applied insteadOf/pushInsteadOf once already, and a
  # url handed back to git is rewritten a second time: `push` by pushInsteadOf, `ls-remote` by insteadOf only. With
  # two chained rules the probe asked one repository and the delete landed on the project's own, and the self-heal
  # re-push closed its open PR (security read of #1118). So a sibling's url is taken only when both of them land on
  # it unchanged (ls-remote --get-url, and the "To" line of a dry-run of the very delete), and the project's own urls,
  # which the self-heal asks with ls-remote, only when ls-remote lands on them unchanged; anything else is said.
  # The "To" line is compared by url_key: git prints it without the user or password, so `git@host:org/x` or a url
  # carrying a token never equalled it and an ssh sibling was never cleaned again. And every line said here names a
  # url only by its url_key, never as written: a url can carry a token, and these lines go onto the board (security
  # read of #1118, round 3).
  own=$(push_keys "$remote"); [ -n "$own" ] || return 0
  local mk='' pu ok mok to bad=''; mr=$(mirror_remote) && mk=$(push_keys "$mr")
  local -a ownu=() rem=() miru=() mc=() mhad=(); mapfile -t ownu < <(git remote get-url --push --all "$remote" 2>/dev/null)
  [ -z "$mk" ] || { mapfile -t miru < <(git remote get-url --push --all "$mr" 2>/dev/null)
    mapfile -t mc < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$mr" 2>/dev/null)" "$workspace" 2>/dev/null); }
  rm -f "$ST/evict.err.tmp"
  # NEVER THE TRACK'S OWN DELIVERY. The repository its PR is on (the board's pr url) and the remote named after the
  # track — its project's own repository, bound or not — are skipped: deleting the branch there closes the very PR
  # this track is landing through, which is what closed a member project's PR three times on 2026-10-12 while the
  # push went to origin. The board is the member's to write as much as ours, so it can only make this delete LESS.
  local prkey; prkey=$("$BIN/cc-board" get "$WSREPO" "$WSTRACK" pr 2>/dev/null | head -1)
  prkey=$(sed -nE 's#^(https?://[^/]+/[^/]+/[^/]+)/pull/[0-9]+.*#\1#p' <<<"$prkey"); prkey=${prkey:+$(url_key "$prkey")}   # the whole url: one url_key rule for both sides
  # evict.same REMEMBERS A HASH OF THE URL_KEY, never the url, which can carry a token (security read of #1118, round
  # 3). A file written before that holds raw urls: each such line is rewritten to its hash here, so it is still known.
  if [ -s "$ST/evict.same" ] && grep -qvxE '[0-9a-f]{64}' "$ST/evict.same"; then
    local sl sk; sk=$(while IFS= read -r sl; do
      if [[ $sl =~ ^[0-9a-f]{64}$ ]]; then printf '%s\n' "$sl"; elif [ -n "$sl" ]; then same_key "$sl"; fi
    done < "$ST/evict.same" | LC_ALL=C sort -u)
    printf '%s\n' "$sk" > "$ST/evict.same"; fi
  # A URL BEGINNING WITH '-' IS AN OPTION to git, not a url: `--upload-pack=<cmd>` as a pushurl ran <cmd> as the
  # owner the moment it was probed (security read of #1118). Every git call below that takes a url puts `--` before
  # it, and a sibling's that begins with '-' is not handed to git at all.
  for pu in "${ownu[@]}" "${miru[@]}"; do [ "$(git ls-remote --get-url -- "$pu" 2>/dev/null)" = "$pu" ] || bad="$pu"; done
  if [ -n "$bad" ]; then
    printf '%s %s\n' "$(date -u +%FT%TZ)" "nothing was taken out of any other repository: $remote pushes to $(url_key "$bad"), which git rewrites to another url when it reads it, so whether a delete took the branch from this project could not be asked. Write that url as git ends up using it." >> "$ST/evict.err.tmp"
  else mapfile -t rem < <(git remote); fi
  for o in "${rem[@]}"; do
   while IFS= read -r url; do
    [ -n "$url" ] || continue
    [ "$o" != "$WSTRACK" ] || continue
    [ -z "$prkey" ] || [ "$(url_key "$url")" != "$prkey" ] || continue
    case $url in -*) printf '%s %s\n' "$(date -u +%FT%TZ)" "$o has a push url beginning with '-', which git would read as an option — left alone. Fix that remote by hand." >> "$ST/evict.err.tmp"; continue;; esac
    grep -qxF -- "$(url_key "$url")" <<<"$own" && continue
    [ -z "$mk" ] || ! grep -qxF -- "$(url_key "$url")" <<<"$mk" || continue   # the project's own mirror (mirror_push) holds this branch by design
    grep -qxF -- "$(same_key "$url")" "$ST/evict.same" 2>/dev/null && continue   # known to be this project's own repository under another spelling: never cycled again
    if [ "$(git ls-remote --get-url -- "$url" 2>/dev/null)" != "$url" ]; then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o pushes to $(url_key "$url"), which git rewrites to another url when it reads it — left alone. Write that url as git ends up using it." >> "$ST/evict.err.tmp"
      continue; fi
    local -a c=(); mapfile -t c < <("$BIN/cc-gh-token" gitargs "$url" "$workspace" 2>/dev/null)
    sha=$(git_unattended "${c[@]}" ls-remote --heads -- "$url" "refs/heads/$branch" 2>/dev/null | awk 'NR==1{print $1}')
    [ -n "$sha" ] || continue   # it does not have this branch, or it could not be asked: nothing to remove either way
    if ! git merge-base --is-ancestor "$sha" "$branch" 2>/dev/null; then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o still holds $branch at $sha, which is not in this branch — left alone. This project pushes to $remote; move or delete that branch by hand." >> "$ST/evict.err.tmp"
      continue; fi
    name=$(url_key "$url"); name=${name##*/}   # the normalised url, so a trailing / does not leave the note naming nothing
    to=$(git_unattended "${c[@]}" push --dry-run --porcelain --delete -- "$url" "refs/heads/$branch" 2>/dev/null | sed -n 's/^To //p' | head -1)
    [ -n "$to" ] || continue   # the dry run could not be made: where the delete would go is unknown, so nothing is deleted
    if [ "$(url_key "$to")" != "$(url_key "$url")" ]; then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o pushes to $(url_key "$url"), but a push there is rewritten to $(url_key "$to") — left alone, since that is not where the branch was found. Write that url as git ends up using it." >> "$ST/evict.err.tmp"
      continue; fi
    # THE MIRROR IS ASKED TOO (security read of #1118): a sibling naming it under a spelling url_key cannot unify
    # takes its branch, and mirror_push never puts back a head .cc/mirrored already records. Only a mirror url that
    # holds the branch now is asked after, so a mirror that never got it does not make every sibling its alias.
    mhad=(); for pu in "${miru[@]}"; do
      still=$(git_unattended "${mc[@]}" ls-remote --heads -- "$pu" "refs/heads/$branch" 2>/dev/null) && [ -n "$still" ] && mhad+=("$pu"); done
    # A delete the other repository REFUSES — GitHub refuses a repository's default branch, and an empty repository
    # takes its default from the first branch pushed into it, which can be the sibling's — is the case that leaves
    # the contamination in place, so it is said, not swallowed (review of #217).
    if ! err=$(git_unattended "${c[@]}" push -q --delete -- "$url" "refs/heads/$branch" 2>&1); then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o still holds $branch — the delete was refused: $(tr '\n' ' ' <<<"$err" | no_userinfo | cut -c1-160). Delete or retarget it by hand; a repository's default branch cannot be deleted, so point that repository's default at its own project's branch first." >> "$ST/evict.err.tmp"
      continue; fi
    # A URL IS NOT A REPOSITORY'S IDENTITY. The same repository under a spelling url_key cannot unify (ssh and
    # https, a symlink) has just had its branch deleted out from under it — so ask the project's own remote
    # whether the branch is still there, and if the answer is that it is gone, put it back and say so (review of
    # #217). Asked where $remote PUSHES, every one of them: that is where the branch was put and where a delete
    # through an alias took it from. An ask that failed says nothing either way and changes nothing.
    ok=1; mok=1
    for pu in "${ownu[@]}"; do
      still=$(git_unattended "${cred[@]}" ls-remote --heads -- "$pu" "refs/heads/$branch" 2>/dev/null) && [ -z "$still" ] && ok=''
    done
    for pu in "${mhad[@]}"; do
      still=$(git_unattended "${mc[@]}" ls-remote --heads -- "$pu" "refs/heads/$branch" 2>/dev/null) && [ -z "$still" ] && mok=''
    done
    if [ -z "$ok" ] || [ -z "$mok" ]; then
      [ -n "$ok" ] || git_unattended "${cred[@]}" push -q -u "$remote" "$branch" 2>/dev/null
      [ -n "$mok" ] || { rm -f "$ST/mirrored"; mirror_push "$branch"; }   # the record says it is there, and it is not
      same_key "$url" >> "$ST/evict.same"   # remembered: deleting and restoring it every turn would close any open PR on the branch (review of #217)
      if [ -z "$ok" ]; then
        printf '%s %s\n' "$(date -u +%FT%TZ)" "$o is this project's own repository under another spelling — its branch was put back and that remote is skipped from now on. Keep one remote for it." >> "$ST/evict.err.tmp"
      else
        printf '%s %s\n' "$(date -u +%FT%TZ)" "$o is this project's mirror $mr under another spelling — its branch was put back there and that remote is skipped from now on. Keep one remote for it." >> "$ST/evict.err.tmp"
      fi
      continue; fi
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $branch removed from ${name:-$o} — this project's work is in its own repository now, not that one" >/dev/null 2>&1
   done < <(git remote get-url --push --all "$o" 2>/dev/null)
  done
  # The two cases that need a person — a branch left in a sibling repository, a duplicate remote — are heard the
  # way a delete is: on the board, once per change and not every turn (the file carries a timestamp per run, so it
  # is compared without them). Nothing on the box reads evict.err by itself (review of #217).
  if [ -s "$ST/evict.err.tmp" ]; then
    if ! cmp -s <(cut -d' ' -f2- "$ST/evict.err.tmp") <(cut -d' ' -f2- "$ST/evict.err" 2>/dev/null); then
      "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $(cut -d' ' -f2- "$ST/evict.err.tmp" | paste -sd' ' -)" >/dev/null 2>&1; fi
    mv -f "$ST/evict.err.tmp" "$ST/evict.err"
  else rm -f "$ST/evict.err.tmp" "$ST/evict.err"; fi
  return 0
}
lease_push(){   # $1 = branch, cwd = worktree root.  0 pushed · 1 push failed · 2 the lease was refused · 3 no host lease
  local branch="$1" lease prc had_lease=
  # POSITIVE HOST STATE, captured before the push writes any. A member workspace track that predates the move to
  # ~/.cc/push-state has no host lease of its own here (its old state is orphaned in <wt>/.cc, which the host will
  # not read), and neither does one nothing has pushed yet. evict_elsewhere — the one destructive remote action in
  # this file — must fire only when the host has managed this track before, never on that absence: on a pre-move
  # track its evict.same is orphaned too, so re-running the self-alias delete+repush would close an open PR, the
  # very #217 hole (round 9 of #225). So the FIRST push records the lease and evicts nothing; eviction waits for a
  # run where the host already held one.
  # …AND NEVER ONE `adopt` READ OFF THE REMOTE. That lease is a person's reading of another commit, not a record of a
  # push this host made, so the track's evict.same is still orphaned in <wt>/.cc and eviction would re-run the
  # self-alias delete+repush and close an open PR. The push that spends an adopted lease clears the flag (lease_keep),
  # so the one after it evicts like any other.
  [ -e "$ST/pushed" ] && [ ! -e "$ST/adopted" ] && had_lease=1
  # The credential. `cc-gh-token gitargs` prints the `git -c …` arguments that authenticate as this box's
  # GitHub App — and prints NOTHING for a remote the app does not cover, or on a box with no app, so every
  # other push still uses whatever helper ~/.gitconfig gives it. Without this a member project's push has no
  # credential at all and stops on "could not read Username", which is how two finished branches sat unpushed.
  # AND NEVER UNSCOPED IN A MEMBER'S TREE. `gitargs <url> ''` mints the app's whole-org credential; the workspace
  # name that narrows it to that member's repositories comes from path_ids, and a worktree that is NOT at
  # ~/.cc/worktrees/<repo>/<track> — a real worktree a member made inside their own checkout — has none (security
  # review of #225). Inside a member workspace with no scope, nothing is minted and nothing is pushed.
  if [ -z "$workspace" ] && member_tree "$root"; then
    printf '%s %s\n' "$(date -u +%FT%TZ)" "refused: $root is inside a member workspace but is not one of its tracks (~/.cc/worktrees/<workspace>/<project>), so there is no workspace to mint a credential for — refusing to push with an unscoped one" >> "$ST/push.err"
    return 1; fi
  local -a cred=(); mapfile -t cred < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$remote" 2>/dev/null)" "$workspace" 2>/dev/null)
  seed_base   # a repository just made for this project takes its default from the FIRST branch pushed: the base goes ahead of the track
  # Plain push FIRST, and force nothing when it works: a fast-forward never needed a lease. It is also how a
  # branch that has taken the other writer's commit in (git rebase origin/<branch>) clears itself — a stale
  # .cc/pushed would otherwise refuse that branch for ever, and a block nobody can lift is its own outage.
  git_unattended "${cred[@]}" push -q -u "$remote" "$branch" 2>"$ST/push.err.tmp"; prc=$?
  [ "$prc" = 0 ] && { lease_keep "$branch"; evict_elsewhere "$branch" "$had_lease"; mirror_push "$branch"; return 0; }
  bound_hit "$prc" "$ST/push.err.tmp"   # killed at the bound: git said nothing, so the reason is written here
  grep -qE 'non-fast-forward|fetch first' "$ST/push.err.tmp" || { mv "$ST/push.err.tmp" "$ST/push.err"; push_rejected; return 1; }   # not a divergence: a plainly broken push (no network, no permission, the remote refusing it)
  lease=$(cat "$ST/pushed" 2>/dev/null)
  # Nothing recorded yet (a track older than .cc/pushed): the tracking ref is the best account of the remote we
  # have, and one push from here replaces the guess with the real thing.
  # NOT FOR A MEMBER WORKSPACE'S PROJECT. That ref lives in ~/dev/<handle>/.git, which the member writes (cc-sandbox
  # binds .git read-write, config and hooks aside), and any fetch refreshes it to whatever is really on the remote —
  # so leasing against it turns "something else wrote to this branch, a person must look" into a host force-push
  # over that writer's commit, which is the one thing the lease exists to prevent. Removing the worktree drops the
  # recorded lease with it, so this is reachable by hand (security review of #225). With no lease of our own the
  # push is not forced.
  [ -n "$lease" ] || [ -n "$workspace" ] || lease=$(git rev-parse -q --verify "refs/remotes/$remote/$branch" 2>/dev/null)
  # …and a lease this worktree's own hand push has overtaken moves up to what it pushed (lease_refresh) — box tracks only.
  [ -n "$workspace" ] || [ -z "$lease" ] || lease=$(lease_refresh "$branch" "$lease")
  # THE BRANCH WAS DELETED AT THE REMOTE, NOT WRITTEN TO. A landing squash-merges a track's PR and deletes
  # track/<track> at origin, and a session row's seat keeps working on a branch that is no longer there — cc-reconcile
  # deletes it again on every pass while the row sits `merged`, so it goes on disappearing (ece206 and ece207,
  # 2026-09-19/20: 38 h of checkpoints that reached nobody). A push that raced that delete is rejected here, and
  # leasing against a tip the remote no longer has is rejected 'stale info' — which this file would then call
  # "something else wrote to that branch" and stop the track on (lease_refused, STATUS: BLOCKED). It is false: nothing
  # wrote, the ref is gone. So the remote is ASKED what it holds before anything is forced. No ref at all and the push
  # is a CREATE, which can overwrite nothing and needs no lease: push it plain and the work is back under its own
  # name. A remote that still has the branch, or one that did not answer, keeps every guarantee below — this never
  # turns a refusal into a force.
  if [ -n "$lease" ] && remote_gone "$branch"; then
    git_unattended "${cred[@]}" push -q -u "$remote" "$branch" 2>"$ST/push.err.tmp"; prc=$?
    [ "$prc" = 0 ] && { lease_keep "$branch"; evict_elsewhere "$branch" "$had_lease"; mirror_push "$branch"; return 0; }
    bound_hit "$prc" "$ST/push.err.tmp"; mv "$ST/push.err.tmp" "$ST/push.err"; push_rejected; return 1; fi
  if [ -n "$lease" ]; then
    git_unattended "${cred[@]}" push -q -u --force-with-lease="refs/heads/$branch:$lease" "$remote" "$branch" 2>"$ST/push.err.tmp"; prc=$?
    [ "$prc" = 0 ] && { lease_keep "$branch"; evict_elsewhere "$branch" "$had_lease"; mirror_push "$branch"; return 0; }
    bound_hit "$prc" "$ST/push.err.tmp"
    mv "$ST/push.err.tmp" "$ST/push.err"
    grep -qE 'stale info|non-fast-forward|fetch first' "$ST/push.err" && return 2
    push_rejected; return 1; fi
  mv "$ST/push.err.tmp" "$ST/push.err"
  # DIVERGED WITH NO LEASE OF OUR OWN. For the box's own repos the tracking-ref fallback above always gave us one, so
  # this is a member workspace whose ~/.cc/push-state lease is empty. Two shapes reach here and they must part ways:
  #  - A track that predates #225 kept its lease in <wt>/.cc/pushed. Its ~/.cc/push-state is empty on the first tick,
  #    so a since-rebased branch lands here — and calling it "something else wrote" wrongly writes STATUS: BLOCKED and
  #    stops the interactive track this exists to serve (review round 8 of #225). Its own pre-#225 footprint, the
  #    plain file at <wt>/.cc/pushed, is what tells it apart: return 3, reported quietly by both callers. Neither of
  #    them can push it — the branch will never fast-forward and there is nothing safe to lease against — so rc=3 has
  #    ONE exit and it is not another push: `cc-checkpoint adopt <handle> <track>`, where a person reads what the
  #    remote holds and records it. Both messages name it.
  #  - A track nothing has ever pushed, with a real other writer's commit on the remote: no such footprint. return 2,
  #    refused out loud, the same as the box's own repos' "diverged, nothing to lease".
  # ONLY THE FILE'S EXISTENCE is read here, NEVER its contents — a forged value must never become a force-with-lease
  # target (review round 8 of #225). Forging its mere presence only downgrades a member's own track from loud to
  # quiet; nothing is pushed either way, so no other writer is overwritten.
  [ -n "$workspace" ] && [ -f "$root/.cc/pushed" ] && [ ! -L "$root/.cc/pushed" ] && return 3
  return 2
}
remote_gone(){   # $1 branch → 0 ONLY when $remote answered and holds no refs/heads/<branch>. cwd = worktree root, $cred from lease_push
  # The question is asked of the remote itself and not of refs/remotes/<remote>/<branch>, which a `push --delete`
  # somewhere else on the box takes away without anything here noticing, and which a fetch can refresh at any time.
  # A remote that does not answer (no network, no credential, the bound) is NOT a deleted branch: it returns 1, the
  # caller forces nothing and the lease's own refusal stands. Silence must never read as permission.
  local out
  out=$(git_unattended "${cred[@]}" ls-remote --heads "$remote" "refs/heads/$1" 2>/dev/null) || return 1
  [ -z "$out" ]; }
lease_refresh(){   # $1 branch · $2 the lease on file → the lease to push with, on stdout. cwd = worktree root, $cred from lease_push
  # A HAND PUSH FROM THIS WORKTREE STALES THE LEASE: a repair committed and pushed outside this file put its tip on
  # the remote while .cc/pushed still named the push before it, so the next rebased push leased against the old
  # value, the remote answered with the hand-pushed one, and a write this worktree made was called "something else
  # wrote" — STATUS: BLOCKED on a track nobody else had touched (raised-hand-commit-on-track-branch-stales-push-lease,
  # 2026-09-18). Brief: "`.cc/pushed` refreshes from origin when the remote equals the worktree's pre-rebase head". So
  # the remote's tip is fetched (bounded, as every remote call here is) and, when it is a tip THIS BRANCH has held —
  # its own reflog, which has the pre-rebase head and every tip before it — the lease moves to it: a commit this
  # branch was at came out of this worktree. A tip the reflog never held is exactly what the lease exists to stop,
  # and the caller's refusal stands. A fetch that fails changes nothing.
  # BOX TRACKS ONLY (the caller's rule): a member workspace's .git, reflog included, is the member's to write — the
  # tracking-ref rule below — so nothing read out of it becomes a force-with-lease target; theirs stays rc=3 and adopt.
  local branch="$1" lease="$2" tip
  if git_unattended "${cred[@]}" fetch -q "$remote" "refs/heads/$branch" 2>/dev/null && tip=$(git rev-parse -q --verify FETCH_HEAD 2>/dev/null) \
     && [ -n "$tip" ] && [ "$tip" != "$lease" ] && git reflog show --format=%H "refs/heads/$branch" 2>/dev/null | grep -qx "$tip"; then
    printf '%s\n' "$tip" > "$ST/pushed"; lease=$tip; fi
  printf '%s\n' "$lease"; }
lease_keep(){ git rev-parse "$1" > "$ST/pushed" 2>/dev/null   # next time's lease: what the remote holds, because we just put it there
  rm -f "$ST/push.err" "$ST/push.err.tmp" "$ST/push.rejected" "$ST/adopted"; }   # …and this lease IS one of ours now, adopted or not; a rejection the remote has since taken back is stale
row_ids(){   # → the CALLER's local repo and track for this worktree's board row and journal.  1 = no safe name
  local f
  # WHOSE track this is comes from the PATH, never .cc/track — the header's rule, and it matters most here: the
  # sweep runs --push as the owner every five minutes, and the board note and the journal land under
  # whatever name is picked. A member writing another workspace's name into line 1 of that read-write file would
  # put this warning on THAT workspace's board and its Slack lane, and create a directory under ~/.cc/state for
  # it (review of #225). Only a worktree that is not under ~/.cc/worktrees — nothing a member session is bound
  # into — is taken at .cc/track's word, and then only for a name with nothing but a name in it.
  if path_ids "$root"; then repo="$WSREPO"; track="$WSTRACK"
  else repo=$(sed -n 1p "$root/.cc/track" 2>/dev/null); track=$(sed -n 2p "$root/.cc/track" 2>/dev/null)
    # A NAME AND NOTHING ELSE: no slash and no leading dot, which would walk out of ~/.cc/state, and no leading
    # dash, which reaches `cc-board note` as an option word and not as a repo. push.err is owed either way.
    for f in "$repo" "$track"; do case "$f" in ''|-*|.*|*[!A-Za-z0-9._-]*) repo=''; track=''; break ;; esac; done; fi
  [ -n "$repo" ] && [ -n "$track" ]; }
push_rejected(){   # after a failed push (lease_push rc=1): the REMOTE's refusal, kept and said once per distinct reason
  # GitHub turning away a workflow file the token has no scope for (or a protected branch, a repository rule) fails
  # every checkpoint the same way. push.err held git's line, and nobody read it: every reader asks only whether it
  # EXISTS (`push!`, the watchdog's "its branch is not pushed"), and each run replaces it. A track sat blocked 3.6
  # days on that with no note and no ask (2026-09-08). So git's `[remote rejected]` line goes to push.rejected, which
  # only a push that succeeds removes (lease_keep) — a run that pushed nothing, or failed for another reason, leaves
  # it — and the board note and the journal hear it when it differs from the one already kept, not every checkpoint.
  local why repo track jf msg
  why=$(grep -m1 -F '[remote rejected]' "$ST/push.err" 2>/dev/null | LC_ALL=C tr -cd '[:print:]' | sed 's/^ *! *//' | cut -c1-300)
  [ -n "$why" ] || return 0
  [ "$(cat "$ST/push.rejected" 2>/dev/null)" = "$why" ] && return 0
  printf '%s\n' "$why" > "$ST/push.rejected"
  row_ids || return 0
  msg="push rejected by $remote, so no commit of this branch reaches it until that is fixed: $why"
  "$BIN/cc-board" note "$repo" "$track" "$msg" >/dev/null 2>&1
  jf=$(journal_file "$repo" "$track") || return 0
  printf '\n%s cc-checkpoint: %s\n' "$(date -u +%FT%TZ)" "$msg" | dd oflag=append,nofollow conv=notrunc "of=$jf" status=none 2>/dev/null
  return 0; }
lease_refused(){   # a write this worktree did not make, on a single-writer branch: say so three ways, never none
  local branch="$1" repo track msg
  msg="push refused: $remote/$branch is not what this worktree last pushed, so something else wrote to that branch. The work is committed here and was NOT overwritten. Read 'git fetch $remote && git log $remote/$branch' before anything else."
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$msg" >> "$ST/push.err"
  row_ids || return 0
  "$BIN/cc-board" note "$repo" "$track" "$msg" >/dev/null 2>&1
  journal_blocked "$repo" "$track" "$msg"; }
push_gap(){   # $1 branch · $2 (optional) why nothing was pushed — ONE Stop line when the turn ends with work the remote has not got
  # NOTHING SILENT. Every other way this file has of saying "the push did not happen" is a file somebody has to go
  # and read: push.err, push.rejected, `push!` in `cc ls` and the digest. The session itself — the one still typing
  # into that worktree — was told nothing, so two course seats worked a day and a half on a branch their landing had
  # deleted at origin, reported "the hook pushes" every turn, and had the owner told work was live that existed in
  # one directory on this box (ece206, ece207, 2026-09-19/20). So the turn end says it, in the Stop decision's reason,
  # the same one line a refusal takes (tell): the hook cannot make a push succeed, but it can refuse to let one fail
  # quietly. The test is this worktree's own receipt, no network: HEAD against the commit the last push PUT on the
  # remote (.cc/pushed, written by lease_keep only after the remote took it). Equal and nothing is said — an ordinary
  # turn is not news. NOT inside a member's boundary, where the Stop hook has no credential by design and the host's
  # sweep does the pushing: the line would be true every turn there and mean nothing.
  local head lease why="${2:-}"
  [ -z "${CC_MEMBER_SANDBOX:-}" ] || return 0
  head=$(git rev-parse -q --verify HEAD 2>/dev/null) || return 0
  lease=$(cat "$ST/pushed" 2>/dev/null)
  [ "$head" = "$lease" ] && [ -z "${3:-}" ] && return 0   # $3 set: the receipt is right but the remote lost it (branch_back)
  [ -n "$why" ] || why=$(cat "$ST/push.err" 2>/dev/null | tr -s '[:space:]' ' ' | LC_ALL=C tr -cd '[:print:]' | cut -c1-200)
  tell "push: ${head:0:12} is committed on '$1' in this worktree and is NOT on $remote — ${why:-no push was made this turn}. Nothing of this turn can be reviewed, landed or read by anyone else until it is pushed, so say nothing is live: 'cc done <repo> <track>' pushes it, and 'git ls-remote $remote refs/heads/$1' is what proves it arrived."
  return 0; }
branch_back(){   # $1 branch — a quiet turn whose HEAD is what the last push put on the remote: is the branch STILL there?
  # push_gap reads the receipt alone, and the receipt cannot see a delete made after it was written: the landing's
  # squash merge, and cc-reconcile's daily sweep deleting track/<track> again while the row sits `merged`, both
  # take the branch away while .cc/pushed still equals HEAD, and a seat that commits nothing new after that would be
  # told nothing, turn after turn (review of #588). So the remote is asked (remote_gone: an answer that is not "no
  # such ref" — silence, the bound, no credential — is never a delete) and a branch that is gone is pushed back by
  # lease_push, whose plain push is then a create. One that cannot be put back is said in the same Stop line.
  local head rc
  [ -z "${CC_MEMBER_SANDBOX:-}" ] || return 0   # push_gap's rule: no credential in there, the host's sweep pushes
  head=$(git rev-parse -q --verify HEAD 2>/dev/null) || return 0
  [ "$head" = "$(cat "$ST/pushed" 2>/dev/null)" ] || return 0   # ahead of the receipt: push_gap says that without asking anybody
  pick_remote || return 0
  if [ -z "$workspace" ] && member_tree "$root"; then return 0; fi   # lease_push's own rule: no scope, no credential minted
  local -a cred=(); mapfile -t cred < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$remote" 2>/dev/null)" "$workspace" 2>/dev/null)
  remote_gone "$1" || return 0
  lease_push "$1"; rc=$?
  [ "$rc" = 0 ] && return 0
  [ "$rc" = 2 ] && lease_refused "$1"
  push_gap "$1" "the branch was deleted at $remote and putting it back failed: $(tr -s '[:space:]' ' ' < "$ST/push.err" 2>/dev/null | LC_ALL=C tr -cd '[:print:]' | cut -c1-160)" gone
  return 0; }
push_catchup(){   # $1 branch — a quiet turn whose HEAD is AHEAD of the receipt: push it, rather than report it
  # 0 = nothing was tried (the caller's own reason for the gap still stands) · 1 = a push was tried and failed, and
  # push.err holds the remote's own words for why.
  # NOTHING STAGED IS NOT THE SAME AS NOTHING TO PUSH. A session that ran its own `git commit` this turn, or
  # `git commit && git push` by hand, leaves the hook a clean index and a HEAD past .cc/pushed — and the quiet
  # branch below pushed nothing at all, so push_gap told that seat its commit "is NOT on origin — nothing was
  # committed this turn" and to say nothing is live. After a hand push that is simply false: the remote has the
  # commit, only the receipt is behind, and lease_refresh — which exists for exactly that hand push — lives
  # inside lease_push and was never reached (review of #588). So the push is made here. It is plain and a
  # fast-forward for a commit of our own, "Everything up-to-date" for one already pushed by hand, and either way
  # lease_keep writes the receipt and push_gap has nothing left to say. Only a push that really failed is reported.
  local head rc
  [ -z "${CC_MEMBER_SANDBOX:-}" ] || return 0   # push_gap's rule: no credential in there, the host's sweep pushes
  head=$(git rev-parse -q --verify HEAD 2>/dev/null) || return 0
  [ "$head" = "$(cat "$ST/pushed" 2>/dev/null)" ] && return 0   # level with the receipt: that is branch_back's question, not this one's
  pick_remote || return 0   # nowhere to push at all: no failed push to report, and the caller's reason is the true one
  if [ -z "$workspace" ] && member_tree "$root"; then return 0; fi   # lease_push's own rule: no scope, no credential minted
  lease_push "$1"; rc=$?
  [ "$rc" = 0 ] && return 0
  [ "$rc" = 2 ] && lease_refused "$1"
  return 1; }
journal_blocked(){   # $1 repo · $2 track · $3 the message — the STATUS: BLOCKED line, into a journal ITS READER CAN WRITE
  # ~/.cc/state/<repo> is bound read-WRITE into a worker's sandbox and into a member's whole boundary (cc-sandbox), so
  # progress.md and the directory holding it are theirs to replace with a link — and `>>` FOLLOWS ONE. The 5-minute
  # sweep runs this as the owner with nobody present, so that was an unattended write-as-owner primitive: link
  # progress.md at ~/.bashrc, take the worktree away so the sweep prunes the host lease, put a diverged branch back
  # with no <wt>/.cc/pushed, and the next tick's refused lease writes two of our lines into the owner's shell profile
  # (security review of #225). Moving the file is not open to us — this journal is the member's own and cc-loop reads
  # it from inside — so the write is walled instead, three ways, and nothing is read or written unless all hold:
  #   · ~/.cc/state/<repo> is not a link (checked before the mkdir, which would otherwise make a directory through one)
  #   · <repo>/<track> still resolves to itself under ~/.cc/state, so a linked track directory is out
  #   · progress.md is not a link — and the append itself is opened O_NOFOLLOW (dd), so a link raced in after these
  #     checks is refused by the KERNEL and not by a test that has already run.
  # Refusing costs the third of three warnings: push.err and the board note are written above and stand either way.
  local jf
  jf=$(journal_file "$1" "$2") || return 0
  # cc-loop greps ^STATUS: BLOCKED out of the journal after every iteration and stops the track there (board
  # `waiting`, owner told once) — that is the whole point of writing it. Only skipped when the journal ALREADY
  # ends with this, so a hook firing every turn cannot spam it; anything else and it is said again. Loud twice
  # beats silent once, which is the bug this file exists to close.
  [ "$(grep -v '^[[:space:]]*$' "$jf" 2>/dev/null | tail -1)" = "STATUS: BLOCKED: $3" ] && return 0
  printf '\n%s cc-checkpoint: %s\nSTATUS: BLOCKED: %s\n' "$(date -u +%FT%TZ)" "$3" "$3" \
    | dd oflag=append,nofollow conv=notrunc "of=$jf" status=none 2>/dev/null; return 0; }
journal_line(){   # $1 repo · $2 track · $3 a dated note for the journal — the same walls, no STATUS line: nothing stops on it
  local jf
  jf=$(journal_file "$1" "$2") || return 0
  printf '\n%s cc-checkpoint: %s\n' "$(date -u +%FT%TZ)" "$3" | dd oflag=append,nofollow conv=notrunc "of=$jf" status=none 2>/dev/null; return 0; }
journal_file(){   # $1 repo · $2 track → the journal's path, once the walls listed above hold.  1 = refused
  # Their last half, O_NOFOLLOW on the append itself, is each caller's: every write to it goes through dd with it.
  local jd
  [ ! -L "$HOME/.cc/state/$1" ] || return 1
  jd="$HOME/.cc/state/$1/$2"
  mkdir -p "$jd" 2>/dev/null || return 1   # a track whose journal has not been started yet is still owed the warning
  [ "$(readlink -f "$jd" 2>/dev/null)" = "$(readlink -f "$HOME/.cc/state" 2>/dev/null)/$1/$2" ] || return 1
  [ ! -L "$jd/progress.md" ] || return 1
  printf '%s\n' "$jd/progress.md"; }
adopt(){   # $1 handle · $2 track · $3 (optional) the sha the operator has read on the remote.  0 recorded · 1 not
  # THE ONE WAY OUT OF rc=3. A member workspace track whose lease predates ~/.cc/push-state has none the host wrote,
  # so a branch rebased since then can neither fast-forward nor be leased, and every automatic path stops: the old
  # lease sits in <wt>/.cc/pushed, which cc-sandbox binds read-WRITE into the member's boundary, and a forged value
  # handed to --force-with-lease force-pushes over whoever really wrote that branch (round 9 of #225). No push can
  # get out of that, so the exit is a PERSON — they read the commit the remote holds, and if it is this track's own
  # work they say so here. Without a sha this only reports, so reading costs nothing.
  # NOTHING OF THE MEMBER'S IS READ, AND NOTHING IS PUSHED. The sha is the operator's word AND has to be what the
  # remote answers at this instant, asked with the workspace's own credential behind the same wall every other
  # host-side git in a member's tree goes through. Recording is all this does: the next push — `cc done`, or the
  # sweep within five minutes — is what reconciles the branch, with the whole lease path in front of it.
  local h="${1:-}" t="${2:-}" want="${3:-}" wt sd why branch tip head f
  for f in "$h" "$t"; do case "$f" in ''|-*|.*|*[!A-Za-z0-9._-]*) echo "cc-checkpoint adopt: <handle> and <track> are plain names" >&2; return 1 ;; esac; done
  wt="$HOME/.cc/worktrees/$h/$t"; sd="$HOME/.cc/push-state/$h/$t"; branch="track/$t"
  [ -f "$HOME/dev/$h/.cc/member-workspace" ] || { echo "cc-checkpoint adopt: ~/dev/$h is not a member workspace — every other track leases against its tracking ref and never reaches rc=3" >&2; return 1; }
  # the sweep's own two walls, in the same order: the directory must BE the track it names (a symlink there resolves
  # outside ~/.cc/worktrees and every identity after it falls back to the member's word), and its .git must be the
  # workspace's own before a single git runs in it (review-156c).
  { [ ! -L "$wt" ] && [ "$(readlink -f "$wt" 2>/dev/null)" = "$(readlink -f "$HOME/.cc/worktrees/$h" 2>/dev/null)/$t" ]; } \
    || { echo "cc-checkpoint adopt: $wt is not the directory it names — a track is a real worktree at ~/.cc/worktrees/$h/$t or nothing of ours runs in it" >&2; return 1; }
  [ -f "$wt/.cc/track" ] || { echo "cc-checkpoint adopt: no track worktree at $wt" >&2; return 1; }
  why=$(member_gitdir "$h" "$wt") || { echo "cc-checkpoint adopt: $why" >&2; return 1; }
  # the MAIN checkout's hooks, never the worktree's — the pin cc, cc-loop and the sweep put on every host-side git in
  # a member's tree. Nothing below runs one, and this way nothing added below can either.
  local hp; hp=$(git -C "$HOME/dev/$h" config --type=path --get core.hooksPath 2>/dev/null)
  case "$hp" in "") hp="$HOME/dev/$h/.git/hooks";; /*) ;; *) hp="$HOME/dev/$h/$hp";; esac
  export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0="$hp"
  root="$wt"; cd "$root" || return 1
  ST="$sd"; mkdir -p "$ST" 2>/dev/null || { echo "cc-checkpoint adopt: cannot make $ST" >&2; return 1; }
  export CC_CHECKPOINT_NO_CREATE=1   # asking what a remote holds is not creating one: a project with no repository has no tip to adopt
  pick_remote || { echo "cc-checkpoint adopt: $h/$t has no repository yet, so there is nothing on a remote to reconcile against — 'cc done $h $t' makes one" >&2; return 1; }
  local -a cred=(); mapfile -t cred < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$remote" 2>/dev/null)" "$workspace" 2>/dev/null)
  tip=$(GIT_TERMINAL_PROMPT=0 git "${cred[@]}" ls-remote --heads "$remote" "refs/heads/$branch" 2>/dev/null | awk 'NR==1{print $1}')
  [ -n "$tip" ] || { echo "cc-checkpoint adopt: $remote does not have $branch, or could not be asked — nothing recorded" >&2; return 1; }
  head=$(git rev-parse -q --verify HEAD 2>/dev/null)
  if [ -z "$want" ]; then   # the reading step, and it records nothing: rc=1 says exactly that
    printf '%s\n' \
      "$h/$t: $remote holds $branch at $tip; this worktree is at ${head:-nothing}." \
      "Read that commit before anything else:  git -C $wt fetch $remote && git -C $wt log $tip" \
      "If it is this track's own work, record it — the next push reconciles the branch against it:" \
      "  cc-checkpoint adopt $h $t $tip" \
      "If it is somebody else's, nothing here overwrites it: merge or rebase onto it in the worktree instead."
    return 1; fi
  [ "$want" = "$tip" ] || { echo "cc-checkpoint adopt: $remote holds $branch at $tip, not $want — nothing recorded" >&2; return 1; }
  printf '%s\n' "$tip" > "$ST/pushed"
  : > "$ST/adopted"   # a lease READ OFF THE REMOTE and not one a push of ours recorded — see lease_push: the push that spends it evicts nothing
  rm -f "$HOME/.cc/sweep/$h/$t"   # …and the sweep must try this head again: rc=3 retired it, and a marker nobody clears is another dead end
  echo "adopted: $h/$t leases against $tip. The next push reconciles $branch against it — 'cc done $h $t', or the sweep within five minutes."
  return 0; }
selfcheck(){   # the cases are tests/selfcheck/cc-checkpoint.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-checkpoint.sh" || return 1
  selfcheck "$@"; }
[ "$MODE" = selfcheck ] && { selfcheck; exit $?; }
[ "$MODE" = gitdir ] && { member_gitdir "${2:?cc-checkpoint gitdir: handle}" "${3:?cc-checkpoint gitdir: worktree}"; exit $?; }
[ "$MODE" = adopt ] && { adopt "${2:-}" "${3:-}" "${4:-}"; exit $?; }
owed_live(){   # $1 repo · $2 track → 0 while the cc-loop its loop.pid names still runs for that track (cc-loop's loop_live, owner side)
  local f="$HOME/.cc/state/$1/$2/loop.pid" p a
  [ -f "$f" ] && [ ! -L "$f" ] || return 1
  p=$(head -c 32 "$f" | awk '{print $1; exit}'); case "$p" in ''|*[!0-9]*) return 1;; esac
  a=$(tr '\0' ' ' 2>/dev/null < "/proc/$p/cmdline")
  case " $a" in *"cc-loop $1 $2 "*) return 0;; esac
  return 1; }
[ "$MODE" = bind ] && { bind_track "${2:-}" "${3:-}" "${4:-}"; exit $?; }
if [ "$MODE" = sweep ]; then   # member workspaces, and a head an owner track's worker loop could not push (~/.cc/push-owed)
  # SAID ONCE, NOT EVERY FIVE MINUTES, and never inside the member's own tree: ~/.cc/worktrees/<h> and ~/.cc/state/<h>
  # are both bound read-write into the boundary (cc-sandbox), so a marker kept there is the member's to forge or
  # delete — and `.cc` in a worktree they invented could be a symlink at anything the owner can write. ~/.cc/sweep is
  # under no bind at all. The board hears it too where the track has a row; the timer's journal always does.
  # The marker carries the HEAD it is about and the outcome at it: one state is said once per commit, and a new
  # commit or a different outcome is said again. A push that lands takes it away.
  mark(){ mkdir -p "$HOME/.cc/sweep/$1" 2>/dev/null && printf '%s\n' "${head:-} $3" > "$HOME/.cc/sweep/$1/$2" 2>/dev/null; return 0; }
  said_once(){   # $1 handle · $2 track · $3 message
    [ "$(cat "$HOME/.cc/sweep/$1/$2" 2>/dev/null)" = "${head:-} $3" ] && return 0
    mark "$1" "$2" "$3"
    echo "$1/$2: $3"; "$BIN/cc-board" note "$1" "$2" "$3" >/dev/null 2>&1; return 0; }
  safe_state(){   # $1 worktree → 0 when the .cc names a push once wrote are plain files of its own
    # NOT WHAT MAKES THE WRITE SAFE — that is CC_CHECKPOINT_STATE_DIR below, which puts every write the push makes
    # outside every bind the member has. This is the cheap sanity refusal in front of it: a track carrying a link at
    # one of these names is one somebody is playing with, and it is skipped and named rather than pushed from. A
    # dangling link is caught FIRST: -e is false through one.
    local wt="$1" f
    [ -d "$wt/.cc" ] && [ ! -L "$wt/.cc" ] || { echo "$wt/.cc is not a directory of its own"; return 1; }
    for f in pushed adopted push.err push.err.tmp push.rejected create.err create.err.tmp evict.err evict.err.tmp evict.same base-seed mirrored mirror.err mirror.refused; do
      [ ! -L "$wt/.cc/$f" ] || { echo "$wt/.cc/$f is a symlink"; return 1; }
      [ ! -e "$wt/.cc/$f" ] || [ -f "$wt/.cc/$f" ] || { echo "$wt/.cc/$f is not a plain file"; return 1; }
    done
    return 0; }
  land_queue(){   # $1 handle · $2 track · $3 host state dir · $4 head — THE LANDING IS QUEUED FROM HERE (cc-land, MEMBERS).
    # A workspace's `cc done` runs inside the boundary and cannot spell the queue, so this tick — the host's, every five
    # minutes, the same one that pushes for it — asks `cc lands <h>` (the grant, and a token to land on) and queues a
    # finished track's PR: a row in review carrying a PR url. ONCE per (PR, head): the stamp, under no bind, says what
    # was queued for which commit, so a landing that stopped is not re-driven every tick, and a new push is a new
    # landing — cc-land's own door refuses one that cannot succeed. The job is the project's name, <h>--<t>.
    local h="$1" t="$2" sd="$3" head="$4" st pr prn o
    "$BIN/cc" lands "$h" >/dev/null 2>&1 || return 0
    st=$("$BIN/cc-board" get "$h" "$t" status 2>/dev/null); [ "$st" = review ] || return 0
    pr=$("$BIN/cc-board" get "$h" "$t" pr 2>/dev/null); prn=${pr##*/}
    case "$prn" in ''|*[!0-9]*) return 0;; esac
    [ "$(cat "$sd/landing-queued" 2>/dev/null)" = "$prn $head" ] && return 0
    mkdir -p "$sd" 2>/dev/null && printf '%s\n' "$prn $head" > "$sd/landing-queued"   # claimed BEFORE the queue: tried once per (PR, head), whichever way it goes
    if o=$("${CC_LAND:-$BIN/cc-land}" queue "$h--$t" "$prn" --who "cc-checkpoint --sweep" 2>&1); then   # CC_LAND: test hook
      echo "$h/$t: PR #$prn queued to land — ${o//$'\n'/ }"
    else
      echo "$h/$t: PR #$prn would not queue — ${o//$'\n'/ }"
      "$BIN/cc-board" note "$h" "$t" "landing: PR #$prn would not queue — $(tail -1 <<<"$o" | cut -c1-200)" >/dev/null 2>&1
    fi
    return 0; }
  mirror_said(){   # $1 handle · $2 track · $3 host state dir · $4 mirror remote · $5 mirror.err's reason before the push — the mirror's outcome, one line
    local m; m=$(cat "$3/mirrored" 2>/dev/null)
    if [ -n "$m" ] && [ ! -e "$3/mirror.err" ] && [ ! -e "$3/mirror.refused" ]; then echo "$1/$2: mirrored ${m:0:7} to $4"
    elif [ -e "$3/mirror.refused" ]; then echo "$1/$2: not mirrored to $4 — refused, not forced: $(cut -d' ' -f2- "$3/mirror.refused")"
    elif [ -e "$3/mirror.err" ] && [ "$(cut -d' ' -f2- "$3/mirror.err")" != "$5" ]; then echo "$1/$2: not mirrored to $4 yet — $(cut -d' ' -f2- "$3/mirror.err"); the next tick tries again"; fi
    return 0; }
  for mk in "$HOME"/dev/*/.cc/member-workspace; do
    [ -f "$mk" ] || continue
    h=${mk%/.cc/member-workspace}; h=${h##*/}
    # the MAIN checkout's hooks, never the worktree's — the pin cc-loop and cc put on every host-side git in a member's tree
    hp=$(git -C "$HOME/dev/$h" config --type=path --get core.hooksPath 2>/dev/null); case "$hp" in "") hp="$HOME/dev/$h/.git/hooks";; /*) ;; *) hp="$HOME/dev/$h/$hp";; esac
    for m in "$HOME/.cc/sweep/$h"/*; do [ -e "$m" ] || continue; [ -d "$HOME/.cc/worktrees/$h/${m##*/}" ] || rm -f "$m"; done   # a track that was removed and made again must be able to say the same thing again
    for m in "$HOME/.cc/push-state/$h"/*; do [ -e "$m" ] || continue; [ -d "$HOME/.cc/worktrees/$h/${m##*/}" ] || rm -rf "$m"; done   # …and its lease goes with it, so a new worktree at that path leases against the remote and not against what the old one pushed
    for wt in "$HOME/.cc/worktrees/$h"/*/; do
      wt=${wt%/}; t=${wt##*/}; [ -f "$wt/.cc/track" ] || continue
      # THE WALL FIRST, before any other git touches this tree — the same one `cc done` puts in front of its own
      # (review-156c). ~/.cc/worktrees/<h> is read-write inside the boundary, so a member can leave a directory there
      # carrying .cc/track and a git dir of their own whose config names an `ext::sh -c …` remote or core.fsmonitor:
      # the push below would run it as the owner, and this runs every five minutes with nobody present (review of
      # #225). Past this line the remotes come from ~/dev/<h>/.git/config, which is read-only in there.
      head=   # nothing has been read out of that tree yet: the wall's refusal is keyed on no head, so a tree that is fixed says the next thing
      # AND ONLY A DIRECTORY THAT IS REALLY ONE OF OURS. The `*/` glob matches a SYMLINK to a directory too, and
      # ~/.cc/worktrees/<h> is read-write inside the boundary: `ln -s ~/dev/<h>/evilwt evil` names a real worktree of
      # the workspace, so the wall and safe_state below both pass, while path_ids resolves outside ~/.cc/worktrees and
      # every identity after it falls back to the member's own .cc/track — another workspace's board, a directory
      # under ~/.cc/state in its name, and an unscoped credential (security review of #225).
      if [ -L "$wt" ] || [ "$(readlink -f "$wt")" != "$(readlink -f "$HOME/.cc/worktrees/$h")/$t" ]; then
        said_once "$h" "$t" "refusing to push from $wt — it is not the directory it names: a track is a real worktree at ~/.cc/worktrees/$h/$t or nothing of ours runs in it"; continue; fi
      if ! why=$(member_gitdir "$h" "$wt"); then said_once "$h" "$t" "$why"; continue; fi
      # AND NOTHING IS WRITTEN INSIDE THE MEMBER'S TREE AT ALL. The push's own state — push.err, push.err.tmp,
      # pushed — goes to a directory of ours under ~/.cc/push-state, which is under no bind, so a link raced into
      # ~/.cc/worktrees/<h>/<t>/.cc between a check and the write has nothing aimed at it (security review of #225).
      # The refusal below is the sanity check in front of that, said once on no head the way the wall's is.
      # NOTHING IS REMOVED IN THERE EITHER: `rm` resolves .cc at removal time, so a link swapped in during the push
      # would have the host unlink a file of that name wherever it points.
      # SO ONE RULE, FOR EVERY MARKER AND EVERY READER: a member workspace's host-side markers live in
      # ~/.cc/push-state/<h>/<t> — push.err behind `push!` and checkpoint.err behind `commit!` — and the files of
      # those names in the member's tree are the MEMBER'S, read by nobody on the host. `cc ls`, cc-digest,
      # cc-reconcile and the Slack Home tab all follow it (cc-reconcile's host_marker states it once). Inside the
      # boundary the Stop hook has no credential by design, so its own push.err is written every turn and no
      # successful push of theirs ever clears it — read as the host's marker it lit `push!` for ever and had
      # cc-reconcile ask "its branch is not pushed" every 20 minutes about a branch this timer had pushed (review
      # round 10 of #225); and the host's own commit refusal, now written under $ST like everything else it writes,
      # lit nothing anywhere while the readers still looked in the tree (review round 11).
      if ! why=$(safe_state "$wt"); then said_once "$h" "$t" "refusing to push from $wt — $why: a track keeps those names as plain files of its own or nothing is pushed from it"; continue; fi
      sd="$HOME/.cc/push-state/$h/$t"; mkdir -p "$sd" 2>/dev/null || continue
      head=$(git -C "$wt" rev-parse -q --verify HEAD 2>/dev/null) || continue
      [ "$(git -C "$wt" symbolic-ref -q --short HEAD 2>/dev/null)" = "track/$t" ] || continue   # --push's own rule; its refusal is the hook's to record, not a line here every 5 min
      was=$(cat "$sd/pushed" 2>/dev/null)
      # What it last pushed IS its head: nothing to do, and no token minted — unless the project has a mirror
      # (mirror_push) that has not got this commit and has not refused it, which this tick then pushes alone.
      # mirror_remote reads the remotes out of ~/dev/<h>/.git/config, behind the wall above, as the push does.
      mr=$(cd "$wt" && WSTRACK="$t" mirror_remote 2>/dev/null) || mr=''
      mdue=; [ -n "$mr" ] && [ "$(cat "$sd/mirrored" 2>/dev/null)" != "$head" ] && [ "$(cut -d' ' -f1 "$sd/mirror.refused" 2>/dev/null)" != "$head" ] && mdue=1
      [ "$was" = "$head" ] && [ -z "$mdue" ] && continue
      # AND A REFUSED LEASE IS NOT TRIED AGAIN FOR THE SAME COMMIT. --push says one three ways every time it runs, so
      # a branch something else wrote to would say it 288 times a day with nobody present, and no retry is going to
      # change that until a person looks. The marker goes down before the push carrying this head; a push that lands
      # takes it away. ONLY a refused lease keeps it: a push that failed for a reason that may pass — DNS, a 5xx, a
      # credential that could not be minted — clears the head below, because one blip must not leave a member's
      # commit sitting on the box for ever, which is the bug this file exists to close (security review of #225).
      [ "$was" != "$head" ] && [ "$(cut -d' ' -f1 "$HOME/.cc/sweep/$h/$t" 2>/dev/null)" = "$head" ] && continue
      prev=$(cat "$HOME/.cc/sweep/$h/$t" 2>/dev/null)   # what was said last time: the mark below overwrites it, and a retry still must not repeat itself
      # AND NEVER UNDERNEATH AN IN-FLIGHT `cc done` ON THE SAME TRACK. `cc done` holds $sd/done.lock across its
      # checkpoint, its push and its PR (core/bin/cc), and both write the same $sd/push.err.tmp and $sd/pushed: a tick
      # landing inside one had lease_keep unlink the push.err.tmp `cc done`'s own rejected push was about to read, so
      # `cc done` said "push failed — no PR opened" about a branch that WAS pushed (review round 11 of #225). Taken
      # without waiting, and taken BEFORE the marker goes down: a track a person is finishing right now is left to
      # them, nothing is retired for this head, and the next tick picks it up.
      exec 7>"$sd/done.lock" || continue
      if ! flock -n 7; then exec 7>&-
        echo "$h/$t: skipped this tick — a 'cc done' is running for this track and holds its state; the next tick picks it up"; continue; fi
      merr=$(cut -d' ' -f2- "$sd/mirror.err" 2>/dev/null)   # what the mirror said last time, so a failure that repeats is not said every tick
      if [ "$was" = "$head" ]; then   # ORIGIN ALREADY HAS IT, only the mirror is behind: the push to origin is a no-op and no marker is touched
        (cd "$wt" && env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp" CC_ROLE=worker CC_CHECKPOINT_NO_CREATE=1 "CC_CHECKPOINT_STATE_DIR=$sd" "$BIN/cc-checkpoint" --push >/dev/null 2>&1 7>&-)
        mirror_said "$h" "$t" "$sd" "$mr" "$merr"; exec 7>&-; continue; fi
      mark "$h" "$t" ''
      # PUSH ONLY: CC_CHECKPOINT_NO_CREATE stops pick_remote short of `cc-gh-token create` and seed_base short of
      # `cc-gh-token default`, so a timer neither makes a repository in the owner's org under a name a member
      # chose nor moves one's default branch (review of #225).
      # …and 7>&- so the lock does NOT ride into the child and everything it spawns: an flock lives until every copy
      # of its fd is closed, so one process that outlived this tick would hold a track's done.lock indefinitely.
      out=$(cd "$wt" && env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp" CC_ROLE=worker CC_CHECKPOINT_NO_CREATE=1 "CC_CHECKPOINT_STATE_DIR=$sd" "$BIN/cc-checkpoint" --push 2>&1 7>&-); rc=$?
      # WHAT THE PUSH DID, NOT WHAT HEAD SAID BEFORE IT. lease_keep records the sha it put on the branch, so the lease
      # MOVING is the push landing — and it is the only account of it that holds when the member's live session commits
      # again between the head read above and the push going out. Compared against $head instead, that run fell through
      # rc=0 to the else below and told the member's board "no repository recorded for this project" about a project
      # that has one and had just been pushed to (review round 11 of #225).
      now=$(cat "$sd/pushed" 2>/dev/null)
      if [ -n "$now" ] && [ "$now" != "$was" ]; then echo "$h/$t: pushed ${now:0:7}"; rm -f "$HOME/.cc/sweep/$h/$t"
        [ -z "$mr" ] || mirror_said "$h" "$t" "$sd" "$mr" "$merr"
      elif [ "$rc" = 3 ]; then
        # DIVERGED WITH NO HOST LEASE. The push was NOT forced and nothing was overwritten. A track from before #225
        # kept its lease in <wt>/.cc/pushed, which this timer will not read; the sweep cannot tell that from a real
        # foreign write, so it never force-pushes and never writes STATUS: BLOCKED here — that false BLOCKED stopped
        # the very interactive tracks this exists to serve (review round 8 of #225). NO LATER PUSH GETS IT OUT
        # EITHER: the branch cannot fast-forward and there is nothing safe to lease against, so `cc done` answers
        # rc=3 too and pointing at it would be a circle (review round 10 of #225). The one exit is a person reading
        # what the remote holds — `cc-checkpoint adopt` — and that is what this says, and what `cc done` says.
        # Said once per commit to the timer's own journal (echo), never the project's board: a benign rebase must not
        # nag it. The marker is already this head (mark '' above), so the next tick skips it until a new commit lands.
        echo "$h/$t: not pushed — this branch has moved on from the remote and no lease of the host's says what it last put there, so nothing was forced and nothing overwritten. One way on: 'cc-checkpoint adopt $h $t' says what the remote holds, and records it once you have read that commit; the next tick then pushes."
      elif [ "$rc" = 2 ]; then msg="push refused — $(tail -1 <<<"$out" | no_userinfo | cut -c1-160)"
        mark "$h" "$t" "$msg"; echo "$h/$t: $msg"   # a person has to look at this one: said for this commit, and not again until there is another
      elif [ "$rc" != 0 ]; then msg="push failed — $(tail -1 <<<"$out" | no_userinfo | cut -c1-160)"
        head=; printf '%s\n' "$prev" > "$HOME/.cc/sweep/$h/$t" 2>/dev/null   # back to what it said before the push, which is what said_once compares against
        said_once "$h" "$t" "$msg"   # no head in the marker, so the next tick tries this same commit again; the board hears the reason once
      else said_once "$h" "$t" "no repository recorded for this project, and the timer makes none — 'cc done' or the owner does that"; fi
      exec 7>&-   # the track is done with for this tick: a `cc done` typed a moment later waits on nothing
    done
    for wt in "$HOME/.cc/worktrees/$h"/*/; do   # …and AFTER the pushes, the landings (land_queue): behind the same two walls
      wt=${wt%/}; t=${wt##*/}; [ -f "$wt/.cc/track" ] || continue   # as the push, silent here — the push loop already said them
      [ -L "$wt" ] || [ "$(readlink -f "$wt")" != "$(readlink -f "$HOME/.cc/worktrees/$h")/$t" ] && continue
      member_gitdir "$h" "$wt" >/dev/null || continue
      # ONLY A HEAD THE HOST KNOWS IS ON THE REMOTE — the lease the push loop writes ($sd/pushed, lease_keep), never the
      # worktree's own HEAD. Queued on HEAD, a commit whose push was skipped or failed above (a refused lease, a remote
      # not answering, rc≠0) was stamped and queued anyway: cc-land gated and merged the PR at the OLDER remote head,
      # dropping the member's last commit from the merge, and once the push did go out on a later tick the stamp
      # already named that head, so nothing re-queued it (review of #418). A HEAD the lease has not caught up with is
      # left for the tick after the push that moves it.
      sd="$HOME/.cc/push-state/$h/$t"; lease=$(cat "$sd/pushed" 2>/dev/null)
      [ -n "$lease" ] && [ "$lease" = "$(git -C "$wt" rev-parse -q --verify HEAD 2>/dev/null)" ] || continue
      land_queue "$h" "$t" "$sd" "$lease"
    done
  done
  # ── A HEAD A WORKER'S LOOP COULD NOT PUSH, on the owner's own tracks ─────────────────────────────────────────────
  # Inside the sandbox the Stop hook commits with no credential, so cc-loop's push from out here is the only one a
  # worker's commit gets — and a rebase round is ONE iteration. When that push failed it was swallowed: #1239's merge
  # of main sat committed on the box for two rounds while the queue kept the old conflicting head, until a seat pushed
  # it by hand (2026-10-13). cc-loop now leaves ~/.cc/push-owed/<repo>/<track> naming the head (push_host), and this
  # tick pushes it once that loop is gone. ONLY those: every other owner track pushes from its own hook or its loop.
  # A refused lease (rc 2/3) is a person's to read — --push has already said it to the board — so it is not retried;
  # any other failure is said to the board once per head and reason, and tried again next tick.
  for ow in "$HOME"/.cc/push-owed/*/*; do
    [ -f "$ow" ] && [ ! -L "$ow" ] || continue
    r=${ow%/*}; r=${r##*/}; t=${ow##*/}; wt="$HOME/.cc/worktrees/$r/$t"
    if [ -f "$HOME/dev/$r/.cc/member-workspace" ] || [ -L "$wt" ] || [ ! -f "$wt/.cc/track" ]; then rm -f "$ow"; continue; fi   # a member's is the pass above
    head=$(git -C "$wt" rev-parse -q --verify HEAD 2>/dev/null) || { rm -f "$ow"; continue; }
    if [ "$(git -C "$wt" symbolic-ref -q --short HEAD 2>/dev/null)" != "track/$t" ]; then   # --push's own rule: a seat mid-rebase, or on a side branch, is left alone
      msg="the host's push is held: its worktree is not on track/$t, so nothing is pushed until it is back on it"   # …and said once, not kept in silence
      [ "$(cat "$ow" 2>/dev/null)" = "$head $msg" ] && continue
      printf '%s\n' "$head $msg" > "$ow"; echo "$r/$t: $msg"; "$BIN/cc-board" note "$r" "$t" "$msg" >/dev/null 2>&1; continue; fi
    [ "$(cat "$wt/.cc/pushed" 2>/dev/null)" = "$head" ] && { rm -f "$ow"; continue; }        # pushed since — by its loop, a seat, `cc done`
    owed_live "$r" "$t" && continue   # a live loop pushes for itself after its next iteration; two pushes at once would read as a foreign write
    [ ! -L "$wt/.cc/done.lock" ] && exec 7>>"$wt/.cc/done.lock" || continue   # `cc done`'s own lock, and its own refusal of a link at it
    flock -n 7 || { exec 7>&-; continue; }   # a `cc done` is pushing it right now
    hp=$(git -C "$HOME/dev/$r" config --type=path --get core.hooksPath 2>/dev/null); case "$hp" in "") hp="$HOME/dev/$r/.git/hooks";; /*) ;; *) hp="$HOME/dev/$r/$hp";; esac
    out=$(cd "$wt" && env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath "GIT_CONFIG_VALUE_0=$hp" CC_ROLE=worker CC_CHECKPOINT_NO_CREATE=1 "$BIN/cc-checkpoint" --push 2>&1 7>&-); rc=$?
    exec 7>&-
    if [ "$rc" = 0 ]; then rm -f "$ow"
      now=$(cat "$wt/.cc/pushed" 2>/dev/null)
      [ "$now" = "$head" ] && { echo "$r/$t: pushed ${head:0:7}, which its worker's loop could not"
        "$BIN/cc-board" note "$r" "$t" "the host pushed ${head:0:7}, which its worker's loop could not push" >/dev/null 2>&1; }
    elif [ "$rc" = 2 ] || [ "$rc" = 3 ]; then rm -f "$ow"; echo "$r/$t: not pushed — $(tail -1 <<<"$out" | no_userinfo | cut -c1-160)"
    else msg="the host's push of ${head:0:7} failed, and the next tick tries again — $(tail -1 <<<"$out" | no_userinfo | cut -c1-160)"
      [ "$(cat "$ow" 2>/dev/null)" = "$head $msg" ] && continue
      printf '%s\n' "$head $msg" > "$ow"; echo "$r/$t: $msg"; "$BIN/cc-board" note "$r" "$t" "$msg" >/dev/null 2>&1
    fi
  done
  # CURSOR RECONCILIATION for the knowledge base (cc-lib): every registered source whose cursor moved without a
  # write hook — an edit by hand, a tool that bypassed one, a journal a session appended to and never turned on —
  # is re-read here, on the five-minute tick the box already has, and a pass that reaches everything clears the
  # hooks' misses log. 60 ms when nothing changed; nothing here is a timer, unit or daemon of the knowledge base's own.
  [ -x "$BIN/cc-lib" ] && timeout 120 "$BIN/cc-lib" index >/dev/null 2>&1
  exit 0
fi
if [ "$MODE" != commit ]; then   # push only: no payload to read, no commit, and a real exit code for `cc done`
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "cc-checkpoint $MODE: not inside a git worktree" >&2; exit 1; }
  cd "$root" || exit 1
  # --remote answers WHERE, and makes the workspace project's repository if that is what the answer needs, so
  # `cc done` asks before the push and opens its PR against the same repository. It writes no branch, so the
  # HEAD rule below — which guards a push — is not its business.
  ST=${CC_CHECKPOINT_STATE_DIR:-$root/.cc}
  # …and never back into the worktree if that directory cannot be made: falling back would put the writes exactly
  # where the caller asked for them not to be (security review of #225). rc=1 — the sweep tries again next tick.
  mkdir -p "$ST" 2>/dev/null || { echo "cc-checkpoint $MODE: cannot make the state directory $ST — refusing to push rather than write the push's state inside the worktree" >&2; exit 1; }
  if [ "$MODE" = remote ]; then pick_remote || exit 1; printf '%s\n' "$remote"; exit 0; fi
  track=$(sed -n 2p "$root/.cc/track" 2>/dev/null); branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
  # STRICTER than the hook, on purpose: the canonical branch and no side branch of it. Without this a session that
  # repointed HEAD could have `cc done` push the default branch for it, and completion — the PR and the landing
  # queue — is keyed on track/<track> whatever the hook was willing to keep the work safe on.
  [ -n "$track" ] && [ "$branch" = "track/$track" ] || { echo "cc-checkpoint --push: HEAD is '$branch', not 'track/$track' — refusing to push" >&2; exit 1; }
  pick_remote || exit 0   # nowhere to push, and none to be made: that is not a failed push
  lease_push "$branch"; rc=$?
  [ "$rc" = 2 ] && lease_refused "$branch"
  [ "$rc" = 0 ] || tail -3 "$ST/push.err" >&2
  exit "$rc"
fi
# ── the hand-off nudge ───────────────────────────────────────────────────────────────────────────
# A session past the hand-off line is told, once, to write its journal entry. That is the whole of it: #501 cut
# the relay that used to do this, and these lines are what it was carrying. A session that dies unjournalled is
# what makes the next handover expensive, and neither seat that crossed the line on 2026-09-16 would have
# journalled unprompted mid-task. The Stop payload's transcript_path is the only handle a hook has on how full
# this session is; cc-context --over sizes it against CC_CONTEXT_HANDOFF_TOKENS and prints the measurement, so
# nothing here measures, records or decides anything of its own. A session that ignores it is not this hook's to
# move: past the rotate line above (CC_CONTEXT_ROTATE_TOKENS) cc-handoff --sweep hands it off (its ROTATION).
# SAID AT MOST ONCE AN HOUR PER SESSION (CC_CHECKPOINT_NUDGE_MIN). A session told again minutes after it wrote a
# full entry writes a two-line addendum, which is worse than silence; a session that ignored the first line is
# still past the line an hour later. The stamp is one empty file per session, pruned when the next one is written.
# And never while the harness says a Stop hook is already holding this turn open (stop_hook_active): blocking
# again there is what a block-loop looks like from in here.
# THE PERMISSION SEAT'S HAND-OFF GATE. cc-perms handoff and relaunch refuse until the box goes live, so a line that
# tells the seat to hand off then sends it into a refusal. perms_handoff_open asks cc-perms' own `gate` (exit 0 open,
# 1 shut: <why>), the one place that checks both the config key and the root-owned go-live marker; a missing binary,
# a failure or a timeout counts as shut. While it is shut, the seat hears PERMS_SHUT and no instruction to hand off.
PERMS_SHUT="The hand-off is shut until go-live, so cc-perms handoff and relaunch refuse; do not run them (cc-perms gate says why)."
perms_handoff_open(){ timeout 10 "$BIN/cc-perms" gate >/dev/null 2>&1; }
journal_nudge(){   # $1 the Stop payload.  One reason line on stdout (relay wraps it), or nothing at all. Never fatal.
  local tp sid stamp last m cwd r
  case "${1//[[:space:]]/}" in *'"stop_hook_active":true'*) return 0;; esac   # whitespace out: one pattern, either spelling
  tp=$(printf '%s' "$1" | sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  [ -n "$tp" ] && [ -f "$tp" ] || return 0
  sid=${tp##*/}; stamp="$HOME/.cc/state/checkpoint/nudged/${sid%.jsonl}"   # a transcript is named for its session
  last=$(stat -c %Y "$stamp" 2>/dev/null) || last=0   # not `find -newermt`: only GNU find reads a relative time
  [ $(( $(printf '%(%s)T' -1) - ${last:-0} )) -ge $(( ${CC_CHECKPOINT_NUDGE_MIN:-60} * 60 )) ] || return 0
  m=$(timeout 20 "$BIN/cc-context" --transcript "$tp" --over 2>/dev/null) || return 0   # rc 1 under the line, 2 unmeasurable
  mkdir -p "${stamp%/*}" 2>/dev/null && : > "$stamp" 2>/dev/null
  find "${stamp%/*}" -type f -mtime +7 -delete 2>/dev/null
  m=${m//[\"\\]/}   # the reason below is JSON on one line, and the measurement goes inside it as plain text
  # THE PERMISSION SEAT HANDS ITSELF OFF: the box's rotation never starts it (cc-handoff refuses), so its line says
  # what only it can do — journal, then cc-perms handoff, which refuses without a fresh HAND-OFF ENTRY. A cwd that
  # merely looks like the seat's gets this text and nothing more: the verb decides who the seat is, not this line.
  # The call waits up to 90 s for the successor; under a timeout shorter than 120 s, a hard kill could leave perms~next.
  cwd=$(printf '%s' "$1" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  case "$cwd" in "$HOME"/.cc/state/*/perms) r=${cwd#"$HOME"/.cc/state/}; r=${r%/perms}
    if [[ $r != */* ]] && [ -f "$cwd/brief.md" ] && ! perms_handoff_open; then   # shut: it journals, and hears why there is no hand-off
      printf '%s\n' "CONTEXT $m. You are the permission seat, past the hand-off line. Before this turn ends, append a dated entry to handoff.md in your own directory, ~/.cc/state/$r/perms/handoff.md (what is done, what is next in order, the gotchas), then carry on. $PERMS_SHUT"
      return 0
    elif [[ $r != */* ]] && [ -f "$cwd/brief.md" ]; then
      printf '%s\n' "CONTEXT $m. You are the permission seat, past the hand-off line. Before this turn ends, append an entry headed '## HAND-OFF ENTRY <UTC time to the minute>Z ... START HERE' to handoff.md in your own directory, ~/.cc/state/$r/perms/handoff.md, which only you can write and the only journal your successor reads (what is done, what is next in order, the gotchas), then run cc-perms handoff in the foreground, never in the background, with a Bash timeout of at least 120000 ms, so a timeout cannot stop it halfway. A fresh seat starts from brief.md and that entry, takes window perms, and this window ends, unless reads are still running in your subagents: then it stays as perms~old for them, and the hand-off's output says what to do."
      return 0; fi;; esac
  printf '%s\n' "CONTEXT $m. Append a dated entry${CC_AGENT_NO:+ headed $CC_AGENT_NO (your agent number)} to this session's journal now, before this turn ends: what is done, what is next in order, the gotchas. A track journals to ~/.cc/state/<repo>/<track>/progress.md, any other session to ~/.cc/state/<repo>/<alias-or-planning>-handoff.md. Write it from what you already know, then carry on. A fresh session starts from that file and from nothing else."
}
# The hook's JSON payload (verified fields: session_id, transcript_path, cwd, stop_hook_active, …) — read before
# anything can exit, capped, and never fatal: the pipe must be drained whatever happens (a hook that leaves it
# unread can stall the writer), and asking how full a context is must not cost a session its commit. What comes
# back is relayed AFTER the commit below, so the work is on the branch before the turn is interrupted.
# THE PERMISSION SEAT'S PINS. cc-perms relaunch and handoff refuse to start a seat while ~/.claude's startup entries,
# ~/.claude.json, the seat's auto-memory or the claude binary differ from the hashes the seat pinned, and only the seat
# can pin. So the seat hears it at the end of a turn, whatever its context, rather than when a hand-off or a crash
# finds out: "startup surface changed since the last pin: <entries>". The comparison is cc-perms' own (pins-diff, one
# hash pass, about a second here, no model), never a copy of it. Said once per set of entries per session, so a seat
# that is still looking is not held a second turn every turn; a new change is a new set, and is said again.
# IT SAYS REVIEW, NEVER JUST "PIN". A changed entry is what a planted startup file looks like, and a seat told to pin
# would bless the plant, so the line sends it to read each change first. While the hand-off gate is shut it carries
# PERMS_SHUT instead of pointing at a hand-off the box will refuse, and the nudge beside it drops its own copy.
pins_line(){   # $1 the Stop payload.  One line on stdout, or nothing at all. Never fatal.
  local cwd r d sid stamp k
  case "${1//[[:space:]]/}" in *'"stop_hook_active":true'*) return 0;; esac
  cwd=$(printf '%s' "$1" | sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  case "$cwd" in "$HOME"/.cc/state/*/perms) r=${cwd#"$HOME"/.cc/state/}; r=${r%/perms};; *) return 0;; esac
  [[ $r != */* ]] && [ -f "$cwd/brief.md" ] && [ -x "$BIN/cc-perms" ] || return 0
  d=$(timeout 30 "$BIN/cc-perms" pins-diff "$r" 2>/dev/null); [ $? = 1 ] && [ -n "$d" ] || return 0   # 0 matches, 2 or 124: nothing to say
  sid=$(printf '%s' "$1" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"/]*\)".*/\1/p' | head -1)
  stamp="$HOME/.cc/state/checkpoint/pins-said/${sid:-$r}"; k=$(printf '%s' "$d" | sha256sum | cut -c1-16)
  [ "$(cat "$stamp" 2>/dev/null)" = "$k" ] && return 0
  mkdir -p "${stamp%/*}" 2>/dev/null && printf '%s\n' "$k" > "$stamp" 2>/dev/null
  find "${stamp%/*}" -type f -mtime +7 -delete 2>/dev/null
  d=$(paste -sd '\t' <<<"$d"); d=${d//$'\t'/, }
  d="startup surface changed since the last pin: ${d//[\"\\]/} — review each change before re-pinning; never pin an entry you haven't read."
  if perms_handoff_open; then printf '%s\n' "$d Until the pins match, cc-perms handoff and relaunch refuse to start a seat."
  else printf '%s\n' "$d $PERMS_SHUT"; fi; }
[ "$STRICT" = 1 ] || [ -t 0 ] || payload=$(timeout 5 cat)
[ -n "${payload:-}" ] && say=$(journal_nudge "$payload")
[ -n "${payload:-}" ] && { pl=$(pins_line "$payload"); [ -z "$pl" ] || { say=${say//" $PERMS_SHUT"/}; say=$pl${say:+ }${say:-}; }; }   # the shut line said once
# INDEX-AT-WRITE for the knowledge base (cc-lib): the journal this turn appended to (~/.cc/state) and the memory
# file it saved (~/.claude/projects) are searchable a minute later, not at the next sweep. Every session, track or
# not, on the hook alone — never `--commit`, and never inside a member's boundary (a member reads its workspace's
# file read-only; the HOST indexes the workspace, by this hook on its side and by the sweep — cc-lib, WORKSPACES).
# The exit code is discarded: a failure is one line in cc-lib's misses log, which `cc-lib ask` reports
# as hook-misses, and a hook that cannot index never costs a session its commit.
# THE MEMORY INDEX SPLIT runs first, on the same terms (cc-lib memory): the MEMORY.md a session's prompt loads keeps its
# rule lines (type feedback, user) and a fact line (project, reference) a turn added moves to MEMORY-facts.md beside it,
# found by `cc-lib ask` — it rewrites nothing when nothing changed, so a running session's cached prompt is not moved.
[ "$STRICT" = 1 ] || [ -n "${CC_MEMBER_SANDBOX:-}" ] || [ ! -x "$BIN/cc-lib" ] || timeout 20 "$BIN/cc-lib" memory >/dev/null 2>&1 || true
[ "$STRICT" = 1 ] || [ -n "${CC_MEMBER_SANDBOX:-}" ] || [ ! -x "$BIN/cc-lib" ] || timeout 20 "$BIN/cc-lib" index --touch "$HOME/.cc/state" "$HOME/.claude/projects" >/dev/null 2>&1 || true
exec 8>&1   # the hook's real stdout: every exit below is inside a block that discards stdout, the relay is not
# A REFUSAL IS SAID OUT LOUD, not only written to checkpoint.err. The ece203 course seat worked four turns on a side
# branch this hook refused, nothing told it, and every commit of that day was lost until a later session went looking
# for the file (raised-checkpoint-refuses-a-study-branch, 2026-09-19). The Stop decision's reason is the only line a
# hook can put in front of a session, so a refusal takes it, ahead of the hand-off nudge when both have something to
# say — uncommitted work is the more urgent of the two. Never while the harness says a Stop hook already holds this
# turn open, and never when there is no harness listening (`--commit`, a run by hand): that is the nudge's own rule.
tell(){ [ -n "${payload:-}" ] || return 0
  case "${payload//[[:space:]]/}" in *'"stop_hook_active":true'*) return 0 ;; esac
  say=$1${say:+ }${say:-}; return 0; }
relay(){ [ -n "${say:-}" ] && printf '{"decision": "block", "reason": "%s"}\n' "${say//[\"\\]/}" >&8; return 0; }
trap relay EXIT   # on EVERY exit, including a session with no track at all, which leaves before the commit block
commit_end(){   # The hook stays nonblocking. Completion requires observable, clean committed work.
  [ "$STRICT" = 1 ] || exit 0
  local dirty
  dirty=$(git status --porcelain --untracked-files=all) || exit 1
  [ -z "$dirty" ] && git rev-parse --verify HEAD >/dev/null || exit 1
  exit 0
}
{
  root=$(git rev-parse --show-toplevel 2>/dev/null) || exit "$STRICT"
  [ -f "$root/.cc/track" ] || exit "$STRICT"
  cd "$root" || exit "$STRICT"
  # THE COMMIT PUSHES TOO, so it keeps its state where the caller says, exactly as --push does: `cc done` on a
  # member workspace hands both calls the same directory under ~/.cc/push-state, and nothing this hook writes
  # lands inside ~/.cc/worktrees/<handle>/<track>/.cc, which is bound read-write in the member's live boundary
  # (review of #225). Unset — the member's own Stop hook — it is the worktree's .cc, whose only writer owns the
  # tree. And never back into the worktree if that directory cannot be made — falling back would put the writes
  # exactly where the caller asked for them not to be — so nothing at all is done this turn and the next one
  # tries again (the same rule --push keeps; the hook's own exit stays 0, and a `--commit` completion fails, because
  # a completion whose receipt could not be written is not one).
  ST=${CC_CHECKPOINT_STATE_DIR:-$root/.cc}
  mkdir -p "$ST" 2>/dev/null; [ -d "$ST" ] || exit "$STRICT"
  refuse(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$ST/checkpoint.err"; tell "$1"; git reset -q 2>/dev/null; exit "$STRICT"; }   # unstage too: a refused secret must not sit in the index
  # …but NOT for a branch that moved under the worktree: nothing staged there is the hook's, and a pathspec-less
  # `git reset` is an update of HEAD that stamps its reflog — the same stamp the moved-branch guard below reads as
  # "this worktree's own move", so the next turn would skip the guard and commit the stale tree (review of #544).
  refuse_asis(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$ST/checkpoint.err"; tell "$1"; exit "$STRICT"; }
  track=$(sed -n 2p "$root/.cc/track"); branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
  own_branch "$track" "$branch" || refuse "refused: HEAD is '$branch', which is not this track's branch — NOTHING WAS COMMITTED this turn, and nothing will be until HEAD is back on 'track/$track' (or a side branch of it: <kind>/$track, or <kind>/$track-YYYY-MM-DD). checkpoint never commits a bare branch name or another track's."
  if [ "$STRICT" = 1 ]; then
    path_ids "$root" && [ "$branch" = "track/$WSTRACK" ] || refuse "refused: completion needs the canonical track"
  fi
  # THE BRANCH MOVED UNDER THIS WORKTREE. A second worktree on the same branch (`git checkout --ignore-other-worktrees`,
  # a subagent's hand fix) commits; the branch ref moves while this worktree's index and files still hold the old tip,
  # and to `git add -A` that is a staged diff UNDOING the fix — the next turn's commit would have landed it on an open
  # PR (raised-shared-branch-stages-a-revert, 2026-09-18, the ece206 seat). Brief: "the hook refuses to commit a diff
  # that reverts its own branch head" and "the second one's index is left clean". This worktree's OWN last move of
  # HEAD is the top of its per-worktree HEAD reflog (`git reflog show HEAD` — not HEAD@{0}, which git resolves to the
  # current tip, with a warning, when the two disagree); a branch past it was moved by somebody else.
  #  · advanced (the old tip is in the new one's history): the tree is carried to the new tip with the two-tree merge a
  #    checkout does (git read-tree -m -u) — a local edit to a file the fix did not touch rides along, one to a file it
  #    did refuses and touches nothing — and HEAD's reflog is stamped (reset --soft, moving nothing) so the move is seen
  #    once. The index is then clean of the revert, and only this seat's own edits can be committed below.
  #  · rewritten (it is not): refused outright — nothing here can say which tree is right, and the old tip is named.
  # A refusal here stamps nothing (refuse_asis, not refuse), so it comes back every turn until a person settles the
  # tree; the one stamp is the successful carry's. Otherwise turn two commits what turn one refused (review of #544).
  # NOT the literal "any staged revert of HEAD": a session that undoes its own last wip commit by editing the file back
  # stages exactly that, and a hook that refused it would pin the bad change on the branch (kept case in selfcheck).
  own=$(git reflog show --format=%H -1 HEAD 2>/dev/null); head=$(git rev-parse HEAD 2>/dev/null)
  if [ -n "$own" ] && [ -n "$head" ] && [ "$own" != "$head" ]; then
    git merge-base --is-ancestor "$own" "$head" 2>/dev/null \
      || refuse_asis "refused: $branch was rewritten under this worktree — its own last tip ${own:0:12} is not in the history of ${head:0:12}, so nothing was committed; 'git log ${own:0:12}' has this worktree's work"
    git read-tree -m -u "$own" "$head" 2>/dev/null \
      || refuse_asis "refused: $branch moved ${own:0:12} → ${head:0:12} under this worktree (another worktree committed on it) and a file that commit changed is edited here too, so nothing was committed; 'git diff ${own:0:12}' is this worktree's own work — put it on top of HEAD by hand"
    git reset -q --soft HEAD 2>/dev/null
    ( row_ids && journal_line "$repo" "$track" "$branch moved ${own:0:12} → ${head:0:12} under this worktree (another worktree committed on it); the tree here was carried to the new tip, nothing of it reverted or lost" )
  fi
  project_readme   # a project's repository describes the project, not the workspace it is a branch of
  git add -A 2>/dev/null || { [ "$STRICT" = 0 ] && exit 0; refuse "failed: git add"; }
  # NOTHING CHANGED THIS TURN — but a gap left by an earlier one does not close by itself, and a session that reads
  # "committed and pushed" into the silence of a quiet turn is exactly how a day's work stayed here. Only a track
  # that has pushed before is told (a lease on file), because one that never has may have nowhere to push at all.
  if git diff --cached --quiet 2>/dev/null; then
    # …and a commit this hook did not make is still a commit: push_catchup sends it — or finds the remote already
    # holds it — before push_gap decides anything, so a quiet turn reports only a push that really failed.
    if [ -e "$ST/pushed" ]; then branch_back "$branch"
      if push_catchup "$branch"; then push_gap "$branch" "nothing was committed this turn, so nothing was pushed either"
      else push_gap "$branch"; fi
    fi
    commit_end; fi
  bad=$(git diff --cached --diff-filter=A --name-only | grep -E "$SECRETS" | head -5 | tr '\n' ' ')   # only NEW files: a repo that already tracks .env.example is not leaking
  [ -z "$bad" ] || refuse "refused: staged files look like secrets: $bad (remove or ignore them, then the next turn commits)"
  files=$(git diff --cached --name-only | wc -l | tr -d ' ')
  # Commit identity: git's own config normally, overridden by CC_GIT_NAME/CC_GIT_EMAIL in ~/.cc/config
  # (read, not sourced — that file holds tokens and none of them belong in this git's environment).
  mapfile -t ident < <(ident_args)
  git "${ident[@]}" commit -q -m "wip: checkpoint $(date -u +%FT%TZ) [$files file(s)] [cc]" 2>/dev/null \
    || { [ "$STRICT" = 0 ] && exit 0; refuse "failed: git commit"; }
  rm -f "$ST/checkpoint.err"
  [ "$STRICT" = 0 ] || commit_end
  if pick_remote; then   # push failures never block, but they must not be invisible either (cc ls / digest show "push!")
    lease_push "$branch"; [ $? = 2 ] && lease_refused "$branch"
    push_gap "$branch"   # …and the session that made the commit hears it before the turn ends, whatever went wrong
  fi
} >/dev/null 2>&1
exit 0
