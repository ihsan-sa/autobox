#!/usr/bin/env bash
# cc-checkpoint — auto-commit+push a track worktree. Wired as a Claude Stop hook (runs after each turn).
#   cc-checkpoint          commit whatever changed and push it (the hook; always exits 0, never blocks a session)
#   cc-checkpoint --commit commit only; exit 1 on refusal, failed commit or remaining changes (used by cc done)
#   cc-checkpoint --push   push only, and exit non-zero saying why if it cannot — `cc done` calls this, because a
#                          PR on an un-pushed branch is worse than no PR
#   cc-checkpoint --remote where the push goes: the remote's name (making the repository if this is a member
#                          workspace project with none), or nothing and exit 1 if there is nowhere. `cc done`
#                          asks, so the PR it opens is against the repository the push went to
#   cc-checkpoint selfcheck  that rule, on fixtures of its own (check.sh runs it)
# It also records how full the session's context is (cc-context --record) and what it still owes Slack
# (cc-owed --check), for EVERY session, track or not: the Stop payload's `transcript_path` is the only
# handle on either, and this hook is where it arrives.
# Committing is what needs a track: no-op unless the cwd is inside one (marker: <worktree-root>/.cc/track). Never touches
# the primary worktree / default branch (no marker there), so main/planning sessions stay clean.
# Refuses (and logs to .cc/checkpoint.err) when HEAD is not the track's own branch — a session can rewrite
# HEAD with git symbolic-ref — or when the staged names look like secrets. Push stderr → .cc/push.err.
# The push carries whatever credential `cc-gh-token gitargs` gives it for that remote — a GitHub App token for
# the org this box has an app for, nothing at all for any other remote — so a repo whose only credential is the
# app pushes unattended. The token is minted for the push and nothing about it is written here. For a MEMBER
# WORKSPACE's track it is minted FOR that workspace, so it opens that workspace's repositories and no other
# member's (cc-gh-token, docs/design-member-workspaces.md).
# NO PUSH HERE CAN WAIT FOR A PERSON. Every one of them runs unattended, and a git with no credential asks for a
# username on the terminal, where nothing will ever answer: a member track sat 6h38m inside git-remote-https on
# that prompt, held its sandbox slot and reported nothing (2026-09-07). So every command below that reaches a
# remote goes through git_unattended — prompts off, askpass off, ssh in batch mode, and a hard bound on EACH
# (CC_PUSH_TIMEOUT, 120 s), because a transport that stalls with nothing to say is the same outage. A turn
# against a dead remote therefore costs a few minutes at worst, not a night. Hitting the bound is a failed push
# like any other: non-zero, with the reason on .cc/push.err, which `cc ls` and `cc digest` already show as
# `push!`. GETTING a credential to a member worker is #225's — the rule here is only that the push ENDS.
# WHERE IT PUSHES: `origin`, except a member workspace's project, which pushes to its OWN repository — the
# remote named after the track, or `origin` when origin is that repository (a workspace's first project is
# wired up as origin). Each project has its own repository (owner, 2026-09-03), so a workspace project with no
# remote at all gets one CREATED for it (cc-gh-token create) and pushed to, which is why work finished inside a
# workspace no longer sits on a local branch nobody else can see. Naming a project's repository something else
# is the owner's to do: bind it by adding a remote NAMED AFTER THE PROJECT, and nothing here reads the
# repository's own name again.
# AND NOWHERE ELSE. A workspace project whose repository could not be made has nowhere to push — never the
# workspace's `origin`, which is another project's repository; the reason is in .cc/create.err and the next
# turn tries again. After a push succeeds, the branch is REMOVED from any other repository the workspace
# remotes name, so opening a project's repository shows that project and not its neighbours (owner,
# 2026-09-04). Only a tip that is an ancestor of what was just pushed is removed; anything else is left and
# named in .cc/evict.err — never push.err, which means the push failed (review of #217). Nothing is created, and nothing removed, for anything but a member workspace's project.
# AND IT SAYS WHOSE IT IS: a project's branch is cut from the workspace's default branch, so it arrives
# carrying the WORKSPACE's README and the project's repository opens on a page about the workspace. While that
# README still opens with the workspace's own name — nobody having written a word of it for this project — the
# commit below replaces it with one naming the project. Retitled by anyone, it is never touched again.
# WHICH workspace and WHICH name that creation uses come from the worktree's own path,
# $HOME/.cc/worktrees/<repo>/<track>, and never from .cc/track: that file is bound read-WRITE into the member
# session, so what it says is the member's word, and naming a repository in the owner's org is an org-admin
# action he reserves to himself (review of #214). A worktree that is not under that path pushes to origin and
# gets nothing created, whatever .cc/track says.
# AND IT OPENS ON THE PROJECT'S BASE, NOT ON THE TRACK. GitHub takes an empty repository's default branch from the
# FIRST branch pushed into it, and a project's first push is its track — so every repository the box made opened
# on track/<project>, a clone came up on it, and `cc done` found no base branch there to open a PR against (#218).
# A repository created HERE is therefore marked (.cc/base-seed) and the next push sends the base branch first, then
# asks GitHub for it by name (cc-gh-token default) if the default is still something else. The base is the board's
# (cc-board base), never a track, whoever names it. Only a repository this file made is marked, so one the owner
# bound by hand is never pushed to or repointed behind his back; and repositories made before this are not touched —
# `cc-gh-token default <workspace> <project> <base>` fixes one, once.
# AND THAT BASE CARRIES THE PROJECT'S OWN README, because the retitle below runs on the track alone: without it
# the front page of a project's repository is the workspace's until the project's first PR merges. Not on the
# workspace's FIRST project, whose repository is the workspace's own `origin` — seed_head says why.
SECRETS='(^|/)(\.env[^/]*|.*\.(pem|key)|credentials[^/]*)$'
BIN=$(dirname "$(readlink -f "$0")")   # siblings come from the same bin/ as this copy
MODE=commit; STRICT=0
case "${1:-}" in --commit) STRICT=1;; --push) MODE=push;; --remote) MODE=remote;; selfcheck) MODE=selfcheck;; "") ;; *) echo "cc-checkpoint: unknown argument '$1'" >&2; exit 2;; esac
# ── no push waits for a person ───────────────────────────────────────────────────────────────────
PUSH_TIMEOUT=${CC_PUSH_TIMEOUT:-120}   # seconds. A track's push is seconds of work, so this is a wall, not a budget.
git_unattended(){   # git that can ask nobody anything and cannot run past the bound. Exit codes are git's, plus
  # 124/137 from `timeout`. Both locks are needed and neither is enough: the prompt locks turn "ask for a
  # username" into an error the caller can read, and the bound catches everything they do not — a credential
  # helper that blocks on its own, a connection accepted and then never answered. `timeout` runs the command in
  # a process group of its own and signals the GROUP, so the transport helper dies with it instead of outliving
  # the run (the lesson the gate runner learned on its own subprocesses, cc-steward:368).
  timeout -k 5 "$PUSH_TIMEOUT" env -u GIT_ASKPASS -u SSH_ASKPASS \
    GIT_TERMINAL_PROMPT=0 SSH_ASKPASS_REQUIRE=never \
    GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh} -o BatchMode=yes" \
    git -c core.askPass= "$@"; }
bound_hit(){   # $1 a git_unattended exit code, $2 the file its stderr went to.  0 when the bound fired.
  # `timeout` KILLS the command, so git wrote nothing at all — without this the push fails with an empty
  # push.err, which is the same silence the bound exists to end.
  case "$1" in 124|137) ;; *) return 1;; esac
  printf '%s the push to %s did not finish within %ss and was killed — nothing was pushed. A push that hangs this long has no credential it can use, or a remote that is not answering.\n' \
    "$(date -u +%FT%TZ)" "$remote" "$PUSH_TIMEOUT" >> "$2"; }
# ── the lease ────────────────────────────────────────────────────────────────────────────────────
# A track branch has exactly one writer, so a worker that rebased its own branch must still reach the remote. A
# plain push is rejected non-fast-forward there and the work never becomes a PR: on 2026-08-31 a track finished
# green with everything committed and NO PR, and only the watchdog noticed. So a DIVERGED push carries a lease:
# --force-with-lease with an EXPLICIT expected SHA, the one this worktree last pushed (.cc/pushed).
# The bare --force-with-lease is not good enough. It leases against refs/remotes/origin/<branch>, and any
# fetch (rebasing onto the default branch does one) refreshes that ref, after which it overwrites somebody
# else's commit without a murmur — measured, not assumed. Given an explicit value git compare-and-swaps against
# what is REALLY on the remote, so a refusal means exactly one thing: something this worktree did not write is on
# that branch. That is never overwritten and never swallowed — see lease_refused.
remote=origin   # every track on the box, until pick_remote says otherwise
workspace=''    # set only for a member workspace's track: the token is then minted for that workspace alone
WSREPO=''; WSTRACK=''   # this worktree's repo and track AS THE PATH SPELLS THEM — see the header
path_ids(){   # $1 worktree root → WSREPO/WSTRACK from $HOME/.cc/worktrees/<repo>/<track>.  1 = not one of those
  local base real rest
  base=$(readlink -f "$HOME/.cc/worktrees" 2>/dev/null) || return 1   # resolved on both sides: a symlinked HOME still matches
  real=$(readlink -f "$1" 2>/dev/null) || return 1
  rest=${real#"$base/"}; [ "$rest" != "$real" ] || return 1
  case "$rest" in */*/*) return 1 ;; */*) ;; *) return 1 ;; esac   # exactly <repo>/<track>: no deeper, no shallower
  WSREPO=${rest%%/*}; WSTRACK=${rest#*/}
  case "$WSREPO$WSTRACK" in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
  case "$WSREPO/$WSTRACK" in .*|*/.*) return 1 ;; esac   # no dotted half, so no . and no ..
  [ -n "$WSREPO" ] && [ -n "$WSTRACK" ]
}
pick_remote(){   # cwd = worktree root ($root).  0 there is somewhere to push · 1 there is not
  local url
  # A MEMBER WORKSPACE FIRST, and only then that workspace's own rules: the track-named remote below belongs
  # to a workspace project, not to every repo on the box, and asking for it first applied it to all of them
  # (review of #214). The path, never .cc/track — the header says why.
  if path_ids "$root" && [ -f "$HOME/dev/$WSREPO/.cc/member-workspace" ]; then
    workspace="$WSREPO"   # so the token is minted for this workspace and opens no other member's repository
    git remote get-url "$WSTRACK" >/dev/null 2>&1 && { remote="$WSTRACK"; return 0; }   # the project's own repository
    # A workspace's FIRST repository is wired up as its `origin` (cc-gh-token create), so origin IS this
    # project's repository when it carries this project's name, and there is nothing to create.
    case "$(git remote get-url origin 2>/dev/null)" in
      *"/$WSTRACK"|*"/$WSTRACK.git") remote=origin; return 0 ;;
    esac
    # "EACH PROJECT GETS ITS OWN GITHUB REPO" (owner, 2026-09-03) — so a member workspace's project that has
    # none gets one made for it here, even where the workspace itself has an origin: that origin is the
    # workspace's first project, not this one.
    # A reason it could not REPLACES the last one, in a file of its own: this runs every turn until the project
    # has a repository, so appending would grow for ever on a box with no app — and push.err belongs to the push.
    if url=$("$BIN/cc-gh-token" create "$WSREPO" "$WSTRACK" 2>"$root/.cc/create.err.tmp"); then
      rm -f "$root/.cc/create.err.tmp" "$root/.cc/create.err"
      remote="$WSTRACK"; git remote get-url "$WSTRACK" >/dev/null 2>&1 || remote=origin   # origin: the workspace had no remote at all, so this is its first
      git remote get-url "$remote" >/dev/null 2>&1 || return 1
      : > "$root/.cc/base-seed"   # brand new and empty: the next push sends the base FIRST, so its default is the base and not this track
      "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: created $url for this project — pushing there from now on" >/dev/null 2>&1
      return 0
    fi
    mv -f "$root/.cc/create.err.tmp" "$root/.cc/create.err" 2>/dev/null
    # Nothing could be created (no app, a name already someone else's, no network) — and for a workspace
    # project there is NOWHERE ELSE. `origin` is the workspace's FIRST project's repository, so falling back to
    # it pushes this project into another project's — which is how a project's branch came to be in a sibling
    # project's repository (measured, 2026-09-04). Nowhere to push is the honest answer: `cc done` ends on it (the
    # branch is the delivery), the reason is in .cc/create.err, and the next turn tries the creation again.
    return 1
  fi
  # Any other track on the box: origin is where it pushed yesterday, so the work reaches GitHub rather than nowhere.
  git remote get-url origin >/dev/null 2>&1
}
readme_text(){   # the front page a project's repository opens on, for the project named in $1. ONE copy of the
  # words, because two branches carry this file: the project's track (project_readme) and the base branch pushed
  # into the repository made for it (seed_head). Different words there and the project's first PR is a conflict in
  # the one file nobody wrote.
  printf '# %s\n\nA project of the %s workspace, and the only project in this repository.\nIts work is the `track/%s` branch.\n' "$1" "$WSREPO" "$1"; }
readme_is_stub(){   # 0 = the README on stdin is one THIS FILE wrote, whoever it names.  The WHOLE file is compared
  # against the template rebuilt from its own heading, so one word changed anywhere makes it somebody's words again.
  local t h; t=$(cat); h=$(printf '%s\n' "$t" | head -1)
  case "$h" in '# '?*) h=${h#\# } ;; *) return 1 ;; esac
  [ "$t" = "$(readme_text "$h")" ]; }
project_readme(){   # cwd = worktree root.  Always 0: this is one file, and never anyone's own words.
  # "he opened [a project's repository] and found the workspace — its README ('scratch project for trying the
  # box out'), with no [project] code" (owner, 2026-09-04). A workspace is one git repo and a project is a
  # BRANCH of it, so a project's branch is cut from the workspace's default branch and carries the workspace's
  # README into the repository made for that project — whose front page then describes the workspace.
  # THE HEADING IS THE WHOLE TEST. While README.md still opens with the WORKSPACE's own name, nobody has
  # written a word of it for this project and it is replaced by one that names the project. Retitle it — the
  # member, their session, anyone, one word — and nothing here ever touches it again.
  # The path, never .cc/track, for the reason the header gives: that file is the member's word.
  path_ids "$root" || return 0
  [ -f "$HOME/dev/$WSREPO/.cc/member-workspace" ] || return 0
  git ls-files --error-unmatch README.md >/dev/null 2>&1 || return 0   # inherited from the branch, not a file this turn wrote
  git diff --quiet HEAD -- README.md 2>/dev/null || return 0            # and untouched this turn: words somebody wrote are theirs (review of #217)
  # A STUB THIS FILE WROTE is nobody's words whichever project it names, so where it came from is not asked. A
  # track cut from a sibling project's repository inherits that sibling's stub — the base branch there carries one
  # now (seed_head) — and the workspace's own name is no longer in the heading for the test below to catch.
  if [ -f README.md ] && readme_is_stub < README.md; then
    [ "$(head -1 README.md)" = "# $WSTRACK" ] || readme_text "$WSTRACK" > README.md
    return 0; fi
  # STILL THE FILE THE BRANCH INHERITED: the same blob the workspace's default branch had where this branch was cut
  # from it. Words committed under the old heading on an earlier turn are theirs too, and "clean against HEAD" says
  # nothing about those (review of #217). No default branch to ask, no merge-base: leave it.
  local def mb; for def in main master "$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null)"; do
    [ -n "$def" ] && git rev-parse -q --verify "refs/heads/${def#origin/}" >/dev/null 2>&1 && { def=${def#origin/}; break; }
    [ -n "$def" ] && git rev-parse -q --verify "refs/remotes/$def" >/dev/null 2>&1 && { def="refs/remotes/$def"; break; }; def=""; done
  [ -n "$def" ] || return 0
  mb=$(git merge-base HEAD "$def" 2>/dev/null) || return 0
  [ "$(git rev-parse -q --verify HEAD:README.md 2>/dev/null)" = "$(git rev-parse -q --verify "$mb:README.md" 2>/dev/null)" ] || return 0
  [ -f README.md ] && [ "$(head -1 README.md 2>/dev/null)" = "# $WSREPO" ] || return 0
  readme_text "$WSTRACK" > README.md
  return 0
}
url_key(){   # one repository, however its url is spelled: case, .git, a trailing /, the scheme, the user, the scp form
  local u=${1%/}; u=${u%.git}; u=${u,,}
  u=${u#ssh://}; u=${u#https://}; u=${u#http://}; u=${u#git://}; u=${u#*@}
  case "$u" in *:*/*) u=${u/:/\/} ;; esac   # git@host:org/repo → host/org/repo
  printf '%s\n' "$u"; }
base_branch(){   # the project's base branch, cwd = worktree root. The board's, and never a track, whoever names it:
  # origin/HEAD is only what a REMOTE calls its default, and for a repository the box made that is the first branch
  # pushed into it. Same rule and same order as cc's default_branch().
  local b; b=$("$BIN/cc-board" base "$WSREPO" 2>/dev/null)
  case "$b" in track/*|'') b=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##') ;; esac
  case "$b" in track/*|'') b=main ;; esac
  printf '%s\n' "$b"; }
ident_args(){   # the `git -c` arguments a commit made by this file is authored with: CC_GIT_NAME/CC_GIT_EMAIL from
  # ~/.cc/config (read, not sourced — that file holds tokens), and git's own config where they are unset.
  local n e
  n=$("$BIN/cc-config" get CC_GIT_NAME);  [ -n "$n" ] && printf -- '-c\nuser.name=%s\n' "$n"
  e=$("$BIN/cc-config" get CC_GIT_EMAIL); [ -n "$e" ] && printf -- '-c\nuser.email=%s\n' "$e"
  return 0; }
seed_head(){   # $1 = the base branch's tip → the commit the new repository's base branch is created at.
  # AND IT OPENS ON THE PROJECT'S README, NOT THE WORKSPACE'S. The base is the WORKSPACE's branch and carries the
  # workspace's README; the retitle (project_readme) only ever runs on the track. So the repository made for a
  # project opened on a page about the workspace and stayed there until the project's first PR merged — which for a
  # living project may be never. The base is therefore pushed with the project's README already on it: one commit,
  # built with plumbing, and REFS/HEADS/<BASE> NEVER MOVES — that is one branch shared by every project in the
  # workspace, and a commit on it here would follow the next project into its repository.
  # THE COMMIT IT IS SEEDED WITH IS ON THE TRACK. A commit only the base has changes README.md against the merge
  # base, so the moment the session writes its own README the project's FIRST PR conflicts in the one file nobody
  # wrote, which is what this seeding was added to prevent (review of #238). So it is merged into the track
  # before it is pushed, and the base is then an ANCESTOR of the branch whose PR merges into it. The merge keeps
  # the track's tree to the letter: both sides carry the same README blob and the seed touches nothing else, so
  # no file on the branch moves and nothing is rewritten. If it cannot be put there, the base goes unseeded.
  # ONLY A STUB THIS FILE WROTE. A README somebody wrote is theirs, and copying it onto a branch they did not write
  # is not this file's to do; their words reach the base the ordinary way, when the project's first PR merges.
  # NOT WHEN THIS REPOSITORY IS THE WORKSPACE'S OWN ORIGIN. A workspace with no remote of its own has its FIRST
  # project's repository wired up as `origin` (cc-gh-token create), and that base branch is then the one
  # ~/dev/<workspace> itself sits on, pushes and pulls. A commit there the workspace does not have turns its
  # `git push origin <base>` into a non-fast-forward rejection, and the pull that clears it retitles the WORKSPACE's
  # README with a project's — words written for the member, which nothing here would put back. So that one
  # repository opens on the workspace until the project's first PR merges. Every later project of the workspace has
  # a repository of its own and is seeded.
  local tip="$1" want tree new idx prev head branch merged; local -a ident=()
  [ "$(url_key "$(git remote get-url "$remote" 2>/dev/null)")" = "$(url_key "$(git remote get-url origin 2>/dev/null)")" ] \
    && { printf '%s\n' "$tip"; return 0; }
  # NOT WHEN THE BASE HAS MOVED ON SINCE THE TRACK WAS CUT. The seed goes onto the track as a merge carrying the
  # TRACK's tree — "take this side entire" — which is exact while the track holds everything refs/heads/<base>
  # holds, and a silent revert of everything the base gained after the cut when it does not: that branch is shared
  # by the whole workspace and moves without this track, so a later commit on it would be merged away here and
  # then leave the new repository's base the moment the project's first PR landed (review of #238). Merging it in
  # for real is this file resolving somebody's branch for them, which it does not do. So that base goes unseeded:
  # the repository opens on the workspace's README until the first PR merges — where it was before any of this.
  git merge-base --is-ancestor "$tip" HEAD 2>/dev/null || { printf '%s\n' "$tip"; return 0; }
  want=$(git rev-parse -q --verify HEAD:README.md 2>/dev/null)
  [ -n "$want" ] && [ "$want" != "$(git rev-parse -q --verify "$tip:README.md" 2>/dev/null)" ] || { printf '%s\n' "$tip"; return 0; }
  git cat-file -p "$want" 2>/dev/null | readme_is_stub || { printf '%s\n' "$tip"; return 0; }
  # A push that never reached the remote keeps the marker and comes back next turn, so the commit already merged
  # into the track is reused: rebuilt from scratch it is a new sha, and a repository unreachable for a week would
  # collect one merge a turn. Reused only while it is still that commit — on the track, on this base tip, this README.
  prev=$(cat "$root/.cc/base-seed" 2>/dev/null)
  if [ -n "$prev" ] && [ "$(git rev-parse -q --verify "$prev^" 2>/dev/null)" = "$tip" ] \
     && [ "$(git rev-parse -q --verify "$prev:README.md" 2>/dev/null)" = "$want" ] \
     && git merge-base --is-ancestor "$prev" HEAD 2>/dev/null; then printf '%s\n' "$prev"; return 0; fi
  idx="$root/.cc/seed.idx"; rm -f "$idx"
  GIT_INDEX_FILE="$idx" git read-tree "$tip" 2>/dev/null \
    && GIT_INDEX_FILE="$idx" git update-index --add --cacheinfo "100644,$want,README.md" 2>/dev/null \
    && tree=$(GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null)
  rm -f "$idx"
  mapfile -t ident < <(ident_args)
  # No identity anywhere, no tree: push the base as it is. A front page one turn late beats a repository with none.
  [ -n "${tree:-}" ] && new=$(git "${ident[@]}" commit-tree "$tree" -p "$tip" -m "README: this repository is the $WSTRACK project" 2>/dev/null)
  [ -n "${new:-}" ] || { printf '%s\n' "$tip"; return 0; }
  # …and onto the track, as a merge carrying the track's own tree. HEAD is the track's branch here — the push path
  # and the hook both refuse to go on when it is not — and the ref only ever moves forward: HEAD is the first parent.
  branch=$(git symbolic-ref -q --short HEAD 2>/dev/null); head=$(git rev-parse -q --verify HEAD 2>/dev/null)
  [ -n "$branch" ] && [ -n "$head" ] \
    && merged=$(git "${ident[@]}" commit-tree "$(git rev-parse -q --verify "$head^{tree}")" -p "$head" -p "$new" \
        -m "merge the base branch this project's repository was seeded with" 2>/dev/null) \
    && git update-ref -m 'cc-checkpoint: the base this repository is seeded with' "refs/heads/$branch" "$merged" "$head" 2>/dev/null \
    || { printf '%s\n' "$tip"; return 0; }   # not on the track, so not pushed as the base: a front page is not worth a conflict
  printf '%s\n' "$new" > "$root/.cc/base-seed"   # …and it is this commit again next turn if the push does not land
  printf '%s\n' "$new"; }
seed_base(){   # cwd = worktree root, $remote and $cred from lease_push.  Always 0: seeding is not the push.
  # The header's "AND IT OPENS ON THE PROJECT'S BASE": a repository created here is empty, GitHub gives it whichever
  # branch lands first, and the track landing first is the whole bug. So the base goes first, and if that still did
  # not make it the default it is asked for by name. Once, at creation — a repository the owner bound himself has no
  # marker and is never touched. Not reaching the remote at all keeps the marker: the next turn tries again, and the
  # track push in this one is failing for the same reason anyway.
  local base def err tip send
  [ -n "$workspace" ] && [ -f "$root/.cc/base-seed" ] || return 0
  base=$(base_branch)
  # A base this checkout does not have cannot be pushed. That used to drop the marker and say nothing at all, so
  # the repository went on opening on the track and no later turn tried again: the board hears it, once.
  tip=$(git rev-parse -q --verify "refs/heads/$base" 2>/dev/null) || {
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: this project's repository was made, but its base branch '$base' is not in this checkout — nothing was seeded, so it opens on whichever branch landed first" >/dev/null 2>&1
    rm -f "$root/.cc/base-seed"; return 0; }
  send=$(seed_head "$tip"); [ -n "$send" ] || send="$tip"   # an EMPTY source in a refspec DELETES the branch: never that
  if ! err=$(git_unattended "${cred[@]}" push -q "$remote" "$send:refs/heads/$base" 2>&1); then
    grep -qE 'rejected|non-fast-forward|already exists' <<<"$err" || return 0   # could not reach it: try again next turn
  fi
  def=$(git_unattended "${cred[@]}" ls-remote --symref "$remote" HEAD 2>/dev/null | sed -n 's#^ref: refs/heads/\([^[:space:]]*\).*$#\1#p' | head -1)
  if [ "$def" != "$base" ] && ! "$BIN/cc-gh-token" default "$workspace" "$WSTRACK" "$base" >/dev/null 2>&1; then
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $base is in this project's repository but its default branch is still ${def:-whichever branch arrived first} — 'cc-gh-token default $WSREPO $WSTRACK $base' sets it" >/dev/null 2>&1
  fi
  rm -f "$root/.cc/base-seed"; return 0; }
evict_elsewhere(){   # $1 = the branch just pushed to $remote, cwd = worktree root.  Always 0: this is tidying.
  # EACH PROJECT'S REPOSITORY HOLDS THAT PROJECT AND NO OTHER. A workspace is one git repo whose projects are
  # branches, so before this every project's branch reached the workspace's first repository too and the
  # repositories differed only by branch: opening one project's repository showed a sibling project's work and
  # none of its own (owner, 2026-09-04, twice). Once a branch is safely in its own repository it is taken out of the
  # others, so a workspace heals itself with nobody present and stays healed.
  # BY URL, NEVER BY REMOTE NAME: the owner binds a project to a repository he already has by adding a remote
  # named after the project, so two remote names are often one repository — and "the other remote" would then
  # be the project's own, deleted out from under it.
  # NOTHING IS LOST AND NO HISTORY IS REWRITTEN: the other repository's tip must be an ancestor of what was
  # just pushed, so every commit it drops is present here and in the project's own repository. A tip that is
  # not, or one whose object this worktree does not have, is left alone and written to .cc/evict.err — a file of
  # its own, replaced each run: push.err means the push FAILED, and a note there after a push that succeeded lit
  # `push!` for ever (review of #217).
  local branch="$1" own o url sha name
  [ -n "$workspace" ] || return 0   # only a member workspace's project has sibling projects to contaminate
  own=$(url_key "$(git remote get-url "$remote" 2>/dev/null)"); [ -n "$own" ] || return 0
  rm -f "$root/.cc/evict.err.tmp"
  for o in $(git remote); do
    url=$(git remote get-url "$o" 2>/dev/null)
    [ "$(url_key "$url")" != "$own" ] || continue
    grep -qxF "$url" "$root/.cc/evict.same" 2>/dev/null && continue   # known to be this project's own repository under another spelling: never cycled again
    local -a c=(); mapfile -t c < <("$BIN/cc-gh-token" gitargs "$url" "$workspace" 2>/dev/null)
    sha=$(git_unattended "${c[@]}" ls-remote --heads "$o" "refs/heads/$branch" 2>/dev/null | awk 'NR==1{print $1}')
    [ -n "$sha" ] || continue   # it does not have this branch, or it could not be asked: nothing to remove either way
    if ! git merge-base --is-ancestor "$sha" "$branch" 2>/dev/null; then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o still holds $branch at $sha, which is not in this branch — left alone. This project pushes to $remote; move or delete that branch by hand." >> "$root/.cc/evict.err.tmp"
      continue; fi
    name=$(url_key "$url"); name=${name##*/}   # the normalised url, so a trailing / does not leave the note naming nothing
    # A delete the other repository REFUSES — GitHub refuses a repository's default branch, and an empty repository
    # takes its default from the first branch pushed into it, which can be the sibling's — is the case that leaves
    # the contamination in place, so it is said, not swallowed (review of #217).
    if ! err=$(git_unattended "${c[@]}" push -q "$o" --delete "refs/heads/$branch" 2>&1); then
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o still holds $branch — the delete was refused: $(tr '\n' ' ' <<<"$err" | cut -c1-160). Delete or retarget it by hand; a repository's default branch cannot be deleted, so point that repository's default at its own project's branch first." >> "$root/.cc/evict.err.tmp"
      continue; fi
    # A URL IS NOT A REPOSITORY'S IDENTITY. The same repository under a spelling url_key cannot unify (ssh and
    # https, a symlink) has just had its branch deleted out from under it — so ask the project's own remote
    # whether the branch is still there, and if the answer is that it is gone, put it back and say so (review of
    # #217). An ask that failed says nothing either way and changes nothing.
    still=$(git_unattended "${cred[@]}" ls-remote --heads "$remote" "refs/heads/$branch" 2>/dev/null); src=$?
    if [ "$src" = 0 ] && [ -z "$still" ]; then
      git_unattended "${cred[@]}" push -q -u "$remote" "$branch" 2>/dev/null
      printf '%s\n' "$url" >> "$root/.cc/evict.same"   # remembered: deleting and restoring it every turn would close any open PR on the branch (review of #217)
      printf '%s %s\n' "$(date -u +%FT%TZ)" "$o is this project's own repository under another spelling — its branch was put back and that remote is skipped from now on. Keep one remote for it." >> "$root/.cc/evict.err.tmp"
      continue; fi
    "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $branch removed from ${name:-$o} — this project's work is in its own repository now, not that one" >/dev/null 2>&1
  done
  # The two cases that need a person — a branch left in a sibling repository, a duplicate remote — are heard the
  # way a delete is: on the board, once per change and not every turn (the file carries a timestamp per run, so it
  # is compared without them). Nothing on the box reads evict.err by itself (review of #217).
  if [ -s "$root/.cc/evict.err.tmp" ]; then
    if ! cmp -s <(cut -d' ' -f2- "$root/.cc/evict.err.tmp") <(cut -d' ' -f2- "$root/.cc/evict.err" 2>/dev/null); then
      "$BIN/cc-board" note "$WSREPO" "$WSTRACK" "github: $(cut -d' ' -f2- "$root/.cc/evict.err.tmp" | paste -sd' ' -)" >/dev/null 2>&1; fi
    mv -f "$root/.cc/evict.err.tmp" "$root/.cc/evict.err"
  else rm -f "$root/.cc/evict.err.tmp" "$root/.cc/evict.err"; fi
  return 0
}
lease_push(){   # $1 = branch, cwd = worktree root.  0 pushed · 1 push failed · 2 the lease was refused
  local branch="$1" lease prc
  # The credential. `cc-gh-token gitargs` prints the `git -c …` arguments that authenticate as this box's
  # GitHub App — and prints NOTHING for a remote the app does not cover, or on a box with no app, so every
  # other push still uses whatever helper ~/.gitconfig gives it. Without this a member project's push has no
  # credential at all and stops on "could not read Username", which is how two finished branches sat unpushed.
  local -a cred=(); mapfile -t cred < <("$BIN/cc-gh-token" gitargs "$(git remote get-url "$remote" 2>/dev/null)" "$workspace" 2>/dev/null)
  seed_base   # a repository just made for this project takes its default from the FIRST branch pushed: the base goes ahead of the track
  # Plain push FIRST, and force nothing when it works: a fast-forward never needed a lease. It is also how a
  # branch that has taken the other writer's commit in (git rebase origin/<branch>) clears itself — a stale
  # .cc/pushed would otherwise refuse that branch for ever, and a block nobody can lift is its own outage.
  git_unattended "${cred[@]}" push -q -u "$remote" "$branch" 2>"$root/.cc/push.err.tmp"; prc=$?
  [ "$prc" = 0 ] && { lease_keep "$branch"; evict_elsewhere "$branch"; return 0; }
  bound_hit "$prc" "$root/.cc/push.err.tmp"   # killed at the bound: git said nothing, so the reason is written here
  grep -qE 'non-fast-forward|fetch first' "$root/.cc/push.err.tmp" || { mv "$root/.cc/push.err.tmp" "$root/.cc/push.err"; return 1; }   # not a divergence: a plainly broken push (no network, no permission)
  lease=$(cat "$root/.cc/pushed" 2>/dev/null)
  # Nothing recorded yet (a track older than .cc/pushed): the tracking ref is the best account of the remote we
  # have, and one push from here replaces the guess with the real thing.
  [ -n "$lease" ] || lease=$(git rev-parse -q --verify "refs/remotes/$remote/$branch" 2>/dev/null)
  if [ -n "$lease" ]; then
    git_unattended "${cred[@]}" push -q -u --force-with-lease="refs/heads/$branch:$lease" "$remote" "$branch" 2>"$root/.cc/push.err.tmp"; prc=$?
    [ "$prc" = 0 ] && { lease_keep "$branch"; evict_elsewhere "$branch"; return 0; }
    bound_hit "$prc" "$root/.cc/push.err.tmp"
    mv "$root/.cc/push.err.tmp" "$root/.cc/push.err"
    grep -qE 'stale info|non-fast-forward|fetch first' "$root/.cc/push.err" && return 2
    return 1; fi
  mv "$root/.cc/push.err.tmp" "$root/.cc/push.err"; return 2   # diverged with nothing to lease against: assume the worst, out loud
}
lease_keep(){ git rev-parse "$1" > "$root/.cc/pushed" 2>/dev/null   # next time's lease: what the remote holds, because we just put it there
  rm -f "$root/.cc/push.err" "$root/.cc/push.err.tmp"; }
lease_refused(){   # a write this worktree did not make, on a single-writer branch: say so three ways, never none
  local branch="$1" repo track st msg
  repo=$(sed -n 1p "$root/.cc/track" 2>/dev/null); track=$(sed -n 2p "$root/.cc/track" 2>/dev/null)
  msg="push refused: $remote/$branch is not what this worktree last pushed, so something else wrote to that branch. The work is committed here and was NOT overwritten. Read 'git fetch $remote && git log $remote/$branch' before anything else."
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$msg" >> "$root/.cc/push.err"
  [ -n "$repo" ] && [ -n "$track" ] || return 0
  "$BIN/cc-board" note "$repo" "$track" "$msg" >/dev/null 2>&1
  st="$HOME/.cc/state/$repo/$track/progress.md"; mkdir -p "$(dirname "$st")" 2>/dev/null || return 0   # a track whose journal has not been started yet is still owed the warning
  # cc-loop greps ^STATUS: BLOCKED out of the journal after every iteration and stops the track there (board
  # `waiting`, owner told once) — that is the whole point of writing it. Only skipped when the journal ALREADY
  # ends with this, so a hook firing every turn cannot spam it; anything else and it is said again. Loud twice
  # beats silent once, which is the bug this file exists to close.
  [ "$(grep -v '^[[:space:]]*$' "$st" | tail -1)" = "STATUS: BLOCKED: $msg" ] && return 0
  printf '\n%s cc-checkpoint: %s\nSTATUS: BLOCKED: %s\n' "$(date -u +%FT%TZ)" "$msg" "$msg" >> "$st"; }
selfcheck(){   # the pick_remote rule, on fixtures of its own: a HOME, workspaces and repos it builds here, and
  # a cc-gh-token that RECORDS what it was asked to create instead of creating anything. No repository of this
  # box's is read, no token is minted, nothing reaches GitHub and no directory outside the temp dir is written.
  local n=0 f=0 out rc d bin
  k(){ n=$((n+1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else echo "  FAIL $2 — $3"; f=$((f+1)); fi; }
  eq(){ k "$([ "$2" = "$3" ] && echo 0 || echo 1)" "$1" "got '$2', wanted '$3'"; }
  T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
  HOME="$T/home"; export HOME GIT_CONFIG_GLOBAL="$T/gitconfig" GIT_CONFIG_SYSTEM=/dev/null
  bin="$T/bin"; mkdir -p "$bin" "$HOME/.cc/worktrees" "$HOME/dev"
  cp "$(readlink -f "$0")" "$bin/cc-checkpoint"   # a COPY: a symlink resolves back to core/bin, and the stubs beside it would never be reached
  CALLS="$T/calls"; NOTES="$T/notes"; DEFS="$T/defaults"; export CALLS NOTES DEFS
  # `default` stands in for GitHub the way `create` does, and records into a file of its own so the create cases
  # above still read a $CALLS with one line in it. BARE, when the case sets it, makes `create` a real bare repo the
  # seeding below can actually push into.
  cat > "$bin/cc-gh-token" <<'SH'
#!/usr/bin/env bash
if [ "$1" = default ]; then printf '%s\n' "$*" >> "$DEFS"
  [ -z "${CC_NODEFAULT:-}" ] || { echo "GitHub refused" >&2; exit 1; }
  git -C "$BARE/$3.git" symbolic-ref HEAD "refs/heads/$4" 2>/dev/null; exit 0; fi
printf '%s\n' "$*" >> "$CALLS"
[ "$1" = create ] || exit 0
[ -z "${CC_FAIL:-}" ] || { echo "GitHub refused to create $3" >&2; exit 1; }
u="https://example.test/org/$3.git"; [ -z "${BARE:-}" ] || { git init -q --bare "$BARE/$3.git"; u="$BARE/$3.git"; }
rn=origin; [ -z "$(git remote 2>/dev/null)" ] || rn="$3"   # cc-gh-token's own rule: a workspace's FIRST repository is its origin
git remote add "$rn" "$u" 2>/dev/null
echo "https://example.test/org/$3"
SH
  # `base` is the board answering what the project's base branch is, and the REAL cc-board answers it, on a real
  # board under this fixture's HOME (`setbase` below writes one). A stub answering it would prove the stub: this
  # file called `base` for a whole PR before cc-board had the subcommand (review of #230). Every other subcommand
  # is recorded instead of run — the board-note cases read $NOTES.
  REALBIN="$BIN"; export REALBIN
  printf '#!/usr/bin/env bash\n[ "$1" = base ] && exec "$REALBIN/cc-board" "$@"\nprintf "%%s\\n" "$*" >> "$NOTES"\n' > "$bin/cc-board"
  setbase(){ "$BIN/cc-board" init "$1" "$HOME/dev/$1" "$2" >/dev/null; }   # what the board records as this repo's base
  nobase(){ rm -f "$HOME/.cc/boards/$1.json"; }                            # …and back to a repo with no board at all
  printf '#!/usr/bin/env bash\nexit 0\n' > "$bin/cc-config"   # the commit cases below ask it for a git identity; the fixture's gitconfig has one
  chmod +x "$bin/cc-gh-token" "$bin/cc-board" "$bin/cc-config"
  printf '[user]\n\tname = t\n\temail = t@t\n' > "$T/gitconfig"
  ws(){ mkdir -p "$HOME/dev/$1/.cc"; : > "$HOME/dev/$1/.cc/member-workspace"; }   # the marker IS the workspace
  mkwt(){   # $1 <repo>/<track> (or an absolute path, for a worktree that is not one of ours), then name/url pairs
    local p="$1"; shift; case "$p" in /*) ;; *) p="$HOME/.cc/worktrees/$p" ;; esac
    mkdir -p "$p/.cc"; git init -q "$p" 2>/dev/null
    while [ "$#" -gt 1 ]; do git -C "$p" remote add "$1" "$2"; shift 2; done
    printf '%s\n' "$p"; }
  run(){ : > "$CALLS"; : > "$NOTES"; ( cd "$1" && env CC_FAIL="${2:-}" "$bin/cc-checkpoint" --remote 2>/dev/null ); }
  ws ws1; ws ws2
  # NOT a member workspace, and it has a remote named after the track: origin still wins, and nothing is ever
  # created for it. The kept case and the suppressed one in one fixture (review of #214: this rule ran first
  # and so applied to every repo on the box).
  d=$(mkwt myrepo/t1 origin https://example.test/org/myrepo.git t1 https://example.test/org/t1.git)
  printf 'myrepo\nt1\n' > "$d/.cc/track"
  eq "plain repo: origin, not the remote named after the track" "$(run "$d")" origin
  eq "plain repo: nothing is created for it" "$(cat "$CALLS")" ""
  # A member workspace's project, with its own repository already wired up: that one, not the workspace's origin.
  d=$(mkwt ws1/proj1 origin https://example.test/org/first.git proj1 https://example.test/org/proj1.git)
  printf 'ws1\nproj1\n' > "$d/.cc/track"
  eq "workspace project: its own remote wins over the workspace's origin" "$(run "$d")" proj1
  eq "workspace project: nothing is created when it has one" "$(cat "$CALLS")" ""
  # The workspace's FIRST project is wired up as `origin` (cc-gh-token create), so origin IS that project's
  # repository when it carries the project's name — and nothing is created a second time.
  d=$(mkwt ws1/proj2 origin https://example.test/org/proj2.git)
  printf 'ws1\nproj2\n' > "$d/.cc/track"
  eq "workspace project: origin when origin is this project's repository" "$(run "$d")" origin
  eq "workspace project: and nothing created for it" "$(cat "$CALLS")" ""
  # A workspace project with no repository at all: one is made for it, the board hears once, and the push has
  # somewhere to go. This workspace has no remote either, so its first repository is `origin`.
  d=$(mkwt ws2/proj3); printf 'ws2\nproj3\n' > "$d/.cc/track"
  eq "workspace project with no remote: a repository is created for it" "$(run "$d")" origin
  eq "created for the workspace and project that own it" "$(cat "$CALLS")" "create ws2 proj3"
  k "$(grep -q 'github: created https://example.test/org/proj3' "$NOTES" && echo 0 || echo 1)" "the board is told which repository was made" "$(cat "$NOTES")"
  # The same, for a workspace that already has an origin: that origin is its FIRST project, not this one, so
  # this project still gets its own repository — under its own name.
  d=$(mkwt ws1/proj4 origin https://example.test/org/first.git); printf 'ws1\nproj4\n' > "$d/.cc/track"
  eq "second project of a workspace: its own repository, not the workspace's origin" "$(run "$d")" proj4
  eq "second project: created under the project's name" "$(cat "$CALLS")" "create ws1 proj4"
  # THE ONE THAT MATTERS. .cc/track is bound read-WRITE into the member session, so it is the member's word;
  # the worktree's path is not. A .cc/track naming another workspace and a free name must not become an
  # org-admin call for that name (review of #214).
  d=$(mkwt ws1/proj5); printf 'ws2\nvictim\n' > "$d/.cc/track"
  out=$(run "$d")
  eq "a lying .cc/track creates the path's own project" "$(cat "$CALLS")" "create ws1 proj5"
  eq "and the lying .cc/track's remote is not what is pushed to" "$out" origin
  # A worktree that is not under ~/.cc/worktrees cannot be trusted to name anything: origin only, nothing made.
  d=$(mkwt "$T/loose"); printf 'ws1\nloose\n' > "$d/.cc/track"
  out=$(run "$d"); rc=$?
  eq "a worktree outside ~/.cc/worktrees: nothing is created for it" "$(cat "$CALLS")" ""
  k "$([ "$rc" = 1 ] && [ -z "$out" ] && echo 0 || echo 1)" "and with no origin it answers that there is nowhere to push" "rc=$rc out='$out'"
  # A creation that could not happen leaves its reason where the next turn replaces it, and does NOT fall back
  # to the workspace's origin: that origin is the first project's repository, and pushing there is exactly the
  # contamination this file is here to stop (owner, 2026-09-04).
  d=$(mkwt ws2/proj6 origin https://example.test/org/first.git); printf 'ws2\nproj6\n' > "$d/.cc/track"
  out=$(run "$d" 1); rc=$?
  k "$([ "$rc" = 1 ] && [ -z "$out" ] && echo 0 || echo 1)" "a failed creation does not push into another project's repository" "rc=$rc out='$out'"
  k "$(grep -q 'refused to create proj6' "$d/.cc/create.err" && echo 0 || echo 1)" "and leaves the reason in .cc/create.err" "$(cat "$d/.cc/create.err" 2>/dev/null)"
  d=$(mkwt ws2/proj7); printf 'ws2\nproj7\n' > "$d/.cc/track"
  out=$(run "$d" 1); rc=$?
  k "$([ "$rc" = 1 ] && [ -z "$out" ] && echo 0 || echo 1)" "a failed creation with no origin: nowhere to push, and it says so" "rc=$rc out='$out'"
  # ── the branch ends up in the project's repository and is taken out of the other projects' ──────────
  bare(){ git init -q --bare "$T/$1.git"; printf '%s\n' "$T/$1.git"; }
  mkproj(){   # $1 <ws>/<track>, then name/url pairs → a worktree on track/<track> carrying one commit of its own
    local p t; p=$(mkwt "$@"); t=${1#*/}
    printf '%s\n%s\n' "${1%%/*}" "$t" > "$p/.cc/track"
    git -C "$p" symbolic-ref HEAD "refs/heads/track/$t"
    echo "$t" > "$p/work.txt"; git -C "$p" add -A
    git -C "$p" -c user.name=t -c user.email=t@t commit -q -m "$t"
    printf '%s\n' "$p"; }
  has(){ git ls-remote --heads "$1" "refs/heads/$2" 2>/dev/null | grep -q .; }
  mkproj_main(){   # like mkproj, but the branch is cut from a `main` that already carries the workspace's README — as a workspace's is
    local p t ws; p=$(mkwt "$@"); t=${1#*/}; ws=${1%%/*}
    printf '%s\n%s\n' "$ws" "$t" > "$p/.cc/track"
    git -C "$p" symbolic-ref HEAD refs/heads/main
    printf '# %s\n\nscratch workspace\n' "$ws" > "$p/README.md"; git -C "$p" add -A
    git -C "$p" -c user.name=t -c user.email=t@t commit -q -m inherited
    git -C "$p" checkout -q -b "track/$t"; echo "$t" > "$p/work.txt"; git -C "$p" add -A
    git -C "$p" -c user.name=t -c user.email=t@t commit -q -m "$t"
    printf '%s\n' "$p"; }
  runp(){ : > "$CALLS"; : > "$NOTES"; ( cd "$1" && "$bin/cc-checkpoint" --push >/dev/null 2>&1 ); }
  ws ws3
  # A workspace's first repository holding a second project's branch — the shape measured on a real workspace
  # on 2026-09-04. The branch is pushed to the project's own repository and then removed from that one.
  oa=$(bare ownA); ta=$(bare otherA)
  d=$(mkproj ws3/projA origin "$ta" projA "$oa"); git -C "$d" push -q origin track/projA
  runp "$d"
  k "$(has "$oa" track/projA && echo 0 || echo 1)" "the branch is in the project's own repository" "not on $oa"
  k "$(has "$ta" track/projA && echo 1 || echo 0)" "and is taken out of the other project's repository" "still on $ta"
  k "$(grep -q 'removed from' "$NOTES" && echo 0 || echo 1)" "the board is told what was removed" "$(cat "$NOTES")"
  # A tip over there that is NOT in this branch is somebody's work: it is left alone and named, never deleted.
  ob=$(bare ownB); tb=$(bare otherB)
  d=$(mkproj ws3/projB origin "$tb" projB "$ob")
  sb=$(mkwt "$T/strayB"); git -C "$sb" symbolic-ref HEAD refs/heads/track/projB
  echo stray > "$sb/stray.txt"; git -C "$sb" add -A; git -C "$sb" -c user.name=t -c user.email=t@t commit -q -m stray
  git -C "$sb" push -q "$tb" track/projB
  runp "$d"
  k "$(has "$ob" track/projB && echo 0 || echo 1)" "an unrelated tip elsewhere does not stop the push" "not on $ob"
  k "$(has "$tb" track/projB && echo 0 || echo 1)" "a tip that is not in this branch is left alone" "deleted from $tb"
  k "$(grep -q 'left alone' "$d/.cc/evict.err" && echo 0 || echo 1)" "and evict.err names the repository that still holds it" "$(cat "$d/.cc/evict.err" 2>/dev/null)"
  k "$([ -e "$d/.cc/push.err" ] && echo 1 || echo 0)" "and push.err, which means the push failed, is not written for it" "$(cat "$d/.cc/push.err" 2>/dev/null)"
  k "$(grep -c 'left alone' "$NOTES" | grep -qx 1 && echo 0 || echo 1)" "and the board hears it — the one case that needs a person" "$(cat "$NOTES")"
  ( cd "$d" && "$bin/cc-checkpoint" --push >/dev/null 2>&1 )   # the next turn, same shape: the board is not told again
  k "$(grep -c 'left alone' "$NOTES" | grep -qx 1 && echo 0 || echo 1)" "…once, not every turn" "$(cat "$NOTES")"
  # ONE repository under two remote names — how the owner binds a project to a repository he already had.
  # Compared by name, "the other remote" is the project's own and the branch is deleted the moment it lands.
  oc=$(bare ownC)
  d=$(mkproj ws3/projC origin "$oc/" projC "$oc")
  runp "$d"
  k "$(has "$oc" track/projC && echo 0 || echo 1)" "one repository under two remote names is not evicted from itself" "gone from $oc"
  k "$(grep -q 'removed from' "$NOTES" && echo 1 || echo 0)" "and nothing is reported as removed" "$(cat "$NOTES")"
  # …and under a spelling url_key CANNOT unify (a symlink here; ssh against https on GitHub): the delete goes
  # through, the project's own remote is asked, and the branch is put back (review of #217).
  oc2=$(bare ownC2); ln -s "$oc2" "$T/aliasC2.git"
  d=$(mkproj ws3/projC2 origin "$T/aliasC2.git" projC2 "$oc2")
  runp "$d"
  k "$(has "$oc2" track/projC2 && echo 0 || echo 1)" "a repository deleted from under itself gets its branch put back" "gone from $oc2"
  k "$(grep -q 'put back' "$d/.cc/evict.err" && echo 0 || echo 1)" "and evict.err names the duplicate remote" "$(cat "$d/.cc/evict.err" 2>/dev/null)"
  k "$(grep -q 'put back' "$NOTES" && echo 0 || echo 1)" "and so does the board" "$(cat "$NOTES")"
  ( cd "$d" && "$bin/cc-checkpoint" --push >/dev/null 2>&1 )   # the next turn: the duplicate is remembered, not cycled
  k "$(grep -qxF "$T/aliasC2.git" "$d/.cc/evict.same" && echo 0 || echo 1)" "the duplicate remote is remembered in evict.same" "$(cat "$d/.cc/evict.same" 2>/dev/null)"
  k "$(grep -c 'put back' "$NOTES" | grep -qx 1 && echo 0 || echo 1)" "and is not deleted and put back again the turn after" "$(cat "$NOTES")"
  k "$(has "$oc2" track/projC2 && echo 0 || echo 1)" "and the branch is still in the project's own repository" "gone from $oc2"
  # A delete the other repository REFUSES (GitHub: its default branch; here receive.denyDeletes) is said, once.
  oi=$(bare ownI); ti=$(bare otherI); git -C "$ti" config receive.denyDeletes true
  d=$(mkproj ws3/projI origin "$ti" projI "$oi"); git -C "$d" push -q origin track/projI
  runp "$d"
  k "$(has "$ti" track/projI && echo 0 || echo 1)" "a refused delete leaves the branch where it was" "gone from $ti"
  k "$(grep -q 'refused' "$d/.cc/evict.err" && echo 0 || echo 1)" "and evict.err says the delete was refused" "$(cat "$d/.cc/evict.err" 2>/dev/null)"
  k "$(grep -c 'refused' "$NOTES" | grep -qx 1 && echo 0 || echo 1)" "and the board hears it" "$(cat "$NOTES")"
  # Not a member workspace: its remotes are its own business and nothing is ever taken out of them.
  od=$(bare ownD); td=$(bare otherD)
  d=$(mkproj myrepo2/t2 origin "$od" t2 "$td"); git -C "$d" push -q t2 track/t2
  runp "$d"
  k "$(has "$od" track/t2 && echo 0 || echo 1)" "a plain repo still pushes to origin" "not on $od"
  k "$(has "$td" track/t2 && echo 0 || echo 1)" "and nothing is removed from its other remotes" "deleted from $td"
  # ── no push waits for a person ──────────────────────────────────────────────────────────────────────
  # The 2026-09-07 hang: a member track with no credential sat 6h38m inside git-remote-https on a username
  # prompt, on a stdin no unattended run can answer. Both halves of the rule are checked, each on its own
  # fixture: the ask turned into an error, and the bound that catches a transport hanging with nothing to say.
  # THE ASK, in one offline step. `git credential fill` IS the code the wedged push was blocked inside, so this
  # asks git the same question the push did and wants an error back rather than a wait.
  out=$( printf 'protocol=https\nhost=example.test\n\n' | ( PUSH_TIMEOUT=5; git_unattended credential fill ) 2>&1 ); rc=$?
  k "$([ "$rc" != 0 ] && grep -q 'terminal prompts disabled' <<<"$out" && echo 0 || echo 1)" \
    "no credential: git comes back non-zero saying the prompt is disabled, instead of waiting on it" "rc=$rc out='$out'"
  # …and the case that is NOT suppressed: the lock is on asking a PERSON, not on authenticating. A credential
  # that is there is still used — otherwise this rule would break every push it was meant to keep.
  printf '#!/usr/bin/env bash\n[ "$1" = get ] && printf "username=u\\npassword=p\\n"\nexit 0\n' > "$bin/cred"; chmod +x "$bin/cred"
  out=$( printf 'protocol=https\nhost=example.test\n\n' | ( PUSH_TIMEOUT=5; git_unattended -c credential.helper="$bin/cred" credential fill ) 2>&1 ); rc=$?
  k "$([ "$rc" = 0 ] && grep -qx 'username=u' <<<"$out" && echo 0 || echo 1)" \
    "…while a credential that IS there is still handed over" "rc=$rc out='$out'"
  # THE BOUND, end to end through --push. The remote is ssh-shaped and its transport sleeps, which is the
  # 6h38m shape with the clock wound down: nothing to read, nothing to say, and no reason to ever return.
  owW=$(bare ownW)
  printf '#!/usr/bin/env bash\nsleep 45\n' > "$bin/wedge-ssh"; chmod +x "$bin/wedge-ssh"   # a path unique to this run, so the survivor check below can name it
  d=$(mkproj myrepoW/tW origin "user@example.test:w.git")
  t0=$(date +%s)
  ( cd "$d" && env CC_PUSH_TIMEOUT=3 GIT_SSH_COMMAND="$bin/wedge-ssh" "$bin/cc-checkpoint" --push >/dev/null 2>&1 ); rc=$?
  el=$(( $(date +%s) - t0 ))
  k "$([ "$rc" != 0 ] && [ "$el" -lt 30 ] && echo 0 || echo 1)" \
    "a transport that never answers is killed at the bound, so the push cannot outlive its loop" "rc=$rc after ${el}s"
  k "$(grep -q 'did not finish within 3s' "$d/.cc/push.err" && echo 0 || echo 1)" \
    "…and push.err carries the reason, which the kill leaves git itself with no chance to write" "$(cat "$d/.cc/push.err" 2>/dev/null)"
  k "$(pgrep -f "$bin/wedge-ssh" >/dev/null && echo 1 || echo 0)" "…and the transport dies with it, rather than being left behind" "a helper outlived the push"
  # The same worktree against a remote that answers: pushed as before, and the marker cleared. A bound that
  # also stopped working pushes would pass every case above and be an outage.
  git -C "$d" remote set-url origin "$owW"; runp "$d"; rc=$?
  k "$([ "$rc" = 0 ] && has "$owW" track/tW && [ ! -e "$d/.cc/push.err" ] && echo 0 || echo 1)" \
    "…while a remote that answers is pushed to as before, and push.err is cleared" "rc=$rc"
  # ── which branch the repository the box made opens on ───────────────────────────────────────────────
  # GitHub gives an empty repository whichever branch lands first as its default, and the track landing first is
  # the bug: the base goes in ahead of it, and is asked for by name if that still did not settle it. Here `create`
  # makes a real bare repo under $BARE and `default` moves its HEAD, so GitHub's two halves are both fixtures.
  export BARE="$T/gh"; mkdir -p "$BARE"
  ws ws4
  # ws4 has NO BOARD for these first cases, and a fixture worktree has no origin/HEAD either: that is the state a
  # workspace is in the moment its first project is created, and the base is main because nothing recorded another.
  d=$(mkproj_main ws4/projJ)   # no remote at all: one is created for it, and seeded before the track lands
  : > "$DEFS"; runp "$d"; rJ="$BARE/projJ.git"
  k "$(has "$rJ" main && echo 0 || echo 1)" "the base is pushed into the repository the box just made" "not on $rJ"
  k "$(has "$rJ" track/projJ && echo 0 || echo 1)" "…and so is the project's own branch" "not on $rJ"
  eq "…and that repository's default branch is the base" "$(git -C "$rJ" symbolic-ref HEAD)" refs/heads/main
  eq "…asked for by name, for this project's own repository" "$(cat "$DEFS")" "default ws4 projJ main"
  k "$([ -e "$d/.cc/base-seed" ] && echo 1 || echo 0)" "…and the marker is gone: this happens once, at creation" ""
  : > "$DEFS"; runp "$d"
  eq "every push after it asks GitHub nothing" "$(cat "$DEFS")" ""
  # A repository whose default is ALREADY the track — the shape every repository the box made ended up in.
  rK="$BARE/projK.git"; git init -q --bare "$rK"
  d=$(mkproj_main ws4/projK projK "$rK"); git -C "$d" push -q projK track/projK
  git -C "$rK" symbolic-ref HEAD refs/heads/track/projK
  : > "$DEFS"; : > "$d/.cc/base-seed"; runp "$d"   # created last turn, seeded on this one
  eq "a repository whose default is the track is moved to the base" "$(git -C "$rK" symbolic-ref HEAD)" refs/heads/main
  eq "…by name, once the base is really there to point at" "$(cat "$DEFS")" "default ws4 projK main"
  # THE BOARD says what the base is, and a track is not an answer — the same rule cc cuts a track with.
  rL="$BARE/projL.git"; git init -q --bare "$rL"
  d=$(mkproj_main ws4/projL projL "$rL"); git -C "$d" branch trunk main
  : > "$DEFS"; : > "$d/.cc/base-seed"; setbase ws4 trunk; runp "$d"; nobase ws4
  k "$(has "$rL" trunk && echo 0 || echo 1)" "the board's base is the branch that is seeded" "not on $rL"
  eq "…and the one the default is set to" "$(cat "$DEFS")" "default ws4 projL trunk"
  rM="$BARE/projM.git"; git init -q --bare "$rM"
  d=$(mkproj_main ws4/projM projM "$rM")
  : > "$DEFS"; : > "$d/.cc/base-seed"; setbase ws4 track/projM; runp "$d"; nobase ws4
  eq "a board that answers a track is not believed: the base is main" "$(cat "$DEFS")" "default ws4 projM main"
  # A base nobody can push because it is not in this checkout. It used to drop the marker and say nothing, so the
  # repository kept opening on the track and no turn ever tried again — the board hears it once instead.
  rQ="$BARE/projQ.git"; git init -q --bare "$rQ"
  d=$(mkproj_main ws4/projQ projQ "$rQ")
  : > "$DEFS"; : > "$d/.cc/base-seed"; setbase ws4 nosuchbase; runp "$d"; nobase ws4
  k "$(grep -q "base branch 'nosuchbase' is not in this checkout" "$NOTES" && echo 0 || echo 1)" \
    "a base that is not in the checkout is said once instead of silently dropped" "$(cat "$NOTES")"
  eq "…and nothing is asked of GitHub for it" "$(cat "$DEFS")" ""
  k "$([ -e "$d/.cc/base-seed" ] && echo 1 || echo 0)" "…and it is not retried every turn from then on" ""
  # A repository the box did NOT make has no marker: nothing is pushed into it and its default is left alone.
  rN="$BARE/projN.git"; git init -q --bare "$rN"
  d=$(mkproj_main ws4/projN projN "$rN")
  : > "$DEFS"; runp "$d"
  k "$(has "$rN" main && echo 1 || echo 0)" "a repository the owner bound himself gets no base pushed into it" "main is on $rN"
  eq "…and its default branch is never asked about" "$(cat "$DEFS")" ""
  # …and where the base push alone settled it (GitHub's own rule), nothing is asked either.
  rO="$BARE/projO.git"; git init -q --bare "$rO"
  d=$(mkproj_main ws4/projO projO "$rO"); git -C "$d" push -q projO main; git -C "$rO" symbolic-ref HEAD refs/heads/main
  : > "$DEFS"; : > "$d/.cc/base-seed"; runp "$d"
  eq "a repository already opening on the base is not asked to change it" "$(cat "$DEFS")" ""
  # A default GitHub will not set is a person's job, so it is said once and not tried every turn from then on.
  rP="$BARE/projP.git"; git init -q --bare "$rP"
  d=$(mkproj_main ws4/projP projP "$rP")
  : > "$DEFS"; : > "$d/.cc/base-seed"; export CC_NODEFAULT=1; runp "$d"; unset CC_NODEFAULT
  k "$(grep -q 'default branch is still' "$NOTES" && echo 0 || echo 1)" "a default GitHub refuses to set reaches the board, with the command that sets it" "$(cat "$NOTES")"
  k "$([ -e "$d/.cc/base-seed" ] && echo 1 || echo 0)" "…once, not on every push after it" ""
  unset BARE
  # ── whose README a project's repository opens on ────────────────────────────────────────────────────
  hook(){ ( cd "$1" && "$bin/cc-checkpoint" </dev/null >/dev/null 2>&1 ); }
  d=$(mkproj_main ws3/projE projE "$(bare ownE)")
  hook "$d"
  eq "the README names the project" "$(head -1 "$d/README.md")" "# projE"
  k "$(grep -q '^# ws3' "$d/README.md" && echo 1 || echo 0)" "and no longer names the workspace" "$(head -1 "$d/README.md")"
  # A project whose branch was cut with no default branch to compare against is left alone: nothing to prove it is inherited.
  d=$(mkproj ws3/projE2 projE2 "$(bare ownE2)"); printf '# ws3\n\nscratch workspace\n' > "$d/README.md"
  git -C "$d" add -A; git -C "$d" -c user.name=t -c user.email=t@t commit -q -m readme
  hook "$d"
  eq "with no default branch to compare against, the README is left as it is" "$(head -1 "$d/README.md")" "# ws3"
  # A word a person set is never rewritten by a machine: the heading is the test, and it is the whole test.
  d=$(mkproj_main ws3/projF projF "$(bare ownF)"); printf '# odoo inventory\n\nmine, and not a stub\n' > "$d/README.md"
  hook "$d"
  eq "a README somebody retitled keeps its heading" "$(head -1 "$d/README.md")" "# odoo inventory"
  k "$(grep -q 'mine, and not a stub' "$d/README.md" && echo 0 || echo 1)" "and keeps what they wrote under it" "$(cat "$d/README.md")"
  # Words written THIS turn under the inherited heading are somebody's, uncommitted, and not replaced (review of #217).
  d=$(mkproj_main ws3/projH projH "$(bare ownH)")
  printf '\nnotes for this project\n' >> "$d/README.md"
  hook "$d"
  eq "a README edited this turn keeps its heading" "$(head -1 "$d/README.md")" "# ws3"
  k "$(grep -q 'notes for this project' "$d/README.md" && echo 0 || echo 1)" "and what was written under it" "$(cat "$d/README.md")"
  hook "$d"   # the turn after: those words are committed now, clean against HEAD, and still under the old heading
  eq "…and the turn after, once those words are committed, still keeps its heading" "$(head -1 "$d/README.md")" "# ws3"
  k "$(grep -q 'notes for this project' "$d/README.md" && echo 0 || echo 1)" "and still keeps the words" "$(cat "$d/README.md")"
  # Not a member workspace: its README is nobody's business here, even titled after the repo.
  d=$(mkproj myrepo3/t3 origin "$(bare ownG)"); printf '# myrepo3\n\nnot a workspace\n' > "$d/README.md"
  hook "$d"
  eq "a repo that is not a member workspace keeps its README" "$(head -1 "$d/README.md")" "# myrepo3"
  k "$(grep -q 'not a workspace' "$d/README.md" && echo 0 || echo 1)" "and all of it" "$(cat "$d/README.md")"
  # ── …and the base of the repository the box made opens on that same README ──────────────────────────
  # The base is the WORKSPACE's branch and carries the workspace's README, so a project's repository opened on a
  # page about the workspace even once its default branch was the base — until the project's first PR merged.
  stub(){ printf '# %s\n\nA project of the %s workspace, and the only project in this repository.\nIts work is the `track/%s` branch.\n' "$2" "$1" "$2"; }
  save(){ git -C "$1" add -A; git -C "$1" -c user.name=t -c user.email=t@t commit -q -m "${2:-x}"; }
  export BARE="$T/gh2"; mkdir -p "$BARE"
  ws ws5; wsO=$(bare ws5own)   # ws5 HAS a remote of its own, so each project's repository is its own, not `origin`
  d=$(mkproj_main ws5/projQ origin "$wsO"); mQ=$(git -C "$d" rev-parse main)
  hook "$d"; rQ="$BARE/projQ.git"
  eq "the base pushed into the new repository names the project" "$(git -C "$rQ" show main:README.md 2>/dev/null | head -1)" "# projQ"
  eq "…the same file the project's own branch carries, so its first PR has nothing to merge there" \
     "$(git -C "$rQ" rev-parse main:README.md 2>/dev/null)" "$(git -C "$d" rev-parse HEAD:README.md)"
  eq "…one commit on top of the base, not a rewrite of it" "$(git -C "$rQ" rev-parse main^ 2>/dev/null)" "$mQ"
  eq "…and that commit is the README and nothing else" "$(git -C "$rQ" diff --name-only main^ main 2>/dev/null)" README.md
  eq "…and the workspace's own branch here never moved: every project in it is cut from that one" "$(git -C "$d" rev-parse main)" "$mQ"
  # THE WORKSPACE'S FIRST PROJECT. Its repository is wired up as the workspace's own `origin`, so that base branch
  # is the one ~/dev/<workspace> sits on: a commit there rejects the workspace's push and its pull retitles the
  # WORKSPACE's README. The base still goes first and the default is still set — only the README is not touched.
  ws ws6
  d=$(mkproj_main ws6/projU); mU=$(git -C "$d" rev-parse main); hook "$d"; rU="$BARE/projU.git"
  eq "the workspace's own origin gets the base exactly as the workspace has it" "$(git -C "$rU" rev-parse main 2>/dev/null)" "$mU"
  eq "…so a member's workspace README is never traded for a project's" "$(git -C "$rU" show main:README.md 2>/dev/null | head -1)" "# ws6"
  eq "…and that repository still opens on the base" "$(git -C "$rU" symbolic-ref HEAD 2>/dev/null)" refs/heads/main
  eq "…while the project's own branch is retitled as ever" "$(head -1 "$d/README.md")" "# projU"
  # Somebody's own words are not put on a branch they did not write; they reach the base when their PR merges.
  d=$(mkproj_main ws5/projT origin "$wsO"); printf '# my thing\n\nmine\n' > "$d/README.md"; save "$d" mine
  echo t > "$d/more.txt"   # the turn that makes the repository is a later one: their README is committed already
  hook "$d"
  eq "a README somebody wrote is not pushed onto the base" "$(git -C "$BARE/projT.git" show main:README.md 2>/dev/null | head -1)" "# ws5"
  # A base already carrying this project's README, and a project with no README at all: nothing is added either way.
  mkbase(){   # $1 <ws>/<track>, $2 a command run on `main` before the track is cut from it
    local p t; p=$(mkwt "${1}" origin "$wsO"); t=${1#*/}
    printf '%s\n%s\n' "${1%%/*}" "$t" > "$p/.cc/track"
    git -C "$p" symbolic-ref HEAD refs/heads/main; ( cd "$p" && eval "$2" )
    echo base > "$p/base.txt"; save "$p" base
    git -C "$p" checkout -q -b "track/$t"; echo "$t" > "$p/work.txt"
    printf '%s\n' "$p"; }
  d=$(mkbase ws5/projZ 'stub ws5 projZ > README.md'); mZ=$(git -C "$d" rev-parse main); hook "$d"
  eq "a base whose README is already the project's is pushed unchanged" "$(git -C "$BARE/projZ.git" rev-parse main 2>/dev/null)" "$mZ"
  d=$(mkbase ws5/projY ':'); mY=$(git -C "$d" rev-parse main); hook "$d"
  eq "a project with no README anywhere leaves the base exactly as it is" "$(git -C "$BARE/projY.git" rev-parse main 2>/dev/null)" "$mY"
  k "$([ -e "$d/README.md" ] && echo 1 || echo 0)" "…and is not given one" ""
  # The sibling this seeding makes: a track cut from that base inherits ANOTHER project's stub, whose heading is no
  # longer the workspace's name for the test above to catch. Still nobody's words, so still replaced.
  d=$(mkproj_main ws5/projR projR "$(bare ownR)"); stub ws5 projQ > "$d/README.md"; save "$d" sibling
  hook "$d"
  eq "a track that inherited a sibling project's stub gets its own" "$(head -1 "$d/README.md")" "# projR"
  k "$(grep -q 'track/projR' "$d/README.md" && echo 0 || echo 1)" "…naming its own branch" "$(cat "$d/README.md")"
  # …and the steady state after that: the stub already names this project, so no turn ever rewrites or commits it.
  d=$(mkproj_main ws5/projV projV "$(bare ownV)"); stub ws5 projV > "$d/README.md"; save "$d" own
  hV=$(git -C "$d" rev-parse HEAD); hook "$d"
  eq "a stub already naming this project keeps its heading" "$(head -1 "$d/README.md")" "# projV"
  eq "…and is not rewritten, so the turn commits nothing" "$(git -C "$d" rev-parse HEAD)" "$hV"
  # One line added to it and the whole file is theirs, heading and all.
  d=$(mkproj_main ws5/projS projS "$(bare ownS)"); { stub ws5 projQ; echo mine; } > "$d/README.md"; save "$d" theirs
  hook "$d"
  eq "a stub somebody added a line to is theirs" "$(head -1 "$d/README.md")" "# projQ"
  k "$(grep -q '^mine$' "$d/README.md" && echo 0 || echo 1)" "…and keeps the line" "$(cat "$d/README.md")"
  # No '# ' heading to rebuild the template from: not a stub, and not this file's to touch.
  d=$(mkproj_main ws5/projX projX "$(bare ownX)"); printf 'no heading here\n' > "$d/README.md"; save "$d" plain
  hook "$d"
  eq "a README with no heading is left alone" "$(cat "$d/README.md")" "no heading here"
  # ── …and the project's FIRST PR merges into the base it was seeded with ─────────────────────────────
  # The seed is a change to README.md that only the base has, so as soon as the session writes its own README
  # both sides have touched that file against the merge base and the first PR conflicts in it, which is the very
  # thing the seeding is for (review of #238). It goes on the track, so the base is an ancestor of the branch.
  merges(){   # $1 a bare repo, $2 a branch in it → 0 when that branch merges into its base with no conflict; PRC = the clone
    PRC=$(mktemp -d "$T/pr.XXXXXX")
    { git clone -q "$1" "$PRC" >/dev/null 2>&1 && git -C "$PRC" checkout -q main 2>/dev/null; } || return 1
    git -C "$PRC" -c user.name=t -c user.email=t@t merge -q --no-edit "origin/$2" >/dev/null 2>&1; }
  d=$(mkproj_main ws5/projW origin "$wsO"); hook "$d"; rW="$BARE/projW.git"; bW=$(git -C "$rW" rev-parse main)
  k "$(git -C "$d" merge-base --is-ancestor "$bW" track/projW 2>/dev/null && echo 0 || echo 1)" \
    "the commit the base is seeded with is on the project's own branch" "$bW is not in track/projW"
  eq "…carried there by a merge that changes no file on that branch" \
     "$(git -C "$d" rev-parse 'HEAD^{tree}')" "$(git -C "$d" rev-parse 'HEAD^1^{tree}')"
  printf '# projW\n\nwhat this project is, in my own words\n' > "$d/README.md"; hook "$d"   # a later turn: the session writes the README
  merges "$rW" track/projW; rc=$?
  k "$([ "$rc" = 0 ] && echo 0 || echo 1)" "and the project's first PR merges into that base with no conflict" "git merge exited $rc"
  eq "…leaving the base on the words the session wrote" "$(sed -n 3p "$PRC/README.md" 2>/dev/null)" "what this project is, in my own words"
  # THE CONTROL, built by hand and never through this file: a README commit the base has and the branch does not.
  # The same clone and the same merge, and it conflicts — which is what the case above is worth.
  rB="$BARE/projB2.git"; git init -q --bare "$rB"
  d=$(mkproj_main ws5/projB2 projB2 "$rB"); git -C "$d" push -q projB2 main "track/projB2"
  sc=$(mktemp -d "$T/seed.XXXXXX"); git clone -q "$rB" "$sc" >/dev/null 2>&1; git -C "$sc" checkout -q main
  stub ws5 projB2 > "$sc/README.md"; save "$sc" seed; git -C "$sc" push -q origin main
  printf '# projB2\n\nmy own words\n' > "$d/README.md"; save "$d" mine; git -C "$d" push -q projB2 "track/projB2"
  merges "$rB" track/projB2; rc=$?
  k "$([ "$rc" = 0 ] && echo 1 || echo 0)" "a seed commit the branch does not have is the conflict this must never make" "it merged clean"
  # A seed whose push never reached the remote keeps the marker, and next turn is the SAME commit: rebuilt it
  # would be a new sha, and a repository unreachable for a week would collect one merge a turn.
  rW3="$BARE/projW3.git"; git init -q --bare "$rW3"
  d=$(mkproj_main ws5/projW3 projW3 "$rW3"); hook "$d"   # the stub README is committed on the track, nothing is seeded
  git -C "$d" remote set-url projW3 "$T/gone.git"; : > "$d/.cc/base-seed"; runp "$d"; h1=$(git -C "$d" rev-parse HEAD)
  k "$([ -s "$d/.cc/base-seed" ] && echo 0 || echo 1)" "a seed that could not be pushed is kept for the next turn" "$(cat "$d/.cc/base-seed" 2>/dev/null)"
  git -C "$d" remote set-url projW3 "$rW3"; runp "$d"
  eq "…and that turn reuses it instead of merging another" "$(git -C "$d" rev-parse HEAD)" "$h1"
  eq "…so the base is pushed at the commit the track already carries" "$(git -C "$rW3" rev-parse main 2>/dev/null)" "$(git -C "$d" rev-parse 'HEAD^2')"
  # THE BASE MOVED ON after the track was cut — the workspace's branch is shared, and a sibling's PR lands on it.
  # The seed merge takes the track's tree entire, so seeding here would record that later commit as reverted and
  # it would leave the new repository's base as soon as the project's first PR merged (review round 2 of #238).
  d=$(mkproj_main ws5/projV2 origin "$wsO")
  git -C "$d" checkout -q main; echo plan > "$d/plan.md"; save "$d" plan; mV2=$(git -C "$d" rev-parse main)
  git -C "$d" checkout -q track/projV2
  hook "$d"; rV2="$BARE/projV2.git"
  eq "a base that moved on since the track was cut is pushed unseeded" "$(git -C "$rV2" rev-parse main 2>/dev/null)" "$mV2"
  k "$([ -n "$(git -C "$d" rev-parse -q --verify 'HEAD^2' 2>/dev/null)" ] && echo 1 || echo 0)" \
    "…so no merge that would take what it gained back off it is put on the track" "$(git -C "$d" log --oneline -1 'HEAD^2' 2>/dev/null)"
  merges "$rV2" track/projV2; rc=$?
  k "$([ "$rc" = 0 ] && echo 0 || echo 1)" "…and the project's first PR still merges into that base" "git merge exited $rc"
  k "$([ -e "$PRC/plan.md" ] && echo 0 || echo 1)" "…leaving on it what it gained after the cut" "plan.md is gone from the base"
  unset BARE
  # Reliable completion: the Stop hook's zero is not a receipt. All pushes below use this fixture's bare repo.
  d=$(mkproj_main receipt/task origin "$(bare receipt)"); echo '/.cc/' >> "$d/.git/info/exclude"
  strict(){ ( cd "$1" && "$bin/cc-checkpoint" --commit </dev/null >/dev/null 2>&1 ); }
  before=$(git -C "$d" rev-parse HEAD); echo changed >> "$d/work.txt"
  strict "$d"; rc=$?; tip=$(git -C "$d" rev-parse HEAD)
  k "$([ "$rc" = 0 ] && [ "$tip" != "$before" ] && ! has "$T/receipt.git" track/task && echo 0 || echo 1)" \
    "C1: strict completion commits but does not push" "rc=$rc before=$before tip=$tip"
  strict "$d"; rc=$?
  k "$([ "$rc" = 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$tip" ] && echo 0 || echo 1)" \
    "C1 control: a clean retry succeeds without another commit" "rc=$rc"
  echo fixture > "$d/.env"; hook "$d"; hookrc=$?; strict "$d"; rc=$?
  k "$([ "$hookrc" = 0 ] && [ "$rc" != 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$tip" ] \
    && [ -n "$(git -C "$d" status --porcelain)" ] && git -C "$d" diff --cached --quiet && echo 0 || echo 1)" \
    "C2: a secret refusal stays zero for the hook, fails completion, and leaves no secret staged" "rc=$rc hook=$hookrc"
  rm "$d/.env"; echo later >> "$d/work.txt"
  printf '#!/bin/sh\nexit 1\n' > "$d/.git/hooks/pre-commit"; chmod +x "$d/.git/hooks/pre-commit"
  strict "$d"; rc=$?
  k "$([ "$rc" != 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$tip" ] && echo 0 || echo 1)" \
    "C3: a failed git commit cannot finish" "rc=$rc"
  rm "$d/.git/hooks/pre-commit"; : > "$d/.git/index.lock"; strict "$d"; rc=$?; rm "$d/.git/index.lock"
  k "$([ "$rc" != 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$tip" ] && echo 0 || echo 1)" \
    "C3 control: a failed git add also cannot finish" "rc=$rc"
  strict "$d"; rc=$?
  k "$([ "$rc" = 0 ] && [ "$(git -C "$d" rev-parse HEAD)" != "$tip" ] && echo 0 || echo 1)" \
    "C3 recovery: removing the failure commits the same work" "rc=$rc"
  git -C "$d" checkout -q main; before=$(git -C "$d" rev-parse HEAD); echo offtrack > "$d/stray.txt"
  strict "$d"; rc=$?
  k "$([ "$rc" != 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$before" ] && echo 0 || echo 1)" \
    "C4: strict completion refuses the default branch" "rc=$rc"
  git -C "$d" checkout -q -b track/impostor; printf 'receipt\nimpostor\n' > "$d/.cc/track"
  strict "$d"; rc=$?
  k "$([ "$rc" != 0 ] && [ "$(git -C "$d" rev-parse HEAD)" = "$before" ] && echo 0 || echo 1)" \
    "C4 control: a matching lying marker cannot make the wrong branch canonical" "rc=$rc"
  d=$(mkproj "$T/outside" origin "$(bare outside)"); strict "$d"; rc=$?
  k "$([ "$rc" != 0 ] && ! has "$T/outside.git" "track/$T/outside" && echo 0 || echo 1)" \
    "C5: an outside worktree gains no strict completion or push" "rc=$rc"
  echo "cc-checkpoint selfcheck: $((n - f)) passed, $f failed"; [ "$f" = 0 ]
}
[ "$MODE" = selfcheck ] && { selfcheck; exit $?; }
if [ "$MODE" != commit ]; then   # push only: no payload to read, no commit, and a real exit code for `cc done`
  root=$(git rev-parse --show-toplevel 2>/dev/null) || { echo "cc-checkpoint $MODE: not inside a git worktree" >&2; exit 1; }
  cd "$root" || exit 1
  # --remote answers WHERE, and makes the workspace project's repository if that is what the answer needs, so
  # `cc done` asks before the push and opens its PR against the same repository. It writes no branch, so the
  # HEAD rule below — which guards a push — is not its business.
  if [ "$MODE" = remote ]; then pick_remote || exit 1; printf '%s\n' "$remote"; exit 0; fi
  track=$(sed -n 2p "$root/.cc/track" 2>/dev/null); branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
  # The same rule the hook keeps: only ever the track's own branch. Without it a session that repointed HEAD
  # could have `cc done` push the default branch for it.
  [ -n "$track" ] && [ "$branch" = "track/$track" ] || { echo "cc-checkpoint --push: HEAD is '$branch', not 'track/$track' — refusing to push" >&2; exit 1; }
  pick_remote || exit 0   # nowhere to push, and none to be made: that is not a failed push
  lease_push "$branch"; rc=$?
  [ "$rc" = 2 ] && lease_refused "$branch"
  [ "$rc" = 0 ] || tail -3 "$root/.cc/push.err" >&2
  exit "$rc"
fi
# The hook's JSON payload (verified fields: session_id, transcript_path, cwd, stop_hook_active, …) — read
# before anything can exit, capped, and never fatal: measuring a context must not cost a session its commit.
# cc-context answers with a Stop decision when the session has crossed a context line; it is relayed AFTER
# the commit below, so the work is safely on the branch before the session is asked to journal it.
# cc-owed asks the same payload what is still owed in Slack and carries the context line through (--with),
# so the two hooks are one decision, owed first. If it fails or times out, ${owe:-$say} keeps the other.
[ "$STRICT" = 1 ] || [ -t 0 ] || payload=$(timeout 5 cat)
[ -n "${payload:-}" ] && say=$(printf '%s' "$payload" | timeout 20 "$BIN/cc-context" --record 2>/dev/null)
[ -n "${payload:-}" ] && { owe=$(printf '%s' "$payload" | timeout 15 "$BIN/cc-owed" --check --with "${say:-}" 2>/dev/null); say=${owe:-$say}; }
exec 8>&1   # the hook's real stdout: every exit below is inside a block that discards stdout, the relay is not
relay(){ [ -n "${say:-}" ] && printf '%s\n' "$say" >&8; return 0; }
trap relay EXIT
commit_end(){   # The hook stays nonblocking. Completion requires observable, clean committed work.
  [ "$STRICT" = 1 ] || exit 0
  local dirty
  dirty=$(git status --porcelain --untracked-files=all) || exit 1
  [ -z "$dirty" ] && git rev-parse --verify HEAD >/dev/null || exit 1
  exit 0
}
{
  root=$(git rev-parse --show-toplevel 2>/dev/null) || exit "$STRICT"
  [ -f "$root/.cc/track" ] || exit "$STRICT"
  cd "$root" || exit "$STRICT"
  refuse(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$root/.cc/checkpoint.err"; git reset -q 2>/dev/null; exit "$STRICT"; }   # unstage too: a refused secret must not sit in the index
  track=$(sed -n 2p "$root/.cc/track"); branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo HEAD)
  [ -n "$track" ] && [ "$branch" = "track/$track" ] || refuse "refused: HEAD is '$branch', not 'track/$track' — checkpoint only ever commits the track's own branch"
  if [ "$STRICT" = 1 ]; then
    path_ids "$root" && [ "$branch" = "track/$WSTRACK" ] || refuse "refused: completion needs the canonical track"
  fi
  project_readme   # a project's repository describes the project, not the workspace it is a branch of
  git add -A 2>/dev/null || { [ "$STRICT" = 0 ] && exit 0; refuse "failed: git add"; }
  if git diff --cached --quiet 2>/dev/null; then commit_end; fi   # nothing changed
  bad=$(git diff --cached --diff-filter=A --name-only | grep -E "$SECRETS" | head -5 | tr '\n' ' ')   # only NEW files: a repo that already tracks .env.example is not leaking
  [ -z "$bad" ] || refuse "refused: staged files look like secrets: $bad (remove or ignore them, then the next turn commits)"
  files=$(git diff --cached --name-only | wc -l | tr -d ' ')
  # Commit identity: git's own config normally, overridden by CC_GIT_NAME/CC_GIT_EMAIL in ~/.cc/config
  # (read, not sourced — that file holds tokens and none of them belong in this git's environment).
  mapfile -t ident < <(ident_args)
  git "${ident[@]}" commit -q -m "wip: checkpoint $(date -u +%FT%TZ) [$files file(s)] [cc]" 2>/dev/null \
    || { [ "$STRICT" = 0 ] && exit 0; refuse "failed: git commit"; }
  rm -f "$root/.cc/checkpoint.err"
  [ "$STRICT" = 0 ] || commit_end
  if pick_remote; then   # push failures never block, but they must not be invisible either (cc ls / digest show "push!")
    lease_push "$branch"; [ $? = 2 ] && lease_refused "$branch"
  fi
} >/dev/null 2>&1
exit 0
