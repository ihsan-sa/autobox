           and "not 'star'" in e2)
        # the whole route: `cc-docs file` inside the sandbox, over a socket the fixture serves as the daemon does
        import socket
        import threading
        SLACKSOCK = os.path.join(t, "sock")
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SLACKSOCK)
        srv.listen(4)

        def serve():
            while True:
                try:
                    c, _ = srv.accept()
                except OSError:
                    return
                with c:
                    f = c.makefile("rb")
                    q = json.loads(f.readline())["docs"]
                    try:
                        r = {"ok": True, "text": member_ask("kid1", q)}
                    except Refused as x:
                        r = {"ok": False, "error": str(x)}
                    c.sendall((json.dumps(r) + "\n").encode())
        threading.Thread(target=serve, daemon=True).start()
        m2 = mkpdf(ws, "m2", "Member physics two")
        IN_SANDBOX = True
        try:
            rc, o = run("file", "--title", "Physics two", m2)
            rcp, op_ = run("public", f"{k1[0]}-0001-A", "on")
            rct, ot = run("token", "x", f"{k1[0]}-0001-A")
            rcr, orr = run("retire", f"{k1[0]}-0001")
            rcf, of = run("fold", f"{k1[0]}-0001", f"{k1[0]}-0002")
        finally:
            IN_SANDBOX = False
            srv.close()
        reg = load()
        d2 = reg["documents"].get(f"{k1[0]}-0002") or {}
        with open(os.path.join(ROOT, "ws", wid, "register.json")) as fh:
            view = json.load(fh)
        ok("inside a workspace `cc-docs file --title T <pdf>` files under its project, next number, stamped, in its view",
           rc == 0 and o.startswith(f"{k1[0]}-0002-A\t") and d2.get("revisions", [{}])[0].get("stamped") == "overlay"
           and d2["revisions"][0]["from"] == m2 and f"{k1[0]}-0002" in view["documents"]
           and f"{k1[0]}-0002-A" in pdftext(os.path.join(ROOT, d2["revisions"][0]["file"])))
        ok("inside a workspace public and token are refused, and no revision gains a token",
           rcp == 2 and rct == 2 and "the host's" in op_ + ot
           and not any("public_token" in r for d in reg["documents"].values() for r in d["revisions"]))
        ok("inside a workspace retire and fold are refused, and both documents stay",
           rcr == 2 and rcf == 2 and "the host's" in orr + of
           and f"{k1[0]}-0001" in reg["documents"] and d2)
        ok("no incoming copy is left behind", not [x for x in os.listdir(ROOT) if x.startswith(".incoming.")])
    print(f"cc-docs selfcheck: {n[0]} passed, {n[1]} failed")
    return 1 if n[1] else 0


def main(argv):
    import argparse
    ap = argparse.ArgumentParser(prog="cc-docs", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("file", "number"):
        p = sub.add_parser(name)
        if name == "file":
            p.add_argument("pdf")
            p.add_argument("--no-stamp", action="store_true")
            p.add_argument("--date")
            p.add_argument("--note")
            p.add_argument("--cost", action="append")
        else:
            p.add_argument("--tex", action="store_true")
        p.add_argument("--project", required=not IN_SANDBOX)   # inside a workspace the host picks the member's own
        p.add_argument("--title", required=True)
        p.add_argument("--source")
        p.add_argument("--kind", choices=sorted(RANGES))
        p.add_argument("--member")
        p.add_argument("--describes")
    p = sub.add_parser("project")
    p.add_argument("name")
    p.add_argument("--number")
    p.add_argument("--kind", choices=sorted(RANGES))
    p.add_argument("--member")
    p = sub.add_parser("find")
    p.add_argument("query", nargs="+")
    p = sub.add_parser("list")
    p.add_argument("--project")
    p = sub.add_parser("star")
    p.add_argument("number")
    p.add_argument("state", choices=("on", "off"))
    p.add_argument("--viewer", default="owner")
    p = sub.add_parser("public")
    p.add_argument("number")
    p.add_argument("state", choices=("on", "off"))
    p = sub.add_parser("token")
    p.add_argument("token")
    p.add_argument("number")
    p = sub.add_parser("library")
    p.add_argument("--viewer", required=True)
    p = sub.add_parser("member")
    p.add_argument("handle")
    p.add_argument("--files")
    p = sub.add_parser("fold")
    p.add_argument("keep")
    p.add_argument("other", nargs="+")
    p = sub.add_parser("retire")
    p.add_argument("number")
    sub.add_parser("selfcheck")
    a = ap.parse_args(argv)
    if a.cmd == "selfcheck":
        return selfcheck()
    if IN_SANDBOX and a.cmd in ("file", "number"):
        return across(a)
    try:
        if IN_SANDBOX and a.cmd in ("project", "star", "public", "token", "member", "fold", "retire"):
            # brief: "A member can't … make anything public, star for someone else, or read the owner's register"
            raise Refused(f"{a.cmd} is the host's: a workspace can file, number, find and list its own documents")
        if a.cmd == "member":
            return cmd_member(a)
        return {"file": cmd_file, "number": cmd_number, "project": cmd_project, "find": cmd_find, "list": cmd_list,
                "star": cmd_star, "public": cmd_public, "token": cmd_token, "library": cmd_library,
                "fold": cmd_fold, "retire": cmd_retire}[a.cmd](a)
    except Refused as e:
        print(f"cc-docs: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
