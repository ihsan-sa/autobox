#!/usr/bin/env bash
# cc-heartbeat — 10 s fsync'd "alive" timestamp so a sudden power loss can be dated to ~10 s (gaps are POST-dominated; 1 Hz cost ~7 GB/day on the SSD for ±1 s nobody needs).
# On start it compares the previous run's last-alive time with this boot and appends one line to
# ~/.cc/state/power-events.log (read by cc-boot-notify), labelled cause=clean-reboot|power-loss|unknown from the previous
# boot's journal (did PID 1 reach reboot/poweroff.target?). A restart within the same boot logs nothing, unless the
# user manager itself restarted (it started under 5 min ago) after more than a minute without a heartbeat: then one
# `restart=… cause=user-manager-restart` line, which cc-boot-notify posts, because every session went down with it.
# `cc-heartbeat --dry-run [<last_alive>]` prints the line it would log (default last_alive: the current stamp), touches nothing, exits.
# `cc-heartbeat selfcheck` proves the restart line through --dry-run, with a scratch HOME and a manager pid of its own.
set -uo pipefail
if [ "${1:-}" = selfcheck ]; then
  n=0 f=0; k(){ n=$((n+1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else echo "  FAIL $2"; f=$((f+1)); fi; }
  up=$(cut -d. -f1 /proc/uptime)
  [ "$up" -gt 400 ] || { echo "cc-heartbeat selfcheck: the box has been up ${up}s, under the 400 s a same-boot stamp needs — not run"; exit 0; }
  H=$(mktemp -d); sleep 60 & fresh=$!   # a "manager" that started a moment ago
  trap 'kill "$fresh" 2>/dev/null; rm -rf "$H"' EXIT
  ago(){ date -u -d "@$(( $(date -u +%s) - $1 ))" +%FT%TZ; }
  a=$(ago 120); out=$(HOME=$H MANAGERPID=$fresh "$0" --dry-run "$a")
  grep -qE "restart=[^ ]+ last_alive=$a gap=1[12][0-9]s cause=user-manager-restart" <<<"$out"
  k $? "a manager under 5 min old after a 2 min gap in the heartbeat: one restart line with the gap"
  out=$(HOME=$H MANAGERPID=$fresh "$0" --dry-run "$(ago 30)")
  ! grep -q 'user-manager-restart' <<<"$out"; k $? "…not after a gap of a minute or less (the heartbeat alone restarted)"
  out=$(HOME=$H MANAGERPID=1 "$0" --dry-run "$a")
  ! grep -q 'user-manager-restart' <<<"$out"; k $? "…and not under a manager that has run longer than 5 min (pid 1 here)"
  [ -z "$(ls -A "$H")" ]; k $? "--dry-run wrote nothing under HOME"
  # the loop itself for 3 s: a stamp lands, and (under strace, when it can trace here) no sync(2) or syncfs(2)
  if command -v strace >/dev/null && strace -qq -o /dev/null true 2>/dev/null; then
    HOME=$H strace -f -qq -e trace=sync,syncfs -o "$H/st" timeout 3 "$0" >/dev/null 2>&1
    ! grep -qE '(^|[] ])(sync|syncfs)\(' "$H/st"; k $? "the loop flushes its own file and dir, never the whole disk (no sync/syncfs)"
  else HOME=$H timeout 3 "$0" >/dev/null 2>&1; echo "  skip no strace here: the no-sync(2) case is not run"; fi
  grep -qxE '[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z' "$H/.cc/state/heartbeat"; k $? "…and its stamp landed"
  echo "cc-heartbeat selfcheck: $((n - f)) passed, $f failed"
  [ "$f" = 0 ]; exit $?
fi
hb="$HOME/.cc/state/heartbeat"; log="$HOME/.cc/state/power-events.log"
dry=0; [ "${1:-}" = --dry-run ] && dry=1
[ $dry = 1 ] || mkdir -p "$HOME/.cc/state"
boot=$(date -u -d "$(uptime -s)" +%FT%TZ 2>/dev/null || date -u +%FT%TZ)
boot_s=$(date -u -d "$boot" +%s)
prev_cause() {  # how the previous boot ended, from its journal (readable by the box user: group adm; same test as cc-boot-notify)
  local j; j=$(journalctl -b -1 _PID=1 -o cat --no-pager 2>/dev/null)
  if [ -z "$j" ]; then echo unknown
  elif grep -qE 'Reached target (reboot|poweroff|halt|shutdown)\.target|^Shutting down\.$' <<<"$j"; then echo clean-reboot
  else echo power-loss; fi
}
emit() { if [ $dry = 1 ]; then echo "DRY-RUN (not written): $1"; else echo "$1" >> "$log"; fi; }
prev=""; [ -s "$hb" ] && prev=$(cat "$hb"); [ $dry = 1 ] && [ -n "${2:-}" ] && prev=$2
if [ -n "$prev" ]; then
  prev_s=$(date -u -d "$prev" +%s 2>/dev/null || echo 0)
  if [ "$prev_s" -lt "$boot_s" ]; then
    gap=$((boot_s - prev_s)); cause=$(prev_cause)
    case $cause in clean-reboot) note="gap = shutdown + POST + kernel start";; *) note="gap = outage + POST + kernel start";; esac
    emit "$(date -u +%FT%TZ) boot=$boot last_alive=$prev gap=${gap}s cause=$cause ($note)"
    [ $dry = 1 ] || logger -t cc-heartbeat "previous run last alive at $prev; this boot at $boot; gap ${gap}s; cause $cause"
  else
    # Known false restart, left as is: this heartbeat stopped for over a minute and started again within a fresh
    # manager's first 5 min of a boot (an install.sh re-enable) logs a restart that did not happen. Comparing the
    # manager's start with the gap's start would tell the two apart; it is one log line, so not done yet.
    gap=$(( $(date -u +%s) - prev_s )); up=$(ps -o etimes= -p "${MANAGERPID:-0}" 2>/dev/null | tr -d ' ')
    if [ "$gap" -gt 60 ] && [ -n "$up" ] && [ "$up" -lt 300 ]; then
      emit "$(date -u +%FT%TZ) restart=$(date -u +%FT%TZ) last_alive=$prev gap=${gap}s cause=user-manager-restart"
    elif [ $dry = 1 ]; then echo "DRY-RUN: last_alive=$prev is not before boot=$boot — same boot, nothing would be logged"
    fi
  fi
else
  emit "$(date -u +%FT%TZ) boot=$boot last_alive=none (first run)"
fi
[ $dry = 1 ] && exit 0
# fsync the file AND its directory: without the second fsync the rename can still be in the dir's
# journal-only state when power drops, and the stamp reverts to the previous value (~10 s of extra dark time).
# fsync(2) per file, never `sync FILE`: uutils sync (0.8.0) calls sync(2) whatever its arguments, so every 10 s it
# flushed every filesystem, and under heavy writes that held writeback for minutes and locked the box (10-29/10-30).
exec python3 -c '
import os, sys, time
hb = sys.argv[1]; tmp = hb + ".tmp"; d = os.path.dirname(hb)
def fsync(path, flags):
    fd = os.open(path, flags)
    try: os.fsync(fd)
    finally: os.close(fd)
while True:
    try:
        with open(tmp, "w") as f: f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ\n", time.gmtime()))
        fsync(tmp, os.O_RDONLY); os.replace(tmp, hb); fsync(d, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as e:
        print(f"cc-heartbeat: {e}", file=sys.stderr, flush=True)
    time.sleep(10)
' "$hb"
