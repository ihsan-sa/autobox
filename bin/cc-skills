#!/usr/bin/env bash
# cc-skills — the skills every Claude session on the box gets, kept at the tip of their own git repos.
#   cc-skills sync       clone a listed skill that is missing, fast-forward one that is there; rides cc-reconcile.service
#   cc-skills list       name<TAB>url<TAB>branch<TAB>state for each listed skill
#   cc-skills names      the listed skills that are installed and are clones of their url — what cc-sandbox binds;
#                        cc-sandbox adds the clone each valid alias resolves into
#   cc-skills aliases    name<TAB>target for each well-formed alias line — the only aliases cc-sandbox looks at
#   cc-skills selfcheck
# THE LIST is one file, one skill per line: `<name> <git url> [<branch>]`, `#` for comments. Adding a skill is one
#   line there. It is the tree's own config/skills.list, and on a box that keeps this tree as core/ inside a private
#   overlay, the overlay's config/skills.list (a skill's url names its owner, which core/ must not). CC_SKILLS_LIST
#   points at another file (the selfcheck's). A url carrying a user or a token is refused: the clone is readable by
#   every member workspace, so its .git/config must hold nothing a member should not read.
# A SKILL KEPT IN THIS TREE is a line whose url is `tree:<dir>`, the dir relative to this tree's root (core/ on a box
#   with an overlay; `tree:skills/email-explanation`). Its source is shipped with the tree, so there is nothing to
#   clone: sync copies the dir to ~/.claude/skills/<name> whole, with a `.cc-skills-tree` file inside naming the
#   source, and copies it again whenever the two differ. A dir that is absolute, climbs out with `..` or is not there
#   is refused, and a directory at the name that is not that copy is left alone, as for a clone.
# AN ALIAS LINE reads `<name> -> <clone>/<path...>` in place of a url — `vde -> chip-flow/skills/vde` means
#   ~/.claude/skills/vde is the directory skills/vde inside the listed clone ~/.claude/skills/chip-flow. sync only
#   ever keeps the symlink's text matching the line, and only once the target passes the same check names makes: a
#   target that is absolute or climbs out with `..`, or that does not resolve into a skill inside another line's own
#   clone, gets no link (and loses the one it had), one stderr line. names prints the name and cc-sandbox's skills_bind
#   binds it, each doing its own realpath check again — no `..` and no symlink escaping the clone — or the line is
#   refused and never listed or bound. The clone a valid alias resolves into is bound too, at its own name, because a
#   sub-skill runs its clone's own tools (chip-flow's bin/eda) from there. The same name rules apply as any other line,
#   synced included. A LINE DROPPED from the list takes its link with it: sync records the alias links it keeps in
#   ~/.cc/skills/aliases and removes one whose line is gone, never a symlink it did not make.
# WHERE: each skill is a plain clone at ~/.claude/skills/<name>, where every host session finds it. The name `synced`
#   belongs to the account's own sync and is never taken; a directory at a listed name that is not a clone of that url
#   (a skill someone made by hand) is left alone and reported. A new clone is made beside it under a dot name and
#   renamed in, so a half clone is never a skill.
# PULL (a clone): fetch the branch (default: whichever the clone checked out, i.e. the remote's default) and merge --ff-only. A
#   pull that fails — no network, a diverged or dirty checkout, a url that moved — changes nothing, so the last good copy
#   stays what every session reads. It is reported ONCE: a stamp at ~/.cc/skills/<name>.fail marks it said, and the
#   first sync that succeeds removes the stamp and says it recovered. Exit 1 when any skill failed.
# MEMBERS AND WORKERS see the same directories through cc-sandbox (skills_bind), read-only, one bind per name this
#   prints under `names` — never ~/.claude/skills whole, so `synced` and a hand-made skill stay the owner's.
set -uo pipefail
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SELF=$(readlink -f "$0")
TOP="$R"; [ "$(basename "$R")" = core ] && [ -d "$R/../config" ] && TOP="$(cd "$R/.." && pwd)"
LIST="${CC_SKILLS_LIST:-$TOP/config/skills.list}"
SK="$HOME/.claude/skills"; ST="$HOME/.cc/skills"
NOTIFY="${CC_SKILLS_NOTIFY:-$(dirname "$SELF")/cc-notify}"
export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false
TO="${CC_SKILLS_TIMEOUT:-120}"

# name<TAB>url<TAB>branch for each well-formed line; a bad line is one stderr line and skipped. An ALIAS line
#   (`<name> -> <target>`) is not this function's — alias_entries reads it, silently skipped here.
entries(){
  [ -f "$LIST" ] || return 0
  local name url br extra ln=0
  while read -r name url br extra; do
    ln=$((ln+1))
    case "$name" in ''|'#'*) continue;; esac
    [ "$url" = '->' ] && continue
    if ! [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || [ "$name" = synced ] || [ -z "$url" ] || [ -n "$extra" ]; then
      echo "cc-skills: $LIST:$ln is not '<name> <git url> [<branch>]' with a plain lowercase name other than synced — skipped" >&2; continue; fi
    case "$url" in
      *://*@*) echo "cc-skills: $LIST:$ln ($name) puts a user or a token in its url — every member workspace can read the clone, so it is skipped" >&2; continue;;
      https://*|ssh://*|git@*:*|/*) ;;
      tree:*) case "/${url#tree:}/" in //|/[/]*|*/../*|*/./*) echo "cc-skills: $LIST:$ln ($name) names a tree dir that is empty, absolute or climbs out — skipped" >&2; continue;; esac;;
      *) echo "cc-skills: $LIST:$ln ($name) has a url that is not https://, ssh://, git@host:, tree: or an absolute path — skipped" >&2; continue;;
    esac
    printf '%s\t%s\t%s\n' "$name" "$url" "$br"
  done < "$LIST"; }

# name<TAB>target for each well-formed ALIAS line (`<name> -> <clone>/<path...>`, the header's AN ALIAS LINE); a bad
#   line is one stderr line and skipped. Whether <target> actually resolves into a listed clone is not decided here —
#   sync_alias checks it before it links, and names/skills_bind each check again on what is really on disk, every
#   time, never trusting an earlier pass.
alias_entries(){
  [ -f "$LIST" ] || return 0
  local name arrow target extra ln=0
  while read -r name arrow target extra; do
    ln=$((ln+1))
    case "$name" in ''|'#'*) continue;; esac
    [ "$arrow" = '->' ] || continue
    if ! [[ "$name" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || [ "$name" = synced ] || [ -z "$target" ] || [ -n "$extra" ]; then
      echo "cc-skills: $LIST:$ln is not '<name> -> <clone>/<path...>' with a plain lowercase name other than synced — skipped" >&2; continue; fi
    printf '%s\t%s\n' "$name" "$target"
  done < "$LIST"; }

TREEMARK=.cc-skills-tree
# $1 url → the absolute source dir of a tree: url (empty for any other url)
TREE="${CC_SKILLS_TREE:-$R}"   # the root a tree: dir is read from; the selfcheck points it at a fixture
treesrc(){ case "$1" in tree:*) printf '%s/%s\n' "$TREE" "${1#tree:}";; esac; }
# $1 dir $2 url → 0 when dir is a real directory holding a clone whose origin is url, or, for a tree: url, the
# copy sync made of that source (its mark names the source)
managed(){ local src; src=$(treesrc "$2")
  if [ -n "$src" ]; then [ -d "$1" ] && [ ! -L "$1" ] && [ -f "$1/$TREEMARK" ] && [ ! -L "$1/$TREEMARK" ] &&
    [ "$(cat "$1/$TREEMARK" 2>/dev/null)" = "$src" ]; return; fi
  [ -d "$1" ] && [ ! -L "$1" ] && [ -d "$1/.git" ] && [ ! -L "$1/.git" ] &&
  [ "$(git -C "$1" config --get remote.origin.url 2>/dev/null)" = "$2" ]; }
# $1 dir $2 url → what `list` says a managed skill is at: the clone's short head, or `tree copy`
at(){ if [ -n "$(treesrc "$2")" ]; then echo "tree copy"; else git -C "$1" rev-parse --short HEAD 2>/dev/null; fi; }

synctree(){   # $1 name $2 url — copy a tree-kept skill in, whole, when it is missing or differs from its source
  local n="$1" src d="$SK/$1" tmp old
  src=$(treesrc "$2")
  [ -d "$src" ] && [ -f "$src/SKILL.md" ] || { fail "$n" "the tree dir $src is not there or has no SKILL.md"; return 1; }
  if [ -e "$d" ] || [ -L "$d" ]; then
    managed "$d" "$2" || { fail "$n" "the directory $d is there but is not the copy of $src, so it is left alone"; return 1; }
    diff -rq --exclude="$TREEMARK" -- "$src" "$d" >/dev/null 2>&1 && { ok "$n"; return 0; }
  fi
  mkdir -p "$SK" || { fail "$n" "cannot make $SK"; return 1; }
  tmp="$SK/.$n.cc-skills.$$"; old="$SK/.$n.cc-skills-old.$$"; rm -rf "$tmp" "$old"
  if cp -a -- "$src" "$tmp" && printf '%s\n' "$src" > "$tmp/$TREEMARK"; then
    if [ -e "$d" ]; then mv -T "$d" "$old" && mv -T "$tmp" "$d" && rm -rf "$old" && { echo "cc-skills: $n copied again from the tree"; ok "$n"; return 0; }
    elif mv -T "$tmp" "$d"; then echo "cc-skills: $n copied from the tree"; ok "$n"; return 0; fi
  fi
  rm -rf "$tmp"; [ -e "$old" ] && [ ! -e "$d" ] && mv -T "$old" "$d"
  fail "$n" "the copy from $src failed"; return 1; }

fail(){   # $1 name $2 why — say it once, until a sync of that skill succeeds
  local s="$ST/$1.fail"
  printf 'cc-skills: %s — %s\n' "$1" "$2" >&2
  [ -e "$s" ] && return 0
  mkdir -p "$ST" && printf '%s\n' "$2" > "$s"
  "$NOTIFY" --ask --id "skill-pull:$1" -t "skill $1 did not update" \
    "The shared skill $1 did not update: $2. Every session still reads the last good copy at ~/.claude/skills/$1. cc-skills sync says this once; the stamp ~/.cc/skills/$1.fail clears when a sync succeeds." >/dev/null 2>&1 || :; }
ok(){ [ -e "$ST/$1.fail" ] && { rm -f "$ST/$1.fail"; echo "cc-skills: $1 updates again"; }; return 0; }

sync1(){   # $1 name $2 url $3 branch
  local n="$1" u="$2" b="$3" d="$SK/$1" tmp out old new
  [ -n "$(treesrc "$u")" ] && { synctree "$n" "$u"; return; }
  if [ ! -e "$d" ] && [ ! -L "$d" ]; then
    mkdir -p "$SK" || { fail "$n" "cannot make $SK"; return 1; }
    tmp="$SK/.$n.cc-skills.$$"; rm -rf "$tmp"
    if out=$(timeout "$TO" git clone -q ${b:+--branch "$b"} -- "$u" "$tmp" 2>&1) && mv -T "$tmp" "$d"; then
      echo "cc-skills: $n cloned at $(git -C "$d" rev-parse --short HEAD)"; ok "$n"; return 0; fi
    rm -rf "$tmp"; fail "$n" "the clone failed: $(tail -1 <<<"$out")"; return 1
  fi
  managed "$d" "$u" || { fail "$n" "the directory $d is there but is not a clone of $u, so it is left alone"; return 1; }
  [ -n "$b" ] || b=$(git -C "$d" symbolic-ref -q --short HEAD) || { fail "$n" "the checkout is not on a branch"; return 1; }
  [ "$(git -C "$d" symbolic-ref -q --short HEAD)" = "$b" ] || { fail "$n" "the checkout is not on $b"; return 1; }
  old=$(git -C "$d" rev-parse HEAD 2>/dev/null)
  out=$(timeout "$TO" git -C "$d" fetch -q origin -- "$b" 2>&1) || { fail "$n" "the fetch failed: $(tail -1 <<<"$out")"; return 1; }
  out=$(git -C "$d" merge -q --ff-only FETCH_HEAD 2>&1) || { fail "$n" "not a fast-forward to origin/$b: $(tail -1 <<<"$out")"; return 1; }
  new=$(git -C "$d" rev-parse HEAD 2>/dev/null)
  [ "$old" = "$new" ] || echo "cc-skills: $n ${old:0:7} -> ${new:0:7}"
  ok "$n"; return 0; }

sync_alias(){   # $1 name $2 target (config/skills.list's ALIAS line) → keeps ~/.claude/skills/<name> a symlink to it.
  # The target is checked BEFORE any link is written (alias_in, the test names makes): absolute or `..` is refused on its
  # text, anything else has to resolve into a skill inside a managed clone. A refused line leaves no link at the name,
  # the old one included. names and skills_bind still check the link on disk again each time, trusting no earlier pass.
  local n="$1" tgt="$2" d="$SK/$1" why=""
  if [ -e "$d" ] && [ ! -L "$d" ]; then
    fail "$n" "the directory $d is there and is not an alias cc-skills made — left alone"; return 1; fi
  case "/$tgt/" in
    //|/[/]*|*/../*|*/./*) why="is absolute or climbs out with ..";;
    *) alias_in "$SK/$tgt" >/dev/null || why="does not resolve to a skill (a dir with a SKILL.md) inside a clone this list manages";;
  esac
  if [ -n "$why" ]; then
    [ -L "$d" ] && rm -f "$d"
    fail "$n" "the alias target $tgt $why — no link made"; return 1; fi
  if [ -L "$d" ]; then
    [ "$(readlink "$d" 2>/dev/null)" = "$tgt" ] && { ok "$n"; return 0; }
    ln -sfn "$tgt" "$d" 2>/dev/null && { echo "cc-skills: $n now points at $tgt"; ok "$n"; return 0; }
    fail "$n" "could not repoint the alias to $tgt"; return 1; fi
  mkdir -p "$SK" && ln -s "$tgt" "$d" 2>/dev/null && { echo "cc-skills: $n aliased to $tgt"; ok "$n"; return 0; }
  fail "$n" "could not make the alias to $tgt"; return 1; }
# THE ALIAS RECORD, ~/.cc/skills/aliases: one name per line, each an alias link sync keeps. A recorded name with no alias
#   line now loses its link (a symlink only: whatever else sits there is not the link sync made), before the clones sync,
#   so a name moved from an alias line to a clone line is free for its clone. Nothing unrecorded is ever removed.
prune_aliases(){ local f="$ST/aliases" cur n
  [ -f "$f" ] || return 0
  cur=$(alias_entries 2>/dev/null | cut -f1)
  while IFS= read -r n; do
    [[ "$n" =~ ^[a-z0-9][a-z0-9._-]*$ ]] && [ "$n" != synced ] || continue
    grep -qxF -- "$n" <<<"$cur" && continue
    [ -L "$SK/$n" ] && rm -f "$SK/$n" && echo "cc-skills: $n has no alias line now — its link is removed"
    rm -f "$ST/$n.fail"
  done < "$f"; }
record_aliases(){ local f="$ST/aliases" n
  mkdir -p "$ST" || return 0
  { alias_entries 2>/dev/null | cut -f1; cat "$f" 2>/dev/null || :; } | sort -u | while IFS= read -r n; do
    if [[ "$n" =~ ^[a-z0-9][a-z0-9._-]*$ ]] && [ "$n" != synced ] && [ -L "$SK/$n" ]; then printf '%s\n' "$n"; fi; done > "$f.new.$$" \
    && mv -f "$f.new.$$" "$f"; rm -f "$f.new.$$"; }
cmd_sync(){ local n u b bad=0
  prune_aliases
  while IFS=$'\t' read -r n u b; do sync1 "$n" "$u" "$b" || bad=1; done < <(entries)
  while IFS=$'\t' read -r n u; do sync_alias "$n" "$u" || bad=1; done < <(alias_entries)
  record_aliases
  return "$bad"; }
cmd_list(){ local n u b s
  while IFS=$'\t' read -r n u b; do
    if [ -e "$ST/$n.fail" ]; then s="failing: $(head -1 "$ST/$n.fail")"
    elif managed "$SK/$n" "$u"; then s="at $(at "$SK/$n" "$u")"
    elif [ -e "$SK/$n" ]; then s="not a clone of the url"; else s="not cloned yet"; fi
    printf '%s\t%s\t%s\t%s\n' "$n" "$u" "${b:-default}" "$s"; done < <(entries); }
# alias_valid $1 name → "<RESOLVED real path>\t<clone>" on stdout when ~/.claude/skills/<name> is a symlink whose target
#   realpaths into a directory strictly inside another line's own clone (managed, and holding a SKILL.md) — never a
#   chain onto a second alias, since only entries() (never alias_entries) supplies the candidate clones below. `..`
#   and a symlink partway down the target both wash out in realpath -e, so the containment check on its RESULT is the
#   whole test; anything else is 1, and the caller says so.
alias_valid(){ [ -L "$SK/$1" ] && alias_in "$SK/$1"; }
# alias_in $1 a path → the same test on any path (sync_alias runs it on ~/.claude/skills/<target> BEFORE it makes the link,
#   which resolves exactly as the link would, the link being relative to ~/.claude/skills): "<resolved>\t<clone>" or 1.
alias_in(){
  local resolved c cu creal
  resolved=$(realpath -e "$1" 2>/dev/null) || return 1
  [ -d "$resolved" ] && [ -f "$resolved/SKILL.md" ] || return 1
  while IFS=$'\t' read -r c cu _; do
    managed "$SK/$c" "$cu" || continue
    creal=$(realpath -e "$SK/$c" 2>/dev/null) || continue
    case "$resolved" in "$creal"|"$creal"/*) printf '%s\t%s\n' "$resolved" "$c"; return 0;; esac
  done < <(entries 2>/dev/null)
  return 1; }
cmd_names(){ local n u b tgt
  while IFS=$'\t' read -r n u b; do managed "$SK/$n" "$u" && [ -f "$SK/$n/SKILL.md" ] && printf '%s\n' "$n"; done < <(entries)
  while IFS=$'\t' read -r n tgt; do alias_valid "$n" >/dev/null && printf '%s\n' "$n"; done < <(alias_entries); :; }

selfcheck(){   # the cases are tests/selfcheck/cc-skills.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-skills.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  sync) cmd_sync;;
  list) cmd_list;;
  names) cmd_names;;
  aliases) alias_entries;;
  selfcheck) selfcheck;;
  -h|--help|help) sed -n '2,/^set -/p' "$SELF" | sed '$d; s/^# \{0,1\}//';;
  *) echo "usage: cc-skills sync|list|names|aliases|selfcheck" >&2; exit 2;;
esac
