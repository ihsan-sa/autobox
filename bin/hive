#!/usr/bin/env python3
"""hive — the engine's dashboard, the new name for cc-live. A file and not a link, because the lander refuses
symlinks under core/. It runs cc-live's code with sys.argv[0] left as this file (runpy would swap it), so the
selfcheck's tally reads "hive selfcheck: …".

The code it runs is the cc-live repo's checkout, ~/dev/cc-live/bin/cc-live (CC_HIVE_CODE names another file), which
the box's follow-main timer keeps on that repo's main, so what the engine builds there is what hive shows. With no such file, or one
that won't compile (it says so on stderr), it runs the cc-live beside it, so a broken main never takes hive or
hive-web down. It points CC_LIVE_BIN at this folder, where D's cc-harness-* and cc-spend and o's cc-live-old are.
`hive selfcheck` always runs the cc-live beside it: the gate checks this repo's copy, never a checkout outside it;
the checkout's own cases are `~/dev/cc-live/bin/cc-live selfcheck`."""
import os
import sys


def load(path):
    with open(path, encoding="utf-8") as f:
        return compile(f.read(), path, "exec")


here = os.path.dirname(os.path.realpath(__file__))
p, prog = os.path.join(here, "cc-live"), None
code = os.environ.get("CC_HIVE_CODE") or os.path.expanduser("~/dev/cc-live/bin/cc-live")
if sys.argv[1:2] != ["selfcheck"] and os.path.isfile(code):
    try:
        prog, p = load(code), code
        os.environ.setdefault("CC_LIVE_BIN", here)
    except (OSError, SyntaxError, ValueError) as err:
        print(f"hive: {code} doesn't load ({type(err).__name__}: {err}), so this is {p}", file=sys.stderr)
exec(prog or load(p), {"__name__": "__main__", "__file__": p})
