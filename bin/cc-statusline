#!/usr/bin/env python3
"""cc-statusline — Claude Code's own statusLine command, for every session this box starts.

Wired as `statusLine` in claude-settings.json. Claude Code runs it after most turns — a new assistant
message, /compact, an effort or vim-mode change (see code.claude.com/docs/en/statusline) — with the
harness's OWN JSON on stdin: exact context-window figures, cost, the model, the session id. That is the
number cc-context otherwise has to re-derive by tailing a transcript (core/bin/cc-context — "WINDOW is the
part worth being honest about"), and it was wrong once. This writes it straight into one small per-session
file cc-context prefers over its own estimate, and prints the one short line the status bar shows.

  <harness JSON on stdin> -> ~/.cc/state/statusline/<session_id>.json, then one line on stdout

The file carries the fields cc-context reads — used, window, pct, model — at the top, and the WHOLE payload
verbatim under "raw" beside them: cost, rate limits, prompt cache, lines changed, whatever else the current
schema carries. Nothing here decides what matters later — the spend site and the Home tab read "raw" for
that, without a second change to this script. One file per session, overwritten every turn: the latest is
the only row worth reading.

A member session runs under cc-sandbox with its own $HOME, so ~/.cc/state here is THAT session's own state —
never mixed into the box's.

Never raises: a status line that crashes leaves the bar blank, not the session.
Env: CC_STATUSLINE_DIR (default ~/.cc/state/statusline).
"""
import json, os, re, sys, time

SID_RE = re.compile(r"^[A-Za-z0-9_-][A-Za-z0-9._-]*$")   # no leading dot, no "/" — an id this is not is not a key

STATE = os.path.expanduser("~/.cc/state")
DIR = os.environ.get("CC_STATUSLINE_DIR") or os.path.join(STATE, "statusline")


def human(n):
    if not isinstance(n, (int, float)):
        return "?"
    if n >= 1_000_000:
        return f"{n/1_000_000:.1f}M".replace(".0M", "M")
    if n >= 1000:
        return f"{round(n/1000)}k"
    return str(int(n))


def extract(d):
    """The harness's payload -> (session_id, record, one-line string). record is what gets written to disk.
    Tolerant of every field the schema documents as absent or null (no context_window yet, no cost, no
    rate_limits, …) — a session barely started must still get a line and a file, not an exception."""
    if not isinstance(d, dict):
        d = {}
    sid = d.get("session_id")
    model = d.get("model") if isinstance(d.get("model"), dict) else {}
    model_id = model.get("id")
    model_name = model.get("display_name") or model_id
    cw = d.get("context_window") if isinstance(d.get("context_window"), dict) else {}
    used, window, pct = cw.get("total_input_tokens"), cw.get("context_window_size"), cw.get("used_percentage")
    if pct is None and isinstance(used, (int, float)) and isinstance(window, (int, float)) and window:
        pct = round(100.0 * used / window, 1)          # used_percentage is null early in a session; derive it
    record = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "session_id": sid,
              "pct": pct, "used": used, "window": window, "model": model_id, "raw": d}

    bits = [model_name or "?", f"{pct:.0f}% ctx" if isinstance(pct, (int, float)) else "ctx ?"]
    if isinstance(used, (int, float)) and isinstance(window, (int, float)):
        bits[1] += f" ({human(used)}/{human(window)})"
    cost = (d.get("cost") if isinstance(d.get("cost"), dict) else {}).get("total_cost_usd")
    if isinstance(cost, (int, float)):
        bits.append(f"${cost:.2f}")
    return sid, record, "  ".join(bits)


def write(sid, record):
    if not sid or not SID_RE.match(sid):
        return   # no key to write it under (falsy), or one shaped to escape DIR (absolute, "../…") — either
                 # way the printed line still goes out; nothing here trusts session_id as a plain filename
    os.makedirs(DIR, exist_ok=True)
    p = os.path.join(DIR, sid + ".json")
    tmp = f"{p}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        json.dump(record, f)
    os.replace(tmp, p)


def main(argv):
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    try:
        d = json.load(sys.stdin)
    except Exception:
        d = {}
    try:
        sid, record, out = extract(d)
        write(sid, record)
    except Exception:
        out = "?"
    print(out)
    return 0


def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-statusline.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-statusline.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
