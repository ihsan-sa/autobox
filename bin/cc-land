#!/usr/bin/env python3
"""cc-land — one command lands a change, so that none of it has to be remembered.

  cc-land <repo> <pr-number>                      the PR path: gates, review, merge, deploy, records, card
  cc-land <repo> <pr-number> --no-review          …without the review gate: land a diff nothing read
  cc-land <repo> <pr-number> --re-review          …asking again about a diff already reviewed (it costs again)
  cc-land <repo> <pr-number> --full-gates         …every gate, instead of the ones the diff has earned
  cc-land <repo> <pr-number> --warm               a batch's first pass, which `work` runs WARM_SLOTS at a time (never a
                                                  hand's): the worker's own green for the head, the static gates on
                                                  the merge with the read beside them, no suite and no merge; what it
                                                  found is written on the PR's queue job for the merge pass
  cc-land record <repo> <pr> <verdict> --by <who> [--head <sha>] [--findings <text>|-]
                                                  write down a review that already happened, against the change the
                                                  PR is at now (--head: the SHA you read, refused if it has moved).
                                                  The landing that finds it buys no review of its own. A STRICTER
                                                  verdict (LAND → LAND-AFTER-FIX → DO-NOT-LAND) supersedes one that
                                                  stands; a looser one is refused — push the fix, or --re-review
  cc-land queue <repo> <pr> [--chat C --ts T]     hand a PR to the queue and start the worker — what a 👍 does. A job
                                                  a landing has already refused for a reason a re-queue cannot mend
                                                  is refused here, in a second, non-zero; a queued one is told its
                                                  place and whether this sweep or the next takes it. A PR touching a
                                                  PROTECTED PATH of its repo (CC_PROTECTED_PATHS_<repo> in ~/.cc/config,
                                                  path prefixes) is refused too — whoever asks, whatever the review
                                                  says — unless --approved-by <uid> is the owner's own Slack id
                                                  (SLACK_OWNER_ID): his 👍 is the only thing that lands one, and it
                                                  is a yes about THAT head — the hold is asked again at every head
                                                  the job reaches, so a fix round cannot push one in under it
  cc-land queue --task <repo> <row>               complete a task; JSON receipt on stdout, queue only with a grant
  cc-land queue <handle>--<track> <pr>            a MEMBER WORKSPACE'S project: lands into the member's own repo on
                                                  the workspace's token, gates inside its sandbox, no deploy, the
                                                  review charged to its daily cap, a stop said in #<handle>
                                                  (cc-checkpoint --sweep queues these; a session inside cannot)
  cc-land work [--detach] [--catch-up]            drain the queue (and poll origin, at most every 15 min): one lane
  cc-land work --lane <repo>                      per repo, side by side, each taking its repo's jobs oldest first;
                                                  bare `work` spawns the lanes. ORDINARY jobs — no protected path,
                                                  nothing on the repo's gate-first lists (every tests/gate-first,
                                                  read at the base; no list, nothing ordinary), into the default
                                                  branch, files disjoint from each other —
                                                  land as ONE BATCH when two or more are ready: their warms side by
                                                  side (--warm, WARM_SLOTS at once), their merges one at a time in
                                                  queue order, then ONE suite on the base; green installs the lot, red
                                                  is believed on a second run, bisected over the squashes provably on
                                                  the base since the batch began (the last is always run: green there
                                                  reverts nobody), and the breaker is REVERTED and told so (its PR,
                                                  its thread, the seat). A lane cut off before that suite leaves a
                                                  note the next sweep resumes.
                                                  Every other job — one alone, a gate-first path, no worker green —
                                                  is gated, reviewed, merged and deployed before the next of that repo
                                                  is touched. A job survives a usage-limit review (waits for
                                                  the reset) and a red gate (3 tries, 15 min apart); a LAND-AFTER-FIX
                                                  sends ONE fix iteration to the PR's track and re-queues on its push;
                                                  a draft or conflicting PR is HELD and looked at every 15 min (a
                                                  conflict first gets ONE rebase round). The board step closes the
                                                  PR's row and every `Closes <row>` its body names, except a row a
                                                  person holds or a track is live on
  cc-land selfcheck                               the decision table (core/tests/cc-land-selfcheck.py); no network

THE FLOW, one line printed per step, stopped at the first real failure: gates and the paid review side by side on
the base MERGED with the head (merge_result — never the head alone, never the branch alone; a serial job's merge
has the jobs landed before it already in; a BATCH member's warm is gated on the base as it was, its members being
file-disjoint, and the base's own suite after the merges is the batch's integration run) → merge → the
#approvals card edited to "landed ✓" (never posted from here) → board rows → ask ledger rows marked `merged` →
install.sh → units this change ADDED switched on (a unit that is off stays off and is named) → restarts proved by
a new pid (never the unit that owns the shared tmux server; a `daemons` row in config/units.json brings back what
systemd does not own, and nothing undeclared is looked for) → each ledger row's own check, run
LAST because until then the box still runs the old code. Only a check exiting 0 makes a row delivered; a row with
no check is reported UNVERIFIED and stays open.

WHAT IT WILL NOT DO:
  · Touch a PARKED project (cc-pause): a 👍 still queues the PR, but no review, merge, deploy, catch-up or timer.
  · Start a suite for a job that cannot succeed: a refusal a re-queue cannot mend (review budget spent, the head
    died on a cap) is written against the change and `queue` answers it in a second, after ONE gh call confirms
    the head, the verdict and the cap have not moved; a gh that does not answer queues as before.
  · Merge a diff nobody read, when the diff is worth a paid read (the control layer, a wide diff, tests, install,
    config, the reviewer's rules; the rest lands on its gates and the planning session's read). The review is one
    headless `claude -p` on the PR's head with no shell, answering LAND / LAND-AFTER-FIX / DO-NOT-LAND; the two stops
    stop like a red gate and the findings are ONE PR comment. `--no-review` is the only way past and a 👍 never
    takes it. It fails CLOSED: a usage limit merges nothing unread — the job waits for the reset cc-limit names.
    ONE VERDICT PER CHANGE, whoever reached it: a comment this box wrote on the PR keyed to a digest of the diff
    against its merge-base (change_digest; a rebase does not move it, an edit does — and a verdict keyed before
    2026-09-19, when the hunk header's tail was still hashed, is read by that older key), so a landing reads a
    recorded verdict (`cc-land record`) instead of buying a second. A review that ran out of its cap (CC_LAND_REVIEW_BUDGET,
    CC_LAND_REVIEW_TURNS) is a third outcome, not a verdict: it is run ONCE MORE at once at the doubled cap the
    message names (one relaunch per head), and a second wall says what both spent and which number to raise; that
    head is then refused until that cap is raised past the doubled one, or a person buys it (`--re-review`).
  · Land one PR twice at once: a landing holds `~/.cc/state/land/held/<repo>-<pr>.lock` (an flock) from before
    its first gate to its end, the direct path and the queue's alike; a second arrival — a hand `--re-review`
    beside the queue's job, or the other way round — names the holder (pid, since, caps, flags), buys nothing
    and exits 1; the queue's job waits its 15 min instead and deploys what the hand landing merged.
  · Spend on a PR already in: the merged state is re-read before the review and before a repair round dispatches.
  · Buy a second ROUTINE review for one change. `~/.cc/state/land/root/<repo>-<pr>.json` tallies per change and
    outlives the job AND the merge (stamped `merged`, bounding nothing from then on — cc-lib indexes it as the
    landing record, so what a landed PR bought is still there to ask for): one routine review, one automatic
    repair round, and the read of what that round changed; past that it STOPS and says who decides — the
    planning session buys one more (`--re-review`, which is added back to what the change may buy, the one
    route the classifier lets a seat take), a PERSON who read it records that (`cc-land record`, refused to the
    seat as self-approval on #521) or lands it unread (`--no-review`). A review a usage limit or its own cap
    killed is not a buy. A fix anybody pushed after a LAND-AFTER-FIX counts as the round. A refusal reached at
    the wall is re-checked against the PR first.
  · Time a gate on the clock: it is timed on its SILENCE — a suite waiting on a lock says so every minute.
  · Refund a read that ran beside a red gate: it was paid for, and a refund would buy a read per red head.

THE ONLY THING ON THIS BOX THAT MERGES. A 👍 writes `~/.cc/state/land/<repo>-<pr>.json` and starts `cc-land work`;
gates, merge and deploy are one transaction. The queue is a FILE because the deploy restarts the daemon that asked:
the job survives that restart, a kill and a reboot, and the next `work` resumes it. `work` runs ONE LANE PER REPO:
it runs the lane of the repo whose job is oldest itself and spawns `work --lane <repo>` for every other repo with a
job; each lane holds its repo's flock and re-reads the queue until nothing of its repo is left, so one repo's
landing never waits behind another's suite, and a job queued while its lane runs is taken by that lane. Inside a
repo it stays one landing at a time, so each merge is of the tree its own gates ran on (the base as the landing
before it left it) and one PR cannot merge twice; `queue` never overwrites a waiting job. A merge this box did not make (GitHub's UI, an
auto-merge) is caught by `work` comparing origin's default branch against the SHA install.sh last ran on.

SKIP vs FAILURE: a step the box has no such thing for (no Slack, no board row, no ledger row) SKIPS and the sequence
carries on. A failure that would leave the box WRONG (a red gate, a merge that did not happen, install.sh, a unit, a
restart) stops everything; a failure in the BOOKKEEPING (card, board, ledger) is reported and the sequence carries
ON. Re-running is the recovery and is safe: merged, carded, settled and enabled are each "nothing to do". A red gate
is also written to the failures ledger the moment it is seen (record_red → `cc-green red`, keyed gate:<gate>:<tree>
so the worker's cc-green and a fix round's see one record); the record never decides anything.

WHAT A STOP SAYS. A landing that does not merge is ONE line under STOP_CARD_MAX characters, everywhere it is said
(the ask thread, #<repo>-updates, a member's lane): `[<repo>] PR #<n>: NOT merged ❌ — <why, in a few words>.
<whose move it is>. <the PR's url>`. A gate red names the case that FAILED — never a case that passed, however its
name is worded (gate_fail). The SHAs, the review's cost, the repair-round tally, the gate log's path and the run's
output are NOT on it: they are in the landing record — the `done …` line in `queue.log`, `work.log`, the kept gate
log and the failures ledger — and in the PR thread, which that url opens. The why keeps the words cc-replay
classifies a stop by (`gate <g> did not pass`, `conflicts with <base> — rebase`): it reads these cards.

Exit: 0 landed and delivered · 1 a step the box depends on failed (nothing after it ran), or another landing
already holds this PR (nothing here ran) · 3 landed, but a cosmetic step wants a hand · 4 merged and deployed, but
nothing observed it reaching the owner · 2 usage.
"""
import ast, calendar, fcntl, fnmatch, glob, hashlib, json, os, re, select, shlex, shutil, signal, subprocess, sys
import contextlib, errno, tempfile, threading, time
import urllib.parse, urllib.request

HOME = os.path.expanduser("~")
BIN = os.path.dirname(os.path.realpath(__file__))    # siblings come from the same bin/ as this copy (like `cc`)
DEV = f"{HOME}/dev"
BOARDS = f"{HOME}/.cc/boards"
UNITS = f"{HOME}/.config/systemd/user"
STATE = f"{HOME}/.cc/state"               # a track's own directory (brief, journal, review); one constant so the selfcheck can move it
LANDQ = f"{HOME}/.cc/state/land"          # the landing queue: one job file per PR, plus what each repo has installed
LAND_TRIES = 3                            # a deploy that keeps failing stops re-driving itself and says so, once
CATCHUP_EVERY = 900                       # how often the box polls origin for a merge nobody here made; never in front of a 👍
# The gates, in the order a person runs them; a repo with none lands ungated and says so.
GATES = ("core/tests/check.sh", "tests/check.sh", "tests/check-extra.sh", "core/tests/selftest.sh", "tests/selftest.sh")
FAILED_RE = re.compile(r"(\d+) failed")   # a suite ending "0 failed" passed; "1 failed" did not, whatever it exited with
# The end-to-end gates, the only slow ones: they run on every code diff, handed the changed paths (CC_LAND_CHANGED), beside the paid review. --full-gates runs every gate; the tier removes gates, never invents one.
SUITE = ("core/tests/selftest.sh", "tests/selftest.sh")
# What earns every gate and a paid read: paths that gate everything by construction, a wide diff, and the repo's own control layer, declared one path or glob per line in this file:
CONTROL_LIST = ("core/tests/control-layer", "tests/control-layer")
# Read from the base side of the diff, like REVIEW_RULES. No list means every code change is read; what is not on it lands on its gates and the planning session's own read, unpaid.
SHARED_PATH_RE = re.compile(r"(^|/)(tests?|config|templates|\.github|\.githooks|\.circleci)/"
                            r"|(^|/)(install\.sh|Makefile|Dockerfile|pyproject\.toml|package\.json|setup\.py|"
                            r"requirements\.txt|go\.mod|Cargo\.toml)$")
DOC_RE = re.compile(r"\.(md|markdown|txt|rst|adoc|org)$|(^|/)(docs|doc)/|(^|/)(LICENSE|COPYING|NOTICE)$", re.I)
COMMENT_RE = re.compile(r"^\s*($|#|//|--[ \t]|\*[ \t/]|\*$|/\*)")   # a line comment in the syntaxes this box writes
WIDE_FILES = 12                           # past this many files, or this many changed lines, "narrow" is a claim
WIDE_LINES = 600                          # nobody can check — the suite is cheaper than being wrong about it
GREEN_TTL = 6 * 3600                      # how long a suite's own green record is spent instead of running it again (green_run)
# AN ORDINARY PR LANDS OPTIMISTICALLY (owner, 2026-09-24: "15 min a PR x 30 = 450 min, way too long"). Ordinary: it
# touches no protected path and nothing on the repo's GATE-FIRST list, its worker left a green record for its head,
# and its files are disjoint from the batch it lands with. Its WARM (the static gates and the read, no suite) runs
# beside the other warms, the suite runs ONCE on the base after the batch has merged, and a red there bisects to
# the PR that broke it and reverts it, out loud. CC_LAND_OPTIMISTIC=0 turns the whole path off.
OPTIMISTIC = os.environ.get("CC_LAND_OPTIMISTIC", "1") != "0"
GATE_FIRST_LIST = ("core/tests/gate-first", "tests/gate-first")   # paths that keep every gate BEFORE the merge, read at the base; no list = nothing is ordinary
WARM_SLOTS = max(1, int(os.environ.get("CC_LAND_WARM_SLOTS") or 4))   # how many of a batch's warms run at once
BATCH_MAX = max(1, int(os.environ.get("CC_LAND_BATCH") or 30))       # …and how many PRs one batch takes at most


def gate_slots():
    """How many test slots a suite gets: two thirds of the cores, never under 2 and never over 6, handed to every suite as CC_SELFTEST_SLOTS, the cap the suite enforces on itself."""
    return max(2, min(6, (os.cpu_count() or 4) * 2 // 3))


SUITE_SLOTS = gate_slots()
GATE_IDLE = 3600                          # a gate that has said nothing for this long is killed: silence, not wall clock
FAIL_LOG_KEEP = 256 * 1024                # what stays of a red gate's log after the run: its last bytes
# The review gate: one generic prompt beside this script (core/config/); a repo's own rules are docs/REVIEW.md, read from the base branch, never the PR. CC_CLAUDE points the model elsewhere.
CLAUDE = os.environ.get("CC_CLAUDE", f"{HOME}/.local/bin/claude")
REVIEW_PROMPT = "config/review-prompt.md"     # relative to the repo THIS cc-land lives in, not the one being landed
REVIEW_RULES = "docs/REVIEW.md"               # read from origin/<base> of the repo being landed; absent = no extra rules
# The two caps the runner enforces, one wall in two units: the review stops when either runs out, having read nothing (exhausted()). Both come from the environment.
REVIEW_BUDGET = os.environ.get("CC_LAND_REVIEW_BUDGET") or "3"   # dollars per review, enforced by the runner
REVIEW_TURNS = os.environ.get("CC_LAND_REVIEW_TURNS") or "40"    # …and turns of it, enforced in the same breath
# Whether a model reads it is gate_tier's answer: only the `full` tier is read, by the worker model; prose and a narrow change outside the control layer are read by nobody paid.
REVIEW_MODEL = os.environ.get("CC_LAND_REVIEW_MODEL") or "claude-opus-5-5"
REVIEW_MARK = "cc-land-review"                # the HTML comment that makes re-posting the same review a no-op
REVIEW_VERDICTS = ("LAND", "LAND-AFTER-FIX", "DO-NOT-LAND")
# The verdict is a field the runner validates, never a sentence grepped for: a finding quotes verdicts.
REVIEW_SCHEMA = json.dumps({
    "type": "object", "additionalProperties": False, "required": ["verdict", "findings"],
    "properties": {
        "verdict": {"type": "string", "enum": list(REVIEW_VERDICTS)},
        "findings": {"type": "array", "maxItems": 10, "items": {
            "type": "object", "additionalProperties": False, "required": ["where", "what", "fix"],
            "properties": {"where": {"type": "string"},      # file:line
                           "what": {"type": "string"},       # what is wrong, one sentence
                           "fix": {"type": "string"}}}}}})   # what to do about it, named
# The fallback for a runner without --json-schema: the first match wins, and two different verdicts are none (verdict_of).
VERDICT_RE = re.compile(r"^\s*(?:\*\*)?VERDICT:?(?:\*\*)?\s*[:\-]?\s*(LAND-AFTER-FIX|DO-NOT-LAND|LAND)\b", re.M)
# Read-only by construction, copied from cc-audit: no settings file, no MCP server, every escape hatch named.
REVIEW_ALLOW = "Read,Grep,Glob,LS"
# A copy of cc-audit's SECRET_PATHS, which is canonical: the selfcheck's drift case goes red when an entry there is missing here.
SECRET_PATHS = (".cc/config", ".cc/secrets/**", ".cc/members/**", "ccbox/env", ".ssh/**",
                ".claude/.credentials.json", ".claude.json", ".config/gh/**")
REVIEW_DENY = ("Bash,BashOutput,KillShell,Edit,Write,MultiEdit,NotebookEdit,WebFetch,WebSearch,Agent,Task,Monitor,"
               "Workflow,Skill,ToolSearch,CronCreate,CronDelete,CronList,ScheduleWakeup,SendMessage,RemoteTrigger,"
               "PushNotification,DesignSync,ListAgents,EnterWorktree,ExitWorktree"
               # Read/Grep are scopeable by path; the secret stores are the one thing a reviewer never needs.
               + "".join(f",Read(/{HOME}/{p}),Grep(/{HOME}/{p})" for p in SECRET_PATHS))
NEVER = "tmux-main.service"               # restarting it takes the shared tmux server — every session on the box — down
# What a landing says to the person a unit's restart is kept for (units.json restart=owner), and the ask-ledger row it writes, keyed on the unit alone so an open ask stops the next landing repeating it.
OWNER_ASK = ("restart {unit}: a landing changed the code it runs and config/units.json keeps its restart for you "
             "(restart=owner), so the box is on the old code until you run `{cmd}`")
OWNER_ASK_KEY = "restart {unit}:"         # …and the prefix an ask still open for THIS unit is recognised by
# The steps whose failure leaves the box wrong, so nothing after them runs; every other step reports ✗, the run goes on and exits 3.
FATAL = ("walls", "review", "gates", "merge", "install", "units", "restart", "daemons")   # walls: a member PR's (MEMBERS)
# ...and of those, the ones worth trying again unattended: install/units/restart fail on the state of the box. A verdict and a refused merge want a person; a draft or a conflict is held (Land.held); a usage limit is deferred, uncounted (run_job).
RETRY = ("gates", "install", "units", "restart", "daemons")
RETRY_AFTER = 900                         # …and how long a kept job waits before the queue re-runs itself (see rearm)
# A LAND-AFTER-FIX names its own remedy, and the queue dispatches it itself, once. A second stop on the same PR is a person's.
FIX_MODEL = os.environ.get("CC_LAND_FIX_MODEL") or "claude-opus-5-5"   # the worker model, not this box's fallback
FIX_LOOP, FIX_BUDGET = "1", "12"          # one repair round (--no-extend), resuming the worker's own session (--resume-last)
FIX_WAIT = 5400                           # how long the fix has to push before the owner is told it did not
FIX_POLL = 300                            # …and how often the queue asks whether it has
# Root work is the change (the PR), not the SHA or the job, which restart per round and bound nothing. These two numbers are the bound, in a file that outlives the job (docs/architecture-usage-efficiency-audit-2026-09-02.md, P0).
ROOT_REVIEWS = 1        # routine paid reviews per change; a repair round earns one more, --re-review is unbounded (reads_earned)
ROOT_REPAIRS = 1        # …and repair rounds per change: the fix that answers a LAND-AFTER-FIX, whoever pushed it; a second stop goes to a person
ROOT_REBASES = 1        # …and rebase rounds per change, counted apart from repairs; a resolved conflict earns its read (reads_earned)
ROOT_TTL = 30 * 86400   # a record for a PR nobody landed is swept, so an abandoned change cannot bound a later one
COSMETIC = 3                              # exit code for "the box is right, its bookkeeping is not"
UNVERIFIED = 4                            # "the box is deployed, and nothing has confirmed the owner can see it"


class Failed(Exception):
    """A step that was asked to do something and could not. Nothing after it runs.

    `short` is the same stop in a few words, for the NOT-merged card: a step that can name the thing that failed
    better than the card could trim its message out of it says so here (stop_why). Without one the card trims.
    """

    def __init__(self, *args, short=""):
        super().__init__(*args)
        self.short = short


class Skip(Exception):
    """A step with nothing to do here (no Slack, no board row, no ledger row). Reported; the sequence goes on."""


class GateStopped(Exception):
    """A gate killed because a sibling gate went red first: the landing is already lost, so this one decides nothing (run_gate)."""


# ── the outside world, each in one place, so `selfcheck` can stand in for all of it ──────────────────────
def sh(argv, cwd=None, timeout=300, stdout_only=False, **kw):
    """(returncode, stdout+stderr), never a raise. A gh or git call in a member clone (member_root) runs with that workspace's own token (GH_TOKEN, GH_CONFIG_DIR pointing at nothing) and never the box's login; with no token granted it does not run at all."""
    if argv and argv[0] in ("gh", "git") and cwd and member_root(cwd):
        tok = member_token(member_root(cwd))
        if not tok:
            return 1, f"no GitHub token granted to workspace {member_root(cwd)} (cc-sandbox github <workspace>) — nothing asked"
        kw["env"] = dict(kw.get("env") or os.environ, GH_TOKEN=tok, GH_CONFIG_DIR=f"{cwd}/.gh-none")   # env, never argv
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL, **kw)
        if stdout_only:
            if r.stderr: print(r.stderr, end="", file=sys.stderr)
            return r.returncode, r.stdout
        return r.returncode, r.stdout + r.stderr
    except Exception as e:
        return 127, f"{e.__class__.__name__}: {e}"


def kill_group(p):
    """Kill the gate's whole process group (start_new_session), not just the leader: the suite's real run and anything it forked go too."""
    try:
        os.killpg(p.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError, OSError):
        p.kill()


# ── the run's scratch root ───────────────────────────────────────────────────────────────────────────────
_RUN = {"root": None, "keep": set(), "lock": threading.Lock()}
KEPT = ".kept"       # the marker drop_run_root leaves in a root it kept a red gate's log in: cc-tmp-reap's to reclaim after 72 h, not the sweep's
SCRATCH = f"{HOME}/.cc/tmp"   # the box's scratch on disk; config/environment.d/cc-tmp.conf gives every unit the same TMPDIR


def use_scratch(path=SCRATCH):
    """Make `path` this process's temp root and every child's TMPDIR, whatever TMPDIR it inherited, and return it.
    main() calls it first: a landing's run root, its gate checkouts and whatever its gates make live on disk, never on
    /tmp. /tmp here is a tmpfs with a per-user quota that the box's own leftovers filled mid-landing, and a gate test
    that sandboxes with `--tmpfs /tmp` cannot see a checkout under /tmp. The real path, because cc-sandbox --tree
    compares its readlink -f with `$TMPDIR/cc-land.run.*`."""
    os.makedirs(path, mode=0o700, exist_ok=True)
    path = os.path.realpath(path)
    os.environ["TMPDIR"] = tempfile.tempdir = path
    return path


def run_root():
    """This process's scratch root, `<tmp>/cc-land.run.<pid>.<random>`, made on first use: every checkout and gate log goes inside it so drop_run_root() removes the lot, and the pid in the name lets sweep_run_roots() tell a dead root from a live one."""
    with _RUN["lock"]:                   # gate threads ask at once; two roots would leave one for the next worker
        root = _RUN["root"]
        if root and os.path.isdir(root):
            return root
        _RUN["root"] = tempfile.mkdtemp(prefix=f"cc-land.run.{os.getpid()}.")
        return _RUN["root"]


def keep_log(path):
    """A log worth keeping past the run — a red gate's, whose path the failure message printed."""
    _RUN["keep"].add(path)


def bound_log(path, limit=FAIL_LOG_KEEP):
    """Cut `path` to its last `limit` bytes, saying so on its first line."""
    try:
        n = os.path.getsize(path)
        if n <= limit:
            return
        with open(path, "rb") as f:
            f.seek(n - limit)
            tail = f.read()
        with open(path, "wb") as f:
            f.write(f"cc-land: the first {n - limit} bytes of this log were dropped after the run; "
                    f"the last {limit} are below\n".encode())
            f.write(tail)
    except OSError:
        pass


def checkout_repo(head):
    """The repo a throwaway checkout `head` belongs to, read off its `.git` file, or '' when it is not a worktree: where `git worktree prune` runs once the checkout is gone."""
    try:
        gitdir = open(f"{head}/.git").read().strip().partition("gitdir:")[2].strip()
    except OSError:
        return ""
    return gitdir.split("/.git/worktrees/")[0] if "/.git/worktrees/" in gitdir else ""


def clear_root(root, keep=()):
    """Remove everything in `root` except the files in `keep` (cut to FAIL_LOG_KEEP each), prune the worktrees it held from their repos, and return whether anything was kept."""
    kept, prunes = False, set()
    for name in sorted(os.listdir(root)):
        p = f"{root}/{name}"
        if p in keep and os.path.isfile(p):
            bound_log(p)
            kept = True
        elif os.path.isdir(p) and not os.path.islink(p):
            prunes.add(checkout_repo(f"{p}/head"))
            shutil.rmtree(p, ignore_errors=True)
        else:
            with contextlib.suppress(OSError):
                os.unlink(p)
    for repo in sorted(prunes - {""}):
        if os.path.isdir(repo):
            with git_lock(repo):
                sh(["git", "worktree", "prune"], cwd=repo, timeout=120)
    return kept


def drop_run_root():
    """The outermost finally: the run root goes whole except the logs keep_log() named, which are cut to FAIL_LOG_KEEP and left under a KEPT marker for cc-tmp-reap to reclaim."""
    root = _RUN["root"]
    if not root or not os.path.isdir(root):
        return
    if clear_root(root, _RUN["keep"]):
        open(f"{root}/{KEPT}", "w").close()
    else:
        with contextlib.suppress(OSError):
            os.rmdir(root)
    _RUN["root"], _RUN["keep"] = None, set()


def live_lander(pid):
    """Whether `pid` is a live cc-land process: the test a left-behind run root is judged on."""
    try:
        argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
    except OSError:
        return False
    return any(b"cc-land" in a for a in argv[:3])


def sweep_run_roots():
    """Remove every `cc-land.run.<pid>.*` in the temp root whose pid is not a live cc-land and that carries no KEPT marker, pruning its repos' worktrees; run once at the start of a sweep. Returns what it removed."""
    gone = []
    for p in sorted(glob.glob(f"{tempfile.gettempdir()}/cc-land.run.*")):
        m = re.fullmatch(r"cc-land\.run\.(\d+)\..*", os.path.basename(p))
        if not m or not os.path.isdir(p) or os.path.islink(p) or os.path.exists(f"{p}/{KEPT}"):
            continue
        pid = int(m.group(1))
        if pid == os.getpid() or live_lander(pid):
            continue
        clear_root(p)
        try:
            os.rmdir(p)
        except OSError:
            continue
        gone.append(p)
    if gone:
        ledger(f"removed {len(gone)} scratch root(s) left by killed runs: {' '.join(gone)}"[:400])
    return gone


# What a write refused for space says. /tmp here is a tmpfs with a per-user quota, and git never says so: a
# checkout that hit it failed as "Could not reset index file to revision HEAD" (#132, 2026-09-22).
DISK_FULL = re.compile(r"Disk quota exceeded|No space left on device|\[Errno (?:122|28)\]")
GIT_WRITE = re.compile(r"unable to write file|Could not reset index file")


def disk_full(text=""):
    """' — …' naming a full temp disk when `text` says a write was refused for space, or the temp root refuses a
    1 MB write now; '' otherwise. The note a failure carries so a quota death reads as one, not as a git error."""
    now = ""
    try:
        with tempfile.TemporaryFile(prefix="cc-land.probe.") as f:
            f.write(b"\0" * (1 << 20))
            f.flush()
    except OSError as e:
        if e.errno in (errno.EDQUOT, errno.ENOSPC):
            now = e.strerror
    if not now and not DISK_FULL.search(text or ""):
        return (f" — git says that when {tempfile.gettempdir()} is full or at its per-user quota; "
                f"`cc-tmp-reap` lists what can go") if GIT_WRITE.search(text or "") else ""
    return (f" — {tempfile.gettempdir()} is full or at its per-user quota ({now or 'the output says so'}); "
            f"`cc-tmp-reap` lists what can go")


def run_gate(argv, cwd, log, env, stop=None):
    """Run one gate in its own process group, streaming its output to `log` as it runs; killed (the whole group) only after GATE_IDLE seconds of silence, never on wall clock, or within a second of `stop` (a threading.Event) being set, which raises GateStopped. Returns (rc, output) like sh()."""
    out_, f = [], None
    with contextlib.suppress(OSError):
        f = open(log, "w")

    def put(text):   # the log is a copy: a write refused (a full /tmp) ends the copy and says why, never the gate
        nonlocal f
        if not f:
            return
        try:
            f.write(text)
            f.flush()
        except OSError as e:
            out_.append(f"\ncc-land: stopped writing {log}: {e}\n".encode())
            with contextlib.suppress(OSError):
                f.close()
            f = None
    try:
        p = subprocess.Popen(argv, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, env=env, start_new_session=True)
    except Exception as e:
        return 127, f"{e.__class__.__name__}: {e}"
    try:
        quiet = time.monotonic()
        while True:
            ready = select.select([p.stdout], [], [], min(GATE_IDLE, 1))[0]
            if stop is not None and stop.is_set():   # a sibling is red: #617's selftest ran 38 min past its red check.sh
                kill_group(p)
                p.wait()
                line = f"\ncc-land: {os.path.basename(argv[0])} stopped — another gate is already red\n"
                put(line)
                raise GateStopped(line.strip())
            if ready:
                quiet = time.monotonic()
            elif time.monotonic() - quiet < GATE_IDLE:
                continue
            else:
                kill_group(p)
                p.wait()
                line = f"\ncc-land: {os.path.basename(argv[0])} said nothing for {GATE_IDLE:g} s — killed as dead\n"
                out_.append(line.encode())
                put(line)
                return 124, b"".join(out_).decode("utf-8", "replace")
            chunk = os.read(p.stdout.fileno(), 65536)
            if not chunk:
                break
            out_.append(chunk)
            put(chunk.decode("utf-8", "replace"))
        return p.wait(), b"".join(out_).decode("utf-8", "replace")
    finally:
        if f:
            with contextlib.suppress(OSError):
                f.close()


def clean_start():
    """Kwargs for every gate (sh(**clean_start())): the session's CLAUDE* variables gone, signals at default, the live config denied (CC_CONFIG_DENY), credential-shaped variables dropped (SECRET_SUFFIXES, SECRET_ENV); PATH, HOME, TMUX, LANG and other CC_* pass. Not a sandbox."""
    env = {k: v for k, v in os.environ.items()
           if k != "CLAUDECODE" and not k.startswith("CLAUDE_") and k not in SECRET_ENV
           and not k.endswith(SECRET_SUFFIXES)}
    env["CC_CONFIG_DENY"] = os.path.realpath(f"{HOME}/.cc/config")
    default_signals()
    return {"env": env}


SECRET_ENV = ("ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "GH_TOKEN", "GITHUB_TOKEN")
SECRET_SUFFIXES = ("_TOKEN", "_KEY", "_SECRET", "_CREDS", "_WEBHOOK", "_PASSWORD")   # cc-green scrubs the same


def default_signals():
    """Reset the four signal dispositions to default in this process, once, from the main thread at startup, so every child inherits them; not a preexec_fn, which runs between fork and exec and wedges a child forked from a thread holding a lock."""
    if threading.current_thread() is not threading.main_thread():
        return
    for s in (signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM):
        signal.signal(s, signal.SIG_DFL)


def ccboard():
    """cc-board imported as a module beside this copy, for its opener and its `reals` (which board file is a board and which a suite's fixture)."""
    if not hasattr(ccboard, "mod"):
        import importlib.machinery, importlib.util
        s = importlib.util.spec_from_loader("ccboard", importlib.machinery.SourceFileLoader(
            "ccboard", os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-board")))
        ccboard.mod = importlib.util.module_from_spec(s); s.loader.exec_module(ccboard.mod)
    return ccboard.mod


def board_read(path):
    """A board file read through cc-board's opener, which refuses anything planted (a member's board is a link into a directory the member writes): None when there is no board, cc-board's Refused for a planted one."""
    return ccboard().read(path)


def board(repo):
    try:
        return board_read(f"{BOARDS}/{repo}.json") or {}
    except Exception:
        return {}


def repo_root(repo):
    """Where the repo is: what the board says, else ~/dev/<repo>; a member workspace's project (`<handle>--<track>`) lands out of its own clone (member_clone)."""
    if member_of(repo)[1]:
        return f"{clones_dir()}/{repo}"
    p = board(repo).get("path") or ""
    return p if p and os.path.isdir(f"{p}/.git") else f"{DEV}/{repo}"


# ── a member workspace's own landing ────────────────────────────────────────────────────────────────────
# A member workspace's finished track lands into the member's own repository the way a box project's does, and nothing of it touches the box. The job's repo is `<handle>--<track>`.
#   · every GitHub call uses that workspace's token and repository, out of a host-only clone (member_clone) of a repository ~/dev/<handle> names under the owner's account;
#   · the gates run inside the workspace's sandbox (`cc-sandbox member <h> <track> --tree <dir>`); the host runs git plumbing and gh, nothing the head wrote;
#   · the deploy half never runs (deploy_steps); every review run — the automatic relaunch at the doubled cap included — is charged to the workspace's daily cap before it is asked for (member_buys_review, ~/.cc/state/member-spend.json, MEMBER_DAILY_USD);
#   · a PR touching the boundary or a token stops before any gate (member_walls); a stop is reported in the workspace's own channel (say_result);
#   · the repair round is the same one a box project gets; a change that spent its review and its repair is told to open a new PR.
# The three places, read at call time like green_dir():
def members_dir():   return f"{HOME}/.cc/members"              # the grants live here: a directory no sandbox bind reaches
def clones_dir():    return f"{LANDQ}/clones"                   # host-only clones of member projects, one per <handle>--<track>
def member_spend():  return f"{STATE}/member-spend.json"       # the per-workspace daily ledger, cc's member_gate shape
MEMBER_DAILY_USD = 20                            # cc's default when MEMBER_DAILY_USD is not in ~/.cc/config
BOUNDARY_PATHS = (".cc/**",) + SECRET_PATHS      # what a member PR may not touch: the boundary's markers, a secret's place
TOKEN_SHAPES = re.compile(r"github_pat_[A-Za-z0-9_]{20,}|\bgh[pousr]_[A-Za-z0-9]{30,}|\bsk-ant-[A-Za-z0-9_-]{20,}"
                          r"|\bxox[abpr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----")


def member_of(repo):
    """(handle, track) for a member project `<handle>--<track>`, (handle, '') for the workspace itself, ('', '') for the box's own; decided by the marker ~/dev/<handle>/.cc/member-workspace, never by the name."""
    h, _, t = (repo or "").partition("--")
    if h and re.fullmatch(r"[a-z0-9][a-z0-9-]{0,39}", h) and os.path.isfile(f"{DEV}/{h}/.cc/member-workspace"):
        return h, t
    return "", ""


def boundary_path(path):
    """True for a path a member PR may not touch: under .cc/ or shaped like a secret's (BOUNDARY_PATHS)."""
    for g in BOUNDARY_PATHS:
        if g.endswith("/**"):
            if path == g[:-3] or path.startswith(g[:-2]):
                return True
        elif fnmatch.fnmatchcase(path, g) or path.endswith("/" + g):
            return True
    return False


def member_root(cwd):
    """The workspace whose clone `cwd` is in, or "" — how sh() knows a gh or git call is a member landing's."""
    rel = os.path.relpath(cwd, clones_dir())
    if rel.startswith(".."):
        return ""
    return member_of(rel.split("/", 1)[0])[0]


def member_token(handle):
    """The token granted to the workspace (cc-sandbox github): ~/.cc/members/<h>/github-token, a link to a mode-600 file; '' when there is no grant, no file, or the wrong mode. Printed nowhere."""
    g = f"{members_dir()}/{handle}/github-token"
    try:
        f = os.path.realpath(g)
        st = os.stat(f)
        if not os.path.islink(g) or not os.path.isfile(f) or (st.st_mode & 0o777) != 0o600:
            return ""
        return open(f).read().strip()
    except OSError:
        return ""


def member_config(key, default):
    rc, o = sh([f"{BIN}/cc-config", "get", key], timeout=30)
    return (o.strip() if rc == 0 and o.strip() else "") or default


def member_project_url(handle, track, pr):
    """The clone url of the repository the project's PR is in, or ('', why). The board row's `pr` is checked, not trusted: the owner must be CC_GH_PERSONAL_OWNER and the name one ~/dev/<handle> itself names (cc-gh-token repos); anything else is refused before a token is read."""
    row = (board(handle).get("tracks") or {}).get(track) or {}
    m = re.fullmatch(r"https://github\.com/([^/\s]+)/([^/\s]+)/pull/([0-9]+)", row.get("pr") or "")
    if not m or m.group(3) != str(pr):
        return "", f"the {handle} board row for {track} does not carry PR #{pr} (pr='{row.get('pr') or ''}')"
    owner, name = m.group(1), m.group(2)
    powner = member_config("CC_GH_PERSONAL_OWNER", "")
    if not powner or owner.lower() != powner.lower():
        return "", f"{owner}/{name} is not under the owner's own account ({powner or 'CC_GH_PERSONAL_OWNER is not set'}) — a granted token opens nothing else"
    rc, o = sh([f"{BIN}/cc-gh-token", "repos", handle, powner], timeout=60)
    if rc or name.lower() not in {x.strip().lower() for x in o.splitlines() if x.strip()}:
        return "", f"{owner}/{name} is not a repository of workspace {handle} (cc-gh-token repos {handle} {powner})"
    return f"https://github.com/{owner}/{name}.git", ""


def member_clone(repo, url):
    """The host-only clone a member project lands out of, made or pointed at `url`; no checkout, and its credential is gh's helper answering with the GH_TOKEN sh() sets, never the box's login. Returns (root, why)."""
    root = f"{clones_dir()}/{repo}"
    if os.path.isdir(f"{root}/.git"):
        if sh(["git", "remote", "get-url", "origin"], cwd=root, timeout=30)[1].strip() != url:
            sh(["git", "remote", "set-url", "origin", url], cwd=root, timeout=30)
        return root, ""
    try:
        os.makedirs(clones_dir(), mode=0o700, exist_ok=True)
        os.makedirs(root, mode=0o700, exist_ok=True)
        os.makedirs(f"{root}/.gh-none", mode=0o700, exist_ok=True)
    except OSError as e:
        return "", f"cannot make {root}: {e}"
    rc, o = sh(["git", "clone", "-q", "--no-checkout", "-c", "credential.helper=",
                "-c", "credential.helper=!gh auth git-credential", url, "."], cwd=root, timeout=900)
    if rc:
        shutil.rmtree(root, ignore_errors=True)
        return "", f"cannot clone {url}: {last(o)}"
    return root, ""


def member_charge(handle, usd):
    """Charge `usd` to the workspace's day in the ledger cc's member_gate keeps, under its lock. Returns None when charged, (spent_before, cap) on a refusal."""
    try:
        cap = float(member_config("MEMBER_DAILY_USD", str(MEMBER_DAILY_USD)))
    except ValueError:
        cap = float(MEMBER_DAILY_USD)
    day = time.strftime("%Y-%m-%d", time.gmtime())
    os.makedirs(STATE, exist_ok=True)
    with open(f"{member_spend()}.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            cur = json.load(open(member_spend()))
            if not isinstance(cur, dict):
                cur = {}
        except (OSError, ValueError):
            cur = {}
        row = cur.get(handle) if isinstance(cur.get(handle), dict) else {}
        spent = float(row.get("usd") or 0) if row.get("day") == day else 0.0
        if spent + usd > cap:
            return spent, cap
        row = dict(row) if row.get("day") == day else {}
        row.update(day=day, usd=round(spent + usd, 2))
        cur[handle] = row
        write_atomic(member_spend(), cur)
    return None


def linked_units():
    """The unit FILES this box has linked — the only ones systemctl can be asked anything about."""
    return sorted(os.path.basename(p) for p in glob.glob(f"{UNITS}/*.service") + glob.glob(f"{UNITS}/*.timer"))


def unit_is(query, unit):
    """What `systemctl --user is-active|is-enabled <unit>` answers, stripped: the one place a unit's state is asked."""
    return sh(["systemctl", "--user", query, unit], timeout=60)[1].strip()


def unit_instances(unit):
    """The names a linked unit FILE runs under: itself, or for a template (`name@.service`) each instance systemd has
    loaded. A template's own name cannot be restarted or asked about — `systemctl --user restart site@.service` is
    refused as missing its instance, and that is the line PR #473's landing handed the owner (2026-09-12). A
    template with no instance loaded runs nothing; one systemctl will not list is named by its glob, which
    `systemctl restart` expands itself, rather than by a name that cannot work."""
    if "@." not in unit:
        return [unit]
    glob_name = unit.replace("@.", "@*.", 1)
    rc, o = sh(["systemctl", "--user", "list-units", "--all", "--plain", "--no-legend", glob_name], timeout=60)
    if rc:
        return [glob_name]
    head, tail = unit.split("@.", 1)
    return sorted({w for w in o.split() if w.startswith(head + "@") and w.endswith("." + tail) and w != unit})


def read_unit(name):
    try:
        return open(f"{UNITS}/{name}", errors="replace").read()
    except OSError:
        return ""


def live_processes():
    """(pid, argv, unit, exe) for every process this user owns, read from /proc in one pass and never raising: unit is '' when no systemd user unit owns it, exe is what the kernel says it is executing."""
    me, found = os.getuid(), []
    try:
        pids = [n for n in os.listdir("/proc") if n.isdigit()]
    except OSError:
        return found
    for n in pids:
        try:
            if os.stat(f"/proc/{n}").st_uid != me:
                continue
            argv = [a for a in open(f"/proc/{n}/cmdline", "rb").read().decode("utf-8", "replace").split("\0") if a]
            cg = open(f"/proc/{n}/cgroup").read()
            exe = os.readlink(f"/proc/{n}/exe")
        except OSError:
            continue
        if not argv:
            continue                                   # a kernel thread has no command line
        # The cgroup leaf names the unit; a `.scope` is a login session or a terminal and owns nothing.
        unit = next((leaf for ln in cg.splitlines() for leaf in [ln.rsplit("/", 1)[-1]]
                     if leaf.endswith(".service")), "")
        # A binary replaced under a running process reads back as '<path> (deleted)': kept as is, it matches nothing, which is right.
        found.append((int(n), argv, unit, exe if exe.endswith(" (deleted)") else os.path.realpath(exe)))
    return found


def own_ancestry():
    """This process and every parent of it, left out of every stale-code answer: cc-land and the loop that started it are files in the repo they land."""
    seen, pid = set(), os.getpid()
    while pid and pid not in seen:
        seen.add(pid)
        try:
            m = re.search(r"^PPid:\s*(\d+)", open(f"/proc/{pid}/status").read(), re.M)
        except OSError:
            break
        pid = int(m.group(1)) if m else 0
    return seen


INTERP = {}


def interpreter_of(prog):
    """The binary the kernel executes for `prog`: `prog` itself if compiled, else the interpreter its `#!` line names (`/usr/bin/env foo` resolved through PATH); '' when it has no `#!`. Cached by path."""
    if prog in INTERP:
        return INTERP[prog]
    ans = ""
    try:
        head = open(prog, "rb").read(256)
    except OSError:
        head = b""
    if head.startswith(b"#!"):
        tok = head.split(b"\n", 1)[0][2:].decode("utf-8", "replace").strip().split()
        if tok:
            ans = shutil.which(tok[1]) or "" if os.path.basename(tok[0]) == "env" and len(tok) > 1 else tok[0]
    INTERP[prog] = os.path.realpath(ans) if ans else ""
    return INTERP[prog]


def repo_program(argv, root, exe):
    """The file of `root` a process runs, relative to it, or '': argv[0] or an interpreter's argv[1] only, and `exe` must agree (a compiled program is the file; a script runs under its `#!` interpreter). `env python3 x` and a `#!`-less entry file are missed on purpose."""
    for tok in argv[:2]:
        if "/" not in tok:
            continue
        p = os.path.realpath(tok)
        if p.startswith(root + "/") and os.path.isfile(p) and exe and exe in (p, interpreter_of(p)):
            return p[len(root) + 1:]
    return ""


def unit_policy(name, field):
    """One cell of config/units.json, via cc-units — the manifest that says whose call a unit is."""
    rc, o = sh([f"{BIN}/cc-units", "policy", name, field], timeout=30)
    return o.strip() if rc == 0 else ""


def units_rows(sub, root, files, cells):
    """`cc-units <sub> --root <root> <files>` (the manifest config/units.json, the overlay's beside it, paths relative to the tree declaring them) as {first cell: the rest}, rows of `cells` columns only. Nothing to ask about is {}; a reader failure is the step's failure, so a manifest that will not parse is an error, not an empty answer."""
    if not files:
        return {}
    rc, o = sh([f"{BIN}/cc-units", sub, "--root", root] + files, timeout=120)
    if rc:
        raise Failed(f"cc-units {sub}: {last(o)}")
    rows = [ln.split("\t") for ln in o.splitlines()]
    return {c[0]: c[1] if cells == 2 else tuple(c[1:]) for c in rows if len(c) == cells and c[0]}


def units_for_paths(root, files):
    """{unit: restart policy} for the units the changed files belong to (`cc-units restart-for`); `none` is answered out loud."""
    return units_rows("restart-for", root, files, 2)


def daemons_for(root, files):
    """{daemon: (restart, runs)} for the long-lived processes the changed files belong to, the ones no systemd unit owns (`cc-units daemons-for`)."""
    return units_rows("daemons-for", root, files, 3)


def stamp(at=None):
    """Now (or `at`, seconds) as the UTC stamp every record here carries."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at))


def epoch_of(s):
    """A stamp() string back as seconds; 0 when it is not one."""
    try:
        return calendar.timegm(time.strptime(s or "", "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return 0


# `usage limit until HH:MMZ (Nm left)`, as `cc-limit status` prints it — the clock time, and beside it the minutes
# still to run, which is the only token in the line that says which DAY that clock time means. The group is optional
# because `cc-limit check` reads the clock alone out of a wrecked run, and older records carry it alone too.
LIMIT_UNTIL_RE = re.compile(r"usage limit until (\d\d):(\d\d)Z(?:\s*\((\d+)m left\))?")

# …and what `cc-limit status` says on its way OUT (exit 1, on stderr) when a stamp is live but was hit by another run
# only: the limit is real and a wait written against it is still owed — it is this caller alone that is not held by it.
LIMIT_ELSEWHERE_RE = re.compile(r"another run hit a limit that resets")


def limit_until(text):
    """The reset cc-limit names as a stamp(), or '' when the text names none. `(Nm left)` is counted from the moment this reads it and so cannot name tomorrow — a line read minutes stale over-books by those minutes, and needs no date arithmetic at all. The clock time ALONE does not say which day it means, so it is taken only while it is ahead of us and within RETRY_AFTER, and otherwise waits RETRY_AFTER and asks again: read as tomorrow's it parked two green PRs for 24 h apiece (#489, #503), each for a limit of a few minutes that had not yet even reset."""
    m = LIMIT_UNTIL_RE.search(text or "")
    if not m:
        return ""
    now = time.time()
    if m.group(3) is not None:
        return stamp(now + int(m.group(3)) * 60 + 60)   # …and a minute past it: cc-limit rounds those minutes up
    t = time.gmtime(now)                                # from a stamp it floors, so both ends of the line are coarse
    end = calendar.timegm((t.tm_year, t.tm_mon, t.tm_mday, int(m.group(1)), int(m.group(2)), 0, 0, 0, 0)) + 60
    return stamp(end if now < end <= now + RETRY_AFTER else now + RETRY_AFTER)


def limited(why):
    """True when a review stopped on a Claude usage limit: matched on the two fixed prefixes review() raises with, never on the words alone."""
    return why.startswith("no review: usage limit") or (why.startswith("the reviewer produced nothing")
                                                        and "usage limit" in why)


# What the runner's result says when the account's limit stopped it: one of these words before 'limit', read only beside a $0.00 cost and no verdict.
LIMIT_SAID_RE = re.compile(r"\b(session|usage|rate)[ _-]?limit", re.I)


def reads_earned(spent):
    """How many paid reads this change has earned, against which `reviews` is held: ROOT_REVIEWS routine ones, one more per repair round up to ROOT_REPAIRS, plus every `--re-review` a person bought (`asked`, written beside `reviews` and refunded with it)."""
    return ROOT_REVIEWS + min(spent.get("repairs", 0), ROOT_REPAIRS) + min(spent.get("rebases", 0), ROOT_REBASES) \
        + spent.get("asked", 0)


# The Closes line: `Closes <row>` (one row, or several joined by commas and/or `and`) anywhere in the PR body, capital C; the list ends at the first thing that is not a row name.
CLOSES_RE = re.compile(r"\bCloses:?\s+([A-Za-z0-9][A-Za-z0-9_-]*(?:\s*(?:,\s*(?:and\s+)?|\s+and\s+)[A-Za-z0-9][A-Za-z0-9_-]*)*)")


def closes_rows(body):
    """The row names a PR body says it closes, in order, each once."""
    seen = []
    for m in CLOSES_RE.finditer(body or ""):
        # Split on the grammar CLOSES_RE accepts, `, and` included as one separator.
        for r in re.split(r"\s*,\s*(?:and\s+)?|\s+and\s+", m.group(1)):
            r = r.strip()
            if r and r.lower() != "and" and r not in seen:
                seen.append(r)
    return seen


# The two ways the runner stops a review on cc-land's own cap, named as the runner names them: a `subtype` field, never the errors[] prose.
WALL_SUBTYPE = {"error_max_budget_usd": ("the money cap", "CC_LAND_REVIEW_BUDGET"),
                "error_max_turns": ("the turn cap", "CC_LAND_REVIEW_TURNS")}
WALL = "the review hit its own cap"       # …and the fixed prefix that says so downstream — see exhausted()


def cap_now(var):
    """The cap variable's value as this process reads it, so the value a wall was hit at and the value a later run reads compare directly (wall_stands)."""
    return REVIEW_BUDGET if var == "CC_LAND_REVIEW_BUDGET" else REVIEW_TURNS


def review_caps(subtype="", budget="", turns=""):
    """(both caps as one word, for the record and the message; then the remedy for the cap that bound: its variable, the value that doubles it, and the other variable as an aside). The caps a run used: the environment's, unless the run was the relaunch at the doubled one (review_now); never stored."""
    budget, turns = budget or REVIEW_BUDGET, turns or REVIEW_TURNS
    var = (WALL_SUBTYPE.get(subtype) or WALL_SUBTYPE["error_max_budget_usd"])[1]
    try:
        more = f"{float(budget if var == 'CC_LAND_REVIEW_BUDGET' else turns) * 2:g}"
    except ValueError:
        more = "6" if var == "CC_LAND_REVIEW_BUDGET" else "80"
    other = "CC_LAND_REVIEW_TURNS" if var == "CC_LAND_REVIEW_BUDGET" else "CC_LAND_REVIEW_BUDGET"
    return f"${budget}/{turns}t", var, more, other


def wall_stands(wall):
    """True while the cap that stopped a review at this head has not been raised (that one cap, not the pair): the next run is then certain to stop the same way, and is refused."""
    which = WALL_SUBTYPE.get(wall.get("hit") or "")
    if not which:
        return True      # a record that does not name the cap that bound: nothing here says one moved, so it stands
    now, was = cap_now(which[1]), wall.get("was")
    try:
        return float(now) <= float(was)
    except (TypeError, ValueError):
        return now == was


def exhausted(why):
    """True when a review stopped on one of cc-land's own caps: a third outcome beside a verdict and a usage limit, which read nothing and a re-run does not mend. Matched on the fixed prefix, like limited()."""
    return (why or "").startswith(WALL)


def write_atomic(path, obj):
    """A reader — the next worker, after a kill — sees the whole job or the previous one, never half of one."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except Exception:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    lib_touch(path)


def lib_touch(path):
    """Index a job or root record with cc-lib at write time; never decides anything (output discarded, a missing cc-lib is nothing at all), and only the two shapes cc-lib registers (~/.cc/state/land/<repo>-<pr>.json and root/ beside it) are offered."""
    live = f"{HOME}/.cc/state/land"
    if os.path.dirname(path) not in (live, f"{live}/root") or not re.fullmatch(r".+-\d+\.json", os.path.basename(path)):
        return
    lib = f"{BIN}/cc-lib"
    if not os.access(lib, os.X_OK):
        return
    try:
        subprocess.run([lib, "index", "--touch", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15)
    except Exception:
        pass


def job_path(repo, pr):
    """One file per PR; the name is the idempotency key, so two 👍 on one card are one job and one merge."""
    return f"{LANDQ}/{repo}-{pr}.json"


def ledger(line):
    """One line per event in `{LANDQ}/queue.log`, kept after the job file is drained: the record of what queued what."""
    try:
        os.makedirs(LANDQ, exist_ok=True)
        with open(f"{LANDQ}/queue.log", "a") as f:
            f.write(f"{stamp()}\t{line}\n")
    except OSError:
        pass


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def applied_sha(repo):
    """The default-branch SHA install.sh last ran on: what 'deployed' means on this box, and what tells a merge made in GitHub's UI from one already applied."""
    return (read_json(f"{LANDQ}/{repo}.applied") or {}).get("sha", "")


def record_applied(repo, sha):
    write_atomic(f"{LANDQ}/{repo}.applied", {"sha": sha, "at": stamp()})


_LOCKS, _LOCKS_GUARD = {}, threading.Lock()


def git_lock_path(root):
    """The file the repo lock is taken on: inside the repo's own `.git` (a linked worktree's `.git` file points into the main one, whose FETCH_HEAD is the shared one), else a name under STATE derived from the root."""
    g = os.path.join(root, ".git")
    if os.path.isfile(g):
        try:
            line = open(g).read().strip()
        except OSError:
            line = ""
        if line.startswith("gitdir:"):
            g = os.path.abspath(os.path.join(root, line.split(":", 1)[1].strip()))
            if os.path.basename(os.path.dirname(g)) == "worktrees":
                g = os.path.dirname(os.path.dirname(g))
    if os.path.isdir(g):
        return os.path.join(g, "cc-land.lock")
    d = f"{STATE}/land/gitlock"
    try:
        os.makedirs(d, exist_ok=True)
    except OSError:
        return ""
    return f"{d}/{re.sub(r'[^A-Za-z0-9]+', '-', os.path.abspath(root)).strip('-')}.lock"


class git_lock:
    """One lock per repository, across processes (an flock in .git) and threads (a reentrant RLock, taken first), held across one fetch, worktree add/remove, install pull or catch-up poll and never across the review or the gates; a lock that cannot be taken skips the flock."""

    def __init__(self, root):
        self.path = git_lock_path(root)
        with _LOCKS_GUARD:
            self.st = _LOCKS.setdefault(self.path or root,
                                        {"rl": threading.RLock(), "fd": None, "depth": 0})

    def __enter__(self):
        self.st["rl"].acquire()
        try:
            if self.st["depth"] == 0 and self.path:
                fd = None
                try:
                    fd = os.open(self.path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
                    fcntl.flock(fd, fcntl.LOCK_EX)
                except OSError:
                    if fd is not None:
                        os.close(fd)
                    fd = None
                self.st["fd"] = fd
            self.st["depth"] += 1
        except BaseException:
            self.st["rl"].release()
            raise
        return self

    def __exit__(self, *exc):
        try:
            self.st["depth"] -= 1
            if self.st["depth"] == 0 and self.st["fd"] is not None:
                fd, self.st["fd"] = self.st["fd"], None
                try:
                    fcntl.flock(fd, fcntl.LOCK_UN)
                finally:
                    os.close(fd)
        finally:
            self.st["rl"].release()
        return False


def pr_lock_path(repo, pr):
    """The file one landing of a PR holds for its whole run, under LANDQ like the queue's own lock, so a hand `cc-land <repo> <pr>` and the worker's job meet on the same file."""
    return f"{LANDQ}/held/{repo}-{pr}.lock"


class pr_lock:
    """ONE LANDING PER PR, across processes. An flock taken before a gate or a read is bought — by the direct path (Land.run) and the queue's (run_one) alike — and held to the end of that landing; the holder writes who it is into the file (pid, since, the caps it runs at, its flags) so the one that arrives second names it and stands down having bought nothing. Two landers on one PR each paid the gates and a $3 review (#496 2026-09-16, and #501 the same day: a hand --re-review beside the queue's own job, the job file's absence read as 'nobody owns this PR' — the live lander is the object, not the file). `record` and `queue` never take it. A lock that cannot be made is held by nobody: the landing goes on."""

    def __init__(self, repo, pr, flags=""):
        self.repo, self.pr, self.flags, self.fd = repo, pr, flags, None

    def take(self):
        """'' when this process now holds the PR; else one line naming the landing that does."""
        path = pr_lock_path(self.repo, self.pr)
        try:
            os.makedirs(os.path.dirname(path), exist_ok=True)
            fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o644)
        except OSError:
            return ""
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            try:
                who = json.loads(os.read(fd, 4096) or b"{}")
            except ValueError:
                who = {}
            os.close(fd)
            return (f"PR #{self.pr} is already being landed by pid {who.get('pid', '?')} since {who.get('since', '?')} "
                    f"at {who.get('cap', '?')}{' ' + who['flags'] if who.get('flags') else ''} — this one stands "
                    f"down, having bought nothing; that landing merges it or says why not")
        self.fd = fd
        with contextlib.suppress(OSError):   # the holder's name is a courtesy to the second arrival; the lock is the fact
            os.ftruncate(fd, 0)
            os.write(fd, json.dumps({"pid": os.getpid(), "since": stamp(), "cap": review_caps()[0],
                                     "flags": self.flags}).encode())
        return ""

    def release(self):
        if self.fd is not None:
            fd, self.fd = self.fd, None
            with contextlib.suppress(OSError):
                fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)


def emit(text):
    """Everything this tool says about a landing goes through here."""
    print(text, flush=True)


def out(mark, text):
    emit(f"  {mark} {text}")


# ── which gates a diff has earned ────────────────────────────────────────────────────────────────────────
def blob(root, sha, path):
    """A file's contents at a commit, or None when it is not there (added on one side, deleted on the other)."""
    rc, o = sh(["git", "show", f"{sha}:{path}"], cwd=root, timeout=60)
    return o if rc == 0 else None


def undoc(tree):
    """The same AST with every docstring removed, so two trees compare equal when only prose changed."""
    for node in ast.walk(tree):
        body = getattr(node, "body", None)
        if isinstance(node, (ast.Module, ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)) and body:
            first = body[0]
            if isinstance(first, ast.Expr) and isinstance(first.value, ast.Constant) and isinstance(first.value.value, str):
                node.body = body[1:] or [ast.Pass()]
    return tree


def comment_only(root, a, b, path):
    """True when this file's change alters no code: both sides parse as Python and their docstring-stripped ASTs are equal, or every added and removed line is blank or a comment. Anything unreadable, a mode change or a rename is False."""
    old, new = blob(root, a, path), blob(root, b, path)
    if old is None or new is None:
        return False              # added or deleted outright: a whole file is never "a comment"
    if old == new:
        return False              # identical bytes and git still calls it changed: a mode bit or a rename, never prose
    o1, n1 = old.split("\n", 1)[0], new.split("\n", 1)[0]
    if o1 != n1 and (o1.startswith("#!") or n1.startswith("#!")):
        return False              # a changed interpreter line is never prose
    try:
        if ast.dump(undoc(ast.parse(old))) == ast.dump(undoc(ast.parse(new))):
            return True
    except (SyntaxError, ValueError, RecursionError, MemoryError):
        pass                      # not Python, or not parseable at one end: fall through to the line reading
    rc, d = sh(["git", "diff", "-U0", a, b, "--", path], cwd=root, timeout=60)
    if rc:
        return False
    hunk = False
    for ln in d.splitlines():
        if ln.startswith("@@"):   # the +++/--- headers all come BEFORE the first hunk, and a content line of three
            hunk = True           # dashes would otherwise be read as one of them
            continue
        if hunk and ln[:1] in ("+", "-") and not COMMENT_RE.match(ln[1:]):
            return False
    return hunk                   # no hunk at all = nothing was read; say no


def listed_paths(root, a, paths, lists, tail):
    """The changed paths one of the repo's path lists (`lists`, the first found; one path or glob per line, `#` comments) names, as (paths, declared); declared=False and every path when the repo ships none. Read at commit `a` — the base side of the diff, never the PR."""
    for lst in lists:
        text = blob(root, a, lst)
        if text is not None:
            # Patterns are relative to the tree the list describes (the repo, or core/ inside it); a path outside that tree is not in its layer.
            pre = lst[:-len(tail)]
            pats = [ln.strip() for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#")]
            return [p for p in paths if p.startswith(pre)
                    and any(p[len(pre):] == g or fnmatch.fnmatchcase(p[len(pre):], g) for g in pats)], True
    return list(paths), False


def control_paths(root, a, paths):
    """The changed paths the repo's control-layer list (CONTROL_LIST) names, as (paths, declared): what buys a paid read."""
    return listed_paths(root, a, paths, CONTROL_LIST, "tests/control-layer")


def gate_first_paths(root, a, paths):
    """The changed paths the repo's gate-first lists (GATE_FIRST_LIST) name, as (paths, declared): what keeps every gate before the merge. EVERY list found at `a` is read — core's and the overlay's beside it — not the first, since core's describes only core/ and would call the overlay's host config ordinary. A path no found list's tree covers counts as named: fail closed. No list at all: every path, so a repo that ships none lands nothing optimistically."""
    found, named = [], set()
    for lst in GATE_FIRST_LIST:
        text = blob(root, a, lst)
        if text is None:
            continue
        pre = lst[:-len("tests/gate-first")]
        found.append(pre)
        pats = [ln.strip() for ln in text.splitlines() if ln.strip() and not ln.lstrip().startswith("#")]
        named |= {p for p in paths if p.startswith(pre)
                  and any(p[len(pre):] == g or fnmatch.fnmatchcase(p[len(pre):], g) for g in pats)}
    if not found:
        return list(paths), False
    named |= {p for p in paths if not any(p.startswith(pre) for pre in found)}
    return [p for p in paths if p in named], True


def churn(root, a, b):
    """Lines added plus lines removed. WIDE_LINES + 1 when it cannot be read, so unreadable counts as wide."""
    rc, o = sh(["git", "diff", "--numstat", a, b], cwd=root, timeout=120)
    if rc:
        return WIDE_LINES + 1
    n = 0
    for ln in o.splitlines():
        f = ln.split("\t")
        n += sum(int(x) for x in f[:2] if x.isdigit())    # "-" for a binary file: counted as nothing, and binaries
    return n                                              # are never doc or comment, so they cannot reach `docs`


def gate_tier(root, a, b, changed):
    """Which gates this diff has earned, as (tier, why): `full` every gate and the paid review, `focused` the gates scoped to what the change reaches and nobody paid to read it, `docs` the cheap static gates only. Every path out that is not a positive answer is `full`."""
    paths = [p for _, p in changed]
    if not paths:
        return "full", "nothing could be read about what this changes"
    if len(paths) > WIDE_FILES:
        return "full", f"a wide diff — {len(paths)} files, more than anyone can scope by eye"
    hit = [p for p in paths if SHARED_PATH_RE.search(p)]
    if hit:
        return "full", f"the tests, the install, the config, the templates or CI changed ({', '.join(hit[:3])})"
    if REVIEW_RULES in paths:
        # The reviewer's rules are read from origin/<base>; a `docs` tier here would let a markdown-only PR rewrite them unread.
        return "full", f"{REVIEW_RULES} — the rules the reviewer is judged by are never a documentation change"
    inst = [p for p in paths if os.path.basename(p) in ("CLAUDE.md", "AGENTS.md")
            or p.startswith(".claude/") or "/.claude/" in p]
    if inst:
        # Same hole, one ring out: files every session loads must not land unread.
        return "full", f"instructions every session loads are never a documentation change ({', '.join(inst[:3])})"
    n = churn(root, a, b)
    if n > WIDE_LINES:
        return "full", f"a wide diff — {n} changed lines across {len(paths)} file(s)"
    code = [p for p in paths if not DOC_RE.search(p) and not comment_only(root, a, b, p)]
    if not code:
        return "docs", f"documentation and comments only — {len(paths)} file(s), no code changed"
    ctl, declared = control_paths(root, a, code)
    if ctl and not declared:
        return "full", f"no control-layer list on the base ({CONTROL_LIST[-1]}), so every code change is read ({', '.join(ctl[:3])})"
    if ctl:
        return "full", (f"the control layer changed ({', '.join(ctl[:3])}) — what runs unattended, or touches secrets, "
                        f"GitHub, the sandbox, the model or the landing")
    return "focused", f"a narrow change outside the control layer ({', '.join(code[:3])}): the gates it reaches, and nobody paid to read it"


def green_dir():
    """Where a passed suite leaves its own record (tests/green.sh writes them): CC_GREEN_DIR, else derived from LANDQ at call time, so the selfcheck's scratch queue is followed, never the live one."""
    return os.environ.get("CC_GREEN_DIR") or f"{LANDQ}/green"


def green_run(content, gate, scope="", part=""):
    """Has this gate already passed on this content? A green record is keyed on the git tree, spent until GREEN_TTL retires it, and answers only the same scope (CC_LAND_CHANGED paths; an unscoped record answers any) and the same half (a whole run answers either)."""
    if not content:
        return False
    base = f"{green_dir()}/{os.path.basename(gate)}"
    for p in ([f"{base}-{part}-{content[:12]}.json"] if part else []) + [f"{base}-{content[:12]}.json"]:
        j = read_json(p) or {}
        if (j.get("tree") == content and j.get("suite") == gate and (j.get("scope") or "") in ("", scope)
                and (j.get("part") or "") in ("", part)
                and time.time() - epoch_of(j.get("at", "")) <= GREEN_TTL):
            return True
    return False


def tree_id(root):
    """What a checkout HOLDS, as git names it: the key a green record is filed under."""
    rc, o = sh(["git", "rev-parse", "HEAD^{tree}"], cwd=root)
    return "" if rc else o.strip()


def sweep_records():
    """Green records past their hours go, and a change's tally nothing has touched for ROOT_TTL (root_work has stopped believing it by then) — never a merged one, which is the landing's record (root_done); an optimisation only, so it never raises."""
    for pattern, ttl in ((f"{green_dir()}/*.json", GREEN_TTL), (f"{root_dir()}/*.json", ROOT_TTL)):
        for p in glob.glob(pattern):
            try:
                if time.time() - os.path.getmtime(p) > ttl and not (read_json(p) or {}).get("merged"):
                    os.unlink(p)
            except OSError:
                pass


def root_dir():
    """Where a change's own tally lives, derived from LANDQ at call time like green_dir()."""
    return f"{LANDQ}/root"


def root_path(repo, pr):
    return f"{root_dir()}/{repo}-{pr}.json"


def root_work(repo, pr):
    """What has already been bought for this change: {'reviews': n, 'repairs': n}. Empty when nothing was spent, the record is older than ROOT_TTL, or the change is in (`merged`, root_done: history, bounding nothing); a record whose stamp will not parse is kept, not dropped."""
    j = read_json(root_path(repo, pr)) or {}
    first = epoch_of(j.get("first", ""))
    if j and (j.get("merged") or (first and time.time() - first > ROOT_TTL)):
        return {}
    return j


def root_spend(repo, pr, **bump):
    """Count a spend before it is made, on disk: an int adds to its counter, anything else (`wall=`, the cap a review died on) is set. Returns the record as it now stands; a merged change's is returned untouched — it is in, and its history is not overwritten by a late mark."""
    j = read_json(root_path(repo, pr)) or {}
    if j.get("merged"):
        return j
    j = root_work(repo, pr)
    j.setdefault("first", stamp())
    j.update(repo=repo, pr=pr, at=stamp())
    for k, n in bump.items():
        j[k] = (j.get(k) or 0) + n if isinstance(n, int) else n   # a counter adds; a record (the cap a review died on) is set
    with contextlib.suppress(OSError):   # the tally is a bound, not the landing: a queue dir that cannot be written
        os.makedirs(root_dir(), exist_ok=True)      # is caught where the job file is written, and this must not be
        write_atomic(root_path(repo, pr), j)        # the thing that stops a merge
    return j


def root_done(repo, pr):
    """The change is IN: its tally stays on disk stamped `merged` — what the change bought is the one record of it, and it is read after the PR lands (cc-lib indexes root/<repo>-<pr>.json as the landing record; `cc-lib ask --object` finds it) — while bounding nothing from then on (root_work). Until 2026-09-19 it was unlinked here, and review spend could not be audited once a PR landed."""
    j = read_json(root_path(repo, pr)) or {}
    if j and not j.get("merged"):
        j.update(merged=stamp(), at=stamp())
        with contextlib.suppress(OSError):
            write_atomic(root_path(repo, pr), j)


def pr_facts(root, pr, fields, timeout=120):
    """What GitHub says about PR `pr` in `root`, one `gh pr view --json <fields>` call, as (facts, why): a dict and ''; None and gh's last line when it failed; None and None when it answered but not with a PR object. Every reader of the PR goes through here."""
    rc, o = sh(["gh", "pr", "view", str(pr), "--json", fields], cwd=root, timeout=timeout)
    if rc:
        return None, last(o)
    try:
        j = json.loads(o)
    except ValueError:
        j = None
    return (j, "") if isinstance(j, dict) else (None, None)


def box_comments(facts):
    """The bodies of the PR comments THIS BOX wrote (`viewerDidAuthor`), oldest first: the only ones a verdict is read off, since anyone who can comment on a PR can type a marker."""
    return [c.get("body") or "" for c in facts.get("comments") or [] if isinstance(c, dict) and c.get("viewerDidAuthor")]


GH_PR_FILES = 100   # `gh pr view --json files` hands back the FIRST 100 files, sorted by path, and says nothing
                    # about there being more


def protected_paths(repo):
    """The repo's PROTECTED PATHS as (rules, why): `CC_PROTECTED_PATHS_<repo>` in ~/.cc/config (a box fact, never in published code; a repo name's `-` or `.` reads as `_`), whitespace-separated path prefixes — `learn-fetch/` is everything under it, `core/bin/x` that file. ([], '') when the repo has no list. (None, why) when cc-config did not answer at all, which protected_hit reports as a hit: member_config folds a failed read into '', '' reads as "no rules", and no rules waves the PR through the one guard that must fail closed. cc-config's exit 1 IS an answer — its documented "the key is not set" — and reading that as a failure would make every repo on this box protected and stop every landing."""
    key = "CC_PROTECTED_PATHS_" + re.sub(r"[^A-Za-z0-9]", "_", repo)
    rc, o = sh([f"{BIN}/cc-config", "get", key], timeout=30)
    if rc not in (0, 1):
        return None, f"cc-config could not read {key} ({last(o) or 'exit ' + str(rc)})"
    return o.split(), ""


def protected_hit(repo, pr):
    """The first file PR `pr` changes under one of the repo's protected paths, as (file, rule), or None. One `gh pr view --json files` per ask. FAIL CLOSED in every way this can not-know — rules cc-config would not read, files gh could not name, a PR with more files than gh lists — each of which is a hit ('?', why), the opposite of doomed(), because here the cost of a wrong yes is a change to the thing the owner said no session may change."""
    rules, why = protected_paths(repo)
    if rules is None:
        return ("?", why)
    if not rules:
        return None
    j, why = pr_facts(repo_root(repo), pr, "files", timeout=60)
    if j is None:
        return ("?", f"gh could not list the PR's files ({why or 'no PR object'})")
    files = j.get("files") or []
    for f in files:
        path = (f.get("path") or "") if isinstance(f, dict) else ""
        for rule in rules:
            if path == rule.rstrip("/") or path.startswith(rule.rstrip("/") + "/"):
                return (path, rule)
    if len(files) >= GH_PR_FILES:
        # gh's page is the first 100 paths in sort order: a PR at or over it has files it never named, and the
        # protected one may be among them. No file to name, so the hit is the uncertainty itself.
        return ("?", f"gh lists only the first {GH_PR_FILES} of the PR's files and this PR has at least that "
                     f"many — the ones it did not name may be under {', '.join(rules)}")
    return None


def owner_approved(uid):
    """Was it the owner's own 👍? `--approved-by <slack uid>` is what cc-slack's approvals handler passes for the person who reacted, and it is his when it equals SLACK_OWNER_ID (~/.cc/config). Nothing else — not `--who`, which is a display name — lifts a protected-path hold."""
    return bool(uid) and uid == member_config("SLACK_OWNER_ID", "")


def pr_head(repo, pr):
    """The PR's head SHA — the one thing an owner's 👍 on a protected path is pinned to — asked of the REMOTE REF itself (remote_head) and of the PR object only when origin will not say. It has to be the same SHA every other step of the landing means by "the head": the gates fetch the branch ref (Land.resolve_head), the merge pins `--match-head-commit` to it, and `gh pr view --json headRefOid` LAGS that ref (remote_head's own docstring). A door that pinned his yes to the lagging answer would approve H1 while H2 was already pushed, and the same lag at the next sweep would then read as "the head has not moved"."""
    j = pr_facts(repo_root(repo), pr, "headRefOid,headRefName", timeout=60)[0] or {}
    return remote_head(repo, (j.get("headRefName") or "").strip()) or (j.get("headRefOid") or "").strip()


def protected_under(repo, hit):
    """The hold's own words for a hit: the file and the rule it is under — or, for a '?' hit, why it could not know."""
    return (f"it touches {hit[0]}, under {repo}'s PROTECTED path {hit[1]} (CC_PROTECTED_PATHS_{repo})"
            if hit[0] != "?" else f"{hit[1]}, and {repo} has PROTECTED paths")


def protected_stop(job):
    """Why a job already on the queue must not go on, as (file, why), or None: the door's question asked AGAIN, and at every head. The door writes `approved_by` (the uid that 👍'd) and `approved_head` (the head that 👍 was about) on the job, because a job queued while the PR touched nothing protected keeps running through its fix rounds — a round that pushes a change under a protected path is a new question, and the yes given at the door was about the head that was there then. Only the owner's own uid, on the head he approved, goes on; a gh that cannot name the head is a stop, not a pass. This check is the door and not the lock: a push landing between it and the merge would still be a head nobody 👍'd, so Land.merge pins `--match-head-commit` to `approved_head` itself and GitHub refuses any other."""
    repo, pr = job.get("repo") or "", job.get("pr")
    hit = protected_hit(repo, pr)
    if not hit:
        return None
    under = protected_under(repo, hit)
    if not owner_approved(job.get("approved_by") or ""):
        return hit[0], f"{under}, and no 👍 of the owner's queued it"
    head = pr_head(repo, pr)
    if head and head == (job.get("approved_head") or ""):
        return None
    why = (f"{under}, at a head the owner has not 👍'd "
           f"({(job.get('approved_head') or 'no head recorded')[:12]} → {head[:12] or 'gh cannot say'})")
    # A head ORIGIN NAMED that is not the one he 👍'd is a certain fact of its own, and the stop is then definite
    # even where the FILE LIST is the not-knowing: protected_hit answers ('?', why) for ever on a PR over
    # GH_PR_FILES files, so handing that '?' on would have run_job hold the job every RETRY_AFTER for ever — never
    # merged, never said, and his second 👍 refused as already queued (review of #527). Only a head origin would
    # not name leaves the whole stop a not-knowing, and that one clears on its own.
    return ("moved" if hit[0] == "?" and head else hit[0]), why


def ordinary(repo, pr):
    """Why PR `pr` is NOT ordinary, or '' with its changed paths, as (why, paths). Brief: "an ordinary PR (its merge with main is file-disjoint from what's landing with it, and it touches no protected path)" — and "protected paths (cc-guard, cc-sandbox, cc-land itself, hooks, anything security) keep the full gate before merge": so it touches no PROTECTED path (protected_hit, which fails closed) and nothing the repo's gate-first list names at the base. Disjointness is the batch's question (batch_of); the worker's own green is the warm's (worker_green). A file list gh could not give, or one at GH_PR_FILES, is not ordinary either."""
    hit = protected_hit(repo, pr)
    if hit:
        return protected_under(repo, hit), []
    root = repo_root(repo)
    j, why = pr_facts(root, pr, "files,baseRefName", timeout=60)
    if j is None:
        return f"gh could not list the PR's files ({why or 'no PR object'})", []
    files = sorted({(f.get("path") or "") for f in (j.get("files") or []) if isinstance(f, dict)} - {""})
    if not files:
        return "gh names no changed file", []
    if len(files) >= GH_PR_FILES:
        return f"gh names only the first {GH_PR_FILES} of the PR's files and this PR has at least that many", []
    # Only a PR INTO the default branch: the list is read there, the suite runs there and a revert lands there. A
    # base the author chose is none of those, and a list read off it is the author's own.
    base = board(repo).get("default_branch") or "main"
    into = (j.get("baseRefName") or "").strip()
    if into != base:
        return f"it merges into {into or 'a branch gh would not name'}, not {base}: only a PR into {base} lands in a batch", []
    first, declared = gate_first_paths(root, f"origin/{base}", files)
    if not declared:
        return f"{repo} ships no {GATE_FIRST_LIST[-1]} list on {base}, so every PR of it runs every gate before it merges", []
    if first:
        return (f"it touches {', '.join(first[:3])}, on {repo}'s gate-first list ({GATE_FIRST_LIST[-1]}) or outside "
                f"every tree one covers: every gate runs before the merge"), []
    return "", files


def doomed(repo, pr):
    """Why a landing of this PR cannot succeed, or '': asked at queue time from what Land.mark_doomed wrote and one `gh pr view`, no git. Every uncertainty (a moved head, any verdict since recorded, a raised cap, a gh error) answers '': it never refuses what could have landed."""
    d = (root_work(repo, pr) or {}).get("doomed") or {}
    if not d.get("head") or not d.get("why"):
        return ""
    j = pr_facts(repo_root(repo), pr, "headRefOid,comments", timeout=60)[0]
    if j is None:
        return ""
    if (j.get("headRefOid") or "") != d["head"] or (d.get("wall") and not wall_stands(d["wall"])):
        return ""
    if any(verdict_in(body, d.get("key") or "") for body in box_comments(j)):   # counted as prior_review() counts them
        return ""
    return d["why"]


def last(text, n=200):
    return next((l.strip() for l in reversed((text or "").splitlines()) if l.strip()), "")[-n:]


GATE_RED = re.compile(r"✗|✘|FAIL|Error\b|error:|not ok|Traceback")
GATE_PASS = re.compile(r"^\W*[✓✔]|^\s*(?:ok|pass(?:ed)?)\b", re.I)   # …and what a line REPORTING A PASS looks like


def gate_fail(text):
    """The line somebody can act on when a gate goes red: the ✗/FAIL case lines, else the last line — and a line
    that reports a PASS is never either of them, however it is worded. '✓ …and when the link does not take it,
    cc-notify FAILS' is a case that PASSED whose name holds the word FAIL; naming it as the failure sent #485's
    worker after a case that was green while the real red went unnamed for 17 hours (2026-09-15)."""
    lines = [l for l in (text or "").splitlines() if not GATE_PASS.match(l)]
    hits = [l.strip() for l in lines if GATE_RED.search(l)]
    return " · ".join(hits[:3])[:400] or last("\n".join(lines)) or last(text)


def record_red(scope, gate, content, log, text, pr="", writer="cc-land"):
    """Write a red gate to the failures ledger (docs/design-failure-noticing-2026-09-11.md) with one `cc-green red` call, kind gate-verdict/red, keyed gate:<gate>:<tree> like a worker's cc-green, so it is one record whoever wrote first. Never a verdict: a failed write is one line, and the caller's Failed is raised as before."""
    try:
        rc, o = sh([f"{BIN}/cc-green", "red", scope, "gate-verdict/red", f"gate:{gate}:{content[:12]}",
                    "--observed", f"gate {gate} did not pass at the landing of {scope}{' PR #' + str(pr) if pr else ''} "
                                  f"on {content[:12]}: {gate_fail(text)}"[:600],
                    "--expected", "a tree handed over passes its gates", "--log", log, "--writer", writer,
                    "--cost", "fix-iteration=1", "--link", f"gate={gate}", "--link", f"tree={content}"]
                   + (["--link", f"pr={pr}"] if pr else []), timeout=60)
        word = last(o) or ("recorded" if rc == 0 else "not recorded: cc-green red exited %d" % rc)
    except Exception as e:                    # noqa: BLE001 — the ledger must never decide a gate
        word = f"not recorded: {e.__class__.__name__}: {e}"
    out("·", f"failures ledger ({scope}): {word}")


def stale_note(root, base_ref, base, head, mine=()):
    """Why a red gate may be the calendar rather than a bug, as a sentence for the failure line, or '': how many commits the base has that this head does not, and which files those moved that this head does not itself change, naming the commit measured. '' whenever git cannot say."""
    rc, o = sh(["git", "rev-list", "--count", f"{head}..{base_ref}"], cwd=root)
    n = int(o.strip()) if not rc and o.strip().isdigit() else 0
    if n <= 0:
        return ""
    behind = f"{n} commit{'' if n == 1 else 's'} behind {base}"
    rc, o = sh(["git", "merge-base", base_ref, head], cwd=root)
    fork = o.strip() if not rc else ""
    moved = []
    if fork:
        rc, o = sh(["git", "diff", "--name-only", fork, base_ref], cwd=root)
        if not rc:
            own = set(mine)
            moved = [l.strip() for l in (o or "").splitlines() if l.strip() and l.strip() not in own]
    missing = ("without " + ", ".join(moved[:3]) + (f" and {len(moved) - 3} more" if len(moved) > 3 else "")
               if moved else "")
    return (f" — and the commit gated here, {head[:12]}, is {behind}" + (f", {missing}" if missing else "")
            + f": rebase it onto {base} and run again before hunting for a bug that may already be fixed")


def merge_result(root, base, head):
    """The commit whose tree `base` will hold once `head` is squashed in, built with plumbing only (merge-tree, commit-tree), as (commit-ish, base-sha, tree): `head` and the base's own sha with NO tree when the base is an ancestor already (nothing to merge), ('', '', '') when git cannot build it. The base sha is the one the caller records and compares bases by, so it is answered whether or not a merge was built; an empty TREE, not an empty base, is what says no merge happened. A textual conflict raises."""
    if not base or not head:
        return "", "", ""
    rc, o = sh(["git", "rev-parse", "--verify", "--quiet", f"{base}^{{commit}}"], cwd=root)
    base_sha = o.strip() if rc == 0 else ""
    if not base_sha:
        return "", "", ""
    if sh(["git", "merge-base", "--is-ancestor", base_sha, head], cwd=root)[0] == 0:
        return head, base_sha, ""   # the head already holds the base: merging it changes nothing, so gate the head —
                                    # but say WHICH base that was, for the caller comparing it with the one projected
    rc, o = sh(["git", "merge-tree", "--write-tree", base_sha, head], cwd=root, timeout=300)
    tree = (o.splitlines() or [""])[0].strip()
    if rc == 1:
        raise Failed(f"{head[:12]} conflicts with {base} at {base_sha[:12]} — rebase it, then land it: "
                     f"{last(o)}",
                     # The card names the base and the remedy, never the two SHAs — and in cc-replay's words
                     # (STOP_CONFLICT: `conflicts with \S+ — rebase`), which is how a stop is classified.
                     short=f"the branch conflicts with {base} — rebase it")
    if rc or not re.fullmatch(r"[0-9a-f]{40,64}", tree):
        return "", "", ""
    ident = dict(os.environ, GIT_AUTHOR_NAME="cc-land", GIT_AUTHOR_EMAIL="cc-land@invalid",
                 GIT_COMMITTER_NAME="cc-land", GIT_COMMITTER_EMAIL="cc-land@invalid")
    rc, o = sh(["git", "commit-tree", tree, "-p", base_sha, "-p", head,
                "-m", f"cc-land: {base} {base_sha[:12]} merged with {head[:12]}"], cwd=root, env=ident)
    sha = o.strip()
    if rc or not re.fullmatch(r"[0-9a-f]{40,64}", sha):
        return "", "", ""
    return sha, base_sha, tree


def verdict_in(body, key):
    """The verdict a PR comment records about change `key`, anchored at the start of the comment where post_review() and `record` put the marker; module-level because Land.prior_verdict and doomed() both ask it. Returns (verdict, findings, who) or ''."""
    if not key:
        return ""
    m = re.compile(rf"\A\s*<!-- {re.escape(REVIEW_MARK)} v2 change={re.escape(key)}(?: [^>]*?)? "
                   r"verdict=(LAND-AFTER-FIX|DO-NOT-LAND|LAND)\b[^>]*-->").match(body)
    if m:
        who = re.search(r"\bby=([A-Za-z0-9._@-]+)", m.group(0))
        return m.group(1), body[m.end():].strip(), (who.group(1) if who else "")
    return ""


ANY_MARK_RE = re.compile(rf"\A\s*<!-- {re.escape(REVIEW_MARK)} v2 change=[0-9a-f]+(?: [^>]*?)? verdict="
                         r"(LAND-AFTER-FIX|DO-NOT-LAND|LAND)\b")


def verdict_written(body):
    """The verdict a marker comment records about any change or head: what this box last said about the PR at all (prior_review keeps it as `stood`), same anchor as verdict_in. Returns (verdict, findings, who) or ''."""
    m = ANY_MARK_RE.match(body or "")
    return m.group(1) if m else ""


def verdict_of(answer):
    """The reviewer's answer as a decision: the validated `verdict` field when the runner used the schema, else the free-text fallback, where two different verdict lines are no verdict at all. Returns (verdict, prose); ('', prose) means nothing read this diff."""
    try:
        j = json.loads(answer)
    except ValueError:
        j = None
    if isinstance(j, dict) and j.get("verdict") in REVIEW_VERDICTS:
        rows = []
        for i, f in enumerate(j.get("findings") or [], 1):
            f = f if isinstance(f, dict) else {"what": str(f)}
            rows.append(f"{i}. {f.get('where') or '(nowhere named)'} — {f.get('what') or ''}"
                        + (f" → {f['fix']}" if f.get("fix") else ""))
        return j["verdict"], "\n".join(rows) or "No findings."
    said = (answer or "").strip()
    seen = {m.group(1) for m in VERDICT_RE.finditer(said)}
    if len(seen) != 1:
        return "", last(said) if said else "(nothing at all)"
    return seen.pop(), said


def name_status(text):
    """git --name-status output -> [(status, path)]. 'A' is what tells a unit this change ADDED from one it touched."""
    rows = []
    for ln in (text or "").splitlines():
        f = ln.split("\t")
        if len(f) >= 2 and f[0]:
            rows.append((f[0][0], f[-1]))
    return rows


HUNK = re.compile(r"^@@ -[0-9,]+ \+[0-9,]+ @@.*$")   # the whole header: its numbers AND the function-context tail git adds after it
HUNK_LEGACY = re.compile(r"^@@ -[0-9,]+ \+[0-9,]+ @@")   # …what keyed every verdict written before 2026-09-19: the tail stayed in


def change_digest(diff, legacy=False):
    """A `git diff` text to the 40 hex characters naming the change, or '' for no diff. Only the `index <blob>..<blob>` line and the hunk header are dropped — its line numbers, and the function-context tail (`@@ … @@ def f():`) git copies from a line ABOVE the hunk, which a commit main took above the change rewrites (2026-09-19: a rebase over one such commit re-keyed the change and bought its read again); everything else is hashed verbatim, whitespace included, which `git patch-id` would strip. `legacy` keeps the tail: the key a verdict recorded before that date carries, which prior_verdict still accepts so the PRs open at the deploy are not all read again."""
    keep = []
    for ln in (diff or "").splitlines():
        if ln.startswith("index "):
            continue
        keep.append((HUNK_LEGACY if legacy else HUNK).sub("@@", ln) if ln.startswith("@@ ") else ln)
    body = "\n".join(keep).strip()
    return hashlib.sha256(body.encode("utf-8", "replace")).hexdigest()[:40] if body else ""


# ── the landing ──────────────────────────────────────────────────────────────────────────────────────────
class Land:
    def __init__(self, repo, pr=None, span=None, review=True, re_review=False, full_gates=False):
        self.repo, self.pr = repo, pr
        self.want_review = review    # --no-review turns the gate off. Default ON everywhere, the 👍 path included
        self.re_review = re_review   # …and --re-review buys a SECOND opinion on a head one was already bought for
        self.full_gates = full_gates  # --full-gates: never scope the gates to the diff, run every one of them
        self.verdict = ""        # the review's answer as a FIELD, so the queue can act on LAND-AFTER-FIX without
        self.findings = ""       # re-reading its own error message — and what the reviewer said, for the fix brief
        self.by = ""             # which model actually read it, so the PR comment cannot claim a different one
        self.stood = ""          # the last verdict this box wrote on the PR for any change of it (prior_review)
        self._ckey = None        # (head, digest): what change this IS — see change_key()
        self._mb = None          # (head, merge-base, why): where it left the base — see merge_base()
        self._tier = None        # (head, tier, why): decided ONCE per head and shared by the review and the gates
        self.span = span         # (installed_sha, tip_sha): a deploy with no PR, catching the box up to a merge it missed
        self.job = ""            # the queue file this landing is running out of, if any — the stage is written to it
        self.stopped = ""        # the step that stopped it, so the worker knows whether trying again could differ
        self.why = ""            # …and what it said
        self.why_short = ""      # …and the few words of it the card carries, when the step named them (Failed.short)
        self.root = repo_root(repo)
        self.member, self.mtrack = member_of(repo)   # a member workspace's project: <handle>, <track> (see MEMBERS)
        self.project = self.member or repo   # the name cc, cc-board, cc-scope and cc-task know this repo by (a member project's: its handle)
        self.hurt = []           # cosmetic steps that failed: reported, not fatal, named again at the end
        self.facts = {}          # what GitHub says about the PR
        self.changed = None      # [(status, path)] this landing makes; worked out once, when it is first needed
        self.head = ""           # the PR head as a SHA — never "FETCH_HEAD", which the pull below overwrites
        self.gated = ""          # …the SHA the gates ran on: what the review after them, and the merge, are pinned to
        self.merged_on = ""      # …and the base it was merged with before they ran (merge_result); "" when the head already held it
        self.merge_unbuilt = False   # …and the third state: git could not build the merge, so the gates ran on the head alone
        self.reviewed = ""       # …and the SHA the review actually read, for the fix round's "has it pushed yet"
        self.approved_head = ""  # …and, for a PR under a PROTECTED path, the head the owner's own 👍 was about: the
                                 # merge is pinned to THIS and not to the head the gates happened to find (merge)
        self._review = None      # the review running BESIDE the suite (a thread) and what it decided: see gates()
        self._read = None
        self.bought = False      # …and whether that read spent a buy: given back only by a usage limit or a cap, never by a red suite
        self.restarted = []
        self.owner_asks = []     # …and what is on the old code because the manifest keeps its restart for the owner: carries the command
        self.unverified = []     # ledger rows this landing could not confirm: named, and left open
        self.warm_only = False   # --warm: the static gates and the read, no merge, the outcome written on the job (warm_done)
        self.warm = None         # …and, in the batch's merge pass, what that warm wrote (spend_warm)
        self.warm_base = ""      # …the base SHA the warm's merge was built on, for the pass that spends it
        self.batch = ""          # the batch this landing merges with: its deploy waits for the batch's suite (after_batch)

    def base(self):
        if self.member and self.mtrack:   # the project's repository, not the workspace's board: what the PR says
            return self.facts.get("baseRefName") or "main"
        return board(self.repo).get("default_branch") or "main"

    def what(self):
        if self.pr:
            return f"PR #{self.pr} {self.facts.get('title', '')}".strip()
        return f"{self.base()} {self.span[0][:7]}..{self.span[1][:7]}"

    def fetch_head(self):
        """The PR's head as a SHA, with origin/<base> fetched too: the branch ref's SHA from ls-remote, `pull/<pr>/head` only as a fallback, never FETCH_HEAD's (resolve_head). Sets self.head and returns it."""
        self.head = self.resolve_head()
        return self.head

    def resolve_head(self):
        """The same question without touching self.head: the review thread asks it again beside the gates, and only the thread that owns the landing writes self.head."""
        branch = (self.facts.get("headRefName") or "").strip()
        pull = f"refs/pull/{self.pr}/head"
        shas = remote_shas(self.repo, f"refs/heads/{branch}" if branch else "", pull)
        on_branch, on_pull = shas.get(f"refs/heads/{branch}", ""), shas.get(pull, "")
        with git_lock(self.root):   # FETCH_HEAD is one file per repo: the fetch and the rev-parse that reads it are one operation
            sh(["git", "fetch", "-q", "origin", self.base()], cwd=self.root, timeout=300)   # stale is not fatal
            spec = f"refs/heads/{branch}" if on_branch else f"pull/{self.pr}/head"
            rc, o = sh(["git", "fetch", "-q", "origin", spec], cwd=self.root, timeout=300)
            if rc:
                raise Failed(f"cannot fetch PR #{self.pr}: {last(o)}")
            if on_branch:
                # The branch's SHA, not FETCH_HEAD's, which any fetch of this checkout rewrites; a fetch that did not bring what ls-remote named is refused, naming both.
                rc, _ = sh(["git", "cat-file", "-e", f"{on_branch}^{{commit}}"], cwd=self.root)
                if rc:
                    raise Failed(f"PR #{self.pr}: {branch} is at {on_branch[:12]} on origin, but the fetch did not "
                                 f"bring that commit here (the pull ref says {on_pull[:12] or 'nothing'}) — "
                                 f"refusing to gate either")
                return on_branch
            rc, o = sh(["git", "rev-parse", "FETCH_HEAD"], cwd=self.root)
            if rc:
                raise Failed(f"cannot resolve the head of PR #{self.pr}: {last(o)}")
        return o.strip()

    def head_checkout(self, step, fetch=True, at=""):
        """A commit of this PR's in a throwaway worktree, `at` (the merge the gates run on) or the head, fetched fresh for each step. Named `cc-land.<step>.<repo>.<pr>.<random>`: cc-spend reads the lane off that name. Returns (tmp, tree)."""
        if fetch:
            self.fetch_head()
        tag = re.sub(r"[^A-Za-z0-9_-]+", "-", self.repo or "") or "repo"      # no dots: they separate the fields
        tmp = tempfile.mkdtemp(prefix=f"cc-land.{step}.{tag}.{self.pr or 'base'}.", dir=run_root())
        tree = f"{tmp}/head"
        with git_lock(self.root):    # .git/worktrees is shared too; held for the bookkeeping git writes, a second
            rc, o = sh(["git", "worktree", "add", "-q", "--detach", tree, at or self.head], cwd=self.root, timeout=300)
        if rc:
            full = disk_full(o)              # asked before the rmtree frees what the half checkout took
            shutil.rmtree(tmp, ignore_errors=True)
            raise Failed(f"cannot check out PR #{self.pr}: {last(o)}{full}")
        return tmp, tree

    def drop_checkout(self, tmp, tree):
        with git_lock(self.root):
            sh(["git", "worktree", "remove", "--force", tree], cwd=self.root)
        shutil.rmtree(tmp, ignore_errors=True)

    # -- 1. the review -------------------------------------------------------------------------------------
    def review(self):
        """The review step: collects the read that ran beside the gates (read_alongside), or makes it here when no gate ran; judged by verdict_result either way, and a head that moved since it was gated and read is refused."""
        if self._review is None:
            return self.review_now()
        try:
            said = self.review_aside()
        except Failed as e:
            if not getattr(e, "doomed", False):
                raise
            said, wall = "", e
        self.moved_since_gated(self.fetch_head(), " and read")
        if said:
            return said + " — read while the gates ran"
        # A refusal reached while the gates ran is re-checked before it stands: a verdict recorded during those minutes answers what the wall refused for.
        prior = self.prior_review()
        if not prior:
            raise wall              # nothing recorded since the mark: the refusal stands, as it was written
        verdict, found, who = prior
        return self.verdict_result(verdict, found, f"read already by {who or 'this box'}",
                                   "recorded for this change while the gates ran",
                                   " — the wall reached at the start of them does not stand against a record")

    def moved_since_gated(self, now, verb=""):
        """A head that moved while the gates ran is refused: merging it would put ungated code on the default branch under a green gate line about something else."""
        if self.gated and now != self.gated:
            raise Failed(f"PR #{self.pr} moved while it was being gated{verb}: {self.gated[:12]} was gated, "
                         f"{now[:12]} is there now — nothing merges ungated. Re-run to gate the new head")

    def read_alongside(self):
        """Start the read on a thread at t=0 beside the gates; review() collects what it decided, and a red gate does too, so a paid verdict is never lost."""
        if self._review is not None or not self.pr or not self.want_review:
            return

        def go():
            try:
                self._read = ("ok", self.review_now())
            except BaseException as e:
                self._read = ("err", e)
        self._review = threading.Thread(target=go, name=f"review-{self.repo}-{self.pr}", daemon=True)
        self._review.start()

    def review_aside(self):
        """What the thread decided, once it has: its line, or the Skip/Failed it raised, raised again here."""
        t, self._review = self._review, None
        t.join()
        kind, v = self._read
        if kind == "err":
            raise v
        return v

    def member_buys_review(self, usd):
        """Charge one review's CAP to the member workspace's day before that review is asked for, or raise the usage limit run_job defers on. Every buy comes through here — the first read and the automatic relaunch at the doubled cap alike — so the most a run can spend is booked against MEMBER_DAILY_USD before it can spend it, and a workspace with no room left gets the same deferral either way instead of a read it cannot pay for."""
        over = member_charge(self.member, usd)
        if not over:
            return
        # The MINUTES to that reset are counted here, because `(Nm left)` is the only token limit_until can
        # read a day off: the bare clock time `00:00Z` is already behind us, and a bare one behind us books
        # one RETRY_AFTER — which would re-run this whole landing, the gates included, every 15 min until
        # midnight, each pass uncounted because the deferral hands the attempt back. cc-limit knows nothing
        # of a member's cap, so this deferral is never re-asked either (limit_src "review", limit_stands).
        at = int(time.time())                       # epoch days ARE UTC days, so this is the next 00:00Z,
        mins = ((at // 86400 + 1) * 86400 - at + 59) // 60      # rounded up as cc-limit rounds its own
        raise Failed(f"no review: usage limit until 00:00Z ({mins}m left) — {self.member} has used "
                     f"${over[0]:.2f} of its ${over[1]:.0f}/day (MEMBER_DAILY_USD) and this review asks "
                     f"${usd:.2f}; the landing waits for the day to reset")

    def review_now(self):
        """One headless reviewer: it reads the diff, the files at the PR's head, the track's brief (never its journal) and the repo's docs/REVIEW.md, with no shell and nothing to write with. Who reads it, or nobody, is review_model()'s answer."""
        if not self.want_review:
            raise Skip("--no-review: nothing read this diff before it merged")
        if self.merged_since():
            # Asked again here, not read off load(): the gates before this take up to an hour, and this is where the money goes.
            raise Skip(f"PR #{self.pr} is already merged — the review guards the merge, and it has happened")
        tpl = f"{os.path.dirname(BIN)}/{REVIEW_PROMPT}"
        try:
            tpl = open(tpl).read()
        except OSError as e:
            raise Failed(f"the reviewer prompt is missing ({e}) — install.sh did not link this checkout, or "
                         f"land with --no-review and read the diff yourself")
        # A local, never self.head: this runs on the review thread while the owning thread is still gating self.head.
        now = self.resolve_head()
        self.moved_since_gated(now)
        if not self.gated:
            self.head = now     # nothing has been gated yet, so no thread exists: this IS the owning thread
        self.reviewed = self.head        # the SHA a dispatched fix round is waiting to see move off
        prior = self.prior_review()
        if prior and not self.re_review:
            # The recorded verdict is the ordinary path: one change (change_key, so a rebase keeps it), one verdict, whoever recorded it, until --re-review or a different diff.
            verdict, said, who = prior
            return self.verdict_result(verdict, said, f"read already by {who or 'this box'}",
                                       "recorded for this change",
                                       ", already on the PR (--re-review to ask again)")
        self.by, tier, why = self.review_model()
        if not self.by:
            # Nothing needs to read prose: a verdict about it costs more than the change.
            raise Skip(f"no model read this diff — the {tier} tier: {why}")
        # ...and how many reads this change has bought already: ROOT_REVIEWS plus one per repair round; past that a person judges. --re-review is a person asking and is not counted against them.
        spent = root_work(self.repo, self.pr)
        if (self.stood == "LAND-AFTER-FIX" and spent.get("repairs", 0) < ROOT_REPAIRS
                and spent.get("reviews", 0) >= reads_earned(spent) and not self.re_review):
            # The repair round is the fix, not the dispatch: a LAND-AFTER-FIX standing with the diff moved since is the round, whoever pushed it, counted once, bounded by ROOT_REPAIRS, and only where the wall would otherwise bind.
            spent = root_spend(self.repo, self.pr, repairs=1)
            out("·", f"the push after the LAND-AFTER-FIX on PR #{self.pr} is its repair round — counted as one, "
                     f"and this read is the one that round earns")
        if spent.get("reviews", 0) >= reads_earned(spent) and not self.re_review:
            raise self.mark_doomed(Failed(
                f"the review budget for this change is spent: PR #{self.pr} has already bought "
                f"{spent.get('reviews', 0)} review(s) and {spent.get('repairs', 0)} repair round(s), and "
                f"the diff at {self.head[:12]} is not one they read. "
                + (f"A new PR is a new budget: close this one and open another for the fixed branch" if self.member else
                   # The seat's own route FIRST: `record … LAND` was refused to the planning seat as self-approval
                   # (#521, 2026-09-19) after this message named it first, and the seat's read was thrown away.
                   f"The planning session decides now — buy one more read (`cc-land {self.repo} {self.pr} "
                   f"--re-review`, the one route a seat takes on its own), or a PERSON who read the diff writes "
                   f"that down (`cc-land record {self.repo} {self.pr} LAND --by <who>`, which this landing then "
                   f"reads; refused to the seat that would land it, as self-approval) or lands it with no "
                   f"verdict on the PR (`cc-land {self.repo} {self.pr} --no-review`)")))
        # ...and whether this exact head already died on a cap: refused until the cap that bound is raised (wall_stands), or --re-review.
        wall = spent.get("wall") or {}
        if wall.get("head") == self.head and wall_stands(wall) and not wall.get("answered") and not self.re_review:
            name = (WALL_SUBTYPE.get(wall.get("hit") or "") or ("the cap", ""))[0]
            var, more = review_caps(wall.get("hit") or "")[1:3]
            with contextlib.suppress(TypeError, ValueError):   # doubled from the cap it HIT — after the relaunch that
                more = f"{float(wall.get('was')) * 2:g}"       # is the doubled one already, and the environment's × 2 stands
            raise self.mark_doomed(Failed(
                f"{WALL}: PR #{self.pr} already spent {wall.get('cost')} at {wall.get('cap')} on "
                f"{self.head[:12]} and read nothing — {name} stopped it and has not moved since, so this "
                f"run is not bought. Raise the cap that stopped it "
                f"(`{var}={more} cc-land {self.repo} {self.pr}`), read the diff yourself (`--no-review`), "
                f"or buy that same run over again (`--re-review`)."), wall=wall)
        stamp = sh([f"{BIN}/cc-limit", "status"], timeout=60)
        if stamp[0] == 0:
            raise Failed(f"no review: {stamp[1].strip()} — the landing waits for the model, or --no-review")
        if self.member:
            # The review is charged to the workspace's daily cap before the buy; the cap reached is weather (limited), deferred by run_job to the day's reset.
            self.member_buys_review(float(REVIEW_BUDGET))
        tmp, tree = self.head_checkout("review", fetch=False)   # fetched above, to answer "read this head already?"
        try:
            dpath = f"{tmp}/pr-{self.pr}.diff"
            open(dpath, "w").write(self.pr_diff() or "")
            # Counted before the money goes; a --re-review is counted as `asked` beside it (reads_earned).
            buy = dict(reviews=1, **({"asked": 1} if self.re_review else {}))
            root_spend(self.repo, self.pr, **buy)
            self.bought = True
            prompt, more, first = self.review_prompt(tpl, tree, dpath), {}, {}
            # Brief 2026-09-19: "one automatic relaunch at the doubled cap the card already prints, then a person".
            # Once per HEAD: a wall this head was already relaunched past (`again` on its record) is a person's run
            # now — their raised cap, or their --re-review — and a second wall on it is theirs to answer.
            relaunched = wall.get("head") == self.head and bool(wall.get("again"))
            while True:
                try:
                    answer, cost, toks = self.ask_reviewer(prompt, tree, tmp, **more)
                    if more:    # the relaunch read: the wall before it stays on the record for the tally, answered, and refuses nothing
                        root_spend(self.repo, self.pr, wall=dict(root_work(self.repo, self.pr).get("wall") or {}, answered=True))
                    break
                except Failed as e:
                    # A usage limit means the model never ran, so the count is given back here (the cc-limit pre-check above raises the same limit before anything is counted).
                    if limited(str(e)):
                        root_spend(self.repo, self.pr, **{k: -n for k, n in buy.items()})
                        self.bought = False
                        raise
                    if not getattr(e, "wall", None):
                        raise
                    # A cap stopped this one: the money is gone and the wall goes on the record, so the next attempt at this head is refused above.
                    if more:
                        e.wall["again"] = first      # …with the run before it kept beside: two priced walls, no verdict
                    elif relaunched:
                        e.wall["again"] = wall.get("again")   # a person's run past the relaunch walls too: the head STAYS
                    root_spend(self.repo, self.pr, wall=e.wall, **{k: -n for k, n in buy.items()})   # relaunched on the record, or their next raise would buy the box's relaunch again at double their cap
                    self.bought = False
                    if more or relaunched:
                        e.args = (f"{e} Run twice at this head" + (f" ({first['cap']}, then {e.wall['cap']})" if more else "")
                                  + " — a person decides now: that raise, the diff read yourself, or --re-review.",)
                        raise
                    cap, var, doubled, _ = review_caps(e.wall.get("hit") or "")
                    first = {k: e.wall[k] for k in ("cap", "cost", "turns", "hit")}
                    more = {"budget" if var == "CC_LAND_REVIEW_BUDGET" else "turns": doubled}
                    if self.member:
                        # The relaunch spends again, up to the DOUBLED money cap, so it is booked like the first read
                        # and refused the same way: a workspace with $3 of room left does not get a $6 run on the box's
                        # initiative. Raised before the relaunch is announced, so nothing promises a run that is not
                        # bought — the wall above is already on the record with its buy given back, so run_job defers
                        # this head to the day's reset rather than relaunching, and the cap holds at the cap.
                        self.member_buys_review(float(more.get("budget") or REVIEW_BUDGET))
                    out("·", f"{WALL} at {cap}: {e.wall['cost']} and {e.wall['turns']} turns on PR #{self.pr} read "
                             f"nothing — run once more at {var}={doubled}, the relaunch the card would have asked a "
                             f"person for; a second wall is theirs")
                    root_spend(self.repo, self.pr, **buy)     # the relaunch is a buy like the first, counted before it goes
                    self.bought = True
        finally:
            self.drop_checkout(tmp, tree)
        verdict, said = verdict_of(answer)
        if not verdict:
            raise Failed(f"the reviewer answered without a verdict ({cost}, {toks}) — nothing read this diff, "
                         f"so nothing merges it. Re-run, or --no-review and read it yourself. Said: {said}")
        return self.verdict_result(verdict, said, f"reviewed by {self.by} at the {tier} tier ({why})",
                                   cost, f", {toks}" + self.post_review(verdict, said))

    def verdict_result(self, verdict, said, verb, cost, posted):
        """One place decides what a verdict means, so a verdict read back off the PR and one just bought stop the landing on the same terms."""
        self.verdict, self.findings = verdict, said
        if verdict != "LAND":
            raise Failed(f"{verdict} on PR #{self.pr} ({cost}{posted}) — the landing stops here, exactly "
                         f"like a red gate.\n{said}")
        return f"{verb}: LAND on PR #{self.pr} ({cost}{posted})"

    def mark_doomed(self, why, **rec):
        """Write down, against the change, that a landing at this head cannot succeed (head, change key, the cap that bound) and hand the Failed back tagged `doomed`, so review() re-reads the PR before it stands: `raise self.mark_doomed(Failed(...))`. Never raises itself."""
        try:
            root_spend(self.repo, self.pr,
                       doomed={"at": stamp(), "head": self.head, "key": self.change_key()[0],
                               "why": str(why), **rec})
        except Exception:
            pass
        why.doomed = True
        return why

    def merge_base(self):
        """Where this head left origin/<base>, as (sha, why): why is git's last line when the ask failed, and '' when it answered. Cached per head: the fork point does not move under a head that has not."""
        if not (self._mb and self._mb[0] == self.head):
            rc, o = sh(["git", "merge-base", f"origin/{self.base()}", self.head], cwd=self.root, timeout=120)
            self._mb = (self.head, (o.split() or [""])[0] if rc == 0 else "", (last(o) or f"exit {rc}") if rc else "")
        return self._mb[1:]

    def pr_diff(self, *flags, **kw):
        """This PR's diff, `git diff <flags> <merge-base> <head>`, as text; Failed when git cannot name the base or read the diff."""
        mb, why = self.merge_base()
        if why:
            raise Failed(f"cannot find where PR #{self.pr} left {self.base()}: {why}")
        rc, d = sh(["git", "diff", *flags, mb, self.head], cwd=self.root, timeout=300, **kw)
        if rc:
            raise Failed(f"cannot read the diff of PR #{self.pr}: {last(d)}")
        return d

    def change_key(self):
        """What this PR is, as a key a rebase does not change: change_digest() of the diff from its merge-base to its head, or the head SHA when git could name no digest. Returns (key, merge-base), merge-base '' when git could not say; cached per head."""
        if not (self._ckey and self._ckey[0] == self.head):
            try:    # -U3 said out loud so a repo's diff.context cannot change the hash
                diff = self.pr_diff("-U3", stdout_only=True)
                key, old = change_digest(diff), change_digest(diff, legacy=True)
            except Failed:
                key = old = ""
            self._ckey = (self.head, key or self.head, old or self.head)   # no digest git can name: keyed on the head, which a rebase re-reads (stricter)
        return self._ckey[1], self.merge_base()[0]

    def legacy_key(self):
        """The key this change had before 2026-09-19 (change_digest legacy=True), for the verdicts already on the PR — read, never written."""
        self.change_key()
        return self._ckey[2]

    def marker(self, verdict="", by=""):
        """The comment's machine-readable half: the change it was written about (`v2 change=<digest>`, or the head where git cannot name one) and the verdict. The verdict lives here and not in the prose, which quotes verdicts."""
        key, mb = self.change_key()
        v = f" verdict={verdict}" if verdict else ""
        w = f" by={re.sub(r'[^A-Za-z0-9._@-]+', '-', by)}" if by else ""
        return f"<!-- {REVIEW_MARK} v2 change={key} base={mb[:12]} head={self.head[:12]}{v}{w} -->"

    def prior_verdict(self, body):
        """The verdict `body` records about this change, or '': verdict_in with this landing's change key — or with the key the change had before 2026-09-19 (legacy_key), so a verdict recorded on a PR before the digest stopped keying on the hunk tail still answers instead of being bought again. Returns (verdict, findings, who) or ''."""
        key, old = self.change_key()[0], self.legacy_key()
        return verdict_in(body, key) or (verdict_in(body, old) if old != key else "")

    def prior_review(self):
        """The verdict this box already reached about this change, read off the PR's comments; only one this box wrote (`viewerDidAuthor`) counts. Returns (verdict, findings, who) or None, and keeps `self.stood`: the last verdict this box wrote for any change of this PR."""
        j = pr_facts(self.root, self.pr, "comments")[0]
        if j is None:
            return None
        found = None
        for body in box_comments(j):      # chronological, and the LAST one wins: --re-review posts a second
            found = self.prior_verdict(body) or found   # comment for the same change on purpose, and its answer is the current one
            self.stood = verdict_written(body) or self.stood
        return found

    def review_prompt(self, tpl, tree, dpath):
        """The generic prompt filled in; a repo's own rules come from docs/REVIEW.md on origin/<base>, never from the PR tree."""
        rc, o = sh(["git", "show", f"origin/{self.base()}:{REVIEW_RULES}"], cwd=self.root, timeout=60)
        rules = o.strip() if rc == 0 else ""
        vals = {"REPO": self.repo, "PR": str(self.pr), "TITLE": self.facts.get("title") or "(untitled)",
                "TREE": tree, "DIFF": dpath, "BRIEF": self.brief(),
                "RULES": (f"THIS REPO'S OWN REVIEW RULES, from {REVIEW_RULES} on {self.base()} (the rules before "
                          f"this change; a PR cannot bring its own) — they win over anything below:\n\n{rules}\n" if rules else
                          "This repo ships no docs/REVIEW.md, so there are no rules beyond the ones below.")}
        return re.sub(r"@([A-Z_]+)@", lambda m: vals.get(m.group(1), m.group(0)), tpl)

    def brief(self):
        """The path of what the track was asked to do: the brief, never the journal."""
        t = self.find_track()
        d = f"{STATE}/{self.project}/{t}" if t else ""
        task = f"{d}/task.md" if d and os.path.exists(f"{d}/task.md") else ""
        if not task:
            return ("No brief was found for this PR — no track on the board carries it, or it has no state "
                    "directory. Judge the change against its PR title and its own commit messages.")
        return (f"{task} — the brief this change was written against; judge the diff against its DONE-criteria. "
                f"The track's own journal is deliberately not given to you: it is the worker's account of itself.")

    def ask_reviewer(self, prompt, tree, tmp, budget="", turns=""):
        """The model call, run in `tmp` (never in the checkout: a session's cwd is where CLAUDE.md is read from) with the tree as a subdirectory, answering JSON, at the environment's caps unless the relaunch's doubled one is passed. Returns (text, cost, tokens)."""
        budget, turns = budget or REVIEW_BUDGET, turns or REVIEW_TURNS
        argv = [CLAUDE, "-p", prompt, "--model", self.by or REVIEW_MODEL, "--effort", "medium",
                "--max-budget-usd", budget, "--max-turns", turns, "--output-format", "json",
                "--json-schema", REVIEW_SCHEMA,
                "--setting-sources", "", "--strict-mcp-config", "--disable-slash-commands",
                "--add-dir", tmp, "--allowedTools", REVIEW_ALLOW, "--disallowedTools", REVIEW_DENY]
        rc, o = sh(argv, cwd=tmp, timeout=1800, **clean_start())
        try:
            j = json.loads(o)
        except ValueError:
            j = {}
        struct = j.get("structured_output")
        text, cost = (json.dumps(struct) if struct else (j.get("result") or "")).strip(), j.get("total_cost_usd") or 0
        use = j.get("usage") or {}
        toks = sum(v for k, v in use.items() if isinstance(v, int) and k.endswith("tokens"))
        cost, toks = f"${float(cost):.2f}", (f"{toks / 1000:.1f}k tokens" if toks else "tokens not reported")
        hit = WALL_SUBTYPE.get(j.get("subtype") or "")
        if hit and not verdict_of(text)[0]:
            # The runner stopped this on a cap, not the diff: its own outcome, priced, and the command offered raises the cap that bound (review_caps).
            cap, var, more, other = review_caps(j.get("subtype") or "", budget, turns)
            e = Failed(f"{WALL}, not the diff: {cost} and {j.get('num_turns') or '?'} turns on PR #{self.pr} read "
                       f"nothing and answered nothing — {hit[0]} ({var}) stopped it, so there is no verdict here to "
                       f"merge on. Give it more (`{var}={more} cc-land {self.repo} {self.pr}`, or {other} for the "
                       f"cap that did not), or read the diff yourself (`--no-review`). The same run at {cap} buys "
                       f"the same stop for the same {cost}, so it is not bought again.")
            e.wall = {"head": self.head, "cap": cap, "cost": cost, "turns": j.get("num_turns") or 0,
                      "hit": j.get("subtype"), "was": budget if var == "CC_LAND_REVIEW_BUDGET" else turns}
            raise e
        if text and not verdict_of(text)[0] and not float(j.get("total_cost_usd") or 0) and LIMIT_SAID_RE.search(text):
            # A limit that answers instead of dying: rc=0, a result naming a session/usage/rate limit, no verdict, $0.00. All three conditions, and then it is the `limited()` prefix, so the buy is refunded and run_job defers the job.
            raise Failed(f"no review: usage limit — the reviewer answered without a verdict, at {cost}, and said "
                         f"it hit a limit: {last(text)[:160]} — the landing waits for the model, or --no-review")
        if not text:
            lim = ""
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
                f.write(o or "{}")
            if sh([f"{BIN}/cc-limit", "check", f.name], timeout=60)[0] == 0:
                lim = " (a Claude usage limit — `cc-limit status`)"
            os.unlink(f.name)
            raise Failed(f"the reviewer produced nothing, rc={rc}{lim} — no diff was read, so nothing merges it. "
                         f"Re-run, or --no-review and read it yourself. Said: {last(o)}")
        return text, cost, toks

    def post_review(self, verdict, said, by="", supersedes=""):
        """One comment per change: the marker names the change, so a re-run adds nothing and a moved diff gets its own. `supersedes` is `record` writing a stricter verdict over a looser one, checked again here against the thread before the write."""
        stands = self.prior_review()
        if stands and not self.re_review:
            if not supersedes:
                return ", comment already on the PR"
            if stands[0] != supersedes:
                return (f", the verdict on the PR moved to {stands[0]} while this was being written — "
                        f"it was recorded over {supersedes}")
        who = by or self.by or REVIEW_MODEL
        over = f"\n\nThis supersedes the **{supersedes}** recorded earlier for this change." if supersedes else ""
        body = (f"{self.marker(verdict, who)}\n**cc-land review** — `{self.head[:12]}`, read by `{who}`\n\n"
                f"**VERDICT: {verdict}**{over}\n\n{said}")
        rc, o = sh(["gh", "pr", "comment", str(self.pr), "--body", body], cwd=self.root, timeout=120)
        return ", commented on the PR" if rc == 0 else f", the comment did not post ({last(o)})"

    # -- 2. gates ------------------------------------------------------------------------------------------
    def gates(self):
        """Gate the merge (merge_result), before merging: every gate at once, the paid read beside them from t=0, the suite handed CC_LAND_CHANGED and CC_SELFTEST_SLOTS, each gate timed on silence (run_gate). The first red stops the rest within a second; the first red in gate order is reported; the read's buy stands."""
        if self.pr and self.facts.get("state") == "MERGED":
            raise Skip(f"PR #{self.pr} is already merged — gates guard the merge, and it has happened")
        tree, tmp, at, base_sha = self.root, None, "", ""
        if self.pr:
            if self.held():             # a draft, or a conflict: the direct path stops here, before a gate or a
                raise Failed(self.held())   # read is bought for a merge GitHub would refuse (the queue holds such a job: run_job)
            self.fetch_head()       # asked BEFORE the checkout: the tier is keyed by the SHA
            self.gated = self.head  # …and pinned here, for the review after this and the merge after that
            with git_lock(self.root):   # merge_result reads refs a sibling landing's pull moves; it writes loose objects only
                at, base_sha, mtree = merge_result(self.root, f"origin/{self.base()}", self.head)
            # merged_on is the fact the ✗ line and gated_on() key on: a base that was MERGED IN, so it stays empty
            # when the head already held it.
            self.merged_on = base_sha if mtree else ""
            self.warm_base = base_sha or ""     # …and the base the warm's merge was built on, for warm_done
            self.merge_unbuilt = not at   # merge_result gives the head back when the head already holds the base and
            if self.merge_unbuilt:        # "" only when it could not answer: the same empty merged_on, two meanings
                out("!", f"the merge of {self.base()} with the head could not be built — an unfetched base, "
                         f"unrelated histories, or git unable to answer in time — so these gates run on the BRANCH "
                         f"ALONE and nothing here proves what {self.base()} holds once this lands")
        if self.pr and self.batch and self.warm:
            spent = self.spend_warm()   # the batch's merge pass: the warm's static gates stand in for these
            if spent:
                return spent
        tier, why = self.tier_for()
        if self.warm_only and tier != "docs":
            # Brief: "lands on its worker's own green plus a static check of about 2 min" — the suite is the base's
            # to run after the batch, not this warm's.
            tier, why = "warm", f"the static gates on the merge; the suite runs on {self.base()} after the batch ({why})"
        if self.pr:
            tmp, tree = self.head_checkout("gates", fetch=False, at=at)
        try:
            found = [g for g in GATES if os.access(f"{tree}/{g}", os.X_OK) and (tier not in ("docs", "warm") or g not in SUITE)]
            if not found and tier == "warm":
                raise Skip(f"no static gate in {self.repo} — the suite is its only gate, and that runs on {self.base()} after the batch")
            if not found:
                skipped = [g for g in SUITE if os.access(f"{tree}/{g}", os.X_OK)]
                if skipped:     # the tier took the only gate there is: run it rather than land ungated
                    found, tier, why = skipped, "full", "the suite is this repo's only gate, so a tier cannot skip it"
            if not found:
                raise Skip(f"no gates in {self.repo} ({GATES[0]}, {GATES[2]}, …) — landing ungated")
            out("·", f"the {tier} tier: {', '.join(found)} — {why}")
            content, reused = tree_id(tree), []   # …and of those, the ones this exact content has already passed
            scope = self.gate_scope()             # what the diff changed, for a suite that runs only what that reaches

            # All gates at once, and the read from t=0: a head a cheap gate rejects also buys a read, whose verdict goes on the PR for the retry.
            if any(not green_run(content, g, scope) for g in found):
                self.read_alongside()
            errs = self.run_gates(tree, found, scope, content, reused)
            if errs:
                if self._review is not None:
                    try:
                        self.review_aside()
                    except (Skip, Failed):
                        pass
                    if self.bought:
                        # Not given back: the money went, and a refund would let red head after red head buy a read with `reviews` at 0. The retry reads the verdict back for free.
                        out("·", "the review that ran beside the gates is COUNTED against this change — the read "
                                 "was paid for — and its verdict is on the PR for the retry to read back")
                raise errs[next(g for g in found if g in errs)]   # the first red in gate order, not whichever thread finished first
            on = f"PR #{self.pr} on {self.gated_on()}" if self.head else f"the {self.base()} checkout"
            again = f" — {len(reused)} of them already green on {content[:12]}, not run again" if reused else ""
            beside = " — the review ran beside the gates" if self._review is not None else ""
            return (f"{len(found)} gate(s) passed on {on} at the {tier} tier ({why}): "
                    f"{', '.join(found)}{again}{beside}")
        finally:
            if tmp:
                self.drop_checkout(tmp, tree)

    def run_gates(self, tree, found, scope, content, reused):
        """Run `found` on `tree` at once, each on its own thread and timed on silence (run_gate), a green record on this content spent instead of a run (appended to `reused`), and the first red stopping the rest within a second. Returns {gate: the Failed} — empty when every gate passed. gates() runs it on a PR's merge; suite_on (after_batch) on the base itself."""
        def run(g):
            if green_run(content, g, scope):
                reused.append(g)
                out("·", f"{g}: already green on this content ({content[:12]}) — the run that made it left the "
                         f"record, so this landing does not buy the same answer twice")
                return
            start = clean_start()
            start["env"].pop("CC_LAND_CHANGED", None)   # never an inherited scope: a landing run from inside a
            if scope:                                    # scoped suite would hand its gates that suite's paths
                start["env"]["CC_LAND_CHANGED"] = scope
            start["env"].pop("CC_SUITE_PART", None)     # …nor an inherited half, for the same reason
            start["env"]["CC_SELFTEST_SLOTS"] = str(SUITE_SLOTS)   # the one slot number, handed to the suite
            keep = f"{run_root()}/cc-land-gate-{self.repo}-{self.pr or 'base'}-{os.path.basename(g)}.log"
            argv = [f"{tree}/{g}"]
            if self.member and self.mtrack:
                # A member's gates run inside the workspace's sandbox (cc-sandbox member --tree); scope and slots go in as arguments, since the boundary clears the environment.
                wt = f"{HOME}/.cc/worktrees/{self.member}/{self.mtrack}"
                argv = ([f"{BIN}/cc-sandbox", "member", self.member, self.mtrack if os.path.isdir(wt) else "",
                         "--tree", tree, "--", "env"]
                        + [f"{k}={start['env'][k]}" for k in ("CC_LAND_CHANGED", "CC_SELFTEST_SLOTS")
                           if k in start["env"]]
                        + [f"{tree}/{g}"])
            try:
                rc, o = run_gate(argv, tree, keep, start["env"], stop=stop)
            except GateStopped:
                out("·", f"{g}: stopped, not run to the end — another gate is red, so this one could not save the landing")
                return
            bad = FAILED_RE.search(o)
            if rc or (bad and bad.group(1) != "0"):
                keep_log(keep)                   # the one log that outlives the run — bounded, at this path
                record_red(self.project, g, content, keep, o, pr=self.pr)   # …and the ledger line that outlives THAT
                full = disk_full(o)
                raise Failed(f"gate {g} did not pass: {gate_fail(o)}{full}{self.behind_base()}"
                             f"  [full output: {keep}]",
                             # the card gets the gate and the case that FAILED and nothing else: the stale-base
                             # reading and the log's path are the landing record's, and are kept above. In
                             # cc-replay's words (`gate \S+ did not pass`), which is how it keys a red gate.
                             short=f"gate {os.path.basename(g)} did not pass: {gate_fail(o)}{full}")

        errs, stop = {}, threading.Event()

        def go(g):
            try:
                run(g)
            except BaseException as e:
                errs[g] = e
                stop.set()   # one red gate ends the rest: the landing is lost, and they hold slots the queue wants

        ts = [threading.Thread(target=go, args=(g,), name=f"gate-{self.repo}-{os.path.basename(g)}", daemon=True)
              for g in found]
        for t in ts:
            t.start()
        for t in ts:
            t.join()     # every one of them, always: a gate left running holds a slot and writes to a checkout about to go
        return errs

    def gated_on(self):
        """Which tree the gates ran on, in one phrase, for the ✓ line, the ✗ line and the card."""
        if not self.head:
            return f"the {self.base()} checkout"
        if self.merged_on:
            return f"{self.base()} at {self.merged_on[:12]} merged with the head {self.head[:12]}"
        if self.merge_unbuilt:
            return f"the branch {self.head[:12]} alone — the merge with {self.base()} could not be built"
        return f"the head {self.head[:12]}, which already holds {self.base()} — the merge is the head"

    def behind_base(self):
        """On a red gate only, why it may be the calendar: when the gates ran on the merge, the clash is with what landed on the base since the head forked; only when they ran on the head alone does stale_note's rebase advice hold. '' for a no-PR deploy."""
        if not self.pr or not self.head:
            return ""
        if self.merged_on:
            return (f" — and these gates ran on {self.gated_on()}, not on the head alone: a head that is green by "
                    f"itself goes red here when its change clashes with what landed on {self.base()} since it "
                    f"forked. Read the failure as that clash before reading it as this branch's own bug")
        return stale_note(self.root, f"origin/{self.base()}", self.base(), self.head,
                          [p for _, p in self.changed_files()])

    def worker_green(self):
        """--warm's first step: the worker's own green for THIS head, or the PR is not ordinary and lands on its own with every gate first. The record is keyed on the HEAD's tree — what the worker's cc-green filed; the merge's tree is other content — unscoped, or scoped to exactly this diff (green_run)."""
        self.fetch_head()
        if self.held():
            raise Failed(self.held())
        self.ordinary_at_head()
        rc, o = sh(["git", "rev-parse", f"{self.head}^{{tree}}"], cwd=self.root)
        tree = o.strip() if not rc else ""
        suites = [g for g in SUITE if not sh(["git", "cat-file", "-e", f"{self.head}:{g}"], cwd=self.root)[0]]
        missing = [g for g in suites if not green_run(tree, g, self.gate_scope())]
        if missing:
            raise Failed(f"no green record of the worker's own for {', '.join(missing)} on the head {self.head[:12]} "
                         f"(tree {tree[:12] or '?'}) — not ordinary: it lands on its own, every gate first",
                         short="no worker green for the head")
        if not suites:
            return f"no suite at the head of PR #{self.pr}: nothing for a worker to have run"
        return (f"the worker's own green stands for {', '.join(suites)} on the head {self.head[:12]} "
                f"(tree {tree[:12]}), so the suite runs once on {self.base()} after the batch")

    def ordinary_at_head(self):
        """ordinary() asked again of the head this warm FETCHED, off git and not gh: batch_of read gh's file list at pick time, tied to no head, and a push after it (one touching core/bin/cc-guard, say) must not ride that answer into a merge its suite never ran before. Raises Failed (short 'not ordinary at this head') when the head goes into a branch other than the default, touches a protected path or anything a gate-first list names or does not cover, or its diff cannot be read; warm_done then marks the job for the serial path."""
        short = "not ordinary at this head"
        into, base = (self.facts.get("baseRefName") or "").strip(), board(self.repo).get("default_branch") or "main"
        if into != base:
            raise Failed(f"PR #{self.pr} merges into {into or '?'}, not {base} — every gate first", short=short)
        files = sorted({p for _, p in name_status(self.pr_diff("--name-status"))})
        if not files:
            raise Failed(f"the head {self.head[:12]} of PR #{self.pr} changes no file git can name — every gate first", short=short)
        rules, why = protected_paths(self.repo)
        if rules is None:
            raise Failed(f"{why} — every gate first", short=short)
        prot = [p for p in files if any(p == r.rstrip("/") or p.startswith(r.rstrip("/") + "/") for r in rules)]
        first, declared = gate_first_paths(self.root, f"origin/{base}", files)
        if prot or first or not declared:
            what = ", ".join((prot or first or files)[:3])
            raise Failed(f"the head {self.head[:12]} touches {what}, which keeps every gate before the merge "
                         f"({'a PROTECTED path' if prot else 'the gate-first list'}) — not ordinary: it lands on its own",
                         short=short)

    def spend_warm(self):
        """The batch's merge pass: the warm's static gates stand in for this landing's when it was about THIS head and the base has moved since only in files this PR does not touch — brief: "its merge with main is file-disjoint from what's landing with it". Its ✓ line, or '' and the gates run as they always did (a moved head, an overlap, a warm that could not answer). A warm that stopped at its gates is this landing's red: same head, same files."""
        w, now = self.warm, self.fetch_head()
        if w.get("head") != now:
            out("!", f"the head moved since the warm ({(w.get('head') or '?')[:12]} → {now[:12]}): the gates run again")
            return ""
        if w.get("stopped") == "gates":
            raise Failed(w.get("why") or "the warm's static gates were red", short=w.get("short") or "")
        # A warm that stopped at its REVIEW passed its gates: they are spent here too, and review() reads the
        # verdict back off the PR and stops on it — never a suite run in front of a verdict already reached.
        if not (w.get("ok") or w.get("stopped") == "review") or not w.get("base"):
            return ""
        rc, o = sh(["git", "diff", "--name-only", w["base"], f"origin/{self.base()}"], cwd=self.root, timeout=120)
        if rc:
            return ""
        clash = sorted({p for _, p in self.changed_files()} & set(o.split()))
        if clash:
            out("!", f"{self.base()} moved since the warm in {', '.join(clash[:3])}, which this PR changes too — "
                     f"the warm is not spent, the gates run on the merge as they always did")
            return ""
        self.gated, self.merged_on = now, w["base"]
        return (f"the warm's static gates passed on PR #{self.pr} on {self.gated_on()} at {w.get('at', '?')}; "
                f"{self.base()} has since moved only in files this PR does not touch, so the merge is spent "
                f"unrun and the suite runs on {self.base()} once the batch has merged")

    def warm_done(self, rc):
        """Write what the warm found on the PR's queue job, for the batch's merge pass (spend_warm): the head and base it was about, whether it passed, and where it stopped. A stop at `warm` (no worker green) marks the job not ordinary, so batch_of leaves it to the serial path."""
        path = job_path(self.repo, self.pr)
        job = read_json(path)
        if job is None:
            return
        job["warm"] = {"head": self.head, "base": self.warm_base, "ok": rc == 0, "at": stamp(),
                       "stopped": self.stopped, "why": (self.why or "")[:600], "short": self.why_short}
        if self.stopped == "warm":
            job["ordinary"] = self.why_short or self.why
        with contextlib.suppress(OSError):
            write_atomic(path, job)

    def gate_scope(self):
        """The paths this diff changes, sorted and space-separated: what the suite is handed as CC_LAND_CHANGED (core/tests/green.sh says how far that reaches) and the key beside a green record's tree. Empty means everything: --full-gates, a no-PR deploy, an unreadable or wide diff."""
        if self.full_gates or not self.pr or not self.head:
            return ""
        paths = sorted({p for _, p in self.changed_files()})
        if not paths or len(paths) > WIDE_FILES:
            return ""
        return " ".join(paths)

    def tier_for(self):
        """What this diff has earned as (tier, why), decided once per head and cached so the review and the gates cannot disagree. Only a PR is ever scoped; a no-PR deploy is `full`."""
        if self.full_gates:
            return "full", "--full-gates: every gate, whatever the diff touches"
        if not self.pr or not self.head:
            return "full", "a deploy with no PR to scope it against"
        if self._tier and self._tier[0] == self.head:
            return self._tier[1:]
        mb, why = self.merge_base()
        if why:
            return "full", f"where this left {self.base()} could not be read"
        tier, why = gate_tier(self.root, mb, self.head, self.changed_files())
        self._tier = (self.head, tier, why)
        return tier, why

    def review_model(self):
        """Who reads this diff, as (model, tier, why): the worker model for the `full` tier, nobody paid for `docs` and `focused`."""
        tier, why = self.tier_for()
        return (REVIEW_MODEL if tier == "full" else None), tier, why

    def changed_files(self):
        """What this landing puts on the default branch: the PR head against its base before the merge, the squash commit itself after it. The same list either way, so the deploy steps survive a re-run."""
        if self.changed is None:
            self.changed = []
            if self.span:       # asked for AFTER install()'s pull, so both ends are in the checkout by now
                self.changed = name_status(sh(["git", "diff", "--name-status", self.span[0], self.span[1]], cwd=self.root)[1])
            elif self.head:
                try:
                    self.changed = name_status(self.pr_diff("--name-status"))
                except Failed:
                    pass
            elif (self.facts.get("mergeCommit") or {}).get("oid"):
                sha = self.facts["mergeCommit"]["oid"]
                self.changed = name_status(sh(["git", "show", "--name-status", "--format=", sha], cwd=self.root)[1])
        return self.changed

    # -- 3. merge ------------------------------------------------------------------------------------------
    def slug(self):
        """owner/repo, off the remote. Used only to make gh leave the LOCAL branch alone — see merge()."""
        m = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?$",
                      sh(["git", "remote", "get-url", "origin"], cwd=self.root, timeout=30)[1].strip())
        return m.group(1) if m else ""

    def merged_now(self):
        """Ask GitHub what became of the PR: gh reporting a failure does not mean the merge did not happen."""
        return (pr_facts(self.root, self.pr, "state,mergedAt", timeout=60)[0] or {}).get("state") == "MERGED"

    def merged_since(self):
        """Has the PR merged since load() read it? Asked again where the next thing costs money or dispatches a worker, and recorded on self.facts. A gh that cannot answer is not a merge."""
        if self.pr and self.facts.get("state") != "MERGED" and self.merged_now():
            self.facts["state"] = "MERGED"
        return self.facts.get("state") == "MERGED"

    def held(self):
        """Why this PR cannot merge yet, or '', off what load() was told: a draft, or a conflict with its base. The queue holds such a job and sends one rebase round (run_job); the direct path refuses it before a gate runs (gates)."""
        if self.pr and self.facts.get("isDraft"):
            return f"PR #{self.pr} is a draft — mark it ready for review, then land it"
        if self.pr and self.facts.get("mergeable") == "CONFLICTING":
            return f"PR #{self.pr} conflicts with {self.base()} — rebase it, then land it"
        return ""

    def merge(self):
        """The one place on this box that merges, after the gates: a squash pinned to the head the gates ran on (--match-head-commit), or, under a protected path, to the head the owner 👍'd; --subject the PR title, -R so gh deletes only the remote branch."""
        if self.facts.get("state") == "MERGED":
            root_done(self.repo, self.pr)      # in is in: the tally goes with the change it was bounding
            return f"PR #{self.pr} was already merged — nothing to do"
        slug, title = self.slug(), self.facts.get("title") or ""
        # Pinned to the SHA the gates ran on and the review read: a push between them makes GitHub refuse the merge, and the re-run gates what is there.
        # …and under a PROTECTED path, to the head the OWNER's 👍 was about (approved_head, carried on the job).
        # protected_stop is the door and runs at the top of the job; this is the lock, and it is GitHub's own: a push
        # that lands after that check, or a `gh pr view` still lagging the ref when it ran, cannot become a merge of
        # a head nobody approved. The two agree in every ordinary round — the stop already refused any head but his.
        pin = self.approved_head or self.head
        argv = (["gh", "pr", "merge", str(self.pr), "--squash", "--delete-branch"]
                + (["--match-head-commit", pin] if pin else [])
                + (["-R", slug] if slug else []) + (["--subject", f"{title} (#{self.pr})"] if title else []))
        rc, o = sh(argv, cwd=self.root, timeout=300)
        done = any(w in o for w in ("already merged", "is closed", "already closed"))   # gh: nothing left to merge
        if rc and ("--auto" in o or "auto-merge" in o):
            # Never armed: an auto-merge lands with nothing gating or deploying it.
            raise Failed(f"PR #{self.pr} is not mergeable yet (checks pending, or it needs a rebase) — nothing was "
                         f"merged, and no auto-merge was armed. Sort that out, then 👍 it again")
        if rc and not done:
            if not self.merged_now():
                raise Failed(f"gh pr merge #{self.pr}: {last(o)}")
            root_done(self.repo, self.pr)
            return f"PR #{self.pr} merged (a second merge overlapped this one; GitHub says it is in)"
        if not rc or self.merged_now():
            root_done(self.repo, self.pr)      # …and the change this tally was bounding is now on the default branch
        # …while a PR gh calls "closed" that GitHub does not call MERGED is not in: its tally stays a bound, for the
        # reopen (the `merged` stamp would retire it for good, and every attempt after would re-buy the same read).
        return f"PR #{self.pr} merged (squash, remote branch deleted)"

    # -- 4. the #approvals card: it stops reading as pending -----------------------------------------------
    def card(self):
        """Turn the PR's #approvals card to 'landed ✓ HH:MM' with `post-approval --landed`; never a new card. No Slack, or no card, is a Skip; a card that stays pending is a Failed."""
        rc, o = sh([f"{BIN}/cc-slack", "post-approval", "--landed", self.repo, str(self.pr)], timeout=120)
        if rc == 3:
            raise Skip("Slack is not set up on this box — no card")
        if rc == 4:
            raise Skip(f"PR #{self.pr} has no card in #approvals — none posted (a landed PR must not look pending)")
        if rc:
            raise Failed(f"the card for PR #{self.pr} still reads as pending: {last(o)}")
        return f"#approvals: the card for PR #{self.pr} reads landed ✓"

    # -- 5. the board --------------------------------------------------------------------------------------
    def find_track(self):
        """The track that carries this PR: the board row naming it by URL or bare number, else the row whose branch is the PR's head, else the row the head's name is (`track/<row>`, `planning/<row>`, `builder/<row>`)."""
        if self.mtrack:
            return self.mtrack
        rows = board(self.project).get("tracks", {})
        for name, t in rows.items():
            pr = str(t.get("pr") or "")
            if re.search(rf"/pull/{self.pr}(?:/|$)", pr) or pr == str(self.pr):
                return name
        head = self.facts.get("headRefName") or ""
        for name, t in rows.items():
            if head and t.get("branch") == head:
                return name
        m = re.fullmatch(r"(?:track|planning|builder)/(.+)", head)
        if m and m.group(1) in rows:
            return m.group(1)
        return ""

    def close_board(self):
        t = self.find_track()
        if not t:
            raise Skip(f"no track on the board carries PR #{self.pr} — nothing to close")
        if t not in board(self.project).get("tracks", {}):
            raise Failed(f"the {self.project} board has no track '{t}'")
        st = "merged"
        rc, o = sh([f"{BIN}/cc-board", "status", self.project, t, st])
        if rc:
            raise Failed(f"cc-board status: {last(o)}")
        sh([f"{BIN}/cc-board", "note", self.project, t, f"landed by cc-land: {self.what()}"])
        line = f"board: {self.project}/{t} -> {st}"
        # The rows the PR body says it closes (closes_rows) are closed here; a row the board does not have is said, not skipped.
        closed, unknown, held = [], [], []
        rows = board(self.project).get("tracks", {})
        for r in closes_rows(self.facts.get("body") or ""):
            if r == t or rows.get(r, {}).get("status") in ("merged", "done"):
                continue                      # its own row is closed above; a row already closed stays as it is
            if r not in rows:
                # Said only when shaped like a row (a hyphen, an underscore, a digit); a bare word is prose.
                if re.search(r"[-_0-9]", r):
                    unknown.append(r)
                continue
            # A subagent's row (cc-board's `agent` mark) has no landing of its own, so its Closes line is the only closer and is honoured; a track's row is left to its own landing.
            mark = (rows[r].get("agent") or "").strip()
            if rows[r].get("held") or (rows[r].get("status") in ("running", "review") and not mark):
                held.append(r)                # a person is sitting on it, in their own words, or a track is live on
                continue                      # it and its own landing will close it: not this pass's to close
            rc, o = sh([f"{BIN}/cc-board", "status", self.project, r, "done"])
            if rc:
                raise Failed(f"cc-board status {r}: {last(o)}")
            sh([f"{BIN}/cc-board", "note", self.project, r, f"closed by cc-land: {self.what()} says Closes {r}"])
            if mark:
                # ...and the `agent` mark goes back with it (cc-board agent_id); cosmetic if it fails.
                sh([f"{BIN}/cc-board", "set", self.project, r, "agent", ""])
            closed.append(r)
        if closed:
            line += f"; closes {', '.join(closed)}"
        if held:
            line += f" (held by a person or live on a track, left open: {', '.join(held)})"
        if unknown:
            line += f" (Closes names no row on the board: {', '.join(unknown)})"
        return line

    # -- 6. the ask ledger ---------------------------------------------------------------------------------
    def ledger_rows(self, t):
        """The unsettled rows on this track, or None if there is no ledger here at all."""
        rc, o = sh([f"{BIN}/cc-scope", "list", self.project, "--track", t, "--json"])
        if rc:
            return None
        try:
            return json.loads(o or "[]")
        except ValueError:
            return []

    def close_ledger(self):
        """Mark every unsettled ask on the track MERGED (`cc-scope merged`), nothing more: delivery is decided by the row's own check in verify_delivery, last of all."""
        t = self.find_track()
        if not t:
            raise Skip("no track — no ledger rows to close")
        asks = self.ledger_rows(t)
        if asks is None:
            raise Skip(f"no ask ledger for {self.project}")
        if not asks:
            raise Skip(f"no unsettled ask on track {t}")
        for a in asks:
            rc, o = sh([f"{BIN}/cc-scope", "merged", self.project, a["id"], "--evidence", self.what()])
            if rc:
                raise Failed(f"cc-scope merged {a['id']}: {last(o)}")
        return (f"ledger: {len(asks)} ask(s) on {t} marked MERGED — not delivered until their own checks pass "
                f"below ({', '.join(a['id'] for a in asks)})")

    # -- 7. pull, install, daemon-reload -------------------------------------------------------------------
    def install(self):
        """Pull the default branch (~/bin points into this checkout) and run install.sh, which links a file the change added; record the applied SHA."""
        rc, o = sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=self.root)
        cur = o.strip()
        if rc or cur != self.base():
            raise Failed(f"{self.root} is on '{cur}', not '{self.base()}' — land from the default-branch checkout")
        with git_lock(self.root):   # a pull is a fetch: it moves refs/remotes/origin/<base>, which a sibling's fetch writes too
            rc, o = sh(["git", "pull", "--ff-only", "-q"], cwd=self.root, timeout=300)
        if rc:
            raise Failed(f"git pull --ff-only in {self.root}: {last(o)}")
        # What is installed, written down (record_applied): the next catch-up compares origin against it. Recorded once install.sh has run, or right after the pull for a repo with none.
        def note():
            rc, o = sh(["git", "rev-parse", "HEAD"], cwd=self.root)
            if not rc and o.strip():                             # an empty SHA is not a record, it is a lie
                try:
                    record_applied(self.repo, o.strip())
                except OSError as e:
                    out("·", f"could not record the applied SHA: {e}")   # the deploy happened; only the note about it failed
        inst = next((p for p in ("core/install.sh", "install.sh") if os.access(f"{self.root}/{p}", os.X_OK)), "")
        if not inst:
            note()
            raise Skip(f"pulled {self.base()}; no install.sh in this repo — nothing to link")
        rc, o = sh([f"{self.root}/{inst}"], cwd=os.path.dirname(f"{self.root}/{inst}"), timeout=900)
        if rc:
            raise Failed(f"{inst}: {last(o)}")
        sh(["systemctl", "--user", "daemon-reload"], timeout=120)
        note()
        return f"pulled {self.base()}, ran {inst}, daemon-reload"

    # -- 8. units this change ADDED, which land switched off -----------------------------------------------
    def enable_units(self):
        added = [os.path.basename(p) for st, p in self.changed_files()
                 if st == "A" and re.search(r"systemd-user/[^/]+\.(service|timer)$", p)]
        linked, done, notes = linked_units(), [], []
        for u in added:
            stem = u.rsplit(".", 1)[0]
            if u.endswith(".service") and f"{stem}.timer" in added + linked:
                notes.append(f"{u} is started by {stem}.timer, never enabled itself")
                continue
            if u.endswith(".service") and "[Install]" not in read_unit(u):
                notes.append(f"{u} has no [Install] — something else starts it")
                continue
            if u not in linked:
                notes.append(f"{u} is not linked (install.sh names its units one by one — add it there)")
                continue
            if unit_policy(u, "enable") == "owner":
                notes.append(f"{u} is the owner's to switch on (units.json enable=owner) — linked, left off")
                continue
            if unit_is("is-enabled", u) == "enabled":
                notes.append(f"{u} was already on")   # enabled = somebody has already decided; --now only ever mattered once
                continue
            rc, o = sh(["systemctl", "--user", "enable", "--now", u], timeout=120)
            if rc:
                raise Failed(f"systemctl enable --now {u}: {last(o)}")
            done.append(u)
        # Named, never touched. 'enabled' is the test, not 'active': a oneshot that has run is enabled and idle.
        off = [u for u in linked if u.endswith(".service") and u not in added and "[Install]" in read_unit(u)
               and unit_is("is-enabled", u) != "enabled"]
        if off:
            notes.append("off by somebody's choice, left alone: " + ", ".join(off))
        tail = " — " + "; ".join(notes) if notes else ""
        if not done:
            raise Skip("no unit added by this change" + tail)
        return f"switched on: {', '.join(done)}" + tail

    # -- 9. restart only what moved ------------------------------------------------------------------------
    def restart(self):
        """Restart each running unit whose Exec line runs a file this change touched, or whose units.json row declares a path it changed: a `none` row is left alone, an `owner` row becomes an ask (owner_ask), NEVER is named and left. A template unit is restarted or asked about as its instances (unit_instances), never by its own name."""
        files = [p for st, p in self.changed_files() if st != "D"]
        if not files:
            raise Skip("no file list for this landing — nothing to restart")
        moved = {os.path.basename(p) for p in files}
        declared = units_for_paths(self.root, files)
        held, owned = [], []
        for u in linked_units():
            if not u.endswith(".service"):
                continue
            runs = {os.path.basename(tok) for ln in re.findall(r"^Exec[A-Za-z]*=(.*)$", read_unit(u), re.M)
                    for tok in ln.split() if "/" in tok}      # paths only: a bare word like `main` is an argument, not a script
            if not (runs & moved) and u not in declared:
                continue
            if u == NEVER:
                held.append(u)
                continue
            if declared.get(u) == "none":
                continue                                   # units.json says none: the next start picks the change up; checked before is-active
            for inst in unit_instances(u):                 # a template runs as its instances, and only they can be restarted or named
                if declared.get(u) == "owner":
                    owned.append(self.owner_ask(inst))     # units.json: never automatically — the landing asks them
                    continue
                if unit_is("is-active", inst) != "active":
                    continue                               # not running: its next start picks the new code up
                rc, o = sh(["systemctl", "--user", "restart", inst], timeout=180)
                if rc:
                    raise Failed(f"systemctl restart {inst}: {last(o)}")
                self.restarted.append(inst)
        tail = (f"; {NEVER} runs a script that moved too — restarting it would take every session on this box "
                f"down, so do it by hand (`cc rc restart`)") if held else ""
        if owned:
            tail += "; " + "; ".join(owned)
        if not self.restarted:
            raise Skip("nothing running uses the files this change touched" + tail)
        return f"restarted: {', '.join(self.restarted)}{tail}"

    def owner_ask(self, unit):
        """A unit units.json keeps for the owner (restart=owner) whose code moved: not restarted; the unit and its restart command go on the card and into the ask ledger, once per unit while an ask is open. A stopped unit is not asked about; a ledger that will not answer does not stop the deploy. Returns the step's sentence."""
        cmd = f"systemctl --user restart {shlex.quote(unit)}"     # a unit name passes bare; a template's glob is quoted
        said = f"{unit} moved too and is the owner's to restart (units.json restart=owner)"
        if unit_is("is-active", unit) in ("inactive", "failed"):
            return said + ", and it is not running — its next start is this change"
        rc, o = sh([f"{BIN}/cc-scope", "list", self.project, "--json"], timeout=60)
        if rc == 0:
            try:
                rows = json.loads(o or "[]")
            except ValueError:
                rows = []
            for a in rows:
                if (a.get("text") or "").startswith(OWNER_ASK_KEY.format(unit=unit)):
                    return said + f"; already asked ({a.get('id') or '?'}), so this landing does not ask again"
        self.owner_asks.append(f"{unit} (`{cmd}`)")      # on the card whatever the ledger does below
        rc, o = sh([f"{BIN}/cc-scope", "add", self.project, OWNER_ASK.format(unit=unit, cmd=cmd),
                    "--who", "box", "--src", self.what()], timeout=60)
        if rc:
            return said + f"; the ask ledger would not take it ({last(o)}) — the card is the only record"
        return said + f", asked: {last(o)}"

    # -- 10. what systemd does NOT own: a server somebody started from a shell -----------------------------
    def daemons(self):
        """Long-lived processes no unit owns: one a units.json `daemons` row declares is restarted by that row's command and must come back under a new pid, or the step is red; a `none` row is left for its next start, an `owner` row is named. A process no row declares is not looked for. The daemon is repo_program's answer, never the command line alone."""
        files = [p for st, p in self.changed_files() if st != "D"]
        if not files:
            raise Skip("no file list for this landing — nothing to look for")
        root = os.path.realpath(self.root)
        rows = daemons_for(self.root, files)
        mine = own_ancestry()

        def bare():
            """Every process no unit owns, with the file of this repo it is running; re-read each time, since proving a restart means looking again."""
            return [(pid, repo_program(argv, root, exe)) for pid, argv, unit, exe in live_processes()
                    if not unit and pid not in mine]

        pids = lambda s: ", ".join(str(p) for p in sorted(s))
        started, notes = [], []
        for name in sorted(rows):
            policy, runs = rows[name]
            was = {pid for pid, rel in bare() if rel == runs}
            if not was:
                notes.append(f"{name} is not running here")
                continue
            if policy == "none":
                notes.append(f"{name} picks this up on its next start (units.json restart=none)")
                continue
            if policy == "owner":
                notes.append(f"{name} (pid {pids(was)}) is the owner's to restart (units.json restart=owner)")
                continue
            argv = [f"{root}/{policy.split()[0]}"] + policy.split()[1:]
            rc, o = sh(argv, cwd=root, timeout=180)
            if rc:
                raise Failed(f"{policy}: {last(o)}")
            now = {pid for pid, rel in bare() if rel == runs}
            if not now or (now & was):
                raise Failed(f"`{policy}` ran, but {name} is still "
                             f"{'pid ' + pids(now & was) if now & was else 'not running'} — the running thing did "
                             f"not change, so the box is on the old code whatever this step printed")
            started.append(f"{name} (pid {pids(now)})")
        tail = "; " + "; ".join(notes) if notes else ""
        if not started:
            raise Skip("no declared daemon runs the files this change touched" + tail)
        return "restarted, and back on a new pid: " + ", ".join(started) + tail

    # -- 11. delivery: the ask's own check, run last of all ---------------------------------------------------
    def verify_delivery(self):
        """Merged is not delivered: `cc-scope deliver` runs each touched ledger row's own check, last of all. rc 0 delivered; 2 no check named (unverified, open); 3 could not run (not a red); else check failed, open. A row never reads delivered because a PR merged."""
        t = self.find_track()
        if not t:
            raise Skip("no track — no ask to check")
        asks = self.ledger_rows(t)
        if asks is None:
            raise Skip(f"no ask ledger for {self.project}")
        rows = [a for a in asks if a.get("status") in ("open", "claimed", "merged")]
        if not rows:
            raise Skip(f"no ask on track {t} waiting to be delivered")
        # rc 3 is cc-scope's 'the check could not run', not rc 1: nothing was measured, and the card must not say a check failed.
        good, red, bare, silent = [], [], [], []
        for a in rows:
            rc = sh([f"{BIN}/cc-scope", "deliver", self.repo, a["id"]], timeout=900)[0]
            (good if rc == 0 else bare if rc == 2 else silent if rc == 3 else red).append(a["id"])
        self.unverified = red + bare + silent
        if not self.unverified:
            return f"delivered — every check ran here and passed: {', '.join(good)}"
        bits = ([f"delivered: {', '.join(good)}"] if good else [])
        if red:
            bits.append(f"CHECK FAILED, still open: {', '.join(red)}")
        if silent:
            bits.append(f"COULD NOT RUN, never measured (not a red check): {', '.join(silent)}")
        if bare:
            bits.append(f"names no check, UNVERIFIED and still open: {', '.join(bare)}")
        raise Failed("; ".join(bits) + f" — `cc-scope show {self.repo} <id>` for what happened, "
                     f"`cc-scope check-cmd {self.repo} <id> \"<cmd>\"` to give a row a check")

    # -- the sequence, in two halves ------------------------------------------------------------------------
    def pr_steps(self):
        """About this change: gate it (every gate at once, the paid read beside them from t=0), collect the read, merge it, record that it landed. A buy made beside a red gate still counts."""
        walls = [("walls", self.member_walls)] if self.member and self.mtrack else []
        return walls + [("gates", self.gates), ("review", self.review), ("merge", self.merge), ("card", self.card),
                        ("board", self.close_board), ("ledger", self.close_ledger)]

    def member_walls(self):
        """A member PR that touches the boundary or a token stops here, before a gate or a read: a path under .cc/, a secret's path shape (SECRET_PATHS), or an added line shaped like a token or a private key. Doomed for this head, said in the workspace's channel."""
        self.fetch_head()
        hit = sorted({path for _, path in self.changed_files() if boundary_path(path)})
        tokens = [ln for ln in self.pr_diff("-U0", stdout_only=True).splitlines()
                  if ln.startswith("+") and not ln.startswith("+++")
                  and TOKEN_SHAPES.search(ln)]
        if hit or tokens:
            what = (f"it changes {', '.join(hit)}" if hit else "") + (" and " if hit and tokens else "") \
                 + (f"it adds {len(tokens)} line(s) shaped like a token or a private key" if tokens else "")
            raise self.mark_doomed(Failed(
                f"PR #{self.pr} touches the boundary or a token — {what} — and nothing lands that on a member's "
                f"behalf. Take it out of the PR and push; the next head is a new question"))
        return f"PR #{self.pr} touches neither the boundary (.cc/, a secret's path) nor a token"

    def no_deploy(self):
        raise Skip(f"{self.repo} is a member workspace's, not the box's — nothing installed, no units, no restarts")

    def deploy_steps(self):
        """About the box: run once at the end of a batch. A member workspace's repository gets none of them (MEMBERS)."""
        if self.member:
            return [("deploy", self.no_deploy)]
        if self.batch:
            return [("deploy", self.after_batch_deploy)]
        return [("install", self.install), ("units", self.enable_units),
                ("restart", self.restart), ("daemons", self.daemons), ("verify", self.verify_delivery)]

    def warm_steps(self):
        """--warm: is the worker's own green there, then the static gates on the merge with the read beside them. No merge, no deploy: the batch's merge pass spends what this leaves (spend_warm), and the suite runs on the base after it."""
        return [("warm", self.worker_green), ("gates", self.gates), ("review", self.review)]

    def steps(self):
        if self.warm_only:
            return self.warm_steps()
        return self.pr_steps() + self.deploy_steps()

    def after_batch_deploy(self):
        raise Skip(f"deployed with the batch: install and the restarts follow the suite on {self.base()} once the batch has merged (after_batch)")

    def load(self, verb="landing"):
        """What GitHub says about the PR, read once before anything runs; `verb` is the caller's word for the log's first line."""
        if self.span:
            emit(f"deploying [{self.repo}] {self.what()} — merged without this box, so it was never installed")
            return True
        j, why = pr_facts(self.root, self.pr,   # isDraft: what held() reads; body: closes_rows
                          "title,url,state,mergeable,headRefName,baseRefName,mergeCommit,isDraft,body")
        if j is None:
            print(f"cc-land: cannot read PR #{self.pr} in {self.root}: {why}" if why is not None else
                  f"cc-land: gh returned no PR #{self.pr}", file=sys.stderr)
            return False
        self.facts = j
        emit(f"{verb} [{self.repo}] PR #{self.pr}: {self.facts.get('title', '')}")
        return True

    def walk(self, steps):
        """0 all well · 1 a step the box depends on failed and nothing after it ran · COSMETIC only bookkeeping did."""
        for name, fn in steps:
            self.mark_stage(name)
            try:
                out("✓", fn())
            except Skip as e:
                out("·", str(e))
            except Failed as e:
                out("✗", f"{name}: {e}")
                self.stopped, self.why, self.why_short = name, str(e), getattr(e, "short", "")
                if name in FATAL:
                    print("cc-land: STOPPED there — nothing after it ran. Fix that and re-run the same command: "
                          "every step already done is a no-op the second time.", file=sys.stderr)
                    return 1
                self.hurt.append(name)   # cosmetic: the box is right, so the rest of the sequence still runs
        if not self.hurt:
            return 0
        return UNVERIFIED if "verify" in self.hurt else COSMETIC

    def mark_stage(self, name):
        """Write where the landing has got to on disk before each step, so a kill between steps is a fact the next worker reads; 'did the merge happen' is never guessed, `gh pr view` answers it."""
        if not self.job:
            return
        job = read_json(self.job)
        if job is None:
            return
        job["stage"], job["at"] = name, stamp()
        with contextlib.suppress(OSError):
            write_atomic(self.job, job)

    def flags(self):
        """The flags this landing runs with, as typed — what the second arrival at a held PR is shown (pr_lock)."""
        return " ".join(f for f, on in (("--no-review", not self.want_review), ("--re-review", self.re_review),
                                        ("--full-gates", self.full_gates), ("--warm", self.warm_only)) if on)

    def run(self):
        if not self.load():
            return 1
        # THE DIRECT PATH IS UNDER THE HOLD TOO. `cc-land <repo> <pr>` is the command `cc` prints as the way to land
        # and --no-review is typed on it, and it never asked protected_hit: with no 👍 on this path at all it pinned
        # the merge to self.head, and a protected-path PR merged on the box's own say-so (review of #527). A hit is
        # a refusal here — there is no approval this path could carry — and not-knowing is a hit (protected_hit).
        hit = protected_hit(self.repo, self.pr) if self.pr else None
        if hit:
            return refuse(f"PR #{self.pr} is not landing — {protected_under(self.repo, hit)}. The box never lands "
                          f"one of these on its own, whatever the gates and the review say: only the owner's own 👍 "
                          f"on the card queues it", 1)
        lock = pr_lock(self.repo, self.pr, self.flags())
        other = lock.take()   # brief: "a second landing on a PR already held by one exits saying so, having bought nothing"
        if other:
            emit(f"cc-land: {other}")
            return 1
        try:
            rc = self.walk(self.steps())
            if self.warm_only:
                self.warm_done(rc)
                print("warm: " + ("ready to merge with the batch" if rc == 0 else f"stopped at {self.stopped}"))
                return rc
            return self.done(rc)
        finally:
            lock.release()

    def done(self, rc):
        if rc == UNVERIFIED:
            rest = [h for h in self.hurt if h != "verify"]
            print(f"merged and deployed — but NOT delivered: nothing here could confirm {', '.join(self.unverified)} "
                  f"reached anyone, so {'they stay' if len(self.unverified) > 1 else 'it stays'} open. That is the "
                  f"honest answer, not a broken landing: `cc-scope unverified {self.repo}`."
                  + (f" ({', '.join(rest)} also wants a hand.)" if rest else ""))
        elif rc == COSMETIC:
            print(f"landed — the box is deployed, but {', '.join(self.hurt)} did not go through. Re-run the same "
                  f"command to retry just those: everything else is a no-op the second time.")
        elif rc == 0:
            print("landed.")
        if self.owner_asks:
            print(f"YOURS TO RESTART: {', '.join(self.owner_asks)} — config/units.json keeps that for the owner, "
                  f"so the box runs the old code until somebody does. Asked: `cc-scope list {self.project}`.")
        return rc


# ── the queue: a landing that outlives the process that asked for it ────────────────────────────────
def spawn_work(secs=0, lane=""):
    """`cc-land work` (or `work --lane <repo>`) as a transient systemd unit — now, or on a timer `secs` from now — never a thread or a child of the caller: the deploy restarts the Slack daemon, and a child of it would die mid-install. With no user manager (a container, a cron) a detached child, sleeping first when timed; the job file is the retry. Returns (how, '') or ('', why)."""
    unit = f"cc-land-work-at-{int(time.time()) + secs}-{os.getpid()}" if secs else f"cc-land-work-{os.getpid()}-{int(time.time())}"
    if lane:
        unit += "-" + re.sub(r"[^A-Za-z0-9_-]+", "-", lane)
    work = ["work", "--lane", lane] if lane else ["work"]
    timed = [f"--on-active={secs}", "--timer-property=RemainAfterElapse=no"] if secs else []
    rc, o = sh(["systemd-run", "--user", "--collect", "--quiet", *timed, f"--unit={unit}",
                f"--description=cc-land: {'re-drive a kept job' if secs else 'drain the landing queue'}"
                + (f" ({lane} lane)" if lane else ""),
                f"{BIN}/cc-land", *work], timeout=120)
    if rc == 0:
        return unit, ""
    try:
        os.makedirs(LANDQ, exist_ok=True)
        f = open(f"{LANDQ}/work.log", "a")
        argv = (["sh", "-c", f"sleep {secs}; exec {shlex.quote(BIN + '/cc-land')} {shlex.join(work)}"] if secs
                else [f"{BIN}/cc-land", *work])
        subprocess.Popen(argv, start_new_session=True, stdin=subprocess.DEVNULL, stdout=f, stderr=f)
        return "a detached child (no systemd --user here)", ""
    except Exception as e:
        return "", f"systemd-run: {last(o)}; detached: {e.__class__.__name__}: {e}"


def start_worker():
    """Start the queue worker (spawn_work). Returns (started, how)."""
    how, why = spawn_work()
    return bool(how), how or why


def notify(*args, timeout=180):
    """One `cc-slack post <args>`, as (rc, output): every line the queue says to a person goes through here."""
    return sh([f"{BIN}/cc-slack", "post", *args], timeout=timeout)


def track_thread_of(repo, pr):
    """`<repo>/<track>` when the row carrying this PR has a thread of its own — the ONE thread a --go track lives in
    (`cc-slack track-thread`, ~/.cc/slack/track-threads.json) — else "". The brief: "its landing card … live in ONE
    thread in the project's channel": the landing line goes there, as a `--route "<repo>/<track> …"` post, which
    cc-slack lands in that thread. A member project (`<handle>--<track>`) is the same target the other way round."""
    try:
        tt = json.load(open(os.environ.get("CC_SLACK_DIR", f"{HOME}/.cc/slack") + "/track-threads.json"))
    except Exception:
        return ""
    handle, track = member_of(repo)
    if not (handle and track):
        track = next((name for name, t in board(repo).get("tracks", {}).items()
                      if re.search(rf"/pull/{pr}(?:/|$)", str(t.get("pr") or "")) or str(t.get("pr") or "") == str(pr)), "")
    target = f"{handle or repo}/{track}" if track else ""
    return target if target and isinstance(tt.get(target), dict) and tt[target].get("ts") else ""


def say_result(job, r):
    """Say the result ONCE — the brief: "a landing notifies once per terminal state". One `cc-slack post` under the job's producer id (`land:<repo>:<pr>:<outcome>@<queued_at>`, so a retry never posts twice), written to the queue log as `notify`: in the reply thread when the job has one; else the track's own thread when it has one (track_thread_of); else a member project's own lane (#<handle>-updates landed, #<handle> stopped); else a stop is routed (`post --route`, the repo's updates lane) and a landing with no thread is its card, already edited to landed ✓ — unless the text carries a restart that is the owner's, which is routed with the one @-mention allowed to page him. A stop of a box repo also wakes its planning session (`cc-slack inject`, first attempt only): the seat's wake, not a post. A stop's card is the one line result_of built (stop_card) and nothing else. Returns whether Slack took it."""
    chat, ts, repo, pr = job.get("chat") or "", job.get("ts") or "", job.get("repo") or "", job.get("pr")
    state = "landed" if r.get("ok") else "stopped"
    pid = f"land:{repo}:{pr or 'deploy'}:{state}" + (f"@{job['queued_at']}" if job.get("queued_at") else "")
    what = f"[{repo}] " + (f"PR #{pr}" if pr else "deploy")
    handle = member_of(repo)[0]
    tt = "" if chat or r.get("restart") else track_thread_of(repo, pr)   # a restart that is the owner's still pages him
    if chat:
        where, args = "thread", ["-c", chat, *(["--thread", ts] if ts else [])]
    elif tt:
        where, args = "track thread", ["--route", f"{tt} {state}"]
    elif handle:
        where = f"#{handle}-updates" if r.get("ok") else f"#{handle}"
        args = ["-c", where]
    elif r.get("ok") and not r.get("restart"):
        where, args = "card", []
    else:
        where, args = "route", ["--route", f"{what} {state}"] + (["--mention"] if r.get("restart") else [])
    said = True
    if args:
        rc, o = notify(*args, "--id", pid, r.get("text", ""), timeout=180 if chat else 60)
        said = rc == 0 or "no SLACK_BOT_TOKEN" in o
    ledger(f"notify {repo}#{pr or 'deploy'} {state} → {where}" + ("" if said else f" — Slack did not take it: {last(o, 120)}"))
    if not r.get("ok") and not handle and not job.get("say_tries"):
        # The first attempt only: the injected line carries no producer id, so a retry sweep must not say it again.
        # Short, because the thread or the updates lane has the full text — this just wakes the seat.
        short = (r.get("short") or "")[:200].replace("\n", " ")
        again = f"cc-land queue {repo} {pr}" if pr else "cc-land work"
        sh([f"{BIN}/cc-slack", "inject", repo, f"{what} landing stopped: {short}. Fix it, then `{again}`."], timeout=120)
    return said


def box_hand():
    """The cwd and env everything below asks in. cc-notify decides who may reach the owner from the caller itself
    (its is_control: CC_MEMBER_SANDBOX, CC_ROLE, and a `.cc/track` / `.cc/member-facing` marker above the cwd) — and a
    self-landing repo's PR is queued from the track's own worktree (cc-loop's `tmux new-window -c <worktree>`, and `cc`
    writes the marker there), so the asks below inherited a directory that says "a track asked". The 🔐 card became a
    request to the planning seat and the owner never got the card his 👍 needs. These are the box's own hand, not the
    track's: run them from ~, with no role in the env. It is not the whole answer for the card — is_control also asks
    the daemon which seat owns this pid chain, and no cwd or env changes that — which is why the card itself is
    raised by owner_card below and only the HELD ask still goes out through cc-notify's door."""
    return {"cwd": HOME, "env": {k: v for k, v in os.environ.items() if k not in ("CC_ROLE", "CC_MEMBER_SANDBOX")}}


def owner_card(pid, text):
    """THE 🔐 CARD, RAISED WHOEVER RAN cc-land: one `cc-slack post -c #approvals --mention --id <pid>` carrying the
    "🔐 *Approval needed:* [<repo>] PR #<n> …" body the daemon reads back (APPROVAL_RE → on_approval, which queues
    the head on the owner's own 👍). It went out as `cc-notify --approval`, whose door asks WHO IS CALLING, and the
    last reading it takes is the daemon's word on the seat owning this process's pid chain. box_hand() can hand it
    a clean cwd and a clean env; it cannot leave the pid chain — so `cc-land queue <repo> <pr>` typed into a
    session, which is the route cc's own stop line offers ("Started by hand? cc-land queue …"), still read as that
    session's ask: the card was filed as a request to the planning seat and #approvals had nothing to tap. That is
    the same missing card box_hand was added to fix. Posting it here widens nothing, because the card is not the
    authority — only his own 👍 on it is (approved_by against SLACK_OWNER_ID) — and #approvals is the daemon's own
    constant lane, the one on_approval reads. What stays with cc-notify is its accounting line and the phone
    fallback, and a phone line about a card that was never posted is no use to him anyway."""
    if re.search(r"(?:^|[^A-Za-z0-9])_(?:cctest|selfcheck)", text):
        # THROWAWAY TEST STATE MUST NEVER PAGE HIM, and this door is the one that would: cc-notify's gate on
        # synthetic repo names stayed behind with cc-notify, and the fixtures that exercise a protected refusal
        # are real calls to this function. Anchored on a non-alphanumeric, the way that gate is, so a real repo
        # that merely contains the word (myrepo_cctesting) still gets its card.
        ledger(f"unsaid {pid}: synthetic test state, no 🔐 card posted")
        return False
    rc, o = sh([f"{BIN}/cc-slack", "post", "-c", "#approvals", "--mention", "--id", pid,
                f"🔐 *Approval needed:* {text}"], timeout=60, **box_hand())
    if rc != 0 and "no SLACK_BOT_TOKEN" not in o:
        ledger(f"unsaid {pid}: #approvals did not take the 🔐 card — {last(o, 120)}")
    return rc == 0


def say_protected_stop(job, text, tag="protected"):
    """A protected-path stop, said to the people who can move it and nobody else: once in the card's own thread when the job has one (else routed as a stop is, say_result's door), under a producer id so a sweep that stops the same job twice says it once — `tag` names WHICH stop, because a hold that is said and the refusal that may follow it are two things to say and one id would swallow the second — and to the door that can move it: a REFUSAL is an authorization only the owner gives (owner_card, a 🔐 card posted at #approvals naming this PR, and his own 👍 on THAT card queues the head — the routine PR card of a self-landing repo lives in the log lane, where a 👍 only re-queues a stopped landing and authorizes nothing, so it is not the card to leave this to), while a HOLD (tag `held`: a '?' the box cannot read through) is an operational fault and a request to the planning seat (`--ask`), not his. Not say_result: that wakes the planning session, which can do nothing about an authorization."""
    chat, ts, repo, pr = job.get("chat") or "", job.get("ts") or "", job.get("repo") or "", job.get("pr")
    pid = f"land:{repo}:{pr}:{tag}" + (f"@{job['queued_at']}" if job.get("queued_at") else "")
    args = ["-c", chat, *(["--thread", ts] if ts else [])] if chat else ["--route", f"[{repo}] PR #{pr} stopped"]
    rc, o = notify(*args, "--id", pid, text, timeout=60)
    said = rc == 0 or "no SLACK_BOT_TOKEN" in o
    ledger(f"notify {repo}#{pr} protected → {'thread' if chat else 'route'}"
           + ("" if said else f" — Slack did not take it: {last(o, 120)}"))
    if tag == "held":   # not an authorization: a request to the planning seat is exactly what this door makes of it
        sh([f"{BIN}/cc-notify", "--ask", "--id", f"{pid}:owner", "-t", f"{repo} approval", text], timeout=60, **box_hand())
    else:
        owner_card(f"{pid}:owner", text)


def say_protected_door(repo, pr, hit):
    """The 🔐 card the DOOR's own refusal leaves behind. say_protected_stop needs a job and the door refuses before
    one exists, and the PR's routine card may be standing in the log lane, where a 👍 re-queues a stopped landing
    and authorizes nothing (cc-slack's card_lane) — so a self-landing repo's protected PR had no card his 👍
    could lift the hold from. Worded as
    cc-slack reads an authorization card ("[<repo>] PR #<n> …", APPROVAL_RE), so his 👍 on it goes to on_approval
    and queues the head. The id carries the head: the same refusal repeated is one card (cc-slack's sent ledger
    answers the replay), and a new head is a new question. Only a NAMED file — a '?' hit is the box not knowing,
    which is an operational fault and not an authorization to ask him for."""
    if hit[0] == "?":
        return
    head = pr_head(repo, pr)
    pid = f"land:{repo}:{pr}:protected-door" + (f"@{head}" if head else "")
    owner_card(pid, f"[{repo}] PR #{pr} is not queued — {protected_under(repo, hit)}. Nothing merged, and your "
                    f"own 👍 on this card is what queues it")


SAY_TRIES = 6   # sweeps (RETRY_AFTER apart) a result whose post Slack refuses is kept for before the ledger line is all it gets


def finish(path, job):
    """Say it once, then forget the job: 'said' is written before the file goes, and said means Slack took it. A refused post keeps the job on disk for the next sweep, up to SAY_TRIES, after which the ledger line is the record."""
    if not job.get("posted"):
        r = job.get("result") or {}
        said = say_result(job, r)
        if not said and job.get("say_tries", 0) + 1 < SAY_TRIES:
            job["say_tries"] = job.get("say_tries", 0) + 1
            ledger(f"unsaid {job.get('repo')}#{job.get('pr') or 'deploy'}: Slack did not take the result (try {job['say_tries']} of {SAY_TRIES}) — kept for the next sweep")
            with contextlib.suppress(OSError):
                write_atomic(path, job)
            return
        # …and the ledger keeps what the card handed it (result_of's `detail`): the step's whole message, the
        # repair-round tally and which try this was. The card is one line because this line is not.
        ledger(f"done {job.get('repo')}#{job.get('pr') or 'deploy'} rc={r.get('rc')} {r.get('short', '')}"
               + (f" | {r['detail']}" if r.get("detail") else "")
               + ("" if said else " (Slack never took the result)"))
        job["posted"] = True
        with contextlib.suppress(OSError):
            write_atomic(path, job)
    with contextlib.suppress(OSError):
        os.unlink(path)


STOP_CARD_MAX = 200   # the whole NOT-merged card. It is the commonest thing the box puts in front of the owner and
                      # he reads it on a phone, so it is one line: which PR, why in a few words, whose move, the
                      # link. Everything that used to ride along — the SHAs, the review's cost, the repair-round
                      # tally, the gate log's path, the fenced run output — is in the landing record (queue.log,
                      # work.log, the kept gate log, the failures ledger) and in the PR thread, both of them one
                      # tap from that link.
STOP_ASIDE = re.compile(r"\s*\[[^\]]*\]|\s*\((?:\$|rc=)[^)]*\)")   # a kept log's path, a review's cost: the record's
STOP_PROSE = re.compile(r"\s+—\s.*\Z", re.S)                       # …and the advice after the first em-dash


def stop_why(L):
    """Why the landing stopped, in a few words for the card: the step's own `short` when it named one (a gate gives
    the case that FAILED), else its message with the record's asides and its trailing advice trimmed off."""
    if L.stopped == "review" and exhausted(L.why):
        # A cap is not a verdict — nothing read this diff — so the card says that and not what the reviewer charged.
        return "the review hit its own cap: nothing read the diff"
    if L.why_short:
        return L.why_short
    why = STOP_PROSE.sub("", STOP_ASIDE.sub("", (L.why or "").strip())).strip(" .")
    return why or "the box could not read it"


def stop_who(L):
    """Whose move it is next, in a few words. By the time a NOT-merged card is written the queue has stopped trying
    and every automatic round it had is spent (run_job), so the move is a person's; what differs is where they look.
    A review stop sends them to the verdict already on the PR, anything else to the thing that failed."""
    if L.stopped == "review":
        return "The reviewer's notes are on the PR" if L.verdict else "Re-queue it to get a review"
    return "Fix it, then re-queue it"


def pr_link(L):
    """The PR's own url for the card: what GitHub said when the PR was read, else one built from the checkout's
    origin, since a landing that could NOT read the PR still owes the owner somewhere to look. '' with no PR."""
    if L.facts.get("url"):
        return L.facts["url"]
    if not L.pr:
        return ""
    rc, o = sh(["git", "remote", "get-url", "origin"], cwd=L.root, timeout=30)
    m = re.search(r"github\.com[:/]+([^/\s]+?)/([^/\s]+?)(?:\.git)?\s*$", o or "")
    return f"https://github.com/{m.group(1)}/{m.group(2)}/pull/{L.pr}" if not rc and m else ""


def stop_card(L):
    """The whole NOT-merged card, one line under STOP_CARD_MAX: which PR, why in a few words, whose move, the link. The
    reason is the only part that gives ground when the line is too long — without the link none of it is actionable,
    and the reason it is cut from is in the landing record at the other end of that link."""
    head = f"[{L.repo}] " + (f"PR #{L.pr}" if L.pr else L.what()) + ": NOT merged ❌ — "
    link = pr_link(L)
    tail = f". {stop_who(L)}." + (f" {link}" if link else "")
    room = STOP_CARD_MAX - len(head) - len(tail)
    why = " ".join(stop_why(L).split())
    if len(why) > room:
        why = why[:room - 1].rstrip() + "…" if room > 1 else ""   # …and with no room at all it goes, not the link
    return head + why + tail


def stop_rounds(L, job):
    """The automatic rounds this change has already spent, for the landing record — never for the card. A cap is
    NOT a verdict: nothing read this diff, so no round failed here, and saying it had sent #194 to a person as a
    change twice rejected."""
    if L.stopped == "review" and exhausted(L.why):
        return ""
    fix = job.get("fix") or {}
    if fix.get("over") == "no push":
        return f"the fix iteration the queue dispatched to {fix.get('track')} ended without pushing anything"
    if fix:
        return f"after one automatic fix iteration in {fix.get('track')}"
    # …and the same fact for a stop that arrived on a LATER job: the round was spent, this job never saw it
    n = (root_work(L.repo, L.pr) if L.pr else {}).get("repairs") or 0
    return f"after {n} automatic fix iteration{'s' if n > 1 else ''} on this change" if n else ""


# The step names (walk) in words a person reads: which piece of bookkeeping wants a hand, and where a deploy stopped.
# "the deploy stopped at daemons" told the owner nothing he could act on. A step with no word here is named as it is.
BOOKKEEPING = {"card": "turning the approval card to landed", "board": "closing the board row",
               "ledger": "marking what the task asked for as merged"}
DEPLOY_STAGE = {"install": "while installing the new code", "units": "while switching on a service the change added",
                "restart": "while restarting what runs the changed code",
                "daemons": "while restarting the box's long-running programs"}


def in_words(names, table):
    """The steps as a phrase: "closing the board row", or "closing the board row and marking what the task asked for as merged"."""
    said = [table.get(n, n) for n in names]
    if len(said) > 1:
        return ", ".join(said[:-1]) + " and " + said[-1]
    return said[0] if said else "a bookkeeping step"


def result_of(L, rc, job, tail):
    """What this landing means, in one sentence the owner can act on, and whether the PR is in. A stop says it in
    one line under STOP_CARD_MAX (stop_card) and hands the rest to `detail`, which the ledger keeps."""
    what = f"[{L.repo}] " + (f"PR #{L.pr}" if L.pr else L.what())
    tries, detail = job.get("attempts", 1), ""
    # Which tree the gates ran on, in the sentence the owner reads: the merge, a head that already holds the base, or a merge git could not build. Asked lazily: a landing that stopped before the gates has no answer.
    def on():
        if not L.pr:
            return "tested it"
        if L.merged_on:
            return f"tested it with {L.base()} merged into the branch"
        if L.merge_unbuilt:
            return "tested the branch on its own, because git could not build the merge"
        return f"tested the branch, which already had {L.base()} in it"
    if rc == 0 and L.batch:
        short = (f"{what}: landed ✅. I {on()}. It's merged with its batch; the suite runs on {L.base()} now, "
                 f"and the box installs the batch when that is green.")
    elif rc == 0:
        short = f"{what}: landed ✅. I {on()}. It's merged and deployed, and its check passed here."
    elif rc == COSMETIC:
        short = (f"{what}: landed ✅. I {on()}. It's merged and deployed, but {in_words(L.hurt, BOOKKEEPING)} did "
                 f"not go through. Running the same landing again picks up just that.")
    elif rc == UNVERIFIED:
        short = (f"{what}: merged and deployed ✅, but I couldn't check that it's really showing for you, so I've "
                 f"left your request open.")
    elif L.stopped in ("review", "gates", "load", "merge"):
        # review belongs here, not in the deploy branch: it runs before the merge, so a stop leaves the PR out.
        short = stop_card(L)
        # The tallies and the full message: the record's, not the card's — finish() writes them to the queue log,
        # which is ONE LINE PER EVENT — so the step's message is flattened and bounded, and the tallies, which are
        # what the record is read for, come after it whole. The whole verdict is on the PR, which the card links.
        detail = "; ".join(x for x in (f"{L.stopped}: {' '.join((L.why or '').split())[:400]}",
                                       stop_rounds(L, job), f"try {tries} of {LAND_TRIES}") if x)
    else:
        short = (f"{what}: merged, but the deploy stopped {DEPLOY_STAGE.get(L.stopped, f'at {L.stopped}')} ❌ after "
                 f"{tries} tries. The box is still running the old code.")
    # A unit whose restart the manifest keeps for the owner is on the old code, and the sentence carries the command. Only the landing that raised the ask says it.
    ask = ""
    if L.owner_asks and rc in (0, COSMETIC, UNVERIFIED):
        ask = (f"⚠️ Please restart {', '.join(L.owner_asks)}. Until then the box runs the old code for "
               f"{'them' if len(L.owner_asks) > 1 else 'it'}.")
        short += " " + ask
    # ...and the ask on its own: the one line addressed to a person, routed by say_result when the job has no thread.
    # A NOT-merged card is the line and nothing else: the run's output rode along fenced until 2026-09-16 and made
    # the card as long as 1275 characters, and none of it is what the owner decides on. It is in the landing record.
    return {"ok": rc in (0, COSMETIC, UNVERIFIED), "rc": rc, "short": short, "restart": ask, "detail": detail,
            "text": short if rc == 0 or detail else f"{short}\n```\n{tail[-900:]}\n```"}


def not_tracks(findings):
    """(the track's findings, a person's), split on the reviewer's own `NOT THE TRACK'S: <who> — <what>` marker (review-prompt.md): a round is never spent on a remedy cc-guard would refuse the track."""
    ours, theirs = [], []
    for line in (findings or "").splitlines():
        (theirs if NOT_TRACKS_RE.search(line) else ours).append(line)
    mine = [l for l in ours if re.match(r"\s*\d+\.\s", l)]      # findings, not the header a read-back comment carries
    return ("\n".join(ours).strip() if mine or not theirs else ""), "\n".join(theirs).strip()


NOT_TRACKS_RE = re.compile(r"\bNOT THE TRACK['’]S\b", re.I)


def dispatch_fix(path, job, L, conflict=""):
    """One fix iteration for a LAND-AFTER-FIX (or, with `conflict`, one rebase round), dispatched by the queue with the PR kept on it: the verdict goes to `review-<pr>.md` in the track's state dir, the brief is a goal. Returns the sweep's line, or '' to let the ordinary path tell the owner; a launch the box could not make holds the job."""
    verdict = "CONFLICT" if conflict else L.verdict
    track = L.find_track()
    st = f"{STATE}/{L.project}/{track}" if track else ""
    none = lambda why, kind="fix-none": ledger(f"{kind} {L.repo}#{L.pr} {why}") or ""   # no round: the ledger says why, the caller tells the owner
    if not track or not os.path.isdir(st):
        return none(f"verdict={verdict} — no track state dir carries this PR")
    findings, theirs = (conflict, "") if conflict else not_tracks(L.findings)
    if theirs and not findings:
        # A remedy cc-guard refuses a track (a base-branch push, a rename, the API) does not spend the round: the stop says whose line it is.
        return none(f"verdict={verdict} — every finding is a person's: {last(theirs)[:200]}")
    reservation, resume, task, facts = None, True, None, {}
    if os.path.lexists(f"{st}/delivery.json"):
        rc, out = sh([f"{BIN}/cc-task", "show", L.project, track])
        try:
            task = json.loads(out)
            # Ask in the path-selected repository. The task's repo and URL are evidence, never credentials.
            facts = pr_facts(L.root, L.pr, "url,state,headRefName")[0] or {}
            if (rc or facts.get("state") != "OPEN" or task.get("closed")
                    or task.get("repo") != L.repo or task.get("branch") != facts.get("headRefName")
                    or (task.get("pr") or {}).get("url") != facts.get("url") or not facts.get("url")):
                raise ValueError("record repo, branch or PR does not match an open PR")
        except (ValueError, KeyError, TypeError, AttributeError) as e:
            return none(f"track={track} — repair request refused: {e}", "fix-identity")
    elif L.facts.get("headRefName") != f"track/{track}":
        # No task record, so nothing says where this PR was built; the dispatch runs only in the canonical worktree.
        return none(f"track={track} — repair request refused: not the canonical branch", "fix-identity")
    rv = f"{st}/review-{L.pr}.md"
    try:
        # ~/.cc/state/<handle>/<track> is bound read-write into a member's boundary: the directory must hold no link on the way and the file is opened O_NOFOLLOW.
        if os.path.realpath(st) != st:
            raise OSError(f"{st} is not a plain directory (a link on the way)")
        fd = os.open(rv, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, "w") as f:
            f.write(f"# cc-land review of PR #{L.pr} — {stamp()}\n\nVERDICT: {verdict}\n\n{findings}\n"
                    + (f"\nNOT THE TRACK'S — left to the person each line names, not this round's to attempt:\n"
                       f"{theirs}\n" if theirs else ""))
    except OSError as e:
        return none(f"— cannot write {rv}: {e}")
    # A conflict was not reviewed and no gate fetched it, so the round's starting head is asked of origin itself.
    head = L.reviewed or L.head or remote_head(L.repo, L.facts.get("headRefName") or "")
    if not head:
        return none(f"verdict={verdict} — origin does not say where {L.facts.get('headRefName')} is")
    if task is not None:
        # Last, because a reservation is durable: a write that fails after it leaves an execution spent on a round that never launches.
        rc, out = sh([f"{BIN}/cc-task", "reserve-repair", L.project, track,
                      "--generation", str((task.get("claim") or {}).get("generation")),
                      "--branch", facts["headRefName"], "--pr", facts["url"], "--head", head])
        try:
            if rc: raise ValueError(last(out))
            reservation = json.loads(out)
            resume = reservation["repair"]["resume"]
        except (ValueError, KeyError, TypeError) as e:
            return none(f"track={track} — repair request refused: {e}", "fix-identity")
    context = ("This continues your own session, so you already have the change in front of you — do not re-derive it. "
               if resume else "This is a fresh worker recovering a subagent-built change in the same canonical "
               "worktree. Read task.md, the findings file, progress.md and the branch diff to recover the context. ")
    # The brief says the limit in the worker's own terms (edits on this branch in this worktree, what cc-guard lets a track do); a finding asking for more names whose line it is.
    limit = (f"cc-guard confines you to this branch in this worktree: no push to {L.base()} or any other branch, no "
             f"branch rename or repoint, no merge, no `gh api`, no PR comment or close — the checkpoint hook pushes "
             f"this branch for you. A finding that needs one of those is not yours: leave it, and end with "
             f"'STATUS: BLOCKED: <whose line it is — owner or planning seat> — <what>' in progress.md.")
    if conflict:
        go = (f"REBASE ROUND, dispatched by the landing queue itself — no person is waiting in this loop, and there is "
              f"exactly ONE of these: what it does not resolve goes to a person. {context}GOAL: PR #{L.pr} merges "
              f"cleanly into {L.base()}. WHY: {conflict} — the base moved under this branch, so the landing holds it "
              f"and nothing else can move it; the note is in {rv}. BOUNDARIES: this branch and this PR only — "
              f"`git fetch origin {L.base()}` and rebase (or merge) origin/{L.base()} here, keep both sides' "
              f"intent where they collide, change nothing the conflict does not touch, do not open a second PR. "
              f"{limit} DONE: the branch merges into origin/{L.base()} with no conflict and this repo's own gates "
              f"are green on the result.")
    else:
        go = (f"REPAIR ROUND, dispatched by the landing queue itself — no person is waiting in this loop, and there is "
              f"exactly ONE of these: what it does not fix goes to a person. {context}GOAL: PR #{L.pr} passes the review "
              f"gate. WHY: the gate answered {L.verdict}, so the change is wanted and is not yet right; its findings "
              f"are in {rv}. BOUNDARIES: this branch and this PR only — do not open a second PR, do not merge, and do "
              f"not widen the change beyond what the findings ask for. {limit} DONE: every finding in that file "
              f"that is the track's is addressed and this repo's own gates are green on the branch. You choose the "
              f"implementation, the tests and the docs.")
    launch = reservation is None or reservation["launch"]
    at = reservation["repair"]["at"] if reservation else stamp()
    job["fix"] = {"track": track, "verdict": verdict, "head": head, "at": stamp(),
                  "by": f"{FIX_MODEL}, loop {FIX_LOOP}, ${FIX_BUDGET}, {'resumed' if resume else 'fresh'}",
                  "deadline": stamp(epoch_of(at) + FIX_WAIT)}
    if reservation: job["fix"]["execution_id"] = reservation["execution_id"]
    # Uncounted, like a usage-limit deferral: the PR was read and answered, and the answer is being acted on.
    job.update(attempts=job["attempts"] - 1, stage="fixing", last=f"review: {verdict}, fixing in {track}"[:400],
               not_before=stamp(time.time() + FIX_POLL))
    job.pop("held", None)             # a held conflict is being worked on now: the next hold, if any, is a new line
    write_atomic(path, job)
    # Both records precede launch. A timeout can mean the window exists; keep waiting on this reservation.
    if launch: root_spend(L.repo, L.pr, **({"rebases": 1} if conflict else {"repairs": 1}))
    if not launch:
        ledger(f"fix-reserved {L.repo}#{L.pr} track={track} — existing repair; no second launch")
        return f"[{L.repo}] PR #{L.pr}: waiting on the reserved repair in {track}; no second worker launched"
    # CC_BRIEF_MACHINE: this brief is the box's own writing, so it takes the machine seam past cc-brief's judge, which holds a person to goal-shaped briefs; CC_BRIEF_FORCE would record an override instead.
    rc, o = sh([f"{BIN}/cc", L.project, track, "--go", go, "--loop", FIX_LOOP,
                *(["--resume-last"] if resume else []), "--no-extend",
                "--model", FIX_MODEL, "--budget", FIX_BUDGET], timeout=300,
               env=dict(os.environ, CC_BRIEF_MACHINE="1"))
    if rc and "TimeoutExpired" in o:
        # A timeout is not a refusal: the window may exist, so the job keeps its reservation and its `fixing` stage, and fix_progress watches for the push.
        ledger(f"fix-refused {L.repo}#{L.pr} track={track} rc={rc} {last(o)[:160]} — reservation kept")
        return f"[{L.repo}] PR #{L.pr}: repair launch unconfirmed in {track}; reservation kept, no retry worker"
    if rc:   # `cc` itself answered (a paused project, the spend tier, a brief the judge refused): nothing is coming
        # A round nobody dispatched is a hold, not a wait: the reason on the record (the head of what `cc` said, flattened to one line), a `held` ledger line, one line in the track's lane, and fix_refused keeps it held.
        said = " ".join((o or "").split())[:200] or f"`cc` exited {rc} with nothing to say"
        why = f"the repair round for PR #{L.pr} was not dispatched to {track}: {said}"
        ledger(f"fix-refused {L.repo}#{L.pr} track={track} rc={rc} {last(o)[:160]} — reservation kept")
        ledger(f"held {L.repo}#{L.pr} — {why}")
        job["fix"] = dict(job["fix"], over="refused", refused=why)
        job.update(stage="held", held=why, last=f"review: {verdict}, {why}"[:400],
                   not_before=stamp(time.time() + RETRY_AFTER))
        write_atomic(path, job)                  # the record before the word about it, as everywhere else here
        # Said once, ever (the producer id is this job's), titled on L.project so a member workspace's round is said in its own lane.
        notify("--route", f"{L.project}/{track} repair not dispatched",
               "--id", f"land:{L.repo}:{L.pr}:fix-refused@{job.get('queued_at') or at}",
               f"[{L.repo}] PR #{L.pr}: {verdict}, and its repair round could not be dispatched to {track} — "
               f"{said}. The landing is held and nothing re-drives it: dispatch the round by hand, or take it "
               f"off the queue — remove {path}, then `cc-land work`.", timeout=60)
        return (f"[{L.repo}] PR #{L.pr}: held — {why}. The reservation is kept and no retry worker was bought")
    what = "rebase" if conflict else "fix"
    ledger(f"fix-dispatch {L.repo}#{L.pr} track={track} verdict={verdict} model={FIX_MODEL} loop={FIX_LOOP} "
           f"budget={FIX_BUDGET} head={head[:12]} brief={rv}")
    sh([f"{BIN}/cc-board", "note", L.project, track,
        f"cc-land: {verdict} on PR #{L.pr} — one {what} iteration dispatched automatically ({FIX_MODEL}); the PR "
        f"re-queues itself when this branch pushes"], timeout=60)
    return (f"[{L.repo}] PR #{L.pr}: {verdict} — one {what} iteration dispatched to track {track} on {FIX_MODEL}, "
            f"and the PR stays queued; it is re-reviewed when that branch pushes")


def fix_refused(job, L):
    """Why a job whose repair round was refused is still held, or ''; the hold lifts itself when the branch moves."""
    fix = job.get("fix") or {}
    if fix.get("over") != "refused":
        return ""
    head = remote_head(job.get("repo") or "", (L.facts or {}).get("headRefName") or "")
    if head and fix.get("head") and head != fix.get("head"):
        return ""
    return fix.get("refused") or f"the repair round for PR #{job.get('pr')} was refused — no worker was dispatched"


ROUND_END_RE = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ) (?:exit \d+:|DONE\b)")
ROUND_LOG_TAIL = 65536                    # …how much of a track's loop.log the line below is looked for in


def round_live(repo, track, since=""):
    """Is the round dispatched at `since` still going? The track's own word first: a stamped `exit <code>: …` or `DONE` line at or after `since` in ~/.cc/state/<repo>/<track>/loop.log ends it (no `since`, or nothing readable or stamped: no word). Then the board word `running`, then the track's tmux window holding a worker — a pane shell with a child, since `cc … --go` leaves the window behind as a bare shell. Conservative, with the fix deadline as the backstop."""
    if not (repo and track):
        return False
    try:
        with open(f"{STATE}/{repo}/{track}/loop.log", "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - ROUND_LOG_TAIL))    # a long-lived track's log, bounded; a split first line
            tail = f.read().decode("utf-8", "replace").splitlines()   # simply fails the match
    except OSError:
        tail = []
    if since and any(m and m.group(1) >= since for m in map(ROUND_END_RE.match, tail)):
        return False
    rc, o = sh([f"{BIN}/cc-board", "get", repo, track, "status"], timeout=60)
    if rc == 0 and (o or "").strip() == "running":
        return True
    rc, o = sh(["tmux", "list-windows", "-t", "main", "-F", "#{window_id} #{window_name}"], timeout=60)
    wid = next((w for w, _, n in (l.strip().partition(" ") for l in (o or "").splitlines())
                if n == f"{repo}/{track}"), "") if rc == 0 else ""
    rc, o = sh(["tmux", "list-panes", "-t", wid, "-F", "#{pane_pid}"], timeout=60) if wid else (1, "")
    pid = ((o or "").splitlines() or [""])[0].strip()
    return rc == 0 and bool(pid) and sh(["pgrep", "-P", pid], timeout=60)[0] == 0


def remote_head(repo, branch):
    """The SHA `branch` points at on origin, asked of the remote itself with ls-remote (the PR object's headRefOid lags the ref); '' on any doubt, and the caller keeps the PR object's answer."""
    return remote_shas(repo, f"refs/heads/{branch}").get(f"refs/heads/{branch}", "") if branch else ""


def remote_shas(repo, *refs):
    """{ref: sha}, what origin itself says those refs point at, in one call; a ref it does not answer for is absent."""
    refs = [r for r in refs if r]
    if not refs:
        return {}
    rc, o = sh(["git", "ls-remote", "origin", *refs], cwd=repo_root(repo), timeout=120)
    if rc != 0:
        return {}
    got = {}
    for row in (o or "").splitlines():
        bits = row.split()
        if len(bits) == 2 and re.fullmatch(r"[0-9a-f]{40}", bits[0]):
            got[bits[1]] = bits[0]
    return got


def job_set(path, job, **fields):
    """The job on disk with `fields` set, before the thing they describe happens; `not_before=None` takes the wait off it."""
    job.update(fields)
    if "not_before" in job and job["not_before"] is None:
        del job["not_before"]
    write_atomic(path, job)


def limit_stands(path, job):
    """True while a job's wait is still owed, False to run it now. A deferral cc-limit itself wrote (`limit_src`, run_job) is ASKED again on each sweep instead of slept through, because the reset it named is a guess: a stamp that is gone means the limit lifted early, so the wait comes off and the job runs this sweep. A fresh answer may only bring the wait FORWARD, never push it out, so asking cannot itself defer a job for ever. Nothing else is touched or even asked — a wait that is not a usage limit (held, a fix round polling), a member's daily cap, a limit only the reviewer saw: cc-limit cannot speak for those, and freeing one on its say-so would re-run the whole job into the same deferral every sweep for ever, uncounted, because the deferral hands the attempt back."""
    if job.get("stage") != "deferred" or job.get("limit_src") != "cc-limit":
        return True
    rc, out = sh([f"{BIN}/cc-limit", "status"], timeout=60)
    until = limit_until(out) if rc == 0 else ""
    if until:
        if until < (job.get("not_before") or ""):
            job_set(path, job, not_before=until)
        return True
    if LIMIT_ELSEWHERE_RE.search(out or ""):
        return True     # exit 1 is "no stamp binds THIS caller" (cc-limit, believe), and this one names a live stamp
    job_set(path, job, stage="queued", not_before=None)
    return False


def fix_progress(path, job):
    """A job waiting on the fix round it dispatched: re-queued once the round has ended (round_live) with a pushed head; a round that never pushes goes back to the ordinary path at its deadline; a PR that merges under the round is not waited on. Returns a line to stand down with, or '' to run the job now."""
    fix = job.get("fix") or {}
    repo, pr = job.get("repo") or "", job.get("pr")
    facts = pr_facts(repo_root(repo), pr, "headRefOid,headRefName,state")[0] or {}
    head, branch, state = ((facts.get(k) or "").strip() for k in ("headRefOid", "headRefName", "state"))
    if state == "MERGED":
        # The push this was waiting for is the merged branch coming back (no worker re-creates a branch a merge deleted): the wait ends and the ordinary path reads the merge.
        job_set(path, job, fix=dict(fix, over="merged"), attempts=0, stage="queued", not_before=None)
        ledger(f"fix-merged {repo}#{pr} track={fix.get('track')} — merged while the round ran; not waiting for "
               f"its push")
        return ""
    # Where gh could not name the branch, the track's canonical one is asked for: dispatch_fix already checked the PR's head is `track/<track>`.
    branch = branch or (f"track/{fix['track']}" if fix.get("track") else "")
    head = remote_head(repo, branch) or head    # the REMOTE's own ref is the head; the PR object is only the fallback
    late = stamp() >= (fix.get("deadline") or "")     # the deadline bounds EVERY wait here, whatever the track looks like
    alive = lambda: round_live(repo, fix.get("track") or "", fix.get("at") or "")   # asked only where the answer decides something

    def wait(why):
        job_set(path, job, not_before=stamp(time.time() + FIX_POLL))
        return f"[{repo}] PR #{pr}: {why}"

    def requeue(head):
        """The round ended with a pushed head: back on the queue with tries fresh, and the ledger says RE-QUEUED in those words."""
        job_set(path, job, fix=dict(fix, over="pushed", pushed=head), attempts=0, stage="queued",
                not_before=None)             # …and the tries start again: this is a different change now
        ledger(f"fix-pushed {repo}#{pr} track={fix.get('track')} {(fix.get('head') or '')[:12]}->{head[:12]} — "
               f"re-queued" + (" (past the fix deadline: reviewed as it stands)" if late else ""))
        return ""
    if head and head != fix.get("head"):
        if not late and alive():
            return wait(f"the fix round pushed a checkpoint ({head[:12]}) but its track {fix.get('track')} is "
                        f"still running — waiting for the round to end")
        return requeue(head)
    if late:
        # Past the deadline with nothing pushed and the round still running: waited for up to one more FIX_WAIT, and the head read after the iteration has ended, since its last act is the push.
        if stamp() < stamp(epoch_of(fix.get("deadline") or "") + FIX_WAIT) and alive():
            return wait(f"the fix iteration in track {fix.get('track')} is past its deadline but still running — "
                        f"waiting for it to end before reading what it pushed")
        head = remote_head(repo, branch) or head    # asked again, now that the iteration is over: what it left
        if head and head != fix.get("head"):
            return requeue(head)
        job_set(path, job, fix=dict(fix, over="no push"), stage="review", not_before=None)
        ledger(f"fix-silent {repo}#{pr} track={fix.get('track')} — nothing pushed by {fix.get('deadline')}, "
               f"and the iteration has ended")
        return ""
    return wait(f"waiting on the fix iteration in track {fix.get('track')} — dispatched {fix.get('at')}, nothing "
                f"pushed yet")


def run_job(path, job):
    """One job, start to finish. Everything durable is written before the thing it describes (the try, the result, 'said'), so a kill converges to at most one merge and one message; 'did the merge happen' is asked of `gh pr view`, and an already-merged PR skips to the deploy."""
    import io
    repo, pr, span = job.get("repo") or "", job.get("pr"), job.get("span")
    # PROTECTED PATHS, asked again here and not only at the queue door: a job queued while the PR touched nothing
    # protected runs on through its fix rounds, and the head it would merge is not the head anybody said yes to.
    # A stop leaves the queue as the door's refusal does — no job, nothing merged, no result card — so the card in
    # #approvals stays pending and the owner's own 👍 on it queues the head that is there now.
    stop = protected_stop(job) if pr else None
    if stop and stop[0] == "?":
        # …except when the stop is NOT-KNOWING rather than a protected file: a cc-config that would not read, a
        # `gh pr view --json files` that failed. Those are transient on every repo that has a list, and a job
        # dropped for one would cost the owner a second 👍 on a landing he had already approved. Kept and looked at
        # again in RETRY_AFTER, costing no try — what a gh failure at L.load() already gets. One ledger line per
        # reason, not per look.
        if job.get("held") != stop[1]:
            ledger(f"held {repo}#{pr} protected:? — {stop[1]}")
            # …and the FIRST hold for a reason is SAID. A '?' that never clears — a cc-config that stays unreadable,
            # a PR over GH_PR_FILES files — would otherwise be re-held every RETRY_AFTER with nobody ever told the
            # landing had stopped. Its own producer ids, so the sweeps after it say nothing and a later refusal's
            # post is not swallowed as a duplicate of this one.
            say_protected_stop(job, f"[{repo}] PR #{pr} is HELD, not landing — {stop[1]}. Nothing merged and the "
                                    f"job stays on the queue; it is asked again every {RETRY_AFTER // 60} min",
                               tag="held")
        job_set(path, job, stage="held", held=stop[1], last=f"protected: {stop[1]}"[:400],
                not_before=stamp(time.time() + RETRY_AFTER))
        return (f"[{repo}] PR #{pr}: held, not tried — {stop[1]}. Nothing merged and the job stays on the queue; "
                f"it is asked again in {RETRY_AFTER // 60} min and this costs it no try")
    if stop:
        ledger(f"refused {repo}#{pr} protected:{stop[0]}")
        # …and the stop REACHES A PERSON (cc-loop's invariant: a landing that stops still reaches one). Dropped with
        # this return string as its only record, a PR the owner 👍'd whose fix round pushed a new head sat with its
        # card at 👀 and nobody was told a second 👍 was needed (review of #527). His 👍 is the one thing that moves
        # it, so it is said in the card's thread and pushed to him — before the unlink, so a kill between the two
        # says it again (once: the producer id) rather than never.
        text = (f"[{repo}] PR #{pr} moved to a head the owner has not 👍'd, under a protected path — 👍 the 🔐 card "
                f"in #approvals to land this head ({stop[1]})"
                if owner_approved(job.get("approved_by") or "") else
                f"[{repo}] PR #{pr} is NOT landing — {stop[1]}. Nothing merged and the job is off the queue; "
                f"the owner's own 👍 on the 🔐 card in #approvals queues this head")
        say_protected_stop(job, text)
        with contextlib.suppress(OSError):
            os.unlink(path)
        return text
    job["attempts"], job["at"] = job.get("attempts", 0) + 1, stamp()
    write_atomic(path, job)                    # counted before anything irreversible: a kill mid-merge is still a try
    L = Land(repo, pr=pr) if pr else Land(repo, span=tuple(span))
    L.job = path
    L.batch, L.warm = job.get("batch") or "", job.get("warm") if job.get("batch") else None
    L.approved_head = job.get("approved_head") or ""   # set only for a protected-path PR: what the merge is pinned to
    buf, held = io.StringIO(), ""
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        if L.load():
            held = L.held() or fix_refused(job, L)    # …GitHub's reasons, then the box's own: a refused repair launch
            rc = 1 if held else L.walk(L.steps() if pr else L.deploy_steps())
        else:
            rc, L.stopped, L.why = 1, "load", f"cannot read PR #{pr} in {L.root}"
    print(buf.getvalue(), end="", flush=True)
    tail = "\n".join(x for x in buf.getvalue().splitlines() if x.strip())
    # A conflict has a way back: one rebase round per change (ROOT_REBASES) to its own track, dispatched as a LAND-AFTER-FIX's is; a second conflict, or no track, falls through to the hold.
    conflict = (held if " conflicts with " in held else
                L.why if rc == 1 and L.stopped == "gates" and " conflicts with " in L.why else "")
    fix = job.get("fix") or {}
    if (conflict and (not fix or fix.get("over"))      # no round of either kind still out on this job
            and root_work(repo, pr).get("rebases", 0) < ROOT_REBASES and not L.merged_since()):
        line = dispatch_fix(path, job, L, conflict=conflict)
        if line:
            return line
    if held:
        # A PR that cannot merge yet (a draft, a conflict) is held, not tried: no gate, no read, the try given back, looked at again in RETRY_AFTER; one ledger line per reason, not per look.
        job.update(attempts=job["attempts"] - 1, stage="held", last=f"held: {held}"[:400],
                   not_before=stamp(time.time() + RETRY_AFTER))
        if job.get("held") != held:
            job["held"] = held
            ledger(f"held {repo}#{pr} — {held}")
        write_atomic(path, job)
        return (f"[{repo}] PR #{pr}: held, not tried — {held}. The queue looks again in {RETRY_AFTER // 60} min "
                f"and this costs it no try; removing {path} takes it out (then `cc-land work`)")
    if rc == 1 and L.stopped == "review" and limited(L.why):
        # A usage limit is the box's state, not a verdict: the job waits for the reset cc-limit names, uncounted, and the sweep arms itself for it (rearm).
        # WHICH limit named it is written on the job, because only cc-limit's own live answer can be re-asked later
        # (limit_stands) — and it is preferred over the line in L.why, which the review's unwind may have left minutes
        # stale. A member's daily cap arrives here in the same words (review()) and cc-limit knows nothing of it.
        lim = sh([f"{BIN}/cc-limit", "status"], timeout=60)
        until = limit_until(lim[1]) if lim[0] == 0 else ""
        src = "cc-limit" if until else "review"
        until = until or limit_until(L.why) or stamp(time.time() + RETRY_AFTER)
        job.update(attempts=job["attempts"] - 1, stage="deferred", not_before=until, limit_src=src,
                   last=f"review: {L.why}"[:400])
        write_atomic(path, job)
        return f"[{repo}] {L.what()}: review deferred until {until} — {L.why[:160]}"
    if (rc == 1 and L.stopped == "review" and L.verdict == "LAND-AFTER-FIX" and (not fix or fix.get("over"))
            and root_work(repo, pr).get("repairs", 0) < ROOT_REPAIRS):   # a rebase round does not use up the fix round
        # ROOT_REPAIRS repair rounds per change, counted in the root tally that outlives the job; a second stop, and every DO-NOT-LAND, goes to the owner.
        if L.merged_since():
            # No fix round is dispatched at a PR that merged while its review ran: GitHub is asked again at the line the money leaves, and a merged PR goes back on the queue to be deployed.
            job_set(path, job, attempts=job["attempts"] - 1,   # uncounted, like the deferral above: nothing was decided
                    stage="queued", last=f"review: {L.verdict}, but PR #{pr} merged first"[:400], not_before=None)
            ledger(f"fix-merged {repo}#{pr} verdict={L.verdict} head={(L.reviewed or '')[:12]} — merged while the "
                   f"review ran; no round dispatched")
            return (f"[{repo}] PR #{pr}: {L.verdict}, but it merged while the review ran — no fix round "
                    f"dispatched; the landing runs again to deploy it")
        line = dispatch_fix(path, job, L)
        if line:
            return line
    decided = L.stopped == "gates" and " conflicts with " in L.why    # no flake: nothing but a rebase changes it.
    # (A conflict GitHub knew of is held above; this is the one merge_result finds itself, which is fresh.)
    if rc == 1 and (L.stopped in RETRY or L.stopped == "load") and not decided and job["attempts"] < LAND_TRIES:
        # Kept, so the next sweep re-drives it; the not_before goes with the try, or a spent reset would be read as the schedule; the stage is the step that stopped.
        job_set(path, job, last=f"{L.stopped}: {L.why}"[:400], stage=L.stopped, not_before=None)
        return (f"[{repo}] {L.what()}: {L.stopped} failed on try {job['attempts']} of {LAND_TRIES} — "
                f"kept for the next sweep")
    job["state"], job["result"] = "done", result_of(L, rc, job, tail)
    write_atomic(path, job)                    # decided, on disk, before a word of it is said
    finish(path, job)
    return job["result"]["short"]


def paused(target):
    """Whether `cc-pause on` has parked the project (repo, tracks, orchs): cc-pause owns the state, and a cc-pause that cannot run means not paused."""
    try:
        target = member_of(str(target))[0] or target   # a member project is parked with its workspace
        return subprocess.run([f"{BIN}/cc-pause", "is", str(target)], stdin=subprocess.DEVNULL,
                              capture_output=True, timeout=10).returncode == 0
    except Exception:
        return False


AFTER_GATES = ("merge", "card", "board", "ledger", "install", "units", "restart", "daemons", "verify")


def tier_holds(job):
    """Whether the box-wide spend tier `stop` (cc-tier) holds this job: a PR job whose stage is still in front of the merge is held, file untouched; one at the merge or after it, or a deploy job, goes on. `cc-tier allows gates` by exit alone: 1 is wait, anything else is go."""
    if not job.get("pr") or job.get("stage") in AFTER_GATES:
        return False
    try:
        return subprocess.run([f"{BIN}/cc-tier", "allows", "gates"], stdin=subprocess.DEVNULL,
                              capture_output=True, timeout=10).returncode == 1
    except Exception:
        return False


def box_hold(job):
    """Why the box itself holds this job, or '': its project parked (paused — the narrower, louder fact, said first), or the spend tier `stop` at its gates (tier_holds). The one question every door asks; a job it holds is not tried and not timed, and the file is not touched, so it lands on the first sweep after the resume."""
    if paused(job.get("repo") or ""):
        return f"{job['repo']} is paused — still queued, lands after `cc-pause off {job['repo']}`"
    if tier_holds(job):
        return "spend tier stop — still queued, its gates run after `cc-tier set` a wider tier"
    return ""


def run_one(path):
    job = read_json(path)
    if not job or not job.get("repo") or not (job.get("pr") or job.get("span")):
        os.replace(path, path + ".unreadable")   # never guess at a landing: keep the file, merge nothing
        return f"{os.path.basename(path)}: not a job this understands — moved aside, nothing merged"
    why = box_hold(job)
    if why:
        return f"[{job['repo']}] {'PR #' + str(job['pr']) if job.get('pr') else 'deploy'}: {why}"
    if job.get("state") == "done":
        finish(path, job)                        # killed between deciding and saying it: say it now, once
        return (job.get("result") or {}).get("short", "")
    if (job.get("fix") or {}).get("over") is None and job.get("fix"):
        line = fix_progress(path, job)           # a dispatched fix iteration: has it pushed? Asked BEFORE the wait
        if line:                                 # below, so a sweep any 👍 starts picks the push up at once
            return line
    if stamp() < (job.get("not_before") or "") and limit_stands(path, job):   # uncounted, untouched, until then
        return (f"[{job['repo']}] {'PR #' + str(job['pr']) if job.get('pr') else 'deploy'}: waits until "
                f"{job['not_before']} ({(job.get('last') or '')[:120]})")
    if job.get("attempts", 0) >= LAND_TRIES:
        finish(path, job)                        # gave up earlier and never got to speak
        return (job.get("result") or {}).get("short", "")
    lock = pr_lock(job["repo"], job["pr"], "queue") if job.get("pr") else None
    other = lock.take() if lock else ""
    if other:
        # A landing somebody ran by hand holds this PR: the job is not tried (no gate, no read, no try counted) and is looked at again in RETRY_AFTER — by then that landing has merged it, and this one deploys, or it has said why not.
        job_set(path, job, last=f"held: {other}"[:400], not_before=stamp(time.time() + RETRY_AFTER))
        return f"[{job['repo']}] {other[:200]} — the queue looks again in {RETRY_AFTER // 60} min"
    try:
        return run_job(path, job)
    finally:
        if lock:
            lock.release()


def known_repos():
    """Every repo this box tracks (the boards name them) plus any it has already deployed; cc-board's `reals` says which board names are real and which a suite's fixture."""
    names = {os.path.basename(x)[:-5] for x in glob.glob(f"{BOARDS}/*.json")}
    names |= {os.path.basename(x)[:-len(".applied")] for x in glob.glob(f"{LANDQ}/*.applied")}
    return ccboard().reals(sorted(n for n in names if re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", n)))


def red_base_path(repo):
    """Where after_batch notes a base tip its suite found red and could not mend: what the catch-up must never install."""
    return f"{LANDQ}/{repo}.red"


def deploy_due(repo, by="the catch-up sweep"):
    """Queue a deploy for `repo` when its origin default branch has moved past the SHA install.sh last ran on, as the job's path, or '' when nothing is owed (or a deploy job already waits, or the tip is one after_batch found RED — a red base is said, never installed behind the batch's back). The catch-up sweep's per-repo step, and the batch's own deploy (after_batch)."""
    root, base = repo_root(repo), (board(repo).get("default_branch") or "main")
    if not os.path.isdir(f"{root}/.git") or os.path.exists(job_path(repo, "deploy")):
        return ""
    with git_lock(root):    # the fetch writes refs/remotes/origin/<base> and the rev-parse reads it back
        if sh(["git", "fetch", "-q", "origin", base], cwd=root, timeout=60)[0]:
            return ""                                    # no remote, no network: nothing to compare against
        rc, o = sh(["git", "rev-parse", f"origin/{base}"], cwd=root)
    if rc:
        return ""
    tip, have = o.strip(), applied_sha(repo)
    if not have:
        # Nothing recorded yet, so read it off the checkout, and only while it is on the default branch.
        if sh(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=root)[1].strip() != base:
            return ""
        rc, o = sh(["git", "rev-parse", "HEAD"], cwd=root)
        if rc:
            return ""
        have = o.strip()
        record_applied(repo, have)
    if have == tip:
        return ""
    if (read_json(red_base_path(repo)) or {}).get("tip") == tip:
        return ""       # the batch's suite found this tip red and said so: a person moves it, not the poll
    if by == "the catch-up sweep" and os.path.exists(batch_path(repo)):
        return ""       # a batch has merged without its suite yet: its lane runs that suite and installs on green
    write_atomic(job_path(repo, "deploy"),
                 {"repo": repo, "pr": None, "span": [have, tip], "queued_at": stamp(), "attempts": 0,
                  "stage": "queued", "by": by,
                  "why": f"origin/{base} moved to {tip[:7]} without this box — what is installed is {have[:7]}"
                         if by == "the catch-up sweep" else f"the batch's suite passed on origin/{base} at {tip[:7]}"})
    ledger(f"queued {repo}#deploy span={have[:7]}..{tip[:7]} by={by}")
    return job_path(repo, "deploy")


def catchup():
    """A merge this box never made still owes it a deploy: queue one for every repo whose origin default branch has moved past the SHA install.sh last ran on (deploy_due). Returns the repos it queued."""
    made = []
    for repo in known_repos():
        if paused(repo) or member_of(repo)[0] or sweep_running(repo):
            continue        # a lane mid-landing deploys what it merges itself; parked: not queued; the poll is idempotent, so the first catch-up after a resume queues it
        if deploy_due(repo):
            made.append(repo)
    return made


def due_catchup():
    """True at most once every CATCHUP_EVERY, stamped on disk so it survives the process and the reboot."""
    f = f"{LANDQ}/.catchup"
    try:
        if time.time() - os.path.getmtime(f) < CATCHUP_EVERY:
            return False
    except OSError:
        pass
    with contextlib.suppress(OSError):
        open(f, "w").close()
    return True


def next_wake(skip=()):
    """Seconds until the earliest job on disk wants running (a deferred one a minute past its not_before, a kept one RETRY_AFTER from now, an untried one almost at once), or None with nothing to wait for. A not_before already behind us is no wait at all. A wait limit_stands may cut short is capped at RETRY_AFTER: the sweep that re-asks is armed by the deferral itself, so a limit that lifts early is picked up on an idle box too and not only when other traffic happens by — cc-limit prints waits in the hundreds of minutes, and nothing on this box runs `work` on a clock. A job whose lane is running, or was just spawned (`skip`), is not waited on here: that lane re-reads the queue and arms its own wake when it ends."""
    now, waits = time.time(), []
    for p in glob.glob(f"{LANDQ}/*.json"):
        j = read_json(p) or {}
        if not j.get("repo"):
            continue
        if j["repo"] in skip or sweep_running(j["repo"]):
            continue    # its lane is running (or was just spawned, `skip`) and arms its own wake when it ends
        if box_hold(j):
            continue    # a parked or tier-held job wants running at no time: `cc-pause off` or `cc-tier set` re-drives it
        nb = epoch_of(j.get("not_before", ""))
        if nb <= now:
            waits.append(RETRY_AFTER if j.get("attempts") else 5)
        elif j.get("stage") == "deferred" and j.get("limit_src") == "cc-limit":
            waits.append(min(nb - now + 60, RETRY_AFTER))    # …only the bookings the re-ask can end early: every
        else:                                                # other wait keeps its one timer, and costs its one sweep
            waits.append(nb - now + 60)
    return int(min(waits)) if waits else None


def rearm(secs):
    """Arm one transient timer for when the earliest kept or deferred job is wanted (spawn_work); nothing else runs `work` on a clock. Two sweeps arming for one job are two cheap sweeps, not two landings. Returns one line."""
    when = f"{secs // 60}m" if secs >= 60 else f"{secs}s"
    how, why = spawn_work(secs)
    if not how:
        return f"cc-land: a job was kept, but nothing could be armed to re-drive it ({why}) — `cc-land work` runs it"
    return (f"cc-land: a job was kept — the queue runs itself again in {when}"
            + (" (a detached child; no systemd --user)" if how.startswith("a detached") else ""))


def queue_order(paths):
    """The queue oldest `queued_at` first, never file-name order: the order a lane takes its repo's jobs in, and the order `work` starts the lanes in (by each repo's oldest job). A job with no readable `queued_at` sorts after everything stamped, by path; ties fall back to the path."""
    def key(p):
        at = epoch_of((read_json(p) or {}).get("queued_at", ""))
        return (0, at, p) if at else (1, 0, p)
    return sorted(paths, key=key)


def lane_dir():
    """Where the lanes' flocks and markers live, derived from LANDQ at call time like root_dir()."""
    return f"{LANDQ}/lanes"


def lane_file(repo, ext):
    return f"{lane_dir()}/{re.sub(r'[^A-Za-z0-9._-]+', '-', repo)}.{ext}"


def sweep_running(repo):
    """The lane landing `repo` now, as its `since` stamp, or ''. Read from the marker run_lane writes under the lane's flock, never by probing the flock (a lane that loses it stands down); a dead pid means no lane."""
    j = read_json(lane_file(repo, "running")) or {}
    pid, since = j.get("pid"), j.get("since") or ""
    if not isinstance(pid, int) or pid <= 0 or not since:
        return ""
    try:
        os.kill(pid, 0)
    except OSError:
        return ""       # ProcessLookupError, or a pid reused by another user: either way ours is not running
    return since


def queue_place(path, running):
    """Where this job stands in its repo's lane and which run of it reaches it, as one line, or '' if it is not on the queue. `running` is sweep_running(repo) read before start_worker; a running lane re-reads the queue after each landing, so it takes the job itself."""
    repo = (read_json(path) or {}).get("repo") or ""
    order = [p for p in queue_order(glob.glob(f"{LANDQ}/*.json")) if (read_json(p) or {}).get("repo") == repo]
    try:
        n = order.index(path) + 1
    except ValueError:
        return ""
    suffix = "th" if 11 <= n % 100 <= 13 else {1: "st", 2: "nd", 3: "rd"}.get(n % 10, "th")
    return (f"{n}{suffix} of {len(order)} in the {repo} lane, oldest first — other repos land beside it"
            + (f"; the {repo} lane has been running since {running} and takes it once the landing it is on ends"
               if running else ""))


def lane_jobs(repo):
    """This repo's job files, oldest first."""
    return queue_order([p for p in glob.glob(f"{LANDQ}/*.json") if (read_json(p) or {}).get("repo") == repo])


# ── the batch: ordinary PRs land together, and the suite runs on the base once ───────────────────────
def ready_job(job):
    """Whether a PR job could be tried NOW, off the file alone: the same doors run_one asks, without the lock."""
    fix = job.get("fix") or {}
    return bool(job.get("pr")) and job.get("state") != "done" and not (fix and fix.get("over") is None) \
        and not (stamp() < (job.get("not_before") or "")) and job.get("attempts", 0) < LAND_TRIES \
        and not box_hold(job)


def batch_of(repo, paths):
    """The batch a lane run takes from its repo's queue (`paths`, oldest first): the ordinary, ready jobs whose files are pairwise disjoint, up to BATCH_MAX, as [(path, job, files)] in queue order. A job that is not ordinary is marked so on its file (`ordinary`: why) and left to the serial path, and once marked it is not asked again this queue life; one that overlaps a member ahead of it waits for the next batch, and is gated on the base that batch left. [] unless OPTIMISTIC."""
    if not OPTIMISTIC:
        return []
    taken, held = [], set()
    for p in paths:
        job = read_json(p) or {}
        if not ready_job(job) or job.get("ordinary"):
            continue
        why, files = ordinary(repo, job["pr"])
        if why:
            ledger(f"serial {repo}#{job['pr']} — {why}")
            job_set(p, job, ordinary=why)
            continue
        if held & set(files):
            ledger(f"waits {repo}#{job['pr']} — overlaps the batch ahead of it in "
                   f"{', '.join(sorted(held & set(files))[:3])}; the next batch takes it")
            continue
        taken.append((p, job, files))
        held |= set(files)
        if len(taken) >= BATCH_MAX:
            break
    return taken


def spawn_warm(repo, pr, log, path):
    """One warm as a process of its own: this tool again, `<repo> <pr> --warm`, its output to `log`, its outcome written by itself on the job at `path` (warm_done). The seam warm_all runs its members through."""
    return subprocess.Popen([sys.executable, os.path.realpath(__file__), repo, str(pr), "--warm"],
                            stdin=subprocess.DEVNULL, stdout=open(log, "w"), stderr=subprocess.STDOUT, cwd=HOME)


def warm_all(repo, batch):
    """Phase 1: every member's warm — `<this> <repo> <pr> --warm`: the worker's green, the static gates on the merge, the read beside them, no merge — WARM_SLOTS at a time, each a process of its own (spawn_warm) whose output is a log under the run root, its outcome written on the job by the warm itself (warm_done). Returns one line per member. A warm that will not start, or dies without writing, leaves the job unwarmed, and the merge pass runs its gates as they always were."""
    lines, running, todo = [], [], list(batch)
    while todo or running:
        while todo and len(running) < WARM_SLOTS:
            path, job, _ = todo.pop(0)
            log = f"{run_root()}/warm-{repo}-{job['pr']}.log"
            try:
                p = spawn_warm(repo, job["pr"], log, path)
            except OSError as e:
                lines.append(f"[{repo}] PR #{job['pr']}: the warm would not start ({e}) — its gates run at the merge pass")
                continue
            running.append((p, path, job, log))
        still = []
        for p, path, job, log in running:
            if p.poll() is None:
                still.append((p, path, job, log))
                continue
            w = (read_json(path) or {}).get("warm") or {}
            lines.append(f"[{repo}] PR #{job['pr']}: warm " + ("passed" if w.get("ok") else
                         f"stopped at {w.get('stopped') or 'start'} — {(w.get('why') or last(open(log).read() if os.path.exists(log) else ''))[:200]}"))
        running = still
        if running:
            time.sleep(2)
    return lines


def suite_on(repo, sha, scope, step="suite"):
    """Every gate the base carries, on the base at `sha` in a throwaway checkout, handed `scope` (the batch's paths, or '' for everything): (ok, why, log) — why names the gate and the case that failed. The one suite an ordinary batch buys, and what the bisect asks of each commit."""
    L = Land(repo)
    L.head = sha
    tmp, tree = L.head_checkout(step, fetch=False, at=sha)
    try:
        found = [g for g in GATES if os.access(f"{tree}/{g}", os.X_OK)]
        if not found:
            return True, f"no gates in {repo}", ""
        content, reused = tree_id(tree), []
        errs = L.run_gates(tree, found, scope, content, reused)
        if errs:
            e = errs[next(g for g in found if g in errs)]
            m = re.search(r"\[full output: ([^\]]+)\]", str(e))
            return False, getattr(e, "short", "") or str(e), (m.group(1) if m else "")
        return True, f"{len(found)} gate(s) passed on {sha[:12]}" + (f" ({len(reused)} already green)" if reused else ""), ""
    finally:
        L.drop_checkout(tmp, tree)


def bisect_batch(repo, merged, scope, tip=""):
    """Which merge of `merged` ([(pr, sha, files)] in merge order) broke the base, as (kind, hit): ("pr", (pr, sha, files)) for the first red one by binary search over the commits themselves, each asked of suite_on — log2(n) runs; ("before", None) when the base was ALREADY red before the first of them (asked only when the first is red); ("after", None) when the LAST of them is green, so the red came from something merged after the batch. The last is always RUN, never assumed red — unless it IS `tip`, the commit the batch's suite already found red twice. Never a revert of a PR that broke nothing."""
    lo, hi, seen = 0, len(merged), {}
    if tip and merged[-1][1] == tip:
        seen[hi] = False

    def green_at(i):
        if i not in seen:
            sha = merged[i - 1][1] if i else f"{merged[0][1]}^"
            seen[i] = suite_on(repo, sha, scope, step="bisect")[0]
            ledger(f"bisect {repo} {sha[:12]} ({'before the batch' if not i else 'PR #' + str(merged[i - 1][0])}): "
                   f"{'green' if seen[i] else 'red'}")
        return seen[i]

    if green_at(hi):
        return "after", None
    while hi - lo > 1:
        mid = (lo + hi) // 2
        if green_at(mid):
            lo = mid
        else:
            hi = mid
    if hi == 1 and not green_at(0):
        return "before", None
    return "pr", merged[hi - 1]


def is_ancestor(root, a, b):
    """`git merge-base --is-ancestor a b`: True only on git's own yes. An object this checkout does not have, or any error, is a no."""
    return bool(a) and bool(b) and sh(["git", "merge-base", "--is-ancestor", a, b], cwd=root, timeout=60)[0] == 0


def base_tip(repo):
    """origin/<default branch>'s SHA, fetched now, or '' when git would not say."""
    root, base = repo_root(repo), (board(repo).get("default_branch") or "main")
    with git_lock(root):
        sh(["git", "fetch", "-q", "origin", base], cwd=root, timeout=120)
        rc, o = sh(["git", "rev-parse", f"origin/{base}"], cwd=root)
    return o.strip() if not rc else ""


def batch_merged(repo, before, members, skip=()):
    """What this batch PROVABLY put on the default branch, as [(pr, sha, files)] in merge order: `members` ([(pr, files)] in the order they were merged) asked of gh, each kept only when it is MERGED into the default branch with a single-parent squash commit that descends from the one before it (`before`, the tip read before the batch, for the first) and is on origin's tip now. A PR in `skip` (merged before this pass) is never one. Only what this returns is bisected and can be reverted, so the auto-revert can never apply the inverse of a commit that is off main, older than the batch or not the batch's."""
    root, base = repo_root(repo), (board(repo).get("default_branch") or "main")
    tip = base_tip(repo)
    merged, prev = [], before
    if not before or not tip:
        return merged
    for pr, files in members:
        if pr in skip:
            continue
        j = pr_facts(root, pr, "state,mergeCommit,baseRefName", timeout=60)[0] or {}
        sha = ((j.get("mergeCommit") or {}).get("oid") or "").strip()
        if j.get("state") != "MERGED" or not sha:
            continue
        parents = sh(["git", "rev-list", "--parents", "-n", "1", sha], cwd=root, timeout=60)[1].split()
        if ((j.get("baseRefName") or "") != base or sha == prev or len(parents) != 2
                or not is_ancestor(root, prev, sha) or not is_ancestor(root, sha, tip)):
            ledger(f"batch-skip {repo}#{pr} sha={sha[:12]} — not a squash on {base} after {prev[:12]}: left out of the "
                   f"batch's suite, never bisected, never reverted")
            continue
        merged.append((pr, sha, files))
        prev = sha
    return merged


def batch_path(repo):
    """Where a batch notes what it is merging while it runs — the tip it began on, its members, the ones merged before it began — so a lane that dies between the merges and the suite leaves the next pass enough to run that suite (resume_batch). Not `.json`: the queue's glob must never read it as a job."""
    return f"{LANDQ}/{repo}.batch"


def resume_batch(repo):
    """A batch record the lane holding the lock did not write is a batch whose lane died before its suite ran on the base: run it now, on what that batch provably merged (batch_merged), and SAY it was cut off. Returns its lines; the record goes once after_batch has spoken."""
    path = batch_path(repo)
    rec = read_json(path)
    if not isinstance(rec, dict):
        with contextlib.suppress(OSError):
            os.unlink(path)
        ledger(f"batch-lost {repo} — its record could not be read; the catch-up deploys the tip as for any merge")
        return [f"[{repo}] a batch's record could not be read — dropped; the catch-up handles the tip"]
    members = [(int(m[0]), list(m[1])) for m in rec.get("members") or []]
    if not members:
        # Cut off before its first merge began: nothing of it is on the base, and nothing is owed but the note.
        with contextlib.suppress(OSError):
            os.unlink(path)
        ledger(f"batch-dropped {repo} {rec.get('bid', '?')} — cut off before any merge; its jobs are still queued")
        return []
    prs = ", ".join(f"#{pr}" for pr, _ in members)
    text = (f"[{repo}] the batch {rec.get('bid', '?')} ({prs}) was cut off before its suite ran on "
            f"{board(repo).get('default_branch') or 'main'} — the lane died. Running that suite now")
    ledger(f"batch-resume {repo} {rec.get('bid', '?')} prs={prs}")
    sh([f"{BIN}/cc-slack", "inject", repo, text[:300]], timeout=120)   # the seat's wake; the suite's outcome is said by after_batch
    lines = [text]
    for pr, _ in members:
        # A member still queued (cut off mid-merge, or kept) lands next on its own: every gate and its own deploy,
        # never the dead batch's warm and deferred deploy.
        jp = job_path(repo, pr)
        j = read_json(jp)
        if j and ("batch" in j or "warm" in j):
            j.pop("batch", None); j.pop("warm", None)
            with contextlib.suppress(OSError):
                write_atomic(jp, j)
    merged = batch_merged(repo, rec.get("before") or "", members, skip=set(rec.get("pre") or []))
    lines += after_batch(repo, merged)
    with contextlib.suppress(OSError):
        os.unlink(path)
    return lines


def revert_pr(repo, pr, sha, why):
    """Take PR `pr`'s squash `sha` back off the base — `git revert` in a throwaway checkout of the tip, pushed to the base — and SAY SO: on the PR (one comment), in the PR's track thread when it has one (else the repo's stopped route), to the repo's seat (inject), and in the queue log. Brief: "a revert is automatic and announced, never silent". Returns the revert's SHA, or '' when the revert could not be made (a conflict, a refused push), which is said the same ways."""
    L = Land(repo)
    root, base = L.root, L.base()
    with git_lock(root):
        sh(["git", "fetch", "-q", "origin", base], cwd=root, timeout=120)
        rc, o = sh(["git", "rev-parse", f"origin/{base}"], cwd=root)
    tip = o.strip() if not rc else ""
    L.head, L.pr = tip, pr
    made, said = "", ""
    if tip and not is_ancestor(root, sha, tip):
        # batch_merged already kept only squashes on the base; asked again at the tip the revert is built on, since
        # the inverse of a commit that is not there would be a change nobody made, pushed to the base.
        said, tip = f"its squash {sha[:12]} is not on origin/{base} at {tip[:12]}, so there is nothing of it to revert", ""
    elif not tip:
        said = f"origin/{base} could not be read"
    if tip:
        tmp, tree = L.head_checkout("revert", fetch=False, at=tip)
        try:
            rc, o = sh(["git", "revert", "--no-edit", sha], cwd=tree, timeout=300)
            if rc:
                said = f"git could not revert it cleanly ({last(o, 120)})"
            else:
                rc, o = sh(["git", "push", "-q", "origin", f"HEAD:refs/heads/{base}"], cwd=tree, timeout=300)
                if rc:
                    said = f"the push of the revert to {base} was refused ({last(o, 120)})"
                else:
                    made = sh(["git", "rev-parse", "HEAD"], cwd=tree)[1].strip()
        finally:
            L.drop_checkout(tmp, tree)
    what = f"[{repo}] PR #{pr}"
    text = (f"{what}: REVERTED ❌ — the suite on {base} went red after this batch merged and the bisect names this "
            f"PR: {why}. Its squash {sha[:12]} is reverted in {made[:12]}; the branch is gone, so open a new PR "
            f"with the fix, off {base} as it is now."
            if made else
            f"{what}: the suite on {base} went red after this batch merged and the bisect names this PR ({why}), "
            f"but the revert did not happen — {said}. {base} is red until a person reverts {sha[:12]} or fixes it.")
    ledger(f"{'reverted' if made else 'revert-failed'} {repo}#{pr} sha={sha[:12]}"
           + (f" by={made[:12]}" if made else f" — {said}") + f" — {why[:200]}")
    sh(["gh", "pr", "comment", str(pr), "--body", text], cwd=root, timeout=120)
    tt = track_thread_of(repo, pr)
    pid = f"land:{repo}:{pr}:reverted@{stamp()}"
    notify(*(["--route", f"{tt} stopped"] if tt else ["--route", f"{what} stopped"]), "--id", pid, text, timeout=60)
    sh([f"{BIN}/cc-slack", "inject", repo, f"{what} was {'reverted' if made else 'NOT reverted'} after the batch's "
                                            f"suite went red on {base}: {why[:160]}"], timeout=120)
    return made


def after_batch(repo, merged):
    """Phase 3, once per batch: ONE suite on the base, at its tip, scoped to the batch's paths when they fit WIDE_FILES (else everything). Green: the deploy the members skipped (deploy_due, run here). Red: believed on a second run only, then bisected to the merge that broke it (bisect_batch), that PR reverted and announced (revert_pr), and the suite run once more on what is left; still red, or a red the batch did not make, is SAID, the tip is noted for the catch-up to leave alone (red_base_path), and nothing is installed. Returns its lines."""
    lines = []
    if not merged:
        return lines
    L = Land(repo)
    root, base = L.root, L.base()
    with git_lock(root):
        sh(["git", "fetch", "-q", "origin", base], cwd=root, timeout=120)
        rc, o = sh(["git", "rev-parse", f"origin/{base}"], cwd=root)
    tip = o.strip() if not rc else ""
    if not tip:
        return [f"[{repo}] batch: origin/{base} could not be read after the merges — nothing installed; the catch-up deploys it"]
    files = sorted({p for _, _, fs in merged for p in fs})
    scope = " ".join(files) if len(files) <= WIDE_FILES else ""
    prs = ", ".join(f"#{pr}" for pr, _, _ in merged)
    ledger(f"batch-suite {repo} tip={tip[:12]} prs={prs} scope={'all' if not scope else len(files)}")
    ok, why, log = suite_on(repo, tip, scope)
    if not ok:
        ok, why2, log = suite_on(repo, tip, scope, step="suite2")    # a red is believed on the second run only
        why = why2 if not ok else why
    if not ok:
        lines.append(f"[{repo}] batch ({prs}): the suite on {base} at {tip[:12]} is red twice — {why}; bisecting")
        kind, hit = bisect_batch(repo, merged, scope, tip=tip)
        if kind != "pr":
            write_atomic(red_base_path(repo), {"tip": tip, "at": stamp(), "why": why})
            if kind == "before":
                text = (f"[{repo}] {base} was already red before this batch ({prs}) merged — {why}. Nothing "
                        f"reverted, nothing installed: the box runs the old code until a person mends {base}.")
            else:
                text = (f"[{repo}] {base} is red at {tip[:12]}, but green at {merged[-1][1][:12]}, the last merge of "
                        f"this batch ({prs}): the red came from something merged after it — {why}. Nothing "
                        f"reverted, nothing installed: the box runs the old code until a person mends {base}.")
            ledger(f"batch-red {repo} tip={tip[:12]} {kind}-batch — {why[:200]}")
            notify("--route", f"[{repo}] batch stopped", "--id", f"land:{repo}:batch:red@{tip[:12]}", text, timeout=60)
            sh([f"{BIN}/cc-slack", "inject", repo, text[:300]], timeout=120)
            return lines + [text]
        pr, sha, _ = hit
        made = revert_pr(repo, pr, sha, why)
        lines.append(f"[{repo}] PR #{pr} broke {base} ({why[:120]}) — " + (f"reverted in {made[:12]}" if made else "the revert did not happen"))
        if made:
            ok, why, log = suite_on(repo, made, scope, step="suite3")
            tip = made
        if not ok:
            write_atomic(red_base_path(repo), {"tip": tip, "at": stamp(), "why": why})
            text = (f"[{repo}] {base} is still red at {tip[:12]} after the batch ({prs}) and the revert of "
                    f"PR #{pr} — {why[:160]}. Nothing installed: the box runs the old code until a person mends it.")
            ledger(f"batch-red {repo} tip={tip[:12]} after-revert — {why[:200]}")
            notify("--route", f"[{repo}] batch stopped", "--id", f"land:{repo}:batch:red@{tip[:12]}", text, timeout=60)
            sh([f"{BIN}/cc-slack", "inject", repo, text[:300]], timeout=120)
            return lines + [text]
    with contextlib.suppress(OSError):
        os.unlink(red_base_path(repo))
    lines.append(f"[{repo}] batch ({prs}): the suite on {base} at {tip[:12]} is green — {why}; installing")
    path = deploy_due(repo, by=f"the batch {prs}")
    if path:
        lines.append(run_one(path))
    return lines


def land_batch(repo, batch):
    """One batch, three phases: the warms side by side (warm_all); the merges one at a time in queue order, each a run_one that spends its warm (spend_warm) and skips the deploy; then after_batch, on what batch_merged proves this pass put on the base. A member whose warm found it not ordinary is left on the queue for the serial path — this lane run's next look takes it. The tip before the batch, its members and the ones already merged before it are written to batch_path first, so a lane that dies before after_batch leaves the next pass what it needs (resume_batch). Returns its lines."""
    bid = stamp()
    before = base_tip(repo)
    if not before:
        # No tip to prove the merges against, so nothing this batch merged could be bisected or reverted: every
        # member goes to the serial path, every gate before its merge.
        for path, job, _ in batch:
            job_set(path, read_json(path) or job, ordinary="the base's tip could not be read before the batch")
        return [f"[{repo}] batch: origin could not name the base's tip — its members land one at a time, every gate first"]
    ledger(f"batch {repo} {bid} before={before[:12]} prs={','.join(str(j['pr']) for _, j, _ in batch)} warms={WARM_SLOTS}")
    rec = {"bid": bid, "before": before, "pid": os.getpid(), "members": [], "pre": []}
    write_atomic(batch_path(repo), rec)
    lines = warm_all(repo, batch)
    for path, job, files in batch:
        job = read_json(path) or {}
        if not job or (job.get("warm") or {}).get("stopped") == "warm":
            continue                          # not ordinary after all: the serial path's, not the batch's
        if (pr_facts(repo_root(repo), job["pr"], "state", timeout=60)[0] or {}).get("state") == "MERGED":
            rec["pre"].append(job["pr"])      # merged before this pass: not the batch's to bisect or revert
        rec["members"].append([job["pr"], files])
        write_atomic(batch_path(repo), rec)   # …noted BEFORE the merge, so a death mid-merge still finds it
        job_set(path, job, batch=bid)
        lines.append(run_one(path))
        left = read_json(path)
        if left is not None:
            # Kept (a retry, a hold, a fix round): the batch and its warm were THIS pass's, and the serial landing
            # that takes it next must gate and deploy it itself — a batch mark left on would skip both.
            left.pop("batch", None); left.pop("warm", None)
            with contextlib.suppress(OSError):
                write_atomic(path, left)
    merged = batch_merged(repo, before, [(pr, fs) for pr, fs in rec["members"]], skip=set(rec["pre"]))
    lines += after_batch(repo, merged)
    with contextlib.suppress(OSError):
        os.unlink(batch_path(repo))
    return lines


def run_lane(repo):
    """Land `repo`'s jobs one at a time, oldest first, under the repo's own flock, re-reading the queue after each so a job queued meanwhile is taken now and not by the next sweep. A job is run once per lane run (keyed by path and queued_at: a kept job waits for its wake, a re-queued one is new). Returns its lines; a lane that finds the flock held stands down, since the holder re-reads the same queue."""
    os.makedirs(lane_dir(), exist_ok=True)
    # Every lane holds the queue's old whole-queue flock SHARED: a worker from before the lanes takes it EXCLUSIVE, so
    # the one running when this change deploys finishes its list alone, and never beside a lane of the same repo.
    whole = open(f"{LANDQ}/.lock", "w")
    try:
        fcntl.flock(whole, fcntl.LOCK_SH | fcntl.LOCK_NB)
    except OSError:
        whole.close()
        return ["cc-land: a worker from before the lanes holds the whole queue — it lands what is in it, and its "
                "rearm starts the lanes after it"]
    try:
        return _run_lane(repo)
    finally:
        fcntl.flock(whole, fcntl.LOCK_UN)
        whole.close()


def _run_lane(repo):
    """run_lane under the shared queue lock."""
    lines, seen = [], set()

    def key(p):
        return p, (read_json(p) or {}).get("queued_at", "")

    def todo():
        # A batch member whose warm found it not ordinary keeps its key in `seen`; its `ordinary` mark is what the
        # next look reads, so it is taken again here — serially, every gate first — and not spun on.
        return [p for p in lane_jobs(repo) if key(p) not in seen
                or ((read_json(p) or {}).get("ordinary") and key(p) in seen_batch)]

    seen_batch = set()

    while True:
        lock = open(lane_file(repo, "lock"), "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            lock.close()
            return lines or [f"cc-land: the {repo} lane is already running — it lands what is queued, so this one "
                             f"stands down"]
        marker = lane_file(repo, "running")
        with contextlib.suppress(OSError):       # the marker answers a question; it never stops a landing
            write_atomic(marker, {"pid": os.getpid(), "since": stamp()})
        try:
            if os.path.exists(batch_path(repo)):
                lines += resume_batch(repo)      # this lane holds the lock, so the batch that wrote it is dead
            while True:
                left = todo()
                if not left:
                    break
                batch = batch_of(repo, left)
                if len(batch) >= 2:
                    # Two or more ordinary jobs ready: they land together (land_batch). One alone lands as it
                    # always did — its suite runs before its merge, and a red there is a stop and not a revert.
                    seen.update(key(p) for p, _, _ in batch)
                    seen_batch.update(key(p) for p, _, _ in batch)
                    lines += land_batch(repo, batch)
                    continue
                seen.add(key(left[0]))
                seen_batch.discard(key(left[0]))   # a demoted member, once run serially, is not looked at again
                lines.append(run_one(left[0]))
        finally:
            with contextlib.suppress(OSError):
                os.unlink(marker)                # this lane is over before the lock it held is
            fcntl.flock(lock, fcntl.LOCK_UN)
            lock.close()
        if not todo():      # a job queued between the last look and the unlock found the lane held: look once more
            return lines


def refuse(msg, rc=2):
    """`return refuse("…")`: the one line on stderr a command says no with, and the exit code it hands back."""
    print(f"cc-land: {msg}", file=sys.stderr)
    return rc


def cmd_work(argv):
    """Drain the queue, one lane per repo, then catch the box up. `work --lane <repo>` is one lane (run_lane); bare `work` sweeps, runs the lane of the repo whose job is oldest itself and spawns a lane for each other repo with a job — so repos land side by side, and one repo's landings stay one at a time, each gated on the base the one before it left."""
    if "--detach" in argv:
        ok, how = start_worker()
        print(f"cc-land: worker started ({how})" if ok else f"cc-land: the worker would not start: {how}",
              file=sys.stdout if ok else sys.stderr)
        return 0 if ok else 1
    os.makedirs(LANDQ, exist_ok=True)
    lines, spawned = [], set()
    if "--lane" in argv:
        i = argv.index("--lane") + 1
        repo = argv[i] if i < len(argv) else ""
        if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", repo):
            return refuse("work --lane takes one repo name")
        lines += run_lane(repo)
    else:
        sweep_records()
        sweep_run_roots()                        # what a killed or rebooted worker left in the temp root (live lanes' are kept)
        repos = []
        for path in queue_order(glob.glob(f"{LANDQ}/*.json")):
            repo = (read_json(path) or {}).get("repo")
            if not repo:
                lines.append(run_one(path))      # not a job: moved aside here, it has no lane
            elif repo not in repos:
                repos.append(repo)
        for path in sorted(glob.glob(f"{LANDQ}/*.batch")):
            repo = os.path.basename(path)[:-len(".batch")]
            if re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", repo) and repo not in repos:
                repos.append(repo)               # a batch cut off before its suite: its lane runs that suite (resume_batch)
        mine = []
        for repo in repos:
            if sweep_running(repo):
                continue                         # its lane re-reads the queue itself
            if not mine or all(box_hold(read_json(p) or {}) for p in lane_jobs(repo)):
                mine.append(repo)                # the oldest job's lane runs here: this process is already paid for,
                continue                         # and so does a lane that only says its jobs are held
            how, why = spawn_work(lane=repo)
            if how:
                spawned.add(repo)
                lines.append(f"cc-land: the {repo} lane started beside this one ({how})")
            else:
                mine.append(repo)                # never dropped: run here, after the others
                lines.append(f"cc-land: the {repo} lane would not start ({why}) — run here after the rest")
        for repo in mine:
            lines += run_lane(repo)              # every sweep: this is what finishes a landing a reboot interrupted
        if "--catch-up" in argv or due_catchup():
            for repo in catchup():
                lines += run_lane(repo)
    wake = next_wake(spawned)
    if wake is not None:
        lines.append(rearm(wake))
    for x in lines:
        if x:
            print(x)
    if not lines:
        print("cc-land: nothing queued, and nothing has landed behind this box's back")
    return 0


def queue_task(argv):
    """Complete a task as the host (`cc done --json`) and queue its PR when `cc lands` grants it; the receipt goes to stdout, human output to stderr."""
    if len(argv) != 2 or not all(re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", a) for a in argv):
        return refuse("queue --task takes <repo> <row>")
    repo, row = argv
    rc, out = sh([f"{BIN}/cc", "done", repo, row, "--json"], timeout=900, stdout_only=True)
    try:
        rec = json.loads(out)
        if (not isinstance(rec, dict) or not rec.get("task_id") or not isinstance(rec.get("errors"), list)
                or not all(isinstance(e, dict) for e in rec["errors"])
                or not isinstance(rec.get("pending"), dict) or not isinstance(rec.get("pr_url") or "", str)
                or not isinstance(rec.get("card") or {}, dict)):
            raise ValueError("not a completion receipt")
    except ValueError:
        return refuse(f"queue --task needs a task record and a completion receipt for {repo}/{row} (rc {rc})", 1)
    grant, _ = sh([f"{BIN}/cc", "lands", repo])
    url = rec.get("pr_url")
    pr = re.fullmatch(r"https://[^/\s]+/[^/\s]+/[^/\s]+/pull/([0-9]+)", url or "")
    status, message, result = "approval", "It's waiting for your 👍 on the approval card.", 0
    if grant == 2:
        status, message, result = "refused", ("The repo belongs to a member, so the box won't land it. "
                                              "Someone has to merge it by hand."), 2
    elif grant not in (0, 1):
        status, message, result = "failed", "Nothing is queued, because the box could not read whether this project lands its own PRs.", 1
    elif url and not pr:
        status, message, result = "failed", ("Nothing is queued, because the link the worker recorded isn't a "
                                             "GitHub pull request."), 1
    elif not pr or rec.get("closed"):
        status, message = "none", "No PR is open for it, so there is nothing to land."
        result = int(any(e.get("stage") in ("commit", "push", "pr") for e in rec["errors"]))
    elif grant == 0:
        card = rec.get("card") or {}
        args = [f"{repo}--{row}" if member_of(repo)[0] else repo, pr[1], "--who", "cc done"]
        if card.get("chat") and card.get("ts"): args += ["--chat", card["chat"], "--ts", card["ts"]]
        with contextlib.redirect_stdout(sys.stderr): result = cmd_queue(args)
        status = "queued" if result == 0 else "failed"
        message = "It's queued to land, no 👍 needed." if result == 0 else "The PR is open, but the landing queue would not take it."
    rec["landing"] = {"status": status, "message": message}
    if rec.get("pending"):
        ledger(f"delivery-pending {repo}/{row} pr={url or '-'} projections={','.join(rec['pending'])}")
    print(message, file=sys.stderr)
    print(json.dumps(rec))
    return result


def split_opts(argv, *names):
    """(positionals, {--opt: value}) for the `--opt value` pairs among `names`; anything else, a bare flag included, is positional."""
    pos, opts, rest = [], {}, list(argv)
    while rest:
        a = rest.pop(0)
        if a in names and rest:
            opts[a] = rest.pop(0)
        else:
            pos.append(a)
    return pos, opts


def cmd_queue(argv):
    """Put a PR on the queue and start the worker (what a 👍 does); a non-zero exit means nothing has merged and nothing will until somebody acts. A doomed job is refused here in about a second, with the commands that end it."""
    if argv and argv[0] == "--task": return queue_task(argv[1:])
    pos, opts = split_opts(argv, "--chat", "--ts", "--who", "--approved-by")
    start = "--no-start" not in pos
    pos = [a for a in pos if a != "--no-start"]
    if len(pos) > 2:
        return refuse(f"queue: unexpected '{pos[2]}'")
    (repo, pr), (chat, ts, who, approved_by) = (pos + ["", ""])[:2], (opts.get(k, "") for k in ("--chat", "--ts", "--who", "--approved-by"))
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", repo or "") or not re.fullmatch(r"[0-9]+", pr or ""):
        return refuse("queue takes <repo> <pr-number> [--chat C… --ts 1788… --who name --approved-by U…]")
    path = job_path(repo, pr)
    handle, mtrack = member_of(repo)
    if handle and not mtrack:
        return refuse(f"{repo} is a member workspace — its projects land as <handle>--<track> (the track that "
                      f"carries the PR), never the workspace itself")
    if handle:
        # A member project lands out of a host-only clone of its repository on the workspace's own token: the repository is checked (member_project_url) and the grant must exist before a job is written.
        if not member_token(handle):
            ledger(f"refused {repo}#{pr} no-token")
            return refuse(f"{handle} is granted no GitHub token (cc-sandbox github {handle}) — nothing can land for it", 1)
        url, why = member_project_url(handle, mtrack, pr)
        if not url:
            ledger(f"refused {repo}#{pr} not-its-repository")
            return refuse(f"PR #{pr} is not queued — {why}", 1)
        root, why = member_clone(repo, url)
        if not root:
            ledger(f"refused {repo}#{pr} no-clone")
            return refuse(f"PR #{pr} is not queued — {why}", 1)
    if os.path.exists(path):
        print(f"[{repo}] PR #{pr} is already queued — one job per PR, so two 👍 are still one landing")
        ledger(f"again {repo}#{pr}")
    else:
        # PROTECTED PATHS (the owner, #lessons 2026-09-18: "make sure lesson sessions, etc cant edit the fetcher"): a PR that
        # touches one is never landed on the box's own say-so — not by the standing grant, not by a member's 👍, whatever
        # the gates and the review would say. It is refused HERE, so no job exists — and the refusal raises the 🔐 card
        # his 👍 queues it from (say_protected_door), because the PR's own card may be in the log lane, where no
        # reaction does anything: only the owner's own 👍 queues it (owner_approved), and it has to have somewhere to go.
        hit, approved_head = protected_hit(repo, pr), ""
        if hit and not owner_approved(approved_by):
            ledger(f"refused {repo}#{pr} protected:{hit[0]}")
            say_protected_door(repo, pr, hit)
            return refuse(f"PR #{pr} is not queued — it touches {hit[0]}, under {repo}'s PROTECTED path {hit[1]} "
                          f"(CC_PROTECTED_PATHS_{repo}). The box never lands one of these on its own, whatever the gates "
                          f"and the review say: only the owner's own 👍 on the 🔐 card in #approvals queues it", 1)
        if hit:
            # His 👍 is about THIS head and no other, so the head is pinned on the job beside his uid and the pair
            # is re-asked at every head after it (protected_stop). A head gh will not name pins nothing.
            approved_head = pr_head(repo, pr)
            if not approved_head:
                ledger(f"refused {repo}#{pr} protected:{hit[0]}")
                return refuse(f"PR #{pr} is not queued — it touches {hit[0]}, under {repo}'s PROTECTED path "
                              f"{hit[1]}, and gh cannot say what head the 👍 is about, so nothing can hold the "
                              f"approval to one", 1)
        # At the door, before a job file exists: doomed() re-asks GitHub in one call and answers '' for every uncertainty.
        why = doomed(repo, pr)
        if why:
            ledger(f"refused {repo}#{pr} doomed")
            return refuse(f"PR #{pr} is not queued — it cannot succeed as it stands, and this was decided when it "
                          f"was asked for rather than after its gates:\n{why}", 1)
        try:
            write_atomic(path, {"repo": repo, "pr": int(pr), "chat": chat, "ts": ts, "who": who,
                                "approved_by": approved_by, "approved_head": approved_head,
                                "queued_at": stamp(), "attempts": 0, "stage": "queued"})
        except OSError as e:
            return refuse(f"cannot write {path}: {e} — nothing merged", 1)
        ledger(f"queued {repo}#{pr} who={who or '-'} chat={chat or '-'}")
        print(f"[{repo}] PR #{pr} queued — the gates run first, then the merge, then the deploy")
    # Where it stands and which run of its lane takes it (queue_place): the running lane is read before start_worker, or the lane this call starts reads as one already in flight.
    running = sweep_running(repo)
    # A 👍 on a parked project is kept, not refused: the job file is written, the worker is not started. Exit 0.
    if paused(repo):
        print(f"cc-land: {repo} is paused — nothing lands until `cc-pause off {repo}`, and this job waits for it")
        return 0
    place = queue_place(path, running)
    if not start:
        if place:
            print(f"cc-land: {place}. Nothing was started — `cc-land work` is the run it waits for")
        return 0
    ok, how = start_worker()
    if not ok:
        return refuse(f"queued, but the worker would not start ({how}) — nothing has merged. `cc-land work` runs it", 1)
    print(f"cc-land: worker started ({how})")
    if place:
        print(f"cc-land: {place}"
              + ("" if running else " — the lane just started is the one that takes it"))
    return 0


def cmd_record(argv):
    """`cc-land record <repo> <pr> <verdict> --by <who> [--head <sha>] [--findings <text>|-]`: write down a review that already happened, keyed on the change (change_digest) at the PR's current head (`--head` is checked, never used in its place). A standing verdict may only get stricter; a looser one is refused. It reviews, merges, gates and deploys nothing."""
    repo, rest = (argv[0] if argv else ""), argv[1:]
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", repo or "") or not rest:
        return refuse("record <repo> <pr> <verdict> --by <who> [--head <sha>] [--findings <text>|-]")
    if not re.fullmatch(r"[0-9]+", rest[0] or ""):
        return refuse(f"'{rest[0]}' is not a PR number")
    pr, rest = int(rest.pop(0)), rest
    verdict = rest.pop(0) if rest else ""
    if verdict not in REVIEW_VERDICTS:
        return refuse(f"'{verdict}' is not a verdict — one of {', '.join(REVIEW_VERDICTS)}")
    pos, opts = split_opts(rest, "--by", "--findings", "--head")
    if pos:
        return refuse(f"unexpected '{pos[0]}'")
    by, findings, head = (opts.get(k, "") for k in ("--by", "--findings", "--head"))
    if findings == "-":
        findings = sys.stdin.read().strip()
    if not by:
        # A verdict is somebody's: with no name it cannot be recorded.
        return refuse("record needs --by <who> — a verdict nobody signed is not one this box merges on")
    head = head.strip().lower()
    if head and not re.fullmatch(r"[0-9a-f]{7,40}", head):
        # Shorter than git's own shortest abbreviation, this would match heads it was never about.
        return refuse(f"'{head}' is not a commit — --head takes 7 to 40 hex characters")
    L = Land(repo, pr=pr)
    if not os.path.isdir(f"{L.root}/.git"):
        return refuse(f"{L.root} is not a git repo")
    if not L.load(verb="recording on"):
        return 1
    if (L.facts.get("state") or "").upper() == "MERGED":
        return refuse(f"PR #{pr} is already merged — a record guards the merge, and it has happened", 1)
    try:
        L.fetch_head()
    except Failed as e:
        return refuse(f"{e}", 1)
    # `--head` is the head the caller read: a mismatch with the PR's current head is refused, or one diff's answer would become another's pass.
    if head and not L.head.lower().startswith(head):
        return refuse(f"PR #{pr} is at {L.head[:12]} now, not {head[:12]} — the branch moved after that "
                      f"read, so it is a pass for a diff nobody is landing. Review the head that is there", 1)
    # A record already standing for this change: the same verdict is a no-op, said so; a stricter one supersedes it; a looser one is refused and names what stands. Reverse a stop by changing the diff, or land with --re-review.
    stands, supersedes = L.prior_review(), ""
    if stands:
        was, _said, who = stands
        if was == verdict:
            print(f"[{repo}] PR #{pr}: {verdict} is already recorded for this change by {who or 'this box'} — "
                  f"nothing to do")
            return 0
        if REVIEW_VERDICTS.index(verdict) < REVIEW_VERDICTS.index(was):
            return refuse(f"PR #{pr} already carries {was} for this change (by {who or 'this box'}); recording "
                          f"{verdict} over it would change what merges. Push the fix, or land with --re-review", 1)
        supersedes = was
    posted = L.post_review(verdict, findings or "No findings.", by=by, supersedes=supersedes)
    if posted != ", commented on the PR":
        # post_review not writing (the comment failed, or a record appeared between the read and this line) must never be reported as 'recorded'.
        return refuse(f"the record did not reach PR #{pr}{posted}", 1)
    key, mb = L.change_key()
    ledger(f"recorded {repo}#{pr} {verdict} by={re.sub(r'[^A-Za-z0-9._@-]+', '-', by)} "
           f"head={L.head[:12]} change={key[:12] or '-'} base={mb[:12] or '-'}"
           f"{f' over={supersedes}' if supersedes else ''}")
    print(f"[{repo}] PR #{pr}: {verdict} recorded by {by} for {L.head[:12]}{posted}"
          + (f" — it supersedes the {supersedes} that stood for this change, and the landing reads this one"
             if supersedes else " — the landing reads this instead of buying a review"))
    return 0


# ── selfcheck: the cases live in core/tests/cc-land-selfcheck.py and run in this namespace ──────────────
def cmd_selfcheck():
    """`cc-land selfcheck` runs core/tests/cc-land-selfcheck.py inside this module (its cases patch globals())."""
    src = os.path.join(os.path.dirname(BIN), "tests", "cc-land-selfcheck.py")
    exec(compile(open(src).read(), src, "exec"), globals())
    return globals()["selfcheck"]()


def main(argv):
    default_signals()                      # once, on the main thread: every gate and reviewer below inherits it
    cmd = {"selfcheck": lambda a: cmd_selfcheck(), "record": cmd_record, "queue": cmd_queue, "work": cmd_work}
    if argv[:1] != ["selfcheck"]:          # the selfcheck keeps its own fixture temp root
        use_scratch()
    if argv and argv[0] in cmd:
        return cmd[argv[0]](argv[1:])
    if len(argv) < 2 or argv[0].startswith("-"):
        print(__doc__.strip().split("\n\n")[1], file=sys.stderr)
        return 2
    repo, rest = argv[0], argv[1:]
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,63}", repo):
        return refuse(f"'{repo}' is not a repo name")
    review = "--no-review" not in rest      # the ONE way past the review gate, and it has to be typed
    re_review = "--re-review" in rest       # …and the ONE way to buy a second one for a head already reviewed
    full_gates = "--full-gates" in rest     # …and the ONE way past the scoping: every gate, whatever the diff is
    warm = "--warm" in rest                 # the batch's first pass: static gates and the read, no merge (warm_all)
    rest = [a for a in rest if a not in ("--no-review", "--re-review", "--full-gates", "--warm")]
    if not rest:
        return refuse("--no-review is not a landing on its own — name the PR too")
    if len(rest) != 1 or not re.fullmatch(r"[0-9]+", rest[0]):
        return refuse("the PR path takes one PR number and nothing else")
    land = Land(repo, pr=int(rest[0]), review=review, re_review=re_review, full_gates=full_gates)
    land.warm_only = warm
    if not os.path.isdir(f"{land.root}/.git"):
        return refuse(f"{land.root} is not a git repo")
    return land.run()


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    finally:
        drop_run_root()                        # the outermost finally: this run's scratch, whatever step it stopped at
