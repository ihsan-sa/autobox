#!/usr/bin/env python3
"""cc-land — the old name of the lander, kept so every caller keeps working. Each verb hands over to `lander`.

  cc-land queue <repo|handle--track> <pr> [--chat C --ts T --who W --approved-by UID --no-start --first]
                                    → lander queue …, every flag forwarded (the 👍 route, lessons' publish;
                                      --first puts the PR at the front of its lane, a planning seat's or the owner's)
  cc-land queue --task <repo> <row> → lander queue --task … (the JSON receipt cc-loop parses)
  cc-land <repo> <pr> [--no-review|--re-review|--full-gates]
                                    → lander queue <repo> <pr>. The three flags are gone with the old gates: a
                                      landing reads what the plan selects, and --no-review can no longer skip a read
  cc-land record <repo> <pr> <verdict> --by <who> [--head <sha>] [--findings TEXT|-]  → lander record …
  cc-land will-review <repo> <pr>   → lander will-review …
  cc-land work [--detach] [--catch-up] [--lane <repo>]
                                    → lander tick [--detach] [--repo <repo>]: resume lanes, poll handed PRs, retry
                                      deploys. --catch-up is what every tick does, so it adds nothing. With
                                      --detach the shim starts the tick in its own session, logging to
                                      <state>/tick.log, and returns at once: cc-slack's sweep kills its child
                                      after 120 s, and a tick may be mid-install by then
  cc-land times [--days N] [--repo R] → lander times …
  cc-land batch-suite …             → exit 0: there are no batches any more
  cc-land selfcheck                 → this shim's own cases; the lander's are `lander selfcheck`
  anything else                     → lander <the same words>

THE ROLLBACK. When ~/.cc/lander/legacy-on exists (`lander-self rollback --legacy`), every call runs the old
lander pinned there instead, unchanged; `lander-self promote` removes it. A legacy-on that does not resolve to a
directory under ~/.cc/lander/legacy/ is refused (exit 3), never followed: the link is the one thing that decides what
code runs every landing, so a link planted to point anywhere else must stop landings, not run. `current` is judged
the same way against ~/.cc/lander/releases/ before its lander package is imported.

AS A MODULE. `cc` and cc-publish's selfcheck load this file with SourceFileLoader, so it runs nothing on import
and keeps the names they call: protected_hit(repo, pr), protected_under(repo, hit), git_lock_path(root), and
GATES = () (the old gate list; the manifest holds the checks now). The first three come from the pinned release's
lander package when there is one, else from the lander package beside this file.
"""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
HOME = os.path.expanduser("~")
LROOT = os.path.join(HOME, ".cc", "lander")
LANDER = os.path.join(HERE, "lander")

GATES = ()


def pinned(link, kind):
    """(exists, target): whether LROOT/<link> exists, and the directory it resolves to when that is a directory
    under LROOT/<kind>/ — "" for a link that points anywhere else (planted), which callers refuse."""
    p = os.path.join(LROOT, link)
    if not os.path.lexists(p):
        return False, ""
    t, under = os.path.realpath(p), os.path.realpath(os.path.join(LROOT, kind))
    return True, (t if t.startswith(under + os.sep) and os.path.isdir(t) else "")


def _lander_pkg():
    """Import the `lander` package: the pinned release's (only when `current` is under releases/), else the one
    beside this file."""
    cur = pinned("current", "releases")[1]
    for d in ((os.path.join(cur, "core"),) if cur else ()) + (os.path.dirname(HERE),):
        if os.path.isfile(os.path.join(d, "lander", "cli.py")):
            if d not in sys.path:
                sys.path.insert(0, d)
            break
    import lander.lane as lane   # noqa: E402 — the path is set just above
    import lander.git as git
    import lander.jobs as jobs
    return lane, git, jobs


def protected_hit(repo, pr):
    """The first file PR `pr` changes under one of the repo's protected paths, as (file, rule), or None; ('?', why)
    when it cannot know (fail closed) — the same check `lander queue` refuses on."""
    lane, _, jobs = _lander_pkg()
    return lane.protected_hit(repo, jobs.repo_root(repo), pr)


def protected_under(repo, hit):
    """The hold's own words for a hit: the file and the rule it is under, or why it could not know."""
    return (f"it touches {hit[0]}, under {repo}'s PROTECTED path {hit[1]} (CC_PROTECTED_PATHS_{repo})"
            if hit[0] != "?" else f"{hit[1]}, and {repo} has PROTECTED paths")


def git_lock_path(root):
    """`.git/cc-land.lock` of the repo's main gitdir: the file the lander and cc-publish both lock."""
    _, git, _ = _lander_pkg()
    return git.git_lock_path(root)


def translate(argv):
    """Old argv -> (lander argv, or None when the shim answers itself with exit 0 and a line)."""
    if not argv:
        return ["--help"]
    cmd, rest = argv[0], argv[1:]
    if cmd in ("queue", "record", "will-review", "times"):
        return [cmd, *rest]
    if cmd == "work":
        out, it = ["tick"], iter(rest)
        for a in it:
            if a == "--detach":
                out.append("--detach")
            elif a == "--lane":
                out += ["--repo", next(it, "")]
            elif a == "--catch-up":
                continue
            else:
                out.append(a)
        return out
    if cmd == "batch-suite":
        return None
    pos = [a for a in rest if a not in ("--no-review", "--re-review", "--full-gates", "--warm")]
    if not cmd.startswith("-") and len(pos) == 1 and pos[0].isdigit():
        return ["queue", cmd, *pos]
    return [cmd, *rest]


def selfcheck():
    ok = []

    def case(name, cond):
        ok.append(bool(cond))
        if not cond:
            print(f"cc-land selfcheck: FAIL {name}")

    case("queue forwards every 👍 flag", translate(["queue", "r", "7", "--chat", "C", "--ts", "1.1", "--who", "W",
                                                     "--approved-by", "U"]) ==
         ["queue", "r", "7", "--chat", "C", "--ts", "1.1", "--who", "W", "--approved-by", "U"])
    case("queue --task forwards", translate(["queue", "--task", "r", "row"]) == ["queue", "--task", "r", "row"])
    case("lessons' bare queue forwards", translate(["queue", "lessons", "42"]) == ["queue", "lessons", "42"])
    case("the bare PR form queues", translate(["r", "7", "--no-review"]) == ["queue", "r", "7"])
    case("work --detach ticks detached", translate(["work", "--detach"]) == ["tick", "--detach"])
    case("work --lane ticks one repo", translate(["work", "--lane", "r"]) == ["tick", "--repo", "r"])
    case("work --catch-up is a tick", translate(["work", "--catch-up"]) == ["tick"])
    case("record forwards", translate(["record", "r", "7", "LAND", "--by", "x"]) ==
         ["record", "r", "7", "LAND", "--by", "x"])
    case("batch-suite answers itself", translate(["batch-suite", "r"]) is None)
    case("GATES is empty", GATES == ())
    case("protected_under words", "PROTECTED path p/" in protected_under("r", ("p/x", "p/")))
    try:
        p = git_lock_path("/nonexistent-root")
        case("git_lock_path answers", isinstance(p, str) and p.endswith(".lock"))
    except Exception as e:  # noqa: BLE001
        case(f"git_lock_path imports ({e})", False)
    import tempfile
    import time
    global LANDER
    with tempfile.TemporaryDirectory() as d:
        os.environ["CC_LANDER_STATE"] = d
        seen, keep = os.path.join(d, "argv"), LANDER
        LANDER = os.path.join(d, "lander")
        with open(LANDER, "w") as f:
            f.write(f"#!/bin/sh\necho \"$@\" > {seen}\nsleep 5\n")
        os.chmod(LANDER, 0o755)
        t0 = time.time()
        rc = detached(translate(["work", "--detach"]))
        case("work --detach returns before the tick ends", rc == 0 and time.time() - t0 < 3)
        for _ in range(50):
            if os.path.exists(seen):
                break
            time.sleep(0.1)
        case("…and the tick it started got `tick --detach`",
             os.path.exists(seen) and open(seen).read().split() == ["tick", "--detach"])
        with open(LANDER, "w") as f:
            f.write("#!/bin/sh\nexit 3\n")
        case("work --detach passes on the lander's exit 3", detached(translate(["work", "--detach"])) == 3)
        LANDER = keep
        del os.environ["CC_LANDER_STATE"]
    legacy_cases(case)
    bad = ok.count(False)
    print(f"cc-land selfcheck: {len(ok) - bad} passed, {bad} failed")
    return 1 if bad else 0


def legacy_cases(case):
    """The legacy-on branch of main(), run as a child with a HOME of its own: a legacy release runs with the same
    argv, and a legacy-on or a current planted outside ~/.cc/lander/<kind>/ is refused, never run."""
    import subprocess
    import tempfile
    with tempfile.TemporaryDirectory() as h:
        lr = os.path.join(h, ".cc", "lander")
        seen = os.path.join(h, "argv")
        for d in (os.path.join(lr, "legacy", "a" * 40, "core", "bin"), os.path.join(h, "evil", "core", "bin")):
            os.makedirs(d)
            with open(os.path.join(d, "cc-land"), "w") as f:
                f.write(f"import sys\nopen({seen!r}, 'w').write({d!r} + ' ' + ' '.join(sys.argv[1:]))\n")

        def run(*argv):
            if os.path.exists(seen):
                os.unlink(seen)
            env = {k: v for k, v in os.environ.items() if k != "CC_LANDER_STATE"}
            r = subprocess.run([sys.executable, os.path.realpath(__file__), *argv], env=dict(env, HOME=h),
                               capture_output=True, text=True, timeout=60)
            return r.returncode, open(seen).read() if os.path.exists(seen) else ""

        os.symlink(os.path.join(lr, "legacy", "a" * 40), os.path.join(lr, "legacy-on"))
        rc, got = run("queue", "r", "7", "--who", "W")
        case("legacy-on runs the old lander with the same argv",
             rc == 0 and got.endswith(" queue r 7 --who W") and "/legacy/" in got)
        os.unlink(os.path.join(lr, "legacy-on"))
        os.symlink(os.path.join(h, "evil"), os.path.join(lr, "legacy-on"))
        rc, got = run("queue", "r", "7")
        case("a legacy-on planted outside legacy/ is refused, not run", rc == 3 and got == "")
        os.unlink(os.path.join(lr, "legacy-on"))
        os.makedirs(os.path.join(h, "evil", "core", "lander"))
        os.symlink(os.path.join(h, "evil"), os.path.join(lr, "current"))
        global LROOT
        keep, LROOT = LROOT, lr
        try:
            case("a current planted outside releases/ is not imported", pinned("current", "releases") == (True, ""))
        finally:
            LROOT = keep


def main(argv):
    on, leg = pinned("legacy-on", "legacy")
    if on:
        tool = os.path.join(leg, "core", "bin", "cc-land") if leg else ""
        if not os.path.isfile(tool):
            print(f"cc-land: {os.path.join(LROOT, 'legacy-on')} does not point at a legacy release under "
                  f"{os.path.join(LROOT, 'legacy')}/ — refused, nothing ran (`lander-self rollback --legacy` "
                  f"sets it; `lander-self promote` clears it)", file=sys.stderr)
            return 3
        os.execv(sys.executable, [sys.executable, tool, *argv])
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    out = translate(argv)
    if out is None:
        print("cc-land: there are no batches any more; nothing to run")
        return 0
    if out[0] == "tick" and "--detach" in out:
        return detached(out)
    os.execv(LANDER, [LANDER, *out])


def detached(out):
    """`work --detach` returns at once: the tick runs the tip, install.sh and restarts in its own process, and
    cc-slack's sweep kills what it started after 120 s — which must never be an install half done."""
    import subprocess
    log = os.path.join(os.environ.get("CC_LANDER_STATE") or os.path.join(HOME, ".cc", "state", "land"), "tick.log")
    try:
        os.makedirs(os.path.dirname(log), exist_ok=True)
        with open(log, "a") as f:
            p = subprocess.Popen([LANDER, *out], stdin=subprocess.DEVNULL, stdout=f, stderr=f,
                                 start_new_session=True)
    except OSError as e:
        print(f"cc-land: could not start the tick: {e}", file=sys.stderr)
        return 1
    try:   # a lander that refuses at once (exit 3: no pinned release) says so to the caller, not only to the log
        rc = p.wait(timeout=1)
    except subprocess.TimeoutExpired:
        rc = None
    if rc:
        print(f"cc-land: the tick exited {rc} at once (log {log})", file=sys.stderr)
        return rc
    print(f"cc-land: tick started detached (pid {p.pid}, log {log})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
