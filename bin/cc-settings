#!/usr/bin/env bash
# cc-settings — reconcile ~/.claude/settings.json against the MANAGED subset in config/claude-managed.json:
# the hook registrations the box's mechanical gates are made of, plus the deny rules that must never go missing.
# Everything else in that file belongs to whoever uses the box: never touched, never reported as drift.
#   cc-settings check     one line naming exactly what is unapplied; exit 1 when anything is. install + audit use this.
#                         A hook that already runs for some tool types is named with only the rest: PreToolUse(Agent|Task).
#   cc-settings show      one line per managed entry, with why each one exists; a partly registered hook reads
#                         PARTIAL with its gap, not MISSING with the whole hook's why
#   cc-settings apply     OWNER ONLY, at a terminal: back up, then add the missing HOOKS. Never `permissions`.
#   cc-settings grant allow '<rule>' --by <who> [--card <id>]     THE cc-slack DAEMON ONLY, carrying the owner's
#                         `yes <id> fix` on a 🔐 grant card or the approver's apply (--by approver): back up, add that ONE rule to permissions.allow,
#                         prove the rest of the file identical, log it (~/.cc/state/grants.log)
#   cc-settings grant unit <file> <sha256> --by <who> [--card <id>]  same door: install + enable one user unit
#   cc-settings selfcheck its own cases, against fixture files — the live settings are never read, never written
#
# WHY NOTHING AUTOMATIC WRITES THIS FILE. ~/.claude/settings.json holds `permissions`, and a hook entry runs a
# command on every prompt: anything able to edit it can grant itself capabilities. cc-guard lists it as a secret
# path and it stays that way. So `check` is what the box runs — install.sh and cc-audit only ever REPORT — while
# `apply` refuses inside a Claude Code session, refuses without a terminal, refuses in a track worktree, and
# re-reads its own output to prove `permissions` came through byte-identical before it replaces anything. A
# missing deny rule is named and printed for the owner to paste; it is never written. `grant` is the one door
# into `permissions.allow`, and only the owner's word opens it — his Slack reply, or a grant of his the approver
# (cc-approve) finds recorded: a session raises the ask (cc-slack grant), the cc-slack daemon — no Claude Code
# environment — carries the answer here, and cc-guard refuses the
# command itself to every session (docs/design-seat-grant-from-slack.md).
#
# PROVEN COST (2026-08-31): a hook was canonical in config/ for days and never applied to the live file, so the
# gate it registers never ran once and nothing the box did depended on it. The audit had been
# failing on it the whole time, as "27 lines differ", where a theme change weighed exactly as much as a missing
# gate. Nobody acted on it. Naming the subset is what turns that report into something anyone can act on.
set -uo pipefail
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
M="${CC_SETTINGS_MANIFEST:-$R/config/claude-managed.json}"
S="${CC_SETTINGS_FILE:-$HOME/.claude/settings.json}"
DEF="$R/config/claude-settings.json"
USAGE="usage: cc-settings check|show|apply|grant allow <rule>|grant unit <file> <sha256> [--by <who> --card <id>]|selfcheck"
command -v jq >/dev/null 2>&1 || { echo "cc-settings: jq is missing" >&2; exit 2; }
[ -f "$M" ] || { echo "cc-settings: no manifest at $M" >&2; exit 2; }

# A hook with no matcher has an EMPTY field, and tab is an IFS *whitespace* character: `IFS=$'\t' read` silently
# folds two tabs into one and every field after the empty matcher shifts left. So the field separator here is
# US (0x1f), which is not whitespace and cannot appear in a path or a matcher.
US=$'\x1f'
# $HOME, ${HOME}, ~ and the literal path are ONE command. The live file is written by whoever last edited it and
# Claude Code expands nothing, so comparing raw strings is how two of the original 27 "differing lines" arose.
norm(){ local c=$1; c=${c//\$\{HOME\}/$HOME}; c=${c//\$HOME/$HOME}; case $c in \~/*) c="$HOME/${c#\~/}";; esac
        printf '%s' "$c" | tr -s ' \t' ' ' | sed 's/^ *//; s/ *$//'; }
want_hooks(){ jq -r '.hooks[] | [.event, (.matcher // ""), .command, (.why // "")] | join("\u001f")' "$M"; }
want_deny(){ jq -r '.deny[]' "$M"; }
want_statusline(){ jq -r '.statusLine.command // empty' "$M"; }         # one line, or none: a scalar, not an array
want_statusline_why(){ jq -r '.statusLine.why // empty' "$M"; }
live_hooks(){ jq -r '(.hooks // {}) | to_entries[] as $e | $e.value[]? | (.matcher // "") as $m
                     | (.hooks // [])[] | select(.type == "command") | [$e.key, $m, .command] | join("\u001f")' "$S" 2>/dev/null; }
live_deny(){ jq -r '(.permissions.deny // [])[]' "$S" 2>/dev/null; }
live_statusline(){ jq -r '.statusLine.command // empty' "$S" 2>/dev/null; }

# add_hook <file> <event> <matcher> <command> — the ONE mutation this command can make, on stdout. It only ever
# assigns under `.hooks`: no path in it names `.permissions`, and apply proves that against its own output too.
add_hook(){ jq --arg ev "$2" --arg m "$3" --arg c "$4" '
      .hooks //= {} | .hooks[$ev] //= []
    | if ([.hooks[$ev][] | select((.matcher // "") == $m)] | length) > 0
      then .hooks[$ev] |= map(if (.matcher // "") == $m then .hooks = ((.hooks // []) + [{type:"command", command:$c}]) else . end)
      else .hooks[$ev] += [ (if $m == "" then {hooks:[{type:"command", command:$c}]}
                                         else {matcher:$m, hooks:[{type:"command", command:$c}]} end) ] end
  ' "$1"; }
# set_statusline <file> <command> — the OTHER mutation apply() can make. Runs only when scan() found
# .statusLine absent: an owner's own different command is never overwritten — scan() reports it as SL_CUSTOM
# instead of MISSING, so this never runs against one.
set_statusline(){ jq --arg c "$2" '.statusLine = {type:"command", command:$c}' "$1"; }

# scan sets MISSING (one row per unapplied entry: "hook<US>event<US>matcher-gap<US>command<US>why",
# "deny<US>rule", "statusline<US>command<US>why", or "absent<US>path"), UNRELATED (lines outside the
# subset — context, never a fault), and SL_CUSTOM (the owner's own statusLine command, when it differs
# from the manifest's — satisfied, never flagged as drift, never written over).
# matcher-gap: for an empty wanted matcher, "" (that event/command is either an exact match or the whole
# row is missing — Stop and SubagentStop have no tool-type dimension). For a non-empty one, only the
# PIPE-SEPARATED TOOL TYPES no live entry for that same event+command covers, computed over the UNION of
# every live entry's matcher for it — so a command split across two or three registrations (or reordered)
# reads as applied exactly like one, and only the tool types genuinely uncovered are named as the gap
# (PROVEN 2026-09-21: cc-guard split live across two matchers covering Bash..Glob and flagged as fully
# "MISSING", the same alarm as zero coverage, though merge/deploy — Bash — already ran; row
# raised-settings-check-says-the-guard-hook-is-missing).
MISSING=""; UNRELATED=0; SL_CUSTOM=""
# gap_for <event> <command> <want-matcher> <live-rows> — the want-matcher's pipe-separated tool types not
# named by any live row's matcher for the same event+command; "" (with success) means fully covered.
gap_for(){
  local ev=$1 cmd=$2 want=$3 live=$4 lev lm lcmd covered="" t rest out=""
  while IFS=$US read -r lev lm lcmd; do
    [ "$lev" = "$ev" ] && [ "$(norm "$lcmd")" = "$(norm "$cmd")" ] || continue
    [ -z "$lm" ] && { covered=ALL; break; }   # an unscoped live entry for this command already covers every tool
    covered="$covered|$lm|"
  done <<<"$live"
  [ "$covered" = ALL ] && return 0
  rest=$want
  while [ -n "$rest" ]; do
    t=${rest%%|*}; case "$rest" in *\|*) rest=${rest#*|} ;; *) rest="" ;; esac
    [ -n "$t" ] || continue
    case "$covered" in *"|$t|"*) ;; *) out="${out:+$out|}$t" ;; esac
  done
  printf '%s' "$out"
}
scan(){
  MISSING=""; UNRELATED=0; SL_CUSTOM=""
  local ev m cmd why rule found lev lm lcmd live ld n sl_want sl_live gap
  [ -f "$S" ] || { MISSING="absent$US$S"; return; }
  live=$(live_hooks)
  while IFS=$US read -r ev m cmd why; do
    [ -n "$ev" ] || continue
    if [ -z "$m" ]; then
      found=0
      while IFS=$US read -r lev lm lcmd; do
        [ "$lev" = "$ev" ] && [ -z "$lm" ] && [ "$(norm "$lcmd")" = "$(norm "$cmd")" ] && { found=1; break; }
      done <<<"$live"
      [ "$found" = 1 ] || MISSING+="hook$US$ev$US$US$cmd$US$why"$'\n'
    else
      gap=$(gap_for "$ev" "$cmd" "$m" "$live")
      [ -n "$gap" ] && MISSING+="hook$US$ev$US$gap$US$cmd$US$why"$'\n'
    fi
  done < <(want_hooks)
  ld=$(live_deny)
  while IFS= read -r rule; do
    [ -n "$rule" ] || continue
    grep -qxF "$rule" <<<"$ld" || MISSING+="deny$US$rule"$'\n'
  done < <(want_deny)
  sl_want=$(want_statusline)
  if [ -n "$sl_want" ]; then
    sl_live=$(live_statusline)
    if [ -z "$sl_live" ]; then MISSING+="statusline$US$sl_want$US$(want_statusline_why)"$'\n'
    elif [ "$(norm "$sl_live")" != "$(norm "$sl_want")" ]; then SL_CUSTOM=$sl_live; fi
  fi
  n=$(diff <(jq -S . "$DEF" 2>/dev/null) <(jq -S . "$S" 2>/dev/null) 2>/dev/null | grep -c '^[<>]')
  UNRELATED=${n:-0}
}
miss_of(){ grep "^$1$US" <<<"$MISSING"; }   # never matches when MISSING is empty: grep, not a case glob
# partial_gap <event> <command> <gap> — true when <gap> is some but not all of the manifest's matcher for that
# hook: the command already runs for every other tool type. check and show then name only the gap, and show drops
# the manifest's why ("…a worker can merge, deploy and push"), which is true of a missing guard, not a partial one.
partial_gap(){ [ -n "$3" ] && [ "$3" != "$(jq -r --arg e "$1" --arg c "$2" \
                 'first(.hooks[] | select(.event == $e and .command == $c) | .matcher // "")' "$M")" ]; }

# one line the owner can act on, and an exit code the caller can gate on
check(){
  local kind a g c hooks="" denies="" sl=""
  scan
  if miss_of absent >/dev/null; then echo "settings — $S does not exist (run install.sh once)"; return 1; fi
  while IFS=$US read -r kind a g c _; do
    case "$kind" in
      hook) if partial_gap "$a" "$c" "$g"; then hooks="$hooks $a($g)"; else hooks="$hooks $a"; fi ;;
      deny) denies="$denies $a" ;; statusline) sl=1 ;;
    esac
  done <<<"$MISSING"
  if [ -z "$hooks$denies$sl" ]; then
    echo "settings — all $( { want_hooks; want_deny; want_statusline; } | grep -c .) managed entries applied ($UNRELATED unrelated line(s) differ, not managed)"
    return 0
  fi
  printf 'settings — UNAPPLIED:%s%s%s — cc-settings show, then %s\n' \
    "${hooks:+ hook$hooks}" "${denies:+ deny$denies}" "${sl:+ statusLine}" \
    "$([ -n "$hooks$sl" ] && echo 'cc-settings apply (owner, at a terminal)' || echo 'add the deny rule(s) by hand')"
  return 1
}

# hook_gap <event> <command> — 0 and sets $HGAP to that MISSING row's matcher-gap (possibly "") when one
# exists for this event+command; 1 otherwise. cmd compared literally: both sides are always the manifest's
# own raw string here, never normalized, so this never needs norm().
hook_gap(){
  local k e m c w
  while IFS=$US read -r k e m c w; do
    [ "$k" = hook ] && [ "$e" = "$1" ] && [ "$c" = "$2" ] && { HGAP=$m; return 0; }
  done <<<"$MISSING"
  return 1
}
show(){
  local ev m cmd why rule
  scan
  printf 'manifest: %s\nlive:     %s\n\n' "$M" "$S"
  while IFS=$US read -r ev m cmd why; do
    [ -n "$ev" ] || continue
    if hook_gap "$ev" "$cmd"; then
      if partial_gap "$ev" "$cmd" "$HGAP"; then
        printf '  PARTIAL  hook %-16s %s  (already covers all but: %s)\n           registered for every other tool type; only %s is ungated\n' \
          "$ev" "$(norm "$cmd")" "$HGAP" "$HGAP"
      else
        printf '  MISSING  hook %-16s %s\n           why: %s\n' "$ev" "$(norm "$cmd")" "$why"
      fi
    else printf '  ok       hook %-16s %s\n' "$ev" "$(norm "$cmd")"; fi
  done < <(want_hooks)
  while IFS= read -r rule; do
    [ -n "$rule" ] || continue
    if grep -qxF "deny$US$rule" <<<"$MISSING"; then
      printf '  MISSING  deny %s\n           add it by hand — cc-settings never writes `permissions`\n' "$rule"
    else printf '  ok       deny %s\n' "$rule"; fi
  done < <(want_deny)
  local sl_want sl_why
  sl_want=$(want_statusline)
  if [ -n "$sl_want" ]; then
    if grep -qF "statusline$US$sl_want" <<<"$MISSING"; then
      sl_why=$(want_statusline_why)
      printf '  MISSING  statusLine %s\n           why: %s\n' "$(norm "$sl_want")" "$sl_why"
    elif [ -n "$SL_CUSTOM" ]; then
      printf '  kept     statusLine %s  (your own — cc-settings never overwrites a statusLine you set)\n' "$(norm "$SL_CUSTOM")"
    else printf '  ok       statusLine %s\n' "$(norm "$sl_want")"; fi
  fi
  printf '\n%s line(s) outside the managed subset differ from %s — not managed, not drift.\n' "$UNRELATED" "${DEF#"$R"/}"
  [ -z "$MISSING" ]
}

# ---- apply: the owner's own hand, at a terminal. Never a session, never `permissions`. ----
refuse(){ echo "cc-settings apply: $1" >&2
          echo "  Deliberate: $S decides what a session may do, so only the owner edits it." >&2
          echo "  Type \`cc-settings apply\` yourself in a shell on the box. \`cc-settings show\` says what is missing." >&2
          exit 3; }
apply(){
  local d ev m cmd tmp bak orig_perm new_perm ans n=0 sl_cmd
  [ -z "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}${CLAUDE_CODE_ENTRYPOINT:-}" ] || refuse "refusing — this is running inside a Claude Code session"
  [ -z "${CC_ROLE:-}" ] || refuse "refusing — CC_ROLE=${CC_ROLE} (a worker or member session)"
  { [ -t 0 ] && [ -t 1 ]; } || refuse "refusing — no terminal (this is only ever typed by hand)"
  d=$PWD; while [ -n "$d" ] && [ "$d" != / ]; do [ -e "$d/.cc/track" ] && refuse "refusing — $d is a track worktree"; d=$(dirname "$d"); done
  [ -f "$S" ] || { echo "cc-settings: no $S — run install.sh once first" >&2; exit 2; }

  scan
  if ! miss_of hook >/dev/null && ! miss_of statusline >/dev/null; then
    echo "cc-settings: every managed hook and the statusLine are already applied — nothing to write."
    { miss_of deny >/dev/null || [ -n "$SL_CUSTOM" ]; } && { echo; show; }
    exit 0
  fi
  if miss_of hook >/dev/null; then
    echo "About to add these hook registrations to $S:"
    while IFS=$US read -r _ ev m cmd _; do printf '  %-16s %s%s\n' "$ev" "$(norm "$cmd")" "${m:+   (matcher: $m)}"; done < <(miss_of hook)
  fi
  if miss_of statusline >/dev/null; then
    echo "About to set the statusLine command in $S:"
    while IFS=$US read -r _ cmd _; do printf '  %s\n' "$(norm "$cmd")"; done < <(miss_of statusline)
  fi
  if [ -n "$SL_CUSTOM" ]; then
    echo "Your own statusLine command is kept as it is, not overwritten: $(norm "$SL_CUSTOM")"
  fi
  if miss_of deny >/dev/null; then
    echo "Also missing, and NOT written by this command — paste these in yourself:"
    miss_of deny | cut -d"$US" -f2 | sed 's/^/  /'
  fi
  printf 'Everything else in the file is kept as it is. Apply? [y/N] '
  read -r ans </dev/tty; case "$ans" in y|Y|yes|YES) ;; *) echo "nothing changed."; exit 0;; esac

  orig_perm=$(jq -S -c '.permissions // null' "$S")
  bak="$S.bak-$(date -u +%Y%m%dT%H%M%SZ)"
  cp -a "$S" "$bak" || { echo "cc-settings: could not back up to $bak — nothing changed" >&2; exit 1; }
  tmp="$S.new.$$"; cp -a "$S" "$tmp" || exit 1
  while IFS=$US read -r _ ev m cmd _; do
    [ -n "$ev" ] || continue
    if add_hook "$tmp" "$ev" "$m" "$cmd" > "$tmp.j"
    then mv -f "$tmp.j" "$tmp"
    else rm -f "$tmp" "$tmp.j"; echo "cc-settings: jq failed on $ev — nothing changed ($bak holds the backup)" >&2; exit 1; fi
    n=$((n+1))
  done < <(miss_of hook)
  if miss_of statusline >/dev/null; then
    sl_cmd=$(miss_of statusline | cut -d"$US" -f2)
    if set_statusline "$tmp" "$sl_cmd" > "$tmp.j"
    then mv -f "$tmp.j" "$tmp"; n=$((n+1))
    else rm -f "$tmp" "$tmp.j"; echo "cc-settings: jq failed on statusLine — nothing changed ($bak holds the backup)" >&2; exit 1; fi
  fi

  jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; echo "cc-settings: the result is not valid json — nothing changed" >&2; exit 1; }
  new_perm=$(jq -S -c '.permissions // null' "$tmp")   # the promise, checked rather than asserted
  [ "$new_perm" = "$orig_perm" ] || { rm -f "$tmp"; echo "cc-settings: that rewrite would have changed \`permissions\` — refused, nothing changed" >&2; exit 1; }
  mv -f "$tmp" "$S" || { echo "cc-settings: could not replace $S — $bak holds the backup" >&2; exit 1; }
  echo "applied $n managed entrie(s). Backup: $bak"
  echo "Claude Code reads settings at session start: restart any session that has to be gated by them."
}

# ---- grant: the owner's Slack answer, carried by the cc-slack daemon. Never a session. ----
# `cc-settings grant allow '<rule>' --by <who> --card <id>` adds ONE rule to `permissions.allow`;
# `cc-settings grant unit <file> <sha256> --by <who> --card <id>` installs and enables one user unit.
# The daemon is a systemd user unit with no Claude Code environment, so the same walls as apply's stand (no
# CLAUDECODE, no CC_ROLE, not in a track worktree) — minus the terminal, which the daemon has not got. What it
# proves is apply's promise turned round: everything but `.permissions.allow` (deny rules included) comes through
# identical, and allow is exactly the old list plus the one rule. Every grant is one line in $GRANT_LOG.
# Design: docs/design-seat-grant-from-slack.md.
GRANT_LOG="${CC_GRANT_LOG:-$HOME/.cc/state/grants.log}"
UNIT_DIR="${CC_UNIT_DIR:-$HOME/.config/systemd/user}"
grant_refuse(){ echo "cc-settings grant: $1" >&2; exit 3; }
grant_log(){ mkdir -p "$(dirname "$GRANT_LOG")"; printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$GRANT_LOG"; }
grant(){
  local kind=${1:-} what=${2:-} sha="" by="" card="" d tmp bak orig_rest new_rest want got name dest inner
  shift $(( $# >= 2 ? 2 : $# ))
  [ -z "${CLAUDECODE:-}${CLAUDE_CODE_SESSION_ID:-}${CLAUDE_CODE_ENTRYPOINT:-}" ] || grant_refuse "refusing — this is running inside a Claude Code session; a seat raises the card (cc-slack grant), the owner's Slack reply writes"
  [ -z "${CC_ROLE:-}" ] || grant_refuse "refusing — CC_ROLE=${CC_ROLE} (a worker or member session)"
  d=$PWD; while [ -n "$d" ] && [ "$d" != / ]; do [ -e "$d/.cc/track" ] && grant_refuse "refusing — $d is a track worktree"; d=$(dirname "$d"); done
  if [ "$kind" = unit ]; then sha=${1:-}; shift $(( $# >= 1 ? 1 : 0 )); fi
  while [ $# -gt 0 ]; do case "$1" in
    --by) by=${2:-}; shift 2 ;; --card) card=${2:-}; shift 2 ;;
    *) grant_refuse "unknown argument $1 ($USAGE)" ;; esac; done
  [ -n "$by" ] || grant_refuse "--by <who> is required: a grant names who gave it"
  by=$(tr -d '\n\r' <<<"$by"); card=$(tr -d '\n\r' <<<"$card")   # one log line per grant, whatever the caller sent
  case "$kind" in
  allow)
    # one Tool(pattern) rule or one bare mcp tool name; never a bare `*` — a grant is narrow and named in the card
    [[ "$what" == *$'\n'* ]] && grant_refuse "not an allow rule (newline): $what"   # grep -E judges per line; one rule is one line
    grep -qE '^([A-Za-z][A-Za-z0-9_]*\([^()[:cntrl:]]{1,200}\)|mcp__[A-Za-z0-9_-]+)$' <<<"$what" || grant_refuse "not an allow rule: $what"
    # a pattern that is nothing but wildcards, separators and slashes — Bash(*), Bash(:*), Bash(* *), Read(/**) — is the whole tool
    inner=${what#*\(}; inner=${inner%\)}
    [ -n "$(tr -d '*?: /' <<<"$inner")" ] || grant_refuse "refusing a bare wildcard: $what grants the whole tool"
    [ -f "$S" ] || grant_refuse "no $S"
    jq -e . "$S" >/dev/null 2>&1 || grant_refuse "$S is not valid json — nothing changed"
    if jq -e --arg r "$what" '(.permissions.allow // []) | index($r) != null' "$S" >/dev/null; then
      echo "cc-settings grant: $what is already allowed — nothing to write"; return 0; fi
    orig_rest=$(jq -S -c 'del(.permissions.allow)' "$S")
    want=$(jq -S -c --arg r "$what" '(.permissions.allow // []) + [$r]' "$S")
    bak="$S.bak-$(date -u +%Y%m%dT%H%M%SZ)"
    cp -a "$S" "$bak" || grant_refuse "could not back up to $bak — nothing changed"
    tmp=$(mktemp "$(dirname "$S")/.settings.grant.XXXXXX") || grant_refuse "could not make a temp file beside $S"   # never a predictable name a planted symlink could be waiting under
    jq --arg r "$what" '.permissions //= {} | .permissions.allow = ((.permissions.allow // []) + [$r])' "$S" > "$tmp" \
      || { rm -f "$tmp"; grant_refuse "jq failed — nothing changed ($bak holds the backup)"; }
    jq -e . "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; grant_refuse "the result is not valid json — nothing changed"; }
    new_rest=$(jq -S -c 'del(.permissions.allow)' "$tmp"); got=$(jq -S -c '.permissions.allow' "$tmp")   # the promise, checked
    [ "$new_rest" = "$orig_rest" ] || { rm -f "$tmp"; grant_refuse "that rewrite would have changed something besides \`permissions.allow\` — refused, nothing changed"; }
    [ "$got" = "$want" ] || { rm -f "$tmp"; grant_refuse "that rewrite would not have added exactly one rule — refused, nothing changed"; }
    mv -f "$tmp" "$S" || grant_refuse "could not replace $S — $bak holds the backup"
    grant_log "allow $what by $by card ${card:--} backup $bak"
    echo "granted: $what is now in $S permissions.allow (backup $bak). Claude Code reads settings at session start."
    ;;
  unit)
    # the unit file the card named, by path AND hash: a swap between raise and approve is refused, not installed
    what=$(readlink -f -- "$what") || grant_refuse "no unit file at $2"
    case "$what" in "${CC_UNIT_ROOTS:-$HOME/dev}"/*|"$HOME"/.cc/worktrees/*) ;; *) grant_refuse "a unit file the card names sits in a repo tree (~/dev, ~/.cc/worktrees): $what" ;; esac
    name=$(basename -- "$what")
    grep -qE '^[A-Za-z0-9_@.-]+\.(service|timer)$' <<<"$name" || grant_refuse "not a user unit file: $what"
    [ -f "$what" ] || grant_refuse "no unit file at $what"
    got=$(sha256sum -- "$what" | cut -d' ' -f1)
    [ -n "$sha" ] && [ "$got" = "$sha" ] || grant_refuse "refusing — $what is not the file the card named (sha256 $got, card said ${sha:-nothing})"
    mkdir -p "$UNIT_DIR" || grant_refuse "could not make $UNIT_DIR"
    dest="$UNIT_DIR/$name"; bak=""
    if [ -e "$dest" ]; then bak="$dest.bak-$(date -u +%Y%m%dT%H%M%SZ)"; cp -a "$dest" "$bak" || grant_refuse "could not back up $dest — nothing changed"; fi
    cp -- "$what" "$dest" || grant_refuse "could not write $dest${bak:+ ($bak holds the backup)}"
    if [ -z "${CC_UNIT_DRY:-}" ]; then   # the selfcheck proves the copy and the log on a fixture dir; systemd is the live box's alone
      systemctl --user daemon-reload || grant_refuse "daemon-reload failed — $dest is in place, not enabled"
      systemctl --user enable --now -- "$name" || grant_refuse "enable --now $name failed — $dest is in place, not enabled"
    fi
    grant_log "unit $name sha256 $got from $what by $by card ${card:--} backup ${bak:--}"
    echo "granted: $name installed from $what (sha256 $got) and enabled${bak:+ (backup $bak)}"
    ;;
  *) grant_refuse "grant allow <rule>|unit <file> <sha256> --by <who> [--card <id>]" ;;
  esac
}

selfcheck(){
  local d n=0 f=0 S M DEF CL out rc sl_cmd self sha g_found
  d=$(mktemp -d "${TMPDIR:-/tmp}/cc-settings-sc.XXXXXX") || return 1   # S/M/DEF are local: every case runs against fixtures
  k(){ n=$((n+1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else echo "  FAIL $2"; f=$((f+1)); fi; }
  t(){ if "$@" >/dev/null 2>&1; then echo 0; else echo 1; fi; }   # a case that PRINTS (jq -e) must not leak into the verdict
  M="$R/config/claude-managed.json"; DEF="$R/config/claude-settings.json"
  k "$(t jq -e . "$M")" "the managed manifest is valid json"
  k "$(t test "$(jq '.hooks | length' "$M")" -eq 5)" "the manifest names five hook registrations"
  k "$(t test -n "$(jq -r '.statusLine.command // empty' "$M")")" "the manifest names a statusLine command"
  # the shipped default must satisfy the subset itself, or a fresh box installs a file that is already wrong
  S="$DEF"; scan
  k "$(t test -z "$MISSING")" "config/claude-settings.json satisfies its own managed subset${MISSING:+ — missing: $(tr '\n' ' ' <<<"$MISSING")}"
  jq '(.hooks.PreToolUse[] | .hooks) |= map(select(.command != "$HOME/bin/cc-native"))
      | del(.hooks.SubagentStop)' "$DEF" > "$d/no-native.json"; S="$d/no-native.json"
  out=$(check); rc=$?
  k "$(t test "$rc" -ne 0)" "native registrations missing is a request that must be refused by check; the shipped subset is its control"
  k "$(t grep -q 'UNAPPLIED: hook PreToolUse SubagentStop' <<<"$out")" "check names both unapplied native hooks without applying them"
  # Every command in the manifest runs unattended, on tool calls nobody watches, so a change to one must buy the
  # paid read at the landing (tests/control-layer, cc-land's gate tier). cc-native was added to the manifest
  # without it and would have landed on the cheap gates alone.
  CL="$R/tests/control-layer"
  ctl_miss(){ local c m=""
    for c in $(jq -r '.hooks[].command' "$M" | awk '{print $1}' | sed 's|^\$HOME/||' | sort -u); do
      grep -qxF "$c" "$CL" || m="$m $c"; done; printf '%s' "$m"; }
  k "$(t test -z "$(ctl_miss)")" "every managed hook command is on tests/control-layer$(ctl_miss | sed 's/^ / — missing: /')"
  grep -vxF 'bin/cc-native' "$CL" > "$d/thin-control-layer"; CL="$d/thin-control-layer"
  k "$(t grep -q 'bin/cc-native' <<<"$(ctl_miss)")" "…and a hook missing from that list is named; the shipped list is its control"
  CL="$R/tests/control-layer"
  # THE PROVEN CASE: canonical in config/, absent from the live file. It must be NAMED, not counted.
  jq 'del(.hooks.Stop)' "$DEF" > "$d/no-stop.json"; S="$d/no-stop.json"
  scan; k "$(t grep -q "^hook${US}Stop" <<<"$MISSING")" "a missing Stop hook is detected"
  out=$(check); rc=$?
  k "$(t grep -q 'Stop' <<<"$out")" "…and check names it in one line: ${out}"
  k "$(t test "$rc" -ne 0)" "…and check exits non-zero, so a caller can gate on it"
  # unrelated settings are NOT drift: theme, model, a custom key and EXTRA allow/deny rules all pass
  jq '.theme="dark" | .model="other" | .permissions.allow += ["Bash(cowsay:*)"]
      | .permissions.deny += ["Bash(git push --force:*)"] | .customKey={a:1}' "$DEF" > "$d/custom.json"; S="$d/custom.json"
  scan; k "$(t test -z "$MISSING")" "unrelated keys, a custom key and EXTRA allow/deny rules are not drift"
  k "$(t test "$UNRELATED" -gt 0)" "…while the unrelated lines are still counted as context ($UNRELATED)"
  # $HOME / ${HOME} / ~ / the literal path are one registration — two of the original 27 "differing lines"
  jq --arg h "$HOME" '.hooks.PreToolUse[0].hooks[0].command = $h + "/bin/cc-guard"
                      | .hooks.PreToolUse[1].hooks[0].command = "~/bin/cc-native"
                      | .hooks.Stop[0].hooks[0].command = "${HOME}/bin/cc-checkpoint  "' "$DEF" > "$d/expanded.json"
  S="$d/expanded.json"; scan
  k "$(t test -z "$MISSING")" "\$HOME, \${HOME}, ~ and the literal path are all the same registration"
  # a required deny rule that has gone missing is reported, by name
  jq '.permissions.deny = ["Bash(*sysrq-trigger*)"]' "$DEF" > "$d/thin-deny.json"; S="$d/thin-deny.json"
  scan; k "$(t test "$(miss_of deny | grep -c .)" -eq 3)" "three missing required deny rules are reported"
  k "$(t grep -qxF "deny${US}Artifact" <<<"$MISSING")" "a settings file without the Artifact deny is reported missing it"
  k "$(t grep -q 'by hand' <<<"$(check)")" "…and check says to add them by hand, not to run apply"
  # right event, wrong matcher: a narrowed guard leaves tools ungated, so it is drift
  jq '.hooks.PreToolUse[0].matcher = "Bash"' "$DEF" > "$d/narrow.json"; S="$d/narrow.json"
  scan; k "$(t grep -q "^hook${US}PreToolUse" <<<"$MISSING")" "a narrowed PreToolUse matcher is drift, not a match"
  # THE PROVEN CASE (2026-09-21, row raised-settings-check-says-the-guard-hook-is-missing): the live guard
  # hook was split across two matcher entries — Bash..NotebookEdit and Read..Glob — whose UNION covered
  # everything the manifest wanted at the time. scan() required one entry matching byte-for-byte and called
  # the whole registration MISSING, with the "a worker session can merge, deploy and push" warning, though
  # merge/deploy (Bash) already ran; a seat spent a turn manually proving that before telling the owner.
  jq '.hooks.PreToolUse = [
        {matcher:"Bash|Edit|Write|MultiEdit|NotebookEdit", hooks:[{type:"command", command:"$HOME/bin/cc-guard"}]},
        {matcher:"Read|NotebookRead|Grep|Glob|Agent|Task", hooks:[{type:"command", command:"$HOME/bin/cc-guard"}]},
        .hooks.PreToolUse[1]
      ]' "$DEF" > "$d/split-full.json"
  S="$d/split-full.json"; scan
  k "$(t test -z "$MISSING")" "a command split across two matcher entries whose union covers the manifest's is applied, not MISSING"
  # …but a split that leaves a real gap must still be named — exactly what mirrors the live box that day:
  # Bash..Glob covered, Agent|Task (the isolation:worktree spawn fence) not.
  jq '.hooks.PreToolUse = [
        {matcher:"Bash|Edit|Write|MultiEdit|NotebookEdit", hooks:[{type:"command", command:"$HOME/bin/cc-guard"}]},
        {matcher:"Read|NotebookRead|Grep|Glob", hooks:[{type:"command", command:"$HOME/bin/cc-guard"}]},
        .hooks.PreToolUse[1]
      ]' "$DEF" > "$d/split-gap.json"
  S="$d/split-gap.json"; scan
  if hook_gap PreToolUse '$HOME/bin/cc-guard'; then g_found=0; else g_found=1; fi
  k "$g_found" "a split registration with a real gap is still reported as a hook row"
  k "$(t test "$HGAP" = 'Agent|Task')" "…and the gap names only the uncovered tool types (Agent|Task), not the whole ten-tool matcher"
  out=$(check); rc=$?
  k "$(t test "$rc" -ne 0)" "…and check still exits non-zero: Bash already gated is not the same as fully applied"
  out=$(show)
  k "$(t grep -q 'already covers all but: Agent|Task' <<<"$out")" "…and show says precisely what is left, not a blanket MISSING"
  k "$(t test "$(grep -c 'merge, deploy and push' <<<"$out")" -eq 0)" "…and show does not raise the missing-guard merge/deploy alarm for a partial gap"
  S="$d/split-gap.json"; out=$(check)
  k "$(t grep -qF 'UNAPPLIED: hook PreToolUse(Agent|Task) ' <<<"$out")" "…and check names the gap, not the whole hook: $out"
  # its control: the guard gone from every entry is the whole hook missing, and keeps the full alarm
  jq '(.hooks.PreToolUse[] | .hooks) |= map(select(.command != "$HOME/bin/cc-guard"))' "$DEF" > "$d/no-guard.json"
  S="$d/no-guard.json"; out=$(check)
  k "$(t grep -qF 'UNAPPLIED: hook PreToolUse — ' <<<"$out")" "a guard missing from every entry is named as the whole hook, no gap: $out"
  out=$(show)
  k "$(t grep -q 'merge, deploy and push' <<<"$out")" "…and show keeps the merge/deploy alarm for it"
  S="$d/split-gap.json"
  # closing the loop: applying just the gap (what apply() would do, since $HGAP is what it hands add_hook)
  # is enough — it must not duplicate the two registrations that already run.
  add_hook "$d/split-gap.json" PreToolUse 'Agent|Task' '$HOME/bin/cc-guard' > "$d/split-fixed.json"
  S="$d/split-fixed.json"; scan
  k "$(t test -z "$MISSING")" "…and adding only the missing Agent|Task registration closes it"
  # an EXTRA hook of the user's own, alongside the managed ones, is not drift either
  jq '.hooks.PreToolUse[0].hooks += [{type:"command", command:"$HOME/bin/mine"}]' "$DEF" > "$d/extra-hook.json"
  S="$d/extra-hook.json"; scan
  k "$(t test -z "$MISSING")" "a user's own extra hook alongside a managed one is preserved, not drift"
  # a settings file that does not exist at all is its own answer, not a crash
  S="$d/nope.json"; scan; k "$(t grep -q '^absent' <<<"$MISSING")" "an absent settings file is reported as absent"
  # statusLine: absent -> reported by name and unapplied; a DIFFERENT command is the owner's own — satisfied,
  # never drift, never something apply would touch.
  jq 'del(.statusLine)' "$DEF" > "$d/no-statusline.json"; S="$d/no-statusline.json"
  scan; k "$(t grep -q "^statusline$US" <<<"$MISSING")" "a missing statusLine is detected"
  out=$(check); rc=$?
  k "$(t grep -q 'statusLine' <<<"$out")" "…and check names it: ${out}"
  k "$(t test "$rc" -ne 0)" "…and check exits non-zero for a missing statusLine"
  jq '.statusLine.command = "$HOME/bin/my-own-statusline"' "$DEF" > "$d/custom-sl.json"; S="$d/custom-sl.json"
  scan
  k "$(t test -z "$MISSING")" "an owner's own different statusLine command is satisfied, not drift"
  k "$(t test "$SL_CUSTOM" = '$HOME/bin/my-own-statusline')" "…and scan() names what it is, for show()/apply() to report"
  out=$(check)
  k "$(t grep -qv UNAPPLIED <<<"$out")" "…and check never calls a custom statusLine unapplied: $out"
  k "$(t test -z "$(miss_of statusline)")" "…so apply's own guard (miss_of statusline) never fires for it"
  # the three walls on apply, each proved on its own
  out=$(CLAUDECODE=1 "$0" apply 2>&1); k "$(t grep -q 'inside a Claude Code session' <<<"$out")" "apply refuses inside a Claude Code session"
  out=$(env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_ENTRYPOINT CC_ROLE=worker "$0" apply 2>&1)
  k "$(t grep -q 'CC_ROLE=worker' <<<"$out")" "apply refuses for a worker or member session"
  out=$(env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_ENTRYPOINT -u CC_ROLE "$0" apply </dev/null 2>&1)
  k "$(t grep -q 'no terminal' <<<"$out")" "apply refuses with no terminal"
  # THE WRITE ITSELF. add_hook is the only mutation apply can make, so run it — no terminal needed — over a file
  # carrying the owner's own permissions, hooks and keys, and check what came out the other side.
  jq --arg h "$HOME" '.theme="dark" | .customKey={a:1}
      | .permissions.allow += ["Bash(cowsay:*)"] | .permissions.deny += ["Bash(git push --force:*)"]
      | .hooks.PreToolUse[0].hooks += [{type:"command", command:($h + "/bin/mine")}]
      | del(.hooks.Stop)' "$DEF" > "$d/live.json"
  add_hook "$d/live.json" Stop "" '$HOME/bin/cc-checkpoint' > "$d/applied.json"
  k "$(t jq -e . "$d/applied.json")" "add_hook produces valid json"
  k "$(t diff <(jq -S .permissions "$d/live.json") <(jq -S .permissions "$d/applied.json"))" \
     "a write leaves \`permissions\` byte-identical — allow and deny both"
  k "$(t diff <(jq -S 'del(.hooks)' "$d/live.json") <(jq -S 'del(.hooks)' "$d/applied.json"))" \
     "…and every key outside .hooks byte-identical (theme, model, customKey included)"
  k "$(t grep -q "$HOME/bin/mine" "$d/applied.json")" "…and the user's own extra hook survives"
  S="$d/applied.json"; scan
  k "$(t test -z "$MISSING")" "…and the file it wrote now satisfies the managed subset"
  # scoped to .hooks: a top-level key can carry the same {type:"command", command:…} shape (statusLine does)
  # without being a hook registration at all, and counting the whole file would count that key too.
  k "$(t test "$(jq '[.hooks | .. | objects | select(.type? == "command") | .command] | length' "$d/applied.json")" -eq 6)" \
     "…with exactly one registration added, not a duplicate of the five that were there"
  # a second run is a no-op: apply must never stack the same registration twice
  add_hook "$d/applied.json" Stop "" '$HOME/bin/cc-checkpoint' > "$d/twice.json"
  S="$d/twice.json"; scan
  k "$(t test -z "$MISSING")" "applying twice still satisfies the subset (scan matches on content, not count)"
  # set_statusline is the OTHER mutation apply() can make: it sets a missing statusLine and touches nothing else
  jq 'del(.statusLine)' "$d/live.json" > "$d/sl-live.json"; S="$d/sl-live.json"; scan
  sl_cmd=$(miss_of statusline | cut -d"$US" -f2)
  set_statusline "$d/sl-live.json" "$sl_cmd" > "$d/sl-applied.json"
  k "$(t jq -e . "$d/sl-applied.json")" "set_statusline produces valid json"
  S="$d/sl-applied.json"; scan
  k "$(t test -z "$(miss_of statusline)")" "…and the file it wrote now satisfies the statusLine entry"
  k "$(t diff <(jq -S 'del(.statusLine)' "$d/sl-live.json") <(jq -S 'del(.statusLine)' "$d/sl-applied.json"))" \
     "…and every other key — hooks included — is untouched"
  # the guard rail that catches a future edit to add_hook: apply re-reads permissions before it swaps the file
  out=$(sed -n '/^apply(){/,/^}$/p' "$(readlink -f "$0")")
  k "$(t grep -q 'new_perm=\$(jq -S -c' <<<"$out")" "apply re-reads \`permissions\` from its own output"
  k "$(t grep -q '\[ "\$new_perm" = "\$orig_perm" \]' <<<"$out")" "…and refuses the swap unless it is byte-identical"
  # ---- grant: the daemon's door into permissions.allow, on a fixture file, never the live one ----
  # Every case below runs `grant` as a child with the Claude Code variables stripped: the selfcheck itself runs
  # inside a session, and the first wall would otherwise refuse every case for the same reason.
  self=$(readlink -f "$0")   # the cases cd into the fixture dir, so a relative $0 would not resolve
  G(){ env -u CLAUDECODE -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_ENTRYPOINT -u CC_ROLE CC_SETTINGS_FILE="$d/g.json" \
           CC_GRANT_LOG="$d/grants.log" CC_UNIT_DIR="$d/units" CC_UNIT_ROOTS="$d" CC_UNIT_DRY=1 ${GENV:-} "$self" grant "$@"; }   # GENV: one case's own variable, last so it wins
  jq '.theme="dark" | .permissions.allow += ["Bash(cowsay:*)"] | .permissions.deny += ["Bash(dd *)"]' "$DEF" > "$d/g.json"
  cp "$d/g.json" "$d/g.before.json"
  out=$(cd "$d" && G allow 'Bash(cc-config set *)' --by owner --card abcde 2>&1); rc=$?
  k "$(t test "$rc" -eq 0)" "grant allow writes: $out"
  k "$(t jq -e '.permissions.allow | index("Bash(cc-config set *)") != null' "$d/g.json")" "…and the ONE rule is in permissions.allow"
  k "$(t diff <(jq -S 'del(.permissions.allow)' "$d/g.before.json") <(jq -S 'del(.permissions.allow)' "$d/g.json"))" \
     "…and everything but permissions.allow — deny rules, theme, hooks — came through identical"
  k "$(t test "$(jq -S -c '.permissions.allow' "$d/g.json")" = "$(jq -S -c '.permissions.allow + ["Bash(cc-config set *)"]' "$d/g.before.json")")" \
     "…and allow is exactly the old list plus that rule, in order"
  k "$(t ls "$d"/g.json.bak-*)" "…and the file was backed up first"
  k "$(t grep -q 'allow Bash(cc-config set \*) by owner card abcde' "$d/grants.log")" "…and the grant is logged: who, what, which card"
  S="$d/g.json"; out=$(check); rc=$?
  k "$(t test "$rc" -eq 0)" "…and check stays green afterwards: $out"
  out=$(cd "$d" && G allow 'Bash(cc-config set *)' --by owner 2>&1); rc=$?
  k "$(t test "$rc" -eq 0)" "a rule already allowed is reported, not stacked twice: $out"
  k "$(t test "$(jq '[.permissions.allow[] | select(. == "Bash(cc-config set *)")] | length' "$d/g.json")" -eq 1)" "…and the file holds it once"
  out=$(cd "$d" && G allow 'Bash(*)' --by owner 2>&1); k "$(t test $? -ne 0)" "a bare wildcard is refused: $out"
  rc=0; for w in 'Bash(:*)' 'Bash(**)' 'Bash(* *)' 'Bash(?*)' 'Bash(*:*)' 'Read(/**)'; do (cd "$d" && G allow "$w" --by owner >/dev/null 2>&1) && rc=1; done
  k "$rc" "…and so is every wildcard dressed up — Bash(:*), Bash(**), Bash(* *), Bash(?*), Bash(*:*), Read(/**) — each is the whole tool"
  out=$(cd "$d" && G allow $'Bash(a *)\nBash(b *)' --by owner 2>&1); k "$(t test $? -ne 0)" "two rules on two lines are refused as one: ${out//$'\n'/ }"
  out=$(cd "$d" && G allow 'rm -rf /' --by owner 2>&1); k "$(t test $? -ne 0)" "a string that is not a Tool(pattern) rule is refused: $out"
  out=$(cd "$d" && G allow 'Bash(x *)' 2>&1); k "$(t test $? -ne 0)" "a grant with nobody named (--by) is refused: $out"
  out=$(cd "$d" && GENV=CLAUDECODE=1 G allow 'Bash(x *)' --by owner 2>&1)
  k "$(t grep -q 'inside a Claude Code session' <<<"$out")" "grant refuses inside a Claude Code session — a session cannot write the file this way either"
  out=$(cd "$d" && GENV=CC_ROLE=worker G allow 'Bash(x *)' --by owner 2>&1)
  k "$(t grep -q 'CC_ROLE=worker' <<<"$out")" "grant refuses for a worker or member session"
  k "$(t jq -e '.permissions.allow | index("Bash(x *)") == null' "$d/g.json")" "…and none of the refused rules reached the file"
  # the unit route: the file the card named, by hash; a swap since the card is refused
  printf '[Unit]\nDescription=x\n[Service]\nExecStart=/bin/true\n' > "$d/x.service"; sha=$(sha256sum "$d/x.service" | cut -d' ' -f1)
  out=$(cd "$d" && G unit "$d/x.service" "$sha" --by owner --card fghjk 2>&1); rc=$?
  k "$(t test "$rc" -eq 0)" "grant unit copies the unit file into the user unit dir: $out"
  k "$(t cmp -s "$d/x.service" "$d/units/x.service")" "…byte for byte"
  k "$(t grep -q 'unit x.service sha256 '"$sha"' .* by owner card fghjk' "$d/grants.log")" "…and logs it with its hash"
  printf 'ExecStart=/bin/false\n' >> "$d/x.service"
  out=$(cd "$d" && G unit "$d/x.service" "$sha" --by owner 2>&1); rc=$?
  k "$(t test "$rc" -ne 0)" "a unit file changed since the card named it is refused: $out"
  k "$(t test "$(grep -c . "$d/units/x.service")" -eq 4)" "…and the installed unit is the one the card approved, untouched"
  out=$(cd "$d" && G unit "$d/notes.txt" "$sha" --by owner 2>&1); k "$(t test $? -ne 0)" "a file that is not a .service/.timer is refused: $out"
  mkdir -p "$d/out"; cp "$d/units/x.service" "$d/out/y.service"; ln -s "$d/out/y.service" "$d/y.service"
  out=$(cd "$d" && GENV=CC_UNIT_ROOTS=$d/in G unit "$d/y.service" "$(sha256sum "$d/out/y.service" | cut -d' ' -f1)" --by owner 2>&1); rc=$?
  k "$(t test "$rc" -ne 0)" "a unit file outside the repo roots is refused, through a symlink inside them too: $out"
  rm -rf "$d"
  echo "cc-settings selfcheck: $((n - f)) passed, $f failed"
  [ "$f" -eq 0 ]
}

case "${1:-}" in
  check)     check ;;
  show)      show ;;
  apply)     apply ;;
  grant)     shift; grant "$@" ;;
  selfcheck) selfcheck ;;
  *)         echo "$USAGE" >&2; exit 2 ;;
esac
