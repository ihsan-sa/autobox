#!/usr/bin/env python3
"""cc-vitals — 24 h of the box's own vitals: one honest row a minute, normalised onto a single 0-100 axis.

WHY A RECORDER AT ALL. One instantaneous read a minute is a sample, not a minute: CPU and power swing hard from
second to second, so any single read is unrepresentative of the minute it stands for. This records the minute
itself — and the two kinds of metric are NOT aggregated the same way:

  COUNTERS — CPU busy (/proc/stat), package energy (RAPL). Monotonic totals, so the delta across the whole
    minute IS that minute's exact mean: no sampling error at all, and nothing to gain from reading them more
    than twice.
  GAUGES — RAM, load, temperature, disk. Nothing accumulates, so they are sampled every SAMPLE seconds and the
    MEAN is stored. The MAX is stored beside it: a minute that averaged 55 °C but touched 79 °C is a fact the
    mean hides, and it is the one worth seeing on a graph.

REAL UNITS ON DISK, NORMALISED ON READ. Rows carry watts, °C and GiB, plus the capacities they are a fraction
of. Normalisation happens in `series`, so a bigger disk or a lifted power limit re-scales the picture instead
of quietly falsifying the history already written.

ONE CHART, ONE AXIS (owner, 2026-08-30 — this overrides the small-multiples design). Every series is plotted as
a percentage of its OWN capacity on a single 0-100 axis: disk % used, RAM % of total, CPU %, load as % of core
count, temperature as % of its throttle point, watts as % of the package limit. That is one honest axis, not two
y-scales pretending to be one; the legend carries the real numbers, so the shapes are comparable and the values
are still true.

THE RESOLVER IS A READING TOO (2026-09-01). Two GitHub failures that morning ("Could not resolve host github.com",
04:37Z and 04:40Z) and cc-slackd's error cluster 5 were one DNS blip, and nothing on the box noticed it. So each
row also carries one lookup of github.com and slack.com through the SYSTEM resolver — getent, the nsswitch path git
and curl take — under a hard 2 s timeout, and #alerts hears about a FLIP only: down once, then back once with the
outage length, never a line a minute while it stays down. Resolver config and the network are never touched here.

THE MAIN CHECKOUT IS A READING TOO (2026-09-01, later that day). ~/bin symlinks into the control repo's main
checkout, so what is on disk there IS the live cc layer — and at 09:38Z two of its binaries were overwritten with an
unreviewed PR head and nothing noticed for 2.5 h. So each row also asks git, READ-ONLY, whether that checkout is a
clean origin/<default> or behind it: tracked files modified, a branch that is not the default, or commits ahead of
origin all count; an untracked file (a session's .claude/) and being behind (a pull pending) do not. Same flip rule.

THE RENDERER IS A SEAM, AND IT IS THE ONLY THING NOT DONE. Nothing on this box can draw a PNG (no matplotlib, no
PIL) and installing one is an owner-gated host change that has not been answered. Everything up to the pixels is
built and tested; render_png() is one function that raises RendererUnavailable, and render_text() — block
sparklines, no dependencies — works today. When the answer comes, that one function is the whole change.

  cc-vitals record [--once]         the recorder: one row a minute, then re-render (never in the tab's own path)
  cc-vitals series [--hours 24]     aggregated + normalised series, JSON on stdout
  cc-vitals render [--backend auto|text|png] [--if-stale SEC]   rewrite current.json + current.txt|png,
                                    atomically, in place; --if-stale redraws only a picture older than SEC
  cc-vitals show [--width N]        the text chart on stdout
  cc-vitals selfcheck               tests; touches nothing outside a temp dir
"""
import glob
import datetime as dt
import io
import json
import os
import re
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
DIR = os.environ.get("CC_VITALS_DIR") or f"{HOME}/.cc/state/vitals"
RAPL = os.environ.get("CC_VITALS_RAPL") or "/sys/class/powercap/intel-rapl:0"
THERMAL = os.environ.get("CC_VITALS_THERMAL") or "/sys/class/thermal"
PROCFS = os.environ.get("CC_VITALS_PROC") or "/proc"
ROOTFS = os.environ.get("CC_VITALS_ROOT") or "/"
PERIOD = 60          # one row per wall-clock minute; rows are stamped with the minute they COVER
SAMPLE = 6           # gauges every 6 s -> 10 samples a minute (a mean, not a lucky read)
KEEP_DAYS = 3        # 24 h of chart from ~290 KB/day of jsonl; a spare day covers a late look
STALE = 300          # a current.* older than this is not "current" and the tab must say so
TJMAX = 100.0        # the throttle denominator when a zone declares no usable passive/hot trip
HOSTS = ("github.com", "slack.com")   # what the box cannot work without: git/gh, and the Slack API
DNS_TIMEOUT = 2.0    # a lookup slower than this IS the outage, for git and curl alike
GETENT = os.environ.get("CC_VITALS_GETENT") or "getent"   # the system resolver; selfcheck points this at a stub
BIN = os.path.dirname(os.path.realpath(__file__))
GIT = os.environ.get("CC_VITALS_GIT") or "git"      # selfcheck points this at a stub for the hang case
REPO = os.environ.get("CC_VITALS_REPO") or BIN      # the control repo = the checkout this copy lives in (~/bin ->
GIT_TIMEOUT = 15                                    # <repo>/core/bin); git finds the top from any dir inside it

# ONE FIXED HUE PER METRIC, ASSIGNED IN THIS ORDER AND NEVER RECYCLED (owner, 2026-08-30). Slots come from the
# validated categorical palette in the dataviz reference, in its published order; slots 7 (violet) and 8 (red)
# are reserved for the next two metrics — a 9th never gets a generated hue, it folds in or the chart splits.
# The SURFACE is picked, not flipped: a PNG cannot answer the viewer's theme, so it is drawn opaque on the dark
# surface, where all six hues clear 3:1 (three of them do not on the light one). It reads as a card in Slack's
# light theme instead of fighting it, and it is the same image in both.
# Colour never identifies a series on its own: every line is labelled, the legend is always present and carries
# the real number, and each series has its own dash for print / forced-colours / the two CVD pairs that sit in
# the warn band (magenta-aqua, yellow-orange).
SURFACE = {"mode": "dark", "bg": "#1a1a19", "ink": "#ffffff", "ink2": "#c3c2b7", "grid": "#383835"}
SPEC = [
    {"key": "cpu",   "label": "CPU",   "slot": 1, "hue": "blue",    "light": "#2a78d6", "colour": "#3987e5", "dash": "solid",     "kind": "counter"},
    {"key": "ram",   "label": "RAM",   "slot": 2, "hue": "orange",  "light": "#eb6834", "colour": "#d95926", "dash": "6 2",       "kind": "gauge", "band": True},
    {"key": "load",  "label": "load",  "slot": 3, "hue": "aqua",    "light": "#1baf7a", "colour": "#199e70", "dash": "2 2",       "kind": "gauge"},
    {"key": "temp",  "label": "temp",  "slot": 4, "hue": "yellow",  "light": "#eda100", "colour": "#c98500", "dash": "8 3 2 3",   "kind": "gauge", "band": True},
    {"key": "watts", "label": "power", "slot": 5, "hue": "magenta", "light": "#e87ba4", "colour": "#d55181", "dash": "1 3",       "kind": "counter"},
    {"key": "disk",  "label": "disk",  "slot": 6, "hue": "green",   "light": "#008300", "colour": "#008300", "dash": "10 4",      "kind": "gauge"},
]
AGG = {"counter": "delta across the whole minute (the minute's exact mean)",
       "gauge": "mean of the minute's samples (max kept beside it)"}


def _read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except Exception:
        return default


def _iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:00Z", time.gmtime(t))


# ---------------------------------------------------------------- capacities: what each metric is a % OF ----
_ZONE = []


def zone():
    """(temp file, throttle °C) for ONE thermal zone, chosen by type and then held. The dashboard picks the
    warmest zone on every read, which is right for "how hot is it now" and wrong for a time series: a line that
    silently changes sensor is a line that lies. Preference order is package first, chassis last."""
    if _ZONE:
        return _ZONE[0]                                          # settled once: 10 samples a minute, forever
    zones = {}
    for z in sorted(glob.glob(f"{THERMAL}/thermal_zone*")):
        zones.setdefault(_read(f"{z}/type"), z)
    for want in ("x86_pkg_temp", "coretemp", "cpu-thermal", "acpitz"):
        if want in zones:
            z = zones[want]
            # The denominator is the THROTTLE point (passive/hot), never `critical`: critical is the shutdown
            # trip, and dividing by 119 °C would flatten the one line worth watching. No usable trip -> TJMAX.
            trips = [int(_read(f"{z}/trip_point_{i}_temp") or -1) / 1000
                     for i in range(16) if _read(f"{z}/trip_point_{i}_type") in ("passive", "hot")]
            trips = [t for t in trips if t > 0]
            _ZONE.append((f"{z}/temp", max(trips) if trips else TJMAX))
            return _ZONE[0]
    _ZONE.append((None, TJMAX))
    return _ZONE[0]


def power_limit():
    """The package's long-term power limit in W — the honest denominator for watts. Short-term (a boost window
    of a couple of ms) is not what a per-minute mean is a fraction of."""
    for c in sorted(glob.glob(f"{RAPL}/constraint_*_name")):
        if _read(c) == "long_term":
            uw = _read(c.replace("_name", "_power_limit_uw"))
            if uw.isdigit() and int(uw) > 0:
                return int(uw) / 1e6
    return None


def caps():
    """What every metric is a percentage of, discovered at RUNTIME — never a constant in this file. A capacity
    this box cannot report comes back None and that metric simply gets no line: a series with no honest
    denominator does not belong on a normalised axis."""
    v = os.statvfs(ROOTFS)
    mem = dict(re.findall(r"^(\w+):\s+(\d+) kB", _read(f"{PROCFS}/meminfo"), re.M))
    tot = int(mem.get("MemTotal", 0))
    _, tj = zone()
    return {"cores": os.cpu_count() or None,
            "ram_gb": round(tot / 1048576, 2) if tot else None,
            "disk_gb": round(v.f_frsize * v.f_blocks / 2**30, 1) or None,
            "temp_c": tj,
            "watts": power_limit()}


# ------------------------------------------------------------------------------- reading the box, one minute --
def counters():
    """The monotonic totals, read once at each end of the minute. Nothing here sleeps."""
    out = {"cpu": None, "uj": None, "wrap": None}
    parts = _read(f"{PROCFS}/stat").split("\n")[0].split()[1:]
    v = [int(x) for x in parts if x.isdigit()]
    if v:
        out["cpu"] = (sum(v), sum(v[3:5]))                       # (total, idle+iowait)
    uj = _read(f"{RAPL}/energy_uj")
    if uj.isdigit():
        out["uj"] = int(uj)
        w = _read(f"{RAPL}/max_energy_range_uj")
        out["wrap"] = int(w) if w.isdigit() else None
    return out


def gauges():
    """One instant of every gauge. Called SAMPLE seconds apart; all plain file reads, no subprocess."""
    v = os.statvfs(ROOTFS)
    mem = dict(re.findall(r"^(\w+):\s+(\d+) kB", _read(f"{PROCFS}/meminfo"), re.M))
    tot, avail = int(mem.get("MemTotal", 0)), int(mem.get("MemAvailable", 0))
    tz, _ = zone()
    t = _read(tz) if tz else ""
    return {"ram": round((tot - avail) / 1048576, 3) if tot else None,
            "load": round(os.getloadavg()[0], 2),
            # Used includes the root-reserved blocks, so this sits a little above `df`'s figure, which hides
            # them from its denominator. % of the filesystem's real size is the one that belongs on this axis.
            "disk": round((v.f_blocks - v.f_bfree) * v.f_frsize / 2**30, 2),
            "temp": round(int(t) / 1000, 2) if t.lstrip("-").isdigit() else None}


def aggregate(c0, c1, dt, samples, cap, start):
    """The whole aggregation, as a pure function of two counter reads and a list of gauge samples — which is why
    it can be tested without waiting a minute for anything."""
    row = {"t": _iso(start), "s": len(samples), "dt": round(dt, 2), "cap": cap}
    row["cpu"] = cpu_pct(c0, c1)
    row["watts"] = watts(c0, c1, dt)
    for k in ("ram", "load", "temp", "disk"):
        vals = [s[k] for s in samples if s.get(k) is not None]
        row[k] = {"m": round(sum(vals) / len(vals), 3), "x": round(max(vals), 3)} if vals else None
    return row


def cpu_pct(c0, c1):
    """Busy % for the minute, exact: (busy delta / total delta). No sampling, so nothing to be unlucky about."""
    if not c0.get("cpu") or not c1.get("cpu"):
        return None
    dtot, didle = c1["cpu"][0] - c0["cpu"][0], c1["cpu"][1] - c0["cpu"][1]
    if dtot <= 0:
        return None                                              # counter reset (a reboot inside the minute)
    return round(max(0.0, min(100.0, 100.0 * (dtot - didle) / dtot)), 2)


def watts(c0, c1, dt):
    """Mean package draw for the minute from the RAPL energy delta. The counter wraps at max_energy_range_uj;
    when the box tells us the range we add it back rather than throw the minute away, and a figure that comes
    out impossible after that is dropped instead of drawn."""
    u0, u1 = c0.get("uj"), c1.get("uj")
    if u0 is None or u1 is None or dt <= 0:
        return None
    d = u1 - u0
    if d < 0:
        if not c0.get("wrap"):
            return None
        d += c0["wrap"]
    w = d / 1e6 / dt
    return round(w, 3) if 0 <= w < 1000 else None


def record_minute(period=PERIOD, sample=SAMPLE):
    """One row: counters at both ends of the window, gauges every `sample` seconds in between. Deadlines are
    computed from a monotonic start, so a slow sample steals from the next one instead of drifting the minute."""
    t0, m0 = time.time(), time.monotonic()
    cap, c0, got = caps(), counters(), [gauges()]
    dn, co = dns(), checkout()       # once a minute, at most 2 s a host and 15 s a git call: deadlines below are
                                     # monotonic, so a slow lookup shifts the first sample, never the minute
    n = 1
    while n * sample < period:
        d = (m0 + n * sample) - time.monotonic()
        if d > 0:
            time.sleep(d)
        got.append(gauges())
        n += 1
    d = (m0 + period) - time.monotonic()
    if d > 0:
        time.sleep(d)
    row = aggregate(c0, counters(), time.monotonic() - m0, got, cap, t0 - (t0 % period))
    row["dns"], row["checkout"] = dn, co
    return row


# ---------------------------------------------------------------------- the resolver: one lookup a minute ----
def resolve(host, timeout=DNS_TIMEOUT):
    """ms for a lookup that answered, None for one that failed or hung. `getent hosts` is the system resolver
    itself — /etc/hosts, resolved, DNS in nsswitch order — so it fails exactly when git and curl would. The
    timeout is a kill, not a hint: a hung resolver must never become a hung recorder."""
    t = time.monotonic()
    try:
        ok = subprocess.run([GETENT, "hosts", host], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                            timeout=timeout).returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        ok = False
    return round((time.monotonic() - t) * 1000) if ok else None


def dns():
    """The reading: {host: ms | None}, once per row."""
    return {h: resolve(h) for h in HOSTS}


def _state(name):
    """A flip's memory, from disk: a file, not a variable, because the recorder restarts (RestartSec=10) and a
    fault must not be announced twice — nor re-announced by every tick it lasts."""
    try:
        return json.loads(_read(f"{DIR}/{name}") or "{}")
    except Exception:
        return {}


def _save(name, state):
    os.makedirs(DIR, exist_ok=True)
    with open(f"{DIR}/{name}.tmp", "w") as f:
        json.dump(state, f)
    os.replace(f"{DIR}/{name}.tmp", f"{DIR}/{name}")


def dns_flip(reading, now=None):
    """This tick against the last one ON DISK: the one line #alerts should hear, or None. Down is any host
    unresolved; back is all of them answering."""
    now = now or time.time()
    prev = _state("dns.json")
    down = sorted(h for h, ms in reading.items() if ms is None)
    since, line = prev.get("since"), None
    if down and not since:
        state = {"since": now, "hosts": down}
        line = f"dns down: {', '.join(down)} unresolved ({DNS_TIMEOUT:g} s timeout)"
    elif down:
        state = dict(prev, hosts=sorted(set(prev.get("hosts") or []) | set(down)))   # still down: say nothing
    elif since:
        state = {}
        line = f"dns back after {max(1, round((now - since) / 60))} min ({', '.join(prev.get('hosts') or [])})"
    else:
        return None                                              # up, was up: the normal minute
    if state != prev:
        _save("dns.json", state)
    return line


# ------------------------------------------------------------- the main checkout: one git status a minute ----
def git(*args, cwd=None, timeout=GIT_TIMEOUT):
    """stdout of one READ-ONLY git command, or None when it failed or hung. The recorder never fetches, pulls,
    checks out or writes in the checkout it watches — it is the thing that has to notice such writes — and it
    takes no optional lock, so a status here never trips over cc-land's pull, nor the pull over it."""
    try:
        p = subprocess.run([GIT, "--no-optional-locks", "-C", cwd or REPO, *args],   # never index.lock: a
                           capture_output=True, text=True, timeout=timeout)         # pull may be running there
    except (subprocess.TimeoutExpired, OSError):
        return None
    return p.stdout.rstrip("\n") if p.returncode == 0 else None


def checkout(repo=None):
    """The reading: {top, branch, default, dirty: [paths], ahead, behind} for the checkout `repo` is inside, or
    None where none can be read (a box installed from a tarball; git hung). Dirty means TRACKED files changed,
    staged or not — an untracked file is a session's scratch, not a live binary swapped. Behind is a pull
    pending, and fine. origin/<default> is the LOCAL ref: no network, ever."""
    top = git("rev-parse", "--show-toplevel", cwd=repo)
    st = git("status", "--porcelain", "--untracked-files=no", cwd=repo) if top is not None else None
    if st is None:
        return None
    head = git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD", cwd=repo) or ""
    default = head.split("/", 1)[1] if "/" in head else "main"
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=repo) or "?"
    lr = (git("rev-list", "--left-right", "--count", f"origin/{default}...HEAD", cwd=repo) or "0 0").split()
    return {"top": top, "branch": "detached HEAD" if branch == "HEAD" else branch, "default": default,
            "dirty": sorted(l[3:].split(" -> ")[-1] for l in st.splitlines() if l.strip()),
            "ahead": int(lr[1]), "behind": int(lr[0])}


def wrong(reading):
    """What is not right about the checkout, in the words #alerts will read; [] for a clean origin/<default>
    or one behind it."""
    if not reading:
        return []
    w = []
    if reading["dirty"]:
        w.append("modified " + ", ".join(reading["dirty"]))
    if reading["branch"] != reading["default"]:
        w.append(f"on {reading['branch']}, not {reading['default']}")
    if reading["ahead"]:
        w.append(f"{reading['ahead']} commit{'s' if reading['ahead'] != 1 else ''} ahead of origin/{reading['default']}")
    return w


def checkout_flip(reading, now=None):
    """The resolver's flip rule, on the checkout: one line when it stops being a clean origin/<default>, one when
    it is again, silence in between — and silence while it cannot be read: an unknown is not a fact, and must
    not close an open fault."""
    if reading is None:
        return None
    now = now or time.time()
    prev = _state("checkout.json")
    w, since, line = wrong(reading), prev.get("since"), None
    top, default = reading["top"].replace(HOME, "~", 1), reading["default"]
    if w and not since:
        state = {"since": now, "what": w}
        line = f"main checkout {top} is not a clean origin/{default} (~/bin runs from it): " + "; ".join(w)
    elif w:
        state = dict(prev, what=sorted(set(prev.get("what") or []) | set(w)))   # still wrong: say nothing
    elif since:
        state = {}
        line = (f"main checkout {top} is a clean origin/{default} again after {max(1, round((now - since) / 60))}"
                f" min ({'; '.join(prev.get('what') or [])})")
    else:
        return None                                              # clean, was clean: the normal minute
    if state != prev:
        _save("checkout.json", state)
    return line


def alert(line):
    """The box's one door outward. "<host> alerts" is the title shape cc-slack routes to #alerts even on a box that
    shares its name with a repo. The DOWN line may not get out — Slack's host is one of the two that just failed —
    which is why the BACK line carries the outage length; cc-notify logs both regardless. Never fatal: the row is
    the recorder's job, the notice is a courtesy."""
    box = socket.gethostname().split(".")[0]
    try:
        subprocess.run([f"{BIN}/cc-notify", "-t", f"{box} alerts", line],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=60)
    except Exception as e:
        print(f"cc-vitals: notify failed: {e}", file=sys.stderr)


def watch(row):
    """The per-tick half: every flip in the row becomes one alert. Returns what was said."""
    said = [l for l in (dns_flip(row.get("dns") or {}), checkout_flip(row.get("checkout"))) if l]
    for l in said:
        alert(l)
    return said


# ------------------------------------------------------------------------------------------------- storage ---
def _day(t):
    return time.strftime("%Y-%m-%d", time.gmtime(t))


def append(row):
    os.makedirs(DIR, exist_ok=True)
    with open(f"{DIR}/{row['t'][:10]}.jsonl", "a") as f:
        f.write(json.dumps(row, separators=(",", ":")) + "\n")


def prune(now=None):
    """A day older than KEEP_DAYS is not history, it is 290 KB nobody will read."""
    keep = {_day((now or time.time()) - i * 86400) for i in range(KEEP_DAYS)}
    for f in glob.glob(f"{DIR}/????-??-??.jsonl"):
        if os.path.basename(f)[:-6] not in keep:
            os.unlink(f)


def rows(hours=24, now=None):
    """Every row inside the window, oldest first. A half-written last line (power cut mid-append) is skipped,
    not fatal: the chart is worth more than the minute it loses."""
    now = now or time.time()
    out = []
    for day in sorted({_day(now - i * 3600) for i in range(int(hours) + 2)}):
        for line in _read(f"{DIR}/{day}.jsonl").splitlines():
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("t"):
                out.append(r)
    cut = _iso(now - hours * 3600)
    return sorted([r for r in out if r["t"] >= cut], key=lambda r: r["t"])


# ------------------------------------------------------------- normalisation: six metrics, one 0-100 axis ---
def cap_of(key, cap):
    return {"cpu": 100.0, "ram": cap.get("ram_gb"), "load": cap.get("cores"),
            "temp": cap.get("temp_c"), "watts": cap.get("watts"), "disk": cap.get("disk_gb")}.get(key)


def norm(key, real, cap):
    """Real value -> % of that metric's own capacity. NOT clipped: load can exceed the core count and a box that
    is over its limit must be able to say so. The renderer clips the axis and flags it; the data stays true."""
    c = cap_of(key, cap)
    return None if real is None or not c else round(100.0 * real / c, 2)


def text(key, real, cap):
    """The legend's real number — the reason a normalised axis is still honest."""
    c = cap_of(key, cap)
    if real is None:
        return "—"
    return {"cpu": lambda: f"{real:.0f}%",
            "ram": lambda: f"{real:.1f}/{c:.0f}G",
            "load": lambda: f"{real:.2f}",
            "temp": lambda: f"{real:.0f}°C",
            "watts": lambda: f"{real:.1f}W",
            "disk": lambda: f"{real:.0f}/{c:.0f}G"}[key]()


def cap_text(key, cap):
    c = cap_of(key, cap)
    return {"cpu": "100%", "ram": f"{c:.0f}G", "load": f"{cap.get('cores')} cores",
            "temp": f"{c:.0f}°C throttle", "watts": f"{c:.0f}W limit", "disk": f"{c:.0f}G"}[key] if c else ""


def value(row, key):
    v = row.get(key)
    if isinstance(v, dict):
        return v.get("m"), v.get("x")
    return v, None


def build(hours=24, now=None, data=None):
    """The chart's whole payload: a DENSE minute axis, so a minute with no row is a null and reads as a break.
    Interpolating across a power cut would draw a line through time the box spent switched off."""
    now = now or time.time()
    data = rows(hours, now) if data is None else data
    end = now - (now % 60) - 60          # the last COMPLETE minute: the one in progress has no row yet, and an
    n = int(hours * 60) + 1              # axis ending on it would put a permanent gap at the right of every chart
    t0 = end - (n - 1) * 60
    at = {r["t"]: r for r in data}
    cap = (data[-1].get("cap") if data else None) or caps()
    out = []
    for s in SPEC:
        k = s["key"]
        if not cap_of(k, cap):
            continue                                             # no honest denominator -> no line, not a guess
        col = dict(s)
        col.pop("band", None)
        pts, real, band, over = [], [], [], False
        for i in range(n):
            r = at.get(_iso(t0 + i * 60))
            m, x = value(r, k) if r else (None, None)
            # Each row is normalised against ITS OWN recorded capacity: history stays true across a disk resize.
            rc = (r.get("cap") if r else None) or cap
            p = norm(k, m, rc)
            pts.append(p)
            real.append(m)
            band.append(norm(k, x, rc))
            over = over or (p is not None and p > 100)
        cur = next((i for i in range(n - 1, -1, -1) if pts[i] is not None), None)
        col.update({"cap": cap_of(k, cap), "cap_text": cap_text(k, cap), "agg": AGG[s["kind"]],
                    "norm": pts, "real": real, "norm_max": band if s.get("band") else None, "over": over,
                    "now": {"norm": pts[cur], "real": real[cur], "text": text(k, real[cur], cap)} if cur is not None
                           else {"norm": None, "real": None, "text": "—"}})
        out.append(col)
    # Counted off the AXIS, not off the file: a row outside the window must not be reported as recorded, or
    # `minutes` and a chart of six empty lines say different things about the same window.
    placed = sum(1 for i in range(n) if _iso(t0 + i * 60) in at)
    return {"generated": _iso(now), "window_h": hours, "t0": int(t0), "step": 60, "n": n,
            "minutes": placed, "gaps": n - placed, "stale_after": STALE,
            "surface": SURFACE, "caps": cap, "dns": data[-1].get("dns") if data else None,
            "checkout": data[-1].get("checkout") if data else None,
            "axis": {"min": 0, "max": 100, "label": "% of each metric's own capacity",
                     "note": "one axis, six capacities; the legend carries the real numbers. Values over 100 "
                             "are real (load can exceed the core count) — the renderer clips and flags them."},
            "series": out}


# ----------------------------------------------------------------------------------------- THE ONE SEAM -----
def chart_tz():
    """The zone the chart's axis is labelled in. The PNG goes to Slack, so it is the owner's clock and carries no
    Z; the rows behind it stay UTC — `_iso` keys every one of them. cc-time names the zone (COMMS.md)."""
    try:
        import importlib.machinery
        import importlib.util
        spec = importlib.util.spec_from_loader("cctime",
                                               importlib.machinery.SourceFileLoader("cctime", f"{BIN}/cc-time"))
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        return m.tz()
    except Exception:
        return dt.datetime.now().astimezone().tzinfo    # this box's own zone — matplotlib's own default is UTC


class RendererUnavailable(Exception):
    """The chart cannot be drawn on this box yet — see render_png()."""


BLOCKS = " ▁▂▃▄▅▆▇█"


def render_text(spec, width=60):
    """The fallback that works TODAY, with nothing installed: one block sparkline per metric, the label beside
    it (never colour alone) and the real number at the end. Empty buckets stay blank, so a gap looks like one."""
    out = [f"vitals · last {spec['window_h']}h · {spec['minutes']} of {spec['n']} minutes recorded"
           f"{' · ' + str(spec['gaps']) + ' missing' if spec['gaps'] > 0 else ''} · {spec['generated']}"]
    for s in spec["series"]:
        bar = ""
        for i in range(width):
            lo, hi = i * spec["n"] // width, max(i * spec["n"] // width + 1, (i + 1) * spec["n"] // width)
            vals = [v for v in s["norm"][lo:hi] if v is not None]
            bar += BLOCKS[0] if not vals else BLOCKS[max(1, min(8, int(sum(vals) / len(vals) / 12.5) + 1))]
        out.append(f"{s['label']:>5} {bar} {s['now']['text']:>11}  /{s['cap_text']}"
                   + ("  ⚠ over" if s["over"] else ""))
    span = f"{spec['window_h']:g}h ago"
    out.append(f"      {span}{'now'.rjust(max(1, width - len(span)))}   block height = 0-100% of each "
               f"metric's own capacity")
    return "\n".join(out) + "\n"


def render_png(spec, out):
    """THE SEAM, AND THE ONLY THING LEFT. Drawing a PNG needs a charting library and this box has none — no
    matplotlib, no PIL — so installing one is a host change only the owner may approve. That question is open
    (board note, 2026-08-30), so this raises instead of guessing.

    When the answer comes, THIS FUNCTION IS THE WHOLE CHANGE: `spec` already carries everything a renderer
    needs — the dense minute axis (t0/step/n), each series' normalised points, its max band where the owner
    wanted one, its fixed colour for both surfaces, its dash, its label and its legend text. Draw a 0-100 axis,
    clip anything above it and mark the series `over`, plot on SURFACE['bg'] opaque, label every line, keep the
    legend. Nothing else in this file moves."""
    try:
        import matplotlib
        matplotlib.use("Agg")                      # headless box: no display, never a GUI backend
        import matplotlib.pyplot as plt
        from matplotlib.dates import DateFormatter
    except Exception as e:                         # a box without it still gets the text chart, never an exception
        raise RendererUnavailable(f"matplotlib is not importable ({e}) — text chart written instead")

    sf, ax_spec = spec["surface"], spec["axis"]
    t0, step, n = spec["t0"], spec["step"], spec["n"]
    xs = [dt.datetime.fromtimestamp(t0 + i * step, dt.timezone.utc) for i in range(n)]
    dark = sf.get("mode") == "dark"

    fig, ax = plt.subplots(figsize=(10.0, 4.4), dpi=110)
    fig.patch.set_facecolor(sf["bg"]); ax.set_facecolor(sf["bg"])
    for side in ("top", "right"):
        ax.spines[side].set_visible(False)
    for side in ("left", "bottom"):
        ax.spines[side].set_color(sf["grid"])
    ax.grid(True, axis="y", color=sf["grid"], linewidth=0.6, alpha=0.7)
    ax.set_axisbelow(True)

    for sr in spec["series"]:
        colour = sr["colour"] if dark else sr.get("light", sr["colour"])
        dash = sr.get("dash") or "solid"
        style = {"linestyle": "solid"} if dash == "solid" else {"dashes": [float(x) for x in str(dash).split()]}
        nan = float("nan")                         # a gap must BREAK the line, not join across the missing minutes
        ys = [nan if v is None else min(v, ax_spec["max"]) for v in sr["norm"]]    # clip: `over` says it was higher
        ax.plot(xs, ys, color=colour, linewidth=1.6, solid_capstyle="round",
                label=f"{sr['label']} · {sr['now']['text']}" if isinstance(sr.get("now"), dict)
                      and sr["now"].get("text") else sr["label"], **style)
        band = sr.get("norm_max")                  # the max the mean would otherwise hide (temp, RAM)
        if band:
            hi = [nan if v is None else min(v, ax_spec["max"]) for v in band]
            ax.fill_between(xs, ys, hi, color=colour, alpha=0.16, linewidth=0)

    ax.set_ylim(ax_spec["min"], ax_spec["max"]); ax.set_xlim(xs[0], xs[-1])
    ax.set_ylabel(ax_spec["label"], color=sf["ink2"], fontsize=9)
    ax.tick_params(colors=sf["ink2"], labelsize=8.5)
    ax.xaxis.set_major_formatter(DateFormatter("%H:%M", tz=chart_tz()))
    over = [sr["label"] for sr in spec["series"] if sr.get("over")]
    title = f"{spec['minutes']} of {n} minutes recorded"
    if over:
        title += " · over 100%: " + ", ".join(over)          # clipped lines say so rather than lying flat at the top
    ax.set_title(title, color=sf["ink2"], fontsize=9, loc="left")
    leg = ax.legend(loc="upper left", ncol=3, fontsize=8.5, frameon=False,
                    labelcolor=sf["ink"], borderaxespad=0.4)   # 6 series: a legend is not optional
    for t in leg.get_texts():
        t.set_color(sf["ink"])
    fig.tight_layout(pad=0.8)
    buf = io.BytesIO()                                         # RETURN the bytes: put() does the temp-file-and-rename,
    fig.savefig(buf, format="png", facecolor=sf["bg"], edgecolor="none")   # so a tab reading mid-write never sees half
    plt.close(fig)                                             # a chart. Opaque: Slack composites on its own surface.
    return buf.getvalue()


BACKENDS = {"text": "txt", "png": "png"}


def drawn_at(name="current.png"):
    """When the drawing on disk was made (mtime), or 0 — the ONE fact a tab needs to say how old its picture is."""
    try:
        return os.path.getmtime(f"{DIR}/{name}")
    except OSError:
        return 0.0


def fresh(sec, name="current.png"):
    """Is the drawing younger than `sec`? The whole point of --if-stale: a redraw every minute costs matplotlib
    for a 24 h chart that moved 0.07 %, and a redraw NEVER is how current.png sat four hours behind the data."""
    return (time.time() - drawn_at(name)) < float(sec)


def render(backend="auto", width=60, spec=None, if_stale=None):
    """Rewrite the current chart IN PLACE — one file per backend, never a growing pile of images. Written to a
    temp file and renamed, so a tab reading while we write never sees half a chart.

    `if_stale` makes the call IDEMPOTENT: a caller on a timer asks for a redraw every tick and pays for one only
    when the picture is actually older than that many seconds. Returns ([], "") when it skipped."""
    if if_stale is not None and fresh(if_stale) and fresh(if_stale, "current.json"):
        return [], ""
    spec = spec or build()
    os.makedirs(DIR, exist_ok=True)
    wrote, why = [], ""

    def put(name, data):
        tmp = f"{DIR}/.{name}.tmp"
        mode = "wb" if isinstance(data, bytes) else "w"
        with open(tmp, mode) as f:
            f.write(data)
        os.replace(tmp, f"{DIR}/{name}")
        wrote.append(name)

    put("current.json", json.dumps(spec, separators=(",", ":")))   # the data the tab reads, chart or no chart
    if backend in ("auto", "png"):
        try:
            put("current.png", render_png(spec, f"{DIR}/current.png"))
        except RendererUnavailable as e:
            why = str(e)
            if backend == "png":
                raise
    if backend in ("auto", "text") or why:
        put("current.txt", render_text(spec, width))
    return wrote, why


# ------------------------------------------------------------------------------------------------ commands ---
def cmd_record(opt):
    period, sample = int(opt.get("--period", PERIOD)), int(opt.get("--sample", SAMPLE))
    if period == PERIOD and "--once" not in opt:
        time.sleep(PERIOD - (time.time() % PERIOD))               # land rows on the wall-clock minute
    while True:
        row = record_minute(period, sample)
        append(row)
        watch(row)                   # a flip is one line to #alerts; a steady state, good or bad, is silence
        prune()
        try:
            render()                     # on a real change, once a minute — never inside the tab's refresh path
        except Exception as e:
            print(f"cc-vitals: render failed: {e}", file=sys.stderr)
        if "--once" in opt:
            print(json.dumps(row, separators=(",", ":")))
            return 0


def cmd_series(opt):
    print(json.dumps(build(float(opt.get("--hours", 24))), indent=None if "--raw" in opt else 1))
    return 0


def cmd_render(opt):
    stale = opt.get("--if-stale")
    wrote, why = render(opt.get("--backend", "auto"), int(opt.get("--width", 60)),
                        if_stale=None if stale in (None, True) else float(stale))
    if not wrote:
        print(f"cc-vitals: current (drawn {int(time.time() - drawn_at())}s ago) — nothing redrawn")
        return 0
    print(f"cc-vitals: wrote {', '.join(wrote)} in {DIR}" + (f"\ncc-vitals: {why}" if why else ""))
    return 0


def cmd_show(opt):
    sys.stdout.write(render_text(build(float(opt.get("--hours", 24))), int(opt.get("--width", 60))))
    return 0


def flags(argv):
    opt = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a.startswith("--") and i + 1 < len(argv) and not argv[i + 1].startswith("--"):
            opt[a] = argv[i + 1]
            i += 2
        else:
            opt[a] = True
            i += 1
    return opt


def main(argv):
    cmds = {"record": cmd_record, "series": cmd_series, "render": cmd_render, "show": cmd_show,
            "selfcheck": lambda o: selfcheck()}
    cmd = argv[0] if argv else ""
    if cmd not in cmds or "--help" in argv or "-h" in argv:
        print(__doc__.strip())
        return 0 if cmd in cmds else 2
    return cmds[cmd](flags(argv[1:]))




# ----------------------------------------------------------------------------------------------- selfcheck ---
CAP = {"cores": 6, "ram_gb": 30.6, "disk_gb": 457.0, "temp_c": 100.0, "watts": 35.0}


def _row(t, cap=None, cpu=10.0, w=8.0, ram=4.3, load=3.0, temp=55.0, tx=79.0, disk=49.0):
    return {"t": _iso(t), "s": 10, "dt": 60.0, "cap": cap or CAP, "cpu": cpu, "watts": w,
            "ram": {"m": ram, "x": ram}, "load": {"m": load, "x": load},
            "temp": {"m": temp, "x": tx}, "disk": {"m": disk, "x": disk}}


def selfcheck():
    """Everything that does not need pixels, proved: the two aggregations, the normalisation, the gaps, the
    palette rules and the seam. Runs in a temp dir — the live vitals are never read or written."""
    import shutil
    import tempfile
    tmp = tempfile.mkdtemp(prefix="cc-vitals-")
    live, globals()["DIR"] = DIR, tmp
    n = [0, 0]

    def check(name, ok):
        n[0 if ok else 1] += 1
        print(f"  {'OK' if ok else 'XX'} {name}")

    try:
        # -- COUNTERS: the delta across the minute IS the minute's mean, so these are exact, not sampled ------
        c0 = {"cpu": (1000, 800), "uj": 1_000_000, "wrap": 262_143_328_850}
        c1 = {"cpu": (2000, 1050), "uj": 601_000_000, "wrap": 262_143_328_850}
        r = aggregate(c0, c1, 60.0, [gauges()], CAP, 0)
        check("counter CPU: 1000 ticks, 250 idle -> exactly 75% busy for the minute", r["cpu"] == 75.0)
        check("counter power: 600 J over 60 s -> exactly 10.0 W", r["watts"] == 10.0)
        check("a counter reset mid-minute, as a restart does, drops the figure instead of drawing a spike",
              cpu_pct({"cpu": (2000, 1050)}, {"cpu": (10, 5)}) is None)
        w = {"cpu": None, "uj": 500_000, "wrap": 262_143_328_850}
        check("RAPL wrap is added back, not thrown away",
              watts({"cpu": None, "uj": 262_143_000_000, "wrap": 262_143_328_850}, w, 60.0) is not None)
        check("a wrap we cannot size is dropped rather than invented",
              watts({"cpu": None, "uj": 262_143_000_000, "wrap": None}, w, 60.0) is None)

        # -- GAUGES: mean AND max, because the mean hides the spike the owner asked to see ---------------------
        g = [{"ram": 4.0, "load": 1.0, "temp": 45.0, "disk": 49.0},
             {"ram": 6.0, "load": 3.0, "temp": 79.0, "disk": 49.0},
             {"ram": 5.0, "load": 2.0, "temp": 41.0, "disk": 49.0}]
        r = aggregate(c0, c1, 60.0, g, CAP, 0)
        check("gauge mean is the mean of the minute's samples, not one lucky read", r["temp"]["m"] == 55.0)
        check("the minute that averaged 55 C but touched 79 C keeps the 79", r["temp"]["x"] == 79.0)
        check("RAM keeps its max too", r["ram"]["x"] == 6.0)
        check("a sensor this box does not have is None, not a zero on the chart",
              aggregate(c0, c1, 60.0, [{"ram": 4.0, "load": 1.0, "disk": 9.0, "temp": None}], CAP, 0)["temp"] is None)

        # -- NORMALISATION: six capacities, one 0-100 axis -----------------------------------------------------
        check("load 3.00 on 6 cores is 50% of the box", norm("load", 3.0, CAP) == 50.0)
        check("55 C against a 100 C throttle is 55%", norm("temp", 55.0, CAP) == 55.0)
        check("17.5 W against a 35 W package limit is 50%", norm("watts", 17.5, CAP) == 50.0)
        check("49 G of 457 G is 10.72%", norm("disk", 49.0, CAP) == 10.72)
        check("the legend carries the real number, so the axis can be a percentage",
              text("ram", 4.3, CAP) == "4.3/31G" and text("temp", 55.0, CAP) == "55°C")
        check("load over the core count is NOT clamped - a box over its limit must be able to say so",
              norm("load", 9.0, CAP) == 150.0)
        s = build(0.05, now=600, data=[_row(600 - 60, load=9.0)])
        check("...and the series is flagged `over` for the renderer to mark",
              [x for x in s["series"] if x["key"] == "load"][0]["over"] is True)

        # -- REAL UNITS ON DISK: capacity changes re-scale the picture, they do not rewrite history ------------
        big = dict(CAP, disk_gb=914.0)
        s = build(0.05, now=600, data=[_row(600 - 120, cap=CAP), _row(600 - 60, cap=big)])
        d = [x for x in s["series"] if x["key"] == "disk"][0]
        check("a row is normalised against the capacity IT recorded: disk grew, same 49 G, half the %",
              d["norm"][-2] == 10.72 and d["norm"][-1] == 5.36 and d["real"][-1] == 49.0)

        # -- GAPS: a power cut is a break in the line, never a line drawn through the dark ---------------------
        s = build(0.05, now=600, data=[_row(600 - 180), _row(600 - 60)])
        c = [x for x in s["series"] if x["key"] == "cpu"][0]
        check("a minute with no row is a null on a dense axis, not an interpolation",
              c["norm"] == [None, 10.0, None, 10.0])
        check("the axis ends on the last COMPLETE minute, so a chart never opens with a trailing gap",
              s["t0"] + (s["n"] - 1) * s["step"] == 540)
        check("the payload says how much of the window is missing", s["gaps"] == 2 and s["minutes"] == 2)
        check("`now` is the newest minute that has data", c["now"]["real"] == 10.0)

        # -- a metric with no honest denominator gets no line --------------------------------------------------
        s = build(0.05, now=600, data=[_row(600 - 60, cap=dict(CAP, watts=None))])
        check("no package power limit -> no watts line, rather than a guessed one",
              not [x for x in s["series"] if x["key"] == "watts"])

        # -- PALETTE: one fixed hue per metric, in a fixed order, never recycled -------------------------------
        hues = [x["hue"] for x in SPEC]
        check("six metrics, six hues, no hue used twice", len(hues) == len(set(hues)) == 6)
        check("slots are the fixed published order 1..6, never reassigned",
              [x["slot"] for x in SPEC] == [1, 2, 3, 4, 5, 6])
        check("no series is identified by colour alone: every one has a label and its own dash",
              all(x["label"] and x["dash"] for x in SPEC) and len({x["dash"] for x in SPEC}) == 6)
        check("the surface is chosen, not flipped: one opaque image for both Slack themes",
              SURFACE["mode"] == "dark" and SURFACE["bg"].startswith("#"))
        s = build(0.05, now=600, data=[_row(600 - 60)])
        check("every series ships both surfaces' hex, so the seam never has to pick a colour",
              all(x["colour"] and x["light"] for x in s["series"]))
        check("temperature and RAM carry the max band the owner asked for; the others do not",
              all((x["norm_max"] is not None) == (x["key"] in ("temp", "ram")) for x in s["series"]))

        # -- THE CLOCK: the picture is for the owner, the rows behind it are for machines -----------------------
        _tz, INSTANT = os.environ.get("CC_TZ"), 1788274921       # 2026-09-01 15:02 UTC = 2026-09-02 00:02 in Tokyo
        try:
            os.environ["CC_TZ"] = "Asia/Tokyo"                   # a zone of its own, never this box's: the DAY moves too
            label = dt.datetime.fromtimestamp(INSTANT, chart_tz()).strftime("%H:%M")
        finally:
            os.environ.pop("CC_TZ", None) if _tz is None else os.environ.__setitem__("CC_TZ", _tz)
        check("the chart's axis is labelled in the owner's zone with no Z — the PNG goes to Slack, and a UTC axis "
              "is what the owner was reading off it (2026-09-01)",
              label == "00:02" and "Z" not in label)
        check("...while the row that minute is recorded under is still UTC and still ends in Z",
              _iso(INSTANT) == "2026-09-01T15:02:00Z")

        # -- THE SEAM (closed 2026-08-31: the owner approved the install, so the renderer is real) --------------
        png = render_png(s, f"{tmp}/x.png")
        check("the PNG backend returns real PNG BYTES — put() does the atomic rename, so a tab reading while we "
              "write never sees half a chart",
              isinstance(png, bytes) and png[:8] == b"\x89PNG\r\n\x1a\n" and len(png) > 4000)
        t = render_text(s, 20)
        check("the text chart still works, and is what a box with no library gets", "CPU" in t and "temp" in t)
        check("...and labels each line with its real number", "/457G" in t)
        wrote, why = render("auto")
        check("render writes the data payload whether or not a chart can be drawn", "current.json" in wrote)
        check("auto draws the picture AND keeps the text one beside it — the text is what shows while a fresh "
              "image is being made, and in the first hour after a boot",
              "current.png" in wrote and "current.txt" in wrote and not why)
        _mpl = sys.modules.get("matplotlib")                  # a box WITHOUT the library must still degrade, not raise
        sys.modules["matplotlib"] = None
        try:
            wrote2, why2 = render("auto")
        finally:
            sys.modules["matplotlib"] = _mpl if _mpl is not None else sys.modules.pop("matplotlib", None)
        check("no library: it falls back to the text chart and says why, instead of raising",
              "current.txt" in wrote2 and "matplotlib" in why2)
        check("current.json is valid JSON with a dense axis", json.load(open(f"{tmp}/current.json"))["step"] == 60)
        check("nothing is left half-written: temp files are renamed into place", not glob.glob(f"{tmp}/.*.tmp"))

        # -- --if-stale: the flag that keeps a tab's picture honest without redrawing it every tick -------------
        check("a fresh picture is NOT redrawn: --if-stale skips, and says so by writing nothing",
              render("auto", if_stale=3600) == ([], ""))
        old_t = drawn_at()
        os.utime(f"{tmp}/current.png", (old_t - 7200, old_t - 7200))
        os.utime(f"{tmp}/current.json", (old_t - 7200, old_t - 7200))
        check("a stale one IS redrawn — this is the bug that left current.png four hours behind the data",
              "current.png" in render("auto", if_stale=300)[0] and drawn_at() > old_t - 60)
        check("drawn_at reports the age of the drawing itself, which is what a tab must show when it is old",
              drawn_at() > 0 and fresh(300) and not fresh(0.0001))
        check("a picture that was never drawn is not silently 'now'", drawn_at("nosuch.png") == 0.0)

        # -- STORAGE -------------------------------------------------------------------------------------------
        append(_row(600))
        append(_row(660))
        check("rows append one JSON line per minute to that UTC day's file",
              len(_read(f"{tmp}/1970-01-01.jsonl").splitlines()) == 2)
        open(f"{tmp}/2000-01-01.jsonl", "w").write("{}\n")
        open(f"{tmp}/{_day(time.time())}.jsonl", "a").write("not json\n")
        prune()
        check("days past KEEP_DAYS are pruned, today's is kept",
              not os.path.exists(f"{tmp}/2000-01-01.jsonl") and os.path.exists(f"{tmp}/{_day(time.time())}.jsonl"))
        check("a half-written last line is skipped, it does not take the chart down", isinstance(rows(24), list))

        # -- THE RESOLVER, stubbed: a reading like the others, and #alerts hears a FLIP only --------------------
        def stub(body):                                          # a fake `getent hosts <host>`; $2 is the host
            path = f"{tmp}/getent"
            with open(path, "w") as f:
                f.write("#!/bin/sh\n" + body + "\n")
            os.chmod(path, 0o755)
            return path
        said, live_getent, live_alert = [], GETENT, alert
        globals()["alert"] = said.append
        try:
            globals()["GETENT"] = stub("exit 0")
            r = dns()
            check("both hosts answer -> a ms reading per host, kept in the row like the other readings",
                  set(r) == set(HOSTS) and all(isinstance(v, int) for v in r.values()))
            check("up, and was up: nothing said, no state file", not watch({"dns": r}) and not said
                  and not os.path.exists(f"{tmp}/dns.json"))
            globals()["GETENT"] = stub('[ "$2" = github.com ] && exit 2; exit 0')
            r = dns()
            check("a failed lookup is None, not a number", r["github.com"] is None and r["slack.com"] is not None)
            check("the first failed lookup is the DOWN flip, naming the host that failed",
                  watch({"dns": r}) and len(said) == 1 and "down" in said[0] and "github.com" in said[0]
                  and "slack.com" not in said[0])
            globals()["GETENT"] = stub("exit 2")
            r = dns()
            check("still down, now both hosts: NO repeat — an outage is one line, not one a minute",
                  dns_flip(r, now=time.time() + 60) is None and dns_flip(r, now=time.time() + 120) is None
                  and not watch({"dns": r}) and len(said) == 1)
            globals()["GETENT"] = stub("sleep 5")
            t = time.monotonic()
            check("a HUNG resolver is None after the timeout, not a hung recorder",
                  resolve("github.com", timeout=0.3) is None and time.monotonic() - t < 2)
            globals()["GETENT"] = stub("exit 0")
            r = dns()
            up = dns_flip(r, now=time.time() + 240)
            check("back: the UP flip once, carrying the outage length and every host that was out",
                  bool(up) and "back after 4 min" in up and "github.com, slack.com" in up)
            check("...and the state is cleared, so the next blip is a new outage, not a repeat",
                  dns_flip(r) is None and json.loads(_read(f"{tmp}/dns.json")) == {})
        finally:
            globals()["GETENT"], globals()["alert"] = live_getent, live_alert
        # the door itself: cc-notify told to log and not push, and a _selfcheck marker its own gate stops anyway
        env = {k: os.environ.get(k) for k in ("CC_NOTIFY_LOG_ONLY", "CC_NOTIFY_LOG")}
        os.environ.update(CC_NOTIFY_LOG_ONLY="1", CC_NOTIFY_LOG=f"{tmp}/notify.log")
        try:
            alert("dns back after 1 min (_selfcheck)")
        finally:
            for k, v in env.items():
                os.environ.pop(k, None) if v is None else os.environ.__setitem__(k, v)
        check("a flip goes out through cc-notify under the '<box> alerts' title cc-slack routes to #alerts",
              f"\t{socket.gethostname().split('.')[0]} alerts\tdns back" in _read(f"{tmp}/notify.log"))

        # -- THE MAIN CHECKOUT, on a throwaway clone: clean is silence, anything else is one line, back is one ---
        genv = dict(os.environ, HOME=tmp, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1",
                    GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")

        def g(*a, cwd=None):
            subprocess.run(["git", *a], cwd=cwd, env=genv, check=True, stdout=subprocess.DEVNULL,
                           stderr=subprocess.DEVNULL)

        def commit(repo, name, body):
            with open(f"{repo}/{name}", "w") as fh:
                fh.write(body)
            g("add", "-A", cwd=repo)
            g("commit", "-qm", name, cwd=repo)
        origin, box = f"{tmp}/origin", f"{tmp}/dev/box"
        g("init", "-q", "-b", "main", origin)
        commit(origin, "f", "one\n")
        os.makedirs(f"{box}")
        g("clone", "-q", origin, box)
        os.makedirs(f"{box}/core/bin")                           # where this script would live in it
        said.clear()
        globals()["alert"] = said.append
        try:
            r = checkout(f"{box}/core/bin")
            check("a clean clone, read from a dir inside it as ~/bin -> <repo>/core/bin is: on the default branch, "
                  "nothing modified, level with origin", bool(r) and r["top"] == box and r["branch"] == r["default"]
                  == "main" and r["dirty"] == [] and r["ahead"] == r["behind"] == 0)
            check("clean, was clean: nothing said, no state file", not watch({"checkout": r}) and not said
                  and not os.path.exists(f"{tmp}/checkout.json"))
            with open(f"{box}/f", "w") as fh:
                fh.write("overwritten\n")
            with open(f"{box}/scratch", "w") as fh:
                fh.write("x")
            r = checkout(box)
            check("a tracked file rewritten in place is dirty; the untracked file beside it is not",
                  r["dirty"] == ["f"])
            check("the first dirty tick is the flip: one line naming the checkout and the file",
                  watch({"checkout": r}) and len(said) == 1 and f"main checkout {box}" in said[0]
                  and "not a clean origin/main" in said[0] and "modified f" in said[0] and "scratch" not in said[0])
            g("checkout", "-q", "-b", "track/x", cwd=box)
            r = checkout(box)
            check("still wrong, now off the branch too: NO repeat", r["branch"] == "track/x"
                  and checkout_flip(r, now=time.time() + 60) is None and len(said) == 1)
            globals()["GIT"] = stub("sleep 5")
            t = time.monotonic()
            check("a HUNG git is None after the timeout, not a hung recorder — and an unreadable tick does not "
                  "close the open fault", git("status", cwd=box, timeout=0.3) is None and time.monotonic() - t < 2
                  and checkout_flip(None) is None and _state("checkout.json").get("since"))
            globals()["GIT"] = "git"
            g("checkout", "-q", "-f", "main", cwd=box)
            r = checkout(box)
            back = checkout_flip(r, now=time.time() + 150 * 60)
            check("a clean main again (scratch still untracked): the UP line once, with the length and what was wrong",
                  r["dirty"] == [] and bool(back) and "clean origin/main again after 150 min" in back
                  and "modified f" in back and "track/x" in back)
            check("...and the state is cleared", checkout_flip(r) is None
                  and json.loads(_read(f"{tmp}/checkout.json")) == {})
            commit(box, "g", "local\n")
            r = checkout(box)
            check("a commit origin does not have is ahead, and a fault",
                  r["ahead"] == 1 and "1 commit ahead of origin/main" in (checkout_flip(r) or ""))
            g("reset", "-q", "--hard", "origin/main", cwd=box)
            check("level again: closed", "again after" in (checkout_flip(checkout(box), now=time.time() + 60) or ""))
            commit(origin, "h", "upstream\n")
            g("fetch", "-q", cwd=box)
            r = checkout(box)
            check("behind origin is a pull pending, not a fault", r["behind"] == 1 and wrong(r) == []
                  and checkout_flip(r) is None)
            g("init", "-q", "-b", "trunk", f"{tmp}/o2")
            commit(f"{tmp}/o2", "f", "1\n")
            g("clone", "-q", f"{tmp}/o2", f"{tmp}/trunk")
            check("the default branch is whatever origin's HEAD says, not the word main",
                  checkout(f"{tmp}/trunk")["default"] == "trunk" and wrong(checkout(f"{tmp}/trunk")) == [])
            check("no checkout at all is None, not a fault", checkout(tmp) is None and checkout_flip(None) is None)
        finally:
            globals()["GIT"], globals()["alert"] = "git", live_alert

        # -- and one real minute end to end, short --------------------------------------------------------------
        r = record_minute(period=2, sample=1)
        check("record_minute reads this box and returns a whole row",
              r["s"] >= 2 and r["cap"]["cores"] and r["load"]["m"] is not None and r["dt"] >= 2)
        check("the row is stamped with the minute it covers, on the minute", r["t"].endswith(":00Z"))
        check("...with the resolver reading in it", set(r["dns"]) == set(HOSTS))
        check("...and the checkout reading (this copy lives in a repo)", "checkout" in r and r["checkout"]["top"])
    finally:
        globals()["DIR"] = live
        shutil.rmtree(tmp, ignore_errors=True)
    print(f"cc-vitals selfcheck: {n[0]} passed, {n[1]} failed")
    return 1 if n[1] else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
