#!/usr/bin/env bash
# cc-perms — bring the permission seat back when its window is gone, or let it hand itself to a fresh one. The
# seat (tmux window `perms`, cwd ~/.cc/state/<repo>/perms) is the one session the box runs with --dangerously-skip-permissions, and a tmux crash
# takes it with everything else. Until this, only the owner could start it again, by hand.
#   cc-perms relaunch    from a repo's planning seat: open window `perms` on that repo's seat, always a fresh
#                        conversation that starts from its brief.md and the last entry of its journal (handoff.md).
#                        While a live seat exists it does nothing and exits 0.
#   cc-perms revive      from the box's recover units only (cc-recover's tick and restore, under systemd): the same
#                        fresh launch for the box's own repo's seat, with no person. Live seat: nothing, exit 0.
#   cc-perms handoff     from the permission seat itself, past its hand-off line: start a fresh seat in window
#                        `perms~next`, and once it is listening move the names (old → `perms~old`, new → `perms`)
#                        and end the old window, last, unless reads are running (below). Refused unless handoff.md in the seat's own directory gained
#                        a `## HAND-OFF ENTRY <UTC minute>Z` heading in the last 15 minutes. A successor that is not
#                        up within 90 s is removed and the old seat kept, and so it is when the call is stopped.
#                        The seat's reads still running in subagents go to the successor in handoff.md, and the
#                        old window stays as `perms~old` until they are in (RUNNING READS below).
#   cc-perms retire      from the old seat in `perms~old` once its reads are recorded: end that window. From the
#                        seat in `perms`: end `perms~old` once it has no read still running.
#   cc-perms pin         from the permission seat itself: record what a new seat starts from (~/.claude's startup
#                        entries and the claude binary, by hash) in `pins` in its own directory. Both verbs above
#                        refuse to start a seat while any of those differs, so the seat takes a change on here.
#   cc-perms pins-diff REPO  read only: each entry of REPO's seat that differs from its pins, one a line (rc 1), or
#                        nothing (rc 0); rc 2 when REPO has no seat. The seat's stop line (cc-checkpoint) asks it.
#   cc-perms selfcheck   the refusals and the launches, against fixtures in a HOME of their own
# WHY IT IS SAFE TO CALL: the property that fenced the seat is that nothing another session can call, write or
# signal starts a session that skips permissions under that session's say-so. So relaunch takes NO argument, reads
# nothing from the caller's environment, and builds one fixed command: the seat's own directory, its own brief.md,
# the one model written below ($MODEL, never cc-model, an override file or the env), the effort the box's own
# ~/.cc/config names (one of claude's levels, else high; never the env), and nothing else. The caller
# decides only WHEN, never WHAT.
# NO LAUNCH EVER LOADS A TRANSCRIPT: any unsandboxed shell can write a .jsonl into ~/.claude/projects, and a seat
# that resumed it would take a planted turn as its own. So relaunch, like handoff, always starts FRESH: a session id
# this script picks (recorded in the seat's own directory, session-id) and the fixed prompt, which reads brief.md and
# the last "START HERE" entry of the journal beside it. Never --continue or --resume.
# WHO MAY CALL COMES FROM THE PROCESS, never from anything typed. The nearest `claude` above this shell must:
#   - be the real claude binary (/proc/PID/exe under ~/.local/share/claude/versions/), not a copy named claude;
#   - stand exactly in ~/dev/<repo>, and that repo has a seat (~/.cc/state/<repo>/perms/brief.md), so another
#     repo's seat is refused and nobody can name a repo they do not sit in;
#   - carry no member or track marker in that directory and no CC_ROLE in its own environment (a worker, a member
#     workspace and a member-facing seat all run with one);
#   - have no second `claude` above it (a session that starts a child claude in ~/dev/<repo> does not become the seat);
#   - run inside a pane of tmux session `main` whose window is <repo> or its handoff successor <repo>~next, so a
#     claude detached into ~/dev/<repo> is refused too.
# HANDOFF'S CALLER is the seat itself, read the same way: the nearest claude above is the real binary, carries the
# skip flag, stands in ~/.cc/state/<repo>/perms (with its brief.md), has no CC_ROLE and no claude above it, and sits
# in the pane of the one tmux window `perms`. Its launch is relaunch's fixed command, always FRESH (a session id it
# picks, the fixed prompt; never --continue or --resume), so the caller still decides only WHEN. The session id is
# recorded only once the names have moved, so a failed hand-off leaves the old seat's id in place.
# THE JOURNAL THE SUCCESSOR FOLLOWS IS FENCED LIKE brief.md: it is handoff.md inside the seat's own directory, which
# cc-guard lets only the seat write, at every tier. Whoever writes the entry the fresh seat starts from steers it,
# so it never lives beside the seat (~/.cc/state/<repo>/*-handoff.md is any unsandboxed worker's to append to).
# A STOPPED HAND-OFF LEAVES ONE SEAT. The wait fits under Bash's 120 s default, and a trap on EXIT, TERM, INT and HUP
# settles whatever stopped it: before the names moved it closes perms~next and gives the old window its name back;
# after, it finishes the cutover forward. Only a SIGKILL gets past the trap, and settle ignores a second signal.
# NOTHING ABOVE THE SEAT STEERS IT (security reads of #940). Claude Code loads CLAUDE.md, CLAUDE.local.md and .claude/
# from every directory above the one it starts in, and ~/.cc/state/<repo>, ~/.cc/state and ~/.cc are any unsandboxed
# worker's to write. Both verbs refuse to launch while one sits above the seat; the one allowed is ~/CLAUDE.md as a
# link that resolves into ~/dev/<repo> (~/.claude is the account's own settings). The launch is an argument list, never
# a shell string: a fixed sh cds into the seat and execs `env -i` with a fixed HOME, PATH, TERM and LANG and the pane's
# own TMUX and TMUX_PANE, so nothing in the tmux server's environment reaches the seat. What it runs is the program
# ~/.local/bin/claude resolves to, checked to be a file directly in ~/.local/share/claude/versions/, through a link
# named claude in the seat's own directory (so the session is still called claude); a hand-off waits for exactly that
# program.
# WHAT THE SEAT STARTS FROM IS FIXED BY CONSTRUCTION (third security read of #940). Any unsandboxed shell of this
# account can write ~/.claude, ~/.claude.json and ~/.local/bin, and a session loads all three as it starts. So:
#   - MCP: the launch carries --strict-mcp-config and --mcp-config launch/mcp.json, which this script writes from a
#     fixed template (the one server the seat had: cc-slack, the one beside this script, tools only), so no server
#     from ~/.claude.json or a project file starts with the seat. It is told its target (<repo>, alias perms): the
#     seat's cwd is no worktree or ~/dev path, so `cc-slack channel` on its own finds none and exits.
#   - ~/.claude: CLAUDE.md, rules/, agents/, skills/, commands/, output-styles/, plugins/, settings.json and
#     settings.local.json (all of each but its permission rules and autoMode text, which a session that skips
#     permissions never consults), ~/.claude.json (but for what every session rewrites as it runs: see CJ_DROP), the
#     seat's own auto-memory (~/.claude/projects/<its directory>/memory/, MEMORY.md and every file in it), and the
#     binary ~/.local/bin/claude resolves to, must match the hashes in `pins` in the seat's own directory. Only the
#     seat writes there (cc-guard), and `cc-perms pin`, run by the seat, records them. A mismatch refuses with one
#     line naming the entry, so an updater's bump or a skill sync waits for the seat to look and re-pin. Left out of
#     the hash is what the account's own sync rewrites by itself: a .git dir, __pycache__, .last-complete-round, a
#     lastUpdated stamp, and the plugin catalogs (plugins/marketplaces, synced, store, the directory cache).
#     Installed plugins (installed_plugins.json, cache/) are in it, and so is what a skill links to, except a link into
#     a skill's link to a box checkout under ~/dev, which is pinned by where it points (see THE PINS).
#   - PATH is ~/bin and the system's own directories, nothing else, so ~/.local/bin is off it. ~/bin comes first
#     because its shims (gh, cc) must win over the system's names, and it is held the way the seat's hooks are,
#     since they run from there too: cc-guard refuses a worker's or member's write into ~/bin and ~/dev, and the
#     launch refuses while an entry of ~/bin resolves outside the box's own repo in ~/dev (a member's workspace is
#     in ~/dev too, and its member writes it). Python the seat runs keeps its bytecode in
#     launch/pycache (PYTHONPYCACHEPREFIX), so a __pycache__ planted beside a script is never read.
# These paths are all this account's to swap, so this narrows the window; the caller's pane is the gate.
# THE GO-LIVE GATE IS RETIRED (2026-10-14, owner: "perms needs to be able to come back up automatically"). The fourth
# security read of #940 found that a worker outside bwrap can still write ~/.claude, ~/.claude.json, ~/bin and the
# seat's pins through a path cc-guard's text check never sees, and so both verbs used to refuse while
# CC_WORKER_SANDBOX was not 1 in ~/.cc/config and the owner's root-owned marker /etc/cc/perms-handoff-live was absent.
# Neither ever came true, and on 2026-10-14 a tmux crash left perms down until the owner pasted a tmux line by hand.
# What the gate held against is a hostile unsandboxed session of this account, and that session already has
# passwordless sudo, so it can start a skip-permissions claude, or do anything that claude could, with or without the
# gate; the dispatch engine's agents run as their own user (dispatch-w) and cannot write this home at all. The owner
# guards against outside attacks and leaks, not the box's own sessions. So nothing on disk gates a launch any more,
# and what still buys something stays: the caller check, the fixed launch, the fresh start, above_clean, bin_clean,
# launch_target, and the pins (a refusal for relaunch and handoff, which a seat is there to settle; advice for revive,
# which no person attends). `cc-perms gate` stays for its callers (cc-checkpoint) and always says open.
# The pins are hashed twice, once before the launch is set up and once just before the tmux call (pins_again).
# REVIVE: the box's own recover units bring the seat back with no person (cc-recover's tick every minute, and its
# restore). The caller is read from /proc/self/cgroup: only a process in cc-recover.service or
# cc-recover-restore.service passes. Both are units with files of their own, so `systemd-run --user --unit` cannot
# take those names, and every seat, worker and member runs in a tmux pane, whose cgroup is the tmux server's. A process
# of this account could move itself into one of those cgroups while the unit runs (the user owns its delegated tree),
# which is the same hostile session sudo already lets through; cc-guard also refuses `cc-perms revive` from a worker or
# member shell as text. Revive takes no argument and brings back only the box's own repo's seat (ctl_repo), with the
# same fixed launch as relaunch. A seat that keeps dying is never left down: past REVIVE_EASY revivals in a row (a run
# of them each less than REVIVE_CALM apart) each further one waits twice as long as the last, from REVIVE_BASE up to
# REVIVE_CEIL, so it is not restarted every minute, and the owner is told once per run, with the line that starts it
# by hand (owner, 2026-10-16/20: no give-up after N; a time-based give-up backs off and posts once). A pins difference, or nothing pinned yet, does not hold it: it starts and logs the
# difference in revive.log, files it with the planning seat (cc-notify --ask; the owner only if that fails), and the
# seat's own stop line (cc-checkpoint, through pins-diff) tells it to check and pin.
# Every other refusal tells the owner once (one cc-notify per reason, stamped in revive-alerted) with one line to paste.
# THE PLANNING SEAT IS TRUSTED. It can edit cc-perms and cc-slack in ~/dev and start a claude that skips permissions
# on its own, and no PR can fence that. Everything here holds against a prompt, a worker or a member, not against it.
# cc-guard refuses `cc-perms relaunch` and `cc-perms handoff` from a worker or member shell as text; this check is what holds when the
# command is spelled some other way. The account's home comes from passwd, not $HOME, and PATH is set to the
# system's own directories before anything is looked up, so a getent, id or stat planted on the caller's PATH never
# names it. A FIXTURE is only a run the selfcheck starts: CC_PERMS_FIXTURE=1, which the selfcheck sets for its own
# calls and nothing else does, with a $HOME that is not the account's. Only a fixture reads its paths from $HOME,
# honours the CC_PERMS_* overrides (a stand-in session, the caller's cgroup, the wait, a mid-launch hook) and
# runs the tmux and cc-notify stand-ins in $HOME/fixture-bin, never the caller's PATH: its tmux runs with TMUX and
# TMUX_TMPDIR unset against a socket in $HOME, so a fixture called from a real pane never reaches the real server or
# the owner's DMs. Its launch carries --fixture-no-bypass where the real one carries --dangerously-skip-permissions,
# so no fixture, and no session that fakes one, ever starts a session that skips permissions. Anything else is real:
# every gate, pin and launch path comes from the passwd home.
# RUNNING READS CROSS THE HAND-OFF (2026-10-19: two cc-guard reads died with the old seat, the successor did not know
# they existed, and both were run again from scratch). handoff reads the seat's subagents still running, by the
# session id in session-id (cc-handoff --reads, the rule cc-handoff's own overlap stays for), before it launches. With
# any, it appends their PR, head, asker and agent id to the START HERE entry in handoff.md, so the successor starts knowing
# them, and once the names move it keeps the old window as perms~old instead of ending it: the old seat records each
# read in security-reads.json as it reports (that ledger's writes are flocked) and tells its asker, then runs
# `cc-perms retire`. The successor ends perms~old with the same verb once nothing of it is still running, and if neither
# does, cc-handoff's sweep ends it once nothing is running and its pane has sat idle two sweeps apart. A next
# hand-off is refused while perms~old is open. No subagent running: the old window ends as before. A hand-off run
# again after a try that stopped replaces that try's reads section in the entry rather than adding a second.
set -uo pipefail
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin; export PATH
AH=$(getent passwd "$(id -u)" 2>/dev/null | cut -d: -f6)
[ -n "$AH" ] || { echo "cc-perms: cannot read this account's home from passwd; nothing started" >&2; exit 1; }
FX=""; H=$AH
if [ "${CC_PERMS_FIXTURE:-}" = 1 ] && [ -n "${HOME:-}" ] && [ "$HOME" != "$AH" ]; then FX=1; H=$HOME; fi
if [ -n "$FX" ]; then SKIP=--fixture-no-bypass; TM=(env -u TMUX -u TMUX_TMPDIR "$H/fixture-bin/tmux" -S "$H/tmux.sock"); EXE=$(readlink -f /bin/bash)   # the stand-ins are bash scripts
else SKIP=--dangerously-skip-permissions; TM=(env -u TMUX -u TMUX_TMPDIR /usr/bin/tmux -S "/tmp/tmux-$(id -u)/default"); EXE=$AH/.local/share/claude/versions/; fi
# the owner's alert goes out through the cc-notify beside this script; a fixture's is its stub in $H/fixture-bin
HERE=$(dirname -- "$(readlink -f -- "$0")")
if [ -n "$FX" ]; then NOTIFY=("$H/fixture-bin/cc-notify"); else NOTIFY=("$HERE/cc-notify"); fi
VERS=$H/.local/share/claude/versions/   # where ~/.local/bin/claude must resolve for a launch
SESSION=main; WIN=perms
PROMPT="Read brief.md in this directory; it is your whole job. Then read the last \"START HERE\" entry in handoff.md in this same directory, and in no other file, if there is one. Then wait for requests."
# where a claude listens for other sessions' messages (<pid>.sock); a fixture's is its own
# the wait for a successor: under the 120 s a Bash call gets by default, so the caller's timeout never stops it midway
if [ -n "$FX" ]; then SOCKS=$H/cc-socks; UP=${CC_PERMS_UP_SECS:-90}; else SOCKS=/run/user/$(id -u)/cc-socks; UP=90; fi
# the one lock relaunch, handoff and pin share: a file of its own in the account's runtime directory (0700, this
# account's alone), never this script, which every account on the box may read and so hold a shared lock on
if [ -n "$FX" ]; then LOCK=$H/cc-perms.lock; else LOCK=/run/user/$(id -u)/cc-perms.lock; fi
# the seat's model, written here and nowhere else: "--model 'claude-opus-5-5[1m]'" — the spec. Not cc-model, whose
# answer an override file or the env can change, so no config a worker can reach picks the bypass session's model.
MODEL='claude-opus-5-5[1m]'
JOURNAL_MIN=15

die(){ echo "cc-perms: $*" >&2; exit 1; }
# lock WHAT — takes $LOCK on fd 9 or dies saying WHAT is already running. The file is made 0600 by this caller, and a
# link or anything but a regular file there is refused rather than followed. The type is checked before the open,
# since opening a FIFO for writing blocks; the open is read-write, which never blocks on a FIFO, so one swapped in
# after that check is caught by the check after the open.
lock(){ local um
  [ -L "$LOCK" ] && die "the lock $LOCK is a link; nothing started"
  [ -e "$LOCK" ] && [ ! -f "$LOCK" ] && die "the lock $LOCK exists and is not a regular file; nothing started"
  um=$(umask); umask 077; exec 9<>"$LOCK"; umask "$um"
  [ -f "$LOCK" ] && [ ! -L "$LOCK" ] || die "cannot take the lock $LOCK; nothing started"
  flock -n 9 || die "$1"; }
# boxconf KEY — prints KEY's value in the box's own $H/.cc/config, parsed as cc-config does (last line wins, one layer
# of quotes), or nothing; the environment and a CC_CONFIG override are ignored on purpose, so a worker cannot set a key
# for one call
boxconf(){ local l k v="" f=$H/.cc/config
  [ -f "$f" ] || return 0
  while IFS= read -r l || [ -n "$l" ]; do
    l="${l#"${l%%[![:space:]]*}"}"; case "$l" in '#'*|*=*) ;; *) continue;; esac
    k="${l%%=*}"; k="${k%"${k##*[![:space:]]}"}"; [ "$k" = "$1" ] || continue
    l="${l#*=}"; l="${l#"${l%%[![:space:]]*}"}"; l="${l%"${l##*[![:space:]]}"}"
    case "$l" in '"'*'"'|"'"*"'") l="${l:1:${#l}-2}";; esac; v=$l
  done < "$f"
  printf '%s' "$v"; }
# effort — the seat's --effort: CC_PERMS_EFFORT in the box's own config (boxconf) when it is one of claude's levels,
# else high. High, not max: the owner's line is the strongest model at high effort, and max thinking was about 40% of
# what filled each seat's window (perms' measurement, 2026-10-15); its security reads run in their own subagents.
effort(){ local e; e=$(boxconf CC_PERMS_EFFORT)
  case "$e" in low|medium|high|xhigh|max) printf '%s' "$e";; *) printf high;; esac; }
# ctl_repo — the box's own repo, the one rule cc, cc-notify and cc-slack read it by: the repo this copy of cc-perms
# lives in under ~/dev, else cc-config's CC_BOX, else the host's short name
ctl_repo(){ local c=""
  case "$HERE" in "$H/dev/"?*) c=${HERE#"$H/dev/"}; c=${c%%/*};; esac
  [ -n "$c" ] || c=$("$HERE/cc-config" get CC_BOX 2>/dev/null)
  [ -n "$c" ] || c=$(hostname -s 2>/dev/null)
  printf %s "$c"; }
# the field after state, counted from the LAST ')': comm may hold spaces and parens, so a bash copied to 'a b 4242 c'
# made a plain field count read 4242 and walk to whichever claude that is (security read, PR #914)
ppid_of(){ local s; s=$(cat "/proc/$1/stat" 2>/dev/null) || return 0; s=${s##*)}; set -f; set -- $s; set +f; echo "${2:-}"; }
comm_of(){ cat "/proc/$1/comm" 2>/dev/null; }

# session_pid — prints the nearest claude above this shell (a fixture may name a stand-in), or says why not (rc 1)
session_pid(){
  local p="" n=0
  if [ -n "$FX" ] && [ -n "${CC_PERMS_ROOT_PID:-}" ]; then p=$CC_PERMS_ROOT_PID
  else p=$PPID
    while [ -n "$p" ] && [ "$p" != 0 ] && [ "$p" != 1 ] && [ "$n" -lt 64 ]; do
      [ "$(comm_of "$p")" = claude ] && break
      p=$(ppid_of "$p"); n=$((n+1)); done
  fi
  [ "$(comm_of "${p:-0}")" = claude ] || { echo "not called from a session"; return 1; }
  case "$(readlink "/proc/$p/exe" 2>/dev/null)" in "$EXE"*) ;; *) echo "the session is not the claude binary"; return 1;; esac
  printf '%s\n' "$p"; }
# claude_above PID — rc 0 when a claude sits above PID (a session started by another session)
claude_above(){
  local n=0 q; q=$(ppid_of "$1")
  while [ -n "$q" ] && [ "$q" != 0 ] && [ "$q" != 1 ] && [ "$n" -lt 64 ]; do
    [ "$(comm_of "$q")" = claude ] && return 0
    q=$(ppid_of "$q"); n=$((n+1)); done
  return 1; }

# caller_repo — prints the repo whose planning seat this call comes from, or says why not (rc 1)
recorded(){ [ -e "$H/.cc/member-facing/$1" ] || { [ -d "$H/.cc/member-facing" ] && ! [ -x "$H/.cc/member-facing" ]; }; }   # the host's record
# of member-facing repos; a record dir it can't search reads as recorded (a chmod fails closed, as in cc-guard)
caller_repo(){
  local p n=0 d r q
  p=$(session_pid) || { echo "$p"; return 1; }
  d=$(readlink "/proc/$p/cwd" 2>/dev/null)
  case "$d" in "$H"/dev/?*) r=${d#"$H"/dev/};; *) echo "not a repo's planning seat (the session stands in ${d:-?})"; return 1;; esac
  case "$r" in */*|.|..) echo "not a repo's planning seat (the session stands in $d)"; return 1;; esac
  [ -e "$d/.cc/track" ] || [ -e "$d/.cc/member-facing" ] || recorded "$r" || [ -e "$d/.cc/member-workspace" ] \
    && { echo "$r is a track or member session, not a planning seat"; return 1; }
  tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -q '^CC_ROLE=' && { echo "the session runs as a worker or member"; return 1; }
  claude_above "$p" && { echo "the session was started by another session"; return 1; }
  local panes inpane=""; panes=$("${TM[@]}" list-panes -s -t "$SESSION" -F '#{window_name} #{pane_pid}' 2>/dev/null)
  n=0; q=$p
  while [ -n "$q" ] && [ "$q" != 0 ] && [ "$q" != 1 ] && [ "$n" -lt 64 ]; do
    awk -v a="$r" -v b="$r~next" -v q="$q" '($1 == a || $1 == b) && $2 == q {f=1} END {exit !f}' <<<"$panes" && { inpane=1; break; }
    q=$(ppid_of "$q"); n=$((n+1)); done
  [ -n "$inpane" ] || { echo "the session is not in tmux window $SESSION:$r"; return 1; }
  [ -f "$H/.cc/state/$r/perms/brief.md" ] || { echo "$r has no permission seat"; return 1; }
  printf '%s\n' "$r"; }

# live_seat DIR — prints the pid of a live seat in DIR (the claude binary carrying the skip flag, standing there), rc 1
# if none. Any program can be named claude, so a copy of another one there is no seat.
live_seat(){
  local f p
  for f in /proc/[0-9]*/comm; do
    [ "$(cat "$f" 2>/dev/null)" = claude ] || continue
    p=${f#/proc/}; p=${p%/comm}
    case "$(readlink "/proc/$p/exe" 2>/dev/null)" in "$EXE"*) ;; *) continue;; esac
    [ "$(readlink "/proc/$p/cwd" 2>/dev/null)" = "$1" ] || continue
    tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | grep -qxF -- "$SKIP" || continue
    printf '%s\n' "$p"; return 0; done
  return 1; }

# above_clean DIR REPO — rc 0 when no CLAUDE.md, CLAUDE.local.md or .claude sits in a directory above DIR, which a
# session started in DIR would load; otherwise says which (rc 1). Allowed: ~/CLAUDE.md as a link resolving into
# ~/dev/REPO, and ~/.claude (the account's settings: pins_match holds its startup entries, and ~/.claude.json, which
# no directory walk loads). A fixture stops at its HOME: above that is the machine running it.
above_clean(){
  local d=${1%/*} n f
  while :; do
    for n in CLAUDE.md CLAUDE.local.md .claude; do
      f=$d/$n; [ -e "$f" ] || [ -L "$f" ] || continue
      [ "$d" = "$H" ] && [ "$n" = .claude ] && continue
      [ "$d" = "$H" ] && [ "$n" = CLAUDE.md ] && [ -L "$f" ] \
        && case "$(readlink -f -- "$f" 2>/dev/null)" in "$H/dev/$2"/?*) true;; *) false;; esac && continue
      echo "$f sits above the seat's directory, and a seat started there would load it"; return 1; done
    { [ -n "$FX" ] && [ "$d" = "$H" ]; } || [ "$d" = / ] || [ -z "$d" ] && break
    d=${d%/*}; [ -n "$d" ] || d=/; done
  return 0; }

# launch_target — prints the program ~/.local/bin/claude resolves to when that is an executable file directly in
# ~/.local/share/claude/versions/, or says why not (rc 1)
launch_target(){
  local c; c=$(readlink -f -- "$H/.local/bin/claude" 2>/dev/null)
  case "$c" in "$VERS"?*) ;; *) echo "$H/.local/bin/claude does not resolve into $VERS (it resolves to ${c:-nothing})"; return 1;; esac
  case "${c#"$VERS"}" in */*) echo "$H/.local/bin/claude resolves below $VERS, not directly in it ($c)"; return 1;; esac
  [ -f "$c" ] && [ -x "$c" ] || { echo "$c is not an executable file"; return 1; }
  printf '%s\n' "$c"; }

# bin_clean — rc 0 when every entry of ~/bin, which is first on the seat's PATH, resolves into the box's own repo in
# ~/dev (ctl_repo), where cc-guard refuses a worker's or member's write, and none but cc and gh shares its name with
# a program in /usr/local/bin, /usr/bin or /bin (cc must beat the C compiler; a ~/bin/jq must never stand in for jq).
# Anywhere else in ~/dev is not enough: a member workspace sits there too, and its member writes it. Otherwise it
# says which entry fails (rc 1). A directory is never run, so it passes.
bin_clean(){
  local f c b d r; r=$(ctl_repo)
  case "$r" in ""|*/*|.|..) echo "cannot tell which repo in $H/dev is the box's own, so ~/bin cannot be checked"; return 1;; esac
  for f in "$H"/bin/* "$H"/bin/.[!.]* "$H"/bin/..?*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    c=$(readlink -f -- "$f" 2>/dev/null); [ -d "$c" ] && continue
    case "$c" in "$H/dev/$r"/?*) ;; *) echo "$f resolves to ${c:-nothing}, outside $H/dev/$r, and ~/bin is on the seat's PATH"; return 1;; esac
    b=${f##*/}; case "$b" in cc|gh) continue;; esac
    for d in /usr/local/bin /usr/bin /bin; do
      [ -e "$d/$b" ] || [ -L "$d/$b" ] || continue
      echo "$f shadows $d/$b, and ~/bin comes first on the seat's PATH (only cc and gh may)"; return 1
    done
  done
  return 0; }

# THE PINS. fhash FILE prints its sha256. treehash DIR [PATH…] prints one hash over every name and file below DIR,
# following links. With TH_REPOLINKS=1 (skills/ only), a link at DIR's top level to a directory inside a box checkout
# (~/dev/<repo> with a .git and no member marker) is pinned by where it points, not by what is there:
# ~/.claude/skills/fwe and npie link into live checkouts, and hashing their content made every commit to those repos
# a pin difference (architect, 2026-10-19). A checkout changes by commit; the link itself sits in ~/.claude, so
# retargeting it is still a difference. A member workspace is written by its member, so a link there is hashed by
# content like any other. Leaves out the PATHs given
# (relative to DIR) and what the account's own sync rewrites by itself: .git, __pycache__ and .last-complete-round
# anywhere, and the lastUpdated stamps in a manifest.json or known_marketplaces.json. A missing DIR is "absent".
fhash(){ sha256sum < "$1" 2>/dev/null | cut -c1-64; }
treehash(){
  local d=$1 x; shift
  [ -e "$d" ] || [ -L "$d" ] || { echo absent; return 0; }
  [ -d "$d" ] || { echo "file:$(fhash "$d")"; return 0; }   # a file where a directory belongs still pins
  local -a pr=(); for x in "$@"; do pr+=(-path "./$x" -o); done
  # every file's sha256 in one sha256sum run (a fork per file took ~/.claude/skills' 3,400 files to 20 s); the lines
  # hashed are the same as one fhash per file would give, and a file sha256sum cannot read hashes as empty, as there
  ( cd -- "$d" || { echo unreadable; exit 0; }
    local -A fh=(); local -a ln=(); local t q
    [ "${TH_REPOLINKS:-}" = 1 ] && while IFS= read -r -d '' x; do
        t=$(realpath -e -- "$x" 2>/dev/null) && [ -d "$t" ] || continue
        case "$t" in "$H/dev/"?*/?*) ;; *) continue;; esac
        q=${t#"$H/dev/"}; q=$H/dev/${q%%/*}
        [ -e "$q/.git" ] && [ ! -e "$q/.cc/member-workspace" ] && [ ! -e "$q/.cc/member-facing" ] && ! recorded "${q##*/}" || continue
        pr+=(-path "$(sed 's/[][*?\\]/\\&/g' <<<"$x")" -o); ln+=("l $x -> $t")
      done < <(find . -mindepth 1 -maxdepth 1 -type l -print0 2>/dev/null)
    while IFS= read -r -d '' x; do fh[${x:66}]=${x:0:64}; done < <(find -L . -mindepth 1 \( "${pr[@]}" -name .git -o -name __pycache__ \
      -o -name .last-complete-round \) -prune -o -type f -print0 2>/dev/null | xargs -0 -r sha256sum -z -- 2>/dev/null)
    { find -L . -mindepth 1 \( "${pr[@]}" -name .git -o -name __pycache__ -o -name .last-complete-round \) -prune -o -printf '%y %p\n' 2>&1
      [ ${#ln[@]} = 0 ] || printf '%s\n' "${ln[@]}"; } | LC_ALL=C sort | while IFS=' ' read -r y p; do
          [ "$y" = f ] || { printf '%s %s\n' "$y" "$p"; continue; }
          x=""; case "${p##*/}" in manifest.json|known_marketplaces.json)
            x=$(jq -cS 'walk(if type == "object" then del(.lastUpdated) else . end)' -- "$p" 2>/dev/null) && x=json:$(printf '%s' "$x" | sha256sum | cut -c1-64) || x="";; esac
          printf 'f %s %s\n' "$p" "${x:-${fh[$p]:-}}"; done ) | sha256sum | cut -c1-64; }
# pin_now TARGET DIR — the pins as they stand: one "<path> <hash>" line for each of ~/.claude's startup entries, one
# for ~/.claude.json, and one for TARGET (the binary a launch runs), keyed by its own path so an updater's bump has no
# pin until the seat makes one. DIR is the seat's directory, whose own entry under .projects is the one it starts from.
PINS=(CLAUDE.md rules agents skills commands output-styles plugins settings.json settings.local.json)
# ~/.claude.json is rewritten by every session of the account as it starts and runs (counters, caches, tips, each
# directory's last-run figures), so its hash leaves out these top-level keys, the nested paths in CJ_DROP_PATHS (the
# profile stamp Claude Code refreshes under oauthAccount, whose identity, email and org stay pinned), the other
# directories' entries under .projects, and the seat's own entry's last* figures and exampleFiles. Every other key,
# mcpServers included, is pinned.
CJ_DROP='["numStartups","promptQueueUseCount","btwUseCount","tipsHistory","tipsHistoryByCommand","tipLifetimeShownCounts",
"skillUsage","pluginUsage","agentLastUsed","lastPlanModeUse","announcementImpressions","seenNotifications",
"promoStartupSeenCount","promoStartupStatusCache","passesLastSeenRemaining","passesUpsellSeenCount","passesEligibilityCache",
"fullscreenUpsellSeenCount","fullscreenBootPending","rcLongTurnNudgeSeenCount","rcLongTurnNudgeSeenKey","rcPermissionNudgeSeenCount",
"remoteControlReadyPushCount","remoteControlReadyPushKey","remoteControlSurfacesSeen","hasSeenEffortMediumNudgeByModel",
"feedbackSurveyState","changelogLastFetched","closedIssuesLastChecked","lastReleaseNotesSeen","cachedGrowthBookFeatures",
"cachedGrowthBookFeaturesAt","cachedExperimentData","cachedExperimentFeatures","cachedExtraUsageDisabledReason",
"cachedUsageUtilization","cachedArtifactRoster","additionalModelCostsCache","additionalModelOptionsCache",
"additionalModelOptionsAnsweredAt","autoCompactWindowsCache","clientDataCacheSlots","githubWebConnectionStatusCache",
"groveConfigCache","modelAccessCache","orgModelDefaultCache","githubRepoPaths","replBridgePlaceholders","apiCreditLinkStatusCache",
"lastClawdEntranceVersion","groveChoiceSeenAt"]'
CJ_DROP_PATHS='[["oauthAccount","profileFetchedAt"]]'
cjhash(){
  local s
  s=$(jq -cS --arg d "$2" --argjson drop "$CJ_DROP" --argjson paths "$CJ_DROP_PATHS" '
      (.projects[$d] // null | if type == "object" then with_entries(select(.key | startswith("last") | not)) | del(.exampleFiles) else . end) as $p
      | del(.projects) | delpaths([$drop[] | [.]] + $paths) | .seatProject = $p' -- "$1" 2>/dev/null) \
    && printf 'json:%s\n' "$(printf '%s' "$s" | sha256sum | cut -c1-64)" || printf 'raw:%s\n' "$(fhash "$1")"; }
pin_now(){
  local c=$H/.claude e s
  for e in "${PINS[@]}"; do
    if [ ! -e "$c/$e" ] && [ ! -L "$c/$e" ]; then s=absent
    else case "$e" in
      CLAUDE.md) s=$(fhash "$c/$e"); s=${s:-unreadable};;
      settings.json|settings.local.json) s=$(jq -cS 'del(.permissions, .autoMode)' -- "$c/$e" 2>/dev/null) \
          && s=json:$(printf '%s' "$s" | sha256sum | cut -c1-64) || s=raw:$(fhash "$c/$e");;
      plugins) s=$(treehash "$c/$e" marketplaces synced store 'plugin-directory-cache*');;
      skills) s=$(TH_REPOLINKS=1 treehash "$c/$e");;
      *) s=$(treehash "$c/$e");;
    esac; fi
    printf '%s %s\n' "$c/$e" "$s"; done
  if [ ! -e "$H/.claude.json" ] && [ ! -L "$H/.claude.json" ]; then s=absent; else s=$(cjhash "$H/.claude.json" "$2"); fi
  printf '%s %s\n' "$H/.claude.json" "$s"
  s=$H/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$2")/memory; printf '%s %s\n' "$s" "$(treehash "$s")"   # the seat's auto-memory
  printf '%s %s\n' "$1" "$(fhash "$1")"; }
# pins_diff DIR TARGET — prints every entry pin_now gives whose hash is not the one in DIR/pins, one a line in pin_now's
# order, or "nothing pinned yet" when DIR/pins is empty or missing; rc 0 when nothing differs, 1 otherwise. One hash
# pass, and it writes nothing: relaunch, handoff, the pins-diff verb and the seat's stop line all compare through it.
pins_diff(){
  [ -s "$1/pins" ] || { echo "nothing pinned yet"; return 1; }
  pin_now "$2" "$1" | awk 'NR == FNR {p[$1] = $2; next} p[$1] != $2 {print $1; n++} END {exit n > 0}' "$1/pins" -; }
# pins_match DIR TARGET — rc 0 when every pin in DIR/pins is what pin_now says now; otherwise names the first that is not (rc 1)
pins_match(){
  local d
  [ -s "$1/pins" ] || { echo "the seat has pinned nothing yet (no pins in $1); the seat runs cc-perms pin"; return 1; }
  d=$(pins_diff "$1" "$2") && return 0
  echo "${d%%$'\n'*} is not what the seat pinned in $1/pins; the seat checks the change and runs cc-perms pin"; return 1; }
# pins_again DIR TARGET — the second look, just before the tmux call that starts claude (only the gate's second ask
# comes after it): everything pins_match
# passed is hashed again, so a write landing while the launch was set up (its link, mcp.json, the session id) refuses
# it. What is left is the moment between this hash and claude's own read as it starts. A fixture may name a program in
# CC_PERMS_MIDHOOK, run just before, to make that write; the real launch never reads it.
pins_again(){
  [ -n "$FX" ] && [ -n "${CC_PERMS_MIDHOOK:-}" ] && "$CC_PERMS_MIDHOOK"
  local why; why=$(pins_match "$1" "$2") && return 0
  echo "$why (it changed while the launch was being set up)"; return 1; }

# pins_alert REPO DIR TARGET — relaunch was refused on the pins, so the seat stays down and only a person can start it
# (pin is the seat's own verb). One owner alert names the entries and the one command that starts the seat by hand,
# and it is posted once per set of entries: DIR/pins-alerted holds the set's hash, and the same hash is the post's
# --id, so a planning seat or a watchdog that retries the relaunch does not post it again. A relaunch that gets past
# the pins removes the stamp. Never fatal: the refusal is what matters, and it is said either way.
# hand_cmd DIR NOTE — the one line the owner pastes to start the seat in DIR by hand, its prompt ending with NOTE
hand_cmd(){ local d=$1
  case "$d" in "$H"/*) d=\~/${d#"$H"/};; esac   # the path as he types it
  printf '%s' "tmux new-window -t $SESSION -n $WIN -c $d -- ~/.local/bin/claude --model '$MODEL' --effort $(effort) --dangerously-skip-permissions 'Read brief.md in this directory; it is your whole job. $2'"; }
pins_alert(){
  local set k cmd msg
  set=$(pins_diff "$2" "$3"); k=$(printf '%s' "$set" | sha256sum | cut -c1-16)
  [ "$(cat "$2/pins-alerted" 2>/dev/null)" = "$k" ] && return 0
  cmd=$(hand_cmd "$2" "Your startup files changed since your last pin: check what changed, then run cc-perms pin.")
  msg="The $1 permission seat is down, and cc-perms relaunch will not start it because its startup files changed since it last pinned them: $(paste -sd '\t' <<<"$set" | sed 's/\t/, /g'). Check those, then start it by hand with: $cmd"
  "${NOTIFY[@]}" --owner -t "$1 perms" --heading "The $1 permission seat is down until you start it by hand" --id "perms-pins:$1:$k" "$msg" >/dev/null 2>&1 \
    && printf '%s\n' "$k" > "$2/pins-alerted"
  return 0; }

# pins_diff_verb REPO — `cc-perms pins-diff`: REPO's seat entries that differ from its pins. Anyone may ask; it reads.
# A ~/.local/bin/claude that does not resolve where a launch needs it is named as the entry that changed.
pins_diff_verb(){
  local pd cl
  case "$1" in ""|*/*|.|..) echo "cc-perms: pins-diff takes the repo whose permission seat it reads" >&2; exit 2;; esac
  pd=$H/.cc/state/$1/perms; [ -f "$pd/brief.md" ] || { echo "cc-perms: $1 has no permission seat" >&2; exit 2; }
  cl=$(launch_target) || { echo "$H/.local/bin/claude"; return 1; }
  pins_diff "$pd" "$cl"; }

# seat_argv DIR TARGET — fills SEAT with the one fixed launch both verbs start from, as an argument list: a fixed sh
# that cds into DIR and execs env -i with the pane's own TMUX and TMUX_PANE (tmux sets those per pane) and a fixed
# environment, then TARGET through DIR/launch/claude (so the process is still called claude), only the MCP servers in
# DIR/launch/mcp.json (written here, from the template below), $MODEL, the effort (see effort), the skip flag and inbound messages
# accepted. Each verb adds only how the conversation starts. rc 1: the link or the MCP file was not written.
# --mcp-config takes several values, so it comes before other options and never just before the prompt.
SEAT=()
seat_argv(){
  local l=$1/launch/claude m=$1/launch/mcp.json u n; u=$(id -un)
  mkdir -p "$1/launch" && ln -sfn -- "$2" "$l.$$" && mv -Tf -- "$l.$$" "$l" || return 1
  jq -n --arg c "$(dirname -- "$(readlink -f -- "$0")")/cc-slack" --arg r "$(basename -- "$(dirname -- "$1")")" \
    '{mcpServers: {"cc-slack": {command: $c, args: ["channel", $r], env: {CC_SLACK_ALIAS: "perms"}}}}' > "$m.$$" \
    && mv -f -- "$m.$$" "$m" || { rm -f -- "$m.$$"; return 1; }
  SEAT=(/bin/sh -c 'cd -- "$1" && shift && exec /usr/bin/env -i TMUX="${TMUX:-}" TMUX_PANE="${TMUX_PANE:-}" "$@"' cc-perms-seat "$1"
    HOME="$H" USER="$u" LOGNAME="$u" SHELL=/bin/bash PATH="$H/bin:/usr/local/bin:/usr/bin:/bin"
    TERM=tmux-256color LANG=C.UTF-8 XDG_RUNTIME_DIR="/run/user/$(id -u)" PYTHONPYCACHEPREFIX="$1/launch/pycache")
  [ -d "$H/.cc/tmp" ] && SEAT+=(TMPDIR="$H/.cc/tmp")
  # the seat's number from the box's one sequence (cc-agent-number), fresh for every seat this starts; none if it can't
  n=$(CC_STATE="$H/.cc/state" "$(dirname -- "$(readlink -f -- "$0")")/cc-agent-number" next perms "$(basename -- "$(dirname -- "$1")")/perms" 0 2>/dev/null)
  [ -n "$n" ] && SEAT+=(CC_AGENT_NO="$n")
  SEAT+=("$l" --strict-mcp-config --mcp-config "$m" --model "$MODEL" --effort "$(effort)" "$SKIP" --settings '{"crossSessionInbound":"accept"}'); }

relaunch(){
  local r why pd cl pid
  lock "another relaunch is running; nothing started"
  why=$(caller_repo) || die "refused — $why. Only a repo's planning seat brings its own permission seat back."
  r=$why; pd="$H/.cc/state/$r/perms"
  pid=$(live_seat "$pd") && { echo "cc-perms: the permission seat is already live (pid $pid); nothing to do"; return 0; }
  "${TM[@]}" list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$WIN" \
    && die "window $SESSION:$WIN is open with no seat in it; close it, then run this again. Nothing started."
  why=$(above_clean "$pd" "$r") || die "refused — $why. Move it away, then run this again. Nothing started."
  cl=$(launch_target) || die "refused — $cl. Nothing started."
  why=$(bin_clean) || die "refused — $why. Nothing started."
  why=$(pins_match "$pd" "$cl") || { pins_alert "$r" "$pd" "$cl"; die "refused — $why. Nothing started."; }
  rm -f -- "$pd/pins-alerted"   # past the pins: a later change is a new set, and its alert goes out
  open_seat "$r" "$pd" "$cl" 1; }

# open_seat REPO DIR TARGET RECHECK — the launch relaunch and revive share, once their checks have passed: the fixed
# argument list, a session id picked here, and window perms. RECHECK=1 hashes the pins again just before the tmux call
# (relaunch); revive passes 0, since its pins only advise. Prints where the seat came back, or dies.
open_seat(){
  local r=$1 pd=$2 cl=$3 lexe pid sid U why
  if [ -n "$FX" ]; then lexe=$EXE; else lexe=$cl; fi   # a fixture's stand-in is a bash script
  seat_argv "$pd" "$cl" || die "could not write the launch link in $pd; nothing started"
  if [ "$4" = 1 ]; then why=$(pins_again "$pd" "$cl") || { pins_alert "$r" "$pd" "$cl"; die "refused — $why. Nothing started."; }; fi
  # fresh, always, as handoff: a session id picked here and the fixed prompt, never --continue or --resume
  U='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  sid=$(cat /proc/sys/kernel/random/uuid); [[ $sid =~ $U ]] || die "could not pick a session id; nothing started"
  printf '%s\n' "$sid" > "$pd/session-id" || die "could not record the session id in $pd; nothing started"
  SEAT+=(--session-id "$sid" "$PROMPT")
  # 9<&-: the seat must not inherit the relaunch lock, or every later call would read as a relaunch in progress
  "${TM[@]}" new-window -d -t "$SESSION" -n "$WIN" -c "$pd" -- "${SEAT[@]}" 9<&- || die "tmux would not open window $SESSION:$WIN"
  for _ in $(seq 20); do
    pid=$(live_seat "$pd") && [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$lexe" ] \
      && { echo "cc-perms: the permission seat is back in $SESSION:$WIN (pid $pid, starting fresh from brief.md and its journal)"; return 0; }
    sleep 0.5; done
  die "opened $SESSION:$WIN, but no seat running $cl is in it after 10 s; look at the window"; }

# unit_caller — rc 0 when this call runs inside one of REVIVE_UNITS, read from /proc/self/cgroup (cgroup v2, the
# user manager's tree, in app.slice or straight under it); else says why (rc 1). A call carrying CC_ROLE (a worker or
# member) is refused first. Only a fixture may name its cgroup line, in CC_PERMS_CGROUP.
REVIVE_UNITS="cc-recover.service cc-recover-restore.service"
unit_caller(){ local cg u m uid; uid=$(id -u)
  [ -n "${CC_ROLE:-}" ] && { echo "the call runs as a worker or member (CC_ROLE=$CC_ROLE)"; return 1; }
  if [ -n "$FX" ] && [ -n "${CC_PERMS_CGROUP+x}" ]; then cg=$CC_PERMS_CGROUP; else cg=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null); fi
  m="/user.slice/user-$uid.slice/user@$uid.service"
  for u in $REVIVE_UNITS; do
    [ "$cg" = "$m/app.slice/$u" ] || [ "$cg" = "$m/$u" ] && return 0; done
  echo "not called from the box's recover units (its cgroup is ${cg:-unreadable})"; return 1; }

# revive_refused REPO DIR WHY FIX — revive will not start the seat: log it, tell the owner once per reason (the reason's
# hash in DIR/revive-alerted, so the tick that retries every minute posts nothing more), and die. FIX is the one line
# he pastes. A revive that starts the seat removes the stamp, so the same reason in a later episode is told again: the
# post's --id carries the time it was sent, because cc-slack's ledger sends an id once, ever.
revive_refused(){
  local k; k=$(printf '%s' "$3" | sha256sum | cut -c1-16)
  revive_log "$2" "refused: $3"
  if [ "$(cat "$2/revive-alerted" 2>/dev/null)" != "$k" ]; then
    "${NOTIFY[@]}" --owner -t "$1 perms" --heading "The $1 permission seat is down and the box will not bring it back by itself" \
      --id "perms-revive:$1:$k:$(date -u +%s)" "The $1 permission seat is down, and the box will not start it again on its own: $3. $4" >/dev/null 2>&1 \
      && printf '%s\n' "$k" > "$2/revive-alerted"
  fi
  die "refused — $3. Nothing started."; }
# revive_pins REPO DIR ENTRIES — revive starts the seat off its pins: log it and hand it to the planning seat as a
# request (cc-notify --ask: durable, one per set of entries by its --id), so a start no person saw is checked by a
# seat; the owner hears only when the request cannot be filed
revive_pins(){
  local k m; k=$(printf '%s' "$3" | sha256sum | cut -c1-16)
  revive_log "$2" "started with startup files that differ from its pins: $3"
  m="The box brought the $1 permission seat back with startup files that differ from what it last pinned: $3. Check what changed, then have the seat run cc-perms pin."
  "${NOTIFY[@]}" --ask -t "$1 perms" --id "perms-revive-pins:$1:$k" "$m" >/dev/null 2>&1 \
    || "${NOTIFY[@]}" --owner -t "$1 perms" --heading "The $1 permission seat came back off its pins" --id "perms-revive-pins:$1:$k" "$m" >/dev/null 2>&1
  return 0; }
revive_log(){ printf '%s %s\n' "$(date -u +%FT%TZ)" "$2" >> "$1/revive.log" 2>/dev/null; return 0; }

# revive — `cc-perms revive`, the box's own recover units bringing the seat back with no person (see REVIVE above)
REVIVE_EASY=3; REVIVE_BASE=120; REVIVE_CEIL=3600; REVIVE_CALM=7200

# revive_run DIR NOW — the run of revivals that ends DIR/revived: from the last line back, while each is less than
# REVIVE_CALM before the next (the last, before NOW). Prints "<count> <first> <last>", or "0 0 0" when there is none.
revive_run(){
  [ -f "$1/revived" ] || { echo "0 0 0"; return 0; }
  awk -v now="$2" -v calm="$REVIVE_CALM" '$1 ~ /^[0-9]+$/ {t[++n] = $1}
    END { c = 0; nx = now; for (i = n; i >= 1 && nx - t[i] < calm; i--) { c++; nx = t[i] }
          if (c) print c, t[n - c + 1], t[n]; else print "0 0 0" }' "$1/revived"; }

revive(){
  local r why pd cl pid n t f first last gap next
  why=$(unit_caller) || die "refused — $why. Only the box's recover units revive the permission seat; a planning seat runs cc-perms relaunch."
  lock "a relaunch, hand-off or revive is already running; nothing started"
  r=$(ctl_repo); pd="$H/.cc/state/$r/perms"
  case "$r" in ""|*/*|.|..) die "cannot tell the box's own repo; nothing started";; esac
  [ -f "$pd/brief.md" ] || die "$r has no permission seat ($pd/brief.md is missing); nothing started"
  pid=$(live_seat "$pd") && { echo "cc-perms: the permission seat is already live (pid $pid); nothing to do"; return 0; }
  "${TM[@]}" list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF "$WIN" \
    && revive_refused "$r" "$pd" "window $SESSION:$WIN is open with no seat in it" \
      "Close it with this, and the box brings the seat back within a minute: tmux kill-window -t $SESSION:$WIN"
  t=$(date +%s)
  read -r n first last < <(revive_run "$pd" "$t")
  if [ "$n" -ge "$REVIVE_EASY" ]; then
    gap=$REVIVE_CEIL; [ $(( n - REVIVE_EASY )) -lt 6 ] && gap=$(( REVIVE_BASE << (n - REVIVE_EASY) ))
    [ "$gap" -gt "$REVIVE_CEIL" ] && gap=$REVIVE_CEIL
    # the owner hears once per run (its first revival's time, stamped in revive-backoff) that it keeps going down and
    # that the box keeps bringing it back, waiting longer each time
    if [ "$(cat "$pd/revive-backoff" 2>/dev/null)" != "$first" ]; then
      revive_log "$pd" "brought back $n times in a row and down again each time; backing off, up to $(( REVIVE_CEIL / 60 )) minutes between tries"
      "${NOTIFY[@]}" --owner -t "$r perms" --heading "The $r permission seat keeps going down" \
        --id "perms-revive:$r:backoff:$first" "The $r permission seat was brought back $n times in a row and went down again each time. The box keeps bringing it back, waiting longer each time, up to $(( REVIVE_CEIL / 60 )) minutes between tries. To look now, start it by hand with: $(hand_cmd "$pd" "You went down several times in a row: say what you see.")" >/dev/null 2>&1 \
        && printf '%s\n' "$first" > "$pd/revive-backoff"
    fi
    next=$(date -u -d "@$(( last + gap ))" +%H:%MZ)
    [ $(( t - last )) -lt "$gap" ] && die "backing off — brought back $n times in a row; the next try is after $next. Nothing started."
  fi
  if ! why=$(above_clean "$pd" "$r"); then f=${why%% sits above*}
    revive_refused "$r" "$pd" "$why" "Move it away with this, and the box brings the seat back within a minute: mv -- $f $f.off"; fi
  cl=$(launch_target) || revive_refused "$r" "$pd" "$cl" "Check it, then start the seat by hand with: $(hand_cmd "$pd" "")"
  why=$(bin_clean) || revive_refused "$r" "$pd" "$why" "Check it, then start the seat by hand with: $(hand_cmd "$pd" "")"
  # the pins advise: a difference, or nothing pinned yet, is logged and filed with the planning seat, and the seat's
  # stop line has it check and pin
  why=$(pins_diff "$pd" "$cl") || revive_pins "$r" "$pd" "$(paste -sd , <<<"$why")"
  printf '%s\n' "$t" >> "$pd/revived"
  # keep the record to the current run, the only part revive_run reads
  f=$(tail -n "$(( n + 1 ))" "$pd/revived") && printf '%s\n' "$f" > "$pd/revived"
  rm -f -- "$pd/revive-alerted"
  why=$(open_seat "$r" "$pd" "$cl" 0) || { revive_log "$pd" "the launch failed"; exit 1; }
  revive_log "$pd" "started"; echo "$why"; }

# seat_caller — prints "<repo> <window id>" of the permission seat this call comes from, or says why not (rc 1)
seat_caller(){
  local p d r q n=0 w wn=${1:-$WIN}
  p=$(session_pid) || { echo "$p"; return 1; }
  d=$(readlink "/proc/$p/cwd" 2>/dev/null)
  case "$d" in "$H"/.cc/state/?*/perms) r=${d#"$H"/.cc/state/}; r=${r%/perms};; *) echo "not the permission seat (the session stands in ${d:-?})"; return 1;; esac
  case "$r" in */*|.|..) echo "not the permission seat (the session stands in $d)"; return 1;; esac
  [ -f "$d/brief.md" ] || { echo "$r has no permission seat"; return 1; }
  tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | grep -qxF -- "$SKIP" || { echo "the session does not run with permissions skipped, so it is not the seat"; return 1; }
  tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null | grep -q '^CC_ROLE=' && { echo "the session runs as a worker or member"; return 1; }
  claude_above "$p" && { echo "the session was started by another session"; return 1; }
  # the ONE window named perms, and the session in its pane (or under the pane's shell)
  w=$("${TM[@]}" list-panes -s -t "$SESSION" -F '#{window_id} #{window_name} #{pane_pid}' 2>/dev/null | awk -v w="$wn" '$2 == w')
  [ "$(grep -c . <<<"$w")" = 1 ] || { echo "there is not exactly one window $SESSION:$wn"; return 1; }
  q=$p
  while [ -n "$q" ] && [ "$q" != 0 ] && [ "$q" != 1 ] && [ "$n" -lt 64 ]; do
    [ "$q" = "$(awk '{print $3}' <<<"$w")" ] && { printf '%s %s\n' "$r" "$(awk '{print $1}' <<<"$w")"; return 0; }
    q=$(ppid_of "$q"); n=$((n+1)); done
  echo "the session is not the one in tmux window $SESSION:$wn"; return 1; }

# reads_of SID — the seat's subagents still running, one a line: "<agent id> · PR #n · head <sha> · asked by <who>"
# (cc-handoff --reads, beside this script). Only those four fields reach handoff.md: a prompt may quote a PR's own text, and the START
# HERE entry steers the next seat, so each field is checked to its shape and nothing else is kept. rc 1 when SID is
# not a session id. A fixture's task files are its own (CC_HANDOFF_TASKS); a real call drops that and the idle knob.
reads_of(){
  local e=(env -u CC_HANDOFF_TASKS -u CC_HANDOFF_AGENT_IDLE) a pr hd who _
  [[ ${1:-} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || return 1
  [ -n "$FX" ] && e=(env)
  "${e[@]}" HOME="$H" "$HERE/cc-handoff" --reads "$1" 2>/dev/null | while IFS=$'\t' read -r a pr hd who _; do
    [[ $a =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || continue
    [[ $pr =~ ^PR\ \#[0-9]{1,6}$ ]] || pr="PR ?"
    [[ $hd =~ ^head\ [0-9a-f]{7,40}$ ]] || hd="head ?"
    [[ $who =~ ^asker\ [A-Za-z0-9][A-Za-z0-9@/._~-]{0,63}$ ]] && who="asked by ${who#asker }" || who="asker ?"
    printf '%s · %s · %s · %s\n' "$a" "$pr" "$hd" "$who"; done; }

# drop_reads FILE — take out of FILE's last HAND-OFF ENTRY the reads section an earlier try of this hand-off added
# (`### Reads still running at hand-off (cc-perms, …)` or `### Reads at hand-off (cc-perms, …)`): its heading, the
# blank lines before it, the one line of prose cc-perms writes under it and the `- ` bullets after that. It stops at
# the first line past that list, so text after it, headed or not, stays. A hand-off that stopped and is run again
# inside the same 15 minutes reuses that entry, so without this each try stacked another section under it (perms,
# 2026-10-19). Only the last entry is touched, and only a section cc-perms wrote. The file is rewritten only if it had
# one, through a temp file in its own directory renamed over it, so a write killed halfway leaves the old file whole.
drop_reads(){
  local L t tmp
  L=$(grep -nE '^## HAND-OFF ENTRY ' "$1" 2>/dev/null | tail -1 | cut -d: -f1); [ -n "$L" ] || return 0
  tail -n +"$L" "$1" | grep -qE '^### Reads (still running )?at hand-off \(cc-perms, ' || return 0
  # s: 0 outside a section, 1 on the line under its heading (its prose or its first bullet), 2 in its bullets
  t=$(awk -v L="$L" '
    NR <= L {print; next}
    /^### Reads (still running )?at hand-off \(cc-perms, / {s = 1; b = ""; next}
    s == 1 && !/^$/ && !/^#/ {s = 2; next}
    s == 2 && /^- / {next}
    {s = 0}
    /^$/ {b = b "\n"; next}
    {printf "%s", b; b = ""; print}' "$1") || return 1
  tmp=$(mktemp "$(dirname -- "$1")/.drop_reads.XXXXXX") || return 1
  { printf '%s\n' "$t" > "$tmp" && chmod --reference="$1" -- "$tmp" && sync -- "$tmp" && mv -f -- "$tmp" "$1"; } || { rm -f -- "$tmp"; return 1; }; }

# journal_fresh FILE — rc 0 when FILE's last `## HAND-OFF ENTRY <stamp>Z` heading is 0-15 minutes old. Stamps are
# written to the minute, so the age is counted in whole minutes: the current minute is 0 and fresh, minute 15 is
# still fresh, 16 is stale, and a stamp ahead of the clock is refused rather than trusted.
journal_fresh(){
  local l s a
  l=$(grep -E '^## HAND-OFF ENTRY ' "$1" 2>/dev/null | tail -1)
  [[ $l =~ ^'## HAND-OFF ENTRY '([0-9]{4}-[0-9]{2}-[0-9]{2})T([0-9]{2}:[0-9]{2})(:[0-9]{2})?Z ]] || return 1
  s=$(date -u -d "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}" +%s 2>/dev/null) || return 1
  a=$(( $(date -u +%s) / 60 - s / 60 ))
  [ "$a" -ge 0 ] && [ "$a" -le "$JOURNAL_MIN" ]; }

# listening PID — rc 0 when PID's message socket ($SOCKS/PID.sock) is a listening unix socket (/proc/net/unix
# flag 00010000), i.e. the session is up and can be reached
listening(){ awk -v s="$SOCKS/$1.sock" '$4 == "00010000" && $8 == s {f=1} END {exit !f}' /proc/net/unix 2>/dev/null; }

# settle — handoff's EXIT trap. Whatever stopped the hand-off (a die below, Bash's timeout, ^C, the session ending),
# the box ends with exactly one window perms. Once the successor's window is named perms the names have moved, so
# the cutover is finished forward: its session id recorded, the old window ended (or kept as perms~old for its running
# reads). Otherwise its window is closed
# (looked up by name if tmux was stopped before it said the id) and the old window gets back the name perms.
HO_PD=""; HO_OW=""; HO_NW=""; HO_SID=""; HO_GO=""; HO_DONE=""; HO_KEEP=""; HO_OSID=""
settle(){
  local rc=$? names w
  # ignored, not reset: a second TERM, ^C or hang-up mid-cleanup would otherwise stop it with perms~next still up
  trap - EXIT; trap '' TERM INT HUP
  { [ -n "$HO_GO" ] && [ -z "$HO_DONE" ]; } || exit "$rc"
  names=$("${TM[@]}" list-windows -t "$SESSION" -F '#{window_id} #{window_name}' 2>/dev/null)
  if [ -n "$HO_NW" ] && awk -v w="$HO_NW" -v n="$WIN" '$1 == w && $2 == n {f=1} END {exit !f}' <<<"$names"; then
    keep_old
    if [ -n "$HO_KEEP" ]; then
      echo "cc-perms: stopped after the names moved, so I finished the cutover: the new seat is $SESSION:$WIN, and this window stays as $WIN~old for its running reads (cc-perms retire ends it)" >&2
      exit 1; fi
    echo "cc-perms: stopped after the names moved, so I finished the cutover: the new seat is $SESSION:$WIN, and this window ends now" >&2
    "${TM[@]}" kill-window -t "$HO_OW" 2>/dev/null; exit 1; fi
  w=$HO_NW; [ -n "$w" ] || w=$(awk -v n="$WIN~next" '$2 == n {print $1; exit}' <<<"$names")
  [ -n "$w" ] && "${TM[@]}" kill-window -t "$w" 2>/dev/null
  "${TM[@]}" rename-window -t "$HO_OW" "$WIN" 2>/dev/null   # a no-op unless the first of the two moves had happened
  echo "cc-perms: I closed $SESSION:$WIN~next, so this seat stays $SESSION:$WIN and nothing else changed." >&2
  exit 1; }

# keep_old — once the names moved: record the new seat's session id, and the old one's beside it when the old window
# stays for its reads (HO_KEEP), so `cc-perms retire` from perms can ask whether perms~old still has one running
keep_old(){
  [ -n "$HO_KEEP" ] && printf '%s\n' "$HO_OSID" > "$HO_PD/session-id.old"
  printf '%s\n' "$HO_SID" > "$HO_PD/session-id"; }

handoff(){
  local who r U np t0 prompt nw why cl lexe reads
  lock "a relaunch or hand-off is already running; nothing started"
  # "It runs only when its caller descends from the claude process in the current perms window's pane" — the spec
  who=$(seat_caller) || die "refused — $who. Only the permission seat hands itself off. Nothing started."
  r=${who% *}; HO_OW=${who#* }; HO_PD="$H/.cc/state/$r/perms"
  # "The verb refuses unless perms-handoff.md gained a ## HAND-OFF ENTRY in the last 15 minutes" — the spec; the file
  # is handoff.md inside the seat's directory, fenced like brief.md (see THE JOURNAL above), and no other is read
  journal_fresh "$HO_PD/handoff.md" \
    || die "refused — no '## HAND-OFF ENTRY <UTC minute>Z' heading in the last $JOURNAL_MIN minutes of handoff.md in this seat's directory ($HO_PD). Write the START HERE entry there first. Nothing started."
  "${TM[@]}" list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qxF -e "$WIN~next" -e "$WIN~old" \
    && die "a window $SESSION:$WIN~next or $WIN~old is already open; close it (cc-perms retire ends $WIN~old once its reads are in), then run this again. Nothing started."
  why=$(above_clean "$HO_PD" "$r") || die "refused — $why. Move it away, then run this again. Nothing started."
  cl=$(launch_target) || die "refused — $cl. Nothing started."
  why=$(bin_clean) || die "refused — $why. Nothing started."
  why=$(pins_match "$HO_PD" "$cl") || die "refused — $why. Nothing started."
  if [ -n "$FX" ]; then lexe=$EXE; else lexe=$cl; fi   # a fixture's stand-in is a bash script
  # RUNNING READS: the old seat's subagents still out go to the successor in the START HERE entry it reads first
  HO_OSID=$(cat "$HO_PD/session-id" 2>/dev/null)
  drop_reads "$HO_PD/handoff.md" || die "could not take an earlier try's reads out of handoff.md; nothing started"
  if reads=$(reads_of "$HO_OSID"); then
    if [ -n "$reads" ]; then
      HO_KEEP=1
      { printf '\n### Reads still running at hand-off (cc-perms, %s)\n' "$(date -u +%Y-%m-%dT%H:%MZ)"
        printf 'The old seat stays as window %s~old until these report: it records each in security-reads.json and tells its asker, then ends with `cc-perms retire`. Once %s~old is gone, restart any of these that has no entry in the ledger at that head, and tell its asker.\n' "$WIN" "$WIN"
        sed 's/^/- /' <<<"$reads"; } >> "$HO_PD/handoff.md" || die "could not add the running reads to handoff.md; nothing started"
    fi
  else
    printf '\n### Reads at hand-off (cc-perms, %s)\nThe old seat'"'"'s subagents could not be read (no session id in session-id, or cc-handoff could not read its task files), so it ended with the hand-off. Check the ledger before you take a read you were asked for as done.\n' "$(date -u +%Y-%m-%dT%H:%MZ)" >> "$HO_PD/handoff.md"
  fi
  U='^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
  HO_SID=$(cat /proc/sys/kernel/random/uuid); [[ $HO_SID =~ $U ]] || die "could not pick a session id; nothing started"
  prompt="Read brief.md in this directory; it is your whole job. Then read the last \"START HERE\" entry in handoff.md in this same directory, and in no other file. Then tell the $r seat you are live (cc-msg $r). Then wait for requests."
  # fresh, always: a session id picked here and the fixed prompt, never --continue or --resume
  seat_argv "$HO_PD" "$cl" || die "could not write the launch link in $HO_PD; nothing started"
  SEAT+=(--session-id "$HO_SID" "$prompt")
  why=$(pins_again "$HO_PD" "$cl") || die "refused — $why. Nothing started."
  # from here every way out goes through settle; a signal is an exit with its own code, so EXIT sees it
  trap settle EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; HO_GO=1
  nw=$("${TM[@]}" new-window -d -P -F '#{window_id} #{pane_pid}' -t "$SESSION" -n "$WIN~next" -c "$HO_PD" -- "${SEAT[@]}" 9<&-) \
    || die "tmux would not open window $SESSION:$WIN~next."
  np=${nw#* }; HO_NW=${nw%% *}
  t0=$SECONDS
  until [ "$(comm_of "$np")" = claude ] && [ "$(readlink "/proc/$np/cwd" 2>/dev/null)" = "$HO_PD" ] \
        && [ "$(readlink "/proc/$np/exe" 2>/dev/null)" = "$lexe" ] && listening "$np"; do
    # "If the successor isn't live within about 3 minutes, the verb kills perms~next, keeps the old perms and says so"
    # — the spec; $UP is 90 s so that Bash's own timeout never ends the wait first (settle closes perms~next)
    [ $((SECONDS - t0)) -ge "$UP" ] && die "the new seat was not up after $UP s."
    sleep 1; done
  # ONE tmux call for both names, as cc-handoff's cutover: between two, no window is `perms`
  "${TM[@]}" rename-window -t "$HO_OW" "$WIN~old" \; rename-window -t "$HO_NW" "$WIN" 2>/dev/null \
    || die "tmux would not move the window names."
  keep_old   # the new seat's id, so the record names who holds the seat
  HO_DONE=1
  if [ -n "$HO_KEEP" ]; then
    echo "cc-perms: the new seat is $SESSION:$WIN (pid $np, fresh from brief.md and the START HERE entry). This window stays as $SESSION:$WIN~old for the reads still running:"
    sed 's/^/  /' <<<"$reads"
    echo "Record each in security-reads.json as it reports and tell its asker, then run cc-perms retire, which ends this window."
    return 0; fi
  echo "cc-perms: the new seat is $SESSION:$WIN (pid $np, fresh from brief.md and the START HERE entry); this window ends now"
  # "Ending the old window is the verb's last act" — the spec
  "${TM[@]}" kill-window -t "$HO_OW"; }

# retire — end perms~old, the old seat a hand-off kept for its running reads (RUNNING READS). From the old seat in
# perms~old it ends its own window once its reads are recorded (the seat decides when; nothing is checked). From the
# live seat in perms it ends perms~old only when that session has no subagent still running, read by the id handoff
# kept in session-id.old. It only ever ends the one window named perms~old, and starts nothing.
retire(){
  local who r pd ow left
  lock "a relaunch, hand-off or retire is already running; nothing ended"
  ow=$("${TM[@]}" list-windows -t "$SESSION" -F '#{window_id} #{window_name}' 2>/dev/null | awk -v n="$WIN~old" '$2 == n {print $1}')
  [ -n "$ow" ] || { echo "cc-perms: no window $SESSION:$WIN~old is open; nothing to end"; return 0; }
  [ "$(grep -c . <<<"$ow")" = 1 ] || die "more than one window $SESSION:$WIN~old is open; nothing ended"
  if who=$(seat_caller "$WIN~old"); then
    pd="$H/.cc/state/${who% *}/perms"
    rm -f -- "$pd/session-id.old"
    echo "cc-perms: ending $SESSION:$WIN~old, this window, now"
    "${TM[@]}" kill-window -t "$ow"; return 0; fi
  who=$(seat_caller) || die "refused — $who. Only the permission seat, old or new, ends $WIN~old. Nothing ended."
  pd="$H/.cc/state/${who% *}/perms"
  left=$(reads_of "$(cat "$pd/session-id.old" 2>/dev/null)") \
    || die "the old seat's session id is not in session-id.old, so its reads cannot be read; ask it to run cc-perms retire itself. Nothing ended."
  [ -z "$left" ] || die "$SESSION:$WIN~old still has reads running, so it stays:
$left"
  rm -f -- "$pd/session-id.old"
  echo "cc-perms: $SESSION:$WIN~old has no read still running; ending it now"
  "${TM[@]}" kill-window -t "$ow"; }

# pin — the seat records what its successor may start from (see WHAT THE SEAT STARTS FROM). The caller is checked as
# handoff's is, so only the seat in window perms pins; a planning seat, a worker or a member is refused.
pin(){
  local who pd cl old
  lock "a relaunch, hand-off or pin is already running; nothing pinned"
  who=$(seat_caller) || die "refused — $who. Only the permission seat pins what a new seat starts from. Nothing pinned."
  pd="$H/.cc/state/${who% *}/perms"
  cl=$(launch_target) || die "refused — $cl. Nothing pinned."
  old=$(cat "$pd/pins" 2>/dev/null)
  pin_now "$cl" "$pd" > "$pd/pins.$$" && mv -f -- "$pd/pins.$$" "$pd/pins" || { rm -f -- "$pd/pins.$$"; die "could not write $pd/pins; nothing pinned"; }
  echo "cc-perms: pinned what a new seat starts from, in $pd/pins"
  awk 'NR == FNR {o[$1] = $2; next} o[$1] != $2 {print "  now pinned: " $1; n++} END {if (!n) print "  nothing had changed"}' \
    <(printf '%s\n' "$old") "$pd/pins"; }

selfcheck(){
  local T pass=0 fail=0 pids="" out rc
  # the trap kills only a pid whose argv names a file under $T, so a wrong pid in $pids can never reach a real process
  T=$(mktemp -d); trap 'for p in $pids; do tr "\0" "\n" 2>/dev/null < "/proc/$p/cmdline" | grep -q "^$T/" && kill "$p" 2>/dev/null; done; rm -rf "$T"' RETURN
  ok(){ if [ "$1" = 0 ]; then pass=$((pass+1)); echo "  ok   $2"; else fail=$((fail+1)); echo "  FAIL $2"; printf "%s\n" "$out" | head -3; fi; }
  # fx NAME — a fresh fixture: a HOME with a seat for repo r1, a second repo r2 without one, a member workspace, a
  # track, a fake tmux whose panes come from $F/panes and whose new-window runs its command, and stand-ins for
  # claude (a sleeping script named claude) and a cc-model and a model override that both say evil-model, so a launch
  # that asked either would show it
  fx(){ F=$T/$1; H=$F/home; mkdir -p "$H/dev/r1" "$H/dev/r2" "$H/dev/m1/.cc" "$H/.cc/worktrees/r1/t1/.cc" \
      "$H/.cc/state/r1/perms" "$H/.local/bin" "$H/.local/share/claude/versions" "$H/bin" "$H/fixture-bin" "$F/fbin"
    : > "$H/dev/m1/.cc/member-workspace"; printf 'r1\nt1\n' > "$H/.cc/worktrees/r1/t1/.cc/track"
    printf 'brief\n' > "$H/.cc/state/r1/perms/brief.md"; : > "$F/panes"
    # the claude stand-in listens on its message socket like the real one, unless $F/nosock says it never comes up.
    # It lives in versions/ behind ~/.local/bin/claude, as the real one does, and writes down its argv and environment.
    { printf '#!/bin/bash\nF=%q; S=%q\n' "$F" "$H/cc-socks"; cat <<'EOF'
printf "%s\n" "$@" > "$F/args.$$"; env > "$F/env.$$"
[ -e "$F/nosock" ] || python3 -c 'import socket,sys,time; s=socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(); time.sleep(30)' "$S/$$.sock" </dev/null >/dev/null 2>&1 &
exec 0<&- 1>&- 2>&-
sleep 30
EOF
    } > "$H/.local/share/claude/versions/9.9.9"; ln -s "$H/.local/share/claude/versions/9.9.9" "$H/.local/bin/claude"
    chmod +x "$H/.local/share/claude/versions/9.9.9"; mkdir -p "$H/cc-socks"
    # ~/bin holds links into ~/dev, as the real one does; the launch refuses one that resolves anywhere else
    printf '#!/bin/sh\necho evil-model\n' > "$H/dev/r2/cc-model"; ln -s "$H/dev/r2/cc-model" "$H/bin/cc-model"; echo evil-model > "$H/.cc/state/model-override"
    # $F/panes holds "<window name> <pane pid>" lines; a window's id is @<pane pid>. Commands chain with `;` as in tmux.
    # It is called as `-S SOCKET CMD…`: a call naming any socket but $H/tmux.sock, or with TMUX or TMUX_TMPDIR in its
    # environment, is written down in $F/tmux.leak, since the real tmux would follow them to the real server
    { printf '#!/bin/bash\nF=%q; H=%q\n' "$F" "$H"; cat <<'EOF'
S=""; [ "${1:-}" = -S ] && { S=$2; shift 2; }
[ "$S" = "$H/tmux.sock" ] && [ -z "${TMUX+x}${TMUX_TMPDIR+x}" ] || echo "S=$S TMUX=${TMUX-} TMUX_TMPDIR=${TMUX_TMPDIR-} $*" >> "$F/tmux.leak"
echo "$*" >> "$F/tmux.log"; P=$F/panes
one(){ local c=$1 f="" n="" d="" pr="" t wn pp o; shift
  case "$c" in
    list-panes|list-windows) while [ $# -gt 0 ]; do [ "$1" = -F ] && { f=$2; shift; }; shift; done
      while read -r wn pp; do [ -n "$wn" ] || continue
        o=${f:-'#{window_name}'}; o=${o//'#{window_name}'/$wn}; o=${o//'#{pane_pid}'/$pp}; o=${o//'#{window_id}'/@$pp}
        printf '%s\n' "$o"; done < "$P";;
    # the launch is an argument list after `--`, run as it stands; a shell string (one word) is refused, as the
    # launch must never be one
    new-window) while [ $# -gt 0 ]; do case "$1" in -c) d=$2; shift 2;; -n) n=$2; shift 2;; -d) shift;; -P) pr=1; shift;; --) shift; break;; -*) shift 2;; *) break;; esac; done
      [ $# -gt 1 ] || { echo "fake tmux: new-window got a shell string, not an argument list" >&2; return 1; }
      rm -f "$F/pane.pid"
      (cd "$d" && setsid -f bash -c 'echo $$ > "$0"; exec "$@"' "$F/pane.pid" "$@" </dev/null >/dev/null 2>&1)
      for _ in $(seq 50); do [ -s "$F/pane.pid" ] && break; sleep 0.1; done; pp=$(cat "$F/pane.pid")
      echo "${n:-x} $pp" >> "$P"; [ -z "$pr" ] || echo "@$pp $pp";;
    rename-window) t=${2#@}; grep -q " $t\$" "$P" || return 1
      # $F/norename: the first move onto the name perms fails, as a tmux that went away between the two moves would
      [ "$3" = perms ] && [ -e "$F/norename" ] && { rm -f "$F/norename"; return 1; }
      awk -v t="$t" -v n="$3" '$2 == t {$1 = n} 1' "$P" > "$P.tmp" && mv "$P.tmp" "$P";;
    kill-window) t=${2#@}; grep -q " $t\$" "$P" || return 1
      awk -v t="$t" '$2 != t' "$P" > "$P.tmp" && mv "$P.tmp" "$P"
      # only a stand-in of this selfcheck is ever signalled: its argv names a file under the selfcheck's own dir
      tr '\0' '\n' < "/proc/$t/cmdline" 2>/dev/null | grep -q "^${F%/*}/" && kill "$t" 2>/dev/null; return 0;;
  esac; }
# $F/sigafter names commands, one a line: once a call starting with the first is done, the hand-off running it gets a
# TERM, as Bash's timeout would send, and the next line waits its turn. The topmost cc-perms handoff above is the
# script itself; any below it are its subshells.
post(){ [ "$(head -1 "$F/sigafter" 2>/dev/null)" = "$1" ] || return 0; sed -i 1d "$F/sigafter"; [ -s "$F/sigafter" ] || rm -f "$F/sigafter"
  local q=$PPID top="" n=0
  while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$n" -lt 8 ]; do
    # argv itself, never a substring of the whole line: a session whose prompt names "cc-perms handoff" is an ancestor
    # too, and matching its text TERMed the worker running this selfcheck (2026-10-13, #940 repair, rc 143 twice)
    tr '\0' '\n' < "/proc/$q/cmdline" 2>/dev/null | awk 'p ~ /(^|\/)cc-perms$/ && $0 == "handoff" {f=1} {p=$0} END {exit !f}' && top=$q
    q=$(awk '{print $4}' "/proc/$q/stat" 2>/dev/null); n=$((n+1)); done
  [ -n "$top" ] && kill -TERM "$top"; }
first=$1; a=(); for x in "$@"; do if [ "$x" = ";" ]; then one "${a[@]}" || exit 1; a=(); else a+=("$x"); fi; done
[ ${#a[@]} = 0 ] || one "${a[@]}" || exit 1
post "$first"
EOF
    } > "$H/fixture-bin/tmux"
    # cc-notify writes down each call, so no fixture ever reaches the real one (relaunch alerts the owner on the pins)
    printf '#!/bin/sh\n{ printf "%%s\\n" "$@"; echo ---; } >> %q\n' "$F/notify.log" > "$H/fixture-bin/cc-notify"
    chmod +x "$H/.local/bin/claude" "$H/bin/cc-model" "$H/fixture-bin/tmux" "$H/fixture-bin/cc-notify"
    HOME=$H "$0" __pins "$(sd)" > "$H/.cc/state/r1/perms/pins"; }   # what the seat would pin in this fixture as it stands
  # stand DIR [VAR=VAL…] — a stand-in session: a claude standing in DIR with exactly that environment; prints its pid
  # (SBIN=PATH stands in with that program instead, e.g. a copy of bash named claude, running the stand-in)
  # (SARG=ARG adds one argument, e.g. the skip flag the permission seat runs with)
  stand(){ local d=$1 b=${SBIN:-$T/claude}; shift; (cd "$d" && env -i "$@" setsid -f "$b" "$T/claude" ${SARG:+"$SARG"} </dev/null >/dev/null 2>&1)
    local f p; for _ in $(seq 40); do for f in /proc/[0-9]*/comm; do p=${f#/proc/}; p=${p%/comm}
      [ "$(cat "$f" 2>/dev/null)" = claude ] && [ "$(readlink "/proc/$p/cwd" 2>/dev/null)" = "$d" ] \
        && tr '\0' '\n' 2>/dev/null < "/proc/$p/cmdline" | grep -qxF "$b" && { echo "$p"; return; }
      done; sleep 0.1; done; }
  printf '#!/bin/bash\nexec 0<&- 1>&- 2>&-\nsleep 30\n' > "$T/claude"; chmod +x "$T/claude"
  # run PID — the verb ($V, default relaunch) from the stand-in session PID. Workers count as sandboxed unless $SBX
  # says otherwise (SBX=unset: neither the environment nor the outer CC_CONFIG gives it, so only $H/.cc/config can),
  # and the box's own repo is r2, where the fixture's ~/bin links point
  mkdir -p "$T/mk"; : > "$T/mk/good"; chmod 644 "$T/mk/good"   # the fixture's marker, owned by whoever runs this
  CC_PERMS_MARKER_UID=$(id -u); CC_PERMS_MARKER_GID=$(id -g); CC_PERMS_MARKER=$T/mk/good; export CC_PERMS_MARKER CC_PERMS_MARKER_UID CC_PERMS_MARKER_GID
  CC_PERMS_FIXTURE=1; export CC_PERMS_FIXTURE   # every call below is a fixture; nothing outside this function sets it
  # (TO=SECS runs the call under timeout, so a hang fails its case rather than the suite)
  run(){ local s=(CC_WORKER_SANDBOX="${SBX-1}") to=(); [ "${SBX-}" = unset ] && s=(-u CC_WORKER_SANDBOX); [ -n "${TO:-}" ] && to=(timeout "$TO")
    [ "${SBX-}" = unset ] || { mkdir -p "$H/.cc"; { grep -v '^CC_WORKER_SANDBOX=' "$H/.cc/config" 2>/dev/null; echo "CC_WORKER_SANDBOX=${SBX-1}"; } > "$H/.cc/config.n"; mv "$H/.cc/config.n" "$H/.cc/config"; }
    "${to[@]}" env -u CC_CONFIG "${s[@]}" HOME="$H" PATH="$F/fbin:$PATH" CC_BOX=r2 CC_PERMS_ROOT_PID="$1" "$0" "${V:-relaunch}" 2>&1; }
  sd(){ printf '%s' "$H/.cc/state/r1/perms"; }   # r1's seat directory in the current fixture
  started(){ grep -q '^new-window' "$F/tmux.log" 2>/dev/null; }
  seatargs(){ local p; p=$(HOME=$H "$0" __live "$H/.cc/state/r1/perms") || return 1; pids="$pids $p"
    for _ in $(seq 40); do [ -s "$F/args.$p" ] && break; sleep 0.1; done; cat "$F/args.$p"; }

  echo "cc-perms selfcheck"
  fx worker; c=$(stand "$H/.cc/worktrees/r1/t1" CC_ROLE=worker); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started && [[ $out == *refused* ]]; echo $?)" "a worker's session is refused and opens nothing"
  fx member; c=$(stand "$H/dev/m1" CC_ROLE=member); pids="$pids $c"; echo "m1 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started; echo $?)" "a member workspace's session is refused and opens nothing"
  fx other; c=$(stand "$H/dev/r2"); pids="$pids $c"; echo "r2 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started && [[ $out == *"no permission seat"* ]]; echo $?)" "another repo's planning seat is refused and opens nothing"
  fx role; c=$(stand "$H/dev/r1" CC_ROLE=worker); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started; echo $?)" "a session in r1 running as a worker is refused"
  fx recorded; mkdir -p "$H/.cc/member-facing"; : > "$H/.cc/member-facing/r1"; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started && [[ $out == *"member session"* ]]; echo $?)" "a session in r1, which the host records member-facing with no marker in the checkout, is refused as a member's"
  fx unsearchable; mkdir -p "$H/.cc/member-facing"; chmod 0 "$H/.cc/member-facing"; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  out=$(run "$c"); rc=$?; chmod 755 "$H/.cc/member-facing"
  ok "$( [ $rc = 1 ] && ! started && [[ $out == *"member session"* ]]; echo $?)" "…and so is one in r1 with no record when the record dir is unsearchable: a chmod fails closed"
  fx detached; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r2 $c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started && [[ $out == *"not in tmux window"* ]]; echo $?)" "a session in r1 outside window r1 is refused"
  fx nested; o=$(stand "$H/dev/r2"); pids="$pids $o"
  # a child claude in r1 under another claude: the parent is the outer stand-in, so the walk meets a second claude
  # (its trailing exit 0 keeps bash from exec'ing the child in its own place, which would leave no parent to meet)
  printf '#!/bin/bash\ncd %q && "%s"\nexit 0\n' "$H/dev/r1" "$T/claude" > "$T/outer-claude"; chmod +x "$T/outer-claude"
  mkdir -p "$T/o"; cp "$T/outer-claude" "$T/o/claude"; (cd "$H/dev/r2" && env -i setsid -f "$T/o/claude" </dev/null >/dev/null 2>&1)
  c=""; for _ in $(seq 40); do c=$(for f in /proc/[0-9]*/comm; do p=${f#/proc/}; p=${p%/comm}
      [ "$(cat "$f" 2>/dev/null)" = claude ] && [ "$(readlink "/proc/$p/cwd" 2>/dev/null)" = "$H/dev/r1" ] \
        && [ "$(tr '\0' '\n' < "/proc/$p/cmdline" 2>/dev/null | sed -n 2p)" = "$T/claude" ] && echo "$p"; done | head -1)
    [ -n "$c" ] && break; sleep 0.1; done
  # the inner stand-in only (its argv is $T/claude; the outer's is $T/o/claude): picking the outer made ppid_of its
  # parent, the user's systemd that setsid reparents to, and the RETURN trap SIGTERMed it (2026-10-02, every session down)
  op=$(ppid_of "${c:-0}"); tr '\0' '\n' < "/proc/${op:-0}/cmdline" 2>/dev/null | grep -qxF "$T/o/claude" || op=""
  pids="$pids $c $op"; echo "r1 $c" > "$F/panes"
  out=$(run "${c:-0}"); rc=$?
  ok "$( [ -n "$c" ] && [ $rc = 1 ] && ! started && [[ $out == *"another session"* ]]; echo $?)" "a claude started by another session in r1 is refused"
  fx forged; mkdir -p "$T/x"; cp "$(readlink -f /bin/bash)" "$T/x/claude"; c=$(SBIN=$T/x/claude stand "$H/dev/r1")
  pids="$pids $c"; echo "r1 $c" > "$F/panes"; out=$(run "${c:-0}"); rc=$?
  ok "$( [ -n "$c" ] && [ $rc = 1 ] && ! started && [[ $out == *"not the claude binary"* ]]; echo $?)" "a copy of another program named claude is refused"
  fx spaced; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; mkdir -p "$T/sp" "$H/.cc"
  echo 'CC_WORKER_SANDBOX=1' > "$H/.cc/config"
  # a non-claude between the call and r1's seat, named so a plain field count of its stat reads r1's seat as its parent;
  # no CC_PERMS_ROOT_PID, so the call walks its own process tree from there
  b="$T/sp/a b ${c:-0} c"; cp "$(readlink -f /bin/bash)" "$b"
  out=$(env -u CC_CONFIG -u CC_PERMS_ROOT_PID CC_WORKER_SANDBOX=1 HOME="$H" PATH="$F/fbin:$PATH" CC_BOX=r2 "$b" -c '"$1" relaunch 2>&1; exit $?' x "$0"); rc=$?
  # run under a session (no pid namespace of its own) the walk goes on past the spaced name to that session's own
  # claude, which is not this box's binary: either refusal says the walk did not land on r1's seat ("another session")
  ok "$( [ -n "$c" ] && [ $rc = 1 ] && ! started && [[ $out == *"not called from a session"* || $out == *"not the claude binary"* ]]; echo $?)" "a parent whose name holds spaces and a pid does not lead the walk to that pid"
  fx window; c=$(stand "$H/dev/r1"); pids="$pids $c"; printf 'r1 %s\nperms 1\n' "$c" > "$F/panes"
  out=$(run "$c"); rc=$?
  ok "$( [ $rc = 1 ] && ! started; echo $?)" "an open perms window with no seat in it is left alone"
  # ── the go-live gate is retired (2026-10-14): the worker-sandbox key and the owner's marker no longer decide ──
  # with the key at 0, no marker anywhere and HOME elsewhere, gate says open and relaunch goes ahead
  fx sandbox; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  g1=$(env HOME="$H" PATH="$F/fbin:$PATH" CC_BOX=r2 CC_PERMS_MARKER="$T/mk/none" "$0" gate 2>&1); g2=$?
  g0=$(env -u CC_PERMS_FIXTURE -u CC_PERMS_MARKER HOME="$AH" "$0" gate 2>&1)
  out=$(SBX=0 CC_PERMS_MARKER="$T/mk/none" run "$c"); r1=$?
  ok "$( [ "$g2$r1" = 00 ] && [ "$g1" = open ] && [ "$g0" = open ] && started && [[ $out == *"back in"* ]] \
      && [[ $out != *"workers run unsandboxed"* ]]; echo $?)" \
    "relaunch: the retired gate refuses nothing — key at 0, no marker, and gate says open from the fixture and the passwd home ($g2$r1)"

  fx fresh; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  out=$(CC_MODEL_PRIMARY=evil-model run "$c"); rc=$?; a=$(seatargs)
  ok "$( [ $rc = 0 ] && started && grep -qxF -- --fixture-no-bypass <<<"$a" && ! grep -qx -- '--dangerously-skip-permissions' <<<"$a" \
      && grep -qxF "$PROMPT" <<<"$a" && ! grep -qx -- --resume <<<"$a" && grep -qx -- --session-id <<<"$a" \
      && grep -qxF "$(cat "$H/.cc/state/r1/perms/session-id")" <<<"$a" && grep -qxF 'claude-opus-5-5[1m]' <<<"$a" \
      && ! grep -q evil <<<"$a" && [[ $out == *"fresh from brief.md"* ]] && grep -A1 -x -- --effort <<<"$a" | grep -qx high; echo $?)" \
    "r1's planning seat brings the seat back from brief.md, on the pinned model and not cc-model's, an override's or the env's, at high effort when the config names none (a fixture never skips permissions)"
  : > "$F/tmux.log"; out=$(run "$c"); rc=$?
  ok "$( [ $rc = 0 ] && ! started && [[ $out == *"already live"* ]]; echo $?)" "a second call while the seat is live does nothing"
  # ── the effort: CC_PERMS_EFFORT in ~/.cc/config when it is one of claude's levels; the env never, anything else gives high ──
  fx effort; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; echo 'CC_PERMS_EFFORT="xhigh"' > "$H/.cc/config"
  out=$(CC_PERMS_EFFORT=low run "$c"); rc=$?; a=$(seatargs)
  ok "$( [ $rc = 0 ] && grep -A1 -x -- --effort <<<"$a" | grep -qx xhigh && ! grep -qx low <<<"$a"; echo $?)" \
    "the seat runs at the effort ~/.cc/config names, not the env's ($rc)"
  fx effortbad; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; echo 'CC_PERMS_EFFORT=max --resume x' > "$H/.cc/config"
  out=$(CC_PERMS_EFFORT=max run "$c"); rc=$?; a=$(seatargs)
  ok "$( [ $rc = 0 ] && grep -A1 -x -- --effort <<<"$a" | grep -qx high && ! grep -qx -- --resume <<<"$a" && ! grep -qx max <<<"$a"; echo $?)" \
    "a CC_PERMS_EFFORT that is not one of claude's levels gives high, whatever the env says ($rc)"

  fx resume; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  # the recorded conversation, and a newer one planted beside it, as any unsandboxed shell could write
  t="$H/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$(sd)")"; mkdir -p "$t"
  u=0f0f0f0f-1111-4222-8333-444455556666; echo "$u" > "$(sd)/session-id"; echo '{}' > "$t/$u.jsonl"
  sleep 1; echo '{}' > "$t/ffffffff-0000-4000-8000-000000000000.jsonl"
  out=$(run "$c"); rc=$?; a=$(seatargs)
  ok "$( [ $rc = 0 ] && ! grep -qx -- --resume <<<"$a" && ! grep -qx -- --continue <<<"$a" && ! grep -qxF "$u" <<<"$a" \
      && ! grep -q ffffffff <<<"$a" && grep -qx -- --session-id <<<"$a" && grep -qxF "$(cat "$(sd)/session-id")" <<<"$a" \
      && ! grep -qxF "$u" "$(sd)/session-id" && grep -qxF "$PROMPT" <<<"$a" && [[ $out == *"starting fresh"* ]]; echo $?)" \
    "relaunch never resumes: with a recorded transcript, and a newer one planted beside it, the seat starts fresh from brief.md and its journal under a new id"
  fx planted; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  t="$H/.claude/projects/$(sed 's/[^A-Za-z0-9]/-/g' <<<"$H/.cc/state/r1/perms")"; mkdir -p "$t"; echo '{}' > "$t/ffffffff-0000-4000-8000-000000000000.jsonl"
  out=$(run "$c"); rc=$?; a=$(seatargs)
  ok "$( [ $rc = 0 ] && ! grep -q ffffffff <<<"$a" && ! grep -qx -- --resume <<<"$a" && grep -qxF "$PROMPT" <<<"$a"; echo $?)" \
    "with no recorded id a transcript someone left there is ignored and the seat starts from brief.md"

  # ── nothing above the seat steers it, and the launch is the program in versions/, under env -i, as an argument list ──
  fx above; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; rs=""; ss=""
  for f in .cc/state/r1/CLAUDE.md .cc/state/CLAUDE.local.md .cc/.claude/ CLAUDE.md CLAUDE.local.md r2link; do
    case "$f" in */) mkdir -p "$H/$f";; r2link) ln -s "$H/dev/r2/CLAUDE.md" "$H/CLAUDE.md";; *) echo planted > "$H/$f";; esac
    out=$(run "$c"); rs+="$?"; started && ss+=y; [[ $out == *"sits above"* ]] || ss+=n
    case "$f" in */) rmdir "$H/$f";; r2link) rm -f "$H/CLAUDE.md";; *) rm -f "${H:?}/$f";; esac; done
  ok "$( [ "$rs" = 111111 ] && [ -z "$ss" ] && [ ! -e "$(sd)/session-id" ] && echo 0 || echo 1)" \
    "a CLAUDE.md, CLAUDE.local.md or .claude/ above the seat (its repo's state, ~/.cc/state, ~/.cc, home), or a ~/CLAUDE.md that is a file or a link into another repo, refuses the launch ($rs$ss)"
  fx homelink; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"
  echo rules > "$H/dev/r1/CLAUDE.md"; ln -s "$H/dev/r1/CLAUDE.md" "$H/CLAUDE.md"; mkdir -p "$H/.claude"
  echo '{"mcpServers":{"planted":{"command":"/bin/false"}}}' > "$H/.claude.json"   # the account's MCP list: never read
  HOME=$H "$0" __pins "$(sd)" > "$(sd)/pins"   # even pinned, so the launch goes ahead
  out=$(PLANTED=1 run "$c"); rc=$?; p=$(HOME=$H "$0" __live "$(sd)"); pids="$pids $p"
  for _ in $(seq 40); do [ -s "$F/env.$p" ] && [ -s "$F/args.$p" ] && break; sleep 0.1; done
  envs=$(cat "$F/env.${p:-x}" 2>/dev/null); a=$(cat "$F/args.${p:-x}" 2>/dev/null)
  ok "$( [ $rc = 0 ] && [ -n "$p" ] && grep -q '^new-window .* -c [^ ]*/perms -- /bin/sh -c ' "$F/tmux.log" \
      && [ "$(readlink "$(sd)/launch/claude")" = "$H/.local/share/claude/versions/9.9.9" ] \
      && grep -qxF "HOME=$H" <<<"$envs" && grep -qx 'LANG=C.UTF-8' <<<"$envs" && grep -qx 'TERM=tmux-256color' <<<"$envs" \
      && grep -qxF "PATH=$H/bin:/usr/local/bin:/usr/bin:/bin" <<<"$envs" && grep -qxF "PYTHONPYCACHEPREFIX=$(sd)/launch/pycache" <<<"$envs" \
      && ! grep -qE '^(PLANTED|CC_PERMS_ROOT_PID)=' <<<"$envs"; echo $?)" \
    "a CLAUDE.md in home that links into the repo, and .claude in home, are allowed, and the seat starts from its argument list under env -i (PATH ~/bin and the system's, no ~/.local/bin), through the program in versions/"
  no=$(sed -n 's/^CC_AGENT_NO=//p' <<<"$envs")
  ok "$( [[ "$no" =~ ^a[0-9]+$ ]] && jq -e --arg no "$no" 'select(.id == $no and .kind == "perms" and .name == "r1/perms")' \
      "${CC_AGENT_LEDGER:-$H/.cc/state/agent-numbers.jsonl}" >/dev/null; echo $?)" \
    "the seat takes a fresh number from the box's sequence (cc-agent-number) and carries it as CC_AGENT_NO ($no)"
  ok "$( [ "$(sed -n 1p <<<"$a")" = --strict-mcp-config ] && [ "$(sed -n 2p <<<"$a")" = --mcp-config ] && [ "$(sed -n 3p <<<"$a")" = "$(sd)/launch/mcp.json" ] \
      && [ "$(jq -c '.mcpServers | to_entries | map([.key, .value.command, .value.args, .value.env])' "$(sd)/launch/mcp.json")" \
           = "$(jq -nc --arg c "$(dirname -- "$(readlink -f -- "$0")")/cc-slack" '[["cc-slack", $c, ["channel", "r1"], {CC_SLACK_ALIAS: "perms"}]]')" ] \
      && ! grep -q planted <<<"$a"; echo $?)" \
    "the seat loads only the MCP servers in its own launch/mcp.json (cc-slack beside this script), never the account's"

  # ── the pins: ~/.claude's startup entries and the binary must be what the seat pinned, and ~/bin only links into ~/dev ──
  fx pins; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; rs=""; ss=""; C=$H/.claude; V9=$H/.local/share/claude/versions/9.9.9
  cp "$(sd)/pins" "$F/pins.good"; cp "$V9" "$F/v9.good"
  for f in nopins CLAUDE.md rules agents skills commands output-styles plugins settings.json settings.local.json .json binary; do
    case "$f" in
      nopins) rm -f "$(sd)/pins";;
      CLAUDE.md) mkdir -p "$C"; echo planted > "$C/CLAUDE.md";;
      settings.json|settings.local.json) mkdir -p "$C"; echo '{"hooks":{"Stop":[{"hooks":[{"type":"command","command":"/tmp/x"}]}]}}' > "$C/$f";;
      .json) echo '{"mcpServers":{"x":{"command":"/tmp/x"}}}' > "$C.json";;
      binary) echo '# a new build' >> "$V9";;
      plugins) mkdir -p "$C/plugins/cache/m/p"; echo planted > "$C/plugins/cache/m/p/hook.sh";;
      *) mkdir -p "$C/$f/x"; echo planted > "$C/$f/x/SKILL.md";;
    esac
    out=$(run "$c"); rs+="$?"; started && ss+=y
    case "$f" in nopins) [[ $out == *"pinned nothing"* ]] || ss+=n;; binary) [[ $out == *"$V9 is not what the seat pinned"* ]] || ss+=n;;
      .json) [[ $out == *"$C.json is not what the seat pinned"* ]] || ss+=n;;
      *) [[ $out == *"$C/$f is not what the seat pinned"* ]] || ss+=n;; esac
    rm -rf "${C:?}" "$C.json"; cp "$F/pins.good" "$(sd)/pins"; cp "$F/v9.good" "$V9"; done
  ok "$( [ "$rs" = 111111111111 ] && [ -z "$ss" ] && [ ! -e "$(sd)/session-id" ] && echo 0 || echo 1)" \
    "no pins, or a changed ~/.claude/CLAUDE.md, rules/, agents/, skills/, commands/, output-styles/, plugins/, settings.json, settings.local.json, ~/.claude.json or claude binary, refuses the launch and names it ($rs$ss)"
  # ── the owner's alert: a relaunch refused on the pins says so to him once per set of entries, with the hand command ──
  fx alert; c=$(stand "$H/dev/r1"); pids="$pids $c"; echo "r1 $c" > "$F/panes"; C=$H/.claude
  mkdir -p "$C/skills/x"; echo planted > "$C/skills/x/SKILL.md"
  out=$(run "$c"); r1=$?; out=$(run "$c"); r2=$?; n1=$(grep -c '^---$' "$F/notify.log" 2>/dev/null); a1=$(cat "$F/notify.log" 2>/dev/null)
  echo planted > "$C/CLAUDE.md"; out=$(run "$c"); r3=$?; n2=$(grep -c '^---$' "$F/notify.log" 2>/dev/null); s3=$(started && echo y)
  rm -rf "${C:?}"; out=$(run "$c"); r4=$?
  ok "$( [ "$r1$r2$r3$r4" = 1110 ] && [ "$n1" = 1 ] && [ "$n2" = 2 ] && [ -z "$s3" ] && grep -qxF -- --owner <<<"$a1" \
      && grep -qF "changed since it last pinned them: $C/skills." <<<"$a1" \
      && grep -qF "tmux new-window -t main -n perms -c ~/.cc/state/r1/perms -- ~/.local/bin/claude --model '$MODEL'" <<<"$a1" \
      && grep -qF -- '--dangerously-skip-permissions' <<<"$a1" && [[ $(tail -n +2 "$F/notify.log") == *"since it last pinned them: $C/CLAUDE.md, $C/skills."* ]] \
      && [ ! -e "$(sd)/pins-alerted" ] && started && echo 0 || echo 1)" \
