           and [m["what"] for m in both[0]["more"]] == ["row two waits on him too"])
        ok("both leave the file in that one delivery — the session hears the second problem, not only the last written",
           n(rec, "inject") == 1 and "row one waits on the owner" in rec and "row two waits on him too" in rec
           and "one more row" in rec)
        logged = read(f"{SEC}/secretary.log").splitlines()
        ok("the log keeps both too: the first is a `new` record, the second an `also` on it — neither is silent",
           sum(f" new {k_} " in f" {ln} " for ln in logged for k_ in [both[0]["fp"]]) == 1
           and any(f"also {both[0]['fp']}" in ln and "row two waits on him too" in ln for ln in logged))
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2", "needs": "❓ 3h · do these need me?\n"
                                           "❓ 4h · one more row\n❓ 4h · a third row"}},
                  open(f"{STATE}/home.json", "w"))   # the band's words moved, so it is judged again
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [
            {"target": "home/needs", "what": f"problem {i}", "why": "x", "evidence": "one more row"} for i in range(5)]}))
        rc, o3, rec3 = run("--tick")
        again = list(led().values())[0]
        ok(f"the extras are bounded and are this tick's own: five problems keep the first and MORE_MAX={MORE_MAX} more, "
           "and last tick's extras are replaced, never stacked",
           again["what"] == "problem 0" and [m["what"] for m in again["more"]] == [f"problem {i}" for i in (1, 2, 3)]
           and again["ticks"] == 2)
        ok("the band changed and a NEW problem is flagged on it: a second delivery, naming the new problem — the record "
           "is the item, but what was delivered is the evidence (review-174b)",
           n(rec3, "inject") == 1 and "problem 0" in rec3 and again["sent_hash"] == again["hash"])
        rc, o4, rec4 = run("--tick")
        ok("…and the same evidence re-confirmed next tick is not delivered again", n(rec4, "inject") == 0)
        open(tmuxf, "w").write("@1\talpha\t100\t0\n@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")

        # (1c) the ledger written BEFORE records kept a status (flat file, numbers as strings) is migrated, not dropped
        fresh()
        off_at = now() - 5 * 3600   # offered longer ago than CC_SECRETARY_WINDOW, so the re-offer is due: relative, because
        legacy = {"concern": "sessions", "target": "sessions/box",   # a fixed epoch would cross that window as the days pass
                  "what": "stuck on the MCP trust dialog", "why": "needs a key",
                  "evidence": "Use this MCP server?", "hash": "580ce7b26230", "janitor": "", "first": "1788274058.1",
                  "last": "1788342757.1", "ticks": "59", "stood": "59", "hash_at_first": "580ce7b26230", "offered": "True",
                  "paged_at": "0", "offered_at": str(off_at)}
        worker = {"concern": "workers", "target": "workers/alpha/t1", "what": "silent for hours", "why": "the board says running",
                  "evidence": "did a step", "hash": "0f0f0f0f0f0f", "janitor": "", "first": "1788274058.1",
                  "last": "1788342757.1", "ticks": "12", "stood": "12", "offered": "True", "paged_at": "0",
                  "offered_at": str(off_at)}   # the old version injected file-class findings too — this PR is what stopped it
        open(verdict, "w").write(json.dumps({"ok": True, "findings": []}))
        run("--tick")   # a tick first, so gate.json holds every item hash — the flat ledger below is what the OLD
        open(f"{SEC}/findings.json", "w").write(json.dumps({"1a2ff7320ef0": legacy, "2b3ff7320ef1": worker}))
        os.environ["CC_SECRETARY_PAGES"] = "0"   # version left behind, and nothing has moved since (no call, no re-judge)
        rc, o, rec = run("--tick")   # shadow mode: the re-offer goes to the session, which is the path being asserted
        old, wold = led(True).get("1a2ff7320ef0") or {}, led(True).get("2b3ff7320ef1") or {}
        ok("a record from the flat findings.json is migrated on the first tick — status, ISO times, heard/sent from "
           "offered/offered_at — and is still in the ledger afterwards, not silently gone (review-174b)",
           old.get("status") == "open" and wold.get("status") == "open" and wold.get("heard") is True
           and wold.get("sent") == stamp(off_at) and old.get("ticks", 0) >= 59
           and "migrated 2 record" in read(f"{SEC}/secretary.log") and n(rec, "claude") == 0)   # not a re-judge
        ok("the migrated dialog record is DECISION class, read off its own evidence because a legacy record has no head — "
           "and it is still delivered, which classing it `file` would have stopped for good (review-174)",
           old.get("class") == "decision" and n(rec, "inject box") == 1 and "stuck on the MCP trust dialog" in rec
           and epoch(old.get("sent")) > off_at)   # the re-offer moved it: the 4-hourly delivery is alive
        ok("(suppressed) the legacy record that quotes no dialog stays `file` — it is a line in the ledger and reaches "
           "nobody, so the migration widens nothing",
           wold.get("class") == "file" and "silent for hours" not in rec and n(rec, "inject") == 1
           and epoch(wold.get("sent")) == int(off_at))   # its migrated sent stands: nothing re-offered it
        os.environ["CC_SECRETARY_PAGES"] = "2"

        # (2) only a decision-class finding is injected; everything else is file-only
        fresh(); open(f"{panes}/@4", "w").write("Use this MCP server?\n 1. Yes\nEnter to confirm \u00b7 Esc to cancel\n")
        open(f"{STATE}/alpha/t1/progress.md", "w").write("- did a step\n- and then stalled\n")
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [
            {"target": "workers/alpha/t1", "what": "silent for hours", "why": "the board still says running", "evidence": "and then stalled"},
            {"target": "sessions/box", "what": "stuck on the MCP trust dialog", "why": "the session never loads its channel",
             "evidence": "Use this MCP server?"}]}))
        rc, o1, rec = run("--tick")
        by_t = {f_["target"]: f_ for f_ in led().values()}
        ok("both are recorded, and only the modal — a key nobody but the owner may press — is delivered anywhere",
           len(by_t) == 2 and by_t["workers/alpha/t1"]["class"] == "file" and by_t["sessions/box"]["class"] == "decision"
           and n(rec, "inject") == 1 and n(rec, "inject abox") == 1 and by_t["sessions/box"]["sent"]
           and not by_t["workers/alpha/t1"]["sent"] and "[file] secretary/workers" in o1)
        run("--tick"); rc, o, rec2 = run("--tick")
        w = list(f_ for f_ in led().values() if f_["target"] == "workers/alpha/t1")[0]
        ok("a file-class finding standing three ticks is still never injected and never paged — it is a line, and that is all of it",
           w["ticks"] == 3 and not w["sent"] and not w["paged"] and n(rec2, "inject") == 0 and n(rec2, "notify") == 0)

        # (3a) a NEEDS YOU row is judged against EVERY repo's board, not one
        fresh()
        json.dump({"repo": "beta", "tracks": [{"name": "w5", "status": "open", "title": "push refused"},
                                             {"name": "w4", "status": "done", "title": "landed hours ago"}]},
                  open(f"{BOARDS}/beta.json", "w"))
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2\n\U0001f3c3 *t1* \u00b7 5m",
                                          "needs": "NEEDS YOU \u00b7 1\n\u2753 [beta] *w5* \u00b7 push refused"}},
                  open(f"{STATE}/home.json", "w"))
        rc, o, rec = run("--dry-run")
        ok("(3a) neither band names a repo alpha owns — `[beta] *w5*` and the bare `*t1*`: the roster carries every "
           "repo's board, so beta/w5 resolves beside alpha's own rows",
           all(r in seg(rec, "home/roster") for r in ("beta/w5 status=open", "alpha/t1 status=running",
                                                       "alpha/ece1 status=open kind=session", "alpha/cctest-leak status=open"))
           and "beta/w4" not in seg(rec, "home/roster") and "repos=2 rows=4" in seg(rec, "home/roster").split(">")[0]
           and "resolve every row you judge against `home/roster`" in rec and "in NO repo's board" in rec)
        os.remove(f"{BOARDS}/beta.json")

        # (3a') the roster is CONTEXT: a tick where only a Home band moved still carries it. A Slack message moves the
        # bands and no board row, and bare names judged with nothing to resolve them against is the DONE-3 false positive
        fresh(); open(verdict, "w").write(json.dumps({"ok": True, "findings": []}))
        run("--tick")                                            # tick 1: everything is judged and gated
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2", "needs": "❓ 3h · do these need me?",
                                           "sessions": "SESSIONS · 1\n*alpha*\n  ↳ 🟢 ece1 · a new line from Slack"}},
                  open(f"{STATE}/home.json", "w"))                # only a band moves — no board, so the roster hash stands
        rc, o, rec = run("--tick")
        ok("(3a') a band moved and no board row did: the roster rides along unjudged-but-present, so the bare names in "
           "the band still resolve — and it goes in FIRST, where a full bundle cannot cut it",
           '<item id="home/roster"' in rec and '<item id="home/sessions"' in rec and n(rec, "claude") == 1
           and rec.index('<item id="home/roster"') < rec.index('<item id="home/sessions"')
           and "alpha/t1 status=running" in seg(rec, "home/roster"))
        rc, o, rec = run("--tick")
        ok("(3a') and it never makes a call of its own: with nothing changed, the owner concern is not judged at all",
           n(rec, "claude") == 0 and "no call made" in o)

        # (3b) a worker parked by a usage limit, or between iterations, is running — not "the loop ended"
        fresh()
        open(f"{STATE}/alpha/t1/loop.log", "w").write(
            f"{stamp(now() - 3000)} iter 1/2 start (budget $8, turns 80)\n"
            f"{stamp(now() - 600)} iter 1 end rc=0 err=false/success turns=28 cost=$1.20 total=$1.20 commits=yes journal=updated\n")
        rc, o, rec = run("--dry-run")
        ok("(3b) one iteration ended and the next has not started: state=\"between iterations\", and the rubric calls that RUNNING",
           'state="between iterations"' in seg(rec, "workers/alpha/t1").split(">")[0] and "are all a worker that is RUNNING" in rec)
        open(f"{STATE}/alpha/t1/loop.log", "a").write(f"{stamp(now() - 300)} usage limit \u2014 waiting until 08:00Z, then rerunning iteration 2\n")
        rc, o, rec = run("--dry-run")
        ok("(3b) parked on a usage limit: state names the reset the loop is sleeping to, so silence beside it explains itself",
           'state="parked waiting until 08:00Z"' in seg(rec, "workers/alpha/t1").split(">")[0])
        open(f"{STATE}/alpha/t1/loop.log", "a").write(f"{stamp(now() - 60)} DONE\n")
        rc, o, rec = run("--dry-run")
        ok("(3b) a loop that really ended says so — state=ended against a board that still says running is the finding the rubric keeps",
           'state="ended"' in seg(rec, "workers/alpha/t1").split(">")[0]
           and "state=ended (a DONE or `exit N:` line) while the board still says running" in rec)

        # (3c) a selftest fixture is never a finding, because nothing about one is ever quotable
        fresh()
        json.dump({"repo": "_cctest77", "tracks": [{"name": "g1", "status": "running", "title": "fixture"}]}, open(f"{BOARDS}/_cctest77.json", "w"))
        os.makedirs(f"{WTS}/alpha/_cctest88", exist_ok=True)
        json.dump({"at": stamp(), "tracks": dict(snap, **{"_cctest77/g1": {"state": "running", "board": "running", "live": True}})},
                  open(f"{STATE}/reconcile.json", "w"))
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2\n\U0001f3c3 *_cctest77* g1 \u00b7 5m"}}, open(f"{STATE}/home.json", "w"))
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [{"target": "home/tally", "what": "a fixture row is on the tab",
                                                                        "why": "it is not real work", "evidence": "*_cctest77* g1"}]}))
        rc, o, rec = run("--tick")
        ok("(3c) no fixture reaches a model — no _cctest board, worktree, tab row or snapshot line is anywhere in the bundle, so a "
           "verdict quoting one has no verbatim quote and is dropped", "_cctest" not in rec and not led())
        os.remove(f"{BOARDS}/_cctest77.json"); shutil.rmtree(f"{WTS}/alpha/_cctest88", ignore_errors=True)

        # (3d) a row idle because it waits on a person is waiting, not stuck
        fresh()
        json.dump({"at": stamp(), "tracks": dict(snap, **{"alpha/t1": dict(snap["alpha/t1"], waiting_on="the owner")})},
                  open(f"{STATE}/reconcile.json", "w"))
        rc, o, rec = run("--dry-run")
        ok("(3d) waiting_on rides on the worker header and on the roster row, and both rubrics say waiting is not stuck",
           'waiting_on="the owner"' in seg(rec, "workers/alpha/t1").split(">")[0]
           and "alpha/t1 status=running waiting_on=the owner" in seg(rec, "home/roster")
           and "waiting is not stuck, and never a finding" in rec and "that is waiting, not stuck" in rec)
        json.dump({"at": stamp(now() - 120), "tracks": snap}, open(f"{STATE}/reconcile.json", "w"))

        # (3e) a loop somebody stopped to take the track over by hand: no cc-loop process, and an INTERACTIVE claude
        # in that track's own window. The loop log alone reads as `the loop ended`, and that was reported on 17 ticks
        # running (a member workspace's track, 2026-09-02).
        fresh()
        open(f"{STATE}/alpha/t1/loop.log", "w").write(
            f"{stamp(now() - 3000)} iter 1/2 start (budget $8, turns 80)\n{stamp(now() - 900)} DONE\n")
        open(psf, "w").write("101 100 900 /home/x/.local/bin/claude --append-system-prompt planning\n"
                             "201 200 3000 /home/x/.local/bin/claude\n")     # the person's own session, in alpha/t1
        rc, o, rec = run("--dry-run")
        w = seg(rec, "workers/alpha/t1").split(">")[0]
        ok("(3e) the loop is gone but a person's own session is in that track's window: interactive=yes rides on the "
           "header, and the rubric says `no process` beside it is never a finding",
           "interactive=yes" in w and "process=NONE" in w
           and "the loop was stopped by hand and the work is being driven live" in rec)
        open(psf, "w").write("101 100 900 /home/x/.local/bin/claude --append-system-prompt planning\n"
                             "201 200 3000 /home/x/.local/bin/claude -p # TASK\n")   # a headless worker, not a person
        rc, o, rec = run("--dry-run")
        w = seg(rec, "workers/alpha/t1").split(">")[0]
        ok("(3e) …and a `claude -p` in the same window is not a person: interactive is empty there, so a loop that "
           "really did stop with nobody on it is still flagged",
           "interactive" not in w and "process=NONE" in w and 'state="ended"' in w)
        shutil.rmtree(BIN, ignore_errors=True)
    print(f"cc-secretary selfcheck: {p} passed, {f} failed")
    return 1 if f else 0


FAKES = {
    "claude": r"""#!/usr/bin/env bash
# records its argv and the prompt, answers with the fixture verdict
{ printf 'claude'; printf ' %q' "$@"; printf ' think=%s' "${MAX_THINKING_TOKENS-unset}"; echo; } >> "$CC_FAKE_CALLS"; cat >> "$CC_FAKE_CALLS"; echo >> "$CC_FAKE_CALLS"
v=$(cat "$CC_FAKE_VERDICT" 2>/dev/null || echo '{"ok":true,"findings":[]}')
printf '{"type":"result","subtype":"success","is_error":false,"structured_output":%s,"total_cost_usd":0.0031,"num_turns":2,"modelUsage":{"claude-haiku-4-5-20251001":{}},"usage":{"input_tokens":12,"cache_creation_input_tokens":3000,"cache_read_input_tokens":0,"output_tokens":80}}' "$v"
""",
    "tmux": r"""#!/usr/bin/env bash
cmd="${1:-}"; shift; targ=""
while [ $# -gt 0 ]; do case "$1" in -t) targ="${2:-}"; shift 2;; *) shift;; esac; done
case "$cmd" in
  list-windows) cat "$CC_FAKE_TMUX";;
  capture-pane) cat "$CC_FAKE_PANES/$targ" 2>/dev/null;;
esac
exit 0
""",
    "cc-slack": r"""#!/usr/bin/env bash
case "${1:-}" in
  inject) shift; [ "$1" = --no-start ] && shift; printf 'inject %s :: %s\n' "$1" "$2" >> "$CC_FAKE_CALLS"
          [ -n "${CC_FAKE_QUEUE:-}" ] && echo queued || echo delivered;;
  history) echo "10:00 owner: why is x?"; echo "10:02 abox: because y.";;
esac
""",
    "cc-notify": r"""#!/usr/bin/env bash
printf 'notify %s\n' "$*" >> "$CC_FAKE_CALLS"
""",
    "cc-janitor": r"""#!/usr/bin/env bash
echo "cc-janitor alpha (dry run)"
[ -n "${CC_FAKE_JANITOR:-}" ] && echo "  would kill window alpha/old — a bare shell on a track that is merged"
echo "cc-janitor: 0 swept, 0 reported (dry run — nothing changed)"
""",
    "cc-units": "#!/usr/bin/env bash\necho 'user units — all 3 enabled, active and armed'\n",
    "cc-scope": "#!/usr/bin/env bash\ncat \"$CC_FAKE_SCOPE/$2.json\"\n",
    "cc-limit": r"""#!/usr/bin/env bash
case "$1" in status) [ -s "$CC_LIMIT_STAMP" ] && { echo "usage limit until 12:00Z"; exit 0; }; echo clear; exit 1;; *) exit 1;; esac
""",
    "systemctl": "#!/usr/bin/env bash\necho 'n/a   n/a   -   -   cc-dead.timer   cc-dead.service'\n",
    "ps": "#!/usr/bin/env bash\ncat \"$CC_FAKE_PS\"\n",
}


def main(argv):
    if argv[:1] == ["--tick"]:
        return tick(False)
    if argv[:1] == ["--dry-run"]:
        return tick(True)
    if argv[:1] == ["status"]:
        return status()
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    print("usage: cc-secretary --tick | --dry-run | status | selfcheck", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
