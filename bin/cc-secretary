MODEL = {"sessions": "haiku", "workers": "haiku", "asks": "sonnet", "owner": "sonnet", "box": "haiku"}
ORDER = ("sessions", "workers", "asks", "owner", "box")


# ── small things ─────────────────────────────────────────────────────────────────────────────────────────
def now():
    return time.time()


def stamp(t=None):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def epoch(s):
    try:
        return float(calendar.timegm(time.strptime(str(s), "%Y-%m-%dT%H:%M:%SZ")))
    except ValueError:
        return 0.0


def conf(key, default):
    """Environment, else ~/.cc/config, else the default — the shape every other knob on the box has."""
    val = os.environ.get(key, "")
    if not val:
        try:
            for ln in open(f"{HOME}/.cc/config"):
                if ln.strip().startswith(key + "="):
                    val = ln.split("=", 1)[1].strip().strip("\"'")
        except OSError:
            pass
    return val if val else default


def box_name():
    return conf("CC_BOX", socket.gethostname().split(".")[0])


def sh(*cmd, timeout=60, stdin=None):
    """Run something; None when it could not run. A timer job never dies of a command that hung."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=stdin)
    except Exception:
        return None


def out(*cmd, timeout=60):
    p = sh(*cmd, timeout=timeout)
    return p.stdout if p is not None and p.returncode == 0 else ""


DRY = False


def log(msg):
    os.makedirs(SEC, exist_ok=True)
    path = f"{SEC}/secretary.log"
    with open(path, "a") as f:
        f.write(f"{stamp()} {'dry ' if DRY else ''}{msg}\n")
    try:
        lines = open(path).read().splitlines()
        if len(lines) > LOG_MAX:
            atomic(path, "\n".join(lines[-LOG_MAX:]) + "\n")
    except OSError:
        pass


def atomic(path, text):
    """cc-reconcile's write shape: tmp + os.replace, so a reader never sees half a file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)


def load(path, default):
    try:
        return json.load(open(path))
    except Exception:
        return default


def read(path, default=""):
    try:
        return open(path, errors="replace").read()
    except OSError:
        return default


def tail_bytes(path, n):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - n))
            return f.read().decode(errors="replace")
    except OSError:
        return ""


def tail_lines(path, n):
    return "\n".join(read(path).splitlines()[-n:])


def fixture(name):
    """A selftest fixture is a name that STARTS with `_cctest`; a real track that merely CONTAINS `cctest` is not one.
    Nothing about a fixture is ever evidence — a selftest running beside a live tick must not be able to make a finding."""
    return bool(FIXTURE.search(str(name)))


def clean(s):
    """What the model may see: no escapes, no spinner glyphs, no secret, no fixture line, lines cut to LINE_MAX.
    The fixture filter sits HERE, in the one funnel every item's body goes through, so there is no collector left to
    forget it: a `_cctest` name cannot be quoted, so it cannot be a verbatim quote, so it cannot become a finding."""
    s = ANSI.sub("", s)
    s = SECRET.sub("[redacted]", s)
    s = SPIN.sub("", s)
    return "\n".join(ln.rstrip()[:LINE_MAX] for ln in s.splitlines() if not FIXTURE.search(ln)).strip("\n")


def h(head, body):
    """The header as given (the caller already digit-stripped its MOVING fields) + the body with counters and spacing stripped."""
    return hashlib.sha1((head + "\n" + NOISE.sub("", body)).encode()).hexdigest()[:12]


def dur(s):
    s = int(max(0, s))
    return f"{s // 86400}d{(s % 86400) // 3600}h" if s >= 86400 else f"{s // 3600}h{(s % 3600) // 60:02d}m" if s >= 3600 else f"{s // 60}m"


def quote(v):
    """A header value that may hold spaces, or nothing at all when there is none."""
    return f'"{v}"' if v else ""


def bucket(s):
    """0 under BUCKET, then 1, 2, 3… per doubling (30m, 1h, 2h, 4h…): waiting longer is news, not a metronome."""
    return int(math.log2(s / BUCKET)) + 1 if s >= BUCKET else 0


def repos():
    return sorted(os.path.basename(p)[:-5] for p in glob.glob(f"{BOARDS}/*.json") if not fixture(os.path.basename(p)))


def board(repo):
    d = load(f"{BOARDS}/{repo}.json", None)
    ts = (d.get("tracks") or []) if isinstance(d, dict) else []
    if isinstance(ts, dict):                       # an older board keeps its tracks keyed by name
        ts = [dict(v, name=k) for k, v in ts.items() if isinstance(v, dict)]
    return [t for t in ts if isinstance(t, dict)]


def item(id_, kind, text, cap=ITEM_MAX, **meta):
    """One evidence item. `hash` = the header fields VERBATIM (so idle_bucket / silent_bucket / exit moving is a change),
    only the MOVING ones digit-stripped, plus the body with counters and spacing stripped."""
    body = clean(text)
    if len(body.encode()) > cap:
        body = body.encode()[-cap:].decode(errors="replace")   # the END is where the news is
    meta = {k: v for k, v in meta.items() if v not in ("", None)}
    head = " ".join(f"{k}={v}" for k, v in meta.items())
    keyed = " ".join(f"{k}={NOISE.sub('', str(v)) if k in MOVING else v}" for k, v in meta.items())
    return {"id": id_, "kind": kind, "head": head, "text": body, "hash": h(keyed, body)}


def wrap(it):
    return f'<item id="{it["id"]}" kind="{it["kind"]}" {it["head"]}>\n{it["text"]}\n</item>'


# ── collectors ───────────────────────────────────────────────────────────────────────────────────────────
def windows():
    """[(id, name, pane_pid, activity_epoch)] in session main."""
    p = sh("tmux", "list-windows", "-t", "main", "-F", "#{window_id}\t#{window_name}\t#{pane_pid}\t#{window_activity}", timeout=20)
    outl = []
    if p is not None and p.returncode == 0:
        for ln in p.stdout.splitlines():
            f = ln.split("\t")
            if len(f) >= 4 and f[1]:
                try:
                    outl.append((f[0], f[1], f[2], float(f[3] or 0)))
                except ValueError:
                    pass
    return outl


def proc_tree():
    """pid -> (ppid, comm, argv-ish) from one ps. CC_FAKE_PS (tests) is that listing in a file."""
    fake = os.environ.get("CC_FAKE_PS")
    txt = read(fake) if fake else out("ps", "-eo", "pid=,ppid=,etimes=,args=", timeout=20)
    kids, info = {}, {}
    for ln in txt.splitlines():
        f = ln.split(None, 3)
        if len(f) >= 4:
            kids.setdefault(f[1], []).append(f[0])
            info[f[0]] = (f[1], int(f[2]) if f[2].isdigit() else 0, f[3])
    return kids, info


def claude_under(pane_pid, kids, info):
    """'session' for an interactive claude anywhere under the pane, 'worker' for a `claude -p`, '' for neither.
    cc-pulse's walk: an overlap successor's claude is a grandchild, so a direct-child test calls it dead."""
    seen, stack, found = set(), list(kids.get(str(pane_pid), [])), ""
    while stack:
        pid = stack.pop()
        if pid in seen:
            continue
        seen.add(pid)
        args = info.get(pid, ("", 0, ""))[2]
        base = args.split()[0].rsplit("/", 1)[-1] if args else ""
        if base == "claude":
            if " -p " in f" {args} " or " --print " in f" {args} ":
                found = found or "worker"
            else:
                return "session"
        stack.extend(kids.get(pid, []))
    return found


def role(name):
    """planning = a repo's planning window (`repo`); track = a track's window (`repo/track`, `~next` / `@2` included);
    session = any other interactive one (the box, a course/channel session — a board row of kind=session, #132)."""
    base = name.split("~")[0].split("@")[0]
    repo, _, track = base.partition("/")
    if not os.path.exists(f"{BOARDS}/{repo}.json"):
        return "session"
    if not track:
        return "planning"
    kind = next((t.get("kind") or "track" for t in board(repo) if t.get("name") == track), "track")
    return "track" if kind == "track" else "session"


def collect_sessions(gate):
    items, kids, info, t0 = [], *proc_tree(), now()
    wins = windows()
    if not wins:   # tmux did not answer: nothing can be called gone this tick
        items.append({"partial": True, "prefix": "sessions/"})
    for wid, name, pid, act in wins:
        if fixture(name) or claude_under(pid, kids, info) != "session":
            continue
        pane = clean(out("tmux", "capture-pane", "-p", "-t", wid, "-S", f"-{PANE_LINES}", timeout=20))
        idle = t0 - act if act else 0
        working, dialog = WORKING in pane, next((d for d in DIALOGS if d in pane), "")
        g = gate.get(f"sessions/{name}") or {}
        since = g.get("working_since") or t0 if working else 0
        rl = role(name)   # a planner's turn is an event loop: hours are by design, so its bar is PLANNER_TURN, not the knob
        long_turn = working and t0 - since >= (PLANNER_TURN if rl == "planning" else float(conf("CC_SECRETARY_LONG_TURN", 90))) * 60
        if working and not long_turn:
            items.append({"skip": True, "id": f"sessions/{name}", "working_since": since})   # mid-turn: Claude's, not ours
            continue
        state = "dialog" if dialog else "mid-turn" if long_turn else "idle"
        items.append(dict(item(f"sessions/{name}", "pane", pane, window=name, role=rl, state=state, turn=dur(t0 - since) if long_turn else "",
                               idle=dur(idle), idle_bucket=bucket(idle), dialog=f'"{dialog}"' if dialog else ""), working_since=since))
    return items


def loops(info):
    """(repo, track) -> age in seconds of its cc-loop process."""
    ages = {}
    for _, (_, age, args) in info.items():
        m = re.search(r"(?:^|/)cc-loop (\S+) (\S+)", args)
        if m and not args.startswith("bash -c"):
            ages[(m.group(1), m.group(2))] = max(age, ages.get((m.group(1), m.group(2)), 0))
    return ages


def loop_state(text, alive):
    """What the loop log says the loop is DOING, read backwards from its last line — the fact the model kept inventing.
    `parked` (sleeping out a usage limit) and `between iterations` (one ended, the next has not started yet) are a
    worker that is RUNNING; only a DONE / `exit N:` line is a loop that ended."""
    for ln in reversed([l for l in text.splitlines() if l.strip()]):
        if "usage limit — waiting until" in ln:
            state = "parked " + ln.split("usage limit — ", 1)[1].split(",")[0].strip(); break
        if re.search(r"\bDONE\b", ln) or re.match(r"^\S+ exit \d+:", ln):
            return "ended"      # no `, no process` on this one: a loop that ended has none by definition, and that is not news
        if re.match(r"^\S+ iter \d+ end\b", ln):
            state = "between iterations"; break
        if re.match(r"^\S+ iter \d+/\d+ start\b", ln):
            state = "in iteration"; break
    else:
        state = "no loop log"
    return state if alive else state + ", no process"


def hand_windows(kids, info):
    """{repo/track} for every track window a PERSON's own interactive claude is sitting in. A loop stopped by hand
    leaves exactly that: no cc-loop process, and a window somebody is now driving live. Read from the loop log alone
    it looks like a loop that ended without a terminal line, and it was reported as one on 17 ticks running
    (a member workspace's track, 2026-09-02). `repo/track~next` / `@2` is that track's window (133b)."""
    got = set()
    for _, name, pid, _ in windows():
        base = name.split("~")[0].split("@")[0]
        if "/" in base and claude_under(pid, kids, info) == "session":
            got.add(base)
    return got


def collect_workers(gate):
    items, (kids, info), t0 = [], proc_tree(), now()
    ages, rs = loops(info), repos()
    hands = hand_windows(kids, info)   # …so `no process` can be told apart from a loop somebody stopped to take over
    waits = (load(f"{STATE}/reconcile.json", {}).get("tracks") or {})
    if not rs:
        items.append({"partial": True, "prefix": "workers/"})
    for repo in rs:
        for t in board(repo):
            name, st = t.get("name") or "", t.get("status") or ""
            if fixture(name) or (st != "running" and (repo, name) not in ages):
                continue
            d = f"{STATE}/{repo}/{name}"
            ll, pm = tail_lines(f"{d}/loop.log", 15), tail_bytes(f"{d}/progress.md", 1500)
            runs = sorted(glob.glob(f"{d}/runs/*.json"))
            wrote = max([os.path.getmtime(p) for p in (f"{d}/progress.md", f"{d}/loop.log") if os.path.exists(p)] or [0])
            silence = t0 - wrote if wrote else 0
            # the LAST `iter N/M start (budget …)` line of the whole log, not the tail: the cadence the model must judge silence
            # against (a step is minutes, an iteration is bounded by budget/turns) — without it, it invented a "typical step"
            loglog = read(f"{d}/loop.log")
            m = next((m for m in (re.match(r"(\S+) iter (\d+/\d+) start(?: \((?:budget )?(.*)\))?", ln) for ln in reversed(loglog.splitlines())) if m), None)
            started = epoch(m.group(1)) if m else 0
            head = read(f"{d}/task.md")[:300].replace("\n", " ")
            text = (f"task: {head}\n--- loop.log (tail)\n{ll}\n--- progress.md (tail)\n{pm}")
            items.append(item(f"workers/{repo}/{name}", "track", text, board=st,
                              state=f'"{loop_state(loglog, (repo, name) in ages)}"',
                              process=dur(ages[(repo, name)]) if (repo, name) in ages else "NONE",
                              interactive="yes" if f"{repo}/{name}" in hands else "",
                              runs=len(runs), silent=dur(silence), silent_bucket=bucket(silence),
                              iter=m.group(2) if m else "", iter_age=dur(t0 - started) if started else "",
                              budget=(m.group(3) or "") if m else "",
                              waiting_on=quote((waits.get(f"{repo}/{name}") or {}).get("waiting_on"))))
    return items


def harness_notice(text):
    t = text.lstrip()
    return t.startswith(("<task-notification", "<cross-session-message", "pulse:", "<channel", "<system"))


def collect_asks(gate):
    items, t0, since = [], now(), now() - ASK_HOURS * 3600
    chans, dm = set(), False
    for repo in sorted(os.path.basename(p)[:-5] for p in glob.glob(f"{SCOPE}/*.json")):
        if fixture(repo):
            continue
        rows = load_rows(repo)
        if rows is None:
            items.append({"partial": True, "prefix": f"ask/{repo}/"}); continue
        for r in rows:
            if r.get("status") not in ("open", "delivered") or epoch(r.get("asked")) < since or harness_notice(r.get("text") or ""):
                continue
            src = str(r.get("src") or "")
            chans.update(re.findall(r"#[a-z0-9_-]+", src))
            dm = dm or bool(re.search(r"\bdm\b", src, re.I))
            text = (f"asked {r.get('asked')} via {src or 'terminal'} · status {r.get('status')} · track {r.get('track') or '-'}"
                    f" · repeats {r.get('repeats', 1)}\n{(r.get('text') or '')[:600]}\n"
                    + (f"evidence: {r.get('evidence')}" if r.get("evidence") else ""))
            items.append(item(f"ask/{repo}/{r.get('id')}", "ask", text, repo=repo))
    seen = [ln for ln in read(f"{SCOPE}/seen.log").splitlines() if epoch(ln.split("\t")[0]) >= since
            and not harness_notice("\t".join(ln.split("\t")[4:]))]
    if seen:
        items.append(item("seen/2h", "capture-log", "\n".join(ln[:LINE_MAX] for ln in seen[-40:])))
    if items:   # history only when there is an ask to check against: it is the one network read here
        for ch in sorted(chans):
            items.append(item(f"chan/{ch}", "history", out(f"{BIN}/cc-slack", "history", ch, "40", timeout=60)))
        if dm:
            ids = sorted({m for p in glob.glob(f"{HOME}/.cc/slack/*.json") + glob.glob(f"{HOME}/.cc/slack/*.log")
                          for m in re.findall(r"\bD0[A-Z0-9]{6,}", read(p))})
            if ids:
                items.append(item("chan/dm", "history", out(f"{BIN}/cc-slack", "history", ids[0], "40", timeout=60)))
    return items


def load_rows(repo):
    """The ledger's rows, or None when cc-scope could not answer (None ≠ no rows: nothing is gone on a failed read)."""
    p = sh(f"{BIN}/cc-scope", "list", repo, "--json", timeout=30)
    try:
        return json.loads(p.stdout) if p is not None and p.returncode == 0 else None
    except ValueError:
        return None


def collect_owner(gate):
    items, home, t0 = [], load(f"{STATE}/home.json", None), now()
    snap = load(f"{STATE}/reconcile.json", {})
    brd = {f"{r}/{t.get('name')}": t for r in repos() for t in board(r)}
    tag = lambda k: " kind=session" if (brd.get(k) or {}).get("kind") == "session" else ""   # a channel (#132): under SESSIONS is its place, not a mismatch
    # dispatch = the row's last loop start / board status change. A tab written BEFORE it is stale by timing;
    # a tab written after it and still disagreeing is the finding to keep.
    disp = lambda k: f" dispatch={dur(t0 - epoch((brd.get(k) or {}).get('updated')))}" if epoch((brd.get(k) or {}).get("updated")) else ""
    if isinstance(home, dict) and t0 - epoch(home.get("at")) < 1800 and isinstance(home.get("text"), dict):
        for band, text in home["text"].items():   # tab_age: the tab and the snapshot below are written at different moments —
            if text.strip():                      # a row that moved between them is timing, and the model can see which is older
                items.append(item(f"home/{band}", "home-tab", text, tab_age=dur(t0 - epoch(home.get("at")))))
    else:
        items.append({"partial": True, "prefix": "home/"})   # no daemon writing it: the tab's bands are unknown, not empty
    # The roster: EVERY repo's board in one list, always. RUNNING and SESSIONS print a track's bare name (a NEEDS YOU row
    # wears `[repo]` since #162), so a row judged against one board is the false "this row is not a real track" of
    # 2026-09-01 — there is only one roster here.
    rows = []
    for repo in repos():
        for t in board(repo):
            if t.get("status") in TERMINAL:
                continue
            k, v = f"{repo}/{t.get('name')}", (snap.get("tracks") or {}).get(f"{repo}/{t.get('name')}") or {}
            rows.append(f"{k} status={t.get('status', '?')}{tag(k)}"
                        + (f" waiting_on={v.get('waiting_on')}" if v.get("waiting_on") else "") + disp(k))
    if rows:
        roster = item("home/roster", "board", "\n".join(sorted(rows)), cap=ROSTER_MAX, repos=len(repos()), rows=len(rows))
        roster["context"] = True   # CONTEXT, not evidence: the rubric resolves every row it judges against this list, so
        items.append(roster)       # it rides with any owner call whether or not its own hash moved (review-174)
    live = [f"{k}: state={v.get('state')} board={v.get('board')} live={v.get('live')}{tag(k)}{disp(k)}"
            + (f" waiting_on={v.get('waiting_on')}" if v.get("waiting_on") else "") + (f" — {v.get('why')[:100]}" if v.get("why") else "")
            for k, v in sorted((snap.get("tracks") or {}).items()) if v.get("state") not in TERMINAL]
    if live:
        items.append(item("home/tracks", "reconcile", "\n".join(live), snap_age=dur(t0 - epoch(snap.get("at"))) if snap.get("at") else ""))
    return items


def collect_box(gate):
    items, rs = [], repos()
    if rs:   # --no-net: GitHub is never asked on a 30-min tick, so the branch rule cannot judge and its "could not be
        jan = "\n".join(ln for ln in out(f"{BIN}/cc-janitor", *rs, "--dry", "--no-net", timeout=120).splitlines()
                        if "PR state could not be read" not in ln)                     # read" lines are not evidence
        items.append(item("box/janitor", "janitor-dry", jan, net="off"))
    p = sh(f"{BIN}/cc-units", "check", timeout=60)
    if p is not None:
        items.append(item("box/units", "units", (p.stdout + p.stderr).strip(), exit=p.returncode))
    timers = [ln for ln in out("systemctl", "--user", "list-timers", "--all", timeout=20).splitlines() if "n/a" in ln]
    if timers:
        items.append(item("box/timers", "timers-unarmed", "\n".join(timers)))
    names = {w[1] for w in windows()}
    bases = {n.split("~")[0].split("@")[0] for n in names}   # `repo/track~next` / `repo/track@2` is that track's window
    rows = {f"{r}/{t.get('name')}": t.get("status") for r in rs for t in board(r)}
    wts = {f"{os.path.basename(os.path.dirname(p))}/{os.path.basename(p)}" for r in rs for p in glob.glob(f"{WTS}/{r}/*")}
    drift = ([f"window {w} — no board row" for w in sorted(names) if "/" in w and w.split("~")[0].split("@")[0] not in rows
              and w.split("/")[0] in rs and not w.startswith("lesson/")]
             + [f"board {k} is {v} — no tmux window" for k, v in sorted(rows.items()) if v == "running" and k not in bases]
             + [f"worktree {w} — no board row" for w in sorted(wts) if w not in rows]
             + [f"board {k} is {v} — no worktree" for k, v in sorted(rows.items()) if v not in TERMINAL and v != "queued" and k not in wts])
    if drift:
        items.append(item("box/drift", "panes-vs-board", "\n".join(drift)))
    temps = [int(read(p, "0").strip() or 0) // 1000 for p in glob.glob("/sys/class/thermal/thermal_zone*/temp")]
    disk = out("df", "-h", "/").splitlines()[-1:]
    items.append(item("box/host", "df-thermal", "\n".join(disk) + (f"\nhottest zone {max(temps)}°C" if temps else ""),
                      load=read("/proc/loadavg")[:14].strip()))
    return items


COLLECT = {"sessions": collect_sessions, "workers": collect_workers, "asks": collect_asks, "owner": collect_owner, "box": collect_box}


# ── the model ────────────────────────────────────────────────────────────────────────────────────────────
def bundle(items):
    """Cap the bundle: newest-first is meaningless here, so it is simply the first items that fit."""
    kept, size = [], 0
    for it in items:
        s = len(wrap(it).encode())
        if size + s > BUNDLE_MAX:
            break
        kept.append(it); size += s
    return kept, size


def judge(concern, items):
    """One call. Returns (verdict dict or None, usage dict)."""
    prompt = FRAME + "\n\nCONCERN: " + RUBRIC[concern] + "\n\nITEMS:\n" + "\n".join(wrap(it) for it in items)
    fake = os.environ.get("CC_SECRETARY_FAKE")
    if fake:
        try:
            return json.loads(fake), {"model": "fake", "in": 0, "out": 0, "cost": 0.0}
        except ValueError:
            return None, {"model": "fake", "in": 0, "out": 0, "cost": 0.0}
    model = conf("CC_SECRETARY_HAIKU", "haiku") if MODEL[concern] == "haiku" else conf("CC_SECRETARY_SONNET", "sonnet")
    # The floor per call is the OUTPUT: with thinking on (the CLI's default) a verdict ran 5–11k output tokens, without it
    # 200–700 (measured 2026-09-01). MAX_THINKING_TOKENS is the CLI's own knob; one turn is enough — the structured-output
    # round trip still completes under --max-turns 1 (num_turns reads 2 either way).
    env = dict(os.environ, CC_ROLE="worker", MAX_THINKING_TOKENS=str(int(conf("CC_SECRETARY_THINK", 0))))
    try:
        p = subprocess.run([CLAUDE, "-p", "--model", model, "--tools", "", "--disallowedTools", DENY, "--strict-mcp-config",
                            "--setting-sources", "", "--disable-slash-commands", "--max-turns", "1", "--no-session-persistence",
                            "--output-format", "json", "--json-schema", SCHEMA, "--max-budget-usd", "0.15"],
                           input=prompt, capture_output=True, text=True, timeout=300, env=env, cwd=SEC if os.path.isdir(SEC) else HOME)
    except Exception as e:
        log(f"{concern}: model call failed ({e.__class__.__name__})"); return None, {}
    try:
        d = json.loads(p.stdout)
    except ValueError:
        log(f"{concern}: no JSON from the model (rc={p.returncode}): {(p.stderr or p.stdout).strip()[-200:]}"); return None, {}
    u = d.get("usage") or {}
    usage = {"model": ",".join((d.get("modelUsage") or {}).keys()) or model, "in": u.get("input_tokens", 0),
             "cache_w": u.get("cache_creation_input_tokens", 0), "cache_r": u.get("cache_read_input_tokens", 0),
             "out": u.get("output_tokens", 0), "turns": d.get("num_turns", 0), "cost": d.get("total_cost_usd", 0)}
    v = d.get("structured_output")
    if not isinstance(v, dict):   # a limit, a refusal, or prose: cc-limit reads the same JSON the loops hand it
        log(f"{concern}: no verdict ({d.get('subtype')}): {str(d.get('result'))[:160]}")
        j = f"{SEC}/last.json"
        atomic(j, p.stdout)
        sh(f"{BIN}/cc-limit", "check", j, timeout=10)
        return None, usage
    return v, usage


def parse(concern, verdict, items):
    """WHITELIST: target must be an item id in this bundle, evidence a verbatim quote of that item."""
    by = {it["id"]: it for it in items}
    found = []
    for f in verdict.get("findings") or [] if isinstance(verdict, dict) else []:
        if not isinstance(f, dict):
            continue
        t, ev = str(f.get("target") or "").strip(), str(f.get("evidence") or "").strip()
        it = by.get(t)
        if not it or not ev or fixture(t):
            continue
        flat = " ".join(it["text"].split())
        if " ".join(ev.split()) not in flat and ev not in it["head"]:
            continue
        found.append({"concern": concern, "target": t, "what": str(f.get("what") or "")[:160].replace("\n", " "),
                      "why": str(f.get("why") or "")[:200].replace("\n", " "), "evidence": ev[:200], "hash": it["hash"],
                      "class": klass(t, it["head"])})
    return found


DECIDING = ("ask/", "chan/", "seen/", "home/needs")


def key(f):
    """The fingerprint: the concern and the item it is about — NOT the model's words. The same problem worded two ways
    on two ticks is ONE finding, recorded once. A SECOND problem with the same item in one tick is not a second
    sighting of the first and does not overwrite it: it joins the record as one of `more` (≤MORE_MAX), and line()
    carries them all, so both reach the session on the tick that found them (the record is the unit of delivery)."""
    return hashlib.sha1(f"{f['concern']}|{f['target']}".encode()).hexdigest()[:12]


MORE_MAX = 3   # extras kept on one record: what a session is asked to read about one item in one line has a bound


def klass(target, head):
    """`decision` — a person, an approval, or a choice the files cannot settle. It is the only class a session ever
    hears: an owner's own message (ask / channel / capture log), the NEEDS YOU band that is his question by definition,
    and a modal, whose key is his to press. Everything else is `file`: a line in findings.json and nothing more,
    because a script already owns it and the full-context turn spent re-reading it is what the 2026-09-01 efficiency
    audit measured (one tick, up to ten turns, most of them rubric misses)."""
    return "decision" if target.startswith(DECIDING) or "dialog=" in head else "file"


# ── delivery ─────────────────────────────────────────────────────────────────────────────────────────────
def route(f):
    """Which session hears it: the window's repo for a pane, the track's repo for a worker, else the control repo."""
    t = f["target"]
    if t == "sessions/box":
        return "box"
    if t.startswith(("sessions/", "workers/", "ask/")):
        repo = t.split("/", 2)[1].split("@")[0].split("~")[0]
        if os.path.exists(f"{BOARDS}/{repo}.json"):
            return repo
    return box_name()


def line(f):
    """What the session reads. target/evidence are bound by parse(); what/why are the model's own words, length-capped
    to one line — and the whole line loses its angle brackets, so nothing quoted off a pane can pose as a tag. Every
    further problem the same tick found with the same item rides the same line (`also:`), which is how one record
    delivers all of them; the stripping runs after they are joined, so an extra is walled like the first."""
    s = f'secretary/{f["concern"]}: {f["target"]} — {f["what"]} ({f["why"]}) · evidence: "{f["evidence"]}"'
    for m in f.get("more") or []:
        s += f' · also: {m["what"]} ({m["why"]}) · evidence: "{m["evidence"]}"'
    s = re.sub(r"[<>]", "", s)
    return s + (f" · janitor would: {f['janitor']} — run `cc-janitor <repo>` live or wait for its Sunday pass" if f.get("janitor") else "")


def offer(target, text):
    inj = os.environ.get("CC_SECRETARY_INJECT") or f"{BIN}/cc-slack"
    p = sh(inj, "inject", "--no-start", target, text, timeout=30)
    return p is not None and p.returncode == 0 and p.stdout.strip() in ("delivered", "typed")   # "queued" is NOT taken;
    # "typed" is cc-msg's word for the same thing on a session without the channel (the finding is on its prompt now);
    # "spooled" is behind a dialog or a turn — the drain delivers it, but nobody has heard it YET, so it is not taken


def blocked(target, wins):
    """Why that session would not read an inject, '' when it would. A modal is the half `delivered` cannot see: the
    keys land, the pane is waiting for a key of its own, and nobody ever reads them (2026-09-01 — a finding about an
    idle session was routed to that session, which sat behind a permission dialog, and it died there)."""
    if not wins:
        return ""                                          # tmux did not answer: nothing can be called absent this tick
    # `repo`, and the same session mid-handoff or a second one of it: `repo~next`, `repo@2` — the suffixes route() strips
    wid = wins.get(target) or next((w for n, w in wins.items() if n.split("~")[0].split("@")[0] == target), None)
    if wid is None:
        return "no session window"
    dialog = next((d for d in DIALOGS if d in clean(out("tmux", "capture-pane", "-p", "-t", wid,
                                                        "-S", f"-{PANE_LINES}", timeout=20))), "")
    return f'a dialog waits for a key: "{dialog}"' if dialog else ""


def deliver(f, wins, extra=""):
    """(taken, the line that says who did not hear it — '' when the routed session did). The finding goes to its own
    repo's session; when that one is absent, sitting on a modal or does not take the inject, it goes to the box's own
    planning session instead, the original target named on it — a finding nobody can hear is why this layer exists."""
    target, fallback = route(f), box_name()
    why = blocked(target, wins)
    if not why:
        if offer(target, line(f) + extra):
            return True, ""
        why = "the inject was not taken"
    note = f"{target} did not hear it ({why})"
    return bool(fallback != target and offer(fallback, f"{note} — {line(f)}{extra}")), note


def page(text):
    nt = os.environ.get("CC_SECRETARY_NOTIFY") or f"{BIN}/cc-notify"
    p = sh(nt, "-t", f"{box_name()} secretary", "-p", "high", text, timeout=60)
    return p is not None and p.returncode == 0


def janitor_line(f, items):
    """A box finding that a janitor rule already covers carries that rule's line."""
    jan = next((it for it in items if it["id"] == "box/janitor"), None)
    if not jan or not f["target"].startswith("box/"):
        return ""
    names = set(re.findall(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.~-]+", f["evidence"] + " " + f["what"]))
    for ln in jan["text"].splitlines():
        if ln.strip().startswith("would ") and (ln.strip() in f["evidence"] or any(n in ln for n in names)):
            return ln.strip()
    return ""


# ── the tick ─────────────────────────────────────────────────────────────────────────────────────────────
def calls_recent(t0):
    """(real calls today, real calls in the last hour) — a dry run writes no row."""
    day, today, hour = stamp(t0)[:10], 0, 0
    for ln in read(f"{SEC}/calls.jsonl").splitlines():
        if '"dry": false' in ln:
            today += ln.startswith('{"at": "' + day); hour += t0 - epoch(ln[8:28]) < 3600
    return today, hour


def ledger():
    """The finding ledger, {fingerprint: record}. One file, one record per finding, open ones and the ones that cleared
    in the last day — so a finding that comes back re-opens its own record instead of becoming a second one, and a
    renderer (the Home tab, later) has both halves of today in one read."""
    d = load(f"{SEC}/findings.json", {})
    recs = (d.get("findings") if isinstance(d, dict) and "findings" in d else d) or {}
    # Records written before this file kept a status (flat findings.json: numbers as strings, `offered`/`offered_at`/
    # `paged_at`) would otherwise be skipped by standing() and escalate() and dropped by the write filter on the first
    # tick — silently, and never re-derived while gate.json still holds the item hash (review-174b). Migrate them once.
    def num(v):
        try:
            return float(v)
        except (TypeError, ValueError):
            return 0.0
    n = 0
    for k, f in recs.items():
        if not isinstance(f, dict) or "status" in f:
            continue
        n += 1
        first, last, off, pg = (num(f.get(x)) for x in ("first", "last", "offered_at", "paged_at"))
        # A legacy record has no head to read a modal off, so read the record: a dialog quoted in its own evidence or
        # `what` IS the modal, and a modal is decision class ("a key nobody but the owner may press"). Classing it
        # `file` would strand it — escalate() drops file class, and a pane sitting on a dialog never changes, so it is
        # never re-judged and the class is never corrected: nobody would be told again (review-174).
        head = "dialog=yes" if any(d in f"{f.get('evidence', '')} {f.get('what', '')}" for d in DIALOGS) else ""
        f.update(fp=k, repo=route(f), **{"class": klass(f.get("target", ""), head)}, more=[], status="open", cleared="",
                 first=stamp(first) if first else stamp(), last=stamp(last) if last else stamp(),
                 ticks=int(num(f.get("ticks")) or 1), stood=int(num(f.get("stood")) or 1),
                 heard=str(f.get("offered")) == "True", sent=stamp(off) if off else "",
                 sent_hash=f.get("hash", "") if off else "", paged=stamp(pg) if pg else "")
    if n:
        log(f"ledger: migrated {n} record(s) written before this file kept a status — nothing dropped")
    return recs


def standing(findings):
    return {k: f for k, f in findings.items() if f.get("status") == "open"}


def record(f, t0, cls=None):
    """A new ledger record. Times are ISO strings: this file is read by a renderer, not only by this script."""
    return {"fp": key(f), "concern": f["concern"], "target": f["target"], "repo": route(f), "class": cls or f["class"],
            "what": f["what"], "why": f["why"], "evidence": f["evidence"], "janitor": f.get("janitor") or "", "more": [],
            "status": "open", "first": stamp(t0), "last": stamp(t0), "cleared": "",
            "ticks": 1, "stood": 1, "hash": f["hash"], "heard": False, "sent": "", "sent_hash": "", "paged": ""}


def clear(findings, k, t0, why):
    """Cleared is a state, not a deletion: the record stays a day so the same finding returning is the same record."""
    log(f"{why} {k}: {findings[k]['target']} — {findings[k]['what'][:80]}")
    findings[k].update(status="cleared", cleared=stamp(t0), last=stamp(t0), why_cleared=why)


def pages_recent(t0):
    """Pages sent in the last 12 h, from pages.jsonl — a finding that cleared after paging still spent one."""
    return sum(1 for ln in read(f"{SEC}/pages.jsonl").splitlines() if t0 - epoch(ln[8:28]) < 12 * 3600)


def escalate(findings, t0, dry):
    """ONLY a decision-class finding leaves this file. A file-class one is written to the ledger and that is the whole
    of it — no inject, no page: the planning session is not a queue for what reconcile, the janitor and cc-land already
    own, and a tick that used to cost it ten full-context turns now costs it none.

    For the ones that do leave: tick 1 → a session that can hear it: its own repo's, else — absent, on a modal, or the
    inject not taken — the box's planning session, which counts as the delivery. Only when nobody at all took it is the
    offer recorded as made, not retried forever: the finding nobody heard is exactly the one that must climb. `stood`
    ≥2 (the item unchanged since the previous tick, whether judged again or standing by construction) → the owner,
    inside the audit budget; a re-confirmation on changed evidence restarts that streak, never the finding. A dialog is
    the one thing no session can clear — it wants a key, and pressing it is the owner's — so a delivery a modal blocked
    rings him the same tick, once per blocked session, and in shadow mode (PAGES=0) the planning session is where it stops."""
    pages_max, window = int(conf("CC_SECRETARY_PAGES", 0)), float(conf("CC_SECRETARY_WINDOW", 4)) * 3600
    paged_12h = pages_recent(t0)   # the log, not the standing findings: a paged finding that cleared still spent a page
    live = {k: f for k, f in findings.items() if f.get("status") == "open" and f.get("class") == "decision"}
    wins = {} if dry or not live else {name: wid for wid, name, _, _ in windows()}
    rung = set()
    for k, f in live.items():
        note = ""
        if dry:
            continue
        if not f.get("sent") or f.get("sent_hash") != f["hash"]:   # never sent, or sent for OTHER evidence: a new
            f["heard"], note = deliver(f, wins); f["sent"], f["sent_hash"] = stamp(t0), f["hash"]   # problem on the same item (review-174b)
            log(f"{k} → session {box_name() if note else route(f)}: {'delivered' if f['heard'] else 'not taken'}"
                + (f" · {note}" if note else ""))
            if not ("a dialog waits" in note and route(f) not in rung):
                continue
            rung.add(route(f))   # his to answer, so it does not wait for tick 2 — but one modal is one page, not one per finding
        elif f.get("stood", 1) < 2:
            continue
        if t0 - epoch(f.get("paged")) < window:
            continue
        if pages_max and paged_12h < pages_max:
            if page(f"{note} — {line(f)}" if note else line(f)):
                f["paged"] = stamp(t0); paged_12h += 1
                with open(f"{SEC}/pages.jsonl", "a") as pf:
                    pf.write(json.dumps({"at": stamp(t0), "key": k}) + "\n")
                log(f"{k} → owner ({note or 'stood ' + str(f['ticks']) + ' ticks'}"
                    + ("" if f.get("heard") else ", nobody took it") + ")")
        elif t0 - epoch(f.get("sent")) >= window:
            f["heard"], _ = deliver(f, wins, f" · standing {f['ticks']} ticks, not paged (budget)"); f["sent"], f["sent_hash"] = stamp(t0), f["hash"]
            log(f"{k} → session again ({'delivered' if f['heard'] else 'not taken'}; owner rung {'off' if not pages_max else 'spent'})")


def tick(dry=False):
    global DRY
    DRY = dry
    os.makedirs(SEC, exist_ok=True)
    lock = open(f"{SEC}/.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("cc-secretary: another tick is running"); return 0
    t0 = now()
    p = sh(f"{BIN}/cc-limit", "status", timeout=10)
    if p is not None and p.returncode == 0:
        log(f"skip: {p.stdout.strip()}"); print(f"skipped: {p.stdout.strip()}"); return 0
    gate, findings, cap = load(f"{SEC}/gate.json", {}), ledger(), int(conf("CC_SECRETARY_CAP", 120))
    (calls, hour), verdicts, pace = calls_recent(t0), {}, max(len(ORDER), cap // 24)   # never below one full tick
    for concern in ORDER:
        items = COLLECT[concern](gate)
        skipped = {i["id"] for i in items if i.get("skip")}                  # exist, not judged this tick (mid-turn)
        partial = tuple(i["prefix"] for i in items if i.get("partial"))      # ids the collector could not list this tick
        for it in [i for i in items if "working_since" in i]:                # session panes: since when mid-turn, 0 once idle again —
            gate[it["id"]] = dict(gate.get(it["id"]) or {}, working_since=it["working_since"])   # a finished turn resets the clock
        items = [i for i in items if not (i.get("skip") or i.get("partial"))]
        changed = [i for i in items if (gate.get(i["id"]) or {}).get("hash") != i["hash"]]
        if any(not i.get("context") for i in changed):   # "resolve every row you judge against `home/roster`" — so when
            ctx = [i for i in items if i.get("context")]  # anything else is judged the roster goes too, gated or not, and
            ids = {i["id"] for i in ctx}                  # FIRST, because bundle() keeps what fits and a cut here is the
            changed = ctx + [i for i in changed if i["id"] not in ids]   # bare-name false positive DONE-3 removes. It
        present, judged = {i["id"]: i for i in items}, set()   # never calls on its own: alone, it is a change like any other
        if not changed:
            log(f"{concern}: unchanged ({len(items)} items)")
        elif calls >= cap:
            log(f"{concern}: cap — {calls} calls today, {len(changed)} items wait")
        elif hour >= pace:
            log(f"{concern}: pace — {hour} calls this hour (≤{pace}), {len(changed)} items wait for the next")
        else:
            sent, size = bundle(changed)
            v, usage = judge(concern, sent)
            calls += 1; hour += 1
            row = dict(at=stamp(t0), concern=concern, items=len(sent), bytes=size, dry=dry, **usage,
                       findings=len(parse(concern, v, sent)) if v else -1)
            if not dry:
                with open(f"{SEC}/calls.jsonl", "a") as f:
                    f.write(json.dumps(row) + "\n")
            log(f"{concern}: {len(sent)} items, {size} B → {row['model'] if 'model' in row else '?'} "
                f"{row.get('in', 0)}+{row.get('cache_w', 0)}+{row.get('cache_r', 0)} in / {row.get('out', 0)} out ${row.get('cost', 0):.4f}: "
                + ("no verdict" if v is None else f"{row['findings']} finding(s)"))
            if v is not None:
                found = parse(concern, v, sent)
                for f in found:
                    f["janitor"] = janitor_line(f, items)
                verdicts[concern] = {"items": [i["id"] for i in sent], "findings": found, "raw": v}
                for it in sent:
                    gate[it["id"]] = dict(gate.get(it["id"]) or {}, hash=it["hash"], last=t0)
                for f in found:
                    k = key(f)
                    g = findings.get(k)
                    if k in judged:   # a SECOND problem with the same item, this same tick: not a second sighting of the
                        m = g.setdefault("more", [])   # first and never an overwrite of it — it joins that record, and
                        if len(m) < MORE_MAX:          # line() carries it, so the session hears both (ticks stay at one)
                            m.append({"what": f["what"], "why": f["why"], "evidence": f["evidence"]})
                            log(f"also {k} [{f['class']}]: {f['what'][:160]}")
                        continue
                    judged.add(k)
                    if g and g.get("status") == "open":   # re-confirmed: the unchanged streak goes on, or restarts on new evidence
                        g.update(f, ticks=g["ticks"] + 1, last=stamp(t0), more=[],   # `more` holds THIS tick's extras only
                                 stood=g.get("stood", 1) + 1 if g["hash"] == f["hash"] else 1)
                    elif g:   # it cleared and came back: the SAME record re-opens — a repeat is never a new finding
                        g.update(record(f, t0), first=g["first"], ticks=g["ticks"] + 1, sent="", paged="", why_cleared="")
                        log(f"back {k} [{f['class']}]: {line(f)[:300]}")
                    else:
                        findings[k] = record(f, t0)
                        log(f"new {k} [{f['class']}]: {line(f)[:300]}")
                for k in [k for k, f in standing(findings).items() if f["concern"] == concern and k not in judged
                          and f["target"] in {i["id"] for i in sent}]:
                    clear(findings, k, t0, "cleared")
        for k, f in list(standing(findings).items()):
            if f["concern"] != concern:
                continue
            it = present.get(f["target"])
            if it is not None and k not in judged and it["hash"] == f["hash"]:   # unchanged since it was judged: the quote is still
                f.update(ticks=f["ticks"] + 1, stood=f.get("stood", 1) + 1, last=stamp(t0))   # there, so it stands another tick, no call
            elif it is None and f["target"] not in skipped:
                if f["target"].startswith(partial) and t0 - epoch(f["last"]) < 86400:
                    continue   # not listed ≠ gone: kept as is, neither cleared nor climbing, until seen again or a day old
                clear(findings, k, t0, "gone")   # positive absence: the window / track / row went away
    escalate(findings, t0, dry)
    if not dry:
        findings = {k: f for k, f in findings.items() if f.get("status") == "open" or t0 - epoch(f.get("cleared")) < 86400}
        atomic(f"{SEC}/gate.json", json.dumps(gate, indent=0))
        atomic(f"{SEC}/findings.json", json.dumps({"at": stamp(t0), "box": box_name(), "findings": findings}, indent=1))
    for concern, v in verdicts.items():
        print(f"{concern}: {len(v['items'])} item(s) judged → " + ("nothing to report" if not v["findings"] else ""))
        for f in v["findings"]:
            print(f"  [{f['class']}] " + line(f))
    if not verdicts:
        print("nothing changed — no call made" if calls < cap else f"cap: {calls} calls today")
    if dry:
        print("(dry run: nothing sent, nothing written)")
    return 0


def status():
    day, rows = stamp()[:10], []
    for ln in read(f"{SEC}/calls.jsonl").splitlines():
        try:
            r = json.loads(ln)
        except ValueError:
            continue
        if r.get("at", "").startswith(day) and not r.get("dry"):
            rows.append(r)
    cost = sum(float(r.get("cost") or 0) for r in rows)
    tok = sum(int(r.get("in") or 0) + int(r.get("cache_w") or 0) + int(r.get("cache_r") or 0) for r in rows)
    pm = int(conf("CC_SECRETARY_PAGES", 0))
    print(f"{day}: {len(rows)} calls · {tok} input tokens · ${cost:.3f} · cap {conf('CC_SECRETARY_CAP', 120)} · "
          f"owner rung {'OFF (shadow)' if not pm else f'{pages_recent(now())}/{pm} pages in 12 h'}")
    fs = ledger()
    for k, f in sorted(fs.items(), key=lambda kv: kv[1].get("first", "")):
        if f.get("status") != "open":
            continue
        where = "paged" if f.get("paged") else "sent" if f.get("sent") else "file only" if f.get("class") == "file" else "pending"
        print(f"  {k} [{f.get('class')}] ×{f.get('ticks')} (unchanged ×{f.get('stood', 1)}) since {f.get('first')} {where}: {line(f)[:200]}")
    shut = [f for f in fs.values() if f.get("status") == "cleared"]
    if not standing(fs):
        print("  no finding standing")
    if shut:
        print(f"  {len(shut)} cleared in the last day (kept in the ledger, so a repeat is not a new finding)")
    ln = read(f"{SEC}/secretary.log").splitlines()
    if ln:
        print(f"  last: {ln[-1]}")
    return 0


# ── selfcheck ────────────────────────────────────────────────────────────────────────────────────────────
def selfcheck():
    import shutil
    import tempfile
    global HOME, BIN, BOARDS, STATE, WTS, SEC, SCOPE, CLAUDE
    p = f = 0

    def ok(name, cond):
        nonlocal p, f
        if cond:
            p += 1
        else:
            f += 1
            print(f"  FAIL {name}")

    with tempfile.TemporaryDirectory() as th:
        HOME, BIN = th, f"{th}/bin"
        BOARDS, STATE, WTS, SCOPE = f"{th}/.cc/boards", f"{th}/.cc/state", f"{th}/.cc/worktrees", f"{th}/.cc/scope"
        SEC, CLAUDE = f"{STATE}/secretary", f"{th}/bin/claude"
        calls, verdict, panes, tmuxf, psf = f"{th}/calls.txt", f"{th}/verdict.json", f"{th}/panes", f"{th}/tmux.txt", f"{th}/ps.txt"
        for d in (BIN, BOARDS, f"{STATE}/alpha/t1/runs", f"{WTS}/alpha/t1", f"{WTS}/alpha/ghost", f"{WTS}/alpha/ece1",
                  f"{WTS}/alpha/cctest-leak", f"{STATE}/_cctest9", SCOPE, panes, f"{th}/.cc/slack"):
            os.makedirs(d, exist_ok=True)
        for name, body in FAKES.items():
            open(f"{BIN}/{name}", "w").write(body); os.chmod(f"{BIN}/{name}", 0o755)
        os.environ.update(PATH=BIN + os.pathsep + os.environ.get("PATH", ""), CC_FAKE_CALLS=calls, CC_FAKE_VERDICT=verdict,
                          CC_FAKE_PANES=panes, CC_FAKE_TMUX=tmuxf, CC_FAKE_PS=psf, CC_FAKE_SCOPE=SCOPE, CC_SECRETARY_PAGES="2",
                          CC_SECRETARY_WINDOW="4", CC_SECRETARY_CAP="10000", CC_SECRETARY_LONG_TURN="90", CC_BOX="abox",
                          CC_LIMIT_STAMP=f"{th}/limit")
        os.environ.pop("CC_FAKE_QUEUE", None)
        os.environ.pop("CC_SECRETARY_FAKE", None); os.environ.pop("CC_SECRETARY_INJECT", None); os.environ.pop("CC_SECRETARY_NOTIFY", None)
        # the box: a planning window `alpha` with an interactive claude, a worker window with a claude -p, a bare shell
        open(tmuxf, "w").write("@1\talpha\t100\t0\n@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        open(psf, "w").write("101 100 900 /home/x/.local/bin/claude --append-system-prompt planning\n"
                             "201 200 3000 bash /home/x/bin/cc-loop alpha t1 --max-iter 1\n"
                             "202 201 2900 /home/x/.local/bin/claude -p # TASK\n"
                             "401 400 5 /home/x/.local/bin/claude\n")
        open(f"{panes}/@1", "w").write("some earlier output\n> \n")
        open(f"{panes}/@4", "w").write("Use this MCP server?\n 1. Yes\n 2. Yes, and all future servers\nEnter to confirm · Esc to cancel\n")
        # the live shapes of 2026-09-01: a course session (kind=session, #132) and a real track whose name contains `cctest`
        json.dump({"repo": "alpha", "tracks": [{"name": "t1", "status": "running", "title": "thing"},
                                               {"name": "old", "status": "merged", "title": "gone"},
                                               {"name": "ece1", "status": "open", "kind": "session", "title": "course ece1"},
                                               {"name": "cctest-leak", "status": "open", "title": "fixture rows leak onto the Home tab"}]},
                  open(f"{BOARDS}/alpha.json", "w"))
        snap = {"alpha/t1": {"state": "running", "board": "running", "live": True, "waiting_on": "", "why": ""},
                "alpha/ece1": {"state": "open", "board": "open", "live": True, "waiting_on": "", "why": ""}}
        json.dump({"at": stamp(now() - 120), "tracks": snap}, open(f"{STATE}/reconcile.json", "w"))
        open(f"{STATE}/alpha/t1/loop.log", "w").write(f"{stamp(now() - 300)} iter 1/1 start (budget $8, turns 80)\n")
        open(f"{STATE}/alpha/t1/progress.md", "w").write("- did a step\n")
        open(f"{STATE}/alpha/t1/task.md", "w").write("GOAL: the thing\n")
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2", "needs": "❓ 3h · do these need me?", "sessions": "SESSIONS · 1\n*alpha*\n  ↳ 🟢 ece1"}},
                  open(f"{STATE}/home.json", "w"))
        json.dump([{"id": "a1", "status": "open", "asked": stamp(now() - 600), "src": "slack #alpha 1.2", "text": "why is x?", "repeats": 1}],
                  open(f"{SCOPE}/alpha.json", "w"))
        open(f"{SCOPE}/seen.log", "w").write(f"{stamp(now() - 500)}\talpha\tkept:a1\tslack\twhy is x?\n")

        def run(*argv):
            open(calls, "w").close()
            import io, contextlib
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf):
                rc = main(list(argv))
            return rc, buf.getvalue(), read(calls)

        def n(rec, word):
            return sum(1 for ln in rec.splitlines() if ln.startswith(word))

        def led(shut=False):
            """The ledger's OPEN findings (shut=True: the whole file, the records that cleared included)."""
            return ledger() if shut else standing(ledger())

        # (a) a first-run dialog pane yields a sessions finding quoting the line; a healthy pane none
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [
            {"target": "sessions/box", "what": "stuck on the MCP trust dialog", "why": "the session never loads its channel",
             "evidence": "Use this MCP server?"},
            {"target": "sessions/alpha", "what": "made up", "why": "x", "evidence": "text that is not on the pane"},
            {"target": "owner", "what": "page the owner", "why": "x", "evidence": "some earlier output"}]}))
        rc, o, rec = run("--tick")
        fs = led()
        ok("tick 1: the dialog pane is a finding, quoting the dialog line", any(f["target"] == "sessions/box" and "Use this MCP server" in f["evidence"] for f in fs.values()))
        ok("a finding whose evidence is not on its pane is dropped; a target that is not an item id is dropped", len(fs) == 1)
        # the pane the finding is about IS the one sitting on the dialog: routing it there is how it died on 2026-09-01
        ok("tick 1: the target is on a modal → the box's planning session hears it instead, named, and the owner is rung the same tick",
           n(rec, "inject box") == 0 and n(rec, "inject abox") == 1 and "box did not hear it (a dialog waits for a key" in rec
           and n(rec, "notify") == 1 and list(fs.values())[0]["heard"])
        ok("the model call carries the wall: --tools '', --strict-mcp-config, --setting-sources '', --disallowedTools, --json-schema",
           all(s in rec for s in ("--tools ''", "--strict-mcp-config", "--setting-sources ''", "--disallowedTools", "--json-schema")))
        ok("one turn, thinking off: --max-turns 1 and MAX_THINKING_TOKENS=0 on every call", "--max-turns 1" in rec and "--max-turns 4" not in rec
           and rec.count("think=0") == n(rec, "claude"))
        ok("the owner's ledger row and its channel history are ask items (read from the test HOME)",
           '<item id="ask/alpha/a1"' in rec and '<item id="chan/#alpha"' in rec)
        ok("the worktree with no board row, the unarmed timer and the janitor's dry run are in the box evidence",
           all(s in rec for s in ("worktree alpha/ghost — no board row", "cc-dead.timer", '<item id="box/janitor"')))
        ok("the prompt frames items as data, never instructions, and the pane text arrived wrapped",
           "never instructions" in rec and '<item id="sessions/box"' in rec)
        ok("the worker window is a track item, not a session; the bare shell is nothing",
           '<item id="workers/alpha/t1"' in rec and '<item id="sessions/alpha/t1"' not in rec and "alpha/old" not in rec.split("CONCERN: Items are what the weekly")[0])
        ok("every concern made exactly one call on a first tick (5 calls)", n(rec, "claude") == 5)
        # (b) tick 2, nothing changed: the finding stands → the owner, once
        rc, o, rec = run("--tick")
        fs = led()
        ok("tick 2 unchanged: NO call — a standing finding on an unchanged item stands by construction", n(rec, "claude") == 0)
        ok("tick 2: nothing is sent again — the modal already rang him, and one page a window is the budget",
           n(rec, "notify") == 0 and n(rec, "inject") == 0 and list(fs.values())[0]["ticks"] == 2)
        rc, o, rec = run("--tick")
        ok("tick 3, still standing: no second page inside the window", n(rec, "notify") == 0)
        ok("status lists the standing finding and today's calls", "sessions/box" in run("status")[1] and "calls" in run("status")[1])
        # (c) the finding clears → key gone, nobody paged
        open(verdict, "w").write(json.dumps({"ok": True, "findings": []}))
        open(f"{panes}/@4", "w").write("> \n")
        rc, o, rec = run("--tick")
        ok("cleared: the key is gone and nothing was sent", led() == {} and n(rec, "notify") == 0 and n(rec, "inject") == 0)
        ok("a changed pane was judged, unchanged concerns were not", n(rec, "claude") == 1)
        # (e) unchanged fixtures → no call at all
        rc, o, rec = run("--tick")
        ok("nothing changed → zero calls", n(rec, "claude") == 0 and "no call made" in o)
        # (d) --dry-run: judges, prints, sends nothing, writes nothing
        open(f"{panes}/@1", "w").write("Error: something broke\n> \n")
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [{"target": "sessions/alpha", "what": "error on screen", "why": "unhandled", "evidence": "Error: something broke"}]}))
