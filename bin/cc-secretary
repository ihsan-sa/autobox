           n(rec, "notify") == 1 and n(rec, "claude") == 0)
        del os.environ["CC_FAKE_QUEUE"]
        # fix 3: a pane that went mid-turn is not "gone"
        open(f"{panes}/@4", "w").write("Thinking… (1m) · esc to interrupt\n")
        rc, o, rec = run("--tick")
        ok("the finding's pane went mid-turn: kept as is (not gone, not re-judged, not re-sent)",
           len(load(f"{SEC}/findings.json", {})) == 1 and n(rec, "claude") == 0 and n(rec, "notify") == 0)
        open(f"{panes}/@4", "w").write("> \n"); open(verdict, "w").write(json.dumps({"ok": True, "findings": []}))
        rc, o, rec = run("--tick")
        ok("the pane came back healthy: judged once, cleared", load(f"{SEC}/findings.json", {}) == {} and n(rec, "claude") == 1)
        # fix 3: a stale Home tab is unknown, not empty; a fresh one without the band is positive absence
        fresh(); open(verdict, "w").write(json.dumps({"ok": False, "findings": [{"target": "home/needs", "what": "a row that needs nobody",
                                                                                 "why": "the session could decide it", "evidence": "do these need me?"}]}))
        run("--tick")
        json.dump({"at": stamp(now() - 3600), "text": {"tally": "RUNNING 2", "needs": "❓ 3h · do these need me?"}}, open(f"{STATE}/home.json", "w"))
        rc, o, rec = run("--tick")
        ok("Home tab 1 h stale: the board fallback is judged and the tab's finding is kept, not gone",
           len(load(f"{SEC}/findings.json", {})) == 1 and '<item id="home/board"' in rec)
        json.dump({"at": stamp(), "text": {"tally": "RUNNING 2"}}, open(f"{STATE}/home.json", "w"))
        rc, o, rec = run("--tick")
        ok("Home tab fresh and the band gone: positive absence → the finding is gone", load(f"{SEC}/findings.json", {}) == {})
        # a re-confirmation on changed evidence restarts the unchanged streak; the next unchanged tick pages
        fresh(); open(f"{panes}/@1", "w").write("Error: boom\n> \n")
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [{"target": "sessions/alpha", "what": "error on screen", "why": "unhandled", "evidence": "Error: boom"}]}))
        run("--tick")
        open(f"{panes}/@1", "w").write("Error: boom\nError: boom again\n> \n")
        rc, o, rec = run("--tick")
        fs = load(f"{SEC}/findings.json", {})
        ok("tick 2 on changed evidence: re-judged and re-confirmed, streak restarted (ticks 2, unchanged 1), not paged",
           n(rec, "claude") == 1 and n(rec, "notify") == 0 and list(fs.values())[0]["ticks"] == 2 and list(fs.values())[0]["stood"] == 1)
        rc, o, rec = run("--tick")
        ok("tick 3 unchanged: stood 2 → paged", n(rec, "notify") == 1 and n(rec, "claude") == 0)
        ok("status shows the unchanged streak", "(unchanged ×2)" in run("status")[1])
        # 133b fix 2: a silence bucket moving is a change even when the tails are byte-identical
        fresh(); run("--tick")
        for p_ in (f"{STATE}/alpha/t1/loop.log", f"{STATE}/alpha/t1/progress.md"):
            os.utime(p_, (now() - 11 * 3600, now() - 11 * 3600))
        rc, o, rec = run("--tick")
        ok("133b-2: a worker silent 11 h on unchanged tails is a change (silent_bucket hashed verbatim) → judged again",
           n(rec, "claude") == 1 and '<item id="workers/alpha/t1"' in rec and f"silent_bucket={bucket(11 * 3600)}" in rec and bucket(11 * 3600) == 5)
        # 133b fix 3: the 12 h page budget counts pages sent, not findings still standing
        fresh(); os.environ["CC_SECRETARY_PAGES"] = "1"
        open(f"{panes}/@4", "w").write("Use this MCP server?\n 1. Yes\nEnter to confirm · Esc to cancel\n"); open(verdict, "w").write(dialog)
        run("--tick"); run("--tick")                                                                           # A: offered, then paged
        open(f"{panes}/@4", "w").write("> \n"); open(verdict, "w").write(json.dumps({"ok": True, "findings": []})); run("--tick")   # A clears
        open(f"{panes}/@1", "w").write("Error: boom\n> \n")
        open(verdict, "w").write(json.dumps({"ok": False, "findings": [{"target": "sessions/alpha", "what": "error on screen", "why": "unhandled", "evidence": "Error: boom"}]}))
        run("--tick"); rc, o, rec = run("--tick")                                                              # B: offered, stands
        ok("133b-3: A paged then cleared, B stands → NOT paged: the budget (1 per 12 h) is spent per the page log, not per standing finding",
           n(rec, "notify") == 0 and read(f"{SEC}/pages.jsonl").count("\n") == 1 and load(f"{SEC}/findings.json", {}) and "1/1 pages" in run("status")[1])
        os.environ["CC_SECRETARY_PAGES"] = "2"
        # 133b fix 4: a handoff successor window `repo/track~next` is that track's window, not drift
        fresh(); open(tmuxf, "w").write("@1\talpha\t100\t0\n@2\talpha/t1~next\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        rc, o, rec = run("--dry-run")
        ok("133b-4: board alpha/t1 running with its window named alpha/t1~next is not `no tmux window`",
           '<item id="box/drift"' in rec and "no tmux window" not in rec)
        open(tmuxf, "w").write("@1\talpha\t100\t0\n@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        # the 2026-09-01 miss: a finding routed to a session that cannot read it. Absent or on a modal, the box's own
        # planning session hears it instead — and a modal, which only the owner can clear, does not wait for tick 2.
        worker = json.dumps({"ok": False, "findings": [{"target": "workers/alpha/t1", "what": "silent for hours",
                                                        "why": "the board still says running", "evidence": "did a step"}]})
        fresh(); open(tmuxf, "w").write("@1\talpha~next\t100\t0\n@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        open(verdict, "w").write(worker)
        rc, o, rec = run("--tick")
        ok("the repo's session mid-handoff (`alpha~next`) is still its session: it hears its own finding, nothing is re-routed",
           n(rec, "inject alpha") == 1 and n(rec, "inject abox") == 0)
        fresh(); open(tmuxf, "w").write("@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        open(verdict, "w").write(worker)
        rc, o, rec = run("--tick")
        fs = load(f"{SEC}/findings.json", {})
        ok("no session for the finding's repo: the planning session hears it, the original target named on the line, and that IS the tick-1 delivery",
           n(rec, "inject alpha") == 0 and n(rec, "inject abox") == 1 and "alpha did not hear it (no session window)" in rec
           and n(rec, "notify") == 0 and list(fs.values())[0]["offered"])
        open(tmuxf, "w").write("@1\talpha\t100\t0\n@2\talpha/t1\t200\t0\n@3\talpha/old\t300\t0\n@4\tbox\t400\t0\n")
        fresh(); os.environ["CC_SECRETARY_PAGES"] = "0"
        open(f"{panes}/@4", "w").write("Use this MCP server?\n 1. Yes\nEnter to confirm · Esc to cancel\n"); open(verdict, "w").write(dialog)
        rc, o, rec = run("--tick")
        ok("shadow mode (PAGES=0): the same blocked delivery still reaches the planning session, and the owner is not rung",
           n(rec, "inject abox") == 1 and n(rec, "notify") == 0 and load(f"{SEC}/findings.json", {}))
        os.environ["CC_SECRETARY_PAGES"] = "2"
        fresh()
        # CC_SECRETARY_FAKE: a verdict with no model at all
        os.environ["CC_SECRETARY_FAKE"] = json.dumps({"ok": True, "findings": []})
        open(f"{panes}/@1", "w").write("> \n")
        rc, o, rec = run("--dry-run")
        ok("CC_SECRETARY_FAKE answers without a model process", n(rec, "claude") == 0 and "nothing to report" in o)
        del os.environ["CC_SECRETARY_FAKE"]
        # rubric tune, rules 2–5 (live tick 2026-09-01 14:47Z): the bundles that came back as findings, each now carrying in
        # its header what the model had to invent, and a rubric that names the case. Rule 1 sits with the long-turn cases above.
        def seg(rec_, id_):
            return rec_.split(f'<item id="{id_}"')[1].split("</item>")[0] if f'<item id="{id_}"' in rec_ else ""
        def age_fixtures(iter_s, snap_s, tab_s):
            open(f"{STATE}/alpha/t1/loop.log", "w").write(f"{stamp(now() - iter_s)} iter 1/1 start (budget $8, turns 80)\n")
            for p_ in (f"{STATE}/alpha/t1/loop.log", f"{STATE}/alpha/t1/progress.md"):
                os.utime(p_, (now() - iter_s, now() - iter_s))
            json.dump({"at": stamp(now() - snap_s), "tracks": snap}, open(f"{STATE}/reconcile.json", "w"))
            json.dump({"at": stamp(now() - tab_s), "text": {"tally": "RUNNING 2\n🏃 *alpha* cctest-leak · 5m",
                                                             "sessions": "SESSIONS · 1\n*alpha*\n  ↳ 🟢 ece1"}}, open(f"{STATE}/home.json", "w"))
        fresh(); age_fixtures(300, 120, 0)
        rc, o, rec = run("--tick")
        w = seg(rec, "workers/alpha/t1").split(">")[0]
        ok("rule 2: a worker 5 min silent carries iter=1/1 iter_age=5m and budget=$8, turns 80 beside silent=5m; the rubric says under 20 min is normal",
           all(x in w for x in ("silent=5m", "iter=1/1", "iter_age=5m", "budget=$8, turns 80")) and "under 20 min is normal and NEVER a finding" in rec)
        ok("rule 3: the kind=session board row is marked on its reconcile line and the rubric says SESSIONS is its place, never a mismatch",
           "alpha/ece1: state=open board=open live=True kind=session" in rec and "never a mismatch" in rec)
        ok("rule 4: a fixture STARTS with _cctest — owner and box rubrics both say so; the leftovers list has _cctest9 and not cctest-leak",
           rec.count("STARTS with `_cctest`") == 2 and "_cctest9" in seg(rec, "box/leftovers") and "cctest-leak" not in seg(rec, "box/leftovers")
           and "cctest-leak" not in seg(rec, "box/drift"))
        ok("rule 5: the Home tab and the snapshot carry their ages (tab_age=0m, snap_age=2m)",
           'kind="home-tab" tab_age=0m' in rec and 'kind="reconcile" snap_age=2m' in rec)
        age_fixtures(900, 240, 60)
        rc, o, rec = run("--tick")
        ok("rules 2/5: iter_age, snap_age and tab_age moving on their own (5→15 m, 2→4 m, 0→1 m) is not a change — no call",
           n(rec, "claude") == 0)
        # rule 5 has two halves: what is suppressed is a row that MOVED between the two snapshots, not a snapshot that is fresh.
        # A 25 min old tab contradicted by a 2 min old snapshot is the finding the owner wants — unless the row itself just moved.
        def dispatched(secs):
            b = load(f"{BOARDS}/alpha.json", {})
            for t_ in b["tracks"]:
                t_["updated"] = stamp(now() - secs)
            atomic(f"{BOARDS}/alpha.json", json.dumps(b))
        fresh(); dispatched(60); age_fixtures(300, 120, 1500)
        rc, o, rec = run("--tick")
        ok("rule 5 (suppressed): a stale tab (25m) against a fresh snapshot (2m) about a row dispatched 1 min ago carries dispatch=1m, "
           "and the rubric calls that timing",
           'kind="home-tab" tab_age=25m' in rec and 'kind="reconcile" snap_age=2m' in rec
           and "dispatch=1m" in seg(rec, "home/tracks") and "is under 5 min old" in rec and "timing, not a finding" in rec)
        fresh(); dispatched(7200); age_fixtures(300, 120, 1500)
        rc, o, rec = run("--tick")
        ok("rule 5 (kept): the same stale tab against the same fresh snapshot about a row that last moved 2 h ago is NOT exempt — "
           "dispatch=2h00m, and the rubric says the disagreement is a finding whichever snapshot is older",
           "dispatch=2h00m" in seg(rec, "home/tracks") and "IS a finding, whichever snapshot is older" in rec)
        shutil.rmtree(BIN, ignore_errors=True)
    print(f"cc-secretary selfcheck: {p} passed, {f} failed")
    return 1 if f else 0


FAKES = {
    "claude": r"""#!/usr/bin/env bash
# records its argv and the prompt, answers with the fixture verdict
{ printf 'claude'; printf ' %q' "$@"; printf ' think=%s' "${MAX_THINKING_TOKENS-unset}"; echo; } >> "$CC_FAKE_CALLS"; cat >> "$CC_FAKE_CALLS"; echo >> "$CC_FAKE_CALLS"
v=$(cat "$CC_FAKE_VERDICT" 2>/dev/null || echo '{"ok":true,"findings":[]}')
printf '{"type":"result","subtype":"success","is_error":false,"structured_output":%s,"total_cost_usd":0.0031,"num_turns":2,"modelUsage":{"claude-haiku-4-5-20251001":{}},"usage":{"input_tokens":12,"cache_creation_input_tokens":3000,"cache_read_input_tokens":0,"output_tokens":80}}' "$v"
""",
    "tmux": r"""#!/usr/bin/env bash
cmd="${1:-}"; shift; targ=""
while [ $# -gt 0 ]; do case "$1" in -t) targ="${2:-}"; shift 2;; *) shift;; esac; done
case "$cmd" in
  list-windows) cat "$CC_FAKE_TMUX";;
  capture-pane) cat "$CC_FAKE_PANES/$targ" 2>/dev/null;;
esac
exit 0
""",
    "cc-slack": r"""#!/usr/bin/env bash
case "${1:-}" in
  inject) shift; [ "$1" = --no-start ] && shift; printf 'inject %s :: %s\n' "$1" "$2" >> "$CC_FAKE_CALLS"
          [ -n "${CC_FAKE_QUEUE:-}" ] && echo queued || echo delivered;;
  history) echo "10:00 owner: why is x?"; echo "10:02 abox: because y.";;
esac
""",
    "cc-notify": r"""#!/usr/bin/env bash
printf 'notify %s\n' "$*" >> "$CC_FAKE_CALLS"
""",
    "cc-janitor": r"""#!/usr/bin/env bash
echo "cc-janitor alpha (dry run)"
[ -n "${CC_FAKE_JANITOR:-}" ] && echo "  would kill window alpha/old — a bare shell on a track that is merged"
echo "cc-janitor: 0 swept, 0 reported (dry run — nothing changed)"
""",
    "cc-units": "#!/usr/bin/env bash\necho 'user units — all 3 enabled, active and armed'\n",
    "cc-scope": "#!/usr/bin/env bash\ncat \"$CC_FAKE_SCOPE/$2.json\"\n",
    "cc-limit": r"""#!/usr/bin/env bash
case "$1" in status) [ -s "$CC_LIMIT_STAMP" ] && { echo "usage limit until 12:00Z"; exit 0; }; echo clear; exit 1;; *) exit 1;; esac
""",
    "systemctl": "#!/usr/bin/env bash\necho 'n/a   n/a   -   -   cc-dead.timer   cc-dead.service'\n",
    "ps": "#!/usr/bin/env bash\ncat \"$CC_FAKE_PS\"\n",
}


def main(argv):
    if argv[:1] == ["--tick"]:
        return tick(False)
    if argv[:1] == ["--dry-run"]:
        return tick(True)
    if argv[:1] == ["status"]:
        return status()
    if argv[:1] == ["selfcheck"]:
        return selfcheck()
    print("usage: cc-secretary --tick | --dry-run | status | selfcheck", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
