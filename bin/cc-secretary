        # a secret on a pane never reaches the model
        open(f"{panes}/@1", "w").write("token xoxb-123456-abcdef\n> \n")
        rc, o, rec = run("--tick")
        ok("a Slack token on a pane is redacted before the model sees it", "xoxb-123456" not in rec and "[redacted]" in rec)
        # the cap: 100 rows today → no call, `cap` logged
