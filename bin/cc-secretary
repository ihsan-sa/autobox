           '<item id="sessions/alpha"' not in rec and "state=mid-turn" not in rec)
        since("sessions/alpha", 13); rc, o, rec = run("--tick")
        ok("rule 1 (kept): the same planner 13 h in IS sent as role=planning, and the rubric makes its turn a finding past 12 h — the "
           "PLANNER_TURN bar the gate uses, so the escalation the docstring promises can fire",
           '<item id="sessions/alpha"' in rec and "role=planning state=mid-turn" in rec
           and "a finding only when the header shows turn past 12 h" in rec and "a planning window's turn under 12 h" in rec)
        open(f"{panes}/@4", "w").write("Thinking… (2m) · esc to interrupt\n"); run("--tick")
        since("sessions/box", 3); rc, o, rec = run("--tick")
        ok("rule 1: an interactive window (box, role=session) 3 h into a turn is still sent — CC_SECRETARY_LONG_TURN is its bar",
           '<item id="sessions/box"' in rec and "role=session state=mid-turn" in rec)
        open(f"{panes}/@4", "w").write("> \n")
        # 133b fix 1: the turn finished → the clock resets; the next turn is not dated from the old one
        open(f"{panes}/@1", "w").write("done\n> \n"); run("--tick")
        open(f"{panes}/@1", "w").write("Thinking… (1m) · esc to interrupt\n")
        rc, o, rec = run("--tick")
        ok("133b-1: a pane idle again clears working_since, so a fresh turn seconds old is not sent as a long one",
           load(f"{SEC}/gate.json", {})["sessions/alpha"]["working_since"] >= now() - 60 and '<item id="sessions/alpha"' not in rec)
        def fresh():
            shutil.rmtree(SEC, ignore_errors=True); os.makedirs(SEC)
            open(f"{panes}/@1", "w").write("> \n"); open(f"{panes}/@4", "w").write("> \n")
            json.dump({"at": stamp(), "text": {"tally": "RUNNING 2", "needs": "❓ 3h · do these need me?"}}, open(f"{STATE}/home.json", "w"))
            open(verdict, "w").write(json.dumps({"ok": True, "findings": []}))
