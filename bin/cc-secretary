           n(rec, "claude") == 0 and any("pace —" in ln for ln in read(f"{SEC}/secretary.log").splitlines()[-6:]) and load(f"{SEC}/gate.json", {})["sessions/alpha"]["hash"] == was)
        os.environ["CC_SECRETARY_CAP"] = "10000"
        # fix 2: an offer nobody took still climbs — no modal here, so it is the queue that fails, not the pane
        fresh(); open(f"{panes}/@4", "w").write("Error: mcp connect failed\n> \n"); open(verdict, "w").write(boxerr)
        os.environ["CC_FAKE_QUEUE"] = "1"
        rc, o, rec = run("--tick")
        fs = load(f"{SEC}/findings.json", {})
        ok("tick 1, nobody live: queued is not delivered, so the planning session is tried too and it is recorded as not taken, nobody paged",
           n(rec, "inject box") == 1 and n(rec, "inject abox") == 1 and n(rec, "notify") == 0 and len(fs) == 1
           and not list(fs.values())[0]["offered"] and list(fs.values())[0]["offered_at"])
        rc, o, rec = run("--tick")
