        ok("100 calls today: no call, cap logged", n(rec, "claude") == 0 and any("cap —" in ln for ln in read(f"{SEC}/secretary.log").splitlines()[-6:]))
        # a usage limit skips the whole tick
        open(f"{th}/limit", "w").write(f"{int(now()) + 3600}\tprobe\t{int(now())}\thaiku\n")
