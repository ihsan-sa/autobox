        os.remove(f"{th}/limit")
        # a mid-turn pane is Claude's business, not ours — until it has run for hours
        open(f"{panes}/@1", "w").write("Thinking… (2m) · esc to interrupt\n")
        os.environ["CC_SECRETARY_CAP"] = "10000"
        rc, o, rec = run("--tick")
        ok("a pane mid-turn is not sent", '<item id="sessions/alpha"' not in rec)
        # rubric tune, rule 1 (live tick 2026-09-01 14:47Z): `alpha` is a PLANNING window — an event loop whose turn is open
        # for hours by design. This bundle used to arrive as state=mid-turn turn=3h and came back as a finding.
