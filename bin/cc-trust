#!/usr/bin/env bash
# cc-trust [rm] <dir> — mark <dir> as a trusted Claude Code workspace in ~/.claude.json so the
# "Is this a project you trust?" prompt never blocks an unattended session; `rm` drops the entry
# (cc rm calls it, so removed tracks leave nothing behind). Idempotent, and locked: live sessions
# rewrite the same file, so a read-modify-mv without flock loses their updates.
set -euo pipefail
mode="set"; [ "${1:-}" = rm ] && { mode="rm"; shift; }
d="$(readlink -f "${1:?usage: cc-trust [rm] <dir>}")"; f="$HOME/.claude.json"
[ -f "$f" ] || echo '{}' > "$f"
exec 9>"$f.lock"; flock 9
if [ "$mode" = rm ]; then jq --arg d "$d" 'del(.projects[$d])' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; exit 0; fi
jq -e --arg d "$d" '.projects[$d].hasTrustDialogAccepted == true' "$f" >/dev/null 2>&1 && exit 0
jq --arg d "$d" '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true})' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
