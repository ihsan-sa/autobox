#!/usr/bin/env bash
# cc-green — a worker's own green: `lander check` on the tree you are about to hand over, and whether it has
# already passed on THAT tree.
#
#   cc-green                 what `lander check` last said on this worktree, and whether that was on the tree the
#                            working copy holds now; then the recurring defects below. exit 1 unless the last verdict
#                            is green on this very tree and the diff carries no recurring defect
#   cc-green run             …and run `lander check` on the worktree, one run per worktree, into a log it names.
#                            The run is a process of its own that outlives this one: this follows its log and exits
#                            with its code. A Ctrl-C here is carried to the run; a TERM or hangup here ends only the
#                            following. exit 3 and no second run when a run is already going on this root; exit 1
#                            when the run was killed before it finished
#   cc-green start           …the same run, and return as soon as it has started: the ROUTE FOR A WORKER, whose check
#                            outlives a foreground tool call. It needs no `setsid`, `nohup` or `&` from the caller —
#                            the run detaches itself (below), and a caller that types those is read by the auto-mode
#                            classifier as a bypass and refused (twice on 2026-09-25). A worker then ENDS ITS ITERATION
#                            rather than wait in a model turn: cc-loop's green_wait waits on the run with no model call
#                            and journals its exit and log for the next one. Anyone else: `cc-green wait` until it
#                            does not exit 3. exit 0 once the run is going, 3 when one already is
#   cc-green start -- SUITE  the same for one of the repo's own suites: a `[core/]tests/check*.sh` or `selftest*.sh`
#                            (`tests/check-slow.sh`), or a tool's `[core/]bin/<tool> selfcheck` for a tool that ships
#                            one — nothing else, no other arguments, and only a file the branch's HEAD already tracks,
#                            so it cannot be a general way to detach any command past the classifier (review of PR
#                            #675). Run from the root, on the same lock, log and status, so `wait` and cc-loop's
#                            green_wait follow it too. It leaves no verdict. `wait` on it says the suite's exit and
#                            exits 0 when that was 0, else 1 — no report. `run -- SUITE` is the same, in the foreground
#   cc-green wait [SECONDS]  block on that run, SECONDS at most (default 540, under a foreground tool call). Ended,
#                            or none going: the report for the tree as it is NOW, exit 0/1 as above. Still going:
#                            `still running (pid, since)`, exit 3 — call again. Killed or interrupted before it
#                            finished: says so and exits 1, with no report
#   cc-green stop            end THIS worktree's run, so a run whose tree has moved under it — a verdict nobody will
#                            spend — does not hold `start` at exit 3 until it is over. The route for a worker, whose own
#                            `kill` of the run the classifier refuses as interfering with a workload (2026-09-26, ~22 min
#                            lost behind a stale suite). It reaches only the pid this root's status note names and the
#                            process group that run wrote there, and only after reading each one's environment for the
#                            run's own CC_GREEN_RUNID — no process is found by name or pattern, and another worktree's
#                            run has another lock, note and runid. TERM first, so the run takes its check down and says
#                            `interrupted`; a run still holding the lock 30 s later gets KILL, and so does a group of
#                            its still there 5 s after that. A worker's later Bash call is a signal scope of its own
#                            that can neither read nor signal the run an earlier call started, so from there it asks:
#                            the runid goes into the note's .stop file, and the run stops itself (stop_watch,
#                            which starts with the run, so a stop asked before its check starts is carried out
#                            too). The stop removes the file once the run is gone. A file left by a stop that
#                            gave up is harmless, since each run has its own runid.
#                            Then `cc-green start` runs on the tree as it is now. exit 0 once none is going (or none
#                            was), 1 when the lock is held by something this cannot prove is the run
#   cc-green red SCOPE KIND KEY --observed TEXT [--log FILE] [--writer W] [--expected TEXT] [--link k=v]... [--cost k=v]...
#                            one failures-ledger record (cc-failures record), ONCE per KEY: a second call with a KEY the
#                            scope's ledger already holds under links.source writes nothing and says `already <id>`. The
#                            last 8 KiB of --log and its ✗/FAIL lines go to a bounded excerpt under
#                            $CC_FAILURES/excerpts/<scope>/ that outlives the log. ALWAYS exit 0 — the caller (cc-loop's
#                            stops, among others) keeps its own verdict whatever the ledger does; what happened is one
#                            line on stdout: `recorded <id>` · `already <id>` · `not recorded: <why>`
#   cc-green selfcheck       fixtures of its own: a scratch verdict directory, a fake lander, throwaway repos
#
# WHAT RUNS. `lander check <root>` plans the worktree's change against its base and runs only the checks that plan
# selects, the way the landing will (core/lander/check.py). It exits 0 green, 1 a check red, 3 no verdict (a check
# could not run); cc-green's own answer is 0 for green and 1 for anything else. Which lander: the worktree's own
# core/lander/cli.py through `python3 -P` when the worktree has one — so a worker on this repo tests the lander its
# branch carries, and never needs a pinned release to exist — else the `lander` on PATH. Neither is no verdict.
# The check runs with no *_TOKEN / *_KEY / *_SECRET / *_CREDS / *_WEBHOOK / *_PASSWORD or named API token from this
# shell, and with the live ~/.cc/config denied (CC_CONFIG_DENY).
# A RED IS NOT WRITTEN TO THE FAILURES LEDGER from here. lander check holds a check that is red on the base too
# against main, not the change, so a red it reports is red only on the branch: that is the worker's own work.
#
# THE VERDICT IS KEYED BY THE TREE. A worker's check ran green, then it kept editing, the Stop hook committed, and
# the tree the PR carried was one nothing had passed on (11 of 34 landings on 2026-09-07). So the run writes what
# it answered beside its lock — the tree it ran on (tests/green.sh's green_tree: every tracked and addable file,
# hashed by git), the exit, the time — and the report calls it green only while the working copy is still that
# tree. A check that itself moves the tree leaves no verdict at all: it passed on content this checkout no longer
# holds. The note is one per root and says nothing to the landing, which plans and checks the change on its own.
#
# THE RECURRING DEFECTS. The report also looks at the diff against origin/HEAD for each defect class the landing
# review has stopped two or more PRs for, and a class it finds holds the hand-over like a red check. No model
# call. The classes come from the record, not from here: tests/recurring_defects.py counts the recorded
# LAND-AFTER-FIX reviews against config/recurring-defects.json, which says how each class is placed and how it
# shows in a diff.
#
# ONE RUN PER WORKTREE. Two `run`s went at one tree at once — an earlier iteration's was still going and nothing
# readable said so — and a loaded box ran the whole thing twice. `run` holds a flock keyed by the root's realpath
# for as long as it runs and writes what it is doing beside it (root, tree, pid, started, log); a second `run` on
# that root reads the note and exits 3. `wait` blocks on the same lock, so a worker that detached the run holds
# nothing but a bounded call and a log path — and the run does not die with the worker's iteration (A RUN
# OUTLIVES WHOEVER STARTED IT, below).
set -uo pipefail
SELF="$(readlink -f "$0")"; BIN="$(dirname "$SELF")"; CORE="$(cd "$BIN/.." && pwd)"
USAGE="usage: cc-green [run|start [-- SUITE]|wait [SECONDS]|stop|red SCOPE KIND KEY --observed TEXT [--log FILE]…|selfcheck]"
# The tree is taken by tests/green.sh's green_tree: one algorithm for every reader of "the tree this working copy
# would commit".
# shellcheck source=/dev/null
. "$CORE/tests/green.sh"
GDIR="${CC_GREEN_DIR:-$HOME/.cc/state/land/green}"

for t in jq flock; do command -v "$t" >/dev/null 2>&1 || { echo "cc-green: $t is missing" >&2; exit 2; }; done

root(){ git rev-parse --show-toplevel 2>/dev/null; }
now(){ date -u +%Y-%m-%dT%H:%M:%SZ; }
CMD=""      # the suite a `start -- SUITE` run carries instead of lander check; set in the run only

# ── the failures ledger: `red`, and the rule that keeps a worker's own red out of it ──────────────────────────
FDIR="${CC_FAILURES:-$HOME/.cc/failures}"   # cc-failures' own default; a test run points both at a scratch dir
RED_TAIL=8192                                # bytes of a log an excerpt keeps — bounded, so a red never fills a disk
RED_LINES=40                                 # …and at most this many ✗/FAIL lines ahead of that tail
RED_RE='✗|✘|FAIL|Error\b|error:|not ok|Traceback|[1-9][0-9]* failed'   # the ✗/FAIL lines an excerpt leads with, plus a red tally

excerpt(){   # SCOPE KEY LOG → the path of a bounded excerpt of LOG under the ledger's dir, or nothing when there is no log
  local scope=$1 key=$2 log=$3 d f n
  [ -n "$log" ] && [ -r "$log" ] || return 0
  d="$FDIR/excerpts/$scope"; mkdir -p "$d" 2>/dev/null || return 0
  f="$d/$(printf '%s' "$key" | tr -c 'A-Za-z0-9._-' '_').log"
  n=$(stat -c %s "$log" 2>/dev/null || echo 0)
  { printf 'source=%s\nlog=%s (%s bytes; its red lines first, then its last %s bytes)\n\n' "$key" "$log" "$n" "$RED_TAIL"
    grep -nE "$RED_RE" "$log" 2>/dev/null | head -n "$RED_LINES"
    printf '\n--- tail ---\n'; tail -c "$RED_TAIL" "$log" 2>/dev/null; } > "$f" 2>/dev/null || return 0
  echo "$f"
}

red(){   # SCOPE KIND KEY --observed TEXT [--log FILE] [--writer W] [--expected TEXT] [--link k=v]... [--cost k=v]...
  local scope=${1:-} kind=${2:-} key=${3:-} observed="" log="" writer=cc-green expected="" have id ex
  local -a extra=()
  [ $# -ge 3 ] && shift 3
  while [ $# -gt 0 ]; do case "$1" in
    --observed) observed=${2:-}; shift;; --log) log=${2:-}; shift;; --writer) writer=${2:-}; shift;;
    --expected) expected=${2:-}; shift;; --link|--cost) extra+=("$1" "${2:-}"); shift;;
    *) echo "not recorded: red: unknown arg $1" >&2; return 0;; esac; shift; done
  [ -n "$scope" ] && [ -n "$kind" ] && [ -n "$key" ] && [ -n "$observed" ] \
    || { echo "not recorded: red needs SCOPE KIND KEY --observed TEXT" >&2; return 0; }
  # ONCE PER KEY. The ledger is read through cc-failures, never the file: `show --json` folds corrections in and
  # prints [] for a scope with no ledger yet. A read that fails is said, and nothing is written over it.
  have=$(CC_FAILURES="$FDIR" "$BIN/cc-failures" show --json --scope "$scope" 2>/dev/null) \
    || { echo "not recorded: cc-failures show failed for scope $scope" >&2; return 0; }
  id=$(jq -r --arg k "$key" '[.[] | select(.links.source == $k)] | .[0].id // empty' <<<"$have" 2>/dev/null)
  [ -z "$id" ] || { echo "already $id"; return 0; }
  ex=$(excerpt "$scope" "$key" "$log")
  # ALWAYS EXIT 0: "a writer that fails must never fail the gate or landing it is in" — the caller's verdict was
  # decided before this ran, and an unwritable ledger is one line here, not a red of its own.
  if id=$(CC_FAILURES="$FDIR" "$BIN/cc-failures" record --scope "$scope" --kind "$kind" --observed "$observed" \
            ${expected:+--expected "$expected"} --writer "$writer" --detector box --detector-evidence "$writer saw it" \
            --link "source=$key" ${log:+--link "log=$log"} ${ex:+--evidence "excerpt:$ex"} "${extra[@]}" 2>&1); then
    echo "recorded ${id##* }"
  else echo "not recorded: $(tail -1 <<<"${id:-cc-failures record failed}")" >&2; fi
  return 0
}

# Every credential-shaped name in this environment — _TOKEN, _KEY, _SECRET, and the named API and login tokens —
# one per line, for `env -u`. The list cc-land's SECRET_ENV and clean_start() drop; the two must stay the same.
secret_names(){
  env | cut -d= -f1 | grep -E '^[A-Za-z_][A-Za-z0-9_]*$' \
    | grep -E '(_TOKEN|_KEY|_SECRET|_CREDS|_WEBHOOK|_PASSWORD)$|^(ANTHROPIC_API_KEY|OPENAI_API_KEY|CLAUDE_CODE_OAUTH_TOKEN|GH_TOKEN|GITHUB_TOKEN)$'
}

# ── the check: lander check on the root, and its verdict note ──────────────────────────────────────────────────
lander_cmd(){   # $1 = root → sets LCMD to the lander check to run there; 1 when there is none
  if [ -f "$1/core/lander/cli.py" ]; then LCMD=(python3 -P "$1/core/lander/cli.py" check "$1")
  elif command -v lander >/dev/null 2>&1; then LCMD=(lander check "$1")
  else return 1; fi
}
verdict_field(){ sed -n "s/^$1=//p" "$VERDICT" 2>/dev/null | head -1; }

# The RUN's side: lander check on $1, its output into the run's log (this process's stdout), in a process group of
# its own with a Ctrl-C or TERM on this run carried into it — bash starts an async job in a shell with no job
# control with SIGINT ignored, so without the group and the trap an INT ended cc-green and its lock while the check
# ran on as an orphan, and the next `run` on that root started a second one beside it. Never on this shell's stdin,
# and never holding the run lock (fd 9): a child the check leaves behind would keep the root locked after the run.
# The log is a file, not a pipe, so the run comes back on the check's own exit whatever it left running.
# The check runs under cc-nosignal, as a suite does in run_cmd: it may signal what it started and nothing else, so a
# pid it computes wrong (the user manager, on 2026-10-02) gets EPERM. A stop from here still reaches it.
run_check(){   # $1 = root → lander check's exit; 3 when there is no lander to run
  local r=$1 rc=0 n gp scrub=()
  local -a LCMD=()
  if ! lander_cmd "$r"; then
    echo "cc-green: no lander here — neither $r/core/lander/cli.py nor a \`lander\` on PATH — no verdict"
    return 3
  fi
  echo "cc-green: ${LCMD[*]}"
  while read -r n; do scrub+=(-u "$n"); done < <(secret_names)
  ( cd "$r" && exec setsid "$BIN/cc-nosignal" -- env "${scrub[@]}" PYTHONDONTWRITEBYTECODE=1 CC_CONFIG_DENY="$(realpath -m "$HOME/.cc/config")" \
      "${LCMD[@]}" ) </dev/null 9>&- & gp=$!
  printf 'gate_pgid=%s\n' "$gp" >> "$STATUS"     # what `stop` may reach besides the run itself
  trap 'kill -TERM -- -"$gp" 2>/dev/null; exit 130' INT TERM
  wait "$gp" || rc=$?
  run_traps
  return "$rc"
}

report(){   # $1 = tree → one line for lander check's last verdict on this root; 0 only when it is green on $1
  local t c at lg
  t=$(verdict_field tree); c=$(verdict_field check); at=$(verdict_field at); lg=$(verdict_field log)
  if [ -z "$t" ]; then echo "  RUN     lander check — no verdict on this worktree"; return 1; fi
  [ "$t" = "$1" ] || { echo "  RUN     lander check — its last verdict ($at) is on ${t:0:12}, not this tree"; return 1; }
  case "$c" in
    0) echo "  green   lander check — passed on this tree at $at"; return 0 ;;
    1) echo "  RED     lander check — a check it selected failed on this tree at $at; log $lg"; return 1 ;;
    *) echo "  RUN     lander check — no verdict (exit $c: a check could not run, or no lander) at $at; log $lg"; return 1 ;;
  esac
}

# ONE RUN PER ROOT. The lock is a flock on a file under $GDIR named for a hash of the root's realpath — two
# checkouts of one repo are two roots and two runs, the same checkout reached by two paths is one. Beside it a
# status note says what the run holding it is doing, and the run's own log: the run writes there and nowhere else,
# and whoever launched it follows that file, so a detached run has somewhere a worker can read. The lock is fd 9
# for as long as the run lives (its launcher takes it and hands it over, below); nothing releases it early.
lock_files(){   # $1 = root → LOCK STATUS LOG VERDICT
  local key; key=$(readlink -f "$1" | sha1sum | cut -c1-12)
  LOCK="$GDIR/run-$key.lock"; STATUS="$GDIR/run-$key.status"; LOG="$GDIR/run-$key.log"; VERDICT="$GDIR/run-$key.verdict"
}
status_field(){ sed -n "s/^$1=//p" "$STATUS" 2>/dev/null | head -1; }
run_traps(){ trap 'exit 130' INT; trap 'exit 143' TERM; }   # the run's own: a signal ends it with a code that says so
take_run(){   # $1 = root. The RUN's side: the lock its launcher handed over on fd 9, else its own (an exec layer shut it)
  lock_files "$1"; mkdir -p "$GDIR"
  { true >&9; } 2>/dev/null || exec 9>"$LOCK"
  flock -n 9 || { echo "cc-green: a run is already going on $1 (pid $(status_field pid)) — no second run" >&2; return 3; }
  trap '' HUP; run_traps
  begin_run "$1" ""
  # The exit, written by the run itself whatever ends it short of a SIGKILL: `wait` tells a run that ended from one
  # that was killed by this line being there or not. Without run_traps a TERM reaches this with $? = 0.
  trap 'printf "exit=%s\nended=%s\n" "$?" "$(now)" >> "$STATUS"' EXIT
  stop_watch
}
begin_run(){   # $1 = root, $2 = tree. Under the lock: what this run is; written first with no tree, then with it
  printf 'root=%s\ntree=%s\npid=%s\nstarted=%s\nlog=%s\nrunid=%s\n' "$1" "$2" "$$" "$(now)" "$LOG" "$CC_GREEN_RUNID" > "$STATUS"
  [ -z "$CMD" ] || printf 'cmd=%s\n' "$CMD" >> "$STATUS"
  [ -z "$2" ] || echo "cc-green: run on $1 (pid $$) — log $LOG"
}

# A RUN OUTLIVES WHOEVER STARTED IT. A track iteration started `setsid nohup cc-green run &` (the advice then; it is
# `cc-green start` now, because the classifier refuses a worker's own setsid/nohup) and ended two minutes
# later (error_max_turns); the run was gone with it — log two lines, nothing recorded, and a loop whose `green_wait` found no run to wait on. That is the signature of a TERM reaching this
# process: the run's trap takes its check's group down and exits 130 before a word is logged. `setsid` got the
# run out of the launcher's process group and session and nothing else — not its cgroup (the tmux pane's scope),
# not the parent chain a tool walks when it kills "everything this command started". So `run` is two processes now:
#   the LAUNCHER (`cc-green run`) takes the root's lock, writes the status note and truncates the log, starts the
#     RUN detached from everything it could share — a transient scope of its own (`systemd-run --user --scope`
#     where the user manager answers, else none), a new session, a parent it does not have (the subshell that
#     forks it exits), stdin /dev/null, HUP ignored, INT/TERM at default so its own traps hold — hands it the
#     lock, and waits until the status names the run's pid. Then it follows the log and exits with the run's
#     code, so a foreground `cc-green run` reads as it always did. A Ctrl-C on it is carried to the run (case 25);
#     a TERM or HUP on it ends the launcher and nothing else (case 23).
#   the RUN (`cc-green __run`, started only by a launcher) holds the lock for its whole life and writes `exit=`
#     into the status on its way out. `wait` reads that: a run that ended says its exit, and one with no exit
#     line, or 130/143, was killed or interrupted — said as such, exit 1, never green and never waited on for
#     ever (the lock goes with the process; case 24).
launch_run(){   # $1 = root, $2 = follow it (1) or return once it has started (0), $3… = a suite in place of lander check
                # → the run's exit (0 once started, unfollowed); 3 when one is already going, 1 when it was killed, 2 when it never started
  local r=$1 follow=$2 runid pid="" rc tp scope=() sub=(__run); shift 2
  [ $# = 0 ] || sub+=(-- "$@")
  lock_files "$r"; mkdir -p "$GDIR"
  exec 9>"$LOCK"
  if ! flock -n 9; then
    echo "cc-green: a run is already going on $r (pid $(status_field pid), started $(status_field started), log $(status_field log))" >&2
    echo "  — no second run. \`cc-green wait\` blocks on it and reports when it has ended." >&2
    stale_hint "$r" >&2
    return 3
  fi
  runid="$$-$(date +%s%N)"
  : > "$LOG"
  printf 'root=%s\npid=%s\nstarted=%s\nlog=%s\nrunid=%s\nstate=starting\n' "$r" "$$" "$(now)" "$LOG" "$runid" > "$STATUS"
  if [ "${CC_GREEN_SCOPE:-1}" = 1 ] && command -v systemd-run >/dev/null 2>&1 \
     && timeout 10 systemd-run --user --scope --quiet --collect true </dev/null >/dev/null 2>&1; then
    scope=(systemd-run --user --scope --quiet --collect --unit "cc-green-$runid" --)
  fi
  # The subshell forks the run and exits, so the run's parent is whatever reaps orphans, not this launcher. The run
  # inherits fd 9 — the same open lock — and this process lets go of it at once, so the lock lives as long as the run.
  ( cd "$r" && CC_GREEN_RUNID=$runid exec "${scope[@]}" env --default-signal=INT,QUIT,TERM setsid "$SELF" "${sub[@]}" \
      </dev/null >>"$LOG" 2>&1 & )
  exec 9>&-
  for _ in $(seq 100); do
    [ "$(status_field runid)" = "$runid" ] && [ "$(status_field state)" != starting ] && pid=$(status_field pid) && break
    sleep 0.1
  done
  if [ -z "$pid" ]; then
    echo "cc-green: the run did not start within 10 s — log $LOG:" >&2; tail -5 "$LOG" >&2; return 2
  fi
  if [ "$follow" = 0 ]; then
    echo "cc-green: started ${*:-lander check} on $r (pid $pid) — log $LOG"
    echo "  A worker ends its iteration now: its loop waits on the run with no model call and journals the log. Anyone else:"
    echo "  \`cc-green wait\` blocks up to 540 s and says when it has ended; exit 3 is still going, so call it again."
    return 0
  fi
  # The follower is async, so this shell sits in `wait`, which a trapped signal interrupts; a foreground tail would
  # hold the INT back until the run had ended on its own. An async job here starts with INT ignored, so a Ctrl-C
  # leaves the follower reading to the run's last line. A TERM or HUP ends the follower and this, never the run.
  tail -n +1 -f -s 0.2 --pid="$pid" "$LOG" 2>/dev/null & tp=$!
  trap 'kill -INT "$pid" 2>/dev/null' INT
  trap 'kill "$tp" 2>/dev/null; exit 143' TERM
  trap 'kill "$tp" 2>/dev/null; exit 129' HUP
  until wait "$tp"; do kill -0 "$tp" 2>/dev/null || break; done
  trap - INT TERM HUP
  rc=$(status_field exit)
  [ -n "$rc" ] || { echo "cc-green: the run (pid $pid) was killed before it finished — nothing it ran is trusted" >&2; return 1; }
  return "$rc"
}
suite_ok(){   # $1 = root, $2… = what `-- …` carries. 0 when it is one of the repo's own suites, else says why and 1.
  # ONLY A SUITE, NEVER A COMMAND. `start` detaches what it runs, and the classifier refuses a worker detaching a
  # process itself; an open `-- CMD` would have made this the way round that refusal. So the form is fixed — a
  # tests/ suite with no arguments or a bin/ tool's `selfcheck` — the path is a plain name (no `..`, no absolute
  # path), and the file is a regular one, not a symlink, that HEAD already tracks, so not a script written a moment
  # ago. A TOOL MUST SHIP A SELFCHECK: ccbox, cc-rc, cc-trust, cc-boot-notify and cc-heartbeat have none and read the
  # word as an ordinary argument, so their `selfcheck` would do their real work (security review of PR #675). HEAD's
  # copy is asked, in the shapes check.sh's ships_selfcheck reads (keep the two the same).
  # WHAT RUNS IS THE WORKING COPY, not HEAD's: these checks say the file is one the branch has committed, and a
  # tool whose committed copy has a selfcheck, but an edit made since is run as it stands. That is the same trust
  # lander check already gives the tree — a worker can edit the checks it runs too — and no more than it.
  local r=$1 p=${2:-} head; shift
  p=${p#./}
  if { [ $# = 1 ] && [[ "$p" =~ ^(core/)?tests/(check|selftest)[A-Za-z0-9_-]*\.sh$ ]]; } \
     || { [ $# = 2 ] && [ "$2" = selfcheck ] && [[ "$p" =~ ^(core/)?bin/[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; }; then
    if [ -f "$r/$p" ] && [ ! -L "$r/$p" ] && [ -x "$r/$p" ] && head=$(git -C "$r" show "HEAD:$p" 2>/dev/null); then
      [ $# = 1 ] && return 0
      if grep -qF "${p##*/} selfcheck:" <<<"$head" ||
         grep -qE 'selfcheck\)|"selfcheck":|== *\[?"selfcheck"\]?|add_parser\("selfcheck"|def cmd_selfcheck|= *"?selfcheck"?( *\]|$)' <<<"$head"; then
        return 0
      fi
      echo "cc-green: refused: $p ships no selfcheck, so \`$p selfcheck\` would run the tool itself" >&2
      return 1
    fi
    echo "cc-green: $p is not an executable file this branch's HEAD tracks — only a committed suite runs detached" >&2
    return 1
  fi
  echo "cc-green: refused: \`-- $*\` is not one of this repo's suites. \`-- \` takes only [core/]tests/check*.sh or" >&2
  echo "  selftest*.sh with no arguments, or [core/]bin/<tool> selfcheck; it does not detach any other command." >&2
  return 1
}
run_cmd(){   # $1 = root, $2… = the suite (suite_ok has passed it). The RUN's side of `start -- CMD`: its exit is the run's, and it records nothing
  local r=$1 gp rc=0; shift
  echo "cc-green: running $* in $r (pid $$) — log $LOG"
  # Its own process group, as lander check gets in run_check, so an INT or TERM on the run takes the command down with it.
  ( cd "$r" && exec setsid "$BIN/cc-nosignal" -- "$@" ) </dev/null 9>&- & gp=$!
  printf 'gate_pgid=%s\n' "$gp" >> "$STATUS"
  trap 'kill -TERM -- -"$gp" 2>/dev/null; exit 130' INT TERM
  wait "$gp" || rc=$?
  run_traps
  echo "cc-green: $* exited $rc"
  return "$rc"
}
wait_run(){   # $1 = root, $2 = seconds. Returns 3 while a run holds the lock past that, 4 when the last run was killed
  local pid rc
  lock_files "$1"; mkdir -p "$GDIR"
  exec 9>"$LOCK"
  # A second's grace before the first try: a `wait` in the same breath as a detached `run` can reach the lock
  # first, find it free and report RUN on a tree the run is a moment from testing — the one answer this must not
  # give. The bound still holds: the grace is inside SECONDS, not on top of it.
  sleep 1
  if ! flock -w "$(( $2 > 1 ? $2 - 1 : 0 ))" 9; then
    echo "cc-green: still running (pid $(status_field pid), since $(status_field started)) — log $(status_field log)"
    stale_hint "$1"
    return 3
  fi
  flock -u 9     # released at once: the report below is a second, and a run may start behind it
  pid=$(status_field pid); rc=$(status_field exit)
  [ -n "$pid" ] || return 0
  # A note with a runid is one a run writes its exit into. No exit there = the run did not end, it was ended.
  if [ -n "$(status_field runid)" ] && [ -z "$rc" ]; then
    echo "cc-green: the run (pid $pid, started $(status_field started)) was KILLED before it finished — no verdict; log $(status_field log)"
    return 4
  fi
  case "$rc" in 130|143) echo "cc-green: the run (pid $pid, started $(status_field started)) was interrupted (exit $rc) — no verdict; log $(status_field log)"; return 4;; esac
  echo "cc-green: the run (pid $pid, started $(status_field started)) has ended${rc:+ (exit $rc)} — log $(status_field log)"
  return 0
}

# A RUN ON A TREE THIS CHECKOUT NO LONGER HOLDS is one whose verdict nobody will spend, so say so where a caller
# meets it held: the refused `start` and the still-going `wait`. A command's run names no tree and gets no hint.
stale_hint(){   # $1 = root (lock_files already read). Says nothing unless the run's tree and the working copy's differ
  local was now_t; was=$(status_field tree); [ -n "$was" ] || return 0
  now_t=$(green_tree "$1"); [ -n "$now_t" ] && [ "$now_t" != "$was" ] || return 0
  echo "  That run is on ${was:0:12} and this working copy is ${now_t:0:12} now, so its verdict will not answer for it:"
  echo "  \`cc-green stop\` ends it, then \`cc-green start\` runs on the tree as it is."
}
# A STOP FROM ANOTHER SIGNAL SCOPE. A cc-loop worker's Bash calls each run in a scope of their own
# (cc-nosignal-shell), so the `cc-green stop` of a later call can neither read the environment of a run an earlier
# call started nor signal it: the kernel refuses both (review of #942). That stop leaves the note's runid in
# $STATUS.stop instead, and the run carries it out from inside its own scope: this watcher, beside the check, reads
# the file once a second, and on its own runid TERMs the run, whose trap takes the check's group down — the same
# path as a stop that can reach the run — then KILLs the run and the group if they are still there 30 s later.
# It starts with the run, not with its check: a stop asked while the run is still taking its tree would otherwise
# wait out the stop's 45 s and exit 1 though the run went on to stop itself (review of #942). So the group is read
# from the note when the stop comes, and a run stopped before its check started has none. It holds no fd of the
# lock and ends with the run.
stop_watch(){   # The RUN's side, started by take_run
  local me=$$ g
  ( exec 9>&-
    while kill -0 "$me" 2>/dev/null; do
      if [ -n "${CC_GREEN_RUNID:-}" ] && [ "$(cat "$STATUS.stop" 2>/dev/null)" = "$CC_GREEN_RUNID" ]; then
        echo "cc-green: asked to stop (cc-green stop, from a scope that cannot signal this run) — stopping"
        kill -TERM "$me" 2>/dev/null
        for _ in $(seq 300); do kill -0 "$me" 2>/dev/null || break; sleep 0.1; done
        g=$(status_field gate_pgid)
        is_ours "$me" "$CC_GREEN_RUNID" && kill -KILL "$me" 2>/dev/null
        [ -z "$g" ] || { is_ours "$g" "$CC_GREEN_RUNID" && kill -KILL -- -"$g" 2>/dev/null; }
        exit 0
      fi
      sleep 1
    done ) </dev/null &
}
hidden(){ [ -n "$1" ] && [ -e "/proc/$1" ] && ! { : < "/proc/$1/environ"; } 2>/dev/null; }   # a live pid whose environment this process may not read
# `cc-green stop`. Every pid it signals is one this root's status note names AND whose environment carries that
# note's runid, which a run and its check inherit from the launcher: a pid reused since, or a lock held by anything
# else, is left alone and said. Never pgrep/pkill -f — a -f pattern once killed ~26 sessions.
is_ours(){ [ -n "$2" ] && tr '\0' '\n' < "/proc/$1/environ" 2>/dev/null | grep -qxF "CC_GREEN_RUNID=$2"; }   # $1 = pid, $2 = runid
stop_run(){   # $1 = root → 0 when no run holds the root any more, 1 when this cannot end what holds it
  local pid runid g
  lock_files "$1"; mkdir -p "$GDIR"
  exec 9>"$LOCK"
  if flock -n 9; then flock -u 9; echo "cc-green: no run is going on $1 — nothing to stop"; return 0; fi
  pid=$(status_field pid); runid=$(status_field runid)
  if [ -n "$runid" ] && hidden "$pid"; then   # another Bash call's scope: ask the run itself (stop_watch); nothing is signalled from here
    echo "cc-green: the run on $1 (pid $pid) is in a signal scope this call cannot reach — asking it to stop"
    printf '%s\n' "$runid" > "$STATUS.stop"
    flock -w 45 9 || { echo "cc-green: the run on $1 did not stop within 45 s of being asked — log $(status_field log)" >&2; return 1; }
    flock -u 9; rm -f "${STATUS:?}.stop"   # done with; a stale one could never match a later run's runid anyway
    echo "cc-green: stopped — \`cc-green start\` runs lander check on the tree as it is now"
    return 0
  fi
  if ! is_ours "$pid" "$runid"; then
    echo "cc-green: the run lock on $1 is held, but pid ${pid:-?} is not a run carrying runid ${runid:-?} — nothing signalled" >&2
    return 1
  fi
  echo "cc-green: stopping the run on $1 (pid $pid, started $(status_field started), tree $(status_field tree | cut -c1-12))"
  kill -TERM "$pid" 2>/dev/null
  flock -w 30 9 || { echo "cc-green: the run still holds the lock 30 s after TERM — KILL"; is_ours "$pid" "$runid" && kill -KILL "$pid" 2>/dev/null; }
  # A check holds no fd of the lock, so a free lock does not mean it is gone: one that ignored the TERM the run
  # passed it, or one a KILLed run could not pass it to, is KILLed here — its group, once it proves to be this run's.
  while read -r g; do
    for _ in $(seq 50); do is_ours "$g" "$runid" || break; sleep 0.1; done
    is_ours "$g" "$runid" && kill -KILL -- -"$g" 2>/dev/null
  done < <(sed -n 's/^gate_pgid=//p' "$STATUS")
  flock -w 10 9 || { echo "cc-green: the lock on $1 is still held — log $(status_field log)" >&2; return 1; }
  flock -u 9
  echo "cc-green: stopped — \`cc-green start\` runs lander check on the tree as it is now"
}

main(){
  local mode=${1:-} r tree tree2 moved crc
  r=$(root) || true
  [ -n "${r:-}" ] || { echo "cc-green: not in a git checkout" >&2; exit 2; }
  # Wait BEFORE taking the tree: the report is on what the working copy holds once the run is over, not before.
  # And lock before it too: the lock is the first thing a run does, so a `wait` behind it has the least to race.
  # A killed run is not green whatever an older verdict says: exit 1 and no report (3 stays "still going").
  [ "$mode" = stop ] && { stop_run "$r"; exit $?; }
  if [ "$mode" = wait ]; then wait_run "$r" "$2"; case $? in 0) ;; 3) exit 3;; *) exit 1;; esac
    # A suite's run has no verdict to report on: its own exit is the answer (wait_run has said it).
    [ -z "$(status_field cmd)" ] || { [ "$(status_field exit)" = 0 ]; exit $?; }
  fi
  # Every door that takes `-- …` checks it the same way, __run too: the check is on what runs, not on who asked.
  # (The dispatcher below has already taken the `--` off for run/start; __run still carries it.)
  case "$mode" in
    run|start) [ $# -lt 2 ] || suite_ok "$r" "${@:2}" || exit 2 ;;
    __run)     [ "${2:-}" != -- ] || suite_ok "$r" "${@:3}" || exit 2 ;;
  esac
  [ "$mode" = run ] && { shift; launch_run "$r" 1 "$@"; exit $?; }
  [ "$mode" = start ] && { shift; launch_run "$r" 0 "$@"; exit $?; }
  [ "$mode" = __run ] && [ "${2:-}" = -- ] && CMD="${*:3}"
  [ "$mode" = __run ] && { take_run "$r" || exit 3; }
  [ "$mode" = __run ] && [ -n "$CMD" ] && { shift 2; run_cmd "$r" "$@"; exit $?; }
  lock_files "$r"
  # Taken in the background and waited on, because bash runs a trap only once its foreground child is done: a stop
  # asked while git is still hashing a large tree (stop_watch's TERM) ends the run now, not when git has finished.
  tf=$(mktemp "${TMPDIR:-/tmp}/cc-green-tree.XXXXXX") || exit 2
  green_tree "$r" > "$tf" & wait $!
  tree=$(cat "$tf"); rm -f "$tf"
  [ -n "$tree" ] || { echo "cc-green: cannot take this working copy's tree" >&2; exit 2; }
  if [ "$mode" = __run ]; then
    begin_run "$r" "$tree"
    crc=0; run_check "$r" || crc=$?
    # A check can leave the tree it just passed on behind it — a log, a scratch file, a rebuilt artefact. Ask again,
    # on what the working copy holds NOW: a moved tree gets no verdict, since whatever passed, passed on other content.
    tree2=$(green_tree "$r")
    if [ -n "$tree2" ] && [ "$tree2" != "$tree" ]; then
      moved=$(cd "$r" && git diff --name-only "$tree" "$tree2" 2>/dev/null | tr '\n' ' ')
      echo "cc-green: the run itself moved the tree ($tree -> $tree2): ${moved:-<unnameable>} — no verdict is kept"
      tree=$tree2; rm -f "$VERDICT"
    else
      printf 'tree=%s\ncheck=%s\nat=%s\nlog=%s\n' "$tree" "$crc" "$(now)" "$LOG" > "$VERDICT"
      # caged=1: this run was inside a worker's fence (bwrap is pid 1 there), whose files the worker writes itself.
      # cc-try puts nothing live on such a verdict; only a run on the host counts (security read of #1086).
      [ "$(cat "${CC_GREEN_PID1_COMM:-/proc/1/comm}" 2>/dev/null)" != bwrap ] || echo caged=1 >> "$VERDICT"
    fi
  elif [ -z "$mode" ] && [ -e "$LOCK" ] && ! flock -n "$LOCK" true 2>/dev/null; then
    echo "cc-green: a run is going on this worktree (pid $(status_field pid), since $(status_field started)) — \`cc-green wait\` for its verdict"
  fi
  echo "cc-green: what lander check found on ${tree:0:12}"
  local gates=0 defects=0
  report "$tree" || gates=1
  python3 "$CORE/tests/recurring_defects.py" check "$r" || defects=1
  if [ "$gates$defects" = 00 ]; then
    echo "cc-green: green on ${tree:0:12} — hand over now. Anything you edit from here is a tree nothing has passed on;"
    echo "  the landing plans and checks the change again on its own."
    return 0
  fi
  [ "$defects" = 0 ] || echo "cc-green: the diff carries a defect the review keeps stopping PRs for — fix it, or mark an added line of that file \`recurring-defect-ok: <class> — <why>\`."
  [ "$gates" = 0 ] || echo "cc-green: NOT green on ${tree:0:12}. \`cc-green start\` runs lander check on it, then \`cc-green wait\` for the verdict."
  return 1
}

selfcheck(){   # the cases are tests/selfcheck/cc-green.sh beside this bin/; sourcing it replaces this selfcheck()
  . "$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/tests/selfcheck/cc-green.sh" || return 1
  selfcheck "$@"; }

case "${1:-}" in
  "")        main ;;
  run|start) case "${2-}" in "") main "$1" ;; --) [ $# -gt 2 ] || { echo "$USAGE" >&2; exit 2; }; main "$1" "${@:3}" ;;
             *) echo "$USAGE" >&2; exit 2 ;; esac ;;
  __run)     [ -n "${CC_GREEN_RUNID:-}" ] || { echo "cc-green: __run is started by \`cc-green run\`, not by hand" >&2; exit 2; }
             main "$@" ;;
  wait)      case "${2:-540}" in *[!0-9]*|"") echo "$USAGE" >&2; exit 2;; esac; main wait "${2:-540}" ;;
  stop)      [ $# = 1 ] || { echo "$USAGE" >&2; exit 2; }; main stop ;;
  red)       shift; red "$@" ;;   # no checkout needed: the landing and the loop call this from wherever they are
  selfcheck) selfcheck ;;
  *)         echo "$USAGE" >&2; exit 2 ;;
esac
