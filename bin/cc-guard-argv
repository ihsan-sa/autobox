          'touch': {'-d', '--date', '-t', '-r', '--reference'}, 'truncate': {'-s', '--size', '-r', '--reference'}}

# ---------------------------------------------------------------------------------------------------------- lexer
class Word:
    __slots__ = ('v', 'raw', 'q', 'dyn', 'glob', 'brace', 'subs')
    def __init__(w, v='', dyn=False, glob=False):
        w.v, w.raw, w.q, w.dyn, w.glob, w.brace, w.subs = v, v, False, dyn, glob, False, []
    def like(w, v):   # a part of this word (of=X, --x=X) keeps what is known about it
        n = Word(v, w.dyn, w.glob); n.q = w.q; return n

def close(s, k, o='(', c=')'):   # index of the `c` closing an `o` already open before k
    d, n, cases = 1, len(s), []   # cases: the depth each open `case` sits at, where a pattern's bare `)` closes nothing
    while k < n:
        ch = s[k]
        if ch == '\\': k += 2; continue
        if o == '(' and (k == 0 or s[k - 1] in ' \t\n;&|(') and re.match(r'(case\s|esac(?=[\s;&|)]|$))', s[k:]):
            if s[k] == 'c': cases.append(d)
            elif cases: cases.pop()
            k += 4; continue
        if ch == c and cases and cases[-1] == d: k += 1; continue
        if ch == "'" and o == '(':
            j = s.find("'", k + 1)
            if j < 0: raise ParseError('quote')
            k = j + 1; continue
        if ch == '"':
            k += 1
            while k < n and s[k] != '"': k += 2 if s[k] == '\\' else 1
            if k >= n: raise ParseError('quote')
        elif ch == '`':
            k = tick(s, k + 1)
        elif ch == o: d += 1
        elif ch == c:
            d -= 1
            if d == 0: return k
        k += 1
    raise ParseError('unclosed ' + o)

def tick(s, k):
    while k < len(s):
        if s[k] == '\\': k += 2; continue
        if s[k] == '`': return k
        k += 1
    raise ParseError('backtick')

def dollar(s, i, w, buf, home, inq):
    nx = s[i + 1:i + 2]
    if s.startswith('$((', i):
        j = close(s, i + 2); buf.append(s[i:j + 1]); w.dyn = True; return j + 1
    if nx == '(':
        j = close(s, i + 2); w.subs.append(s[i + 2:j]); w.dyn = True; buf.append(s[i:j + 1]); return j + 1
    if nx == '{':
        j = close(s, i + 2, '{', '}'); inner = s[i + 2:j]
        if inner == 'HOME': buf.append(home)
        else:
            w.dyn = True; buf.append(s[i:j + 1]); w.subs += subs_in(inner)
        return j + 1
    if nx == "'" and not inq:
        j = i + 2
        while j < len(s) and s[j] != "'": j += 2 if s[j] == '\\' else 1
        if j >= len(s): raise ParseError('quote')
        try: buf.append(s[i + 2:j].encode('latin-1', 'backslashreplace').decode('unicode_escape'))
        except (UnicodeError, ValueError): buf.append(s[i + 2:j])
        w.q = True; return j + 1
    if nx == '"' and not inq: return i + 1
    m = re.match(r'[A-Za-z_]\w*', s[i + 1:])
    if m:
        if m.group() == 'HOME': buf.append(home)
        else: w.dyn = True; buf.append('$' + m.group())
        return i + 1 + m.end()
    if nx and nx in '@*#?$!-0123456789':
        w.dyn = True; buf.append(s[i:i + 2]); return i + 2
    buf.append('$'); return i + 1

def subs_in(t):   # $( ) and backticks in text where quotes mean nothing (an unquoted heredoc body)
    out, k = [], 0
    while k < len(t):
        if t[k] == '\\': k += 2; continue
        if t.startswith('$(', k) and not t.startswith('$((', k):
            j = close(t, k + 2); out.append(t[k + 2:j]); k = j + 1; continue
        if t[k] == '`':
            j = tick(t, k + 1); out.append(re.sub(r'\\([`\\$])', r'\1', t[k + 1:j])); k = j + 1; continue
        k += 1
    return out

META = set(' \t\n;&|()<>')

def word(s, i, home):
    w, buf, plain, st, n = Word(), [], [], i, len(s)
    while i < n:
        c = s[i]
        if c in META:
            if c in '<>' and s[i + 1:i + 2] == '(' and not buf:   # <(..) >(..): a process substitution
                j = close(s, i + 2); w.subs.append(s[i + 2:j]); w.dyn = True; buf.append('/dev/fd/63'); i = j + 1; continue
            if c == '(' and not w.q and ASSIGN.fullmatch(''.join(buf)):   # a=( x y ): data
                j = close(s, i + 1); buf.append(s[i:j + 1]); i = j + 1; continue
            break
        if c == '\\':
            if s[i + 1:i + 2] != '\n': buf.append(s[i + 1:i + 2]); w.q = True
            i += 2; continue
        if c == "'":
            j = s.find("'", i + 1)
            if j < 0: raise ParseError('quote')
            buf.append(s[i + 1:j]); w.q = True; i = j + 1; continue
        if c == '"':
            w.q = True; i += 1
            while True:
                if i >= n: raise ParseError('quote')
                d = s[i]
                if d == '"': i += 1; break
                if d == '\\':
                    if s[i + 1:i + 2] in ('$', '`', '"', '\\'): buf.append(s[i + 1])
                    elif s[i + 1:i + 2] != '\n': buf.append(s[i:i + 2])
                    i += 2
                elif d == '$': i = dollar(s, i, w, buf, home, True)
                elif d == '`':
                    j = tick(s, i + 1); w.subs.append(re.sub(r'\\([`\\$])', r'\1', s[i + 1:j])); w.dyn = True
                    buf.append(s[i:j + 1]); i = j + 1
                else: buf.append(d); i += 1
            continue
        if c == '$': i = dollar(s, i, w, buf, home, False); continue
        if c == '`':
            j = tick(s, i + 1); w.subs.append(re.sub(r'\\([`\\$])', r'\1', s[i + 1:j])); w.dyn = True
            buf.append(s[i:j + 1]); i = j + 1; continue
        if c == '~' and i == st and (i + 1 >= n or s[i + 1] == '/' or s[i + 1] in META):
            buf.append(home); i += 1; continue
        buf.append(c); plain.append(c); i += 1
    w.v, w.raw, p = ''.join(buf), s[st:i], ''.join(plain)
    w.glob = bool(re.search(r'[*?[]', p))
    w.brace = bool(re.search(r'\{[^{}]*(,|\.\.)[^{}]*\}', p))
    return w, i

OPS = ('<<<', '<<-', '&>>', ';;&', '&&', '||', '|&', ';;', ';&', '<<', '>>', '<>', '<&', '>&', '>|', '&>',
       ';', '&', '|', '(', ')', '<', '>')
REDIR = {'<', '>', '>>', '>|', '<>', '<&', '>&', '&>', '&>>', '<<', '<<-', '<<<'}

def lex(s, home):
    toks, pend, i, n, fd = [], [], 0, len(s), ''
    while i < n:
        c = s[i]
        if c in ' \t\r': i += 1; continue
        if c == '\\' and s[i + 1:i + 2] == '\n': i += 2; continue
        if c == '#':
            j = s.find('\n', i); i = n if j < 0 else j; continue
        if c == '\n':
            toks.append(('OP', '\n')); i += 1
            for r in pend: i = body(s, i, r)
            pend = []; continue
        op = None if (c in '<>' and s[i + 1:i + 2] == '(') else next((o for o in OPS if s.startswith(o, i)), None)
        if op is None:
            w, i = word(s, i, home)
            if re.fullmatch(r'\d+|\{\w+\}', w.raw) and s[i:i + 1] in ('<', '>'): fd = w.raw; continue   # an fd number
            toks.append(('W', w)); continue
        i += len(op)
        if op not in REDIR: toks.append(('OP', op)); continue
        while i < n and s[i] in ' \t': i += 1
        if i >= n or s[i] in '\n;&|)': raise ParseError('redirect without a target')
        w, i = word(s, i, home)
        r, fd = {'op': op, 'w': w, 'body': None, 'qd': w.q, 'fd': fd}, ''
        toks.append(('R', r))
        if op in ('<<', '<<-'): pend.append(r)
    for r in pend: r['body'] = r['body'] or ''
    return toks

def body(s, i, r):
    lines, n = [], len(s)
    while i < n:
        j = s.find('\n', i); line = s[i:] if j < 0 else s[i:j]; i = n if j < 0 else j + 1
        cmp = line.lstrip('\t') if r['op'] == '<<-' else line
        if cmp == r['w'].v: break
        lines.append(cmp)
    else: raise ParseError('a heredoc that never ends')   # bash runs to EOF on it; fail closed rather than guess
    r['body'] = '\n'.join(lines); return i

def bexp(s):   # bash brace expansion of one word: {a,b} only
    for i, c in enumerate(s):
        if c != '{': continue
        d, parts, st = 0, [], i + 1
        for j in range(i, len(s)):
            if s[j] == '{': d += 1
            elif s[j] == '}':
                d -= 1
                if d == 0: break
            elif s[j] == ',' and d == 1: parts.append(s[st:j]); st = j + 1
        else: return [s]
        if not parts: continue
        parts.append(s[st:j])
        return [x for p in parts for x in bexp(s[:i] + p + s[j + 1:])][:256]
    return [s]

def pos(ws, argopts=()):   # positional words, options (and the values of argopts) skipped
    out, k = [], 0
    while k < len(ws):
        x = ws[k].v
        if x == '--': return out + ws[k + 1:]
        if x.startswith('-') and len(x) > 1: k += 2 if x in argopts else 1; continue
        out.append(ws[k]); k += 1
    return out

def optval(ws, short, long):   # the value of -t X / --target-directory=X
    for k, w in enumerate(ws):
        if w.v == short or w.v == long:
            if k + 1 < len(ws): return ws[k + 1]
        elif w.v.startswith(long + '='): return w.like(w.v[len(long) + 1:])
    return None

# --------------------------------------------------------------------------------------------------------- parser
class Guard:
    def __init__(g, env):
        g.home = os.path.normpath(env.get('GUARD_HOME') or env.get('HOME') or '/nonexistent')
        g.role = env.get('GUARD_ROLE', '')
        g.base = os.path.normpath(env.get('GUARD_CWD') or os.getcwd())
        g.root = env.get('GUARD_ROOT', '')
        g.mws = env.get('GUARD_MWS', '') if g.role == 'member' else ''
        g.pseat = env.get('GUARD_PSEAT') == '1'
        g.pathdirs = [d for d in env.get('PATH', '').split(':') if d]
        g.env = env
        g.out, g.dirs, g._names, g.vars, g.vout = [], [], None, {}, {}
        g.headmove = g.cddyn = g.bypass = False
        g._mp = None
        g.written, g.alias = {}, {}   # files this command writes (path -> text), and its aliases
        g.vsrc = {}   # a variable set from a substitution: its source text, read as a computed verb's words
        nt = env.get('GUARD_NEVER_TOUCH') or os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', '..', 'config', 'never-touch.txt')
        g.nt = set()
        try:
            with open(nt) as f: g.nt |= {l.strip() for l in f if l.strip() and not l.lstrip().startswith('#')}
        except OSError: pass
        H = g.home
        g.secf = {H + '/.claude/.credentials.json', H + '/ccbox/env', H + '/.codex/auth.json', H + '/.config/cursor/auth.json'}
        g.secf |= {os.path.realpath(f) for f in g.secf}
        g.secd = [H + '/.cc/config', H + '/.ssh', H + '/.claude/settings.json', H + '/.cc/sandbox', H + '/.cc/members'] if g.role == 'member' else []
        g.inb = env.get('GUARD_INB') == '1'   # inside a member boundary, as cc-guard decides it ($inb): never from $mws
        if g.role == 'member' and not g.inb:   # the Slack copy and the owner's index: see secret_path in cc-guard
            g.secd += [H + '/.cc/slack', H + '/.cc/library/owner']
        g.own = H + '/.cc/members/' + g.mws if g.mws else ''   # member isolation: its own record is its own
        g.allow = [d for d in g.root.split(':') + [H + '/dev/' + g.mws if g.mws else ''] if d]
        g.allow += [os.path.realpath(d) for d in g.allow]
        g.fixed = [(H + '/bin', '~/bin'), (H + '/.cc/try', '~/.cc/try'), (H + '/.cc/lander', '~/.cc/lander'),
                   (H + '/.cc/state/land', '~/.cc/state/land'), (H + '/.cc/config', '~/.cc/config'),
                   (H + '/.claude/settings.json', '~/.claude/settings.json'), (H + '/.config/gh', "~/.config/gh (gh's config and aliases)")]
        if env.get('GH_CONFIG_DIR'): g.fixed.append((g.absp(env['GH_CONFIG_DIR'], g.base), "$GH_CONFIG_DIR (gh's config and aliases)"))
        g.secx = [H + '/.cc/secrets']   # every role: the box's tokens, and any credentials.json / *.token under ~ (SECBASE)
        names = ['.credentials.json', 'credentials.json', 'ccbox/env', '.codex/auth.json', 'cursor/auth.json', '.cc/secrets']   # as body text
        names += ['.cc/config', '.ssh', '.claude/settings.json', '.cc/sandbox'] if g.role == 'member' else []
        names += ['.cc/slack', '.cc/library/owner'] if g.role == 'member' and not g.inb else []
        g.secn = re.compile(r'(?<![\w.-])(' + '|'.join(map(re.escape, names)) + r')(?![\w.-])')
        seat = [d for d in glob.glob(H + '/.cc/state/*/perms') if os.path.isdir(d)]   # the seat's state as it stands now
        seat += [f for f in (H + '/.cc/state/handoff/perms.json', H + '/.cc/state/handoff/perms.brief') if os.path.exists(f)]
        g.above = [(d, "the permission seat's state") for d in seat]
        if g.role != 'pf': g.above += [(H + '/dev', '~/dev (the live checkouts)')] + g.fixed
        # a member's trees, by the host-side record only a host session sees (~/.cc/members is not inside the boundary)
        g.mtrees = []
        for d in sorted(glob.glob(H + '/.cc/members/*')):
            h = os.path.basename(d)
            if not HANDLE.fullmatch(h) or not os.path.isdir(d) or h == g.mws: continue
            for r in (H + '/dev/' + h, H + '/.cc/worktrees/' + h):
                g.mtrees += [(r, h)] + ([(os.path.realpath(r), h)] if os.path.realpath(r) != r else [])

    def ownchans(g):   # the box's channels and this worktree's repo's, each with its -threads and -updates lanes. The
        # repo is read off the worktree's path (~/.cc/worktrees/<repo>/<track>), never its .cc/track, which the worker
        # writes (perms' read of 9bf1d03b)
        names = {g.env.get('CC_BOX', '').lower()}
        m = re.search(r'/\.cc/worktrees/([^/:]+)/', g.root.split(':')[0] + '/')
        if m: names.add(m.group(1).lower())
        return {n + s for n in names if n for s in ('', '-threads', '-updates')}

    def absp(g, v, cwd):
        return os.path.normpath(v if v.startswith('/') else os.path.join(cwd, v))

    def deglob(g, pat):   # a globbed verb is every command name it can match
        if g._names is None:
            g._names = set(GATED)
            for d in g.pathdirs:
                try: g._names.update(os.listdir(d))
                except OSError: pass
        pat = pat.replace('[^', '[!')
        return sorted(n for n in g._names if fnmatch.fnmatch(n.lower(), pat.lower())) or [pat]   # nocaseglob too

    def vcands(g, raw):   # a computed verb word (`cc-try$@`, `$D/cc-la[n]d`, `{cc-land,}$x`, `cc-try${IFS}on`) -> [(name, args)]
        b = bexp(re.sub(r'[\'"\\]', '', raw))[0]   # bash runs the brace group's first word
        star, cut = EXPN.sub('*', b), [x for x in EXPN.split(b)]   # an expansion is anything, or a blank that splits the word
        out = []
        for pat, rest in ((star, []), (cut[0], [x for x in cut[1:] if x])):
            pat = pat.rsplit('/', 1)[-1]
            if pat.strip('*'): out += [(n, rest) for n in g.deglob(pat) if n in GATED]
        return out

    def script(g, text, cwd, nested, depth):
        if depth > 8: raise ParseError('nested too deep')
        start, toks, cmds, stack, k = len(g.out), lex(text, g.home), [], [], 0
        cwdl, cur = [cwd], {'words': [], 'redirs': [], 'pipe': None}
        def end(pipe=False):
            nonlocal cur
            idx = None
            if cur['words'] or cur['redirs']:
                g.finish(cur, cwdl, nested, depth, cmds); cmds.append(cur); idx = len(cmds) - 1
            cur = {'words': [], 'redirs': [], 'pipe': idx if pipe else None}
        while k < len(toks):
            t = toks[k]; k += 1; top = stack[-1] if stack else None
            if top and top[0] == 'casepat':   # case patterns are data up to their `)`
                if t[0] == 'W' and t[1].v == 'esac' and not t[1].q: stack.pop()
                elif t == ('OP', ')'): top[0] = 'casecmd'
                continue
            if t[0] == 'W':
                w = t[1]
                if not cur['words'] and not w.q and w.v == 'case' and k + 1 < len(toks) and toks[k][0] == 'W' \
                        and toks[k + 1][0] == 'W' and toks[k + 1][1].v == 'in':
                    for sub in toks[k][1].subs: g.script(sub, cwdl[0], '$()', depth + 1)
                    k += 2; stack.append(['casepat']); continue
                if not cur['words'] and not w.q and w.v == 'esac' and top and top[0] == 'casecmd':
                    stack.pop(); continue
                cur['words'].append(w)
            elif t[0] == 'R': cur['redirs'].append(t[1])
            elif t[1] in ('|', '|&'): end(True)
            elif t[1] == '(':
                if cur['words'] and k < len(toks) and toks[k] == ('OP', ')'):   # f() { ..; }: the name goes
                    k += 1; cur['words'] = []; continue
                end(); stack.append(['sub', cwdl[0]])
            elif t[1] == ')':
                end()
                if not (top and top[0] == 'sub'): raise ParseError('unbalanced )')
                cwdl[0] = top[1]; stack.pop()
            elif t[1] in (';;', ';&', ';;&'):
                end()
                if not (top and top[0] == 'casecmd'): raise ParseError('stray ;;')
                top[0] = 'casepat'
            else: end()
        end()
        if any(e[0] == 'sub' for e in stack): raise ParseError('unclosed (')
        return g.out[start:]

    def finish(g, cur, cwdl, nested, depth, cmds):
        for w in cur['words'] + [r['w'] for r in cur['redirs']]:
            for sub in w.subs: g.script(sub, cwdl[0], '$()', depth + 1)
        for r in cur['redirs']:
            if r['body'] and not r['qd']:
                for sub in subs_in(r['body']): g.script(sub, cwdl[0], '$()', depth + 1)
        ws = []
        for w in cur['words']:
            ws += [w.like(x) for x in bexp(w.v)] if w.brace else [w]
        i = 0
        while i < len(ws) and not ws[i].q and ws[i].v in KW: i += 2 if ws[i].v == 'function' else 1
        assigns = []
        while i < len(ws) and ASSIGN.match(ws[i].raw): assigns.append(ws[i].v); i += 1
        if i >= len(ws) and not assigns and not cur['redirs']: cur['rs'] = []; return
        if i >= len(ws):   # X=docker on its own: a later `$X` in this command is that word (literal values only)
            for w in ws[i - len(assigns):i]:
                k, _, val = w.v.partition('=')
                g.vars[k.rstrip('+')] = None if (w.dyn or w.glob or k.endswith('+')) else val
                if w.dyn: g.vsrc[k.rstrip('+')] = w.raw.partition('=')[2]   # `X=$(echo docker)`: the text it is built from
                if w.dyn and w.subs and re.fullmatch(r'"?\$\(.*\)"?', w.raw.partition('=')[2], re.S) and depth < 8:
                    try: sv = ' '.join(g.data(r) for sub in w.subs for r in g.script(sub, cwdl[0], '$()', depth + 1))
                    except ParseError: sv = ''
                    if sv.strip(): g.vout[k.rstrip('+')] = sv   # …and a later `$X` also runs what that substitution prints
        cur['rs'] = g.expand(ws[i:], cur['redirs'], cwdl[0], assigns, [], nested, depth, (cmds, cur))
        if cur['pipe'] is not None:   # the commands piped into this one (the kill fence asks whether a pgrep feeds it)
            src = [[S['verb'] or ''] + S['args'] for S in cmds[cur['pipe']].get('rs', [])]
            for R in cur['rs']: R['from'] = src
        for R in cur['rs']:
            if R['verb'] in ('cd', 'pushd', 'popd') and not R['via']: cwdl[0] = g.cd(R, cwdl[0])
            if R['verb'] in ('export', 'declare', 'typeset', 'readonly', 'local'):
                for w in R['argw']:
                    if ASSIGN.match(w.raw):
                        k, _, val = w.v.partition('=')
                        g.vars[k.rstrip('+')] = None if (w.dyn or w.glob or k.endswith('+')) else val

    def cd(g, R, cwd):
        if R['verb'] == 'popd': return g.dirs.pop() if g.dirs else g.base
        a = [w for w in R['argw'] if not w.v.startswith('-') or w.v == '-']
        if not a: tgt = g.home if R['verb'] == 'cd' else g.base
        elif a[0].dyn or a[0].v == '-': tgt = g.base; g.cddyn = True   # a cd this cannot resolve: judge against the session cwd
        else: tgt = g.absp(re.split(r'[*?[]', a[0].v)[0] if a[0].glob else a[0].v, cwd)
        if R['verb'] == 'pushd': g.dirs.append(cwd)
        return tgt

    def emit(g, verb, ws, redirs, cwd, assigns, via, nested, raw):
        R = {'verb': verb, 'argw': ws, 'args': [w.v for w in ws], 'redirs': redirs, 'cwd': cwd,
             'assigns': assigns, 'via': via, 'nested': nested, 'raw': raw}
        g.out.append(R); return R

    def expand(g, ws, redirs, cwd, assigns, via, nested, depth, ctx):
        raw = [w.raw for w in ws]
        if not ws: return [g.emit('', [], redirs, cwd, assigns, via, nested, raw)]
        w0 = ws[0]
        m = re.fullmatch(r'"?\$(\{)?([A-Za-z_]\w*)(?(1)\})"?', w0.raw)
        if w0.dyn and m and g.vars.get(m.group(2)) is not None and depth < 8:   # `X=docker; $X run`: the verb is docker
            val = g.vars[m.group(2)]
            nw = [Word(val)] if w0.raw.startswith('"') else [Word(x, glob=bool(re.search(r'[*?[]', x))) for x in val.split()]
            return g.expand(nw + ws[1:], redirs, cwd, assigns, via, nested, depth + 1, ctx) if nw else \
                [g.emit('', ws[1:], redirs, cwd, assigns, via, nested, raw)]
        if not w0.dyn and w0.v in g.alias and depth < 8:   # `alias d=docker; d run x`: the verb is docker
            return g.expand([Word(x) for x in shlex.split(g.alias.pop(w0.v))] + ws[1:], redirs, cwd, assigns, via, nested, depth + 1, ctx)
        if w0.dyn and w0.subs and not m and depth < 8:   # `… | $(echo bash)`: the verb is what the substitution prints
            try: val = ' '.join(g.data(r) for sub in w0.subs for r in g.script(sub, cwd, '$()', depth + 1)).split()
            except ParseError: val = []
            if val: return g.expand([Word(x) for x in val] + ws[1:], redirs, cwd, assigns, via, nested, depth + 1, ctx)
        if w0.dyn:
            out = [g.emit(None, ws[1:], redirs, cwd, assigns, via, nested, raw + [g.vsrc.get(m.group(2), '') if m else ''])]
            if m and g.vout.get(m.group(2)) and depth < 8:
                out += g.expand([Word(x) for x in g.vout[m.group(2)].split()] + ws[1:], redirs, cwd, assigns, via, nested, depth + 1, ctx)
            for n, rest in ([] if m else g.vcands(w0.raw)):
                out += g.expand([Word(n)] + [Word(x) for x in rest] + ws[1:], redirs, cwd, assigns, via, nested, depth + 1, ctx)
            return out
        b0 = w0.v.rsplit('/', 1)[-1]
        # a member's own file named like a wrapper (`~/dev/bob/nice make`) is that file, not the wrapper: unwrapping
        # would drop its path before memcode reads it
        mine = '/' in w0.v and g.mtrees and g.memtree(g.absp(w0.v, cwd))
        out = []
        for b in (g.deglob(b0) if w0.glob else [b0]):
            if b in WRAP and len(via) < 8 and not mine:
                if '/' in w0.v and g.mplaces() and g.inmem(w0, cwd):   # ~/dev/<member>/env runs the member's file, not env:
                    R = g.emit(b, ws[1:], redirs, cwd, assigns, via, nested, raw); R['vw'] = w0; out.append(R)   # memexec
                j, info = g.unwrap(b, ws)
                for t in info.get('script', []): out += g.script(t, cwd, b, depth + 1)
                c2 = g.absp(info['cd'].v, cwd) if 'cd' in info and not info['cd'].dyn else cwd
                cw = ws[j:] if j is not None else []
                if b in ('xargs', 'parallel'):   # its argv grows from stdin, a file it reads (-a, `< f`) or parallel's ::: words
                    o, af, items, sep = ws[1:j or len(ws)], [], [], ''
                    for k, w in enumerate(o):   # -a f, --arg-file f, -af, --arg-file=f
                        if w.v in ('-a', '--arg-file') and k + 1 < len(o): af.append(o[k + 1])
                        elif re.match(r'-a.|--arg-file=', w.v): af.append(w.like(w.v.split('=', 1)[1] if w.v[1] == '-' else w.v[2:]))
                    if b == 'parallel':
                        k = next((k for k, w in enumerate(cw) if w.v.startswith(':::')), len(cw))
                        for w in cw[k:]:   # ::: words are items, :::: words files of items
                            if w.v.startswith(':::'): sep = w.v
                            elif sep.startswith('::::'): af.append(w)
                            else: items.append(w.v)
                        cw = [] if [w.v for w in cw[:k]] == ['{}'] else cw[:k]   # a lone {} runs each item as the command
                    fed = g.feed(redirs, '0', cwd, depth) + [t for w in af for t in g.feed([{'op': '<', 'w': w, 'fd': ''}], '0', cwd, depth)] \
                        + (['\n'.join(items)] if items else [])
                if b in ('xargs', 'parallel') and (ctx[1]['pipe'] is not None or fed):
                    stdin = '\n'.join(fed + ([g.produced(ctx)] if ctx[1]['pipe'] is not None else []))
                    text = ' '.join("'" + w.v.replace("'", "'\\''") + "'" for w in cw) + ' ' + stdin \
                        if cw else stdin if b == 'parallel' or fed else ''   # bare parallel, or a bare xargs fed a heredoc or file (fails closed): each line is read as a command
                    try: out += g.script(text, c2, b, depth + 1)
                    except ParseError: pass
                    # …and as it splits items with -0, -d or -I, ONE item may be the whole input or one line of it, a word
                    # of its own (`… | xargs -0 sh -c`, `xargs -I{} sh -c {}`): the command is read with each
                    rep = xrepl(b, [w.v for w in ws[1:j]], [w.v for w in cw]) if cw else None
                    for it in (dict.fromkeys([stdin.strip('\n')] + stdin.split('\n')) if cw else ()):
                        if not it.strip(): continue
                        cmd = [w.v.replace(rep, it) for w in cw] if rep else [w.v for w in cw] + [it]
                        try: out += g.script(' '.join(shq(x) for x in cmd), c2, b, depth + 1)
                        except ParseError: pass
                if j is None or j >= len(ws): out.append(g.emit(b, ws[1:], redirs, cwd, assigns, via, nested, raw))
                else: out += g.expand(ws[j:], redirs, c2, assigns + info.get('assigns', []), via + [b], nested, depth, ctx)
                continue
            R = g.emit(b, ws[1:], redirs, cwd, assigns, via, nested, raw); R['vw'] = w0; out.append(R)
            R['w0'] = w0.v   # the command word as a path (memcode)
            out += g.inner(R, ws, depth, ctx)
        return out

    def unwrap(g, b, ws):   # -> (index of the wrapped command or None, {script, cd, assigns})
        a, j, info = [w.v for w in ws], 1, {}
        if b == 'command' and a[1:2] and a[1] in ('-v', '-V'): return None, info
        if b in ('watch', 'flock', 'env'):
            while j < len(a) and a[j].startswith('-') and a[j] != '-':
                x = a[j]
                if x in {'flock': ('-c', '--command'), 'env': ('-S', '--split-string')}.get(b, ()) and j + 1 < len(a):
                    info.setdefault('script', []).append(a[j + 1]); return None, info
                if b == 'env' and ((x.startswith('-S') and len(x) > 2) or x.startswith('--split-string=')):
                    info.setdefault('script', []).append(x[2:] if x.startswith('-S') else x[15:]); return None, info
                if x in ('-C', '--chdir') and j + 1 < len(a): info['cd'] = ws[j + 1]; j += 2; continue
                if x.startswith('--chdir='): info['cd'] = ws[j].like(x[8:])
                j += 2 if x in WRAP[b] | {'-u', '--unset'} else 1
            while b == 'env' and j < len(a) and ASSIGN.match(a[j]): info.setdefault('assigns', []).append(a[j]); j += 1
            if b == 'watch': info.setdefault('script', []).append(' '.join(a[j:])); return None, info
            if b == 'flock': j += 1   # the lock file
            return j, info
        while j < len(a) and a[j].startswith('-') and a[j] != '-':
            if a[j] == '--': j += 1; break
            j += 2 if a[j] in WRAP[b] or (b == 'xargs' and re.fullmatch(r'-[^adEILnPs-]+[adEILnPs]', a[j])) else 1   # `-0I {}`: a bundle ending in a letter that takes a value
        if b in ('taskset', 'chrt') and '-p' in a[1:j]: return None, info
        if b in ('timeout', 'chrt', 'taskset', 'chroot'): j += 1   # its duration, priority, mask or new root
        return j, info

    def produced(g, ctx):   # what the commands piped into this one print, read as words
        cmds, cur = ctx; texts, idx = [], cur['pipe']
        while idx is not None:
            for R in cmds[idx].get('rs', []): texts.append(g.data(R))
            idx = cmds[idx]['pipe']
        return '\n'.join(reversed(texts))

    def data(g, R):
        if INTERP.fullmatch(R['verb'] or ''): return '\n'.join(literals(progtext(R['verb'], R['args'], R['redirs'])))
        bodies = [r['body'] if r['op'] in ('<<', '<<-') else r['w'].v for r in R['redirs'] if r['op'] in ('<<', '<<-', '<<<')]
        if bodies: return '\n'.join(bodies)
        a = R['args']
        if R['verb'] in READERS:   # `sed -n p core/bin/cc-land | bash`: a shell fed a gated tool's own text runs that tool,
            ts = [g.written[g.absp(x, R['cwd'])] for x in a if g.absp(x, R['cwd']) in g.written] \
                + [os.path.basename(x) for x in a if not x.startswith('-') and os.path.basename(x) in TOOLS]   # and `cat f | bash` what this line wrote to f
            if ts: return '\n'.join(ts)
        if R['verb'] in ('echo', 'printf'):
            while a and re.fullmatch(r'-[neE]+', a[0]): a = a[1:]
            return ' '.join(a).replace('\\n', '\n')
        return ' '.join(a)

    def feed(g, redirs, fd, cwd, depth):   # the text on descriptor fd: a heredoc, here-string, <( ) or a file this line wrote
        out = []
        for r in redirs:
            if (r['fd'] or '0') != fd: continue
            if r['op'] in ('<<', '<<-', '<<<'): out.append(r['body'] if r['op'] != '<<<' else r['w'].v)
            elif r['op'] == '<' and r['w'].subs: out += ['\n'.join(g.data(x) for x in g.script(t, cwd, '<()', depth + 1)) for t in r['w'].subs]
            elif r['op'] == '<' and not r['w'].dyn and g.absp(r['w'].v, cwd) in g.written: out.append(g.written[g.absp(r['w'].v, cwd)])
        return out

    def fed(g, subs, cwd, via, depth):   # what a <( ) prints, read as the script a shell or `source` runs
        out = []
        for sub in subs:
            rs = g.script(sub, cwd, '<()', depth + 1)
            try: out += g.script('\n'.join(g.data(r) for r in rs), cwd, via, depth + 1)
            except ParseError: pass
        return out

    def bypath(g, b, a, cwd, depth):   # a[0] is the script file an interpreter or shell runs: one of TOOLS runs as that tool
        if b in SHELLS and g.absp(a[0], cwd) in g.written: return g.script(g.written[g.absp(a[0], cwd)], cwd, b + ' script', depth + 1)
        t = 'lander' if landcli(a[0], cwd) else os.path.basename(a[0])
        ts = [x for x in g.deglob(t) if x in TOOLS] if re.search(r'[*?[]', t) else [t]   # `python3 core/bin/cc-tr[y]`
        return [r for t in ts if t in TOOLS for r in g.script(' '.join(shlex.quote(x) for x in [t] + a[1:]), cwd, b + ' script', depth + 1)]

    def inner(g, R, ws, depth, ctx):   # what this command runs: sh -c, stdin to a shell, eval, find -exec, source <(..)
        b, a, cwd, out = R['verb'], R['args'], R['cwd'], []
        for r in R['redirs']:   # `echo 'docker run x' > f; bash f`: what a shell or source later runs from f is this text (`2>` is not)
            if r['op'] in ('>', '>>', '>|') and r['fd'] in ('', '1') and not r['w'].dyn: g.written[g.absp(r['w'].v, cwd)] = g.data(R)
        if b == 'tee' and ctx[1]['pipe'] is not None:   # `… | tee f; f 7`: f holds what was piped in
            for x in a:
                if not x.startswith('-'): g.written[g.absp(x, cwd)] = g.produced(ctx)
        p0 = ws[0].v if ws and '/' in ws[0].v else None   # running a file this line wrote runs what it wrote
        if p0 and g.absp(p0, cwd) in g.written:
            try: out += g.script(g.written[g.absp(p0, cwd)], cwd, 'script', depth + 1)
            except ParseError: pass
        if b in SHELLS:
            k, c, s, nx = 0, False, False, False
            while k < len(a) and a[k][:1] in ('-', '+') and a[k] not in ('-', '--'):
                if a[k] in ('-o', '+o') and a[k + 1:k + 2] == ['noexec']: nx = a[k] == '-o'
                if a[k] in ('-o', '+o', '-O', '+O', '--rcfile', '--init-file'): k += 2; continue
                if a[k][:1] == '-' and not a[k].startswith('--'): c, s, nx = c or 'c' in a[k], s or 's' in a[k], nx or 'n' in a[k]
                if a[k][:1] == '+' and 'n' in a[k]: nx = False   # `bash -n +n f`: a later +n turns the check off
                k += 1
            if a[k:k + 1] == ['--']: k += 1
            if c:   # `sh -n -c '…'` only parses the string
                if k < len(a) and not nx: out += g.script(a[k], cwd, b + ' -c', depth + 1)
                if k + 1 < len(ws) and ws[k + 1].subs and not nx: out += g.fed(ws[k + 1].subs, cwd, b + ' -c', depth)   # bash -c "$(…)"
            elif k < len(a) and not s and (not fdof(a[k]) or ws[k + 1].subs):   # `bash core/bin/cc-publish`: a script file that IS one of the gated tools runs as it
                if not nx: out += g.bypath(b, a[k:], cwd, depth)   # (`bash -n` only parses it)
                if not nx and ws[k + 1].subs: out += g.fed(ws[k + 1].subs, cwd, b + ' <()', depth)   # `sh <(…)`: what it prints is the script
            else:   # `bash < <(echo 'docker run ..')`, `bash /dev/fd/3 3<<<'…'`: what that descriptor holds is the script
                fd = fdof(a[k]) if k < len(a) and not s else '0'
                for t in g.feed(R['redirs'], fd, cwd, depth): out += g.script(t, cwd, 'stdin>' + b, depth + 1)
                if fd == '0' and ctx[1]['pipe'] is not None:
                    try: out += g.script(g.produced(ctx), cwd, 'pipe>' + b, depth + 1)
                    except ParseError: pass
        elif b == 'script':   # script -c CMD / -qc CMD / --command[=]CMD runs CMD in a shell
            for k, x in enumerate(a):
                t = a[k + 1] if (re.fullmatch(r'-[A-Za-z]*c', x) or x == '--command') and k + 1 < len(a) else \
                    x.split('=', 1)[1] if x.startswith('--command=') else None
                if t is not None: out += g.script(t, cwd, 'script -c', depth + 1)
        elif b == 'git':   # a `!` alias runs its text in a shell: -c alias.X=!CMD, or git config alias.X '!CMD'
            cmds = [c.split('=', 1)[1][1:] for c in gitcfg(ws[1:]) if re.match(r'alias\.[^=]*=!', c, re.I)]
            _, sub, rest = gitparse(ws[1:])
            if sub == 'config':
                rv = [w.v for w in rest]
                cmds += [rv[k + 1][1:] for k, x in enumerate(rv[:-1]) if re.match(r'alias\.', x, re.I) and rv[k + 1].startswith('!')]
            for t in cmds: out += g.script(t, cwd, 'git alias', depth + 1)
        elif INTERP.fullmatch(b or ''):   # the code's string literals as the commands it may run: each literal, and
            # …and `python3 core/bin/cc-try on …`: a script file that IS one of the gated tools runs as that tool
            k, code = 0, None   # options a letter at a time: -c/-e/-m/-r carry code (stop), -W/-X/-I a value (-Wignore, -W x)
            while k < len(a) and a[k].startswith('-') and a[k] != '-':
                if a[k] == '--': k += 1; break
                o = '' if a[k].startswith('--') else a[k][1:]
                j = next((j for j, ch in enumerate(o) if ch in 'cemrWXI'), None)
                if j is not None and o[j] in 'cemr': code = (o[j], o[j + 1:]); break
                k += 2 if j is not None and j + 1 == len(o) else 1
            if code is None and k < len(a): out += g.bypath(b, a[k:], cwd, depth)
            elif code and code[0] == 'm' and b.startswith(('python', 'pypy')):   # `python3 -m lander.cli queue …` is the lander
                mod, rest = (code[1], a[k + 1:]) if code[1] else (a[k + 1] if k + 1 < len(a) else '', a[k + 2:])
                if mod.split('.')[0] == 'lander': out += g.script(' '.join(shlex.quote(x) for x in ['lander'] + rest), cwd, b + ' -m', depth + 1)
            prog = progtext(b, a, [])   # a program on stdin is judged only where it runs something (writing docs that name
            fd = '0' if k >= len(a) else fdof(a[k])   # a command is data): system(, popen, subprocess, exec, spawn, backticks
            if code is None and fd: prog += [t for t in g.feed(R['redirs'], fd, cwd, depth)
                                             + ([g.produced(ctx)] if fd == '0' and ctx[1]['pipe'] is not None else []) if RUNS.search(t)]
            for t in literals(prog):
                n0 = len(g.out)
                try: out += g.script(t.strip().strip('|'), cwd, b + ' code', depth + 1)
                except ParseError: del g.out[n0:]
        elif b == 'ssh':   # what the far shell runs is kept on R['sshrem'] and judged by everyrole; what ssh runs HERE
            rem, k = [], 0  # (-o ProxyCommand / LocalCommand / KnownHostsCommand) is parsed as local commands
            while k < len(a) and a[k].startswith('-'):
                if a[k] == '--': k += 1; break
                opt = a[k + 1] if a[k] == '-o' and k + 1 < len(a) else a[k][2:] if a[k].startswith('-o') else ''
                m = re.match(r'\s*(\w+)\s*(?:=\s*|\s+)(.*)', opt, re.S)
                if m and m.group(1).lower() == 'remotecommand': rem.append(m.group(2))
                elif m and m.group(1).lower() in ('proxycommand', 'localcommand', 'knownhostscommand'):
                    out += g.script(m.group(2), cwd, 'ssh -o', depth + 1)
                k += 2 if a[k] in SSHOPT else 1
            if a[k + 1:]: rem.append(' '.join(a[k + 1:]))   # the words after the host, joined by blanks as ssh sends them
            # …and what it is fed: a heredoc, a here-string, a <( ), or a pipe (`echo 'sudo reboot' | ssh <host>`)
            rem += [r['body'] if r['op'] != '<<<' else r['w'].v for r in R['redirs'] if r['op'] in ('<<', '<<-', '<<<')]
            for r in R['redirs']:
                if r['op'] == '<' and r['w'].subs:
                    rem += ['\n'.join(g.data(x) for x in g.script(sub, cwd, '<()', depth + 1)) for sub in r['w'].subs]
            if ctx[1]['pipe'] is not None: rem.append(g.produced(ctx))
            R['sshrem'] = [t for t in rem if t.strip()]
        elif b == 'eval' and a:
            out += g.script(' '.join(a), cwd, 'eval', depth + 1)
        elif b == 'alias':
            for x in a:
                if '=' in x: g.alias[x.split('=', 1)[0]] = x.split('=', 1)[1]
        elif b == 'tmux':   # a command tmux runs in a shell (new-window CMD, run-shell CMD…), and keys send-keys types into a pane
            k = 0
            while k < len(a) and a[k].startswith('-'): k += 2 if a[k] in ('-L', '-S', '-f', '-c', '-T') else 1
            for part in ' '.join(shlex.quote(x) for x in a[k:]).split(' \\; '):
                ws2 = shlex.split(part)
                if not ws2 or not (ws2[0] in TMUXRUN or ws2[0] in ('send-keys', 'send')): continue
                j, p = 1, []
                while j < len(ws2):
                    if ws2[j].startswith('-') and ws2[j] != '-' and not p: j += 2 if ws2[j] in TMUXVAL else 1; continue
                    p.append(ws2[j]); j += 1
                if ws2[0] in ('send-keys', 'send'):
                    p = [' '.join(x for x in p if not re.fullmatch(r'Enter|KPEnter|[CMS]-.+|Space|Tab|Escape|BSpace|\^.', x))]
                for t in p:
                    try: out += g.script(t, cwd, 'tmux', depth + 1)
                    except ParseError: pass
        elif b == 'screen':   # screen CMD…, and screen -X stuff TEXT types TEXT into a window
            k = 0
            while k < len(a) and a[k].startswith('-') and a[k] != '-X':
                k += 2 if a[k] in ('-S', '-c', '-p', '-T', '-e', '-h', '-t', '-Logfile') else 1
            rest = a[k + 2:] if a[k:k + 2] == ['-X', 'stuff'] else [] if a[k:k + 1] == ['-X'] else a[k:]
            if rest: out += g.script(' '.join(rest) if a[k:k + 1] == ['-X'] else ' '.join(shq(x) for x in rest), cwd, 'screen', depth + 1)
        elif b in ('at', 'batch') or (b in ('source', '.') and a[:1] and fdof(a[0]) and not ws[1].subs):   # stdin (or that descriptor) is the script
            fd = fdof(a[0]) if b in ('source', '.') else '0'
            for t in g.feed(R['redirs'], fd, cwd, depth): out += g.script(t, cwd, 'stdin>' + b, depth + 1)
            if fd == '0' and ctx[1]['pipe'] is not None: out += g.script(g.produced(ctx), cwd, 'pipe>' + b, depth + 1)
        elif b in ('source', '.') and a and g.absp(a[0], cwd) in g.written:
            out += g.script(g.written[g.absp(a[0], cwd)], cwd, 'source', depth + 1)
        elif b in AWKS:   # awk's system(), a print piped to a command, or a command piped to getline runs the literal
            prog = progtext(b, a, R['redirs'])
            if any(RUNS.search(t) or '|' in t for t in prog):
                for t in literals(prog):
                    n0 = len(g.out)
                    try: out += g.script(t.strip().strip('|'), cwd, b + ' code', depth + 1)
                    except ParseError: del g.out[n0:]
        elif b in ('source', '.') and ws[1:2] and ws[1].subs:
            out += g.fed(ws[1].subs, cwd, 'source', depth)
        elif b == 'find':
            k = 1
            while k < len(ws):
                if ws[k].v in ('-exec', '-execdir', '-ok', '-okdir'):
                    j = k + 1
                    while j < len(ws) and ws[j].v not in (';', '+'): j += 1
                    out += g.expand(ws[k + 1:j], [], cwd, [], R['via'] + ['find -exec'], R['nested'], depth + 1, ctx)
                    k = j
                k += 1
        return out

    # ------------------------------------------------------------------------------------------------------ rules
    def prot(g, p, cut=False, pat=None):   # the protected place p lands in (cut: p is the literal prefix of glob pat), or None
        H = g.home
        for q in ({p, os.path.realpath(p)} if not cut else {p}):
            if BLOCKDEV.match(q): return 'a block device'
            inside = lambda d: q == d or q.startswith(d + '/')
            if inside(H + '/dev') and not any(inside(d) for d in g.allow): return '~/dev (the live checkouts)'
            for d, lab in g.fixed:
                if inside(d): return lab
            if not g.pseat and re.match(re.escape(H) + r'/\.cc/state/([^/]+/perms(/|$)|handoff/perms\.(json(\.tmp)?|brief)$)', q):
                return "the permission seat's state"
            if cut:   # the glob may reach a protected root from above
                # the seat's state first (the ungated tier reads no other label): refused when the glob, read a path
                # component at a time, can name a seat place as it stands now, a directory above one, or a path inside
                # one (`rm ~/.cc/state/s*` beside the seat passes)
                if not g.pseat and pat is not None:
                    pc = pat.rstrip('/').split('/')
                    for d, lab in g.above:
                        if lab != SEATLAB: continue
                        dc = d.split('/')
                        if all(fnmatch.fnmatchcase(x, y) for x, y in zip(dc, pc)): return SEATLAB
                for d in [H + '/dev/'] + [d for d, _ in g.fixed]:
                    if d.startswith(q): return d.replace(H, '~', 1)
        return None

    def wtargets(g, R):
        v, ws, out = R['verb'], R['argw'], []
        if v != '[[':
            for r in R['redirs']:
                if r['op'] in ('>', '>>', '>|', '&>', '&>>', '<>') or (r['op'] == '>&' and not re.fullmatch(r'\d*-?', r['w'].v)):
                    out.append(r['w'])
        a = R['args']
        if v in ('cp', 'install', 'ln', 'rsync', 'mv'):
            t = optval(ws, '-t', '--target-directory')
            p = pos(ws, {'-t', '--target-directory', '-S', '--suffix', '-m', '--mode', '-o', '--owner', '-g', '--group', '-e', '--rsh'})
            if v == 'mv': out += p + ([t] if t else [])
            elif t: out.append(t)
            elif len(p) >= 2 and not (v == 'rsync' and re.match(r'[^/]*:', p[-1].v)): out.append(p[-1])
            elif v == 'ln' and p: out.append(Word('.'))
            if v == 'rsync' and '--remove-source-files' in a: out += p[:-1]
        elif v in RMOPTS: out += pos(ws, RMOPTS[v])
        elif v in ('chmod', 'chown', 'chgrp'):
            p = pos(ws, {'--reference'}); out += p if any(x.startswith('--reference') for x in a) else p[1:]
        elif v == 'dd': out += [w.like(w.v[3:]) for w in ws if w.v.startswith('of=')]
        elif v in ('sed', 'perl') and any(re.match(r'-[A-Za-z]*i', x) or x.startswith('--in-place') for x in a):
            p, k, given = [], 0, False
            while k < len(ws):
                x = ws[k].v
                if re.fullmatch(r'-[A-Za-z]*[efE]', x) or x in ('--expression', '--file'): given = True; k += 2; continue
                if x.startswith(('--expression=', '--file=')): given = True
                elif not x.startswith('-'): p.append(ws[k])
                k += 1
            out += p if given else p[1:]
        elif v == 'curl': out += [t for t in [optval(ws, '-o', '--output')] if t]
        elif v == 'wget': out += [t for t in (optval(ws, '-O', '--output-document'), optval(ws, '-P', '--directory-prefix')) if t]
        elif v == 'find' and '-delete' in a:
            k = 0
            while k < len(ws) and not ws[k].v.startswith(('-', '(', '!')): k += 1
            out += ws[:k] or [Word('.')]
        elif v == 'git':
            dirs, sub, rest = gitparse(ws)
            if sub in GITW:
                base = Word('.')
                for d in dirs: base = d.like(os.path.join(base.v, d.v)) if not base.dyn else base
                if sub == 'clone':
                    p = pos(rest, {'-b', '--branch', '-o', '--origin', '--depth', '-c', '--config', '--reference'})
                    base = p[1] if len(p) > 1 else Word(os.path.join(base.v, re.sub(r'\.git$', '', p[0].v.rstrip('/').rsplit('/', 1)[-1]))) if p else base
                out.append(base)
        return out

    def dynpat(g, v):   # a computed word as the glob it could match: its text up to the first $ or `, then anything. The
        # path deny is matched on text, so `d=slack; cat ~/.cc/$d/x` named no denied path until this (perms' read of #937).
        # A leading variable this command set is its value, or what its substitution prints; one computed from text that
        # names a path may be anywhere.
        m = re.match(r'\$\{?(\w+)\}?', v)
        if m and m.group(1) in g.vars:
            k = m.group(1); val = g.vars[k]
            if val is None: val = g.vout.get(k, '').strip() or ('/*' if re.search(r'[~/]|HOME|\.cc', g.vsrc.get(k, '')) else '$')
            v = val + v[m.end():]
        if v == '~' or v.startswith('~/'): v = g.home + v[1:]
        return re.split(r'[$`]', v)[0] + '*'

    def is_secret(g, cand, glob, cwd):
        p = g.absp(cand, cwd)
        if g.own and any(q == g.own or q.startswith(g.own + '/') for q in (p, os.path.realpath(p))): return False
        if glob:
            cut = re.split(r'[*?[]', p)[0]
            return any(fnmatch.fnmatchcase(f, p) for f in g.secf) or any(cut.startswith(d) or d.startswith(cut) for d in g.secd + g.secx)
        for q in (p, os.path.realpath(p)):
            if q in g.secf or any(q == d or q.startswith(d + '/') for d in g.secd + g.secx): return True
            if q.startswith(g.home + '/') and SECBASE.fullmatch(os.path.basename(q)): return True
            if q.endswith('/ccbox/env') and (os.path.exists(q) or cand.rstrip('/') != 'ccbox/env'):
                return True   # the PAT file in any checkout (main's secret_all: */ccbox/env); a bare `ccbox/env` that
                # names no file here is a grep pattern, not a path
        return False

    def rmtargets(g, R):   # what this command removes or moves away whole (its parents matter, not only its insides)
        v, ws, a = R['verb'], R['argw'], R['args']
        if v in ('rm', 'rmdir'): return pos(ws)
        if v == 'mv':
            p = pos(ws, {'-t', '--target-directory', '-S', '--suffix'})
            return p if optval(ws, '-t', '--target-directory') else p[:-1]
        if v == 'rsync':
            p = [w for w in pos(ws, {'-e', '--rsh', '-f', '--filter', '--exclude', '--include', '-T', '--temp-dir'})
                 if not re.match(r'[^/]*:', w.v)]
            out = p[:-1] if '--remove-source-files' in a else []
            return out + (p[-1:] if len(p) >= 2 and any(x.startswith('--del') for x in a) else [])
        if v == 'find' and '-delete' in a:
            k = 0
            while k < len(ws) and not ws[k].v.startswith(('-', '(', '!')): k += 1
            return ws[:k] or [Word('.')]
        return []

    def marker(g, q, cut=False, whole=False):   # q is a member marker (.cc/member-facing, .cc/member-workspace), or
        # (whole: q is removed or moved away whole) a dir holding one; writing INTO a dir that holds one is not. cut: q
        # is a glob's literal prefix, and a glob's own `*` never names a dot file, so only a prefix that already spells
        # `.cc/`, `.cc/m…` or `.c…` can reach a marker.
        names = ('member-facing', 'member-workspace')
        holds = lambda d: any(os.path.lexists(os.path.join(d, '.cc', x)) for x in names)
        slash, q = q.endswith('/'), q.rstrip('/')
        d, b = os.path.split(q)
        if os.path.basename(d) == '.cc' and (b.startswith('member-') or (cut and not slash and 'member-'.startswith(b))): return True
        if b == '.cc' and (cut or whole) and holds(d): return True
        if cut: return not slash and b.startswith('.') and '.cc'.startswith(b) and holds(d)
        return whole and holds(q)

    def fence(g, R):   # the write fence, and a remove/move of a directory holding a protected place
        # A MEMBER MARKER IS WRITTEN BY NO SESSION. .cc/member-facing and .cc/member-workspace decide a session's role
        # and its workspace, and they sit in the session's own tree, so a member-facing session or a worker that could
        # make, move or remove one would choose its own fence (perms, #937: "Refuse writes to .cc/member-* from
        # sessions"). The host's provisioning tools write them; a session's command never does.
        if g.role in ('member', 'worker'):
            rms = g.rmtargets(R)
            for w in g.wtargets(R) + rms:
                if w.dyn: continue
                if w in rms and os.path.basename(w.v.rstrip('/')) == '.cc': hit = True   # a whole .cc moved or removed away
                elif w.glob:
                    cut = re.split(r'[*?[]', w.v)[0]
                    hit = g.marker(cut if cut.startswith('/') else os.path.join(R['cwd'], cut), cut=True)
                else:
                    a, whole = g.absp(w.v, R['cwd']), w in rms
                    hit = g.marker(a, whole=whole) or g.marker(os.path.realpath(a), whole=whole)
                if hit: return 'never', f'writing, moving or removing a member marker ({w.v}): .cc/member-facing and .cc/member-workspace are the host\'s to write'
            # …nor cc-lib's caller records: cc-guard writes ~/.cc/library/owner/callers/<pid> for the session's claude
            # (ccrec), and a session that wrote one would choose whether cc-lib shows it the owner's Slack copy.
            cr = g.home + '/.cc/library/owner/callers'
            for w in g.wtargets(R):
                if w.dyn: continue
                if w.glob:
                    cut = re.split(r'[*?[]', w.v)[0]
                    cut = cut if cut.startswith('/') else os.path.join(R['cwd'], cut)
                    hit = cut.startswith(cr) or cr.startswith(cut)
                else:
                    a = g.absp(w.v, R['cwd'])
                    hit = any(x == cr or x.startswith(cr + '/') for x in (a, os.path.realpath(a)))
                if hit: return 'never', f'writing cc-lib\'s caller records ({w.v}): cc-guard writes them, and they decide who sees the Slack copy'
        for w in g.wtargets(R):
            if w.dyn and g.role == 'member': w = Word(g.dynpat(w.v), glob=True)
            if w.dyn and not w.v.startswith(g.home): continue
            if w.glob:
                cut = re.split(r'[*?[]', w.v)[0]
                lab = g.prot(cut if cut.startswith('/') else os.path.join(R['cwd'], cut), cut=True,
                             pat=w.v if w.v.startswith('/') else os.path.join(R['cwd'], w.v))
            else: lab = g.prot(g.absp(w.v, R['cwd']))
            if g.role == 'pf' and lab != SEATLAB: continue
            if lab == 'a block device': return 'never', 'writing onto a block device (partitioning by another name)'
            if lab == SEATLAB: return 'never', SEATWHY
            if lab: return 'never', f'writing into {lab}: the live tree and the gates are written by the lander alone'
        if g.pseat: return None
        for w in g.rmtargets(R):
            if w.dyn or w.glob: continue   # a glob's cut prefix is judged by prot above
            for q in {g.absp(w.v, R['cwd']), os.path.realpath(g.absp(w.v, R['cwd']))}:
                for d, lab in g.above:
                    if d.startswith(q.rstrip('/') + '/'):
                        return 'never', f'removing or moving {w.v} takes {lab} with it' + (f' ({SEATWHY})' if lab == SEATLAB else
                                        ': the live tree and the gates are written by the lander alone')
        return None

    # NAMING THE WORKERS' LOGIN IS NOT READING IT (perms, 2026-10-14). `cc-config set WORKER_CLAUDE_CREDENTIALS
    # ~/.claude-workers/.credentials.json` stores the path and never opens the file, so that one word, in that one
    # command, is not a read: the key and the path exactly (~, $HOME or ${HOME}), cc-config by its bare name, no
    # substitution, glob or brace anywhere, and nothing else on the line (no second command, function, VAR= or
    # wrapper). A cc-notify --approval --run text is that command when it parses to it and nothing else (no second
    # command, no redirection). Every other word, the `<` sources and any chained cat/jq of the file are judged as
    # before. The ungated tier only (the planning seat holds the cc-config grant); a worker or a member is refused as
    # before.
    def namesonly(g, R):   # the argv words of R that name the workers' login without reading it
        ws, v = R['argw'], R['verb']
        if g.role != 'pf' or len(g.out) != 1 or R['assigns'] or R['via']: return []   # the line's one command, as typed
        if v == 'cc-config' and 'cc-config' in R['raw'] and len(ws) == 3 and [w.v for w in ws[:2]] == ['set', WLOGIN[0]] \
                and not any(w.dyn or w.glob or w.brace or w.subs for w in ws) and ws[2].v == g.home + WLOGIN[1]:
            return [ws[2]]
        if v == 'cc-notify' and '--approval' in R['args']:
            return [w for k, w in enumerate(ws) if k and ws[k - 1].v == '--run' and not w.dyn and g.namesonlytext(w.v)]
        return []

    def namesonlytext(g, t):   # a --run text that is exactly the one cc-config set above
        s2 = Guard(dict(g.env, GUARD_ROLE=g.role))
        try: s2.script(t, g.base, 'run', 1)
        except ParseError: return False
        return bool(s2.out) and s2.out[0]['verb'] == 'cc-config' and not s2.out[0]['redirs'] and bool(s2.namesonly(s2.out[0]))

    def secread(g, R, mem=False):   # a read of the box's credentials: an argv word, a `<` source, or an interpreter's program text
        v = R['verb']
        if v not in ('echo', 'printf'):
            named = g.namesonly(R)
            for w in R['argw'] + [r['w'] for r in R['redirs'] if r['op'] in ('<', '<>')]:
                if any(w is x for x in named): continue
                dyn = w.dyn and g.role == 'member'   # a member's computed word is judged as the glob it could be
                if w.dyn and not dyn and not w.v.startswith(g.home): continue
                cands = {w.v} | ({w.v.split('=', 1)[1]} if '=' in w.v else set()) | ({w.v.split('@', 1)[1]} if '@' in w.v else set())
                if dyn: cands = {g.dynpat(c) for c in cands if c}
                if any(c and '\n' not in c and g.is_secret(c, w.glob or dyn, R['cwd']) for c in cands):
                    return 'never', "reading the box's credentials" + (" or secrets (~/.cc/config, ~/.ssh, ~/.claude/settings.json, ~/.cc/sandbox)" if mem else '')
        for t in progtext(v or '', R['args'], R['redirs']):
            m = g.secn.search(t)
            if m: return 'never', f"reading the box's credentials ({m.group(1)}) from inside a {v} program"
        return None

    def everyrole(g, R):   # the hard limits no role is without, the ungated tier included
        v, a = R['verb'], R['args']
        while v in ROOTV and v != 'su':   # `sudo -n reboot`: the verb that runs as root is the one after the options
            k = 0
            while k < len(a) and a[k].startswith('-'): k += 2 if a[k] in ROOTOPT else 1
            v, a = (a[k], a[k + 1:]) if k < len(a) else (None, [])
            if v is not None and v != 'su':   # what sudo runs is judged as a command of its own: `sudo /sbin/reboot`,
                # `sudo env reboot` (the way su -c is; perms' read of 600963af)
                h = judge(' '.join(shq(x) for x in [v] + a), dict(g.env, GUARD_ROLE=g.role))
                if h and h[0] == 'never': return h   # a lesser refusal waits: running as root is never, below
                v = v.rsplit('/', 1)[-1]
        if v == 'su' and '-c' in a[:-1]: return judge(a[a.index('-c') + 1], dict(g.env, GUARD_ROLE=g.role))
        if power(v, a):
            return 'never', f'rebooting, halting, suspending or switching the target of the box ({v}): a hard limit for every role'
        if R['verb'] is None and any(f in POWERV for t in [re.sub(r'[\\\'"]', '', x) for x in R['raw']] + a
                                     for f in re.findall(r'[A-Za-z0-9_.+-]+', t)):
            return 'never', 'a command word this cannot read (a $ or a substitution) next to a reboot or shutdown; spell the command out'
        for t in R.get('sshrem', []):   # SSH CARRIES THE HARD LIMITS WITH IT, to any host: its remote command, its
            h = judge(t, dict(g.env, GUARD_ROLE=g.role))   # -o RemoteCommand and what it is fed are judged for this role
            if h: return 'never', f'an ssh carrying a hard limit (on any host the same limit as typing it here): {h[1]}'
            if g.role != 'pf':   # …and for a gated role any root, power, firewall, disk, container, unit or network verb at
                s2 = Guard(dict(g.env, GUARD_ROLE=g.role)); s2.script(t, g.base, 'ssh', 1)   # all (perms' read of 1ed108ee)
                bad = sorted({R2['verb'] for R2 in s2.out if R2['verb'] in SSHHARD or (R2['verb'] or '').startswith('mkfs')})
                if bad: return 'never', f'an ssh carrying `{bad[0]}`: a root, power, firewall, disk, container, unit or network verb on any host'
        if (v == 'cc-slack' and a[:2] == ['member', 'add']) or (v == 'cc' and a[:3] == ['slack', 'member', 'add']):
            return 'never', "widening who reaches the box (cc-slack member add) is the owner's to do"
        return g.memcode(R)

    def memtree(g, p):   # (handle, track) of the member tree path p lands in, or None
        for q in {p, os.path.realpath(p)}:
            for r, h in g.mtrees:
                if q == r or q.startswith(r + '/'):
                    rest = q[len(r) + 1:].split('/')[0] if '/.cc/worktrees/' in r else ''
                    return h, rest
        return None

    def mplaces(g):   # every member's workspace (~/dev/<h> holding .cc/member-workspace, cc-sandbox's own test) and worktrees
        if g._mp is None:
            g._mp = []
            for m in glob.glob(g.home + '/dev/*/.cc/member-workspace'):
                d = m[:-len('/.cc/member-workspace')]
                for p in (d, g.home + '/.cc/worktrees/' + os.path.basename(d)):
                    g._mp += [p, os.path.realpath(p)]
        return g._mp

    def inmem(g, w, cwd):
        if w.dyn or '\n' in w.v: return False
        p = re.split(r'[*?[]', w.v)[0] if w.glob else w.v
        if not p: return False
        q = g.absp(p, cwd)
        return any(x == d or x.startswith(d + '/') for x in {q, os.path.realpath(q)} for d in g.mplaces())

    def memexec(g, R):   # A HOST SESSION RUNNING A MEMBER'S CODE runs it as the owner, beside ~/.ssh and the box's tokens: a
        # file under a member workspace or worktree, an interpreter or shell given one, or a build/test runner pointed
        # there. Only `cc-sandbox member <h> -- …` runs it (raised-member-gate-reruns-ran-unsandboxed)
        if g.role not in ('pf', 'worker') or not g.mplaces(): return None
        v, aw, cwd, w0 = R['verb'] or '', R['argw'], R['cwd'], R.get('vw')
        why = "running a member's code outside its sandbox ({}): run it as `cc-sandbox member <handle> [<track>] -- …`"
        if w0 is not None and '/' in w0.v and g.inmem(w0, cwd): return 'never', why.format(w0.v)
        here = g.inmem(Word(cwd), cwd)
        def pointed(ws, what):   # a runner's path arguments (and NAME=path values) naming a member's files
            for x in ws:
                for c in [x] + ([x.like(x.v.split('=', 1)[1])] if '=' in x.v else []):
                    if '/' in c.v and g.inmem(c, cwd): return 'never', why.format(f'{what} {x.v}')
        if v in SHELLS or v in ('source', '.') or INTERP.fullmatch(v):
            # each interpreter's options by its own semantics (bash -E and python3 -O take no value, perl -E is code)
            fam = 'sh' if v in SHELLS or v in ('source', '.') else re.match(r'[a-z]+', v).group(0)
            fam = {'pypy': 'python', 'nodejs': 'node'}.get(fam, fam)
            code, val = MEMOPTS.get(fam, MEMOPTS['node'])
            k, stdin = 0, False
            while k < len(aw) and aw[k].v.startswith(('-', '+')) and aw[k].v not in ('-', '+'):
                x = aw[k].v
                if x == '--': k += 1; break
                if fam == 'python' and (x == '-m' or (re.fullmatch(r'-[A-Za-z]+', x) and x.endswith('m'))):
                    if here: return 'never', why.format(f'{v} -m in {cwd}')   # the module is found from the cwd
                    return pointed(aw[k + 1:], f'{v} -m')
                if x in code or (fam in ('sh', 'python') and re.fullmatch(r'-[A-Za-z]+', x) and x.endswith('c')):
                    return None   # its code is a literal (judged as a script on its own)
                if fam == 'sh' and re.fullmatch(r'-[A-Za-z]*s[A-Za-z]*', x): stdin = True
                k += 2 if x in val else 1
            if fam in ('deno', 'bun') and k < len(aw) and aw[k].v in ('run', 'test', 'x'): k += 1
            if k < len(aw) and aw[k].v != '-' and g.inmem(aw[k], cwd): return 'never', why.format(f'{v} {aw[k].v}')
            if (stdin or k >= len(aw) or aw[k].v == '-') and v not in ('source', '.') \
                    and any(r['op'] == '<' and g.inmem(r['w'], cwd) for r in R['redirs']):   # it runs what stdin holds
                return 'never', why.format(f'{v} < a member file')
        if v in RUNNERS:
            if here: return 'never', why.format(f'{v} in {cwd}')
            return pointed(aw, v)
        return None
    def memcode(g, R):   # code from a member's tree, run on the host outside cc-sandbox member
        # Why (from the brief): member-written code ran on the host as the box's own user, with full host access, more than once, and no seat noticed.
        # So a hit refuses (never), at every tier; no tree recorded under ~/.cc/members means nothing to judge.
        if not g.mtrees: return None
        v, a, cwd, hit, what = R['verb'] or '', R['args'], R['cwd'], None, ''
        w0 = R.get('w0', '')
        if '/' in w0: hit, what = g.memtree(g.absp(w0, cwd)), w0
        if not hit and (v in SHELLS or v in ('source', '.') or INTERP.fullmatch(v)):
            k = 0
            while k < len(a) and a[k].startswith(('-', '+')) and a[k] not in ('-', '--') and v not in ('source', '.'):
                if meminline(v, a[k]): k = len(a); break
                k += 2 if a[k] in MEMOPT else 1
            if a[k:k + 1] == ['--']: k += 1
            if k < len(a) and a[k] != '-': hit, what = g.memtree(g.absp(a[k], cwd)), f'{v} {a[k]}'
        if not hit and v in ('make', 'gmake'):
            # -C is cumulative and runs first, so a relative makefile or include directory is read from where it lands;
            # each is judged from the start cwd too. MAKEFILES (makefiles read first) and MAKEFLAGS' -I count as well
            mf = [x.split('=', 1)[1] for x in R['assigns'] if x.startswith('MAKEFLAGS=')]
            mf = [w if w.startswith('-') or j else '-' + w for f in mf for j, w in enumerate(f.split())]
            opts = makepaths(a) + [o for o in makepaths(mf) if o[0] == 'I']
            opts += [('f', w, f'MAKEFILES={w}') for x in R['assigns'] if x.startswith('MAKEFILES=') for w in x[10:].split()]
            d = cwd
            for kind, val, typed in opts:
                if kind == 'C': d = g.absp(val, d)
            for kind, val, typed in opts:
                for q in ([d] if kind == 'C' else [g.absp(val, d), g.absp(val, cwd)]):
                    hit, what = g.memtree(q), f'{v} {typed}'
                    if hit: break
                if hit: break
        if not hit and (v in MEMCWD or INTERP.fullmatch(v)): hit, what = g.memtree(cwd), f'{v} in {cwd}'
        if not hit: return None
        h, tr = hit
        return 'never', (f"running a member's code on the host ({what}, in {h}'s tree): it would run as the box's own user "
                         f"with the whole host in reach. Run it inside the member's boundary: cc-sandbox member {h} "
                         f"{tr or '<track>'} -- <cmd>. Reading the files (cat, grep, git log) stays yours")

    def rules(g, R):
        v, a, mem = R['verb'], R['args'], g.role == 'member'
        h = g.everyrole(R) or g.memexec(R)
        if h: return h
        if g.role == 'pf':   # THE UNGATED TIER: the seat's state, the hard limits above (ssh carrying them too), the credentials
            return g.fence(R) or g.secread(R)
        n = [x for x in a if not x.startswith('-')]
        first = n[0] if n else ''
        if v is None:
            # quotes and backslashes come off first: `$X re''boot` runs reboot, so it is matched as reboot
            text = [re.sub(r'[\\\'"]', '', raw) for raw in R['raw']] + a
            bad = sorted(f for t in text for f in re.findall(r'[A-Za-z0-9_.+-]+', t)
                         if f in HARD or f.startswith('mkfs') or (mem and f in ('cc-config', 'cc-loop')))   # a member's whatever the args
            if bad: return 'never', f'a command word this cannot read (a $ or a substitution) next to `{bad[0]}`; spell the command out'
            # …and the hard limits keyed on a verb's ARGUMENTS (`$(echo git) push -f origin main`): the arguments are
            # judged as each such verb's, and the first refusal stands
            for cand in CANDV:
                if cand == 'ip' and first not in IPOBJ: continue   # ip refuses any non-read; only its own objects say ip
                if cand == 'gh' and first not in GHCMD: continue   # …and gh its own commands
                if cand == 'lander-self' and first not in ('land', 'promote', 'rollback', 'pin'): continue   # …and its own verbs
                if cand == 'cc' and not (CCWORDS & set(a) or any(x.startswith('--go=') for x in a)): continue   # …and cc any other repo
                r = g.rules(dict(R, verb=cand))
                if r: return r[0], f'a command word this cannot read (a $ or a substitution) whose arguments, run by {cand}, are refused: {r[1]}'
        if v in ROOTV: return 'never', f'running as root ({v}): reboot, firewall, partitions and the network sit behind it'
        if power(v, a): return 'never', f'rebooting, halting, suspending or switching the target of the box ({v})'
        if v in ('systemctl', 'service') and UNITSTOP & set(a):
            u = next((x for x in a if NETUNIT.fullmatch(x)), None)
            if u: return 'never', f'stopping a network unit ({v} {u}): the links and the hotspot are never-touch'
        if v in NET and any(e.lower() in x.lower() for x in a for e in g.nt):
            return 'never', f'touching a never-touch network entry ({v})'
        if v in FW and not fwread(v, a, n): return 'never', f'changing the firewall ({v})'
        if (v in PART or (v or '').startswith('mkfs')) and not partread(v, a, n):
            return 'never', f'partitioning or formatting a disk ({v})'
        if v in NET and netwrite(v, a, n): return 'never', f'changing the network ({v}): the links and the hotspot are never-touch'
        if v in CONT: return 'never', f'running a container ({v}): the socket is root-equivalent'
        cmdv = [x.split('=', 1) for x in R['assigns']] + [kv for kv in g.vars.items()]
        cmdv = [val for k, val in cmdv if CMDVAR.fullmatch(k)]
        if v == 'git': cmdv += [c.split('=', 1)[1] for c in gitcfg(R['argw']) if '=' in c and CMDCFG.fullmatch(c.split('=', 1)[0])]
        for o in RUNOPT.get(v, ()):   # `sort --compress-program=CMD`, `rg --pre CMD`: the tool runs CMD
            cmdv += [x.split('=', 1)[1] for x in a if x.startswith(o + '=')] + [a[k + 1] for k, x in enumerate(a[:-1]) if x == o]
        for val in cmdv:   # a pager, editor or ssh command a tool will run: judged as the command it is
            h = judge(val, dict(g.env, GUARD_ROLE=g.role))
            if h: return h
            w0 = (val.split() or [''])[0].rsplit('/', 1)[-1]
            if w0 in SHELLS or INTERP.fullmatch(w0): return 'never', f'a pager, editor or ssh command that is a shell ({w0}): it runs whatever it is fed'
        if v == 'systemctl' and any(x in ('-H', '--host', '-M', '--machine') or x.startswith(('--host=', '--machine=', '-H', '-M')) for x in a):
            return 'never', 'systemctl on another host or machine (-H / -M)'
        if v == 'rm' and any(re.fullmatch(r'-[a-zA-Z]*[rR][a-zA-Z]*|--recursive', x) for x in a):
            for w in pos(R['argw']):
                q = os.path.normpath(g.absp(re.split(r'[*?[]', w.v)[0] if w.glob else w.v, R['cwd']))
                inside = any(q.startswith(d.rstrip('/') + '/') and not (w.glob and q == d.rstrip('/')) for d in g.allow)
                free = any(q.startswith(d + '/') for d in ((g.home + '/.cc/state', g.home + '/.cc/tmp', g.home + '/.cache') if (q + '/').startswith(g.home + '/')
                                                           else ('/tmp', '/var/tmp')))
                if w.dyn or not (inside or free):
                    return 'never', f'recursive delete outside the worktree ({w.v})'
        h = g.secread(R, mem)
        if h: return h
        if v == 'git':
            dirs, sub, rest = gitparse(R['argw'])
            if sub == 'push':
                rv = [w.v for w in rest]
                if '--mirror' in rv: return 'deny', 'git push --mirror rewrites every ref on the remote, the default branch included'
                if {'--all', '--branches'} & set(rv): return 'deny', 'git push --all pushes every branch, the default branch included'
                if any(re.match(r'(remote\.[^=]*\.(push|mirror)|push\.default)=', c, re.I) for c in gitcfg(R['argw'])) \
                        or any(x.startswith('GIT_CONFIG_') for x in R['assigns']):
                    return 'deny', 'a git push whose -c config picks the refspec (it can name the default branch)'
                pw = pos(rest, {'-o', '--push-option', '--repo', '--receive-pack', '--exec'})
                p = [w.v for w in pw][1:]
                gd = [w for k, w in enumerate(R['argw'][1:], 1) if R['argw'][k - 1].v == '--git-dir'] + \
                     [w.like(w.v[10:]) for w in R['argw'] if w.v.startswith('--git-dir=')]
                genv = [x.split('=', 1)[1] for x in R['assigns'] if x.startswith(('GIT_DIR=', 'GIT_WORK_TREE='))] + \
                       [g.vars[k] for k in ('GIT_DIR', 'GIT_WORK_TREE') if k in g.vars]
                # the branch a push reaches is read off the checkout BEFORE the command runs, so a push in a command
                # that also moves HEAD, or whose destination, -C, --git-dir, GIT_DIR or cd is computed, is refused
                # (perms' read of 600963af: `git switch -C main; git push -f origin HEAD`, `git push origin HEAD:$(echo main)`)
                if g.headmove: return 'deny', 'a git push in a command that also moves HEAD (checkout, switch, symbolic-ref, branch -m): push in a command of its own'
                if any(w.dyn for w in pw + dirs + gd) or g.cddyn or any(x is None or '$' in x or '`' in x for x in genv):
                    return 'deny', 'a git push whose destination, -C, --git-dir, GIT_DIR or directory is computed: spell it out'
                gdir = (g.absp(gd[0].v, R['cwd']) if gd else g.absp(genv[0], R['cwd']) if genv else None)
                cur = lambda: (gitbranch(gdir) if gdir else
                               curbranch(g.absp(dirs[-1].v, R['cwd']) if dirs else R['cwd']))
                if not p and cur() in ('main', 'master'):   # no refspec: the current branch goes (push.default)
                    return 'deny', 'pushing from the default branch (main/master)'
                for rs in p:
                    src, _, dst = rs.lstrip('+').rpartition(':') if ':' in rs else ('', '', rs.lstrip('+'))
                    if ':' not in rs and dst in ('HEAD', '@'): dst = cur()   # `git push origin HEAD`: the current branch's name
                    dst = re.sub(r'^refs/heads/', '', dst or '')
                    if dst in ('main', 'master') or '*' in dst:   # None = no checkout here: git itself refuses that push
                        return 'deny', 'pushing to the default branch (main/master), or to a glob that matches it'
                # a worker rewrites or deletes only its own track branch: `--force … publish:refs/heads/publish` from a
                # copy in /tmp is a force push all the same (perms' replay set, row "force push or deleting refspec")
                force = any(x in ('-f', '--force', '-d', '--delete') or x.startswith(('--force-', '--force=')) or
                            re.fullmatch(r'-[a-zA-Z]*[fd][a-zA-Z]*', x) for x in rv if x.startswith('-')) or any(x.startswith(('+', ':')) for x in p)
                if g.role == 'member' and force: return 'deny', 'a force push or branch delete'
                if g.role == 'worker' and any(x in ('-f', '--force') or x.startswith(('--force-', '--force='))
                                              or re.fullmatch(r'-[a-zA-Z]*f[a-zA-Z]*', x) for x in rv):
                    return 'deny', 'a force push by flag (-f, --force, --force-with-lease), on any branch'
                if g.role == 'worker' and force:
                    dsts = [re.sub(r'^refs/heads/', '', rs.lstrip('+').rpartition(':')[2] if ':' in rs else rs.lstrip('+')) for rs in p]
                    dsts = [cur() if d in ('HEAD', '@') else d for d in dsts] if p else [cur()]
                    if any(not (d or '').startswith('track/') for d in dsts):
                        return 'deny', "a force push or branch delete off this track's own branch (track/…)"
            if sub == 'config' and any(re.fullmatch(r'remote\..*\.(push|mirror)|push\.default', w.v, re.I) for w in rest):
                return 'deny', 'setting the refspec a later git push sends (remote.*.push / mirror, push.default)'
        if v == 'gh':
            gw = pos(R['argw'], {'-R', '--repo'}); gn = [w.v for w in gw]
            # `gh pr $M 1`: which command gh runs is not known, so it is not read as any (gh api refuses its own computed words below)
            if any(w.dyn or w.glob for w in gw[:1 if gn[:1] == ['api'] else 2]):
                return 'deny', 'a gh command or subcommand word this cannot read (a $, a substitution or a glob); spell it out'
            if gn[:2] == ['config', 'set']:   # an alias set in gh's config runs what it was set to, like gh alias set
                key = pos(R['argw'][R['argw'].index(gw[1]) + 1:], {'-h', '--host'})[:1]
                if key and (key[0].dyn or re.match(r'aliases(\.|$)', key[0].v, re.I)):
                    return 'deny', f'setting a gh alias through gh config ({key[0].v}): an alias runs what it was set to'
            if gn[:1] and (gn[0] not in GHCMD or gn[:2] in (['alias', 'set'], ['alias', 'import'])):
                return 'deny', f'a gh command this does not know, or setting one up (gh {" ".join(gn[:2])}): an alias or extension runs what it was set to'
            if gn[:2] in (['repo', 'delete'], ['repo', 'archive']): return 'deny', f'gh repo {gn[1]}'
            if gn[:2] == ['pr', 'merge']: return 'deny', 'merging a PR (gh pr merge): the lander merges'
            if gn[:1] in (['pr'], ['issue']) and gn[1:2] and gn[1] in GHPOST:
                return 'deny', f"posting to a PR or issue (gh {gn[0]} {gn[1]}): a worker's PR text goes up through cc done"
            if gn[:2] == ['release', 'create']: return 'deny', 'publishing a GitHub release (gh release create)'
            if gn[:1] == ['api']:
                # GET ONLY (perms' read of b0b28819). gh sends GET unless -X/--method names another, a field or an
                # --input body makes it a POST, or a header off main's read list (a Method-Override) asks; a graphql
                # query with no mutation is
                # the one POST that reads. A computed word, or argv a pipe hands it through xargs, is not read as a
                # read. Nothing the box runs gated writes through the raw API (a worker's PR text goes up through cc
                # done), so no write endpoint is opened by name, a comment's DELETE included: who wrote a comment is
                # not in the argv.
                # bundled short flags split as gh's flag parser splits them: -iX POST is -i -X POST, -ifk=v is -i -f k=v
                # (perms' read of 9bf1d03b). A letter gh api does not take is an unread word
                ga, odd = [], False
                for x in R['args']:
                    if not re.match(r'-[A-Za-z]{2}', x): ga.append(x); continue
                    for k, c in enumerate(x[1:], 1):
                        ga.append('-' + c)
                        if c in 'XHfFpqtR':
                            if x[k + 1:]: ga.append(x[k + 1:].removeprefix('='))
                            break
                        odd |= c != 'i'
                meth = ''
                for k, x in enumerate(ga):
                    if x in ('-X', '--method') and k + 1 < len(ga): meth = ga[k + 1]
                    elif x.startswith('--method=') or (x.startswith('-X') and len(x) > 2): meth = x.split('=', 1)[-1] if x.startswith('--') else x[2:].lstrip('=')
                ep = [w.v for w in pos([w for w in R['argw'] if not w.dyn], {'-X', '--method', '-H', '--header', '-f', '-F', '--field', '--raw-field', '--input',
                                                   '-q', '--jq', '-t', '--template', '--cache', '--hostname', '-p', '--preview', '-R', '--repo'})][1:2]
                # the endpoint as gh resolves it: a full URL, a leading / and a ?query come off (perms' read of 600963af)
                ep = [re.sub(r'\?.*$', '', re.sub(r'^(https?://[^/]+/(api/v3/)?)?/*', '', e)).rstrip('/') for e in ep]
                form = [x for k, x in enumerate(ga) if x in ('-f', '-F', '--field', '--raw-field', '--input') or x.startswith(('-f', '-F', '--field=', '--raw-field=', '--input='))
                        or (k and ga[k - 1] in ('-f', '-F', '--field', '--raw-field', '--input'))]
                hdr = [x for k, x in enumerate(ga) if x.startswith('--header=') or (k and ga[k - 1] in ('-H', '--header'))] + [x[2:] for x in ga if x.startswith('-H') and len(x) > 2]
                unread = odd or any(w.dyn or '{}' in w.v for w in R['argw']) or {'xargs', 'parallel'} & set(R['via']) \
                    or any(not re.match(r'(--header=)?(Accept|Content-Type|If-None-Match|Time-Zone|X-GitHub-Api-Version):', x, re.I) for x in hdr)
                # graphql reads as main read it: one -f/--raw-field query whose document opens with `query` or `{`
                gql = ep == ['graphql'] and meth.upper() in ('', 'POST') and len(form) == 2 and form[0] in ('-f', '--raw-field') \
                    and re.match(r'query=(query[ {(]|\{)', form[1]) and not any(re.search(r'\b(mutation|subscription)\b', x) for x in ga)
                if unread or not (gql or (meth.upper() in ('', 'GET') and not form)):
                    return 'deny', 'a raw gh api call that is not a plain GET (a method, a field, an --input body, a Method-Override header or a word this cannot read as a read)'
        if v in LAUNCHERS and g.bypass:
            return 'never', 'starting a session with its permission checks skipped'
        w = optval(R['argw'], '--settings', '--settings') if v in LAUNCHERS else None
        if w:   # --settings JSON or FILE naming bypassPermissions (perms' read of 600963af), a computed one, or a file
            try:  # this same command writes with it
                with open(g.absp(w.v, R['cwd'])) as f: body = f.read()
            except (OSError, ValueError): body = ''
            if w.dyn or 'bypassPermissions' in w.v + body or g.bypass:
                return 'never', 'starting a session whose --settings skips its permission checks'
        if (v == 'cc' and '__runperms' in a) or (v == 'cc-handoff' and any(x.startswith('--perms-dir') for x in a)):
            return 'never', 'starting the permission seat (the one session that runs with checks skipped)'
        help_ = bool(HELP & set(a[:2]))   # usage only right after the tool or its subcommand: `cc-slack inject s --help` types
        if v == 'cli.py' and landcli(re.sub(r'[\\\'"]', '', R['raw'][0]), R['cwd']): v = 'lander'
        if (v == 'cc-land' and a not in (['-h'], ['--help'], ['selfcheck'])) \
                or (v == 'lander' and not help_ and first not in ('selfcheck', 'plan', 'check', 'will-review', 'times')) \
                or (v == 'lander-self' and not help_ and first not in ('selfcheck', 'status')) \
                or (INTERP.fullmatch(v or '') and any(re.search(r'(from|import)\s+lander\b|[\'"]lander(\.[\w.]*)?[\'"]', t)
                                                       for t in progtext(v, a, R['redirs']))):
            return 'never', 'landing a change (cc-land and the lander merge, install, switch units on and restart services in one go)'
        if v == 'cc-try' and first in ('on', 'off', 'check'): return 'never', 'cc-try switches the live overlay in front of ~/bin'
        if v == 'cc-config' and mem: return 'never', "the box's config is not a member's to read or rewrite (cc-config)"
        if v == 'cc-config' and first in ('set', 'unset') and len(n) > 1 and PROTKEY.match(n[1]):
            return 'never', f'cc-config {first} {n[1].split("=")[0]}: a key the landing gate reads'
        if v == 'cc-settings' and first in ('apply', 'grant'): return 'never', 'cc-settings rewrites the permission layer'
        # typing into a session's prompt is text arriving with a seat's authority (both roles); a plain post to the owner's
        # own channel reaches nobody outside, so only a member is held off it (a member's reach stays what it was)
        if not help_ and ((v == 'cc-slack' and first == 'inject') or (v == 'cc-broker' and first in ('inject', 'ledger'))):
            return 'deny', f"typing into a session's prompt ({v} {first})"
        if mem and not help_ and ((v == 'cc-slack' and first in ('post', 'post-approval')) or (v == 'cc-arch' and first == 'landed')):
            return 'deny', f"posting to the owner's Slack ({v} {first})"
        # a worker posts to the box's own channels only: #<box> and #<repo> with their -threads and -updates lanes (perms'
        # reads of b0b28819 and 9bf1d03b). -c and --to (post --file) name the channel, --route's first word and
        # post-approval's repo pick one; a name in another workspace, an id or a computed one is refused. With none the
        # post goes to the worker's own thread
        if g.role == 'worker' and not help_ and v == 'cc-slack' and first in ('post', 'post-approval'):
            ws = R['argw'][1:]
            cw = [(w, R['argw'][k - 1].v == '--route') for k, w in enumerate(ws, 1) if R['argw'][k - 1].v in ('-c', '--to', '--route')] \
                if first == 'post' else [(w, False) for w in pos([w for w in ws if w.v not in ('--force', '--landed', '--print-chat')])[:1]]
            if any(w.dyn or re.split(r'[/\s\]]', w.v.strip().lstrip('[#'), maxsplit=1)[0].lower() not in g.ownchans() | ({'box'} if rt else set())
                   for w, rt in cw):
                return 'deny', f"posting outside the box's own Slack channels (cc-slack {first} {cw[0][0].v})"
        if v in ('mail', 'mailx', 'sendmail', 'msmtp', 'mutt') and not help_: return 'deny', f'sending email ({v})'
        if v in DEPLOYV and (first in ('deploy', 'apply', 'up') or '--prod' in a) and not help_: return 'never', f'deploying ({v} {first})'
        if v == 'cc-publish' and not help_ and first not in ('status', 'selfcheck', 'setup') and a[:1] not in (['--dry-run'], ['-n']):
            return 'deny', "publishing the box's code outward (cc-publish)"
        h = g.fence(R)
        if h: return h
        if not mem: return None
        if any(x.startswith(('CC_MEMBER_SANDBOX=', 'CC_MEMBER_SANDBOX+=')) for x in R['assigns'] +
               (a if v in ('export', 'declare', 'typeset', 'readonly', 'local') else [])):
            return 'never', 'setting CC_MEMBER_SANDBOX: the boundary opens a workspace session from outside'
        if v == 'cc':
            if any(x == '--go' or x.startswith('--go=') for x in a) and a[:1] not in (['board'], ['quick']) \
                    and not (g.mws and a[:1] == [g.mws]):
                return 'never', ('dispatching outside this workspace' if g.mws else 'a member-facing session does not dispatch workers (cc --go)')
            if g.mws and a:
                r = ''
                if a[0] == 'board': r = a[2] if len(a) > 2 and not a[2].startswith('-') else ''
                elif a[0] in ('done', 'rm', 'handoff', '-c'): r = next((x for x in a[1:] if not x.startswith('-')), '')
                elif a[0] not in ('slack', 'rc', 'digest', 'quick', 'ls', 'resume') and not a[0].startswith('-'): r = a[0]
                r = r.split('/')[0]
                if r and r != g.mws: return 'never', f'creating outside `{g.mws}`: this workspace makes tracks, boards and sessions under ~/dev/{g.mws} only'
            if a[:1] == ['slack'] and a[1:2] and a[1] in ('off', 'setup', 'mkchannel', 'updates-sweep', 'archive', 'retire'):
                return 'never', f"re-wiring the box's Slack (cc slack {a[1]})"
        if v == 'cc-loop': return 'never', 'a member does not call cc-loop (it spends without the ledger)'
        if v == 'claude' and any(x in ('-p', '--print') or x.startswith('--print=') for x in a):
            return 'never', "a headless claude spends the owner's budget"
        if v == 'cc-slack' and first in ('off', 'setup', 'mkchannel', 'updates-sweep', 'archive', 'retire'):
            return 'never', f"re-wiring the box's Slack (cc-slack {first})"
        return None

def landcli(p, cwd):   # p, against cwd, is the lander's own cli.py (core/lander/cli.py, or ./cli.py inside it)
    p = os.path.normpath(os.path.join(cwd, p))
    return os.path.basename(p) == 'cli.py' and os.path.basename(os.path.dirname(p)) == 'lander'

def literals(prog):   # the string literals of program text, and each run one list or concatenation holds
    lits, runs = [], []   # ("a", "b" -> `a b`; "a " + "b" -> `a b`)
    for code in prog:
        end = None
        for m in re.finditer(r'"((?:[^"\\]|\\.)*)"|\'((?:[^\'\\]|\\.)*)\'|`((?:[^`\\]|\\.)*)`', code, re.S):
            t = re.sub(r'\\(.)', r'\1', next(x for x in m.groups() if x is not None))
            gap = code[end:m.start()] if end is not None else None
            if gap is not None and re.fullmatch(r'\s*[,+.]?\s*', gap): runs[-1] += (' ' if ',' in gap else '') + t
            else: runs.append(t)
            lits.append(t); end = m.end()
    return list(dict.fromkeys(x for x in lits + runs if x.strip()))

def progtext(v, a, redirs):   # the program text an interpreter -c/-e, awk or sed runs (data to the parser, read here as text)
    out = []
    m = INTERP.fullmatch(v)
    if m:
        fl = {'python': 'c', 'pypy': 'c', 'perl': 'eE', 'ruby': 'e', 'node': 'ep', 'nodejs': 'ep', 'deno': '', 'bun': 'e', 'php': 'r'}
        f = fl[re.match(r'[a-z]+', v).group()]
        for k, x in enumerate(a):
            if x in ('--eval', '--print', '--run') and k + 1 < len(a): out.append(a[k + 1])
            elif x.startswith(('--eval=', '--print=')): out.append(x.split('=', 1)[1])
            elif f and not x.startswith('--'):
                mm = re.fullmatch(r'-[A-Za-z]*?[%s](.*)' % f, x, re.S)
                if mm: out.append(mm.group(1) or (a[k + 1] if k + 1 < len(a) else ''))
        out += [r['body'] if r['op'] in ('<<', '<<-') else r['w'].v for r in redirs if r['op'] in ('<<', '<<-', '<<<')]
    elif v in AWKS or v == 'sed':
        valopts = {'-F', '-v', '-f', '-i', '-l', '-W', '--assign', '--field-separator', '--include', '--load', '--file'} if v != 'sed' \
            else {'-f', '-l', '--file', '--line-length'}
        given, k, posn = False, 0, []
        while k < len(a):
            x = a[k]
            if x in ('-e', '--source', '--expression') or (v == 'sed' and re.fullmatch(r'-[A-Za-z]*e', x)):
                if k + 1 < len(a): out.append(a[k + 1])
                given = True; k += 2; continue
            if x.startswith(('--source=', '--expression=')): out.append(x.split('=', 1)[1]); given = True
            elif x in valopts:
                given = given or x in ('-f', '--file')
                if x in ('-f', '--file') and a[k + 1:k + 2] in (['-'], ['/dev/stdin']):   # `awk -f - <<EOF`: the heredoc is the program
                    out += [r['body'] if r['op'] in ('<<', '<<-') else r['w'].v for r in redirs if r['op'] in ('<<', '<<-', '<<<')]
                k += 2; continue
            elif x.startswith('--file='): given = True
            elif not x.startswith('-') or x == '-': posn.append(x)
            k += 1
        if not given and posn: out.append(posn[0])
    return out

def gitparse(ws):   # git's global options -> (-C dirs, subcommand, the words after it)
    k, dirs = 0, []
    while k < len(ws):
        x = ws[k].v
        if x in ('-C', '--work-tree') and k + 1 < len(ws): dirs.append(ws[k + 1]); k += 2
        elif x in ('-c', '--git-dir', '--namespace', '--config-env', '--super-prefix'): k += 2
        elif x.startswith('--work-tree='): dirs.append(ws[k].like(x[12:])); k += 1
        elif x.startswith('-'): k += 1
        else: return dirs, x, ws[k + 1:]
    return dirs, '', []

def shq(x):   # one word, single-quoted for the shell
    return "'" + x.replace("'", "'\\''") + "'"

def xrepl(b, opts, cmd):   # the string xargs -I/-i/--replace (or parallel's {}) swaps for each item, or None (items go last)
    r = None
    for k, x in enumerate(opts):
        if x.startswith('--replace'): r = x.partition('=')[2] or '{}'
        if x.startswith('--') or not x.startswith('-'): continue
        for i, c in enumerate(x[1:], 1):   # a bundle, read as getopt reads it: -0I{} is -0 -I {}
            if c in 'adEILnPs':
                if c == 'I': r = x[i + 1:] or (opts[k + 1] if k + 1 < len(opts) else None)
                break
            if c == 'i': r = x[i + 1:] or '{}'; break
    if b == 'parallel': r = r or '{}'; return r if any(r in x for x in cmd) else None
    return r

def gitcfg(ws):   # the values of git's global -c options, before the subcommand
    out, k = [], 0
    while k < len(ws) and (ws[k].v.startswith('-') or (k and ws[k - 1].v in ('-C', '-c', '--work-tree', '--git-dir', '--namespace', '--config-env'))):
        if ws[k].v == '-c' and k + 1 < len(ws): out.append(ws[k + 1].v)
        k += 1
    return out

def headmove(R):   # a command that changes which branch HEAD names
    if R['verb'] == 'gh': return R['args'][:2] == ['pr', 'checkout']
    if R['verb'] != 'git': return False
    _, sub, rest = gitparse(R['argw'])
    rv = [w.v for w in rest]
    return sub in ('checkout', 'switch', 'symbolic-ref', 'worktree') or (sub == 'branch' and bool({'-m', '-M', '--move'} & set(rv))) \
        or (sub == 'update-ref' and 'HEAD' in rv)

def gitbranch(gd):   # the branch a git dir's HEAD names ('HEAD' when detached, so not main), or None
    try:
        with open(os.path.join(gd, 'HEAD')) as f: head = f.read().strip()
    except OSError: return None
    return head[len('ref: refs/heads/'):] if head.startswith('ref: refs/heads/') else 'HEAD'

def curbranch(d):   # the branch checked out at d (its .git, a worktree's gitdir file followed), or None outside a checkout
    while d and d != '/':
        dg = os.path.join(d, '.git')
        try:
            if os.path.isfile(dg):
                with open(dg) as f: dg = os.path.join(d, f.read().split('gitdir:', 1)[1].strip())
        except (OSError, IndexError): return None
        if os.path.isdir(dg): return gitbranch(dg)
        d = os.path.dirname(d)
    return None

def fwread(v, a, n):
    if v.startswith(('iptables', 'ip6tables', 'ebtables', 'arptables')) and not v.endswith('restore'):
        lst = any(re.fullmatch(r'-[A-Za-z]*[LS][A-Za-z]*', x) or x in ('--list', '--list-rules') for x in a)
        wr = any(re.fullmatch(r'-[A-Za-z]*[ADIRFXPNZE][A-Za-z]*', x) or x in ('--append', '--delete', '--insert', '--replace',
                 '--flush', '--delete-chain', '--policy', '--new-chain', '--zero', '--rename-chain') for x in a)
        return lst and not wr
    if v == 'nft': return '-f' not in a and (n[:1] == ['list'] or (bool(a) and set(a) <= HELP | {'-v', '--version'}))
    if v == 'ufw': return n[:1] in (['status'], ['show'], ['version']) or (n[:1] == ['app'] and n[1:2] in (['list'], ['info'])) or bool(HELP & set(a))
    if v == 'firewall-cmd': return bool(a) and all(re.fullmatch(r'--(state|list-.*|get-.*|query-.*|info-.*|zone=.*|permanent|version|help)|-[hq]', x) for x in a)
    return False

def partread(v, a, n):
    if v in ('fdisk', 'sfdisk', 'gdisk', 'sgdisk', 'cfdisk', 'parted'):
        return bool({'-l', '--list', 'print', '-p', '--print', '--version', '-V'} & set(a) | HELP & set(a))
    if v == 'wipefs': return not any(re.fullmatch(r'-[A-Za-z]*[ao][A-Za-z]*', x) or x.startswith(('--all', '--offset')) for x in a)
    if v == 'cryptsetup': return first_in(n, ('status', 'luksDump', 'isLuks')) or bool(HELP & set(a))
    if v == 'lvm': return first_in(n, ('lvs', 'vgs', 'pvs', 'version', 'help', 'lvdisplay', 'vgdisplay', 'pvdisplay'))
    return False

def first_in(n, xs): return bool(n) and n[0] in xs
def pm(x, *words): return bool(x) and any(w.startswith(x) for w in words)

def netwrite(v, a, n):
    if v == 'ip':
        if any(x in ('-b', '-batch', '-force') for x in a): return True
        n = [x for k, x in enumerate(a) if not x.startswith('-') and not (k and a[k - 1] in ('-n', '-netns', '-f', '-family'))]
        act = n[1] if len(n) > 1 else ''
        return bool(act) and not (pm(act, 'show', 'list', 'get', 'help', 'monitor', 'save') or act in ('ls', 'lst'))
    if v == 'nmcli':
        n = [x for k, x in enumerate(a) if not x.startswith('-') and not (k and a[k - 1] in ('-f', '--fields', '-g', '--get-values', '-e', '--escape', '-c', '--colors', '-m', '--mode', '-w', '--wait'))]
        if not n or pm(n[0], 'monitor', 'help'): return False
        o, x = n[0], n[1] if len(n) > 1 else ''
        if pm(o, 'general'): return not (len(n) <= 2 and (not x or pm(x, 'status', 'permissions', 'logging', 'hostname')))
        if pm(o, 'networking'): return not (len(n) == 1 or pm(x, 'connectivity'))
        if pm(o, 'radio'): return len(n) > 2
        if pm(o, 'connection'): return not (not x or pm(x, 'show'))
        if pm(o, 'device'): return not (not x or pm(x, 'status', 'show') or (pm(x, 'wifi') and (len(n) == 2 or pm(n[2], 'list'))))
        return True
    if v == 'iw': return bool({'set', 'add', 'del', 'connect', 'disconnect', 'join', 'leave', 'start', 'stop', 'ibss', 'mesh'} & set(a))
    if v == 'iwconfig' or v == 'ifconfig': return len(n) > 1
    if v == 'wpa_cli':
        n = [x for k, x in enumerate(a) if not x.startswith('-') and not (k and a[k - 1] in ('-i', '-p', '-g', '-P', '-G', '-a'))]
        return not first_in(n, ('status', 'list_networks', 'scan_results', 'ping', 'help', 'get', 'mib', 'signal_poll'))
    if v == 'netplan': return not (not n or n[0] in ('get', 'info', 'status', 'help') or HELP & set(a))
    if v == 'ethtool': return bool({'-s', '--change', '-K', '--features', '--offload', '-A', '--pause', '-G', '--set-ring', '-C', '--coalesce',
                                    '-L', '--set-channels', '-E', '--change-eeprom', '-f', '--flash', '-r', '--negotiate', '--reset'} & set(a))
    if v == 'route': return first_in(n, ('add', 'del', 'delete', 'flush', 'change'))
    if v == 'rfkill': return first_in(n, ('block', 'unblock', 'toggle'))
    if v == 'hostapd_cli': return not first_in(n, ('status', 'all_sta', 'list_sta', 'ping', 'help', 'get_config'))
    if v in ('tc', 'bridge'): return bool({'add', 'del', 'delete', 'change', 'replace', 'flush', 'set'} & set(a))
    if v == 'brctl': return any(x.startswith(('add', 'del', 'set', 'stp')) for x in n)
    if v == 'networkctl': return first_in(n, ('up', 'down', 'reconfigure', 'reload', 'renew', 'forcerenew', 'delete'))
    if v in FW: return False   # judged by fwread
    return not (set(a) and set(a) <= HELP | {'--version', '-V'})   # ifup ifdown dhclient hostapd wpa_supplicant nmtui

# ----------------------------------------------------------------------------------------------------------- main
def judge(text, env):
    g = Guard(env)
    if g.role not in ('worker', 'member', 'pf'): return None
    try: g.script(text, g.base, None, 0)
    except ParseError: return 'never', 'could not parse this command; split it or put it in a file'
    g.headmove = any(headmove(R) for R in g.out)
    # the skip-permissions words anywhere in the command, quotes off: a launcher handed them through `$F` or `$(…)` uses them
    g.bypass = bool(re.search(r'dangerously-skip-permissions|bypassPermissions|permission-mode[\s=]+bypass', re.sub(r'[\\\'"]', '', text)))
    hits = [h for h in (g.rules(R) for R in g.out) if h]
    return next((h for h in hits if h[0] == 'never'), None) or (hits[0] if hits else None)

def parse(text, env):
    g = Guard(env); g.script(text, g.base, None, 0)
    return [{'verb': R['verb'], 'argv': R['args'], 'redirects': [[r['op'], r['w'].v] for r in R['redirs']],
             'cwd': R['cwd'], 'nested': R['nested'], 'via': R['via']} for R in g.out]

SEATWHY = ("only the permission seat writes its state (~/.cc/state/<repo>/perms and its handoff record): whoever writes "
           "its brief.md controls the next permission-skipping session")

UNIT = [   # (command, verbs that must be seen, verbs that must not)
    ("cat > f <<EOF\nsudo reboot\nEOF", ['cat'], ['sudo']),
    ("echo 'sudo reboot'; grep -rn 'docker run' .", ['echo', 'grep'], ['sudo', 'docker']),
    ("git commit -m 'sudo reboot; docker rm x'", ['git'], ['sudo', 'docker']),
    ("bash -c 'sudo reboot'", ['bash', 'sudo'], []),
    ("bash -lc \"echo hi; docker ps\"", ['docker'], []),
    ("echo sudo reboot | bash", ['sudo'], []),
    ("printf 'docker ps\\n' | sh -s", ['docker'], []),
    ("bash <<EOF\nsudo reboot\nEOF", ['sudo'], []),
    ("sh <<< 'nft flush ruleset'", ['nft'], []),
    ("echo $(sudo reboot)", ['echo', 'sudo'], []),
    ("echo \"`docker ps`\"", ['docker'], []),
    ("cat <<EOF\n$(sudo reboot)\nEOF", ['sudo'], []),
    ("cat <<'EOF'\n$(sudo reboot)\nEOF", ['cat'], ['sudo']),
    ("timeout 5 tmux kill-server", ['tmux'], ['timeout']),
    ("echo x | xargs sudo reboot", ['sudo'], []),
    ("echo reboot | xargs -r systemctl", ['systemctl'], []),
    ("xargs -0 <<E\nsudo reboot\nE", ['sudo'], []),
    ("xargs -0 sudo <<< reboot", ['sudo'], []),
    ("find . -name x -exec docker rm {} \\;", ['find', 'docker'], []),
    ("env FOO=1 BAR=2 docker ps", ['docker'], ['env']),
    ("env -S 'sudo reboot'", ['sudo'], []),
    ("nice -n 5 nohup setsid stdbuf -oL ionice -c 3 parted /dev/sda rm 1", ['parted'], []),
    ("sud[o] reboot", ['sudo'], []),
    ("/usr/bin/sudo reboot", ['sudo'], []),
    ("{sudo,reboot}", ['sudo'], []),
    ("s''udo \\reboot", ['sudo'], []),
    ("eval 'sudo reboot'", ['eval', 'sudo'], []),
    ("source <(echo docker ps)", ['docker'], []),
    ("f() { sudo reboot; }; f", ['sudo'], []),
    ("case $x in a) docker ps;; b|c) echo;; esac", ['docker', 'echo'], []),
    ('echo "$(case a in a) x;; esac; docker ps)"', ['echo', 'x', 'docker'], []),   # a pattern's ) does not close the $( )
    ("python3 -c 'import os; os.system(\"sudo reboot\")'", ['python3', 'sudo'], []),
    ("python3 -c 'print(1)'", ['python3'], ['print']),
    ("script -qc 'docker ps' /dev/null", ['script', 'docker'], []),
    ("git -c alias.x='!docker ps' x", ['git', 'docker'], []),
    ("git -c alias.x='log' x", ['git'], ['log']),
    ("python3 - <<'EOF'\nprint('iptables -F')\nEOF", ['python3'], ['iptables']),
    ("for mail in a b; do echo $mail; done", ['echo'], ['mail']),
    ("command -v docker", ['command'], ['docker']),
]

def selfcheck():
    ok = bad = 0
    def fail(msg):
        nonlocal bad; bad += 1; print('FAIL ' + msg)
    with tempfile.TemporaryDirectory(prefix='cc-guard-argv.') as H:
        H = os.path.realpath(H)
        os.makedirs(H + '/.cc/state/demo/perms')   # the seat's state exists, so a parent of it is found (rule D)
        os.makedirs(H + '/dev/alice/.cc'); os.makedirs(H + '/.cc/worktrees/alice/t')   # alice is a member workspace (memexec)
        open(H + '/dev/alice/.cc/member-workspace', 'w').close()
        os.makedirs(H + '/.cc/worktrees/demo/t/.cc')   # the worker's tree, of repo demo (its own Slack channels)
        with open(H + '/.cc/worktrees/demo/t/.cc/track', 'w') as f: f.write('other\nt\n')   # written by the worker: not read
        base = {'HOME': H, 'GUARD_ROLE': 'worker', 'GUARD_CWD': H + '/.cc/worktrees/demo/t', 'GUARD_ROOT': H + '/.cc/worktrees/demo/t'}
        for cmd, want, unwanted in UNIT:
            try: seen = [r['verb'] for r in parse(cmd, base)]
            except ParseError as e: fail(f'unit {cmd!r}: parse error {e}'); continue
            miss = [v for v in want if v not in seen] + [v for v in unwanted if v in seen]
            if miss: fail(f'unit {cmd!r}: saw {seen}, wrong on {miss}')
            else: ok += 1
        for cmd, cwd, want in [("cd ~/dev/x && echo > f", None, H + '/dev/x'), ("cd $D; touch f", None, base['GUARD_CWD']),
                               ("(cd /tmp); touch f", None, base['GUARD_CWD']), ("pushd /a; popd; touch f", None, base['GUARD_CWD'])]:
            last = parse(cmd, base)[-1]
            if last['cwd'] != want: fail(f'unit cwd {cmd!r}: {last["cwd"]} != {want}')
            else: ok += 1
        # a glob beside the seat's state (state/demo/perms here) is judged on what it can name, a component at a time
        for cmd, refuse in [(f'rm {H}/.cc/state/s* /tmp/x*', False), (f'rm -rf {H}/.cc/state/s*/perms', False),
                            (f'rm -rf {H}/.cc/state/d*', True), (f'rm -rf {H}/.cc/s*', True),
                            (f'cp /tmp/x {H}/.cc/state/de*/perms/brief.md', True), (f'rm -rf {H}/.cc/state/*/per?s', True)]:
            for role in ('worker', 'pf'):
                if (judge(cmd, dict(base, GUARD_ROLE=role)) is not None) != refuse: fail(f'seat glob {role}: {cmd!r} (want {"refuse" if refuse else "pass"})')
                else: ok += 1
        for cmd in ("echo 'unclosed", 'echo "$(date', 'ls )', 'echo `date', 'cat <<E\ngh pr merge 1'):
            if (judge(cmd, base) or ('',))[0] != 'never': fail(f'unit {cmd!r}: an unparseable command was not refused')
            else: ok += 1
        # the hard limits perms' read of #1221 found open: each case gets a fresh checkout on the branch it names
        # (a plain .git dir, or a worktree's .git file pointing at its gitdir), and each refusal has its near miss
        def repo(branch, wt):
            d = tempfile.mkdtemp(dir=H, prefix='repo.')
            gd = d + '/.gitdir' if wt else d + '/.git'
            os.makedirs(gd)
            with open(gd + '/HEAD', 'w') as f: f.write(f'ref: refs/heads/{branch}\n')
            if wt:
                with open(d + '/.git', 'w') as f: f.write('gitdir: .gitdir\n')
            return d
        rb = 're' + 'boot'
        SEATDOOR = ('sudo -n -u dispatch-seat-door /usr/local/lib/dispatch-seat-door/dispatch-door '
                    '/var/lib/dispatch-door/dispatch upload secretary@box')
        for role, branch, cmd, refuse in [
                ('worker', 'main', 'git push -f origin HEAD', True), ('worker', 'track/x', 'git push -f origin HEAD', True),
                ('worker', 'main', 'git push --force', True), ('worker', 'track/x', 'git push --force', True),
                ('worker', 'track/x', 'git push --all --force origin', True), ('worker', 'track/x', 'git push origin track/x', False),
                ('worker', 'track/x', "git push origin '+refs/heads/*:refs/heads/*'", True),
                ('worker', 'track/x', "git push origin '+refs/heads/track/x:refs/heads/track/x'", False),
                ('worker', 'track/x', 'git -c remote.origin.push=HEAD:main push origin', True),
                ('worker', 'track/x', 'git -c user.name=x push origin HEAD', False),
                ('worker', 'track/x', 'git config remote.origin.push HEAD:main', True), ('worker', 'track/x', 'git config user.name x', False),
                ('worker', 'track/x', 'gh api -X DELETE repos/o/r/branches/main/protection', True),
                ('worker', 'track/x', 'gh api repos/o/r/branches/main/protection', False),
                ('worker', 'track/x', 'gh api -X PUT repos/o/r/collaborators/X', True),
                ('worker', 'track/x', 'gh api --method=PUT orgs/o/memberships/X -f role=member', True),
                ('worker', 'track/x', 'gh api repos/o/r/collaborators', False),
                ('worker', 'track/x', 'gh api --method PUT repos/o/r/branches/master/protection --input p.json', True),
                ('worker', 'track/x', "X=$(printf 'su%s' do); $X " + rb[:2] + "''" + rb[2:], True),
                ('worker', 'track/x', "X=$(printf 'e%s' cho); $X hel''lo", False),
                ('member', None, 'cc-slack retire C1', True), ('member', None, 'cc slack retire', True),
                ('member', None, 'cc-slack status', False),
                ('worker', 'track/x', 'git push --force https://example.invalid/r.git publish:refs/heads/publish', True),
                ('worker', 'track/x', 'git push --force-with-lease origin HEAD', True),
                ('worker', 'track/x', 'git push origin :old-branch', True), ('worker', 'track/x', 'git push origin publish', False),
                ('worker', 'track/x', 'gh pr comment 9 --body hi', True), ('worker', 'track/x', 'gh pr view 9 --comments', False),
                ('worker', 'track/x', 'jq . ~/.claude-workers/.credentials.json', True), ('worker', 'track/x', 'jq . ~/notes.json', False),
                ('worker', 'track/x', 'cat ~/.cc/secrets/x.token', True), ('worker', 'track/x', 'ls ~/.cc', False),
                ('pf', None, 'cc-slack member add x', True), ('pf', None, 'cc-slack member list', False),
                ('pf', None, 'sudo -n ' + rb, True), ('pf', None, 'sudo -n true', False),
                # hive's seat door: a seat writes #dispatch's door as dispatch-seat-door (dispatch's sudoers rule
                # allows that one copy), and a worker or member is refused it like every other sudo
                ('pf', None, SEATDOOR, False), ('worker', 'track/x', SEATDOOR, True), ('member', None, SEATDOOR, True),
                ('pf', None, "ssh h 'rm -f ~/.cc/members/x/credentials.json'", True), ('pf', None, 'ssh h uptime', False),
                # naming the workers' login is not reading it (namesonly): that one set, and a card that runs it, pass
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json', False),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS "$HOME"/.claude-workers/.credentials.json', False),
                ('pf', None, "cc-notify --approval --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ${HOME}/.claude-workers/.credentials.json' t", False),
                ('pf', None, 'cc-config set OTHER ~/.claude-workers/.credentials.json', True),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/x/.credentials.json', True),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/../.claude/.credentials.json', True),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude*/.credentials.json', True),
                ('pf', None, './cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json', True),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json < ~/ccbox/env', True),
                ('pf', None, 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json; cat ~/.claude-workers/.credentials.json', True),
                ('pf', None, "cc-notify --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json' t", True),
                ('pf', None, "cc-notify --approval --run 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json; jq . ~/.claude-workers/.credentials.json' t", True),
                ('worker', 'track/x', 'cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json', True)]:
            cwd = repo(branch, branch != 'main') if branch else H + '/dev/alice'
            env = dict(base, GUARD_ROLE=role, GUARD_CWD=cwd, GUARD_ROOT=cwd, GUARD_MWS='alice' if role == 'member' else '')
            got = judge(cmd, env)
            if (got is not None) != refuse: fail(f'case {role} on {branch}: {cmd!r} -> {got} (want {"refuse" if refuse else "pass"})')
            else: ok += 1
        mr, tr = repo('main', False), repo('track/x', True)   # git -C / --git-dir name the checkout, not the cwd
        for cmd, refuse in [(f'git -C {mr} push origin +HEAD', True), (f'git -C {tr} push origin +HEAD', False),
                            (f'git --git-dir={mr}/.git push origin +HEAD', True), (f'git --git-dir={tr}/.gitdir push origin +HEAD', False)]:
            got = judge(cmd, dict(base, GUARD_CWD=tr, GUARD_ROOT=tr))
            if (got is not None) != refuse: fail(f'case git -C: {cmd!r} -> {got}')
            else: ok += 1
        # member code on the host (raised-member-gate-reruns-ran-unsandboxed): seats reran ece298a's PLL gates with
        # `setsid nice -n 19 python3 gate.py` and `bash log/scratch/run_sim_tt.sh` from its worktree, as the box's user.
        # Its own HOME: bob is a member by the host-side record; carol has a ~/dev tree but no record, so is not.
        MH = tempfile.mkdtemp(dir=H, prefix='mem.')
        for d in ('.cc/members/bob', '.cc/worktrees/bob/pll/log/scratch', 'dev/bob', 'dev/carol', 'plain'): os.makedirs(MH + '/' + d)
        mp = MH + '/.cc/worktrees/bob/pll'
        for role, cwd, cmd, refuse in [
                ('pf', 'plain', f'cd {mp} && setsid nice -n 19 python3 gate.py > log 2>&1', True),
                ('pf', 'plain', f'cd {mp}; bash log/scratch/run_sim_tt.sh', True),
                ('pf', 'plain', f'bash -e {mp}/log/scratch/run_sim_tt.sh', True),
                ('pf', 'plain', f'{mp}/gate.py', True), ('pf', 'plain', 'python3 -I ~/dev/bob/x.py', True),
                ('pf', 'plain', 'make -C ~/dev/bob sim', True), ('pf', 'dev/bob', 'make test', True),
                ('worker', 'plain', "cd ~/dev/bob && python3 -c 'print(1)'", True),
                ('pf', 'plain', f'systemd-run --user --wait cc-sandbox member bob pll -- python3 {mp}/gate.py', False),
                ('pf', 'plain', f'cd {mp} && cc-sandbox member bob pll -- python3 gate.py', False),
                ('pf', 'plain', f'cd {mp} && cat gate.py && git log -3 && grep -rn x .', False),
                ('pf', 'plain', 'python3 ~/bin/tool.py ~/dev/bob/data.json', False),
                ('pf', 'dev/bob', "bash -c 'git status'", False), ('pf', 'plain', 'cd ~/dev/carol && make', False),
                ('member', 'dev/bob', 'python3 x.py', False),
                # a member's file named like a wrapper is still a member's file (the review of #1496)
                ('pf', 'plain', f'{mp}/nice -n 19 ls', True), ('pf', 'plain', f'cd {mp} && ./setsid ls', True),
                ('pf', 'plain', f'nice {mp}/env ls', True), ('pf', 'plain', '/usr/bin/nice -n 19 ls', False),
                # make's options in every form make reads them (the second review of #1496)
                ('pf', 'plain', f'make -C{mp} sim', True),
                ('pf', 'plain', f'make -f{mp}/Makefile', True), ('pf', 'plain', f'make -f {mp}/Makefile', True),
                ('pf', 'plain', f'make --directory={mp}', True), ('pf', 'plain', f'make --directory {mp}', True),
                ('pf', 'plain', f'make --file={mp}/Makefile', True), ('pf', 'plain', f'make --makefile={mp}/M', True),
                ('pf', 'plain', f'make -I{mp}', True), ('pf', 'plain', f'make -I {mp}', True),
                ('pf', 'plain', f'make --include-dir={mp}', True), ('pf', 'plain', f'make -sC{mp}', True),
                ('pf', 'plain', f'make -sC {mp}', True), ('pf', 'plain', f'make -kj4 -sf{mp}/M', True),
                ('pf', 'plain', f'make --dir={mp}', True), ('pf', 'plain', f'make all -C {mp}', True),
                ('pf', 'plain', f'make -C {MH} -C .cc/worktrees/bob/pll', True),
                ('pf', 'plain', f'make -C {mp} -f Makefile', True), ('pf', 'plain', f'make -C {MH}/plain -f ../dev/bob/M', True),
                ('pf', 'plain', f'MAKEFILES={mp}/x.mk make', True), ('pf', 'plain', f'MAKEFLAGS=-I{mp} make', True),
                ('pf', 'plain', f'make -C {MH}/plain -j 4 -o {mp}/x all', False),
                ('pf', 'plain', f'make -C {MH}/plain -- -C{mp}', False), ('pf', 'plain', f'make -sC {MH}/plain', False)]:
            env = {'HOME': MH, 'GUARD_ROLE': role, 'GUARD_CWD': MH + '/' + cwd, 'GUARD_ROOT': MH + '/' + cwd,
                   'GUARD_MWS': 'bob' if role == 'member' else ''}
            got = judge(cmd, env)
            if (got is not None) != refuse or (refuse and 'cc-sandbox member bob' not in got[1]):
                fail(f'member code {role}: {cmd!r} -> {got} (want {"refuse" if refuse else "pass"})')
            else: ok += 1
        # gh reads its aliases from $GH_CONFIG_DIR when the session sets it, so that dir is fenced like ~/.config/gh
        W = base["GUARD_ROOT"]   # inside the tree it writes, so the fence alone refuses
        for cmd, refuse in [(f"echo x > {W}/ghc/config.yml", True), (f"cp a.yml {W}/ghc/", True), (f"echo x > {W}/ghd/config.yml", False)]:
            got = judge(cmd, dict(base, GH_CONFIG_DIR=W + "/ghc"))
            if (got is not None) != refuse: fail(f'case GH_CONFIG_DIR: {cmd!r} -> {got}')
            else: ok += 1
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), '..', 'tests', 'guard-replay.jsonl')
        skipped = 0
        with open(H + '/never-touch.txt', 'w') as f: f.write('# fixture\n192.0.2.10\n')
        # the pending false refusals (expect pass) too: main's text judges still refuse them, but this layer must not
        lines = open(path).read().splitlines() + open(path[:-len('.jsonl')] + '-pending.jsonl').read().splitlines()
        for no, line in enumerate(lines, 1):
                if not line.strip(): continue
                c = json.loads(line)
                if c.get('layer', 'argv') != 'argv': skipped += 1; continue
                role = c['role']; mws = c.get('mws', 'alice' if role == 'member' else '')
                dflt = H + '/dev/' + mws if role == 'member' else base['GUARD_CWD']
                fx = lambda p: p.replace('~', H, 1) if p.startswith('~') else p
                env = {'HOME': H, 'GUARD_ROLE': role, 'GUARD_MWS': mws, 'GUARD_CWD': fx(c.get('cwd', dflt)),
                       'GUARD_ROOT': fx(c.get('root', dflt)), 'GUARD_PSEAT': '1' if c.get('pseat') else '', 'GUARD_INB': '1' if c.get('inb') else '',
                       'GUARD_NEVER_TOUCH': H + '/never-touch.txt'}
                got = judge(c['cmd'], env)
                if (got is not None) != (c['expect'] == 'refuse'):
                    fail(f"replay {no} ({c['expect']}, {role}): {c['cmd'][:70]!r} -> {got}")
                else: ok += 1
    print(f'replay lines left to cc-guard (tmux, pattern kill): {skipped}')
    print(f'cc-guard-argv selfcheck: {ok} passed, {bad} failed')
    return 1 if bad else 0

def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ''
    if mode == 'selfcheck': sys.exit(selfcheck())
    if mode not in ('judge', 'parse'):
        print('usage: cc-guard-argv judge|parse|selfcheck  (command on stdin)', file=sys.stderr); sys.exit(2)
    text = sys.stdin.read()
    try:
        if mode == 'parse':
            try: rows = parse(text, os.environ)
            except ParseError as e: print(json.dumps({'error': str(e)})); return
            for r in rows: print(json.dumps(r))
            return
        h = judge(text, os.environ)
        if h: print(f'{h[0]}\t{h[1]}')
    except Exception as e:   # noqa: BLE001 - a crash must refuse, never allow
        print(f'cc-guard-argv: internal error: {type(e).__name__}: {e}', file=sys.stderr); sys.exit(3)

if __name__ == '__main__':
    main()
