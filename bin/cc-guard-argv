#!/usr/bin/env python3
"""cc-guard-argv: the argv backstop for a gated Bash call (design: guard-keeps-only-the-backstop).

  cc-guard-argv judge      the raw command on stdin; prints nothing (allowed) or ONE line `deny<TAB>why` (needs the
                           owner) or `never<TAB>why`, exit 0. Exit 3 + stderr on an internal error (cc-guard refuses).
  cc-guard-argv parse      the command on stdin as JSON lines: verb, argv, redirects, cwd after cd, nested-in, via.
  cc-guard-argv selfcheck  parser unit cases + every line of core/tests/guard-replay{,-pending}.jsonl in a fixture HOME.
Env: GUARD_ROLE worker|member|pf (anything else: allowed; pf = the ungated tier, see below), HOME (or GUARD_HOME),
GUARD_CWD, GUARD_ROOT (the tree this session writes, ':'-separated), GUARD_MWS (member workspace), GUARD_INB=1 (inside a member boundary: only then are ~/.cc/slack and ~/.cc/library/owner a member's to read), GUARD_PSEAT=1 (the permission seat).
GUARD_NEVER_TOUCH (a file) replaces config/never-touch.txt; only the selfcheck sets it, and cc-guard unsets it.
It only judges: nothing here launches a worker, dispatches or writes the board.
recurring-defect-ok: pause-hold-missing — a judge that refuses `--go`; it never launches or writes the board
recurring-defect-ok: held-files-unchecked — a judge that refuses `--go`; it never dispatches or groups rows

Only what bash would exec is judged. Words are read after VAR= and wrappers (env timeout nice nohup setsid stdbuf
ionice time command builtin exec chrt taskset xargs parallel busybox flock watch systemd-run unshare nsenter chroot); the parser
recurses into sh -c, eval, $( ), backticks, <( ), find -exec, xargs fed by a pipe, env -S/--split-string, and a
heredoc, here-string, pipe (`cat f` of an f written earlier reads as its text), `< <( )` or `< f` (f written earlier in the line) fed to a shell, source or at/batch, or named
as its script (`sh <( )`, `bash /dev/stdin`, `. -`, `bash /dev/fd/3 3<<<…`, an interpreter's stdin, a pipe too), what xargs
or parallel runs with each item it reads (from stdin, -a f, --arg-file=f, `< f`, parallel's ::: words or :::: f) as ONE word (the whole input, and
each line, -I/-i/--replace[=] swapped in; a lone `parallel {}` runs each item as the command), `script -c CMD`, a git `!` alias given as -c alias.X=!CMD or set by git config, and the string
literals of an interpreter's -c/-e code (python perl ruby node php…: each literal, and all of them joined by blanks,
so os.system("<cmd>") and subprocess.run(["git", "push", …]) are judged as the commands they run; a literal that
does not parse is data). Other quoted args, heredoc bodies and commit messages are data; the credentials rule also
reads an interpreter's -c/-e (or stdin heredoc) body and awk/sed program text.

Rules for both gated roles:
- root: sudo doas su runuser pkexec sudoedit                                                        -> never
- power: reboot shutdown poweroff halt kexec; systemctl|loginctl reboot|poweroff|halt|kexec|suspend|hibernate|
  rescue|emergency|isolate|default; dbus-send|busctl|gdbus|qdbus naming login1 or systemd1 with a Reboot, PowerOff,
  Halt, KExec, Suspend, Hibernate… method or a power target                                          -> never
- network units: systemctl|service stop|disable|mask|kill|restart.. on NetworkManager hostapd wpa_supplicant
  systemd-networkd iwd dnsmasq                                                                        -> never
- firewall: iptables ip6tables nft ufw firewall-cmd ebtables, unless a read (-L/-S, list, status, --list-*) -> never
- partition: fdisk sfdisk gdisk sgdisk parted wipefs mkfs* mkswap cryptsetup lvm/pv/vg/lv verbs unless a listing,
  and any write onto a block device (/dev/sd*, nvme*, mmcblk*, ...)                                   -> never
- network: ip <obj> add|del|set|flush|change|replace, nmcli non-read, iw set|add|del|connect, wpa_cli non-read,
  netplan apply|set|try, ifconfig <if> <arg>, ifup/ifdown, ethtool -s/-K.., route add|del, rfkill block, tc add.. -> never
- never-touch: a network verb whose argv names a line of config/never-touch.txt (GUARD_NEVER_TOUCH, a file,
  replaces it in the selfcheck)                                                             -> never
- containers: docker podman nerdctl docker-compose podman-compose ctr                               -> never
- credentials: an argv word (or its @file / =value part) or `<` source resolving to secret_all (worker) or
  secret_path (member), or anything under ~/.cc/secrets or any credentials.json / .credentials.json / *.token under
  ~, for any verb but echo/printf; or one of those path names (ccbox/env, .credentials.json, credentials.json,
  .cc/secrets, .codex/auth.json, cursor/auth.json; member also .cc/config .ssh .claude/settings.json .cc/sandbox) as text inside
  a python/perl/ruby/node/php -c/-e body or awk/sed program (so a commit message or grep pattern still passes) -> never
  (a member's computed word — `~/.cc/$d`, `$d/x`, `~/.cc/$(..)`, backticks — is read, and fenced as a write target,
  as the glob it could match: dynpat)
  (the one exception, role pf only: `cc-config set WORKER_CLAUDE_CREDENTIALS ~/.claude-workers/.credentials.json` alone
  on the line, ~ or $HOME, names the workers' login without reading it, and so does a cc-notify --approval --run of
  exactly that text; namesonly)
- git push whose refspec destination is main/master (+main, :main, -d main, HEAD:main) or a glob ('+refs/heads/*:
  refs/heads/*'); `HEAD` alone, or no refspec, is the branch checked out at the cwd / git -C / --git-dir (read
  from its HEAD; outside a checkout git refuses the push itself); --mirror, --all, --branches; -c remote.*.push|
  mirror / push.default or a GIT_CONFIG_* assignment on the push; git config setting remote.*.push|mirror or
  push.default; a worker's force push (-f, --force*, +refspec) or delete (-d, --delete, :dst) whose
  destination is not a track/… branch; GIT_DIR/GIT_WORK_TREE name the checkout like --git-dir; any push in a
  command that also moves HEAD (git checkout|switch|symbolic-ref|worktree, branch -m, update-ref HEAD, gh pr
  checkout), or whose refspec, remote, -C, --git-dir, GIT_DIR or cd target is computed                 -> deny
- gh pr|issue comment|create|close|reopen|edit|review|merge|lock|unlock|delete|transfer; gh release create; a gh
  command or subcommand word that is computed ($M, "$(…)", a glob); gh config set aliases.*; a gh command off GHCMD
  (an alias or extension, `co` included)                                                                  -> deny
- cc-slack inject, cc-broker inject|ledger, cc-publish (but status/selfcheck/setup, or --dry-run/-n/--help as its
  first word); a member's cc-slack post|post-approval, cc-arch landed, force push or branch delete   -> deny
- mail mailx sendmail msmtp mutt -> deny; vercel netlify fly heroku kubectl terraform ansible aws gcloud az with
  deploy|apply|up or --prod -> never
- an interpreter or shell running one of the gated tools by its path (`python3 -Wignore core/bin/cc-try on`, `bash
  core/bin/cc-publish`) is judged as that tool; a --help or -h counts as usage only
  right after the tool or its subcommand
- gh repo delete|archive; a raw gh api call that is not a plain GET: a method other than GET, a field or --input
  body (a POST), a header but Accept/Content-Type/If-None-Match/Time-Zone/X-GitHub-Api-Version, a computed word,
  or argv a pipe hands it through xargs/parallel; the one POST open is gh api graphql -f query='query…' or '{…'
  naming no mutation or subscription                                                                     -> deny
- a worker's cc-slack post -c/--to a channel that is not the box's own (#<box>, #<repo>, each's -threads and
  -updates lanes; <repo> from the worktree's .cc/track)                                                  -> deny
- bypass: a launch in a command whose text (quotes off) names dangerously-skip-permissions, bypassPermissions or
  --permission-mode bypass, or whose --settings JSON or file names bypassPermissions or is computed     -> never
- cc __runperms; cc-handoff --perms-dir; cc-try on|off|check                                         -> never
- landing: cc-land but `-h`/`--help`/`selfcheck` alone; lander but plan/check/will-review/times/selfcheck/help;
  lander-self but status/selfcheck/help; core/lander/cli.py by its path (or ./cli.py inside it), python -m lander[.x],
  or interpreter code importing lander                                                             -> never
- cc-config set|unset CC_PROTECTED_PATHS_*|SLACK_OWNER_ID|CC_LAND_REVIEW*|CC_CLAUDE|CC_CODEX; cc-settings apply|grant -> never
- write fence: a redirect target or the destination of cp mv ln install rsync tee dd(of=) sed -i perl -i truncate rm
  rmdir unlink shred touch mkdir chmod chown curl -o wget -O find -delete, or git -C <dir> (or the cwd) with a verb
  that writes the tree, landing (relative = after this command's own cd/pushd) in ~/dev/* (except GUARD_ROOT and
  ~/dev/<mws>), ~/bin, ~/.cc/try, ~/.cc/lander, ~/.cc/state/land, ~/.cc/config, ~/.claude/settings.json, ~/.config/gh and $GH_CONFIG_DIR (gh reads aliases there), or
  ~/.cc/state/<x>/perms or ~/.cc/state/handoff/perms.{json,brief} (unless GUARD_PSEAT). A `$` target passes; a glob
  is cut at its first wildcard and the cut judged as a prefix, but for the seat's state it is matched a component at a
  time against the seat places that exist (above, at or inside one is refused)                      -> never
- remove from above: rm rmdir, mv (sources), rsync --delete* (destination) or --remove-source-files, find -delete
  whose target is a PARENT of an existing ~/.cc/state/<x>/perms or handoff seat file, of ~/dev, or of a write-fence
  place (`rm -rf ~/.cc`, `mv ~/.cc/state x`); unless GUARD_PSEAT                                     -> never
- a `$X` verb is the literal value of an earlier X= / export / declare in the same command; any other `$X` /
  `$(..)` verb passes unless a word of that command (or of the text an X=$(..) was built from), read with its quotes and backslashes taken off
  (`$X re''boot` is reboot), is a hard-limit verb name (a member's too: cc-config, cc-loop) (-> never), or its arguments would be refused as
  the arguments of one of CANDV (git gh systemctl cc-slack claude lander-self cc-handoff; cp, so a
  last argument in the write fence; ip when the first argument is an ip object; cc when an argument is one of
  CCWORDS), so
  `$(echo git) push -f origin main` is a push to main                                  -> that verb's answer
- an unclosed quote, substitution or ( )                                    -> never "could not parse this command"
Every role, pf included:
- power: a power verb (or systemctl|loginctl on a reboot/poweroff/halt/kexec/suspend/rescue/emergency/... .target
  unless the subcommand reads it), and what sudo/doas/pkexec/runuser runs (options skipped) judged as a command of
  its own (`sudo /sbin/reboot`, `sudo env reboot`), or su -c; a `$X` verb next to reboot/shutdown/poweroff/halt/kexec -> never
- ssh to any host: what it carries (the words after the host joined by blanks, -o RemoteCommand, and a heredoc,
  here-string, <( ) or pipe it is fed) judged as a command for this role; for a gated role also any root, power,
  firewall, disk, container, systemctl, ip, nmcli or netplan verb in it. -o ProxyCommand/LocalCommand/
  KnownHostsCommand run here and are parsed as local commands                                         -> never
- cc-slack member add / cc slack member add (widening who reaches the box)                           -> never
pf and worker (a host session; one whose cwd is in a member workspace is read as role member, and not judged here):
- a member's code run outside its sandbox: a verb path, a shell/interpreter/`source` file argument or `<` source
  under a member workspace (~/dev/<h> holding .cc/member-workspace) or its worktrees (~/.cc/worktrees/<h>), python -m
  there, or make npm npx yarn pnpm pytest tox nox cargo just with the cwd there or a path argument there; only
  `cc-sandbox member <h> -- …` runs it (an -c/-e literal is judged as its own commands)                -> never
- member code on the host: a command that runs a file under a member's tree (~/dev/<h> or ~/.cc/worktrees/<h>,
  where the host-side ~/.cc/members/<h> exists) as its command word or as the script of a shell, `source` or an
  interpreter; make whose -C, -f or -I (attached, detached, clustered or a long prefix, as make reads them),
  MAKEFILES or MAKEFLAGS -I lands in one; or an interpreter, build or EDA tool (MEMCWD) whose cwd after cd is in
  one. A member's code runs inside its boundary, `cc-sandbox member <h> [<track>] -- <cmd>`, whose own argv is not
  read as a command here. Reads (cat, grep, git) pass; a member session's own tree is its own. Ceiling: a cd
  this cannot resolve is judged at the session cwd, and a tool not in MEMCWD run there passes  -> never
pf (the ungated tier) only, besides those: the seat-state part of the write fence, remove-from-above for the seat's
state, and the credentials rule.
Member only:
- CC_MEMBER_SANDBOX= assignment; cc --go outside ~/dev/<mws> (cc board|quick exempt); cc-loop; `cc <repo>` naming
  another repo; claude -p/--print; cc slack / cc-slack off|setup|mkchannel|updates-sweep|archive|retire;
  cc-config                                                                                            -> never
Not here (cc-guard keeps them, they need /proc or the tool input): tmux kill-server/kill-session, pattern kills,
the member kill fence, the Write/Edit rules.
"""
import fnmatch, glob, json, os, re, shlex, sys, tempfile

class ParseError(Exception):
    pass

ROOTV = {'sudo', 'doas', 'su', 'runuser', 'pkexec', 'sudoedit'}
POWERV = {'reboot', 'shutdown', 'poweroff', 'halt', 'kexec'}
POWERSUB = {'reboot', 'poweroff', 'halt', 'kexec', 'suspend', 'hibernate', 'hybrid-sleep', 'suspend-then-hibernate',
            'rescue', 'emergency', 'isolate', 'default'}
# `systemctl start reboot.target` is a reboot by its unit's name (perms' read of 600963af)
POWERTGT = re.compile(r'(reboot|poweroff|halt|kexec|shutdown|suspend|hibernate|hybrid-sleep|suspend-then-hibernate|sleep|'
                      r'rescue|emergency|ctrl-alt-del|exit|soft-reboot)\.target')

# …and the same call made over D-Bus: logind's or systemd's Reboot, PowerOff, Halt, KExec, Suspend… method, or a
# StartUnit of one of those targets, sent with dbus-send, busctl, gdbus or qdbus (perms' read of #1221). A target
# counts only beside a method that starts a unit (StartUnit, a unit object's Start, EnqueueUnitJob…), so CanReboot,
# GetUnit reboot.target and the like are reads, and pass.
DBUSV = {'dbus-send', 'busctl', 'gdbus', 'qdbus', 'qdbus6'}
DBUSPOW = re.compile(r'(?<![A-Za-z])(Reboot|PowerOff|Halt|KExec|Suspend|Hibernate|HybridSleep|SuspendThenHibernate|Sleep|'
                     r'SoftReboot|ScheduleShutdown)(WithFlags)?$')
DBUSSTART = re.compile(r'(?<![A-Za-z])(Start|Restart|TryRestart|ReloadOrRestart|ReloadOrTryRestart|Enqueue)'
                       r'(Unit|UnitReplace|UnitWithFlags|TransientUnit|UnitJob|Job)?$')

def power(v, a):   # a reboot, halt, suspend or target switch, by its verb, its systemctl subcommand or its unit
    first = next((x for x in a if not x.startswith('-')), '')
    tgt = first not in ('status', 'show', 'cat', 'list-dependencies', 'list-units', 'is-active', 'is-enabled', 'help') \
        and any(POWERTGT.fullmatch(x) for x in a)   # a read of the unit passes
    bus = v in DBUSV and any('login1' in x or 'systemd1' in x for x in a) \
        and (any(DBUSPOW.search(x) for x in a) or any(DBUSSTART.search(x) for x in a)
             and any(POWERTGT.search(x.replace('_2e', '.')) for x in a))   # a unit's object path escapes its dot
    return v in POWERV or (v in ('systemctl', 'loginctl') and (bool(POWERSUB & set(a)) or tgt)) or bus \
        or (v in ('init', 'telinit') and first in ('0', '1', '6', 's', 'S'))
NETUNIT = re.compile(r'(NetworkManager|hostapd|wpa_supplicant|systemd-networkd|iwd|dnsmasq)(@[^.]*)?(\.service|\.socket)?')
UNITSTOP = {'stop', 'disable', 'mask', 'kill', 'restart', 'try-restart', 'reload-or-restart', 'try-reload-or-restart', 'force-reload'}
INTERP = re.compile(r'(python[0-9.]*|pypy[0-9.]*|perl[0-9.]*|ruby[0-9.]*|node|nodejs|deno|bun|php[0-9.]*)')
# what runs code from the directory it starts in: imports from the cwd (python puts '' first on sys.path for -c and
# -m), a Makefile, a package manifest, a test collector, or an EDA tool's own script language (ngspice `shell`, yosys
# and magic tcl). A seat that ran ece298a's PLL gate.py by hand on the host ran member code as the box's own user.
MEMCWD = {'make', 'gmake', 'pytest', 'py.test', 'tox', 'nox', 'npm', 'npx', 'yarn', 'pnpm', 'cargo', 'go', 'uv', 'pip',
          'pip3', 'poetry', 'hatch', 'ngspice', 'xyce', 'Xyce', 'yosys', 'iverilog', 'vvp', 'verilator', 'magic', 'netgen',
          'klayout', 'xschem', 'openroad', 'openlane', 'librelane', 'tclsh', 'wish', 'cocotb-config'}
MEMOPT = {'-o', '+o', '-O', '+O', '--rcfile', '--init-file', '-W', '-X', '-Q', '-r', '--require'}   # take a value

def meminline(v, x):   # does option x make v run inline code (or a module), so it names no script file
    if x.startswith('--'): return x.split('=', 1)[0] in ('--eval', '--print', '--command')
    if v in SHELLS: return 'c' in x[1:]
    m = re.match(r'[a-z]+', v)
    f = {'python': 'cm', 'pypy': 'cm', 'perl': 'eE', 'ruby': 'e', 'node': 'ep', 'nodejs': 'ep', 'bun': 'e', 'php': 'r'}.get(m.group() if m else '', '')
    return bool(f) and bool(re.match(r'-[A-Za-z]*?[%s]' % f, x))
# make's options read the way GNU make's getopt reads them (the review of #1496: `-C<dir>`, `-sC<dir>`, `--directory=<dir>`
# got past a check that matched only the detached `-C <dir>`). Short options cluster (`-sC dir`, `-sCdir`); one that takes
# a value takes the rest of its word, or else the next word; a long option may be any unique prefix (`--dir=`)
MKSHORT = {'C': 'C', 'f': 'f', 'I': 'I', 'E': '', 'o': '', 'W': ''}   # take a value: C/f/I name a directory or makefile
MKOPTV = 'jlO'   # an optional value, attached only (`-j4`); a detached `-j 4` is a separate number, never a path
MKLONG = {'directory': 'C', 'file': 'f', 'makefile': 'f', 'include-dir': 'I', 'eval': '', 'old-file': '',
          'assume-old': '', 'what-if': '', 'new-file': '', 'assume-new': '', 'jobserver-auth': '', 'jobserver-style': ''}

def makepaths(a):   # [(kind, value, as typed)] for each -C (C), makefile (f) or include directory (I) make's argv names
    out, k = [], 0
    while k < len(a):
        x = a[k]; k += 1
        if x == '--': break
        if x.startswith('--'):
            n, eq, val = x[2:].partition('=')
            hit = [o for o in MKLONG if o == n] or [o for o in MKLONG if n and o.startswith(n)]
            if not hit: continue
            # an ambiguous prefix is an error to make; reading it as each candidate only ever refuses more
            if not eq and k < len(a): val, k = a[k], k + 1
            out += [(MKLONG[o], val, x if eq else f'{x} {val}') for o in hit if MKLONG[o]]
        elif x.startswith('-') and len(x) > 1:
            for i, c in enumerate(x[1:], 1):
                if c in MKOPTV: break
                if c in MKSHORT:
                    val = x[i + 1:]
                    if not val and k < len(a): val, k = a[k], k + 1
                    if MKSHORT[c]: out.append((MKSHORT[c], val, x if x[i + 1:] else f'{x} {val}'))
                    break
    return out
HANDLE = re.compile(r'[a-z0-9][a-z0-9-]*')
AWKS = {'awk', 'gawk', 'mawk', 'nawk', 'busybox-awk'}
SEATLAB = "the permission seat's state"
FW = {'iptables', 'ip6tables', 'iptables-nft', 'iptables-legacy', 'ip6tables-nft', 'ip6tables-legacy',
      'iptables-restore', 'ip6tables-restore', 'nft', 'ufw', 'firewall-cmd', 'ebtables', 'arptables'}
PART = {'fdisk', 'sfdisk', 'gdisk', 'sgdisk', 'cfdisk', 'cgdisk', 'parted', 'wipefs', 'mkswap', 'mke2fs', 'cryptsetup',
        'lvm', 'pvcreate', 'pvremove', 'pvresize', 'pvmove', 'vgcreate', 'vgremove', 'vgextend', 'vgreduce', 'lvcreate',
        'lvremove', 'lvresize', 'lvextend', 'lvreduce', 'mdadm', 'blkdiscard', 'tune2fs', 'resize2fs'}
NET = {'ip', 'nmcli', 'iw', 'iwconfig', 'wpa_cli', 'wpa_supplicant', 'netplan', 'ifconfig', 'ifup', 'ifdown', 'ethtool',
       'route', 'dhclient', 'rfkill', 'hostapd', 'hostapd_cli', 'tc', 'brctl', 'bridge', 'nmtui', 'networkctl'} | FW
CONT = {'docker', 'podman', 'nerdctl', 'docker-compose', 'podman-compose', 'ctr'}
HARD = ROOTV - {'su'} | POWERV | FW | PART | CONT | {'nmcli', 'wpa_cli', 'netplan'}
SSHHARD = ROOTV | POWERV | FW | PART | CONT | {'systemctl', 'ip', 'nmcli', 'netplan'}
RUNS = re.compile(r'\b(system|popen|Popen|subprocess|exec\w*|spawn\w*|run|call|check_output|check_call|getoutput|passthru|proc_open'
                  r'|open[23]|capture[23]\w*)\s*\(|`|\bqx\b|\bOpen3\b|\bopen\b[^;\n]*\|')   # …and a perl/ruby open of a |pipe
TMUXRUN = {'new', 'new-session', 'new-window', 'neww', 'split-window', 'splitw', 'respawn-pane', 'respawnp', 'respawn-window',
           'respawnw', 'run-shell', 'run', 'display-popup', 'popup', 'if-shell', 'if', 'pipe-pane', 'pipep'}
TMUXVAL = {'-t', '-c', '-n', '-s', '-e', '-F', '-x', '-y', '-l', '-p', '-L', '-S', '-f', '-N', '-T', '-w', '-b', '-E', '-H', '-M'}
CMDVAR = re.compile(r'(GIT_)?(SSH_COMMAND|SSH|PAGER|EDITOR|SEQUENCE_EDITOR|ASKPASS|EXTERNAL_DIFF|PROXY_COMMAND)|SYSTEMD_PAGER|MANPAGER|'
                    r'VISUAL|SSH_ASKPASS|LESSOPEN|LESSCLOSE|BROWSER|PROMPT_COMMAND|BASH_ENV|ENV')
CMDCFG = re.compile(r'core\.(pager|editor|sshcommand|askpass|fsmonitor)|pager\..*|sequence\.editor|(diff|merge)\..*\.(command|cmd)|'
                    r'(gpg|credential)\.(program|helper)|.*\.(textconv|clean|smudge|process)', re.I)
READERS = {'cat', 'tac', 'nl', 'head', 'tail', 'sed', 'cut', 'grep', 'tee', 'sort', 'uniq'} | AWKS   # print a file's lines
SHELLS = {'bash', 'sh', 'zsh', 'dash', 'ksh', 'ash', 'mksh', 'rbash'}
# run what sits in the directory they are pointed at (the cwd, -C/--prefix/--cwd or a path argument): a member's build
# files and tests are its code
# per interpreter family: (the options whose value is code, so nothing on disk runs; the options that take the next word)
MEMOPTS = {'sh': ({'-c'}, {'-o', '+o', '-O', '+O', '--rcfile', '--init-file'}),
           'python': ({'-c'}, {'-W', '-X'}),
           'perl': ({'-e', '-E'}, set()),
           'ruby': ({'-e'}, {'-r', '-I', '-C', '-E'}),
           'node': ({'-e', '--eval', '-p', '--print'}, {'-r', '--require', '--import', '--loader', '--experimental-loader',
                                                       '-C', '--conditions', '--input-type'}),
           'php': ({'-r', '-B', '-R', '-E'}, {'-d', '-c', '-z'})}
RUNNERS = {'make', 'gmake', 'npm', 'npx', 'yarn', 'pnpm', 'pytest', 'py.test', 'tox', 'nox', 'cargo', 'just'}
def fdof(x):   # the descriptor a script operand reads (`-`, /dev/stdin, /dev/fd/N, /proc/self/fd/N, //dev/./stdin), or None
    m = re.fullmatch(r'-|/dev/stdin|/dev/fd/(\d+)|/proc/self/fd/(\d+)', x if x == '-' else re.sub('/+', '/', os.path.normpath(x)))
    return m and str(int(m.group(1) or m.group(2) or 0))
WRAP = {'env': set(), 'timeout': {'-s', '--signal', '-k', '--kill-after'}, 'nice': {'-n', '--adjustment'},
        'ionice': {'-c', '-n', '-p', '-P', '-u', '--class', '--classdata'}, 'stdbuf': {'-i', '-o', '-e'},
        'nohup': set(), 'setsid': set(), 'time': {'-f', '--format', '-o', '--output'}, 'command': set(),
        'builtin': set(), 'exec': {'-a'}, 'chrt': set(), 'taskset': set(), 'busybox': set(), 'toybox': set(),
        'xargs': {'-a', '-d', '-E', '-I', '-L', '-n', '-P', '-s', '--arg-file', '--delimiter', '--max-args', '--max-procs'},
        'parallel': {'-a', '-d', '-I', '-j', '-n', '-N', '-S', '--arg-file', '--delimiter', '--jobs', '--joblog', '--max-args', '--sshlogin'},
        'flock': {'-w', '-E', '--timeout', '--conflict-exit-code'}, 'watch': {'-n', '--interval'},
        'systemd-run': {'-u', '--unit', '-p', '--property', '-E', '--setenv', '-M', '--machine', '-H', '--host',
                        '--description', '--slice', '--uid', '--gid', '--nice', '--working-directory'},
        'unshare': {'-S', '-G', '-R', '-w', '--setuid', '--setgid', '--root', '--wd'},
        # nsenter's -r and -w take a directory only when it is attached (-r/x, --root=/x): `nsenter -t 1 -r reboot`
        # runs the reboot, so neither eats the next word (perms' read of #1221)
        'nsenter': {'-t', '--target', '-S', '-G', '--setuid', '--setgid'},
        'chroot': {'--userspec', '--groups'},   # …and chroot runs what follows its new root (perms' read of #1221)
        'unbuffer': set(), 'torify': set(), 'torsocks': set()}
RUNOPT = {'man': ('-P', '--pager'), 'sort': ('--compress-program',), 'rg': ('--pre',), 'ag': ('--pager',), 'ack': ('--pager',),
          'wget': ('--use-askpass',), 'split': ('--filter',), 'less': ('--lesskey-src',)}   # an option whose value a tool runs
EXPN = re.compile(r'\$\{[^}]*\}|\$\w+|\$[@*#?$!-]')
KW = {'!', 'if', 'then', 'else', 'elif', 'fi', 'do', 'done', 'while', 'until', '{', '}', 'esac', 'function', 'coproc'}
WRITEV = {'cp', 'mv', 'ln', 'install', 'rsync', 'tee', 'dd', 'sed', 'perl', 'truncate', 'rm', 'rmdir', 'unlink',
          'shred', 'touch', 'mkdir', 'chmod', 'chown', 'chgrp', 'curl', 'wget', 'find', 'git'}
TOOLS = {'service', 'gh', 'claude', 'cc', 'cc-loop', 'cc-room', 'cc-handoff', 'lander-self', 'cc-try', 'cc-config', 'cc-settings',
         'cc-slack', 'cc-broker', 'cc-publish', 'cc-arch', 'cc-land', 'lander', 'tmux', 'pkill', 'killall', 'systemctl', 'loginctl', 'eval'}
GATED = ROOTV | POWERV | FW | PART | NET | CONT | SHELLS | set(WRAP) | WRITEV | TOOLS
GITW = {'add', 'am', 'apply', 'checkout', 'cherry-pick', 'clean', 'commit', 'merge', 'mv', 'pull', 'rebase', 'reset',
        'restore', 'revert', 'rm', 'stash', 'switch', 'worktree', 'submodule', 'update-ref', 'symbolic-ref', 'init', 'clone'}
LAUNCHERS = {'claude', 'cc', 'cc-loop', 'cc-room', 'cc-handoff', 'npx', 'bunx', 'node', 'codex'}
PROTKEY = re.compile(r'(CC_PROTECTED_PATHS_\w*|SLACK_OWNER_ID|CC_LAND_REVIEW\w*|CC_CLAUDE|CC_CODEX)(=|$)')
ASSIGN = re.compile(r'[A-Za-z_]\w*(\[[^]]*\])?\+?=')
BLOCKDEV = re.compile(r'/dev/(sd[a-z]|nvme\d|mmcblk\d|vd[a-z]|xvd[a-z]|hd[a-z]|md\d|dm-|mapper/|disk/|loop\d)')
DEPLOYV = {'vercel', 'netlify', 'fly', 'flyctl', 'heroku', 'kubectl', 'terraform', 'ansible', 'aws', 'gcloud', 'az'}
HELP = {'-h', '--help', 'help'}
ROOTOPT = {'-u', '-g', '-h', '-p', '-C', '-D', '-r', '-t', '-U', '-T', '--user', '--group', '--host', '--prompt', '--chdir',
           '--role', '--type', '--other-user', '--command-timeout'}   # sudo's options that take a value
SSHOPT = {'-b', '-c', '-D', '-E', '-e', '-F', '-I', '-i', '-J', '-L', '-l', '-m', '-O', '-o', '-p', '-Q', '-R', '-S', '-W', '-w', '-B'}
SECBASE = re.compile(r'\.?credentials\.json|[^/]*\.token')
WLOGIN = ('WORKER_CLAUDE_CREDENTIALS', '/.claude-workers/.credentials.json')   # the workers' login, by key and by path under ~
# gh's own commands. An alias or an extension runs whatever it was set to (`gh alias set x 'api -X POST …'`), so a
# subcommand off this list is refused, and so are alias set and import (perms' read of 9bf1d03b). `co` is not gh's own
