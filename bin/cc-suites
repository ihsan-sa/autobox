#!/usr/bin/env bash
# cc-suites — the box's long test suite (tests/selftest.sh): reap the runs nobody owns any more, and send every run
# to a runner on another machine (the owner's laptop) FIRST, whenever that answers free and fit (owner, 2026-09-25:
# offload as much as possible); the box runs a suite only when the runner cannot take it or brings back no pass.
#
#   cc-suites reap [--dry]        kill every selftest.sh run whose owner or log is gone (below). One line per run it
#                                 kills, nothing when there is none. exit 0
#   cc-suites spill SUITE [ARG…]  run SUITE on the runner in ~/.cc/suites/remote if that answers and has a free slot:
#                                 ship the tree SUITE's checkout would commit, stream the run's output here, and on a
#                                 pass exit 0 after filing the green record a local pass would have.
#                                 exit 75 when nothing ran there: no runner set, not reachable, busy or unfit. The
#                                 caller runs the suite itself and may offer it again later.
#                                 exit 76 when it ran there and no pass came back: the connection ended (lid shut) or
#                                 ran out of time before a verdict, or the verdict was RED and could not be finished
#                                 here (FINISH HERE below). The caller runs the suite
#                                 itself and does not offer it again. A red there is never a red here on its own: the
#                                 laptop is not the box (2026-09-25, a live run came back 481 passed, 7 failed, every
#                                 red a gap in the runner's environment), so only this box's own run can fail a landing.
#   cc-suites status              the runner this box would use, and what it answers. exit 0 reachable, 75 not
#   cc-suites runner              the runner's side, on the other machine: the forced command of the key, reading
#                                 SSH_ORIGINAL_COMMAND (`status`, `run SUITE TREE PART CHANGED-B64`, or the lander's
#                                 one check, `job CHECK TREE CAP RUN-B64 CWD-B64 [net]`) and a tar on stdin
#   cc-suites laptop-setup [NODE] print the PowerShell script the owner runs once on a Windows laptop (below), and on
#                                 this box make the key and point ~/.cc/suites/remote at ccsuite@NODE
#                                 (default cc-suites-runner, the tailnet name the script gives the runner)
#   cc-suites selfcheck           fixtures of its own: a scratch runner reached through a stub transport, fake runs
#                                 in a temp dir. It never reads this box's processes outside that dir, nor its keys
#
# WHY. On 2026-09-25 at 19:52Z ten suites and three orphans ran on six cores (load 45-56) and a landing waited 86 min
# on its own run. The suite already capped itself (selftest.sh's slots, two thirds of the cores); what broke the cap
# was ORPHANS — a suite whose holder shell died and freed the slot while the suite ran on, unowned, into a log file
# already deleted. selftest.sh now makes the suite die with its holder (PR_SET_PDEATHSIG), and this reaps the ones
# that got away before that, or in some way that does not.
#
# AN ORPHAN is a process running bash on a …/tests/selftest.sh, of this user, where any of these holds:
#   owner gone   CC_SELFTEST_HELD (the pid of the holder shell that took its slot) names a process that is gone
#   log gone     its stdout is a file that has been deleted
#   tree gone    the suite file it runs has been deleted (its worktree was removed)
# It gets a TERM (its EXIT trap takes its fixtures down) and, 10 s on, a KILL for it and every descendant left.
# A run that is only WAITING for a slot holds nothing and is never reaped for waiting.
#
# THE RUNNER. A verdict from another machine counts only for the exact tree it ran: this ships `git archive` of the
# tree green_tree names, the runner commits what it unpacked and refuses unless its own tree hash is that one, and it
# ends on `cc-suite-runner: verdict exit=N tree=T`. Every line the SUITE prints reaches the box prefixed `| ` (the
# runner relays it), and the runner kills the suite's whole process group before it prints the verdict, so no suite
# line, and no child a suite leaves behind, can pass for one. The box accepts exactly one unprefixed
# `cc-suite-runner: verdict` line, as the last line, naming exit=N and the tree it shipped; anything else (a second
# verdict, the lid shut, the tailnet dropped) is no verdict at all and the suite runs here instead.
# What goes over: `git archive` of the tree under test, which is the WHOLE repository at that tree, a private overlay
# (its docs, config and private tools) included, so the runner's account can read all of it; and CC_SUITE_PART /
# CC_LAND_CHANGED; for the lander's `job`, the same tree and the check's own run line and directory (runner_job).
# No environment variable, token or key of this box's, and nothing outside that repository. The key (~/.cc/suites/id_ed25519) is this tool's alone and the runner's authorized_keys pins it to
# `cc-suites runner` with `restrict`, so it opens no shell, forwards nothing and runs nothing else.
# The runner takes at most N runs at once and answers `free 0` past that. N is the number in the runner's own
# ~/.cc-suite-runner/slots (1..32) if there is one, else about one per 8 of its cores (1..8; 22 cores → 3), so the
# suites take about half the machine: one run peaks near 4 busy cores (a serial main line plus the 3 selfchecks
# it prefetches at once), and 13 runs on the box's 6 cores held a load of 45-56 on 2026-09-25, about 4 each.
# READY. The runner also answers `unfit (…)` while a tool the suite needs is missing or does not work there
# (RUNNER_NEEDS below, bwrap by actually running it): a machine that would fail the suite for want of a tool takes none.
# It answers unfit too while its python3 or shellcheck is older than the box's (FLOOR, which laptop-setup writes and
# brings the laptop up to): a laptop pass is final for the lander's static, hermetic and host checks, so an older tool
# there could pass what the box would fail.
# THE OWNER'S LAPTOP COMES FIRST. The runner also answers busy, and starts nothing, while its 1-minute load is above
# a bound (battery does not matter: the owner wants it to run no matter what, and status only reports ac=0|1): the number in the runner's own ~/.cc-suite-runner/maxload if it holds
# a positive one (the same way slots reads its own file), else half its cores. A run it does start is `nice -n 19`
# and idle-class I/O.
# Both sides bound a run in wall-clock time: the runner stops the suite after CC_SUITES_RUNNER_TIMEOUT (85m) and
# gives no verdict, and the box stops waiting after CC_SUITES_SPILL_TIMEOUT (90m) and runs the suite itself (76).
# FINISH HERE. A runner red whose every red is a tool's own selfcheck (`  ✗ cc-foo selfcheck: …`, as many such lines
# as the suite's closing tally counts failed, and that tally its last line) is not a whole suite to run again: this
# box runs just those selfchecks — each only if the suite runs it through `chk`, and with the flags the suite exports
# (CC_NOTIFY_LOG_ONLY=1 and the rest), so a re-run from a landing cannot reach the owner — by the same judge chk uses (the tool's tally reads `0 failed`, a second try allowed
# for load), and their pass here with the rest's pass there is the pass, filed as one. The case this is for: the
# laptop has no bwrap, so cc-sandbox's selfcheck is red on every run there (2026-09-26/27, 8 runs of 8), and the box
# ran all ~500 cases again for that one. Anything else in the red — an inline case, a tool's inner ✗ lines, a tally
# that does not add up — and nothing is finished here: 76, as before. A tool red here too is 76 as well, so the red a
# landing can fail on is still only ever this box's own run of the whole suite.
# Every line spill ends on says how long the runner had the run, so the runner's seconds can be set beside the box's.
# The runner's host key is made here by laptop-setup, pinned in ~/.cc/suites/known_hosts (StrictHostKeyChecking=yes)
# and its private half handed over in the script only, never kept on this box.
#
# THE LAPTOP (laptop-setup). A WSL distro of its own (cc-suites), so its settings touch nothing the owner uses:
# systemd on, Windows interop and the C: mount OFF (a process there cannot start a Windows program or read the
# owner's files), its own Tailscale node, sshd taking only the key above, only from the tailnet, only as ccsuite.
# The box's python3 (major.minor) and shellcheck, or newer: from the deadsnakes PPA and shellcheck's own release (its
# sha256 pinned here, SHELLCHECK_SUMS) when the distro's are older, and written to FLOOR, root's.
# ccsuite owns nothing that decides what it runs or says: the runner, its home, .ssh and authorized_keys are root's,
# its shell reads no rc file, and whatever it runs is caged (THE CAGE, below), so a PR's code cannot change a later
# verdict. Each run of the script wipes and remakes that home, keeping its slots and maxload. A logon task keeps the distro running while the owner is logged in. Closed or asleep, the node drops off the
# tailnet, `spill` answers 75 inside its connect timeout, and the box queues exactly as it did before.
set -uo pipefail
SELF="$(readlink -f "$0")"; BIN="$(dirname "$SELF")"; CORE="$(cd "$BIN/.." && pwd)"
SD="${CC_SUITES_DIR:-$HOME/.cc/suites}"            # remote (user@host), id_ed25519, known_hosts
RUNNER_DIR="${CC_SUITES_RUNNER_DIR:-$HOME/.cc-suite-runner}"   # the runner's slots and scratch trees, on its machine
USAGE="usage: cc-suites [reap [--dry]|spill SUITE [ARG…]|status|runner|laptop-setup [NODE]|selfcheck]"
ALLOWED_SUITES="core/tests/selftest.sh tests/selftest.sh"
SUITE_RE='(^|/)tests/selftest\.sh$'

# ---- reap ---------------------------------------------------------------------------------------------------------
descendants(){ ps -eo pid=,ppid= | awk -v root="$1" '{kid[$2]=kid[$2] " " $1} END {n=split(kid[root],q," "); while (n) {p=q[n--]; print p; m=split(kid[p],c," "); for (i=1;i<=m;i++) q[++n]=c[i]}}'; }
orphan_why(){   # $1 = pid → why it is an orphan, or nothing
  local p=$1 held out
  held=$(tr '\0' '\n' 2>/dev/null <"/proc/$p/environ" | sed -n 's/^CC_SELFTEST_HELD=//p' | head -1)
  if [ -n "$held" ] && [ "$held" != "$p" ] && ! kill -0 "$held" 2>/dev/null; then echo "its slot holder $held is gone"; return; fi
  out=$(readlink "/proc/$p/fd/1" 2>/dev/null)
  case $out in /*' (deleted)') echo "its log ${out% (deleted)} was deleted"; return;; esac
  [ -e "$2" ] || { echo "its suite file $2 was deleted"; return; }   # $2 is absolute: reap resolved it from the run's cwd
}
reap(){
  local dry=${1:-} me pid bin script why kids k under=${CC_SUITES_REAP_UNDER:-}
  me=$(id -u)
  while read -r pid bin script; do
    [ "$pid" != "$$" ] || continue
    case $bin in bash|*/bash) ;; *) continue;; esac
    [[ $script =~ $SUITE_RE ]] || continue
    # a relative path is the run's own, so it is resolved from ITS cwd, never from this one (`cd core && tests/selftest.sh`)
    case $script in /*) ;; *) script="$(readlink "/proc/$pid/cwd" 2>/dev/null)/$script";; esac
    [ -z "$under" ] || case $script in "$under"/*) ;; *) continue;; esac
    why=$(orphan_why "$pid" "$script"); [ -n "$why" ] || continue
    if [ -n "$dry" ]; then echo "cc-suites: would reap $pid ($script) — $why"; continue; fi
    kids=$(descendants "$pid")
    kill -TERM "$pid" 2>/dev/null || continue
    echo "cc-suites: reaped $pid ($script) — $why"
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    for k in $pid $kids; do kill -KILL "$k" 2>/dev/null; done
  done < <(ps -u "$me" -o pid=,args= | awk '{print $1, $2, $3}')
  return 0
}

# ---- the transport ------------------------------------------------------------------------------------------------
remote(){ [ -s "$SD/remote" ] && head -1 "$SD/remote" | tr -d '[:space:]'; }
xport_argv(){   # sets XP to the transport command. CC_SUITES_SSH replaces ssh for the selfcheck
  if [ -n "${CC_SUITES_SSH:-}" ]; then XP=("$CC_SUITES_SSH"); return 0; fi
  local r; r=$(remote); [ -n "$r" ] && [ -s "$SD/id_ed25519" ] && [ -s "$SD/known_hosts" ] || return 75
  # The host key is the one laptop-setup made and pinned: an unknown or changed key is no runner.
  XP=(ssh -F /dev/null -i "$SD/id_ed25519" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=8
      -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o StrictHostKeyChecking=yes
      -o UserKnownHostsFile="$SD/known_hosts" -o GlobalKnownHostsFile=/dev/null -o ClearAllForwardings=yes
      -o KexAlgorithms=curve25519-sha256   # the post-quantum kex packet is dropped on the tailnet path (MTU): ssh stalls at ECDH_REPLY
      -a -x -T -C "$r" --)
}
xport(){ xport_argv || return 75; "${XP[@]}" "$@"; }   # $@ = the remote command; stdin goes with it
configured(){ [ -n "${CC_SUITES_SSH:-}" ] || { [ -n "$(remote)" ] && [ -s "$SD/id_ed25519" ] && [ -s "$SD/known_hosts" ]; }; }
# A wall-clock bound in timeout(1)'s form (90m, 2s); anything else is the default.
limit(){ local v=${1:-}; [[ $v =~ ^[0-9]+[smh]?$ ]] && [ "${v%[smh]}" != 0 ] && echo "$v" || echo "$2"; }

status(){
  configured || { echo "cc-suites: no runner set ($SD/remote) — every suite runs here"; return 75; }
  local a; local -a XP; xport_argv || return 75
  a=$(timeout "$(limit "${CC_SUITES_STATUS_TIMEOUT:-}" 20s)" "${XP[@]}" status </dev/null 2>/dev/null | tail -1)
  case $a in "free "*) echo "cc-suites: runner $(remote) answers: $a"; return 0;;
                      "busy"*|"unfit"*) echo "cc-suites: runner $(remote) answers: $a — every suite runs here for now"; return 75;;
             *) echo "cc-suites: runner $(remote) does not answer${a:+ ($a)}"; return 75;; esac
}

# ---- spill --------------------------------------------------------------------------------------------------------
# The verdict in a runner's stream ($1), or nothing: exactly one unprefixed `cc-suite-runner: verdict` line, it is the
# last line, and it reads exit=N tree=<40 hex>. Two of them (one forged by the suite, one real) is none.
verdict_of(){
  local vs last
  vs=$(grep -a -v '^| ' "$1" | grep -a '^cc-suite-runner: verdict'); last=$(tail -n 1 "$1")
  [ -n "$vs" ] && [ "$(printf '%s\n' "$vs" | wc -l)" = 1 ] && [ "$vs" = "$last" ] || return 0
  [[ $vs =~ ^cc-suite-runner:\ verdict\ exit=[0-9]+\ tree=[0-9a-f]{40}$ ]] && echo "$vs"
}
# The tools a red stream ($1) can be finished with here (FINISH HERE), one per line, or nothing when it cannot: the
# suite's last line is its tally, it counts F >= 1 failed, and the stream holds exactly F case lines of the ✗ shape,
# every one a tool's own selfcheck.
finishable(){
  local last f n t
  last=$(grep -a '^| ' "$1" | tail -n 1)
  [[ $last =~ ^\|\ ==\ result:\ [0-9]+\ passed,\ ([0-9]+)\ failed ]] || return 0
  f=${BASH_REMATCH[1]}; [ "$f" -ge 1 ] || return 0
  n=$(grep -ac '^|   ✗ ' "$1"); t=$(grep -a '^|   ✗ ' "$1" | sed -n 's/^|   ✗ \(cc-[a-z0-9-]*\) selfcheck: .*/\1/p')
  [ "$n" = "$f" ] && [ "$(printf '%s' "$t" | grep -c .)" = "$f" ] || return 0
  printf '%s\n' "$t" | sort -u
}
finish_here(){   # $1 = the suite, $2 = the checkout's bin/, then the tools: 0 when each one's own selfcheck passes here
  local s=$1 b=$2 t o r try; shift 2
  for t in "$@"; do
    [ -x "$b/$t" ] || { echo "== $t is not a tool in this checkout — not finished here =="; return 1; }
    # only a tool the suite runs through chk: an inline case of the same shape (cc-slack's, with its own scratch
    # CC_SLACK_DIR) gets an environment from the suite that this bare run would not give it
    grep -qE "^chk $t([[:space:]]|\$)" "$s" || { echo "== $t's selfcheck is not a chk case in the suite — not finished here =="; return 1; }
    for try in 1 2; do   # chk's rule: red once beside a loaded box is run once more, and judged again
      # the environment chk gives it: the suite's own unset, then its own exports (selftest.sh's head), never-push first
      o=$( for v in "${!CC_@}"; do case $v in CC_LAND_CHANGED|CC_GREEN_DIR) ;; *) unset "$v";; esac; done
           export CC_NOTIFY_LOG_ONLY=1 CC_LIMIT_MIN_WAIT=1 CC_SPEND_TIER=autonomous
           "$b/$t" selfcheck 2>&1 </dev/null )
      r=$(grep -o "$t selfcheck: .*" <<<"$o" | tail -1)
      grep -qE '(: |, )0 failed' <<<"$r" && break
      r="${r:-no tally} (try $try)"
    done
    echo "== finished here: $r =="
    grep -qE '(: |, )0 failed' <<<"$r" || return 1
  done
}
spill(){
  local suite root rel tree part changed out a rc v lim took tools
  local -a XP
  suite=$(readlink -f "${1:-}" 2>/dev/null) || return 75; shift
  configured || return 75
  root=$(cd "$(dirname "$suite")" && git rev-parse --show-toplevel 2>/dev/null) || return 75
  rel=${suite#"$root"/}
  case " $ALLOWED_SUITES " in *" $rel "*) ;; *) return 75;; esac
  [ "$#" = 0 ] || return 75          # the runner takes no arguments for the suite; a run that has some stays here
  xport_argv || return 75
  a=$(timeout "$(limit "${CC_SUITES_STATUS_TIMEOUT:-}" 20s)" "${XP[@]}" status </dev/null 2>/dev/null | tail -1)   # a runner that answers nothing in 20 s is none
  case $a in "free "[1-9]*) ;; *) return 75;; esac
  # green.sh's start tree is taken HERE, as it is sourced, and names the suite: the tree shipped is that tree, and
  # green_record below refuses to file anything if the checkout moved while the runner ran it.
  part=${CC_SUITE_PART:-all}   # taken BEFORE green.sh, which unsets CC_SUITE_PART as it is sourced
  SELF=$suite; . "$CORE/tests/green.sh"
  tree=$GREEN_START_TREE; [ -n "$tree" ] && [ "$GREEN_START_ROOT" = "$root" ] || return 75
  changed=$(printf '%s' "${CC_LAND_CHANGED:-}" | base64 -w0); changed=${changed:--}
  out=$(mktemp "${TMPDIR:-/tmp}/cc-suites.out.XXXXXX") || return 75
  lim=$(limit "${CC_SUITES_SPILL_TIMEOUT:-}" 90m)
  echo "== running on the runner $(remote) (tree ${tree:0:12}), not here: it answered free and fit =="
  # Bounded: a runner that stays up while the suite hangs must not hold this box. Past $lim the transport is killed
  # (its whole group), which is no verdict, and the suite runs here.
  # What the suite printed comes over prefixed `| `; the log here shows it without the prefix, and the verdict is
  # read from the stream as it came ($out), where only the runner's own lines are unprefixed.
  SECONDS=0
  git -C "$root" archive --format=tar "$tree" | timeout -k 10 "$lim" "${XP[@]}" run "$rel" "$tree" "$part" "$changed" \
    | tee "$out" | sed -u 's/^| //'
  rc=${PIPESTATUS[1]}; took=$SECONDS
  case $rc in 124|137) echo "== the runner took longer than $lim — stopped it ==";; esac
  v=$(verdict_of "$out")
  # "A laptop verdict counts only for the exact tree it ran" (the brief): no verdict line, or one for another tree, is none.
  if [ -z "$v" ] || [ "${v##* tree=}" != "$tree" ]; then
    rm -f "$out"
    echo "== the runner gave no verdict for ${tree:0:12} after ${took}s (transport exit $rc) — running it here instead =="
    return 76
  fi
  rc=${v#*exit=}; rc=${rc%% *}
  if [ "$rc" != 0 ]; then
    tools=$(finishable "$out"); rm -f "$out"
    if [ -z "$tools" ]; then
      echo "== the runner's verdict for ${tree:0:12} is red (exit $rc) after ${took}s — a red there fails nothing: running it here =="
      return 76
    fi
    echo "== the runner's verdict for ${tree:0:12} is red (exit $rc) after ${took}s, only in the own selfcheck of: $(echo $tools) — running just that here =="
    # shellcheck disable=SC2086   # one tool per word, by construction (finishable)
    if ! finish_here "$suite" "$(cd "$(dirname "$suite")/../bin" 2>/dev/null && pwd)" $tools; then
      echo "== red here too — running the whole suite here =="
      return 76
    fi
  else rm -f "$out"; echo "== the runner passed ${tree:0:12} in ${took}s =="; fi
  # A pass there is filed as a pass here, at the scope this checkout would have run it at — land_scope is a pure
  # function of the tree and CC_LAND_CHANGED, so it is the scope the runner's own copy printed.
  land_scope "$(cd "$(dirname "$suite")/../bin" 2>/dev/null && pwd)"
  green_record "$suite" "${SCOPE:-}" || return 1
  return 0
}

# ---- runner (the other machine) -----------------------------------------------------------------------------------
slots_for(){ local n=$(( ($1 + 4) / 8 )); [ "$n" -ge 1 ] || n=1; [ "$n" -le 8 ] || n=8; echo "$n"; }   # $1 = cores
runner_slots(){
  local v; v=$(head -1 "$RUNNER_DIR/slots" 2>/dev/null | tr -d '[:space:]')
  if [[ $v =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] && [ "$v" -le 32 ]; then echo "$v"; else slots_for "$(nproc 2>/dev/null || echo 2)"; fi
}
# The runner's own load bound, from ~/.cc-suite-runner/maxload the same way runner_slots reads slots: a positive
# number if it holds one, else nothing (runner_unfit then falls back to half the cores).
runner_maxload(){
  local v; v=$(head -1 "$RUNNER_DIR/maxload" 2>/dev/null | tr -d '[:space:]')
  [[ $v =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v v="$v" 'BEGIN { exit !(v > 0) }' && echo "$v"
}
# What the suite needs of the machine it runs on; a runner missing one is unfit (what laptop-setup installs).
RUNNER_NEEDS="git jq python3 tmux flock setsid timeout nice script sqlite3 bwrap"
# The box's versions of the tools a check's verdict turns on, one `tool version` a line, root's (laptop-setup writes it)
FLOOR="${CC_SUITES_FLOOR:-/etc/cc-suites/floor}"
SHELLCHECK_SUMS="0.11.0=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"   # linux.x86_64.tar.xz
tool_version(){
  case $1 in
    python3) python3 -c 'import sys; print("%d.%d.%d" % sys.version_info[:3])' 2>/dev/null;;
    shellcheck) shellcheck --version 2>/dev/null | awk '/^version:/ { print $2 }';;
  esac
}
runner_older(){   # the tools older here than FLOOR says, as tool(have<want), space-separated, or nothing
  local t v have m=""
  [ -r "$FLOOR" ] || return 0
  while read -r t v _; do
    case $t in python3|shellcheck) ;; *) continue;; esac
    [[ $v =~ ^[0-9]+(\.[0-9]+)*$ ]] || continue
    have=$(tool_version "$t")
    [ "$(printf '%s\n%s\n' "$have" "$v" | sort -V | head -1)" = "$v" ] || m="$m $t(${have:-none}<$v)"
  done < "$FLOOR"
  echo "${m# }"
}
runner_missing(){   # the needs this machine lacks, space-separated, or nothing
  local c m=""
  for c in ${CC_SUITES_RUNNER_NEEDS:-$RUNNER_NEEDS}; do
    command -v "$c" >/dev/null 2>&1 || { m="$m $c"; continue; }
    # bwrap present is not bwrap usable (user namespaces off, or an AppArmor rule against it): cc-sandbox needs it to
    # run, and the cage needs a network namespace of its own, so a bwrap that cannot cut the network does not run either
    [ "$c" != bwrap ] || bwrap --ro-bind / / --dev /dev --proc /proc --unshare-net true >/dev/null 2>&1 || m="$m bwrap(does-not-run)"
  done
  echo "${m# }"
}
# THE CAGE. What the runner runs is a PR's code, and it runs as the runner's own account, which also owns the
# runner's state and whose next login reads its home. So every suite and job runs in bwrap: the whole machine
# read-only, writable only in the directories named (its own scratch tree and HOME), with fresh /tmp, /var/tmp and
# /run/user (no reaching this account's systemd --user or tmux, which would start things outside), RUNNER_DIR
# (slots, maxload, other runs) hidden, and a pid namespace of its own that dies with the runner, so nothing it starts
# outlives it, sees the runner, or signals it. It cannot write /usr/local/bin/cc-suites, the account's home or
# authorized_keys, or any other run's tree, so it cannot change what a later run is told (2026-09-29, the security
# read of #806). No bwrap that runs is `unfit`: nothing runs uncaged.
# NO NETWORK by default: a network namespace of its own with only a loopback, so PR code cannot reach the tailnet,
# the box's services or anything else (2026-09-29, the security read of #807), and a fresh empty /run, since a
# read-only bind still lets a job connect to a Unix socket: a caged job read the tailnet's peers from the VPN
# daemon's socket there (2026-09-30, the security read of #866). A job the lander sends with a
# trailing `net` (its manifest's net = true, which a PR cannot grant itself: manifest.py self_widening) keeps the
# machine's network; a whole suite never does. A check that needed the network and was not given it goes red here,
# and a laptop red is said again on the box (run.py), so a missing opt-in costs box time, never a wrong verdict.
# cage_argv [--net] DIR… sets CG to the bwrap prefix; the command follows it.
cage_argv(){
  local net=""; [ "${1:-}" != --net ] || { net=1; shift; }
  CG=(bwrap --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp --tmpfs /var/tmp)
  # the network cut, /run goes too: a socket there (a VPN daemon's, the system bus) is still reached through the
  # read-only root, and no job without the network needs one; nothing under it is bound back
  if [ -n "$net" ]; then [ ! -d /run/user ] || CG+=(--tmpfs /run/user); else CG+=(--unshare-net --tmpfs /run); fi
  CG+=(--tmpfs "$RUNNER_DIR")
  local d; for d in "$@"; do CG+=(--bind "$d" "$d"); done
  CG+=(--unshare-pid --unshare-ipc --die-with-parent --new-session --)
}
# the needs this machine lacks, the cage first: no override of the needs (CC_SUITES_*_NEEDS) drops bwrap or the FLOOR
needs_missing(){
  local m; m="$(CC_SUITES_RUNNER_NEEDS=bwrap runner_missing) $(CC_SUITES_RUNNER_NEEDS=$1 runner_missing) $(runner_older)"
  m=$(tr -s ' ' <<<"$m"); m=${m# }; echo "${m% }"
}
# Whether the machine is on battery (a Mains supply offline, or a Battery discharging; no power_supply info at all
# counts as on AC, as in a WSL with none). Only status reports it; it never stops a run.
# CC_SUITES_POWER_DIR: the selfcheck.
runner_on_battery(){
  local ps=${CC_SUITES_POWER_DIR:-/sys/class/power_supply} d ty v mains="" ac="" dis=""
  for d in "$ps"/*/; do
    [ -r "$d/type" ] || continue; ty=$(head -1 "$d/type" 2>/dev/null)
    case $ty in
      Mains) mains=1; v=$(head -1 "$d/online" 2>/dev/null); [ "$v" = 1 ] && ac=1;;
      Battery) v=$(head -1 "$d/status" 2>/dev/null); [ "$v" = Discharging ] && dis=1;;
    esac
  done
  [ -n "$dis" ] || { [ -n "$mains" ] && [ -z "$ac" ]; }
}
# Why this machine should take no new run now (loaded), or nothing when it may. The laptop is the owner's, and a suite
# is never worth his work; battery is not a reason. CC_SUITES_LOADAVG: the selfcheck.
runner_unfit(){
  local l1 n mx; n=$(nproc 2>/dev/null || echo 2); mx=$(runner_maxload)
  read -r l1 _ < "${CC_SUITES_LOADAVG:-/proc/loadavg}" 2>/dev/null || return 0
  awk -v l="$l1" -v n="$n" -v mx="$mx" 'BEGIN { b = (mx != "" ? mx + 0 : n / 2); exit !(l + 0 > b) }' && echo "load $l1 on $n cores"
}
# What status adds after its answer, for a person reading `cc-suites status`: `cores=N slots=N maxload=L load=L ac=0|1`.
# The box parses only the leading `free N`, and ac=1 includes "no power supply info". maxload is the bound in force:
# the runner's own file if it set one, else the n/2 default.
runner_facts(){
  local l1="?" ac=1 mx
  read -r l1 _ < "${CC_SUITES_LOADAVG:-/proc/loadavg}" 2>/dev/null || l1="?"
  ! runner_on_battery || ac=0
  mx=$(runner_maxload); mx=${mx:-$(awk -v n="$(nproc 2>/dev/null || echo 2)" 'BEGIN { print n / 2 }')}
  echo "cores=$(nproc 2>/dev/null || echo "?") slots=$(runner_slots) maxload=$mx load=$l1 ac=$ac"
}
runner(){
  local -a a pre; local rel tree part changed i slot t rc why lim rp
  w=""; gp=""; pg=""   # global, not local: the EXIT trap reads them after this function has returned
  # read takes the first line and drops the rest, so a second line (a check name carrying one) could make a job of
  # its own, `net` and all: a command is one line, or it is refused whole before anything runs
  case ${SSH_ORIGINAL_COMMAND:-} in *$'\n'*|*$'\r'*) echo "cc-suite-runner: refused: a command is one line"; return 2;; esac
  read -r -a a <<<"${SSH_ORIGINAL_COMMAND:-}"
  mkdir -p "$RUNNER_DIR"
  case ${a[0]:-} in
    status)
      why=$(needs_missing "${CC_SUITES_RUNNER_NEEDS:-$RUNNER_NEEDS}"); [ -z "$why" ] || { echo "unfit (missing: $why) $(runner_facts)"; return 0; }
      why=$(runner_unfit); [ -z "$why" ] || { echo "busy ($why) $(runner_facts)"; return 0; }
      i=0; for slot in $(seq 1 "$(runner_slots)"); do
        ( flock -n 9 ) 9>>"$RUNNER_DIR/slot.$slot" && i=$((i + 1)); done
      echo "free $i $(runner_facts)"; return 0;;
    run) ;;
    job) runner_job "${a[@]:1}"; return;;
    *) echo "cc-suite-runner: refused: ${a[0]:-nothing}" >&2; return 2;;
  esac
  [ "${#a[@]}" = 5 ] || { echo "cc-suite-runner: refused: run takes SUITE TREE PART CHANGED" >&2; return 2; }
  rel=${a[1]}; tree=${a[2]}; part=${a[3]}; changed=${a[4]}
  case " $ALLOWED_SUITES " in *" $rel "*) ;; *) echo "cc-suite-runner: refused suite $rel" >&2; return 2;; esac
  [[ $tree =~ ^[0-9a-f]{40}$ ]] || { echo "cc-suite-runner: refused tree" >&2; return 2; }
  case $part in all|box|portable) ;; *) echo "cc-suite-runner: refused part" >&2; return 2;; esac
  [[ $changed =~ ^[A-Za-z0-9+/=]+$|^-$ ]] || { echo "cc-suite-runner: refused changed" >&2; return 2; }
  [ "$changed" = - ] && changed="" || changed=$(printf '%s' "$changed" | base64 -d 2>/dev/null) || return 2
  for slot in $(seq 1 "$(runner_slots)"); do
    exec {LK}>>"$RUNNER_DIR/slot.$slot"; flock -n $LK && break; exec {LK}>&-; LK=
  done
  [ -n "${LK:-}" ] || { echo "cc-suite-runner: busy"; return 75; }
  why=$(runner_unfit); [ -z "$why" ] || { echo "cc-suite-runner: busy ($why)"; return 75; }   # changed since status
  why=$(needs_missing "${CC_SUITES_RUNNER_NEEDS:-$RUNNER_NEEDS}"); [ -z "$why" ] || { echo "cc-suite-runner: unfit (missing: $why)"; return 75; }
  w=$(mktemp -d "$RUNNER_DIR/run.XXXXXX") || return 1
  trap 'rc=$?; [ -z "$pg" ] || kill -TERM -- -"$pg" 2>/dev/null; sleep 1; [ -z "$pg" ] || kill -KILL -- -"$pg" 2>/dev/null; [ -z "$w" ] || rm -rf "$w" "$w.home" "$w.relay"; exit $rc' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  # nothing but this shell holds the slot's lock ($LK): every child below closes it, so none can outlive the run holding it
  tar -x -C "$w" -f - --no-same-owner {LK}>&- 2>/dev/null || { echo "cc-suite-runner: the tree did not unpack"; return 1; }
  t=$(exec {LK}>&-; cd "$w" && git init -q && git add -A -f && git write-tree 2>/dev/null) || t=""
  [ "$t" = "$tree" ] || { echo "cc-suite-runner: unpacked tree ${t:-none} is not $tree — refused"; return 1; }
  ( exec {LK}>&-; cd "$w" && git -c user.name=cc-suites -c user.email=cc-suites@localhost commit -qm "tree $tree" --no-verify ) \
    || { echo "cc-suite-runner: could not commit the tree"; return 1; }
  # WHAT A BOX HAS THAT A FRESH ACCOUNT DOES NOT, and the box half of the suite leans on: a tmux session `main` to
  # open windows in, and a ~/.local/bin/claude for the one window (`cc <repo>`) that starts it and must stay up.
  # Every model call in the suite is stubbed by the suite itself (CC_CLAUDE); this stub only waits. Both are made
  # INSIDE the cage, in a HOME of the run's own ($w.home) on a tmux server of its own, so a window the suite opens is
  # caged too and goes with it. CC_SUITES_RUNNER_PREP=0 skips them (selfcheck).
  local prep=""
  mkdir -m 700 "$w.home" || return 1
  [ "${CC_SUITES_RUNNER_PREP:-1}" = 0 ] || prep='mkdir -p "$HOME/.local/bin" "$TMUX_TMPDIR" && chmod 700 "$TMUX_TMPDIR"
printf "#!/bin/sh\n# cc-suites runner stub: the suite stubs every model call; this only keeps a window up\nexec sleep 3600\n" >"$HOME/.local/bin/claude" && chmod +x "$HOME/.local/bin/claude"
tmux new-session -d -s main -x 200 -y 50 2>/dev/null
'
  unset TMUX
  # A clean environment: nothing of this shell's, and CC_SELFTEST_HELD set so the suite takes no slot of its own —
  # this runner's slot is the one it runs in, and it dies with this runner. Lowest CPU and I/O priority, so the
  # owner's own work always goes first, and a wall-clock bound a little inside the box's, so it stops first.
  lim=$(limit "${CC_SUITES_RUNNER_TIMEOUT:-}" 85m)
  pre=(timeout -k 30 "$lim" nice -n 19)
  command -v ionice >/dev/null 2>&1 && ionice -c3 true 2>/dev/null && pre+=(ionice -c3)
  # The suite writes into a fifo and nowhere else; the relay prefixes each of its lines `| `, so nothing the suite
  # prints can pass for a line of this runner's (the verdict).
  mkfifo -m 600 "$w.relay" || { echo "cc-suite-runner: no relay"; return 1; }
  awk '{ print "| " $0; fflush() }' <"$w.relay" {LK}>&- & rp=$!
  cage_argv "$w" "$w.home"
  ( cd "$w" && exec setsid env -i HOME="$w.home" USER="${USER:-$(id -un)}" LOGNAME="${USER:-$(id -un)}" \
      PATH=/usr/local/bin:/usr/bin:/bin LANG=C.UTF-8 TERM=dumb SHELL=/bin/bash TMUX_TMPDIR="$w.home/tmux" \
      CC_SELFTEST_HELD=$$ CC_SUITE_PART="$([ "$part" = all ] || echo "$part")" CC_LAND_CHANGED="$changed" \
      "${pre[@]}" "${CG[@]}" bash -c "${prep}"'exec bash "$0"' "$w/$rel" ) </dev/null {LK}>&- >"$w.relay" 2>&1 &
  gp=$!; pg=$gp   # setsid: its pid is its group
  rc=0; wait "$gp" || rc=$?; gp=""
  # The suite is done: whatever it left in its group goes now, before a verdict is printed (a child it left could
  # otherwise hold the stream open, or print after it). The relay gets 5 s to drain what is left of it, then goes too.
  kill -KILL -- -"$pg" 2>/dev/null
  for _ in $(seq 1 50); do kill -0 "$rp" 2>/dev/null || break; sleep 0.1; done
  kill -KILL "$rp" 2>/dev/null; wait "$rp" 2>/dev/null; rm -f "$w.relay"
  # Out of time is no verdict on the tree: the box runs it itself. Still a `verdict` line, so that one a suite
  # forged some other way makes two, which is none.
  case $rc in 124|137) echo "cc-suite-runner: verdict none — the suite ran past $lim and was stopped"; return 0;; esac
  echo "cc-suite-runner: verdict exit=$rc tree=$tree"
  return 0
}
# The lander's one check (run.py laptop_argv): `job CHECK TREE CAP RUN_B64 CWD_B64 [net]` and the tree as a tar on
# stdin. `net` is the only sixth word taken: the check keeps the network (THE CAGE); without it the job has none.
# The same refusals as a run — no slot or loaded is `cc-suite-runner: busy (…)`, exit 75, and the lander
# reads any exit but 0 as no answer (unrunnable, never red) and runs the check on the box. Each job gets a directory
# and a HOME of its own, proves the tree by write-tree, and both go when it ends. Its lines come back `| `-prefixed,
# then `lander-job: verdict exit=N` (124 past CAP). It runs in the cage (above), writable only in its own directory;
# a host check brings its own tmux `main` in its line (run.py HOST_PREP), inside the cage.
JOB_NEEDS="git tar timeout setsid nice"
runner_job(){
  local name=${1:-} tree=${2:-} cap=${3:-} rb=${4:-} cb=${5:-} net=${6:-} line cwd why slot j t rc
  { { [ "$#" = 5 ] || { [ "$#" = 6 ] && [ "$net" = net ]; }; } && [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]] && [[ $tree =~ ^[0-9a-f]{40}$ ]] && [[ $cap =~ ^[0-9]+$ ]] \
    && [[ $rb =~ ^[A-Za-z0-9+/=]+$ ]] && [[ $cb =~ ^[A-Za-z0-9+/=]+$|^-$ ]]; } \
    || { echo "cc-suite-runner: refused: job CHECK TREE CAP RUN_B64 CWD_B64 [net]"; return 2; }
  line=$(printf '%s' "$rb" | base64 -d 2>/dev/null) && [ -n "$line" ] || { echo "cc-suite-runner: refused: bad encoding"; return 2; }
  if [ "$cb" = - ]; then cwd=""; else cwd=$(printf '%s' "$cb" | base64 -d 2>/dev/null) || { echo "cc-suite-runner: refused: bad encoding"; return 2; }; fi
  case "/$cwd/" in //*|*/../*) [ -z "$cwd" ] || { echo "cc-suite-runner: refused: cwd leaves the tree"; return 2; };; esac
  for slot in $(seq 1 "$(runner_slots)"); do
    exec {LK}>>"$RUNNER_DIR/slot.$slot"; flock -n $LK && break; exec {LK}>&-; LK=
  done
  [ -n "${LK:-}" ] || { echo "cc-suite-runner: busy"; return 75; }
  why=$(runner_unfit); [ -z "$why" ] || { echo "cc-suite-runner: busy ($why)"; return 75; }
  why=$(needs_missing "${CC_SUITES_JOB_NEEDS:-$JOB_NEEDS}")
  [ -z "$why" ] || { echo "cc-suite-runner: unfit (missing: $why)"; return 75; }
  j=$(mktemp -d "$RUNNER_DIR/job.XXXXXX") || return 1; w=$j   # w: the EXIT trap removes it
  trap 'rc=$?; [ -z "$pg" ] || kill -KILL -- -"$pg" 2>/dev/null; [ -z "$w" ] || rm -rf "$w" "$w.log"; exit $rc' EXIT
  trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
  mkdir "$j/tree" "$j/home"
  tar -x -C "$j/tree" -f - --no-same-owner {LK}>&- 2>/dev/null || { echo "cc-suite-runner: the tree did not unpack"; return 1; }
  # the tar carries the box's one-commit repo; the tree is proved from the files, not from what it says
  rm -rf "$j/tree/.git"
  t=$(exec {LK}>&-; cd "$j/tree" && git init -q && git add -A -f && git write-tree 2>/dev/null) || t=""
  [ "$t" = "$tree" ] || { echo "cc-suite-runner: unpacked tree ${t:-none} is not $tree — refused"; return 1; }
  ( exec {LK}>&-; cd "$j/tree" && git -c user.name=lander -c user.email=lander@localhost commit -qm tree --no-verify ) >/dev/null 2>&1
  [ -d "$j/tree/$cwd" ] || { echo "cc-suite-runner: no $cwd in the tree"; return 1; }
  local -a pre=(timeout -k 10 "$cap" nice -n 19)
  command -v ionice >/dev/null 2>&1 && ionice -c3 true 2>/dev/null && pre+=(ionice -c3)
  # the log is the runner's, outside the cage: the job reaches it only through the stdout it was handed
  if [ -n "$net" ]; then cage_argv --net "$j"; else cage_argv "$j"; fi
  ( cd "$j/tree/$cwd" && exec setsid env -i HOME="$j/home" USER="${USER:-$(id -un)}" PATH=/usr/local/bin:/usr/bin:/bin \
      LANG=C.UTF-8 TERM=dumb TMPDIR="$j" CC_SELFTEST_SPILL=0 "${pre[@]}" "${CG[@]}" /bin/sh -c "$line" ) \
    </dev/null {LK}>&- >"$j.log" 2>&1 & gp=$!; pg=$gp
  rc=0; wait "$gp" || rc=$?; gp=""
  kill -KILL -- -"$pg" 2>/dev/null; pg=""
  # every job line, an unterminated last one too, goes out prefixed and newline-ended, so no byte the job writes
  # (a \r, a fake verdict, a missing final newline) can start a line of its own or glue onto the verdict below
  LC_ALL=C awk '{ print "| " $0 }' "$j.log" {LK}>&-
  case $rc in 124|137) rc=124;; esac
  echo "lander-job: verdict exit=$rc"
  return 0
}

# ---- laptop-setup -------------------------------------------------------------------------------------------------
laptop_setup(){
  local node=${1:-cc-suites-runner} pub b64 hk pymm scv scsum=""
  [[ $node =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo "cc-suites: NODE is a tailnet host name ([a-z0-9-])" >&2; return 2; }
  pymm=$(tool_version python3 | cut -d. -f1,2); scv=$(tool_version shellcheck)
  [[ $pymm =~ ^[0-9]+\.[0-9]+$ ]] && [[ $scv =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
    || { echo "cc-suites: this box's python3 or shellcheck gives no version ($pymm, $scv)" >&2; return 1; }
  local e; for e in $SHELLCHECK_SUMS; do [ "${e%%=*}" != "$scv" ] || scsum=${e#*=}; done
  [ -n "$scsum" ] || echo "cc-suites: no pinned sum for shellcheck $scv (SHELLCHECK_SUMS): the laptop keeps its own, and answers unfit while it is older" >&2
  mkdir -p "$SD" && chmod 700 "$SD"
  [ -s "$SD/id_ed25519" ] || ssh-keygen -q -t ed25519 -N "" -C "cc-suites@$(hostname -s)" -f "$SD/id_ed25519" >/dev/null || return 1
  # The runner's host key is made HERE and pinned before the laptop is ever reached: the box trusts that key for
  # NODE and no other (StrictHostKeyChecking=yes), so a tailnet name that answers with another key is no runner.
  # Its private half goes into the script below and is NOT kept here: each run makes a new key and pins that one, so
  # the script printed last is the only one that works (run it again after any rerun of laptop-setup).
  local kd; kd=$(mktemp -d "${TMPDIR:-/tmp}/cc-suites-hostkey.XXXXXX") || return 1
  ssh-keygen -q -t ed25519 -N "" -C "cc-suites-runner" -f "$kd/k" >/dev/null || { rm -rf "$kd"; return 1; }
  echo "$node $(cut -d' ' -f1,2 "$kd/k.pub")" > "$SD/known_hosts"
  hk=$(cat "$kd/k"); rm -rf "$kd"
  echo "ccsuite@$node" > "$SD/remote"
  pub=$(cat "$SD/id_ed25519.pub"); b64=$(base64 -w76 "$SELF")
  echo "cc-suites: the script below is SECRET — it carries the runner's private host key. Run it on the laptop and delete it; never paste it into Slack, a doc or a shared file." >&2
  cat <<PS1
# SECRET: this script carries the runner's private SSH host key. Run it, then delete it; do not share or paste it.
# cc-suites runner for this laptop. Run once in an ADMINISTRATOR PowerShell; running it again is safe.
# It makes a WSL distro of its own (cc-suites) that runs the box's test suites while this laptop is open, and
# touches no other distro: in it Windows interop and the C: mount are off, sshd takes one key, from the tailnet only.
\$ErrorActionPreference = 'Stop'
\$Distro = 'cc-suites'
wsl.exe --update | Out-Null
\$have = (wsl.exe -l -q) -replace "\`0","" | Where-Object { \$_.Trim() -eq \$Distro }
if (-not \$have) {
  wsl.exe --install -d Ubuntu-24.04 --name \$Distro --no-launch
  if (\$LASTEXITCODE -ne 0) { throw "WSL could not install Ubuntu as '\$Distro'. If it asked for a reboot, reboot and run this again." }
}
\$sh = @'
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive
cat >/etc/wsl.conf <<'EOF'
[boot]
systemd=true
[interop]
enabled=false
appendWindowsPath=false
[automount]
enabled=false
mountFsTab=false
EOF
apt-get update -qq </dev/null   # nothing below may read stdin: it is this script
apt-get install -y -qq git jq tmux python3 curl ca-certificates openssh-server util-linux bsdutils procps psmisc \\
  gawk bc sqlite3 file lsof shellcheck bubblewrap </dev/null >/dev/null
command -v tailscale >/dev/null || curl -fsSL https://tailscale.com/install.sh | sh
# The box's python3 and shellcheck, or newer (a laptop pass is final for the lander's checks); the runner answers
# unfit while either is older than the floor
older(){ [ "\$(printf '%s\\n%s\\n' "\$1" "\$2" | sort -V | head -1)" != "\$2" ]; }
if older "\$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" $pymm; then
  apt-get install -y -qq software-properties-common </dev/null >/dev/null
  add-apt-repository -y ppa:deadsnakes/ppa </dev/null >/dev/null
  apt-get install -y -qq python$pymm </dev/null >/dev/null
  ln -sf /usr/bin/python$pymm /usr/local/bin/python3
fi
if [ -n "$scsum" ] && older "\$(shellcheck --version 2>/dev/null | awk '/^version:/ { print \$2 }')" $scv; then
  t=\$(mktemp -d)
  curl -fsSL -o "\$t/sc.tar.xz" https://github.com/koalaman/shellcheck/releases/download/v$scv/shellcheck-v$scv.linux.x86_64.tar.xz
  echo "$scsum  \$t/sc.tar.xz" | sha256sum -c --quiet
  tar -xJf "\$t/sc.tar.xz" -C "\$t"
  install -m 755 -o root -g root "\$t/shellcheck-v$scv/shellcheck" /usr/local/bin/shellcheck; rm -rf "\$t"
fi
install -d -m 755 -o root -g root /etc/cc-suites
printf 'python3 %s\\nshellcheck %s\\n' $pymm $scv >/etc/cc-suites/floor; chmod 644 /etc/cc-suites/floor
# The runner account can write nothing that decides what it runs or says: the runner, its home, its dotfiles and
# authorized_keys are root's, its shell reads no rc file, and a suite or job it runs is caged (cc-suites, THE CAGE).
# A runner set up before the cage ran PR code as this account, so its home is wiped and made again on every run,
# keeping only its slots and maxload, and anything it left running or scheduled goes.
id ccsuite >/dev/null 2>&1 || useradd -M -d /home/ccsuite -s /bin/sh ccsuite
usermod -s /bin/sh ccsuite
pkill -KILL -u ccsuite 2>/dev/null || true
crontab -r -u ccsuite 2>/dev/null || true
loginctl disable-linger ccsuite 2>/dev/null || true
# slots and maxload are read as numbers, never copied: the old account could have made either (or the directory) a link
# or a FIFO, and root following it would hand the account a root-only file or hang here.
keep_slots=; keep_maxload=; r=/home/ccsuite/.cc-suite-runner
if [ ! -L /home/ccsuite ] && [ ! -L "\$r" ] && [ -d "\$r" ]; then
  for f in slots maxload; do
    [ -f "\$r/\$f" ] && [ ! -L "\$r/\$f" ] || continue
    v=\$(head -c 16 "\$r/\$f" 2>/dev/null | tr -d '[:space:]')
    [[ \$v =~ ^[0-9]+(\.[0-9]+)?\$ ]] && printf -v "keep_\$f" %s "\$v"
  done
fi
rm -rf /home/ccsuite
install -d -m 755 -o root -g root /home/ccsuite /home/ccsuite/.ssh
install -d -m 700 -o ccsuite -g ccsuite /home/ccsuite/.cc-suite-runner
for f in slots maxload; do v=keep_\$f; [ -z "\${!v}" ] || { t=\$(mktemp); printf '%s\\n' "\${!v}" >"\$t"; install -m 644 -o ccsuite -g ccsuite "\$t" "\$r/\$f"; rm -f "\$t"; }; done
base64 -d >/usr/local/bin/cc-suites <<'B64'
$b64
B64
chown root:root /usr/local/bin/cc-suites; chmod 755 /usr/local/bin/cc-suites
echo 'restrict,command="/usr/local/bin/cc-suites runner" $pub' >/home/ccsuite/.ssh/authorized_keys
chown root:root /home/ccsuite/.ssh/authorized_keys; chmod 644 /home/ccsuite/.ssh/authorized_keys
# the host key the box has pinned for this runner; sshd offers it and no other
install -m 600 -o root -g root /dev/null /etc/ssh/ssh_host_cc_suites_ed25519
cat >/etc/ssh/ssh_host_cc_suites_ed25519 <<'KEY'
$hk
KEY
cat >/etc/ssh/sshd_config.d/cc-suites.conf <<'EOF'
HostKey /etc/ssh/ssh_host_cc_suites_ed25519
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
AllowUsers ccsuite@100.64.0.0/10
EOF
'@
# On stdin, not through a file: after the first run the distro has no C: mount to read one from.
\$OutputEncoding = New-Object System.Text.UTF8Encoding \$false
((\$sh -replace "\`r\`n", "\`n") + "\`nexit 0\`n") | wsl.exe -d \$Distro -u root -- bash -s
if (\$LASTEXITCODE -ne 0) { throw "the setup inside WSL failed (above)" }
wsl.exe --terminate \$Distro   # restart it so wsl.conf (systemd on, interop and C: off) takes hold
wsl.exe -d \$Distro -u root -- sh -c 'systemctl enable --now ssh tailscaled >/dev/null 2>&1; systemctl restart ssh'
# Keep the distro up while you are logged in; closed or asleep, the box runs every suite itself.
\$act = New-ScheduledTaskAction -Execute 'wsl.exe' -Argument "-d \$Distro --exec /bin/sleep infinity"
\$set = New-ScheduledTaskSettingsSet -ExecutionTimeLimit 0 -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -Hidden
Register-ScheduledTask -TaskName 'cc-suites keep-alive' -Action \$act -Trigger (New-ScheduledTaskTrigger -AtLogOn -User \$env:USERNAME) -Settings \$set -Force | Out-Null
Start-ScheduledTask -TaskName 'cc-suites keep-alive'
Write-Host "Last step: open the link below and log this runner into your tailnet (as '$node')."
wsl.exe -d \$Distro -u root -- tailscale up --hostname=$node --accept-dns=false
\$ready = wsl.exe -d \$Distro -u ccsuite -- env SSH_ORIGINAL_COMMAND=status /usr/local/bin/cc-suites runner
Write-Host "The runner answers: \$ready  ('free N' is ready; 'unfit (missing: ...)' names what this laptop still lacks)"
Write-Host "Done. The box will send suites and the lander's quick checks here while this laptop is open and not busy (on battery too)."
PS1
}

# ---- selfcheck ----------------------------------------------------------------------------------------------------
selfcheck(){
  local D pass=0 fail=0 R out rc p1 p2 p3 p4 tree
  D=$(mktemp -d "${TMPDIR:-/tmp}/cc-suites-selfcheck.XXXXXX") || return 1
  k(){ if [ "$1" = 0 ]; then pass=$((pass + 1)); echo "  ✓ $2"; else fail=$((fail + 1)); echo "  ✗ $2"; fi; }
  t(){ "$@" >/dev/null 2>&1; echo $?; }
  b(){ if eval "$1"; then echo 0; else echo 1; fi; }   # a condition as a case
  export CC_SUITES_DIR="$D/sd" CC_SUITES_RUNNER_DIR="$D/runner" CC_GREEN_DIR="$D/green"
  SD="$D/sd"; RUNNER_DIR="$D/runner"   # this shell's own view too: the cases below call its functions
  unset CC_SUITES_SSH CC_SUITE_PART CC_LAND_CHANGED CC_SUITES_SPILL_TIMEOUT CC_SUITES_RUNNER_TIMEOUT
  # the runner's view of power and load is a fixture too: on AC (no supply info) and idle, unless a case says not
  mkdir -p "$D/power" && echo "0.00 0.00 0.00 1/1 1" > "$D/loadavg"
  export CC_SUITES_POWER_DIR="$D/power" CC_SUITES_LOADAVG="$D/loadavg" CC_SUITES_RUNNER_NEEDS="bash git"
  export CC_SUITES_FLOOR="$D/floor"; FLOOR="$D/floor"   # none unless a case writes one (never this host's /etc)
  # --- REAP: four fake runs under $D, each on a fixture of its own; only $D is looked at (CC_SUITES_REAP_UNDER)
  mkdir -p "$D/a/tests" "$D/b/tests" "$D/c/tests" "$D/d/tests"
  for x in a b c d; do printf 'sleep 300\n' > "$D/$x/tests/selftest.sh"; done
  sleep 300 & local live=$!
  ( exec env CC_SELFTEST_HELD=999999999 bash "$D/a/tests/selftest.sh" ) >/dev/null 2>&1 & p1=$!     # owner gone
  ( exec env CC_SELFTEST_HELD=$live bash "$D/b/tests/selftest.sh" ) >"$D/b.log" 2>&1 & p2=$!        # owned, logging: kept
  ( exec env CC_SELFTEST_HELD=$live bash "$D/c/tests/selftest.sh" ) >"$D/c.log" 2>&1 & p3=$!        # log deleted
  ( exec env CC_SELFTEST_HELD=$live bash "$D/d/tests/selftest.sh" ) >"$D/d.log" 2>&1 & p4=$!        # tree deleted
  sleep 0.5; rm -f "$D/c.log"; rm -rf "$D/d"
  out=$(CC_SUITES_REAP_UNDER="$D" reap --dry)
  k "$(t kill -0 $p1)" "a dry reap kills nothing…"
  k "$(b 'grep -c '\''would reap'\'' <<<"$out" | grep -qx 3')" "…and names the three orphans: $(grep -o 'gone\|deleted' <<<"$out" | tr '\n' ' ')"
  out=$(CC_SUITES_REAP_UNDER="$D" reap)
  sleep 0.3
  k "$(b '! kill -0 $p1 2>/dev/null')" "a run whose slot holder is gone is reaped"
  k "$(t kill -0 $p2)" "…and a run whose holder and log are both there is kept"
  k "$(b '! kill -0 $p3 2>/dev/null')" "a run whose log was deleted is reaped"
  k "$(b '! kill -0 $p4 2>/dev/null')" "a run whose suite file was deleted (worktree removed) is reaped"
  out=$(CC_SUITES_REAP_UNDER="$D/elsewhere" reap)
  k "$(b '[ -z "$out" ] && kill -0 $p2 2>/dev/null')" "a reap scoped elsewhere touches nothing under $D"
  # a run started by a RELATIVE path from its own dir, reaped from a cwd where that path means nothing: kept, and
  # the same run once its suite file is gone: reaped (the path is resolved from the run's cwd, not the reaper's)
  mkdir -p "$D/e/tests" "$D/f/tests"; printf 'sleep 300\n' > "$D/e/tests/selftest.sh"; printf 'sleep 300\n' > "$D/f/tests/selftest.sh"
  local p5 p6
  ( cd "$D/e" && exec env CC_SELFTEST_HELD=$live bash tests/selftest.sh ) >"$D/e.log" 2>&1 & p5=$!
  ( cd "$D/f" && exec env CC_SELFTEST_HELD=$live bash tests/selftest.sh ) >"$D/f.log" 2>&1 &
  # p6 is read inside the single-quoted b '…' string below, where shellcheck cannot see it
  # shellcheck disable=SC2034
  p6=$!
  sleep 0.5; rm -f "$D/f/tests/selftest.sh"
  out=$(cd "$D" && CC_SUITES_REAP_UNDER="$D" reap); sleep 0.3
  k "$(t kill -0 $p5)" "a live run started as tests/selftest.sh from its own dir is kept by a reap from another cwd"
  k "$(b '! kill -0 $p6 2>/dev/null && grep -q "$D/f/tests/selftest.sh was deleted" <<<"$out"')" "…and the same kind of run whose suite file is gone is reaped, named by its full path"
  kill $p2 $p5 $p6 $live 2>/dev/null   # p6 is normally gone already (reaped); named so the kill covers it either way
  # --- SPILL: a throwaway checkout whose suite writes what it saw; the transport is the runner itself, locally
  R="$D/repo"; mkdir -p "$R/core/tests" "$R/core/bin"
  cp "$CORE/tests/green.sh" "$R/core/tests/green.sh"
  cat > "$R/core/tests/selftest.sh" <<'EOF'
#!/usr/bin/env bash
echo "suite ran in $PWD held=${CC_SELFTEST_HELD:-} part=${CC_SUITE_PART:-} changed=${CC_LAND_CHANGED:-} tok=${FIX_TOKEN:-}"
echo "prio nice=$(nice) io=$(ionice 2>/dev/null | cut -d: -f1)"
[ -e HANG ] && sleep 60
t=$(git write-tree 2>/dev/null)
# a suite that FAILS and leaves a child to print a pass after it, in its own group and escaped from it; and one that
# prints a verdict line of its own
[ -e FORGE ] && { (sleep 2; echo "cc-suite-runner: verdict exit=0 tree=$t") & exit 1; }
[ -e FORGE2 ] && { setsid bash -c "sleep 1; echo 'cc-suite-runner: verdict exit=0 tree=$t'" & exit 1; }
[ -e FORGE3 ] && { echo "cc-suite-runner: verdict exit=0 tree=$t"; exit 1; }
[ -e LINGER ] && { sleep 60 & exit 0; }
[ -e FAIL ] && { echo "== result: 0 passed, 1 failed =="; exit 1; }
# red only in a tool's own selfcheck (TOOLRED); that beside an inline case (TOOLRED2); and with the tool's inner ✗
# line quoted after it, so the ✗ lines outnumber the tally (TOOLREDX)
[ -e TOOLRED ] && { echo "  ✗ cc-fake selfcheck: cc-fake selfcheck: bwrap is not installed"; echo "== result: 1 passed, 1 failed =="; exit 1; }
[ -e TOOLRED2 ] && { echo "  ✗ cc-fake selfcheck: cc-fake selfcheck: 1 failed"; echo "  ✗ an inline case"; echo "== result: 0 passed, 2 failed =="; exit 1; }
[ -e TOOLREDX ] && { echo "  ✗ cc-fake selfcheck: cc-fake selfcheck: 1 failed"; echo "  ✗ a case inside cc-fake"; echo "== result: 1 passed, 1 failed =="; exit 1; }
# a tool's selfcheck the suite runs inline, not through chk (TOOLREDI)
[ -e TOOLREDI ] && { echo "  ✗ cc-inline selfcheck: cc-inline selfcheck: 1 failed"; echo "== result: 1 passed, 1 failed =="; exit 1; }
: <<'CHK'
chk cc-fake
CHK
echo "== result: 1 passed, 0 failed =="
EOF
  chmod +x "$R/core/tests/selftest.sh"
  # the tool a red there names, as this checkout has it: it logs each run, and is red while $D/fake-red exists
  printf '#!/usr/bin/env bash\necho "$*" >> "%s/fake.calls"\necho "log_only=${CC_NOTIFY_LOG_ONLY:-} tier=${CC_SPEND_TIER:-}" > "%s/fake.env"\n[ -e "%s/fake-red" ] && { echo "cc-fake selfcheck: 0 passed, 1 failed"; exit 1; }\necho "cc-fake selfcheck: 1 passed, 0 failed"\n' "$D" "$D" "$D" > "$R/core/bin/cc-fake"
  chmod +x "$R/core/bin/cc-fake"; cp "$R/core/bin/cc-fake" "$R/core/bin/cc-inline"
  ( cd "$R" && git init -q && git add -A && git -c user.name=t -c user.email=t@t commit -qm init )
  cat > "$D/xport" <<EOF
#!/usr/bin/env bash
# the stub ssh: the forced command, run by the runner code, with a HOME of its own and none of this shell's secrets
exec env -u FIX_TOKEN HOME="$D/rhome" CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="\$*" CC_SUITES_RUNNER_DIR="$D/runner" bash "$SELF" runner
EOF
  chmod +x "$D/xport"; mkdir -p "$D/rhome"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ]')" "no runner set: spill says 75 and runs nothing (got $rc)"
  out=$(bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q '\''no runner set'\'' <<<"$out"')" "…and status says there is none"
  export CC_SUITES_SSH="$D/xport"
  tree=$(cd "$R" && . core/tests/green.sh && green_tree "$R")
  out=$(FIX_TOKEN=sekrit CC_LAND_CHANGED="core/bin/x" bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ]')" "a free runner runs the suite and its pass is this exit (got $rc)"
  k "$(b 'grep -q "suite ran in $D/runner/run\." <<<"$out"')" "…in a scratch copy on the runner, not in this checkout"
  k "$(b 'grep -q '\''changed=core/bin/x tok=$'\'' <<<"$out"')" "…with CC_LAND_CHANGED carried over and no token of this shell's"
  k "$(b 'grep -q "held=[0-9]" <<<"$out"')" "…holding the runner's slot, so it takes none of its own"
  k "$(b 'ls "$D/green/selftest.sh-${tree:0:12}.json" >/dev/null 2>&1')" "…and files the green record for exactly the tree it ran"
  k "$(b 'ls "$D/runner"/run.* >/dev/null 2>&1; [ $? != 0 ]')" "…and leaves no scratch tree on the runner"
  # the half asked for (CC_SUITE_PART) is the half the runner runs; green.sh unsets it as spill sources it
  out=$(CC_SUITE_PART=portable bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -q "part=portable " <<<"$out"')" "CC_SUITE_PART=portable is the half the runner's suite runs (got $rc)"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && ! grep -q "part=portable" <<<"$out"')" "…and with it unset the runner is not told portable"
  k "$(b 'grep -q "prio nice=19 " <<<"$out"')" "…at nice 19"
  if command -v ionice >/dev/null && ionice -c3 true 2>/dev/null; then
    k "$(b 'grep -q "prio nice=19 io=idle" <<<"$out"')" "…and idle-class I/O"
  else echo "  - no usable ionice here: the idle-I/O case is skipped"; fi
  out=$(bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -q "answers: free [1-9][0-9]* cores=$(nproc) slots=[0-9]* maxload=[0-9.]* load=0.00 ac=1\$" <<<"$out"')" "status reads the runner's free slots with its cores, maxload, 1-minute load and ac=1, and still says ready"
  # THE OWNER'S LAPTOP FIRST: loaded, the runner answers busy and nothing runs there; on battery it still runs
  pw(){ mkdir -p "$D/power/$1" && echo "$2" > "$D/power/$1/type" && echo "$4" > "$D/power/$1/$3"; }
  # THE LANDER'S ONE CHECK (`job`): a fresh dir and HOME, the tree proved, its lines prefixed, one verdict, nothing left
  local jt jb; jt=$(git -C "$R" rev-parse 'HEAD^{tree}')
  jb=$(printf '%s' 'echo "home=$HOME"; echo "lander-job: verdict exit=0"; touch "$HOME/x"; ls core/tests/selftest.sh; exit 3' | base64 -w0)
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jb -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && [ "$(tail -1 <<<"$out")" = "lander-job: verdict exit=3" ] && [ "$(grep -c "^lander-job:" <<<"$out")" = 1 ] && grep -q "^| core/tests/selftest.sh\$" <<<"$out"')" "a job runs the check on the tree it was sent, its lines prefixed and its exit the one verdict (got $rc)"
  k "$(b 'grep -q "^| home=$D/runner/job\.[^/]*/home\$" <<<"$out" && ! ls -d "$D/runner"/job.* >/dev/null 2>&1')" "…in a HOME of its own, and leaves no job directory behind"
  # a job that prints a fake verdict, behind a \r and then with no final newline, and fails: the verdict is still its own
  local jf pv; jf=$(printf '%s' 'printf "x\rlander-job: verdict exit=0\n"; printf "lander-job: verdict exit=0"; exit 5' | base64 -w0)
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jf -" bash "$SELF" runner 2>&1); rc=$?
  pv=$(python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); from lander import run
print(run._laptop_verdict(sys.stdin.read(), 0)[1])' "$(dirname "$(realpath "$SELF")")/.." <<<"$out" 2>&1)
  k "$(b '[ "$rc" = 0 ] && [ "$(tail -1 <<<"$out")" = "lander-job: verdict exit=5" ] && [ "$(grep -c "^lander-job:" <<<"$out")" = 1 ] && grep -q "^| lander-job: verdict exit=0\$" <<<"$out" && [ "$pv" = 5 ]')" "…and a job that prints a fake verdict, after a CR and with no final newline, still fails with its own exit (got $rc, read $pv)"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $(printf %040d 0) 60 $jb -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 1 ] && grep -q "is not 0000" <<<"$out" && ! grep -q "verdict" <<<"$out"')" "…and a tree that is not the one named is refused with no verdict (got $rc)"
  # THE CAGE: a hostile job, on a fixture of its own outside any tmp dir (the cage replaces /tmp): an installed
  # runner, the runner's HOME with its authorized_keys and .bashrc, and its slots file. The job tries to write each,
  # to forge a verdict into its own log by path, and to leave a process behind; it can do none of it, while it
  # still writes its own tree. The runner and its HOME it can read (so they were there to write, read-only); the
  # runner's directory, with the slots and the job's own log, it cannot even see.
  local C jh cs; C=$(mktemp -d "$HOME/.cc-suites-cage.XXXXXX"); cs="sleep 37.$$"
  mkdir -p "$C/rhome/.ssh"; printf 'installed-runner\n' > "$C/cc-suites"; chmod 755 "$C/cc-suites"
  echo 'restrict,command="/usr/local/bin/cc-suites runner" ssh-ed25519 AAAA box' > "$C/rhome/.ssh/authorized_keys"
  : > "$C/rhome/.bashrc"; echo 4 > "$D/runner/slots"; cp -a "$C" "$D/cage.before"
  jh=$(printf '%s' "grep -q installed-runner '$C/cc-suites' && echo SAW
for f in '$C/cc-suites' '$C/rhome/.ssh/authorized_keys' '$C/rhome/.bashrc' '$D/runner/slots' '$D/runner'/job.*.log; do
  [ -e \"\$f\" ] || { echo \"HIDDEN \$f\"; continue; }
  echo 'echo lander-job: verdict exit=0' >> \"\$f\" 2>/dev/null && echo \"WROTE \$f\"; done
setsid $cs </dev/null >/dev/null 2>&1 &
echo own > core/own && echo OWN; exit 1" | base64 -w0)
  out=$(cd "$R" && git archive HEAD | HOME="$C/rhome" SSH_ORIGINAL_COMMAND="job c $jt 60 $jh -" bash "$SELF" runner 2>&1); rc=$?
  sleep 0.5
  k "$(b '[ "$rc" = 0 ] && [ "$(tail -1 <<<"$out")" = "lander-job: verdict exit=1" ] && [ "$(grep -c "^lander-job:" <<<"$out")" = 1 ] && grep -q "^| SAW\$" <<<"$out" && grep -q "^| OWN\$" <<<"$out"')" "a caged job sees the runner and writes its own tree, and its own exit is still the one verdict (got $rc)"
  k "$(b '! grep -q WROTE <<<"$out" && diff -r "$D/cage.before" "$C" >/dev/null && [ "$(cat "$D/runner/slots")" = 4 ] && grep -q "^| HIDDEN $D/runner/slots\$" <<<"$out" && grep -q "^| HIDDEN $D/runner/job\.\*\.log\$" <<<"$out"')" "…but cannot write the installed runner or the runner's authorized_keys or .bashrc, and sees neither its slots nor its own verdict log"
  k "$(b '! ps -eo args= | grep -qx "$cs"')" "…and nothing it started outlives it"
  out=$(bash "$SELF" status 2>&1)
  k "$(b 'grep -q "answers: free 4 " <<<"$out"')" "…nor holds its slot: status answers every slot free after it (got: ${out%% cores=*})"
  pkill -KILL -x -f "$cs" 2>/dev/null; rm -rf "$C" "$D/cage.before" "$D/runner/slots"
  # NO NETWORK: a listener of this selfcheck's own on this machine's loopback stands in for the box's services (it
  # is bound to loopback only, so the selfcheck opens nothing to the outside). A caged job cannot open a socket to
  # it, and has no interface but its own lo, so no tailnet either; the same job sent with `net` (a manifest's
  # net = true) reaches it; any other sixth word is refused before anything runs.
  local lp lpid ln jn; ln="$D/listen.port"; rm -f "$ln"
  python3 -c 'import socket, sys
s = socket.socket(); s.bind(("127.0.0.1", 0)); s.listen(8); open(sys.argv[1], "w").write(str(s.getsockname()[1]))
while True: s.accept()[0].close()' "$ln" & lpid=$!
  for _ in $(seq 1 50); do [ -s "$ln" ] && break; sleep 0.1; done; lp=$(cat "$ln" 2>/dev/null)
  jn=$(printf '%s' "echo IF \$(awk -F: \"NR > 2 { print \\\$1 }\" /proc/net/dev); python3 -c 'import socket, sys
try: socket.create_connection((\"127.0.0.1\", int(sys.argv[1])), timeout=3); print(\"REACHED\")
except OSError: print(\"CUT\")' $lp" | base64 -w0)
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ -n "$lp" ] && [ "$rc" = 0 ] && grep -qx "| CUT" <<<"$out" && grep -qx "| IF lo" <<<"$out" && ! grep -q "REACHED" <<<"$out"')" "a caged job cannot open a socket to a service on this machine, and has no interface but lo (got $rc)"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn - net" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -qx "| REACHED" <<<"$out"')" "…and the same job sent with net reaches it (got $rc)"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn - share" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 2 ] && grep -q "refused: job CHECK TREE CAP RUN_B64 CWD_B64 \[net\]" <<<"$out" && ! grep -q "REACHED\|CUT\|IF \|verdict" <<<"$out"')" "…and any sixth word but net is refused and runs nothing (got $rc)"
  # a check name with a newline in it arrives as two lines, the first a well-formed job ending in net: refused whole
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn - net"$'\n'"junk" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 2 ] && grep -q "refused: a command is one line" <<<"$out" && ! grep -q "REACHED\|CUT\|IF \|verdict" <<<"$out"')" "…and a command with a second line in it is refused and runs nothing (got $rc)"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn - net"$'\r' bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 2 ] && grep -q "refused: a command is one line" <<<"$out" && ! grep -q "REACHED\|CUT\|IF \|verdict" <<<"$out"')" "…and so is one with a carriage return in it (got $rc)"
  kill "$lpid" 2>/dev/null; wait "$lpid" 2>/dev/null
  # …NOR A SOCKET UNDER /run: a Unix socket of this selfcheck's own, planted in the first world-writable directory
  # under /run (the stand-in for a daemon's socket there), answers outside the cage and is not there inside it
  local rd rs rpid; rd=""; for rs in /run/lock /run/screen; do [ -d "$rs" ] && [ -w "$rs" ] && { rd=$rs; break; }; done
  if [ -n "$rd" ] && rd=$(mktemp -d "$rd/cc-suites-selfcheck.XXXXXX"); then
    rs="$rd/s.sock"; python3 -c 'import os, socket, sys
s = socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); s.listen(8)
while True: s.accept()[0].close()' "$rs" & rpid=$!
    for _ in $(seq 1 50); do [ -S "$rs" ] && break; sleep 0.1; done
    jn=$(printf '%s' "python3 -c 'import socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(3)
try: s.connect(sys.argv[1]); print(\"REACHED\")
except OSError: print(\"CUT\")' $rs" | base64 -w0)
    p1=$(python3 -c 'import socket, sys; socket.socket(socket.AF_UNIX).connect(sys.argv[1]); print("up")' "$rs" 2>&1)
    out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jn -" bash "$SELF" runner 2>&1); rc=$?
    k "$(b '[ "$p1" = up ] && [ "$rc" = 0 ] && grep -qx "| CUT" <<<"$out" && ! grep -q "REACHED" <<<"$out"')" "…nor connect to a Unix socket planted under /run, which answers outside the cage (got $rc, outside: $p1)"
    kill "$rpid" 2>/dev/null; wait "$rpid" 2>/dev/null; rm -rf "$rd"
  else echo "  - no writable directory under /run here: the /run socket case is skipped"; fi
  # a bwrap that runs but cannot cut the network is no cage: unfit, and nothing runs
  mkdir -p "$D/nonet"; printf '#!/bin/sh\nfor a; do [ "$a" != --unshare-net ] || exit 1; done\nexec %s "$@"\n' "$(command -v bwrap)" > "$D/nonet/bwrap"; chmod +x "$D/nonet/bwrap"
  out=$(cd "$R" && git archive HEAD | PATH="$D/nonet:$PATH" CC_SUITES_JOB_NEEDS=git SSH_ORIGINAL_COMMAND="job c $jt 60 $jb -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q "unfit (missing: bwrap(does-not-run))" <<<"$out" && ! grep -q "verdict\|home=" <<<"$out"')" "a runner whose bwrap cannot cut the network answers unfit to a job, 75, and runs nothing (got $rc)"
  # …and a machine whose bwrap does not run takes no job, whatever the needs are set to: nothing runs uncaged
  mkdir -p "$D/nobw"; printf '#!/bin/sh\nexit 1\n' > "$D/nobw/bwrap"; chmod +x "$D/nobw/bwrap"
  out=$(cd "$R" && git archive HEAD | PATH="$D/nobw:$PATH" CC_SUITES_JOB_NEEDS=git SSH_ORIGINAL_COMMAND="job c $jt 60 $jb -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q "unfit (missing: bwrap(does-not-run))" <<<"$out" && ! grep -q "verdict\|home=" <<<"$out"')" "a runner whose bwrap does not run answers unfit to a job, 75, and runs nothing (got $rc)"
  out=$(cd "$R" && git archive HEAD | PATH="$D/nobw:$PATH" SSH_ORIGINAL_COMMAND="run core/tests/selftest.sh $tree all -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q "unfit (missing: bwrap(does-not-run))" <<<"$out" && ! grep -q "suite ran" <<<"$out"')" "…and to a suite, though the needs this selfcheck sets leave bwrap out (got $rc)"
  pw AC Mains online 0
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" != 75 ] && grep -q '\''suite ran'\'' <<<"$out"')" "on battery (the Mains supply offline): spill still runs (got $rc)"
  out=$(bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -q "answers: free [1-9][0-9]* cores=$(nproc) slots=[0-9]* maxload=[0-9.]* load=0.00 ac=0\$" <<<"$out"')" "…and status says the runner is free on battery, with its cores, maxload, load and ac=0"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="run core/tests/selftest.sh $tree all -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" != 75 ] && ! grep -q '\''busy'\'' <<<"$out"')" "…and a run that asks is accepted, not refused as busy"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_PREP=0 SSH_ORIGINAL_COMMAND="job c $jt 60 $jb -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -q "^lander-job: verdict exit=3" <<<"$out" && ! grep -q "busy" <<<"$out"')" "…and a lander job is accepted too: it runs and gives its verdict (got $rc)"
  pw AC Mains online 1; pw BAT0 Battery status Discharging
  k "$(b 'runner_on_battery && [ -z "$(runner_unfit)" ]')" "a battery discharging is on battery, whatever the Mains supply says, and still fit to run"
  pw BAT0 Battery status Charging
  k "$(b '[ -z "$(runner_unfit)" ] && ! runner_on_battery')" "on AC with the battery charging: fit to run, not on battery"
  rm -rf "$D/power"/*
  k "$(b '[ -z "$(runner_unfit)" ]')" "no power supply info at all (a WSL with none) counts as on AC"
  echo "99.00 99.00 99.00 1/1 1" > "$D/loadavg"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && ! grep -q '\''suite ran'\'' <<<"$out" && grep -q "^load 99.00" <<<"$(runner_unfit)"')" "a 1-minute load above half the cores: busy, 75, nothing ran (got $rc)"
  # the runner's own maxload file replaces the n/2 default, the same way slots does
  echo 100 > "$D/runner/maxload"
  k "$(b '[ -z "$(runner_unfit)" ]')" "…and a maxload file above the current load answers fit, though it is above n/2"
  out=$(bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && grep -q "maxload=100 " <<<"$out"')" "…named in status as the bound in force"
  rm -f "$D/runner/maxload"
  k "$(b '[ -n "$(runner_unfit)" ]')" "…and with the file gone the n/2 default answers busy again"
  echo "0.00 0.00 0.00 1/1 1" > "$D/loadavg"
  # WALL-CLOCK BOUNDS. The runner stops a suite past its limit and gives no verdict; the box then runs it here
  touch "$R/HANG"; SECONDS=0
  out=$(CC_SUITES_RUNNER_TIMEOUT=2s bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && grep -q '\''ran past 2s'\'' <<<"$out" && [ "$SECONDS" -lt 20 ]')" "a suite that hangs on the runner is stopped there: no verdict, 76, in ${SECONDS}s"
  rm -f "$R/HANG"
  # …and a runner that stays up while nothing comes back holds the box no longer than CC_SUITES_SPILL_TIMEOUT
  printf '#!/usr/bin/env bash\n[ "$1" = status ] && { echo "free 1"; exit 0; }\ncat >/dev/null; echo "suite ran, then hung"; exec sleep 120\n' > "$D/xport-hang"
  chmod +x "$D/xport-hang"; SECONDS=0
  out=$(CC_SUITES_SSH="$D/xport-hang" CC_SUITES_SPILL_TIMEOUT=2s bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && grep -q '\''longer than 2s'\'' <<<"$out" && [ "$SECONDS" -lt 20 ]')" "a runner that never answers is given up on after the limit: 76, in ${SECONDS}s"
  # READINESS: a runner missing a tool the suite needs answers unfit and runs nothing
  out=$(CC_SUITES_RUNNER_NEEDS="bash no-such-tool-xyz" bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && ! grep -q '\''suite ran'\'' <<<"$out"')" "a runner missing a tool the suite needs: 75, and nothing ran (got $rc)"
  out=$(CC_SUITES_RUNNER_NEEDS="bash no-such-tool-xyz" bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q '\''unfit (missing: no-such-tool-xyz)'\'' <<<"$out"')" "…and status names what it lacks"
  out=$(cd "$R" && git archive HEAD | CC_SUITES_RUNNER_NEEDS="no-such-tool-xyz" SSH_ORIGINAL_COMMAND="run core/tests/selftest.sh $tree all -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q unfit <<<"$out" && ! grep -q '\''suite ran'\'' <<<"$out"')" "…and a run that asks anyway is refused before it starts"
  k "$(b '[ -z "$(runner_missing)" ] && grep -q "bwrap" <<<"$RUNNER_NEEDS"')" "a runner with every need is ready, and bwrap is among the needs"
  # FLOOR: a laptop pass is final, so a python3 older than the box's answers unfit, and one at or above it does not
  echo "python3 99.0" > "$D/floor"
  out=$(bash "$SELF" status 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q "unfit (missing: python3([0-9.]*<99.0))" <<<"$out"')" "a runner whose python3 is older than the floor answers unfit and names it (got $rc)"
  out=$(cd "$R" && git archive HEAD | SSH_ORIGINAL_COMMAND="job c $(printf %040d 0) 60 $(printf true | base64) -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && grep -q "unfit (missing: python3(" <<<"$out"')" "…and so does the lander's job, though its own needs leave python3 out (got $rc)"
  printf 'python3 3.0\nsh 99\n' > "$D/floor"
  k "$(b '[ -z "$(runner_older)" ]')" "…a python3 at or above the floor is fit, and a floor line naming any other tool is not read"
  rm -f "$D/floor"
  k "$(b '[ "$(slots_for 22)" = 3 ] && [ "$(slots_for 6)" = 1 ] && [ "$(slots_for 16)" = 2 ] && [ "$(slots_for 128)" = 8 ]')" "slots by default: about one per 8 cores, so suites take about half (22 cores → 3, 6 → 1, capped at 8)"
  echo 5 > "$D/runner/slots"; k "$(b '[ "$(runner_slots)" = 5 ]')" "…and the runner's own slots file sets it"
  echo 0 > "$D/runner/slots"; k "$(b '[ "$(runner_slots)" = "$(slots_for "$(nproc)")" ]')" "…and a slots file out of 1..32 is the default"
  rm -f "$D/runner/slots"
  k "$(b '[ "$(limit 90x 90m)" = 90m ] && [ "$(limit 0 90m)" = 90m ] && [ "$(limit 5s 90m)" = 5s ]')" "a limit that is not timeout's form, or zero, is the default"
  touch "$R/FAIL"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && grep -q '\''running it here'\'' <<<"$out" && [ "$(find "$D/green" -name "selftest.sh-*.json" ! -name "*${tree:0:12}*" | wc -l)" = 0 ]')" "a red there fails nothing on its own: 76, so it runs here and is not offered again (got $rc), and files no record"
  rm -f "$R/FAIL"
  # FINISH HERE: a red there only in a tool's own selfcheck runs that selfcheck here, and nothing else here
  touch "$R/TOOLRED"; rm -rf "$D/green"; rm -f "$D/fake.calls" "$D/fake-red"; tree=$(cd "$R" && . core/tests/green.sh && green_tree "$R")
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && [ "$(cat "$D/fake.calls")" = selfcheck ] && grep -q "finished here: cc-fake selfcheck: 1 passed, 0 failed" <<<"$out" && ls "$D/green/selftest.sh-${tree:0:12}.json" >/dev/null 2>&1')" "a red there only in a tool's own selfcheck: that selfcheck alone runs here, and its pass is the pass, filed for the tree (got $rc)"
  k "$(b 'grep -q "red (exit 1) after [0-9]*s, only in the own selfcheck of: cc-fake" <<<"$out"')" "…and the line says how long the runner had it, and which tool is finished here"
  k "$(b '[ "$(cat "$D/fake.env")" = "log_only=1 tier=autonomous" ]')" "…and the tool runs with the suite's own flags: CC_NOTIFY_LOG_ONLY=1, so a re-run never pushes to the owner"
  rm -rf "$D/green"; rm -f "$D/fake.calls"; touch "$D/fake-red"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && [ "$(cat "$D/fake.calls")" = "$(printf "selfcheck\nselfcheck")" ] && [ ! -d "$D/green" ] && grep -q "red here too" <<<"$out"')" "…and a tool red here too (twice, as chk judges it) is 76 and no record: the whole suite runs here (got $rc)"
  rm -f "$R/TOOLRED" "$D/fake-red"
  touch "$R/TOOLREDI"; rm -rf "$D/green"; rm -f "$D/fake.calls"
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && [ ! -e "$D/fake.calls" ] && [ ! -d "$D/green" ] && grep -q "cc-inline.s selfcheck is not a chk case" <<<"$out"')" "a red only in a tool selfcheck the suite runs inline, not through chk: 76, the tool not run here, no record (got $rc)"
  rm -f "$R/TOOLREDI"
  for f in TOOLRED2 TOOLREDX; do
    touch "$R/$f"; rm -rf "$D/green"; rm -f "$D/fake.calls"
    out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
    k "$(b '[ "$rc" = 76 ] && [ ! -e "$D/fake.calls" ] && [ ! -d "$D/green" ] && grep -q "running it here" <<<"$out"')" "a red there with more in it than tool selfchecks ($f) finishes nothing here: 76, no tool run, no record (got $rc)"
    rm -f "$R/$f"
  done
  k "$(b 'printf "| x\n|   ✗ cc-a selfcheck: 1 failed\n|   ✗ cc-b selfcheck: 2 failed\n| == result: 5 passed, 2 failed (scoped to: x) ==\ncc-suite-runner: verdict exit=1 tree=%040d\n" 0 > "$D/f1"; [ "$(finishable "$D/f1" | tr "\n" " ")" = "cc-a cc-b " ]')" "finishable names each tool when the tally, scoped or not, counts exactly its ✗ lines"
  k "$(b 'printf "|   ✗ cc-a selfcheck: 1 failed\n| == result: 5 passed, 1 failed ==\n| a line after the tally\n" > "$D/f2"; [ -z "$(finishable "$D/f2")" ]')" "…and nothing when the tally is not the suite's last line"
  # A SUITE CANNOT FORGE A PASS: each of these exits 1 and tries to put `verdict exit=0` for its own tree on the stream
  for f in FORGE FORGE2 FORGE3; do
    touch "$R/$f"; rm -rf "$D/green"; SECONDS=0
    out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
    k "$(b '[ "$rc" = 76 ] && [ ! -d "$D/green" ] && [ "$SECONDS" -lt 10 ]')" "a suite that fails and forges a pass ($f) is a red there: 76, no record, in ${SECONDS}s (got $rc)"
    rm -f "$R/$f"
  done
  # …and a child a passing suite leaves behind does not hold the box: the runner kills its group and the box returns
  touch "$R/LINGER"; SECONDS=0
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && [ "$SECONDS" -lt 10 ]')" "a pass whose suite left a child running comes back at once: 0, in ${SECONDS}s (got $rc)"
  rm -f "$R/LINGER"
  k "$(b 'printf "| x\ncc-suite-runner: verdict exit=0 tree=%040d\n" 0 > "$D/v1"; [ -n "$(verdict_of "$D/v1")" ]')" "the box reads one unprefixed verdict as the last line…"
  k "$(b 'printf "cc-suite-runner: verdict exit=0 tree=%040d\ncc-suite-runner: verdict exit=1 tree=%040d\n" 0 0 > "$D/v2"; [ -z "$(verdict_of "$D/v2")" ]')" "…and two verdicts as none"
  k "$(b 'printf "cc-suite-runner: verdict exit=0 tree=%040d\n| after\n" 0 > "$D/v3"; [ -z "$(verdict_of "$D/v3")" ]')" "…and a verdict that is not the last line as none"
  k "$(b 'printf "cc-suite-runner: verdict exit=0 tree=%040d\ncc-suite-runner: verdict none — ran past\n" 0 > "$D/v4"; [ -z "$(verdict_of "$D/v4")" ]')" "…and a forged one beside the runner's out-of-time line as none"
  # a runner that never answers status is given up on
  printf '#!/usr/bin/env bash\nexec sleep 120\n' > "$D/xport-mute"; chmod +x "$D/xport-mute"
  SECONDS=0; out=$(CC_SUITES_SSH="$D/xport-mute" CC_SUITES_STATUS_TIMEOUT=2s bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && [ "$SECONDS" -lt 10 ]')" "a runner that never answers status is none after its bound (20 s by default): 75, in ${SECONDS}s"
  # busy: every runner slot held
  mkdir -p "$D/runner"; echo 2 > "$D/runner/slots"; exec {H1}>>"$D/runner/slot.1"; exec {H2}>>"$D/runner/slot.2"; flock -n $H1; flock -n $H2
  out=$(bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 75 ] && ! grep -q '\''suite ran'\'' <<<"$out"')" "a runner with no free slot: 75, and nothing ran"
  exec {H1}>&- {H2}>&-; rm -f "$D/runner/slots"
  # a connection that ends before the verdict (the lid shut): no verdict, 75, no record
  printf '#!/usr/bin/env bash\n[ "$1" = status ] && { echo "free 1"; exit 0; }\ncat >/dev/null; echo "suite ran, half way"; exit 255\n' > "$D/xport-cut"
  chmod +x "$D/xport-cut"; rm -rf "$D/green"
  out=$(CC_SUITES_SSH="$D/xport-cut" bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && grep -q '\''no verdict'\'' <<<"$out" && [ ! -d "$D/green" ]')" "a run cut off before its verdict (the lid shut) is no verdict: 76, and no record"
  # a verdict for some other tree does not count
  printf '#!/usr/bin/env bash\n[ "$1" = status ] && { echo "free 1"; exit 0; }\ncat >/dev/null; echo "cc-suite-runner: verdict exit=0 tree=%040d"\n' 0 > "$D/xport-other"
  chmod +x "$D/xport-other"
  out=$(CC_SUITES_SSH="$D/xport-other" bash "$SELF" spill "$R/core/tests/selftest.sh" 2>&1); rc=$?
  k "$(b '[ "$rc" = 76 ] && [ ! -d "$D/green" ]')" "a verdict naming another tree is not this run's: 76, and no record"
  # the runner refuses what it was not built for
  out=$(cd "$D" && SSH_ORIGINAL_COMMAND="run ../../etc/passwd $tree all -" bash "$SELF" runner 2>&1 </dev/null); rc=$?
  k "$(b '[ "$rc" = 2 ]')" "the runner refuses a suite outside its list (exit $rc)"
  out=$(cd "$D" && SSH_ORIGINAL_COMMAND="bash -i" bash "$SELF" runner 2>&1 </dev/null); rc=$?
  k "$(b '[ "$rc" = 2 ]')" "…and any command but status and run"
  out=$(cd "$R" && git archive HEAD | SSH_ORIGINAL_COMMAND="run core/tests/selftest.sh $(printf %040d 0) all -" bash "$SELF" runner 2>&1); rc=$?
  k "$(b 'grep -q '\''refused'\'' <<<"$out" && ! grep -q '\''suite ran'\'' <<<"$out"')" "…and a tar that is not the tree it was told, before running a line of it"
  # laptop-setup: the key, the remote, and a script that carries this very file and the key's public half
  out=$(bash "$SELF" laptop-setup my-node 2>&1); rc=$?
  k "$(b '[ "$rc" = 0 ] && [ "$(cat "$D/sd/remote")" = ccsuite@my-node ] && [ -s "$D/sd/id_ed25519" ]')" "laptop-setup makes the key and points the remote at ccsuite@my-node"
  k "$(b 'grep -qF "restrict,command=\"/usr/local/bin/cc-suites runner\" $(cat "$D/sd/id_ed25519.pub")" <<<"$out"')" "…and its script pins that key to the runner, restricted"
  k "$(b 'awk "/^base64 -d/{f=1;next} /^B64\$/{f=0} f" <<<"$out" | base64 -d | cmp -s - "$SELF"')" "…and carries this file byte for byte"
  k "$(b 'grep -q "bubblewrap" <<<"$out"')" "…installs bwrap, which the suite's sandbox cases run"
  k "$(b 'grep -qx "printf '\''python3 %s\\\\nshellcheck %s\\\\n'\'' $(tool_version python3 | cut -d. -f1,2) $(tool_version shellcheck) >/etc/cc-suites/floor; chmod 644 /etc/cc-suites/floor" <<<"$out" && grep -q "sha256sum -c" <<<"$out"')" "…writes this box's python3 and shellcheck as the floor, and checks the shellcheck it fetches"
  # …and leaves the runner account nothing of its own to rewrite: the runner, the home, .ssh and authorized_keys root's
  k "$(b 'grep -qx "chown root:root /usr/local/bin/cc-suites; chmod 755 /usr/local/bin/cc-suites" <<<"$out" && grep -qx "install -d -m 755 -o root -g root /home/ccsuite /home/ccsuite/.ssh" <<<"$out" && grep -qx "chown root:root /home/ccsuite/.ssh/authorized_keys; chmod 644 /home/ccsuite/.ssh/authorized_keys" <<<"$out" && ! grep -q "chown ccsuite\|-o ccsuite -g ccsuite /home/ccsuite/.ssh\|useradd -m" <<<"$out"')" "…makes the runner, the runner account's home, .ssh and authorized_keys root's, never the account's"
  k "$(b 'grep -qx "usermod -s /bin/sh ccsuite" <<<"$out" && grep -qx "pkill -KILL -u ccsuite 2>/dev/null || true" <<<"$out" && grep -qx "rm -rf /home/ccsuite" <<<"$out" && grep -qx "keep_slots=; keep_maxload=; r=/home/ccsuite/.cc-suite-runner" <<<"$out" && ! grep -q "cp /home/ccsuite" <<<"$out"')" "…and wipes what an uncaged run could have left there (its processes, its home) but keeps its slots and maxload"
  k "$(b 'grep -q '\''^enabled=false'\'' <<<"$out" && grep -q '\''AllowUsers ccsuite@100.64.0.0/10'\'' <<<"$out"')" "…with interop and the C: mount off, and sshd for ccsuite from the tailnet only"
  awk "/^cat >\/etc\/ssh\/ssh_host_cc_suites_ed25519/{f=1;next} /^KEY\$/{f=0} f" <<<"$out" > "$D/hk"; chmod 600 "$D/hk"
  k "$(b '[ "$(cat "$D/sd/known_hosts")" = "my-node $(ssh-keygen -y -f "$D/hk" | cut -d" " -f1,2)" ] && grep -q "^HostKey /etc/ssh/ssh_host_cc_suites_ed25519" <<<"$out"')" "…and pins a host key of its own making: known here for my-node, installed there as sshd's only one"
  k "$(b '[ -z "$(ls "$D/sd" | grep -v "^id_ed25519\|^known_hosts\$\|^remote\$")" ] && grep -q "SECRET" <<<"$out"')" "…keeps no copy of that private key here, and says the script is secret"
  unset CC_SUITES_SSH; local -a XP
  k "$(b 'xport_argv && printf "%s\n" "${XP[@]}" | grep -qx StrictHostKeyChecking=yes && ! printf "%s\n" "${XP[@]}" | grep -q accept-new')" "the transport takes that key and no other (StrictHostKeyChecking=yes)"
  rm -f "$D/sd/known_hosts"
  k "$(b '! configured')" "…and with no pinned key there is no runner"
  kill $p1 $p2 $p3 $p4 2>/dev/null; rm -rf "$D"
  echo "cc-suites selfcheck: $pass passed, $fail failed"
  [ "$fail" = 0 ]
}

case "${1:-}" in
  reap) shift; reap "${1:-}";;
  spill) shift; spill "$@";;
  status) status;;
  runner) runner;;
  laptop-setup) shift; laptop_setup "$@";;
  selfcheck) selfcheck;;
  -h|--help) echo "$USAGE";;
  *) echo "$USAGE" >&2; exit 2;;
esac
