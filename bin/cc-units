#!/usr/bin/env bash
# cc-units — the one reader of config/units.json, the core unit manifest. Three lists used to be hardcoded in
# three files (install.sh linked one set, install.sh enabled another, cc-audit health-checked a third) and they
# had drifted: the model, reconcile and publish timers were enabled by the installer and invisible to the audit.
#   cc-units list                      every row: unit  enable  start  health  restart
#   cc-units link                      the unit filenames to symlink (all of them)
#   cc-units enable                    unit<TAB>start, for the rows the installer switches on
#   cc-units check                     is-enabled/is-active/list-timers vs the manifest; one line, exit 1 on a fault
#   cc-units restart-for [--root <dir>] <path…>
#                                      unit<TAB>restart|rearm|owner|none for the units a change touches
#   cc-units policy <unit> <field>     one cell, for anything that wants a single answer
#   cc-units selfcheck                 the manifest's own invariants, against no live systemd at all
# `restart-for` is the answer to "a .timer edit is invisible to an ExecStart-basename test": a changed OnCalendar
# needs the timer RESTARTED and re-armed, and `daemon-reload` alone leaves it with `Trigger: n/a` — no next run.
# It is also the answer to a unit whose code is a DIRECTORY: its row's `paths` say which files are its, because an
# ExecStart-basename test sees one entry point and misses the package behind it (a merged dashboard sat on the
# previous version's process for want of that, 2026-09-06). A path is relative to the tree that declares it, and
# --root says which tree is being landed — so another repo's `dashboard/` is not this box's.
set -uo pipefail
R="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
M="${CC_UNITS_MANIFEST:-$R/config/units.json}"
UD="${CC_UNITS_DIR:-$R/config/systemd-user}"
# A box may keep this tree as `core/` inside a private repo — the overlay — with user units of its own. install.sh
# links those by glob and the owner switches them on, but a landing still has to know which of them a change
# touched, so the overlay declares them in its own config/units.json, read HERE and nowhere else. Setting
# CC_UNITS_OVERLAY to the empty string turns that off (the selfcheck's fixtures run against no overlay at all).
OVD=""; [ "$(basename "$R")" = core ] && OVD="$(cd "$R/.." && pwd)"
OV="${CC_UNITS_OVERLAY-$OVD}"
USAGE="usage: cc-units list|link|enable|check|restart-for [--root <dir>] <path…>|policy <unit> <field>|selfcheck"
command -v jq >/dev/null 2>&1 || { echo "cc-units: jq is missing" >&2; exit 2; }
[ -f "$M" ] || { echo "cc-units: no manifest at $M" >&2; exit 2; }

rows(){ jq -r '.units[] | [.unit, .enable, .start, .health, .restart] | @tsv' "$M"; }
cell(){ jq -r --arg u "$1" --arg f "$2" '.units[] | select(.unit==$u) | .[$f] // ""' "$M"; }
CT="$(cd "$(dirname "$M")/.." && pwd)"   # the tree $M describes — its rows' paths are relative to this
ROOT="${OV:-$CT}"                        # …and so is a changed path handed to restart-for, unless --root says otherwise

# every manifest a landing reads: tree<TAB>manifest<TAB>unit-dir. The core one, and the overlay's own where a box
# keeps one. Only these two — a manifest is a tree's declaration about its own units, never another tree's.
manifests(){
  printf '%s\t%s\t%s\n' "$CT" "$M" "$UD"
  [ -n "$OV" ] && [ -f "$OV/config/units.json" ] && [ "$OV/config/units.json" != "$M" ] &&
    printf '%s\t%s\t%s\n' "$OV" "$OV/config/units.json" "$OV/config/systemd-user"
  return 0
}

# …and every one of them must PARSE before a landing believes an empty answer. jq writes its complaint to stderr
# and carries on, so a manifest with a typo in it reads as "this tree declares no unit at all" — which is the
# silent guess this whole field exists to stop. Non-zero here, and one line saying which file.
lint_manifests(){
  local t m d bad=0
  while IFS=$'\t' read -r t m d; do
    jq -e . "$m" >/dev/null 2>&1 || { echo "cc-units: $m is not valid json — nothing can be told what to restart" >&2; bad=1; }
  done < <(manifests)
  return "$bad"
}

# unit<TAB>restart<TAB>unit-dir<TAB>declared paths, for the manifests INSIDE the tree being landed. Each declared
# path comes out already prefixed with where its own tree sits in that repo — "core/" for a core tree inside an
# overlay, nothing for the overlay itself — so one declared path reads the same in a bare clone and in an overlay.
# The prefix is glued on in jq rather than sent as a field of its own: tab is IFS whitespace, so an empty field
# would collapse into the next one and every path would arrive as the prefix.
prows(){
  local t m d p
  while IFS=$'\t' read -r t m d; do
    case "$t" in
      "$ROOT")   p="" ;;
      "$ROOT"/*) p="${t#"$ROOT"/}/" ;;
      *)         continue ;;   # a manifest outside this repo declares nothing about this repo's files
    esac
    # `?` for a row that names no restart policy: it is not `none`, so the selfcheck's vocabulary case says so
    jq -r --arg d "$d" --arg p "$p" \
       '.units[] | [.unit, (.restart // "?"), $d, ((.paths // []) | map($p + .) | join(" "))] | @tsv' "$m"
  done < <(manifests)
  return 0
}
sc(){ systemctl --user "$@" 2>&1; }   # never fails the caller: an is-* answer is the value, not the exit code

# ---- check: what the audit asks. Every `required` row must be enabled and healthy; an `owner` row is checked
# only once the owner has enabled it (a bare clone with no Slack tokens is not a broken box); a `timer` row is
# started by its own timer and is neither. A timer that is active but has no next trigger is DOWN, not up.
check(){
  local u en st he re bad="" n=0 state trig lnk="${CC_UNITS_LINKDIR:-$HOME/.config/systemd/user}"
  while IFS=$'\t' read -r u en st he re; do
    [ -n "$u" ] || continue
    # linked first, for EVERY row. A `timer` row is skipped by everything below, so an unlinked cc-*.service
    # would otherwise be invisible until its timer fired and found nothing to start.
    [ -e "$lnk/$u" ] || { bad="$bad $u=unlinked"; continue; }
    case "$en" in
      required) state=$(sc is-enabled "$u")
                case "$state" in enabled|enabled-runtime|static|generated|indirect) ;; *) bad="$bad $u=not-enabled($state)"; continue;; esac ;;
      owner)    state=$(sc is-enabled "$u"); case "$state" in enabled|enabled-runtime) ;; *) continue;; esac ;;   # off by the owner's choice: not a fault
      timer)    continue ;;
    esac
    n=$((n+1))
    case "$he" in
      active)     state=$(sc is-active "$u"); [ "$state" = active ] || { bad="$bad $u=$state"; continue; } ;;
      not-failed) [ "$(sc is-failed "$u")" = failed ] && { bad="$bad $u=failed"; continue; } ;;
    esac
    if [ "$re" = rearm ]; then   # armed, not merely active: a changed OnCalendar reloaded but not restarted sits at `Trigger: n/a`
      trig=$(sc list-timers --all --no-pager "$u" | awk 'NR==2{print $1}')
      case "$trig" in ""|"n/a"|"-")
        # no NEXT while the timer's own service runs — it is computed after the run (the 03:30 audit failed its own timer, 2026-09-01)
        case "$(sc is-active "${u%.timer}.service")" in active|activating) ;; *) bad="$bad $u=not-armed" ;; esac ;;
      esac
    fi
  done < <(rows)
  if [ -n "$bad" ]; then echo "user units —$bad"; return 1; fi
  echo "user units — all $n enabled, active and armed as config/units.json declares"
}

# ---- restart-for: the landing's policy. A unit is touched when the change edits ITS OWN unit file, any file its
# Exec* lines run, or anything under a path its row declares. `restart` and `rearm` are done by the landing;
# `owner` is recorded and left alone; `none` is SAID rather than filtered out, because the landing runs a name test
# of its own and a policy it never hears cannot stop it — a boot oneshot with RemainAfterExit=yes reads active, and
# restarting it re-does the whole boot job.
restart_for(){
  local u re d pa f b names=" " changed=" " ln tok hit
  lint_manifests || return 2      # an unreadable manifest is an ANSWER the caller must not get: exit non-zero
  for f in "$@"; do names="$names$(basename -- "$f") "; changed="$changed$f "; done
  while IFS=$'\t' read -r u re d pa; do
    [ -n "$u" ] || continue
    hit=0
    case "$names" in *" $u "*) hit=1 ;; esac                         # the unit file itself moved (a .timer schedule change)
    if [ "$hit" = 0 ] && [ -n "$pa" ]; then                          # a path the row declares: the unit IS that directory
      for tok in $pa; do
        tok="${tok%/}"
        case "$changed" in *" $tok "*|*" $tok"/*) hit=1 ;; esac      # the file itself, or anything under it
      done
    fi
    if [ "$hit" = 0 ] && [ -f "$d/$u" ]; then
      while IFS= read -r ln; do
        for tok in $ln; do case "$tok" in */*) b=$(basename -- "$tok"); case "$names" in *" $b "*) hit=1 ;; esac ;; esac; done
      done < <(sed -n 's/^Exec[A-Za-z]*=//p' "$d/$u")
    fi
    [ "$hit" = 1 ] && printf '%s\t%s\n' "$u" "$re"
  done < <(prows)
  return 0   # the loop's status is the last row's `&&`, so a final unmatched row would report failure: no match is not an error
}

selfcheck(){
  local n=0 f=0 u en st he re out d pa tok T
  k(){ n=$((n+1)); if [ "$1" = 0 ]; then echo "  ok   $2"; else echo "  FAIL $2"; f=$((f+1)); fi; }
  t(){ if "$@" >/dev/null 2>&1; then echo 0; else echo 1; fi; }   # a check that PRINTS (jq -e) must not leak into the verdict
  nt(){ if "$@" >/dev/null 2>&1; then echo 1; else echo 0; fi; }  # …and one that must NOT hold
  k "$(t jq -e . "$M")" "manifest is valid json"
  # …and so is every manifest a landing reads, the overlay's own included — nothing else lints that one on a
  # bare box, and unreadable it would declare no unit at all without saying so
  k "$(t lint_manifests)" "every manifest a landing reads is valid json"
  k "$(t test "$(rows | wc -l)" -gt 0)" "manifest has rows"
  # every declared unit exists, and every unit file is declared: adding a file without a row must FAIL, loudly
  out=""; while IFS=$'\t' read -r u _; do [ -f "$UD/$u" ] || out="$out $u"; done < <(rows)
  k "$(t test -z "$out")" "every manifest row has a unit file —${out:- none missing}"
  out=""; for u in "$UD"/*; do [ -f "$u" ] || continue; rows | cut -f1 | grep -qxF "$(basename "$u")" || out="$out $(basename "$u")"; done
  k "$(t test -z "$out")" "every unit file has a manifest row —${out:- none missing}"
  # the field vocabulary: a typo in a policy word must not read as "nothing to do"
  out=""; while IFS=$'\t' read -r u en st he re; do
    case "$en" in required|owner|timer) ;; *) out="$out $u:enable=$en";; esac
    case "$st" in now|no-block|none) ;; *) out="$out $u:start=$st";; esac
    case "$he" in active|not-failed|none) ;; *) out="$out $u:health=$he";; esac
    case "$re" in restart|rearm|owner|none) ;; *) out="$out $u:restart=$re";; esac
  done < <(rows)
  k "$(t test -z "$out")" "every policy word is one of the known values —${out:- all known}"
  # a .timer is rearm and a .service is never rearm: the whole point of the field. The exception is a timer the
  # OWNER switches on (enable=owner): it is linked but off, and re-arming it on a landing would start the very
  # thing they have not switched on yet — so the landing records the action for them instead.
  out=""; while IFS=$'\t' read -r u en st he re; do
    case "$u" in
      *.timer)   if [ "$en" = owner ]; then [ "$re" = owner ] || out="$out $u"; else [ "$re" = rearm ] || out="$out $u"; fi;;
      *.service) [ "$re" = rearm ] && out="$out $u";;
    esac
  done < <(rows)
  k "$(t test -z "$out")" "every timer re-arms, bar one the owner switches on, and no service does —${out:- correct}"
  # the proven cost, 2026-08-31: editing cc-digest.timer's OnCalendar restarts and re-arms the TIMER
  out=$(restart_for core/config/systemd-user/cc-digest.timer)
  k "$(t grep -qx 'cc-digest.timer	rearm' <<<"$out")" "a changed .timer file re-arms that timer (#86's silent switch-off)"
  # and a changed script still reaches the unit whose ExecStart runs it
  out=$(restart_for core/bin/cc-slack)
  k "$(t grep -qx 'cc-slackd.service	restart' <<<"$out")" "a changed script restarts the unit whose ExecStart runs it"
  out=$(restart_for core/bin/cc-rc)
  k "$(t grep -qx 'tmux-main.service	owner' <<<"$out")" "the shared tmux server is reported as the owner's action, never restarted"
  out=$(restart_for core/bin/cc-digest)
  k "$(t grep -qx 'cc-digest.service	none' <<<"$out")" "a timer-driven oneshot's script comes back as none, said out loud rather than omitted — silence is what lets the caller's own name test restart it anyway"
  # a caller gates on this: "nothing to restart" must exit 0, or every landing that touches no unit reads as failed
  out=$(restart_for core/docs/DESIGN.md)
  k "$(t test -z "$out")" "a change no row and no ExecStart names comes back empty"
  "$0" restart-for core/docs/DESIGN.md >/dev/null 2>&1; k $? "…and exits 0 saying so"
  "$0" restart-for core/config/systemd-user/cc-digest.timer >/dev/null 2>&1; k $? "restart-for exits 0 when it does match"

  # ---- a unit whose code is a DIRECTORY, in a fixture tree shaped like a box: a core tree inside an overlay, each
  # with its own manifest. This is the case that went wrong on 2026-09-06 — a merged change moved a server's modules
  # and web assets, its ExecStart file did not move, and the deploy left the old process serving the new version.
  T=$(mktemp -d)
  mkdir -p "$T/core/config/systemd-user" "$T/config/systemd-user" "$T/elsewhere"
  cat > "$T/core/config/units.json" <<'J'
{ "units": [ { "unit": "tool.service", "enable": "required", "start": "now", "health": "active", "restart": "restart" } ] }
J
  cat > "$T/config/units.json" <<'J'
{ "units": [ { "unit": "dash.service",  "restart": "restart", "paths": ["dashboard", "bin-private/dashsrc"] },
             { "unit": "quiet.service", "restart": "restart", "paths": ["quiet"] } ] }
J
  printf '[Service]\nExecStart=%%h/bin/tool run\n' > "$T/core/config/systemd-user/tool.service"
  # its ExecStart names NOTHING the cases below change: every hit on this unit is a declared path's doing
  printf '[Service]\nExecStart=%%h/bin/dashd --foreground\n' > "$T/config/systemd-user/dash.service"
  rf(){ CC_UNITS_MANIFEST="$T/core/config/units.json" CC_UNITS_DIR="$T/core/config/systemd-user" \
        CC_UNITS_OVERLAY="$T" "$0" restart-for "$@"; }
  out=$(rf dashboard/server.py dashboard/web/app.js docs/note.md)
  k "$(t grep -qx 'dash.service	restart' <<<"$out")" "a change under a unit's declared directory restarts it, with its ExecStart file untouched"
  k "$(nt grep -q 'quiet.service' <<<"$out")" "…and a unit whose declared paths did not change is left alone"
  out=$(rf bin-private/dashsrc)
  k "$(t grep -qx 'dash.service	restart' <<<"$out")" "a declared path that is a FILE counts too, not only a directory"
  out=$(rf docs/note.md README.md dashboardish.md)
  k "$(t test -z "$out")" "a change outside every declared path restarts nothing — and a declared path matches at a / , not as a string prefix"
  out=$(rf core/bin/tool)
  k "$(t grep -qx 'tool.service	restart' <<<"$out")" "the core tree's own rows still answer for the file their ExecStart runs, from inside an overlay"
  out=$(rf --root "$T/elsewhere" dashboard/server.py core/bin/tool)
  k "$(t test -z "$out")" "…and landing ANOTHER repo restarts none of them: a path is declared relative to the tree that declares it"
  # a manifest with a typo in it must not read as "this tree declares nothing": jq complains on stderr and keeps
  # going, and an empty answer that exits 0 is what a landing believes
  printf '{ this is not valid json\n' > "$T/config/units.json"
  out=$(rf dashboard/server.py 2>&1); re=$?
  k "$(t test "$re" -ne 0)" "an unreadable overlay manifest exits non-zero — an empty answer here is a landing's silent guess"
  k "$(t grep -q 'not valid json' <<<"$out")" "…and says which file, on stderr"
  rm -rf "$T"; unset -f rf

  # the rows a landing reads — the overlay's included — must name a policy it knows, and declare plain relative paths
  out=""; while IFS=$'\t' read -r u re d pa; do
    case "$re" in restart|rearm|owner|none) ;; *) out="$out $u:restart=$re";; esac
    for tok in $pa; do case "$tok" in /*|*..*|*'*'*|*'?'*) out="$out $u:paths=$tok";; esac; done
  done < <(prows)
  k "$(t test -z "$out")" "every row a landing reads names a restart policy, over plain relative paths —${out:- all do}"
  # …and on a box that keeps an overlay, a unit file of its own with no row has no restart policy at all, which is
  # exactly how a landing leaves a merged change on the old process.
  if [ -n "$OV" ] && [ -f "$OV/config/units.json" ]; then
    out=""; for u in "$OV"/config/systemd-user/*; do [ -f "$u" ] || continue
      jq -r '.units[].unit' "$OV/config/units.json" | grep -qxF "$(basename "$u")" || out="$out $(basename "$u")"; done
    k "$(t test -z "$out")" "every overlay unit file has a row in the overlay manifest —${out:- none missing}"
  fi
  # an unlinked unit is a fault even for a `timer` row, which every other test skips
  out=$(CC_UNITS_LINKDIR="$UD/no-such-link-dir" check 2>&1)   # a path that cannot exist: no temp dir to leak
  k "$(t grep -q 'cc-digest.service=unlinked' <<<"$out")" "an unlinked timer-driven .service is reported, not skipped"
  # a timer whose own service is running shows NEXT '-' until the run ends: armed, not a fault (the 03:30 monthly audit
  # reported cc-audit.timer=not-armed — itself, mid-run, 2026-09-01). sc is a function, so a subshell fakes systemd.
  fake(){ local svc="$1"; shift; case "$1" in list-timers) ;; is-active) case "$2" in cc-audit.service) echo "$svc";; *) echo active;; esac;; is-failed) echo active;; *) echo enabled;; esac; }
  out=$( sc(){ fake activating "$@"; }; CC_UNITS_LINKDIR="$UD" check 2>&1 )
  k "$(nt grep -q 'cc-audit.timer=not-armed' <<<"$out")" "a timer with no NEXT whose service is running is armed, not a fault"
  out=$( sc(){ fake inactive "$@"; }; CC_UNITS_LINKDIR="$UD" check 2>&1 )
  k "$(t grep -q 'cc-audit.timer=not-armed' <<<"$out")" "…and with its service idle it is not-armed, as before"
  # a unit the installer enables must have somewhere to be enabled FROM
  out=""; while IFS=$'\t' read -r u en st he re; do
    [ "$en" = required ] || continue
    case "$u" in *.timer) continue;; esac
    grep -q '^\[Install\]' "$UD/$u" 2>/dev/null || out="$out $u"
  done < <(rows)
  k "$(t test -z "$out")" "every required .service has an [Install] section —${out:- all do}"
  echo "cc-units selfcheck: $((n - f)) passed, $f failed"
  [ "$f" -eq 0 ]
}

case "${1:-}" in
  list)        rows ;;
  link)        rows | cut -f1 ;;
  enable)      rows | awk -F'\t' '$2=="required"{print $1"\t"$3}' ;;
  check)       check ;;
  restart-for) shift
               if [ "${1:-}" = --root ]; then     # the tree being landed: a path is declared relative to it
                 [ $# -ge 2 ] || { echo "$USAGE" >&2; exit 2; }
                 ROOT="$(cd "$2" 2>/dev/null && pwd)" || { echo "cc-units: no such --root: $2" >&2; exit 2; }
                 shift 2
               fi
               [ $# -gt 0 ] || { echo "$USAGE" >&2; exit 2; }; restart_for "$@" ;;
  policy)      [ $# -eq 3 ] || { echo "$USAGE" >&2; exit 2; }; cell "$2" "$3" ;;
  selfcheck)   selfcheck ;;
  *)           echo "$USAGE" >&2; exit 2 ;;
esac
