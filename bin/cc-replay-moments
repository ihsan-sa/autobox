#!/usr/bin/env python3
"""cc-replay-moments — before a fix is built, count the past owner nudges, recorded failures and stalls it would have prevented.

  cc-replay-moments extract [--labels FILE] [--snapshots DIR] [--slack DIR] [--stalls FILE] [--held-out] --out FILE
      Rebuild the moment behind every labelled nudge, every recorded failure and every stall, and write them one JSON
      line each. Held-out stall moments are left out of the file; --held-out writes only them.
  cc-replay-moments score --new PATH [--old PATH] (--moments FILE | [--labels FILE] [--snapshots DIR] [--slack DIR]
                          [--stalls FILE]) [--held-out] [--verbose]
      Run every moment through the OLD and the NEW version of a rule and print, per class, how many moments could be
      replayed and how many each version would have prevented, and for stalls the minutes of waiting each would have
      saved. --verbose lists each moment either version fired on. --held-out scores the held-out stall moments and
      nothing else.
  cc-replay-moments selfcheck

A MOMENT is what the box had in front of it just before a nudge: the owner message (time, chat, thread, text) and the
box post before it — the last post in the same thread, else the last in the same chat, with reactions and failed posts
skipped (the nudge pass's own rule). It is read from the collector's snapshots first (their slack.jsonl carries the
box post already), then from the Slack archive and the outbox log for the days no snapshot covers. A labelled nudge
whose message or box post cannot be found is UNREPLAYABLE: it stays in the table as a count and is never dropped.
A failure is a moment too: each cluster in the snapshots' failures.jsonl stands for `n` records, the examples it
quotes are the text the writer saw and are replayable, and the rest of its `n` are counted unreplayable.
The owner messages in the labels' own time span that were NOT labelled are CONTROL moments: nothing is prevented
there, and a version that fires on many of them is firing on ordinary traffic, not on the fault.

A STALL is a stretch where a session stood without progress until a person or a sweep ended it. It is read from
cc-stall's log (--stalls, default ~/.cc/state/stall.log): each `raised <row>` line is one stall, and it began
"stood N min" before the line (minute-floored, as the log prints it). It ended at the first sign on its board row, in
any snapshot day's board.jsonl, that someone dealt with it: a status of done, merged, dropped or closed, or a note that
starts "Closed" or "Dropped". `stood_s` is that stretch, and it is the moment's `gap_s` too. A raised stall whose row
has no such sign in the snapshots, a stall whose row the board refused and that was never raised after, and a dialog
the sweep pressed itself (the log does not say how long it stood) are UNREPLAYABLE, counted and never dropped. Stall
moments carry `window`, `class` (the stall's kind), `row`, `raised_at`, `text` (the log's own words), `stood_s`,
`ended_at` and `ended_by`. A version that fires on a stall `after_s` seconds after it began saves `stood_s - after_s`
of waiting (all of it when it names no after_s), and is LATE when after_s is past stood_s.
Loops, handoffs, landings and idle wake-ups are not stall sources here: landings are cc-replay's, and the others
record no start and end of a wait that a person or a sweep ended.

HELD OUT. One in four stall moments, chosen by sha256 of a salt and the moment's id, is held out, and so is every
stall raised at or after the stamp in `replay-heldout.from` (minute resolution; the word `lifted` there lifts it).
Both files sit in ~/.cc/state/<control repo>/architect/ (CC_REPLAY_HELDOUT_DIR overrides), and a run with stall
moments and no salt or stamp there is refused. extract and score leave held-out moments out and say how many;
only --held-out scores them, and then only them. The split is made on every run from the ids, never read from a
moments file.

A VERSION is a file. A Python file (`.py`, or any file that defines `judge`) is imported and `judge(moment)` is
called; anything else is executed once per moment with the moment as JSON on stdin and read from the first word of
stdout. Either way it answers one of: `pass` (or nothing) — the moment goes as it went — or `refused`, `rewritten`,
`status` (a push reached the owner) or `flagged`. A Python judge may return `(verdict, after_s)`, and an executable
may print `<verdict> <after_s>`: the version acts `after_s` seconds after the box post, and a moment where that falls
after the owner's message is LATE — the nudge had already happened, so it counts as not prevented. `--old` defaults to
a version that never fires, which is what the box did in history by definition: every nudge in the labels happened.
A replayed old version that claims to prevent some is the replay's own error bar, read it before the new column.

No model, no network, no clock: the same inputs print the same bytes. It reads the labels, the snapshots, the archive,
the outbox log, the stall log and the held-out files and writes only --out. It posts nothing and records nothing. Stdlib only; no box's repo names,
channels or people are in this file — the labels and snapshots are data and live outside the repo.
"""
import calendar, collections, glob, hashlib, importlib.util, json, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
SNAPSHOTS = os.environ.get("CC_REPLAY_SNAPSHOTS") or f"{HOME}/.cc/state/improve/snapshots"
SLACK = os.environ.get("CC_REPLAY_SLACK") or f"{HOME}/.cc/slack"
STALLS = os.environ.get("CC_REPLAY_STALLS") or f"{HOME}/.cc/state/stall.log"
BIN = os.path.dirname(os.path.realpath(__file__))
STALL_ENDS = ("done", "merged", "dropped", "closed")      # a status on a stall's row that says someone dealt with it
STALL_END_NOTE = re.compile(r"(closed|dropped)\b", re.I)  # …or a note that starts so
REFUSED_WINDOW_S = 900                                    # a refused row raised again within this is the same stall
HELD_EVERY = 4                                            # one in this many stall moments is held out
VERDICTS = ("refused", "rewritten", "status", "flagged")
SKIP_KINDS = ("post-failed",)          # and every react*: a reaction is not a post the owner read as the box's answer
USAGE = ("usage: cc-replay-moments extract [--labels FILE] [--snapshots DIR] [--slack DIR] [--stalls FILE] [--held-out] "
         "--out FILE\n"
         "       cc-replay-moments score --new PATH [--old PATH] (--moments FILE | [--labels FILE] [--snapshots DIR] "
         "[--slack DIR] [--stalls FILE]) [--held-out] [--verbose]\n"
         "       cc-replay-moments selfcheck")


def die(msg, rc=2):
    print(f"cc-replay-moments: {msg}", file=sys.stderr)
    sys.exit(rc)


def secs(stamp):
    """ISO UTC (…Z, seconds optional) -> epoch seconds; None stays None."""
    if not stamp:
        return None
    s = stamp.rstrip("Z")
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M"):
        try:
            return calendar.timegm(time.strptime(s[:19] if fmt.endswith("%S") else s[:16], fmt))
        except ValueError:
            continue
    return None


def jsonl(path):
    out = []
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


def day_dirs(root):
    """A snapshot root (its day dirs, oldest first, the `latest` link skipped) or one day dir itself."""
    if not root or not os.path.isdir(root):
        return []
    if os.path.exists(os.path.join(root, "index.json")) or os.path.exists(os.path.join(root, "slack.jsonl")):
        return [root]
    return [d for d in sorted(glob.glob(os.path.join(root, "*")))
            if os.path.isdir(d) and not os.path.islink(d) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", os.path.basename(d))]


# ── extract ───────────────────────────────────────────────────────────────────────────────────────────────────────

def load_sources(snapshots, slack):
    """Owner messages keyed (chat, ts) with the source each came from, and the outbox posts by thread and by chat."""
    msgs = {}
    for d in day_dirs(snapshots):
        for r in jsonl(os.path.join(d, "slack.jsonl")):
            if r.get("role") == "owner" and r.get("chat") and r.get("ts"):
                msgs[(r["chat"], r["ts"])] = dict(r, src="snapshot")
    for f in sorted(glob.glob(os.path.join(slack, "archive", "**", "*.jsonl"), recursive=True)):
        for r in jsonl(f):
            if r.get("role") == "owner" and r.get("chat") and r.get("ts"):
                msgs.setdefault((r["chat"], r["ts"]), dict(r, src="archive"))
    by_thread, by_chat = collections.defaultdict(list), collections.defaultdict(list)
    try:
        with open(os.path.join(slack, "outbox.log"), errors="replace") as fh:
            for line in fh:
                p = line.rstrip("\n").split("\t")
                if len(p) < 5 or p[1].startswith("react") or p[1] in SKIP_KINDS:
                    continue
                post = {"at": p[0], "kind": p[1], "text": "\t".join(p[4:])}
                by_thread[(p[2], p[3])].append(post)
                by_chat[p[2]].append(post)
    except OSError:
        pass
    for lst in list(by_thread.values()) + list(by_chat.values()):
        lst.sort(key=lambda x: x["at"])
    return msgs, by_thread, by_chat


def box_before(m, by_thread, by_chat):
    """The box post the owner saw last before message m: the snapshot's own when it has one, else the outbox's."""
    if m.get("prev_box"):
        return m["prev_box"]
    th, at = m.get("thread_ts") or m["ts"], m.get("at") or ""
    cands = []
    if th != m["ts"]:
        cands = [x for x in by_thread.get((m["chat"], th), []) if x["at"] < at]
    if not cands:
        cands = [x for x in by_chat.get(m["chat"], []) if x["at"] < at]
    return cands[-1] if cands else None


def moment_of(m, cls, source, by_thread, by_chat):
    prev = box_before(m, by_thread, by_chat)
    a, b = secs(m.get("at")), secs(prev.get("at")) if prev else None
    mo = {"id": f"{source[0]}:{m['chat']}:{m['ts']}", "source": source, "class": cls, "at": m.get("at"),
          "chat": m["chat"], "thread_ts": m.get("thread_ts") or m["ts"], "in_thread": (m.get("thread_ts") or m["ts"]) != m["ts"],
          "text": m.get("text") or "", "prev_box": prev, "gap_s": (a - b) if a is not None and b is not None else None,
          "src": m.get("src"), "replayable": prev is not None}
    if prev is None:
        mo["why"] = "no box post before it"
    return mo


def stall_ends(snapshots):
    """Row ("repo/track") -> (epoch, ISO, by): the first sign in any snapshot day's board.jsonl that someone ended it.
    The board's stamps are "MM-DDTHH:MM"; the year is the snapshot day's."""
    ends = {}
    for d in day_dirs(snapshots):
        year = os.path.basename(os.path.normpath(d))[:4]
        for r in jsonl(os.path.join(d, "board.jsonl")):
            row = f"{r.get('repo')}/{r.get('track')}"
            for entry, is_note in [(x, False) for x in r.get("statuses") or []] + [(x, True) for x in r.get("notes") or []]:
                if not isinstance(entry, str) or " " not in entry:
                    continue
                stamp, word = entry.split(" ", 1)
                if is_note and not STALL_END_NOTE.match(word):
                    continue
                if not is_note and word.strip() not in STALL_ENDS:
                    continue
                at = secs(f"{year}-{stamp}")
                by = STALL_END_NOTE.match(word).group(1).lower() if is_note else word.strip()
                if at is not None and (row not in ends or at < ends[row][0]):
                    ends[row] = (at, f"{year}-{stamp}:00Z", f"{by} note" if is_note else by)
    return ends


def stall_moments(stalls, snapshots):
    """One moment per stall in cc-stall's log; see STALL in the docstring for what replays and what does not."""
    lines = []
    try:
        with open(stalls, errors="replace") as fh:
            for line in fh:
                p = line.rstrip("\n").split("\t")
                if len(p) >= 4 and secs(p[0]) is not None:
                    lines.append((p[0], p[1], p[2], p[3], "\t".join(p[4:])))
    except OSError:
        return []
    ends, out, seen = stall_ends(snapshots), [], set()
    for i, (at, window, kind, action, detail) in enumerate(lines):
        base = {"source": "stall", "class": kind, "window": window, "raised_at": at, "text": detail, "prev_box": None,
                "stood_s": None, "gap_s": None, "replayable": False}
        if action.startswith("raised "):
            row = action.split()[1]
            m = re.search(r"stood (\d+) min", detail)
            start = secs(at) - int(m.group(1)) * 60 if m else None
            mo = dict(base, id=f"s:{row}", row=row,
                      at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(start)) if start is not None else at)
            end = ends.get(row)
            if start is None:
                mo["why"] = "the log does not say how long it had stood"
            elif end is None or end[0] < secs(at):
                mo["why"] = "no board snapshot records how its row ended"
            else:
                mo.update(stood_s=end[0] - start, gap_s=end[0] - start, ended_at=end[1], ended_by=end[2], replayable=True)
        elif action.startswith("board refused "):
            row = action.split()[2]
            later = any(k == kind and w == window and a.startswith("raised ") and 0 <= secs(t) - secs(at) <= REFUSED_WINDOW_S
                        for t, w, k, a, _ in lines[i + 1:])
            if later or f"s:{row}" in seen:   # the same stall, raised on a later pass or already counted as refused
                continue
            mo = dict(base, id=f"s:{row}", row=row, at=at, why="the board refused its row and it was never raised")
        elif action.startswith("pressed "):
            mo = dict(base, id=f"s:{window}:{kind}:{at}", at=at,
                      why="the sweep pressed it; the log does not say how long it stood")
        else:
            continue
        seen.add(mo["id"])
        out.append(mo)
    return out


def extract(labels, snapshots, slack, stalls=None):
    lab = jsonl(labels) if labels else []
    if labels and not lab:
        die(f"no labelled nudges in {labels}")
    msgs, by_thread, by_chat = load_sources(snapshots, slack) if lab else ({}, {}, {})
    out, labelled = [], set()
    for r in lab:
        key = (r.get("chat"), r.get("ts"))
        labelled.add(key)
        m = msgs.get(key)
        if m is None:
            out.append({"id": f"n:{key[0]}:{key[1]}", "source": "nudge", "class": r.get("class") or "?", "at": None,
                        "replayable": False, "why": "message not in the snapshots or the archive"})
        else:
            out.append(moment_of(m, r.get("class") or "?", "nudge", by_thread, by_chat))
    found = sorted(x["at"] for x in out if x.get("at"))
    if found:                           # CONTROL: the owner's other messages over the span the labels were read over
        lo, hi = found[0], found[-1]
        for key, m in msgs.items():
            if key not in labelled and lo <= (m.get("at") or "") <= hi:
                mo = moment_of(m, "-", "control", by_thread, by_chat)
                mo["id"] = f"c:{key[0]}:{key[1]}"
                out.append(mo)
    for d in day_dirs(snapshots):
        day = os.path.basename(os.path.normpath(d))
        for c in jsonl(os.path.join(d, "failures.jsonl")):
            kind, ex = c.get("kind") or "?", [e for e in (c.get("examples") or []) if isinstance(e, str) and e.strip()]
            cid, n = (c.get("clusters") or ["?"])[0], max(int(c.get("n") or 0), len(ex))
            for i in range(n):
                mo = {"id": f"f:{day}:{cid}:{i}", "source": "failure", "class": kind, "at": c.get("last"),
                      "repo": c.get("repo"), "writers": c.get("writers") or [], "expected": c.get("expected") or "",
                      "text": ex[i] if i < len(ex) else "", "prev_box": None, "gap_s": None, "replayable": i < len(ex)}
                if i >= len(ex):
                    mo["why"] = "the snapshot quotes no text for this record"
                out.append(mo)
    if stalls:
        out += stall_moments(stalls, snapshots)
    out.sort(key=lambda x: (x["source"], x.get("at") or "", x["id"]))
    return out


# ── held out ──────────────────────────────────────────────────────────────────────────────────────────────────────

def ctl():
    """The control repo: the one this bin/ is checked out under in ~/dev or ~/.cc/worktrees (cc-stall's ctl())."""
    for root in (f"{HOME}/dev", f"{HOME}/.cc/worktrees"):
        rel = os.path.relpath(BIN, root)
        if not rel.startswith(".."):
            return rel.split(os.sep)[0]
    return "box"


def heldout_files(d=None):
    """(salt, from): the salt that picks one in HELD_EVERY stall moments, and the stamp from which every stall is held
    out ('lifted' when the architect has lifted it). Refused when either is missing or not what it should be."""
    d = d or os.environ.get("CC_REPLAY_HELDOUT_DIR") or f"{HOME}/.cc/state/{ctl()}/architect"
    try:
        with open(os.path.join(d, "replay-heldout.salt")) as fh:
            salt = fh.read().strip()
        with open(os.path.join(d, "replay-heldout.from")) as fh:
            frm = fh.read().strip()
    except OSError as e:
        die(f"stall moments need the held-out files in {d}: {e.strerror}: {e.filename}")
    if not re.fullmatch(r"[0-9a-f]{32}", salt):
        die(f"{d}/replay-heldout.salt is not 32 hex characters")
    if frm != "lifted" and secs(frm) is None:
        die(f"{d}/replay-heldout.from holds neither an ISO stamp nor 'lifted'")
    return salt, frm


def is_held_out(mo, salt, frm):
    """A stall moment is held out by its id's hash, or by being raised at or after the stamp (both minute-floored,
    so a stall raised in the stamp's own minute is held out)."""
    if mo.get("source") != "stall":
        return False
    if int(hashlib.sha256(f"{salt}\0{mo['id']}".encode()).hexdigest()[:8], 16) % HELD_EVERY == 0:
        return True
    return frm != "lifted" and (mo.get("raised_at") or mo.get("at") or "")[:16] >= frm[:16]


def split_held(moments, held, files=None):
    """-> (the moments this run scores, how many held-out stall moments it left out or kept).
    held=False: every moment but the held-out stalls. held=True: the held-out stalls and nothing else."""
    if not held and not any(m.get("source") == "stall" for m in moments):
        return moments, None
    salt, frm = files or heldout_files()
    # brief: "score leaves held-out moments out by default ... only an explicit --held-out flag scores them, and only them"
    keep = [m for m in moments if (m.get("source") == "stall" and is_held_out(m, salt, frm)) == held]
    n = sum(1 for m in moments if m.get("source") == "stall" and is_held_out(m, salt, frm))
    return keep, n


# ── versions ──────────────────────────────────────────────────────────────────────────────────────────────────────

def never(_moment):
    return "pass"


def load_version(path):
    """A callable moment -> (verdict, after_s). None is the version that never fires."""
    if not path or path == "none":
        return "none", never
    if not os.path.isfile(path):
        die(f"no version at {path}")
    name = os.path.basename(path)
    with open(path, errors="replace") as fh:
        src = fh.read()
    if path.endswith(".py") or re.search(r"^def judge\(", src, re.M):
        spec = importlib.util.spec_from_loader(f"ccrm_{abs(hash(path))}", loader=None, origin=path)
        mod = importlib.util.module_from_spec(spec)
        mod.__file__ = path
        exec(compile(src, path, "exec"), mod.__dict__)
        if not callable(getattr(mod, "judge", None)):
            die(f"{path} defines no judge(moment)")
        return name, mod.judge
    if not os.access(path, os.X_OK):
        die(f"{path} is neither a Python judge nor executable")

    def run(moment):
        p = subprocess.run([path], input=json.dumps(moment), capture_output=True, text=True, timeout=30)
        if p.returncode != 0:
            raise RuntimeError(f"exit {p.returncode}: {p.stderr.strip()[:200]}")
        w = p.stdout.split()
        return (w[0], float(w[1])) if len(w) > 1 else (w[0] if w else "pass")
    return name, run


def verdict(fn, moment, label):
    """-> 'pass' | a VERDICT | 'late'. A version that raises or answers another word stops the run: a count built on
    a judge that failed half the time is not a count."""
    return judged(fn, moment, label)[0]


def judged(fn, moment, label):
    """-> (verdict, after_s or None), the verdict as verdict() gives it."""
    try:
        v = fn(dict(moment))
    except Exception as e:                      # noqa: BLE001 — the candidate's own fault, named with its moment
        die(f"{label} failed on {moment['id']}: {e}", 1)
    after = None
    if isinstance(v, (tuple, list)):
        v, after = (v[0], v[1]) if len(v) > 1 else (v[0], None)
    v = (v or "pass").strip().lower() if isinstance(v, str) else ("pass" if v is None else v)
    if v != "pass" and v not in VERDICTS:
        die(f"{label} answered {v!r} on {moment['id']}: want pass or one of {', '.join(VERDICTS)}", 1)
    if v != "pass" and after is not None and moment.get("gap_s") is not None and float(after) > moment["gap_s"]:
        return "late", float(after)
    return v, (float(after) if after is not None else None)


def saved(v, after, mo):
    """Seconds of a stall's stand a verdict would have cut: from after_s (the stall's start when none) to its end."""
    if v not in VERDICTS or mo.get("stood_s") is None:
        return 0
    return max(0, int(mo["stood_s"] - (after or 0)))


# ── score ─────────────────────────────────────────────────────────────────────────────────────────────────────────

def score(moments, old, new, verbose=False, held=None, held_only=False):
    """held: how many held-out stall moments split_held left out (or, held_only, kept); None when there were none."""
    (on, of), (nn, nf) = old, new
    rows = {"nudge": collections.OrderedDict(), "failure": collections.OrderedDict(), "stall": collections.OrderedDict()}
    ctl = {"n": 0, "old": 0, "new": 0}
    why = collections.Counter()
    lines = []
    for mo in moments:
        src = mo.get("source")
        if src == "control":
            if not mo.get("replayable"):
                continue
            ctl["n"] += 1
            ctl["old"] += verdict(of, mo, on) in VERDICTS
            ctl["new"] += verdict(nf, mo, nn) in VERDICTS
            continue
        if src not in rows:
            continue
        r = rows[src].setdefault(mo.get("class") or "?", collections.Counter())
        r["total"] += 1
        if not mo.get("replayable"):
            r["unrep"] += 1
            why[f"{src}: {mo.get('why') or 'unknown'}"] += 1
            continue
        r["rep"] += 1
        (vo, ao), (vn, an) = judged(of, mo, on), judged(nf, mo, nn)
        if src == "stall":
            r["stood"] += mo.get("stood_s") or 0
            r["s_old"] += saved(vo, ao, mo)
            r["s_new"] += saved(vn, an, mo)
        po, pn = vo in VERDICTS, vn in VERDICTS
        r["old"] += po
        r["new"] += pn
        r["gained"] += pn and not po
        r["lost"] += po and not pn
        r["late"] += vn == "late"
        if pn:
            r[f"v:{vn}"] += 1
        if verbose and (po or pn or "late" in (vo, vn)):
            lines.append(f"  {mo['id']}  {mo.get('class')}  old={vo} new={vn}")
    out = [f"cc-replay-moments: old={on} new={nn}"]
    for src, title in (("nudge", "NUDGES by class"), ("failure", "FAILURES by kind"), ("stall", "STALLS by kind")):
        if not rows[src]:
            continue
        tab = sorted(rows[src].items(), key=lambda kv: (-kv[1]["total"], kv[0]))
        w = max(12, max(len(k) for k, _ in tab))
        mins = src == "stall"           # minutes, floored: waited (replayable stalls), cut by old, cut by new
        hd = f"  {'waited':>6}  {'cut_old':>7}  {'cut_new':>7}" if mins else ""
        out += ["", title, f"{'class':<{w}}  {'total':>5}  {'replay':>6}  {'unrep':>5}  {'old':>4}  {'new':>4}  "
                            f"{'gained':>6}  {'lost':>4}  {'late':>4}{hd}  new verdicts"]
        tot = collections.Counter()

        def mn(r):
            return f"  {r['stood'] // 60:>6}  {r['s_old'] // 60:>7}  {r['s_new'] // 60:>7}" if mins else ""
        for k, r in tab:
            tot.update(r)
            vs = ", ".join(f"{v} {r[f'v:{v}']}" for v in VERDICTS if r[f"v:{v}"])
            out.append(f"{k:<{w}}  {r['total']:>5}  {r['rep']:>6}  {r['unrep']:>5}  {r['old']:>4}  {r['new']:>4}  "
                       f"{r['gained']:>6}  {r['lost']:>4}  {r['late']:>4}{mn(r)}  {vs}")
        out.append(f"{'total':<{w}}  {tot['total']:>5}  {tot['rep']:>6}  {tot['unrep']:>5}  {tot['old']:>4}  "
                   f"{tot['new']:>4}  {tot['gained']:>6}  {tot['lost']:>4}  {tot['late']:>4}{mn(tot)}")
        if mins:
            out.append("minutes: waited is how long the replayable stalls stood; cut_old and cut_new are the minutes of "
                       "it each version would have cut")
    out += ["", f"control: {ctl['n']} other owner messages in the labels' span; old fires before {ctl['old']}, "
                f"new before {ctl['new']}"]
    if held is not None:
        out.append(f"held out: scored only the {held} held-out stall moments" if held_only else
                   f"held out: {held} stall moments left out; only --held-out scores them")
    if why:
        out.append("unreplayable: " + "; ".join(f"{k} {v}" for k, v in sorted(why.items())))
    if verbose and lines:
        print("\n".join(lines), file=sys.stderr)
    return "\n".join(out)


# ── cli ───────────────────────────────────────────────────────────────────────────────────────────────────────────

def opts(argv, flags, valued):
    o, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in flags:
            o[a] = True
        elif a in valued and i + 1 < len(argv):
            o[a] = argv[i + 1]
            i += 1
        else:
            die(f"unknown or incomplete argument {a!r}\n{USAGE}")
        i += 1
    return o


def moments_from(o):
    """-> (moments, held count): the moments this run may see, the held-out stalls split off on every run."""
    if o.get("--moments"):
        ms = jsonl(o["--moments"])
        if not ms:
            die(f"no moments in {o['--moments']}")
    else:
        if not o.get("--labels") and not o.get("--stalls"):
            die(f"need --moments, --labels or --stalls\n{USAGE}")
        ms = extract(o.get("--labels"), o.get("--snapshots") or SNAPSHOTS, o.get("--slack") or SLACK,
                     o.get("--stalls") or STALLS)
    return split_held(ms, bool(o.get("--held-out")))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__ if argv else USAGE)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "selfcheck":
        return selfcheck()
    if cmd == "extract":
        o = opts(rest, ("--held-out",), ("--labels", "--snapshots", "--slack", "--stalls", "--out"))
        if not (o.get("--labels") or o.get("--stalls")) or not o.get("--out"):
            die(USAGE)
        ms, held = moments_from(o)
        tmp = o["--out"] + ".tmp"
        with open(tmp, "w") as fh:
            for m in ms:
                fh.write(json.dumps(m, sort_keys=True) + "\n")
        os.replace(tmp, o["--out"])
        c = collections.Counter((m["source"], bool(m.get("replayable"))) for m in ms)
        print(f"cc-replay-moments: wrote {len(ms)} moments to {o['--out']}: "
              + ", ".join(f"{s} {c[(s, True)]} replayable / {c[(s, True)] + c[(s, False)]}"
                          for s in ("nudge", "failure", "control", "stall"))
              + ("" if held is None else f"; {held} held-out stall moments "
                 + ("only" if o.get("--held-out") else "left out")))
        return 0
    if cmd == "score":
        o = opts(rest, ("--verbose", "--held-out"), ("--new", "--old", "--moments", "--labels", "--snapshots", "--slack",
                                                     "--stalls"))
        if not o.get("--new"):
            die(USAGE)
        ms, held = moments_from(o)
        print(score(ms, load_version(o.get("--old")), load_version(o["--new"]), o.get("--verbose", False), held,
                    bool(o.get("--held-out"))))
        return 0
    die(USAGE)


# ── selfcheck ─────────────────────────────────────────────────────────────────────────────────────────────────────

def selfcheck(*a, **k):
    """The cases are core/tests/selfcheck/cc-replay-moments.py, run in THIS namespace so their stubs and `global`
    rebinds land on the tool as they did when the body was here. Defining them replaces this selfcheck()."""
    path = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "tests", "selfcheck", "cc-replay-moments.py")
    with open(path, encoding="utf-8") as fh:
        exec(compile(fh.read(), path, "exec"), globals())
    return globals()["selfcheck"](*a, **k)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
