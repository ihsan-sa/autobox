#!/usr/bin/env python3
"""cc-replay-moments — before a fix is built, count the past owner nudges, recorded failures and stalls it would have prevented.

  cc-replay-moments extract [--labels FILE] [--snapshots DIR] [--slack DIR] [--stalls FILE] [--held-out] --out FILE
      Rebuild the moment behind every labelled nudge, every recorded failure and every stall, and write them one JSON
      line each. Held-out stall moments are left out of the file; --held-out writes only them.
  cc-replay-moments score --new PATH [--old PATH] (--moments FILE | [--labels FILE] [--snapshots DIR] [--slack DIR]
                          [--stalls FILE]) [--held-out] [--verbose]
      Run every moment through the OLD and the NEW version of a rule and print, per class, how many moments could be
      replayed and how many each version would have prevented, and for stalls the minutes of waiting each would have
      saved. --verbose lists each moment either version fired on. --held-out scores the held-out stall moments and
      nothing else.
  cc-replay-moments selfcheck

A MOMENT is what the box had in front of it just before a nudge: the owner message (time, chat, thread, text) and the
box post before it — the last post in the same thread, else the last in the same chat, with reactions and failed posts
skipped (the nudge pass's own rule). It is read from the collector's snapshots first (their slack.jsonl carries the
box post already), then from the Slack archive and the outbox log for the days no snapshot covers. A labelled nudge
whose message or box post cannot be found is UNREPLAYABLE: it stays in the table as a count and is never dropped.
A failure is a moment too: each cluster in the snapshots' failures.jsonl stands for `n` records, the examples it
quotes are the text the writer saw and are replayable, and the rest of its `n` are counted unreplayable.
The owner messages in the labels' own time span that were NOT labelled are CONTROL moments: nothing is prevented
there, and a version that fires on many of them is firing on ordinary traffic, not on the fault.

A STALL is a stretch where a session stood without progress until a person or a sweep ended it. It is read from
cc-stall's log (--stalls, default ~/.cc/state/stall.log): each `raised <row>` line is one stall, and it began
"stood N min" before the line (minute-floored, as the log prints it). It ended at the first sign on its board row, in
any snapshot day's board.jsonl, that someone dealt with it: a status of done, merged, dropped or closed, or a note that
starts "Closed" or "Dropped". `stood_s` is that stretch, and it is the moment's `gap_s` too. A raised stall whose row
has no such sign in the snapshots, a stall whose row the board refused and that was never raised after, and a dialog
the sweep pressed itself (the log does not say how long it stood) are UNREPLAYABLE, counted and never dropped. Stall
moments carry `window`, `class` (the stall's kind), `row`, `raised_at`, `text` (the log's own words), `stood_s`,
`ended_at` and `ended_by`. A version that fires on a stall `after_s` seconds after it began saves `stood_s - after_s`
of waiting (all of it when it names no after_s), and is LATE when after_s is past stood_s.
Loops, handoffs, landings and idle wake-ups are not stall sources here: landings are cc-replay's, and the others
record no start and end of a wait that a person or a sweep ended.

HELD OUT. One in four stall moments, chosen by sha256 of a salt and the moment's id, is held out, and so is every
stall raised at or after the stamp in `replay-heldout.from` (minute resolution; the word `lifted` there lifts it).
Both files sit in ~/.cc/state/<control repo>/architect/ (CC_REPLAY_HELDOUT_DIR overrides), and a run with stall
moments and no salt or stamp there is refused. extract and score leave held-out moments out and say how many;
only --held-out scores them, and then only them. The split is made on every run from the ids, never read from a
moments file.

A VERSION is a file. A Python file (`.py`, or any file that defines `judge`) is imported and `judge(moment)` is
called; anything else is executed once per moment with the moment as JSON on stdin and read from the first word of
stdout. Either way it answers one of: `pass` (or nothing) — the moment goes as it went — or `refused`, `rewritten`,
`status` (a push reached the owner) or `flagged`. A Python judge may return `(verdict, after_s)`, and an executable
may print `<verdict> <after_s>`: the version acts `after_s` seconds after the box post, and a moment where that falls
after the owner's message is LATE — the nudge had already happened, so it counts as not prevented. `--old` defaults to
a version that never fires, which is what the box did in history by definition: every nudge in the labels happened.
A replayed old version that claims to prevent some is the replay's own error bar, read it before the new column.

No model, no network, no clock: the same inputs print the same bytes. It reads the labels, the snapshots, the archive,
the outbox log, the stall log and the held-out files and writes only --out. It posts nothing and records nothing. Stdlib only; no box's repo names,
channels or people are in this file — the labels and snapshots are data and live outside the repo.
"""
import calendar, collections, glob, hashlib, importlib.util, json, os, re, shutil, subprocess, sys, tempfile, time

HOME = os.path.expanduser("~")
SNAPSHOTS = os.environ.get("CC_REPLAY_SNAPSHOTS") or f"{HOME}/.cc/state/improve/snapshots"
SLACK = os.environ.get("CC_REPLAY_SLACK") or f"{HOME}/.cc/slack"
STALLS = os.environ.get("CC_REPLAY_STALLS") or f"{HOME}/.cc/state/stall.log"
BIN = os.path.dirname(os.path.realpath(__file__))
STALL_ENDS = ("done", "merged", "dropped", "closed")      # a status on a stall's row that says someone dealt with it
STALL_END_NOTE = re.compile(r"(closed|dropped)\b", re.I)  # …or a note that starts so
REFUSED_WINDOW_S = 900                                    # a refused row raised again within this is the same stall
HELD_EVERY = 4                                            # one in this many stall moments is held out
VERDICTS = ("refused", "rewritten", "status", "flagged")
SKIP_KINDS = ("post-failed",)          # and every react*: a reaction is not a post the owner read as the box's answer
USAGE = ("usage: cc-replay-moments extract [--labels FILE] [--snapshots DIR] [--slack DIR] [--stalls FILE] [--held-out] "
         "--out FILE\n"
         "       cc-replay-moments score --new PATH [--old PATH] (--moments FILE | [--labels FILE] [--snapshots DIR] "
         "[--slack DIR] [--stalls FILE]) [--held-out] [--verbose]\n"
         "       cc-replay-moments selfcheck")


def die(msg, rc=2):
    print(f"cc-replay-moments: {msg}", file=sys.stderr)
    sys.exit(rc)


def secs(stamp):
    """ISO UTC (…Z, seconds optional) -> epoch seconds; None stays None."""
    if not stamp:
        return None
    s = stamp.rstrip("Z")
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M"):
        try:
            return calendar.timegm(time.strptime(s[:19] if fmt.endswith("%S") else s[:16], fmt))
        except ValueError:
            continue
    return None


def jsonl(path):
    out = []
    try:
        with open(path, errors="replace") as fh:
            for line in fh:
                try:
                    out.append(json.loads(line))
                except ValueError:
                    continue
    except OSError:
        pass
    return out


def day_dirs(root):
    """A snapshot root (its day dirs, oldest first, the `latest` link skipped) or one day dir itself."""
    if not root or not os.path.isdir(root):
        return []
    if os.path.exists(os.path.join(root, "index.json")) or os.path.exists(os.path.join(root, "slack.jsonl")):
        return [root]
    return [d for d in sorted(glob.glob(os.path.join(root, "*")))
            if os.path.isdir(d) and not os.path.islink(d) and re.fullmatch(r"\d{4}-\d{2}-\d{2}", os.path.basename(d))]


# ── extract ───────────────────────────────────────────────────────────────────────────────────────────────────────

def load_sources(snapshots, slack):
    """Owner messages keyed (chat, ts) with the source each came from, and the outbox posts by thread and by chat."""
    msgs = {}
    for d in day_dirs(snapshots):
        for r in jsonl(os.path.join(d, "slack.jsonl")):
            if r.get("role") == "owner" and r.get("chat") and r.get("ts"):
                msgs[(r["chat"], r["ts"])] = dict(r, src="snapshot")
    for f in sorted(glob.glob(os.path.join(slack, "archive", "**", "*.jsonl"), recursive=True)):
        for r in jsonl(f):
            if r.get("role") == "owner" and r.get("chat") and r.get("ts"):
                msgs.setdefault((r["chat"], r["ts"]), dict(r, src="archive"))
    by_thread, by_chat = collections.defaultdict(list), collections.defaultdict(list)
    try:
        with open(os.path.join(slack, "outbox.log"), errors="replace") as fh:
            for line in fh:
                p = line.rstrip("\n").split("\t")
                if len(p) < 5 or p[1].startswith("react") or p[1] in SKIP_KINDS:
                    continue
                post = {"at": p[0], "kind": p[1], "text": "\t".join(p[4:])}
                by_thread[(p[2], p[3])].append(post)
                by_chat[p[2]].append(post)
    except OSError:
        pass
    for lst in list(by_thread.values()) + list(by_chat.values()):
        lst.sort(key=lambda x: x["at"])
    return msgs, by_thread, by_chat


def box_before(m, by_thread, by_chat):
    """The box post the owner saw last before message m: the snapshot's own when it has one, else the outbox's."""
    if m.get("prev_box"):
        return m["prev_box"]
    th, at = m.get("thread_ts") or m["ts"], m.get("at") or ""
    cands = []
    if th != m["ts"]:
        cands = [x for x in by_thread.get((m["chat"], th), []) if x["at"] < at]
    if not cands:
        cands = [x for x in by_chat.get(m["chat"], []) if x["at"] < at]
    return cands[-1] if cands else None


def moment_of(m, cls, source, by_thread, by_chat):
    prev = box_before(m, by_thread, by_chat)
    a, b = secs(m.get("at")), secs(prev.get("at")) if prev else None
    mo = {"id": f"{source[0]}:{m['chat']}:{m['ts']}", "source": source, "class": cls, "at": m.get("at"),
          "chat": m["chat"], "thread_ts": m.get("thread_ts") or m["ts"], "in_thread": (m.get("thread_ts") or m["ts"]) != m["ts"],
          "text": m.get("text") or "", "prev_box": prev, "gap_s": (a - b) if a is not None and b is not None else None,
          "src": m.get("src"), "replayable": prev is not None}
    if prev is None:
        mo["why"] = "no box post before it"
    return mo


def stall_ends(snapshots):
    """Row ("repo/track") -> (epoch, ISO, by): the first sign in any snapshot day's board.jsonl that someone ended it.
    The board's stamps are "MM-DDTHH:MM"; the year is the snapshot day's."""
    ends = {}
    for d in day_dirs(snapshots):
        year = os.path.basename(os.path.normpath(d))[:4]
        for r in jsonl(os.path.join(d, "board.jsonl")):
            row = f"{r.get('repo')}/{r.get('track')}"
            for entry, is_note in [(x, False) for x in r.get("statuses") or []] + [(x, True) for x in r.get("notes") or []]:
                if not isinstance(entry, str) or " " not in entry:
                    continue
                stamp, word = entry.split(" ", 1)
                if is_note and not STALL_END_NOTE.match(word):
                    continue
                if not is_note and word.strip() not in STALL_ENDS:
                    continue
                at = secs(f"{year}-{stamp}")
                by = STALL_END_NOTE.match(word).group(1).lower() if is_note else word.strip()
                if at is not None and (row not in ends or at < ends[row][0]):
                    ends[row] = (at, f"{year}-{stamp}:00Z", f"{by} note" if is_note else by)
    return ends


def stall_moments(stalls, snapshots):
    """One moment per stall in cc-stall's log; see STALL in the docstring for what replays and what does not."""
    lines = []
    try:
        with open(stalls, errors="replace") as fh:
            for line in fh:
                p = line.rstrip("\n").split("\t")
                if len(p) >= 4 and secs(p[0]) is not None:
                    lines.append((p[0], p[1], p[2], p[3], "\t".join(p[4:])))
    except OSError:
        return []
    ends, out, seen = stall_ends(snapshots), [], set()
    for i, (at, window, kind, action, detail) in enumerate(lines):
        base = {"source": "stall", "class": kind, "window": window, "raised_at": at, "text": detail, "prev_box": None,
                "stood_s": None, "gap_s": None, "replayable": False}
        if action.startswith("raised "):
            row = action.split()[1]
            m = re.search(r"stood (\d+) min", detail)
            start = secs(at) - int(m.group(1)) * 60 if m else None
            mo = dict(base, id=f"s:{row}", row=row,
                      at=time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(start)) if start is not None else at)
            end = ends.get(row)
            if start is None:
                mo["why"] = "the log does not say how long it had stood"
            elif end is None or end[0] < secs(at):
                mo["why"] = "no board snapshot records how its row ended"
            else:
                mo.update(stood_s=end[0] - start, gap_s=end[0] - start, ended_at=end[1], ended_by=end[2], replayable=True)
        elif action.startswith("board refused "):
            row = action.split()[2]
            later = any(k == kind and w == window and a.startswith("raised ") and 0 <= secs(t) - secs(at) <= REFUSED_WINDOW_S
                        for t, w, k, a, _ in lines[i + 1:])
            if later or f"s:{row}" in seen:   # the same stall, raised on a later pass or already counted as refused
                continue
            mo = dict(base, id=f"s:{row}", row=row, at=at, why="the board refused its row and it was never raised")
        elif action.startswith("pressed "):
            mo = dict(base, id=f"s:{window}:{kind}:{at}", at=at,
                      why="the sweep pressed it; the log does not say how long it stood")
        else:
            continue
        seen.add(mo["id"])
        out.append(mo)
    return out


def extract(labels, snapshots, slack, stalls=None):
    lab = jsonl(labels) if labels else []
    if labels and not lab:
        die(f"no labelled nudges in {labels}")
    msgs, by_thread, by_chat = load_sources(snapshots, slack) if lab else ({}, {}, {})
    out, labelled = [], set()
    for r in lab:
        key = (r.get("chat"), r.get("ts"))
        labelled.add(key)
        m = msgs.get(key)
        if m is None:
            out.append({"id": f"n:{key[0]}:{key[1]}", "source": "nudge", "class": r.get("class") or "?", "at": None,
                        "replayable": False, "why": "message not in the snapshots or the archive"})
        else:
            out.append(moment_of(m, r.get("class") or "?", "nudge", by_thread, by_chat))
    found = sorted(x["at"] for x in out if x.get("at"))
    if found:                           # CONTROL: the owner's other messages over the span the labels were read over
        lo, hi = found[0], found[-1]
        for key, m in msgs.items():
            if key not in labelled and lo <= (m.get("at") or "") <= hi:
                mo = moment_of(m, "-", "control", by_thread, by_chat)
                mo["id"] = f"c:{key[0]}:{key[1]}"
                out.append(mo)
    for d in day_dirs(snapshots):
        day = os.path.basename(os.path.normpath(d))
        for c in jsonl(os.path.join(d, "failures.jsonl")):
            kind, ex = c.get("kind") or "?", [e for e in (c.get("examples") or []) if isinstance(e, str) and e.strip()]
            cid, n = (c.get("clusters") or ["?"])[0], max(int(c.get("n") or 0), len(ex))
            for i in range(n):
                mo = {"id": f"f:{day}:{cid}:{i}", "source": "failure", "class": kind, "at": c.get("last"),
                      "repo": c.get("repo"), "writers": c.get("writers") or [], "expected": c.get("expected") or "",
                      "text": ex[i] if i < len(ex) else "", "prev_box": None, "gap_s": None, "replayable": i < len(ex)}
                if i >= len(ex):
                    mo["why"] = "the snapshot quotes no text for this record"
                out.append(mo)
    if stalls:
        out += stall_moments(stalls, snapshots)
    out.sort(key=lambda x: (x["source"], x.get("at") or "", x["id"]))
    return out


# ── held out ──────────────────────────────────────────────────────────────────────────────────────────────────────

def ctl():
    """The control repo: the one this bin/ is checked out under in ~/dev or ~/.cc/worktrees (cc-stall's ctl())."""
    for root in (f"{HOME}/dev", f"{HOME}/.cc/worktrees"):
        rel = os.path.relpath(BIN, root)
        if not rel.startswith(".."):
            return rel.split(os.sep)[0]
    return "box"


def heldout_files(d=None):
    """(salt, from): the salt that picks one in HELD_EVERY stall moments, and the stamp from which every stall is held
    out ('lifted' when the architect has lifted it). Refused when either is missing or not what it should be."""
    d = d or os.environ.get("CC_REPLAY_HELDOUT_DIR") or f"{HOME}/.cc/state/{ctl()}/architect"
    try:
        with open(os.path.join(d, "replay-heldout.salt")) as fh:
            salt = fh.read().strip()
        with open(os.path.join(d, "replay-heldout.from")) as fh:
            frm = fh.read().strip()
    except OSError as e:
        die(f"stall moments need the held-out files in {d}: {e.strerror}: {e.filename}")
    if not re.fullmatch(r"[0-9a-f]{32}", salt):
        die(f"{d}/replay-heldout.salt is not 32 hex characters")
    if frm != "lifted" and secs(frm) is None:
        die(f"{d}/replay-heldout.from holds neither an ISO stamp nor 'lifted'")
    return salt, frm


def is_held_out(mo, salt, frm):
    """A stall moment is held out by its id's hash, or by being raised at or after the stamp (both minute-floored,
    so a stall raised in the stamp's own minute is held out)."""
    if mo.get("source") != "stall":
        return False
    if int(hashlib.sha256(f"{salt}\0{mo['id']}".encode()).hexdigest()[:8], 16) % HELD_EVERY == 0:
        return True
    return frm != "lifted" and (mo.get("raised_at") or mo.get("at") or "")[:16] >= frm[:16]


def split_held(moments, held, files=None):
    """-> (the moments this run scores, how many held-out stall moments it left out or kept).
    held=False: every moment but the held-out stalls. held=True: the held-out stalls and nothing else."""
    if not held and not any(m.get("source") == "stall" for m in moments):
        return moments, None
    salt, frm = files or heldout_files()
    # brief: "score leaves held-out moments out by default ... only an explicit --held-out flag scores them, and only them"
    keep = [m for m in moments if (m.get("source") == "stall" and is_held_out(m, salt, frm)) == held]
    n = sum(1 for m in moments if m.get("source") == "stall" and is_held_out(m, salt, frm))
    return keep, n


# ── versions ──────────────────────────────────────────────────────────────────────────────────────────────────────

def never(_moment):
    return "pass"


def load_version(path):
    """A callable moment -> (verdict, after_s). None is the version that never fires."""
    if not path or path == "none":
        return "none", never
    if not os.path.isfile(path):
        die(f"no version at {path}")
    name = os.path.basename(path)
    with open(path, errors="replace") as fh:
        src = fh.read()
    if path.endswith(".py") or re.search(r"^def judge\(", src, re.M):
        spec = importlib.util.spec_from_loader(f"ccrm_{abs(hash(path))}", loader=None, origin=path)
        mod = importlib.util.module_from_spec(spec)
        mod.__file__ = path
        exec(compile(src, path, "exec"), mod.__dict__)
        if not callable(getattr(mod, "judge", None)):
            die(f"{path} defines no judge(moment)")
        return name, mod.judge
    if not os.access(path, os.X_OK):
        die(f"{path} is neither a Python judge nor executable")

    def run(moment):
        p = subprocess.run([path], input=json.dumps(moment), capture_output=True, text=True, timeout=30)
        if p.returncode != 0:
            raise RuntimeError(f"exit {p.returncode}: {p.stderr.strip()[:200]}")
        w = p.stdout.split()
        return (w[0], float(w[1])) if len(w) > 1 else (w[0] if w else "pass")
    return name, run


def verdict(fn, moment, label):
    """-> 'pass' | a VERDICT | 'late'. A version that raises or answers another word stops the run: a count built on
    a judge that failed half the time is not a count."""
    return judged(fn, moment, label)[0]


def judged(fn, moment, label):
    """-> (verdict, after_s or None), the verdict as verdict() gives it."""
    try:
        v = fn(dict(moment))
    except Exception as e:                      # noqa: BLE001 — the candidate's own fault, named with its moment
        die(f"{label} failed on {moment['id']}: {e}", 1)
    after = None
    if isinstance(v, (tuple, list)):
        v, after = (v[0], v[1]) if len(v) > 1 else (v[0], None)
    v = (v or "pass").strip().lower() if isinstance(v, str) else ("pass" if v is None else v)
    if v != "pass" and v not in VERDICTS:
        die(f"{label} answered {v!r} on {moment['id']}: want pass or one of {', '.join(VERDICTS)}", 1)
    if v != "pass" and after is not None and moment.get("gap_s") is not None and float(after) > moment["gap_s"]:
        return "late", float(after)
    return v, (float(after) if after is not None else None)


def saved(v, after, mo):
    """Seconds of a stall's stand a verdict would have cut: from after_s (the stall's start when none) to its end."""
    if v not in VERDICTS or mo.get("stood_s") is None:
        return 0
    return max(0, int(mo["stood_s"] - (after or 0)))


# ── score ─────────────────────────────────────────────────────────────────────────────────────────────────────────

def score(moments, old, new, verbose=False, held=None, held_only=False):
    """held: how many held-out stall moments split_held left out (or, held_only, kept); None when there were none."""
    (on, of), (nn, nf) = old, new
    rows = {"nudge": collections.OrderedDict(), "failure": collections.OrderedDict(), "stall": collections.OrderedDict()}
    ctl = {"n": 0, "old": 0, "new": 0}
    why = collections.Counter()
    lines = []
    for mo in moments:
        src = mo.get("source")
        if src == "control":
            if not mo.get("replayable"):
                continue
            ctl["n"] += 1
            ctl["old"] += verdict(of, mo, on) in VERDICTS
            ctl["new"] += verdict(nf, mo, nn) in VERDICTS
            continue
        if src not in rows:
            continue
        r = rows[src].setdefault(mo.get("class") or "?", collections.Counter())
        r["total"] += 1
        if not mo.get("replayable"):
            r["unrep"] += 1
            why[f"{src}: {mo.get('why') or 'unknown'}"] += 1
            continue
        r["rep"] += 1
        (vo, ao), (vn, an) = judged(of, mo, on), judged(nf, mo, nn)
        if src == "stall":
            r["stood"] += mo.get("stood_s") or 0
            r["s_old"] += saved(vo, ao, mo)
            r["s_new"] += saved(vn, an, mo)
        po, pn = vo in VERDICTS, vn in VERDICTS
        r["old"] += po
        r["new"] += pn
        r["gained"] += pn and not po
        r["lost"] += po and not pn
        r["late"] += vn == "late"
        if pn:
            r[f"v:{vn}"] += 1
        if verbose and (po or pn or "late" in (vo, vn)):
            lines.append(f"  {mo['id']}  {mo.get('class')}  old={vo} new={vn}")
    out = [f"cc-replay-moments: old={on} new={nn}"]
    for src, title in (("nudge", "NUDGES by class"), ("failure", "FAILURES by kind"), ("stall", "STALLS by kind")):
        if not rows[src]:
            continue
        tab = sorted(rows[src].items(), key=lambda kv: (-kv[1]["total"], kv[0]))
        w = max(12, max(len(k) for k, _ in tab))
        mins = src == "stall"           # minutes, floored: waited (replayable stalls), cut by old, cut by new
        hd = f"  {'waited':>6}  {'cut_old':>7}  {'cut_new':>7}" if mins else ""
        out += ["", title, f"{'class':<{w}}  {'total':>5}  {'replay':>6}  {'unrep':>5}  {'old':>4}  {'new':>4}  "
                            f"{'gained':>6}  {'lost':>4}  {'late':>4}{hd}  new verdicts"]
        tot = collections.Counter()

        def mn(r):
            return f"  {r['stood'] // 60:>6}  {r['s_old'] // 60:>7}  {r['s_new'] // 60:>7}" if mins else ""
        for k, r in tab:
            tot.update(r)
            vs = ", ".join(f"{v} {r[f'v:{v}']}" for v in VERDICTS if r[f"v:{v}"])
            out.append(f"{k:<{w}}  {r['total']:>5}  {r['rep']:>6}  {r['unrep']:>5}  {r['old']:>4}  {r['new']:>4}  "
                       f"{r['gained']:>6}  {r['lost']:>4}  {r['late']:>4}{mn(r)}  {vs}")
        out.append(f"{'total':<{w}}  {tot['total']:>5}  {tot['rep']:>6}  {tot['unrep']:>5}  {tot['old']:>4}  "
                   f"{tot['new']:>4}  {tot['gained']:>6}  {tot['lost']:>4}  {tot['late']:>4}{mn(tot)}")
        if mins:
            out.append("minutes: waited is how long the replayable stalls stood; cut_old and cut_new are the minutes of "
                       "it each version would have cut")
    out += ["", f"control: {ctl['n']} other owner messages in the labels' span; old fires before {ctl['old']}, "
                f"new before {ctl['new']}"]
    if held is not None:
        out.append(f"held out: scored only the {held} held-out stall moments" if held_only else
                   f"held out: {held} stall moments left out; only --held-out scores them")
    if why:
        out.append("unreplayable: " + "; ".join(f"{k} {v}" for k, v in sorted(why.items())))
    if verbose and lines:
        print("\n".join(lines), file=sys.stderr)
    return "\n".join(out)


# ── cli ───────────────────────────────────────────────────────────────────────────────────────────────────────────

def opts(argv, flags, valued):
    o, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in flags:
            o[a] = True
        elif a in valued and i + 1 < len(argv):
            o[a] = argv[i + 1]
            i += 1
        else:
            die(f"unknown or incomplete argument {a!r}\n{USAGE}")
        i += 1
    return o


def moments_from(o):
    """-> (moments, held count): the moments this run may see, the held-out stalls split off on every run."""
    if o.get("--moments"):
        ms = jsonl(o["--moments"])
        if not ms:
            die(f"no moments in {o['--moments']}")
    else:
        if not o.get("--labels") and not o.get("--stalls"):
            die(f"need --moments, --labels or --stalls\n{USAGE}")
        ms = extract(o.get("--labels"), o.get("--snapshots") or SNAPSHOTS, o.get("--slack") or SLACK,
                     o.get("--stalls") or STALLS)
    return split_held(ms, bool(o.get("--held-out")))


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__ if argv else USAGE)
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "selfcheck":
        return selfcheck()
    if cmd == "extract":
        o = opts(rest, ("--held-out",), ("--labels", "--snapshots", "--slack", "--stalls", "--out"))
        if not (o.get("--labels") or o.get("--stalls")) or not o.get("--out"):
            die(USAGE)
        ms, held = moments_from(o)
        tmp = o["--out"] + ".tmp"
        with open(tmp, "w") as fh:
            for m in ms:
                fh.write(json.dumps(m, sort_keys=True) + "\n")
        os.replace(tmp, o["--out"])
        c = collections.Counter((m["source"], bool(m.get("replayable"))) for m in ms)
        print(f"cc-replay-moments: wrote {len(ms)} moments to {o['--out']}: "
              + ", ".join(f"{s} {c[(s, True)]} replayable / {c[(s, True)] + c[(s, False)]}"
                          for s in ("nudge", "failure", "control", "stall"))
              + ("" if held is None else f"; {held} held-out stall moments "
                 + ("only" if o.get("--held-out") else "left out")))
        return 0
    if cmd == "score":
        o = opts(rest, ("--verbose", "--held-out"), ("--new", "--old", "--moments", "--labels", "--snapshots", "--slack",
                                                     "--stalls"))
        if not o.get("--new"):
            die(USAGE)
        ms, held = moments_from(o)
        print(score(ms, load_version(o.get("--old")), load_version(o["--new"]), o.get("--verbose", False), held,
                    bool(o.get("--held-out"))))
        return 0
    die(USAGE)


# ── selfcheck ─────────────────────────────────────────────────────────────────────────────────────────────────────

def selfcheck():
    fails, passed = [], [0]

    def ok(name, cond):
        if cond:
            passed[0] += 1
        else:
            fails.append(name)
            print(f"FAIL {name}")

    root = tempfile.mkdtemp(prefix="cc-replay-moments-selfcheck-")
    # the box's own stall log and held-out files never reach a case: the nudge cases run with no stall log at all, and
    # an empty held-out dir proves a run with no stall moments needs no salt
    os.environ["CC_REPLAY_STALLS"] = os.path.join(root, "no-stall.log")
    os.environ["CC_REPLAY_HELDOUT_DIR"] = os.path.join(root, "no-heldout")
    try:
        snaps, slack = os.path.join(root, "snaps"), os.path.join(root, "slack")
        day = os.path.join(snaps, "2026-01-05")
        os.makedirs(day)
        os.makedirs(os.path.join(slack, "archive", "p", "CA"))
        os.symlink("2026-01-05", os.path.join(snaps, "latest"))

        def w(path, rows):
            with open(path, "w") as fh:
                for r in rows:
                    fh.write((r if isinstance(r, str) else json.dumps(r)) + "\n")

        def own(ts, at, text, chat="CA", th=None):
            return {"ts": ts, "thread_ts": th or ts, "chat": chat, "role": "owner", "text": text, "at": at}
        # archive: n1 in a thread with a box post in it; n2 top-level (falls back to the chat's last post); n3 in a
        # chat with no box post at all; c1 an unlabelled message (control); c9 outside the labels' span
        w(os.path.join(slack, "archive", "p", "CA", "2026-01.jsonl"), [
            own("100.1", "2026-01-04T10:00:00Z", "where are we", th="90.0"),
            own("200.1", "2026-01-04T12:00:00Z", "status?"),
            own("300.1", "2026-01-04T13:00:00Z", "hello?", chat="CB"),
            own("250.1", "2026-01-04T12:20:00Z", "thanks"),
            own("900.1", "2026-01-06T00:00:00Z", "later"),
            {"ts": "260.1", "chat": "CA", "role": "member", "text": "not the owner", "at": "2026-01-04T12:40:00Z"}])
        w(os.path.join(slack, "outbox.log"), [
            "2026-01-04T09:00:00Z\tpost\tCA\t90.0\tIt's queued to land, no thumbs needed.",
            "2026-01-04T09:30:00Z\tpost\tCA\t\ta top-level post",
            "2026-01-04T09:59:00Z\treact\tCA\t90.0\teyes",
            "2026-01-04T09:59:30Z\tpost-failed\tCA\t90.0\tnever reached anyone",
            "2026-01-04T11:50:00Z\tpost\tCA\t\tI've started building it.",
            "2026-01-04T12:29:00Z\tpost\tCA\t\tDone: it landed."])
        # snapshot: n4 carries its own prev_box (the archive does not have n4 at all); a failure cluster of n=3 quoting 2
        w(os.path.join(day, "slack.jsonl"), [dict(own("400.1", "2026-01-05T08:00:00Z", "done yet?", chat="CC"),
                                                  prev_box={"at": "2026-01-05T06:00:00Z", "kind": "post",
                                                            "text": "Running now: the fix."}, src="x")])
        w(os.path.join(day, "failures.jsonl"), [{"clusters": ["c-1"], "kind": "notification/false-action-needed",
                                                 "examples": ["the watchdog said land it while it was landing", "again"],
                                                 "n": 3, "last": "2026-01-05T07:00:00Z", "writers": ["w"]}])
        labels = os.path.join(root, "labels.jsonl")
        w(labels, [{"ts": "100.1", "chat": "CA", "class": "landing-chase"},
                   {"ts": "200.1", "chat": "CA", "class": "status-not-pushed"},
                   {"ts": "300.1", "chat": "CB", "class": "message-unseen"},
                   {"ts": "400.1", "chat": "CC", "class": "status-not-pushed"},
                   {"ts": "500.1", "chat": "CA", "class": "status-not-pushed"}])
        before = sorted(os.path.relpath(os.path.join(d, f), root) for d, _, fs in os.walk(root) for f in fs)
        ms = extract(labels, snaps, slack)
        by = {m["id"]: m for m in ms}
        n1, n2, n3, n4 = by.get("n:CA:100.1"), by.get("n:CA:200.1"), by.get("n:CB:300.1"), by.get("n:CC:400.1")
        ok("a nudge in a thread takes the thread's last box post, skipping reactions and failed posts",
           n1 and n1["prev_box"]["text"].startswith("It's queued") and n1["gap_s"] == 3600 and n1["in_thread"])
        ok("a top-level nudge takes the chat's last box post before it", n2 and n2["prev_box"]["text"] == "I've started building it."
           and n2["gap_s"] == 600)
        ok("a nudge with no box post before it is kept and counted unreplayable",
           n3 and not n3["replayable"] and n3["why"] == "no box post before it")
        ok("a snapshot's own box post is used first", n4 and n4["src"] == "snapshot" and n4["gap_s"] == 7200)
        ok("a labelled nudge found nowhere is kept, unreplayable",
           by.get("n:CA:500.1", {}).get("replayable") is False and "not in" in by["n:CA:500.1"]["why"])
        ctl = [m for m in ms if m["source"] == "control"]
        ok("control is the owner's unlabelled messages inside the labels' span only (no member, nothing after)",
           [m["id"] for m in ctl] == ["c:CA:250.1"] and ctl[0]["prev_box"]["text"] == "I've started building it.")
        fl = [m for m in ms if m["source"] == "failure"]
        ok("a failure cluster of n=3 quoting 2 examples is 2 replayable moments and 1 unreplayable",
           len(fl) == 3 and sum(m["replayable"] for m in fl) == 2 and fl[0]["class"] == "notification/false-action-needed")

        cand = os.path.join(root, "new.py")
        with open(cand, "w") as fh:
            fh.write("import re\n"
                     "def judge(m):\n"
                     "    if m['source'] == 'failure':\n"
                     "        return 'flagged' if 'landing' in m['text'] else None\n"
                     "    t = (m.get('prev_box') or {}).get('text', '')\n"
                     "    return ('status', 1800) if re.search(r'queued|started|running', t, re.I) else 'pass'\n")
        old = os.path.join(root, "old.py")
        with open(old, "w") as fh:
            fh.write("def judge(m):\n    return 'status' if 'queued' in ((m.get('prev_box') or {}).get('text') or '') else None\n")
        exe = os.path.join(root, "new.sh")
        with open(exe, "w") as fh:
            fh.write("#!/usr/bin/env python3\nimport json, re, sys\nm = json.load(sys.stdin)\n"
                     "t = (m.get('prev_box') or {}).get('text', '') if m['source'] != 'failure' else ''\n"
                     "if m['source'] == 'failure': print('flagged' if 'landing' in m['text'] else 'pass')\n"
                     "elif re.search(r'queued|started|running', t, re.I): print('status 1800')\n"
                     "else: print('pass')\n")
        os.chmod(exe, 0o755)
        rep = score(ms, load_version(old), load_version(cand))

        def row(title, cls, report=None):
            report = report or rep
            sect = report.split(title, 1)[1] if title in report else ""
            for ln in sect.splitlines():
                if ln.startswith(cls + " "):
                    return ln.split()
            return []
        s = row("NUDGES", "status-not-pushed")
        # status-not-pushed: n2 (started, 10 min gap < 30 min: late), n4 (running, 2 h gap: status), 500.1 unreplayable
        ok("per class: total, replayable, unreplayable, old, new, gained, lost, late",
           s[1:9] == ["3", "2", "1", "0", "1", "1", "0", "1"])
        lc = row("NUDGES", "landing-chase")
        ok("a moment both versions prevent is neither gained nor lost", lc[1:8] == ["1", "1", "0", "1", "1", "0", "0"])
        mu = row("NUDGES", "message-unseen")
        ok("an unreplayable nudge stays in its class's total", mu[1:4] == ["1", "0", "1"])
        fk = row("FAILURES", "notification/false-action-needed")
        ok("failures are scored by kind, unreplayable ones counted", fk[1:6] == ["3", "2", "1", "0", "1"])
        ok("control counts what each version fires on outside the nudges",
           "old fires before 0, new before 1" in rep)
        ok("the unreplayable reasons are listed", "nudge: no box post before it 1" in rep
           and "failure: the snapshot quotes no text for this record 1" in rep)
        ok("an executable version scores the same as the Python one",
           score(ms, load_version(old), load_version(exe)).split("\n", 1)[1] == rep.split("\n", 1)[1])
        dflt = [r.split() for r in score(ms, load_version(None), load_version(cand)).splitlines()]
        ok("--old defaults to never firing: every old column is 0",
           all(r[4] == "0" for r in dflt if len(r) > 8 and r[1].isdigit() and r[0] != "control:")
           and "old=none" in dflt[0][1])
        ok("the same input prints the same bytes", score(ms, load_version(old), load_version(cand)) == rep)
        after = sorted(os.path.relpath(os.path.join(d, f), root) for d, _, fs in os.walk(root) for f in fs)
        ok("extract and score write nothing beside the sources", set(after) - set(before) <= {"new.py", "old.py", "new.sh"})

        bad = os.path.join(root, "bad.py")
        with open(bad, "w") as fh:
            fh.write("def judge(m):\n    return 'maybe'\n")
        boom = os.path.join(root, "boom.py")
        with open(boom, "w") as fh:
            fh.write("def judge(m):\n    raise ValueError('no')\n")
        me = os.path.realpath(__file__)
        for name, path, want in (("a verdict outside the list stops the run", bad, "answered 'maybe'"),
                                 ("a judge that raises stops the run and names the moment", boom, "failed on ")):
            p = subprocess.run([sys.executable, me, "score", "--new", path, "--labels", labels, "--snapshots", snaps,
                                "--slack", slack], capture_output=True, text=True)
            ok(name, p.returncode == 1 and want in p.stderr)
        mf = os.path.join(root, "m.jsonl")
        p = subprocess.run([sys.executable, me, "extract", "--labels", labels, "--snapshots", day, "--slack", slack,
                            "--out", mf], capture_output=True, text=True)
        ok("extract writes the moments and says how many replay; a day dir works as --snapshots",
           p.returncode == 0 and "nudge 3 replayable / 5" in p.stdout and len(jsonl(mf)) == len(ms))
        p = subprocess.run([sys.executable, me, "score", "--new", cand, "--old", old, "--moments", mf],
                           capture_output=True, text=True)
        ok("score over a written moments file prints the same table", p.returncode == 0 and p.stdout.strip() == rep)
        p = subprocess.run([sys.executable, me, "score", "--labels", labels], capture_output=True, text=True)
        ok("score with no --new is refused with the usage", p.returncode == 2 and "usage" in p.stderr)
        p = subprocess.run([sys.executable, me, "extract", "--labels", os.path.join(root, "none.jsonl"), "--out", mf],
                           capture_output=True, text=True)
        ok("an empty or missing labels file is refused, not scored as zero", p.returncode == 2 and "no labelled" in p.stderr)

        # STALLS, on their own fixture: a stall log and two snapshot days whose board rows say how each stall ended
        sroot = os.path.join(root, "stall")
        sd1, sd2 = os.path.join(sroot, "snaps", "2026-01-05"), os.path.join(sroot, "snaps", "2026-01-06")
        os.makedirs(sd1)
        os.makedirs(sd2)
        slog = os.path.join(sroot, "stall.log")
        w(slog, ["2026-01-05T10:04:00Z\tw1\tdialog\traised r/raised-stall-w1-dialog-01051004\ta dialog has stood 4 min",
                 "2026-01-05T12:03:00Z\tw2\tdialog\traised r/raised-stall-w2-dialog-01051203\ta dialog has stood 3 min",
                 "2026-01-05T13:04:00Z\tw3\tdialog\traised r/raised-stall-w3-dialog-01051304\ta dialog has stood 4 min",
                 "2026-01-05T14:00:00Z\tw4\tdialog\tboard refused r/raised-stall-w4-dialog-01051400 (try 1)",
                 "2026-01-05T14:02:00Z\tw4\tdialog\traised r/raised-stall-w4-dialog-01051402\ta dialog has stood 6 min",
                 "2026-01-05T15:00:00Z\tw5\tdialog\tboard refused r/raised-stall-w5-dialog-01051500 (try 1)",
                 "2026-01-05T15:02:00Z\tw5\tdialog\tboard refused r/raised-stall-w5-dialog-01051500 (try 2)",
                 "2026-01-05T16:00:00Z\tw6\tdev-channels\tpressed '1'",
                 "not a line"])
        w(os.path.join(sd1, "board.jsonl"), [
            {"repo": "r", "track": "raised-stall-w1-dialog-01051004", "statuses": [],
             "notes": ["01-05T10:04 added: w1 is stuck: a dialog has stood 4 min"]},
            {"repo": "r", "track": "raised-stall-w2-dialog-01051203", "statuses": ["01-05T12:30 running", "01-05T12:40 done"],
             "notes": ["01-05T12:35 Dropped: a duplicate"]},
            {"repo": "r", "track": "raised-stall-w4-dialog-01051402", "statuses": ["01-05T14:56 merged"], "notes": []}])
        w(os.path.join(sd2, "board.jsonl"), [
            {"repo": "r", "track": "raised-stall-w1-dialog-01051004", "statuses": [],
             "notes": ["01-06T10:00 Closed in triage: stale"]}])
        sm = extract(None, os.path.join(sroot, "snaps"), slack, slog)
        sb = {m["id"]: m for m in sm}
        s1, s2 = sb.get("s:r/raised-stall-w1-dialog-01051004", {}), sb.get("s:r/raised-stall-w2-dialog-01051203", {})
        s4 = sb.get("s:r/raised-stall-w4-dialog-01051402", {})
        ok("a stall begins 'stood N min' before its log line and ends at a close note on a later snapshot day",
           s1.get("at") == "2026-01-05T10:00:00Z" and s1.get("stood_s") == 86400 and s1.get("gap_s") == 86400
           and s1.get("ended_by") == "closed note" and s1.get("replayable") is True)
        ok("a stall ends at the earliest sign on its row: a Dropped note before done, never a running status",
           s2.get("stood_s") == 2100 and s2.get("ended_by") == "dropped note")
        ok("a refused row raised again on a later pass is one stall, the raised one",
           s4.get("stood_s") == 3600 and s4.get("ended_by") == "merged"
           and "s:r/raised-stall-w4-dialog-01051400" not in sb)
        un = {m["id"]: m.get("why") for m in sm if not m["replayable"]}
        ok("a stall with no recorded end, a row the board never took and a sweep's press are kept, unreplayable",
           un == {"s:r/raised-stall-w3-dialog-01051304": "no board snapshot records how its row ended",
                  "s:r/raised-stall-w5-dialog-01051500": "the board refused its row and it was never raised",
                  "s:w6:dev-channels:2026-01-05T16:00:00Z": "the sweep pressed it; the log does not say how long it stood"})
        ok("a stall log with no labels makes only stall moments", len(sm) == 6 and {m["source"] for m in sm} == {"stall"})

        snew, sold = os.path.join(sroot, "new.py"), os.path.join(sroot, "old.py")
        with open(snew, "w") as fh:     # clears a dialog 30 min in, 50 min in for w2 (whose stall stood 35): late there
            fh.write("def judge(m):\n"
                     "    if m['source'] != 'stall' or m['class'] != 'dialog':\n        return 'pass'\n"
                     "    return ('flagged', 3000 if m['window'] == 'w2' else 1800)\n")
        with open(sold, "w") as fh:     # fires on w4 only, with no after_s: it saves the whole stand
            fh.write("def judge(m):\n    return 'flagged' if m.get('window') == 'w4' else 'pass'\n")
        srep = score(sm, load_version(sold), load_version(snew))
        d = row("STALLS", "dialog", srep)
        # dialog: 5 stalls, 3 replay (86400 + 2100 + 3600 s = 1535 min); old cuts w4's 60; new cuts 1410 + 30, w2 late
        ok("stalls are scored per kind with the minutes they stood and the minutes each version cuts",
           d[1:12] == ["5", "3", "2", "1", "2", "1", "0", "1", "1535", "60", "1440"])
        dc = row("STALLS", "dev-channels", srep)
        ok("a kind with only unreplayable stalls stays in the table at zero minutes",
           dc[1:4] == ["1", "0", "1"] and dc[9:12] == ["0", "0", "0"])
        ok("the stall unreplayable reasons are listed", "stall: no board snapshot records how its row ended 1" in srep)
        ok("stall scoring prints the same bytes twice", score(sm, load_version(sold), load_version(snew)) == srep)

        # HELD OUT: one in four by the salted hash, and everything raised from the stamp on
        salt = "0123456789abcdef0123456789abcdef"
        many = [{"id": f"s:r/raised-stall-x-{i}", "source": "stall", "raised_at": "2026-01-05T10:00:00Z"} for i in range(200)]
        mix = many + [{"id": "n:CA:1", "source": "nudge"}, {"id": "f:x:0", "source": "failure"}]
        kept, nh = split_held(mix, False, (salt, "lifted"))
        only, nh2 = split_held(mix, True, (salt, "lifted"))
        ok("about one stall moment in four is held out, and default and --held-out split them exactly",
           30 <= nh <= 70 and nh == nh2 == len(only) and len(kept) + len(only) == len(mix)
           and not {m["id"] for m in kept} & {m["id"] for m in only})
        ok("the default keeps the nudges and failures; --held-out scores the held-out stalls and nothing else",
           {"n:CA:1", "f:x:0"} <= {m["id"] for m in kept} and {m["source"] for m in only} == {"stall"})
        ok("the split is stable for one salt and moves with another",
           split_held(mix, True, (salt, "lifted"))[0] == only
           and split_held(mix, True, ("f" * 32, "lifted"))[0] != only)
        free = next(m for m in many if not is_held_out(m, salt, "lifted"))
        edge = dict(free, raised_at="2026-01-05T10:04:59Z")
        ok("a stall raised in the stamp's own minute or after is held out; one the minute before is not",
           is_held_out(edge, salt, "2026-01-05T10:04Z") and is_held_out(edge, salt, "2026-01-05T09:00Z")
           and not is_held_out(edge, salt, "2026-01-05T10:05Z") and not is_held_out(edge, salt, "lifted"))
        ok("nudges, failures and controls are never held out",
           not any(is_held_out(m, salt, "2000-01-01T00:00Z") for m in mix if m["source"] != "stall"))

        hd = os.path.join(sroot, "heldout")
        os.makedirs(hd)
        w(os.path.join(hd, "replay-heldout.salt"), [salt])
        w(os.path.join(hd, "replay-heldout.from"), ["2026-01-05T15:30Z"])
        env = dict(os.environ, CC_REPLAY_HELDOUT_DIR=hd)
        want = sum(is_held_out(m, salt, "2026-01-05T15:30Z") for m in sm)
        base = [sys.executable, me, "score", "--new", snew, "--stalls", slog, "--snapshots", os.path.join(sroot, "snaps")]
        p = subprocess.run(base, capture_output=True, text=True)
        ok("stall moments with no held-out files are refused, not scored in full",
           p.returncode == 2 and "held-out files" in p.stderr)
        os.makedirs(os.path.join(sroot, "bad"))
        w(os.path.join(sroot, "bad", "replay-heldout.salt"), ["short"])
        w(os.path.join(sroot, "bad", "replay-heldout.from"), ["lifted"])
        p = subprocess.run(base, capture_output=True, text=True, env=dict(os.environ, CC_REPLAY_HELDOUT_DIR=os.path.join(sroot, "bad")))
        ok("a salt that is not 32 hex characters is refused", p.returncode == 2 and "32 hex" in p.stderr)
        p = subprocess.run(base, capture_output=True, text=True, env=env)
        ok("score leaves the held-out stalls out and says how many (the 16:00 press is past the stamp)",
           p.returncode == 0 and f"held out: {want} stall moments left out" in p.stdout and want >= 1
           and is_held_out(sb["s:w6:dev-channels:2026-01-05T16:00:00Z"], salt, "2026-01-05T15:30Z"))
        p = subprocess.run(base + ["--held-out", "--labels", labels, "--slack", slack], capture_output=True, text=True, env=env)
        ok("score --held-out scores only the held-out stalls: no nudges, no control",
           p.returncode == 0 and f"scored only the {want} held-out" in p.stdout and "NUDGES" not in p.stdout
           and "control: 0 " in p.stdout)
        allm = os.path.join(sroot, "all.jsonl")
        w(allm, [json.dumps(dict(m, held_out=False), sort_keys=True) for m in sm])
        p = subprocess.run([sys.executable, me, "score", "--new", snew, "--moments", allm], capture_output=True, text=True,
                           env=env)
        ok("a moments file cannot unhold a moment: the split is made again from the ids",
           p.returncode == 0 and f"held out: {want} stall moments left out" in p.stdout)
        p = subprocess.run([sys.executable, me, "extract", "--stalls", slog, "--snapshots", os.path.join(sroot, "snaps"),
                            "--out", os.path.join(sroot, "x.jsonl")], capture_output=True, text=True, env=env)
        ok("extract writes no held-out stall and says how many it left out",
           p.returncode == 0 and f"{want} held-out stall moments left out" in p.stdout
           and len(jsonl(os.path.join(sroot, "x.jsonl"))) == len(sm) - want)

        # the example candidates shipped beside the tests, when this file sits in its tree
        ex = os.path.join(os.path.dirname(os.path.dirname(me)), "tests", "replay-moments")
        sp, lw = os.path.join(ex, "status-push-45m.py"), os.path.join(ex, "landing-wait-4h.py")
        if os.path.isfile(sp) and os.path.isfile(lw):
            _, spj = load_version(sp)
            _, lwj = load_version(lw)

            def mk(text, gap):
                return {"id": "x", "source": "nudge", "prev_box": {"text": text}, "gap_s": gap}
            q = "It's queued to land, no thumbs needed."
            ok("status-push fires 45 min after an in-flight post, and is late before that",
               verdict(spj, mk(q, 3000), "sp") == "status" and verdict(spj, mk(q, 600), "sp") == "late")
            ok("status-push stays quiet after a post that says the work is done or asks a question",
               verdict(spj, mk("Done: it landed.", 9000), "sp") == "pass"
               and verdict(spj, mk("Decision needed: which one? It is queued.", 9000), "sp") == "pass")
            ok("landing-wait fires only on a queued-to-land post, four hours on",
               verdict(lwj, mk(q, 15000), "lw") == "flagged" and verdict(lwj, mk(q, 3000), "lw") == "late"
               and verdict(lwj, mk("I've started building it.", 15000), "lw") == "pass")
    finally:
        shutil.rmtree(root, ignore_errors=True)
    print(f"cc-replay-moments selfcheck: {passed[0]} passed, {len(fails)} failed")
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
