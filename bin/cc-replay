#!/usr/bin/env python3
"""cc-replay — score a CANDIDATE cc-land against a recorded set of past landings, offline, in one number.

  cc-replay extract [--repo R]... [--since STAMP] [--until STAMP] --out FILE
      Build the trace: which PRs were queued when, what their gates and reviews answered, how long they took,
      what a repair round pushed and when. Read from the landing queue's own ledger (queue.log), the sweeps'
      journal (journalctl --user), the gate logs under $TMPDIR, the reviewer transcripts, and `gh pr view`.
      Reads only. Prints what it could not recover and how the gap was filled.
  cc-replay score --candidate PATH --trace FILE [--prepare N] [--conflicts history|files|none] [--verbose] [--keep]
      Import PATH as a module, stand the world in for it from the trace, and drive its own `queue` and `work`
      commands through the trace's arrivals on a VIRTUAL clock: a gate or a review parks its thread until the
      clock reaches its recorded duration, and the clock advances to the earliest wake only when every live
      thread is parked. No real gate, gh, git, systemd or Slack call is made; the candidate's own state lives
      under a temp root this tool creates and removes. Prints one score line and a per-PR table; the same
      input prints the same bytes every time. --verbose writes the world's log and the candidate's own output to
      stderr; --keep leaves the temp root in place to read afterwards.
  cc-replay selfcheck
      The virtual clock, the conflict model, the trace loader and determinism, on fixtures of its own.

THE SCORE is the median minutes from a PR's first `queued` to its merge in the replay, over the PRs that merged;
suites run, paid reviews bought, repair rounds dispatched and PRs left unmerged are the secondary columns. A
`history` line gives history's median over the PRs both merged, for calibration. The per-PR table's last column
says how history merged each PR: `queue` (the landing queue did) or `hand` (a person did, outside it — the replay
lands one of those only where a LAND was recorded).

WHAT THE WORLD ANSWERS, and from where:
  · a gate returns its recorded rc after its recorded duration for that PR (else the trace median for that gate);
    a gate history saw go red at that head goes red here;
  · a review returns the verdict history recorded for that head (else for that change, else the PR's eventual
    verdict) after that PR's recorded review duration (else the median); a verdict a PERSON recorded (`cc-land
    record`) appears on the PR at its recorded time, written in the candidate's own marker format, and a recorded
    LAND queues the PR again when the replay had already given up on it (in history the job was still waiting,
    or the person queued it again — nobody types that in a replay); a PR history merged with no verdict on its
    last head is read as LAND there;
  · a repair round pushes the next recorded head after that PR's recorded fix latency (else the median);
  · mergeability is a MODEL: a PR conflicts when a PR merged since its base, in the REPLAY's order, touches one
    of its files (--conflicts files). Files overlap far more often than hunks do, so the default, `history`,
    applies that rule only to PRs history saw conflict; `none` never conflicts;
  · green records history spent are seeded for every head of the PR they were spent on, from its first arrival;
  · git is answered from the trace — file lists, per-file churn, a synthetic merge-base and diff per change —
    never from a checkout, so a decision that needs file CONTENTS (comment-only detection) reads every file as code.

WHAT IT CANNOT SCORE: a suite made faster or slower, a reviewer made better or worse, or anything that depends on
what a file contains rather than which files changed. It scores the LANDING — order, parallelism, what is bought,
what is re-run, what is refused — on the same PRs, for two cc-lands.

Stdlib only. The code holds no repo names, PR numbers or paths of any one box; the trace is data and lives
outside the repo (~/.cc/state/<repo>/replay/ is the suggested home).
"""
import calendar, glob, hashlib, heapq, importlib.machinery, importlib.util, inspect, io, json, os, re, shutil, statistics
import subprocess, sys, tempfile, threading, time

HOME = os.path.expanduser("~")
LANDQ = f"{HOME}/.cc/state/land"
BOARDS = f"{HOME}/.cc/boards"
GATES = ("core/tests/check.sh", "tests/check.sh", "tests/check-extra.sh", "core/tests/selftest.sh", "tests/selftest.sh")
SUITE = ("core/tests/selftest.sh", "tests/selftest.sh")
CONTROL_LIST = ("core/tests/control-layer", "tests/control-layer")
VERDICTS = ("LAND", "LAND-AFTER-FIX", "DO-NOT-LAND")
REVIEW_MODEL_RE = re.compile(r"^claude-")        # a verdict signed by a model was BOUGHT by a landing; any other name recorded it
DEFAULTS = {"gate": {"check.sh": 120, "check-extra.sh": 180, "selftest.sh": 900}, "review": 480, "fix": 1500}
GATE_MIN, GATE_MAX = 20, 4 * 3600               # a log span outside this is not one run of one gate
GATE_SPAN_CAP = 3                               # nor is one past this many times the gate's median


def stamp(e):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(e))


def epoch(s):
    try:
        return calendar.timegm(time.strptime(s or "", "%Y-%m-%dT%H:%M:%SZ"))
    except ValueError:
        return 0


def iso_epoch(s):
    """An ISO stamp with any offset (journalctl -o short-iso, gh) as an epoch; 0 when unreadable."""
    from datetime import datetime
    try:
        return int(datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp())
    except (ValueError, AttributeError):
        return 0


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def sh(argv, cwd=None, timeout=120):
    try:
        r = subprocess.run(argv, cwd=cwd, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        return r.returncode, r.stdout + r.stderr
    except Exception as e:
        return 127, f"{e.__class__.__name__}: {e}"


def median(xs, default):
    xs = [x for x in xs if x]
    return statistics.median(xs) if xs else default


def hexname(*parts):
    return hashlib.sha256("\0".join(str(p) for p in parts).encode()).hexdigest()[:40]


# ── extract ──────────────────────────────────────────────────────────────────────────────────────────────
LEDGER_RE = re.compile(r"^(?P<at>\S+)\t(?P<kind>[a-z-]+) (?P<repo>[A-Za-z0-9_.-]+)#(?P<pr>[0-9]+|deploy)(?P<rest>.*)$")
MARK_OLD = re.compile(r"\A\s*<!-- cc-land-review ([0-9a-f]{7,40}) (LAND-AFTER-FIX|DO-NOT-LAND|LAND) -->")
MARK_V2 = re.compile(r"\A\s*<!-- cc-land-review v2 change=([0-9a-f]+)(?: base=([0-9a-f]+))? head=([0-9a-f]+) "
                     r"verdict=(LAND-AFTER-FIX|DO-NOT-LAND|LAND)(?: by=([A-Za-z0-9._@-]+))?[^>]*-->")
JOURNAL_RE = re.compile(r"^(?P<at>\S+) \S+ cc-land\[(?P<pid>\d+)\]: (?P<text>.*)$")


def repo_root_of(repo):
    p = (read_json(f"{BOARDS}/{repo}.json") or {}).get("path") or ""
    return p if p and os.path.isdir(f"{p}/.git") else f"{HOME}/dev/{repo}"


def ledger_events(path, since, until):
    out = []
    try:
        lines = open(path, errors="replace").read().splitlines()
    except OSError:
        return out
    for ln in lines:
        m = LEDGER_RE.match(ln)
        if not m or m.group("pr") == "deploy":
            continue
        at = epoch(m.group("at"))
        if not at or at < since or at > until:
            continue
        out.append({"at": at, "kind": m.group("kind"), "repo": m.group("repo"), "pr": int(m.group("pr")),
                    "rest": m.group("rest").strip()})
    return out


def gh_pr(repo, pr, cache=""):
    """What GitHub says about the PR; a merged or closed PR's answer is kept beside the trace, so a second
    extraction does not ask again."""
    cached = f"{cache}/{repo}-{pr}.json" if cache else ""
    if cached and os.path.exists(cached):
        return read_json(cached)
    rc, o = sh(["gh", "pr", "view", str(pr), "--json", "number,title,state,createdAt,mergedAt,closedAt,headRefOid,"
                "headRefName,baseRefName,additions,deletions,files,comments,mergeCommit"], cwd=repo_root_of(repo))
    if rc:
        return None
    try:
        j = json.loads(o)
    except ValueError:
        return None
    if cached and j.get("state") in ("MERGED", "CLOSED"):
        os.makedirs(cache, exist_ok=True)
        with open(cached, "w") as f:
            json.dump(j, f)
    return j


HUNK = re.compile(r"^@@ -[0-9,]+ \+[0-9,]+ @@")


def change_digest(diff):
    """cc-land's own change key, kept in step with it: the diff text with the `index` lines and the hunk line
    numbers dropped, hashed. Two heads with the same digest are one change (a rebase between them)."""
    keep = []
    for ln in (diff or "").splitlines():
        if ln.startswith("index "):
            continue
        keep.append(HUNK.sub("@@", ln) if ln.startswith("@@ ") else ln)
    body = "\n".join(keep).strip()
    return hashlib.sha256(body.encode("utf-8", "replace")).hexdigest()[:40] if body else ""


def change_key_of(root, base, sha):
    """The change a head IS, read from the checkout's own objects — read-only, and "" when the head is not there.
    merge-base against the base branch as it stands: the fork point of an old head does not move."""
    rc, o = sh(["git", "rev-parse", "--verify", "-q", f"{sha}^{{commit}}"], cwd=root)
    if rc:
        return ""
    full = o.strip()
    rc, o = sh(["git", "merge-base", f"origin/{base}", full], cwd=root)
    if rc or not o.strip():
        return ""
    r = subprocess.run(["git", "diff", "-U3", o.strip().split()[0], full], cwd=root, capture_output=True, text=True)
    return change_digest(r.stdout) if r.returncode == 0 else ""


def journal_lines(since):
    rc, o = sh(["journalctl", "--user", "--no-pager", "-o", "short-iso", "--since", f"@{since}"], timeout=300)
    if rc:
        return []
    out = []
    for ln in o.splitlines():
        m = JOURNAL_RE.match(ln)
        if m:
            out.append((iso_epoch(m.group("at")), int(m.group("pid")), m.group("text")))
    return out


GATE_LINE = re.compile(r"(\d+) gate\(s\) passed on PR #(\d+)(?: at the (\w+) tier)?[^:]*: (.*?)(?: — (\d+) of them already green on ([0-9a-f]+))?(?: —|;|$)")
GREEN_LINE = re.compile(r"^\s*· (\S+): already green on this content \(([0-9a-f]+)\)")
TIER_LINE = re.compile(r"^\s*· the (\w+) tier: ")
NOMODEL_LINE = re.compile(r"no model read this diff — the (\w+) tier")
BOUGHT_LINE = re.compile(r"reviewed by (\S+) at the (\w+) tier .*?: (LAND-AFTER-FIX|DO-NOT-LAND|LAND) on PR #(\d+) \(\$([0-9.]+)")
STOP_BOUGHT = re.compile(r"✗ review: (LAND-AFTER-FIX|DO-NOT-LAND|LAND) on PR #(\d+) \(\$([0-9.]+)")
READ_LINE = re.compile(r"read already by (\S+): (LAND-AFTER-FIX|DO-NOT-LAND|LAND) on PR #(\d+)")
MERGED_LINE = re.compile(r"✓ PR #(\d+) merged \(")       # the queue's own merge; "already merged — nothing to do" is a hand merge it noticed
LANDING_LINE = re.compile(r"^landing \[([A-Za-z0-9_.-]+)\] PR #(\d+)")


def journal_facts(lines):
    """Per (repo, pr): the tier each landing ran at, which gates a green record answered for, and whether the
    review was bought, read back or skipped — from the lines the sweeps printed. A job's lines name the PR in
    the gate and review lines; the `already green` lines just before a gate line belong to that gate line."""
    facts = {}
    pending, repo_of = {}, {}

    def f(repo, pr):
        return facts.setdefault((repo, pr), {"tiers": [], "green": [], "bought": [], "read": [], "nomodel": [], "queue_merged": False})

    for at, pid, text in lines:
        m = LANDING_LINE.match(text)
        if m:
            repo_of[pid] = m.group(1)
        m = GREEN_LINE.match(text)
        if m:
            pending.setdefault(pid, []).append(m.group(1))
            continue
        m = GATE_LINE.search(text)
        if m:
            pr = int(m.group(2))
            repo = repo_of.get(pid) or repo_of_pr(pr, facts)
            if repo:
                rec = f(repo, pr)
                if m.group(3):
                    rec["tiers"].append((at, m.group(3)))
                for g in pending.pop(pid, []):
                    rec["green"].append((at, g))
            else:
                pending.pop(pid, None)
            continue
        m = BOUGHT_LINE.search(text) or STOP_BOUGHT.search(text)
        if m:
            g = m.groups()
            verdict, pr, cost = (g[2], int(g[3]), float(g[4])) if len(g) == 5 else (g[0], int(g[1]), float(g[2]))
            repo = repo_of.get(pid) or repo_of_pr(pr, facts)
            if repo:
                f(repo, pr)["bought"].append((at, verdict, cost))
            continue
        m = READ_LINE.search(text)
        if m:
            repo = repo_of.get(pid) or repo_of_pr(int(m.group(3)), facts)
            if repo:
                f(repo, int(m.group(3)))["read"].append((at, m.group(2), m.group(1)))
            continue
        m = MERGED_LINE.search(text)
        if m:
            repo = repo_of.get(pid) or repo_of_pr(int(m.group(1)), facts)
            if repo:
                f(repo, int(m.group(1)))["queue_merged"] = True
            continue
        m = NOMODEL_LINE.search(text)
        if m and repo_of.get(pid):
            pass    # the tier line above already carries the tier; nothing to add
    return facts


def repo_of_pr(pr, facts):
    hits = {r for (r, p) in facts if p == pr}
    return hits.pop() if len(hits) == 1 else ""


def gate_log_spans(tmpdir):
    """{(repo, pr, gate-basename): seconds} from each gate log's birth to its last write. The file is truncated and
    rewritten on every run of that gate for that PR, and truncation keeps the inode, so the span covers EVERY run:
    only a PR gated once can be read off it, and the caller decides that."""
    out = {}
    for p in glob.glob(f"{tmpdir}/cc-land-gate-*.log"):
        m = re.match(r"cc-land-gate-(.+)-(\d+|base)-([^-]+\.sh)\.log$", os.path.basename(p))
        if not m or m.group(2) == "base":
            continue
        rc, o = sh(["stat", "-c", "%W %Y", p])
        try:
            birth, mtime = (int(x) for x in o.split())
        except ValueError:
            continue
        if birth > 0 and mtime > birth:
            out[(m.group(1), int(m.group(2)), m.group(3))] = mtime - birth
    return out


def review_spans():
    """{(repo, pr): [seconds...]} — how long each paid review of that PR ran, from the reviewer's own transcript:
    it runs in a directory named cc-land.review.<repo>.<pr>.<random>, and the transcript's first and last stamps
    bracket the read."""
    out = {}
    for d in glob.glob(f"{HOME}/.claude/projects/-tmp-cc-land-review-*"):
        m = re.match(r"-tmp-cc-land-review-(.+)-(\d+)-[A-Za-z0-9]+$", os.path.basename(d))
        if not m:
            continue
        stamps = []
        for j in glob.glob(f"{d}/*.jsonl"):
            try:
                for ln in open(j, errors="replace"):
                    mm = re.search(r'"timestamp":"([^"]+)"', ln)
                    if mm:
                        stamps.append(iso_epoch(mm.group(1)))
            except OSError:
                pass
        stamps = [s for s in stamps if s]
        if len(stamps) >= 2 and 10 <= max(stamps) - min(stamps) <= 3 * 3600:
            out.setdefault((m.group(1), int(m.group(2))), []).append(max(stamps) - min(stamps))
    return out


def parse_marker(body):
    """(head12, verdict, change-key, by, kind) from a review comment, or None."""
    m = MARK_V2.match(body or "")
    if m:
        key, head, verdict, by = m.group(1), m.group(3), m.group(4), m.group(5) or ""
    else:
        m = MARK_OLD.match(body or "")
        if not m:
            return None
        head, verdict, key, by = m.group(1), m.group(2), "", ""
    if not by:
        mm = re.search(r"(?:read by|model) `([^`]+)`", body)
        by = mm.group(1) if mm else ""
    kind = "bought" if (not by or REVIEW_MODEL_RE.match(by)) else "recorded"
    return head[:12], verdict, key, by, kind


def build_landing(repo, pr, events, gh, jf, spans, rspans, until):
    """One PR's record, from every source that mentions it."""
    ev = sorted(events, key=lambda e: (e["at"], e["kind"]))
    arrivals = [{"at": stamp(e["at"]), "again": e["kind"] == "again"} for e in ev if e["kind"] in ("queued", "again")]
    dones = []
    for e in ev:
        if e["kind"] == "done":
            m = re.match(r"rc=(\d+) (.*)", e["rest"])
            if m:
                dones.append({"at": stamp(e["at"]), "rc": int(m.group(1)), "short": m.group(2)[:240]})
    fixes, open_fix = [], None
    for e in ev:
        if e["kind"] == "fix-dispatch":
            m = re.search(r"track=(\S+).*head=([0-9a-f]+)", e["rest"])
            open_fix = {"dispatched": stamp(e["at"]), "track": m.group(1) if m else "", "old": m.group(2)[:12] if m else ""}
            fixes.append(open_fix)
        elif e["kind"] == "fix-pushed" and open_fix and "pushed" not in open_fix:
            m = re.search(r"([0-9a-f]{7,40})->([0-9a-f]{7,40})", e["rest"])
            open_fix.update(pushed=stamp(e["at"]), old=m.group(1)[:12] if m else open_fix["old"], new=m.group(2)[:12] if m else "")
    # Every head anyone saw, with when: the comment markers, the ledger's recorded/fix lines, and the head the
    # PR ends on. Ordered by first sighting; a head pushed by a repair round is a NEW change, a head with the same
    # change key as the one before it is a rebase, and a head with no key and no repair between is read as a
    # rebase too — the caveat is in the docs.
    sightings = {}       # sha12 -> (at, via, key)

    def see(sha, at, via="push", key=""):
        sha = (sha or "")[:12]
        if not sha:
            return
        if sha not in sightings or at < sightings[sha][0]:
            sightings[sha] = (at, via, key or (sightings.get(sha) or ("", "", ""))[2])

    created = iso_epoch(gh.get("createdAt") or "") if gh else 0
    verdicts = []
    for c in (gh or {}).get("comments") or []:
        if not isinstance(c, dict) or not c.get("viewerDidAuthor"):
            continue
        pm = parse_marker(c.get("body") or "")
        if not pm:
            continue
        head, verdict, key, by, kind = pm
        at = iso_epoch(c.get("createdAt") or "")
        see(head, at - (median(rspans.get((repo, pr), []), DEFAULTS["review"]) if kind == "bought" else 0), key=key)
        cost = 0.0
        for bat, bverdict, bcost in jf.get("bought", []):
            if bverdict == verdict and abs(bat - at) < 120:
                cost = bcost
        verdicts.append({"at": stamp(at), "head": head, "verdict": verdict, "by": by, "kind": kind, "cost": cost})
    for e in ev:
        if e["kind"] == "recorded":
            m = re.match(r"(LAND-AFTER-FIX|DO-NOT-LAND|LAND) by=(\S+) head=([0-9a-f]+) change=(\S+)", e["rest"])
            if m:
                see(m.group(3), e["at"], key="" if m.group(4) == "-" else m.group(4))
                if not any(v["head"] == m.group(3)[:12] and v["verdict"] == m.group(1) for v in verdicts):
                    verdicts.append({"at": stamp(e["at"]), "head": m.group(3)[:12], "verdict": m.group(1),
                                     "by": m.group(2), "kind": "recorded", "cost": 0.0})
        elif e["kind"] == "stale-pull-ref":
            for sha in re.findall(r"=([0-9a-f]{7,40})", e["rest"]):
                see(sha, e["at"])
    for fx in fixes:
        see(fx.get("old"), epoch(fx["dispatched"]) - 1)
        if fx.get("new"):
            see(fx["new"], epoch(fx["pushed"]), via="fix")
    for d in dones:       # a stop names the head it stopped on; that head was there when the attempt was queued
        before = [epoch(a["at"]) for a in arrivals if epoch(a["at"]) <= epoch(d["at"])]
        for sha in re.findall(r"\b[0-9a-f]{12}\b", d["short"]):
            see(sha, before[-1] if before else epoch(d["at"]))
    final = ((gh or {}).get("headRefOid") or "")[:12]
    if final:
        merged_at = iso_epoch((gh or {}).get("mergedAt") or "") or until
        see(final, merged_at - 30)
    if not sightings:
        see(hexname(repo, pr, "head0"), created or (epoch(arrivals[0]["at"]) if arrivals else 0))
    order = sorted(sightings.items(), key=lambda kv: kv[1][0])
    root, base = repo_root_of(repo), (gh or {}).get("baseRefName") or "main"
    heads, gen, last_key, keyed = [], 0, None, 0
    for i, (sha, (at, via, key)) in enumerate(order):
        key = key or change_key_of(root, base, sha)      # the checkout's objects settle it where the marker did not
        if key and (i == 0 or sightings[order[i - 1][0]][2] or True):
            keyed += 1
        if i:
            if via == "fix":
                gen += 1
            elif key and last_key:
                gen += 0 if key == last_key else 1
            # no key on either side: a rebase — see the caveats
        heads.append({"at": stamp(max(at, 0)), "sha": sha, "gen": gen, "via": via if i else "push", "key": key[:12]})
        last_key = key or last_key
    unkeyed = sum(1 for h in heads if not h["key"])
    heads[0]["at"] = stamp(min(epoch(heads[0]["at"]), created or epoch(heads[0]["at"]),
                              epoch(arrivals[0]["at"]) if arrivals else epoch(heads[0]["at"])))

    def gen_at(at):
        g = 0
        for h in heads:
            if epoch(h["at"]) <= at:
                g = h["gen"]
        return g

    for v in verdicts:
        v["gen"] = next((h["gen"] for h in heads if h["sha"] == v["head"]), gen_at(epoch(v["at"])))
    red, conflicted = {}, False
    for d in dones:
        m = re.search(r"gate (\S+) did not pass", d["short"])
        if m:       # keyed by the HEAD it went red on: the rebase that fixed PR #305's stale red is a new head
            head_then = next((h["sha"] for h in reversed(heads) if epoch(h["at"]) <= epoch(d["at"])), heads[0]["sha"])
            red.setdefault(os.path.basename(m.group(1)), []).append(head_then)
        if re.search(r"conflicts with|merge conflicts|not mergeable", d["short"]):
            conflicted = True
    files = [[("A" if f.get("additions") and not f.get("deletions") and f.get("changeType") == "ADDED" else "M"), f["path"]]
             for f in (gh or {}).get("files") or [] if isinstance(f, dict) and f.get("path")]
    perfile = {f["path"]: [f.get("additions") or 0, f.get("deletions") or 0]
               for f in (gh or {}).get("files") or [] if isinstance(f, dict) and f.get("path")}
    attempts = len(dones) + (1 if arrivals and (not dones or epoch(arrivals[-1]["at"]) > epoch(dones[-1]["at"])) else 0)
    gates = {}      # one arrival AND one head: a repair push or a rebase re-runs the gates into the same log
    for (r, p, g), secs in spans.items():
        if (r, p) == (repo, pr) and attempts <= 1 and len(heads) <= 1 and GATE_MIN <= secs <= GATE_MAX:
            gates[g] = secs
    green = sorted({os.path.basename(g) for _, g in jf.get("green", [])})
    tiers = sorted({t for _, t in jf.get("tiers", [])})
    return {"repo": repo, "pr": pr, "title": (gh or {}).get("title") or "", "branch": (gh or {}).get("headRefName") or "",
            "base": (gh or {}).get("baseRefName") or "main", "created": stamp(created) if created else "",
            "merged": stamp(iso_epoch(gh["mergedAt"])) if gh and gh.get("mergedAt") else "",
            "state": (gh or {}).get("state") or "", "files": files, "perfile": perfile,
            "adds": (gh or {}).get("additions") or 0, "dels": (gh or {}).get("deletions") or 0,
            "arrivals": arrivals, "heads": heads, "verdicts": sorted(verdicts, key=lambda v: v["at"]),
            "fixes": fixes, "dones": dones, "gates": gates, "red": red, "green": green, "tiers": tiers,
            "review_secs": sorted(rspans.get((repo, pr), [])), "attempts": attempts, "conflicted": conflicted,
            "unkeyed_heads": unkeyed, "queue_merged": bool(jf.get("queue_merged"))}


def cmd_extract(argv):
    repos, since, until, out = [], 0, int(time.time()), ""
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--repo" and rest:
            repos.append(rest.pop(0))
        elif a == "--since" and rest:
            since = epoch(rest.pop(0))
        elif a == "--until" and rest:
            until = epoch(rest.pop(0))
        elif a == "--out" and rest:
            out = rest.pop(0)
        else:
            print(f"cc-replay extract: unexpected '{a}'", file=sys.stderr)
            return 2
    if not out:
        print("cc-replay extract: --out FILE is required", file=sys.stderr)
        return 2
    since = since or until - 86400
    events = ledger_events(f"{LANDQ}/queue.log", since, until)
    prs = sorted({(e["repo"], e["pr"]) for e in events if e["kind"] == "queued" and (not repos or e["repo"] in repos)})
    if not prs:
        print("cc-replay extract: no `queued` line in that window", file=sys.stderr)
        return 1
    print(f"extracting {len(prs)} PR(s) queued between {stamp(since)} and {stamp(until)}", file=sys.stderr)
    jf = journal_facts(journal_lines(since))
    spans = gate_log_spans(tempfile.gettempdir())
    rspans = review_spans()
    landings, gaps, missing_gh = [], [], []
    cache = f"{os.path.abspath(out)}.gh"
    for repo, pr in prs:
        gh = gh_pr(repo, pr, cache)
        if gh is None:
            missing_gh.append(f"{repo}#{pr}")
        mine = [e for e in events if (e["repo"], e["pr"]) == (repo, pr)]
        landings.append(build_landing(repo, pr, mine, gh, jf.get((repo, pr), {}), spans, rspans, until))
    repos_out = {}
    for repo in sorted({l["repo"] for l in landings}):
        root = repo_root_of(repo)
        gates = [g for g in GATES if os.access(f"{root}/{g}", os.X_OK)]
        control = None
        base = (read_json(f"{BOARDS}/{repo}.json") or {}).get("default_branch") or "main"
        for lst in CONTROL_LIST:
            rc, o = sh(["git", "show", f"origin/{base}:{lst}"], cwd=root)
            if rc == 0:
                control = (lst, o)
                break
        repos_out[repo] = {"default_branch": base, "gates": gates, "control": control}
    medians = {"gate": {}, "review": int(median([s for v in rspans.values() for s in v], DEFAULTS["review"])),
               "fix": int(median([epoch(f["pushed"]) - epoch(f["dispatched"]) for l in landings for f in l["fixes"]
                                  if f.get("pushed")], DEFAULTS["fix"]))}
    for g in sorted({g for l in landings for g in l["gates"]} | set(DEFAULTS["gate"])):
        medians["gate"][g] = int(median([l["gates"][g] for l in landings if g in l["gates"]], DEFAULTS["gate"].get(g, 300)))
    n_capped = 0    # a span past GATE_SPAN_CAP× the gate's median is a wait at a lock or two runs, not one run
    for l in landings:
        for g in [g for g, secs in l["gates"].items() if secs > GATE_SPAN_CAP * medians["gate"][g]]:
            del l["gates"][g]
            n_capped += 1
    for g in medians["gate"]:
        medians["gate"][g] = int(median([l["gates"][g] for l in landings if g in l["gates"]], medians["gate"][g]))
    # What could not be recovered, said plainly, and how the gap is filled.
    n_multi = sum(1 for l in landings if l["attempts"] > 1 or len(l["heads"]) > 1)
    n_nogate = sum(1 for l in landings if not l["gates"])
    n_norev = sum(1 for l in landings if not l["review_secs"])
    n_nohead = sum(1 for l in landings if len(l["heads"]) == 1 and l["heads"][0]["sha"] == hexname(l["repo"], l["pr"], "head0"))
    gaps.append(f"{n_multi} of {len(landings)} PRs were gated more than once (a second arrival, a repair push or a "
                f"rebase); their gate logs span every run, so their gate durations are the trace median per gate "
                f"({', '.join(f'{k} {v}s' for k, v in medians['gate'].items())}); {n_capped} more span(s) past "
                f"{GATE_SPAN_CAP}× that median (a wait at a lock is not a run) get the median too")
    gaps.append(f"{n_nogate} PRs have no usable gate log at all (never gated, or a green record answered) — median per gate")
    gaps.append(f"{n_norev} PRs have no reviewer transcript — review duration is the median {medians['review']}s")
    gaps.append(f"repair latency: {sum(1 for l in landings for f in l['fixes'] if f.get('pushed'))} rounds measured, "
                f"median {medians['fix']}s; a round with no measured push uses that")
    gaps.append(f"{n_nohead} PRs have no head anybody wrote down — one synthetic head, one change")
    n_unkeyed = sum(l.get("unkeyed_heads", 0) for l in landings)
    gaps.append(f"{n_unkeyed} of {sum(len(l['heads']) for l in landings)} heads have no change key (no marker, not in "
                f"the checkout): a move onto one is read as a rebase unless a repair round pushed it; the force-push "
                f"timeline (gh api) is not read here, so a head nobody wrote down is not in the trace at all")
    gaps.append(f"{sum(1 for l in landings if l.get('conflicted'))} PRs conflicted in history; the default conflict "
                f"model (--conflicts history) can only conflict those")
    gaps.append("review budgets spent BEFORE the window are not seeded: every change starts with none bought")
    n_hand = sum(1 for l in landings if l["merged"] and not l["queue_merged"])
    gaps.append(f"{n_hand} PRs history merged OUTSIDE the queue (a person merged, mostly after the review-budget wall; "
                f"hist-by=hand in the table): the replay lands one only where a LAND was recorded, and its history "
                f"minutes are a person's, not a queue's")
    if missing_gh:
        gaps.append(f"gh could not read {len(missing_gh)} PR(s) ({', '.join(missing_gh[:5])}): no files, no verdicts, "
                    f"treated as a one-file change with no history")
    trace = {"version": 1, "since": stamp(since), "until": stamp(until), "repos": repos_out, "medians": medians,
             "landings": landings, "gaps": gaps}
    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
    with open(out, "w") as f:
        json.dump(trace, f, indent=1, sort_keys=True)
    print(f"wrote {out}: {len(landings)} landings, {sum(len(l['arrivals']) for l in landings)} arrivals")
    print("could not recover, and how it was filled:")
    for g in gaps:
        print(f"  · {g}")
    return 0


def load_trace(path):
    t = read_json(path)
    if not isinstance(t, dict) or t.get("version") != 1 or not isinstance(t.get("landings"), list):
        raise SystemExit(f"cc-replay: {path} is not a v1 trace")
    for l in t["landings"]:
        for k in ("repo", "pr", "arrivals", "heads", "files"):
            if k not in l:
                raise SystemExit(f"cc-replay: {path}: landing without '{k}'")
        l.setdefault("verdicts", []); l.setdefault("fixes", []); l.setdefault("gates", {}); l.setdefault("red", {})
        l.setdefault("green", []); l.setdefault("review_secs", []); l.setdefault("perfile", {}); l.setdefault("base", "main")
        l.setdefault("branch", ""); l.setdefault("merged", ""); l.setdefault("title", ""); l.setdefault("conflicted", False)
    t.setdefault("medians", dict(DEFAULTS)); t["medians"].setdefault("gate", dict(DEFAULTS["gate"]))
    t["medians"].setdefault("review", DEFAULTS["review"]); t["medians"].setdefault("fix", DEFAULTS["fix"])
    t.setdefault("repos", {})
    return t


# ── the virtual clock, and the threading the candidate is handed ─────────────────────────────────────────
class Deadlock(Exception):
    pass


class Clock:
    """Discrete-event time. Every thread the candidate runs is counted RUNNING until it parks — in a stub that
    waits out a duration, in a join, in an Event or Condition wait. The clock moves only when nothing is
    running: the last thread to park advances it, to the earliest of the next trace arrival (which it injects)
    and the earliest parked wake, and marks the woken threads running before it blocks itself. The count
    therefore never sits at zero with work to do, and the same trace walks the same virtual times every run."""

    def __init__(self, now):
        self.now = now
        self.lock = threading.Lock()
        self.running = 1           # the driver
        self.sleepers = []         # (wake, seq, event)
        self.seq = 0
        self.arrivals = []         # [(at, payload)] sorted, consumed by whoever advances past them
        self.inject = None         # payload -> None; runs with the clock held still
        self.advances = 0
        self.parked = []           # every real Event a parked thread is blocked on, so a deadlock can wake them all
        self.dead = None

    def sleep(self, secs):
        """Park the calling thread until now + secs."""
        ev = threading.Event()
        with self.lock:
            self.seq += 1
            heapq.heappush(self.sleepers, (self.now + max(0, int(secs)), self.seq, ev))
        self.park(ev)

    def park(self, ev):
        with self.lock:
            self.parked.append(ev)
            self.running -= 1
            self._advance_if_idle()
        ev.wait()
        with self.lock:
            if ev in self.parked:
                self.parked.remove(ev)
        if self.dead:
            raise Deadlock(self.dead)

    def _advance_if_idle(self):
        while self.running == 0 and not self.dead:
            nxt_arr = self.arrivals[0][0] if self.arrivals else None
            nxt_slp = self.sleepers[0][0] if self.sleepers else None
            if nxt_arr is None and nxt_slp is None:
                self.dead = "every thread is parked and nothing is due: the candidate is waiting on something it never signals"
                for e in self.parked:
                    e.set()
                return
            if nxt_arr is not None and (nxt_slp is None or nxt_arr <= nxt_slp):
                self.now = max(self.now, nxt_arr)
                _, payload = self.arrivals.pop(0)
                self.running += 1
                self.lock.release()
                try:
                    self.inject(payload)
                finally:
                    self.lock.acquire()
                    self.running -= 1
                continue
            self.now = max(self.now, nxt_slp)
            self.advances += 1
            while self.sleepers and self.sleepers[0][0] <= self.now:
                _, _, e = heapq.heappop(self.sleepers)
                self.running += 1
                e.set()


class FakeThreading:
    """The `threading` the candidate sees: Thread/Event/Condition report to the Clock; everything else is real."""

    def __init__(self, clock):
        self.clock = clock
        real = threading
        self.Lock, self.RLock, self.local = real.Lock, real.RLock, real.local
        self.current_thread, self.main_thread = real.current_thread, real.main_thread
        self.get_ident = real.get_ident
        clk = clock

        class Thread:
            def __init__(self, group=None, target=None, name=None, args=(), kwargs=None, daemon=None):
                self._target, self._args, self._kwargs, self.name = target, args, kwargs or {}, name
                self._joiners, self._finished, self._t = [], False, None

            def start(self):
                with clk.lock:
                    clk.running += 1
                self._t = real.Thread(target=self._run, name=self.name, daemon=True)
                self._t.start()

            def _run(self):
                try:
                    if self._target:
                        self._target(*self._args, **self._kwargs)
                except Deadlock:
                    pass
                finally:
                    with clk.lock:
                        self._finished = True
                        for e in self._joiners:
                            clk.running += 1
                            e.set()
                        self._joiners = []
                        clk.running -= 1
                        clk._advance_if_idle()

            def join(self, timeout=None):
                with clk.lock:
                    if self._finished:
                        return
                    e = real.Event()
                    self._joiners.append(e)
                clk.park(e)

            def is_alive(self):
                return self._t is not None and not self._finished

        class Event:
            def __init__(self):
                self._set, self._waiters = False, []

            def is_set(self):
                return self._set

            def set(self):
                with clk.lock:
                    self._set = True
                    ws, self._waiters = self._waiters, []
                    for e in ws:
                        clk.running += 1
                        e.set()

            def clear(self):
                self._set = False

            def wait(self, timeout=None):
                with clk.lock:
                    if self._set:
                        return True
                    e = real.Event()
                    self._waiters.append(e)
                clk.park(e)
                return True

        class Condition:
            def __init__(self, lock=None):
                self._lock, self._waiters = lock or real.RLock(), []

            def __enter__(self):
                self._lock.acquire()
                return self

            def __exit__(self, *a):
                self._lock.release()
                return False

            acquire = lambda self, *a, **k: self._lock.acquire(*a, **k)
            release = lambda self: self._lock.release()

            def wait(self, timeout=None):
                with clk.lock:
                    e = real.Event()
                    self._waiters.append(e)
                self._lock.release()
                try:
                    clk.park(e)
                finally:
                    self._lock.acquire()
                return True

            def notify_all(self):
                with clk.lock:
                    ws, self._waiters = self._waiters, []
                    for e in ws:
                        clk.running += 1
                        e.set()

            notify = notify_all

        self.Thread, self.Event, self.Condition = Thread, Event, Condition


class FakeTime:
    def __init__(self, clock):
        self._c = clock

    def time(self):
        return float(self._c.now)

    def gmtime(self, secs=None):
        return time.gmtime(self._c.now if secs is None else secs)

    def sleep(self, secs):
        self._c.sleep(secs)

    def __getattr__(self, name):
        return getattr(time, name)


class FakeOsPath:
    def __init__(self, mtimes, clock):
        self._m, self._c = mtimes, clock

    def getmtime(self, path):
        return float(self._m.get(path, self._c.now))

    def __getattr__(self, name):
        return getattr(os.path, name)


class FakeOs:
    """`os` with two answers of the harness's: getmtime from the table write_atomic fills (durable time is a
    stamp, never the disk's clock) and access(X_OK) answering which gates a checkout has without one existing."""

    def __init__(self, world, mtimes, clock):
        self._w = world
        self.path = FakeOsPath(mtimes, clock)

    def access(self, path, mode, **kw):
        rel = self._w.gate_rel(path)
        if rel is not None:
            return rel in self._w.gates_of(self._w.repo_of_path(path))
        return os.access(path, mode, **kw)

    def __getattr__(self, name):
        return getattr(os, name)


# ── the world: what the trace says happened, answered to whoever asks ────────────────────────────────────
class World:
    def __init__(self, trace, root, clock, conflicts="files", log=None):
        self.trace, self.root, self.clock, self.conflicts = trace, root, clock, conflicts
        self.log = log or (lambda s: None)
        self.prs = {(l["repo"], l["pr"]): l for l in trace["landings"]}
        self.repos = trace.get("repos") or {}
        self.med = trace["medians"]
        self.state = {}         # (repo, pr) -> live state
        self.merges = []        # [(seq, repo, pr, at, files)]
        self.tip = {}           # repo -> synthetic default-branch sha
        self.digest, self.mark, self.v2_markers = change_digest, "cc-land-review", True   # the candidate's own, once loaded
        self.mtimes = {}
        self.rearm, self.work_wanted = [], False
        self.n = {"suites": 0, "gates": 0, "reviews": 0, "repairs": 0, "merges": 0, "conflicts": 0}
        self.calls = []
        for key, l in self.prs.items():
            self.state[key] = {"merged_at": None, "comments": [], "base_seq": 0, "fix": None, "fix_gens": 0,
                               "fix_pushes": [], "extra_gens": 0}

    # -- where a path points --
    def repo_of_path(self, path):
        m = re.search(r"/cc-land\.\w+\.([A-Za-z0-9_-]+)\.(\d+|base)\.[^/]+(?:/|$)", path or "")
        if m:
            return m.group(1)
        m = re.match(re.escape(self.root) + r"/dev/([^/]+)", path or "")
        return m.group(1) if m else ""

    def pr_of_path(self, path):
        m = re.search(r"/cc-land\.\w+\.([A-Za-z0-9_-]+)\.(\d+)\.[^/]+(?:/|$)", path or "")
        return (m.group(1), int(m.group(2))) if m else None

    def gate_rel(self, path):
        m = re.search(r"/cc-land\.\w+\.[A-Za-z0-9_-]+\.(?:\d+|base)\.[^/]+/head/(.+)$", path or "")
        if m:
            return m.group(1)
        m = re.match(re.escape(self.root) + r"/dev/[^/]+/(.+)$", path or "")
        return m.group(1) if m else None

    def gates_of(self, repo):
        return (self.repos.get(repo) or {}).get("gates") or []

    def base_of(self, repo):
        return (self.repos.get(repo) or {}).get("default_branch") or "main"

    def board(self, repo):
        tracks = {}
        for (r, pr), l in sorted(self.prs.items()):
            if r == repo and (l.get("branch") or "").startswith("track/"):
                tracks[l["branch"][6:]] = {"pr": f"https://example.invalid/o/r/pull/{pr}", "branch": l["branch"],
                                           "status": "merged" if self.state[(r, pr)]["merged_at"] else "review"}
        return {"default_branch": self.base_of(repo), "path": f"{self.root}/dev/{repo}", "tracks": tracks}

    # -- the head, over time --
    def head(self, key, at=None):
        l, st, at = self.prs[key], self.state[key], self.clock.now if at is None else at
        cur = l["heads"][0]
        for h in l["heads"]:
            if h["via"] == "fix":
                continue
            if epoch(h["at"]) <= at and h["gen"] >= cur["gen"]:
                cur = h
        fix_heads = [h for h in l["heads"] if h["via"] == "fix"]
        for i, pushed_at in enumerate(st["fix_pushes"]):
            if pushed_at <= at:
                h = fix_heads[i] if i < len(fix_heads) else {"sha": hexname(key, "fix", i), "gen": (fix_heads[-1]["gen"] if fix_heads else cur["gen"]) + 1 + (i - len(fix_heads))}
                if h["gen"] >= cur["gen"]:
                    cur = h
        return cur["sha"], cur["gen"]

    def verdict_for(self, key, sha, gen):
        l = self.prs[key]
        for v in l["verdicts"]:
            if v["head"] == sha[:12] and v["kind"] == "bought":
                return v["verdict"], v.get("cost") or 0
        for v in l["verdicts"]:
            if v.get("gen") == gen:
                return v["verdict"], v.get("cost") or 0
        if l.get("merged"):     # the PR's eventual verdict: it landed, so the last diff anyone read was a LAND
            return "LAND", 0
        if l["verdicts"]:
            return l["verdicts"][-1]["verdict"], l["verdicts"][-1].get("cost") or 0
        return "LAND", 0

    def record(self, key, v):
        """A verdict a PERSON wrote down (`cc-land record`), put on the PR at the time they did, in the shape the
        candidate itself writes — keyed by the change where it keys by the change, by the head where it does not —
        so the candidate reads it as its own and does not buy the same answer again."""
        l, st = self.prs[key], self.state[key]
        h = next((h for h in l["heads"] if h["sha"][:12] == (v.get("head") or "")[:12]), None)
        sha, gen = (h["sha"], h["gen"]) if h else self.head(key)
        by = re.sub(r"[^A-Za-z0-9._@-]+", "-", v.get("by") or "a-person")
        if self.v2_markers:
            body = (f"<!-- {self.mark} v2 change={self.digest(self.synth_diff(key, gen))} base={self.mb(key)[:12]} "
                    f"head={sha[:12]} verdict={v['verdict']} by={by} -->")
        else:
            body = f"<!-- {self.mark} {sha[:12]} {v['verdict']} -->"
        st["comments"].append({"body": f"{body}\n{v['verdict']} — recorded by {by}, replayed from history",
                               "viewerDidAuthor": True, "createdAt": stamp(self.clock.now)})
        self.log(f"{stamp(self.clock.now)} recorded {key} {v['verdict']} by {by} at {sha[:12]}")
        # A recorded LAND is a person saying "land this": in history the job was either still waiting in a slow
        # queue or they queued it again a second later. A faster candidate may have finished the job before the
        # record came, and nobody in a replay types the re-queue — so the record does, when the PR is still open.
        return v["verdict"] == "LAND" and st["merged_at"] is None

    def conflicting(self, key):
        """The brief's rule: "a PR conflicts when a PR merged since its base IN THE REPLAY'S ORDER touches one of
        its files" — under `files` for every PR, under `history` only for a PR history saw conflict."""
        if self.conflicts == "none" or (self.conflicts == "history" and not self.prs[key].get("conflicted")):
            return False
        st, mine = self.state[key], {p for _, p in self.prs[key]["files"]}
        for seq, repo, pr, at, files in self.merges:
            if repo == key[0] and seq >= st["base_seq"] and (repo, pr) != key and mine & files:
                return True
        return False

    def rebase(self, key):
        self.state[key]["base_seq"] = len(self.merges)

    # -- the answers --
    def gh(self, argv, cwd):
        repo = self.repo_of_path(cwd)
        if len(argv) < 4 or argv[1] != "pr" or not repo:
            return 1, "gh: not answered here"
        try:
            pr = int(argv[3])
        except ValueError:
            return 1, "gh: bad pr"
        key = (repo, pr)
        if key not in self.prs:
            return 1, f"no pull requests found for #{pr}"
        l, st = self.prs[key], self.state[key]
        if argv[2] == "view":
            fields = argv[argv.index("--json") + 1].split(",") if "--json" in argv else []
            sha, gen = self.head(key)
            merged = st["merged_at"] is not None
            facts = {"number": pr, "title": l.get("title") or f"PR #{pr}", "url": f"https://example.invalid/o/r/pull/{pr}",
                     "state": "MERGED" if merged else "OPEN",
                     "mergeable": "CONFLICTING" if (not merged and self.conflicting(key)) else "MERGEABLE",
                     "headRefName": l.get("branch") or f"pr-{pr}", "headRefOid": sha + "0" * (40 - len(sha)),
                     "mergeCommit": {"oid": hexname(key, "merge")} if merged else None,
                     "mergedAt": stamp(st["merged_at"]) if merged else None,
                     "comments": [dict(c) for c in st["comments"]]}
            return 0, json.dumps({k: facts.get(k) for k in fields} if fields else facts)
        if argv[2] == "comment":
            body = argv[argv.index("--body") + 1] if "--body" in argv else ""
            st["comments"].append({"body": body, "viewerDidAuthor": True, "createdAt": stamp(self.clock.now)})
            return 0, f"https://example.invalid/o/r/pull/{pr}#issuecomment-{len(st['comments'])}"
        if argv[2] == "merge":
            if st["merged_at"] is not None:
                return 1, "GraphQL: Pull request already merged"
            sha, gen = self.head(key)
            want = argv[argv.index("--match-head-commit") + 1] if "--match-head-commit" in argv else ""
            if want and not want.startswith(sha):
                return 1, "GraphQL: Head branch was modified. Review and try the merge again."
            if self.conflicting(key):
                self.n["conflicts"] += 1
                return 1, "GraphQL: Pull Request has merge conflicts (mergePullRequest)"
            st["merged_at"] = self.clock.now
            self.merges.append((len(self.merges), repo, pr, self.clock.now, {p for _, p in l["files"]}))
            self.tip[repo] = hexname(repo, "tip", len(self.merges))
            self.n["merges"] += 1
            self.log(f"{stamp(self.clock.now)} merged {repo}#{pr}")
            return 0, ""
        return 1, "gh: not answered here"

    def git(self, argv, cwd, stdout_only=False):
        repo, key = self.repo_of_path(cwd), self.pr_of_path(cwd)
        sub = argv[1] if len(argv) > 1 else ""
        args = argv[2:]
        base = self.base_of(repo)
        tip = self.tip.get(repo) or hexname(repo, "tip", 0)
        if sub in ("fetch", "pull", "worktree"):
            return 0, ""
        if sub == "ls-remote":
            out = []
            for ref in args[1:]:
                m = re.match(r"refs/pull/(\d+)/head", ref)
                pr = int(m.group(1)) if m else next((p for (r, p), l in self.prs.items() if r == repo and f"refs/heads/{l.get('branch')}" == ref), None)
                if pr is not None and (repo, pr) in self.prs:
                    sha, _ = self.head((repo, pr))
                    out.append(f"{sha + '0' * (40 - len(sha))}\t{ref}")
            return 0, "\n".join(out) + ("\n" if out else "")
        if sub == "rev-parse":
            what = args[-1] if args else ""
            if what == "FETCH_HEAD":
                key = self._fetched.get(repo)
                if not key:
                    return 128, "fatal: no FETCH_HEAD"
                sha, _ = self.head(key)
                return 0, sha + "0" * (40 - len(sha)) + "\n"
            if what == "--abbrev-ref" or "--abbrev-ref" in args:
                return 0, base + "\n"
            if what == "HEAD^{tree}":
                if key and key in self.prs:
                    sha, gen = self.head(key)
                    return 0, self.tree_id(key, gen) + "\n"
                return 0, hexname(repo, "basetree", tip) + "\n"
            if what in ("HEAD", f"origin/{base}"):
                return 0, tip + "\n"
            return 0, hexname(what) + "\n"
        if sub == "merge-base":
            pr_key = self.key_of_sha(repo, args[-1])
            return (0, self.mb(pr_key) + "\n") if pr_key else (128, "fatal: no merge base")
        if sub == "rev-list":
            return 0, "0\n"
        if sub == "remote":
            return 0, "git@example.invalid:o/r.git\n"
        if sub == "show":
            spec = args[-1] if args else ""
            if "--name-status" in args:
                pr_key = self.key_of_merge(spec)
                return (0, self.name_status(pr_key)) if pr_key else (0, "")
            path = spec.split(":", 1)[1] if ":" in spec else ""
            ctl = (self.repos.get(repo) or {}).get("control")
            if ctl and path == ctl[0]:
                return 0, ctl[1]
            return 128, f"fatal: path '{path}' does not exist"
        if sub == "diff":
            flags = [a for a in args if a.startswith("-")]
            revs = [a for a in args if not a.startswith("-")]
            pr_key = next((self.key_of_sha(repo, r) for r in reversed(revs) if self.key_of_sha(repo, r)), None)
            if not pr_key:
                return 0, ""
            l = self.prs[pr_key]
            if "--name-status" in flags:
                return 0, self.name_status(pr_key)
            if "--numstat" in flags:
                return 0, "".join(f"{a}\t{d}\t{p}\n" for p, (a, d) in sorted(l["perfile"].items())) or \
                    "".join(f"{l.get('adds', 1)}\t{l.get('dels', 0)}\t{p}\n" for _, p in l["files"])
            if "--name-only" in flags:
                return 0, ""
            if "-U0" in flags:
                return 1, ""
            _, gen = self.head(pr_key)
            return 0, self.synth_diff(pr_key, gen)
        return 0, ""

    _fetched = {}

    def note_fetch(self, repo, spec):
        m = re.match(r"(?:refs/heads/(.+)|pull/(\d+)/head)$", spec or "")
        if not m:
            return
        if m.group(2):
            self._fetched[repo] = (repo, int(m.group(2)))
        else:
            for (r, p), l in self.prs.items():
                if r == repo and l.get("branch") == m.group(1):
                    self._fetched[repo] = (r, p)

    def key_of_sha(self, repo, sha):
        for (r, p), l in self.prs.items():
            if r != repo:
                continue
            for h in l["heads"]:
                if sha.startswith(h["sha"]) or h["sha"].startswith(sha[:12]):
                    return (r, p)
            for i in range(self.state[(r, p)]["fix_pushes"].__len__()):
                if sha.startswith(hexname((r, p), "fix", i)):
                    return (r, p)
        return None

    def key_of_merge(self, sha):
        for key in self.prs:
            if sha.startswith(hexname(key, "merge")):
                return key
        return None

    def mb(self, key):
        return hexname(key, "base")

    def tree_id(self, key, gen):
        return hexname(key, "tree", gen)

    def name_status(self, key):
        return "".join(f"{s}\t{p}\n" for s, p in self.prs[key]["files"])

    def synth_diff(self, key, gen):
        out = []
        for s, p in self.prs[key]["files"]:
            out.append(f"diff --git a/{p} b/{p}\nindex 0000000..1111111 100644\n--- a/{p}\n+++ b/{p}\n@@ -1 +1 @@\n"
                       f"-{key[0]}#{key[1]} before\n+{key[0]}#{key[1]} change {gen} of {p}\n")
        return "".join(out)

    def gate(self, argv, cwd):
        key = self.pr_of_path(cwd)
        rel = self.gate_rel(argv[0]) or os.path.basename(argv[0])
        g = os.path.basename(rel)
        self.n["gates"] += 1
        if rel in SUITE:
            self.n["suites"] += 1
        secs = self.med["gate"].get(g, 300)
        red = False
        if key and key in self.prs:
            l = self.prs[key]
            secs = l["gates"].get(g) or secs
            sha, _ = self.head(key)
            red = sha[:12] in (l["red"].get(g) or [])
        self.log(f"{stamp(self.clock.now)} gate {g} for {key} {secs}s {'RED' if red else 'green'}")
        self.clock.sleep(secs)
        return (1, "  ✗ a case history saw fail\n1 failed\n") if red else (0, "  ✓ every one\n0 failed\n")

    def review(self, argv, cwd):
        prompt = argv[2] if len(argv) > 2 else ""
        m = re.search(r"cc-replay:(\S+):(\d+)", prompt)
        key = (m.group(1), int(m.group(2))) if m else self.pr_of_path(cwd)
        self.n["reviews"] += 1
        secs, verdict, cost = self.med["review"], "LAND", 0.0
        if key in self.prs:
            l = self.prs[key]
            secs = median(l["review_secs"], secs)
            sha, gen = self.head(key)
            verdict, cost = self.verdict_for(key, sha, gen)
        self.log(f"{stamp(self.clock.now)} review {key} {int(secs)}s -> {verdict}")
        self.clock.sleep(secs)
        obj = {"verdict": verdict, "findings": [] if verdict == "LAND" else
               [{"where": "somewhere", "what": "what history's reviewer found", "fix": "what it asked for"}]}
        return 0, json.dumps({"result": json.dumps(obj), "structured_output": obj, "total_cost_usd": cost or 1.0,
                              "usage": {"input_tokens": 1000, "output_tokens": 100}, "num_turns": 5})

    def fix(self, argv):
        repo, track = argv[1], argv[2]
        key = next(((r, p) for (r, p), l in self.prs.items() if r == repo and l.get("branch") == f"track/{track}"), None)
        self.n["repairs"] += 1
        if key:
            st, l = self.state[key], self.prs[key]
            i = len(st["fix_pushes"])
            latency = (epoch(l["fixes"][i]["pushed"]) - epoch(l["fixes"][i]["dispatched"])) if i < len(l["fixes"]) and l["fixes"][i].get("pushed") else 0
            latency = latency if latency > 0 else self.med["fix"]
            st["fix_pushes"].append(self.clock.now + latency)
            st["fix"] = (self.clock.now, self.clock.now + latency)
            self.log(f"{stamp(self.clock.now)} repair {key} pushes in {latency}s")
        return 0, ""

    def track_status(self, repo, track):
        key = next(((r, p) for (r, p), l in self.prs.items() if r == repo and l.get("branch") == f"track/{track}"), None)
        if key and self.state[key]["fix"] and self.state[key]["fix"][1] > self.clock.now:
            return "running"
        return "merged" if key and self.state[key]["merged_at"] is not None else "review"

    def sh(self, argv, cwd=None, timeout=300, stdout_only=False, **kw):
        tool = os.path.basename(argv[0]) if argv else ""
        self.calls.append(tool)
        if tool == "git":
            if len(argv) > 3 and argv[1] == "fetch":
                self.note_fetch(self.repo_of_path(cwd), argv[-1])
            return self.git(argv, cwd, stdout_only)
        if tool == "gh":
            return self.gh(argv, cwd)
        if tool == "claude":
            return self.review(argv, cwd)
        if tool == "systemd-run":
            on = next((a for a in argv if a.startswith("--on-active=")), "")
            if on:
                self.rearm.append(int(on.split("=", 1)[1]))
            else:
                self.work_wanted = True
            return 0, ""
        if tool == "systemctl":
            return (0, "inactive\n") if "is-active" in argv else (0, "disabled\n") if "is-enabled" in argv else (0, "")
        if tool == "cc-board":
            if len(argv) > 4 and argv[1] == "get" and argv[4] == "status":
                return 0, self.track_status(argv[2], argv[3]) + "\n"
            return 0, ""
        if tool == "cc-limit":
            return 1, "clear\n"
        if tool == "cc-scope":
            return 1, "no ledger\n"
        if tool == "cc":
            if "--go" in argv:
                return self.fix(argv)
            return 0, ""
        if tool in ("tmux", "pgrep", "cc-pause"):
            return 1, ""
        return 0, ""


# ── the harness: import the candidate, rebind its seams, drive the trace through it ──────────────────────
def load_candidate(path, root, world, clock, verbose_log):
    binq = f"{root}/bin"
    os.makedirs(binq, exist_ok=True)
    os.makedirs(f"{root}/config", exist_ok=True)
    dst = f"{binq}/cc-land"
    shutil.copyfile(path, dst)
    with open(f"{root}/config/review-prompt.md", "w") as f:
        f.write("cc-replay:@REPO@:@PR@ review of @TITLE@ at @TREE@ diff @DIFF@ brief @BRIEF@ rules @RULES@\n")
    spec = importlib.util.spec_from_loader("cc_land_candidate", importlib.machinery.SourceFileLoader("cc_land_candidate", dst))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    ns = mod.__dict__
    for k in ("sh", "run_gate", "cmd_work", "cmd_queue", "write_atomic", "stamp", "LANDQ", "STATE", "BOARDS"):
        if k not in ns:
            raise SystemExit(f"cc-replay: {path} has no `{k}` — not a cc-land this harness knows how to hold")
    real_write = ns["write_atomic"]
    world.digest = ns.get("change_digest") or change_digest
    world.mark = ns.get("REVIEW_MARK") or "cc-land-review"
    world.v2_markers = "by" in inspect.signature(ns["Land"].marker).parameters if "Land" in ns else False

    def write_atomic(p, obj):
        real_write(p, obj)
        world.mtimes[p] = clock.now

    ns.update(threading=FakeThreading(clock), time=FakeTime(clock), os=FakeOs(world, world.mtimes, clock),
              sh=world.sh, run_gate=lambda argv, cwd, log, env: world.gate(argv, cwd), write_atomic=write_atomic,
              board=world.board, repo_root=lambda r: f"{root}/dev/{r}", paused=lambda t: False,
              linked_units=lambda: [], read_unit=lambda u: "")
    if "default_signals" in ns:
        ns["default_signals"] = lambda: None
    return mod


def score(candidate, trace, prepare=4, conflicts="history", verbose=False, keep_root=False):
    root = tempfile.mkdtemp(prefix="cc-replay-")
    saved_env = {k: os.environ.get(k) for k in ("HOME", "CC_CLAUDE", "CC_LAND_PREPARE", "CC_GREEN_DIR", "TMPDIR")}
    saved_tmp = tempfile.tempdir
    chatter = io.StringIO()
    logl = []
    log = (lambda s: logl.append(s)) if verbose else (lambda s: None)
    try:
        os.makedirs(f"{root}/tmp")
        os.environ.update(HOME=root, CC_CLAUDE=f"{root}/bin/claude", CC_LAND_PREPARE=str(prepare), TMPDIR=f"{root}/tmp")
        os.environ.pop("CC_GREEN_DIR", None)
        tempfile.tempdir = f"{root}/tmp"
        arrivals = [(epoch(a["at"]), 1, l["repo"], l["pr"], None) for l in trace["landings"] for a in l["arrivals"] if epoch(a["at"])]
        if not arrivals:
            raise SystemExit("cc-replay: the trace has no arrivals")
        records = [(epoch(v["at"]), 0, l["repo"], l["pr"], v) for l in trace["landings"] for v in l["verdicts"]
                   if v.get("kind") == "recorded" and epoch(v["at"])]
        events = sorted(arrivals + records, key=lambda e: e[:4])    # a record and a queue in one second: the record first
        clock = Clock(events[0][0] - 1)
        world = World(trace, root, clock, conflicts, log)
        for repo in sorted({l["repo"] for l in trace["landings"]}):
            os.makedirs(f"{root}/dev/{repo}/.git", exist_ok=True)
            for l in trace["landings"]:
                if l["repo"] == repo and (l.get("branch") or "").startswith("track/"):
                    os.makedirs(f"{root}/.cc/state/{repo}/{l['branch'][6:]}", exist_ok=True)
        landq = f"{root}/.cc/state/land"
        os.makedirs(f"{landq}/green", exist_ok=True)
        for l in trace["landings"]:        # the green records history spent, for the head they were spent on
            key = (l["repo"], l["pr"])
            for g in l.get("green") or []:
                gate = next((x for x in world.gates_of(l["repo"]) if os.path.basename(x) == g), g)
                for h in l["heads"]:
                    tree = world.tree_id(key, h["gen"])
                    with open(f"{landq}/green/{g}-{tree[:12]}.json", "w") as f:
                        json.dump({"suite": gate, "tree": tree, "scope": "", "at": l["arrivals"][0]["at"] if l["arrivals"] else stamp(clock.now)}, f)
        mod = load_candidate(candidate, root, world, clock, log)

        def inject(payload):
            kind, repo, pr, v = payload
            if kind == 0 and not world.record((repo, pr), v):
                return
            world.rebase((repo, pr))
            with contextlib_redirect(chatter):
                mod.cmd_queue([repo, str(pr), "--who", "replay"])
            log(f"{stamp(clock.now)} queued {repo}#{pr}{' after the recorded LAND' if kind == 0 else ''}")

        clock.inject = inject
        clock.arrivals = [(e[0], e[1:]) for e in events]
        armed, sweeps = [], 0
        while True:
            nxt_arr = clock.arrivals[0][0] if clock.arrivals else None
            nxt_arm = min(armed) if armed else None
            if nxt_arr is None and nxt_arm is None:
                break
            t = min(x for x in (nxt_arr, nxt_arm) if x is not None)
            clock.now = max(clock.now, t)
            world.work_wanted = False
            while clock.arrivals and clock.arrivals[0][0] <= clock.now:
                _, payload = clock.arrivals.pop(0)
                inject(payload)
            due = [a for a in armed if a <= clock.now]
            if not due and not world.work_wanted:
                continue
            armed = [a for a in armed if a > clock.now]
            world.rearm = []
            sweeps += 1
            log(f"{stamp(clock.now)} sweep {sweeps}")
            with contextlib_redirect(chatter):
                mod.cmd_work([])
            if clock.dead:
                raise Deadlock(clock.dead)
            armed += [clock.now + s for s in world.rearm]
            if sweeps > 100000:
                raise SystemExit("cc-replay: runaway sweep loop")
        return report(trace, world, clock, sweeps), "\n".join(logl), chatter.getvalue()
    finally:
        for k, v in saved_env.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
        tempfile.tempdir = saved_tmp
        if not keep_root:
            shutil.rmtree(root, ignore_errors=True)


class contextlib_redirect:
    def __init__(self, buf):
        self.buf = buf

    def __enter__(self):
        self.o, self.e = sys.stdout, sys.stderr
        sys.stdout = sys.stderr = self.buf

    def __exit__(self, *a):
        sys.stdout, sys.stderr = self.o, self.e
        return False


def report(trace, world, clock, sweeps):
    rows, mins, both, both_q = [], [], [], []
    for l in sorted(trace["landings"], key=lambda l: (l["repo"], l["pr"])):
        key = (l["repo"], l["pr"])
        first = min((epoch(a["at"]) for a in l["arrivals"] if epoch(a["at"])), default=0)
        st = world.state[key]
        m_rep = st["merged_at"]
        hist = epoch(l.get("merged") or "")
        rmin = (m_rep - first) / 60 if m_rep is not None and first else None
        hmin = (hist - first) / 60 if hist and first else None
        if rmin is not None:
            mins.append(rmin)
        via = "queue" if l.get("queue_merged") else ("hand" if hist else "-")
        if rmin is not None and hmin is not None:
            both.append(hmin)
            if via == "queue":
                both_q.append(hmin)
        rows.append((f"{l['repo']}#{l['pr']}", stamp(first)[:16] if first else "-", stamp(m_rep)[:16] if m_rep is not None else "-",
                     f"{rmin:.1f}" if rmin is not None else "-", stamp(hist)[:16] if hist else "-", f"{hmin:.1f}" if hmin is not None else "-", via))
    n = world.n
    total = len(trace["landings"])
    merged = sum(1 for r in rows if r[2] != "-")
    med = statistics.median(mins) if mins else 0.0
    lines = [f"score {med:.1f} suites={n['suites']} reviews={n['reviews']} repairs={n['repairs']} unmerged={total - merged} merged={merged}/{total}",
             f"gates={n['gates']} conflicts={n['conflicts']} sweeps={sweeps} clock-advances={clock.advances} "
             f"span={stamp(clock.now)[:16]} hand-merged={sum(1 for r in rows if r[6] == 'hand')}",
             f"history {statistics.median(both) if both else 0.0:.1f} over the {len(both)} PRs both merged "
             f"({statistics.median(both_q) if both_q else 0.0:.1f} over the {len(both_q)} the queue merged)",
             f"{'pr':<22} {'queued':<16} {'merged-in-replay':<16} {'min':>7} {'merged-in-history':<17} {'min-hist':>8} {'hist-by':<7}"]
    for r in rows:
        lines.append(f"{r[0]:<22} {r[1]:<16} {r[2]:<16} {r[3]:>7} {r[4]:<17} {r[5]:>8} {r[6]:<7}")
    return "\n".join(lines) + "\n"


def cmd_score(argv):
    candidate, trace, prepare, conflicts, verbose, keep = "", "", 4, "history", False, False
    rest = list(argv)
    while rest:
        a = rest.pop(0)
        if a == "--candidate" and rest:
            candidate = rest.pop(0)
        elif a == "--trace" and rest:
            trace = rest.pop(0)
        elif a == "--prepare" and rest:
            prepare = int(rest.pop(0))
        elif a == "--conflicts" and rest:
            conflicts = rest.pop(0)
        elif a == "--verbose":
            verbose = True
        elif a == "--keep":
            keep = True
        else:
            print(f"cc-replay score: unexpected '{a}'", file=sys.stderr)
            return 2
    if not candidate or not trace or conflicts not in ("history", "files", "none"):
        print("cc-replay score --candidate PATH --trace FILE [--prepare N] [--conflicts history|files|none] [--verbose] [--keep]", file=sys.stderr)
        return 2
    t = load_trace(trace)
    out, log, chatter = score(os.path.abspath(candidate), t, prepare, conflicts, verbose, keep)
    sys.stdout.write(out)
    if verbose:
        sys.stderr.write(log + "\n")
        sys.stderr.write("--- candidate output ---\n" + chatter)
    return 0


# ── selfcheck ────────────────────────────────────────────────────────────────────────────────────────────
def fixture_trace(n=4, t0=1_800_000_000, stopped=(), recorded_at=0):
    """n PRs on disjoint files, queued a minute apart, each with its own gate durations; PR 2 and 3 share a file.
    A PR in `stopped` bought a DO-NOT-LAND on its head; with `recorded_at`, a person recorded LAND on it that many
    seconds after it was queued."""
    landings = []
    for i in range(1, n + 1):
        files = [["M", f"bin/tool{i}"]] + ([["M", "bin/shared"]] if i in (2, 3) else [])
        landings.append({"repo": "r", "pr": i, "title": f"change {i}", "branch": f"track/t{i}", "base": "main",
                         "created": stamp(t0 - 600), "merged": stamp(t0 + 3600 * i), "state": "MERGED",
                         "files": files, "perfile": {p: [10, 2] for _, p in files}, "adds": 10, "dels": 2,
                         "arrivals": [{"at": stamp(t0 + 60 * i), "again": False}],
                         "heads": [{"at": stamp(t0 - 600), "sha": f"{i:012x}", "gen": 0, "via": "push"}],
                         "verdicts": [], "fixes": [], "dones": [], "gates": {"check.sh": 60, "selftest.sh": 300 * i},
                         "red": {}, "green": [], "tiers": [], "review_secs": [200], "attempts": 1, "conflicted": False,
                         "queue_merged": True})
        if i in stopped:
            landings[-1]["verdicts"] = [{"at": stamp(t0 + 60 * i + 200), "head": f"{i:012x}", "gen": 0, "kind": "bought",
                                         "verdict": "DO-NOT-LAND", "by": "claude-x", "cost": 1.0}]
            if recorded_at:
                landings[-1]["verdicts"].append({"at": stamp(t0 + 60 * i + recorded_at), "head": f"{i:012x}", "gen": 0,
                                                 "kind": "recorded", "verdict": "LAND", "by": "a person", "cost": 0.0})
    return {"version": 1, "since": stamp(t0), "until": stamp(t0 + 86400),
            "repos": {"r": {"default_branch": "main", "gates": ["tests/check.sh", "tests/selftest.sh"], "control": None}},
            "medians": {"gate": {"check.sh": 60, "selftest.sh": 600}, "review": 200, "fix": 900}, "landings": landings, "gaps": []}


def cmd_selfcheck():
    fails = []

    def check(name, cond):
        print(("  ✓ " if cond else "  ✗ ") + name)
        if not cond:
            fails.append(name)

    # 1. the virtual clock: four gate threads park for 100/200/300/400 s; joining them all takes the clock to +400
    #    and no wall-clock time, and each advance lands on a wake — never a tick between them.
    clock = Clock(1000)
    th = FakeThreading(clock)
    ends = []
    ts = [th.Thread(target=lambda d=d: (clock.sleep(d), ends.append(clock.now))) for d in (300, 100, 400, 200)]
    w0 = time.time()
    for t in ts:
        t.start()
    for t in ts:
        t.join()
    check("virtual clock: four parked gate threads advance the clock to the longest (1400), in wake order, in no wall time",
          clock.now == 1400 and sorted(ends) == [1100, 1200, 1300, 1400] and time.time() - w0 < 2)
    check("…and it advanced exactly four times — once per distinct wake, never on a tick", clock.advances == 4)
    clock = Clock(0)
    th = FakeThreading(clock)
    same = [th.Thread(target=lambda: clock.sleep(300)) for _ in range(4)]
    for t in same:
        t.start()
    for t in same:
        t.join()
    check("…and four threads parked for the SAME 300 s advance it once, to 300", clock.now == 300 and clock.advances == 1)
    # Event and Condition park too: a waiter on an Event nobody has set is parked, and the clock still moves for
    # the sleeper beside it; the set wakes the waiter without a tick.
    clock = Clock(0)
    th = FakeThreading(clock)
    ev, got = th.Event(), []
    waiter = th.Thread(target=lambda: (ev.wait(), got.append(clock.now)))
    setter = th.Thread(target=lambda: (clock.sleep(50), ev.set()))
    waiter.start(); setter.start(); waiter.join(); setter.join()
    check("an Event waiter is parked, the sleeper beside it moves the clock to 50, and set() wakes the waiter there",
          got == [50] and clock.now == 50)
    clock = Clock(0)
    th = FakeThreading(clock)
    cv, box = th.Condition(), []
    def consumer():
        with cv:
            while not box:
                cv.wait()
            box.append(clock.now)
    def producer():
        clock.sleep(70)
        with cv:
            box.append("x")
            cv.notify_all()
    c, p = th.Thread(target=consumer), th.Thread(target=producer)
    c.start(); p.start(); c.join(); p.join()
    check("a Condition waiter is parked and wakes on notify at the producer's virtual time", box == ["x", 70])
    # Arrivals: an arrival due before the next wake is injected at its own time, with the clock stopped there.
    clock = Clock(0)
    th = FakeThreading(clock)
    seen = []
    clock.inject = lambda p: seen.append((p, clock.now))
    clock.arrivals = [(40, "a"), (90, "b")]
    t = th.Thread(target=lambda: clock.sleep(100))
    t.start(); t.join()
    check("arrivals due before a wake are injected at their own times, and the sleeper still wakes at 100",
          seen == [("a", 40), ("b", 90)] and clock.now == 100)
    # A deadlock — everything parked, nothing due — is reported, not hung.
    clock = Clock(0)
    th = FakeThreading(clock)
    ev2 = th.Event()
    dead = []
    t = th.Thread(target=lambda: (lambda: dead.append(ev2.wait()))())
    t.start()
    try:
        t.join()
    except Deadlock:
        dead.append("raised")
    check("every thread parked with nothing due is a Deadlock raised to the joiner, never a hang", "raised" in dead and clock.dead)

    # 2. the conflict model: a PR conflicts when a PR merged since its base, in the replay's order, touches one of
    #    its files — and not when the files are disjoint, and not once it has rebased past that merge.
    tr = fixture_trace()
    root = tempfile.mkdtemp(prefix="cc-replay-selfcheck-")
    try:
        w = World(tr, root, Clock(0), "files")
        w.merges.append((0, "r", 2, 0, {"bin/tool2", "bin/shared"}))
        check("conflict model: PR 3 (shares bin/shared) conflicts after PR 2 merged past its base", w.conflicting(("r", 3)))
        check("…and PR 4, on disjoint files, does not", not w.conflicting(("r", 4)))
        w.rebase(("r", 3))
        check("…and a rebase past that merge clears it", not w.conflicting(("r", 3)))
        w.merges.append((1, "r", 4, 0, {"bin/tool4"}))
        check("…a later merge on other files leaves it clear", not w.conflicting(("r", 3)))
        w2 = World(tr, root, Clock(0), "none")
        w2.merges.append((0, "r", 2, 0, {"bin/shared"}))
        check("--conflicts none never conflicts", not w2.conflicting(("r", 3)))
        w4 = World(tr, root, Clock(0), "history")
        w4.merges.append((0, "r", 2, 0, {"bin/shared"}))
        w4.prs[("r", 3)]["conflicted"] = True
        check("--conflicts history (the default) conflicts a PR history saw conflict, on the same rule…",
              w4.conflicting(("r", 3)))
        w4.prs[("r", 3)]["conflicted"] = False
        check("…and never one history did not", not w4.conflicting(("r", 3)))
        # the gh answer carries it: mergeable flips to CONFLICTING, and a merge is refused with GitHub's words
        w3 = World(tr, root, Clock(0), "files")
        w3.merges.append((0, "r", 2, 0, {"bin/shared"}))
        cwd = f"{root}/dev/r"
        rc, o = w3.gh(["gh", "pr", "view", "3", "--json", "state,mergeable"], cwd)
        check("gh pr view answers CONFLICTING for it", rc == 0 and json.loads(o)["mergeable"] == "CONFLICTING")
        rc, o = w3.gh(["gh", "pr", "merge", "3", "--squash"], cwd)
        check("…and gh pr merge refuses it with GitHub's own words", rc == 1 and "merge conflicts" in o)
        rc, o = w3.gh(["gh", "pr", "merge", "4", "--squash"], cwd)
        rc2, o2 = w3.gh(["gh", "pr", "view", "4", "--json", "state,mergedAt"], cwd)
        check("a clean PR merges and reads MERGED after", rc == 0 and json.loads(o2)["state"] == "MERGED")
    finally:
        shutil.rmtree(root, ignore_errors=True)

    # 3. the trace loader: a fixture round-trips through a file, and a file that is not a trace is refused.
    d = tempfile.mkdtemp(prefix="cc-replay-selfcheck-")
    try:
        with open(f"{d}/t.json", "w") as f:
            json.dump(fixture_trace(), f)
        t = load_trace(f"{d}/t.json")
        check("trace loader: a fixture loads with its landings, arrivals, heads and medians",
              len(t["landings"]) == 4 and t["landings"][2]["files"][1][1] == "bin/shared" and t["medians"]["review"] == 200)
        with open(f"{d}/bad.json", "w") as f:
            f.write('{"version": 2}')
        try:
            load_trace(f"{d}/bad.json")
            bad = False
        except SystemExit:
            bad = True
        check("…and a file that is not a v1 trace is refused", bad)
        # the ledger and marker readers, on lines of the shapes the sources print
        ev = ledger_events_from_text("2026-09-07T10:00:00Z\tqueued r#7 who=- chat=- by=x\n2026-09-07T10:30:00Z\tdone r#7 rc=0 [r] PR #7: landed ✅\n"
                                     "2026-09-07T10:31:00Z\tqueued r#deploy span=a..b by=the catch-up sweep\n", 0, 2_000_000_000)
        check("the ledger reader keeps queued/done for a PR and drops the deploy rows",
              [e["kind"] for e in ev] == ["queued", "done"] and ev[1]["rest"].startswith("rc=0"))
        old = parse_marker("<!-- cc-land-review 926d8b229822 LAND-AFTER-FIX -->\n**cc-land review** — `926d8b229822`, model `claude-opus-5`\n")
        new = parse_marker("<!-- cc-land-review v2 change=6eeebb3b7c8ccece3c98ae8111b83bc5045fd33d base=275f737a49f3 head=418892988b79 verdict=LAND by=r-b8-reviewer -->\nx")
        check("both marker shapes are read: the head-keyed one is a bought verdict, the change-keyed one signed by a "
              "person is a recorded one", old == ("926d8b229822", "LAND-AFTER-FIX", "", "claude-opus-5", "bought")
              and new == ("418892988b79", "LAND", "6eeebb3b7c8ccece3c98ae8111b83bc5045fd33d", "r-b8-reviewer", "recorded"))
    finally:
        shutil.rmtree(d, ignore_errors=True)

    # 4. determinism, end to end: the cc-land beside this file scores the fixture twice to the same bytes, every PR
    #    merges, and the PRs on a shared file were gated one after the other (the second's merge is later).
    cand = os.path.join(os.path.dirname(os.path.realpath(__file__)), "cc-land")
    if os.path.exists(cand):
        a, la, ca = score(cand, fixture_trace(), prepare=4, verbose=True)
        b, _, _ = score(cand, fixture_trace(), prepare=4)
        check("determinism: two scores of the fixture trace against the cc-land beside this file are byte-identical", a == b)
        check("…and every fixture PR merged in the replay", "merged=4/4" in a.splitlines()[0])
        first = a.splitlines()[0]
        check("…with the score line in its contract shape", re.match(r"^score \d+\.\d suites=\d+ reviews=\d+ repairs=\d+ unmerged=\d+ merged=\d+/\d+$", first) is not None)
        r, lr, _ = score(cand, fixture_trace(stopped=(1,), recorded_at=900), prepare=4, verbose=True)
        check("a LAND a person recorded after the bought review stopped PR 1 lands it — queued again by the record, read, not bought again",
              "merged=4/4" in r.splitlines()[0] and "reviews=4" in r.splitlines()[0] and "after the recorded LAND" in lr)
        u, _, _ = score(cand, fixture_trace(stopped=(1,)), prepare=4)
        check("…and without the record the same PR stays open on its DO-NOT-LAND", "merged=3/4" in u.splitlines()[0])
        c, _, _ = score(cand, fixture_trace(), prepare=1)
        check("a change that alters the landing order changes the number: PREPARE=1 against 4 scores differently",
              c.splitlines()[0] != first)
        if not (a == b and "merged=4/4" in first):
            print(la[-3000:]); print(ca[-3000:])
    else:
        print("  · no cc-land beside this file — the end-to-end cases did not run")
    print(f"cc-replay selfcheck: {len(fails)} failed")
    return 1 if fails else 0


def ledger_events_from_text(text, since, until):
    d = tempfile.mkdtemp(prefix="cc-replay-ledger-")
    try:
        with open(f"{d}/queue.log", "w") as f:
            f.write(text)
        return ledger_events(f"{d}/queue.log", since, until)
    finally:
        shutil.rmtree(d, ignore_errors=True)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip().split("\n\n")[0] + "\n\n" + "\n".join(l for l in __doc__.splitlines()[2:20] if l.startswith("  ")))
        return 0 if argv else 2
    cmd, rest = argv[0], argv[1:]
    if cmd == "extract":
        return cmd_extract(rest)
    if cmd == "score":
        return cmd_score(rest)
    if cmd == "selfcheck":
        return cmd_selfcheck()
    print(f"cc-replay: unknown command '{cmd}'", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
