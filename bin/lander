#!/usr/bin/env bash
# lander — run the pinned lander release, never the live checkout.
#
# ~/.cc/lander/current points at releases/<sha>, a whole tree; `promote` moves it and keeps the one before for
# `rollback`. With no current it REFUSES rather than run the checkout: a broken or deleted release must stop
# landings, never quietly hand them to whatever the checkout holds. Development runs cli.py directly.
# `selfcheck` ALWAYS runs the one beside this file: check.sh calls it to test the change in front of it, and the
# pinned release would answer for code the change never touched. Nothing in the environment moves `current`.
#
# -P keeps core/lander/ off sys.path (its types.py would shadow the stdlib's); no bytecode is written, so neither
# a checkout nor a pinned release gets __pycache__ in it.
set -euo pipefail
here=$(dirname "$(realpath "$0")")
cur=$HOME/.cc/lander/current
export PYTHONDONTWRITEBYTECODE=1
case "${1:-}" in
  selfcheck) exec python3 -P "$here/../lander/cli.py" "$@";;
esac
if [ -f "$cur/core/lander/cli.py" ]; then exec python3 -P "$cur/core/lander/cli.py" "$@"; fi
echo "lander: no pinned release at $cur (promote one; development runs core/lander/cli.py directly)" >&2
exit 3
