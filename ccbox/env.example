# ccbox container environment (docker --env-file). KEY=value, no quotes. chmod 600 - contains secrets.
# GitHub: fine-grained PAT (repo contents/PRs) - gh + git use it automatically. Never mount ~/.ssh instead.
#GH_TOKEN=github_pat_xxx
# Vercel CLI/API token
#VERCEL_TOKEN=xxx
# Commit identity inside the container (the host uses its own git config).
GIT_AUTHOR_NAME=<your name>
GIT_AUTHOR_EMAIL=<you@example.com>
