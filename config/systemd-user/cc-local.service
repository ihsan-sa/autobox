[Unit]
# The local model server for cc-local (core/bin/cc-local): ollama on 127.0.0.1:LOCAL_MODEL_PORT (11434) only, never
# a host port, no tunnel. It holds the GPU only while a model is loaded, and drops it after LOCAL_MODEL_KEEP_ALIVE
# (5m) idle; cc-local takes each cold load's turn through cc-gpu's queue.
# NO [Install] SECTION, ON PURPOSE: a landing must not start a GPU server by itself (config/units.json: enable=owner).
# Switching it on, once, after `cc-local install` has put ollama under ~/.local/opt/ollama:
#   systemctl --user add-wants default.target cc-local.service && systemctl --user start cc-local.service && cc-local pull
# To undo: stop it, then rm ~/.config/systemd/user/default.target.wants/cc-local.service
Description=cc-local: a small model on this box's GPU, loopback only, for private text
After=default.target

[Service]
Type=simple
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/bin/cc-local serve
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
