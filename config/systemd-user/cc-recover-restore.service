[Unit]
Description=cc-recover restore: bring back the saved sessions after a boot, resumed, with a catch-up turn
After=tmux-main.service cc-heartbeat.service
Wants=tmux-main.service

[Service]
Type=oneshot
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/bin/cc-recover restore --boot
# it waits up to 15 min for the network and then launches each session 20 s apart: no finite timeout fits.
# KillMode=process: the sessions live in the tmux server's cgroup, never this unit's, but nothing the launcher
# left behind is killed when it ends either.
TimeoutStartSec=infinity
KillMode=process

[Install]
WantedBy=default.target
