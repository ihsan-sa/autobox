[Unit]
Description=cc-model on an event: a tick the moment cc-limit's stamp, its interrupted-session record or an owner's answer to a confirm card changes
[Path]
PathChanged=%h/.cc/state/claude-limit
PathChanged=%h/.cc/state/limit-interrupted
PathChanged=%h/.cc/state/confirm-answers
Unit=cc-model.service
[Install]
WantedBy=paths.target
