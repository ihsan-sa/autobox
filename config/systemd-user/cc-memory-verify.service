[Unit]
Description=cc-memory-verify: check what the memory notes claim against the live box, retire or rewrite what it contradicts
[Service]
Type=oneshot
# Reads ~/.claude/projects/*/memory and probes the box read-only (cc-model out, cc-config key presence, systemctl
# --user is-active/is-enabled, gh pr view, git, lstat, PATH); writes the memory dirs as dream commits that
# `cc-memory-dream rollback` undoes, and ~/.cc/state/memory-verify/. Two tool-less model calls a dir under
# MEMORY_VERIFY_BUDGET (default $2). Posts one line to #<control repo>-updates.
TimeoutStartSec=3600
ExecStart=%h/bin/cc-memory-verify run
