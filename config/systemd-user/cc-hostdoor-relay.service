[Unit]
Description=cc-hostdoor relay: on a session host, each member's Slack socket carried to the hub's daemon over the host's door key (refuses to run on the hub)
[Service]
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/bin/cc-hostdoor relay
Restart=on-failure
RestartSec=30
[Install]
WantedBy=default.target
