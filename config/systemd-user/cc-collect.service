[Unit]
Description=cc-collect: the day's snapshot of the box's own workings, for the daily improvement passes
[Service]
Type=oneshot
# Reads ~/.cc (Slack archive and outbox, landing queue, boards, failures, loop logs, journals, spend) and writes
# ~/.cc/state/improve/snapshots/<date>/. No model, no network, no post; a run takes a few seconds.
TimeoutStartSec=300
ExecStart=%h/bin/cc-collect
