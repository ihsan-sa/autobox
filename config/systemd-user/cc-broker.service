[Unit]
Description=cc-broker: deliver the events held for a session — one digest instead of one wake each
[Service]
Type=oneshot
# One hung target cannot cost another its delivery: each target's outcome is written to pending.json
# before the next one is tried, so a run cut short here resumes rather than repeating itself.
# NO TIMEOUT AND NOT THE 120 IT WAS, because a flush can now run a target's steward and wait for its exit — that
# is the verdict, so there is nothing to wait for otherwise. ONE BOUND, NOT TWO: cc-broker caps each steward call
# at STEWARD_TIMEOUT_S (1200 s, cc-steward's own worst case), but `--flush` with no target loops over every
# pending target, so any fixed number here is a whole-run budget against a per-target cap and two slow targets
# clear it — which is systemd killing a chain mid-commit, the exact thing the number was meant to prevent
# (review of #343, F3). The cost is named: a run that really takes that long delays the next tick, since the
# timer will not start a second run while this one is active, and a delayed tick costs a late delivery rather
# than a lost one — phase C writes each target's outcome before the next is tried. Only the `task` chain reaches
# those minutes; the rest hand work to a queue and return inside three.
TimeoutStartSec=infinity
ExecStart=%h/bin/cc-broker --flush
