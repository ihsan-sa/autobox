[Unit]
Description=cc-broker: the box's one delivery tick — held events as one digest, cc-msg's spool, and every 2 min the dialog sweep
[Service]
Type=oneshot
# One hung target cannot cost another its delivery: each target's outcome is written to pending.json
# before the next one is tried, so a run cut short here resumes rather than repeating itself.
# A flush only hands text to the daemon's door; the budget is for its riders (cc-msg --drain beside it, and
# cc-stall and cc-msg --sweep every 2 min after it), which had 120 s and 300 s as units of their own.
TimeoutStartSec=300
ExecStart=%h/bin/cc-broker --flush
# THE PEER'S CALLS RIDE THIS TICK TOO: a worker cc-room placed on the peer host spools its board notes, notices and
# DONE there, and `cc-peer drain` brings them here and runs them (cc-peer's docstring). With no peer configured it does
# nothing. `-` because a peer that did not answer keeps its spool for the next tick; `timeout` bounds a slow ssh.
ExecStart=-/usr/bin/timeout 120 %h/bin/cc-peer drain
