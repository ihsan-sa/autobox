[Unit]
Description=cc-queue-steward every 2 min (a landing that stalls must not wait for a person to notice)
# LINKED BUT NOT ENABLED (units.json: enable=owner). The planning seat starts it once, and stopping this timer is
# how the steward is killed.
[Timer]
OnBootSec=4min
OnUnitActiveSec=2min
Persistent=false
[Install]
WantedBy=timers.target
