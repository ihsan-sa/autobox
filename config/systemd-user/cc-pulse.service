[Unit]
Description=cc-pulse: wake every session on this box so each one decides whether there is work
[Service]
Type=oneshot
# 600, not 300: one target can spend ~180 s of per-target CLI timeouts, and a machine-wide run walks them all.
TimeoutStartSec=600
# No argument: the whole machine. The targets are every board and every live orch, enumerated at run time —
# a list here would have to be remembered by whoever registers the next repo, and would not be.
ExecStart=%h/bin/cc-pulse
