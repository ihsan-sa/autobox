[Unit]
Description=cc-janitor: sweep dead tracks, merged origin branches and bare tmux windows in the configured repos, and stopped ccbox containers box-wide
[Service]
Type=oneshot
# --configured, not a repo name: which repos this box sweeps is CC_JANITOR_REPOS in ~/.cc/config, and with the
# key unset no repo is swept. Rule 5 needs no key: on every box, each run removes ccbox-* containers stopped for
# CC_JANITOR_CONTAINER_DAYS days or more (default 7; 0, or the key set empty, switches it off). A tool that
# deletes is pointed by hand — a config line, or a container's own name; the unit only says when.
ExecStart=%h/bin/cc-janitor --configured
