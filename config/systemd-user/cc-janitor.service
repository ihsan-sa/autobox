[Unit]
Description=cc-janitor: sweep dead tracks, merged origin branches and bare tmux windows in the configured repos
[Service]
Type=oneshot
# --configured, not a repo name: which repos this box sweeps is CC_JANITOR_REPOS in ~/.cc/config, and with the
# key unset this does nothing at all. A tool that deletes is pointed by hand; the unit only says when.
ExecStart=%h/bin/cc-janitor --configured
