[Unit]
Description=cc-msg: answer every known-safe dialog on the box, whether or not a message is queued behind it
[Service]
Type=oneshot
TimeoutStartSec=300
# cc-stall first, and `-`: a stuck session (a known startup dialog it clears, a relaunch loop or a dialog nobody
# answers it raises as a row) is a separate tool whose failure never stops cc-msg's sweep behind it.
ExecStart=-%h/bin/cc-stall --apply
ExecStart=%h/bin/cc-msg --sweep
