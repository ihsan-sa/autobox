[Unit]
Description=Memory ceiling for the lander's landing checks (admission.py's scopes)

# A runaway check is killed inside this slice instead of the kernel's global OOM killer picking interactive sessions
# (app.slice, uncapped) at random, as it did on 2026-10-24. Percentages of RAM, so no machine's size is named here.
# No MemoryHigh: admission.py reads it as its memory bound, and each check reserves its recorded peak, so on
# 2026-10-31 three checks whose reservations filled MemoryHigh, while using well under half of it, held every
# worker's green run for two hours with most of RAM free. Without it admission sets no slice bound and still drops
# to one slot on box-wide memory pressure (mem_loaded, short). Each check's own scope MemoryMax (admission's MEM_MAX)
# stops one runaway; this MemoryMax bounds all checks together.
[Slice]
MemoryHigh=infinity
MemoryMax=50%
MemorySwapMax=15%
