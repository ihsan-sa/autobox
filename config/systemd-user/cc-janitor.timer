[Unit]
Description=Weekly cc-janitor (Sundays 05:00 UTC — clear of the 03:30 audit, done before the owner is up)
[Timer]
OnCalendar=Sun *-*-* 05:00:00 UTC
# Persistent=true is a hazard on cc-digest.timer (a catch-up run pushed a digest to the owner's phone at 22:43
# local) and is safe here for the same reason it is useful: a catch-up sweep reaches nobody, and a box that was
# off over the weekend still wants its cleanup rather than a skipped one.
Persistent=true
[Install]
WantedBy=timers.target
