[Unit]
Description=cc-improve-batch: the day's ranked list of the box's own biggest problems, for the improve seat
# After= only orders the two when both are queued at once, which is the case that matters: Persistent= fires both
# timers together at boot after a missed night, and this waits for the snapshot. No Wants=: pulling cc-collect in at
# 00:20 would write a snapshot of the wrong 24 h. A night cc-collect didn't run at all, the script refuses a `latest`
# over 26 h old.
After=cc-collect.service
[Service]
Type=oneshot
# Reads ~/.cc/state/improve/snapshots/latest (cc-collect's) and writes ~/.cc/state/improve/reports/<day>.{md,jsonl}.
# A few tool-less model calls under IMPROVE_BATCH_BUDGET (default $3); makes no board row and posts nothing.
# Worst case: 4 fixed calls (failures, fixes-pick, fixes-judge, ideas) plus one nudge call per 120 owner messages,
# each up to 900 s. Sized for 600 owner messages, twice the busiest day seen (299): (4 + 5) x 900 = 8100 s, plus 600 s
# for git and the report. The selfcheck holds this number to the script's constants.
TimeoutStartSec=8700
ExecStart=%h/bin/cc-improve-batch
