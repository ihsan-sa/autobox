[Unit]
Description=cc-collect once a day, just before midnight UTC, so the snapshot named for a day covers that day
# LINKED BUT NOT ENABLED (units.json: enable=owner). The seat that runs the improvement passes switches it on.
[Timer]
OnCalendar=*-*-* 23:50:00 UTC
# A day missed while the box was down is caught up at boot: the snapshot covers the 24 h before that run.
Persistent=true
[Install]
WantedBy=timers.target
