[Unit]
Description=cc-hostdoor sync: a session host pulls each member's library and documents views from the hub and pushes its board
[Service]
Type=oneshot
TimeoutStartSec=300
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/bin/cc-hostdoor sync
