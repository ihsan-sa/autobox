[Unit]
Description=tmux server + session "main" with the box's Remote-Control Claude session (cc-rc)

[Service]
# forking: systemd tracks the tmux server pid, the unit goes inactive when the server dies, and a dead server
# is restarted in 5 s. Panes live in tmux-spawn-*.scopes, so this cgroup holds only the server. Never create the
# server from another unit's cgroup (a server born inside cc-slackd died with it — 2026-08-26 incident).
# A deliberate `systemctl --user restart tmux-main` while the server is up kills every session: owner-only.
Type=forking
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/tmux new-session -d -s main -n box -c %h/dev %h/bin/cc-rc
ExecStop=-/usr/bin/tmux kill-server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
