[Unit]
Description=tmux server + session "main" with the box's Remote-Control Claude session (cc-rc)

[Service]
# forking: systemd tracks the tmux server pid, the unit goes inactive when the server dies, and a dead server
# is restarted in 5 s. Panes live in tmux-spawn-*.scopes, so this cgroup holds only the server. Never create the
# server from another unit's cgroup (a server born inside cc-slackd died with it — 2026-08-26 incident).
# A deliberate `systemctl --user restart tmux-main` while the server is up kills every session: owner-only.
Type=forking
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# A session "main" that is already up but not ours (a server started by hand, as during the 2026-10-12 move) counts
# as up: exit 1 skips the start and leaves the unit inactive, not failed, and since systemd 251 a skipped
# ExecCondition does not trigger Restart=always. Without it ExecStart failed on "duplicate session: main" every 5 s
# and every deploy's install.sh failed starting the unit. The next box restart hands the server back to the unit.
# `=main` is an exact match: plain `-t main` also matches a session named "main2" by prefix.
ExecCondition=/bin/sh -c '! /usr/bin/tmux has-session -t =main 2>/dev/null'
ExecStart=/usr/bin/tmux new-session -d -s main -n box -c %h/dev %h/bin/cc-rc
# A deliberate stop (!restart tmux, a stop of this unit, a clean reboot) is not a crash: forget tells cc-tmux-ledger so
# the next server starts clean. systemd runs ExecStop after a crash too, and then forget finds no server and does nothing.
ExecStop=-%h/bin/cc-tmux-ledger forget
ExecStop=-/usr/bin/tmux kill-server
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
