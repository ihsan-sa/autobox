[Unit]
Description=cc-memory-dream: the nightly tidy of Claude Code's auto-memory, every change a git commit in the memory dir
[Service]
Type=oneshot
# Reads ~/.claude/projects/*/memory, each project's recent journals and its cc-failures ledger; writes the memory dirs
# (each its own git repo) and ~/.cc/state/memory-dream/. Tool-less model calls under MEMORY_DREAM_BUDGET (default $2);
# no row, no post. Worst case per dir is two calls of up to 900 s; a night that runs long stops at the budget first.
TimeoutStartSec=7200
ExecStart=%h/bin/cc-memory-dream run
