[Unit]
Description=cc-slackd: the box's Slack connection (Socket Mode) + local router for Claude Code channel sessions (cc slack on|off)

[Service]
# The daemon parses ~/.cc/config itself — no EnvironmentFile: it leaked every secret into the env of whatever it spawned.
# KillMode=process: restarting/stopping this daemon must never take down processes it once spawned (2026-08-26 incident:
# the tmux server was born in this cgroup and died with it).
KillMode=process
ExecStart=%h/bin/cc-slack daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
