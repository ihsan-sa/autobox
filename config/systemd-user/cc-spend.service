[Unit]
Description=cc-spend: fold what grew in every claude transcript into the box's token ledger
[Service]
Type=oneshot
# The first run backfills every day of transcripts this box already has (370 MB read in ~2 s here); every run
# after it reads only the bytes that arrived since the last tick.
TimeoutStartSec=300
ExecStart=%h/bin/cc-spend tick
