[Unit]
Description=cc-secretary every 15 min — INSTALLED OFF: a watcher that spends model budget is switched on by the owner (systemctl --user enable --now cc-secretary.timer)
[Timer]
OnBootSec=10min
OnUnitActiveSec=15min
# never Persistent: a catch-up tick after a power cut would judge a box that is still coming up
Persistent=false
[Install]
WantedBy=timers.target
