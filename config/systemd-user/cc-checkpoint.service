[Unit]
Description=cc-checkpoint --sweep: push what an interactive member session committed, with that workspace's own credential
[Service]
Type=oneshot
# Inside a member workspace's boundary the Stop hook commits but cannot push — the credential is host-only by design
# (cc-sandbox) — and only a worker's loop pushed from out here. This is the same host push, on a timer, for the
# sessions a person drives. Member workspaces only; nothing is pushed for the box's own repos.
ExecStart=%h/bin/cc-checkpoint --sweep
