[Unit]
Description=cc-usage-poll: the account's five-hour and seven-day plan usage, read live into ~/.cc/state/usage/now.json
[Service]
Type=oneshot
# One GET of Anthropic's OAuth usage endpoint with the ~/.claude login's token; no model call. A failure keeps the
# last good now.json and writes error.json beside it.
TimeoutStartSec=60
ExecStart=%h/bin/cc-usage-poll
