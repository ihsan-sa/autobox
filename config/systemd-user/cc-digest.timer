[Unit]
Description=Daily cc-digest (16:00 UTC = 09:00 America/Los_Angeles, the owner's morning)
[Timer]
# PINNED TO UTC ON PURPOSE, and the local time in the description is the INTENT. The box moved from Etc/UTC to
# America/Los_Angeles on 2026-08-31; because this line says UTC it did not shift, which is right — a timer that
# silently follows the host's timezone is a timer nobody can reason about. But 13:00 UTC was chosen as "≈09:00
# Eastern" and the owner is Pacific, so it had become a 06:00 alarm. Keep the pin, move the number.
OnCalendar=*-*-* 16:00:00 UTC
Persistent=true
[Install]
WantedBy=timers.target
