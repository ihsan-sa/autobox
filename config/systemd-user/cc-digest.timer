[Unit]
Description=Daily cc-digest (11:00 America/Los_Angeles — the owner's late morning)
[Timer]
# THE TIMEZONE IS NAMED, not implied and not converted. Two ways to get this wrong, both hit on 2026-08-31:
#   · bare "11:00:00" silently follows whatever the host is set to, so the schedule moves when the box moves.
#   · "18:00:00 UTC" is 11:00 today and 10:00 after the DST change — a UTC pin is only stable in UTC.
# Naming the zone is stable in the unit the owner actually cares about, and still says exactly what it means.
# (systemd >= 251; this box runs 259. `systemd-analyze calendar` prints both local and UTC for any change.)
OnCalendar=*-*-* 11:00:00 America/Los_Angeles
# Persistent=true CATCHES UP A MISSED RUN THE MOMENT THE UNIT RELOADS. Moving 13:00->16:00 UTC earlier tonight
# pushed a digest to the owner's phone at 22:43 local, because today's new slot was already behind the last
# recorded trigger. Before changing this line, check `systemctl --user list-timers` for the LAST trigger: if it
# is older than the most recent slot of the NEW schedule, the change will fire immediately. Then restart the
# timer, not just daemon-reload — a reload alone left it with `Trigger: n/a`, i.e. no next run at all.
Persistent=true
[Install]
WantedBy=timers.target
