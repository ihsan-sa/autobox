[Unit]
Description=cc-reconcile: make the board match the box, and tell the owner what it cannot decide
[Service]
Type=oneshot
# Findings go through cc-broker, not straight at the session: one digest per window instead of a wake each. The
# door is an env var in cc-reconcile precisely so this is a unit line and not an edit — and cc-broker's argv is
# the daemon's own, so it drops in. CC_BROKER_SOURCE is how it names itself in the digest and the report.
Environment=CC_RECONCILE_INJECT=%h/bin/cc-broker CC_BROKER_SOURCE=reconcile
ExecStart=%h/bin/cc-reconcile --apply --notify
# THE COHERENCE PASS RIDES THIS TURN AND HAS NO UNIT OF ITS OWN. cc-sense reads the box's own config, documents,
# routing tables and panes and writes only the names that do not resolve; it is a watcher, and a watcher with its
# own timer is a fourth thing running beside cc-reconcile, cc-audit and cc-secretary for somebody to read. This is
# the same arrangement cc-handoff's --sweep already has here, one layer up: the timer gives it a turn, cc-sense
# owns what it looks at. `-` because the reconciliation is this unit's job and a coherence finding must never colour
# it, and after the ExecStart above so a slow pass cannot delay the board. It does NOTHING until `CC_SENSE=on` is in
# ~/.cc/config: this timer is enabled on every box, and a recurring pass over the whole box is the owner's call.
ExecStart=-%h/bin/cc-sense --tick
# exit 1 means "found something only a person can settle" — that is the tool working, not the unit failing.
SuccessExitStatus=1
