[Unit]
Description=cc-reconcile: make the board match the box, and tell the owner what it cannot decide
[Service]
Type=oneshot
# Findings go through cc-broker, not straight at the session: one digest per window instead of a wake each. The
# door is an env var in cc-reconcile precisely so this is a unit line and not an edit — and cc-broker's argv is
# the daemon's own, so it drops in. CC_BROKER_SOURCE is how it names itself in the digest and the report.
Environment=CC_RECONCILE_INJECT=%h/bin/cc-broker CC_BROKER_SOURCE=reconcile
ExecStart=%h/bin/cc-reconcile --apply --notify
# exit 1 means "found something only a person can settle" — that is the tool working, not the unit failing.
SuccessExitStatus=1
