[Unit]
Description=cc-reconcile: make the board match the box, sweep what is dead, wake a seat with startable work, post the daily line
[Service]
Type=oneshot
# Findings go through cc-broker, so one digest per window reaches the session instead of a wake each.
Environment=CC_RECONCILE_INJECT=%h/bin/cc-broker CC_BROKER_SOURCE=reconcile
ExecStart=%h/bin/cc-reconcile --apply --notify
# THE BUNDLE TICK RIDES THIS TURN AND HAS NO UNIT OF ITS OWN: cc-bundle starts ONE worker for the queued rows that
# share a file (its own docstring has the whole of it) and holds while the project is parked, the landing queue is
# full, the tier or a usage limit says wait, or two bundles are already live — so its cadence is "within 20 min of
# the queue freeing", which is this timer's. `-` because a dispatch refused is a line in
# ~/.cc/state/bundle/<repo>.jsonl, never this unit red.
ExecStart=-%h/bin/cc-bundle --tick
# exit 1 means "found something only a person can settle" — that is the tool working, not the unit failing.
SuccessExitStatus=1
