[Unit]
Description=cc-board-dream once a night
# LINKED BUT NOT ENABLED (units.json: enable=owner). The planning seat switches it on after it has read a dry report
# (`cc-board-dream run` writes one without touching a board): `systemctl --user enable --now cc-board-dream.timer`.
[Timer]
OnCalendar=*-*-* 03:10:00 UTC
Persistent=true
[Install]
WantedBy=timers.target
