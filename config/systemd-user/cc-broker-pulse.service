[Unit]
Description=cc-broker: give each session's steward a turn over the ledger lines nobody has read
[Service]
Type=oneshot
# THE TICK THAT REACHES THE STEWARD WHEN NOTHING HAS BEEN INJECTED AT ALL. cc-broker.timer delivers events; this
# one carries the ledger, which is the one thing on the box that wakes nobody and is read by nobody — a group
# that repeated inside the hour is written there and rides out only on that target's next real message, so a
# target that goes quiet leaves its lines in a file no turn ever opens.
#
# ENABLED EVERYWHERE AND STILL FREE, because it spends nothing until CC_STEWARD_SOURCES is set in ~/.cc/config:
# with that key unset every run exits without calling anything. That key is the whole switch, so there is no
# second one here to disagree with it, and turning the steward on later needs no second install — the shape
# cc-publish.timer already has.
#
# The RULE is CC_STEWARD_PULSE_S (2 h) inside cc-broker and this timer is only the opportunity to apply it: a
# target that had a tick inside that window is skipped rather than given a second one.
#
# NO TIMEOUT, for the reason cc-broker.service gives at length: one run may give SEVERAL targets' stewards a turn
# and the only cap in the code is per target (STEWARD_TIMEOUT_S), so a fixed number here is a whole-run budget
# against a per-target one and an N-target sweep clears it. A run cut short resumes rather than repeating itself
# — each target's cursor is written before the next target is tried, and a cursor only moves on a run the steward
# actually took — but being cut short mid-chain is still the thing worth not doing.
TimeoutStartSec=infinity
ExecStart=%h/bin/cc-broker --pulse
