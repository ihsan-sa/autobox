[Unit]
Description=cc-keepwarm: a one-line keepalive to an idle seat that is likely to wake, before its prompt cache expires
[Service]
Type=oneshot
# Off unless `cc-config get CC_KEEPWARM` is 1: an off tick reads one key and exits. Never red: a seat that fails is a
# line in ~/.cc/state/keepwarm.log and the walk moves on.
TimeoutStartSec=120
Nice=10
# A keepalive is a turn the box makes on its own, so it waits while the tier holds the pulse (stop): the tick is
# skipped, not failed, and the first one after the tier rises runs again. Nothing stops this timer for a tier.
ExecCondition=%h/bin/cc-tier allows pulse
ExecStart=%h/bin/cc-keepwarm --apply
