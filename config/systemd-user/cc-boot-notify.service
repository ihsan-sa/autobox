[Unit]
Description=cc-boot-notify: Slack/ntfy message on every boot (clean vs power loss, downtime)
After=cc-heartbeat.service
Wants=cc-heartbeat.service

[Service]
Type=oneshot
ExecStart=%h/bin/cc-boot-notify
# waiting for the network after a power cut (slow ISP/WiFi) plus the retries can exceed any finite
# timeout; the script is self-limiting (~15 min max: 600 s network wait + retries) and only stamps the boot once a
# channel took it; when it gives up (exit 1) systemd retries it a minute later until a channel accepts the notice.
TimeoutStartSec=infinity
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
