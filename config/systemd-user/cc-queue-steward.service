[Unit]
Description=cc-queue-steward: notice a stalled landing queue and have one model call decide what moves it
[Service]
Type=oneshot
# A pass reads files and asks no model; only a pass that found a stop, a red, a stall or a dead lane waits on one
# `claude -p` (its own timeout is 20 min), so the start timeout covers that call and not much more.
TimeoutStartSec=1500
ExecStart=%h/bin/cc-queue-steward --apply
