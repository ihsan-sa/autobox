[Unit]
Description=cc-publish: mirror the published prefix of the default branch to its public repo (no-op when in sync)
[Service]
Type=oneshot
# a fetch, a fetch and a push, all against remotes, and then cc-arch's turn — two pdflatex passes and an
# upload. Slow beats killed mid-push, and killed mid-upload used to mean the owner got the document twice.
# The timer is 15 min and systemd starts no second copy of a oneshot that is still running.
TimeoutStartSec=1200
ExecStart=%h/bin/cc-publish
