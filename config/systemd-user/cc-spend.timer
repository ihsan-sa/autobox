[Unit]
Description=cc-spend every 5 min (the token ledger, and the snapshot of live claude processes)
# LINKED BUT NOT ENABLED (units.json: enable=owner). It reads transcripts and /proc and calls no model, so the
# only thing to decide is whether the box keeps this ledger at all — that is the owner's call, not the installer's.
[Timer]
OnBootSec=2min
# OnUnitActiveSec, not OnCalendar: a tick is due five minutes after the last one, and nothing about a byte offset
# wants to land on the clock. Persistent=false — a catch-up tick after downtime reads the same bytes the next one
# would, so there is nothing to catch up on.
OnUnitActiveSec=5min
Persistent=false
[Install]
WantedBy=timers.target
