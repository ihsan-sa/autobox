[Unit]
Description=Memory ceiling for the box's workers (cc-loop's wscope scopes)

# A runaway in a worker is killed inside this slice instead of the kernel's global OOM killer picking interactive
# sessions (app.slice, uncapped) at random, as it did on 2026-10-24. Percentages of RAM, so no machine's size is named here.
[Slice]
MemoryHigh=25%
MemoryMax=33%
MemorySwapMax=15%
