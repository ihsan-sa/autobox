[Unit]
Description=cc-warden tick: each open permission ask in perms' ledger with no live warden run gets one
[Service]
Type=oneshot
# The runs a tick starts outlive it (each up to 20 min), so the unit leaves them be when the tick exits.
KillMode=process
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/bin/cc-warden tick
TimeoutStartSec=300
Nice=10
