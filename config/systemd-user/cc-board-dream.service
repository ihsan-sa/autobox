[Unit]
Description=cc-board-dream: the nightly consolidation of every repo's board (close done rows, fold duplicates), each action in a ledger one command undoes
[Service]
Type=oneshot
# Reads ~/.cc/boards/*.json, the rows' briefs and each repo's default branch; writes the boards through cc-board's lock,
# the parents' briefs, and ~/.cc/state/board-dream/. Tool-less Haiku calls under BOARD_DREAM_BUDGET (default $1); no post.
TimeoutStartSec=3600
ExecStart=%h/bin/cc-board-dream run --live
