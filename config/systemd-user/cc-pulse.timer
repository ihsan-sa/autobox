[Unit]
Description=cc-pulse every 2 h (the drive loop: no development on this box waits for a human poke)
# LINKED BUT NOT ENABLED (units.json: enable=owner). The first fire wakes every session on the box at once —
# on a box that has been up a while a hand-enable fires it immediately, so the owner reads one `cc-pulse --dry-run`
# first and switches the loop on when that reads clean.
[Timer]
OnBootSec=10min
# OnUnitActiveSec, not OnCalendar: a pulse is due two hours after the LAST one, whenever that was, and nothing
# about it wants to land on the clock. Persistent=false for the same reason — a catch-up pulse for a box that
# was off tells its sessions nothing the next one will not.
OnUnitActiveSec=2h
Persistent=false
[Install]
WantedBy=timers.target
