[Unit]
Description=cc-secretary: cheap models read the panes, the journals, the asks and the Home tab, and tell the session what looks wrong
[Service]
Type=oneshot
# --tick: five read-only evidence bundles, one tool-less model call each, findings to the repo's session. Never acts.
# Findings go through cc-broker, not straight at the session: repeated ones are deduped by (repo, PR, state,
# decision-needed) into one digest per window, and a finding that asks the session to CHOOSE is still immediate.
# The door is an env var in cc-secretary precisely so this is a unit line and not an edit to that file.
Environment=CC_SECRETARY_INJECT=%h/bin/cc-broker CC_BROKER_SOURCE=secretary
ExecStart=%h/bin/cc-secretary --tick
