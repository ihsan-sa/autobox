#!/bin/sh
# The default branch is live (symlinks): block broken commits there. Track worktrees checkpoint freely.
# A private overlay that carries core/ as a subtree can add tests/check-extra.sh for its own files.
[ "$(git branch --show-current)" = main ] || exit 0
C="$(cd "$(dirname "$0")/.." && pwd)"                  # core root, wherever this hook was linked from
"$C/tests/check.sh" || exit 1
X="$(git rev-parse --show-toplevel)/tests/check-extra.sh"
[ -x "$X" ] || exit 0
exec "$X"
