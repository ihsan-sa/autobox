# RAPL energy counters readable by the box's operator: cc-slack's dashboard turns them into a live watt reading.
# Read-only, one attribute; the counter exposes power draw only (the "platypus" side-channel concern applies to
# fine-grained sampling of another user's workload — this box runs one user).
SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", ACTION=="add|change", RUN+="/bin/chmod a+r /sys%p/energy_uj"
